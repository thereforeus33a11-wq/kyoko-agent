# Copy to social/.env and fill in.
DISCORD_TOKEN=
# Your own Discord user ID (Developer Mode -> right-click yourself -> Copy User ID)
OVERSEER_ID=
# A private channel only you + the bot can see
OVERSIGHT_CHANNEL_ID=

OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434
# SYSTEM_PROMPT_FILE=persona.txt

# review = every outgoing message waits for your approval; watch = sends automatically, mirrored to you
MODE=review
# Comma-separated user IDs who agreed to be DMed first (e.g. your friend)
ALLOWED_DM_USERS=
MAX_NEW_DMS_PER_HOUR=5
