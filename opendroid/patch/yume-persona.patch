diff --git a/app/src/main/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModel.kt b/app/src/main/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModel.kt
new file mode 100644
index 0000000..e37e4eb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModel.kt
@@ -0,0 +1,463 @@
+package com.opendroid.ai.ui.viewmodel
+
+import android.graphics.Bitmap
+import android.net.Uri
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.agent.ChatErrorUiState
+import com.opendroid.ai.core.agent.guidance
+import com.opendroid.ai.core.agent.title
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.allows
+import com.opendroid.ai.core.persona.PersonaEngine
+import com.opendroid.ai.core.persona.PersonaLibrary
+import com.opendroid.ai.core.persona.PersonaPicture
+import com.opendroid.ai.core.persona.PersonaPictureRules
+import com.opendroid.ai.core.persona.PersonaPictures
+import com.opendroid.ai.core.persona.PersonaStore
+import com.opendroid.ai.core.persona.PictureReading
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.repository.SettingsRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * Backs the screen with her pictures: the pictures of herself with their captions, the
+ * one background picture, and the text that lies under her awareness.
+ *
+ * Everything here stays on the phone except the two things the owner starts by hand:
+ * "Let her look" and "Read the picture into the text" each send one picture to the model
+ * on her route, through the same gate as every other request.
+ */
+@HiltViewModel
+class PersonaPicturesViewModel @Inject constructor(
+    private val pictures: PersonaPictures,
+    private val store: PersonaStore,
+    private val library: PersonaLibrary,
+    private val engine: PersonaEngine,
+    private val settingsRepository: SettingsRepository
+) : ViewModel() {
+
+    /** One picture as the screen lists it. */
+    data class Shown(val id: String, val caption: String, val captionIsHers: Boolean)
+
+    private fun shown(picture: PersonaPicture) =
+        Shown(picture.id, picture.caption, picture.captionBy == PersonaPicture.CaptionBy.HER)
+
+    /** The pictures of herself, in the order they were added. */
+    val selfPictures: StateFlow<List<Shown>> = pictures.pictures
+        .map { all -> all.filter { it.kind == PersonaPicture.Kind.SELF }.map(::shown) }
+        .stateIn(viewModelScope, SharingStarted.Eagerly, emptyList())
+
+    /** The one background picture, or null when there is none. */
+    val background: StateFlow<Shown?> = pictures.pictures
+        .map { all -> all.firstOrNull { it.kind == PersonaPicture.Kind.BACKGROUND }?.let(::shown) }
+        .stateIn(viewModelScope, SharingStarted.Eagerly, null)
+
+    val maxSelfPictures: Int = PersonaPictureRules.MAX_SELF
+    val maxCaptionChars: Int = PersonaPictureRules.MAX_CAPTION_CHARS
+
+    /** Whether the model on her route can be sent a picture as things are set. Both buttons that send one hang on it. */
+    val modelSeesPictures: StateFlow<Boolean> = settingsRepository.llmConfig
+        .map { engine.chatSeesImages(it) }
+        .stateIn(viewModelScope, WHILE_SHOWN, false)
+
+    /** Whether she is switched on and has a card: without her there is nobody to look. */
+    val sheIsOn: StateFlow<Boolean> = settingsRepository.llmConfig
+        .map { engine.isActive(it) }
+        .flowOn(Dispatchers.IO)
+        .stateIn(viewModelScope, WHILE_SHOWN, false)
+
+    /** Where a picture goes when she is shown it, in plain words for the top of the screen. */
+    val whereAPictureGoes: StateFlow<String> = settingsRepository.llmConfig
+        .combine(engine.pictureRefusals) { config, _ -> whereAPictureGoes(config, engine.pictureRefused(config)) }
+        .stateIn(viewModelScope, WHILE_SHOWN, "")
+
+    /** How many picture files lie in the app's storage without being in the list. See [PersonaPictures.unlisted]. */
+    val unlistedFiles: StateFlow<Int> = pictures.unlisted
+
+    val underEnabled: StateFlow<Boolean> = settingsRepository.llmConfig
+        .map { it.personaUnderEnabled }
+        .stateIn(viewModelScope, WHILE_SHOWN, true)
+
+    /** One plain line about the last thing that was done here, or why it could not be done. */
+    var status by mutableStateOf("")
+        private set
+
+    /** The picture she is being shown right now, by its id. */
+    var lookingAt by mutableStateOf<String?>(null)
+        private set
+    var readingBackground by mutableStateOf(false)
+        private set
+    var adding by mutableStateOf(false)
+        private set
+
+    // Snapshot state, not a StateFlow, like the card editor: a long text field drops
+    // characters when every keystroke makes an asynchronous round trip.
+    /** The text in the box: his saved wording, a draft of his, or the text from her files. */
+    var underText by mutableStateOf("")
+        private set
+
+    /** True when the saved text is the owner's own wording, false when the one from her files applies. */
+    var underIsOwnWording by mutableStateOf(false)
+        private set
+
+    /** True when the box takes typing. The text from her files is a read-only preview until he presses Edit. */
+    var underEditing by mutableStateOf(false)
+        private set
+    var underHasUnsavedChanges by mutableStateOf(false)
+        private set
+
+    /** What the box held before a reading of the picture took its place. Null when there is nothing to bring back. */
+    private var boxBeforeReading: UnderBox? = null
+
+    /** True while "Read the picture into the text" can be taken back. */
+    var canUndoReading by mutableStateOf(false)
+        private set
+
+    private var underTextLoaded = false
+
+    init {
+        // The pictures only. The settings row that shows how many there are holds a view
+        // model of this kind too, and has no use for the text or for her files.
+        viewModelScope.launch { pictures.list() }
+    }
+
+    /** Reads the text for the box, once. The screen asks for it when it opens. */
+    fun loadUnderText() {
+        if (underTextLoaded) return
+        underTextLoaded = true
+        viewModelScope.launch { showStoredUnderText() }
+    }
+
+    private suspend fun showStoredUnderText() {
+        val saved = withContext(Dispatchers.IO) { store.savedUnderText() }
+        val shownText = saved?.trim() ?: library.bundledUnderText()
+        underText = shownText
+        underIsOwnWording = saved != null
+        underEditing = saved != null
+        underHasUnsavedChanges = false
+        forgetBoxBeforeReading()
+    }
+
+    private fun forgetBoxBeforeReading() {
+        boxBeforeReading = null
+        canUndoReading = false
+    }
+
+    fun addSelfPicture(uri: Uri) = add(uri, PersonaPicture.Kind.SELF)
+
+    /** Sets the background picture. One that was there is replaced and deleted. */
+    fun setBackgroundPicture(uri: Uri) = add(uri, PersonaPicture.Kind.BACKGROUND)
+
+    private fun add(uri: Uri, kind: PersonaPicture.Kind) {
+        viewModelScope.launch {
+            adding = true
+            status = when (pictures.add(uri, kind)) {
+                is PersonaPictures.Added.Stored ->
+                    if (kind == PersonaPicture.Kind.SELF) {
+                        "Added. Write under it what is on it, or let her look."
+                    } else {
+                        "This is the background picture now. She is never shown it."
+                    }
+                PersonaPictures.Added.Full ->
+                    "She has $maxSelfPictures pictures of herself, which is as many as fit. Remove one to add another."
+                PersonaPictures.Added.Unreadable -> "That file could not be read as a picture. Nothing was added."
+            }
+            adding = false
+        }
+    }
+
+    fun remove(id: String) {
+        viewModelScope.launch {
+            pictures.remove(id)
+            status = "Removed. The picture is deleted from the app's storage."
+        }
+    }
+
+    /**
+     * Saves a caption the owner typed. A text that is the caption already (he only added
+     * a space or a line break) is not saved again, and the caption stays whose it was.
+     */
+    fun saveCaption(id: String, text: String) {
+        viewModelScope.launch {
+            val stored = pictures.list().firstOrNull { it.id == id }?.caption ?: return@launch
+            if (!captionChanged(text, stored)) {
+                status = "The caption is what it was. Nothing was changed."
+                return@launch
+            }
+            pictures.setCaption(id, text, PersonaPicture.CaptionBy.OWNER)
+            status = "Caption saved."
+        }
+    }
+
+    /** Deletes the picture files that are in the app's storage but not in the list. */
+    fun deleteUnlistedFiles() {
+        viewModelScope.launch {
+            pictures.removeUnlisted()
+            status = if (pictures.unlisted.value == 0) {
+                "Deleted. What is listed here is every picture the app keeps."
+            } else {
+                "${pictures.unlisted.value} of those files could not be deleted."
+            }
+        }
+    }
+
+    /**
+     * Shows her picture [id] and keeps what she says is on it as its caption, marked as
+     * hers. When nothing usable comes back the caption stays as it was and the line at
+     * the top says why.
+     */
+    fun letHerLook(id: String) {
+        if (lookingAt != null) return
+        viewModelScope.launch {
+            lookingAt = id
+            try {
+                val image = pictures.base64(id)
+                if (image == null) {
+                    status = "That picture is not in the app's storage any more."
+                    return@launch
+                }
+                status = when (val reading = engine.describeOwnPicture(image)) {
+                    is PictureReading.Read -> {
+                        pictures.setCaption(id, reading.text, PersonaPicture.CaptionBy.HER)
+                        "She looked. The caption is what she said."
+                    }
+                    is PictureReading.Failed -> failureLine(reading, "The caption is unchanged.")
+                }
+            } finally {
+                lookingAt = null
+            }
+        }
+    }
+
+    /**
+     * Has the model on her route write down what the background picture says and puts
+     * that into the box, for the owner to check, edit and save. Nothing is saved by this,
+     * and what the box held before is kept for one step back ([undoReading]): he may
+     * have typed a wording of his own into it and not saved it yet.
+     */
+    fun readBackgroundIntoText() {
+        val picture = background.value ?: return
+        if (readingBackground) return
+        viewModelScope.launch {
+            readingBackground = true
+            try {
+                val image = pictures.base64(picture.id)
+                if (image == null) {
+                    status = "The background picture is not in the app's storage any more."
+                    return@launch
+                }
+                status = when (val reading = engine.readBackgroundPicture(image)) {
+                    is PictureReading.Read -> {
+                        val before = UnderBox(underText, underEditing, underHasUnsavedChanges)
+                        boxBeforeReading = before
+                        canUndoReading = true
+                        underText = reading.text
+                        underEditing = true
+                        underHasUnsavedChanges = true
+                        readLine(replacedUnsavedTyping = before.unsaved)
+                    }
+                    is PictureReading.Failed -> failureLine(reading, "The text below is unchanged.")
+                }
+            } finally {
+                readingBackground = false
+            }
+        }
+    }
+
+    /** Puts back what the box held before the picture was read into it: his typing, saved or not, as it was. */
+    fun undoReading() {
+        val before = boxBeforeReading ?: return
+        underText = before.text
+        underEditing = before.editing
+        underHasUnsavedChanges = before.unsaved
+        forgetBoxBeforeReading()
+        status = "The box holds what it held before the picture was read."
+    }
+
+    /** Lets the owner type into the box, starting from the text that is in it. */
+    fun startEditingUnderText() {
+        underEditing = true
+    }
+
+    fun onUnderTextChange(text: String) {
+        if (!underEditing) return
+        underText = text
+        underHasUnsavedChanges = true
+    }
+
+    /** Saves the text in the box as the owner's own wording. She runs on it from her next reply. */
+    fun saveUnderText() {
+        val text = underText
+        viewModelScope.launch {
+            withContext(Dispatchers.IO) { store.saveUnderText(text) }
+            showStoredUnderText()
+            status = savedLine(
+                ownWording = underIsOwnWording,
+                herFilesHaveText = underText.isNotBlank(),
+                inHerPrompt = underIsInHerPrompt()
+            )
+        }
+    }
+
+    /** Whether the switch is on as stored, not as the screen last showed it. */
+    private suspend fun underIsInHerPrompt(): Boolean = settingsRepository.llmConfig.first().personaUnderEnabled
+
+    /** Drops the owner's wording, saved or not, and goes back to the text from her own files. */
+    fun backToTextFromHerFiles() {
+        viewModelScope.launch {
+            withContext(Dispatchers.IO) { store.saveUnderText("") }
+            showStoredUnderText()
+            status = removedLine(herFilesHaveText = underText.isNotBlank(), inHerPrompt = underIsInHerPrompt())
+        }
+    }
+
+    fun setUnderEnabled(enabled: Boolean) {
+        viewModelScope.launch { settingsRepository.updateConfig { it.copy(personaUnderEnabled = enabled) } }
+    }
+
+    /** A small version of picture [id] for the list, or null when its file is gone. */
+    suspend fun thumbnail(id: String): Bitmap? = pictures.thumbnail(id)
+
+    /** The box with the text under her awareness as it stands: what is in it, and whether it takes typing and holds something unsaved. */
+    private class UnderBox(val text: String, val editing: Boolean, val unsaved: Boolean)
+
+    companion object {
+        // What is read off the settings is only kept current while a screen shows it.
+        private val WHILE_SHOWN = SharingStarted.WhileSubscribed(5_000)
+
+        /** Said when the switch is off: the text is kept, and none of it is in her prompt. */
+        private const val SWITCH_IS_OFF =
+            "It is left out of her prompt while \"Keep this under her awareness in every reply\" is off."
+
+        /**
+         * True when [draft], as it would be stored, is another caption than [stored]. White
+         * space at the ends and empty lines are not kept, so they are not a change.
+         */
+        fun captionChanged(draft: String, stored: String): Boolean = PersonaPictureRules.fitCaption(draft) != stored
+
+        /**
+         * After Save: what was saved, and whether it reaches her, which hangs on the switch
+         * ([inHerPrompt]). An empty text is not a wording ([ownWording] is false): saving it
+         * removes his.
+         */
+        internal fun savedLine(ownWording: Boolean, herFilesHaveText: Boolean, inHerPrompt: Boolean): String = when {
+            !ownWording -> "An empty text was saved. " + removedLine(herFilesHaveText, inHerPrompt)
+            inHerPrompt -> "Saved. This is what lies under her awareness from her next reply on."
+            else -> "Saved. $SWITCH_IS_OFF"
+        }
+
+        /** After "Back to the text from her files", in the same way. */
+        internal fun removedLine(herFilesHaveText: Boolean, inHerPrompt: Boolean): String = when {
+            !herFilesHaveText ->
+                "Your wording is removed. This build has no such text in her files, so nothing lies under her awareness."
+            inHerPrompt -> "Your wording is removed. The text from her files applies again."
+            else -> "Your wording is removed. The text from her files is the one kept. $SWITCH_IS_OFF"
+        }
+
+        /** After the picture was read into the box. [replacedUnsavedTyping] says he had typed something he had not saved. */
+        internal fun readLine(replacedUnsavedTyping: Boolean): String =
+            "Read into the box below. Check it and change what is wrong; nothing is saved until you press Save. " +
+                if (replacedUnsavedTyping) {
+                    "What you had typed is not lost: \"Undo the reading\" puts it back."
+                } else {
+                    "\"Undo the reading\" puts back what the box held before."
+                }
+
+        /** Under a disabled "Let her look". */
+        const val CANNOT_LOOK_REASON =
+            "Her model cannot be sent pictures on this route (the encrypted route carries none). " +
+                "Type what is on it, or give her replies a model that reads images."
+
+        /** Under a disabled "Read the picture into the text". */
+        const val CANNOT_READ_REASON =
+            "The model on her route cannot be sent pictures (the encrypted route carries none). " +
+                "Type the text yourself, or give her replies a model that reads images."
+
+        /**
+         * Where a picture goes when she is shown it, for the configuration as it is. Kept
+         * on the phone is one thing and shown to her model is another, and the screen
+         * says both: a hosted model's provider can see a picture it is sent.
+         */
+        internal fun whereAPictureGoes(config: LLMConfig, refusedByHerModel: Boolean = false): String {
+            val route = RouteClassifier.personaRoute(config)
+            return when {
+                !config.routePolicy.allows(route) ->
+                    "The model set for her replies is on a route your privacy setting refuses (${route.label}), " +
+                        "so nothing is sent to it, and no picture either."
+                route == RoutePrivacy.ENCRYPTED ->
+                    "Her replies are end to end encrypted, and that route carries no pictures. She is not shown any; " +
+                        "she is told in words what is on them, from the captions."
+                !config.personaChatSeesImages ->
+                    "Her model is not set to read images (\"Her model can see screenshots\" in Settings is off). " +
+                        "She is not shown any picture; she is told in words what is on them, from the captions."
+                !PersonaEngine.imagesReachChatModel(config) -> {
+                    val provider = PersonaEngine.chatProviderName(config)
+                    "The provider that writes her replies ($provider) cannot pass a picture on to its model. " +
+                        "She is not shown any; she is told in words what is on them, from the captions." +
+                        if (provider == "Ollama") {
+                            " A model served by Ollama can be shown pictures through Custom OpenAI Compatible, " +
+                                "pointed at the same machine with /v1 at the end of the address."
+                        } else {
+                            ""
+                        }
+                }
+                // Sent once and turned down: she is not shown one again, so nothing here may say she is.
+                refusedByHerModel ->
+                    "The model that writes her replies would not take the last picture of her it was sent, and wrote " +
+                        "that reply without it. Until the app is restarted or her model is changed she is not sent " +
+                        "another; she is told in words what is on them, from the captions. If her model does not read " +
+                        "images, switch off \"Her model can see screenshots\" in Settings. If it does, \"Let her look\" " +
+                        "tries a picture again."
+                route == RoutePrivacy.ON_DEVICE ->
+                    "When she is shown a picture of herself it goes to the model that writes her replies, which runs " +
+                        "on this phone. It does not leave the phone."
+                route == RoutePrivacy.OWN_NETWORK ->
+                    "When she is shown a picture of herself it goes to the model that writes her replies, which runs " +
+                        "on your own network. It leaves the phone and stays on your own machine."
+                else ->
+                    "When she is shown a picture of herself it is sent to the model that writes her replies. That " +
+                        "model is hosted, and its provider can read what it is sent, the picture included."
+            }
+        }
+
+        /** Why nothing came of showing a picture, in one plain line that ends on [unchanged]. */
+        internal fun failureLine(failed: PictureReading.Failed, unchanged: String): String {
+            val why = when (failed.reason) {
+                PictureReading.Reason.SHE_IS_OFF -> "She is switched off in Settings, so there is nobody to look."
+                PictureReading.Reason.NO_PICTURES_ON_THIS_ROUTE ->
+                    "Not sent: the model on her route cannot be sent pictures (the encrypted route carries none)."
+                PictureReading.Reason.CALL_FAILED -> failed.failure?.let { failure ->
+                    val error = ChatErrorUiState(
+                        sessionId = "",
+                        requestId = "",
+                        runId = "",
+                        category = failure.error,
+                        provider = failure.provider,
+                        model = failure.model
+                    )
+                    "${error.title()}. ${error.guidance()}"
+                } ?: "The request to her model failed."
+                PictureReading.Reason.TOOK_TOO_LONG -> "Her model took too long to answer."
+                PictureReading.Reason.DECLINED -> "Her model declined to look at the picture."
+                PictureReading.Reason.EMPTY -> "Her model sent nothing back."
+            }
+            return "$why $unchanged"
+        }
+    }
+}
