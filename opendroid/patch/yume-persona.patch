+package com.opendroid.ai.core.agent
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class IntentClassifierForcedActionTest {
+
+    @Test
+    fun `commands are still forced onto the planner`() {
+        for (query in listOf(
+            "call dad", "Calling mom now", "text Sam I'm late", "open youtube", "play some music",
+            "take screenshots", "turn on the flashlight", "set alarm for 7", "find my keys",
+            "what's the weather", "send it", "ring my phone"
+        )) {
+            assertTrue(query, IntentClassifier.isForcedAction(query))
+        }
+    }
+
+    @Test
+    fun `commands whose keyword sits inside a longer word are still forced`() {
+        for (query in listOf(
+            "redial the last number", "rebook uber for 6pm", "recalculate the route",
+            "put it on speakerphone", "connect my headphones", "use the microphone"
+        )) {
+            assertTrue(query, IntentClassifier.isForcedAction(query))
+        }
+    }
+
+    @Test
+    fun `a keyword straight after a script written without spaces starts a word`() {
+        for (query in listOf("打开youtube", "音楽をyoutubeで再生", "打开wifi", "เปิดwifi")) {
+            assertTrue(query, IntentClassifier.isForcedAction(query))
+        }
+        // An accented Latin letter still joins onto what follows it.
+        assertFalse(IntentClassifier.isForcedAction("the décall is fine"))
+    }
+
+    @Test
+    fun `a forced word inside another word no longer hijacks conversation`() {
+        for (query in listOf(
+            "you are boring", "that's basically it", "give me some context", "i reopened it",
+            "bring it on", "this is unfindable", "what a display"
+        )) {
+            assertFalse(query, IntentClassifier.isForcedAction(query))
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt
