+            assertTrue(strict.contains("It is asked without the request only when \"$ROUTE_POLICY_ANY_LABEL\" is chosen above."))
+            val kept = PreferredRecognizer.Choice { false }
+            assertFalse(kept.onError(onDevice = false, error = 13))
+            assertTrue(kept.asksOffline(onDevice = false))
+            assertTrue(kept.offlineUnavailable(onDevice = false, error = 13))
