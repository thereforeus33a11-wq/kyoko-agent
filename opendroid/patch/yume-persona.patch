+package com.opendroid.ai.core.life.ears
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+import android.os.StatFs
+import android.util.Log
+import androidx.work.Constraints
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkInfo
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import androidx.work.workDataOf
+import com.opendroid.ai.core.llm.ModelDownloadForegroundInfoFactory
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import java.io.File
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Where her ears' models live on the phone, and how they get there: only when he taps to get
+ * them, only over Wi-Fi (an unmetered network; WorkManager waits for one, and the download
+ * stops when the phone leaves it and goes on later from where it stopped), each checked
+ * against the hash pinned in [EarsModels]. They sit in the app's no-backup storage, so no
+ * backup carries them off, and [deleteAll] removes every one of them.
+ */
+@Singleton
+class EarsModelStore @Inject constructor(@ApplicationContext private val context: Context) {
+
+    /** The models' folder. */
+    val root: File get() = File(context.noBackupFilesDir, DIRECTORY)
+
+    /** True when everything the ears need with [recognizer] is in place. */
+    fun ready(recognizer: EarsModels.Recognizer): Boolean = missing(recognizer).isEmpty()
+
+    /** What the ears still need with [recognizer]. */
+    fun missing(recognizer: EarsModels.Recognizer): List<EarsModels.Model> =
+        EarsModels.needed(recognizer).filterNot { EarsModelInstaller.isInstalled(root, it) }
+
+    /** The bytes the ears' models take on the phone now. */
+    fun bytesOnPhone(): Long = root.walkTopDown().filter { it.isFile }.sumOf { it.length() }
+
+    /**
+     * Starts getting what [recognizer] needs, at his tap. It waits for Wi-Fi if the phone is
+     * not on it. A download under way for another choice is replaced.
+     */
+    fun download(recognizer: EarsModels.Recognizer) {
+        val request = OneTimeWorkRequestBuilder<EarsModelWorker>()
+            .setConstraints(
+                Constraints.Builder()
+                    .setRequiredNetworkType(NetworkType.UNMETERED)
+                    .setRequiresStorageNotLow(true)
+                    .build()
+            )
+            .setInputData(workDataOf(EarsModelWorker.RECOGNIZER to recognizer.name))
+            .addTag(TAG)
+            .build()
+        WorkManager.getInstance(context).enqueueUniqueWork(WORK, ExistingWorkPolicy.REPLACE, request)
+    }
+
+    /** Stops a download; what came of it so far is kept for the next one. */
+    fun cancel() {
+        WorkManager.getInstance(context).cancelUniqueWork(WORK)
+    }
+
+    /** Stops any download and deletes every model of the ears, and what was half fetched. */
+    suspend fun deleteAll(): Boolean = withContext(Dispatchers.IO) {
+        cancel()
+        EarsModels.ALL.forEach { EarsModelInstaller.remove(root, it) }
+        File(root, PARTIAL).deleteRecursively()
+        !root.exists() || root.walkTopDown().none { it.isFile }
+    }
+
+    /** Where getting the models stands, for the settings card. */
+    data class Status(
+        val ready: Boolean,
+        val downloading: Boolean,
+        /** Waiting for Wi-Fi (or for free space) before it can go on. */
+        val waiting: Boolean,
+        val doneBytes: Long,
+        val totalBytes: Long,
+        /** What went wrong the last time, in words for him; null when nothing did. */
+        val failed: String?,
+    )
+
+    /** [Status] as it changes, for [recognizer]. */
+    fun status(recognizer: EarsModels.Recognizer): Flow<Status> =
+        WorkManager.getInstance(context).getWorkInfosForUniqueWorkFlow(WORK).map { infos ->
+            val info = infos.firstOrNull()
+            val total = EarsModels.downloadBytes(EarsModels.needed(recognizer))
+            val running = info?.state == WorkInfo.State.RUNNING
+            val waiting = info?.state == WorkInfo.State.ENQUEUED || info?.state == WorkInfo.State.BLOCKED
+            val done = info?.progress?.getLong(EarsModelWorker.DONE_BYTES, 0L) ?: 0L
+            val failed = if (info?.state == WorkInfo.State.FAILED) info.outputData.getString(EarsModelWorker.WHY) else null
+            Status(ready(recognizer), running, waiting, done, total, failed)
+        }
+
+    companion object {
+        const val DIRECTORY = "ears_models"
+        const val PARTIAL = ".download"
+        const val WORK = "ears-models"
+        const val TAG = "ears-models"
+    }
+}
+
+/**
+ * Fetches and installs, one after the other, the models the ears need with the recogniser
+ * he chose. Started only by [EarsModelStore.download], at his tap, on an unmetered network.
+ */
+class EarsModelWorker(appContext: Context, params: WorkerParameters) : CoroutineWorker(appContext, params) {
+
+    override suspend fun doWork(): Result = withContext(Dispatchers.IO) {
+        val recognizer = EarsModels.Recognizer.of(inputData.getString(RECOGNIZER))
+        val root = File(applicationContext.noBackupFilesDir, EarsModelStore.DIRECTORY)
+        val partials = File(root, EarsModelStore.PARTIAL)
+        // WorkManager waits for an unmetered network; this is the second look, since the
+        // owner said Wi-Fi only.
+        if (!unmetered()) return@withContext Result.retry()
+        try {
+            setForeground(ModelDownloadForegroundInfoFactory.create(applicationContext, id))
+        } catch (e: Exception) {
+            // Android may refuse a foreground start from the background; the download then runs
+            // as ordinary work, and a stop goes on from where it was.
+            Log.w(TAG, "Ears models download runs without a foreground notification: ${e.javaClass.simpleName}")
+        }
+        val download = EarsDownload(OkHttpClient())
+        val todo = EarsModels.needed(recognizer).filterNot { EarsModelInstaller.isInstalled(root, it) }
+        val total = EarsModels.downloadBytes(EarsModels.needed(recognizer))
+        var before = EarsModels.downloadBytes(EarsModels.needed(recognizer) - todo.toSet())
+        for (model in todo) {
+            if (!partials.isDirectory && !partials.mkdirs()) return@withContext fail("the phone's storage could not take it")
+            val part = File(partials, "${model.id}.part")
+            val free = StatFs(root.path.takeIf { root.exists() } ?: applicationContext.noBackupFilesDir.path).availableBytes
+            if (free < EarsModels.peakBytes(model) - part.length()) {
+                return@withContext fail("not enough free space: about ${EarsModels.peakBytes(model) / (1024 * 1024)} MB are needed")
+            }
+            val base = before
+            val outcome = download.fetch(model, part, keepGoing = { !isStopped && unmetered() }) { have ->
+                setProgressAsync(workDataOf(DONE_BYTES to base + have, TOTAL_BYTES to total))
+            }
+            when (outcome) {
+                is EarsDownload.Outcome.Interrupted -> return@withContext Result.retry()
+                is EarsDownload.Outcome.Refused -> {
+                    part.delete()
+                    return@withContext fail("the download was refused (${outcome.code})")
+                }
+                EarsDownload.Outcome.Done -> Unit
+            }
+            when (val failure = EarsModelInstaller.install(root, model, part) { !isStopped }) {
+                null -> part.delete()
+                // The whole download is kept: the next run installs it without fetching it again.
+                EarsModelInstaller.Failure.STOPPED -> return@withContext Result.retry()
+                else -> {
+                    part.delete()
+                    return@withContext fail(failure.words)
+                }
+            }
+            before += model.size
+        }
+        partials.deleteRecursively()
+        Result.success()
+    }
+
+    private fun unmetered(): Boolean {
+        val cm = applicationContext.getSystemService(ConnectivityManager::class.java) ?: return false
+        val caps = cm.getNetworkCapabilities(cm.activeNetwork ?: return false) ?: return false
+        return caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED) &&
+            caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+    }
+
+    private fun fail(why: String): Result {
+        Log.w(TAG, "Ears models not installed: $why")
+        return Result.failure(workDataOf(WHY to why))
+    }
+
+    companion object {
+        private const val TAG = "EarsModels"
+        const val RECOGNIZER = "recognizer"
+        const val DONE_BYTES = "done"
+        const val TOTAL_BYTES = "total"
+        const val WHY = "why"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/EarsModels.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsModels.kt
new file mode 100644
