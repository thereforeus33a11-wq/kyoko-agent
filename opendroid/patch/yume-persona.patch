+/**
+ * Everything the persona does, in one place, so that the rest of the app asks it a
+ * few narrow questions and never handles her text itself:
+ *
+ *  - is she on ([isActive], and [active] for the screens), and which provider writes her replies;
+ *  - the system prompt for one chat reply, with her own block about him and the phone;
+ *  - the fixed lines the app speaks, in her voice ([phrasebook]);
+ *  - keeping her notebook up to date after a chat ([onReply]);
+ *  - a moment of her own at the time she named, with nobody having written
+ *    ([ownMoment]), and the lines of a reply she keeps to herself ([withoutThoughts]);
+ *  - her sleep, which she lies down to herself, and the pass in it in which she goes
+ *    over all of herself ([PersonaSleep], [PersonaSleepPass]);
+ *  - what the phone just did, said in her words with the facts kept ([resultLine]);
+ *  - which model may read a command she wrote ([commandRoute]);
+ *  - her own picture in front of her ([ownPictureFor], [orWithoutPicture],
+ *    [describeOwnPicture]), and the background picture read into text for the owner
+ *    ([readBackgroundPicture]).
+ *
+ * Nothing here starts a device action. Every call it makes asks for plain text, and what
+ * comes back goes to the chat and to speech, or, where the owner had a picture looked
+ * at, to the screen he did that on. When she wants something done on the phone she ends
+ * a reply with a command line ([PersonaActions]); the loop that runs the owner's
+ * commands takes it from there, through her rein and his approval setting.
+ */
+@Singleton
+class PersonaEngine @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val library: PersonaLibrary,
+    private val settingsRepository: SettingsRepository,
+    private val llmProviderFactory: LLMProviderFactory,
+    private val userProfileStore: UserProfileStore,
+    private val pictures: PersonaPictures,
+    private val memoryManager: MemoryManager,
+    private val thoughts: PersonaThoughts,
+    private val ownTimeAlarm: OwnTimeAlarm = OwnTimeAlarm.NONE,
+    private val ownLife: OwnLifeLink = OwnLifeLink.NONE
+) {
+    val phrasebook = PersonaPhrasebook()
+
+    private val scope = CoroutineScope(
+        SupervisorJob() + Dispatchers.Default + CoroutineExceptionHandler { _, e ->
+            Log.w(TAG, "Persona background task failed: ${e.javaClass.simpleName}")
+        }
+    )
+    private val reflecting = AtomicBoolean(false)
+    private val seedLock = Mutex()
+    @Volatile private var seeded = false
+
+    // Once there has been talk between them on this phone, there always has been: asked of the store only until then.
+    @Volatile private var talkedBefore = false
+
+    /**
+     * What time it is, for the things in her prompts that go by the clock: how old a note
+     * is, which day it is, and whose turn it is on a page that is too small for her
+     * notebook. A test sets it; the app never does.
+     */
+    internal var clock: () -> Long = System::currentTimeMillis
+
+    /**
+     * How much later than the span she named a sleep of hers comes out: 0 to
+     * [PersonaSleep.MAX_JITTER_MILLIS], never earlier, so that her nights vary like a
+     * person's. A test sets it; the app never does.
+     */
+    internal var sleepJitter: () -> Long = { Random.nextLong(0, PersonaSleep.MAX_JITTER_MILLIS + 1) }
+
+    init {
+        // A chat he clears or deletes takes its rows with it. What her notebook has not
+        // read of them is kept first, so that the next pass still gets it.
+        memoryManager.episodicMemory.beforeRowsGo(::keepUnread)
+    }
+
+    // One lock for every change to what is stored about her own time, and one moment at a time.
+    private val ownTimeLock = Mutex()
+    private val inOwnMoment = AtomicBoolean(false)
+
+    // The model (provider, model and address in one text) that would not take her picture
+    // and wrote the same reply without it. Kept in memory only: after a restart, or on
+    // another model, she is sent a picture again.
+    private val refusedPictures = MutableStateFlow<String?>(null)
+
+    /** Changes whenever a model starts or stops being known to refuse her picture. See [pictureRefused]. */
+    val pictureRefusals: StateFlow<String?> = refusedPictures.asStateFlow()
+
+    suspend fun isActive(): Boolean = isActive(settingsRepository.llmConfig.first())
+
+    /**
+     * On only when switched on and a card exists; a build without the card behaves like
+     * stock. This is the one answer to "is she the one who talks": the chat, the voice
+     * service and, through [active], every screen ask here.
+     */
+    fun isActive(config: LLMConfig): Boolean = config.personaEnabled && store.card().isNotBlank()
+
+    /**
+     * [isActive] for the screens, told again whenever the switch or the card changes: a
+     * card can be saved or removed in the editor without any setting being touched.
+     */
+    val active: Flow<Boolean> = combine(settingsRepository.llmConfig, store.changes) { config, _ -> isActive(config) }
+        .distinctUntilChanged()
+        .flowOn(Dispatchers.IO)
+
+    /**
+     * The provider that writes her replies: the one chosen for chat, else the active one.
+     *
+     * Only a blank setting means "the same as the main provider". A name this build does
+     * not know (a provider renamed or removed since it was saved) is handed to the
+     * factory as it is, which answers with a provider that fails before any network
+     * access: her replies never move to another provider because a name stopped matching.
+     */
+    suspend fun chatProvider(config: LLMConfig): LLMProvider {
+        val chosen = chatProviderName(config)
+        return if (chosen == null) llmProviderFactory.getActiveProvider() else llmProviderFactory.getProviderByName(chosen)
+    }
+
+    /**
+     * Points [request] at the model chosen for her replies, when one is set, and marks it
+     * as a request of her own. Used for her chat reply, her notebook reflection, a
+     * moment of her own and her line about a result, and for planning a command of hers when that
+     * has to stay on her route ([commandRoute]). Nothing of the owner's own commands goes
+     * this way.
+     *
+     * The mark tells the model layer three things: her prompt is never cut to fit a
+     * model, a refusal by the model or its host is an error and not her line, and the
+     * model named here is used only on the provider it was typed for.
+     */
+    fun withChatModel(request: LLMRequest, config: LLMConfig): LLMRequest = requestOfHers(request, config)
+
+    /** Whether a screenshot may be attached to a chat request for this configuration. */
+    fun chatSeesImages(config: LLMConfig): Boolean = imagesReachChatModel(config)
+
+    /**
+     * Her system prompt for one reply.
+     *
+     * [relevantContext] is the context the caller read for this reply, in the stock
+     * assistant's wording. Her prompt no longer carries that text: the block about him
+     * and the phone is built here, from the same data, in plain lines of its own
+     * ([aboutHimBlock]). What the caller read still decides one thing. A command she ends
+     * the reply with is held against the notification text the caller saw, so only
+     * notifications that stand in [relevantContext] are shown to her.
+     *
+     * Her own latest thoughts are in it too, in a block that says whose they are. They
+     * can be about him, so on a route that holds his details back they stay on the phone
+     * like her notes about him. This prompt, for a reply of hers or for a moment of her
+     * own ([inOwnTime]), is the only thing that reads them. [nowMillis] is the one time
+     * everything in the prompt that goes by the clock is counted from: the ages of her
+     * notes and of her thoughts, and the time of her next moment.
+     */
+    suspend fun chatSystemPrompt(
+        config: LLMConfig,
+        relevantContext: String,
+        deviceActivity: List<String>,
+        screenshotAttached: Boolean,
+        ownActions: Boolean = config.personaActionsEnabled,
+        cues: List<PersonaLibraryText.Cue> = emptyList(),
+        ownPicture: OwnPicture? = null,
+        inOwnTime: Boolean = false,
+        nowMillis: Long = clock(),
+        shownNotes: ((Set<String>) -> Unit)? = null,
+        withLibrary: Boolean = true,
+        onOuting: Boolean = false,
+        onLook: Boolean = false
+    ): String {
+        seedOnce()
+        val owner = ownerName()
+        val route = RouteClassifier.personaRoute(config)
+        val heldBack = config.holdsBackDetails(route)
+        // Read once: her next moment and her sleep are told from the same state.
+        val ownTime = memory.ownTime()
+        val bounds = PersonaOwnTime.Bounds.of(config)
+        val timeIsOn = PersonaOwnTime.isOn(config)
+        // A moment of her own has room for more of what she thought: it is where she looks back.
+        val allPictures = pictures.list()
