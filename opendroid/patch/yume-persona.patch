+    /** [index] with no more than the store may hold: the newest background picture and the first [MAX_SELF] of her. */
+    private fun withinLimits(index: Index): Index {
+        val background = index.pictures.lastOrNull { it.kind == PersonaPicture.Kind.BACKGROUND }
+        var selfLeft = MAX_SELF
