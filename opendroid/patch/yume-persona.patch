+    /**
+     * Whether her thoughts are in her prompts on her route as things are set: where his
+     * details are held back they are left out, and an outing's step says nothing of them.
+     */
+    fun thoughtsShown(config: LLMConfig): Boolean = !config.holdsBackDetails(RouteClassifier.personaRoute(config))
+
+    /**
+     * She is back from an outing at [nowMillis]: what she did on it ([outing]) is kept
+     * for her next moment, and that moment is brought forward ([PersonaOwnTime.cameBack]):
+     * a minute from now at the earliest, never closer to her last moment than his least
+     * gap, and never before the day has room. Asleep, or with her own time off, only what
+     * she did is kept. Never fails the caller.
+     */
+    suspend fun outingCameBack(outing: PersonaOwnTime.LastOuting, nowMillis: Long = System.currentTimeMillis()) {
+        try {
+            val config = settingsRepository.llmConfig.first()
+            val bounds = PersonaOwnTime.Bounds.of(config)
+            val wake = ownTimeLock.withLock {
+                val state = memory.ownTime()
+                val back = if (ownTimeIsOn(config) && !inOwnMoment.get()) {
+                    PersonaOwnTime.cameBack(state, outing, nowMillis, bounds)
+                } else {
+                    state.copy(lastOuting = outing)
+                }
+                memory.saveOwnTime(back)
+                (back.wake as? PersonaOwnTime.Wake.At)?.atMillis?.takeIf { back.why == PersonaOwnTime.Why.CAME_BACK && back.wake != state.wake }
+            }
+            if (wake != null) ownTimeAlarm.set(wake)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her coming back was not stored: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * A go: line of hers that did not start ([missed]), stored so that her next moment
+     * tells her. Never fails the caller.
+     */
+    suspend fun goMissed(missed: PersonaOwnTime.GoMissed) {
+        try {
+            ownTimeLock.withLock { memory.saveOwnTime(memory.ownTime().copy(goMissed = missed)) }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "A go: line that did not start was not stored: ${e.javaClass.simpleName}")
+        }
+    }
+
+    private fun ownerName(): String =
+        (userProfileStore.read() as? ProfileStoreResult.Success)?.value?.name.orEmpty()
+
+    /**
+     * What a page of her notebook is told about where her notes came from: the words her
+     * files give her starting notes, in this build and in earlier ones, so that a note
+     * that still has them is shown as one of her files' ([PersonaNotes.Origins]); and,
+     * with [withMarks], her marks of how she knows a note, for a page that does not list
+     * them apart. Read on the phone, from the files the build ships and what is stored.
+     */
+    private suspend fun origins(withMarks: Boolean = true): PersonaNotes.Origins = PersonaNotes.Origins.of(
+        store.seedNotes(),
+        store.previousSeedNotes(),
+        if (withMarks) memory.how() else emptyMap()
+    )
+
+    /**
+     * Writes her starting notes the first time in this process that her notebook is put
+     * in front of her: a prompt of hers, her notebook pass or her sleep pass, whichever
+     * comes first (a new build can start in her sleep). A reply that is cut short while
+     * they are being written leaves the job open, and the next one writes the notes that
+     * are still missing ([PersonaMemory.seedIfNeeded]).
+     *
+     * Then a starting note that an older build wrote and she never rewrote is given the
+     * wording of this build ([PersonaMemory.refreshStartingNotes]), once for each version.
+     * A call that comes while this runs waits for it, so that no page of hers is read
+     * from her notebook as it was before.
+     */
+    private suspend fun seedOnce() {
+        if (seeded) return
+        seedLock.withLock {
+            if (seeded) return
+            try {
+                val seed = store.seedNotes()
+                memory.seedIfNeeded(seed)
+                memory.refreshStartingNotes(seed, store.previousSeedNotes())
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "Seed notes were not written: ${e.javaClass.simpleName}")
+            }
+            seeded = true
+        }
+    }
