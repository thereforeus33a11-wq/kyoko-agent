+// ── "Try picture models". Each sentence says what the code does, and a test holds them against it.
+
+internal const val PICTURE_MODELS_TITLE = "TRY PICTURE MODELS"
+
+/** Over the choices: what a try makes, what it costs, what is checked and what is kept. */
+internal const val PICTURE_MODELS_HINT =
+    "One test picture of her for each model you tick: a selfie in her usual outfit on a Tokyo street at night, the same " +
+        "scene and the same seed for every model, so you can compare them side by side. Each is made on your Venice key " +
+        "at the price shown, on Venice's Private tier. Every test picture goes through the age check first, like any " +
+        "picture of her: one it does not pass as an adult is thrown away unseen and counted, and you are told so in its " +
+        "place. The pictures stay on this screen only: they are not added to her pictures and are gone when you leave."
+
+/** Under the match switch. */
+internal const val PICTURE_MODELS_MATCH_HINT =
+    "Matched to her pictures: each new picture is sent once more with two of her originals or masters, so it is her " +
+        "face, hair and metal, as her own pictures are when that setting is on. About 4 cents more for each generate model."
+
+/** Above the edit models: what they do in a try. */
+internal const val PICTURE_MODELS_EDIT_NOTE =
+    "Edit models make the test picture out of her first original (or master) picture, the way her pictures were made before. Never out of a picture a model made."
+
+/**
+ * "Try picture models": the models with their prices to tick, the match switch, the price of
+ * the try, Start or Stop, and the test pictures side by side as they come back, each with
+ * what it cost and a tap to make that model hers.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PictureModelsScreen(viewModel: PictureModelsViewModel, onNavigateBack: () -> Unit) {
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(text = PICTURE_MODELS_TITLE, fontFamily = FontFamily.Monospace, fontWeight = FontWeight.Bold, color = TextPrimary, fontSize = 20.sp)
+                },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(imageVector = Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back", tint = TextPrimary)
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBackground)
+            )
+        },
+        containerColor = DarkBackground
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .padding(horizontal = 16.dp, vertical = 8.dp)
+                .verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            Text(text = PICTURE_MODELS_HINT, fontSize = 12.sp, color = TextSecondary)
+            viewModel.current?.let { (generate, edit) ->
+                Text(text = "Now: new pictures with $generate, small changes with $edit.", fontSize = 11.sp, color = AccentCyan)
+            }
+            ModelGroup("NEW PICTURES", viewModel.models.filter { it.kind == PictureModels.Kind.GENERATE }, viewModel)
+            ModelGroup("EDIT MODELS", viewModel.models.filter { it.kind == PictureModels.Kind.EDIT }, viewModel)
+            Text(text = PICTURE_MODELS_EDIT_NOTE, fontSize = 10.sp, color = TextSecondary)
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Column(modifier = Modifier.weight(1f).padding(end = 12.dp)) {
+                    Text(text = "Match to her pictures", fontSize = 14.sp, fontWeight = FontWeight.SemiBold, color = TextPrimary)
+                    Text(text = PICTURE_MODELS_MATCH_HINT, fontSize = 10.sp, color = TextSecondary)
+                }
+                Switch(checked = viewModel.match, onCheckedChange = viewModel::updateMatch, enabled = !viewModel.running)
+            }
+            Text(
+                text = "This try: about ${PictureModels.cents(viewModel.cost())} on your Venice key, and a fraction of a cent for each age check.",
+                fontSize = 12.sp,
+                color = TextPrimary
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {
+                if (viewModel.running) {
+                    OutlinedButton(onClick = viewModel::stop) { Text("STOP") }
+                    CircularProgressIndicator(modifier = Modifier.padding(start = 4.dp), strokeWidth = 2.dp)
+                } else {
+                    Button(onClick = viewModel::start) { Text("MAKE TEST PICTURES") }
+                }
+            }
+            if (viewModel.status.isNotEmpty()) Text(text = viewModel.status, fontSize = 12.sp, color = AccentCyan)
+            // Side by side, two to a row.
+            viewModel.rows.chunked(2).forEach { pair ->
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    pair.forEach { row -> TrialTile(row, viewModel, Modifier.weight(1f)) }
+                    if (pair.size == 1) Box(modifier = Modifier.weight(1f))
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ModelGroup(title: String, models: List<PictureModels.Model>, viewModel: PictureModelsViewModel) {
+    Text(text = title, fontSize = 11.sp, fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace, color = AccentCyan)
+    models.forEach { model ->
+        Row(
+            modifier = Modifier.fillMaxWidth().clickable(enabled = !viewModel.running) { viewModel.toggle(model) },
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Checkbox(checked = model.id in viewModel.chosen, onCheckedChange = { viewModel.toggle(model) }, enabled = !viewModel.running)
+            Column(modifier = Modifier.weight(1f)) {
+                Text(text = "${model.label} · ${PictureModels.cents(model.price)}", fontSize = 13.sp, color = TextPrimary)
+                Text(text = model.note, fontSize = 10.sp, color = TextSecondary)
+            }
+        }
+    }
+}
+
+@Composable
+private fun TrialTile(row: PictureModelsViewModel.Row, viewModel: PictureModelsViewModel, modifier: Modifier) {
+    Column(
+        modifier = modifier
+            .border(1.dp, BorderColor, RoundedCornerShape(10.dp))
+            .padding(8.dp),
+        verticalArrangement = Arrangement.spacedBy(4.dp)
+    ) {
+        Text(text = row.model.label, fontSize = 12.sp, fontWeight = FontWeight.SemiBold, color = TextPrimary)
+        val bytes = row.bytes
+        val image = remember(bytes) { bytes?.let { BitmapFactory.decodeByteArray(it, 0, it.size)?.asImageBitmap() } }
+        when {
+            image != null -> Image(
+                bitmap = image,
+                contentDescription = "Test picture made with ${row.model.label}",
+                contentScale = ContentScale.Fit,
+                modifier = Modifier.fillMaxWidth().aspectRatio(2f / 3f).clip(RoundedCornerShape(6.dp))
+            )
+            !row.done -> Box(modifier = Modifier.fillMaxWidth().aspectRatio(2f / 3f), contentAlignment = Alignment.Center) {
+                Text(text = "waiting", fontSize = 11.sp, color = TextSecondary)
+            }
+            else -> Text(text = row.why.ifEmpty { "No picture came back." }, fontSize = 11.sp, color = if (row.thrownAway) AccentCyan else TextSecondary)
+        }
+        val cost = "${PictureModels.cents(row.cost)}" + (row.seconds?.let { " · $it s" } ?: "")
+        Text(text = cost, fontSize = 10.sp, color = TextSecondary)
+        if (row.note.isNotEmpty()) Text(text = row.note, fontSize = 10.sp, color = TextSecondary)
+        if (image != null) {
+            TextButton(onClick = { viewModel.use(row.model) }) {
+                Text(if (row.model.kind == PictureModels.Kind.GENERATE) "USE FOR NEW PICTURES" else "USE FOR CHANGES", fontSize = 11.sp)
+            }
+        }
+    }
+}
