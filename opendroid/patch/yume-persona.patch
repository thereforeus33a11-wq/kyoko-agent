+    }
+
+    // ── What a fetch sends and takes ─────────────────────────────────────────────────
+
+    @Test
+    fun `no cookies, no referer, no language and a generic user agent`() = runBlocking {
+        serve { html("<p>hi</p>").newBuilder().addHeader("Set-Cookie", "session=abc; Path=/").build() }
+        val fetcher = fetcher()
