+        assertEquals(1, memory.refreshStartingNotes(nextBuild + later, earlier + voice))
+        assertEquals(later.text, stored(later)!!.value)
+        assertEquals(null, stored(rig))
+    }
+
+    @Test
+    fun `with the files this build ships, a phone holding any earlier wording of a starting note it still has gets the current one`() = runBlocking {
+        val assets = java.io.File("src/main/assets")
+        val shipped = PersonaStore(context) { path -> java.io.File(assets, path).takeIf { it.isFile }?.readText().orEmpty() }
+        val current = shipped.seedNotes().associateBy { it.storageKey }
+        val previous = shipped.previousSeedNotes()
+        // A build made without her files has nothing to look at.
+        if (current.isEmpty() || previous.isEmpty()) return@runBlocking
+        val lines = java.io.File(assets, "persona/seed_notes.previous.txt").readLines()
+            .filter { it.isNotBlank() && !it.trim().startsWith("#") }
+        assertEquals("every line of the file is a note", lines.size, previous.size)
+
+        for (old in previous.filter { it.storageKey in current }) {
+            anotherPhone()
+            memory.seedIfNeeded(listOf(old))
+            memory.refreshStartingNotes(current.values.toList(), previous)
+            assertEquals(old.toLine(), current.getValue(old.storageKey).text, stored(old)!!.value)
+        }
+    }
+
+    private fun earlierText(row: Memory): String = Regex("\"t\":\"([^\"]*)\"").find(row.value)!!.groupValues[1]
+}
