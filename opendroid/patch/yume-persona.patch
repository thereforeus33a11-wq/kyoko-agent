+    private lateinit var repository: MemoryRepository
+    private lateinit var memory: PersonaMemory
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        dao = CountedDao(database.memoryDao())
+        repository = MemoryRepository(memoryDao = dao, taskHistoryDao = database.taskHistoryDao(), macroDao = database.macroDao())
+        memory = PersonaMemory(repository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    /** Another phone: a notebook of its own. */
+    private fun anotherPhone() {
+        database.close()
+        setUp()
+    }
+
+    /** Counts how often her notebook is read by prefix and how often a row is written or deleted. */
+    private class CountedDao(private val dao: MemoryDao) : MemoryDao by dao {
+        var prefixReads = 0
+        var writes = 0
+
+        override suspend fun getMemoriesByKeyPrefix(prefix: String): List<MemoryEntity> {
+            prefixReads++
+            return dao.getMemoriesByKeyPrefix(prefix)
+        }
+
+        override suspend fun insertOrUpdateMemory(memory: MemoryEntity) {
+            writes++
+            dao.insertOrUpdateMemory(memory)
+        }
+
+        override suspend fun deleteMemory(key: String) {
+            writes++
+            dao.deleteMemory(key)
+        }
+    }
+
+    // Two earlier wordings of one starting note, and the one this build has.
+    private val oldestVoice = Note(
+        Kind.THREAD, "own-voice",
+        "she wants her own synthesized voice: low for her size, slow, a little raspy, with a grin in it; it does not exist yet | open"
+    )
+    private val oldVoice = Note(
+        Kind.THREAD, "own-voice",
+        "i want my own synthesized voice: low for my size, slow, a little raspy, with a grin in it; it does not exist yet | open"
+    )
+    private val voice = Note(
+        Kind.THREAD, "own-voice",
+        "my own voice speaks my lines on the phone now, made there from my words. only a first build; i want it finished | open"
+    )
+    private val oldBoots = Note(Kind.THREAD, "boots", "street story: left boot lost a gold buckle; i am 13,000 short | open")
+    private val boots = Note(Kind.THREAD, "boots", "street story: left boot lost a gold buckle; i have 11,000 yen toward the pair | open")
+    private val oldBuilder = Note(Kind.USER, "builder", "he has been around about two months, building her and poking at her model")
+    private val builder = Note(Kind.USER, "builder", "he has been around about two months, building me and poking at my model")
+    private val miku = Note(Kind.OPINION, "miku", "a singing girl who never gets tired is a little funny")
+
+    /** What an older build wrote as her starting notes. */
+    private val olderBuild = listOf(oldBuilder, miku, oldBoots, oldVoice)
+
+    /** The starting notes of this build, and the file of their earlier wordings, comments and all. */
+    private val thisBuild = listOf(builder, miku, boots, voice)
+    private val previousFile = """
+        # Earlier wordings of her starting notes, from older builds.
+        ${oldestVoice.toLine()}
+        ${oldBoots.toLine()}
+        ${oldBuilder.toLine()}
+        ${oldVoice.toLine()}
+    """.trimIndent()
+    private val earlier = PersonaStore(context) { path -> if (path == "persona/seed_notes.previous.txt") previousFile else "" }.previousSeedNotes()
+
+    private suspend fun stored(note: Note): Memory? = repository.getMemory(note.storageKey)
+
+    private suspend fun archived(note: Note): List<Memory> {
+        val prefix = PersonaMemory.ARCHIVE_PREFIX + note.storageKey.removePrefix(PersonaNotes.KEY_PREFIX) + "."
+        return repository.getMemoriesByKeyPrefix(prefix).filter { it.key.startsWith(prefix) }
+    }
+
+    @Test
+    fun `the file of earlier wordings keeps every wording of a key, and comments are no notes`() {
+        assertEquals(listOf(oldestVoice, oldBoots, oldBuilder, oldVoice), earlier)
+    }
+
+    @Test
+    fun `a starting note she never rewrote is given this build's wording, keeps its place and age, and its old text goes to her archive`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        // A note of her own, newer than every starting note, and a mark she gave the old wording.
+        memory.apply(listOf(Note(Kind.ME, "soda", "melon soda is mine")))
+        memory.updateHow { mapOf(oldVoice.storageKey to PersonaNotes.How.LIVED, miku.storageKey to PersonaNotes.How.LIVED) }
+        val writtenAt = memory.writtenAt()
+        val order = memory.notes().map { it.key }
+
+        assertEquals(3, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(voice.text, stored(voice)!!.value)
+        assertEquals(boots.text, stored(boots)!!.value)
+        assertEquals(builder.text, stored(builder)!!.value)
+        // Its place and its age: nothing of it is new.
+        assertEquals(order, memory.notes().map { it.key })
+        assertEquals(writtenAt, memory.writtenAt())
+        // The old text is in her archive, the way a note written over is, with her mark.
+        val kept = archived(voice).single()
+        assertEquals("yume.meta.archive.thread.own-voice.${writtenAt.getValue(voice.storageKey)}", kept.key)
+        assertTrue(kept.value, kept.value.contains("\"t\":\"${oldVoice.text}\""))
+        assertTrue(kept.value, kept.value.contains("\"why\":\"replaced\""))
+        assertTrue(kept.value, kept.value.contains("\"how\":\"LIVED\""))
+        assertEquals(3, memory.archiveCount())
+        // The mark said how she knew the old text, and went with it; the note that did not change keeps its own.
+        assertEquals(mapOf(miku.storageKey to PersonaNotes.How.LIVED), memory.how())
+        // It is not something she let go, and nothing is there to bring back.
+        assertTrue(memory.archivedLately(10).isEmpty())
+        assertTrue(memory.restorableKeys().isEmpty())
+        assertEquals(5, memory.notes().size)
+    }
