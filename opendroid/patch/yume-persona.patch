+++ b/app/src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt
@@ -0,0 +1,133 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import com.opendroid.ai.actions.base.Action
+import com.opendroid.ai.actions.base.ActionResult
+
+import com.opendroid.ai.core.persona.PersonaPictures
+import com.opendroid.ai.core.persona.PersonaSelfPictures
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnPurpose
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.first
+import okhttp3.OkHttpClient
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/** The phone action by which she makes a new picture of herself ([PersonaSelfPictures]). */
+@Singleton
+class PersonaPictureActions @Inject constructor(
+    private val pictures: PersonaPictures,
+    private val memory: com.opendroid.ai.core.persona.PersonaMemory,
+    private val store: com.opendroid.ai.core.persona.PersonaStore,
+    private val settingsRepository: SettingsRepository,
+    private val userProfileStore: UserProfileStore,
+    private val client: OkHttpClient
+) {
+    fun getActions(): List<Action> = listOf(MakeSelfPictureAction())
+
+    private inner class MakeSelfPictureAction : Action {
+        override val name: String = NAME
+
+        override suspend fun execute(params: Map<String, String>, context: Context): ActionResult {
+            val config = settingsRepository.llmConfig.first()
+            // A picture of her, made only while she is the one who talks (PersonaEngine.isActive).
+            if (!config.personaEnabled || store.card().isBlank()) {
+                return ActionResult(false, null, "She is switched off, so no picture of her is made.")
+            }
+            PersonaSelfPictures.notAllowed(config)?.let { return ActionResult(false, null, it) }
+            // In her own time her own-time key goes first, where he set one: her own life's limit stands behind it.
+            val key = PersonaSelfPictures.keyFor(config, ownTime = currentCoroutineContext()[OwnCall] != null)
+                ?: return ActionResult(false, null, "No Venice key is set, so no picture can be made.")
+            val ask = params["description"].orEmpty().trim()
+            // A full-body reference of one or more sides ("views"), or one ordinary picture.
+            val views = PersonaSelfPictures.views(params["views"])
+            if (views.isEmpty() || ask.isNotEmpty()) PersonaSelfPictures.refusal(ask)?.let { return ActionResult(false, null, it) }
+            // The words that pick the picture to start from are held to the same rule.
+            PersonaSelfPictures.refusalOfWords(params["from"])?.let { return ActionResult(false, null, it) }
+            val notes = memory.notes()
+            val owner = (userProfileStore.read() as? ProfileStoreResult.Success)?.value?.name.orEmpty()
+            // What her notes know of him: her words must not carry any of it out.
+            val hisNotes = notes.filter {
+                it.kind == com.opendroid.ai.core.persona.PersonaNotes.Kind.USER ||
+                    it.kind == com.opendroid.ai.core.persona.PersonaNotes.Kind.REL
+            }.joinToString("\n") { it.text }
+            PersonaSelfPictures.carriesHisDetails(ask, hisNotes)?.let { return ActionResult(false, null, it) }
+            val base = PersonaSelfPictures.base(pictures.list(), params["from"])
+                ?: return ActionResult(false, null, "She has no picture of herself yet to start from. Add one in Settings, Persona.")
+            val baseImage = pictures.base64(base.id)
+                ?: return ActionResult(false, null, "The picture to start from could not be read.")
+            val words = PersonaSelfPictures.withoutHim(ask, owner)
+            val look = try {
+                context.assets.open(PICTURES_FILE).bufferedReader().use { it.readText() }
+            } catch (e: Exception) {
+                ""
+            }.let(PersonaSelfPictures::look)
+            val age = com.opendroid.ai.core.persona.PersonaAge.on(System.currentTimeMillis())
+            // How she looks now, as she has noted it herself: newer than her files.
+            val lookNow = PersonaSelfPictures.lookNow(notes, owner)
+            if (views.isEmpty()) {
+                val prompt = PersonaSelfPictures.prompt(words, look, age, lookNow)
+                return when (val made = make(key, config.personaPictureModel, baseImage, prompt, PersonaSelfPictures.caption(words))) {
+                    is Outcome.Kept -> ActionResult(true, made.line, null)
+                    is Outcome.NotKept -> ActionResult(false, null, made.why)
+                }
+            }
+            // One request per side, one after the other, each kept as it comes: a side that
+            // fails is said as such, and the ones that were made stay made.
+            val lines = views.map { view ->
+                val prompt = PersonaSelfPictures.referencePrompt(view, words, look, age, lookNow)
+                when (val made = make(key, config.personaPictureModel, baseImage, prompt, PersonaSelfPictures.referenceCaption(view, words))) {
+                    is Outcome.Kept -> made.line
+                    is Outcome.NotKept -> "Not made: the ${view.word} view. ${made.why}"
+                }
+            }
+            val anyMade = lines.any { it.startsWith(MADE_PREFIX) }
+            return if (anyMade) ActionResult(true, lines.joinToString("\n"), null) else ActionResult(false, null, lines.joinToString("\n"))
+        }
+
+        private suspend fun make(key: String, model: String, baseImage: String, prompt: String, caption: String): Outcome {
+            val body = PersonaSelfPictures.body(model = model, imageBase64 = baseImage, prompt = prompt)
+            // A picture made in her own time is a call of hers: written down at this call
+            // site, since it does not go through her model (her ledger, OwnPurpose.PICTURE).
+            val own = currentCoroutineContext()[OwnCall]
+            val made = try {
+                PersonaSelfPictures.request(client, key, body)
+            } catch (e: kotlinx.coroutines.CancellationException) {
+                own?.recordAs(OwnPurpose.PICTURE, model, ok = false)
+                throw e
+            }
+            own?.recordAs(OwnPurpose.PICTURE, model, ok = made is PersonaSelfPictures.Made.Picture)
+            return when (made) {
+                is PersonaSelfPictures.Made.Failed -> Outcome.NotKept(made.why)
+                is PersonaSelfPictures.Made.Picture ->
+                    when (val stored = pictures.addMade(made.bytes, caption)) {
+                        is PersonaPictures.Added.Stored -> Outcome.Kept("$MADE_PREFIX${stored.picture.id}): ${stored.picture.caption}")
+                        else -> Outcome.NotKept("A picture came back but could not be kept on the phone.")
+                    }
+            }
+        }
+    }
+
+    private sealed class Outcome {
+        class Kept(val line: String) : Outcome()
+        class NotKept(val why: String) : Outcome()
+    }
+
+    companion object {
+        const val NAME = "MAKE_SELF_PICTURE"
+
+        /** Her picture file as the build puts it into the app (tools/prepare_assets.sh). */
+        const val PICTURES_FILE = "persona/library/kisaragi-pics.md"
+
+        /** See [PersonaSelfPictures.MADE_PREFIX]. */
+        const val MADE_PREFIX = PersonaSelfPictures.MADE_PREFIX
+
+        fun madePictureIds(text: String?): List<String> = PersonaSelfPictures.madePictureIds(text)
+
+        fun shownWithoutIds(text: String): String = PersonaSelfPictures.shownWithoutIds(text)
+    }
+}
