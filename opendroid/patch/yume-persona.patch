+        val file = File(folder.root, "persona/her_log.json").readText()
+        assertFalse(file.contains("DROPPED_SENTINEL"))
+        assertFalse(file.contains("KID_PAGE_SENTINEL"))
+        assertEquals("Kids skipped in 24 h: 1. Lines of hers about a kid not kept: 2.", HerLog.kidsLine(log.entries(), now.get()))
+    }
+
+    @Test
+    fun `without a kid in front of her, nothing she writes is checked`() {
