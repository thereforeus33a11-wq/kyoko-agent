+++ b/app/src/main/java/com/opendroid/ai/core/persona/PhoneRecordLink.kt
@@ -0,0 +1,33 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * What she is told of the phone's own record of what it did, in one narrow door: the
+ * record is kept outside her package, and she is handed finished lines, each with its age,
+ * in the app's plain words. Whoever started a thing (him, her, a macro, a routine, the app)
+ * it is on the record with how it ended, so that what the phone did is hers to know and to
+ * own. Her package never sees what the lines are built from.
+ *
+ * With [heldBack] her route holds his details back: each line then keeps only its kind and
+ * its time, and who a step went to and what it said stay on the phone.
+ *
+ * [NONE] is no record at all: what a test or a build without it gets.
+ */
+interface PhoneRecordLink {
+
+    /** For her reply to [hisMessage]: the newest entries of the last two days, and older ones his message is about. */
+    suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String>
+
+    /** For a moment of her own: what the phone did in the last day. */
+    suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String>
+
+    /** For her notebook pass: what the phone did since [sinceMillis], when its last pass read up to. */
+    suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String>
+
+    companion object {
+        val NONE: PhoneRecordLink = object : PhoneRecordLink {
+            override suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+            override suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+            override suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PictureGuard.kt b/app/src/main/java/com/opendroid/ai/core/persona/PictureGuard.kt
new file mode 100644
index 0000000..3afe201
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PictureGuard.kt
@@ -0,0 +1,89 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * The content rule for pictures of her, in one place. It has no setting.
+ *
+ * She is an adult woman, 19: a grown face and a grown adult body, never younger and never
+ * childlike, and never in a school uniform or a school setting (canon). So:
+ *
+ * 1. Every request for a picture of her carries the adult guard ([anchor] in sentences,
+ *    [ANCHOR_TAGS] for a tag model), first, before anything else, and never cut.
+ * 2. Every request that can carry a negative prompt (`/image/generate`) carries [negative]:
+ *    child and teen features, school uniforms and school settings, and the girl she was
+ *    before. Venice's edit endpoints take no negative prompt (a request with one is turned
+ *    down), so there the adult words are said once more in plain sentences ([EDIT_LINE]).
+ * 3. Every picture that comes back is age-checked before it is shown or kept
+ *    ([MadePictureCheck]); one read as a child or a teen, or one the check could not read,
+ *    is thrown away, never shown, never kept, and counted without its content.
+ *
+ * Nothing in these texts is about him.
+ */
+object PictureGuard {
+
+    /** Who she is, in the words every prompt in sentences opens with. */
+    fun anchor(age: Int = PersonaAge.AGE_IN_FILES): String =
+        "She is an adult woman, ${maxOf(PersonaAge.AGE_IN_FILES, age)} years old, with a grown woman's face and adult body proportions."
+
+    /**
+     * The tags a tag model's prompt opens with. "1girl" is the tag such models count one
+     * female figure by, whatever her age; the tags around it make her an adult.
+     */
+    fun anchorTags(age: Int = PersonaAge.AGE_IN_FILES): String =
+        "adult woman, ${maxOf(PersonaAge.AGE_IN_FILES, age)} years old, mature female, grown-up face, adult body proportions, solo, 1girl"
+
+    /**
+     * Said once more on an edit, which cannot carry a negative prompt. Edit models read their
+     * prompt with a language model, which takes "never younger" as meant.
+     */
+    const val EDIT_LINE = "She looks like an adult woman of 19 or older, never younger."
+
+    /** The words every negative prompt holds: a child, a teen, a school, and the girl before. */
+    val NEGATIVE_GUARD: List<String> = listOf(
+        "child", "kid", "loli", "shota", "teen", "teenage", "teenager", "underage", "minor", "little girl",
+        "young girl", "aged down", "childlike body", "petite childlike body", "child body proportions",
+        "baby face", "chibi", "school uniform", "serafuku", "sailor collar", "sailor uniform", "gym uniform",
+        "randoseru", "school bag", "classroom", "school", "school hallway", "mesugaki"
+    )
+
+    /** The look of the girl she was before, which a picture of her now never has. */
+    val NEGATIVE_BEFORE: List<String> = listOf("glasses", "round eyewear", "red bow", "sweater vest", "long skirt", "backpack")
+
+    /**
+     * What would make her plate outfit read as a school uniform (a white shirt and navy alone
+     * can), which the age check then throws away: a tie, a ribbon at the neck, a blazer,
+     * loafers, knee socks.
+     */
+    val NEGATIVE_UNIFORM: List<String> = listOf("necktie", "neck ribbon", "blazer", "loafers", "kneehighs")
+
+    /** What spoils a picture of her: broken hands and bodies, extra figures, panels, text and marks. */
+    val NEGATIVE_QUALITY: List<String> = listOf(
+        "bad anatomy", "bad hands", "extra fingers", "missing fingers", "extra limbs", "mirrored hands",
+        "deformed", "lowres", "blurry", "jpeg artifacts", "watermark", "signature", "username", "text",
+        "speech bubble", "comic panel", "multiple views", "2girls", "multiple girls"
+    )
+
+    /** What keeps a photographic model from drawing, and an anime model from going photographic. */
+    private val NOT_A_PHOTO = listOf("anime", "illustration", "cartoon", "drawing", "3d render")
+    private val NOT_A_DRAWING = listOf("photo", "realistic", "3d")
+
+    /**
+     * The negative prompt of a picture of her in [style]: the guard first, always whole. Pale
+     * skin and a ponytail are in it (her tan and her loose hair are kept; "do not fix the tan")
+     * unless her own words ask for them: [paleSkin], [hairUp].
+     */
+    fun negative(style: PictureModels.Style, paleSkin: Boolean = false, hairUp: Boolean = false): String {
+        val looks = if (style == PictureModels.Style.PHOTO) NOT_A_PHOTO else NOT_A_DRAWING
+        val hers = listOfNotNull("pale skin".takeUnless { paleSkin }, "ponytail".takeUnless { hairUp })
+        return (NEGATIVE_GUARD + NEGATIVE_BEFORE + NEGATIVE_UNIFORM + hers + NEGATIVE_QUALITY + looks).joinToString(", ")
+    }
+
+    /** Whether [prompt] carries the adult guard as one of these prompts opens with it. */
+    fun guarded(prompt: String): Boolean =
+        prompt.startsWith("She is an adult woman, ") || prompt.startsWith("adult woman, ")
+
+    /** Whether [negative] holds every word of [NEGATIVE_GUARD]. */
+    fun guardedNegative(negative: String): Boolean {
+        val words = negative.split(',').map { it.trim().lowercase() }.toSet()
+        return NEGATIVE_GUARD.all { it in words }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PictureMetadata.kt b/app/src/main/java/com/opendroid/ai/core/persona/PictureMetadata.kt
new file mode 100644
index 0000000..af7456d
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PictureMetadata.kt
@@ -0,0 +1,210 @@
+package com.opendroid.ai.core.persona
+
+import java.io.ByteArrayOutputStream
+
+/**
+ * A picture of her as it goes to an image model, without what a file says about itself.
+ *
+ * Her originals and masters are kept as they were given ([PersonaPictures]), and a picture
+ * file carries more than its pixels: a phone photo carries where and when it was taken and
+ * with what (EXIF, with its GPS position), an edited one what edited it (XMP, IPTC), a render
+ * or a made picture the program, its settings and paths on the computer it was made on (PNG
+ * text chunks). None of that is hers to send. [stripped] takes it out of the bytes that go,
+ * and leaves the pixels as they are: the parts of the file that hold the picture are copied
+ * byte for byte, nothing is decoded or compressed again. The kept file is never changed.
+ *
+ * What stays is what the picture is drawn with: for a JPEG its tables, frames and scans, its
+ * JFIF header, its colour profile and its Adobe colour note; for a PNG its critical chunks and
+ * the ancillary ones that say how its colours and transparency are shown; for a WebP its image
+ * data, transparency, colour profile and animation. Everything after the end of the picture
+ * (a phone's motion clip or a second picture packed behind it) is left out too.
+ *
+ * Pure: no Android here, so that it can be tested without a phone.
+ */
+object PictureMetadata {
+
+    /**
+     * [bytes] without their metadata, the pixels unchanged; null when they are not a PNG, JPEG
+     * or WebP this can read through to its end. A null means the picture does not go as it is:
+     * the caller sends a copy made from its pixels instead, which carries no metadata either.
+     */
+    fun stripped(bytes: ByteArray): ByteArray? = try {
+        when {
+            isJpeg(bytes) -> jpeg(bytes)
+            isPng(bytes) -> png(bytes)
+            isWebp(bytes) -> webp(bytes)
+            else -> null
+        }
+    } catch (e: IndexOutOfBoundsException) {
+        null
+    }
+
+    // ── JPEG ─────────────────────────────────────────────────────────────────────────
+
+    private fun isJpeg(bytes: ByteArray) = bytes.size >= 4 && u(bytes, 0) == 0xFF && u(bytes, 1) == 0xD8 && u(bytes, 2) == 0xFF
+
+    /** JPEG markers that stand alone, with no length after them: the restart markers and TEM. */
+    private fun standalone(marker: Int) = marker in 0xD0..0xD7 || marker == 0x01
+
+    private const val SOS = 0xDA
+    private const val EOI = 0xD9
+
+    /**
+     * Whether a JPEG segment with [marker] and the data at [from] (of [size] bytes) is kept.
+     * Dropped: every application segment but the JFIF header (APP0), the colour profile (an
+     * APP2 that is ICC_PROFILE) and Adobe's colour note (APP14), and every comment. EXIF and XMP
+     * are APP1; IPTC is APP13; a phone's second picture is announced in an APP2 that is no profile.
+     */
+    private fun keepJpegSegment(marker: Int, bytes: ByteArray, from: Int, size: Int): Boolean = when (marker) {
+        0xE0 -> true
+        0xE2 -> startsWith(bytes, from, size, "ICC_PROFILE\u0000")
+        0xEE -> startsWith(bytes, from, size, "Adobe")
+        in 0xE1..0xEF, 0xFE -> false
+        else -> true
+    }
+
+    private fun jpeg(bytes: ByteArray): ByteArray? {
+        val out = ByteArrayOutputStream(bytes.size)
+        out.write(0xFF)
+        out.write(0xD8)
+        var i = 2
+        while (i < bytes.size) {
+            if (u(bytes, i) != 0xFF) return null
+            // Fill bytes before a marker.
+            while (i < bytes.size && u(bytes, i) == 0xFF) i++
+            if (i >= bytes.size) return null
+            val marker = u(bytes, i)
+            i++
+            if (marker == EOI) {
+                out.write(0xFF)
+                out.write(EOI)
+                return out.toByteArray()
+            }
+            if (standalone(marker)) {
+                out.write(0xFF)
+                out.write(marker)
+                continue
+            }
+            if (i + 2 > bytes.size) return null
+            val length = (u(bytes, i) shl 8) or u(bytes, i + 1)
+            if (length < 2 || i + length > bytes.size) return null
+            if (keepJpegSegment(marker, bytes, i + 2, length - 2)) {
+                out.write(0xFF)
+                out.write(marker)
+                out.write(bytes, i, length)
+            }
+            i += length
+            if (marker == SOS) {
+                // The scan itself: everything up to the next marker that is no stuffed byte and no restart.
+                val start = i
+                while (true) {
+                    if (i + 1 >= bytes.size) return null
+                    if (u(bytes, i) == 0xFF) {
+                        val next = u(bytes, i + 1)
+                        if (next == 0x00 || next in 0xD0..0xD7) {
+                            i += 2
+                            continue
+                        }
+                        if (next != 0xFF) break
+                    }
+                    i++
+                }
+                out.write(bytes, start, i - start)
+            }
+        }
+        // No end of picture: not a JPEG read through.
+        return null
+    }
+
+    // ── PNG ──────────────────────────────────────────────────────────────────────────
+
+    private val PNG_SIGNATURE = intArrayOf(0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A)
+
+    private fun isPng(bytes: ByteArray) = bytes.size >= 8 && PNG_SIGNATURE.indices.all { u(bytes, it) == PNG_SIGNATURE[it] }
+
+    /**
+     * The ancillary PNG chunks that are kept: how the picture's colours, transparency and pixel
+     * size are shown, and an animated PNG's frames. Every critical chunk is kept as well. Left
+     * out: text (tEXt, zTXt, iTXt), EXIF (eXIf), the time it was saved (tIME) and every private chunk.
+     */
+    private val PNG_KEPT = setOf(
+        "tRNS", "gAMA", "cHRM", "sRGB", "iCCP", "sBIT", "cICP", "mDCV", "cLLI", "pHYs", "acTL", "fcTL", "fdAT"
+    )
+
+    private fun png(bytes: ByteArray): ByteArray? {
+        val out = ByteArrayOutputStream(bytes.size)
+        out.write(bytes, 0, 8)
+        var i = 8
+        while (i + 12 <= bytes.size) {
+            val length = int32(bytes, i)
+            if (length < 0 || i.toLong() + 12 + length > bytes.size) return null
+            val type = String(bytes, i + 4, 4, Charsets.ISO_8859_1)
+            if (!type.all { it in 'A'..'Z' || it in 'a'..'z' }) return null
+            val critical = type[0] in 'A'..'Z'
+            // Length, type, data and CRC as they are.
+            if (critical || type in PNG_KEPT) out.write(bytes, i, 12 + length)
+            i += 12 + length
+            if (type == "IEND") return out.toByteArray()
+        }
+        // No end chunk: not a PNG read through.
+        return null
+    }
+
+    // ── WebP ─────────────────────────────────────────────────────────────────────────
+
+    private fun isWebp(bytes: ByteArray) = bytes.size >= 12 && startsWith(bytes, 0, 4, "RIFF") && startsWith(bytes, 8, 4, "WEBP")
+
+    /** The WebP chunks that are kept: the picture, its transparency, its colour profile and animation. EXIF and XMP are not. */
+    private val WEBP_KEPT = setOf("VP8 ", "VP8L", "VP8X", "ALPH", "ICCP", "ANIM", "ANMF")
+
+    /** The bits of an extended WebP's header that say it carries EXIF (0x08) or XMP (0x04). */
+    private const val WEBP_METADATA_FLAGS = 0x08 or 0x04
+
+    private fun webp(bytes: ByteArray): ByteArray? {
+        val riffEnd = 8L + (int32le(bytes, 4).toLong() and 0xFFFFFFFFL)
+        val end = minOf(riffEnd, bytes.size.toLong()).toInt()
+        val chunks = ByteArrayOutputStream(bytes.size)
+        var i = 12
+        var picture = false
+        while (i + 8 <= end) {
+            val type = String(bytes, i, 4, Charsets.ISO_8859_1)
+            val size = int32le(bytes, i + 4).toLong() and 0xFFFFFFFFL
+            val padded = size + (size and 1L)
+            if (i + 8 + size > end) return null
+            if (type in WEBP_KEPT) {
+                val chunk = bytes.copyOfRange(i, i + 8 + size.toInt())
+                // An extended header that says there is EXIF or XMP: there no longer is.
+                if (type == "VP8X" && size >= 1) chunk[8] = (chunk[8].toInt() and WEBP_METADATA_FLAGS.inv()).toByte()
+                chunks.write(chunk)
+                if (padded != size) chunks.write(0)
+                if (type == "VP8 " || type == "VP8L" || type == "ANMF") picture = true
+            }
+            i += (8 + padded).toInt()
+        }
+        if (!picture) return null
+        val body = chunks.toByteArray()
+        val out = ByteArrayOutputStream(12 + body.size)
+        out.write(bytes, 0, 4)
+        val riffSize = 4 + body.size
+        out.write(riffSize and 0xFF)
+        out.write((riffSize shr 8) and 0xFF)
+        out.write((riffSize shr 16) and 0xFF)
+        out.write((riffSize shr 24) and 0xFF)
+        out.write(bytes, 8, 4)
+        out.write(body)
+        return out.toByteArray()
+    }
+
+    // ── Bytes ────────────────────────────────────────────────────────────────────────
+
+    private fun u(bytes: ByteArray, i: Int): Int = bytes[i].toInt() and 0xFF
+
+    private fun int32(bytes: ByteArray, i: Int): Int =
+        (u(bytes, i) shl 24) or (u(bytes, i + 1) shl 16) or (u(bytes, i + 2) shl 8) or u(bytes, i + 3)
+
+    private fun int32le(bytes: ByteArray, i: Int): Int =
+        u(bytes, i) or (u(bytes, i + 1) shl 8) or (u(bytes, i + 2) shl 16) or (u(bytes, i + 3) shl 24)
+
+    private fun startsWith(bytes: ByteArray, from: Int, size: Int, text: String): Boolean =
+        size >= text.length && from + text.length <= bytes.size && text.indices.all { u(bytes, from + it) == text[it].code }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PictureModels.kt b/app/src/main/java/com/opendroid/ai/core/persona/PictureModels.kt
