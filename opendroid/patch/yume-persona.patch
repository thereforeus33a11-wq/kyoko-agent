+    private val LINE_BULLET = Regex("""(?m)^\s*(?:[•·▪◦]|[-*+](?=\s))\s*""")
+    private val LINE_HEADING = Regex("""(?m)^\s*#{1,6}\s+""")
+    private val LAUGH = Regex("""(?i)(?<![a-z0-9])w{3,}(?![a-z0-9])""")
+    private val HUM = Regex("""(?i)(?<![a-z0-9])fu{2,}n(?![a-z0-9])""")
+    // "mm" as a reply is a flat hum, and is said as one: "mhm" would be a yes she did not
+    // give. After a number ("5 mm") it is a unit and is left alone. A longer "mmm" is a
+    // sound of its own and stays as typed.
+    private val MM = Regex("""(?<![A-Za-z0-9])(?<!\d )mm(?![A-Za-z0-9])""")
+    private val LONG_RUN = Regex("""([a-z])\1{2,}""")
