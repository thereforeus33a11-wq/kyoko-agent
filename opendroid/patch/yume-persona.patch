+            firstTalk = !inOwnTime && firstTalk()
+        )
+    }
+
+    /**
+     * True when no earlier talk between the two of them is stored on this phone: no line
+     * of hers in any chat, the ones he has left included, none kept for her notebook from
+     * a chat he deleted, no notebook pass that has read any, and no note in her notebook
+     * other than a starting note in the words of her files: a notebook handed over from
+     * another phone, or notes he gave her, hold talk this phone has no rows of. His
+     * message that this reply answers is stored already and is not earlier talk; a reply
+     * of hers to it is. Only yes or no is read, and nothing of what was said. Once it is
+     * false it stays false for this run.
+     */
+    internal suspend fun firstTalk(): Boolean {
+        if (talkedBefore) return false
+        val talked = memory.lastReflectionAt() > 0 ||
+            memory.leftBehind(Long.MIN_VALUE).any { PersonaPrompts.isHers(it.message) } ||
+            memoryManager.episodicMemory.anyRowUnder(PersonaPrompts.BADGE) ||
+            origins(withMarks = false).let { origins -> memory.notes().any { !origins.fromFiles(it) } }
+        if (talked) talkedBefore = true
+        return !talked
+    }
+
+    /**
+     * What lies under her awareness, as her chat prompt gets it: the owner's own wording
+     * when he has saved one, otherwise the text from her files, with his name filled in
+     * the way her pages get it. Empty when he switched it off.
+     *
+     * Only [chatSystemPrompt] asks for it, so it goes into her chat reply and a moment
+     * of her own and into no other request: not her notebook pass, not her line
+     * about a result, not the look at one of her pictures.
+     */
+    private suspend fun underText(config: LLMConfig, ownerName: String): String {
+        if (!config.personaUnderEnabled) return ""
+        val text = withContext(Dispatchers.IO) { store.savedUnderText() } ?: library.bundledUnderText()
+        return underWithOwner(text, ownerName)
+    }
+
+    /**
+     * The picture of herself that goes with her reply to [hisMessage], or null: when her
+     * model cannot be sent images or would not take the last one ([pictureRefused]), when
+     * she has no picture of herself, or when this is not a reply in which she is shown
+     * herself ([PersonaPictureRules.pictureFor]).
+     *
+     * [recent] is the newest stored rows of the chat, his message last, with the
+     * screenshot of his screen on it if this reply carries one. Whether this is her first
+     * reply is a question about the whole chat, not about those rows: a run of commands
+     * pushes her last line out of them. So when they hold no reply of hers, [wholeChat]
+     * is asked for the rows before them as well.
+     *
+     * Her pictures are hers, not facts about him, so they are not held back on any
+     * route. The request that carries one still passes the same gate as every other.
+     * A picture that cannot be read costs her the picture, never the reply.
+     */
+    suspend fun ownPictureFor(
+        config: LLMConfig,
+        recent: List<ChatMessage>,
+        hisMessage: String,
+        wholeChat: suspend () -> List<ChatMessage>
+    ): OwnPicture? {
+        if (!chatSeesImages(config) || pictureRefused(config)) return null
+        return try {
+            val own = pictures.list()
+            if (!PersonaPictureRules.hasOwnPicture(own)) return null
+            val imageAttached = recent.any { it.imageBase64 != null }
+            // The chat is read back only where the answer decides something.
+            val firstReply = !imageAttached && !PersonaPictureRules.holdsReplyOfHers(recent) &&
+                !PersonaPictureRules.holdsReplyOfHers(wholeChat())
