+        engine.afterReply(talk)
+
+        val asked = asked()
+        // Her card, with his name in it, stands in front of the notebook's own text.
+        assertTrue(asked, asked.contains("You are Yume. Sam built you.\\n\\nYou are Yume Kisaragi. This is your own notebook."))
+        // She is told what day it is, and on which day the talk was said: it is read weeks later here.
+        assertTrue(asked, asked.contains("TODAY: ${PersonaNotebookTalk.day(20 * day)} (on his clock)"))
+        assertTrue(asked, asked.contains("he: ${saidOn(1_000)}the second hive is up"))
+        assertTrue(asked, asked.contains("i: finally"))
+        assertEquals(1, Regex(Regex.escape("(said on ")).findAll(asked).count())
+        assertEquals(
+            setOf(
+                Note(Kind.ME, "soda", "melon soda is mine and i do not share"),
+                Note(Kind.USER, "hives", "he has a second hive up now")
+            ),
+            runBlocking { memory.notes() }.toSet()
+        )
+        // The time that is kept is that of the newest row the pass read.
+        assertEquals(3_010L, lastPass())
