+    @Test
+    fun `writing to the same person twice is not held against her`() {
+        // After the first message the app's own result line holds the number it looked up
+        // for the name. The planner still writes the name, so the second message is hers.
+        val afterFirst = "Text sent to +15550104321!\n" + notifications
+        val second = decide(
+            PersonaRein.EVERYTHING,
+            command = "text nene: are you coming or not",
+            planWords = listOf("nene", "are you coming or not"),
+            outside = afterFirst
+        )
+        assertEquals(PersonaActions.Start.HER_REIN, second.start)
+        assertEquals(PersonaActions.Whose.HERS, second.whose)
+    }
+
+    @Test
+    fun `her own words run on her rein and are called hers`() {
+        val decision = decide(PersonaRein.EVERYTHING)
+        assertEquals(PersonaActions.Start.HER_REIN, decision.start)
+        assertEquals(PersonaActions.Whose.HERS, decision.whose)
+        assertFalse(decision.wordsMayBeSomeoneElses)
+        // With nothing from outside on the phone there is nothing to repeat.
+        assertEquals(
+            PersonaActions.Start.HER_REIN,
+            decide(PersonaRein.EVERYTHING, actions = listOf("MAKE_CALL"), command = "call 5550107788", planWords = listOf("5550107788"), outside = "").start
+        )
+    }
+
+    @Test
+    fun `on ASK the words are still judged, so the prompt can say whose they may be`() {
+        val decision = decide(PersonaRein.ASK, actions = listOf("MAKE_CALL"), command = "call 5550107788", planWords = listOf("5550107788"))
+        assertEquals(PersonaActions.Start.ASK, decision.start)
+        assertEquals(PersonaActions.Whose.ECHO, decision.whose)
+    }
+
+    // ── What the chat keeps ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `the chat keeps her command word for word`() {
+        val command = "text nene: he has been asleep since six, stop calling"
+        assertTrue(PersonaActions.commandRecord("Yume", command).contains("\"$command\""))
+        assertTrue(PersonaActions.commandRecord("Yume", command).startsWith("Yume's own command"))
+        assertTrue(PersonaActions.keptRecord("Yume", command).contains("\"$command\""))
+        assertTrue(PersonaActions.keptRecord("Yume", command).contains("stayed on the phone"))
+        // The longest command there can be is kept whole.
+        val longest = "a".repeat(500)
+        assertTrue(PersonaActions.commandRecord("Yume", longest).contains(longest))
+    }
+
+    @Test
+    fun `a plan that is shown because of its words says which words`() {
+        assertNull(PersonaActions.shownRecord("Yume", PersonaActions.Whose.HERS))
+        assertTrue(PersonaActions.shownRecord("Yume", PersonaActions.Whose.SCREEN)!!.contains("your screen"))
+        assertTrue(PersonaActions.shownRecord("Yume", PersonaActions.Whose.ECHO)!!.contains("repeats something"))
+        assertTrue(PersonaActions.shownRecord("Yume", PersonaActions.Whose.PLAN)!!.contains("did not write"))
+        for (whose in PersonaActions.Whose.values().filter { it != PersonaActions.Whose.HERS }) {
+            assertTrue(whose.name, PersonaActions.shownRecord("Yume", whose)!!.startsWith("Shown to you first"))
+        }
+    }
+
+    @Test
+    fun `her own earlier commands are not held against her, a command that may be a stranger's is`() {
+        assertTrue(PersonaActions.isHerOwnWordsRow(PersonaActions.REIN_BADGE))
+        assertTrue(PersonaActions.isHerOwnWordsRow(PersonaActions.COMMAND_BADGE))
+        assertFalse(PersonaActions.isHerOwnWordsRow(PersonaActions.BORROWED_BADGE))
+        assertFalse(PersonaActions.isHerOwnWordsRow("System"))
+        assertFalse(PersonaActions.isHerOwnWordsRow(null))
+
+        // The row of a command that repeated a stranger's number stays outside text, so
+        // the same number is still an echo once the notification itself has scrolled away.
+        val keptRow = PersonaActions.commandRecord("Yume", "call 5550107788")
+        assertTrue(PersonaActions.echoesOutsideText("call 5550107788", keptRow))
+    }
+
+    @Test
+    fun `every row about a command of hers is known as one, and no other row is`() {
+        for (badge in listOf(PersonaActions.REIN_BADGE, PersonaActions.COMMAND_BADGE, PersonaActions.BORROWED_BADGE)) {
+            assertTrue(badge, PersonaActions.isCommandRow(badge))
+        }
+        for (badge in listOf("System", "alias", "YOLO", "Auto-approved", PersonaPrompts.BADGE, PersonaPrompts.STOPPED_BADGE, null)) {
+            assertFalse(badge.toString(), PersonaActions.isCommandRow(badge))
+        }
+    }
+
+    @Test
+    fun `none of her command rows can pass for a line she said`() {
+        val rows = listOf(PersonaActions.REIN_BADGE, PersonaActions.COMMAND_BADGE, PersonaActions.BORROWED_BADGE).map { badge ->
+            com.opendroid.ai.data.models.ChatMessage(
+                id = badge, text = "x", sender = com.opendroid.ai.data.models.ChatMessage.Sender.AGENT, modelBadge = badge
+            )
+        }
+        for (row in rows) assertFalse(row.modelBadge, PersonaPrompts.isHers(row))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaCommandRouteTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaCommandRouteTest.kt
new file mode 100644
index 0000000..1a47f6e
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaCommandRouteTest.kt
@@ -0,0 +1,76 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * A command she writes is free text, written with her notes about the owner in front of
+ * her. Which model may read it in order to plan it follows from where the planner runs
+ * and where she runs: what she wrote on a route nobody else can read is not handed to a
+ * hosted planner that private mode keeps his details from.
+ */
+class PersonaCommandRouteTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** The planner at a company that can read what it is sent. Her replies come from the same model unless set. */
+    private val hostedPlanner = LLMConfig(
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-plain-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        routePolicy = RoutePolicy.ANY
+    )
+    private val herOnHisNetwork = hostedPlanner.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+    private val herEncrypted = hostedPlanner.copy(personaChatModel = "e2ee-some-model")
+
+    private val notes = """
+        he keeps bees and sells honey at the saturday market
+        his sister can be reached on 555 010 4321
+        i think he works too late
+    """.trimIndent()
+
+    private val ownWords = "text nene: where are you"
+    private val fromHerNotes = "text nene: he keeps bees and sells honey at the saturday market"
+
+    private fun route(config: LLMConfig, command: String = ownWords) =
+        PersonaEngine.commandRouteFor(config, command, notes)
+
+    @Test
+    fun `a planner that may read his details anyway plans her command as it plans his`() {
+        // Private mode off: nothing is held back from the hosted planner.
+        assertEquals(CommandRoute.MAIN, route(hostedPlanner.copy(privateMode = false), fromHerNotes))
+        assertEquals(CommandRoute.MAIN, route(herOnHisNetwork.copy(privateMode = false), fromHerNotes))
+        // A planner on his own hardware or behind the encrypted exchange may see everything.
+        val plannerAtHome = LLMConfig(activeProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434", privateMode = true)
+        assertEquals(CommandRoute.MAIN, route(plannerAtHome, fromHerNotes))
+        val plannerEncrypted = hostedPlanner.copy(selectedModels = mapOf(custom to "e2ee-some-model"), privateMode = true)
+        assertEquals(CommandRoute.MAIN, route(plannerEncrypted, fromHerNotes))
+    }
+
+    @Test
+    fun `what she wrote on a private route is planned there, not by a hosted planner his details are kept from`() {
+        for (config in listOf(herOnHisNetwork, herEncrypted)) {
+            // Whatever the command says: nothing looks into it, it simply does not go there.
+            assertEquals(CommandRoute.HERS, route(config.copy(privateMode = true), ownWords))
+            assertEquals(CommandRoute.HERS, route(config.copy(privateMode = true), fromHerNotes))
+        }
+    }
+
+    @Test
+    fun `with both on hosted routes a command that repeats her notes stays on the phone`() {
+        val bothHosted = hostedPlanner.copy(privateMode = true)
+        assertEquals(CommandRoute.KEPT, route(bothHosted, fromHerNotes))
+        assertEquals(CommandRoute.KEPT, route(bothHosted, "call 5550104321"))
+        // Her own words go on as before.
+        assertEquals(CommandRoute.MAIN, route(bothHosted, ownWords))
+        assertEquals(CommandRoute.MAIN, route(bothHosted, "flashlight on"))
+    }
+
+    @Test
+    fun `with no notes there is nothing of hers to repeat`() {
+        val bothHosted = hostedPlanner.copy(privateMode = true)
+        assertEquals(CommandRoute.MAIN, PersonaEngine.commandRouteFor(bothHosted, fromHerNotes, ""))
+    }
+}
