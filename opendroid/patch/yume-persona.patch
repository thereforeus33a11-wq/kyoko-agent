+/**
+ * Her own time, as far as it is a decision about text and time: what a moment of hers
+ * comes to, when she is woken next inside the owner's bounds, what is stored, and what
+ * she is told. Every sentence she is told is held against the rule that makes it true.
+ */
+class PersonaOwnTimeTest {
+
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private val day = 24 * hour
+    private val utc: TimeZone = TimeZone.getTimeZone("UTC")
+
+    /** 2026-11-17 22:10:00 UTC, a Tuesday. */
