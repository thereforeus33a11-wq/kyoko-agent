+        assertEquals(3, PersonaPrompts.shapeHistory(talk).dialogue.count { it.sender == Sender.USER })
+    }
+
+    @Test
+    fun `her prompt is told that an app line is from when it was written`() {
+        val text = PersonaPrompts.chatSystemPrompt(
+            card = "You are Yume.",
+            ownerName = "Sam",
+            autoModeLabel = "OFF",
+            relevantContext = "",
+            notes = "",
+            deviceActivity = listOf("(yesterday) Phone is now on silent mode."),
+            screenshotAttached = false
+        )
+        assertTrue(text.contains("An app line says what was true when it was written, not what is true now"))
+        assertTrue(text.contains("[cut]"))
+    }
+
+    @Test
+    fun `for an unprompted line only app lines from the last half hour are passed`() {
+        val rows = listOf(
+            owner("silent mode", badge = PersonaPrompts.OWNER_COMMAND_BADGE, minutesAgo = 200),
+            app("Phone is now on silent mode.", minutesAgo = 200),
+            owner("and the torch", badge = PersonaPrompts.OWNER_COMMAND_BADGE, minutesAgo = 190),
+            app("Flashlight turned on", minutesAgo = 31),
+            app("Timer finished", minutesAgo = 29)
+        )
+        val shaped = PersonaPrompts.shapeHistory(
+            rows,
+            nowMillis = now,
+            activityMaxAgeMillis = CheckInRule.MAX_APP_LINE_AGE_MILLIS
+        )
+        assertEquals(listOf("(29 min ago) Timer finished"), shaped.deviceActivity)
+        assertEquals(30 * minute, CheckInRule.MAX_APP_LINE_AGE_MILLIS)
+        // The talk itself is not cut by age.
+        assertEquals(1, shaped.dialogue.size)
+    }
+
+    // ── How much of the talk she sees ────────────────────────────────────────────────
+
+    @Test
+    fun `a run of commands does not push the conversation out of her sight`() {
+        val talk = (1..8).flatMap { listOf(owner("his line $it"), yume("her line $it")) }
+        // Three commands, each with the rows the app writes around one.
+        val commands = (1..3).flatMap {
+            listOf(
+                owner("command $it", badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+                app("alarm. ok", badge = "alias"),
+                app("Running: 1 step\n• Set alarm", badge = "Auto-approved"),
+                app("Your alarm is set for 7:0$it AM!")
+            )
+        }
+        val shaped = PersonaPrompts.shapeHistory(talk + commands + owner("so where were we"))
+
+        val replayed = shaped.dialogue.joinToString("\n") { it.text }
+        // Sixteen rows of talk, counted after the app's rows are taken out.
+        assertTrue(replayed, replayed.contains("her line 3"))
+        assertTrue(replayed, replayed.contains("his line 8"))
+        assertTrue(replayed, replayed.contains("so where were we"))
+        assertFalse(replayed, replayed.contains("his line 1\n"))
+        assertEquals(16, PersonaPrompts.MAX_DIALOGUE_ROWS)
+        assertEquals(6, shaped.deviceActivity.size)
+        assertEquals(Sender.USER, shaped.dialogue.first().sender)
+    }
+
+    @Test
+    fun `the number of rows of talk kept is the caller's to set`() {
+        val talk = (1..10).flatMap { listOf(owner("his $it"), yume("hers $it")) }
+        val shaped = PersonaPrompts.shapeHistory(talk, maxDialogueRows = 4)
+        assertEquals(listOf("his 9", "hers 9", "his 10", "hers 10"), shaped.dialogue.map { it.text })
+    }
+
+    // ── What she read off his screen ─────────────────────────────────────────────────
+
+    @Test
+    fun `a reply written with his screen in front of her is stored as hers and marked as that`() {
+        assertEquals("Yume (screen)", PersonaPrompts.SCREEN_BADGE)
+        assertEquals(PersonaPrompts.BADGE, PersonaPrompts.replyBadge(sawScreen = false))
+        assertEquals(PersonaPrompts.SCREEN_BADGE, PersonaPrompts.replyBadge(sawScreen = true))
+        assertEquals(PersonaPrompts.STOPPED_BADGE, PersonaPrompts.replyBadge(sawScreen = false, stopped = true))
+        assertEquals(PersonaPrompts.SCREEN_STOPPED_BADGE, PersonaPrompts.replyBadge(sawScreen = true, stopped = true))
+
+        for (badge in listOf(PersonaPrompts.SCREEN_BADGE, PersonaPrompts.SCREEN_STOPPED_BADGE)) {
+            val reply = yume("bob moving to osaka next month. good riddance", badge = badge)
+            assertTrue(badge, PersonaPrompts.isHers(reply))
+            assertTrue(badge, PersonaPrompts.readOffScreen(reply))
+            assertFalse(badge, PersonaPrompts.isPrivateResult(reply))
+        }
+        assertFalse(PersonaPrompts.readOffScreen(yume("mm")))
+        assertFalse(PersonaPrompts.readOffScreen(yume("mm", badge = PersonaPrompts.STOPPED_BADGE)))
+        // A row of his or of the app's is never hers, whatever badge it carries.
+        assertFalse(PersonaPrompts.readOffScreen(owner("x", badge = PersonaPrompts.SCREEN_BADGE)))
+    }
+
+    @Test
+    fun `the notebook pass is told which line she read off his screen, and ordinary talk after it is not marked`() {
+        val rows = listOf(
+            owner("what does this say", minutesAgo = 9),
+            yume("bob moving to osaka next month. good riddance", badge = PersonaPrompts.SCREEN_BADGE, minutesAgo = 9),
+            owner("i sold the hive", minutesAgo = 5),
+            yume("finally", minutesAgo = 5),
+            owner("you would miss the honey", minutesAgo = 1),
+            yume("i would not", minutesAgo = 1)
+        )
+        val notebook = PersonaPrompts.shapeHistory(rows, forNotebook = true).dialogue
+        val transcript = PersonaPrompts.reflectionUserPrompt("", notebook)
+
+        assertTrue(transcript, transcript.contains("i: ${PersonaPrompts.SCREEN_REPLY_LABEL}bob moving to osaka"))
+        assertTrue(PersonaPrompts.SCREEN_REPLY_LABEL.contains("not something he told me"))
+        // The talk that followed is hers and his as it always was.
+        assertTrue(transcript, transcript.contains("he: i sold the hive"))
+        assertTrue(transcript, transcript.contains("i: finally"))
+        assertTrue(transcript, transcript.contains("i: i would not"))
+        assertEquals(1, Regex(Regex.escape(PersonaPrompts.SCREEN_REPLY_LABEL)).findAll(transcript).count())
+
+        // In her own chat prompt the reply is replayed as she said it, with no label in her mouth.
+        val chat = PersonaPrompts.shapeHistory(rows).dialogue
+        assertEquals("bob moving to osaka next month. good riddance", chat[1].text)
+        assertFalse(chat.joinToString { it.text }.contains(PersonaPrompts.SCREEN_REPLY_LABEL))
+    }
+
+    @Test
+    fun `the notebook pass is handed the talk shaped for it, held back by the route it travels on`() {
+        val engine = java.io.File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        val reflect = engine.substringAfter("internal suspend fun reflect(").substringBefore("suspend fun checkInLine(")
+        val route = reflect.indexOf("val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))")
+        val shaped = reflect.indexOf("val dialogue = PersonaPrompts.shapeHistory(")
+        assertTrue(route >= 0)
+        assertTrue(shaped > route)
+        val call = reflect.substring(shaped).substringBefore(".dialogue")
+        assertTrue(call.contains("recentMessages,"))
+        assertTrue(call.contains("holdBackPrivateResults = heldBack,"))
+        assertTrue(call.contains("forNotebook = true"))
+    }
+
+    // ── With her switched off ────────────────────────────────────────────────────────
+
+    @Test
+    fun `the stock chat gets none of her lines, screen replies included, and keeps the app's rows`() {
+        val rows = listOf(
+            owner("what is this"),
+            yume("a chat with bob", badge = PersonaPrompts.SCREEN_BADGE),
+            owner("text mom", badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("What should I tell Mom?", badge = PersonaPrompts.QUESTION_BADGE),
+            owner("im late", badge = PersonaPrompts.OWNER_ANSWER_BADGE),
+            app("Message sent to Mom!")
+        )
+        val stock = PersonaPrompts.stockHistory(rows, holdBack = false)
+        assertEquals(
+            listOf("what is this", "text mom", "What should I tell Mom?", "im late", "Message sent to Mom!"),
+            stock.map { it.text }
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt
new file mode 100644
index 0000000..3bde11b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt
@@ -0,0 +1,107 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaLibraryText.Cue
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Checks the real library, as the build puts it into `assets/persona`, when it is
+ * there. A checkout without her files skips these: the library is not part of the
+ * source tree.
+ */
+class PersonaLibraryShelfCheckTest {
+
+    private val assets = File("src/main/assets/persona")
+
+    private fun shelf(): PersonaLibraryText.Shelf {
+        val files = File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty().sortedBy { it.name }
+        assumeTrue("her library is not in this checkout", files.isNotEmpty())
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").takeIf { it.isFile }?.readText().orEmpty())
+        return PersonaLibraryText.Shelf(files.flatMap { PersonaLibraryText.pages(it.name.removeSuffix(".md"), it.readText(), index) })
+    }
+
+    @Test
+    fun `what lies under her is kept apart from her pages and is all there`() {
+        shelf()
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").readText())
+        val under = File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty()
+            .joinToString("\n\n") { PersonaLibraryText.underText(it.name.removeSuffix(".md"), it.readText(), index) }
+        assertTrue("the build has no under-text", under.length > 2000)
+        assertTrue(under.contains("Badplug"))
+        assertTrue(under.contains("buried deep in her mind"))
+        for (gone in listOf("LOCKED CANON", "/home/", "kisaragi-")) {
+            assertFalse("$gone in the under-text", under.contains(gone))
+        }
+    }
+
+    private fun PersonaLibraryText.Shelf.labelsFor(message: String, budget: Int = 6000): List<String> =
+        select(listOf(Cue(message, 1.0)), budget).map { it.label }
+
+    @Test
+    fun `nothing on the shelf tells her what was done to her or talks to a writer`() {
+        val shelf = shelf()
+        assertTrue(shelf.pages.size > 80)
+        for (page in shelf.pages) {
+            val text = page.body + " " + page.label
+            for (word in listOf("badplug", "bad plug", "parasite", " worm", "plugged", "LOCKED CANON", "/home/", "writing as Yume")) {
+                assertFalse("${page.label} has \"$word\"", text.contains(word, ignoreCase = true))
+            }
+            assertFalse("${page.label} names a file", Regex("""kisaragi-[a-z]+""").containsMatchIn(text.replace("kisaragi-agent", "")))
+        }
+    }
+
+    @Test
+    fun `the name he is called by in the files is a placeholder`() {
+        val shelf = shelf()
+        assertTrue(shelf.pages.any { it.body.contains(PersonaPrompts.OWNER_PLACEHOLDER) })
+        val rendered = PersonaLibraryText.render(shelf.pages, "Sam")
+        assertFalse(rendered.contains("{{owner"))
+    }
+
+    @Test
+    fun `what he says finds the page about it`() {
+        val shelf = shelf()
+        val expected = mapOf(
+            "who is nene" to "life: Her people",
+            "tell me about your mom" to "life: Where she comes from",
+            "what music do you like" to "taste: Music",
+            "do you want a real body" to "mind: What she is really after",
+            "say something dirty" to "life: What she wants that is not money",
+            "what does maji mean" to "voice: Where her voice comes from",
+            "how is the rig going" to "now: Her real week",
+            "whats your favorite konbini" to "taste: Konbini, ranked"
+        )
+        for ((message, label) in expected) {
+            val labels = shelf.labelsFor(message)
+            assertTrue("\"$message\" gave $labels", labels.any { it.startsWith(label) })
+        }
+    }
+
+    @Test
+    fun `small talk brings nothing and the budget holds`() {
+        val shelf = shelf()
+        for (message in listOf("hey", "mm", "ok", "lol", "what", "yeah i guess")) {
+            assertEquals("\"$message\"", emptyList<String>(), shelf.labelsFor(message))
+        }
+        val picked = shelf.select(listOf(Cue("your nails your hair your boots your tan your money your mom", 1.0)), 3000)
+        assertTrue(picked.sumOf { it.body.length + it.label.length + 4 } <= 3000)
+    }
+
+    @Test
+    fun `report what a few messages bring`() {
+        val out = System.getenv("YUME_LIBRARY_REPORT") ?: return
+        val shelf = shelf()
+        val messages = File(System.getenv("YUME_LIBRARY_MESSAGES") ?: return).readLines().filter { it.isNotBlank() }
+        File(out).writeText(
+            "${shelf.pages.size} pages, ${shelf.totalChars} chars\n" + messages.joinToString("\n") { message ->
+                val picked = shelf.select(listOf(Cue(message, 1.0)), 6000)
+                "\nQ: $message -> ${picked.size} pages, ${picked.sumOf { it.body.length }} chars\n" +
+                    picked.joinToString("\n") { "   ${it.label}" }
+            }
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryTextTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryTextTest.kt
