+/**
+ * Her eyes: the switch, with the consent sheet the first time it is switched on; why the
+ * app stopped them, where it did; and while they are on, the model (checked when it is
+ * chosen), the pictures a day and the pictures an outing.
+ */
+@Composable
+private fun HerEyesSettings(config: LLMConfig, viewModel: SettingsViewModel, life: OwnLifeViewModel) {
+    var asking by remember { mutableStateOf(false) }
+    SettingSwitchRow(
+        title = EYES_TITLE,
+        description = EYES_HINT,
+        checked = config.personaEyes,
+        onCheckedChange = { on -> if (on && config.personaEyesConsentAt <= 0L) asking = true else viewModel.updatePersonaEyes(on) }
+    )
+    if (config.personaEyesStoppedWhy.isNotBlank()) {
+        Text(text = config.personaEyesStoppedWhy, fontSize = 11.sp, color = AccentCyan)
+    }
+    if (asking) {
+        AlertDialog(
+            onDismissRequest = { asking = false },
+            title = { Text(EYES_CONSENT_TITLE) },
+            text = { Text(EYES_CONSENT_TEXT) },
+            confirmButton = {
+                TextButton(onClick = {
+                    asking = false
+                    viewModel.acceptPersonaEyesConsent()
+                }) { Text("Switch them on") }
+            },
+            dismissButton = { TextButton(onClick = { asking = false }) { Text("Not now") } }
+        )
+    }
+    if (!config.personaEyes) return
+    SettingChoiceRow(
+        label = "Model her eyes use",
+        options = eyesModelChoices(config.personaEyesModel),
+        selected = HerEyes.modelOf(config),
+        onSelect = { id -> life.chooseEyesModel(config, id, viewModel::updatePersonaEyesModel) }
+    )
+    Text(
+        text = life.eyesStatus.ifEmpty { EYES_MODEL_HINT },
+        fontSize = 10.sp,
+        color = if (life.eyesStatus.isEmpty()) TextSecondary else AccentCyan
+    )
+    SettingChoiceRow(
+        label = "Pictures described in any 24 hours",
+        options = eyesPerDayChoices(config.personaEyesPerDay),
+        selected = config.personaEyesPerDay.coerceAtLeast(0),
+        onSelect = viewModel::updatePersonaEyesPerDay
