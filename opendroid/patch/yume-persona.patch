+            runBlocking { engine.readBackgroundPicture("dGhlLXBhZ2Uh") }
+        )
+        assertEquals(0, server.requestCount)
+    }
+
+    // ── Her own picture in front of her ──────────────────────────────────────────────
+
+    @Test
