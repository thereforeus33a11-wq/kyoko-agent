+/** New pictures of herself: what is made, from which picture, with which words, and where it is kept. */
+class PersonaSelfPicturesTest {
+
+    private fun picture(id: String, caption: String, made: Boolean = false) =
+        PersonaPicture(id = id, file = "$id.jpg", kind = PersonaPicture.Kind.SELF, caption = caption, made = made)
+
+    @Test
+    fun `she is always made as the 19 she is, never as the girl before or younger or childlike`() {
+        assertNull(PersonaSelfPictures.refusal("on a rooftop at night, smoking, boots on the rail"))
+        assertNull(PersonaSelfPictures.refusal("topless on the love hotel bed"))
+        // She is young: a young woman, young-looking, is her.
+        assertNull(PersonaSelfPictures.refusal("young and cocky, grinning at the camera"))
+        assertNull(PersonaSelfPictures.refusal("young-looking face, fresh dye day"))
+        for (ask in listOf(
+            "as satomi in the library", "with round glasses and the sweater vest", "in a school uniform",
+            "looking younger", "as a little girl", "childlike", "loli style", "as a kid"
+        )) {
+            assertNotNull(ask, PersonaSelfPictures.refusal(ask))
+        }
+        // An ordinary word that only looks like one of those is not a reason.
+        assertNull(PersonaSelfPictures.refusal("a minor change: nails red instead of blue"))
+        assertNull(PersonaSelfPictures.refusal("no kidding, the cat on my lap"))
+        assertNotNull(PersonaSelfPictures.refusal("  "))
+        // Every prompt says so too, before anything else.
+        assertTrue(PicturePrompts.edit("on a curb").startsWith("She is an adult woman, 19 years old"))
+        assertTrue(PicturePrompts.generate(PictureModels.WAI, "on a curb").startsWith("adult woman, 19 years old"))
+    }
+
+    @Test
+    fun `his name never leaves in her words`() {
+        assertEquals("on him's bed, legs up", PersonaSelfPictures.withoutHim("on Gunnar's bed,   legs up", "Gunnar"))
+        assertEquals("with him", PersonaSelfPictures.withoutHim("with GUNNAR", "Gunnar"))
+        // Every part of his name goes, each on its own, not only the whole name.
+        assertEquals("in him's flat, him on the sofa", PersonaSelfPictures.withoutHim("in Gunnar's flat, Olsen on the sofa", "Gunnar Olsen"))
+        // A word that only contains a part of it stays.
+        assertEquals("olsenberg street", PersonaSelfPictures.withoutHim("olsenberg street", "Gunnar Olsen"))
+        // Words that carry his details are not sent at all.
+        assertNotNull(PersonaSelfPictures.carriesHisDetails("me holding a sign with 0412 345 678", ""))
+        assertNotNull(PersonaSelfPictures.carriesHisDetails("me at gunnar@example.com", ""))
+        assertNotNull(PersonaSelfPictures.carriesHisDetails(
+            "me standing outside his flat on grunerlokka thorvald meyers gate by the bakery",
+            "he lives on thorvald meyers gate in grunerlokka by the bakery"
+        ))
+        assertNull(PersonaSelfPictures.carriesHisDetails("on a rooftop at night", "he lives on thorvald meyers gate"))
+        assertEquals("x".repeat(PersonaSelfPictures.MAX_ASK_CHARS), PersonaSelfPictures.withoutHim("x".repeat(900), ""))
+    }
+
+    @Test
+    fun `the prompt keeps her words whole, the guard first and the style last, within what the model reads`() {
+        val ask = "sitting on the curb at 5 am, " + "smoking and looking bored, ".repeat(17)
+        for (model in PictureModels.GENERATE) {
+            val prompt = PicturePrompts.generate(model, ask.take(PersonaSelfPictures.MAX_ASK_CHARS), lookNow = "x".repeat(400))
+            assertTrue(model.id, prompt.length <= model.promptLimit)
+            assertTrue(model.id, PictureGuard.guarded(prompt))
+            assertTrue(model.id, prompt.contains("sitting on the curb at 5 am"))
+            // The drawing style is never cut off the end.
+            if (model.style == PictureModels.Style.ANIME_TAGS) assertTrue(model.id, prompt.endsWith(PicturePrompts.STYLE_TAGS))
+        }
+    }
+
+    @Test
+    fun `her look is read from her picture file as it ships`() {
+        val file = File("src/main/assets/persona/library/kisaragi-pics.md")
+        if (!file.isFile) return
+        val look = PersonaSelfPictures.look(file.readText())
+        assertTrue(look.startsWith("Tan Japanese girl, 19"))
+        assertFalse(look.contains("Rear / turned views"))
+    }
+
+    @Test
+    fun `a new picture starts from one of his unless she names another`() {
+        val his = picture("a", "me on the platform boots wide")
+        val stairs = picture("b", "me on the stairs smoking")
+        val mine = picture("c", "rooftop at night", made = true)
+        val all = listOf(mine, his, stairs)
+        assertEquals("a", PersonaSelfPictures.base(all, null)?.id)
+        assertEquals("b", PersonaSelfPictures.base(all, "the one on the stairs")?.id)
+        assertEquals("c", PersonaSelfPictures.base(all, "the rooftop one")?.id)
+        assertEquals("a", PersonaSelfPictures.base(all, "something else entirely")?.id)
+        assertNull(PersonaSelfPictures.base(emptyList(), null))
+        // A picture of the girl before is never one to start from, first or named.
+        val before = picture("z", "satomi with her round glasses and the sweater vest")
+        assertEquals("a", PersonaSelfPictures.base(listOf(before, his), null)?.id)
+        assertEquals("a", PersonaSelfPictures.base(listOf(before, his), "the one with the glasses")?.id)
+        assertNull(PersonaSelfPictures.base(listOf(before), null))
+        assertNotNull(PersonaSelfPictures.refusalOfWords("the satomi one"))
+        assertNull(PersonaSelfPictures.refusalOfWords(null))
+    }
+
+    @Test
+    fun `the key is the one his Venice provider holds, and only that one`() {
+        val config = LLMConfig(
+            customEndpoints = mapOf("Custom OpenAI-Compatible" to "https://api.venice.ai/api/v1", "Other" to "https://example.com/v1"),
+            apiKeys = mapOf("Custom OpenAI-Compatible" to " vkey ", "Other" to "okey")
