@@ -0,0 +1,88 @@
+package com.opendroid.ai.ui.viewmodel
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.llm.PromptBudget
+import com.opendroid.ai.core.persona.PersonaEngine
+import com.opendroid.ai.core.persona.PersonaStore
+import com.opendroid.ai.data.models.LLMConfig
+import dagger.hilt.android.lifecycle.HiltViewModel
+import java.io.IOException
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import kotlinx.coroutines.launch
+
+/**
+ * Tells a screen whether the persona is the one who talks, so that every screen asks
+ * the same place the chat and the voice service ask ([PersonaEngine.isActive]: the
+ * switch is on and a card exists) and none of them reads the switch alone. A build
+ * without a card then looks and reads like the stock app on every screen.
+ *
+ * It also carries what the settings need to know about the card itself: whether there
+ * is one, and whether a saved edit stands on an older built-in card.
+ */
+@HiltViewModel
+class PersonaPresenceViewModel @Inject constructor(
+    persona: PersonaEngine,
+    private val store: PersonaStore,
+    private val pictures: com.opendroid.ai.core.persona.PersonaPictures
+) : ViewModel() {
+
+    /** A picture of hers, small, for the chat row that says she made it. Null when its file is gone. */
+    suspend fun pictureThumbnail(id: String): android.graphics.Bitmap? = pictures.bitmap(id, MADE_PICTURE_SIDE)
+
+    /** True when she is the one who talks, false when the app runs as stock, null until that is known. */
+    val active: StateFlow<Boolean?> = persona.active
+        .map<Boolean, Boolean?> { it }
+        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), null)
+
+    /**
+     * [present]: a card exists, built in or saved. [notice]: what there is to say about a
+     * saved edit. [cardTokens]: how long the card is, by the estimate the providers go
+     * by when they decide whether a prompt fits a model.
+     */
+    data class CardState(val present: Boolean, val notice: CardEditNotice, val cardTokens: Int = 0)
+
+    /** Read again whenever the saved card changes; null until it has been read once. */
+    val card: StateFlow<CardState?> = store.changes
+        .map<Int, CardState?> {
+            val text = store.card()
+            CardState(text.isNotBlank(), store.editBase().toNotice(), PromptBudget.estimateTokens(text))
+        }
+        .flowOn(Dispatchers.IO)
+        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5000), null)
+
+    /** Removes the saved edit, so that the built-in card of this version is used. */
+    fun useBuiltInCard() = change { store.saveCard("") }
+
+    /** Keeps the saved edit and stops the notice until the built-in card changes again. */
+    fun keepEditedCard() = change { store.keepEdit() }
+
+    companion object {
+        /** The longer side of a picture of hers shown in the chat. */
+        const val MADE_PICTURE_SIDE = 640
+
+        /**
+         * Whether an image put on her chat request reaches the model that writes her
+         * replies, as things are set. The settings ask here, like they ask here whether
+         * she talks, so that no screen reaches into her own code.
+         */
+        internal fun imagesReachHerModel(config: LLMConfig): Boolean = PersonaEngine.imagesReachChatModel(config)
+    }
+
+    // A write that fails changes nothing, and the notice simply stays where it is.
+    private fun change(write: () -> Unit) {
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                write()
+            } catch (e: IOException) {
+                android.util.Log.w("PersonaPresence", "The choice about the card was not stored: ${e.javaClass.simpleName}")
+            }
+        }
+    }
+}
