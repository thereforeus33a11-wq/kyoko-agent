+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.life.eyes.EyesModels
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.data.models.EyesBounds
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.ui.viewmodel.OwnLifeViewModel
+import com.opendroid.ai.ui.viewmodel.eyesStatusLine
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * What the card says about her eyes is what the code does: the consent sheet says plainly
+ * that pictures go to Venice unencrypted on the Private tier, the switch needs it, the
+ * choices are his, and the status line holds counts and a price only.
+ */
+class EyesWordingTest {
+
+    private fun source(path: String) = File("src/main/java/com/opendroid/ai/$path").readText()
+
+    @Test
+    fun `the consent sheet says plainly where pictures go and that they are not encrypted`() {
+        assertTrue(EYES_CONSENT_TITLE.contains("unencrypted"))
+        assertTrue(EYES_CONSENT_TEXT.contains("to a vision model on Venice's Private tier"))
+        assertTrue(EYES_CONSENT_TEXT.contains("This is not end-to-end encrypted"))
+        assertTrue(EYES_CONSENT_TEXT.contains("With the picture goes one fixed instruction, and nothing else: not her card, not her notes, nothing about you."))
+        assertTrue(EYES_CONSENT_TEXT.contains("Her chat stays on her encrypted model"))
+        assertTrue(EYES_HINT.contains("not end-to-end encrypted"))
+        assertTrue(EYES_HINT.contains("The picture is never stored on the phone."))
+        // Without his consent her eyes stay shut, whatever the switch says.
+        assertEquals(HerEyes.Why.OFF, HerEyes(okhttp3.OkHttpClient(), { LLMConfig() }, {}, OwnLedger({ File("unused") }, { 0L }), { 0L })
+            .gate(LLMConfig(personaEyes = true, personaEyesConsentAt = 0L)))
+        // The card asks first, the first time.
+        val card = source("ui/screens/PersonaSettingsCards.kt")
+        assertTrue(card.contains("onCheckedChange = { on -> if (on && config.personaEyesConsentAt <= 0L) asking = true else viewModel.updatePersonaEyes(on) }"))
+        assertTrue(card.contains("viewModel.acceptPersonaEyesConsent()"))
+        val settings = source("ui/viewmodel/SettingsViewModel.kt")
+        assertTrue(settings.contains("val on = enabled && _llmConfig.value.personaEyesConsentAt > 0L"))
+    }
+
+    @Test
+    fun `his choices for her eyes`() {
+        assertFalse(LLMConfig().personaEyes)
+        assertEquals(0L, LLMConfig().personaEyesConsentAt)
+        assertEquals(60, LLMConfig().personaEyesPerDay)
+        assertEquals(6, LLMConfig().personaEyesPerOuting)
+        assertEquals(EyesModels.CHOICES, eyesModelChoices(EyesBounds.DEFAULT_MODEL).map { it.first })
+        assertEquals("google-gemma-4-31b-it (default)", eyesModelChoices(EyesBounds.DEFAULT_MODEL).first().second)
+        assertTrue(eyesModelChoices("google-gemma-3-27b-it").any { it.first == "google-gemma-3-27b-it" })
+        assertEquals(listOf(20, 40, 60, 100, 150), eyesPerDayChoices(60).map { it.first })
+        assertTrue(eyesPerDayChoices(75).any { it.first == 75 })
+        assertTrue(eyesPerOutingChoices(6).any { it.first == 6 })
+        assertTrue(EYES_MODEL_HINT.contains("claude-, openai- or gemini-"))
+        assertTrue(OWN_LIFE_CALLS_HINT.contains("the pictures her eyes look at"))
+        assertTrue(OWN_TIME_KEY_HINT.contains("sent to api.venice.ai only, never with your own calls"))
+        assertTrue(OwnLifeViewModel.eyesVerdictText("x", EyesModels.Verdict.Refused("Venice does not list that model now.")).startsWith("Not saved: "))
+    }
+
+    @Test
+    fun `her day and her next moment say how many pictures she looked at, counts only`() {
+        assertEquals("2 pictures looked at", com.opendroid.ai.ui.viewmodel.countsText(mapOf(com.opendroid.ai.core.life.OutingHost.PICTURES_LOOKED to 2)))
+        assertEquals(
+            "1 not described (balance), 2 pictures not shown (the describer gave no ages), 1 skipped as a kid's (teen)",
+            com.opendroid.ai.ui.viewmodel.refusalsText(
+                mapOf(com.opendroid.ai.core.life.OutingHost.EYES_PREFIX + "BALANCE" to 1, com.opendroid.ai.core.life.KidGuard.UNCHECKED to 2, "kid:TEEN" to 1)
+            )
+        )
+        val outing = com.opendroid.ai.core.persona.PersonaOwnTime.LastOuting(
+            kind = "read", words = "read about egg", startedAt = 0L, endedAt = 60_000L, minutes = 4, steps = 3, opened = 1,
