@@ -0,0 +1,47 @@
+package com.opendroid.ai.core.service
+
+import android.app.Notification
+import android.app.PendingIntent
+import android.content.Context
+import androidx.core.app.NotificationCompat
+
+/**
+ * The notification for a line she wrote without being asked.
+ *
+ * A notification is not private to the app that posts it: it can be read on the lock
+ * screen, and the system hands its text to every other app with notification access (a
+ * watch, a car, another assistant), which may pass it on. Her line is written from her
+ * notebook and the recent talk, so unless the owner asked to see her words here the
+ * notification only says that she wrote. The line itself is in the chat either way.
+ */
+internal object CheckInNotification {
+
+    /** What the notification says when it does not show her words. */
+    fun wroteTitle(name: String): String = "$name wrote to you"
+
+    /** [name] is who wrote; it is handed in so that this file needs nothing from her own code. */
+    fun build(
+        context: Context,
+        channelId: String,
+        name: String,
+        line: String,
+        showText: Boolean,
+        open: PendingIntent?
+    ): Notification {
+        val builder = NotificationCompat.Builder(context, channelId)
+            .setSmallIcon(android.R.drawable.stat_notify_chat)
+            .setAutoCancel(true)
+            .setContentIntent(open)
+        if (showText) {
+            builder.setContentTitle(name)
+                .setContentText(line)
+                .setStyle(NotificationCompat.BigTextStyle().bigText(line))
+        } else {
+            // No text at all, so there is nothing for a lock screen or another app to
+            // show; and marked private, so a lock screen set to hide content hides this too.
+            builder.setContentTitle(wroteTitle(name))
+                .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+        }
+        return builder.build()
+    }
+}
