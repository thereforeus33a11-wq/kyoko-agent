+        /** The time of the moment, which the ages in these lines are counted from. */
+        val nowMillis: Long,
+        /** What she can go and do now; only these are offered ([goLine]). */
+        val runnable: Set<OutingKind.Kind>,
+        val maxMinutes: Int,
+        val maxSteps: Int,
+        /** His cap of calls on her own in any 24 hours, and how many are left (null when the ledger cannot be read). */
+        val cap: Int,
+        val left: Int?,
