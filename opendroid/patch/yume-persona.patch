+    private fun request(temperature: Float, maxTokens: Int) = LLMRequest(
+        systemPrompt = "card",
+        messages = listOf(ChatMessage("1", "oi", ChatMessage.Sender.USER)),
+        temperature = temperature,
+        maxTokens = maxTokens,
+        responseFormat = ResponseFormat.TEXT
+    )
