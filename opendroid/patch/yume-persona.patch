@@ -0,0 +1,188 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Where her pictures and the text under her awareness are wired into the app. These
+ * read the source, like [PersonaWallTest], because what they guard is which code may
+ * touch which thing:
+ *
+ *  - the text under her awareness is read for her chat prompt and for the screen where
+ *    the owner edits it, and by nothing else;
+ *  - her own picture rides on the request only, so it is never weighed as a screenshot
+ *    of his screen when a command of hers starts;
+ *  - the two requests that send a picture on demand are started from the owner's screen
+ *    alone, and the background picture is not something the chat can reach.
+ */
+class PersonaPictureHooksTest {
+
+    private val mainSources = File("src/main/java/com/opendroid/ai")
+
+    private fun relative(file: File) = file.relativeTo(mainSources).path.replace('\\', '/')
+
+    private fun kotlinSources() = mainSources.walkTopDown().filter { it.isFile && it.extension == "kt" }
+
+    private fun source(path: String) = File(mainSources, path).readText()
+
+    private fun filesThatContain(text: String): Set<String> =
+        kotlinSources().filter { it.readText().contains(text) }.map { relative(it) }.toSet()
+
+    @Test
+    fun `only her chat prompt and the owner's screen read what lies under her awareness`() {
+        val readers = setOf("core/persona/PersonaEngine.kt", "ui/viewmodel/PersonaPicturesViewModel.kt")
+        assertEquals(readers + "core/persona/PersonaStore.kt", filesThatContain("savedUnderText()"))
+        assertEquals(readers + "core/persona/PersonaLibrary.kt", filesThatContain("bundledUnderText()"))
+        // The heading that makes it a block of her prompt is used in one place.
+        assertEquals(setOf("core/persona/PersonaPrompts.kt"), filesThatContain("UNDER_HEADING)"))
+    }
+
+    @Test
+    fun `inside the engine it is asked for once, by the chat prompt, and never by the notebook pass`() {
+        val engine = source("core/persona/PersonaEngine.kt")
+
+        assertEquals(1, Regex("""store\.savedUnderText\(\)""").findAll(engine).count())
+        assertEquals(1, Regex("""library\.bundledUnderText\(\)""").findAll(engine).count())
+        // One call, and it is the argument her chat prompt is built with.
+        assertEquals(1, Regex("""[^.\w]underText\(config, owner\)""").findAll(engine).count())
+        val chatPrompt = engine.substringAfter("suspend fun chatSystemPrompt(").substringBefore("private suspend fun underText(")
+        assertTrue(chatPrompt.contains("under = underText(config, owner)"))
+
+        // Her notebook pass builds its request without her chat prompt, so without the under text.
+        val notebookPass = engine.substringAfter("internal suspend fun reflect(").substringBefore("class Heard(")
+        assertTrue(notebookPass.contains("reflectionRequest(store.card(), ownerName(),"))
+        assertFalse(notebookPass.contains("chatSystemPrompt"))
+        assertFalse(notebookPass.contains("underText"))
+        assertFalse(notebookPass.contains("UnderText"))
+        // That request is her card and the notebook's own text, and nothing else of hers.
+        val notebookRequest = engine.substringAfter("internal fun reflectionRequest(").substringBefore("private val TOKYO")
+        assertTrue(notebookRequest.contains("systemPrompt = PersonaPrompts.reflectionSystemPrompt(card, ownerName)"))
+        assertFalse(notebookRequest.contains("chatSystemPrompt"))
+        assertFalse(notebookRequest.contains("nderText"))
+        val notebookPrompt = source("core/persona/PersonaPrompts.kt")
+            .substringAfter("fun reflectionSystemPrompt(").substringBefore("fun reflectionUserPrompt(")
+        assertTrue(notebookPrompt.contains("fillOwner(card.trim(), ownerName) + \"\\n\\n\" + REFLECTION_SYSTEM_PROMPT"))
+        assertFalse(notebookPrompt.contains("UNDER_HEADING"))
+
+        // Neither does the look at one of her pictures, nor the reading of the background picture.
+        val pictureCalls = engine.substringAfter("internal suspend fun describeOwnPictureFrom(")
+            .substringBefore("/** Her replies want more variety")
+        assertFalse(pictureCalls.contains("chatSystemPrompt"))
+        assertFalse(pictureCalls.contains("underText"))
+    }
+
+    @Test
+    fun `her picture rides on the request, and the dialogue a command of hers is weighed against stays without it`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        val chat = loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+
+        // Asked for with the stored rows and his newest message as he wrote it, not with
+        // the shaped dialogue, in which a command of his is merged into his turn.
+        assertTrue(chat.contains("lastMsgs = shaped.dialogue"))
+        // After a look he asked for, the frame rides on the turn instead of a picture of her.
+        assertTrue(chat.contains("ownPicture = if (seen != null) null else persona.ownPictureFor(chatConfig, storedMsgs, userMsg.text) {"))
+        // Whether this is her first reply is asked of the chat, further back than those rows.
+        val wholeChat = chat.substringAfter("persona.ownPictureFor(").substringBefore("suspend fun herPrompt(")
+        assertTrue(wholeChat.contains("conversationRepository.getLastMessages("))
+        assertTrue(wholeChat.contains("PersonaPictureRules.CHAT_ROWS_LOOKED_BACK"))
+        // Handed to her prompt, so that the prompt says so.
+        assertTrue(chat.contains("ownPicture = picture"))
+        assertTrue(chat.contains("systemPrompt = herPrompt(ownPicture)"))
+        // With her switched off nothing of hers is attached: the stock branch never mentions it.
+        val stock = chat.substringAfter("// Off is stock:")
+        assertFalse(stock.contains("ownPicture"))
+        assertFalse(stock.contains("promptWithoutPicture"))
+
+        // The picture is put on only where the request is built.
+        val request = loop.substringAfter("val chatRequest = LLMRequest(").substringBefore("provider.streamComplete(")
+        assertTrue(request.contains("messages = com.opendroid.ai.core.persona.PersonaPictureRules.withOwnPicture(lastMsgs, ownPicture)"))
+        assertEquals(1, Regex("""withOwnPicture\(""").findAll(loop).count())
+
+        // So "was she shown a screenshot" is still asked of the dialogue without her picture.
+        val handOver = loop.substringAfter("// A last line starting with \">>\" is a command of her own")
+            .substringBefore("} catch (e: CancellationException)")
+        assertTrue(handOver.contains("screenshotAttached = lastMsgs.any { it.imageBase64 != null }"))
+    }
+
+    @Test
+    fun `a reply with her picture on it has one second try without it, by a prompt built the same way`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        val chat = loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+
+        // One function builds her prompt, with her picture or without: the second prompt
+        // cannot drift from the first, and it claims no picture.
+        assertEquals(1, Regex("""persona\.chatSystemPrompt\(""").findAll(loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("private suspend fun generatePlan(")).count())
+        assertTrue(chat.contains("promptWithoutPicture = { herPrompt(null) }"))
+
+        val sending = loop.substringAfter("val chatRequest = LLMRequest(").substringBefore("} catch (streamError: CancellationException)")
+        // Only a reply that carries her picture is wrapped; every other one is sent as before.
+        assertTrue(sending.contains("val stream = if (ownPicture == null || promptAgain == null) {"))
+        val secondTry = sending.substringAfter("persona.orWithoutPicture(chatConfig, reply) {").substringBefore("stream.collect { chunk ->")
+        // The second request goes through the same provider, so through the same gate, to
+        // her own model, with the dialogue as it was said and nothing attached.
+        assertTrue(secondTry.contains("provider.streamComplete("))
+        assertTrue(secondTry.contains("persona.withChatModel("))
+        // The turn a look's frame rides on (none outside the turn after a look) goes with it as it went with the first.
+        assertTrue(secondTry.contains("chatRequest.copy(systemPrompt = promptAgain(), messages = lastMsgs + seenTurnMessages(seen, chatConfig))"))
+        assertFalse(secondTry.contains("withOwnPicture"))
+        // It is the one place where a failed reply is asked for again.
+        assertEquals(1, Regex("""orWithoutPicture\(""").findAll(loop).count())
+    }
+
+    @Test
+    fun `the switch that decides whether she is sent a picture says that it does`() {
+        // One switch governs every image her model is sent. Its name speaks of screenshots,
+        // so the line under it has to say that her own pictures hang on it too.
+        val engine = source("core/persona/PersonaEngine.kt")
+        val reaches = engine.substringAfter("internal fun imagesReachChatModel(").substringBefore("internal fun chatProviderOrMain(")
+        assertTrue(reaches.contains("config.personaChatSeesImages"))
+        val pictures = engine.substringAfter("suspend fun ownPictureFor(").substringBefore("fun orWithoutPicture(")
+        assertTrue(pictures.contains("if (!chatSeesImages(config) || pictureRefused(config)) return null"))
+
+        val settings = source("ui/screens/PersonaSettingsCards.kt")
+        val switch = settings.substringAfter("title = \"Her model can see screenshots\",").substringBefore("checked = config.personaChatSeesImages")
+        assertTrue(switch.contains("neither a screenshot of your screen nor a picture of her"))
+    }
+
+    @Test
+    fun `a picture is sent on demand only from the owner's screen`() {
+        val screenOnly = setOf("core/persona/PersonaEngine.kt", "ui/viewmodel/PersonaPicturesViewModel.kt")
+        assertEquals(screenOnly, filesThatContain("describeOwnPicture("))
+        assertEquals(screenOnly, filesThatContain("readBackgroundPicture("))
+    }
+
+    @Test
+    fun `the background picture is known to the store, its rules and the owner's screen, and to nothing that talks to her`() {
+        val knowers = filesThatContain("Kind.BACKGROUND")
+        assertEquals(
+            setOf("core/persona/PersonaPictureRules.kt", "ui/viewmodel/PersonaPicturesViewModel.kt"),
+            knowers
+        )
+        // The rules name it only to leave it out or to keep it single.
+        val rules = source("core/persona/PersonaPictureRules.kt")
+        val picks = rules.substringAfter("fun choose(").substringBefore("fun pictureFor(")
+        assertTrue(picks.contains("pictures.filter { it.kind == PersonaPicture.Kind.SELF }"))
+        val told = rules.substringAfter("fun captions(").substringBefore("private val STOCK_REFUSAL")
+        assertTrue(told.contains("pictures.filter { it.kind == PersonaPicture.Kind.SELF }"))
+    }
+
+    @Test
+    fun `the pictures are kept in the app's own files directory, which no backup includes`() {
+        val store = source("core/persona/PersonaPictures.kt")
+        assertTrue(store.contains("File(File(context.filesDir, PERSONA_DIRECTORY), PICTURES_DIRECTORY)"))
+        // Nothing in the store writes anywhere else: no gallery, no shared or external storage.
+        for (elsewhere in listOf("MediaStore", "Environment.", "getExternalFilesDir", "externalCacheDir", "cacheDir")) {
+            assertFalse(elsewhere, store.contains(elsewhere))
+        }
+
+        // The whole files directory is excluded from cloud backup and from device transfer.
+        val excluded = """<exclude domain="file" path="."/>"""
+        val backupRules = File("src/main/res/xml/backup_rules.xml").readText()
+        assertTrue(backupRules.contains(excluded))
+        val extractionRules = File("src/main/res/xml/data_extraction_rules.xml").readText()
+        assertEquals(2, Regex(Regex.escape(excluded)).findAll(extractionRules).count())
+    }
+}
