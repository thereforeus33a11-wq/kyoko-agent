+package com.opendroid.ai.core.persona
+
+/**
+ * The words that go out with a request for a picture of her, built here so they can be
+ * read and tested without a phone.
+ *
+ * Her look is the "After-state prompt lock" of her picture file (kisaragi-pics), written
+ * the way each kind of model reads best: Danbooru tags for an anime tag model, plain
+ * sentences for the rest. A tag prompt is built from short fixed parts in a fixed order,
+ * so that nothing important is cut off the end: the adult guard first, her face, hair and
+ * metal, her own words, her clothes, and the drawing style last but never cut. The print on
+ * her bandeau, the tally on her thigh and the toy are not asked of a model that draws from
+ * words (garbled letters, and they are not for every picture); the pass that matches a new
+ * picture to her own pictures ([match]) carries them over from those pictures, and a reference
+ * sheet in her outfit keeps them from the pictures it is made from ([outfitMarks]).
+ *
+ * Wording is positive only. A prompt that says "no glasses" names glasses, and a model
+ * draws what is named; what she never has goes into the negative prompt instead
+ * ([PictureGuard.negative]), where a model takes one.
+ */
+object PicturePrompts {
+
+    /** The shape of a picture, in pixels for a pixel-sized model and as a ratio for the rest. */
+    enum class Shape(val width: Int, val height: Int, val ratio: String) {
+        PORTRAIT(832, 1216, "2:3"),
+        LANDSCAPE(1216, 832, "3:2"),
+        SQUARE(1024, 1024, "1:1")
+    }
+
+    private val WIDE = Regex("""(?i)\b(?:wide|landscape|panorama|16:9|widescreen)\b""")
+    private val SQUARE_WORD = Regex("""(?i)\bsquare\b""")
+
+    /** The shape [ask] asks for: wide, square, or upright as a picture of a whole person mostly is. */
+    fun shapeOf(ask: String): Shape = when {
+        WIDE.containsMatchIn(ask) -> Shape.LANDSCAPE
+        SQUARE_WORD.containsMatchIn(ask) -> Shape.SQUARE
+        else -> Shape.PORTRAIT
+    }
+
+    // ── Her look, from the prompt lock ────────────────────────────────────────────────
+
+    /**
+     * Her face, hair and metal as tags (kisaragi-pics, kisaragi-look). The hair colour and the
+     * tan are their own parts, left out only where her own words give her another colour or
+     * pale skin. "tsurime" is the tag for her sharp, slanted eyes.
+     */
+    private const val HAIR_TAGS = "red hair"
+    private const val SKIN_TAGS = "tan, tanned skin, shiny skin"
+    private const val FACE_TAGS =
+        "long hair, loose hair, ahoge, gyaru, tsurime, sharp eyes, narrow eyes, half-closed eyes, black eyes, red pupils, eyeliner, " +
+            "gold hoop earrings, lip piercing, tongue piercing, black choker, smug"
+
+    /** The small things that stay with any outfit: the cuffs never come off. Cut before her words, never before the guard. */
+    private const val DETAIL_TAGS = "black wrist cuffs, long fingernails, red nails, blue nails"
+
+    /** Her default face in a picture: the crooked tongue-out grin with the barbell showing. */
+    private const val DEFAULT_FACE_TAGS = "crooked grin, tongue out"
+
+    /** Her plate pose, where her words name none: weight on one hip, the cigarette low in the other hand. */
+    private const val POSE_TAGS = "hand on hip, contrapposto, holding cigarette"
+
+    /** How a tag model is asked to draw: like her plates. Never cut. */
+    const val STYLE_TAGS = "2d, anime illustration, clean lineart, flat color, masterpiece, best quality, amazing quality, very aesthetic, absurdres"
+
+    private const val HAIR_PROSE = "long vivid red hair worn loose with a small ahoge"
+    private const val SKIN_PROSE = "a deep golden-brown salon tan, skin glossy with oil"
+    private const val FACE_PROSE =
+        "sharp narrow half-lidded eyes with white sclera, black irises and tiny red pupils, heavy winged black liner, gold hoop earrings, " +
+            "a clearly visible silver stud on the right side of her lower lip, a tongue barbell, a black choker, and a smug, cocky look"
+    private const val DETAIL_PROSE =
+        "Black leather wrist cuffs with gold buckles turned out sit on both wrists, and her long pointed nails alternate red and steel blue."
+    private const val DEFAULT_FACE_PROSE = " Her face: a crooked grin, her tongue resting on her lower teeth with the barbell showing."
+    private const val POSE_PROSE =
+        "She stands with her weight on one hip, one hand on it with the nails splayed, a cigarette held low between two fingers of the other hand."
+
+    /** How a general model is asked to draw her: like her plates, one woman alone. Never cut. */
+    const val STYLE_ANIME_PROSE = "Drawn as a 2D clean anime illustration with crisp lineart and flat colour, one woman alone in the picture."
+
+    /** How a photographic model is asked. Never cut. */
+    const val STYLE_PHOTO = "A real photograph with natural skin texture and natural light, one woman alone in the picture."
+
+    // ── Her plate outfit, in parts ───────────────────────────────────────────────────
+
+    /** The parts of her plate outfit, so that taking one off leaves the rest. */
+    enum class Part { TOP, BANDEAU, MIDRIFF, SKIRT, HIPS, LEGS, BOOTS }
+
+    /**
+     * Her plate outfit as tags and as words, without the print, the tally and the toy (see the
+     * class note). The collar up, the sleeves rolled and the shirt tied high over the bandeau
+     * keep it street fashion: a white shirt and navy alone could read as a school uniform.
+     */
+    private val OUTFIT_TAGS: List<Pair<Part, String>> = listOf(
+        Part.TOP to "white shirt", Part.TOP to "tied shirt", Part.TOP to "popped collar", Part.TOP to "sleeves rolled up",
+        Part.BANDEAU to "navy tube top", Part.MIDRIFF to "midriff", Part.MIDRIFF to "navel piercing",
+        Part.SKIRT to "navy microskirt", Part.SKIRT to "white trim", Part.SKIRT to "white belt", Part.SKIRT to "heart buckle",
+        Part.HIPS to "highleg panties", Part.LEGS to "navy thighhighs", Part.LEGS to "white stripes on thighhighs",
+        Part.BOOTS to "black platform boots"
+    )
+
+    private fun outfitProse(off: Set<Part>): String {
+        val parts = ArrayList<String>()
+        val top = Part.TOP !in off
+        val bandeau = Part.BANDEAU !in off
+        when {
+            top && bandeau -> parts += "a white shirt tied high under the bust over a very dark navy bandeau, its collar flipped up and its sleeves rolled back unevenly"
+            top -> parts += "a white shirt tied high under the bust, its collar flipped up and its sleeves rolled back unevenly"
+            bandeau -> parts += "a very dark navy bandeau"
+        }
+        if (Part.MIDRIFF !in off) parts += "a bare midriff with a gold navel ring sitting flush"
+        if (Part.SKIRT !in off) parts += "a navy micro skirt with white trim low on her hips, a white belt with a gold heart buckle"
+        if (Part.HIPS !in off) parts += "thin pale straps showing high on both hips" + if (Part.SKIRT !in off) " above the skirt" else ""
+        if (Part.LEGS !in off) parts += "glossy navy thigh-highs with white stripes at the top"
+        if (Part.BOOTS !in off) parts += "black patent platform boots"
+        if (parts.isEmpty()) return ""
+        val list = if (parts.size == 1) parts.single() else parts.dropLast(1).joinToString(", ") + ", and " + parts.last()
+        return "She wears $list: gyaru nightlife street fashion."
+    }
+
+    /** Words that by themselves say what she wears (or that she wears nothing). */
+    private val WEARING = Regex(
+        """(?i)\b(?:wear(?:s|ing)?|wore|dressed|undressed|outfit|clothes|clothing|naked|nude|topless|bottomless|""" +
+            """barefoot|costume|strip(?:s|ped|ping)?|tak(?:e|es|ing) (?:it|them|everything) off)\b"""
+    )
+
+    private const val GARMENTS =
+        """bikini|lingerie|underwear|bra|panties|thong|hoodie|dress|jacket|coat|kimono|yukata|swimsuit|pajamas|pyjamas|""" +
+            """towel|shirt|t-?shirt|crop top|tank top|skirt|jeans|shorts|pants|trousers|stockings|thigh-?highs|socks|""" +
+            """boots|heels|sneakers|shoes|apron|sweater|leggings|robe|bathrobe|uniform|suit|tracksuit|onesie"""
+
+    /** A garment she is in, or one that comes off: "in a red hoodie", "in her pajamas", "boots only". */
+    private val IN_GARMENT = Regex(
+        """(?i)\b(?:in|into|only|just|nothing but)\s+(?:(?:a|an|her|my|the|some|just|only)\s+)?(?:[\w-]+\s+){0,2}(?:$GARMENTS)\b|""" +
+            """\b(?:$GARMENTS)\s+(?:off|only|open|undone|pulled (?:up|down|aside))\b"""
+    )
+
+    /**
+     * Words that only take something of her plate outfit off, or open it, and what each
+     * leaves out of it: "topless" leaves the shirt and the bandeau out, "barefoot" the boots,
+     * "shirt open" nothing (her words say how it is worn).
+     */
+    private val TAKEN_OFF: List<Pair<Regex, Set<Part>>> = listOf(
+        Regex("""(?i)\b(?:topless|bare[ -]?chest(?:ed)?|bare breasts?|(?:boobs?|tits|breasts?) out)\b""") to setOf(Part.TOP, Part.BANDEAU),
+        Regex("""(?i)\b(?:(?:her |my |the )?(?:bandeau|tube top) (?:off|down|pulled (?:up|down|aside)))\b""") to setOf(Part.BANDEAU),
+        Regex("""(?i)\b(?:(?:her |my |the )?(?:shirt|top) (?:off|removed))\b""") to setOf(Part.TOP),
+        Regex("""(?i)\b(?:(?:her |my |the )?(?:shirt|top) (?:open|undone|unbuttoned|untied|pulled (?:up|down|aside)))\b""") to emptySet(),
+        Regex("""(?i)\b(?:bottomless|(?:no|without) (?:panties|underwear)|(?:her |my |the )?(?:panties|underwear) (?:off|down))\b""") to setOf(Part.SKIRT, Part.HIPS),
+        Regex("""(?i)\b(?:(?:her |my |the )?(?:panties|underwear) (?:pulled )?aside)\b""") to emptySet(),
+        Regex("""(?i)\b(?:(?:her |my |the )?skirt (?:off|down|removed))\b""") to setOf(Part.SKIRT),
+        Regex("""(?i)\b(?:(?:her |my |the )?skirt (?:up|lifted|flipped up|pulled up|hiked up))\b""") to emptySet(),
+        Regex("""(?i)\b(?:bare legs|(?:her |my |the )?(?:thigh-?highs?|stockings) (?:off|down|rolled down))\b""") to setOf(Part.LEGS),
+        Regex("""(?i)\b(?:barefoot|bare feet|(?:her |my |the )?(?:boots?|shoes) off)\b""") to setOf(Part.BOOTS)
+    )
+
+    /** What her words leave of her plate outfit. */
+    sealed class Outfit {
+        /** Her words say nothing of what she wears: her plate outfit. */
+        data object Plate : Outfit()
+
+        /** Her words only take parts of it off ([off]) or open it: the rest of her plate outfit. */
+        data class Less(val off: Set<Part>) : Outfit()
+
+        /** Her words say what she wears, or that she wears nothing: none of her plate outfit. */
+        data object Own : Outfit()
+    }
+
+    /**
+     * What [ask] leaves of her plate outfit. "Boots on the rail" is where her boots are, not
+     * what she wears, and leaves her outfit as it is; "topless" takes off the shirt and the
+     * bandeau and leaves the skirt, the thigh-highs and the boots (the plate outfit is the
+     * default, and less of it); "in a red hoodie" or "naked" dresses her in her own words.
+     */
+    fun outfitOf(ask: String): Outfit {
+        var rest = ask
+        val off = LinkedHashSet<Part>()
+        var took = false
+        for ((pattern, parts) in TAKEN_OFF) {
+            if (pattern.containsMatchIn(rest)) {
+                took = true
+                off += parts
+                rest = pattern.replace(rest, " ")
+            }
+        }
+        return when {
+            WEARING.containsMatchIn(rest) || IN_GARMENT.containsMatchIn(rest) -> Outfit.Own
+            took -> Outfit.Less(off)
+            else -> Outfit.Plate
+        }
+    }
+
+    /** Whether [ask] says what she wears, so that none of her plate outfit is asked for. */
+    fun namesClothes(ask: String): Boolean = outfitOf(ask) == Outfit.Own
+
+    /** The parts of her plate outfit left out of a picture of [ask]: all of them where her words dress her. */
+    private fun offOf(ask: String, view: PersonaSelfPictures.View?): Set<Part> = when (val outfit = if (view != null) Outfit.Own else outfitOf(ask)) {
+        Outfit.Plate -> emptySet()
+        is Outfit.Less -> outfit.off
+        Outfit.Own -> Part.entries.toSet()
+    }
+
+    private const val COLOURS = """black|blonde?|brown|brunette|pink|blue|silver|white|platinum|purple|violet|green|ash|gr[ae]y|orange|teal|lilac|lavender"""
+
+    /**
+     * Words of hers that give her hair another colour: "i dyed my hair black", "hair's pink
+     * now", "blonde". Roots, bleach, a mess or a new cut keep her red.
+     */
+    private val OTHER_HAIR = Regex(
+        """(?i)\b(?:blonde?|brunette|platinum)\b|\bdye[ds]?\W+(?:\w+\W+){0,2}(?:$COLOURS)\b|""" +
+            """\bhair\W+(?:(?:is|was|s|now|gone|went|got|turned|all)\W+){0,2}(?:$COLOURS)\b|\b(?:$COLOURS)\W+hair\b"""
+    )
+
+    /** Words of hers that take her tan away: pale, the tan gone. Oiled skin, a sunburn or a new tattoo keep it. */
+    private val NO_TAN = Regex(
+        """(?i)\b(?:pale(?![ -](?:moon\w*|light\w*|blue|pink|green|yellow|purple|lilac|grey|gray|sky|glow\w*|neon|morning|dawn|sun\w*|""" +
+            """walls?|sheets?|straps?|colou?rs?|tones?|pastel\w*|shirt|dress))|untanned|no tan|fair[ -]skinned|fair skin|porcelain|""" +
+            """(?:lost|without) (?:my|the|her) tan|""" +
+            """tan(?:'s| is| has)? (?:gone|faded|fading|washed out))\b"""
+    )
+
+    /** Words that name her face: then her default grin is not asked for. */
+    private val EXPRESSION = Regex(
+        """(?i)\b(?:smil\w*|grin\w*|laugh\w*|cry\w*|cries|tears?|sad|angry|mad|pout\w*|frown\w*|sulk\w*|mouth (?:shut|closed)|closed mouth|""" +
+            """asleep|sleep\w*|serious|bored|kiss\w*|wink\w*|eyes (?:closed|shut)|blush\w*|scream\w*|yell\w*|shock\w*|surprised|scared|""" +
+            """neutral|expression|tongue|moan\w*|ahegao|bite|biting|licking|lick\w*)\b"""
+    )
+
+    /** Words that name a pose, a place she sits or lies, or what her hands hold: then her plate pose is not asked for. */
+    private val POSE = Regex(
+        """(?i)\b(?:sit\w*|sat|lying|lies|lie|lay\w*|kneel\w*|squat\w*|crouch\w*|walk\w*|run\w*|danc\w*|lean\w*|bend\w*|bent|""" +
+            """pose|posing|selfie|hold\w*|hand|hands|arms?|from behind|back view|on all fours|spread\w*|stretch\w*|jump\w*|hug\w*|""" +
+            """straddl\w*|riding|bed|sofa|couch|floor|bath\w*|shower\w*|asleep|sleep\w*|smok\w*|cigarette|phone|can|drink\w*|""" +
+            """eat\w*|close-?up|portrait|headshot|face|mirror)\b"""
+    )
+
+    /** Words that put her hair up: then "ponytail" is not in the negative prompt. */
+    private val HAIR_UP = Regex("""(?i)\b(?:pony ?tails?|twin ?tails|pigtails|buns?|braids?|braided|updo|hair (?:up|tied)|tied (?:up )?hair)\b""")
+
+    /**
+     * Words that never go to an image model as they are: "old school" (no school ever goes out
+     * in a picture of her) is said as "retro".
+     */
+    private val OLD_SCHOOL = Regex("""(?i)\bold[ -]school\b""")
+
+    /** [words] as they go out with a picture: "old school" as "retro". */
+    fun sendable(words: String): String = OLD_SCHOOL.replace(words, "retro")
+
+    /** The most of her own words about her look now that go into a picture's prompt. */
+    const val MAX_LOOK_NOW_CHARS = 200
+
+    /**
+     * The negative prompt of a picture of [ask] in [style] ([PictureGuard.negative]), with pale
+     * skin and a ponytail in it unless her words or her look now ([lookNow]) ask for them.
+     */
+    fun negative(style: PictureModels.Style, ask: String = "", lookNow: String = ""): String {
+        val words = "$ask $lookNow"
+        return PictureGuard.negative(style, paleSkin = NO_TAN.containsMatchIn(words), hairUp = HAIR_UP.containsMatchIn(words))
+    }
+
+    // ── New pictures ──────────────────────────────────────────────────────────────────
+
+    /**
+     * The prompt for a new picture of her on [model]: [scene] (her words about it, his name
+     * already out) and, where she noted how she looks now ([lookNow]), that. With [view] it
+     * is one side of a full-body reference: the shot of that side on a plain background, and
+     * [scene] is then what she wears on it, or nothing ([PersonaSelfPictures.BARE_REFERENCE]).
+     */
+    fun generate(
+        model: PictureModels.Model,
+        scene: String,
+        age: Int = PersonaAge.AGE_IN_FILES,
+        lookNow: String = "",
+        view: PersonaSelfPictures.View? = null
+    ): String {
+        val now = sendable(lookNow).trim().trimEnd('.').take(MAX_LOOK_NOW_CHARS).trim()
+        val words = sendable(scene).trim().trimEnd('.')
+        val wearing = if (view != null) words else ""
+        val off = offOf(words, view)
+        val ownHair = OTHER_HAIR.containsMatchIn(now) || OTHER_HAIR.containsMatchIn(words)
+        val ownSkin = NO_TAN.containsMatchIn(now) || NO_TAN.containsMatchIn(words)
+        // Her grin, unless her words name her face; never on a back view, where no face is seen.
+        val grin = view != PersonaSelfPictures.View.BACK && !EXPRESSION.containsMatchIn(words) && !EXPRESSION.containsMatchIn(now)
+        // Her plate pose, on an ordinary picture whose words name no pose and nothing in her hands.
+        val pose = view == null && !POSE.containsMatchIn(words)
+        return if (model.style == PictureModels.Style.ANIME_TAGS) {
+            val head = listOfNotNull(
+                PictureGuard.anchorTags(age),
+                HAIR_TAGS.takeUnless { ownHair },
+                SKIN_TAGS.takeUnless { ownSkin },
+                FACE_TAGS,
+                now.takeIf { it.isNotEmpty() }?.let { "($it)" },
+                view?.let(::viewTags),
+                when {
+                    view == null -> words.takeIf { it.isNotEmpty() }
+                    wearing.isEmpty() -> BARE_TAGS
+                    else -> wearing
+                },
+                DEFAULT_FACE_TAGS.takeIf { grin }
+            ).joinToString(", ")
+            val outfit = OUTFIT_TAGS.filter { (part, _) -> part !in off }.map { it.second }
+            fit(head, listOf(DETAIL_TAGS) + outfit + listOfNotNull(POSE_TAGS.takeIf { pose }), STYLE_TAGS, ", ", model.promptLimit)
+        } else {
+            val style = if (model.style == PictureModels.Style.PHOTO) STYLE_PHOTO else STYLE_ANIME_PROSE
+            val looks = listOfNotNull(HAIR_PROSE.takeUnless { ownHair }, SKIN_PROSE.takeUnless { ownSkin }, FACE_PROSE).joinToString(", ")
+            val head = buildString {
+                append(PictureGuard.anchor(age)).append(' ')
+                append(style).append(' ')
+                append("She is Japanese, with ").append(looks).append('.')
+                if (now.isNotEmpty()) append(" Her look now, in her own words: ").append(now).append('.')
+                if (view != null) {
+                    append(" A full-body character reference of her, ").append(view.shot)
+                    append(": standing straight in a relaxed pose, arms a little away from her body, feet slightly apart, the whole body from head to feet in the frame, a plain light grey background and even soft light.")
+                    append(" On her body, ").append(wearing.ifEmpty { PersonaSelfPictures.BARE_REFERENCE }).append('.')
+                } else if (words.isNotEmpty()) {
+                    append(" The picture: ").append(words).append('.')
+                }
+                if (grin) append(DEFAULT_FACE_PROSE)
+            }
+            val optional = listOf(DETAIL_PROSE) + listOfNotNull(outfitProse(off).takeIf { it.isNotEmpty() }, POSE_PROSE.takeIf { pose })
+            fit(head, optional, "", " ", model.promptLimit)
+        }
+    }
+
+    /** One side of a full-body reference as tags. */
+    private fun viewTags(view: PersonaSelfPictures.View): String = when (view) {
+        PersonaSelfPictures.View.FRONT -> "full body, standing, front view, facing viewer, looking at viewer"
+        PersonaSelfPictures.View.BACK -> "full body, standing, from behind, back view, facing away"
+        PersonaSelfPictures.View.LEFT -> "full body, standing, from side, profile, facing left"
+        PersonaSelfPictures.View.RIGHT -> "full body, standing, from side, profile, facing right"
+    } + ", arms slightly away from body, feet slightly apart, plain light grey background, simple background, even lighting"
+
+    /** What a body reference shows when she names nothing to wear, as tags. */
+    const val BARE_TAGS = "completely nude, barefoot, piercings visible"
+
+    /**
+     * [head], then as many whole parts of [optional] as fit, then [tail], within [limit]
+     * characters. The head is the guard, her look and her words; it is cut only where it
+     * alone would not fit, and then from its end, never its start.
+     */
+    private fun fit(head: String, optional: List<String>, tail: String, separator: String, limit: Int): String {
+        val room = limit - (if (tail.isEmpty()) 0 else tail.length + separator.length)
+        var text = if (head.length > room) head.take(room).trimEnd(' ', ',') else head
+        for (part in optional) {
+            if (text.length + separator.length + part.length > room) continue
+            text += separator + part
+        }
+        return if (tail.isEmpty()) text.trim() else (text + separator + tail).trim()
+    }
+
+    // ── A small change to one of her pictures ─────────────────────────────────────────
+
+    /** The most characters an edit prompt is: the edit models do best with short prompts. */
+    const val MAX_EDIT_CHARS = 1000
+
+    /**
+     * The prompt for a small change to one of her pictures ([ask]: one change, his name out),
+     * on an edit model: the adult guard, the change, her look now where she noted it, and
+     * that everything else stays as it is. Positive words only.
+     */
+    fun edit(ask: String, age: Int = PersonaAge.AGE_IN_FILES, lookNow: String = ""): String {
+        val now = sendable(lookNow).trim().trimEnd('.').take(MAX_LOOK_NOW_CHARS).trim()
+        val head = PictureGuard.anchor(age) + " " + PictureGuard.EDIT_LINE + " Change only this: " + sendable(ask).trim().trimEnd('.') + "."
+        val nowLine = if (now.isEmpty()) "" else " Her look now, in her own words: $now."
+        return (head + nowLine + " " + KEEP_REST).take(MAX_EDIT_CHARS).trim()
+    }
+
+    /** What an edit keeps. */
+    const val KEEP_REST =
+        "Keep everything the change does not name exactly as it is in the picture: her face, eyes, hair and ahoge, tan, piercings, " +
+            "clothes, pose, background and the drawing style."
+
+    // ── Matching a new picture to her own pictures ────────────────────────────────────
+
+    /**
+     * The prompt for the pass that matches a new picture (image 1) to [references] of her own
+     * pictures (images 2 on) on [PictureModels.MATCH]: the same woman, her pose and scene kept,
+     * and every small thing of her that a model drawing from words gets wrong (the liner, the
+     * nails, the cuffs, which side the lip stud is on). With [outfitFromPlates] her plate outfit
+     * comes over too, print and marks where they show, except what [takenOff] says she has
+     * taken off in image 1; without it she keeps what she wears in image 1. With [view] the
+     * side she is seen from is kept: his pictures of her are front views, and a back view
+     * must not be turned to the camera or get her front's marks on its back.
+     */
+    fun match(
+        references: Int,
+        outfitFromPlates: Boolean,
+        style: PictureModels.Style,
+        age: Int = PersonaAge.AGE_IN_FILES,
+        view: PersonaSelfPictures.View? = null,
+        takenOff: Boolean = false
+    ): String {
+        val theirs = if (references <= 1) "image 2" else "images 2 to ${references + 1}"
+        val look = if (style == PictureModels.Style.PHOTO) "photographic look" else "2D clean anime drawing style"
+        return buildString {
+            append(PictureGuard.anchor(age)).append(' ').append(PictureGuard.EDIT_LINE)
+            append(" Make the woman in image 1 the same woman as in ").append(theirs)
+            append(": the same face, eyes, hair and ahoge, tan, liner, nails, choker, wrist cuffs and piercings ")
+            append("(the silver stud on the right side of her lower lip, her right)")
+            if (outfitFromPlates) {
+                append(", and the same outfit, with its print and marks where they show")
+                if (takenOff) append(", except what she has taken off in image 1")
+            }
+            append(". Keep image 1's pose, scene, framing, light and $look")
+            if (!outfitFromPlates) append(", and exactly what she wears in image 1")
+            append('.')
+            when (view) {
+                PersonaSelfPictures.View.BACK -> append(
+                    " She is seen from behind in image 1: keep her facing away. Her face, the shirt knot, the print and the marks " +
+                        "on the front of her right thigh are on her front only, and stay unseen on her back and the backs of her thighs."
+                )
+                PersonaSelfPictures.View.LEFT, PersonaSelfPictures.View.RIGHT -> append(" Keep her in the same full profile as in image 1.")
+                PersonaSelfPictures.View.FRONT, null -> {}
+            }
+        }
+    }
+
+    // ── Her reference sheets ──────────────────────────────────────────────────────────
+
+    /**
+     * What she wears on a reference sheet in the plain base layer: simple fitted clothing, not
+     * nude, so that the shape of her body can be read and clothes worked out on it later. The
+     * things that never come off stay (kisaragi-look: the cuffs, the choker, the metal).
+     */
+    const val BASE_LAYER_PROSE =
+        "a plain fitted base layer: a simple fitted plain black sleeveless top and simple fitted plain black shorts, close to her body so that its shape shows, and bare feet. " +
+            "Her piercings, her black choker and her black leather wrist cuffs stay on."
+
+    /** What she wears on a reference sheet in her outfit: her plate outfit as her picture file fixes it, and the small things that go with any outfit. */
+    fun outfitSheetProse(): String = "her own outfit. " + outfitProse(emptySet()) + " " + DETAIL_PROSE
+
+    /**
+     * What a sheet in her outfit keeps of it from her own pictures, seen from [side] ([sheet]):
+     * the print on her bandeau, the toy and the tally (kisaragi-look). Her outfit's words leave
+     * them out, as for a model that draws from words (see the class note); an edit of her own
+     * picture keeps them where they show in it, and in her other pictures ([from]: "image 1",
+     * "image 1 and images 2 to 3"). From behind only a little of the toy shows: the print and
+     * the tally are on her front ([sheet] says so with the back view).
+     */
+    fun outfitMarks(side: ReferenceSheets.Side, from: String): String = when (side) {
+        ReferenceSheets.Side.BACK -> " Keep the bit of the pink egg that shows on the inside of her left thigh as in $from."
+        ReferenceSheets.Side.FRONT, ReferenceSheets.Side.SIDE ->
+            " Keep as in $from, where they show: the print across her bandeau, the pink egg under the white band of her left thigh-high " +
+                "with its pink wire and controller, and the tally on the front of her right thigh."
+    }
+
+    /**
+     * The prompt for one reference sheet ([ReferenceSheets]): image 1, one of her originals or
+     * masters seen from [side], redrawn in [look] and nothing else changed; with [others] more
+     * of her originals or masters (images 2 on) she stays the same woman as in them. In her
+     * outfit, the print, the toy and the tally are kept from image 1 and the others where they
+     * show ([outfitMarks]), so that a sheet that becomes a master carries her whole look. Her look
+     * comes from her files, as in every picture prompt; her own notes about how she looks now
+     * do not go into a sheet, which is the fixed base the others start from. Positive words only.
+     * Within what the edit model reads ([PictureModels.MATCH]), for every look, side and number of others.
+     */
+    fun sheet(look: ReferenceSheets.Look, side: ReferenceSheets.Side, others: Int, age: Int = PersonaAge.AGE_IN_FILES): String = buildString {
+        val theirs = when {
+            others <= 0 -> ""
+            others == 1 -> "image 2"
+            else -> "images 2 to ${others + 1}"
+        }
+        val outfit = look == ReferenceSheets.Look.OUTFIT
+        append(PictureGuard.anchor(age)).append(' ').append(PictureGuard.EDIT_LINE)
+        append(" Image 1 is a character reference picture of her, seen from the ").append(side.word).append('.')
+        append(" Change only what she wears, to ")
+        append(if (outfit) outfitSheetProse() else BASE_LAYER_PROSE)
+        if (outfit) append(outfitMarks(side, if (theirs.isEmpty()) "image 1" else "image 1 and $theirs"))
+        if (theirs.isNotEmpty()) {
+            append(" She is the same woman as in ").append(theirs)
+            append(": the same face, eyes, hair and ahoge, tan, liner, nails, choker, wrist cuffs and piercings ")
+            append("(the silver stud on the right side of her lower lip, her right).")
+        }
+        append(" Keep everything else exactly as it is in image 1: her body and its proportions, her pose, the camera, the framing, ")
+        append("the light, the plain background and the style.")
+        if (side == ReferenceSheets.Side.BACK) {
+            append(" She is seen from behind: keep her facing away.")
+            append(if (outfit) " Her face, the print and the tally are on her front and stay unseen." else " Her face and what is on her front stay unseen.")
+        }
+    }
+
+    // ── The test picture of "Try picture models" ──────────────────────────────────────
+
+    /** The one picture every model is tried with: not sexual, her usual outfit, a Tokyo street at night. */
+    const val TRIAL_SCENE =
+        "a selfie at night on a Tokyo street, holding her phone up at arm's length, neon signs and the light of a konbini behind her, " +
+            "a crooked grin with her tongue out"
+
+    /** The same test as an edit of one of her pictures, for an edit model: the way her pictures were made before. */
+    const val TRIAL_EDIT = "put her on a Tokyo street at night taking a selfie, phone held up at arm's length, neon signs and a konbini behind her"
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PictureSources.kt b/app/src/main/java/com/opendroid/ai/core/persona/PictureSources.kt
