+/**
+ * Whose words a plan sends: his message or her command passes, a tool's composition does
+ * not, and only words that go to a person, a site or another app are looked at.
+ */
+class PlanWordsTest {
+
+    private fun step(id: String, action: String, params: Map<String, String> = emptyMap(), fallback: String = "") = PlanStep(
+        stepId = id,
+        order = id.filter(Char::isDigit).toIntOrNull() ?: 1,
+        description = "the planner's own words about the step",
+        action = action,
+        params = params,
+        fallback = fallback
+    )
+
+    private fun his(message: String) = PlanWords.Sources(listOf(message))
+
+    private fun notTheirs(message: String, vararg steps: PlanStep) = PlanWords.notTheirs(steps.toList(), his(message))
+
+    // ── His words and hers pass ──────────────────────────────────────────────────────
+
+    @Test
+    fun `his words, as he wrote them, pass`() {
+        val sms = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "I'll be late, sorry!"))
+        assertTrue(notTheirs("text mom I'll be late, sorry!", sms).isEmpty())
+        // Her command passes the same way.
+        val hers = step("s1", "SEND_TELEGRAM", mapOf("contact" to "@nene", "message" to "where are you"))
+        assertTrue(notTheirs("text nene: where are you", hers).isEmpty())
+    }
+
+    @Test
+    fun `small changes of punctuation, case and width are still his words`() {
+        for (written in listOf("i'll be late sorry", "I’ll be LATE. Sorry", "  I'll  be late,   sorry!!  ", "Ｉ'll be late, sorry")) {
+            val sms = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to written))
+            assertTrue(written, notTheirs("text mom I'll be late, sorry!", sms).isEmpty())
+        }
+        // The words in another order, or a greeting put in front of a long message, are still his.
+        val reordered = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "sorry, I'll be late"))
+        assertTrue(notTheirs("text mom I'll be late, sorry!", reordered).isEmpty())
+        val long = "tell her the train stopped at the bridge and I will be home around nine tonight with the groceries"
+        val greeted = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Hey, the train stopped at the bridge and I will be home around nine tonight with the groceries"))
+        assertTrue(notTheirs("text mom $long", greeted).isEmpty())
+    }
+
+    @Test
+    fun `a body the tool composed does not pass, nor a sign-off in his name`() {
+        val email = step(
+            "s1", "SEND_EMAIL",
+            mapOf(
+                "to" to "support@tumblr.com",
+                "subject" to "Blog flagged",
+                "body" to "Hello Tumblr Support,\n\nI am writing because my blog was flagged by mistake. Could you please review it?\n\nBest regards,\nRen"
+            )
+        )
+        val found = notTheirs("email tumblr support about my blog being flagged", email).single()
+        assertEquals(null, found.inMacro)
+        assertEquals(PlanWords.Kind.EMAIL, found.words.kind)
+        assertEquals(listOf("subject", "body"), found.words.fields)
+        // The subject is his words; the body is not.
+        assertEquals(listOf("body"), found.words.notTheirs)
+        assertEquals(listOf("support@tumblr.com"), found.words.to)
+
+        val signed = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "I'll be late, sorry! - Ren"))
+        assertEquals(listOf("message"), notTheirs("text mom I'll be late, sorry!", signed).single().words.notTheirs)
+    }
+
+    @Test
+    fun `a sign-off on a long message of his is not his words, his name least of all`() {
+        val train = "text mom the train stopped at the bridge and I will be home around nine tonight"
+        for (sources in listOf(his(train), PlanWords.Sources(listOf(train), names = listOf("Ren Takahashi")))) {
+            for (signed in listOf(
+                "The train stopped at the bridge and I will be home around nine tonight. - Ren",
+                "The train stopped at the bridge and I will be home around nine tonight. Love, mom's boy",
+                "The train stopped at the bridge and I will not be home around nine tonight"
+            )) {
+                assertFalse(signed, PlanWords.isTheirs(signed, sources))
+            }
+            // The same words with a greeting in front are still his.
+            assertTrue(PlanWords.isTheirs("Hey, the train stopped at the bridge and I will be home around nine tonight", sources))
+        }
+        // A dictated email body of his with a sign-off put under it.
+        val dictated = "email boss@example.com saying I am sick today with a fever and a sore throat, I will not be in the office " +
+            "and I will check my mail in the afternoon if I feel better, the report is in the shared folder"
+        val body = "I am sick today with a fever and a sore throat, I will not be in the office and I will check my mail in the " +
+            "afternoon if I feel better, the report is in the shared folder.\n\nThanks, Ren"
+        assertFalse(PlanWords.isTheirs(body, his(dictated)))
+        assertTrue(PlanWords.isTheirs(body.substringBefore("\n\nThanks"), his(dictated)))
+        // A name that is also a word a person may add is still his name.
+        val will = "I will be home around nine tonight with the groceries and the mail, the train stopped at the bridge"
+        assertTrue(PlanWords.isTheirs("$will will", his("text mom $will")))
+        assertFalse(PlanWords.isTheirs("$will will", PlanWords.Sources(listOf("text mom $will"), names = listOf("Will"))))
+        // Where he wrote his name himself, it is his.
+        assertTrue(PlanWords.isTheirs("$will - Ren", PlanWords.Sources(listOf("text mom $will - Ren"), names = listOf("Ren"))))
+    }
+
+    @Test
+    fun `a sign-off in Japanese is not his words either`() {
+        val message = "ママに先に食べてて、電車が止まったから少し遅くなるって送って"
+        assertTrue(PlanWords.isTheirs("先に食べてて、電車が止まったから少し遅くなる", his(message)))
+        assertFalse(PlanWords.isTheirs("先に食べてて、電車が止まったから少し遅くなる。レン", his(message)))
+        assertFalse(PlanWords.isTheirs("先に食べてて、電車が止まったから少し遅くなる。レン", PlanWords.Sources(listOf(message), names = listOf("レン"))))
+        // A particle changed is still his.
+        assertTrue(PlanWords.isTheirs("先に食べてて、電車が止まったので少し遅くなる", his(message)))
+    }
+
+    @Test
+    fun `an answer an earlier step gives is the phone's own output and passes`() {
+        val weather = step("s1", "GET_WEATHER", mapOf("location" to "Osaka"))
+        val pasted = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "\$\$s1"))
+        val framed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Today's weather: \$\$s1"))
+        val single = step("s2", "SEND_WHATSAPP", mapOf("contact" to "Mom", "message" to "\$s1"))
+        assertTrue(PlanWords.notTheirs(listOf(weather, pasted), his("text mom the weather in osaka")).isEmpty())
+        assertTrue(PlanWords.notTheirs(listOf(weather, framed), his("text mom today's weather in osaka")).isEmpty())
+        assertTrue(PlanWords.notTheirs(listOf(weather, single), his("whatsapp mom the weather")).isEmpty())
+        // Words around the answer are still held to his.
+        val composed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Mom, don't forget your umbrella: \$\$s1"))
+        assertEquals(1, PlanWords.notTheirs(listOf(weather, composed), his("text mom the weather")).size)
+        // The ".result" the executor also reads is part of the reference.
+        val suffixed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "\$\$s1.result"))
+        assertTrue(PlanWords.notTheirs(listOf(weather, suffixed), his("text mom the weather")).isEmpty())
+        // A stretch copied word for word from what a step put out passes; a sentence of words
+        // that only occur somewhere in it does not.
+        val result = "Weather in Osaka: light rain, 18 C, wind from the north. The week ahead looks warm and you will need no coat at all."
+        val sources = PlanWords.Sources(listOf("text mom the weather"), pasted = listOf(result))
+        assertTrue(PlanWords.isTheirs("The weather: light rain, 18 C", sources))
+        assertFalse(PlanWords.isTheirs("you will need the coat in the week ahead", sources))
+    }
