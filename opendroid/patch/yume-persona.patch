+package com.opendroid.ai.actions
+
+import android.content.Context
+import android.content.ContextWrapper
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.agent.ActionSequenceExecutor
+import com.opendroid.ai.core.agent.HerPresence
+import com.opendroid.ai.core.record.Outcome
+import com.opendroid.ai.core.record.PhoneLogEntry
+import com.opendroid.ai.core.record.PhoneRecorder
+import com.opendroid.ai.core.record.Starter
+import com.opendroid.ai.core.record.StepEnd
+import com.opendroid.ai.data.db.dao.MacroDao
+import com.opendroid.ai.data.db.entities.MacroEntity
+import com.opendroid.ai.data.models.PlanStep
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * While she is on, RUN_MACRO runs only a macro he left on, and never writes to an address
+ * or number that only sends: such a step is left out with the plain reason, and so is a
+ * step that uses what it would have returned. The result names every step that was left
+ * out. An emergency number is not a sender that only sends.
+ *
+ * With her off the app is stock but for the build's switch-offs (plan section 4), so those
+ * two checks are not made then; an auto-reply step, which has nothing to do in this build,
+ * is left out whoever is on, and the rest of the macro runs. The record of what the phone
+ * did tells every step that was left out, in its place, as not run and why.
+ */
+class MacroRunTest {
+
+    private val context: Context = ContextWrapper(null)
+
+    @Test
+    fun `a macro he switched off does not run and says so`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro("evening", enabled = false, step("s1", 1, "SEND_SMS", "to" to "+15551234567", "message" to "home soon")),
+            dispatched
+        )
+
+        assertFalse(result.success)
+        assertEquals("Macro 'evening' is switched off, so it did not run.", result.error)
+        assertEquals(emptyList<String>(), dispatched)
+    }
+
+    @Test
+    fun `a step to an address that only sends is skipped, and the rest runs`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "morning", enabled = true,
+                step("s1", 1, "GET_WEATHER", "location" to "Osaka"),
+                step("s2", 2, "SEND_EMAIL", "to" to "Tumblr <no-reply@tumblr.com>", "subject" to "Re: your post", "body" to "thanks"),
+                step("s3", 3, "SEND_SMS", "to" to "+15551234567", "message" to "up early today")
+            ),
+            dispatched
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("GET_WEATHER", "SEND_SMS"), dispatched)
+        assertEquals(
+            "Macro completed successfully (2 steps). " +
+                "Step 2 (SEND_EMAIL) was skipped: no-reply@tumblr.com is an address that only sends.",
+            result.data
+        )
+    }
+
+    @Test
+    fun `a step that uses what a skipped step would have returned is skipped too`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "codes", enabled = true,
+                step("s1", 1, "SEND_SMS", "to" to "57575", "message" to "STOP"),
+                step("s2", 2, "COPY_TO_CLIPBOARD", "text" to "\$\$s1"),
+                step("s10", 3, "GET_WEATHER", "location" to "Osaka")
+            ),
+            dispatched
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("GET_WEATHER"), dispatched)
+        val data = result.data.orEmpty()
+        assertTrue(data, data.contains("Step 1 (SEND_SMS) was skipped: 57575 is an SMS short code, which only sends."))
+        assertTrue(data, data.contains("Step 2 (COPY_TO_CLIPBOARD) was skipped: it uses what a skipped step would have returned."))
+    }
+
+    @Test
+    fun `a macro whose every step is skipped does nothing and says why`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro("bots", enabled = true, step("s1", 1, "SEND_TELEGRAM", "username" to "@weather_bot", "message" to "hi")),
+            dispatched
+        )
+
+        assertFalse(result.success)
+        assertEquals("Macro 'bots' did not run: Step 1 (SEND_TELEGRAM) was skipped: @weather_bot is a bot.", result.error)
+        assertEquals(emptyList<String>(), dispatched)
+    }
+
+    @Test
+    fun `a failure of the steps that ran still names the skipped ones`() = runBlocking {
+        val result = run(
+            macro(
+                "mixed", enabled = true,
+                step("s1", 1, "SEND_EMAIL", "to" to "notifications@github.com", "subject" to "x", "body" to "y"),
+                step("s2", 2, "OPEN_APP", "app" to "maps")
+            ),
+            mutableListOf(),
+            outcome = { ActionResult.Failure("Maps is not installed.") }
+        )
+
+        assertFalse(result.success)
+        assertEquals(
+            "Macro stopped at step 2 (OPEN_APP): Maps is not installed. " +
+                "Step 1 (SEND_EMAIL) was skipped: notifications@github.com is an address that only sends.",
+            result.error
+        )
+    }
+
+    @Test
+    fun `people, calls and steps that write to nobody are left as they are`() {
+        val sorted = MacroRun.sort(
+            herOn = true,
+            steps = listOf(
+                step("s1", 1, "SEND_WHATSAPP", "contact" to "Mom", "message" to "on my way"),
+                step("s2", 2, "SEND_EMAIL", "to" to "aoi@example.com", "subject" to "hi", "body" to "hello"),
+                // A short number can be an emergency line: a call is never skipped.
+                step("s3", 3, "MAKE_CALL", "contact" to "112"),
+                step("s4", 4, "CONVERT_UNITS", "value" to "5", "from" to "km", "to" to "miles")
+            )
+        )
+
+        assertEquals(listOf("s1", "s2", "s3", "s4"), sorted.toRun.map { it.stepId })
+        assertTrue(sorted.skipped.isEmpty())
+    }
+
+    @Test
+    fun `the steps run in the macro's order`() {
+        val sorted = MacroRun.sort(
+            herOn = true,
+            steps = listOf(
+                step("b", 2, "SEND_SMS", "to" to "VM-HDFCBK", "message" to "ok"),
+                step("a", 1, "GET_WEATHER", "location" to "Osaka")
+            )
+        )
+
+        assertEquals(listOf("a"), sorted.toRun.map { it.stepId })
+        assertEquals(listOf(MacroRun.Skipped(2, "SEND_SMS", "VM-HDFCBK is an SMS sender ID, which only sends")), sorted.skipped)
+    }
+
+    @Test
+    fun `with her off a macro he switched off runs, as in the stock app`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro("evening", enabled = false, step("s1", 1, "SEND_SMS", "to" to "+15551234567", "message" to "home soon")),
+            dispatched,
+            presence = HerPresence.OFF
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("SEND_SMS"), dispatched)
+    }
+
+    @Test
+    fun `with her off a step to a sender that only sends runs, as in the stock app`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "bank", enabled = true,
+                step("s1", 1, "SEND_SMS", "to" to "56767", "message" to "BAL"),
+                step("s2", 2, "SEND_EMAIL", "to" to "no-reply@tumblr.com", "subject" to "x", "body" to "y")
+            ),
+            dispatched,
+            presence = HerPresence.OFF
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("SEND_SMS", "SEND_EMAIL"), dispatched)
+        assertEquals("Macro completed successfully (2 steps).", result.data)
+    }
+
+    @Test
+    fun `an auto-reply step saved before the update is skipped whoever is on, and the steps around it run`() = runBlocking {
+        for (presence in listOf(HerPresence.ON, HerPresence.OFF)) {
+            val dispatched = mutableListOf<String>()
+            val result = run(
+                macro(
+                    "driving", enabled = true,
+                    step("s1", 1, "TOGGLE_DND", "state" to "on"),
+                    step("s2", 2, "AUTO_REPLY_TOGGLE", "state" to "on", "app" to "whatsapp"),
+                    step("s3", 3, "OPEN_APP", "app" to "maps")
+                ),
+                dispatched,
+                presence = presence
+            )
+
+            assertTrue(result.success)
+            assertEquals(listOf("TOGGLE_DND", "OPEN_APP"), dispatched)
+            assertEquals(
+                "Macro completed successfully (2 steps). " +
+                    "Step 2 (AUTO_REPLY_TOGGLE) was skipped: Auto-reply is off in this build. Nothing answers messages for you.",
+                result.data
+            )
+        }
+        // Switching it off is skipped the same way, and so is the step under another spelling.
+        val bedtime = MacroRun.sort(
+            herOn = false,
+            steps = listOf(
+                step("s1", 1, "auto reply toggle", "state" to "off"),
+                step("s2", 2, "SET_ALARM", "time" to "07:00")
+            )
+        )
+        assertEquals(listOf("s2"), bedtime.toRun.map { it.stepId })
+        assertEquals(listOf(1), bedtime.skipped.map { it.number })
+    }
+
+    @Test
+    fun `a text to an emergency number is not taken for a short code`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "SOS", enabled = true,
+                step("s1", 1, "GET_LOCATION"),
+                step("s2", 2, "SEND_SMS", "contact" to "911", "message" to "Need help at \$\$s1"),
+                step("s3", 3, "SEND_SMS", "contact" to "Mom", "message" to "Texted 911")
+            ),
+            dispatched
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("GET_LOCATION", "SEND_SMS", "SEND_SMS"), dispatched)
+        assertEquals("Macro completed successfully (3 steps).", result.data)
+
+        for (line in listOf("112", "999", "000", " 1 1 2 ", "10111")) {
+            val sorted = MacroRun.sort(listOf(step("s1", 1, "SEND_SMS", "to" to line, "message" to "help")), herOn = true)
+            assertTrue(line, sorted.skipped.isEmpty())
+        }
+        // A short code that is not an emergency line is still left out.
+        val code = MacroRun.sort(listOf(step("s1", 1, "SEND_SMS", "to" to "56767", "message" to "STOP")), herOn = true)
+        assertEquals(listOf("56767 is an SMS short code, which only sends"), code.skipped.map { it.reason })
+    }
+
+    @Test
+    fun `a macro's step is addressed as a plan's step is, copies, compose links and fallbacks included`() = runBlocking {
+        val dispatched = mutableListOf<Pair<String, Map<String, String>>>()
+        val email = step("s1", 1, "SEND_EMAIL", "to" to "me@corp.com", "cc" to "no-reply@tumblr.com", "subject" to "appeal", "body" to "see below")
+        val link = step(
+            "s2", 2, "OPEN_URL",
+            "url" to "https://mail.google.com/mail/?view=cm&to=no-reply@tumblr.com&body=please%20review%20my%20blog"
+        )
+        val call = step("s3", 3, "MAKE_CALL", "contact" to "56767", "message" to "STOP").copy(fallback = "SEND_SMS")
+        val result = runWithParams(macro("appeal", enabled = true, email, link, call), dispatched)
+
+        assertTrue(result.success)
+        // The copy that only sends is taken off and the mail goes to the person on it; the
+        // compose link for a machine does not open; the call runs without its fallback.
+        assertEquals(listOf("SEND_EMAIL", "MAKE_CALL"), dispatched.map { it.first })
+        assertEquals(null, dispatched[0].second["cc"])
+        assertEquals("me@corp.com", dispatched[0].second["to"])
+        assertEquals(null, dispatched[1].second["message"])
+        assertEquals(
+            "Macro completed successfully (2 steps). " +
+                "Step 1 (SEND_EMAIL): no-reply@tumblr.com is an address that only sends, so it was taken off this step. " +
+                "Step 2 (OPEN_URL) was skipped: no-reply@tumblr.com is an address that only sends. " +
+                "Step 3 (MAKE_CALL): 56767 is an SMS short code, which only sends, so its fallback was taken off.",
+            result.data
+        )
+        val sorted = MacroRun.sort(listOf(email, link, call), herOn = true)
+        assertEquals("", sorted.toRun.single { it.stepId == "s3" }.fallback)
+        assertEquals(listOf(1, 3), sorted.numbers)
+
+        // With her off the macro runs as it was saved, as in the stock app.
+        val stock = MacroRun.sort(listOf(email, link, call), herOn = false)
+        assertEquals(listOf(email, link, call), stock.toRun)
+        assertTrue(stock.takenOff.isEmpty())
+    }
+
+    @Test
+    fun `the record tells a macro's skipped steps in their places, as not run and why, even when none of it ran`() = runBlocking {
+        val recorded = mutableListOf<PhoneLogEntry>()
+        val recorder = PhoneRecorder { recorded += it }
+        val dispatched = mutableListOf<String>()
+        run(
+            macro(
+                "driving", enabled = true,
+                step("s1", 1, "TOGGLE_DND", "state" to "on"),
+                step("s2", 2, "AUTO_REPLY_TOGGLE", "state" to "on"),
+                step("s3", 3, "SEND_SMS", "to" to "56767", "message" to "STOP"),
+                step("s4", 4, "OPEN_APP", "appName" to "Maps")
+            ),
+            dispatched,
+            recorder = recorder
+        )
+        assertEquals(listOf("TOGGLE_DND", "OPEN_APP"), dispatched)
+        val entry = recorded.single()
+        assertEquals(Starter.MACRO, entry.who)
+        assertEquals("driving", entry.why)
+        assertEquals(listOf(StepEnd.DONE, StepEnd.NOT_RUN, StepEnd.NOT_RUN, StepEnd.DONE), entry.steps.map { it.end })
+        // The record is told to her: the auto-reply line speaks of the build, not to him.
+        assertEquals(
+            listOf(null, "auto-reply is off in this build", "56767 is an SMS short code, which only sends", null),
+            entry.steps.map { it.reason }
+        )
+        assertEquals(Outcome.PARTLY, entry.outcome)
+
+        // None of it runs: it is on the record all the same, every step as not run and why.
+        recorded.clear()
+        val none = run(
+            macro("bedtime", enabled = true, step("s1", 1, "auto reply toggle", "state" to "off")),
+            dispatched,
+            presence = HerPresence.OFF,
+            recorder = recorder
+        )
+        assertFalse(none.success)
+        val nothing = recorded.single()
+        assertEquals(Starter.MACRO, nothing.who)
+        assertEquals(listOf(StepEnd.NOT_RUN), nothing.steps.map { it.end })
+        assertEquals("auto-reply is off in this build", nothing.steps.single().reason)
+        assertEquals(Outcome.NOT_RUN, nothing.outcome)
+
+        // A macro he switched off has no entry of its own: the plan step that asked for it
+        // is on the record with the plan, as failed and why.
+        recorded.clear()
+        run(macro("evening", enabled = false, step("s1", 1, "SEND_SMS", "to" to "+15551234567", "message" to "home soon")), dispatched, recorder = recorder)
+        assertTrue(recorded.isEmpty())
+    }
+
+    /** Runs [macro] with her on and keeps each dispatched action with the params it ran with. */
+    private suspend fun runWithParams(macro: MacroEntity, dispatched: MutableList<Pair<String, Map<String, String>>>): ActionResult {
+        val actions = MacroActions(
+            macroDao = OneMacroDao(macro),
+            actionSequenceExecutor = ActionSequenceExecutor(
+                executeAction = { action, params, _ ->
+                    dispatched += action to params
+                    ActionResult.Success()
+                },
+                hasAction = { true }
+            ),
+            herPresence = HerPresence.ON
+        )
+        return actions.getActions().first { it.name == "RUN_MACRO" }.execute(mapOf("macroName" to macro.name), context)
+    }
+
+    private suspend fun run(
+        macro: MacroEntity,
+        dispatched: MutableList<String>,
+        outcome: (String) -> ActionResult = { ActionResult.Success() },
+        presence: HerPresence = HerPresence.ON,
+        recorder: PhoneRecorder = PhoneRecorder.NONE
+    ): ActionResult {
+        val actions = MacroActions(
+            macroDao = OneMacroDao(macro),
+            actionSequenceExecutor = ActionSequenceExecutor(
+                executeAction = { action, _, _ ->
+                    dispatched += action
+                    outcome(action)
+                },
+                hasAction = { true },
+                recorder = recorder
+            ),
+            herPresence = presence
+        )
+        return actions.getActions().first { it.name == "RUN_MACRO" }.execute(mapOf("macroName" to macro.name), context)
+    }
+
+    private fun step(id: String, order: Int, action: String, vararg params: Pair<String, String>) =
+        PlanStep(stepId = id, order = order, description = action, action = action, params = params.toMap())
+
+    private fun macro(name: String, enabled: Boolean, vararg steps: PlanStep) = MacroEntity(
+        id = "macro-$name",
+        name = name,
+        trigger = "manual",
+        stepsJson = Json.encodeToString(steps.toList()),
+        isSystem = false,
+        isEnabled = enabled
+    )
+
+    private class OneMacroDao(private val macro: MacroEntity) : MacroDao {
+        override fun getAllMacrosFlow(): Flow<List<MacroEntity>> = MutableStateFlow(listOf(macro))
+        override suspend fun getAllMacros(): List<MacroEntity> = listOf(macro)
+        override suspend fun getMacroById(id: String): MacroEntity? = macro.takeIf { it.id == id }
+        override suspend fun getMacroByName(name: String): MacroEntity? = macro.takeIf { it.name == name }
+        override suspend fun insertMacro(macro: MacroEntity) = error("not written")
+        override suspend fun deleteMacro(id: String) = error("not deleted")
+        override suspend fun clearAllMacros() = error("not cleared")
+    }
+}
