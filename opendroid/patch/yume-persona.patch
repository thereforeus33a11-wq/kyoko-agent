+            .joinToString("\n").takeIf { it.isNotBlank() }
+        if (out.isEmpty()) {
+            return Record(
+                NOTHING_RAN,
+                fromSteps = false,
+                namesSteps = false,
+                stopped = false,
+                plainOutcome = false,
+                plannerWords = plannerWords
+            )
+        }
+        return Record(
+            out.joinToString("\n"),
+            fromSteps = true,
+            namesSteps = namesSteps,
+            stopped = stopped,
+            plainOutcome = plainOutcome,
+            plannerWords = plannerWords,
+            spoken = spoken.joinToString("\n")
+        )
+    }
+
+    /** The row left by a proposed plan the owner turned down. */
+    fun rejected(plan: Plan, canonicalName: (PlanStep) -> String): String = notApproved(plan, "rejected", canonicalName)
+
+    /** The row left by a proposed plan that was dropped before he answered, and [why]. */
+    fun dropped(plan: Plan, why: String, canonicalName: (PlanStep) -> String): String =
+        notApproved(plan, why, canonicalName)
+
+    /**
+     * A plan that waited for approval and did not get it. Usually nothing of it has run.
+     * A plan that was changed while it ran waits at the same gate with steps already
+     * done, and then the row has to say which.
+     */
+    private fun notApproved(plan: Plan, why: String, canonicalName: (PlanStep) -> String): String =
+        if (plan.steps.all { it.status == StepStatus.PENDING }) {
+            "Not run ($why): ${allSteps(plan)}"
+        } else {
+            stopped(plan, canonicalName, why)
+        }
+
+    /**
+     * The row left by a plan that was stopped while it ran: every step it had, then what
+     * had already run, what was under way and what never started. A step that was under
+     * way is not said to have run or not to have run, because that is not known.
+     * [why] says what stopped it, when that is known. [declinedStepId] is the step the
+     * owner said no to: whatever its status, it did not run. With [waitingForAnswer] the
+     * step under way was waiting for his answer and had not run either.
+     */
+    fun stopped(
+        plan: Plan,
+        canonicalName: (PlanStep) -> String,
+        why: String? = null,
+        declinedStepId: String? = null,
+        waitingForAnswer: Boolean = false
+    ): String {
+        val lines = PlanApprovalSummary.stepLines(plan)
+        val ran = mutableListOf<String>()
+        val failed = mutableListOf<String>()
+        val interrupted = mutableListOf<String>()
+        val notRun = mutableListOf<String>()
+        plan.steps.forEachIndexed { index, step ->
+            val canonical = canonicalName(step)
+            if (isTalkAction(canonical) || canonical in ASKING_ACTIONS) return@forEachIndexed
+            val label = lines.getOrElse(index) { step.action }
+            when {
+                step.stepId == declinedStepId -> notRun += label
+                step.status == StepStatus.COMPLETED -> ran += label
+                step.status == StepStatus.FAILED -> failed += label
+                step.status == StepStatus.RUNNING && !waitingForAnswer -> interrupted += label
+                else -> notRun += label
+            }
+        }
+        return buildList {
+            add("Stopped" + why?.let { " ($it)" }.orEmpty() + ": ${allSteps(plan)}")
+            add(if (ran.isEmpty()) "Nothing had run yet." else "Already ran: ${ran.joinToString(", ")}")
+            if (failed.isNotEmpty()) add("Failed: ${failed.joinToString(", ")}")
+            interrupted.forEach { add("Interrupted: $it ($MAY_HAVE_RUN)") }
+            if (notRun.isNotEmpty()) add("Not run: ${notRun.joinToString(", ")}")
+        }.joinToString("\n")
+    }
+
