+         * "context" and "call" inside "basically", and ordinary conversation was sent to the
+         * planner. A word start still catches every inflection ("calling", "texted",
+         * "screenshots") without matching the middle of an unrelated word.
+         */
+        internal fun isForcedAction(query: String): Boolean =
+            FORCED_ACTION_PATTERNS.any { startsAWord(query, it) }
+
+        private fun startsAWord(query: String, pattern: String): Boolean {
+            var from = 0
