+        assertTrue(errors.isEmpty())
+        assertFalse(shadowOf(given[0]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertTrue(shadowOf(given[1]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        assertFalse(shadowOf(given[2]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+
+        shadowOf(given[2]).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+    }
+
+    @Test
+    fun `where that is allowed a network error to an offline request is reported, and the next request does not ask`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = false), cloudAllowed = { true })
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        shadowOf(given.single()).triggerOnError(SpeechRecognizer.ERROR_NETWORK)
+
+        assertEquals(listOf("Network error"), errors)
+        assertEquals("the recogniser is kept", 1, given.size)
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        assertFalse(shadowOf(given.single()).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+    }
+
+    @Test
+    fun `any other error is reported as before and the recogniser is kept`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = true))
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        shadowOf(given.single()).triggerOnError(SpeechRecognizer.ERROR_NO_MATCH)
+
+        assertEquals(listOf("No speech match found"), errors)
+        assertEquals(1, given.size)
+    }
+
+    @Test
+    fun `a phone that cannot recognise speech still says so`() {
+        val engine = SpeechRecognitionEngine(context, recognizers = { _, _ -> null })
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+
+        assertEquals(listOf("Speech recognition not available on this device"), errors)
+    }
+
+    // ── Wake word ────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the wake word listener uses the phone's own recogniser, which needs no asking`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = true))
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+
+        assertEquals(listOf(true), asked)
+        assertFalse(shadowOf(given.single()).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertTrue(shadowOf(given.single()).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false))
+
+        shadowOf(given.single()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+        detector.destroy()
+    }
+
+    @Test
+    fun `without an on-device recogniser the wake word listener asks the default one to work offline`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = false))
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+
+        assertTrue(shadowOf(given.single()).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+
+        shadowOf(given.single()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+        detector.destroy()
+    }
+
+    @Test
+    fun `the wake word listener goes on with the default recogniser when the on-device one lacks the language`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = true))
+
+        detector.startListening { }
+        idle()
+        shadowOf(given[0]).triggerOnError(12)
+        // It restarts a second after an error.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+
+        assertEquals(listOf(true, false), asked)
+        assertTrue(shadowOf(given[1]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+
+        // Any other error restarts with the same choice.
+        shadowOf(given[1]).triggerOnError(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        assertEquals(listOf(true, false, false), asked)
+        assertTrue(shadowOf(given[2]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        detector.destroy()
+    }
+
+    @Test
+    fun `the wake word listener does not send the room to a speech service when the phone cannot hear offline`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = false))
+        var woken = 0
+        val told = mutableListOf<Boolean>()
+        detector.onHearingChanged = { told += it }
+
+        detector.startListening { woken++ }
+        idle()
+        assertFalse(detector.cannotHearOffline)
+        shadowOf(given[0]).triggerOnError(13)
+        // It is known at once, and whoever words the notification is told.
+        assertTrue(detector.cannotHearOffline)
+        assertEquals(listOf(false), told)
+
+        // Round after round asks for offline work and nothing else.
+        for (round in 1..3) {
+            shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+            assertEquals(round + 1, given.size)
+            assertTrue(
+                "round $round",
+                shadowOf(given[round]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false)
+            )
+            shadowOf(given[round]).triggerOnError(if (round == 2) SpeechRecognizer.ERROR_NETWORK else 13)
+        }
+        assertFalse(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+        assertEquals(0, woken)
+
+        // The language is downloaded: the next round listens, and the reason is gone.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        assertTrue(shadowOf(given.last()).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        shadowOf(given.last()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+        assertTrue(detector.isHearing)
+        assertFalse(detector.cannotHearOffline)
+
+        // Stopped, it has nothing to say about why it does not hear.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        shadowOf(given.last()).triggerOnError(13)
+        assertTrue(detector.cannotHearOffline)
+        detector.stopListening()
+        assertFalse(detector.cannotHearOffline)
+        detector.destroy()
+    }
+
+    @Test
+    fun `where plain hosted models are allowed the wake word listener keeps hearing on a phone whose default recogniser cannot work offline`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = false), cloudAllowed = { true })
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+        assertTrue(shadowOf(given[0]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        shadowOf(given[0]).triggerOnError(13)
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+
+        // The next round asks the same recogniser without the offline request, and hears.
+        assertEquals(2, given.size)
+        assertFalse(shadowOf(given[1]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        shadowOf(given[1]).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+
+        // And every round after it.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        assertFalse(shadowOf(given[2]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertFalse("there was a next step, so nothing is wrong", detector.cannotHearOffline)
+        detector.destroy()
+    }
+
+    // ── Who decides ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `every listener of the app is built with the setting, and none with leave of its own`() {
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        assertTrue(service.contains("val cloudSpeechAllowed = { PreferredRecognizer.cloudAllowed(lastConfig) }"))
+        assertTrue(service.contains("WakeWordDetector(this, cloudAllowed = cloudSpeechAllowed)"))
+        assertTrue(service.contains("SpeechRecognitionEngine(this, cloudAllowed = cloudSpeechAllowed)"))
+        val chat = java.io.File("src/main/java/com/opendroid/ai/ui/screens/ChatScreen.kt").readText()
+        assertTrue(chat.contains("SpeechRecognitionEngine(context, cloudAllowed = { PreferredRecognizer.cloudAllowed(configNow) })"))
+        // Nothing else in the app makes a recogniser, and none is made without the setting.
+        val makers = java.io.File("src/main/java/com/opendroid/ai").walkTopDown()
+            .filter { it.isFile && it.extension == "kt" }
+            .filter { file ->
+                val text = file.readText()
+                text.contains("SpeechRecognitionEngine(") || text.contains("WakeWordDetector(") ||
+                    text.contains("createSpeechRecognizer(") || text.contains("RecognizerIntent.ACTION_")
+            }
+            .map { it.name }.toSet()
+        assertEquals(
+            setOf("OpenDroidService.kt", "ChatScreen.kt", "PreferredRecognizer.kt", "SpeechRecognitionEngine.kt", "WakeWordDetector.kt"),
+            makers
+        )
+        for (file in listOf(service, chat)) {
+            assertFalse(file.contains("SpeechRecognitionEngine(this)"))
+            assertFalse(file.contains("SpeechRecognitionEngine(context)"))
+            assertFalse(file.contains("WakeWordDetector(this)"))
+            assertFalse(file.contains("cloudAllowed = { true }"))
+        }
+    }
+
+    @Test
+    fun `a listen that could not start offline is not left silent by the service`() {
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        assertTrue(service.contains("if (error == PreferredRecognizer.OFFLINE_UNAVAILABLE) textToSpeechEngine.speak(error)"))
+        // Both listens of the service report it: the one for a request and the one for an answer.
+        assertEquals(2, Regex("sayWhyNothingWasHeard\\(error\\)").findAll(service).count())
+    }
+}
