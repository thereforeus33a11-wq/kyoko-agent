+            Text(text = OWN_TIME_KEY_HINT, fontSize = 10.sp, color = TextSecondary)
+            SettingChoiceRow(
+                label = "Longest outing",
+                options = outingMinutesChoices(config.personaOutingMaxMinutes),
+                selected = config.personaOutingMaxMinutes.coerceAtLeast(1),
+                onSelect = viewModel::updatePersonaOutingMaxMinutes
+            )
+            SettingChoiceRow(
+                label = "Most steps of one outing",
+                options = outingStepsChoices(config.personaOutingMaxSteps),
+                selected = config.personaOutingMaxSteps.coerceAtLeast(1),
+                onSelect = viewModel::updatePersonaOutingMaxSteps
+            )
+            SettingSwitchRow(
+                title = OUTINGS_ASK_TITLE,
+                description = OUTINGS_ASK_HINT,
+                checked = config.personaOutingsAsk,
+                onCheckedChange = viewModel::updatePersonaOutingsAsk
+            )
+            SettingSwitchRow(
+                title = READS_TITLE,
+                description = READS_HINT,
+                checked = config.personaReads,
+                onCheckedChange = viewModel::updatePersonaReads
+            )
+            if (config.personaReads) {
