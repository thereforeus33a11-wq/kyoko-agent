+    @Volatile private var restingUntil = 0L
+    @Volatile private var strikes = 0
+
+    /** Why no picture can be described now, as [config] stands, or null when one can. */
+    fun gate(config: LLMConfig, nowMillis: Long = clock(), needs: OwnLedger.Start = OwnLedger.Start.STEP): Why? = when {
+        !config.personaEyes || config.personaEyesConsentAt <= 0L -> Why.OFF
+        config.routePolicy == RoutePolicy.OWN_HARDWARE -> Why.OWN_HARDWARE
+        config.personaEyesStoppedWhy.isNotBlank() -> Why.STOPPED
