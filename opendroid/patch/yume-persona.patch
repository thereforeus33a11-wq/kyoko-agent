+++ b/app/src/main/java/com/opendroid/ai/core/persona/SelfPictureMaker.kt
@@ -0,0 +1,189 @@
+package com.opendroid.ai.core.persona
+
+import java.util.Base64
+
+/**
+ * How one picture of her is made, from the first request to a picture kept or thrown away,
+ * with the requests, the age check, the store and the count handed in, so that every path is
+ * tested without a phone or a network.
+ *
+ * 1. The first request ([Plan.first]): a new picture drawn from words, or an edit of one of
+ *    her pictures.
+ * 2. Where the plan has one, the match ([Plan.match]): the new picture sent back with her own
+ *    pictures so it is her face and look. Where the match fails, the new picture stands as
+ *    it came; where Venice flags it, nothing is kept.
+ * 3. The age check ([MadePictureCheck.AgeCheck]) on the picture that would be kept, always,
+ *    and on the drawn picture before it is sent on to the match. Only one read as an adult
+ *    goes on; any other is zeroed, never shown, never sent on, never kept, and counted by its
+ *    category ([Counts.notKept]), nothing else.
+ * 4. Kept ([keep]) or handed back in memory ([checked], for "Try picture models").
+ *
+ * A picture Venice flags as against its terms (it may be blacked out) is thrown away the
+ * same way, counted as [BLOCKED].
+ */
+class SelfPictureMaker(
+    private val send: suspend (VeniceImages.Call) -> VeniceImages.Made,
+    private val check: MadePictureCheck.AgeCheck,
+    private val counts: Counts
+) {
+
+    /** Where what was made and what was thrown away is counted: categories only. */
+    interface Counts {
+        fun kept()
+        fun notKept(category: String)
+    }
+
+    /** What is to be made: the first request, and the match it is sent on to, where there is one. */
+    class Plan(
+        val first: VeniceImages.Call,
+        /** A note for him that a picture made without a match is kept with: why it was not matched, where it was meant to be. */
+        val note: String = "",
+        /** The match request for the first picture, from that picture's base64; null for none. */
+        val match: ((String) -> VeniceImages.Call)? = null
+    )
+
+    /** A picture that came back and passed the age check, its bytes in memory only. */
+    class Passed(val bytes: ByteArray, val matched: Boolean, val note: String) {
+        override fun toString(): String = "Passed(${bytes.size} bytes)"
+    }
+
+    sealed class Result {
+        class Ok(val picture: Passed) : Result()
+
+        /** Nothing came back that could be kept: a failed request. */
+        class NotMade(val why: String) : Result()
+
+        /** A picture came back and was thrown away unseen: the age check, or Venice's flag. */
+        class ThrownAway(val why: String, val category: String) : Result()
+    }
+
+    /**
+     * [plan] made and age-checked. With [counted] the picture is a call of hers (her own
+     * time), and the age check is too. The bytes of a picture that did not pass are zeroed
+     * here; those of one that passed are the caller's.
+     */
+    suspend fun checked(plan: Plan, counted: Boolean): Result {
+        val first = when (val made = send(plan.first)) {
+            is VeniceImages.Made.Failed -> return Result.NotMade(made.why)
+            VeniceImages.Made.Blocked -> return blocked()
+            is VeniceImages.Made.Picture -> made.bytes
+        }
+        val matchOf = plan.match ?: return notPassed(first, counted) ?: Result.Ok(Passed(first, matched = false, note = plan.note))
+        // The drawn picture is checked before it goes anywhere again: one that is not passed is
+        // never sent on to the match with his pictures of her (and the match is not paid for).
+        notPassed(first, counted)?.let { return it }
+        val call = matchOf(Base64.getEncoder().encodeToString(first))
+        return when (val made = send(call)) {
+            is VeniceImages.Made.Picture -> {
+                first.fill(0)
+                notPassed(made.bytes, counted) ?: Result.Ok(Passed(made.bytes, matched = true, note = ""))
+            }
+            VeniceImages.Made.Blocked -> {
+                first.fill(0)
+                blocked()
+            }
+            // The drawn picture stands as it came, already checked.
+            is VeniceImages.Made.Failed -> Result.Ok(Passed(first, matched = false, note = notMatched(made.why)))
+        }
+    }
+
+    /**
+     * The age check on [picture]: null where it read an adult; else the picture is zeroed and
+     * counted by its category, and what it came to is handed back.
+     */
+    private suspend fun notPassed(picture: ByteArray, counted: Boolean): Result? {
+        val verdict = try {
+            check.check(picture, counted)
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            picture.fill(0)
+            throw e
+        } catch (e: Exception) {
+            MadePictureCheck.Verdict.Unchecked(MadePictureCheck.NO_CHECK, ran = false)
+        }
+        if (verdict == MadePictureCheck.Verdict.Adult) return null
+        picture.fill(0)
+        val category = MadePictureCheck.category(verdict) ?: com.opendroid.ai.core.life.KidGuard.UNCHECKED
+        counts.notKept(category)
+        return Result.ThrownAway(MadePictureCheck.thrownAway(verdict), category)
+    }
+
+    /** What came of making a picture to keep. */
+    sealed class Outcome {
+        /** [seenByHer]: she looked at it, and its caption is what she said of it. */
+        class Kept(val picture: PersonaPicture, val note: String, val seenByHer: Boolean = false) : Outcome()
+        class NotKept(val why: String) : Outcome()
+    }
+
+    /**
+     * [plan] made, age-checked and, where it passed, kept by [keep] with [caption]. The bytes
+     * are zeroed once kept or not.
+     *
+     * Where she can see it ([look], her brain sees), she looks at the kept picture before she
+     * says anything of it (kisaragi-pics: she checks it against how she looks, half right is
+     * wrong), and what she says of it is its caption. Should she read herself in it as younger
+     * than she is, a child or a teen ([MadePictureCheck.readsYoung]), it came out wrong: it is
+     * taken out of her pictures again ([drop]) and counted as thrown away.
+     */
+    suspend fun make(
+        plan: Plan,
+        caption: String,
+        counted: Boolean,
+        keep: suspend (ByteArray, String) -> PersonaPictures.Added,
+        look: (suspend (PersonaPicture) -> String?)? = null,
+        drop: suspend (PersonaPicture) -> Unit = {}
+    ): Outcome =
+        when (val result = checked(plan, counted)) {
+            is Result.NotMade -> Outcome.NotKept(result.why)
+            is Result.ThrownAway -> Outcome.NotKept(result.why)
+            is Result.Ok -> {
+                val bytes = result.picture.bytes
+                val stored = try {
+                    keep(bytes, caption)
+                } finally {
+                    bytes.fill(0)
+                }
+                if (stored !is PersonaPictures.Added.Stored) {
+                    Outcome.NotKept("A picture came back but could not be kept on the phone.")
+                } else {
+                    val seen = look?.let { looking ->
+                        try {
+                            looking(stored.picture)?.trim()?.takeIf { it.isNotEmpty() }
+                        } catch (e: kotlinx.coroutines.CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            null
+                        }
+                    }
+                    if (seen != null && MadePictureCheck.readsYoung(seen)) {
+                        drop(stored.picture)
+                        counts.notKept(com.opendroid.ai.core.life.KidGuard.UNCHECKED)
+                        Outcome.NotKept(SEEN_YOUNG_WHY)
+                    } else {
+                        counts.kept()
+                        val picture = if (seen != null) stored.picture.copy(caption = seen, captionBy = PersonaPicture.CaptionBy.HER) else stored.picture
+                        Outcome.Kept(picture, result.picture.note, seenByHer = seen != null)
+                    }
+                }
+            }
+        }
+
+    private fun blocked(): Result {
+        counts.notKept(BLOCKED)
+        return Result.ThrownAway(BLOCKED_WHY, BLOCKED)
+    }
+
+    companion object {
+        /** How the note on a picture that could not be matched to her own pictures opens. It is for him, not for her line about the picture. */
+        const val NOT_MATCHED_PREFIX = "It was not matched to her own pictures: "
+
+        fun notMatched(why: String): String = NOT_MATCHED_PREFIX + why.trimEnd('.').replaceFirstChar { it.lowercase() } + "."
+
+        /** The category a picture Venice flagged is counted under. */
+        const val BLOCKED = "venice:FLAGGED"
+
+        const val BLOCKED_WHY = "Not kept: Venice flagged the picture as against its rules, so it was thrown away unseen."
+
+        /** What she and he are told when she read herself in a kept picture as younger than she is. */
+        const val SEEN_YOUNG_WHY = "Not kept: the picture came out wrong: she looked younger in it than she is, so it was thrown away."
+    }
+}
