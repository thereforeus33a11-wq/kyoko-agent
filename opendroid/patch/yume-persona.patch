+        return HerFetcher.Fetched.Page("https://kid.example/blog", "https://kid.example/blog", "text/html; charset=utf-8", html.toByteArray(), false)
+    }
+
+    @Test
+    fun `I11 - a kid's site is never followed, and a line of hers about it that reads as sexual is not kept`() {
+        val host = host()
