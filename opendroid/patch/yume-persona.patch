+
+    private fun loopSource() = File(mainSources, "core/agent/AgentLoop.kt").readText()
+
+    /** The body of AgentLoop.runPersonaAction, up to the helper that follows it. */
+    private fun runPersonaActionSource() = loopSource()
+        .substringAfter("private suspend fun runPersonaAction(")
+        .substringBefore("private suspend fun savePersonaCommandRow(")
+
+    @Test
+    fun `her command is held against what was on the phone when she wrote it, not when it is about to run`() {
+        val loop = loopSource()
+        // The snapshot is taken around the read that builds her prompt.
+        val chat = loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+        val before = chat.indexOf("val outsideBefore = if (mayAct) memoryManager.recentOutsideText() else \"\"")
+        val prompt = chat.indexOf("val relevantContext = memoryManager.getRelevantContext(")
+        val after = chat.indexOf("val shownOutsideText = if (mayAct) outsideBefore + \"\\n\" + memoryManager.recentOutsideText() else \"\"")
+        assertTrue(before >= 0)
+        assertTrue(prompt > before)
+        assertTrue(after > prompt)
+        // It is handed on with the app's lines she was shown, and nothing is read again later.
+        val handOver = loop.substringAfter("// A last line starting with \">>\" is a command of her own").substringBefore("} catch (e: CancellationException)")
+        // The same condition guards the snapshot and the action, so a command never runs without one.
+        assertTrue(chat.contains("val mayAct = personaOn && context != null && chatConfig.personaActionsEnabled"))
+        assertTrue(handOver.contains("if (command != null && context != null && mayAct) {"))
+        assertTrue(handOver.contains("outsideText = (shownAppLines + shownOutsideText).joinToString(\"\\n\")"))
+        assertTrue(handOver.contains("screenshotAttached = lastMsgs.any { it.imageBase64 != null }"))
+        assertTrue(handOver.contains("PersonaActions.isHerOwnWordsRow(it.modelBadge)"))
+        assertFalse(runPersonaActionSource().contains("recentOutsideText"))
+    }
+
+    @Test
+    fun `with her switched off, neither her lines nor the rows that quote her commands go to the stock assistant`() {
+        val chat = loopSource().substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+        val stock = chat.substringAfter("// Off is stock:").substringBefore("systemPrompt = ")
+        // The rows that quote her commands are taken out here, her own lines by stockHistory.
+        assertTrue(stock.contains("PersonaPrompts.stockHistory("))
+        assertTrue(stock.contains("PersonaActions.isCommandRow(it.modelBadge)"))
+        val hers = ChatMessage(id = "1", text = "mm", sender = ChatMessage.Sender.AGENT, modelBadge = PersonaPrompts.BADGE)
+        val his = ChatMessage(id = "2", text = "hi", sender = ChatMessage.Sender.USER)
+        assertEquals(listOf(his), PersonaPrompts.stockHistory(listOf(hers, his), false))
+    }
+
+    @Test
+    fun `her command is planned without notification text, and the whole start is decided in one tested place`() {
+        val action = runPersonaActionSource()
+        assertTrue(action.contains("relevantContext = memoryManager.getRelevantContext(command, lean = true)"))
+        assertFalse(action.contains("lean = config.privateMode"))
+
+        val decision = action.substringAfter("PersonaActions.decideStart(").substringBefore("when (decision.start)")
+        assertTrue(decision.contains("hisSettingRuns = AutoApprovalPolicy.shouldAutoApprove("))
+        assertTrue(decision.contains("approval.mode, approval.grantedActions, validated, command"))
+        assertTrue(decision.contains("rein = live.personaRein"))
+        assertTrue(decision.contains("canonicalActions = canonicalActionsOf(validated)"))
+        // The words are the planner's own. A number validation looked up in his contacts is
+        // not held against her: the app's own result lines repeat it after every message.
+        assertTrue(decision.contains("planWords = plan.steps.flatMap { it.params.values }"))
+        assertFalse(decision.contains("validated.steps.flatMap"))
+        assertTrue(decision.contains("screenshotAttached = screenshotAttached"))
+        assertTrue(decision.contains("outsideText = outsideText"))
+        // Nothing else in the loop decides whether a plan of hers runs unasked.
+        assertFalse(action.contains("runsOnRein("))
+        assertFalse(action.contains("echoesOutsideText("))
+    }
+
+    @Test
+    fun `her command is in the chat word for word before any model reads it`() {
+        val action = runPersonaActionSource()
+        val record = action.indexOf("PersonaActions.commandRecord(who, command)")
+        val planned = action.indexOf("provider.complete(")
+        assertTrue(record >= 0)
+        assertTrue(planned > record)
+        // A command that may repeat a stranger keeps the badge that leaves it in the outside text.
+        val badge = action.substring(record, planned)
+        assertTrue(badge.contains("PersonaActions.BORROWED_BADGE"))
+        assertTrue(badge.contains("PersonaActions.COMMAND_BADGE"))
+    }
+
+    @Test
+    fun `a command that must stay on her route is planned by her model, and one that must stay on the phone is not sent`() {
+        val action = runPersonaActionSource()
+        val route = action.indexOf("val route = persona.commandRoute(config, command)")
+        val kept = action.indexOf("if (route == com.opendroid.ai.core.persona.CommandRoute.KEPT) {")
+        val planned = action.indexOf("provider.complete(")
+        assertTrue(route >= 0)
+        assertTrue(kept > route)
+        assertTrue(planned > kept)
+        // The kept command returns before a provider is even looked up.
+        val keptBranch = action.substring(kept, action.indexOf("val onHerRoute = "))
+        assertTrue(keptBranch.contains("PersonaActions.keptRecord(who, command)"))
+        assertTrue(keptBranch.contains("return"))
+        assertFalse(keptBranch.contains("getActiveProvider"))
+        assertTrue(
+            action.contains(
+                "val provider = if (onHerRoute) persona.chatProvider(config) else llmProviderFactory.getActiveProvider()"
+            )
+        )
+        assertTrue(action.contains("if (onHerRoute) persona.withChatModel(planningRequest, config) else planningRequest"))
+    }
+
+    @Test
+    fun `a plan of hers that breaks off after it started is failed and said to have stopped, not to have done nothing`() {
+        val action = runPersonaActionSource()
+        // The plan counts as handed on only once its trace row is written.
+        for (trace in listOf("recordAutoApprovedTrace(validated, approval.mode, sessionId)", "recordPersonaReinTrace(validated, sessionId)")) {
+            val after = action.substringAfter(trace)
+            assertTrue(trace, after.indexOf("handedOn = true") in 0 until after.indexOf("executePlanLoop("))
+        }
+        val failure = action.substringAfter("} catch (e: Exception) {")
+        val started = failure.substringAfter("if (handedOn) {").substringBefore("} else {")
+        assertTrue(started.contains("planManager.updatePlanStatus(PlanStatus.FAILED)"))
+        assertTrue(started.contains("planManager.currentPlan.value?.planId == startedPlanId"))
+        assertTrue(started.contains("persona.phrasebook.ownActionStopped()"))
+        assertFalse(started.contains("ownActionFailed"))
+        val notStarted = failure.substringAfter("} else {").substringBefore("} catch (inner: CancellationException)")
+        assertTrue(notStarted.contains("planManager.cancelPlan(it)"))
+        assertTrue(notStarted.contains("persona.phrasebook.ownActionFailed()"))
+        assertTrue(failure.contains("_agentState.value = AgentState.Error("))
+        // Nothing that goes wrong here is answered with another chat reply.
+        assertFalse(action.contains("executeSimpleQuery("))
+        assertFalse(action.contains("processQuery("))
+    }
+
+    @Test
+    fun `a plan that is only talk is recognised under either name the planner can use`() {
+        // The planner is told to answer talk with CHAT, which keeps its name; every other
+        // talk action becomes DISPLAY_INFO. Both must hand the reply to her.
+        assertTrue(com.opendroid.ai.core.agent.isTalkAction("CHAT"))
+        assertTrue(com.opendroid.ai.core.agent.isTalkAction("DISPLAY_INFO"))
+        for (real in listOf("SEND_SMS", "MAKE_CALL", "OPEN_APP", "SET_ALARM", "READ_NOTIFICATIONS", "ANALYZE_SCREENSHOT")) {
+            assertFalse(real, com.opendroid.ai.core.agent.isTalkAction(real))
+        }
+        val mapper = com.opendroid.ai.actions.ActionAutoMapper()
+        assertEquals("CHAT", mapper.canonicalActionName("CHAT", mapOf("response" to "hi"), setOf("DISPLAY_INFO")))
+        assertEquals("DISPLAY_INFO", mapper.canonicalActionName("RESPOND", mapOf("message" to "hi"), setOf("DISPLAY_INFO")))
+    }
+}
