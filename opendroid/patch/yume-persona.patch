+    @Test
+    fun `her notebook pass is written by her, on her card, and is due from what is stored`() {
+        val engine = File(mainSources, "core/persona/PersonaEngine.kt").readText()
+        val reflect = engine.substringAfter("internal suspend fun reflect(").substringBefore("class Heard(")
+        assertTrue(reflect.contains("reflectionRequest(store.card(), ownerName(), notebook.text, dialogue, notesAboutHimHeldBack = heldBack,"))
+        // On a route a host could read, every note that can be about him is left off the
+        // page, and what she writes is held against that same test and against the notes
+        // that were on the page she was given: a note that was not on it is never
+        // replaced by this pass.
+        assertTrue(reflect.contains("val unseen = notesLeftOut(heldBack, ownerName())"))
+        assertTrue(reflect.contains("leaveOut = unseen,"))
+        assertTrue(reflect.contains("PersonaNotes.besideUnseen(written.notes, memory.notes(), unseen, shownKeys = notebook.shownKeys)"))
+        assertTrue(engine.contains("if (heldBack) PersonaNotes.aboutHim(ownerName) else null"))
+        assertTrue(engine.contains("systemPrompt = PersonaPrompts.reflectionSystemPrompt(card, ownerName),"))
+        assertFalse(engine.contains("systemPrompt = PersonaPrompts.REFLECTION_SYSTEM_PROMPT"))
+        // Her feel lines are taken off before her notes are read: they are not notes, and not lines the notebook could not take.
+        assertTrue(reflect.contains("PersonaNotes.read(PersonaMood.withoutFeelings(response.content, cutOff = cutOff), limit = PersonaNotes.LINES_PER_PASS)"))
+        assertTrue(reflect.contains("val mood = PersonaMood.read(response.content, PersonaMood.PASS_LINES, cutOff)"))
+        assertTrue(reflect.contains("PersonaNotes.withoutBrokenLine(it, mood.rest)"))
+        // A line she meant as a note and that was not taken is kept for her next pass to be told.
+        // Such a line can say as much about him as a note: where notes are left off the page, only
+        // the lines that test lets through are repeated, and the rest wait for a pass that may read them.
+        val repeated = reflect.indexOf("val repeated = PersonaNotes.quotable(notTaken, unseen)")
+        assertTrue(repeated >= 0)
+        assertTrue(repeated < reflect.indexOf("chatProvider(config).complete("))
+        assertTrue(reflect.contains("val waiting = notTaken - repeated.toSet()"))
+        assertTrue(reflect.contains("notTaken = repeated,"))
+        // How she feels and her marks go with it, held back the way the page is.
+        assertTrue(reflect.contains("notTakenHeldBack = waiting.size, feelings = feelings, marks = marks),"))
+        assertTrue(reflect.contains("PersonaMood.pageLines(memory.mood(), now, leaveOut = if (heldBack) PersonaMood.aboutHim(ownerName()) else null)"))
+        assertTrue(reflect.contains("PersonaSleepPass.howBlock(memory.how(), memory.notes().filter { it.storageKey in notebook.shownKeys })"))
+        assertEquals(1, Regex("""memory\.notTaken\(\)""").findAll(reflect).count())
+        assertTrue(reflect.contains("memory.recordNotTaken(written.notTaken + waiting)"))
+
+        val onReply = engine.substringAfter("fun onReply(").substringBefore("internal suspend fun reflect(")
+        // No count that dies with the process and no window of rows: what is unread is read
+        // from the store, and the time is written only after a pass that was made, as the
+        // time of the newest row that pass was given.
+        assertFalse(engine.contains("AtomicInteger"))
+        assertTrue(onReply.contains("val unread = unreadRows(memory.lastReflectionAt())"))
+        // Due by what is stored, or asked for by her sleep over whatever is unread.
+        assertTrue(onReply.contains("if (PersonaNotebookTalk.isDue(unread) || (catchUp && unread.isNotEmpty())) {"))
+        assertTrue(onReply.contains("val page = PersonaNotebookTalk.page(unread)"))
+        assertTrue(onReply.indexOf("if (reflect(page)) {") in 0 until onReply.indexOf("memory.recordReflection(page.readUpTo)"))
+        assertEquals(1, Regex("""recordReflection\(""").findAll(engine).count())
+        // The chat loop hands over no rows of its own choosing any more.
+        assertTrue(loopSource().contains("persona.onReply()"))
+        assertFalse(loopSource().contains("persona.onReply {"))
+    }
