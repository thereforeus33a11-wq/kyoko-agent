+package com.opendroid.ai.core.voice.own
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The phone must give her voice exactly the phonemes it was trained on. These cases were
+ * made by Piper's own phonemize_japanese.py over pyopenjtalk 0.4.1, the same front end
+ * the phone runs (its labels are checked against pyopenjtalk's separately): the text,
+ * how it splits into sentences, each sentence's labels, and the phonemes Piper made.
+ */
+class JapanesePhonemesTest {
+
+    private val cases: List<JsonObject> by lazy {
+        val text = javaClass.classLoader!!.getResourceAsStream("own_voice/ja_phonemes.json")!!
+            .bufferedReader(Charsets.UTF_8).use { it.readText() }
+        Json.parseToJsonElement(text).jsonObject["cases"]!!.jsonArray.map { it.jsonObject }
+    }
+
+    private fun strings(o: JsonObject, key: String) = o[key]!!.jsonArray.map { it.jsonPrimitive.content }
+
+    @Test
+    fun `there are enough cases to mean something`() {
+        assertTrue(cases.size >= 40)
+    }
+
+    @Test
+    fun `sentences split as Piper splits them`() {
+        for (case in cases) {
+            val text = case["text"]!!.jsonPrimitive.content
+            assertEquals(text, strings(case, "sentences"), JapanesePhonemes.splitSentences(text))
+        }
+    }
+
+    @Test
+    fun `labels become the phonemes Piper made, sentence by sentence`() {
+        for (case in cases) {
+            val text = case["text"]!!.jsonPrimitive.content
+            val labels = case["labels"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            val expected = case["phonemes"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            val bySentence = strings(case, "sentences").zip(labels).toMap()
+            val got = JapanesePhonemes.phonemize(text) { bySentence[it] }
+            assertEquals(text, expected, got)
+        }
+    }
+
+    @Test
+    fun `every phoneme is one codepoint`() {
+        for (case in cases) {
+            val labels = case["labels"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            for (l in labels) {
+                for (p in JapanesePhonemes.ipa(JapanesePhonemes.phonesFromLabels(l))) {
+                    assertEquals(p, 1, p.codePointCount(0, p.length))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `a sentence with no labels is dropped, not spoken as nothing`() {
+        assertEquals(emptyList<List<String>>(), JapanesePhonemes.phonemize("。。") { null })
+    }
+
+    @Test
+    fun `a line her voice cannot read is not reported said, so another voice can say it`() {
+        val label = "xx^xx-sil+xx=xx/A:xx+xx+xx/F:xx_xx#xx_xx@xx_xx|xx_xx"
+        val kana = listOf(label, "xx^sil-a+sil=xx/A:0+1+1/F:1_1#0_xx@1_1|1_1", label)
+        // Open JTalk knows nothing in a sentence of another script, or refused one.
+        assertEquals(null, JapanesePhonemes.phonemizeAll("ねえ。привет。") { if ("ねえ" in it) kana else emptyList() })
+        assertEquals(null, JapanesePhonemes.phonemizeAll("ねえ。") { null })
+        // A sentence of marks alone that gives nothing is only dropped.
+        assertEquals(1, JapanesePhonemes.phonemizeAll("ねえ。、。") { if ("ねえ" in it) kana else emptyList() }?.size)
+        assertEquals(emptyList<List<String>>(), JapanesePhonemes.phonemizeAll("。。") { null })
+    }
+
+    @Test
+    fun `a long run of katakana reaches Open JTalk broken into pieces it can hold`() {
+        val run = "ッ".repeat(340) + "ズ"
+        val safe = OpenJTalk.withLongKanaRunsBroken(run)
+        assertEquals(run, safe.replace("、", ""))
+        assertTrue(safe.split("、").all { it.length <= OpenJTalk.MAX_KANA_RUN })
+        // Ordinary text is left as it is.
+        assertEquals("ねえ、スモーク。", OpenJTalk.withLongKanaRunsBroken("ねえ、スモーク。"))
+        val hundred = "ア".repeat(OpenJTalk.MAX_KANA_RUN)
+        assertEquals(hundred, OpenJTalk.withLongKanaRunsBroken(hundred))
+    }
+}
