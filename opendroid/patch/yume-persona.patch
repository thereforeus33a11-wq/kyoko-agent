+        internal fun readLine(replacedUnsavedTyping: Boolean, cutOff: Boolean = false): String =
+            (if (cutOff) "Read into the box below, but not to the end: $CUT_OFF_READING " else "Read into the box below. ") +
+                "Check it and change what is wrong; nothing is saved until you press Save. " +
+                if (replacedUnsavedTyping) {
+                    "What you had typed is not lost: \"Undo the reading\" puts it back."
+                } else {
+                    "\"Undo the reading\" puts back what the box held before."
+                }
+
+        /** What a reading of the page is when the model stopped at its length limit. */
+        private const val CUT_OFF_READING =
+            "the model stopped at its length limit, so the page says more than the box does. Type in what is missing."
+
+        /**
+         * After she looked at a picture: where her words are and what becomes of them.
+         * [hadCaption] says the picture has a caption, which stays until he decides.
+         */
+        internal fun lookedLine(hadCaption: Boolean, cutOff: Boolean = false): String =
+            "She looked. What she said stands under the picture" +
+                (if (cutOff) ", cut short where her model reached its length limit" else "") +
+                ". It is not the caption yet: \"Keep what she said\" makes it the caption" +
+                if (hadCaption) ", and until then the caption you have is unchanged." else "."
+
+        /**
+         * After she looked at a picture that was removed while she did. What she said is
+         * not kept: there is no picture for it to stand under, or to be the caption of.
+         */
+        internal const val REMOVED_WHILE_SHE_LOOKED_LINE =
+            "That picture was removed while she looked at it. What she said about it was not kept."
+
+        /** Ends the line about a look that failed, when the picture was removed while it ran. */
+        private const val REMOVED_MEANWHILE = "The picture was removed meanwhile."
+
+        /** After Save, when the text could not be written. The box still holds it. */
+        internal const val NOT_SAVED_LINE =
+            "The text could not be saved: the phone's storage did not take it. It is still in the box. " +
+                "Free some storage and press Save again."
+
+        /** After "Back to the text from her files", when his saved wording could not be deleted. */
+        internal const val NOT_REMOVED_LINE =
+            "Your wording could not be removed from the phone's storage, so it still applies. Try again."
+
+        /**
+         * What the screen says before it is left with something on it that is stored
+         * nowhere: one sentence for each thing that would be lost, and nothing else.
+         */
+        internal fun leavingLine(unsaved: Unsaved): String = listOfNotNull(
+            "The text under her awareness has changes that are not saved.".takeIf { unsaved.underText },
+            when (unsaved.captions) {
+                0 -> null
+                1 -> "A caption you changed is not saved."
+                else -> "${unsaved.captions} captions you changed are not saved."
+            },
+            when (unsaved.herWords) {
+                0 -> null
+                1 -> "What she said about a picture is not kept yet, and is let go when you leave."
+                else -> "What she said about ${unsaved.herWords} pictures is not kept yet, and is let go when you leave."
+            },
+            "Her model is still being asked about a picture. Its answer is thrown away when you leave."
+                .takeIf { unsaved.working }
+        ).joinToString(" ")
+
+        /** Asked before a picture of her is removed. Removing deletes the stored copy, and the caption with it. */
+        internal const val REMOVE_PICTURE_QUESTION =
+            "The copy in the app's storage is deleted, and its caption goes with it. Your original is not touched."
+
+        /** Asked before the background picture is removed. The text in the box is not made from it and stays. */
+        internal const val REMOVE_BACKGROUND_QUESTION =
+            "The copy in the app's storage is deleted. The text under her awareness stays as it is. " +
+                "Your original is not touched."
+
+        /** After the background picture was added or replaced. Adding it puts nothing into her prompt. */
+        internal const val BACKGROUND_ADDED_LINE =
+            "This is the background picture now. She is never shown it, and nothing of it is in her prompt " +
+                "until the text below says it."
+
+        /**
+         * Under the heading for the background picture. The picture itself is never read
+         * for her prompt: what lies under her awareness is the text in the box, and the
+         * picture only gets into that text when he types it or has it read and saves.
+         */
+        internal const val BACKGROUND_NOTE =
+            "One picture: the page she comes from. It is kept here for you and is never shown to her. What lies " +
+                "under her awareness is the text in the box below, not the picture: the text from her files, until " +
+                "you save a wording of your own. Nothing of the picture is in it until you type it in, or press " +
+                "\"Read the picture into the text\" and then Save. What that text says was done to her she cannot " +
+                "recall or talk about. It only shapes her."
+
+        /**
+         * Why her model is sent no picture with [config], and what he can do about it, or
+         * null when it is sent them. The reason is the one that holds for these settings:
+         * the route, the switch or the provider, in the order [PersonaEngine.imagesReachChatModel]
+         * and [whereAPictureGoes] look at them.
+         */
+        internal fun whyNoPicture(config: LLMConfig): String? = when {
+            PersonaEngine.imagesReachChatModel(config) -> null
+            RouteClassifier.personaRoute(config) == RoutePrivacy.ENCRYPTED ->
+                "her replies are end to end encrypted, and that route carries no pictures. Type the words " +
+                    "yourself, or give her replies a model that reads images on a route that carries them."
+            !config.personaChatSeesImages ->
+                "\"Her model can see screenshots\" in Settings is off, so her model is sent no pictures. Switch " +
+                    "it on if her model reads images, or type the words yourself."
+            else ->
+                "the provider that writes her replies (${PersonaEngine.chatProviderOrMain(config)}) cannot pass " +
+                    "a picture on to its model. Type the words yourself, or give her replies another provider."
+        }
+
+        /** Under a disabled "Let her look" and a disabled "Read the picture into the text": the button, then [why]. */
+        internal fun buttonIsOffLine(button: String, why: String): String =
+            "\"$button\" is off: " + why.ifBlank { NO_PICTURES_AS_SET }
+
+        /** Said when the reason is not known at that moment. It claims nothing about a route or a switch. */
+        private const val NO_PICTURES_AS_SET = "as things are set her model is sent no pictures."
+
+        /**
+         * Where a picture goes when she is shown it, for the configuration as it is. Kept
+         * on the phone is one thing and shown to her model is another, and the screen
+         * says both: a hosted model's provider can see a picture it is sent.
+         */
+        internal fun whereAPictureGoes(config: LLMConfig, refusedByHerModel: Boolean = false): String {
+            val route = RouteClassifier.personaRoute(config)
+            return when {
+                !config.routePolicy.allows(route) ->
+                    "The model set for her replies is on a route your privacy setting refuses (${route.label}), " +
+                        "so nothing is sent to it, and no picture either."
+                route == RoutePrivacy.ENCRYPTED ->
+                    "Her replies are end to end encrypted, and that route carries no pictures. She is not shown any; " +
+                        "she is told in words what is on them, from the captions."
+                !config.personaChatSeesImages ->
+                    "Her model is not set to read images (\"Her model can see screenshots\" in Settings is off). " +
+                        "She is not shown any picture; she is told in words what is on them, from the captions."
+                !PersonaEngine.imagesReachChatModel(config) -> {
+                    val provider = PersonaEngine.chatProviderOrMain(config)
+                    "The provider that writes her replies ($provider) cannot pass a picture on to its model. " +
+                        "She is not shown any; she is told in words what is on them, from the captions."
+                }
+                // Sent once and turned down: she is not shown one again, so nothing here may say she is.
+                refusedByHerModel ->
+                    "The model that writes her replies would not take the last picture of her it was sent, and wrote " +
+                        "that reply without it. Until the app is restarted or her model is changed she is not sent " +
+                        "another; she is told in words what is on them, from the captions. If her model does not read " +
+                        "images, switch off \"Her model can see screenshots\" in Settings. If it does, \"Let her look\" " +
+                        "tries a picture again."
+                route == RoutePrivacy.ON_DEVICE ->
+                    "When she is shown a picture of herself it goes to the model that writes her replies, which runs " +
+                        "on this phone. It does not leave the phone."
+                route == RoutePrivacy.OWN_NETWORK ->
+                    "When she is shown a picture of herself it goes to the model that writes her replies, which runs " +
+                        "on your own network. It leaves the phone and stays on your own machine."
+                route == RoutePrivacy.PRIVATE_TIER ->
+                    "When she is shown a picture of herself it goes to the model that writes her replies, on Venice's " +
+                        "Private tier, which you trust for her: she sees it herself. Venice reads it to answer and keeps nothing."
+                else ->
+                    "When she is shown a picture of herself it is sent to the model that writes her replies. That " +
+                        "model is hosted, and its provider can read what it is sent, the picture included."
+            }
+        }
+
+        /**
+         * Why nothing came of showing a picture, in one plain line that ends on [unchanged].
+         * [noPictureReason] is why her model is sent no picture with the settings as they
+         * are ([whyNoPicture]), for the case that this is what stopped it.
+         */
+        internal fun failureLine(failed: PictureReading.Failed, unchanged: String, noPictureReason: String? = null): String {
+            val why = when (failed.reason) {
+                PictureReading.Reason.SHE_IS_OFF -> "She is switched off in Settings, so there is nobody to look."
+                PictureReading.Reason.NO_PICTURES_ON_THIS_ROUTE -> "Not sent: " + (noPictureReason ?: NO_PICTURES_AS_SET)
+                PictureReading.Reason.CALL_FAILED -> failed.failure?.let { failure ->
+                    val error = ChatErrorUiState(
+                        sessionId = "",
+                        requestId = "",
+                        runId = "",
+                        category = failure.error,
+                        provider = failure.provider,
+                        model = failure.model
+                    )
+                    "${error.title()}. ${error.guidance()}"
+                } ?: "The request to her model failed."
+                PictureReading.Reason.TOOK_TOO_LONG -> "Her model took too long to answer."
+                PictureReading.Reason.DECLINED -> "Her model declined to look at the picture."
+                PictureReading.Reason.EMPTY -> "Her model sent nothing back."
+            }
+            return "$why $unchanged"
+        }
+    }
+}
