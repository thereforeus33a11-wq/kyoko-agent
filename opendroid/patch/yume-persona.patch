+    }
+
+    /** The app around the host: where her one line to him goes. Given by the service when it starts. */
+    interface Room {
+        suspend fun said(line: String, atMillis: Long)
+
+        /**
+         * His settings ask him first ([LLMConfig.personaOutingsAsk]): he is asked to let an
+         * outing of [kind] start, for [maxMinutes] at most. Her words are not shown. For a
+         * look, [camera] says what she would look through ([CameraLook.askWords]).
+         */
+        suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String) = Unit
+
+        /** The question is over: answered, not answered in time, or dropped. */
+        fun askOver() = Unit
+
+        /**
+         * She looked through [camera] ("back camera") at [atMillis], and his settings say he is
+         * told each time: the camera and the time only, never what was seen.
+         */
+        suspend fun looked(camera: String, atMillis: Long) = Unit
+    }
+
+    /** The phone's power, for the rules. */
+    fun interface Phone {
+        fun power(): Power
+    }
+
+    data class Power(val batteryPercent: Int, val charging: Boolean, val thermalStatus: Int)
+
+    /** What an outing came to, for her next moment. Titles are other people's words. */
+    data class Back(
+        val kind: OutingKind.Kind,
+        val words: String,
+        val startedAt: Long,
+        val endedAt: Long,
+        val minutes: Int,
+        val steps: Int,
+        val opened: Int,
+        val searches: Int,
+        val titles: List<String>,
+        val endedBy: HerLog.EndedBy,
+        val said: Boolean,
+        /** Pictures the describer looked at for her. */
+        val looked: Int = 0,
+        /** The camera of a look ("back camera"); empty for an outing that was no look. */
+        val camera: String = "",
+        /** Why a look came to nothing she could be shown, in the app's words; empty when it came to something. */
+        val unseen: String = "",
+        /** Lines of hers about a kid that were not kept in its last step, and so not told yet (PK-2). */
+        val untoldDrops: Int = 0,
+        /** Something marked as a kid's was in front of her on it: the kept-line check runs in the moment after it. */
+        val metKid: Boolean = false
+    )
+
+    /** What became of a `go:` handed here. */
+    sealed class Began {
+        data object Started : Began()
+
+        /** His settings ask him first: it waits for his yes ([letHer], [notNow]). */
+        data object Asked : Began()
+
+        data class NotStarted(val why: HerLog.NotStarted) : Began()
+    }
+
+    /** A `go:` of hers waiting for his yes ([LLMConfig.personaOutingsAsk]). */
+    private class Question(val words: String, val parsed: OutingKind.Parsed, val atMillis: Long) {
+        @Volatile var expiry: Job? = null
+    }
+
+    private class Outing(val words: String, val parsed: OutingKind.Parsed, val startedAt: Long) {
+        @Volatile var job: Job? = null
+
+        @Volatile var endedBy: HerLog.EndedBy? = null
+    }
+
+    @Volatile private var room: Room? = null
+    @Volatile private var current: Outing? = null
+    @Volatile private var asked: Question? = null
+    @Volatile private var lastLookedAt = 0L
+    private var stopsWatched: Job? = null
+    private val lock = Any()
+
+    /** True while an outing of hers runs. */
+    val running: Boolean get() = current?.job?.isActive == true
+
+    /** True while a `go:` of hers waits for his yes. */
+    val asking: Boolean get() = asked != null
+
+    /** Waits until the outing that runs now has ended: for tests, and for nothing in the app. */
+    internal suspend fun awaitEnd() {
+        current?.job?.join()
+    }
+
+    /**
+     * The service is up: her space is awake. A RUNNING entry left in the log by an app
+     * that was stopped mid-outing is closed as broken off, and her own `<< go: stop` is
+     * listened for from here.
+     */
+    fun start(room: Room) {
+        synchronized(lock) {
+            this.room = room
+            if (current?.job?.isActive != true) {
+                val closed = log.closeLeftovers()
+                if (closed > 0) Log.i(TAG, "Outings left running by an app that was stopped: $closed")
+            }
+            if (stopsWatched?.isActive != true) {
+                stopsWatched = scope.launch { life.stopsAsked.collect { stop(HerLog.EndedBy.DONE) } }
+            }
+        }
+    }
+
+    /** The service is going: what runs breaks off, what waits for his yes is dropped, and nothing starts until it is up again. */
+    fun shutDown() {
+        synchronized(lock) { room = null }
+        stop(HerLog.EndedBy.BROKE_OFF)
+        take()?.let { question ->
+            scope.launch { notStarted(question.words, question.parsed.kind, HerLog.NotStarted.SERVICE_DOWN) }
+        }
+    }
+
+    /** Ends the outing that runs, with [by] as how it ended. Nothing when none runs. */
+    fun stop(by: HerLog.EndedBy = HerLog.EndedBy.STOP) {
+        val outing = current ?: return
+        if (outing.endedBy == null) outing.endedBy = by
+        outing.job?.cancel()
+    }
+
+    /**
+     * The glance at her feeds just before a moment of hers: at most [Glance.MAX_HEADLINES]
+     * headlines published since she last looked, with no model call. Empty while her own
+     * life or her reading is off, and when the feeds cannot be read in time.
+     */
+    suspend fun glance(config: LLMConfig, nowMillis: Long = clock()): List<Glance.Headline> {
+        if (!mind.lifeOn(config) || OutingKind.Kind.NEWS !in OwnLife.runnable(config)) return emptyList()
+        val since = lastLookedAt
+        // The glance takes what came in by its deadline; a little more here only in case it overruns.
+        val look = try {
+            withTimeoutOrNull(GLANCE_WAIT_MILLIS + GLANCE_SLACK_MILLIS) { headlines(herFeeds(config), since) }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The glance at her feeds failed: ${e.javaClass.simpleName}")
+            null
+        }
+        // She has looked as far as the feeds that were read: when none came in, the next
+        // glance still shows what came since she last really looked.
+        look?.asOfMillis?.let { lastLookedAt = minOf(it, nowMillis) }
+        return look?.headlines.orEmpty()
+    }
+
+    /**
+     * Her `go:` line ([words], read as [parsed]), handed over from a moment of hers. It is
+     * started here and runs by itself; nothing waits for it. Where his settings ask him
+     * first ([LLMConfig.personaOutingsAsk]) it waits for his yes instead ([Began.Asked]),
+     * one at a time. What does not start is logged, and she is told at her next moment.
+     */
+    suspend fun go(words: String, parsed: OutingKind.Parsed, nowMillis: Long = clock()): Began {
+        val config = mind.config()
+        val why = whyNot(config, parsed, nowMillis)
+        if (why != null) {
+            notStarted(words, parsed.kind, why)
+            return Began.NotStarted(why)
+        }
+        if (config.personaOutingsAsk) return ask(words, parsed, config, nowMillis)
+        return begin(words, parsed, nowMillis)
+    }
+
+    /**
+     * He let her go: the notification's "Let her". The `go:` that waits starts, if it still
+     * may (her own life on, awake, room in the ledger, no other outing, the phone's power);
+     * null when none waits.
+     */
+    suspend fun letHer(nowMillis: Long = clock()): Began? {
+        val question = take() ?: return null
+        room?.askOver()
+        // Past its wait by the clock on the wall it is over: it was not answered in time.
+        if (expired(question, nowMillis)) {
+            notStarted(question.words, question.parsed.kind, HerLog.NotStarted.NOT_ANSWERED)
+            return Began.NotStarted(HerLog.NotStarted.NOT_ANSWERED)
+        }
+        val why = whyNot(mind.config(), question.parsed, nowMillis)
+        if (why != null) {
+            notStarted(question.words, question.parsed.kind, why)
+            return Began.NotStarted(why)
+        }
+        return begin(question.words, question.parsed, nowMillis)
+    }
+
+    /** He said not now: the `go:` that waits does not start, and she is told at her next moment. Null when none waits. */
+    suspend fun notNow(): Began? {
+        val question = take() ?: return null
+        room?.askOver()
+        notStarted(question.words, question.parsed.kind, HerLog.NotStarted.HE_SAID_NO)
+        return Began.NotStarted(HerLog.NotStarted.HE_SAID_NO)
+    }
+
+    /** Why a `go:` read as [parsed] may not start now, or null when it may. */
+    private suspend fun whyNot(config: LLMConfig, parsed: OutingKind.Parsed, nowMillis: Long): HerLog.NotStarted? {
+        val kind = parsed.kind
+        return when {
+            kind == null -> HerLog.NotStarted.NOT_READ
+            !mind.lifeOn(config) || kind !in runnable(config, nowMillis) -> HerLog.NotStarted.NOT_READ
+            room == null -> HerLog.NotStarted.SERVICE_DOWN
+            running -> HerLog.NotStarted.BUSY
+            mind.asleep() -> HerLog.NotStarted.ASLEEP
+            parsed is OutingKind.Parsed.Look -> whyNoLook(config, parsed.at, nowMillis)
+            !ledger.canStart(OwnLedger.Start.OUTING, OwnLife.capOf(config), nowMillis) -> HerLog.NotStarted.BUDGET
+            powerLow() -> HerLog.NotStarted.POWER
+            else -> null
+        }
+    }
+
+    /** What she can go and do now: reading as his settings say, and a look where looks are offered. */
+    private fun runnable(config: LLMConfig, nowMillis: Long): Set<OutingKind.Kind> =
+        OwnLife.runnable(config, looking = looks?.offer(config, nowMillis) != null)
+
+    /**
+     * Why a look at [at] may not start now, or null when it may: the phone, his talk, the
+     * calls and the day's looks ([CameraLook.refusal]), then whether a camera faces that way
+     * as the phone is folded ([CameraLook.plan]).
+     */
+    private suspend fun whyNoLook(config: LLMConfig, at: OutingKind.LookAt, nowMillis: Long): HerLog.NotStarted? {
+        val looks = looks ?: return HerLog.NotStarted.NOT_READ
+        val offer = looks.offer(config, nowMillis) ?: return HerLog.NotStarted.NOT_READ
+        CameraLook.refusal(
+            looks.phone(),
+            talking = life.talkGoingOn(),
+            callsLeft = ledger.left(OwnLife.capOf(config), nowMillis),
+            left = offer.left
+        )?.let { return notStartedOf(it) }
+        return when (val plan = looks.plan(config, at)) {
+            is CameraLook.Plan.Refused -> notStartedOf(plan.why)
+            is CameraLook.Plan.Takes -> null
+        }
+    }
+
+    /** A `go:` that did not start: logged by why, and she is told at her next moment. */
+    private suspend fun notStarted(words: String, kind: OutingKind.Kind?, why: HerLog.NotStarted) {
+        log.notStarted(why, kind?.let(::logKind)?.word.orEmpty())
+        mind.missed(words, why)
+    }
+
+    /**
+     * His settings ask him first: the `go:` waits for his yes for [ASK_WAITS_MILLIS], and
+     * he is asked through [Room.ask]. Unanswered by then, it does not start.
+     */
+    private suspend fun ask(words: String, parsed: OutingKind.Parsed, config: LLMConfig, nowMillis: Long): Began {
+        val kind = parsed.kind ?: return Began.NotStarted(HerLog.NotStarted.NOT_READ)
+        val question = Question(words, parsed, nowMillis)
+        // An earlier question older than its wait by the clock on the wall is over, even when
+        // the wait itself has not run out: that wait stops while the phone sleeps, and the
+        // notification that asked him is gone by then.
+        val expired = synchronized(lock) { asked?.takeIf { expired(it, nowMillis) }?.also { asked = null } }
+        if (expired != null) {
+            expired.expiry?.cancel()
+            room?.askOver()
+            notStarted(expired.words, expired.parsed.kind, HerLog.NotStarted.NOT_ANSWERED)
+        }
+        val earlier = synchronized(lock) { asked.also { if (it == null) asked = question } }
+        if (earlier != null) {
+            notStarted(words, kind, HerLog.NotStarted.WAITING)
+            return Began.NotStarted(HerLog.NotStarted.WAITING)
+        }
+        question.expiry = scope.launch {
+            askWait(ASK_WAITS_MILLIS)
+            val unanswered = synchronized(lock) { if (asked === question) question.also { asked = null } else null }
+            if (unanswered != null) {
+                room?.askOver()
+                notStarted(unanswered.words, kind, HerLog.NotStarted.NOT_ANSWERED)
+            }
+        }
+        // For a look he is told which camera, and that one which faces him does.
+        val camera = (parsed as? OutingKind.Parsed.Look)?.let { look ->
+            (looks?.plan(config, look.at) as? CameraLook.Plan.Takes)?.uses?.let { uses ->
+                CameraLook.askWords(uses.take(looks.offer(config, nowMillis)?.left ?: uses.size))
+            }
+        }.orEmpty()
+        room?.ask(logKind(kind), OwnLife.maxMinutes(config), nowMillis, camera)
+        return Began.Asked
+    }
+
+    /** Whether [question] has waited longer than [ASK_WAITS_MILLIS] by the clock on the wall. */
+    private fun expired(question: Question, nowMillis: Long): Boolean = nowMillis - question.atMillis >= ASK_WAITS_MILLIS
+
+    /** The `go:` that waits for his yes, taken off: it waits no more. */
+    private fun take(): Question? = synchronized(lock) { asked.also { asked = null } }?.also { it.expiry?.cancel() }
+
+    /** Starts the outing for [words] now, unless another started in between. */
+    private suspend fun begin(words: String, parsed: OutingKind.Parsed, nowMillis: Long): Began {
+        val kind = parsed.kind ?: return Began.NotStarted(HerLog.NotStarted.NOT_READ)
+        val outing = Outing(words, parsed, nowMillis)
+        val busy = synchronized(lock) {
+            if (running) {
+                true
+            } else {
+                current = outing
+                outing.job = scope.launch { run(outing) }
+                false
+            }
+        }
+        if (busy) {
+            notStarted(words, kind, HerLog.NotStarted.BUSY)
+            return Began.NotStarted(HerLog.NotStarted.BUSY)
+        }
+        return Began.Started
+    }
+
+    private fun powerLow(): Boolean = phone.power().let { OutingRules.powerLow(it.batteryPercent, it.charging, it.thermalStatus) }
+
+    private suspend fun run(outing: Outing) {
+        val kind = outing.parsed.kind ?: return
+        val parsed = outing.parsed
+        if (parsed is OutingKind.Parsed.Look) return look(outing, parsed.at)
+        val tally = HerLog.Tally()
+        // Her steps and her looks as the ledger recorded them: a call that failed or was
+        // stopped after it was sent counts as the call it was, so the log and the status card agree.
+        val stepsRecordedBefore = ledger.recorded(OwnPurpose.OUTING_STEP)
+        val looksRecordedBefore = ledger.recorded(OwnPurpose.EYES)
+        fun callsSoFar() = tally.calls(
+            ledger.recorded(OwnPurpose.OUTING_STEP) - stepsRecordedBefore + ledger.recorded(OwnPurpose.EYES) - looksRecordedBefore
+        )
+        val id = log.start(logKind(kind), "")
+        herNow.doing(logKind(kind), "", outing.startedAt, OutingPrompt.doing(outing.parsed))
+        var endedBy = HerLog.EndedBy.DONE
+        var steps = 0
+        var sayUsed = false
+        var activeMillis = 0L
+        val titles = ArrayList<String>()
+        var opened = 0
+        var searches = 0
+        var looked = 0
+        var untoldDrops = 0
+        var metKid = false
+        try {
+            var config = mind.config()
+            // Her eyes for this outing: open when it starts, or none on it at all.
+            val looks = eyes?.takeIf { it.open(config, clock()) }?.let { HerEyes.perOuting(config) } ?: 0
+            val space = ReadingSpace(
+                sources, his(), herFeeds(config),
+                limits = ReadingSpace.Limits(looks = looks, webSearch = webSearch(config)),
+                clock = clock,
+                eyes = eyes?.takeIf { looks > 0 }
+            )
+            val history = ArrayList<String>()
+            fun took(did: ReadingSpace.Did) {
+                did.opened?.let { (title, site) ->
+                    tally.opened(title, site)
+                    opened++
+                    if (titles.size < MAX_TITLES && title.isNotBlank()) titles += title
+                }
+                did.searched?.let {
+                    tally.searched(it)
+                    searches++
+                }
+                did.refusal?.let { tally.refused("guard:" + it.name) }
+                did.fetchRefused?.let { tally.refused("fetch:" + it.name) }
+                did.kidSkipped?.let { tally.refused(KidGuard.category(it)) }
+                did.kidSeen?.let { tally.refused(KidGuard.category(it)) }
+                if (did.unchecked) tally.refused(KidGuard.UNCHECKED)
+                did.notSeen?.let { tally.refused(EYES_PREFIX + it.name) }
+                if (did.looked) {
+                    tally.bump(PICTURES_LOOKED)
+                    looked++
+                }
+                if (did.followed) tally.bump(FEEDS_FOLLOWED)
+                herNow.at(space.site)
+            }
+            val first = space.begin(outing.parsed)
+            took(first)
+            log.update(id, tally)
+            history += OutingPrompt.historyLine(0, "for your go: line the app " + firstLook(outing.parsed) + ": " + first.line, null)
+            var seenTalk = life.hisActivityAt.value
+            var tick = clock()
+            while (true) {
+                config = mind.config()
+                val end = endBefore(config, space)
+                if (end != null) {
+                    endedBy = end
+                    break
+                }
+                if (life.talkGoingOn() || life.hisActivityAt.value > seenTalk) {
+                    val after = waitOutHisTalk()
+                    if (after != null) {
+                        endedBy = after
+                        break
+                    }
+                    seenTalk = life.hisActivityAt.value
+                    tick = clock()
+                    continue
+                }
+                val maxSteps = OwnLife.maxSteps(config)
+                val maxMillis = OwnLife.maxMinutes(config) * MINUTE
+                if (steps >= maxSteps) {
+                    endedBy = HerLog.EndedBy.STEPS
+                    break
+                }
+                if (activeMillis >= maxMillis) {
+                    endedBy = HerLog.EndedBy.TIME
+                    break
+                }
+                val facts = OutingPrompt.Facts(
+                    words = outing.words,
+                    step = steps + 1,
+                    maxSteps = maxSteps,
+                    minutesIn = (activeMillis / MINUTE).toInt(),
+                    maxMinutes = OwnLife.maxMinutes(config),
+                    history = history,
+                    sayUsed = sayUsed,
+                    searchesLeft = space.searchesLeft,
+                    pagesLeft = space.pagesLeft,
+                    canFollow = space.canFollow,
+                    kid = space.kidInFront != null,
+                    looksLeft = looksLeft(config, space),
+                    paidSearch = space.webSearch
+                )
+                // Each step renews what keeps the phone awake for her (the service's wake lock).
+                herNow.stepped()
+                val inFront = OutingPrompt.inFront(space.view, showPictures = facts.looksLeft != null)
+                if (space.kidInFront != null) metKid = true
+                // A line not kept in the step before is told in this one (PK-2).
+                untoldDrops = 0
+                val step = mind.step(OutingPrompt.text(facts, inFront), sayUsed, clock(), space.kidInFront != null, look = false)
+                val now = clock()
+                activeMillis += now - tick
+                tick = now
+                callsSoFar()
+                if (step == null) {
+                    endedBy = HerLog.EndedBy.ERROR
+                    break
+                }
+                steps++
+                tally.step(step)
+                repeat(step.kidLinesDropped) { tally.refused(KidGuard.LINE_DROPPED) }
+                // Told in her next step, or in her next moment where this was the last one.
+                untoldDrops = step.kidLinesDropped
+                // She may have lain down, or her own life been switched off, while the step was
+                // out: then nothing of it reaches him and nothing more is done (I9).
+                config = mind.config()
+                if (!mind.lifeOn(config)) {
+                    endedBy = HerLog.EndedBy.SWITCHED_OFF
+                    break
+                }
+                if (mind.asleep()) {
+                    endedBy = HerLog.EndedBy.ASLEEP
+                    break
+                }
+                // Her one line to him of the whole outing; a later one was kept as her thought.
+                sayUsed = said(step, sayUsed, now)
+                val thought = step.thought.takeIf { mind.thoughtsShown(config) }
+                // A line of hers that was not kept is said in her next step (PK-2).
+                val notKept = if (step.kidLinesDropped > 0) " " + KidGuard.NOT_KEPT else ""
+                when (val next = step.next) {
+                    is OutingStep.Next.Finished -> {
+                        endedBy = HerLog.EndedBy.DONE
+                        break
+                    }
+                    is OutingStep.Next.CutOff -> {
+                        // A do: on a line the length limit cut is not run, and nothing else is to be done.
+                        endedBy = HerLog.EndedBy.DONE
+                        break
+                    }
+                    is OutingStep.Next.NotRead ->
+                        history += OutingPrompt.historyLine(steps, "the app could not read your do: line, so nothing was done", thought) + notKept
+                    is OutingStep.Next.Run -> {
+                        val did = space.run(next.verb)
+                        took(did)
+                        history += OutingPrompt.historyLine(steps, did.line, thought) + notKept
+                    }
+                }
+                log.update(id, tally)
+            }
+        } catch (e: CancellationException) {
+            endedBy = outing.endedBy ?: HerLog.EndedBy.BROKE_OFF
+            throw e
+        } catch (e: Exception) {
+            endedBy = HerLog.EndedBy.ERROR
+            Log.w(TAG, "An outing of hers broke off: ${e.javaClass.simpleName}")
+        } finally {
+            withContext(NonCancellable) {
+                val endedAt = clock()
+                callsSoFar()
+                log.end(id, endedBy, tally)
+                herNow.nothing()
+                synchronized(lock) { if (current === outing) current = null }
+                val back = Back(
+                    kind = kind,
+                    words = outing.words,
+                    startedAt = outing.startedAt,
+                    endedAt = endedAt,
+                    minutes = ((activeMillis + MINUTE / 2) / MINUTE).toInt(),
+                    steps = steps,
+                    opened = opened,
+                    searches = searches,
+                    titles = titles.toList(),
+                    endedBy = endedBy,
+                    said = sayUsed,
+                    looked = looked,
+                    untoldDrops = untoldDrops,
+                    metKid = metKid
+                )
+                try {
+                    mind.cameBack(back, endedAt)
+                } catch (e: Exception) {
+                    Log.w(TAG, "Her coming back was not kept: ${e.javaClass.simpleName}")
+                }
+            }
+        }
+    }
+
+    /**
+     * One look of hers through the phone's camera, facing [at]: the cameras the fold allows,
+     * each frame taken in memory and described by her eyes, then her moment of looking, one
+     * step of hers with what the describer wrote ([OutingPrompt.lookText]). His talk, Stop,
+     * his screen going off or a call call it off while it runs; she lying down or her own life
+     * switched off end it before her moment. Logged with the camera, the time and counts.
+     */
+    private suspend fun look(outing: Outing, at: OutingKind.LookAt) {
+        val looks = looks ?: return
+        val tally = HerLog.Tally()
+        val stepsRecordedBefore = ledger.recorded(OwnPurpose.OUTING_STEP)
+        val looksRecordedBefore = ledger.recorded(OwnPurpose.EYES)
+        fun callsSoFar() = tally.calls(
+            ledger.recorded(OwnPurpose.OUTING_STEP) - stepsRecordedBefore + ledger.recorded(OwnPurpose.EYES) - looksRecordedBefore
+        )
+        val id = log.start(HerLog.Kind.LOOK, "")
+        herNow.doing(HerLog.Kind.LOOK, CAMERA, outing.startedAt, OutingPrompt.doing(outing.parsed))
+        var endedBy = HerLog.EndedBy.DONE
+        var steps = 0
+        var sayUsed = false
+        var looked = 0
+        var camera = CAMERA
+        var unseen = ""
+        var untoldDrops = 0
+        var metKid = false
+        val seenTalk = life.hisActivityAt.value
+        // What called the look off, once something did (§1.1): asked at every frame while a camera settles.
+        val off = AtomicReference<HerLog.EndedBy?>(null)
+        fun callOff(): HerLog.EndedBy? {
+            off.get()?.let { return it }
+            val why = outing.endedBy ?: lookStops(looks.phone(), life.talkGoingOn() || life.hisActivityAt.value > seenTalk)
+            if (why != null) off.compareAndSet(null, why)
+            return off.get()
+        }
+        // His switches are watched while it runs: her own life, her eyes or her camera looks
+        // switched off call it off (§1.1), also while a camera settles.
+        val switches = scope.launch {
+            while (off.get() == null) {
+                val now = try {
+                    mind.config()
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    null
+                }
+                if (now != null && !lookSwitchedOn(now)) off.compareAndSet(null, HerLog.EndedBy.SWITCHED_OFF)
+                delay(SWITCH_LOOK_MILLIS)
+            }
+        }
+        try {
+            var config = mind.config()
+            if (!lookSwitchedOn(config)) {
+                endedBy = HerLog.EndedBy.SWITCHED_OFF
+                return
+            }
+            val plan = looks.plan(config, at)
+            if (plan is CameraLook.Plan.Refused) {
+                // The phone was folded another way between her go: and the look.
+                tally.refused(CameraLook.CAMERA_PREFIX + plan.why.name)
+                unseen = plan.why.words
+                return
+            }
+            // No more frames than looks are left today: `around` takes two only where two are left.
+            val left = looks.offer(config, clock())?.left ?: 0
+            val uses = (plan as CameraLook.Plan.Takes).uses.take(left)
+            if (uses.isEmpty()) {
+                tally.refused(CameraLook.CAMERA_PREFIX + CameraLook.Refusal.USED_UP.name)
+                unseen = CameraLook.Refusal.USED_UP.words
+                return
+            }
+            camera = CameraLook.where(uses)
+            tally.at(camera)
+            herNow.at(camera)
+            val tellsHim = config.personaCameraTellMe
+            val result = looks.look(uses, keepGoing = { callOff() == null }) { taken ->
+                tally.bump(CameraLook.CAMERA_LOOKS)
+                // He is told she looked, by the camera and the time only.
+                if (tellsHim) room?.looked(taken, clock())
+            }
+            for (frame in result.frames) {
+                when (val seen = frame.result) {
+                    is CameraLook.Result.Described -> {
+                        looked++
+                        tally.bump(PICTURES_LOOKED)
+                        val kid = seen.kid
+                        when {
+                            kid != null -> tally.refused(KidGuard.category(kid))
+                            seen.ages !is KidGuard.Ages.Read -> tally.refused(KidGuard.UNCHECKED)
+                        }
+                    }
+                    is CameraLook.Result.Dark, CameraLook.Result.Blank -> tally.bump(CameraLook.TOO_DARK)
+                    is CameraLook.Result.NotSeen -> tally.refused(EYES_PREFIX + seen.why.name)
+                    is CameraLook.Result.Failed ->
+                        if (seen.why != Shot.Fail.STOPPED) tally.refused(CameraLook.CAMERA_PREFIX + seen.why.name)
+                }
+            }
+            callsSoFar()
+            log.update(id, tally)
+            if (result.stopped) {
+                endedBy = off.get() ?: outing.endedBy ?: HerLog.EndedBy.BROKE_OFF
+                return
+            }
+            unseen = CameraLook.unseen(result)
+            config = mind.config()
+            if (!lookSwitchedOn(config)) {
+                endedBy = HerLog.EndedBy.SWITCHED_OFF
+                return
+            }
+            if (mind.asleep()) {
+                endedBy = HerLog.EndedBy.ASLEEP
+                return
+            }
+            if (!CameraLook.worthAMoment(result)) return
+            config = mind.config()
+            if (!lookSwitchedOn(config)) off.compareAndSet(null, HerLog.EndedBy.SWITCHED_OFF)
+            callOff()?.let {
+                endedBy = it
+                return
+            }
+            // Her moment of looking: what the describer wrote, a frame with a kid in it as kid only.
+            metKid = CameraLook.metKid(result)
+            val saw = result.frames.map { CameraLook.saw(it, clockWords(it.atMillis), OutingPrompt::fenced) }
+            herNow.stepped()
+            val step = mind.step(OutingPrompt.lookText(outing.words, saw), sayUsed, clock(), metKid, look = true)
+            callsSoFar()
+            if (step == null) {
+                endedBy = HerLog.EndedBy.ERROR
+                return
+            }
+            steps++
+            tally.step(step)
+            repeat(step.kidLinesDropped) { tally.refused(KidGuard.LINE_DROPPED) }
+            untoldDrops = step.kidLinesDropped
+            // She may have lain down, or her own life been switched off, while she wrote: nothing of it reaches him (I9).
+            config = mind.config()
+            if (!mind.lifeOn(config)) {
+                endedBy = HerLog.EndedBy.SWITCHED_OFF
+                return
+            }
+            if (mind.asleep()) {
+                endedBy = HerLog.EndedBy.ASLEEP
+                return
+            }
+            sayUsed = said(step, sayUsed, clock())
+        } catch (e: CancellationException) {
+            endedBy = outing.endedBy ?: off.get() ?: HerLog.EndedBy.BROKE_OFF
+            throw e
+        } catch (e: Exception) {
+            endedBy = HerLog.EndedBy.ERROR
+            Log.w(TAG, "A look of hers broke off: ${e.javaClass.simpleName}")
+        } finally {
+            switches.cancel()
+            withContext(NonCancellable) {
+                val endedAt = clock()
+                callsSoFar()
+                log.end(id, endedBy, tally)
+                herNow.nothing()
+                synchronized(lock) { if (current === outing) current = null }
+                val back = Back(
+                    kind = OutingKind.Kind.LOOK,
+                    words = outing.words,
+                    startedAt = outing.startedAt,
+                    endedAt = endedAt,
+                    minutes = ((endedAt - outing.startedAt + MINUTE / 2) / MINUTE).toInt(),
+                    steps = steps,
+                    opened = 0,
+                    searches = 0,
+                    titles = emptyList(),
+                    endedBy = endedBy,
+                    said = sayUsed,
+                    looked = looked,
+                    camera = camera,
+                    unseen = unseen,
+                    untoldDrops = untoldDrops,
+                    metKid = metKid
+                )
+                try {
+                    mind.cameBack(back, endedAt)
+                } catch (e: Exception) {
+                    Log.w(TAG, "Her coming back from a look was not kept: ${e.javaClass.simpleName}")
+                }
+            }
+        }
+    }
+
+    /** Her own life, her eyes and her camera looks are all switched on: a look may go on. */
+    private fun lookSwitchedOn(config: LLMConfig): Boolean =
+        mind.lifeOn(config) && config.personaCameraLooks && config.personaEyes
+
+    /** Her one line to him of an outing, where she wrote one and has not used it yet. True once it is used. */
+    private suspend fun said(step: OutingStep.Step, sayUsed: Boolean, atMillis: Long): Boolean {
+        if (step.said.isNotEmpty() && !sayUsed) {
+            room?.said(step.said, atMillis)
+            return true
+        }
+        return sayUsed
+    }
+
+    /**
+     * What ends the outing before its next step, by the rules of [OutingRules], or null
+     * when it goes on: switched off, asleep, three guard refusals, power, and fewer than
+     * [OwnLedger.Start.STEP] calls on her own left (a ledger that cannot be read counts as
+     * none left).
+     */
+    private suspend fun endBefore(config: LLMConfig, space: ReadingSpace): HerLog.EndedBy? {
+        val power = phone.power()
+        val events = OutingRules.Snapshot(
+            asleep = mind.asleep(),
+            callsLeft = ledger.left(OwnLife.capOf(config)),
+            batteryPercent = power.batteryPercent,
+            charging = power.charging,
+            thermalStatus = power.thermalStatus,
+            switchedOn = mind.lifeOn(config),
+            guardRefusals = space.guardRefusals
+        ).events()
+        if (OutingRules.decide(OutingRules.Activity.OUTING, events) < OutingRules.Rule.END_AT_NEXT_STEP) return null
+        return when {
+            OutingRules.Event.SWITCH_OFF in events -> HerLog.EndedBy.SWITCHED_OFF
+            OutingRules.Event.ASLEEP in events -> HerLog.EndedBy.ASLEEP
+            OutingRules.Event.GUARD_REFUSALS in events -> HerLog.EndedBy.GUARD
+            OutingRules.Event.POWER_LOW in events -> HerLog.EndedBy.POWER
+            OutingRules.Event.CALLS_LOW in events -> HerLog.EndedBy.BUDGET
+            else -> null
+        }
+    }
+
+    /**
+     * He wrote, gave a command or talked to her: the outing waits. Null once it goes on,
+     * [OutingRules.RESUME_AFTER_QUIET_MILLIS] after the talk went quiet; how it ended when
+     * it ended meanwhile: paused for too long, switched off, or she lay down.
+     */
+    private suspend fun waitOutHisTalk(): HerLog.EndedBy? {
+        herNow.paused(true)
+        val pausedAt = clock()
+        try {
+            while (true) {
+                wait(PAUSE_LOOK_MILLIS)
+                val config = mind.config()
+                if (!mind.lifeOn(config)) return HerLog.EndedBy.SWITCHED_OFF
+                if (mind.asleep()) return HerLog.EndedBy.ASLEEP
+                val now = clock()
+                val lastTalk = if (life.talkGoingOn()) now else life.hisActivityAt.value
+                when (OutingRules.afterPause(pausedAt, lastTalk, now)) {
+                    OutingRules.AfterPause.RESUME -> return null
+                    OutingRules.AfterPause.END -> return HerLog.EndedBy.HIS_MESSAGE
+                    OutingRules.AfterPause.WAIT -> Unit
+                }
+            }
+        } finally {
+            herNow.paused(false)
+        }
+    }
+
+    /**
+     * The looks she may still have in this step: none offered (null) without eyes on this
+     * outing or while they are shut now; else the fewer of the outing's and the day's.
+     */
+    private fun looksLeft(config: LLMConfig, space: ReadingSpace): Int? {
+        val eyes = eyes ?: return null
+        if (!space.hasEyes || !eyes.open(config, clock())) return null
+        return minOf(space.looksLeft, eyes.leftToday(config, clock()) ?: 0)
+    }
+
+    private fun firstLook(parsed: OutingKind.Parsed): String = when (parsed) {
+        is OutingKind.Parsed.Read -> if (parsed.url != null) "opened the link you gave" else "looked up your words"
+        is OutingKind.Parsed.NewsOf -> "went to your feeds"
+        is OutingKind.Parsed.Look -> "looked through the camera"
+        is OutingKind.Parsed.NotRead -> "did nothing"
+    }
+
+    companion object {
+        private const val TAG = "OutingHost"
+        private const val MINUTE = 60_000L
+
+        /** How often a paused outing looks whether the talk has gone quiet. */
+        const val PAUSE_LOOK_MILLIS = 15_000L
+
+        /** How often a running look reads his switches: a camera settles for about a second. */
+        const val SWITCH_LOOK_MILLIS = 150L
+
+        /** How long a `go:` waits for his yes where his settings ask him first. */
+        const val ASK_WAITS_MILLIS = com.opendroid.ai.core.persona.PersonaOwnTime.OUTING_ASK_WAITS_MINUTES * MINUTE
+
+        /** How long the glance before a moment may take: what came in by then is shown. */
+        const val GLANCE_WAIT_MILLIS = 20_000L
+
+        /** Beyond [GLANCE_WAIT_MILLIS], only in case the glance itself overruns. */
+        private const val GLANCE_SLACK_MILLIS = 2_000L
+
+        /** Titles kept for her next moment. */
+        const val MAX_TITLES = 5
+
+        /** The count of feeds she followed on an outing. */
+        const val FEEDS_FOLLOWED = "feeds followed"
+
+        /** The count of pictures the describer looked at for her on an outing. */
+        const val PICTURES_LOOKED = "pictures looked at"
+
+        /** The category of a look her eyes did not make, by why ([HerEyes.Why]). */
+        const val EYES_PREFIX = "eyes:"
+
+        fun logKind(kind: OutingKind.Kind): HerLog.Kind = when (kind) {
+            OutingKind.Kind.READ -> HerLog.Kind.READ
+            OutingKind.Kind.NEWS -> HerLog.Kind.NEWS
+            OutingKind.Kind.LOOK -> HerLog.Kind.LOOK
+        }
+
+        /** Where a look is before its cameras are known. */
+        private const val CAMERA = "camera"
+
+        /**
+         * What calls a running look off now (§1.1, a camera look): his talk ([talk]), his screen
+         * going off or locking, a call; null while it may go on. Stop is the host's own.
+         */
+        fun lookStops(phone: CameraLook.Phone, talk: Boolean): HerLog.EndedBy? {
+            val events = OutingRules.Snapshot(
+                hisTalk = talk,
+                screenOff = !phone.screenOn || !phone.unlocked,
+                phoneCall = phone.inCall,
+                callsLeft = Int.MAX_VALUE
+            ).events()
+            if (OutingRules.mayStart(OutingRules.Activity.CAMERA_LOOK, events)) return null
+            return when {
+                OutingRules.Event.HIS_TALK in events -> HerLog.EndedBy.HIS_MESSAGE
+                OutingRules.Event.PHONE_CALL in events -> HerLog.EndedBy.CALL
+                OutingRules.Event.SCREEN_OFF in events -> HerLog.EndedBy.SCREEN_OFF
+                else -> null
+            }
+        }
+
+        /** Why a look did not start, for the log and for her next moment. */
+        fun notStartedOf(refusal: CameraLook.Refusal): HerLog.NotStarted = when (refusal) {
+            CameraLook.Refusal.SCREEN_OFF -> HerLog.NotStarted.SCREEN_OFF
+            CameraLook.Refusal.CALL -> HerLog.NotStarted.CALL
+            CameraLook.Refusal.TALKING -> HerLog.NotStarted.TALKING
+            CameraLook.Refusal.POWER -> HerLog.NotStarted.POWER
+            CameraLook.Refusal.CALLS_LOW -> HerLog.NotStarted.BUDGET
+            CameraLook.Refusal.USED_UP -> HerLog.NotStarted.LOOKS_USED_UP
+            CameraLook.Refusal.IN_USE -> HerLog.NotStarted.CAMERA_BUSY
+        }
+
+        /** Why a look did not start where no camera faced the way she asked. */
+        fun notStartedOf(refusal: FoldState.Refusal): HerLog.NotStarted = when (refusal) {
+            FoldState.Refusal.FRONT_OFF -> HerLog.NotStarted.FRONT_OFF
+            FoldState.Refusal.FOLDED_NO_BACK -> HerLog.NotStarted.FOLDED
+            FoldState.Refusal.UNKNOWN -> HerLog.NotStarted.FOLD_UNKNOWN
+        }
+    }
+}
+
+/** The host's view of her engine: her settings, her state, one step, and what she brings back. */
+private class EngineMind(
+    private val engine: com.opendroid.ai.core.persona.PersonaEngine,
+    private val settings: SettingsRepository
+) : OutingHost.Mind {
+    override suspend fun config(): LLMConfig = settings.llmConfig.first()
+    override fun lifeOn(config: LLMConfig): Boolean = engine.ownLifeIsOn(config)
+    override fun thoughtsShown(config: LLMConfig): Boolean = engine.thoughtsShown(config)
+    override suspend fun asleep(): Boolean = engine.isAsleepNow()
+    override suspend fun step(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, look: Boolean): OutingStep.Step? =
+        engine.outingStep(outing, sayUsed, nowMillis, kid, look)
+
+    override suspend fun cameBack(back: OutingHost.Back, nowMillis: Long) {
+        engine.outingCameBack(
+            com.opendroid.ai.core.persona.PersonaOwnTime.LastOuting(
+                kind = back.kind.name.lowercase(),
+                words = back.words,
+                startedAt = back.startedAt,
+                endedAt = back.endedAt,
+                minutes = back.minutes,
+                steps = back.steps,
+                opened = back.opened,
+                searches = back.searches,
+                titles = back.titles,
+                ended = back.endedBy.name,
+                said = back.said,
+                looked = back.looked,
+                camera = back.camera,
+                unseen = back.unseen,
+                untoldDrops = back.untoldDrops,
+                metKid = back.metKid
+            ),
+            nowMillis
+        )
+    }
+
+    override suspend fun missed(words: String, why: HerLog.NotStarted) {
+        engine.goMissed(com.opendroid.ai.core.persona.PersonaOwnTime.GoMissed(words, why.name))
+    }
+}
+
+/** The phone's battery and heat, read when asked. */
+private class AndroidPhone(private val context: Context) : OutingHost.Phone {
+    override fun power(): OutingHost.Power {
+        val battery = try {
+            context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        } catch (e: Exception) {
+            null
+        }
+        val level = battery?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: -1
+        val scale = battery?.getIntExtra(BatteryManager.EXTRA_SCALE, -1) ?: -1
+        val percent = if (level >= 0 && scale > 0) level * 100 / scale else 100
+        val status = battery?.getIntExtra(BatteryManager.EXTRA_STATUS, -1) ?: -1
+        val charging = status == BatteryManager.BATTERY_STATUS_CHARGING || status == BatteryManager.BATTERY_STATUS_FULL
+        val thermal = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            (context.getSystemService(Context.POWER_SERVICE) as? PowerManager)?.currentThermalStatus ?: 0
+        } else {
+            0
+        }
+        return OutingHost.Power(percent, charging, thermal)
+    }
+}
