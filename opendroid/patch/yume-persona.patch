@@ -0,0 +1,62 @@
+package com.opendroid.ai.core.record
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her outing on his screen, lent, on the phone's record: hers, in his app, with what the phone
+ * did there (every kind of move with its count, her search words as typed, the taps the
+ * look-only guard refused, how the screen was given back) and nothing that was on the screen.
+ */
+class OutingEntriesTest {
+
+    private val now = 1_800_000_000_000L
+
+    @Test
+    fun `the record keeps her outing in his app as hers, with what the phone did and nothing that was on the screen`() {
+        val entry = OutingEntries.phoneTime(
+            OutingEntries.PhoneTime(
+                app = "TikTok", words = "scroll tiktok", startedAt = now - 600_000, endedAt = now, hisYes = false, opened = true,
+                scrolls = 14, taps = 2, tabs = 1, backs = 3, watchedMillis = 95_000, searches = listOf("stray cats kabukicho"),
+                searchesHeldBack = 1, refused = mapOf("a like or a dislike" to 2), ended = "he took the phone back", gaveBack = "home", early = true
+            )
+        )
+        assertEquals(Outcome.STOPPED, entry.outcome)
+        val lines = entry.steps.map { it.line }
+        assertEquals(
+            listOf(
+                "opened TikTok on his screen", "scrolled 14 times", "tapped into 2 posts, videos, profiles or comments", "switched tabs once",
+                "went back 3 times", "searched TikTok", "searches not typed: 1", "watched for 1 min 35 s", "not tapped: 2 a like or a dislike",
+                "gave the screen back: home"
+            ),
+            lines
+        )
+        assertEquals("stray cats kabukicho", entry.steps.single { it.line == "searched TikTok" }.words.single().text)
+        assertEquals(StepEnd.NOT_RUN, entry.steps.single { it.kind == "Look only" }.end)
+        assertTrue(entry.steps.all { it.app == "TikTok" })
+        // As her prompt reads it: hers, on his screen, let through by his setting.
+        val said = RecordLines.line(entry, heldBack = false, age = "5 min ago")
+        assertTrue(said, said.startsWith("5 min ago: you, on an outing of your own on his screen: \"go: scroll tiktok; it ended: he took the phone back\"; his approval setting let it run."))
+        assertTrue(said.contains("searched TikTok: \"stray cats kabukicho\" - done"))
+        // Where his details are held back, the kinds and the time only: not her words.
+        val held = RecordLines.line(entry, heldBack = true, age = "5 min ago")
+        assertFalse(held.contains("stray cats"))
+    }
+
+    @Test
+    fun `an app launched that never came to the front is a failed outing whose screen was still given back`() {
+        val entry = OutingEntries.phoneTime(
+            OutingEntries.PhoneTime(
+                app = "TikTok", words = "scroll tiktok", startedAt = now - 10_000, endedAt = now, hisYes = false, opened = true, arrived = false,
+                ended = "he took the phone back", gaveBack = "home", early = true
+            )
+        )
+        assertEquals(Outcome.FAILED, entry.outcome)
+        assertEquals(
+            listOf("opened TikTok on his screen" to StepEnd.DONE, "TikTok did not come to the front" to StepEnd.FAILED, "gave the screen back: home" to StepEnd.DONE),
+            entry.steps.map { it.line to it.end }
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/record/PhoneLogTest.kt b/app/src/test/java/com/opendroid/ai/core/record/PhoneLogTest.kt
