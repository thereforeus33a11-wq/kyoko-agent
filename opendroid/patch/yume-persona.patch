index 0000000..e44922e
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/OutingRules.kt
@@ -0,0 +1,236 @@
+package com.opendroid.ai.core.life
+
+/**
+ * What ends or pauses what she does on her own (OWN_LIFE_PLAN §1.1). Pure: the host asks
+ * with the events that hold now and gets one rule back; the times are passed in.
+ *
+ * | Event                         | Outing          | Camera look | Ears             | Lent screen | Own screen           |
+ * |-------------------------------|-----------------|-------------|------------------|-------------|----------------------|
+ * | he writes, commands or talks  | pause           | cancel      | keep listening   | end         | pause                |
+ * | Stop                          | end             | cancel      | —                | end         | end                  |
+ * | he touches the phone          | —               | —           | —                | end at once | continue             |
+ * | screen off or locked          | continue        | refuse/abort| continue         | end         | pause, end after 2 m |
+ * | phone call                    | continue        | abort       | pause            | end         | end                  |
+ * | she lies down to sleep        | end, none start | none        | close and clear  | end         | end                  |
+ * | ledger under 10 left          | end at next step| refuse      | —                | end         | end                  |
+ * | battery or heat               | end             | refuse      | pause under 20 % | end         | end                  |
+ * | switch turned off             | end             | cancel      | close and clear  | end         | end, display gone    |
+ * | login/payment/install screen  | —               | —           | —                | end, needs him | end, needs him    |
+ * | three guard refusals          | end             | —           | —                | end         | end                  |
+ */
+object OutingRules {
+
+    enum class Activity { OUTING, CAMERA_LOOK, EARS, LENT_SCREEN, OWN_SCREEN }
+
+    enum class Event {
+        /** He writes, gives a command or talks to her. */
+        HIS_TALK,
+
+        /** Stop: the notification, the tile or the in-app button. */
+        STOP,
+
+        /** He touches the phone. */
+        HE_TOUCHES,
+
+        /** The screen is off or locked. */
+        SCREEN_OFF,
+
+        /** A phone call is ringing or going on. */
+        PHONE_CALL,
+
+        /** She lay down to sleep. */
+        ASLEEP,
+
+        /** Fewer than [CALLS_LOW] calls on her own are left, or the ledger cannot be read. */
+        CALLS_LOW,
+
+        /** The battery is low and not charging, or the phone is too hot ([powerLow]). */
+        POWER_LOW,
+
+        /** Her own life was switched off. */
+        SWITCH_OFF,
+
+        /** A login, challenge, payment, permission or install screen is in front of her. */
+        GATE_SCREEN,
+
+        /** Three guard refusals in one outing. */
+        GUARD_REFUSALS
+    }
+
+    /** What happens. Ordered from the mildest to the strongest. */
+    enum class Rule {
+        /** The event does not touch this activity. */
+        NONE,
+
+        /** It goes on. */
+        CONTINUE,
+
+        /** The ears keep listening: what he says is talk. */
+        KEEP_LISTENING,
+
+        /** It waits ([afterPause] says when it goes on or ends). */
+        PAUSE,
+
+        /** It ends before its next step. */
+        END_AT_NEXT_STEP,
+
+        /** It is not started. */
+        REFUSE,
+
+        /** It ends. */
+        END,
+
+        /** It is called off before it is done. */
+        CANCEL,
+
+        /** It is stopped where it is. */
+        ABORT,
+
+        /** The ears close and what they hold is cleared. */
+        CLOSE_AND_CLEAR,
+
+        /** It ends at once, with any gesture in flight cancelled. */
+        END_AT_ONCE,
+
+        /** It ends and the account is marked as needing him. */
+        END_NEEDS_HIM,
+
+        /** It ends and her display is destroyed. */
+        END_DESTROY_DISPLAY
+    }
+
+    /** The ledger's floor below which a running outing ends at its next step. */
+    const val CALLS_LOW = 10
+
+    /** Battery below this, not charging, ends what runs. */
+    const val BATTERY_LOW_PERCENT = 15
+
+    /** The ears pause below this. */
+    const val EARS_BATTERY_PERCENT = 20
+
+    /** [android.os.PowerManager.THERMAL_STATUS_SEVERE]. */
+    const val THERMAL_SEVERE = 3
+
+    /** A paused outing goes on this long after the talk went quiet. */
+    const val RESUME_AFTER_QUIET_MILLIS = 3 * 60_000L
+
+    /** A paused outing ends after this long paused. */
+    const val END_AFTER_PAUSED_MILLIS = 30 * 60_000L
+
+    /** Her own screen, paused by the screen going off, ends after this long. */
+    const val OWN_SCREEN_OFF_END_MILLIS = 2 * 60_000L
+
+    /** Guard refusals in one outing that end it. */
+    const val GUARD_REFUSALS_END = 3
+
+    private val TABLE: Map<Event, Map<Activity, Rule>> = mapOf(
+        Event.HIS_TALK to row(Rule.PAUSE, Rule.CANCEL, Rule.KEEP_LISTENING, Rule.END, Rule.PAUSE),
+        Event.STOP to row(Rule.END, Rule.CANCEL, Rule.NONE, Rule.END, Rule.END),
+        Event.HE_TOUCHES to row(Rule.NONE, Rule.NONE, Rule.NONE, Rule.END_AT_ONCE, Rule.CONTINUE),
+        Event.SCREEN_OFF to row(Rule.CONTINUE, Rule.ABORT, Rule.CONTINUE, Rule.END, Rule.PAUSE),
+        Event.PHONE_CALL to row(Rule.CONTINUE, Rule.ABORT, Rule.PAUSE, Rule.END, Rule.END),
+        Event.ASLEEP to row(Rule.END, Rule.REFUSE, Rule.CLOSE_AND_CLEAR, Rule.END, Rule.END),
+        Event.CALLS_LOW to row(Rule.END_AT_NEXT_STEP, Rule.REFUSE, Rule.NONE, Rule.END, Rule.END),
+        Event.POWER_LOW to row(Rule.END, Rule.REFUSE, Rule.PAUSE, Rule.END, Rule.END),
+        Event.SWITCH_OFF to row(Rule.END, Rule.CANCEL, Rule.CLOSE_AND_CLEAR, Rule.END, Rule.END_DESTROY_DISPLAY),
+        Event.GATE_SCREEN to row(Rule.NONE, Rule.NONE, Rule.NONE, Rule.END_NEEDS_HIM, Rule.END_NEEDS_HIM),
+        Event.GUARD_REFUSALS to row(Rule.END, Rule.NONE, Rule.NONE, Rule.END, Rule.END)
+    )
+
+    private fun row(outing: Rule, camera: Rule, ears: Rule, lent: Rule, own: Rule): Map<Activity, Rule> = mapOf(
+        Activity.OUTING to outing,
+        Activity.CAMERA_LOOK to camera,
+        Activity.EARS to ears,
+        Activity.LENT_SCREEN to lent,
+        Activity.OWN_SCREEN to own
+    )
+
+    /** What [event] does to [activity] while it runs. */
+    fun rule(event: Event, activity: Activity): Rule = TABLE.getValue(event).getValue(activity)
+
+    /**
+     * What all of [events] together do to [activity]: the strongest of their rules.
+     * [Rule.NONE] when none touches it.
+     */
+    fun decide(activity: Activity, events: Set<Event>): Rule =
+        events.map { rule(it, activity) }.maxByOrNull { it.ordinal } ?: Rule.NONE
+
+    /**
+     * Whether [activity] may start while [events] hold. An outing starts in none of the
+     * states that would end or pause it, and the camera in none that would refuse,
+     * cancel or abort it. The ears follow their own gates.
+     */
+    fun mayStart(activity: Activity, events: Set<Event>): Boolean =
+        decide(activity, events) in setOf(Rule.NONE, Rule.CONTINUE, Rule.KEEP_LISTENING)
+
+    /** The phone's power state as an event: battery under 15 % and not charging, or thermal SEVERE or worse. */
+    fun powerLow(batteryPercent: Int, charging: Boolean, thermalStatus: Int): Boolean =
+        (batteryPercent in 0 until BATTERY_LOW_PERCENT && !charging) || thermalStatus >= THERMAL_SEVERE
+
+    /** Whether the ears pause for the battery: under 20 %. */
+    fun earsPowerLow(batteryPercent: Int): Boolean = batteryPercent in 0 until EARS_BATTERY_PERCENT
+
+    /** Whether [left] calls are too few for a running outing: under 10, or a ledger that cannot be read. */
+    fun callsLow(left: Int?): Boolean = left == null || left < CALLS_LOW
+
+    /** Whether the guard refusals of one outing end it. */
+    fun guardEnds(refusals: Int): Boolean = refusals >= GUARD_REFUSALS_END
+
+    /**
+     * The events that hold now, from the phone's state. A host fills what it knows; what
+     * a phase does not have yet stays false. [callsLeft] null means the ledger could not
+     * be read, which counts as low: it fails closed.
+     */
+    data class Snapshot(
+        val hisTalk: Boolean = false,
+        val stop: Boolean = false,
+        val heTouches: Boolean = false,
+        val screenOff: Boolean = false,
+        val phoneCall: Boolean = false,
+        val asleep: Boolean = false,
+        val callsLeft: Int? = null,
+        val batteryPercent: Int = 100,
+        val charging: Boolean = true,
+        val thermalStatus: Int = 0,
+        val switchedOn: Boolean = true,
+        val gateScreen: Boolean = false,
+        val guardRefusals: Int = 0
+    ) {
+        fun events(): Set<Event> = buildSet {
+            if (hisTalk) add(Event.HIS_TALK)
+            if (stop) add(Event.STOP)
+            if (heTouches) add(Event.HE_TOUCHES)
+            if (screenOff) add(Event.SCREEN_OFF)
+            if (phoneCall) add(Event.PHONE_CALL)
+            if (asleep) add(Event.ASLEEP)
+            if (callsLow(callsLeft)) add(Event.CALLS_LOW)
+            if (powerLow(batteryPercent, charging, thermalStatus)) add(Event.POWER_LOW)
+            if (!switchedOn) add(Event.SWITCH_OFF)
+            if (gateScreen) add(Event.GATE_SCREEN)
+            if (guardEnds(guardRefusals)) add(Event.GUARD_REFUSALS)
+        }
+
+        /** What holds for the ears, whose battery bound is their own. */
+        fun earsEvents(): Set<Event> = events().let { all ->
+            if (earsPowerLow(batteryPercent)) all + Event.POWER_LOW else all - Event.POWER_LOW
+        }
+    }
+
+    /** What becomes of a paused outing. */
+    enum class AfterPause { WAIT, RESUME, END }
+
+    /**
+     * A paused outing at [nowMillis], paused since [pausedAtMillis], his talk last heard at
+     * [lastTalkMillis]: it ends after 30 minutes paused, goes on 3 minutes after the talk
+     * went quiet, and waits otherwise.
+     */
+    fun afterPause(pausedAtMillis: Long, lastTalkMillis: Long, nowMillis: Long): AfterPause = when {
+        nowMillis - pausedAtMillis >= END_AFTER_PAUSED_MILLIS -> AfterPause.END
+        nowMillis - maxOf(lastTalkMillis, pausedAtMillis) >= RESUME_AFTER_QUIET_MILLIS -> AfterPause.RESUME
+        else -> AfterPause.WAIT
+    }
+
+    /** Her own screen, paused because his went off at [offSinceMillis]: true once it should end. */
+    fun ownScreenOffEnds(offSinceMillis: Long, nowMillis: Long): Boolean =
+        nowMillis - offSinceMillis >= OWN_SCREEN_OFF_END_MILLIS
+}
