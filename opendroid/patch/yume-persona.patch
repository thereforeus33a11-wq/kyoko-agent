+                        "That is how her notebook is moved to another phone: copy here, paste there, add, and do it " +
+                        "there before you first talk to her. The first line says the notebook has had its starting " +
+                        "notes, so they are not written into it again. " +
+                        "Whatever you paste into, and a keyboard that reads the clipboard, gets to read them.",
+                    fontSize = 11.sp,
+                    color = TextSecondary
+                )
+            }
+        }
+    }
+
+    if (askAboutUnsaved) {
+        AlertDialog(
+            onDismissRequest = { askAboutUnsaved = false },
+            title = { Text("Your changes are not saved") },
+            text = { Text("Save them before you leave, or leave without them?") },
+            confirmButton = {
+                TextButton(onClick = {
+                    askAboutUnsaved = false
+                    // Leaves only once the text is stored; a failed save keeps the screen and says why.
+                    viewModel.save(then = onNavigateBack)
+                }) { Text("Save") }
+            },
+            dismissButton = {
+                Row {
+                    TextButton(onClick = {
+                        askAboutUnsaved = false
+                        onNavigateBack()
+                    }) { Text("Discard") }
+                    TextButton(onClick = { askAboutUnsaved = false }) { Text("Keep editing") }
+                }
+            }
+        )
+    }
+
+    if (confirmEmpty) {
+        AlertDialog(
+            onDismissRequest = { confirmEmpty = false },
+            title = { Text("Empty her notebook?") },
+            text = {
+                Text(
+                    "Every note she has written or was given is deleted from this phone and cannot be brought back. " +
+                        "She will not know any of it in her next reply. Copy the notebook first if you want to keep it."
+                )
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmEmpty = false
+                    viewModel.emptyNotebook()
+                }) { Text("Empty it", color = AccentRed) }
+            },
+            dismissButton = { TextButton(onClick = { confirmEmpty = false }) { Text("Cancel") } }
+        )
+    }
+}
