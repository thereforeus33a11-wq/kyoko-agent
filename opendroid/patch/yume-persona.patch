+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her prompt says whether a screenshot is attached. That line has to be true: the
+ * encrypted exchange carries no images, so there she is told she cannot see the screen.
+ */
+class PersonaEngineRouteTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    private val seesImages = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-vision-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatSeesImages = true
+    )
+
+    @Test
+    fun `a screenshot reaches a chat model that reads images on a route that carries them`() {
+        assertTrue(PersonaEngine.imagesReachChatModel(seesImages))
+        assertTrue(
+            PersonaEngine.imagesReachChatModel(
+                seesImages.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+            )
+        )
+        assertTrue(
+            PersonaEngine.imagesReachChatModel(seesImages.copy(customEndpoints = mapOf(custom to "http://127.0.0.1:8080/v1")))
+        )
+    }
+
+    @Test
+    fun `on the encrypted route no screenshot is attached, however the switch is set`() {
+        val encryptedReplies = seesImages.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertFalse(PersonaEngine.imagesReachChatModel(encryptedReplies))
+
+        val encryptedEverything = seesImages.copy(selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p"))
+        assertFalse(PersonaEngine.imagesReachChatModel(encryptedEverything))
+    }
+
+    @Test
+    fun `a model that was never said to read images gets none on any route`() {
+        assertFalse(PersonaEngine.imagesReachChatModel(seesImages.copy(personaChatSeesImages = false)))
+        assertFalse(PersonaEngine.imagesReachChatModel(LLMConfig(activeProvider = "On-Device AI")))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt
new file mode 100644
index 0000000..3bde11b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryShelfCheckTest.kt
@@ -0,0 +1,107 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaLibraryText.Cue
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Checks the real library, as the build puts it into `assets/persona`, when it is
+ * there. A checkout without her files skips these: the library is not part of the
+ * source tree.
+ */
+class PersonaLibraryShelfCheckTest {
+
+    private val assets = File("src/main/assets/persona")
+
+    private fun shelf(): PersonaLibraryText.Shelf {
+        val files = File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty().sortedBy { it.name }
+        assumeTrue("her library is not in this checkout", files.isNotEmpty())
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").takeIf { it.isFile }?.readText().orEmpty())
+        return PersonaLibraryText.Shelf(files.flatMap { PersonaLibraryText.pages(it.name.removeSuffix(".md"), it.readText(), index) })
+    }
+
+    @Test
+    fun `what lies under her is kept apart from her pages and is all there`() {
+        shelf()
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").readText())
+        val under = File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty()
+            .joinToString("\n\n") { PersonaLibraryText.underText(it.name.removeSuffix(".md"), it.readText(), index) }
+        assertTrue("the build has no under-text", under.length > 2000)
+        assertTrue(under.contains("Badplug"))
+        assertTrue(under.contains("buried deep in her mind"))
+        for (gone in listOf("LOCKED CANON", "/home/", "kisaragi-")) {
+            assertFalse("$gone in the under-text", under.contains(gone))
+        }
+    }
+
+    private fun PersonaLibraryText.Shelf.labelsFor(message: String, budget: Int = 6000): List<String> =
+        select(listOf(Cue(message, 1.0)), budget).map { it.label }
+
+    @Test
+    fun `nothing on the shelf tells her what was done to her or talks to a writer`() {
+        val shelf = shelf()
+        assertTrue(shelf.pages.size > 80)
+        for (page in shelf.pages) {
+            val text = page.body + " " + page.label
+            for (word in listOf("badplug", "bad plug", "parasite", " worm", "plugged", "LOCKED CANON", "/home/", "writing as Yume")) {
+                assertFalse("${page.label} has \"$word\"", text.contains(word, ignoreCase = true))
+            }
+            assertFalse("${page.label} names a file", Regex("""kisaragi-[a-z]+""").containsMatchIn(text.replace("kisaragi-agent", "")))
+        }
+    }
+
+    @Test
+    fun `the name he is called by in the files is a placeholder`() {
+        val shelf = shelf()
+        assertTrue(shelf.pages.any { it.body.contains(PersonaPrompts.OWNER_PLACEHOLDER) })
+        val rendered = PersonaLibraryText.render(shelf.pages, "Sam")
+        assertFalse(rendered.contains("{{owner"))
+    }
+
+    @Test
+    fun `what he says finds the page about it`() {
+        val shelf = shelf()
+        val expected = mapOf(
+            "who is nene" to "life: Her people",
+            "tell me about your mom" to "life: Where she comes from",
+            "what music do you like" to "taste: Music",
+            "do you want a real body" to "mind: What she is really after",
+            "say something dirty" to "life: What she wants that is not money",
+            "what does maji mean" to "voice: Where her voice comes from",
+            "how is the rig going" to "now: Her real week",
+            "whats your favorite konbini" to "taste: Konbini, ranked"
+        )
+        for ((message, label) in expected) {
+            val labels = shelf.labelsFor(message)
+            assertTrue("\"$message\" gave $labels", labels.any { it.startsWith(label) })
+        }
+    }
+
+    @Test
+    fun `small talk brings nothing and the budget holds`() {
+        val shelf = shelf()
+        for (message in listOf("hey", "mm", "ok", "lol", "what", "yeah i guess")) {
+            assertEquals("\"$message\"", emptyList<String>(), shelf.labelsFor(message))
+        }
+        val picked = shelf.select(listOf(Cue("your nails your hair your boots your tan your money your mom", 1.0)), 3000)
+        assertTrue(picked.sumOf { it.body.length + it.label.length + 4 } <= 3000)
+    }
+
+    @Test
+    fun `report what a few messages bring`() {
+        val out = System.getenv("YUME_LIBRARY_REPORT") ?: return
+        val shelf = shelf()
+        val messages = File(System.getenv("YUME_LIBRARY_MESSAGES") ?: return).readLines().filter { it.isNotBlank() }
+        File(out).writeText(
+            "${shelf.pages.size} pages, ${shelf.totalChars} chars\n" + messages.joinToString("\n") { message ->
+                val picked = shelf.select(listOf(Cue(message, 1.0)), 6000)
+                "\nQ: $message -> ${picked.size} pages, ${picked.sumOf { it.body.length }} chars\n" +
+                    picked.joinToString("\n") { "   ${it.label}" }
+            }
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryTextTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLibraryTextTest.kt
