+    /** The app-authored rows and the real back-and-forth, separated. */
+    data class ShapedHistory(val dialogue: List<ChatMessage>, val deviceActivity: List<String>)
+
+    /**
+     * Splits stored chat rows into what was actually said between the two of them and
+     * what the app wrote (pre-speech, plan traces, step results, questions).
+     *
+     * Stock sends every agent row back as an assistant turn. The app's rows are in a
+     * polite assistant voice and can carry notification text, so replaying them as her
+     * own lines both pulls her out of voice and hands third-party text the standing of
+     * something she said. Here they become a short fenced activity list instead.
+     * Consecutive rows from the same side are merged and the list always starts with
+     * the owner, which strict chat templates require.
+     *
+     * What became of a message of his is read off the badge the app put on the row when
+     * it decided: a command is labelled as one, an answer to a question the app asked is
+     * labelled as that, and a secret is only ever its marker. A row with no badge at all
+     * was stored before the app marked them; for those the old rule still holds, that a
+     * message the app answered was a command.
+     *
+     * With [holdBackPrivateResults] an app row that shows his private data is replaced by
+     * a line saying that it stays on the phone. The caller sets it when the prompt goes to
+     * a host that could read it; on a private route she reads such a row like any other.
+     *
+     * With [nowMillis] every app line carries its age, because it says what was true when
+     * it was written and not what is true now. With [activityMaxAgeMillis] as well, older
+     * app lines are left out altogether. At most [maxDialogueRows] rows of talk are kept,
+     * counted after the app's rows are taken out, so that a run of commands does not
+     * push the conversation out of her sight. [forNotebook] shapes the talk for her
+     * notebook pass: a reply she wrote with his screen in front of her says so, and her
+     * line about a result is left out.
+     *
+     * Of the planner's reasons for going on after a step only the last few are kept, so
+     * that they leave room among the app's lines for what the phone did.
+     */
+    fun shapeHistory(
+        messages: List<ChatMessage>,
+        holdBackPrivateResults: Boolean = false,
+        nowMillis: Long? = null,
+        activityMaxAgeMillis: Long? = null,
+        maxDialogueRows: Int = MAX_DIALOGUE_ROWS,
+        forNotebook: Boolean = false
+    ): ShapedHistory {
+        val activity = mutableListOf<String>()
+        val talk = mutableListOf<ChatMessage>()
+        val kept = withFewGoesOnRows(messages)
+        val rows = (if (holdBackPrivateResults) withPrivateResultsHeldBack(kept) else kept)
+            .filter { it.text.isNotBlank() }
+        for ((index, message) in rows.withIndex()) {
+            val isOwner = message.sender == ChatMessage.Sender.USER
+            if (!isOwner && !isHers(message)) {
+                val tooOld = activityMaxAgeMillis != null && nowMillis != null &&
+                    nowMillis - message.timestamp > activityMaxAgeMillis
+                if (!tooOld) activity += appLine(message, nowMillis)
+                continue
+            }
+            // Her line about a result is not a turn of the talk: her notebook pass is not given it.
+            if (forNotebook && isResultLine(message)) continue
+            val text = when {
+                isOwner -> ownerText(message, rows.subList(index + 1, rows.size))
+                forNotebook && readOffScreen(message) -> SCREEN_REPLY_LABEL + message.text.trim()
+                else -> message.text.trim()
+            }
+            // His row leaves here with its label in the text and no badge, so that
+            // shaping the result once more does not label it a second time.
+            talk += message.copy(text = text, modelBadge = if (isOwner) null else message.modelBadge)
+        }
+        val dialogue = mutableListOf<ChatMessage>()
+        for (message in talk.takeLast(maxDialogueRows.coerceAtLeast(0))) {
+            val previous = dialogue.lastOrNull()
+            if (previous != null && previous.sender == message.sender) {
+                dialogue[dialogue.lastIndex] = previous.copy(
+                    text = previous.text + "\n" + message.text,
+                    imageBase64 = message.imageBase64 ?: previous.imageBase64
+                )
+            } else {
+                dialogue += message
+            }
+        }
+        while (dialogue.isNotEmpty() && dialogue.first().sender != ChatMessage.Sender.USER) {
+            dialogue.removeAt(0)
+        }
+        return ShapedHistory(dialogue, activity.takeLast(MAX_ACTIVITY_LINES))
+    }
