--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesRequestTest.kt
@@ -0,0 +1,248 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.data.models.EyesBounds
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.personaOwnTimeKey
+import com.opendroid.ai.data.models.withOwnTimeKey
+import okhttp3.OkHttpClient
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.util.Base64
+
+/**
+ * Her eyes without a phone: the describer request as it is sent (I5: exactly one picture
+ * and one neutral instruction, nothing else), the instructions themselves, how an answer
+ * is read, which key goes, and the gate that says when a picture may go out at all.
+ */
+class HerEyesRequestTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val jpeg = byteArrayOf(0xff.toByte(), 0xd8.toByte(), 0xff.toByte(), 0xe0.toByte(), 1, 2, 3, 4, 5, 6, 7, 8)
+
+    private fun sent(source: Describe.Source = Describe.Source.PAGE_IMAGE, model: String = "google-gemma-4-31b-it"): JsonObject =
+        JsonParser.parseString(String(HerEyes.body(model, source, jpeg), Charsets.UTF_8)).asJsonObject
+
+    // ── I5: the request ──────────────────────────────────────────────────────────────
+
+    @Test
+    fun `I5 - a request holds exactly one picture and one neutral instruction, and nothing else`() {
+        for (source in Describe.Source.entries) {
+            val body = sent(source)
+            assertEquals(setOf("model", "messages", "temperature", "max_tokens", "venice_parameters"), body.keySet())
+            assertEquals("google-gemma-4-31b-it", body.get("model").asString)
+            val messages = body.getAsJsonArray("messages")
+            assertEquals(2, messages.size())
+            // The system message is one constant: the instruction for this kind of picture.
+            val system = messages[0].asJsonObject
+            assertEquals(setOf("role", "content"), system.keySet())
+            assertEquals("system", system.get("role").asString)
+            assertEquals(Describe.instruction(source), system.get("content").asString)
+            assertTrue(system.get("content").asString in Describe.ALL)
+            // The user turn: one text part, the fixed turn, and one picture.
+            val user = messages[1].asJsonObject
+            assertEquals(setOf("role", "content"), user.keySet())
+            assertEquals("user", user.get("role").asString)
+            val parts = user.getAsJsonArray("content")
+            assertEquals(2, parts.size())
+            assertEquals(1, parts.count { it.asJsonObject.get("type").asString == "text" })
+            assertEquals(1, parts.count { it.asJsonObject.get("type").asString == "image_url" })
+            val text = parts.first { it.asJsonObject.get("type").asString == "text" }.asJsonObject
+            assertEquals(setOf("type", "text"), text.keySet())
+            assertEquals(Describe.TURN, text.get("text").asString)
+            val image = parts.first { it.asJsonObject.get("type").asString == "image_url" }.asJsonObject
+            assertEquals(setOf("type", "image_url"), image.keySet())
+            val url = image.getAsJsonObject("image_url")
+            assertEquals(setOf("url"), url.keySet())
+            val data = url.get("url").asString
+            assertTrue(data.startsWith("data:image/jpeg;base64,"))
+            assertArrayEquals(jpeg, Base64.getDecoder().decode(data.removePrefix("data:image/jpeg;base64,")))
+            // Sampling, and Venice's own system prompt and thinking off.
+            assertEquals(0.2, body.get("temperature").asDouble, 1e-9)
+            assertEquals(350, body.get("max_tokens").asInt)
+            val venice = body.getAsJsonObject("venice_parameters")
+            assertEquals(setOf("include_venice_system_prompt", "disable_thinking"), venice.keySet())
+            assertFalse(venice.get("include_venice_system_prompt").asBoolean)
+            assertTrue(venice.get("disable_thinking").asBoolean)
+        }
+    }
+
+    @Test
+    fun `I5 - nothing of his or hers can be in a request, which is built from the model id, the kind of picture and the bytes alone`() {
+        // The one function a request is built by takes these three and nothing else.
+        val built = HerEyes.Companion::class.java.declaredMethods.single { it.name == "body" }
+        assertEquals(listOf(String::class.java, Describe.Source::class.java, ByteArray::class.java), built.parameterTypes.toList())
+        // And the text around the picture is the same for every picture of a kind.
+        val one = String(HerEyes.body("m", Describe.Source.FEED_IMAGE, byteArrayOf(1)), Charsets.UTF_8)
+        val two = String(HerEyes.body("m", Describe.Source.FEED_IMAGE, byteArrayOf(2, 3, 4)), Charsets.UTF_8)
+        assertEquals(one.substringBefore("base64,"), two.substringBefore("base64,"))
+        assertEquals(one.substringAfter("base64,").substringAfter('"'), two.substringAfter("base64,").substringAfter('"'))
+    }
+
+    @Test
+    fun `the instructions are neutral constants, open with the shared rule and end with the ages request`() {
+        assertEquals(5, Describe.Source.entries.size)
+        for (instruction in Describe.ALL) {
+            assertTrue(instruction.startsWith(Describe.SHARED))
+            assertTrue(instruction.endsWith(Describe.AGES))
+            assertTrue(instruction.endsWith("(for example ages: teen, adult)."))
+            // No persona, no names, nothing about whose picture it is or who reads the words.
+            for (word in listOf("Yume", "Kisaragi", "gyaru", "Ren", "owner", "girlfriend", "persona", " she ", " he ", " his ", " her ")) {
+                assertFalse("$word in $instruction", instruction.contains(word, ignoreCase = word.trim().length > 3))
+            }
+        }
+        assertTrue(Describe.SHARED.contains("apparent age group (child, teen or adult)"))
+        assertTrue(Describe.SHARED.contains("Never name anyone or guess who they are."))
+        assertEquals(
+            "You describe images for a reader who cannot see them. Plain prose. Never name anyone or guess who they are. " +
+                "For people: apparent age group (child, teen or adult), expression, pose and clothing in general terms. " +
+                "Copy visible text exactly, at most 200 characters. No opinions, advice or warnings. " +
+                "Describe this image: what is in it, the setting and the style. 3 to 6 sentences. " +
+                "End with one line: ages: none when no person is shown, or the apparent age groups shown, from child, teen and adult (for example ages: teen, adult).",
+            Describe.PAGE_IMAGE
+        )
+        assertTrue(Describe.CAMERA.contains("This is a photo from a phone camera."))
+        assertTrue(Describe.SCREEN.contains("This is a phone screen."))
+        assertTrue(Describe.VIDEO_FRAME.contains("This is one frame of a short video in an app."))
+    }
+
+    // ── Reading an answer ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `an answer is read with its tokens, whether it was cut off, and without the describer's thinking`() {
+        val reply = HerEyes.parseReply(
+            """{"choices":[{"message":{"content":"<think>hm</think>A red bridge over a river.\nages: none"},"finish_reason":"stop"}],"usage":{"prompt_tokens":812,"completion_tokens":40}}"""
+        )!!
+        assertEquals(812, reply.promptTokens)
+        assertEquals(40, reply.completionTokens)
+        assertFalse(reply.cutOff)
+        val parts = HerEyes.parseReply("""{"choices":[{"message":{"content":[{"type":"text","text":"A cat."},{"type":"text","text":"ages: none"}]},"finish_reason":"length"}]}""")!!
+        assertEquals("A cat.\nages: none", parts.content)
+        assertTrue(parts.cutOff)
+        assertNull(parts.promptTokens)
+        assertNull(HerEyes.parseReply("not json"))
+        assertNull(HerEyes.parseReply("""{"error":"nope"}"""))
+    }
+
+    @Test
+    fun `her words are the describer's without its ages line, which the code reads`() {
+        val seen = HerEyes.seen("Two people at a crossing in Shibuya, laughing.\n\nages: adult, adult", cutOff = false) as HerEyes.Seen.Described
+        assertEquals("Two people at a crossing in Shibuya, laughing.", seen.words)
+        assertEquals(KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)), seen.ages)
+        val none = HerEyes.seen("A bowl of ramen.", cutOff = true) as HerEyes.Seen.Described
+        assertEquals(KidGuard.Ages.Unchecked, none.ages)
+        assertTrue(none.cutOff)
+    }
+
+    @Test
+    fun `an unsupported answer is told apart from other errors`() {
+        assertTrue(HerEyes.unsupported(400, """{"error":"Image input is not supported for this model"}"""))
+        assertTrue(HerEyes.unsupported(415, "unsupported media"))
+        assertFalse(HerEyes.unsupported(400, """{"error":"bad temperature"}"""))
+        assertFalse(HerEyes.unsupported(500, "unsupported"))
+    }
+
+    // ── Which key, and the gate ──────────────────────────────────────────────────────
+
+    private val venice = "Custom OpenAI Compatible"
+
+    private fun config(
+        eyes: Boolean = true,
+        consent: Long = 1L,
+        hisKey: String? = "his-venice-key",
+        route: RoutePolicy = RoutePolicy.ENCRYPTED,
+        model: String = EyesBounds.DEFAULT_MODEL,
+        perDay: Int = 60,
+        stopped: String = ""
+    ) = LLMConfig(
+        activeProvider = venice,
+        customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+        apiKeys = hisKey?.let { mapOf(venice to it) } ?: emptyMap(),
+        routePolicy = route,
+        personaOwnLife = true,
+        personaEyes = eyes,
+        personaEyesConsentAt = consent,
+        personaEyesModel = model,
+        personaEyesPerDay = perDay,
+        personaEyesStoppedWhy = stopped
+    )
+
+    @Test
+    fun `her own-time key goes where he set one, else his Venice key, and it is kept with the encrypted keys`() {
+        assertEquals("his-venice-key", HerEyes.keyFor(config()))
+        val own = config().withOwnTimeKey("  her-own-key ")
+        assertEquals("her-own-key", own.personaOwnTimeKey)
+        assertEquals("her-own-key", own.apiKeys[EyesBounds.OWN_TIME_KEY_SLOT])
+        assertEquals("her-own-key", HerEyes.keyFor(own))
+        assertEquals("her-own-key", HerEyes.keyFor(config(hisKey = null).withOwnTimeKey("her-own-key")))
+        assertNull(HerEyes.keyFor(config(hisKey = null)))
+        // Blank takes it away.
+        assertFalse(own.withOwnTimeKey(" ").apiKeys.containsKey(EyesBounds.OWN_TIME_KEY_SLOT))
+    }
+
+    private val now = 1_800_000_000_000L
+
+    private fun eyes(ledger: OwnLedger) = HerEyes(
+        base = OkHttpClient(),
+        settings = { config() },
+        save = {},
+        ledger = ledger,
+        clock = { now }
+    )
+
+    @Test
+    fun `a picture goes out only with his switch, his consent, a key, a private model and room in the day and the ledger`() {
+        val ledger = OwnLedger({ File(folder.root, "ledger.json") }, { now })
+        val eyes = eyes(ledger)
+        assertNull(eyes.gate(config(), now))
+        assertEquals(HerEyes.Why.OFF, eyes.gate(config(eyes = false), now))
+        assertEquals(HerEyes.Why.OFF, eyes.gate(config(consent = 0L), now))
+        assertEquals(HerEyes.Why.OWN_HARDWARE, eyes.gate(config(route = RoutePolicy.OWN_HARDWARE), now))
+        assertEquals(HerEyes.Why.STOPPED, eyes.gate(config(stopped = HerEyes.STRUCK_OUT_WHY), now))
+        assertEquals(HerEyes.Why.NO_KEY, eyes.gate(config(hisKey = null), now))
+        assertEquals(HerEyes.Why.MODEL_REFUSED, eyes.gate(config(model = "claude-opus-45"), now))
+        assertEquals(HerEyes.Why.MODEL_REFUSED, eyes.gate(config(model = "openai-gpt-5"), now))
+        // The day's pictures: his number a day, counted over the rolling 24 hours.
+        repeat(3) { ledger.record(OwnPurpose.EYES, "google-gemma-4-31b-it", 900, 120, ok = true) }
+        assertEquals(57, eyes.leftToday(config(), now))
+        assertEquals(HerEyes.Why.DAY_USED_UP, eyes.gate(config(perDay = 3), now))
+        assertTrue(eyes.open(config(perDay = 4), now))
+        assertEquals(60, eyes.leftToday(config(), now + OwnLedger.WINDOW_MILLIS + 1))
+        // His number of calls on her own: an outing's look needs what a step needs.
+        val full = OwnLedger({ File(folder.root, "full.json") }, { now })
+        repeat(141) { full.record(OwnPurpose.MOMENT, "e2ee-her-model", 14_000, 600, ok = true) }
+        assertEquals(HerEyes.Why.CALLS_LOW, eyes(full).gate(config(), now))
+        assertNull(eyes(full).gate(config(), now, OwnLedger.Start.CALL))
+    }
+
+    @Test
+    fun `a ledger that cannot be read leaves her eyes shut`() {
+        val broken = File(folder.root, "broken.json").apply { writeText("{not a list") }
+        val eyes = eyes(OwnLedger({ broken }, { now }))
+        assertNull(eyes.leftToday(config(), now))
+        assertEquals(HerEyes.Why.DAY_USED_UP, eyes.gate(config(), now))
+    }
+
+    @Test
+    fun `the ledger prices her eyes by the table's rows for the eyes models`() {
+        for (model in EyesModels.CHOICES) {
+            val call = OwnLedger.Call(0L, OwnPurpose.EYES, model, 1_000, 350)
+            assertEquals((1_000 * 0.15 + 350 * 0.60) / 1_000_000.0, com.opendroid.ai.core.life.OwnPrices.usd(call), 1e-12)
+        }
+        assertEquals(OwnPurpose.Counted.LIMITED, OwnPurpose.EYES.counted)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesWallTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesWallTest.kt
