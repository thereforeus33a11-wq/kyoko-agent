@@ -0,0 +1,36 @@
+package com.opendroid.ai.core.voice.own
+
+import java.io.File
+import java.util.jar.JarFile
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The sherpa-onnx native side calls the callback that takes her samples by name and
+ * signature: invoke(float[]) returning Integer. A Kotlin lambda compiled the usual way
+ * (invokedynamic) declares only the erased invoke(Object), so the native side would find
+ * nothing to call and she would make no sound at all. Unit tests never load the native
+ * library, so the compiled class itself is checked here.
+ */
+class OwnVoiceCallbackTest {
+
+    @Test
+    fun `the callback her voice hands to the native side declares invoke(float array) returning Integer`() {
+        val outer = OwnVoice::class.java
+        val prefix = outer.name.replace('.', '/') + "$"
+        val location = File(outer.protectionDomain.codeSource.location.toURI())
+        val entries = if (location.isDirectory) {
+            location.walk().filter { it.isFile }.map { it.relativeTo(location).invariantSeparatorsPath }.toList()
+        } else {
+            JarFile(location).use { jar -> jar.entries().asSequence().map { it.name }.toList() }
+        }
+        val nested = entries.filter { it.startsWith(prefix) && it.endsWith(".class") }
+            .map { Class.forName(it.removeSuffix(".class").replace('/', '.'), false, outer.classLoader) }
+        val callbacks = nested.filter { cls ->
+            val invoke = runCatching { cls.getDeclaredMethod("invoke", FloatArray::class.java) }.getOrNull()
+            invoke != null && invoke.returnType == Int::class.javaObjectType &&
+                kotlin.jvm.functions.Function1::class.java.isAssignableFrom(cls)
+        }
+        assertTrue("classes nested in OwnVoice: ${nested.map { it.name }}", callbacks.isNotEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/data/models/BuildDefaultsTest.kt b/app/src/test/java/com/opendroid/ai/data/models/BuildDefaultsTest.kt
new file mode 100644
index 0000000..125a9d8
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/data/models/BuildDefaultsTest.kt
@@ -0,0 +1,131 @@
+package com.opendroid.ai.data.models
+
+import com.opendroid.ai.core.llm.ProviderCatalog
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.allows
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What this build is set to before the owner has changed anything. Stock starts on a
+ * hosted Google model; here the first provider is the one that can speak to a model end
+ * to end encrypted or on the owner's own machine, with its address filled in.
+ *
+ * That start is a setting of its own ([BuildDefaults.fresh]) and not the default of the
+ * fields: a setting is saved without the fields that equal their defaults, so a changed
+ * default would change what an older saved setting means.
+ */
+class BuildDefaultsTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    // The way SettingsRepository reads and writes a setting.
+    private val json = Json { ignoreUnknownKeys = true }
+
+    @Test
+    fun `a fresh install starts on the compatible provider with Venice's address filled in`() {
+        val fresh = BuildDefaults.fresh()
+
+        assertEquals(custom, fresh.activeProvider)
+        assertTrue(ProviderCatalog.isKnown(fresh.activeProvider))
+        assertEquals("https://api.venice.ai/api/v1", fresh.customEndpoints[custom])
+        // It starts on the model that is spoken to end to end encrypted, with time for it to think.
+        assertEquals(BuildDefaults.MODEL, fresh.activeModel)
+        assertEquals(BuildDefaults.MODEL, fresh.selectedModelFor(custom))
+        assertTrue(com.opendroid.ai.core.llm.providers.VeniceE2ee.isE2eeModel(BuildDefaults.MODEL))
+        assertEquals(120, fresh.resolvedCloudTimeoutSeconds())
+        // Her own time is on from the start in this build. The default a saved setting falls
+        // back to is still off, so a setting saved before keeps what it meant.
+        assertTrue(fresh.personaCheckInsEnabled)
+        assertFalse(LLMConfig().personaCheckInsEnabled)
+        // No key is assumed, and no model of its own for her replies.
+        assertTrue(fresh.apiKeys.isEmpty())
+        assertEquals("", fresh.personaChatModel)
+        assertEquals("", fresh.personaChatModelProvider)
+    }
+
+    @Test
+    fun `with that start nothing goes out readable until he chooses a private model or says otherwise`() {
+        val fresh = BuildDefaults.fresh()
+        // As it starts, both his commands and her replies go out end to end encrypted.
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.mainRoute(fresh))
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.personaRoute(fresh))
+        assertTrue(fresh.routePolicy.allows(RouteClassifier.mainRoute(fresh)))
+        // A plain hosted id typed in its place is refused until he allows such models himself.
+        val plain = fresh.withSelectedModel(custom, "venice-uncensored-1-2")
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.mainRoute(plain))
+        assertFalse(plain.routePolicy.allows(RouteClassifier.mainRoute(plain)))
+
+        val encrypted = fresh.withSelectedModel(custom, "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.mainRoute(encrypted))
+        assertTrue(encrypted.routePolicy.allows(RouteClassifier.mainRoute(encrypted)))
+
+        val ownMachine = fresh.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:8080/v1"))
+        assertEquals(RoutePrivacy.OWN_NETWORK, RouteClassifier.mainRoute(ownMachine))
+    }
+
+    @Test
+    fun `a setting saved by an earlier build keeps its provider, also where that was never written down`() {
+        // Gemini was the default when this was saved, so the provider is not in the text.
+        for (saved in listOf("{}", """{"routePolicy":"ANY","isDarkMode":false}""")) {
+            val earlier = json.decodeFromString<LLMConfig>(saved)
+            assertEquals(saved, "Google Gemini", earlier.activeProvider)
+            assertEquals(saved, ProviderCatalog.defaultModel("Google Gemini"), earlier.selectedModelFor("Google Gemini"))
+            assertTrue(saved, earlier.customEndpoints.isEmpty())
+        }
+    }
+
+    @Test
+    fun `this build's start survives being saved and read again`() {
+        val saved = json.encodeToString(BuildDefaults.fresh())
+        assertTrue("the provider has to be written down, or it would read back as stock", saved.contains(custom))
+
+        val readBack = json.decodeFromString<LLMConfig>(saved)
+        assertEquals(BuildDefaults.fresh(), readBack)
+    }
+
+    @Test
+    fun `a saved setting keeps what it says`() {
+        val his = json.decodeFromString<LLMConfig>(
+            """{"activeProvider":"Ollama","activeModel":"gemma3:4b","customEndpoints":{"Custom OpenAI Compatible":"http://127.0.0.1:8080/v1"}}"""
+        )
+        assertEquals("Ollama", his.activeProvider)
+        assertEquals("gemma3:4b", his.selectedModelFor("Ollama"))
+        assertEquals("http://127.0.0.1:8080/v1", his.customEndpoints[custom])
+
+        // A provider picked explicitly is switched to like any other, Gemini included.
+        val gemini = BuildDefaults.fresh().withActiveProvider("Google Gemini")
+        assertEquals("Google Gemini", gemini.activeProvider)
+        assertEquals(ProviderCatalog.defaultModel("Google Gemini"), gemini.selectedModelFor("Google Gemini"))
+        assertEquals("Google Gemini", json.decodeFromString<LLMConfig>(json.encodeToString(gemini)).activeProvider)
+    }
+
+    // ── The provider a model for her replies was typed for ───────────────────────────
+
+    @Test
+    fun `a reply model saved without its provider is tied to the provider her replies go to`() {
+        val onMain = LLMConfig(activeProvider = "OpenRouter", personaChatModel = "some/model")
+        assertEquals("OpenRouter", onMain.withReplyModelProviderRecorded().personaChatModelProvider)
+
+        val onHerOwn = onMain.copy(personaChatProvider = custom)
+        assertEquals(custom, onHerOwn.withReplyModelProviderRecorded().personaChatModelProvider)
+    }
+
+    @Test
+    fun `a provider already recorded is kept, and without a model nothing is recorded`() {
+        val recorded = LLMConfig(
+            activeProvider = "Ollama",
+            personaChatModel = "some/model",
+            personaChatModelProvider = "OpenRouter"
+        )
+        assertEquals(recorded, recorded.withReplyModelProviderRecorded())
+
+        val noModel = LLMConfig(activeProvider = "Ollama")
+        assertEquals("", noModel.withReplyModelProviderRecorded().personaChatModelProvider)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/data/repository/ConversationRepositoryLeavingTest.kt b/app/src/test/java/com/opendroid/ai/data/repository/ConversationRepositoryLeavingTest.kt
new file mode 100644
index 0000000..7e5039f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/data/repository/ConversationRepositoryLeavingTest.kt
@@ -0,0 +1,151 @@
+package com.opendroid.ai.data.repository
+
+import android.app.Application
+import android.content.Context
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The chats read by time and not by chat, and what is told before messages are deleted
+ * for good. Both are there for a reader that must not miss what was said: it reads what
+ * is newer than the last thing it read, wherever it stands, and it is given the chance
+ * to take what it has not read out of a chat that is about to go.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = Application::class)
+class ConversationRepositoryLeavingTest {
+
+    private val context: Context
+        get() = ApplicationProvider.getApplicationContext()
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var repository: ConversationRepository
+    private lateinit var first: String
+    private lateinit var second: String
+
+    private fun row(id: String, at: Long, his: Boolean = true) = ChatMessage(
+        id = id,
+        text = "line $id",
+        sender = if (his) ChatMessage.Sender.USER else ChatMessage.Sender.AGENT,
+        timestamp = at
+    )
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        repository = ConversationRepository(database, database.conversationDao(), database.chatSessionDao())
+        runBlocking {
+            first = repository.createSession("first")
+            second = repository.createSession("second")
+            repository.insertMessage(first, row("a", 1_000))
+            repository.insertMessage(first, row("b", 1_010, his = false))
+            repository.insertMessage(second, row("c", 2_000))
+            repository.insertMessage(first, row("d", 3_000))
+            repository.insertMessage(second, row("e", 3_000, his = false))
+        }
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `messages newer than a time are read across chats, oldest first, each with its chat`() = runBlocking {
+        val all = repository.getMessagesSince(0, 100)
+        assertEquals(listOf("a", "b", "c", "d", "e"), all.map { it.message.id })
+        assertEquals(listOf(first, first, second, first, second), all.map { it.sessionId })
+
+        // Only what is newer, and no more than asked for: the oldest of them.
+        assertEquals(listOf("c", "d", "e"), repository.getMessagesSince(1_010, 100).map { it.message.id })
+        assertEquals(listOf("a", "b"), repository.getMessagesSince(0, 2).map { it.message.id })
+        assertTrue(repository.getMessagesSince(3_000, 100).isEmpty())
+    }
+
+    @Test
+    fun `the messages of one chat up to a time are read newest last`() = runBlocking {
+        assertEquals(listOf("a", "b"), repository.getMessagesUntil(first, 2_999, 10).map { it.id })
+        assertEquals(listOf("b", "d"), repository.getMessagesUntil(first, 3_000, 2).map { it.id })
+        assertTrue(repository.getMessagesUntil(second, 1_999, 10).isEmpty())
+        assertTrue(repository.getMessagesUntil("no such chat", 9_000, 10).isEmpty())
+    }
+
+    @Test
+    fun `before a chat is cleared or deleted its messages can still be read, and then they are gone`() = runBlocking {
+        val seen = ArrayList<List<String>>()
+        repository.beforeMessagesGo = { leaving -> seen += leaving(1_000, 100).map { "${it.sessionId == first}:${it.message.id}" } }
+
+        repository.clearSession(first)
+        // Only that chat's messages, and only those newer than the time asked for.
+        assertEquals(listOf(listOf("true:b", "true:d")), seen)
+        assertTrue(repository.getMessages(first).first().isEmpty())
+        assertEquals(2, repository.getMessages(second).first().size)
+
+        repository.deleteSession(second)
+        assertEquals(listOf("false:c", "false:e"), seen.last())
+        assertTrue(repository.getMessagesSince(0, 100).isEmpty())
+    }
+
+    @Test
+    fun `before a message is edited and sent again, what stood behind it can still be read, and it is not among that`() = runBlocking {
+        // The first chat holds a, b and d; two more rows follow d.
+        repository.insertMessage(first, row("g", 3_500, his = false))
+        repository.insertMessage(first, row("h", 4_000))
+        val seen = ArrayList<List<String>>()
+        repository.beforeMessagesGo = { leaving -> seen += leaving(1_000, 100).map { "${it.sessionId == first}:${it.message.id}" } }
+
+        repository.deleteMessageAndAfter(first, "b")
+
+        // What was written behind the edited message, newer than the time asked for.
+        // Not the message itself, whose new wording is sent again, and nothing before it.
+        assertEquals(listOf(listOf("true:d", "true:g", "true:h")), seen)
+        assertEquals(listOf("a"), repository.getMessages(first).first().map { it.id })
+        assertEquals(2, repository.getMessages(second).first().size)
+
+        // No more than asked for, the oldest first; and a message that is not there hands over nothing.
+        repository.insertMessage(first, row("i", 5_000))
+        repository.insertMessage(first, row("j", 5_010, his = false))
+        repository.insertMessage(first, row("k", 5_020))
+        repository.beforeMessagesGo = { leaving -> seen += leaving(0, 1).map { it.message.id } }
+        repository.deleteMessageAndAfter(first, "no such message")
+        assertTrue(seen.last().isEmpty())
+        repository.deleteMessageAndAfter(first, "i")
+        assertEquals(listOf("j"), seen.last())
+        assertEquals(listOf("a"), repository.getMessages(first).first().map { it.id })
+    }
+
+    @Test
+    fun `a wipe of every chat hands over the messages of all of them, and a listener that fails stops nothing`() = runBlocking {
+        var handed = emptyList<String>()
+        repository.beforeMessagesGo = { leaving ->
+            handed = leaving(0, 100).map { it.message.id }
+            throw IllegalStateException("the listener broke")
+        }
+
+        repository.clearAllSessions()
+
+        assertEquals(listOf("a", "b", "c", "d", "e"), handed)
+        assertTrue(repository.getMessagesSince(0, 100).isEmpty())
+
+        // With nobody listening the chats are deleted as they always were.
+        repository.beforeMessagesGo = null
+        repository.insertMessage(first, row("f", 4_000))
+        repository.clearCurrentSession()
+        repository.clearSession(first)
+        assertTrue(repository.getMessagesSince(0, 100).isEmpty())
+    }
+}
