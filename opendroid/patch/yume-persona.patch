+        assertTrue(personaMemory.notes().isEmpty())
+        assertEquals(0, personaMemory.empty())
+    }
+
+    @Test
+    fun `a notebook emptied before her first reply is not filled with the starting notes afterwards`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.USER, "bees", "he keeps bees")))
+
+        assertEquals(1, personaMemory.empty())
+        personaMemory.seedIfNeeded(startingNotes)
+
+        assertTrue(personaMemory.notes().isEmpty())
+    }
+
+    @Test
+    fun `the time of her last notebook pass is stored and is not a note`() = runBlocking {
+        assertEquals(0L, personaMemory.lastReflectionAt())
+        personaMemory.recordReflection(1_700_000_000_000)
+        assertEquals(1_700_000_000_000, personaMemory.lastReflectionAt())
+        assertTrue(personaMemory.notes().isEmpty())
+        // It is read from the store, so a new process finds it.
+        assertEquals(1_700_000_000_000, PersonaMemory(memoryRepository).lastReflectionAt())
+    }
+
+    @Test
+    fun `her block is given what the stock context is given, and a lean route holds back the same`() = runBlocking {
+        profile = UserProfile(name = "Sam", dateOfBirth = "03/14/1990")
+        for ((key, value) in listOf(
+            "favorite_tea" to "oolong",
+            "home_address" to "12 Fernhill Lane",
+            "note_garage" to "Title: garage code 4410",
+            "contact_pref_dad" to "Dad||+15550100||",
+            "notif_pattern_top_contacts" to "Most contacted people this week: Riya (12 messages)"
+        )) {
+            memoryRepository.saveMemory(Memory(key, value, MemoryType.SEMANTIC))
+        }
+        personaMemory.apply(listOf(Note(Kind.USER, "hives", "he keeps 9 hives")))
+        database.notificationDao().insertNotification(
+            com.opendroid.ai.data.db.entities.NotificationEntity(
+                packageName = "com.example.chat", appName = "Chat", title = "Riya",
+                text = "the hive inspector comes on friday", contactName = "Riya"
+            )
+        )
+
+        for (lean in listOf(true, false)) {
+            val stock = manager.getRelevantContext("", lean = lean)
+            val pieces = manager.contextPieces(lean = lean)
+
+            // Every stored fact she is given stands in the stock context for the same route.
+            assertTrue(pieces.facts.isNotEmpty())
+            for ((key, value) in pieces.facts) assertTrue("$key lean=$lean", stock.contains("$key: $value"))
+            // And what the stock context leaves out, her pieces leave out.
+            for (detail in listOf("Fernhill", "4410", "oolong")) {
+                assertEquals("$detail lean=$lean", stock.contains(detail), pieces.facts.any { it.second.contains(detail) })
+            }
+            assertEquals(stock.contains("03/14/1990"), pieces.dateOfBirth == "03/14/1990")
+            assertEquals(stock.contains("inspector"), pieces.notifications.contains("inspector"))
+            // The notification she is shown is found in the stock context as that context
+            // really prints it: this is what ties her block to what the caller read.
+            assertEquals(
+                if (lean) 0 else 1,
+                PersonaEngine.notificationLines(manager.contextPieces(lean = false).notifications, stock).size
+            )
+            assertEquals(stock.contains("Most contacted"), pieces.notificationPatterns.contains("Most contacted"))
+            assertEquals(stock.contains("Location="), pieces.location.isNotEmpty())
+            assertEquals("Sam", pieces.ownerName)
+            // Never, on any route: a contact's number, or her own notebook.
+            val handed = pieces.toString()
+            for (never in listOf("+15550100", "9 hives", PersonaNotes.KEY_PREFIX)) {
+                assertFalse("$never lean=$lean", handed.contains(never))
+            }
+        }
+
+        val lean = manager.contextPieces(lean = true)
+        assertEquals(listOf("favorite_tea" to "oolong"), lean.facts)
+        assertEquals("", lean.dateOfBirth)
+        assertEquals("", lean.location)
+        assertEquals("", lean.notifications)
+        assertEquals("", lean.notificationPatterns)
+        assertEquals("", lean.learnedFromUse)
+        assertEquals("", lean.planGoal)
+
+        val whole = manager.contextPieces(lean = false)
+        assertTrue(whole.facts.contains("home_address" to "12 Fernhill Lane"))
+        assertTrue(whole.notifications.contains("the hive inspector comes on friday"))
+    }
+
+    @Test
+    fun `notebook passes without sight of what she noted about him do not pile up copies in the store`() = runBlocking {
+        personaMemory.apply(
+            listOf(
+                Note(Kind.USER, "tea", "he drinks tea"),
+                Note(Kind.THREAD, "hive", "the second hive is half built | open"),
+                Note(Kind.OPINION, "smoke", "the smoker is overrated")
+            )
+        )
+        val unseen = setOf(Kind.USER)
+
+        // The same talk stays in the window, so every pass writes the same line again.
+        repeat(5) {
+            val changes = listOf(Note(Kind.USER, "tea", "he drinks oolong"))
+            personaMemory.apply(PersonaNotes.besideUnseen(changes, personaMemory.notes(), unseen))
+        }
+
+        val notes = personaMemory.notes()
+        assertEquals(4, notes.size)
+        assertEquals(
+            setOf("he drinks tea", "he drinks oolong"),
+            notes.filter { it.kind == Kind.USER }.map { it.text }.toSet()
+        )
+        // Her thread and her opinion are still there: nothing had to make room.
+        assertTrue(notes.any { it.kind == Kind.THREAD })
+        assertTrue(notes.any { it.kind == Kind.OPINION })
+    }
+
+    /** The stored profile; none unless a test sets one. */
+    private var profile: UserProfile? = null
+
+    private val profileStore = object : UserProfileStore {
+        override fun read(): ProfileStoreResult<UserProfile?> = ProfileStoreResult.Success(profile)
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt
new file mode 100644
index 0000000..8da27cf
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt
@@ -0,0 +1,126 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her notebook pass: it is due from what is stored, not from a count that is lost when
+ * the app is closed, and it is written by her, with her card in front of it.
+ */
+class PersonaNotebookPassTest {
+
+    private var nextId = 0
+    private fun row(sender: Sender, badge: String?, at: Long, text: String = "line") =
+        ChatMessage(id = "m${nextId++}", text = text, sender = sender, timestamp = at, modelBadge = badge)
+
+    @Test
+    fun `a pass is due once three of her replies are newer than the last one`() {
+        val rows = listOf(
+            row(Sender.USER, null, 100),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110),
+            row(Sender.AGENT, "System", 120),
+            row(Sender.USER, null, 200),
+            row(Sender.AGENT, PersonaPrompts.STOPPED_BADGE, 210),
+            row(Sender.USER, null, 300),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 310)
+        )
+        // Counted from the stored rows, so a process that starts afresh still knows: three of hers.
+        assertEquals(3, PersonaEngine.repliesSince(rows, 0))
+        assertEquals(3, PersonaEngine.REPLIES_PER_REFLECTION)
+        // Only replies newer than the last pass count, and the app's rows and his never do.
+        assertEquals(2, PersonaEngine.repliesSince(rows, 110))
+        assertEquals(1, PersonaEngine.repliesSince(rows, 210))
+        assertEquals(0, PersonaEngine.repliesSince(rows, 310))
+        assertEquals(0, PersonaEngine.repliesSince(emptyList(), 0))
+    }
+
+    @Test
+    fun `her line about a result and a line she wrote unprompted are not replies`() {
+        val rows = listOf(
+            // Two commands of his: the app's exact row, then her line about it.
+            row(Sender.USER, null, 100, "flashlight on"),
+            row(Sender.AGENT, "System", 110, "Flashlight on."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 120, "light's on"),
+            row(Sender.USER, null, 200, "set an alarm for seven"),
+            row(Sender.AGENT, "System", 210, "Alarm set for 7:00."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 220, "seven it is"),
+            // Hours later she writes first.
+            row(Sender.AGENT, PersonaPrompts.BADGE, 9_000, "the boots are still in the window"),
+            // And then he says one thing to her.
+            row(Sender.USER, null, 9_100, "which boots"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 9_110, "the ones you will hear about until i have them")
+        )
+        // Four rows carry her badge, and one of them answers him.
+        assertEquals(4, rows.count { PersonaPrompts.isHers(it) })
+        assertEquals(1, PersonaEngine.repliesSince(rows, 0))
+        assertTrue(PersonaEngine.repliesSince(rows, 0) < PersonaEngine.REPLIES_PER_REFLECTION)
+
+        // A reply that ends in a command of her own is one reply, whatever the app and she say after it.
+        val ownCommand = listOf(
+            row(Sender.USER, null, 100, "it is dark in here"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110, "then let there be light"),
+            row(Sender.AGENT, PersonaActions.REIN_BADGE, 120, "Running on Yume's own command, without asking: 1 step"),
+            row(Sender.AGENT, "System", 130, "Flashlight on."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 140, "there")
+        )
+        assertEquals(1, PersonaEngine.repliesSince(ownCommand, 0))
+    }
+
+    @Test
+    fun `two short visits on different days add up to a pass`() {
+        // Two replies before the app was closed, two after it was opened again: no count
+        // kept in memory would have reached three.
+        val yesterday = listOf(
+            row(Sender.USER, null, 1_000), row(Sender.AGENT, PersonaPrompts.BADGE, 1_010),
+            row(Sender.USER, null, 1_100), row(Sender.AGENT, PersonaPrompts.BADGE, 1_110)
+        )
+        val today = listOf(
+            row(Sender.USER, null, 90_000), row(Sender.AGENT, PersonaPrompts.BADGE, 90_010),
+            row(Sender.USER, null, 90_100), row(Sender.AGENT, PersonaPrompts.BADGE, 90_110)
+        )
+        assertTrue(PersonaEngine.repliesSince(yesterday, 0) < PersonaEngine.REPLIES_PER_REFLECTION)
+        assertTrue(PersonaEngine.repliesSince(yesterday + today, 0) >= PersonaEngine.REPLIES_PER_REFLECTION)
+        // After a pass over all of it nothing is due until she has said more.
+        val read = (yesterday + today).maxOf { it.timestamp }
+        assertEquals(0, PersonaEngine.repliesSince(yesterday + today, read))
+    }
+
+    @Test
+    fun `the pass is asked as her, once, with room for the lines it may write`() {
+        val dialogue = listOf(
+            row(Sender.USER, null, 100, "the second hive is up"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110, "finally")
+        )
+        val request = PersonaEngine.reflectionRequest(
+            card = "You are Yume. {{owner}} built you.",
+            ownerName = "Sam",
+            notebook = "rel | stage | past the polite part",
+            dialogue = dialogue,
+            notesAboutHimHeldBack = false
+        )
+
+        // Her card comes first: the one who decides what she keeps is her.
+        assertTrue(request.systemPrompt.startsWith("You are Yume. Sam built you.\n\n"))
+        assertTrue(request.systemPrompt.endsWith(PersonaPrompts.REFLECTION_SYSTEM_PROMPT))
+        val asked = request.messages.single()
+        assertEquals(Sender.USER, asked.sender)
+        assertTrue(asked.text.contains("rel | stage | past the polite part"))
+        assertTrue(asked.text.contains("he: the second hive is up"))
+        assertTrue(asked.text.contains("i: finally"))
+        assertFalse(asked.text.contains("Not shown"))
+        assertEquals(ResponseFormat.TEXT, request.responseFormat)
+        assertEquals(RetryPolicy.NONE, request.retryPolicy)
+        // Five lines of the longest note are some 1,200 characters; this leaves room for them.
+        val longest = PersonaNotes.LINES_PER_PASS * (PersonaNotes.MAX_NOTE_CHARS + 50)
+        assertTrue(request.maxTokens * 3 >= longest)
+
+        val heldBack = PersonaEngine.reflectionRequest("You are Yume.", "Sam", "", dialogue, notesAboutHimHeldBack = true)
+        assertTrue(heldBack.messages.single().text.contains("Not shown: what you have noted about him, and what you saw on his screen."))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt
new file mode 100644
index 0000000..2d2e22f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt
@@ -0,0 +1,517 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersonaNotesTest {
+
+    @Test
+    fun `a well formed line becomes a note`() {
+        val note = PersonaNotes.parseLine("user | hive | he keeps 9 hives and talks about it too much")
+        assertEquals(Note(Kind.USER, "hive", "he keeps 9 hives and talks about it too much"), note)
+        assertEquals("yume.user.hive", note!!.storageKey)
+    }
+
+    @Test
+    fun `keys are normalised and bullets tolerated`() {
+        val note = PersonaNotes.parseLine("- Opinion | Bad Jokes | his jokes are bad and he knows")
+        assertEquals(Note(Kind.OPINION, "bad-jokes", "his jokes are bad and he knows"), note)
+    }
+
+    @Test
+    fun `lines that do not fit the form are dropped`() {
+        for (line in listOf(
+            "", "NONE", "# comment", "user | hive", "mood | x1 | something", "user | !! | text",
+            "user | a | too short key", "user | ok-key | hi", "just a sentence about him"
+        )) {
+            assertNull(line, PersonaNotes.parseLine(line))
+        }
+    }
+
+    @Test
+    fun `long text is cut and control characters removed`() {
+        val note = PersonaNotes.parseLine("rel | stage | " + "x".repeat(500) + "\u0007")!!
+        assertEquals(PersonaNotes.MAX_NOTE_CHARS, note.text.length)
+        assertFalse(note.text.contains('\u0007'))
+    }
+
+    @Test
+    fun `parse keeps the last note per key and honours the limit`() {
+        val text = """
+            user | bee | he keeps 9 hives
+            chatter that is not a note
+            user | bee | he sold the hive
+            thread | body | 3d model: rig still missing | open
+            opinion | hosts | hosts are scammers with good hair
+            fix | emoji | stop ending lines with an emoji
+        """.trimIndent()
+        val all = PersonaNotes.parse(text)
+        assertEquals(listOf("he sold the hive"), all.filter { it.key == "bee" }.map { it.text })
+        assertEquals(4, all.size)
+        assertEquals(2, PersonaNotes.parse(text, limit = 2).size)
+    }
+
+    @Test
+    fun `a closed thread is recognised`() {
+        assertTrue(PersonaNotes.parseLine("thread | body | rig finished | closed")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("thread | body | rig missing | open")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("user | door | he closed the shop | closed")!!.isClosedThread)
+    }
+
+    @Test
+    fun `storage round trip and foreign rows`() {
+        val note = Note(Kind.THREAD, "body", "rig missing | open")
+        assertEquals(note, PersonaNotes.fromStorage(note.storageKey, note.text))
+        assertNull(PersonaNotes.fromStorage("wife_name", "Sara"))
+        assertNull(PersonaNotes.fromStorage("yume.meta.seeded", "1"))
+        assertNull(PersonaNotes.fromStorage("yume.user.", "x"))
+    }
+
+    @Test
+    fun `render groups the notes under headings in a fixed order, what he corrected first`() {
+        val notes = listOf(
+            Note(Kind.OPINION, "hosts", "hosts are scammers"),
+            Note(Kind.USER, "bee", "he keeps 9 hives"),
+            Note(Kind.ME, "soda", "melon soda is mine and i do not share"),
+            Note(Kind.FIX, "emoji", "an emoji at the end of every line read as fake"),
+            Note(Kind.THREAD, "body", "rig missing | open"),
+            Note(Kind.REL, "stage", "past the polite part")
+        )
+        val block = PersonaNotes.render(notes)
+        val order = listOf(
+            "What he corrected or called fake (the detail as it is now, or the line and what was off: examples, not a ban list):",
+            "- an emoji at the end of every line read as fake",
+            "Where you two stand:",
+            "- past the polite part",
+            "What you have settled about yourself:",
+            "- melon soda is mine and i do not share",
+            "What you know about him:",
+            "- he keeps 9 hives",
+            "Still going on:",
+            "- rig missing | open",
+            "What you think:",
+            "- hosts are scammers"
+        )
+        assertEquals(order.joinToString("\n"), block)
+        // A correction is an example she keeps, not an order she now follows.
+        assertFalse(block.contains("this is how you do it now"))
+        assertEquals("", PersonaNotes.render(emptyList()))
+    }
+
+    private fun sized(kind: Kind, key: String, chars: Int) = Note(kind, key, "$key ".padEnd(chars, 'x'))
+
+    @Test
+    fun `what he corrected gets a third of the room at most, so it cannot push out the rest`() {
+        // Each note costs 100 characters: twelve corrections would have filled the room alone.
+        val fixes = (1..12).map { sized(Kind.FIX, "fix-$it", 97) }
+        val aboutHim = (1..12).map { sized(Kind.USER, "him-$it", 97) }
+
+        val block = PersonaNotes.render(fixes + aboutHim, maxChars = 1200)
+
+        val shownFixes = (1..12).filter { block.contains("- fix-$it x") }
+        val shownAboutHim = (1..12).filter { block.contains("- him-$it x") }
+        // A third of 1,200 holds the four newest corrections; the rest of the room is for the rest.
+        assertEquals(listOf(1, 2, 3, 4), shownFixes)
+        assertEquals((1..8).toList(), shownAboutHim)
+        assertTrue(block.indexOf("- fix-1 ") < block.indexOf("- him-1 "))
+        assertTrue(block, block.endsWith("\n(12 older notes of yours are not shown here)"))
+    }
+
+    @Test
+    fun `corrections beyond their third are still shown when everything else has had its place`() {
+        val fixes = (1..6).map { sized(Kind.FIX, "fix-$it", 97) }
+        val block = PersonaNotes.render(fixes + Note(Kind.USER, "bees", "he keeps bees"), maxChars = 1200)
+        for (number in 1..6) assertTrue("fix-$number", block.contains("- fix-$number x"))
+        assertTrue(block.contains("- he keeps bees"))
+        assertFalse(block.contains("not shown"))
+    }
+
+    @Test
+    fun `notes that do not fit are counted in one line, and they are always the older ones`() {
+        val views = (1..6).map { Note(Kind.OPINION, "view-$it", "view number $it holds") }
+
+        // Each costs 22 characters, so 70 hold three.
+        assertEquals(
+            "What you think:\n- view number 1 holds\n- view number 2 holds\n- view number 3 holds\n" +
+                "(3 older notes of yours are not shown here)",
+            PersonaNotes.render(views, maxChars = 70)
+        )
+        assertTrue(PersonaNotes.render(views.take(4), maxChars = 70).endsWith("\n(1 older note of yours is not shown here)"))
+        assertFalse(PersonaNotes.render(views, maxChars = 6 * 22).contains("not shown"))
+
+        // A short old note does not slip in past a newer one that did not fit.
+        val uneven = listOf(
+            Note(Kind.OPINION, "aa", "a".repeat(30)),
+            Note(Kind.OPINION, "bb", "b".repeat(60)),
+            Note(Kind.OPINION, "cc", "short")
+        )
+        val cut = PersonaNotes.render(uneven, maxChars = 50)
+        assertTrue(cut.contains("a".repeat(30)))
+        assertFalse(cut, cut.contains("short"))
+        assertTrue(cut, cut.endsWith("(2 older notes of yours are not shown here)"))
+    }
+
+    @Test
+    fun `the room holds the notebook she really has`() {
+        assertEquals(9000, PersonaNotes.PROMPT_BUDGET_CHARS)
+        // Sixty notes of 120 characters: far more than the old room of 2,400 held.
+        val notebook = (1..60).map { sized(if (it % 2 == 0) Kind.USER else Kind.THREAD, "note-$it", 120) }
+        val block = PersonaNotes.render(notebook)
+        assertFalse(block.contains("not shown"))
+        for (number in 1..60) assertTrue("note-$number", block.contains("- note-$number x"))
+        assertEquals(60, PersonaNotes.renderForReview(notebook).lines().size)
+    }
+
+    @Test
+    fun `closed threads have a heading of their own after the open ones, and only the newest five are shown`() {
+        val closed = (1..7).map { Note(Kind.THREAD, "tab-$it", "street story: tab $it is paid off | closed") }
+        val notes = listOf(Note(Kind.THREAD, "boots", "street story: saving for the boots | open")) +
+            closed + Note(Kind.OPINION, "hosts", "hosts are scammers")
+
+        val block = PersonaNotes.render(notes)
+
+        val open = block.indexOf("Still going on:\n- street story: saving for the boots | open")
+        val over = block.indexOf("Over, and you remember how it went:\n- street story: tab 1 is paid off | closed")
+        val views = block.indexOf("What you think:")
+        assertTrue(block, open >= 0 && over > open && views > over)
+        for (number in 1..5) assertTrue(block.contains("tab $number is paid off"))
+        for (number in 6..7) assertFalse(block.contains("tab $number is paid off"))
+        assertTrue(block.endsWith("\n(2 older notes of yours are not shown here)"))
+
+        // The notebook pass is shown every one of them, so she can still reopen or reword one.
+        val review = PersonaNotes.renderForReview(notes)
+        assertEquals(notes.map { it.toLine() }, review.lines())
+    }
+
+    @Test
+    fun `when room runs out, how a street story ended goes before anything about him or the two of them`() {
+        val notes = listOf(
+            Note(Kind.THREAD, "tab", "street story: the tab is paid | closed"),
+            Note(Kind.USER, "bees", "he keeps bees"),
+            Note(Kind.REL, "stage", "we are past the polite part")
+        )
+        // Room for the two older notes only: the newest one is the closed thread, and it is the one left out.
+        val block = PersonaNotes.render(notes, maxChars = (13 + 3) + (27 + 3))
+        assertTrue(block.contains("- he keeps bees"))
+        assertTrue(block.contains("- we are past the polite part"))
+        assertFalse(block.contains("the tab is paid"))
+        assertFalse(block.contains("Over, and you remember how it went"))
+        assertTrue(block.endsWith("\n(1 older note of yours is not shown here)"))
+    }
+
+    @Test
+    fun `the notebook pass is shown the same notes as her chat prompt, and the same line when some did not fit`() {
+        val notes = (1..6).map { Note(Kind.USER, "fact-$it", "fact number $it about him") }
+
+        val chat = PersonaNotes.render(notes, maxChars = 90)
+        val review = PersonaNotes.renderForReview(notes, maxChars = 90)
+
+        assertEquals(
+            listOf(
+                "user | fact-1 | fact number 1 about him",
+                "user | fact-2 | fact number 2 about him",
+                "user | fact-3 | fact number 3 about him",
+                "(3 older notes of yours are not shown here)"
+            ),
+            review.lines()
+        )
+        for (number in 1..3) assertTrue(chat.contains("- fact number $number about him"))
+        for (number in 4..6) assertFalse(chat.contains("fact number $number about him"))
+        assertTrue(chat.endsWith("(3 older notes of yours are not shown here)"))
+    }
+
+    @Test
+    fun `she has a kind for what she settles about herself`() {
