+
+    // ── A model that will not take her picture ───────────────────────────────────────
+
+    private fun failing(failure: Throwable): Flow<String> = flow { throw failure }
+
+    private fun rejected(): LLMException = LLMErrorMapper.requestInvalid(custom, "her-vision-model")
+
+    @Test
+    fun `a model that will not take her picture costs her the picture, not the reply`() {
+        stored(self("a", "black coat, fur collar"))
+        val config = config()
+        assertFalse(engine.pictureRefused(config))
+        var secondTries = 0
+
+        val said = runBlocking {
+            engine.orWithoutPicture(config, failing(rejected())) {
+                secondTries++
+                flowOf("mm", ". morning")
+            }.toList()
+        }
+
+        assertEquals(listOf("mm", ". morning"), said)
+        assertEquals(1, secondTries)
+
+        // The model is remembered: her next replies do not each begin with a request that fails.
+        assertTrue(engine.pictureRefused(config))
+        assertNull(pictureFor(config, listOf(he("morning"))))
+        assertNull(pictureFor(config, listOf(he("hi"), she("mm"), he("what are you wearing"))))
+        assertEquals(0, runBlocking { pictures.turn() })
+        // And she is told in words what is on her pictures instead.
+        assertTrue(chatPrompt(config).contains(PersonaPrompts.PICTURES_HEADING + "\n- black coat, fur collar\n"))
+
+        // It is that model which is remembered, not her: on another one she is shown herself again.
+        val otherModel = config.copy(personaChatModel = "another-vision-model")
+        assertFalse(engine.pictureRefused(otherModel))
+        assertNotNull(pictureFor(otherModel, listOf(he("morning"))))
+        val otherAddress = config.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:8080/v1"))
+        assertFalse(engine.pictureRefused(otherAddress))
