+        val lines = PlanApprovalSummary.stepLines(plan)
+        val next = plan.steps.withIndex().drop(index + 1).firstOrNull { (_, step) ->
+            step.status == StepStatus.PENDING && !isTalkAction(canonicalName(step)) &&
+                canonicalName(step) !in ASKING_ACTIONS
+        } ?: return null
+        return "Next: ${lines[next.index]}"
+    }
+
+    /**
+     * The step of [plan] that is itself putting a question to the owner: the step
+     * [stepIdInHand], when its action is one of [ASKING_ACTIONS]. Null when the step in
+     * hand is something else. A macro runs steps of its own inside one step of the plan,
+     * and a question from in there belongs to none of the plan's steps: what the plan
+     * says comes after the macro is not what that question guards.
+     */
+    fun askingStep(plan: Plan?, stepIdInHand: String?, canonicalName: (PlanStep) -> String): PlanStep? =
+        plan?.steps?.firstOrNull { it.stepId == stepIdInHand }?.takeIf { canonicalName(it) in ASKING_ACTIONS }
+
+    /**
+     * True when the question the step [asking] puts to the owner may repeat his private
+     * data: the step quotes the result of a step that read some ("You got: $s1. Reply?"),
+     * or of one that names a saved contact. The phone fills such a quote in itself, so
+     * what the planner was told says nothing about what the question holds.
+     *
+     * With no [asking] step the question comes from where the plan cannot see (a macro's
+     * own steps, an action run outside any plan). What it quotes is then not known, and
+     * it is taken to hold some: the row is shown to him as it is either way, and only a
+     * prompt that a host could read gets a placeholder in its place.
+     */
+    fun questionMayHoldPersonalData(
+        plan: Plan?,
+        asking: PlanStep?,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Boolean {
+        if (plan == null || asking == null) return true
+        return asking.stepId in PersonalDataResults.stepIdsHolding(plan.steps, canonicalNames) ||
+            asking.stepId in PersonalDataResults.stepIdsNamingContact(plan.steps, canonicalNames)
+    }
+
+    /**
+     * True when the lines of [plan]'s steps say more than which actions they are: who a
+     * step goes to, a file, an amount. Validation writes numbers from his address book
+     * into a plan, so a row built from such lines holds his private data.
+     */
+    fun stepLinesNameDetails(plan: Plan): Boolean {
+        val bare = plan.copy(steps = plan.steps.map { it.copy(params = emptyMap()) })
+        return PlanApprovalSummary.stepLines(plan) != PlanApprovalSummary.stepLines(bare)
+    }
+
+    /** True when [plan] has a step that takes a secret, such as saving one in the secure store. */
+    fun takesASecret(plan: Plan): Boolean = PlanPrivacy.redactPlan(plan) !== plan
+
+    /**
+     * True when the owner's answer to the step [askStepId] of [plan] is a secret: a later
+     * step puts that answer into a parameter the plan store never keeps.
+     */
+    fun answerIsASecret(plan: Plan, askStepId: String): Boolean {
+        val reference = "$" + askStepId
+        return plan.steps.any { step ->
+            val shown = PlanPrivacy.redactParams(step.action, step.params)
+            step.params.any { (name, value) -> value.contains(reference) && shown[name] != value }
+        }
+    }
+
+    /**
+     * Why a step failed, fit to show and to speak, or null when the step's error says
+     * nothing a person can use. Guidance the handler wrote for him is kept whole. A
+     * sentence a handler wrote is kept. Text from inside the machine (an exception, a
+     * missing parameter, a stack frame) is replaced by the plain reason it stands for
+     * where one is known, and left out otherwise. Keys and tokens never pass.
+     */
+    fun reason(error: String?): String? {
+        val text = error?.let(CrashLogRedactor::redact)?.replace(Regex("""\s+"""), " ")?.trim().orEmpty()
+        if (text.isEmpty()) return null
+        BOTH_TRIES.matchEntire(text)?.let { tries ->
+            return reason(tries.groupValues[1]) ?: reason(tries.groupValues[2])
+        }
+        PLAIN_REASONS.firstOrNull { (pattern, _) -> pattern.containsMatchIn(text) }?.let { return it.second }
+        // An exception is never shown, even when its text happens to hold a word like "check".
+        if (FROM_THE_MACHINE.containsMatchIn(text)) return null
+        if (isUserFacingStepError(text)) return short(text)
+        if (TECHNICAL.containsMatchIn(text)) return null
+        return short(text)
+    }
+
+    private fun short(text: String): String =
+        if (text.length > MAX_REASON_CHARS) text.take(MAX_REASON_CHARS).trimEnd() + "…" else text
+
+    /** The error the plan loop writes when a step and its fallback both failed. */
+    private val BOTH_TRIES = Regex("""Primary failed: (.*)\. Fallback failed: (.*)""")
+
+    /**
+     * Machine text that stands for a reason a person can use. Only an error that names
+     * its cause is given one. A bare IOException is not: it is thrown for a full disk
+     * and a missing file as well as for a dead network, so it says "failed" and no more.
+     */
+    private val PLAIN_REASONS: List<Pair<Regex, String>> = listOf(
+        Regex("""SecurityException|Permission Denial""") to "A permission is missing.",
+        Regex("""ActivityNotFound""") to "No app on the phone can do that.",
+        Regex("""UnknownHost|Unable to resolve host|ConnectException|NoRouteToHost|Network is unreachable""") to
+            "There was no connection.",
+        Regex("""SocketTimeout""") to "The connection timed out.",
+        Regex("""is not registered in ActionDispatcher""") to "The phone has no such action."
+    )
+
+    /** Marks of an exception or a stack frame. */
+    private val FROM_THE_MACHINE = Regex(
+        """Exception|Throwable|\b(?:java|javax|kotlin|kotlinx|android|androidx|com|org)\.[a-z]+\.|\bat [\w$.]+\(|""" +
+            """null object reference|0x[0-9a-fA-F]{2,}"""
+    )
+
+    /** Softer marks of text that was not written for a person: a missing parameter, a status code, a placeholder. */
+    private val TECHNICAL = Regex(
+        """\bnull\b|\bparam(?:eter)?s?\b|\berrno\b|[{}\[\]]|\bHTTP \d{3}\b|\bCode \d{3}\b|""" +
+            """Unknown (?:execution )?error|Execution failed""",
+        RegexOption.IGNORE_CASE
+    )
+
+    private fun isBlocked(error: String?): Boolean = error?.startsWith("Skipped: depends on failed step") == true
+
+    /** A handler's own result, or null when it reported nothing a person could read. */
+    private fun ownResult(result: String?): String? =
+        result?.trim()?.takeIf { it.length > 5 && !it.startsWith("{") && it != NO_OWN_RESULT }
+
+    private fun allSteps(plan: Plan): String = PlanApprovalSummary.stepLines(plan).joinToString(", ")
+
+    /** What a talk step said, however short: a one-word answer is still the planner's answer. */
+    private fun talkWords(result: String?): String? =
+        result?.trim()?.takeIf { it.isNotEmpty() && !it.startsWith("{") && it != NO_OWN_RESULT }
+
+    /** A step line as it reads after a label: "Send SMS to Mom" becomes "send SMS to Mom". */
+    private fun inSentence(line: String): String {
+        val first = line.takeWhile { !it.isWhitespace() }
+        val acronym = first.length > 1 && first.all { it.isUpperCase() || it.isDigit() }
+        return if (acronym) line else line.replaceFirstChar { it.lowercase() }
+    }
+}
