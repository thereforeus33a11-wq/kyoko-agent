+    private fun pumpUntil(what: String, condition: () -> Boolean) {
+        repeat(150) {
+            shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(100))
+            if (condition()) return
+            Thread.sleep(20)
+        }
+        throw AssertionError("Timed out waiting for: $what; stored = ${stored()}")
+    }
