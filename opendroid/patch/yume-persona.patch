+        val engine = engine()
+        store(talk)
+        server.enqueue(
+            MockResponse.Builder()
+                .code(200)
+                .setHeader("Content-Type", "application/json")
+                .body("""{"choices": [{"message": {"content": "NONE"}}], "usage": {"total_tokens": 7}}""")
