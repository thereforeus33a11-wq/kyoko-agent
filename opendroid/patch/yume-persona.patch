+     * Called in one place, [com.opendroid.ai.core.llm.WrappedLLMProvider], so that it holds
+     * for every provider, the local ones included.
+     */
+    fun stripReasoning(content: String): String {
+        val rest = dropOrphanedReasoning(content)
+        if (!rest.trimStart().startsWith("<")) return rest
+        // Inline reasoning always comes first. Only leading blocks go; a tag further in is
+        // part of the answer (plan text, XML, a sentence about the tag) and is left alone.
+        var answer = rest
