+package com.opendroid.ai.core.persona
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her whole library on the phone: every skill file that describes her, bundled with
+ * the app under `assets/persona/library`. It is read once, kept in memory and asked
+ * for the pages that fit a reply. A build without the files simply has an empty shelf
+ * and she runs on the card alone.
+ */
+@Singleton
+class PersonaLibrary @Inject constructor(
+    @ApplicationContext private val context: Context
+) {
+    @Volatile private var shelf: PersonaLibraryText.Shelf? = null
+
+    @Volatile private var under: String = ""
+
+    /**
+     * What her own files say lies under her awareness, as shipped with the app. Empty
+     * when the build has no such sections. The owner's own text, when he has saved one,
+     * takes its place (see [PersonaStore.underText]).
+     */
+    suspend fun bundledUnderText(): String {
+        shelf()
+        return under
+    }
+
+    /** Files on the shelf, for the settings screen. */
+    @Volatile var fileCount: Int = 0
+        private set
+
+    suspend fun shelf(): PersonaLibraryText.Shelf {
+        shelf?.let { return it }
+        return withContext(Dispatchers.IO) {
+            shelf ?: load().also { shelf = it }
+        }
+    }
+
+    /** The text put into her prompt for this moment, or an empty string. */
+    suspend fun excerpt(
+        cues: List<PersonaLibraryText.Cue>,
+        budgetChars: Int,
+        ownerName: String,
+        withPagesAboutOwner: Boolean = true
+    ): String {
+        if (budgetChars == 0) return ""
+        return PersonaLibraryText.render(shelf().select(cues, budgetChars, withPagesAboutOwner), ownerName)
+    }
+
+    private fun load(): PersonaLibraryText.Shelf {
+        val names = try {
+            context.assets.list(DIRECTORY).orEmpty().filter { it.endsWith(".md") }.sorted()
+        } catch (e: Exception) {
+            emptyList()
+        }
+        val index = PersonaLibraryText.parseIndex(readAsset(INDEX_FILE))
+        val texts = names.associate { name -> name.removeSuffix(".md") to readAsset("$DIRECTORY/$name") }
+        val pages = texts.flatMap { (file, raw) -> PersonaLibraryText.pages(file, raw, index) }
+        // Her core file first, then the rest in name order.
+        under = texts.entries
+            .sortedBy { (file, _) -> if (file == PersonaLibraryText.FILE_PREFIX) "" else file }
+            .map { (file, raw) -> PersonaLibraryText.underText(file, raw, index) }
+            .filter { it.isNotBlank() }
+            .joinToString("\n\n")
+        fileCount = names.size
+        if (names.isNotEmpty()) Log.i(TAG, "Library loaded: ${names.size} files, ${pages.size} pages")
+        return PersonaLibraryText.Shelf(pages)
+    }
+
+    private fun readAsset(path: String): String = try {
+        context.assets.open(path).bufferedReader().use { it.readText() }
+    } catch (e: Exception) {
+        ""
+    }
+
+    private companion object {
+        const val TAG = "PersonaLibrary"
+        const val DIRECTORY = "persona/library"
+        const val INDEX_FILE = "persona/library_index.txt"
+    }
+}
