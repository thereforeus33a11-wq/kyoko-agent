+    /** One of the app's rows as a line of her prompt: its age, what kind of row it is, its text. */
+    private fun appLine(message: ChatMessage, nowMillis: Long?): String {
+        val kind = when (message.modelBadge?.removeSuffix(PRIVATE_SUFFIX)) {
+            // A shortcut's announcement is written before anything has run.
+            ALIAS_BADGE -> STARTED_LABEL
+            QUESTION_BADGE -> QUESTION_LABEL
+            PLANNER_BADGE -> PLANNER_LABEL
+            else -> ""
+        }
+        val written = nowMillis?.let { "(" + age(it - message.timestamp) + ") " }.orEmpty()
+        return written + kind + appText(message.text)
+    }
