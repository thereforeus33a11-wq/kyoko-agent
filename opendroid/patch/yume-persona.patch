index 0000000..2fbbac1
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/ReferenceSheets.kt
@@ -0,0 +1,193 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * "Make her reference sheets": on his tap, reference pictures of her made from her originals
+ * and masters, front, back and side, each in two looks: a plain fitted base layer (simple
+ * fitted clothing, not nude, for the shape of her body) and her outfit as her files fix it.
+ *
+ * Each sheet is one edit of one of her originals or masters ([SourceImage]): the picture of
+ * that side, with what she wears changed and nothing else, and, where she has them, two more
+ * of her originals or masters for her face and look ([PicturePrompts.sheet]). So every sheet
+ * is one step from a picture that is no model's work, never a step from another made one.
+ *
+ * Every sheet that comes back goes through the age check before it is shown or kept, like any
+ * picture of her ([SelfPictureMaker.make]); one that does not pass is thrown away unseen and
+ * counted. A sheet that passes is kept as it came ([PersonaPictures.addSheet]) and is derived
+ * until he approves it; his approval makes it a master ([PictureSources.changed]). Nothing is
+ * made, and nothing sent, without his tap; without an original or a master of a side, that
+ * side is not made, and without any, nothing is.
+ *
+ * Everything but the requests themselves is decided here, so it can be read and tested
+ * without a phone.
+ */
+object ReferenceSheets {
+
+    /** The two looks a sheet is made in. */
+    enum class Look(val word: String) {
+        BASE_LAYER("plain fitted base layer"),
+        OUTFIT("her outfit")
+    }
+
+    /** The sides a sheet shows her from. One side view: her right where there is one, which is the side of her lip stud. */
+    enum class Side(val word: String) { FRONT("front"), BACK("back"), SIDE("side") }
+
+    /**
+     * One sheet to make: [look] from [side], made from [source] (one of her originals or
+     * masters of that side) and kept the same woman as [also] (more of them, for her face and
+     * look; at most two, as the edit takes three pictures).
+     */
+    class Sheet(val look: Look, val side: Side, val source: PersonaPicture, val also: List<PersonaPicture>) {
+        /** The caption it is kept with. */
+        val caption: String get() = "reference sheet, ${look.word}, ${side.word} view"
+
+        /** Which side of her it shows, as kept with it: the side its source shows, where that is known. */
+        val view: String get() = source.view.ifEmpty { "full body, ${side.word}" }
+    }
+
+    /** What a tap would make, or why it makes nothing. */
+    sealed class Planned {
+        /**
+         * [sheets] to make, in order; [missing] are the sides she has no original or master of;
+         * [outfitMissing] the sides whose only original or master is a sheet in the plain base
+         * layer, so that only the base layer is made of them ([plan]).
+         */
+        class Sheets(val sheets: List<Sheet>, val missing: List<Side>, val outfitMissing: List<Side> = emptyList()) : Planned()
+
+        class Nothing(val why: String) : Planned()
+    }
+
+    /** What he is told where she has no original or master of any side. */
+    const val NO_BASES_WHY =
+        "Nothing made: she has no original or master picture that shows her whole from the front, the back or the side. Sheets are only ever made from those."
+
+    private val FACE = Regex("""(?i)\b(?:face|close[ -]?up|portrait|headshot)\b""")
+    private val BACK = Regex("""(?i)\b(?:back|behind|rear)\b""")
+    private val THREE_QUARTER = Regex("""(?i)\bthree[ -]?quarter\b""")
+    private val SIDE = Regex("""(?i)\b(?:side|profile|left|right)\b""")
+    private val FRONT = Regex("""(?i)\b(?:front|full[ -]?body|plate|standing|whole)\b""")
+    private val RIGHT = Regex("""(?i)\bright\b""")
+
+    /**
+     * Which side of her [picture] shows her whole from, by the side kept with it, else by its
+     * caption; null for a face, a three-quarter view, or a picture that says neither.
+     */
+    fun sideOf(picture: PersonaPicture): Side? {
+        val words = picture.view.ifEmpty { picture.caption }
+        return when {
+            FACE.containsMatchIn(words) || THREE_QUARTER.containsMatchIn(words) -> null
+            BACK.containsMatchIn(words) -> Side.BACK
+            SIDE.containsMatchIn(words) -> Side.SIDE
+            FRONT.containsMatchIn(words) -> Side.FRONT
+            else -> null
+        }
+    }
+
+    /** Which pictures are nearest to no model's work: those that came with the app, then his, then approved sheets. */
+    private fun nearness(picture: PersonaPicture): Int = when (picture.origin) {
+        PersonaPicture.Origin.BUNDLED -> 0
+        PersonaPicture.Origin.ADDED -> 1
+        else -> 2
+    }
+
+    /** True for a sheet in the plain base layer: her, but not in her outfit, so never what a sheet in her outfit is made from. */
+    private fun inBaseLayer(picture: PersonaPicture): Boolean = picture.sheetLook == Look.BASE_LAYER.name
+
+    /**
+     * What a tap makes from [pictures]: for each side she has an original or a master of, one
+     * sheet in each look. Only the pictures an image model may work from are used
+     * ([PersonaSelfPictures.bases]: originals and masters that, by their captions, are her now
+     * and her alone), for the picture a sheet is made from as for the others. The picture a
+     * side is made from is the nearest to no model's work, her right side before her left, and
+     * the newest set that came with the app before an older one ([PersonaSelfPictures.newestBundledFirst]).
+     * A sheet in her outfit is never made from a sheet in the plain base layer, which has none
+     * of her outfit to keep. The pictures for her face and look are her best two other
+     * originals or masters ([PersonaSelfPictures.references]).
+     */
+    fun plan(pictures: List<PersonaPicture>): Planned {
+        val bases = PersonaSelfPictures.bases(pictures)
+        val order = compareBy<PersonaPicture>({ nearness(it) }, { if (sideOf(it) == Side.SIDE && !RIGHT.containsMatchIn(it.view.ifEmpty { it.caption })) 1 else 0 })
+            .then(PersonaSelfPictures.newestBundledFirst)
+        fun pick(look: Look, side: Side): PersonaPicture? =
+            bases.filter { sideOf(it) == side && (look != Look.OUTFIT || !inBaseLayer(it)) }.sortedWith(order).firstOrNull()
+        val picked = Look.entries.flatMap { look -> Side.entries.map { side -> (look to side) to pick(look, side) } }.toMap()
+        val sheets = Look.entries.flatMap { look ->
+            Side.entries.mapNotNull { side ->
+                val source = picked.getValue(look to side) ?: return@mapNotNull null
+                val also = PersonaSelfPictures.references(bases.filter { it.id != source.id }, max = PictureModels.MATCH_IMAGES - 1)
+                Sheet(look, side, source, also)
+            }
+        }
+        if (sheets.isEmpty()) return Planned.Nothing(NO_BASES_WHY)
+        val missing = Side.entries.filter { side -> Look.entries.all { look -> picked.getValue(look to side) == null } }
+        val outfitMissing = Side.entries.filter { side -> side !in missing && picked.getValue(Look.OUTFIT to side) == null }
+        return Planned.Sheets(sheets, missing, outfitMissing)
+    }
+
+    /** What [count] sheets cost on the edit model, before the age checks (a fraction of a cent each). */
+    fun cost(count: Int): Double = count * PictureModels.MATCH.price
+
+    /**
+     * The request for [sheet]: [source] (its source, an original or a master) first, then
+     * [also] (the others), on the edit model that takes several pictures at once. The shape
+     * is image 1's own.
+     */
+    fun call(sheet: Sheet, source: SourceImage, also: List<SourceImage>, age: Int = PersonaAge.AGE_IN_FILES): VeniceImages.Call {
+        val others = also.take(PictureModels.MATCH_IMAGES - 1)
+        val prompt = PicturePrompts.sheet(sheet.look, sheet.side, others.size, age)
+        return VeniceImages.multiEdit(PictureModels.MATCH, listOf(source.base64) + others.map { it.base64 }, prompt)
+    }
+
+    /** What he is told where there is not room for every sheet a tap would make. */
+    fun noRoom(room: Int, count: Int): String =
+        "Nothing made: this makes $count reference sheets and there is room for $room more reference pictures. Remove some in Her pictures first."
+
+    /** What he is told of the sides that are not made ([Planned.Sheets.missing]), and of those made in the base layer only ([Planned.Sheets.outfitMissing]). */
+    fun missingLine(missing: List<Side>, outfitMissing: List<Side> = emptyList()): String = listOfNotNull(
+        missing.takeIf { it.isNotEmpty() }?.let { "No sheet of her " + it.joinToString(" or ") { side -> side.word } + ": she has no original or master of that side." },
+        outfitMissing.takeIf { it.isNotEmpty() }?.let {
+            "No sheet of her " + it.joinToString(" or ") { side -> side.word } + " in her outfit: her only original or master of that side is a sheet in the plain base layer."
+        }
+    ).joinToString(" ")
+
+    /** [missingLine] for [planned]. */
+    fun missingLine(planned: Planned.Sheets): String = missingLine(planned.missing, planned.outfitMissing)
+}
+
+/**
+ * One tap of "Make her reference sheets" ([ReferenceSheets]): each sheet in turn, made by
+ * [maker] (the request, the age check, then kept by [keep] or thrown away), its pictures read
+ * by [source] (originals and masters only). His act: no call of it is counted as hers, and she
+ * is not asked to look at a sheet.
+ */
+class ReferenceSheetRun(
+    private val maker: SelfPictureMaker,
+    private val source: suspend (String) -> SourceImage?,
+    private val keep: suspend (bytes: ByteArray, caption: String, view: String, look: ReferenceSheets.Look) -> PersonaPictures.Added
+) {
+    /** What one sheet came to: kept (derived until he approves it), or why not. */
+    class Entry(val sheet: ReferenceSheets.Sheet, val kept: PersonaPicture?, val why: String)
+
+    /** Each of [sheets] in turn, [onEach] told as each is done. */
+    suspend fun run(sheets: List<ReferenceSheets.Sheet>, age: Int, onEach: suspend (Entry) -> Unit) {
+        for (sheet in sheets) {
+            val from = source(sheet.source.id)
+            if (from == null) {
+                onEach(Entry(sheet, null, NOT_READ))
+                continue
+            }
+            val also = sheet.also.mapNotNull { source(it.id) }
+            val plan = SelfPictureMaker.Plan(ReferenceSheets.call(sheet, from, also, age))
+            val made = maker.make(plan, sheet.caption, counted = false, keep = { bytes, caption -> keep(bytes, caption, sheet.view, sheet.look) })
+            onEach(
+                when (made) {
+                    is SelfPictureMaker.Outcome.Kept -> Entry(sheet, made.picture, "")
+                    is SelfPictureMaker.Outcome.NotKept -> Entry(sheet, null, made.why)
+                }
+            )
+        }
+    }
+
+    companion object {
+        const val NOT_READ = "Not made: the picture it starts from could not be read."
+    }
+}
