+    }
+
+    @Test
+    fun `gesture spans are told from emphasis by their first word`() {
+        assertTrue(SpeechTextNormalizer.isGesture("rolls eyes"))
+        assertTrue(SpeechTextNormalizer.isGesture("shrugs"))
+        assertTrue(SpeechTextNormalizer.isGesture("Leans back, smirking"))
+        assertFalse(SpeechTextNormalizer.isGesture("not"))
+        assertFalse(SpeechTextNormalizer.isGesture("never again"))
+        // A verb that opens a gesture is, alone, more likely a word she stressed.
+        assertFalse(SpeechTextNormalizer.isGesture("looks"))
+    }
+
+    @Test
+    fun `a custom lexicon replaces whole words`() {
+        val lexicon = mapOf("maji" to "mah jee")
+        assertEquals(
+            "mah jee? you win it?",
+            SpeechTextNormalizer.normalize("maji? you win it?", personaVoice = true, lexicon = lexicon)
+        )
+    }
