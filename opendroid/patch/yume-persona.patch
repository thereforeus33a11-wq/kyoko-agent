+        val render = plain.copyOfRange(0, 33) + chunk + plain.copyOfRange(33, plain.size)
+        val bundle = Bundled(manifest(Triple("full_front.png", "ORIGINAL", render)), mutableMapOf("full_front.png" to render))
+        val store = PersonaPictures(context, bundle)
