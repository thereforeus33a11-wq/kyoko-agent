+    @Test
+    fun `a step of her plan that waits for his answer ends the plan, whichever kind of question it is`() {
+        val registered = setOf("ASK_USER", "CONFIRM_ACTION", "PROMPT_USER_SELECTION")
+        val mapper = com.opendroid.ai.actions.ActionAutoMapper()
+        for (written in listOf(
+            "ASK_USER", "CONFIRM_ACTION", "PROMPT_USER_SELECTION", "CONFIRM", "ASK_CONFIRMATION",
+            "REQUEST_CONFIRMATION", "CONFIRM_USER", "PROMPT_USER", "GET_USER_INPUT", "ask user"
+        )) {
+            val runsAs = mapper.canonicalActionName(written, emptyMap(), registered)
+            assertTrue("$written runs as $runsAs", com.opendroid.ai.core.agent.waitsForOwnersAnswer(runsAs))
+        }
+        for (other in listOf("SEND_SMS", "DISPLAY_INFO", "CHAT", "WAIT", "OPEN_APP")) {
+            assertFalse(other, com.opendroid.ai.core.agent.waitsForOwnersAnswer(other))
+        }
+        // Every action that waits on the owner's next message is one of them. They all ask
+        // through the loop's askOwner, which stores the question and then waits.
+        val actions = File("src/main/java/com/opendroid/ai/actions").walkTopDown().filter { it.extension == "kt" }
+        val waiting = actions.flatMap { file ->
+            val source = file.readText()
+            Regex("""\.askOwner\(""").findAll(source).map { call ->
+                Regex("""override val name: String = "([A-Z_]+)"""").findAll(source.substring(0, call.range.first))
+                    .last().groupValues[1]
+            }
+        }.toSet()
+        assertEquals(registered, waiting)
+        for (name in waiting) assertTrue(name, com.opendroid.ai.core.agent.waitsForOwnersAnswer(name))
+    }
