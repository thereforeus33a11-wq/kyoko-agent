+    @Test
+    fun `what is said after a hand-over names the lines that are no notes and the notes that were cut`() {
+        val short = Note(Kind.ME, "soda", "melon soda is mine")
+        assertEquals("Added 1. They are in her notebook now.", notesStatusFor(1, listOf(short), emptyList()))
+        assertEquals("Nothing added. Each line has to read: kind | key | note", notesStatusFor(2, emptyList(), listOf("a", "b")))
+
+        // A note of 230 characters is added whole, so "added" is all there is to say about it.
+        val whole = PersonaNotes.read("user | story | " + "he told the swarm story again ".repeat(8))
+        assertTrue(whole.shortened.isEmpty())
+        assertEquals("Added 2. They are in her notebook now.", notesStatusFor(2, listOf(short) + whole.notes, emptyList(), whole.shortened.size))
+        // One that is too long even for that is cut: he is told, not left to think all of it is there.
+        val cut = PersonaNotes.read("user | story | " + "he told the swarm story again ".repeat(16))
+        assertEquals(1, cut.shortened.size)
+        assertEquals(
+            "Added 2. They are in her notebook now. 1 note was longer than 400 characters and was cut there; it is marked [cut].",
+            notesStatusFor(2, listOf(short) + cut.notes, emptyList(), cut.shortened.size)
+        )
+        val two = cut.notes + cut.notes.map { it.copy(key = "story-2") }
+        assertTrue(notesStatusFor(2, two, emptyList(), shortened = 2).endsWith("2 notes were longer than 400 characters and were cut there; they are marked [cut]."))
+        // "Marked", not "ends in": a thread keeps its status behind the mark.
+        assertTrue(cut.notes.single().text.endsWith("[cut]"))
+        assertTrue(PersonaNotes.read("thread | swarm | " + "he told the swarm story again ".repeat(16) + "| closed").shortened.single().text.endsWith("[cut] | closed"))
+        // A note that carries the mark of a cut made long ago is added as it is, and nothing is said about a cut.
+        assertEquals("Added 2. They are in her notebook now.", notesStatusFor(2, listOf(short) + cut.notes, emptyList()))
+
+        // Up to three lines are named, a long one in short.
+        val notRead = listOf("mood | x1 | not a kind", "just a sentence", "user | bees", "rel", "x".repeat(90))
+        assertEquals(
+            "Added 1 of 6 lines. The rest did not fit the form: \"mood | x1 | not a kind\"; \"just a sentence\"; \"user | bees\" and 2 more.",
+            notesStatusFor(6, listOf(short), notRead)
+        )
+        assertTrue(notesStatusFor(2, listOf(short), listOf("x".repeat(90))).contains("\"" + "x".repeat(60) + "...\"."))
+    }
