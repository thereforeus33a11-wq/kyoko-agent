+        try {
+            val sent = asSent(file.readBytes()) ?: return@withContext null
+            SourceImage.of(picture, Base64.encodeToString(sent, Base64.NO_WRAP))
+        } catch (e: Exception) {
+            Log.w(TAG, "A picture could not be read: ${e.javaClass.simpleName}")
+            null
+        } catch (e: OutOfMemoryError) {
+            Log.w(TAG, "A picture was too large to read")
+            null
+        }
+    }
+
+    /**
+     * [bytes], a picture of her as the store keeps it, as an image model is given it ([source]):
+     * where a request can carry it as it is, its own bytes without their metadata
+     * ([PictureMetadata.stripped]), and only where they are still the same size of picture;
+     * otherwise, or where its metadata cannot be taken out, a copy made from its pixels.
+     */
+    private fun asSent(bytes: ByteArray): ByteArray? {
+        val kind = EyesImage.kindOf(bytes)
+        val size = boundsOf(bytes)
+        if (PersonaPictureRules.sendableAsGiven(kind, bytes.size, size, orientationOf(bytes))) {
+            PictureMetadata.stripped(bytes)?.takeIf { boundsOf(it) == size }?.let { return it }
+        }
+        return if (kind == EyesImage.Kind.PNG) pngCopy(bytes, MAX_SOURCE_SIDE) else jpegCopy(bytes, MAX_SOURCE_SIDE, SOURCE_JPEG_QUALITY)
+    }
+
+    /** Picture [id] for the screen, decoded no larger than about [maxSide] on its longer side, upright. Null when it is gone. */
+    suspend fun bitmap(id: String, maxSide: Int = PersonaPictureRules.MAX_SIDE): Bitmap? = withContext(Dispatchers.IO) {
+        val (picture, file) = lock.withLock { entryOf(id) } ?: return@withContext null
+        // A picture kept as given may still carry a camera's note to turn it; the system decoder follows it.
+        if (picture.asGiven && Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            return@withContext try {
+                ImageDecoder.createSource(ByteBuffer.wrap(file.readBytes())).decodeBitmap { info, _ ->
+                    allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+                    setTargetSampleSize(PersonaPictureRules.sampleSize(info.size.width, info.size.height, maxSide))
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "A picture could not be shown: ${e.javaClass.simpleName}")
+                null
+            } catch (e: OutOfMemoryError) {
+                Log.w(TAG, "A picture was too large to show")
+                null
+            }
+        }
+        try {
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            BitmapFactory.decodeFile(file.path, bounds)
+            val options = BitmapFactory.Options().apply {
+                inSampleSize = PersonaPictureRules.sampleSize(bounds.outWidth, bounds.outHeight, maxSide)
+            }
+            BitmapFactory.decodeFile(file.path, options)
+        } catch (e: Exception) {
+            Log.w(TAG, "A picture could not be shown: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    /** A small version of picture [id] for a list. */
+    suspend fun thumbnail(id: String): Bitmap? = bitmap(id, THUMBNAIL_SIDE)
+
+    /**
+     * How many pictures she has been shown in turn so far. Which picture is next is worked
+     * out from it. It is kept in the index, so the next picture is another one after a
+     * restart too.
+     */
+    suspend fun turn(): Int = withContext(Dispatchers.IO) {
+        lock.withLock { index().turn }
+    }
+
+    /** Counts one more picture shown in turn. */
+    suspend fun turnTaken() = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val index = index()
+            save(index.copy(turn = if (index.turn == Int.MAX_VALUE) 0 else index.turn + 1))
+        }
+    }
+
+    private fun fileOf(id: String): File? = entryOf(id)?.second
+
+    /** Picture [id] as the index holds it now, and its file, where both are there. */
+    private fun entryOf(id: String): Pair<PersonaPicture, File>? =
+        index().pictures.firstOrNull { it.id == id }?.let { picture -> File(directory, picture.file).takeIf { it.isFile }?.let { picture to it } }
+
+    /**
+     * The index as it stands. Read from the file once; an entry whose picture file is gone is
+     * left out. On the first read the pictures that come with this build are put in, those the
+     * phone was never given ([seedBundled]).
+     */
+    private fun index(): PersonaPictureRules.Index {
+        loaded?.let { return it }
+        val read = try {
+            indexFile.takeIf { it.isFile }?.readText()?.let(PersonaPictureRules::parseIndex)
+        } catch (e: Exception) {
+            Log.w(TAG, "The picture index could not be read: ${e.javaClass.simpleName}")
+            null
+        } ?: PersonaPictureRules.Index()
+        val present = read.copy(pictures = read.pictures.filter { File(directory, it.file).isFile })
+        loaded = present
+        current.value = present.pictures
+        unlistedCount.value = unlistedFiles(present).size
+        if (!bundleRead) {
+            bundleRead = true
+            return seedBundled(present)
+        }
+        return present
+    }
+
+    /**
+     * The pictures of her that come with this build ([HerRefs]) put into [index], those it was
+     * never given, each as it is in the app with its SHA-256 checked, and [index] as it is then.
+     * Nothing is put in twice, nothing he removed comes back, and nothing he changed is set back.
+     * Once this build's set is on the phone, a picture of an earlier set that its list no longer
+     * names is retired, derived ([HerRefs.retired]). A build that carries no list puts nothing
+     * in and changes nothing.
+     */
+    private fun seedBundled(index: PersonaPictureRules.Index): PersonaPictureRules.Index {
+        val entries = try {
+            HerRefs.parse(bundle.manifest())
+        } catch (e: Exception) {
+            Log.w(TAG, "The list of her bundled pictures could not be read: ${e.javaClass.simpleName}")
+            emptyList()
+        }
+        if (entries.isEmpty()) return index
+        val seeding = HerRefs.seeding(index, entries)
+        val added = ArrayList<PersonaPicture>()
+        val dealt = ArrayList<String>(seeding.known)
+        val now = System.currentTimeMillis()
+        for ((n, entry) in seeding.add.withIndex()) {
+            val bytes = try {
+                bundle.open(entry.file)
+            } catch (e: Exception) {
+                null
+            } ?: continue
+            // Bytes that are not the ones the list names are not put in; a later build can bring them.
+            if (sha256(bytes) != entry.sha256) {
+                Log.w(TAG, "A bundled picture does not match its hash and was left out")
+                continue
+            }
+            val ending = endingOf(bytes)?.takeIf { it == "png" || it == "jpg" || it == "webp" } ?: continue
+            val id = UUID.randomUUID().toString()
+            val file = "$id.$ending"
+            if (!writeAsGiven(file, bytes)) continue
+            // In the order the list gives them.
+            added += HerRefs.picture(entry, id, file, now + n)
+            dealt += entry.sha256
+        }
+        val seeded = if (dealt.isEmpty()) index else PersonaPictureRules.withSeeded(index, added, dealt)
+        val after = HerRefs.retired(seeded, entries)
+        if (after == index) return index
+        save(after)
+        return after
+    }
+
+    /** Writes [bytes] as they are to [name] in the folder, beside it first and then moved, so that a cut-short write leaves nothing. */
+    private fun writeAsGiven(name: String, bytes: ByteArray): Boolean {
+        val file = File(directory, name)
+        val draft = File(directory, "$name.tmp")
+        return try {
+            directory.mkdirs()
+            draft.writeBytes(bytes)
+            if (!draft.renameTo(file)) {
+                file.writeBytes(bytes)
+                draft.delete()
+            }
+            true
+        } catch (e: Exception) {
+            Log.w(TAG, "A picture could not be stored: ${e.javaClass.simpleName}")
+            draft.delete()
+            file.delete()
+            false
+        }
+    }
+
+    /** The ending a picture's file gets by what its first bytes say it is; null for bytes that are no picture the phone can read. */
+    private fun endingOf(bytes: ByteArray): String? {
+        val ending = when (EyesImage.kindOf(bytes)) {
+            EyesImage.Kind.PNG -> "png"
+            EyesImage.Kind.JPEG -> "jpg"
+            EyesImage.Kind.WEBP -> "webp"
+            EyesImage.Kind.HEIF -> "heic"
+            EyesImage.Kind.GIF -> "gif"
+            EyesImage.Kind.BMP -> "bmp"
+            else -> null
+        } ?: return null
+        val (width, height) = boundsOf(bytes)
+        return ending.takeIf { width > 0 && height > 0 }
+    }
+
+    /** The size of the picture in [bytes] without decoding it (the system's decoder reads HEIF from Android 9), or 0 by 0. */
+    private fun boundsOf(bytes: ByteArray): Pair<Int, Int> {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        return if (bounds.outWidth > 0 && bounds.outHeight > 0) bounds.outWidth to bounds.outHeight else 0 to 0
+    }
+
+    /** The camera's note of how the picture in [bytes] is to be turned (an EXIF orientation), or normal where there is none. */
+    private fun orientationOf(bytes: ByteArray): Int = try {
+        android.media.ExifInterface(java.io.ByteArrayInputStream(bytes))
+            .getAttributeInt(android.media.ExifInterface.TAG_ORIENTATION, android.media.ExifInterface.ORIENTATION_NORMAL)
+    } catch (e: Exception) {
+        android.media.ExifInterface.ORIENTATION_NORMAL
+    }
+
+    /** A JPEG of the picture in [bytes], upright, on white, no larger than [maxSide]: made in memory, for sending. */
+    private fun jpegCopy(bytes: ByteArray, maxSide: Int, quality: Int): ByteArray? {
+        val bitmap = decodeUprightScaled(bytes, maxSide)?.let(::onWhite) ?: return null
+        return try {
+            ByteArrayOutputStream().use { out ->
+                if (!bitmap.compress(Bitmap.CompressFormat.JPEG, quality, out)) null else out.toByteArray()
+            }
+        } finally {
+            bitmap.recycle()
+        }
+    }
+
+    /** A PNG of the picture in [bytes], upright, no larger than [maxSide]: made in memory, for sending. */
+    private fun pngCopy(bytes: ByteArray, maxSide: Int): ByteArray? {
+        val bitmap = decodeUprightScaled(bytes, maxSide) ?: return null
+        return try {
+            ByteArrayOutputStream().use { out ->
+                if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, out)) null else out.toByteArray()
+            }
+        } finally {
+            bitmap.recycle()
+        }
+    }
+
+    /** The picture in [bytes], upright where the phone can turn it, no larger than [maxSide] on its longer side. */
+    private fun decodeUprightScaled(bytes: ByteArray, maxSide: Int): Bitmap? {
+        val decoded = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            ImageDecoder.createSource(ByteBuffer.wrap(bytes)).decodeBitmap { info, _ ->
+                allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+                setTargetSampleSize(PersonaPictureRules.sampleSize(info.size.width, info.size.height, maxSide))
+            }
+        } else {
+            val (width, height) = boundsOf(bytes)
+            if (width <= 0 || height <= 0) return null
+            val options = BitmapFactory.Options().apply { inSampleSize = PersonaPictureRules.sampleSize(width, height, maxSide) }
+            BitmapFactory.decodeByteArray(bytes, 0, bytes.size, options)
+        } ?: return null
+        val (width, height) = PersonaPictureRules.scaledSize(decoded.width, decoded.height, maxSide)
+        if (width == decoded.width && height == decoded.height) return decoded
+        return replacing(decoded, decoded.scale(width, height))
+    }
+
+    private fun sha256(bytes: ByteArray): String =
+        java.security.MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+    /**
+     * Writes [index] and deletes the picture files it has stopped naming, so that a
+     * removed or replaced picture is gone from the phone.
+     *
+     * Only those files. One that the index as it was read does not name (its entry
+     * could not be read, or the whole index could not) is not deleted here: an ordinary
+     * change, or a reply of hers that counts a turn, must never cost a picture nobody
+     * asked to remove. Such a file stays and is counted in [unlisted].
+     */
+    private fun save(index: PersonaPictureRules.Index) {
+        val named = index.pictures.map { it.file }.toSet()
+        val dropped = loaded?.pictures.orEmpty().map { it.file }.filterNot { it in named }
+        // What the app works with changes first: a phone that cannot write just now
+        // must not cost her a reply, and the next change writes the whole index again.
+        loaded = index
+        current.value = index.pictures
+        val draft = File(directory, "$INDEX_FILE.tmp")
+        try {
+            directory.mkdirs()
+            // Written beside the index and moved over it, so a write that is cut short leaves the old one.
+            draft.writeText(PersonaPictureRules.encodeIndex(index))
+            if (!draft.renameTo(indexFile)) {
+                indexFile.writeText(PersonaPictureRules.encodeIndex(index))
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "The picture index could not be written: ${e.javaClass.simpleName}")
+        }
+        try {
+            // Whether or not the index could be written: he asked for these to be gone.
+            dropped.forEach { File(directory, it).delete() }
+            draft.delete()
+            unlistedCount.value = unlistedFiles(index).size
+        } catch (e: Exception) {
+            Log.w(TAG, "A removed picture could not be deleted: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /** The picture files in the folder that [index] does not name. Nothing but files this store could have written. */
+    private fun unlistedFiles(index: PersonaPictureRules.Index): List<File> {
+        val named = index.pictures.map { it.file }.toSet()
+        return directory.listFiles().orEmpty().filter {
+            it.isFile && it.name !in named && PersonaPictureRules.isPictureFileName(it.name)
+        }
+    }
+
+    /**
+     * The image behind [uri], upright and no larger than [PersonaPictureRules.MAX_SIDE]
+     * on its longer side, or null when it cannot be read as an image. A transparent
+     * picture is put on white: JPEG has no transparency and would turn it black.
+     */
+    /** [bytes] as a picture the way the store keeps one, or null when they are not an image. */
+    private fun decodeBytes(bytes: ByteArray): Bitmap? = try {
+        val decoded = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) decodeUpright(bytes) else decodeAsStored(bytes)
+        decoded?.let(::scaledDown)?.let(::onWhite)
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun decodeScaled(uri: Uri): Bitmap? = try {
+        val bytes = readSource(uri)
+        val decoded = when {
+            bytes == null -> null
+            Build.VERSION.SDK_INT >= Build.VERSION_CODES.P -> decodeUpright(bytes)
+            else -> decodeAsStored(bytes)
+        }
+        decoded?.let(::scaledDown)?.let(::onWhite)
+    } catch (e: Exception) {
+        Log.w(TAG, "A picture could not be decoded: ${e.javaClass.simpleName}")
+        null
+    } catch (e: OutOfMemoryError) {
+        Log.w(TAG, "A picture was too large to decode")
+        null
+    }
+
+    /**
+     * The file behind [uri], read once while the picker's permission for it holds. Null
+     * when it cannot be opened or is larger than any photo is ([MAX_SOURCE_BYTES]).
+     */
+    private fun readSource(uri: Uri): ByteArray? =
+        context.contentResolver.openInputStream(uri)?.use { input ->
+            val bytes = ByteArrayOutputStream()
+            val buffer = ByteArray(64 * 1024)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                if (bytes.size() + read > MAX_SOURCE_BYTES) return null
+                bytes.write(buffer, 0, read)
+            }
+            bytes.toByteArray()
+        }
+
+    /**
+     * Decodes with the system's image decoder, which turns a photo the way its camera
+     * says it was held. A background picture is often a photographed page, and a page
+     * lying on its side cannot be read into text.
+     */
+    @RequiresApi(Build.VERSION_CODES.P)
+    private fun decodeUpright(bytes: ByteArray): Bitmap =
+        ImageDecoder.createSource(ByteBuffer.wrap(bytes)).decodeBitmap { info, _ ->
+            // In ordinary memory: the picture is scaled and compressed here, which a
+            // bitmap that lives on the graphics chip cannot be.
+            allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+            setTargetSampleSize(PersonaPictureRules.sampleSize(info.size.width, info.size.height))
+        }
+
+    /** The decoder of older phones (Android 8). It takes the picture as it is stored and does not turn it. */
+    internal fun decodeAsStored(bytes: ByteArray): Bitmap? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        val options = BitmapFactory.Options().apply {
+            inSampleSize = PersonaPictureRules.sampleSize(bounds.outWidth, bounds.outHeight)
+        }
+        return BitmapFactory.decodeByteArray(bytes, 0, bytes.size, options)
+    }
+
+    private fun scaledDown(bitmap: Bitmap): Bitmap {
+        val (width, height) = PersonaPictureRules.scaledSize(bitmap.width, bitmap.height)
+        if (width == bitmap.width && height == bitmap.height) return bitmap
+        return replacing(bitmap, bitmap.scale(width, height))
+    }
+
+    private fun onWhite(bitmap: Bitmap): Bitmap {
+        if (!bitmap.hasAlpha()) return bitmap
+        val flat = createBitmap(bitmap.width, bitmap.height).applyCanvas {
+            drawColor(Color.WHITE)
+            drawBitmap(bitmap, 0f, 0f, null)
+        }
+        return replacing(bitmap, flat)
+    }
+
+    /** [next] in place of [previous], whose memory is given back unless the two are the same bitmap. */
+    private fun replacing(previous: Bitmap, next: Bitmap): Bitmap {
+        if (next !== previous) previous.recycle()
+        return next
+    }
+
+    private companion object {
+        const val TAG = "PersonaPictures"
+        const val PERSONA_DIRECTORY = "persona"
+        const val PICTURES_DIRECTORY = "pictures"
+        const val INDEX_FILE = "index.json"
+        const val THUMBNAIL_SIDE = 320
+
+        /** No photo a phone takes is this large; a file that is cannot be a picture to keep. */
+        const val MAX_SOURCE_BYTES = 64 * 1024 * 1024
+
+        /**
+         * The longer side of a picture an image model is given to work from ([source]): her
+         * reference renders are 2048 high, and an image request takes a picture of that size.
+         */
+        const val MAX_SOURCE_SIDE = PersonaPictureRules.MAX_SOURCE_SIDE
+
+        /** The quality of a JPEG copy made for an image model to work from, where the file itself cannot go. */
+        const val SOURCE_JPEG_QUALITY = 95
+    }
+}
