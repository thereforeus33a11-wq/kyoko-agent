+            ollamaUrl = "https://ollama.example.com"
+        )
+        assertEquals(listOf("OpenAI", "Ollama"), ProviderSelectionPolicy.keepingRoutePrivate(plain, listOf("OpenAI", "Ollama")))
+        val encrypted = routes(custom).copy(ollamaUrl = "https://ollama.example.com")
+        assertEquals(emptyList<String>(), ProviderSelectionPolicy.keepingRoutePrivate(encrypted, listOf("OpenAI", "Ollama")))
