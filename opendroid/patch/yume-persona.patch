+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaActions.kt
@@ -0,0 +1,60 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * The one way the persona can act on the phone herself: the last line of a reply may
+ * be `>> <plain command>`. The app takes that line out of what is shown and spoken and
+ * hands the command to the normal planner, where it meets the same approval settings
+ * as one of the owner's commands.
+ *
+ * What she may do this way is a short, fixed list of on-device actions. Nothing that
+ * contacts another person, spends money, deletes, reads his messages or files, sends
+ * free text to the network, or drives another app's screen is on it, so neither a
+ * whim of hers nor text someone else slipped into her prompt can reach beyond the phone.
+ */
+object PersonaActions {
+
+    const val MARKER = ">>"
+
+    /** Canonical action names she may run. Everything else is dropped. */
+    val ALLOWED: Set<String> = setOf(
+        "OPEN_APP", "TOGGLE_FLASHLIGHT", "TOGGLE_DND", "SET_BRIGHTNESS", "SET_VOLUME",
+        "SET_RINGER_MODE", "LOCK_SCREEN", "TAKE_SCREENSHOT", "GET_SYSTEM_INFO",
+        "SET_ALARM", "SET_TIMER",
+        "PLAY_MUSIC", "PAUSE_MUSIC", "NEXT_TRACK", "PREV_TRACK", "SET_VOLUME_MUSIC", "PLAY_YOUTUBE",
+        "CALCULATE"
+    )
+
+    private const val MIN_COMMAND_CHARS = 3
+    private const val MAX_COMMAND_CHARS = 160
+
+    data class Split(val text: String, val command: String?)
+
+    /**
+     * Separates what she says from what she wants done. Only a `>>` line that is the
+     * last line counts as a command; any other `>>` line is simply removed, so a
+     * marker in the middle of a reply can never be shown, spoken or run.
+     */
+    fun split(reply: String): Split {
+        val lines = reply.lines()
+        val lastContent = lines.indexOfLast { it.isNotBlank() }
+        if (lastContent < 0) return Split("", null)
+        var command: String? = null
+        val kept = ArrayList<String>(lines.size)
+        for ((index, line) in lines.withIndex()) {
+            val trimmed = line.trim()
+            if (!trimmed.startsWith(MARKER)) {
+                kept += line
+                continue
+            }
+            if (index == lastContent) {
+                command = trimmed.removePrefix(MARKER).trim().trim('`', '"').trim()
+                    .takeIf { it.length in MIN_COMMAND_CHARS..MAX_COMMAND_CHARS && it.any(Char::isLetter) }
+            }
+        }
+        return Split(kept.joinToString("\n").trim(), command)
+    }
+
+    /** True only when there is at least one action and every one of them is on the list. */
+    fun allAllowed(canonicalActions: Collection<String>): Boolean =
+        canonicalActions.isNotEmpty() && canonicalActions.all { it in ALLOWED }
+}
