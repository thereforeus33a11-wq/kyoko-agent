+            on = true, wake = PersonaOwnTime.Wake.At(now + 40 * minute), why = PersonaOwnTime.Why.ASKED,
+            moments = listOf(now - 5 * hour, now - 20 * minute), lastAtMillis = now - 20 * minute, lastDid = PersonaOwnTime.Did.SAID
+        )
+        assertEquals(
+            listOf(
+                "Last moment: 17 Nov, 21:50 (20 min ago). She wrote to you.",
+                "Moments in the last 24 hours: 2.",
+                "Next moment: about 17 Nov, 22:50 (in 40 min)."
+            ),
+            lines(said)
+        )
+        assertTrue(lines(said.copy(lastDid = PersonaOwnTime.Did.KEPT))[0].endsWith("She kept it to herself."))
+        assertTrue(lines(said.copy(lastDid = PersonaOwnTime.Did.PASSED))[0].endsWith("She let it pass."))
+        // A moment older than a day is not counted among the day's.
+        assertEquals("Moments in the last 24 hours: 1.", lines(said.copy(moments = listOf(now - 25 * hour, now - 20 * minute)))[1])
+        // The next one, however it stands.
+        assertEquals("Next moment: due now. It comes when the phone gets to it.", lines(said.copy(wake = PersonaOwnTime.Wake.At(now - minute)))[2])
+        assertEquals(
+            "Next moment: the usual gap after her reply to your next message. She asked to wait for you.",
+            lines(said.copy(wake = PersonaOwnTime.Wake.WhenHeWrites))[2]
+        )
+        assertEquals(
+            "Next moment: none set yet. The first comes 20 min after her first reply.",
+            lines(PersonaOwnTime.State(on = true))[2]
+        )
+        assertEquals("She has had no moment of her own yet.", lines(PersonaOwnTime.State(on = true))[0])
+        // Off, nothing is said to be due.
+        val off = lines(said.copy(on = false))
+        assertEquals(3, off.size)
+        assertTrue(off[2].startsWith("Her own time is not running now"))
+        assertFalse(off.any { it.startsWith("Next moment") })
+    }
+
+    @Test
+    fun `the own-time card tells a failed attempt from a quiet moment, and says until when she sleeps`() {
+        val awake = PersonaOwnTime.State(
+            on = true, wake = PersonaOwnTime.Wake.At(now + 15 * minute), lastAtMillis = now - 3 * hour, lastDid = PersonaOwnTime.Did.KEPT
+        )
+        assertFalse(lines(awake).any { it.contains("did not come about") })
+        assertEquals("The last attempt did not come about. The app tries again later.", lines(awake.copy(failures = 1)).last())
+        assertEquals(
+            "The last 3 attempts in a row did not come about. Each new try waits longer, up to 6 h.",
+            lines(awake.copy(failures = 3)).last()
+        )
+        // Asleep: until when, and no moment is said to be due in between.
+        val asleep = awake.copy(asleepSince = now - hour, sleepUntil = now + 6 * hour, wake = PersonaOwnTime.Wake.At(now + 2 * hour))
+        val night = lines(asleep)
+        assertTrue(night.contains("Asleep until 18 Nov, 04:10 (in 6 h). No moment comes while she sleeps; your message wakes her."))
+        assertFalse(night.any { it.startsWith("Next moment") })
+        // Past the time she meant to wake, and not yet woken.
+        assertTrue(lines(asleep, at = now + 6 * hour + 5 * minute).contains("Asleep: she meant to wake at 18 Nov, 04:10 (5 min ago) and wakes when the phone gets to it."))
+    }
+
+    @Test
+    fun `the own-time card shows nothing she wrote, and the screen reads it off what is stored`() {
+        // What she asked for in her own words is in what is stored. None of it reaches the card.
+        val state = PersonaOwnTime.State(
+            on = true, wake = PersonaOwnTime.Wake.At(now + hour), lastAtMillis = now - hour, lastDid = PersonaOwnTime.Did.SAID,
+            moved = PersonaOwnTime.Moved.NOT_READ, movedAsked = "whenever the neon dies", sleepAsked = "till the trains run"
+        )
+        for (line in lines(state)) {
+            assertFalse(line, line.contains("neon"))
+            assertFalse(line, line.contains("trains"))
+        }
+        // The function is given the stored state and nothing else: no note, no thought, no chat row.
+        val source = File("src/main/java/com/opendroid/ai/ui/viewmodel/PersonaViewModel.kt").readText()
+        val body = source.substringAfter("internal fun ownTimeStatusLines(").substringBefore("internal fun thoughtsCountLine(")
+            .replace(Regex("""(?s)/\*.*?\*/"""), "").replace(Regex("""//.*"""), "")
+        for (never in listOf("Thought", "thoughts", "notes", "Note", "movedAsked", "sleepAsked", "ChatMessage")) {
+            assertFalse(never, body.contains(never))
+        }
+
+        // The model reads it from her memory and shows it.
+        runBlocking { memory.saveOwnTime(state) }
+        val model = viewModel(store("You are Yume.\n"))
+        model.loadOwnTimeStatus(nowMillis = { now })
+        await("her own time to be read") { model.ownTimeLines.isNotEmpty() }
+        assertEquals(ownTimeStatusLines(state, now), model.ownTimeLines)
+    }
+
+    // ── Her own life, in counts, times and places ────────────────────────────────────
+
+    private fun lifeLines(at: Long = now): List<String> = runBlocking {
+        ownLifeStatusLines(ownLife.read(at), com.opendroid.ai.core.persona.PersonaOwnTime.isOn(lifeConfig), at)
+    }
+
+    /** A day of hers: calls of every kind, an outing with titles and search words, what she does now, two wonders. */
+    private fun herDay(sentinel: String) = runBlocking {
+        val purposes = List(16) { com.opendroid.ai.core.life.OwnPurpose.MOMENT } +
+            List(19) { com.opendroid.ai.core.life.OwnPurpose.OUTING_STEP } +
+            List(6) { com.opendroid.ai.core.life.OwnPurpose.OWN_COMMAND } +
+            List(2) { com.opendroid.ai.core.life.OwnPurpose.NOTEBOOK } +
+            listOf(com.opendroid.ai.core.life.OwnPurpose.SLEEP_PASS)
+        purposes.forEach { ledger.record(it, "e2ee-her-model", 14_000, 600, ok = true) }
+        repeat(12) { ledger.count(com.opendroid.ai.core.life.OwnPurpose.FETCH) }
+        val id = herLog.start(com.opendroid.ai.core.life.HerLog.Kind.READ, "ja.wikipedia.org")
+        val tally = com.opendroid.ai.core.life.HerLog.Tally().apply {
+            searched("$sentinel search")
+            opened("$sentinel title", "ja.wikipedia.org")
+            called()
+        }
+        herLog.end(id, com.opendroid.ai.core.life.HerLog.EndedBy.DONE, tally)
+        herLog.end(herLog.start(com.opendroid.ai.core.life.HerLog.Kind.NEWS, "news.yahoo.co.jp"), com.opendroid.ai.core.life.HerLog.EndedBy.TIME)
+        herLog.command(">> $sentinel command", "a plan was made", 2)
+        wonders.apply(
+            listOf(
+                com.opendroid.ai.core.life.Wonders.Line.Add("$sentinel why do trains hum"),
+                com.opendroid.ai.core.life.Wonders.Line.Add("$sentinel what is egg magazine now")
+            ),
+            now - hour
+        )
+        herNow.doing(com.opendroid.ai.core.life.HerLog.Kind.READ, "ja.wikipedia.org", now - 3 * minute, herWords = "$sentinel her words")
+    }
+
+    @Test
+    fun `the own-life card says his calls by purpose with a price, what she does now, her outings and how many wonders, and nothing she wrote`() {
+        herDay("SENTINEL")
+        val lines = lifeLines()
+        assertEquals(
+            listOf(
+                "Calls on her own: 41 of 150 in the last 24 h (moments 16, outings 19, commands 6). About $0.27.",
+                "Upkeep, not held against his number but in the price above: sleep pass 1, notebook 2.",
+                "Pages and feeds fetched for her in 24 h: 12.",
+                "Now: reading (3 min).",
+                "Outings in 24 h: 2 (reading 1, news 1).",
+                "Open wonders: 2."
+            ),
+            lines
+        )
+        // Her titles, her search words, her command, her wonders and her go: words are not in any line.
+        for (line in lines) assertFalse(line, line.contains("SENTINEL"))
+        // Paused while he talks, and nothing at all.
+        herNow.paused(true)
+        assertTrue(lifeLines().contains("Now: reading (3 min, paused)."))
+        herNow.nothing()
+        assertTrue(lifeLines().contains("Now: nothing."))
+        // Older than a day, an outing is not among the day's.
+        assertTrue(lifeLines(at = now + 25 * hour).contains("Outings in 24 h: none."))
+    }
+
+    @Test
+    fun `switched off, the card says so and holds her moments to no number of his, and an unreadable ledger is said to stop outings`() {
+        runBlocking { repeat(3) { ledger.record(com.opendroid.ai.core.life.OwnPurpose.MOMENT, "e2ee-her-model", null, null, ok = true) } }
+        lifeConfig = lifeConfig.copy(personaOwnLife = false)
+        val off = lifeLines()
+        assertTrue(off.first(), off.first().startsWith("Her own life is switched off"))
+        assertTrue(off.any { it.startsWith("Calls on her own: 3 in the last 24 h (moments 3).") })
+        assertFalse(off.any { it.contains(" of 150") })
+
+        // On, with her own time off: none of it runs, and the card says so.
+        lifeConfig = lifeConfig.copy(personaOwnLife = true, personaCheckInsEnabled = false)
+        assertEquals("Her own life is switched on, but her own time is off, so none of it runs.", lifeLines().first())
+
+        // A ledger that cannot be read: no outing starts, and the card says that instead of a count.
+        lifeConfig = lifeConfig.copy(personaCheckInsEnabled = true)
+        File(directory, "own_ledger.json").writeText("not a ledger")
+        val unreadable = ownLifeStatusLines(
+            runBlocking {
+                com.opendroid.ai.core.life.OwnLifeStatus(
+                    { lifeConfig },
+                    com.opendroid.ai.core.life.OwnLedger({ File(directory, "own_ledger.json") }, { now }),
+                    herLog, herNow, wonders
+                ).read(now)
+            },
+            ownTimeOn = true,
+            nowMillis = now
+        )
+        assertEquals("Calls on her own: the count cannot be read, so no outing starts.", unreadable.first())
+    }
+
+    @Test
+    fun `the card screen reads her own life through the model, and the lines are built from counts alone`() {
+        herDay("SENTINEL")
+        val model = viewModel(store("You are Yume.\n"))
+        model.loadOwnLifeStatus(nowMillis = { now })
+        await("her own life to be read") { model.ownLifeLines.isNotEmpty() }
+        assertEquals(lifeLines(), model.ownLifeLines)
+        // The function is given the snapshot of counts and nothing of what she wrote.
+        val source = File("src/main/java/com/opendroid/ai/ui/viewmodel/PersonaViewModel.kt").readText()
+        val body = source.substringAfter("internal fun ownLifeStatusLines(").substringBefore("@HiltViewModel")
+            .replace(Regex("""(?s)/\*.*?\*/"""), "").replace(Regex("""//.*"""), "")
+        for (never in listOf("inHerWords", ".what", ".text", "Thought", "notes", "wonders.open")) {
+            assertFalse(never, body.contains(never))
+        }
+        // And the card screen shows them under their own heading, with the way to "Her day".
+        val screen = File("src/main/java/com/opendroid/ai/ui/screens/PersonaCardScreen.kt").readText()
+        assertTrue(screen.contains("viewModel.loadOwnLifeStatus()"))
+        assertTrue(screen.contains("viewModel.ownLifeLines.forEach"))
+        assertTrue(screen.contains("onClick = onOpenHerDay"))
+    }
+}
