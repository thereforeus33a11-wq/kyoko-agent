index 0000000..80d0e9f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/own/MixedSegmentationTest.kt
@@ -0,0 +1,177 @@
+package com.opendroid.ai.core.voice.own
+
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.mixed
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * How a line of hers is cut before it is read: into sentences, then into English and
+ * Japanese segments, and what each Japanese segment hands Open JTalk. Each expectation
+ * here is what the training side's mix_phonemize.py gives for the same text (its plan
+ * and _ja_text), for the edges of the rules: numbers and units, currency, times,
+ * katakana English, romaji, mixed sentences and punctuation.
+ *
+ * A plan is written "en:<text> | ja:<text>=<what Open JTalk gets>" per sentence, a "," after
+ * a segment that has a clause mark before it, then the sentence's end mark; "verbatim" is
+ * a pure Japanese sentence handed to Open JTalk whole.
+ */
+class MixedSegmentationTest {
+
+    private fun plan(text: String): List<String> = mixed.plan(text).map { p ->
+        if (p.verbatim) return@map "verbatim"
+        p.segments.withIndex().joinToString(" | ") { (k, g) ->
+            val seg = p.text.substring(g.toks.first().start, g.toks.last().end)
+            val ja = if (g.route == Lang.JA) "=" + mixed.japaneseText(p, g, last = k == p.segments.size - 1) else ""
+            "${g.route.code}:$seg$ja" + if (p.pauses[k]) "," else ""
+        } + " end=${p.terminal}"
+    }
+
+    /** Phonemes for a line whose Japanese pieces, if any, Open JTalk cannot read. */
+    private fun english(text: String): String? =
+        mixed.phonemize(text) { null }?.joinToString(" / ") { it.joinToString("") }
+
+    @Test
+    fun `sentences split as the reference splits them`() {
+        assertEquals(listOf("ok.", "fine"), mixed.splitSentences("ok. fine"))
+        assertEquals(listOf("it costs 1.5 man"), mixed.splitSentences("it costs 1.5 man"))
+        assertEquals(listOf("whatever... fine"), mixed.splitSentences("whatever... fine"))
+        assertEquals(listOf("Mr. Tanaka is here."), mixed.splitSentences("Mr. Tanaka is here."))
+        assertEquals(listOf("は？", "なにそれ。", "うける"), mixed.splitSentences("は？なにそれ。うける"))
+        assertEquals(listOf("why?", "because."), mixed.splitSentences("why? because."))
+        assertEquals(listOf("wait!!", "really?!"), mixed.splitSentences("wait!! really?!"))
+        // e.g. and a.m. end no sentence.
+        assertEquals(listOf("e.g. this one"), mixed.splitSentences("e.g. this one"))
+        assertEquals(listOf("at 7 a.m. i sleep"), mixed.splitSentences("at 7 a.m. i sleep"))
+        // Python's $ also stands before one final newline: "Mr" still ends the text before the ".".
+        assertEquals(listOf("hi Mr\n. x"), mixed.splitSentences("hi Mr\n. x"))
+    }
+
+    @Test
+    fun `numbers follow the nearest word, after them first`() {
+        assertEquals(listOf("ja:あと=あと | en:5 minutes end=."), plan("あと5 minutes"))
+        assertEquals(listOf("ja:3時に=3時に | en:meet | ja:しよう=しよう end=."), plan("3時に meet しよう"))
+        assertEquals(listOf("en:meet at 3 end=."), plan("meet at 3"))
+        assertEquals(listOf("en:５ minutes end=."), plan("５ minutes"))
+        assertEquals(listOf("ja:100円=100円 | en:ok end=."), plan("100円 ok"))
+        // No word in the line: Japanese, read whole.
+        assertEquals(listOf("verbatim"), plan("4"))
+        assertEquals(listOf("verbatim"), plan("５００円だよ。"))
+        assertEquals(listOf("verbatim"), plan("1 = 1"))
+    }
+
+    @Test
+    fun `ordinals, dollars and euros are always English, yen follows its neighbours`() {
+        assertEquals(listOf("en:1st end=."), plan("1st"))
+        assertEquals(listOf("en:2nd floor end=."), plan("2nd floor"))
+        assertEquals(listOf("en:\$20 end=."), plan("\$20"))
+        assertEquals(listOf("verbatim"), plan("¥500"))
+        assertEquals(listOf("verbatim"), plan("¥ 500"))
+        assertEquals("fˈɜːst.", english("1st"))
+        assertEquals("θˈɜːd tˈaɪm.", english("3rd time"))
+        assertEquals("twˈɛnti dˈɑːlɚz.", english("\$20"))
+        assertEquals("aɪ pˈeɪ fˈaɪv hˈʌndɹəd jˈɛn ˈoʊkˈeɪ.", english("i pay ¥500 ok"))
+    }
+
+    @Test
+    fun `numbers with marks inside are read whole`() {
+        assertEquals("fˈɪfti pɚsˈɛnt ˈɔːf.", english("50% off"))
+        assertEquals("ɪts twˈɛnti θɹˈiː pˈɔɪnt fˈaɪv dɪɡɹˈiːz.", english("it's 23.5 degrees"))
+        assertEquals("wˈʌn θˈaʊzənd tˈuː hˈʌndɹəd nˈaɪnti nˈaɪn jˈɛn.", english("1,299 yen"))
+        assertEquals("ɪt kˈɑːsts wˈʌn pˈɔɪnt fˈaɪv mˈæn.", english("it costs 1.5 man"))
+    }
+
+    @Test
+    fun `am and pm after an English number are letters`() {
+        assertEquals("sˈɛvən ˌeɪˈɛm.", english("7am"))
+        assertEquals("sˈɛvən pˌiːˈɛm ˈoʊkˈeɪ.", english("7 pm ok"))
+        // a.m. typed with dots is two letters and two clause marks, as in the reference.
+        assertEquals("æt sˈɛvən ɐ, ˈɛm, aɪ slˈiːp.", english("at 7 a.m. i sleep"))
+    }
+
+    @Test
+    fun `units glued to a number are read as her romaji guesses, in Japanese`() {
+        assertEquals(listOf("ja:10km=10クム end=."), plan("10km"))
+        assertEquals(listOf("ja:5kg=5クグ end=."), plan("5kg"))
+    }
+
+    @Test
+    fun `katakana English is Japanese and goes whole to Open JTalk`() {
+        assertEquals(listOf("verbatim"), plan("テンション上がる"))
+        assertEquals(listOf("ja:今日=今日 | en:tension low | ja:なんだけど=なんだけど end=."), plan("今日 tension low なんだけど"))
+        assertEquals(listOf("ja:その=その | en:joke | ja:つまんない=つまんない end=."), plan("その joke つまんない"))
+    }
+
+    @Test
+    fun `her romaji and her words go to Japanese, the spaces beside them dropped`() {
+        assertEquals(listOf("ja:tanoshikatta ne=たのしかったね end=."), plan("tanoshikatta ne"))
+        assertEquals(listOf("ja:maji de=まじで | en:i fucking love her, end=."), plan("maji de, i fucking love her"))
+        assertEquals(listOf("ja:baka=ばか end=."), plan("baka"))
+        assertEquals(listOf("ja:kabukicho=歌舞伎町 | en:tonight end=.", "en:lets go end=."), plan("kabukicho tonight. lets go"))
+        // Neither English nor romaji: a Japanese reading of its letters.
+        assertEquals(listOf("ja:rizz=リッズ end=."), plan("rizz"))
+        assertEquals(listOf("ja:e=え | en:g. this one, end=."), plan("e.g. this one"))
+    }
+
+    @Test
+    fun `a Japanese piece that is not last hands Open JTalk no end mark, the last one takes the sentence's`() {
+        assertEquals(listOf("en:baby | ja:こっち来て=こっち来て。, end=."), plan("baby、こっち来て。"))
+        assertEquals(listOf("ja:え=え | en:really, end=?"), plan("え、really？"))
+    }
+
+    @Test
+    fun `punctuation pauses, ends or is dropped`() {
+        assertEquals("wˌʌtˈɛvɚ, fˈaɪn.", english("whatever... fine"))
+        assertEquals("jˈɛs, nˈoʊ, mˈeɪbi.", english("yes; no: maybe"))
+        assertEquals("tˈiː ʃˈɜːt tˈuː smˈɔːl.", english("t-shirt too small"))
+        assertEquals("nˈoʊ, nˈɛvɚ.", english("no - never"))
+        assertEquals("wˈeɪt, ɹˈɪli, nˈoʊ.", english("wait (really) no"))
+        assertEquals("kwˈoʊtɪd wˈɜːdz.", english("\"quoted\" words"))
+        assertEquals("sˈɔːlt ænd pˈɛpɚ.", english("salt & pepper"))
+        assertEquals("æt hˈoʊm.", english("@ home"))
+        assertEquals("mˈɪstɚ tɑːnˈɑːkə ɪz hˈiːɹ.", english("Mr. Tanaka is here."))
+        assertEquals("ˈoʊkˈeɪ. / fˈaɪn.", english("ok. fine"))
+        assertEquals("wˈaɪ? / bɪkˈɔːz.", english("why? because."))
+        assertEquals("wˈeɪt! / ɹˈɪli?", english("wait!! really?!"))
+        assertEquals("hˈaɪ mˈɪstɚ, ˈɛks.", english("hi Mr\n. x"))
+    }
+
+    @Test
+    fun `typed forms are made plain before reading`() {
+        assertEquals("ˈoʊkˈeɪ fˈaɪn.", english("ｏｋ ｆｉｎｅ"))
+        assertEquals("dˈoʊnt.", english("don’t"))
+        assertEquals("pˈoʊkeɪmən.", english("Pokémon"))
+        assertEquals("nˈoʊ.", english("NOOOO"))
+        assertEquals("sˈoʊ ɡˈʊd.", english("sooooo good"))
+    }
+
+    @Test
+    fun `a piece Open JTalk reads as nothing leaves no stray space, and a line with letters it refuses is not hers to say`() {
+        // An emoji is a Japanese run that gives no phoneme and has nothing to read in it.
+        assertEquals(listOf("ja:😂=😂 | en:lol end=."), plan("😂 lol"))
+        assertEquals("lˈɔːl.", english("😂 lol"))
+        // Letters of another script, which Open JTalk refuses: another voice says the line.
+        assertNull(mixed.phonemize("안녕") { null })
+        assertNull(mixed.phonemize("lol 안녕") { null })
+        // Marks alone: nothing to say.
+        assertEquals(emptyList<List<String>>(), mixed.phonemize("...") { null })
+    }
+
+    @Test
+    fun `Open JTalk is handed exactly the Japanese pieces`() {
+        val asked = ArrayList<String>()
+        // Labels of one mora (a), so that every piece reads as something and the next is asked for.
+        val sil = "xx^xx-sil+xx=xx/A:xx+xx+xx/F:xx_xx#xx_xx@xx_xx|xx_xx"
+        val a = listOf(sil, "xx^sil-a+sil=xx/A:0+1+1/F:1_1#0_xx@1_1|1_1", sil)
+        mixed.phonemize("あんたってほんとに crazy だね") { asked += it; a }
+        // Each piece is split as Piper splits a sentence, then read.
+        assertEquals(listOf("あんたってほんとに", "だね"), asked)
+        asked.clear()
+        mixed.phonemize("ii jan. keep that one") { asked += it; a }
+        // The sentence's own "." goes with its last piece (Open JTalk reads it as the end).
+        assertEquals(listOf("いいじゃん."), asked)
+        asked.clear()
+        mixed.phonemize("ふーん、そうなんだ？ へぇ〜。") { asked += it; a }
+        assertEquals(listOf("ふーん、そうなんだ？", "へぇ〜。"), asked)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/own/OwnVoiceCallbackTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/own/OwnVoiceCallbackTest.kt
