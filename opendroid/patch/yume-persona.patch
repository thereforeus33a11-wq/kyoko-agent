+    /** The last outing to read or for the news. */
+    private fun lastReadLine(outing: LastOuting, nowMillis: Long, thoughtsLeftOut: Boolean): String = buildString {
+        append("your last outing: ").append(quoted(outing.words)).append(", ").append(PersonaPrompts.age(nowMillis - outing.endedAt))
+        append(", ").append(outing.minutes).append(" min: ")
+        val counts = buildList {
+            add(if (outing.steps == 1) "1 step" else "${outing.steps} steps")
+            if (outing.searches > 0) add(if (outing.searches == 1) "1 search" else "${outing.searches} searches")
+            if (outing.opened > 0) {
+                val titles = outing.titles.joinToString(", ") { quoted(it) }
+                add((if (outing.opened == 1) "1 page opened" else "${outing.opened} pages opened") + if (titles.isEmpty()) "" else " ($titles)")
+            }
