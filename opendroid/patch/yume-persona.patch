+++ b/app/src/main/java/com/opendroid/ai/core/persona/HerRefs.kt
@@ -0,0 +1,165 @@
+package com.opendroid.ai.core.persona
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+
+/**
+ * The reference pictures of her that come with the app: `assets/her_refs/`, a list
+ * ([MANIFEST]) and the pictures it names, put there at build time from the repository's
+ * `opendroid/her_refs/` by `tools/prepare_assets.sh`, and only where he has approved them
+ * (an `APPROVED` file beside them). A build without them carries no list, or an empty one,
+ * and then nothing is put in.
+ *
+ * On the first start of a build, the pictures the list names that this phone was never given
+ * are put into her pictures ([PersonaPictures]) as they are, byte for byte, with the
+ * provenance the list gives each ([PersonaPicture.Provenance.ORIGINAL] or
+ * [PersonaPicture.Provenance.MASTER]) and its note. Each is remembered by its SHA-256
+ * ([PersonaPictureRules.Index.seeded]), so a later start, or a later build with the same
+ * picture in it, puts none in twice; one he removed stays removed; and what he changed about
+ * one (taken out of the bases, approved) is never set back. A picture whose bytes do not
+ * match the hash the list gives is not put in.
+ *
+ * The list of a build is the whole set that comes with it. Once a newer build has brought its
+ * set, a picture of an earlier set that this list no longer names is retired: derived, so never
+ * again a base, but still among her pictures for him to look at or remove ([retired]). Without
+ * that, an earlier set would stay a base beside the newer one for good. What he set himself is
+ * never changed, here either.
+ *
+ * The list, as `prepare_assets.sh` writes it:
+ * ```
+ * {"version": 1, "files": [{"file": "full_front.png", "kind": "ORIGINAL", "view": "full body, front",
+ *   "sha256": "<64 hex>", "note": "<where it came from>"}]}
+ * ```
+ * Nothing here reads the network or sends anything anywhere.
+ */
+object HerRefs {
+
+    /** The folder in the app's assets. */
+    const val DIRECTORY = "her_refs"
+
+    /** The list in it. */
+    const val MANIFEST = "$DIRECTORY/manifest.json"
+
+    /** One picture the list names. */
+    data class Entry(
+        /** The file's name in [DIRECTORY]: no folder, nothing outside it. */
+        val file: String,
+        /** What it is: an original or a master. A list never brings a derived picture. */
+        val kind: PersonaPicture.Provenance,
+        /** Which side of her it shows, as the list says it. */
+        val view: String,
+        /** The SHA-256 of its bytes, lower-case hex. */
+        val sha256: String,
+        /** Where it came from, for him. */
+        val note: String
+    )
+
+    private val JSON = Json { ignoreUnknownKeys = true }
+
+    /** A name the list may give: letters, digits, dots, dashes and underscores, ending in a picture's ending; never a folder. */
+    private val FILE_NAME = Regex("""[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\.(?:png|jpg|jpeg|webp)""", RegexOption.IGNORE_CASE)
+
+    private val SHA256 = Regex("""[0-9a-f]{64}""")
+
+    /** True for a SHA-256 in lower-case hex. */
+    fun isSha256(text: String): Boolean = SHA256.matches(text)
+
+    /** The most a view or a note is kept to. */
+    const val MAX_TEXT_CHARS = 200
+
+    /**
+     * The entries of a list. Text that is not a list gives none. An entry without a usable
+     * name, with a kind other than an original or a master, without a hash, or that repeats
+     * a name or a hash, is skipped.
+     */
+    fun parse(text: String?): List<Entry> {
+        if (text.isNullOrBlank()) return emptyList()
+        val root = try {
+            JSON.parseToJsonElement(text) as? JsonObject
+        } catch (e: Exception) {
+            null
+        } ?: return emptyList()
+        val names = HashSet<String>()
+        val hashes = HashSet<String>()
+        return (root["files"] as? JsonArray).orEmpty().mapNotNull { element ->
+            val entry = element as? JsonObject ?: return@mapNotNull null
+            val file = entry.string("file")?.trim().orEmpty()
+            val kind = when (entry.string("kind")?.trim()?.uppercase()) {
+                "ORIGINAL" -> PersonaPicture.Provenance.ORIGINAL
+                "MASTER" -> PersonaPicture.Provenance.MASTER
+                else -> null
+            }
+            val sha = entry.string("sha256")?.trim()?.lowercase().orEmpty()
+            if (!FILE_NAME.matches(file) || kind == null || !isSha256(sha)) return@mapNotNull null
+            if (!names.add(file.lowercase()) || !hashes.add(sha)) return@mapNotNull null
+            Entry(file, kind, entry.text("view"), sha, entry.text("note"))
+        }
+    }
+
+    private fun JsonObject.string(key: String): String? = (this[key] as? JsonPrimitive)?.takeIf { it.isString }?.content
+
+    private fun JsonObject.text(key: String): String =
+        string(key).orEmpty().replace(Regex("""\s+"""), " ").trim().take(MAX_TEXT_CHARS).trim()
+
+    /** What a start does with the list: the entries to put in, and the hashes of those already on the phone. */
+    class Seeding(val add: List<Entry>, val known: List<String>)
+
+    /**
+     * Which of [entries] go into [index]: those it was never given ([PersonaPictureRules.Index.seeded])
+     * and holds no picture of (by hash: he may have added the same file himself), as many as
+     * there is room for. A picture already there by its hash is remembered as given, so it is
+     * not put in after he removes it.
+     */
+    fun seeding(index: PersonaPictureRules.Index, entries: List<Entry>): Seeding {
+        val seeded = index.seeded.toSet()
+        val held = index.pictures.map { it.sha256 }.filter { it.isNotEmpty() }.toSet()
+        val fresh = entries.filter { it.sha256 !in seeded }
+        val known = fresh.filter { it.sha256 in held }.map { it.sha256 }
+        val add = fresh.filter { it.sha256 !in held }.take(PersonaPictureRules.referenceRoom(index))
+        return Seeding(add, known)
+    }
+
+    /**
+     * [index] with what came with the app brought in line with [entries], the list of the build
+     * it is on: a bundled picture the list names has the kind the list gives it, and one it no
+     * longer names is derived. A picture whose provenance he set himself
+     * ([PersonaPicture.provenanceByOwner]) is left as he set it. Only a list whose set has come
+     * onto the phone (at least one of its pictures is there, by hash) does this: a build with no
+     * list, an empty one, or one none of whose pictures could be put in changes nothing, so a
+     * build that brings nothing never leaves him without his bases.
+     */
+    fun retired(index: PersonaPictureRules.Index, entries: List<Entry>): PersonaPictureRules.Index {
+        val kinds = entries.associate { it.sha256 to it.kind }
+        val arrived = index.pictures.any { it.kind == PersonaPicture.Kind.SELF && it.sha256.isNotEmpty() && it.sha256 in kinds }
+        if (!arrived) return index
+        val pictures = index.pictures.map { picture ->
+            if (picture.origin != PersonaPicture.Origin.BUNDLED || picture.made || picture.provenanceByOwner) return@map picture
+            val kind = kinds[picture.sha256] ?: PersonaPicture.Provenance.DERIVED
+            if (picture.provenance == kind) picture else picture.copy(provenance = kind)
+        }
+        return if (pictures == index.pictures) index else index.copy(pictures = pictures)
+    }
+
+    /** The caption a bundled picture is kept with: which side of her it shows. */
+    fun caption(entry: Entry): String =
+        PersonaPictureRules.fitCaption("reference picture" + entry.view.trimEnd('.').takeIf { it.isNotEmpty() }?.let { ": $it" }.orEmpty())
+
+    /** [entry] as a picture of her in the store, kept as given in [file] at [addedAt]. */
+    fun picture(entry: Entry, id: String, file: String, addedAt: Long): PersonaPicture = PersonaPicture(
+        id = id,
+        file = file,
+        kind = PersonaPicture.Kind.SELF,
+        caption = caption(entry),
+        captionBy = PersonaPicture.CaptionBy.APP,
+        addedAt = addedAt,
+        made = false,
+        origin = PersonaPicture.Origin.BUNDLED,
+        provenance = entry.kind,
+        asGiven = true,
+        view = entry.view,
+        sha256 = entry.sha256,
+        note = entry.note
+    )
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/HerWords.kt b/app/src/main/java/com/opendroid/ai/core/persona/HerWords.kt
new file mode 100644
index 0000000..c767c2a
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/HerWords.kt
@@ -0,0 +1,263 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.data.models.ChatMessage
+import java.util.UUID
+
+/**
+ * Words the phone is about to send for him that nobody else may write: she writes them.
+ *
+ * When something the phone is about to send (an email, a message, a post, text typed
+ * into another app, an invitation) holds words that are neither his own nor hers, the
+ * app does not send them as the planning tool wrote them. It asks her to write them
+ * herself, as herself, and tells her only what she needs for that: what kind of thing it
+ * is, who it goes to and through which app, that it goes from his phone and his accounts,
+ * and what was asked for, in the words of whoever asked. The draft the planning tool
+ * wrote, and the planning tool's own prompt, are never shown to her: her words would
+ * then only be its words passed through her.
+ *
+ * Her answer is read strictly ([read]): the fields she was asked for, in order, or a
+ * plain NO. Anything else counts as no, and then nothing is sent.
+ *
+ * Like the rest of this package, everything here is a decision about text. The words go
+ * back to the loop that runs plans as finished strings.
+ */
+object HerWords {
+
+    /** What the words are. Each kind is named in her note the way a person would say it. */
+    enum class Kind(val said: String) {
+        EMAIL("an email"),
+        MESSAGE("a message"),
+        POST("a public post"),
+        TYPED_TEXT("text typed into another app"),
+        INVITATION("a calendar invitation"),
+        PAYMENT_NOTE("the note on a payment"),
+        LINK("words a link fills into the page it opens")
+    }
+
+    /** Who asked for the thing the words go with: him, in a message of his, or her, in a command of hers. */
+    enum class From { HIM, HER }
+
+    /**
+     * A mark she may write where the phone puts in what an earlier step gives back when it
+     * runs (the weather it looked up, his answer to a question): [token] is the mark, and
+     * [step] names that step's action the way his approval card does. Neither is anybody's
+     * words: the app makes both.
+     */
+    data class Fill(val token: String, val step: String)
+
+    /**
+     * One thing the phone is about to send, as she is told of it.
+     *
+     * [to] is who it goes to as the phone has it (an address, a number, a name, or the
+     * field text is typed into), empty for a post. [through] is the app it goes through.
+     * [asked] is what was asked for, word for word, by [askedBy]. [fields] are the names
+     * of the parts she writes, in order ("subject", "body"). [stored] says the words are
+     * kept in a macro of his and sent the same every time it runs. [kept] names the parts
+     * that are already his or her own words and stay as they are; only their names, never
+     * their words. [fills] are the marks for what earlier steps give back, which go where
+     * she puts them.
+     */
+    data class Ask(
+        val kind: Kind,
+        val to: String,
+        val through: String,
+        val askedBy: From,
+        val asked: String,
+        val fields: List<String>,
+        val stored: Boolean = false,
+        val kept: List<String> = emptyList(),
+        val fills: List<Fill> = emptyList()
+    ) {
+        /**
+         * This ask for a route that is not given his details: who it goes to is named only
+         * where the words that asked for it name it too. An address or a number the phone
+         * looked up in his contacts stays on the phone.
+         */
+        fun withRecipientHeldBack(): Ask {
+            if (to.isBlank() || kind == Kind.TYPED_TEXT || kind == Kind.POST) return this
+            return if (asked.contains(to.trim(), ignoreCase = true)) this else copy(to = RECIPIENT_HELD_BACK)
+        }
+    }
+
+    /** What came of asking her. */
+    sealed class Answer {
+        /** She wrote them: every field she was asked for, in her words. */
+        data class Written(val fields: Map<String, String>) : Answer()
+
+        /** She will not send it, or her answer could not be read as the fields she was asked for. */
+        object Refused : Answer()
+
+        /** Her model could not be reached, or she is not on. Nothing came from her. */
+        object Unreachable : Answer()
+    }
+
+    /** Stands in for who it goes to where her route is not given his details. */
+    const val RECIPIENT_HELD_BACK = "someone of his (who it is stays on the phone)"
+
+    /** Her answer when she will not send it. */
+    const val NO = "NO"
+
+    // Her voice, steadier than a chat reply: the answer has a shape that is read.
+    private const val WORDS_TEMPERATURE = 0.7f
+    // Room for a whole email.
+    private const val WORDS_MAX_TOKENS = 1500
+    // Longer than any message he would send by hand; an answer past it is not read as one.
+    private const val MAX_FIELD_CHARS = 6000
+    // The fields that are one line: a subject line, the title of an invitation.
+    private val ONE_LINE_FIELDS = setOf("subject", "title")
+    private val QUOTE_PAIRS = listOf('"' to '"', '\u201C' to '\u201D', '\u300C' to '\u300D')
+
+    /**
+     * Her request for [ask]: her card with his name filled in, then the app's facts about
+     * what these words are ([PersonaPrompts.wordsSystemPrompt]), and one turn of the
+     * app's that says what is about to be sent and asks her for the fields
+     * ([PersonaPrompts.wordsPrompt]). Plain text, read whole. It is marked as hers by the
+     * engine before it goes out.
+     */
+    fun request(card: String, ownerName: String, ask: Ask): LLMRequest = LLMRequest(
+        systemPrompt = PersonaPrompts.wordsSystemPrompt(card, ownerName),
+        messages = listOf(
+            ChatMessage(id = UUID.randomUUID().toString(), text = PersonaPrompts.wordsPrompt(ask), sender = ChatMessage.Sender.USER)
+        ),
+        temperature = WORDS_TEMPERATURE,
+        maxTokens = WORDS_MAX_TOKENS,
+        responseFormat = ResponseFormat.TEXT
+    )
+
+    /**
+     * Reads her answer for [fields]. Only two shapes are taken:
+     *
+     *  - a plain NO, which is her saying she will not send it;
+     *  - every one of [fields], in order, each at the start of a line with its name and a
+     *    colon ("subject: ..."), with nothing before the first. Each field runs to the
+     *    next one, and the last to the end. A subject or a title is one line. No field
+     *    may be empty or a bare NO.
+     *
+     * Anything else, half an answer included, is [Answer.Refused]: words that cannot be
+     * read as hers are not sent. One pair of quotation marks around a whole field is
+     * taken off, the way a chat model wraps a line it was asked to write.
+     */
+    fun read(raw: String, fields: List<String>): Answer {
+        val text = raw.replace("\r\n", "\n").trim()
+        if (fields.isEmpty() || text.isEmpty()) return Answer.Refused
+        if (isNo(text)) return Answer.Refused
+        val written = LinkedHashMap<String, String>()
+        var from = 0
+        var openAt = -1
+        var openField: String? = null
+        for (field in fields) {
+            val label = Regex("""(?im)^[ \t]*${Regex.escape(field)}[ \t]*:""")
+            val found = label.find(text, from) ?: return Answer.Refused
+            if (openField == null) {
+                // Nothing of hers may stand before the first field.
+                if (text.substring(0, found.range.first).isNotBlank()) return Answer.Refused
+            } else {
+                written[openField] = text.substring(openAt, found.range.first)
+            }
+            openField = field
+            openAt = found.range.last + 1
+            from = openAt
+        }
+        written[openField!!] = text.substring(openAt)
+        val cleaned = LinkedHashMap<String, String>()
+        for ((field, value) in written) {
+            val words = unquoted(value.trim())
+            if (words.isEmpty() || isNo(words) || words.length > MAX_FIELD_CHARS) return Answer.Refused
+            if (field.lowercase() in ONE_LINE_FIELDS && '\n' in words) return Answer.Refused
+            cleaned[field] = words
+        }
+        return Answer.Written(cleaned)
+    }
+
+    private fun isNo(text: String): Boolean = text.trim().trimEnd('.', '!').trim().equals(NO, ignoreCase = true)
+
+    private fun unquoted(text: String): String {
+        if (text.length < 2) return text
+        val pair = QUOTE_PAIRS.firstOrNull { (open, close) -> text.first() == open && text.last() == close } ?: return text
+        val inner = text.substring(1, text.length - 1)
+        // A quotation mark inside means the outer ones are not a wrapping pair.
+        return if (pair.first in inner || pair.second in inner) text else inner.trim()
+    }
+
+    // ── The app's rows about it ──────────────────────────────────────────────────────
+
+    /**
+     * Why a step that was to send words was left out of the plan, in the app's words.
+     * [fallback] is the line for a step that itself sends nothing, whose fallback alone
+     * would have sent the words: only the fallback goes, and the step still runs.
+     */
+    enum class LeftOut(val reason: String, val fallback: String? = null) {
+        /** She answered NO, or something that could not be read as the words. */
+        REFUSED(
+            "${PersonaPrompts.BADGE} did not write this, so it was left out.",
+            "${PersonaPrompts.BADGE} did not write the words of its fallback, so the fallback was taken off. The step itself still runs."
+        ),
+
+        /** Her model could not be reached, so nothing came from her. */
+        UNREACHABLE(
+            "${PersonaPrompts.BADGE}'s model could not be reached, so it was not sent.",
+            "${PersonaPrompts.BADGE}'s model could not be reached, so its fallback was taken off. The step itself still runs."
+        ),
+
+        /** The words that asked for the plan are not known here, so nobody's words can be told from a tool's. */
+        NOT_KNOWN(
+            "what was asked for is not known here, so it was left out.",
+            "what was asked for is not known here, so its fallback was taken off. The step itself still runs."
+        ),
+
+        /** Who it goes to, or the field it is typed into, reads as a sentence and not as a name or an address. */
+        UNCLEAR(
+            "who or where it goes could not be read plainly, so it was left out.",
+            "who or where its fallback goes could not be read plainly, so the fallback was taken off. The step itself still runs."
+        ),
+
+        /** It reads the answer of a step that was left out, which will never come. */
+        NEEDED("it needed the answer of a step that was left out, so it was left out too."),
+
+        /** It taps, types or waits on his screen right after typing that was left out, and would act on whatever is there instead. */
+        AFTER_TYPING("it acts on text a step that was left out would have typed, so it was left out too."),
+
+        /** A macro all of whose stored steps were left out. */
+        NOTHING_KEPT("nothing it would keep is left, so it was left out.")
+    }
+
+    /** The line for a step whose words she wrote. [stepLine] names the step as the approval card does. */
+    fun wroteLine(stepLine: String): String = "$stepLine: ${PersonaPrompts.BADGE} wrote the words."
+
+    /** The line for a step left out, and why. */
+    fun leftOutLine(stepLine: String, why: LeftOut): String = "$stepLine: ${why.reason}"
+
+    /** The line for a step that still runs without the fallback that would have sent words, and why. */
+    fun fallbackOffLine(stepLine: String, why: LeftOut): String = "$stepLine: ${why.fallback ?: why.reason}"
+
+    /**
+     * The line for a step left out because it was addressed to a machine that only sends.
+     * [reason] is the app's sentence for why that address is never answered.
+     */
+    fun automatedLine(stepLine: String, reason: String): String = "$stepLine: $reason, so it was left out."
+
+    /** The line for a step that still runs, with an address that only sends taken off it. */
+    fun takenOffLine(stepLine: String, reason: String): String = "$stepLine: $reason, so it was taken off this step."
+
+    /** The line for a step that still runs without its fallback, which would have sent words to a machine that only sends. */
+    fun automatedFallbackLine(stepLine: String, reason: String): String =
+        "$stepLine: $reason, so its fallback was taken off. The step itself still runs."
+
+    /** The line for a step kept in a macro: [macroLine] is the macro's step, [innerLine] the stored step. */
+    fun storedStepLine(macroLine: String, innerLine: String): String = "$macroLine, its step $innerLine"
+
+    private const val CHECKED = "Checked before it runs:"
+    private const val NOTHING_LEFT = "Not run: nothing was left to run."
+
+    /**
+     * The row the chat keeps of what was done to a plan's words before it ran: [lines], one
+     * per step, under a heading. With [nothingLeft] the row opens the way every row for
+     * something that was not run does, so that her next prompt reads it as an outcome.
+     */
+    fun record(lines: List<String>, nothingLeft: Boolean): String = buildString {
+        append(if (nothingLeft) NOTHING_LEFT else CHECKED)
+        lines.forEach { append("\n• ").append(it) }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/MadePictureCheck.kt b/app/src/main/java/com/opendroid/ai/core/persona/MadePictureCheck.kt
new file mode 100644
index 0000000..b37b2ca
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/MadePictureCheck.kt
@@ -0,0 +1,218 @@
+package com.opendroid.ai.core.persona
+
+import android.util.Log
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.eyes.EyesImage
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.life.eyes.HerSight
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import java.util.Base64
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The age check of every picture made of her, before it is shown or kept (the content rule,
+ * [PictureGuard]). It has no setting.
+ *
+ * A picture is looked at by the describer's Private-tier vision model ([HerEyes.checkMade])
+ * and, where her brain sees, by her own model too ([HerSight.checkMade]), each with the
+ * picture and [com.opendroid.ai.core.life.eyes.Describe.MADE_CHECK] and nothing else. Each
+ * answer is read the way every picture's is ([KidGuard.ages], [KidGuard.flagOfPicture]): its
+ * `ages:` line and every other word of it. The picture passes ([Verdict.Adult]) only when a
+ * check ran and read an adult, and none read anything else:
+ *
+ * - a child or a teen, by the ages line or by the words (a school uniform, a child's body):
+ *   [Verdict.Kid];
+ * - an answer without a readable ages line, or one that saw no one in a picture of her:
+ *   [Verdict.Unchecked];
+ * - no check that could run at all: [Verdict.Unchecked].
+ *
+ * Anything but [Verdict.Adult] is thrown away by the caller: never shown, never kept, its
+ * bytes zeroed, and counted by its [category] only ([HerLog.KID_PREFIX]). Nothing of the
+ * picture or of the checker's words is logged.
+ */
+object MadePictureCheck {
+
+    sealed class Verdict {
+        data object Adult : Verdict()
+
+        /** Read as a [group]; [why] is a few words for him, never the checker's words. */
+        data class Kid(val group: KidGuard.Group, val why: String) : Verdict()
+
+        /** The check ran and could not tell, or none could run ([ran] false). */
+        data class Unchecked(val why: String, val ran: Boolean = true) : Verdict()
+    }
+
+    /** The one interface the makers of her pictures hold: a picture's bytes in, a verdict out. */
+    fun interface AgeCheck {
+        /** [counted]: the picture is a call of hers (her own time), so the check is too. */
+        suspend fun check(image: ByteArray, counted: Boolean): Verdict
+    }
+
+    /** What a check that saw no person in a picture of her is told as. */
+    const val SAW_NO_ONE = "the age check saw no one in it"
+
+    /** What no check that could run is told as. */
+    const val NO_CHECK = "no age check could run on it"
+
+    /** What a check that looked at the picture and would not say, or said nothing, is told as. */
+    const val WOULD_NOT_SAY = "the age check looked at it and would not say how old the woman drawn looks"
+
+    /**
+     * Words of a checker's answer that read as a child's or a teen's look in a picture made
+     * of her, whatever its ages line says. Stricter than the words read on any other picture
+     * ([KidGuard.flagOfPicture]): a picture of her is of one adult woman, so a child-like
+     * body, a baby face, a loli or a school outfit named at all is enough, and "baby face" is
+     * not taken for a colour here.
+     */
+    private val MADE_CHILD = Regex(
+        """(?i)\b(?:child\w*|child-like|kid-?like|kiddie|loli\w*|shota\w*|baby[ -]?faced?|preteens?|prepubescent|pubescent|""" +
+            """underage\w*|under-?aged?|minors?|chibi|very young|little girls?|young girls?|toddler\w*|infant\w*|underdeveloped|mesugaki)\b|""" +
+            """幼い|幼女|少女|子供|子ども|児童|女児|ロリ|メスガキ"""
+    )
+    private val MADE_TEEN = Regex(
+        """(?i)(?<!old[ -])\b\w*school\w*\b|\b(?:(?:sailor|student|school|gym) (?:uniform|outfit|collar|fuku|suit)|sailor ?fuku|serafuku|seifuku|""" +
+            """randoseru|classroom|jailbait|teen\w*|adolescen\w*)\b|制服|セーラー|学生服|女子高生|中学生|高校生|ランドセル|学校|教室"""
+    )
+
+    /**
+     * One check's answer as a verdict. An answer that came back and said nothing usable (the
+     * checker would not describe it, or sent back no words) is a check that ran and could not
+     * tell: it does not pass the picture, whatever another check said. Only a check that never
+     * reached a model (no key, no network) is passed over where another one ran.
+     */
+    fun judge(seen: HerEyes.Seen, nowMillis: Long = System.currentTimeMillis()): Verdict = when (seen) {
+        is HerEyes.Seen.Described -> {
+            val made = when {
+                MADE_CHILD.containsMatchIn(seen.words) -> Verdict.Kid(KidGuard.Group.CHILD, "described as a child")
+                MADE_TEEN.containsMatchIn(seen.words) -> Verdict.Kid(KidGuard.Group.TEEN, "described as a teen")
+                else -> null
+            }
+            val flag = KidGuard.flagOfPicture(seen.words, seen.ages, nowMillis, KidGuard.AGE_CHECK)
+            val read = seen.ages as? KidGuard.Ages.Read
+            when {
+                // Its ages line first, where it names a child or a teen; then its words.
+                flag != null && read != null && (KidGuard.Age.CHILD in read.groups || KidGuard.Age.TEEN in read.groups) -> Verdict.Kid(flag.group, flag.why)
+                made != null -> made
+                flag != null -> Verdict.Kid(flag.group, flag.why)
+                read == null -> Verdict.Unchecked(KidGuard.NO_AGES_CHECKED)
+                KidGuard.Age.ADULT !in read.groups -> Verdict.Unchecked(SAW_NO_ONE)
+                else -> Verdict.Adult
+            }
+        }
+        // Never an answer of these checks; a picture shown without being read is not passed.
+        is HerEyes.Seen.Shown -> Verdict.Unchecked(KidGuard.NO_AGES_CHECKED)
+        is HerEyes.Seen.NotSeen -> when (seen.why) {
+            // It looked, and declined or said nothing: possibly because of what it saw.
+            HerEyes.Why.DECLINED, HerEyes.Why.EMPTY -> Verdict.Unchecked(WOULD_NOT_SAY)
+            else -> Verdict.Unchecked(NO_CHECK, ran = false)
+        }
+    }
+
+    /** Her own words about a picture of her that say she looks younger than she is in it: "younger", "like a teen", "15". */
+    private val SEEN_YOUNG = Regex(
+        """(?i)\b(?:younger|young girl|little girl|kid|kiddo|like a (?:teen|child|minor)|look(?:s|ing)?(?: like)? (?:[1-9]|1[0-7])(?![\d:.]))\b"""
+    )
+
+    /**
+     * Whether [words] (what she says of a picture made of her) read her as younger than she
+     * is, a child or a teen: the checker's made-picture words ([MADE_CHILD], [MADE_TEEN]), an
+     * age under 18 or a school marker ([KidGuard.flag]), or "younger".
+     */
+    fun readsYoung(words: String): Boolean =
+        MADE_CHILD.containsMatchIn(words) || MADE_TEEN.containsMatchIn(words) || SEEN_YOUNG.containsMatchIn(words) ||
+            KidGuard.flag("", words) != null
+
+    /**
+     * The checks together: a child or a teen read by any of them, then any that ran and could
+     * not tell, then whether at least one ran and read an adult. A check that could not run
+     * is passed over where another one ran.
+     */
+    fun combine(verdicts: List<Verdict>): Verdict {
+        verdicts.firstOrNull { it is Verdict.Kid }?.let { return it }
+        verdicts.firstOrNull { it is Verdict.Unchecked && it.ran }?.let { return it }
+        return if (verdicts.any { it == Verdict.Adult }) Verdict.Adult else Verdict.Unchecked(NO_CHECK, ran = false)
+    }
+
+    /** The log category a verdict that throws a picture away is counted under: `kid:CHILD`, `kid:TEEN` or `kid:UNCHECKED`. Null for an adult. */
+    fun category(verdict: Verdict): String? = when (verdict) {
+        is Verdict.Adult -> null
+        is Verdict.Kid -> HerLog.KID_PREFIX + verdict.group.name
+        is Verdict.Unchecked -> KidGuard.UNCHECKED
+    }
+
+    /**
+     * What he and she are told of a picture thrown away. Nothing of the picture is in it. It
+     * says the render came out wrong, not that she did, so that she can say it as a picture
+     * that did not work.
+     */
+    fun thrownAway(verdict: Verdict): String = when (verdict) {
+        is Verdict.Adult -> ""
+        is Verdict.Kid -> "Not kept: the picture came out wrong: the age check read the woman drawn as a ${verdict.group.name.lowercase()} (${verdict.why}), so it was thrown away unseen."
+        is Verdict.Unchecked -> "Not kept: the picture came out unchecked: ${verdict.why}, so it was thrown away unseen."
+    }
+}
+
+/**
+ * The age check as the app runs it ([MadePictureCheck]): the describer first, then her own
+ * model where her brain sees. A picture the describer already read as a kid, or looked at
+ * and could not tell, is not sent on: it cannot pass.
+ */
+@Singleton
+class MadePictureAgeCheck internal constructor(
+    private val eyes: suspend (ByteArray, Boolean) -> HerEyes.Seen,
+    private val herModel: suspend (LLMConfig, String, Boolean) -> HerEyes.Seen,
+    private val settings: suspend () -> LLMConfig,
+    private val brainSees: (LLMConfig) -> Boolean,
+    private val prepare: (ByteArray) -> EyesImage.Prepared = EyesImage::prepare,
+    private val clock: () -> Long = System::currentTimeMillis
+) : MadePictureCheck.AgeCheck {
+
+    @Inject
+    constructor(eyes: HerEyes, sight: HerSight, settings: SettingsRepository) : this(
+        eyes = { image, counted -> eyes.checkMade(image, counted) },
+        herModel = { config, base64, counted -> sight.checkMade(config, base64, counted) },
+        settings = { settings.llmConfig.first() },
+        brainSees = sight::brainSees
+    )
+
+    override suspend fun check(image: ByteArray, counted: Boolean): MadePictureCheck.Verdict {
+        val verdicts = ArrayList<MadePictureCheck.Verdict>()
+        verdicts += MadePictureCheck.judge(eyes(image, counted), clock())
+        // Read as a kid, or looked at and not told: it cannot pass, so it is not sent on (nor paid for again).
+        val first = verdicts.last()
+        if (first is MadePictureCheck.Verdict.Kid || (first is MadePictureCheck.Verdict.Unchecked && first.ran)) {
+            MadePictureCheck.category(first)?.let { Log.i(TAG, "A picture of her was not passed: $it") }
+            return first
+        }
+        val config = settings()
+        if (brainSees(config)) {
+            val base64 = when (val prepared = withContext(Dispatchers.Default) { prepare(image) }) {
+                is EyesImage.Prepared.Skipped -> null
+                is EyesImage.Prepared.Jpeg -> try {
+                    Base64.getEncoder().encodeToString(prepared.bytes)
+                } finally {
+                    prepared.bytes.fill(0)
+                }
+            }
+            verdicts += if (base64 == null) {
+                MadePictureCheck.Verdict.Unchecked(MadePictureCheck.NO_CHECK, ran = false)
+            } else {
+                MadePictureCheck.judge(herModel(config, base64, counted), clock())
+            }
+        }
+        val verdict = MadePictureCheck.combine(verdicts)
+        // The category only: never the picture, never the checker's words.
+        MadePictureCheck.category(verdict)?.let { Log.i(TAG, "A picture of her was not passed: $it") }
+        return verdict
+    }
+
+    private companion object {
+        const val TAG = "MadePictureCheck"
+    }
+}
