--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/HerFeeds.kt
@@ -0,0 +1,109 @@
+package com.opendroid.ai.core.life.reading
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The feeds she follows herself (`do: follow` on a page with a feed of its own), at most
+ * [Feeds.MAX_FOLLOWED]. Her other feeds are the build's defaults, less those he took
+ * away. One small JSON file in the app's own storage: addresses and names of sites, no
+ * text of hers.
+ */
+@Singleton
+class HerFeeds internal constructor(private val file: () -> File) {
+
+    @Inject
+    constructor(@ApplicationContext context: Context) : this({ File(File(context.filesDir, DIRECTORY), FILE) })
+
+    /** What became of a follow. */
+    enum class Followed { ADDED, ALREADY, FULL, FAILED }
+
+    @Serializable
+    private data class Entry(val name: String, val url: String)
+
+    private val lock = Any()
+
+    /** The feeds she follows, oldest first. Empty when there are none or the file cannot be read. */
+    fun followed(): List<Feeds.Feed> = synchronized(lock) { read().orEmpty().map(::feedOf) }
+
+    /** Follows the feed at [url], named [name] (the site's title). */
+    fun follow(url: String, name: String): Followed = synchronized(lock) {
+        val current = read() ?: return Followed.FAILED
+        if (current.any { it.url == url }) return Followed.ALREADY
+        if (current.size >= Feeds.MAX_FOLLOWED) return Followed.FULL
+        val added = current + Entry(name.replace(Regex("""\s+"""), " ").trim().take(MAX_NAME_CHARS).ifEmpty { "a site" }, url)
+        if (write(added)) Followed.ADDED else Followed.FAILED
+    }
+
+    /**
+     * Takes the feed at [url] off the ones she follows: his choice in Settings. True when
+     * it is gone (or was never there), false when the file could not be read or written.
+     */
+    fun unfollow(url: String): Boolean = synchronized(lock) {
+        val current = read() ?: return false
+        if (current.none { it.url == url }) return true
+        write(current.filterNot { it.url == url })
+    }
+
+    /**
+     * Her feeds now: the defaults he did not take away ([removed], by id), the YouTube
+     * channels he added ([youtube], channel id to name), then the ones she follows.
+     */
+    fun all(removed: Collection<String>, youtube: Map<String, String> = emptyMap()): List<Feeds.Feed> =
+        Feeds.DEFAULTS.filterNot { it.id in removed } +
+            youtube.mapNotNull { (id, name) -> Feeds.youtube(id, name) } +
+            followed()
+
+    /** Her feeds under [config]: what [all] gives for his removals and his YouTube channels. */
+    fun all(config: com.opendroid.ai.data.models.LLMConfig): List<Feeds.Feed> =
+        all(config.personaReadFeedsRemoved, config.personaReadYouTube)
+
+    private fun feedOf(entry: Entry) = Feeds.Feed("her-" + Integer.toHexString(entry.url.hashCode()), entry.name, entry.url)
+
+    private fun read(): List<Entry>? {
+        val target = file()
+        return try {
+            if (!target.isFile) emptyList() else JSON.decodeFromString(ListSerializer(Entry.serializer()), target.readText())
+        } catch (e: Exception) {
+            Log.w(TAG, "Her feeds could not be read: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    private fun write(all: List<Entry>): Boolean = try {
+        val target = file()
+        val folder = target.parentFile ?: throw IOException("No directory")
+        if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+        val draft = File(folder, target.name + ".tmp")
+        try {
+            FileOutputStream(draft).use { out ->
+                out.write(JSON.encodeToString(ListSerializer(Entry.serializer()), all).toByteArray(Charsets.UTF_8))
+                out.fd.sync()
+            }
+            if (!draft.renameTo(target)) throw IOException("The file could not be put in place")
+        } finally {
+            draft.delete()
+        }
+        true
+    } catch (e: Exception) {
+        Log.w(TAG, "Her feeds could not be written: ${e.javaClass.simpleName}")
+        false
+    }
+
+    private companion object {
+        const val TAG = "HerFeeds"
+        const val DIRECTORY = "persona"
+        const val FILE = "her_feeds.json"
+        const val MAX_NAME_CHARS = 60
+        val JSON = Json { ignoreUnknownKeys = true }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/reading/HerFetcher.kt b/app/src/main/java/com/opendroid/ai/core/life/reading/HerFetcher.kt
new file mode 100644
index 0000000..1e7eb14
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/HerFetcher.kt
@@ -0,0 +1,558 @@
+package com.opendroid.ai.core.life.reading
+
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.llm.providers.cancellable
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.CookieJar
+import okhttp3.Dns
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okio.Buffer
+import java.io.IOException
+import java.io.InterruptedIOException
+import java.net.Inet4Address
+import java.net.Inet6Address
+import java.net.InetAddress
+import java.net.Proxy
+import java.net.UnknownHostException
+import java.util.concurrent.TimeUnit
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Fetches pages and feeds for her, and nothing else, by fixed rules:
+ *
+ * - https only; at most [Limits.maxRedirects] redirects, each one checked again;
+ * - the name is resolved first, by this phone, and a name that is an IP literal, ends in
+ *   `.onion` or `.local` (or another local suffix), has no dot, or resolves to any
+ *   loopback, private, link-local, CGNAT, unique-local or otherwise non-public address is
+ *   not fetched. The connection is made only to the addresses that were checked, and never
+ *   through a proxy, so the check holds for where the request really goes;
+ * - at most [Limits.maxBytes] are read, within [Limits.timeoutMillis], and only text/html,
+ *   XML or JSON is taken;
+ * - no cookie jar, no Referer, no Accept-Language, and a generic User-Agent ([USER_AGENT])
+ *   that carries nothing about him;
+ * - robots.txt is honoured, cached per host for a day, for every page she opens by a link
+ *   or a page of a site ([fetch] with robots on). It is a crawler's rule, so an address the
+ *   app builds itself to ask a service's own interface (Wikipedia's API) and the feeds she
+ *   reads (published for readers, as a feed reader reads them) are fetched with it off:
+ *   Wikimedia's robots.txt closes `/w/` to crawlers, its API included, and YouTube's closes
+ *   `/feeds/videos.xml`;
+ * - one fetch per host every [Limits.perHostMillis] at most, a fixed wait with no jitter.
+ *
+ * Every fetch that leaves the phone is counted in her ledger ([OwnPurpose.FETCH]). Nothing
+ * fetched is written to disk here.
+ */
+@Singleton
+class HerFetcher internal constructor(
+    base: OkHttpClient,
+    systemDns: Dns,
+    private val addressAllowed: (InetAddress) -> Boolean,
+    private val limits: Limits,
+    private val clock: () -> Long,
+    private val pause: suspend (Long) -> Unit,
+    private val ledger: OwnLedger?
+) {
+    @Inject
+    constructor(client: OkHttpClient, ledger: OwnLedger) : this(
+        base = client,
+        systemDns = Dns.SYSTEM,
+        addressAllowed = PublicAddress::isPublic,
+        limits = Limits(),
+        clock = System::currentTimeMillis,
+        pause = { delay(it) },
+        ledger = ledger
+    )
+
+    data class Limits(
+        val maxRedirects: Int = 3,
+        val maxBytes: Int = 1_500_000,
+        val timeoutMillis: Long = 15_000,
+        val perHostMillis: Long = 5_000,
+        val robotsTtlMillis: Long = 24 * 60 * 60_000L,
+        /** How long a robots.txt that could not be fetched (5xx, no answer) keeps a host closed. */
+        val robotsRetryMillis: Long = 60 * 60_000L,
+        val robotsMaxBytes: Int = 500_000,
+        /** The most a picture for her eyes may weigh. */
+        val maxImageBytes: Int = 6_000_000
+    )
+
+    /** Why something was not fetched. Logged by category only. */
+    enum class Why {
+        BAD_URL,
+        NOT_HTTPS,
+        IP_LITERAL,
+        LOCAL_NAME,
+        PRIVATE_ADDRESS,
+        NO_ADDRESS,
+        ROBOTS,
+        TOO_MANY_REDIRECTS,
+        WRONG_TYPE,
+        TIMEOUT,
+        HTTP_ERROR,
+        NETWORK,
+
+        /** A picture larger than the app takes. */
+        TOO_LARGE
+    }
+
+    sealed class Fetched {
+        /** What a site answered, cut at the size limit ([truncated]). */
+        class Page(
+            val url: String,
+            val finalUrl: String,
+            val contentType: String,
+            val bytes: ByteArray,
+            val truncated: Boolean
+        ) : Fetched() {
+            /** The page as text, decoded by its declared or detected charset ([Readable.decode]). */
+            fun text(): String = Readable.decode(bytes, contentType)
+
+            val host: String get() = finalUrl.toHttpUrlOrNull()?.host.orEmpty()
+        }
+
+        data class Refused(val why: Why, val status: Int? = null) : Fetched()
+    }
+
+    private val guardedDns = GuardedDns(systemDns, addressAllowed)
+
+    private val client: OkHttpClient = base.newBuilder()
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .cookieJar(CookieJar.NO_COOKIES)
+        .cache(null)
+        .proxy(Proxy.NO_PROXY)
+        .dns(guardedDns)
+        .callTimeout(limits.timeoutMillis, TimeUnit.MILLISECONDS)
+        .build()
+
+    private val paceLock = Mutex()
+    private val lastAt = HashMap<String, Long>()
+    private val robotsLock = Mutex()
+    private val robots = HashMap<String, Pair<Long, Robots.Rules>>()
+
+    /**
+     * Fetches [url] for her by the rules above. [robots] off is only for an address the app
+     * builds itself for a service's interface or a feed, never for a link or a page of a site.
+     */
+    suspend fun fetch(url: String, robots: Boolean = true): Fetched = withContext(Dispatchers.IO) {
+        var current = url.trim().toHttpUrlOrNull() ?: return@withContext Fetched.Refused(Why.BAD_URL)
+        for (hop in 0..limits.maxRedirects) {
+            refusal(current)?.let { return@withContext Fetched.Refused(it) }
+            if (robots && !robotsAllow(current)) return@withContext Fetched.Refused(Why.ROBOTS)
+            pace(current.host)
+            val result = exchange(current, ACCEPT_PAGE, limits.maxBytes)
+            when (result) {
+                is Exchange.Failed -> return@withContext Fetched.Refused(result.why)
+                is Exchange.Moved -> {
+                    current = current.resolve(result.location) ?: return@withContext Fetched.Refused(Why.BAD_URL)
+                    continue
+                }
+                is Exchange.Answered -> {
+                    if (result.status !in 200..299) return@withContext Fetched.Refused(Why.HTTP_ERROR, result.status)
+                    if (!takes(result.contentType, result.bytes)) return@withContext Fetched.Refused(Why.WRONG_TYPE, result.status)
+                    return@withContext Fetched.Page(url, current.toString(), result.contentType, result.bytes, result.truncated)
+                }
+            }
+        }
+        Fetched.Refused(Why.TOO_MANY_REDIRECTS)
+    }
+
+    /**
+     * Fetches a picture for her eyes from [url], by the same rules as a page, except what is
+     * taken: only a picture (an image type, never SVG), at most [Limits.maxImageBytes],
+     * and one cut at that size is refused rather than taken in part. A picture a page or a
+     * feed shows is fetched the way a browser shows it with the page: robots.txt, a
+     * crawler's rule for pages, is not asked. Nothing is written to disk; the bytes are the
+     * caller's to zero once it is done with them.
+     */
+    suspend fun image(url: String): Fetched = withContext(Dispatchers.IO) {
+        var current = url.trim().toHttpUrlOrNull() ?: return@withContext Fetched.Refused(Why.BAD_URL)
+        for (hop in 0..limits.maxRedirects) {
+            refusal(current)?.let { return@withContext Fetched.Refused(it) }
+            pace(current.host)
+            when (val result = exchange(current, ACCEPT_IMAGE, limits.maxImageBytes)) {
+                is Exchange.Failed -> return@withContext Fetched.Refused(result.why)
+                is Exchange.Moved -> {
+                    current = current.resolve(result.location) ?: return@withContext Fetched.Refused(Why.BAD_URL)
+                    continue
+                }
+                is Exchange.Answered -> {
+                    if (result.status !in 200..299) return@withContext Fetched.Refused(Why.HTTP_ERROR, result.status)
+                    if (!takesImage(result.contentType)) {
+                        result.bytes.fill(0)
+                        return@withContext Fetched.Refused(Why.WRONG_TYPE, result.status)
+                    }
+                    if (result.truncated) {
+                        result.bytes.fill(0)
+                        return@withContext Fetched.Refused(Why.TOO_LARGE, result.status)
+                    }
+                    return@withContext Fetched.Page(url, current.toString(), result.contentType, result.bytes, false)
+                }
+            }
+        }
+        Fetched.Refused(Why.TOO_MANY_REDIRECTS)
+    }
+
+    /** Why [url] is not fetched before anything leaves the phone, or null. The name is resolved and checked here. */
+    private fun refusal(url: HttpUrl): Why? {
+        if (!url.isHttps) return Why.NOT_HTTPS
+        hostRefusal(url.host)?.let { return it }
+        return try {
+            guardedDns.lookup(url.host)
+            null
+        } catch (e: RefusedAddress) {
+            e.why
+        } catch (e: UnknownHostException) {
+            Why.NO_ADDRESS
+        } catch (e: Exception) {
+            Why.NO_ADDRESS
+        }
+    }
+
+    private sealed class Exchange {
+        class Answered(val status: Int, val contentType: String, val bytes: ByteArray, val truncated: Boolean) : Exchange()
+        class Moved(val location: String) : Exchange()
+        class Failed(val why: Why) : Exchange()
+    }
+
+    /**
+     * One request and its answer. Cancelling the coroutine (Stop, an outing that ends)
+     * cancels the call at once, also while its body is being read.
+     */
+    private suspend fun exchange(url: HttpUrl, accept: String, maxBytes: Int): Exchange {
+        val request = Request.Builder()
+            .url(url)
+            .header("User-Agent", USER_AGENT)
+            .header("Accept", accept)
+            .get()
+            .build()
+        return try {
+            client.cancellable<Exchange>(request) { response ->
+                ledger?.count(OwnPurpose.FETCH)
+                if (response.code in REDIRECTS) {
+                    val location = response.header("Location") ?: return@cancellable Exchange.Failed(Why.HTTP_ERROR)
+                    return@cancellable Exchange.Moved(location)
+                }
+                val source = response.body.source()
+                val buffer = Buffer()
+                var total = 0L
+                while (total <= maxBytes) {
+                    val read = source.read(buffer, 8_192)
+                    if (read == -1L) break
+                    total += read
+                }
+                val truncated = total > maxBytes
+                val bytes = if (truncated) buffer.readByteArray(maxBytes.toLong()) else buffer.readByteArray()
+                Exchange.Answered(response.code, response.header("Content-Type").orEmpty(), bytes, truncated)
+            }
+        } catch (e: IOException) {
+            Exchange.Failed(failureOf(e))
+        }
+    }
+
+    private fun failureOf(e: Throwable): Why {
+        refusedIn(e)?.let { return it.why }
+        return when {
+            e is InterruptedIOException -> Why.TIMEOUT
+            e is UnknownHostException -> Why.NO_ADDRESS
+            else -> Why.NETWORK
+        }
+    }
+
+    private fun refusedIn(e: Throwable?): RefusedAddress? {
+        var cause = e
+        var depth = 0
+        while (cause != null && depth < 8) {
+            if (cause is RefusedAddress) return cause
+            cause.suppressed.firstOrNull { it is RefusedAddress }?.let { return it as RefusedAddress }
+            cause = cause.cause
+            depth++
+        }
+        return null
+    }
+
+    private suspend fun pace(host: String) {
+        val wait = paceLock.withLock {
+            val now = clock()
+            val next = (lastAt[host] ?: Long.MIN_VALUE / 2) + limits.perHostMillis
+            val at = maxOf(now, next)
+            lastAt[host] = at
+            at - now
+        }
+        if (wait > 0) pause(wait)
+    }
+
+    /** Whether robots.txt of [url]'s host lets her fetch it. */
+    private suspend fun robotsAllow(url: HttpUrl): Boolean {
+        val key = url.scheme + "://" + url.host + ":" + url.port
+        val now = clock()
+        val rules = robotsLock.withLock {
+            robots[key]?.takeIf { it.first > now }?.second
+        } ?: run {
+            val (fresh, ttl) = fetchRobots(url)
+            robotsLock.withLock { robots[key] = (clock() + ttl) to fresh }
+            fresh
+        }
+        val path = url.encodedPath + (url.encodedQuery?.let { "?$it" } ?: "")
+        return rules.allows(path)
+    }
+
+    /** robots.txt of [url]'s host, read by RFC 9309: unavailable (4xx) allows all, unreachable (5xx, no answer) allows none. */
+    private suspend fun fetchRobots(url: HttpUrl): Pair<Robots.Rules, Long> {
+        var current = url.newBuilder().encodedPath("/robots.txt").query(null).fragment(null).build()
+        for (hop in 0..limits.maxRedirects) {
+            if (refusal(current) != null) return Robots.Rules.NONE_ALLOWED to limits.robotsRetryMillis
+            when (val result = exchange(current, "text/plain,*/*;q=0.5", limits.robotsMaxBytes)) {
+                is Exchange.Failed -> return Robots.Rules.NONE_ALLOWED to limits.robotsRetryMillis
+                is Exchange.Moved -> {
+                    current = current.resolve(result.location) ?: return Robots.Rules.ALL_ALLOWED to limits.robotsTtlMillis
+                }
+                is Exchange.Answered -> return when (result.status) {
+                    in 200..299 -> Robots.parse(Readable.decode(result.bytes, result.contentType), AGENT_TOKEN) to limits.robotsTtlMillis
+                    in 400..499 -> Robots.Rules.ALL_ALLOWED to limits.robotsTtlMillis
+                    else -> Robots.Rules.NONE_ALLOWED to limits.robotsRetryMillis
+                }
+            }
+        }
+        // Past five redirects robots.txt counts as unavailable (RFC 9309, 2.3.1.2).
+        return Robots.Rules.ALL_ALLOWED to limits.robotsTtlMillis
+    }
+
+    companion object {
+        /** Generic: names the reader, never him. */
+        const val USER_AGENT = "YumeReader/1.0 (personal reader)"
+
+        /** The token robots.txt groups are matched against. */
+        const val AGENT_TOKEN = "yumereader"
+
+        private const val ACCEPT_PAGE =
+            "text/html,application/xhtml+xml,application/xml;q=0.9,application/rss+xml;q=0.9,application/atom+xml;q=0.9,application/json;q=0.8"
+
+        private const val ACCEPT_IMAGE = "image/webp,image/jpeg,image/png,image/gif;q=0.9"
+
+        private val REDIRECTS = setOf(301, 302, 303, 307, 308)
+
+        private val LOCAL_SUFFIXES = listOf(".onion", ".local", ".localhost", ".internal", ".lan", ".home", ".home.arpa", ".arpa", ".localdomain", ".intranet", ".corp")
+
+        /** Why a host name is refused before it is looked up, or null. */
+        fun hostRefusal(host: String): Why? {
+            val name = host.lowercase().trimEnd('.').removeSurrounding("[", "]")
+            if (name.isEmpty()) return Why.BAD_URL
+            if (':' in name) return Why.IP_LITERAL
+            // Dotted, decimal, octal or hex forms of an IPv4 address.
+            if (name.all { it.isDigit() || it == '.' }) return Why.IP_LITERAL
+            if (Regex("""^(?:0x[0-9a-f]+|[0-9]+)(?:\.(?:0x[0-9a-f]+|[0-9]+)){0,3}$""").matches(name)) return Why.IP_LITERAL
+            if (name == "localhost" || '.' !in name) return Why.LOCAL_NAME
+            if (LOCAL_SUFFIXES.any { name.endsWith(it) }) return Why.LOCAL_NAME
+            return null
+        }
+
+        private val TAKEN_TYPES = setOf(
+            "text/html", "application/xhtml+xml", "text/xml", "application/xml",
+            "application/rss+xml", "application/atom+xml", "application/rdf+xml", "application/json"
+        )
+
+        /** Whether a picture of [contentType] is taken: any `image/` type but SVG, which is markup and not a picture. */
+        internal fun takesImage(contentType: String): Boolean {
+            val mime = contentType.substringBefore(';').trim().lowercase()
+            return mime.startsWith("image/") && !mime.startsWith("image/svg")
+        }
+
+        /** Whether a page of [contentType] is taken. Without a type, only what opens like markup or JSON. */
+        internal fun takes(contentType: String, bytes: ByteArray): Boolean {
+            val mime = contentType.substringBefore(';').trim().lowercase()
+            if (mime.isEmpty()) {
+                val start = String(bytes, 0, minOf(bytes.size, 64), Charsets.ISO_8859_1).trimStart('﻿', ' ', '\n', '\r', '\t', 'ï', '»', '¿')
+                return start.startsWith("<") || start.startsWith("{") || start.startsWith("[")
+            }
+            return mime in TAKEN_TYPES || (mime.startsWith("application/") && (mime.endsWith("+xml") || mime.endsWith("+json")))
+        }
+    }
+}
+
+/** A name or an address refused by the fetch guard. */
+internal class RefusedAddress(val why: HerFetcher.Why) : UnknownHostException("refused by the fetch guard")
+
+/**
+ * Resolves names for [HerFetcher]: refuses what [HerFetcher.hostRefusal] refuses, and a
+ * name any of whose addresses [allowed] does not take. The connection uses exactly the
+ * addresses returned here.
+ */
+internal class GuardedDns(private val delegate: Dns, private val allowed: (InetAddress) -> Boolean) : Dns {
+    override fun lookup(hostname: String): List<InetAddress> {
+        HerFetcher.hostRefusal(hostname)?.let { throw RefusedAddress(it) }
+        val all = delegate.lookup(hostname)
+        if (all.isEmpty()) throw UnknownHostException("no address")
+        if (all.any { !allowed(it) }) throw RefusedAddress(HerFetcher.Why.PRIVATE_ADDRESS)
+        return all
+    }
+}
+
+/**
+ * Whether an address is on the public internet. Everything else is refused: loopback,
+ * unspecified, private (RFC 1918), link-local, CGNAT (100.64/10), multicast, broadcast,
+ * the documentation, benchmark and reserved ranges, unique-local IPv6 (fc00::/7), and
+ * IPv6 forms that carry an IPv4 address (mapped, compatible, NAT64, 6to4) when that
+ * address is not public; Teredo is refused outright.
+ */
+object PublicAddress {
+
+    fun isPublic(address: InetAddress): Boolean = when (address) {
+        is Inet4Address -> isPublicV4(address.address)
+        is Inet6Address -> isPublicV6(address.address)
+        else -> false
+    }
+
+    private fun u(byte: Byte): Int = byte.toInt() and 0xff
+
+    internal fun isPublicV4(b: ByteArray): Boolean {
+        if (b.size != 4) return false
+        val a = u(b[0])
+        val c = u(b[1])
+        val third = u(b[2])
+        return when {
+            a == 0 -> false
+            a == 10 -> false
+            a == 127 -> false
+            a == 100 && c in 64..127 -> false
+            a == 169 && c == 254 -> false
+            a == 172 && c in 16..31 -> false
+            a == 192 && c == 0 && third == 0 -> false
+            a == 192 && c == 0 && third == 2 -> false
+            a == 192 && c == 88 && third == 99 -> false
+            a == 192 && c == 168 -> false
+            a == 198 && c in 18..19 -> false
+            a == 198 && c == 51 && third == 100 -> false
+            a == 203 && c == 0 && third == 113 -> false
+            a >= 224 -> false
+            else -> true
+        }
+    }
+
+    internal fun isPublicV6(b: ByteArray): Boolean {
+        if (b.size != 16) return false
+        val first = u(b[0])
+        val second = u(b[1])
+        val zeroTo = { end: Int -> (0 until end).all { b[it].toInt() == 0 } }
+        // ::/128, ::1, and the IPv4-compatible ::a.b.c.d
+        if (zeroTo(12)) return if (zeroTo(16) || (zeroTo(15) && u(b[15]) == 1)) false else isPublicV4(b.copyOfRange(12, 16))
+        // IPv4-mapped ::ffff:a.b.c.d
+        if (zeroTo(10) && u(b[10]) == 0xff && u(b[11]) == 0xff) return isPublicV4(b.copyOfRange(12, 16))
+        // NAT64 64:ff9b::/96
+        if (first == 0x00 && second == 0x64 && u(b[2]) == 0xff && u(b[3]) == 0x9b) return isPublicV4(b.copyOfRange(12, 16))
+        // 6to4 2002::/16 carries an IPv4 address in its next 32 bits.
+        if (first == 0x20 && second == 0x02) return isPublicV4(b.copyOfRange(2, 6))
+        // Teredo 2001::/32 and documentation 2001:db8::/32
+        if (first == 0x20 && second == 0x01 && u(b[2]) == 0x00 && u(b[3]) == 0x00) return false
+        if (first == 0x20 && second == 0x01 && u(b[2]) == 0x0d && u(b[3]) == 0xb8) return false
+        return when {
+            (first and 0xfe) == 0xfc -> false // unique local fc00::/7
+            first == 0xfe && (second and 0xc0) == 0x80 -> false // link-local fe80::/10
+            first == 0xfe && (second and 0xc0) == 0xc0 -> false // site-local fec0::/10
+            first == 0xff -> false // multicast
+            (first and 0xe0) != 0x20 -> false // outside global unicast 2000::/3
+            else -> true
+        }
+    }
+}
+
+/**
+ * robots.txt, read the way RFC 9309 says: the group for this reader's token, else the `*`
+ * group; the longest matching rule decides, and Allow wins a tie. `*` matches anything and
+ * `$` ends a pattern.
+ */
+object Robots {
+
+    class Rules internal constructor(private val rules: List<Pair<Boolean, String>>, private val allowAll: Boolean = false, private val allowNone: Boolean = false) {
+        /** Whether [path] (path and query, beginning with /) may be fetched. */
+        fun allows(path: String): Boolean {
+            if (allowNone) return false
+            if (allowAll) return true
+            val target = if (path.isEmpty()) "/" else path
+            if (target == "/robots.txt") return true
+            var best: Pair<Boolean, String>? = null
+            for (rule in rules) {
+                if (!matches(rule.second, target)) continue
+                val current = best
+                if (current == null || rule.second.length > current.second.length ||
+                    (rule.second.length == current.second.length && rule.first && !current.first)
+                ) {
+                    best = rule
+                }
+            }
+            return best?.first ?: true
+        }
+
+        companion object {
+            val ALL_ALLOWED = Rules(emptyList(), allowAll = true)
+            val NONE_ALLOWED = Rules(emptyList(), allowNone = true)
+        }
+    }
+
+    fun parse(text: String, agent: String): Rules {
+        data class Group(val agents: MutableList<String> = ArrayList(), val rules: MutableList<Pair<Boolean, String>> = ArrayList())
+        val groups = ArrayList<Group>()
+        var current: Group? = null
+        var lastWasAgent = false
+        for (raw in text.lineSequence()) {
+            val line = raw.substringBefore('#').trim()
+            if (line.isEmpty()) continue
+            val colon = line.indexOf(':')
+            if (colon < 0) continue
+            val field = line.substring(0, colon).trim().lowercase()
+            val value = line.substring(colon + 1).trim()
+            when (field) {
+                "user-agent" -> {
+                    if (current == null || !lastWasAgent) {
+                        current = Group().also { groups += it }
+                    }
+                    current.agents += value.lowercase()
+                    lastWasAgent = true
+                }
+                "allow", "disallow" -> {
+                    lastWasAgent = false
+                    val group = current ?: continue
+                    // An empty Disallow allows everything; it adds no rule.
+                    if (value.isEmpty()) continue
+                    group.rules += (field == "allow") to value
+                }
+                else -> lastWasAgent = false
+            }
+        }
+        // Her group is the one that names her token itself, matched without case (RFC 9309,
+        // 2.2.1): not one whose name only stands inside hers, and never an empty name.
+        val token = agent.lowercase()
+        val own = groups.filter { group -> group.agents.any { it.substringBefore('/').trim() == token } }
+        val chosen = own.ifEmpty { groups.filter { "*" in it.agents } }
+        return Rules(chosen.flatMap { it.rules })
+    }
+
+    /** Whether the robots pattern [pattern] matches [path] from its start. */
+    internal fun matches(pattern: String, path: String): Boolean {
+        val anchored = pattern.endsWith("$")
+        val body = if (anchored) pattern.dropLast(1) else pattern
+        val regex = buildString {
+            append('^')
+            for (part in body.split('*').withIndex()) {
+                if (part.index > 0) append(".*")
+                append(Regex.escape(part.value))
+            }
+            if (anchored) append('$')
+        }
+        return Regex(regex).containsMatchIn(path) || Regex(regex).containsMatchIn(decodedPercent(path))
+    }
+
+    private fun decodedPercent(path: String): String = try {
+        java.net.URLDecoder.decode(path.replace("+", "%2B"), "UTF-8")
+    } catch (e: Exception) {
+        path
+    }
+}
