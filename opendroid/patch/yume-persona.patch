diff --git a/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt b/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt
new file mode 100644
index 0000000..07e7ee6
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt
@@ -0,0 +1,123 @@
+package com.opendroid.ai.core.voice
+
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import androidx.annotation.ChecksSdkIntAtLeast
+
+/**
+ * Chooses where speech is turned into text.
+ *
+ * The system's default recogniser belongs to whoever made the phone's speech service,
+ * and many of them send the audio to their servers. In wake-word mode that is the sound
+ * of the room, all the time. So recognition on the phone itself is preferred wherever the
+ * phone can do it, in this order:
+ *
+ *  1. Android 12 and later have a recogniser that is guaranteed not to leave the device.
+ *     It is used when the phone says it has one.
+ *  2. Otherwise the default recogniser is used and asked to work offline (see
+ *     [preferOffline]). The platform describes that request as "only use an offline
+ *     engine"; a service is free to honour it or to ignore it.
+ *  3. When the default recogniser says it cannot do that, it is asked again without the
+ *     request, so that voice input keeps working as it did before there was a choice.
+ *     From then on the audio may go to the speech service's servers.
+ *
+ * Which of these a listener is on is kept in a [Choice]. A step down is never taken back
+ * while the listener lives; a new listener starts from the top again.
+ */
+internal object PreferredRecognizer {
+
+    /** A recogniser, and whether it is the one that stays on the phone. */
+    class Handle(val recognizer: SpeechRecognizer, val onDevice: Boolean)
+
+    // SpeechRecognizer.ERROR_LANGUAGE_NOT_SUPPORTED and ERROR_LANGUAGE_UNAVAILABLE, which
+    // only have names from Android 12 on.
+    private const val ERROR_LANGUAGE_NOT_SUPPORTED = 12
+    private const val ERROR_LANGUAGE_UNAVAILABLE = 13
+
+    @ChecksSdkIntAtLeast(api = Build.VERSION_CODES.S)
+    fun isOnDeviceAvailable(context: Context): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && SpeechRecognizer.isOnDeviceRecognitionAvailable(context)
+
+    /**
+     * The on-device recogniser when there is one and [allowOnDevice] is true, else the
+     * default one, else null when the phone cannot recognise speech at all. Must be
+     * called on the main thread, like the platform calls it wraps.
+     */
+    fun create(context: Context, allowOnDevice: Boolean = true): Handle? {
+        if (allowOnDevice && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && isOnDeviceAvailable(context)) {
+            try {
+                return Handle(SpeechRecognizer.createOnDeviceSpeechRecognizer(context), onDevice = true)
+            } catch (e: Exception) {
+                // The phone reported one and could not start it; the default is tried next.
+            }
+        }
+        if (!SpeechRecognizer.isRecognitionAvailable(context)) return null
+        return Handle(SpeechRecognizer.createSpeechRecognizer(context), onDevice = false)
+    }
+
+    /** Asks the default recogniser to do its work without the network. */
+    fun preferOffline(intent: Intent): Intent = intent.putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
+
+    /**
+     * True when [error] says the recogniser does not have the language, or has not got
+     * it on the phone. The on-device recogniser knows fewer languages than the default
+     * one, and the default one asked to work offline has only the languages that were
+     * downloaded.
+     */
+    fun isLanguageFailure(error: Int): Boolean =
+        error == ERROR_LANGUAGE_NOT_SUPPORTED || error == ERROR_LANGUAGE_UNAVAILABLE
+
+    /** True when [error] says the recogniser wanted a network or a server and did not get one. */
+    fun isNetworkFailure(error: Int): Boolean =
+        error == SpeechRecognizer.ERROR_NETWORK ||
+            error == SpeechRecognizer.ERROR_NETWORK_TIMEOUT ||
+            error == SpeechRecognizer.ERROR_SERVER
+
+    /**
+     * What one listener has found out about the phone so far, and so what it asks for
+     * next. See the order at the top of this file.
+     */
+    class Choice {
+
+        /** False once the on-device recogniser has said it lacks the language. */
+        var allowOnDevice = true
+            private set
+
+        // False once the default recogniser has shown it cannot work offline.
+        private var offlineWorks = true
+
+        /**
+         * Whether the next request carries the offline request. The on-device recogniser
+         * needs no asking; the default one is asked until it has shown that it cannot.
+         */
+        fun asksOffline(onDevice: Boolean): Boolean = !onDevice && offlineWorks
+
+        /**
+         * Takes in [error] from a recogniser that was the on-device one or not. True when
+         * the error only says that the present choice is not to be had on this phone: the
+         * caller then listens again at once with the next one and reports nothing. False
+         * for every other error, which is reported as it always was.
+         */
+        fun onError(onDevice: Boolean, error: Int): Boolean {
+            if (onDevice) {
+                if (!isLanguageFailure(error)) return false
+                allowOnDevice = false
+                return true
+            }
+            if (!offlineWorks) return false
+            if (isLanguageFailure(error)) {
+                offlineWorks = false
+                return true
+            }
+            // Some speech services answer an offline request they cannot serve with a
+            // network or server error instead. Either way the recogniser was not working
+            // offline, so asking again buys nothing. The error may also be a real one, so
+            // it is still reported; only the next request changes.
+            if (isNetworkFailure(error)) offlineWorks = false
+            return false
+        }
+    }
+}
