index 0000000..19094c1
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/providers/TdxQuoteTest.kt
@@ -0,0 +1,129 @@
+package com.opendroid.ai.core.llm.providers
+
+import java.io.IOException
+import java.math.BigInteger
+import java.security.MessageDigest
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The quote parser is checked against quotes built byte for byte from Intel's layout, and
+ * the hash against published values and the platform's own SHA-3.
+ */
+class TdxQuoteTest {
+
+    private val reportData = ByteArray(64) { (0xa0 + it).toByte() }
+
+    @Test
+    fun `report data and the debug bit are read from a version 4 quote`() {
+        val quote = TdxQuote.parse(TestEnclave.quoteWithReportData(reportData))
+        assertEquals(4, quote.version)
+        assertArrayEquals(reportData, quote.reportData)
+        assertFalse(quote.isDebug)
+
+        assertTrue(TdxQuote.parse(TestEnclave.quoteWithReportData(reportData, debug = true)).isDebug)
+    }
+
+    @Test
+    fun `a version 5 quote is read behind its body prefix, for both report sizes`() {
+        for (bodyType in listOf(2, 3)) {
+            val quote = TdxQuote.parse(TestEnclave.quoteWithReportData(reportData, version = 5, bodyType = bodyType))
+            assertEquals(5, quote.version)
+            assertArrayEquals(reportData, quote.reportData)
+            assertFalse(quote.isDebug)
+            assertTrue(TdxQuote.parse(TestEnclave.quoteWithReportData(reportData, version = 5, bodyType = bodyType, debug = true)).isDebug)
+        }
+    }
+
+    @Test
+    fun `any bit of the under-debug group counts as debug`() {
+        val bytes = TestEnclave.quoteWithReportData(reportData)
+        bytes[48 + 120] = 0x40
+        assertTrue(TdxQuote.parse(bytes).isDebug)
+    }
+
+    @Test
+    fun `hex and base64 give the same quote`() {
+        val bytes = TestEnclave.quoteWithReportData(reportData)
+        assertArrayEquals(reportData, TdxQuote.parse(TestEnclave.hex(bytes)).reportData)
+        assertArrayEquals(reportData, TdxQuote.parse("0x" + TestEnclave.hex(bytes).uppercase()).reportData)
+        assertArrayEquals(reportData, TdxQuote.parse(TestEnclave.base64(bytes)).reportData)
+        assertArrayEquals(reportData, TdxQuote.parse(TestEnclave.base64(bytes).chunked(76).joinToString("\n")).reportData)
+        assertArrayEquals(
+            reportData,
+            TdxQuote.parse(TestEnclave.base64(bytes).replace('+', '-').replace('/', '_').trimEnd('=')).reportData
+        )
+    }
+
+    @Test
+    fun `anything that is not a whole TDX quote is refused`() {
+        val good = TestEnclave.quoteWithReportData(reportData)
+        val refused = listOf(
+            "an SGX quote" to TestEnclave.quoteWithReportData(reportData, teeType = TestEnclave.SGX),
+            "version 3" to TestEnclave.quoteWithReportData(reportData, version = 3),
+            "version 6" to TestEnclave.quoteWithReportData(reportData, version = 6),
+            "cut inside the report data" to good.copyOf(48 + 540),
+            "cut inside the header" to good.copyOf(20),
+            "a version 5 enclave report" to TestEnclave.quoteWithReportData(reportData, version = 5, bodyType = 1),
+            "a version 5 body cut short" to TestEnclave.quoteWithReportData(reportData, version = 5).copyOf(48 + 6 + 500),
+            "nothing" to ByteArray(0)
+        )
+        for ((what, bytes) in refused) {
+            assertThrows(what, IOException::class.java) { TdxQuote.parse(bytes) }
+        }
+        for (text in listOf("", "   ", "not a quote!", "zz")) {
+            assertThrows(text, IOException::class.java) { TdxQuote.parse(text) }
+        }
+    }
+
+    @Test
+    fun `a version 5 quote that declares too small a body is refused`() {
+        val bytes = TestEnclave.quoteWithReportData(reportData, version = 5)
+        bytes[48 + 2] = 0x10 // declared body size: 16 bytes
+        bytes[48 + 3] = 0
+        assertThrows(IOException::class.java) { TdxQuote.parse(bytes) }
+    }
+
+    @Test
+    fun `the hash matches published Keccak-256 values`() {
+        assertEquals(
+            "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470",
+            VeniceE2ee.hex(Keccak256.digest(ByteArray(0)))
+        )
+        assertEquals(
+            "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45",
+            VeniceE2ee.hex(Keccak256.digest("abc".toByteArray()))
+        )
+        assertEquals(
+            "4d741b6f1eb29cb2a9b9911c82f56fa8d73b04959d3d9d222895df6c0b28aa15",
+            VeniceE2ee.hex(Keccak256.digest("The quick brown fox jumps over the lazy dog".toByteArray()))
+        )
+    }
+
+    @Test
+    fun `the same code with SHA-3 padding agrees with the platform at every length`() {
+        // Keccak-256 and SHA3-256 differ only in the first padding byte, so this checks the
+        // permutation and the block handling, around the 136-byte block size in particular.
+        val sha3 = MessageDigest.getInstance("SHA3-256")
+        for (length in (0..300) + listOf(407, 408, 409, 1000)) {
+            val input = ByteArray(length) { (it * 31 + length).toByte() }
+            assertArrayEquals("length $length", sha3.digest(input), Keccak256.sponge(input, 0x06))
+        }
+    }
+
+    @Test
+    fun `addresses match the well known ones for private keys 1 and 2`() {
+        val expected = mapOf(
+            1L to "7e5f4552091a69125d5dfcb7b8c2659029395bdf",
+            2L to "2b5ad5c4795c026514f8317c7a215e218dccd6cf"
+        )
+        for ((privateKey, address) in expected) {
+            val publicKey = Secp256k1.encode(Secp256k1.multiply(Secp256k1.G, BigInteger.valueOf(privateKey)))
+            assertEquals(address, VeniceE2ee.hex(VeniceE2ee.ethereumAddress(publicKey)))
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/providers/TestEnclave.kt b/app/src/test/java/com/opendroid/ai/core/llm/providers/TestEnclave.kt
new file mode 100644
index 0000000..bb0ec9b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/providers/TestEnclave.kt
@@ -0,0 +1,83 @@
+package com.opendroid.ai.core.llm.providers
+
+import java.util.Base64
+
+/**
+ * Builds what an enclave would serve, for tests: an Intel TDX quote laid out byte for
+ * byte as the specification describes it, and the attestation answer that carries it.
+ * The quote is not signed, which is all the app's checks ask of it (see
+ * [VeniceE2ee.modelKeyFromAttestation]).
+ */
+internal object TestEnclave {
+
+    private const val TDX = 0x81
+    const val SGX = 0x00
+
+    /** A quote whose report data binds [keyHex] and [nonceHex] the way the live service does. */
+    fun quote(
+        keyHex: String,
+        nonceHex: String,
+        version: Int = 4,
+        debug: Boolean = false,
+        teeType: Int = TDX,
+        bodyType: Int = 2
+    ): ByteArray {
+        val key = VeniceE2ee.unhex(if (keyHex.length == 128) "04$keyHex" else keyHex)
+        return quoteWithReportData(
+            VeniceE2ee.ethereumAddress(key) + ByteArray(12) + VeniceE2ee.unhex(nonceHex),
+            version, debug, teeType, bodyType
+        )
+    }
+
+    fun quoteWithReportData(
+        reportData: ByteArray,
+        version: Int = 4,
+        debug: Boolean = false,
+        teeType: Int = TDX,
+        bodyType: Int = 2
+    ): ByteArray {
+        require(reportData.size == 64)
+        val header = ByteArray(48)
+        header[0] = version.toByte()          // version, little-endian
+        header[2] = 2                         // attestation key type: ECDSA P-256
+        header[4] = teeType.toByte()          // TEE type, little-endian
+        for (i in 12 until 28) header[i] = 0x51 // QE vendor id, any value
+
+        // TD report 1.0 is 584 bytes; 1.5 appends 64 more.
+        val body = ByteArray(if (bodyType == 3) 648 else 584) { (it % 251).toByte() }
+        for (i in 120 until 128) body[i] = 0  // TD attributes
+        if (debug) body[120] = 0x01
+        body[123] = 0x10                      // SEPT_VE_DISABLE, set on real guests; not a debug bit
+        System.arraycopy(reportData, 0, body, 520, 64)
+
+        val signature = ByteArray(4 + 64) { 0x33 }.also { it[0] = 64; it[1] = 0; it[2] = 0; it[3] = 0 }
+        return when (version) {
+            5 -> header + byteArrayOf(bodyType.toByte(), 0) + littleEndian32(body.size) + body + signature
+            else -> header + body + signature
+        }
+    }
+
+    fun hex(quote: ByteArray): String = VeniceE2ee.hex(quote)
+
+    fun base64(quote: ByteArray): String = Base64.getEncoder().encodeToString(quote)
+
+    /** The attestation answer for [model] and [nonce]; pass null to leave a field out. */
+    fun attestation(
+        model: String?,
+        nonce: String?,
+        keyHex: String?,
+        quote: String?,
+        verified: String = "true",
+        keyField: String = "signing_key"
+    ): String = buildList {
+        add("\"verified\":$verified")
+        nonce?.let { add("\"nonce\":\"$it\"") }
+        model?.let { add("\"model\":\"$it\"") }
+        keyHex?.let { add("\"$keyField\":\"$it\"") }
+        quote?.let { add("\"intel_quote\":\"$it\"") }
+        add("\"tee_provider\":\"test\"")
+    }.joinToString(",", "{", "}")
+
+    private fun littleEndian32(value: Int): ByteArray =
+        byteArrayOf(value.toByte(), (value shr 8).toByte(), (value shr 16).toByte(), (value shr 24).toByte())
+}
