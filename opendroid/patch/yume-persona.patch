+            assertTrue(PersonaPrompts.isPrivateResult(app("x", badge = PersonaPrompts.appRowBadge(true, badge))))
+        }
+    }
+
+    @Test
+    fun `the planner's reasons for going on do not push what the phone did out of her prompt`() {
+        val goesOn = PersonaPrompts.PLANNER_GOES_ON_PREFIX
