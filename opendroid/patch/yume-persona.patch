+++ b/app/src/main/java/com/opendroid/ai/core/llm/providers/VeniceE2eeMessages.kt
@@ -0,0 +1,354 @@
+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.google.gson.JsonPrimitive
+import com.opendroid.ai.data.models.ChatMessage
+import java.io.IOException
+import java.math.BigInteger
+import okio.BufferedSource
+
+/** Shapes a request for the encrypted exchange and reads the encrypted reply. */
+internal object VeniceE2eeMessages {
+
+    /**
+     * A request as it is sent on this path. [marked] is true when the transcript inside
+     * [system] carries the persona's marks, which the reply may then echo ([unfoldReply]).
+     */
+    class Folded(val system: String, val user: String, val marked: Boolean = false)
+
+    /** The heading over the transcript inside the system text. */
+    private const val EARLIER_HEADING = "=== EARLIER IN THIS CONVERSATION (oldest first) ==="
+
+    /**
+     * What stands in front of his lines and hers in the transcript of a persona request.
+     * They are marks of the app's and must not be mistaken for anything she writes: she
+     * types no brackets, while "he:" at the start of a line is how she tells what
+     * somebody said.
+     */
+    private const val HIS_MARK = "[he]"
+    private const val HER_MARK = "[you]"
+
+    /**
+     * Venice's guide encrypts system and user messages only, which would leave an
+     * assistant message in the clear; in practice the enclave refuses a request with any
+     * unencrypted message, and takes at most one system message. Folding satisfies both
+     * readings: the earlier conversation, her side included, goes into the one encrypted
+     * system text, and only the newest message, when it is his, is sent as the user turn.
+     * Images are left out: this path is text only, and an image part cannot be encrypted.
+     *
+     * The messages stay in the order they were said. When the newest one is not his (a
+     * line of hers stored after his), all of them go into the transcript and the user
+     * turn only asks the model to go on.
+     *
+     * For a request of the persona's own ([persona]) the lines of the transcript are
+     * marked "[he]" and "[you]". "User:" and "You:" pull a model towards the assistant it
+     * was trained as, and a transcript invites it to write his next line as well; see
+     * [unfoldReply].
+     */
+    fun fold(systemPrompt: String, messages: List<ChatMessage>, persona: Boolean = false): Folded {
+        val newestIsHis = messages.lastOrNull()?.sender == ChatMessage.Sender.USER
+        val earlier = (if (newestIsHis) messages.dropLast(1) else messages).filter { it.text.isNotBlank() }
+        val system = if (earlier.isEmpty()) {
+            systemPrompt
+        } else {
+            buildString {
+                append(systemPrompt.trimEnd())
+                append("\n\n").append(EARLIER_HEADING).append('\n')
+                earlier.forEach { message ->
+                    val his = message.sender == ChatMessage.Sender.USER
+                    val who = if (persona) (if (his) HIS_MARK else HER_MARK) else (if (his) "User:" else "You:")
+                    append(who).append(' ').append(message.text.trim()).append('\n')
+                }
+            }.trimEnd()
+        }
+        val user = messages.lastOrNull()?.takeIf { newestIsHis }?.text?.takeIf { it.isNotBlank() } ?: "(continue)"
+        return Folded(system, user, marked = persona && earlier.isNotEmpty())
+    }
+
+    private val LEADING_HER_MARK = Regex("""^\s*\[you\][ \t]*""", RegexOption.IGNORE_CASE)
+    private val OPENS_WITH_HIS_LINE = Regex("""^\s*\[he\]""", RegexOption.IGNORE_CASE)
+    private val HIS_LINE = Regex("""(?im)^[ \t]*\[he\]""")
+    private val HER_LINE = Regex("""(?im)^[ \t]*\[you\][ \t]*""")
+
+    /**
+     * A reply with the transcript's marks taken off. [endedAtHisMark] is true when the
+     * reply was ended at a line the model went on to write for him: what stands in
+     * [text] is then whole, whatever stopped the model further down.
+     */
+    class Unfolded(val text: String, val endedAtHisMark: Boolean)
+
+    /**
+     * Takes the transcript's marks off a reply to a folded persona request ([marked]: the
+     * request carried them). A model that was shown "[he] ... [you] ..." may start its
+     * answer with "[you]", may say his last line over before it answers, and may go on to
+     * write his next line and an answer to it. The marks are not part of what she said,
+     * and a line the model made up for him, with what it then wrote on, is not her reply
+     * to anything he said.
+     *
+     * Nothing she wrote is touched. Only the app's own marks count, never "he:" or
+     * "you:": a line such as "he: where you live" is her telling what somebody said. She
+     * types no brackets, so a line that starts with "[he]" is never hers:
+     *
+     *  - Where the reply opens with lines marked his and a line marked hers follows, her
+     *    reply is what follows that first mark of hers.
+     *  - The reply ends at the first line marked his that stands behind something of hers,
+     *    whether or not the model wrote an answer to it as well.
+     *
+     * A reply that would be left with nothing is handed on as it came.
+     *
+     * A request that carried no marks gets its reply back as it came. A moment of her own
+     * is such a request: its one turn is the app's and no talk is folded in front of it,
+     * so a thought of hers that begins with "he:", or with anything else, costs her
+     * nothing she wrote after it.
+     */
+    fun unfold(reply: String, marked: Boolean): Unfolded {
+        if (!marked) return Unfolded(reply, endedAtHisMark = false)
+        val asItCame = LEADING_HER_MARK.replaceFirst(reply, "")
+        var own = asItCame
+        if (OPENS_WITH_HIS_LINE.containsMatchIn(own)) {
+            val hers = HER_LINE.find(own) ?: return Unfolded(asItCame, endedAtHisMark = false)
+            own = own.substring(hers.range.last + 1)
+        }
+        val writtenOn = HIS_LINE.find(own)
+            ?: return Unfolded(own.ifBlank { asItCame }, endedAtHisMark = false)
+        val hers = own.substring(0, writtenOn.range.first).trimEnd()
+        return if (hers.isBlank()) Unfolded(asItCame, endedAtHisMark = false) else Unfolded(hers, endedAtHisMark = true)
+    }
+
+    /** [unfold], for a caller that only wants the text. */
+    fun unfoldReply(reply: String, marked: Boolean): String = unfold(reply, marked).text
+
+    /**
+     * The two messages of a request, each encrypted to [modelKey]. There is exactly one
+     * system message and one user message, and neither carries anything but ciphertext.
+     */
+    fun sealedMessages(folded: Folded, modelKey: String): List<Map<String, String>> = listOf(
+        mapOf("role" to "system", "content" to VeniceE2ee.encrypt(folded.system, modelKey)),
+        mapOf("role" to "user", "content" to VeniceE2ee.encrypt(folded.user, modelKey))
+    )
+
+    /**
+     * Request options that may ride along in the clear: numbers and switches that shape
+     * how the model samples and reasons. Everything else is left out, whatever asked for
+     * it. Venice relays the body unencrypted, so anything in it is readable to Venice.
+     */
+    private val NUMBER_OPTIONS = setOf(
+        "temperature", "top_p", "top_k", "min_p", "min_temp", "max_temp",
+        "frequency_penalty", "presence_penalty", "repetition_penalty", "seed",
+        "max_tokens", "max_completion_tokens"
+    )
+    private val REASONING_OPTIONS = setOf("effort", "enabled", "exclude", "max_tokens")
+
+    /**
+     * `venice_parameters` entries that only shape the reply. The rest search the web,
+     * name a public character or switch the encryption off.
+     */
+    private val VENICE_SWITCHES = setOf("include_venice_system_prompt", "strip_thinking_response", "disable_thinking")
+
+    private val TOKEN_LIMIT_OPTIONS = listOf("max_tokens", "max_completion_tokens")
+
+    /** A switch's value is a number, true or false, or one short word; never a text. */
+    private const val MAX_OPTION_WORD_CHARS = 32
+
+    /**
+     * The body of an encrypted request. [asked] is what the request and the settings
+     * want in it (see [OpenAiCompatExtras.mergeExtraBody]); only the options named above
+     * are taken from it.
+     *
+     * Never present, whatever [asked] holds: `tools`, `tool_choice`, `response_format`
+     * and anything else that carries text. Venice drops tool definitions on this path
+     * without saying so and would have them in the clear; a plan is asked for as JSON in
+     * the encrypted system text instead. `venice_parameters.enable_e2ee` is always true:
+     * false would turn the request into one Venice can read.
+     */
+    fun requestBody(model: String, asked: Map<String, Any>, messages: List<Map<String, String>>): Map<String, Any> {
+        val body = mutableMapOf<String, Any>()
+        for ((key, value) in asked) {
+            when {
+                key in NUMBER_OPTIONS -> if (number(value) != null) body[key] = value
+                key == "reasoning_effort" -> if (isSwitchValue(value)) body[key] = value
+                key == "reasoning" -> switches(value, REASONING_OPTIONS)?.let { body[key] = it }
+            }
+        }
+        // Reasoning is paid for out of the same limit as the answer; see MIN_OUTPUT_TOKENS.
+        for (key in TOKEN_LIMIT_OPTIONS) {
+            val limit = body[key]?.let(::number) ?: continue
+            if (limit < VeniceE2ee.MIN_OUTPUT_TOKENS) body[key] = VeniceE2ee.MIN_OUTPUT_TOKENS
+        }
+        val venice = switches(asked["venice_parameters"], VENICE_SWITCHES).orEmpty().toMutableMap()
+        venice["enable_e2ee"] = true
+        body["venice_parameters"] = venice
+        body["model"] = model
+        body["stream"] = true
+        if (messages.any { !VeniceE2ee.looksEncrypted(it["content"].orEmpty()) }) {
+            throw IOException("A message was not encrypted")
+        }
+        body["messages"] = messages
+        return body
+    }
+
+    /** The entries of a JSON object named in [allowed] whose values are switch values; null when there are none. */
+    private fun switches(value: Any?, allowed: Set<String>): Map<String, Any>? {
+        val source = (value as? JsonElement)?.takeIf { it.isJsonObject }?.asJsonObject ?: return null
+        val kept = source.entrySet()
+            .filter { (name, entry) -> name in allowed && isSwitchValue(entry) }
+            .associate { (name, entry) -> name to (entry as Any) }
+        return kept.takeIf { it.isNotEmpty() }
+    }
+
+    private fun isSwitchValue(value: Any?): Boolean = when (value) {
+        is Number, is Boolean -> true
+        is String -> value.length <= MAX_OPTION_WORD_CHARS
+        is JsonPrimitive -> !value.isString || value.asString.length <= MAX_OPTION_WORD_CHARS
+        else -> false
+    }
+
+    private fun number(value: Any): Double? = when (value) {
+        is Number -> value.toDouble()
+        is JsonPrimitive -> if (value.isNumber) value.asDouble else null
+        else -> null
+    }
+
+    /**
+     * A decrypted reply and, where the stream said so, why it ended and the token counts
+     * of its `usage` block. Both travel in the clear beside the encrypted pieces.
+     */
+    class Reply(val text: String, val finishReason: String?, val promptTokens: Int? = null, val completionTokens: Int? = null)
+
+    /**
+     * Reads the reply, which arrives as server-sent events whose content pieces are each
+     * encrypted to [privateKey]'s public key. A reply that arrives as one JSON object
+     * instead is read the same way. Reading stops at the end marker.
+     *
+     * Fails rather than return anything that was readable on the way: a piece of the
+     * reply that is not ciphertext means the exchange was not private, and it is never
+     * shown as her reply. The model's reasoning arrives encrypted beside the reply; it is
+     * dropped unread, and if it arrives in plain text that fails the exchange too.
+     *
+     * The other way round does not hold. A reply made of ciphertext only was unreadable
+     * on the way, but that does not prove who wrote it or that it is complete: the pieces
+     * are encrypted to a public key the relay can see and are not signed, each one on its
+     * own, so a relay could drop, reorder or add pieces without this noticing. See
+     * [VeniceE2ee.modelKeyFromAttestation] for the whole list of what is taken on trust.
+     * The reason the reply ended travels beside the pieces in the clear and is the
+     * relay's word: it is used to mark a reply as cut off, never to decide what she said.
+     *
+     * A stream that stops without its end marker and without having said why the reply
+     * ended has broken off on the way, and so has one that carries an error. What arrived
+     * until then is not handed on as a reply ([ReplyBrokeOffException]): its last line
+     * could be half a command of hers, and nothing would mark it as unfinished. This
+     * catches a relay or an enclave that fails; a relay that means to shorten a reply can
+     * still send the marker early, which is among what is taken on trust.
+     */
+    fun readReply(source: BufferedSource, privateKey: BigInteger): Reply {
+        val text = StringBuilder()
+        val unframed = StringBuilder()
+        // One key agreement per sender key for the whole reply, not one per piece.
+        val derivedKeys = HashMap<String, ByteArray>()
+        var finishReason: String? = null
+        var usage: Pair<Int?, Int?>? = null
+        var sawEvents = false
+        // Whether the stream said that the reply was over: the end marker, or a reason.
+        var ended = false
+        while (true) {
+            val line = source.readUtf8Line() ?: break
+            if (line.startsWith("data:")) {
+                sawEvents = true
+                val data = line.removePrefix("data:").trim()
+                if (data == "[DONE]") {
+                    ended = true
+                    break
+                }
+                if (data.isEmpty()) continue
+                val event = parse(data) ?: continue
+                if (carriesError(event)) throw ReplyBrokeOffException("the stream carried an error")
+                if (saysWhyItEnded(event)) ended = true
+                finishReasonOf(event)?.let { finishReason = it }
+                usageOf(event)?.let { usage = it }
+                val piece = holder(event, "delta") ?: continue
+                text.append(open(piece, privateKey, derivedKeys))
+            } else if (!sawEvents) {
+                unframed.append(line)
+            }
+        }
+        if (sawEvents && !ended) throw ReplyBrokeOffException("the stream stopped before the reply was finished")
+        if (!sawEvents && unframed.isNotBlank()) {
+            // A reply sent as one document is whole once it parses.
+            parse(unframed.toString())?.let { whole ->
+                if (carriesError(whole)) throw ReplyBrokeOffException("the answer was an error")
+                finishReasonOf(whole)?.let { finishReason = it }
+                usageOf(whole)?.let { usage = it }
+                holder(whole, "message")?.let { text.append(open(it, privateKey, derivedKeys)) }
+            }
+        }
+        return Reply(text.toString(), finishReason, usage?.first, usage?.second)
+    }
+
+    /** `usage.prompt_tokens` and `usage.completion_tokens` of an event, or null when it carries no usage block. */
+    private fun usageOf(root: JsonObject): Pair<Int?, Int?>? {
+        val usage = root.get("usage")?.takeIf { it.isJsonObject }?.asJsonObject ?: return null
+        fun count(key: String): Int? = usage.get(key)
+            ?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isNumber }
+            ?.let { runCatching { it.asInt }.getOrNull() }
+            ?.takeIf { it >= 0 }
+        return count("prompt_tokens") to count("completion_tokens")
+    }
+
+    /** True for an event, or a whole answer, that is an error and not part of a reply. */
+    private fun carriesError(root: JsonObject): Boolean =
+        root.get("error")?.let { !it.isJsonNull } == true && firstChoice(root) == null
+
+    /** True when [root] names a reason the reply ended, whatever the reason is. */
+    private fun saysWhyItEnded(root: JsonObject): Boolean =
+        firstChoice(root)?.let { stringField(it, "finish_reason") } != null
+
+    private fun finishReasonOf(root: JsonObject): String? =
+        firstChoice(root)?.let { stringField(it, "finish_reason") }?.takeIf { it.length <= MAX_OPTION_WORD_CHARS }
+
+    private val REASONING_FIELDS = listOf("reasoning_content", "reasoning")
+
+    private fun open(piece: JsonObject, privateKey: BigInteger, derivedKeys: MutableMap<String, ByteArray>): String {
+        for (field in REASONING_FIELDS) {
+            val reasoning = stringField(piece, field) ?: continue
+            if (reasoning.isNotBlank() && !VeniceE2ee.looksEncrypted(reasoning)) {
+                throw E2eeProtocolException("the reasoning was not encrypted")
+            }
+        }
+        val raw = piece.get("content")
+        if (raw != null && !raw.isJsonNull && !(raw.isJsonPrimitive && raw.asJsonPrimitive.isString)) {
+            // Content given as parts or an object is plain text in another shape.
+            throw E2eeProtocolException("the reply was not encrypted")
+        }
+        val content = stringField(piece, "content") ?: return ""
+        return when {
+            VeniceE2ee.looksEncrypted(content) -> try {
+                VeniceE2ee.decrypt(content, privateKey, derivedKeys)
+            } catch (e: IOException) {
+                throw E2eeProtocolException("a piece of the reply could not be opened")
+            }
+            // Spacing between encrypted pieces is sent as it is and says nothing about the
+            // reply; the reference client lets it through for the same reason.
+            content.isBlank() -> content
+            else -> throw E2eeProtocolException("the reply was not encrypted")
+        }
+    }
+
+    private fun parse(json: String): JsonObject? = try {
+        JsonParser.parseString(json).takeIf { it.isJsonObject }?.asJsonObject
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun firstChoice(root: JsonObject): JsonObject? =
+        root.get("choices")?.takeIf { it.isJsonArray }?.asJsonArray?.firstOrNull()
+            ?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun holder(root: JsonObject, name: String): JsonObject? =
+        firstChoice(root)?.get(name)?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun stringField(holder: JsonObject, name: String): String? =
+        holder.get(name)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+            ?.takeIf { it.isNotEmpty() }
+}
