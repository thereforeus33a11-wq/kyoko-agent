+        // A step that ran as written names nothing in its place.
+        val plain = PlanEntries.of(plan(step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "hi"))), his,
+            PlanEntries.Ending.Finished(isSuccess = true))!!
+        assertNull(plain.steps.single().insteadOf)
+    }
+
+    @Test
+    fun `a fallback does not bring back a secret of the action it stands in for`() {
+        // On a sensitive action every parameter it does not declare is a secret; on a plain one it is not.
+        val entry = PlanEntries.of(
+            plan(step("s1", "SAVE_SENSITIVE_INFO", mapOf("key" to "locker", "message" to "combination 4589")).copy(fallback = "SEND_SMS")),
+            his,
+            PlanEntries.Ending.Finished(isSuccess = true),
+            ranAs = { PlanEntries.AsRun(action = "SEND_SMS") }
+        )!!
+        assertEquals("Send SMS", entry.steps.single().kind)
+        assertFalse(stored(entry).contains("4589"))
+    }
+
+    @Test
+    fun `the words he gave when a step asked for them are the words it sent`() {
+        val entry = PlanEntries.of(
+            plan(step("s1", "SEND_SMS", mapOf("contact" to "Mom"))),
+            his,
+            PlanEntries.Ending.Finished(isSuccess = true),
+            ranAs = { PlanEntries.AsRun(given = mapOf("message" to "on my way")) }
+        )!!
+        assertEquals(listOf(SentWords("message", "on my way")), entry.steps.single().words)
+    }
+
+    @Test
+    fun `what he gave is noted without a secret`() {
+        assertEquals(
+            mapOf("label" to "gym locker"),
+            PlanStarts.kept("SAVE_SENSITIVE_INFO", mapOf("label" to "gym locker", "secret" to "4589"))
+        )
+        // On a sensitive action a parameter it does not declare is a secret too.
+        assertEquals(emptyMap<String, String>(), PlanStarts.kept("SAVE_SENSITIVE_INFO", mapOf("pin" to "4589")))
+        // And a parameter that is a secret on any action is never kept, whatever the step is.
+        assertEquals(mapOf("message" to "on my way"), PlanStarts.kept("SEND_SMS", mapOf("message" to "on my way", "secret" to "4589", "contact" to " ")))
+    }
+
+    @Test
+    fun `how often a plan went on the record is counted`() {
+        val notes = PlanStarts()
+        assertEquals(0, notes.timesRecorded("p"))
+        notes.recorded("p")
+        notes.recorded("p")
+        assertEquals(2, notes.timesRecorded("p"))
+    }
+
+    @Test
+    fun `the notes of how a plan ran, a fallback, what he gave, and a fresh start`() {
+        val notes = PlanStarts()
+        notes.valuesGiven("p", "s1", "SEND_WHATSAPP", mapOf("message" to "late"))
+        notes.valuesGiven("p", "s1", "SEND_WHATSAPP", mapOf("message" to "late", "contact" to "Mom Sato"))
+        assertEquals(PlanEntries.AsRun(given = mapOf("message" to "late", "contact" to "Mom Sato")), notes.asRun("p", "s1"))
+        // The fallback runs with the step's own parameters: what was given to the first try does not carry over.
+        notes.fallbackRan("p", "s1", "SEND_SMS")
+        assertEquals(PlanEntries.AsRun(action = "SEND_SMS"), notes.asRun("p", "s1"))
+        notes.stepStarted("p", "s1")
+        assertNull(notes.asRun("p", "s1"))
+
+        // Only the newest plans are kept.
+        val few = PlanStarts(max = 2)
+        listOf("a", "b", "c").forEach { few.fallbackRan(it, "s1", "SEND_SMS") }
+        assertNull(few.asRun("a", "s1"))
+        assertEquals("SEND_SMS", few.asRun("c", "s1")?.action)
+    }
+
+    @Test
+    fun `what the phone put on the clipboard is kept, and what it read off the clipboard is not`() {
+        val entry = PlanEntries.of(
+            plan(
+                step("s1", "GET_CLIPBOARD", result = "Clipboard contains: \"the door code is 7731\""),
+                step("s2", "COPY_TO_CLIPBOARD", mapOf("text" to "meet at 8, Shibuya exit")),
+                step("s3", "COPY_TO_CLIPBOARD", mapOf("text" to "\$s1"))
+            ),
+            his,
+            PlanEntries.Ending.Finished(isSuccess = true)
+        )!!
+        assertEquals(emptyList<SentWords>(), entry.steps[0].words)
+        assertEquals(listOf(SentWords("text", "meet at 8, Shibuya exit")), entry.steps[1].words)
+        assertEquals(listOf(SentWords("text", "[the answer to step 1]")), entry.steps[2].words)
+        assertFalse(stored(entry).contains("7731"))
+    }
+
+    @Test
+    fun `an entry is dated by when it ended as well as when it began`() {
+        val entry = PlanEntries.of(
+            plan(step("s1", "TOGGLE_WIFI")),
+            his,
+            PlanEntries.Ending.Finished(isSuccess = true),
+            endedAtMillis = 9_000L
+        )!!
+        assertEquals(1_000L, entry.at)
+        assertEquals(9_000L, entry.endedAt)
+        assertEquals(9_000L, entry.lastAt)
+        // Without an end, it goes by when it began.
+        assertEquals(1_000L, PlanEntries.of(plan(step("s1", "TOGGLE_WIFI")), his, PlanEntries.Ending.Finished(isSuccess = true))!!.lastAt)
+    }
+
+    @Test
+    fun `a run whose end is not known, with nothing failed, is told as that`() {
+        val unknown = PhoneLogStep("Auto-reply", "Auto-reply", end = StepEnd.UNKNOWN)
+        assertEquals(Outcome.UNKNOWN, PlanEntries.outcomeOf(listOf(unknown), PlanEntries.Ending.Finished(isSuccess = true)))
+        val done = PhoneLogStep("Toggle wifi", "Toggle wifi", end = StepEnd.DONE)
+        assertEquals(Outcome.UNKNOWN, PlanEntries.outcomeOf(listOf(done, unknown), PlanEntries.Ending.Finished(isSuccess = true)))
+    }
+}
