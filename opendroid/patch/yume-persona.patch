+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.agent.DeviceStateProvider
+import com.opendroid.ai.core.memory.EpisodicMemory
+import com.opendroid.ai.core.memory.MemoryExtractor
+import com.opendroid.ai.core.memory.MemoryManager
+import com.opendroid.ai.core.memory.NotificationIntelligence
+import com.opendroid.ai.core.memory.ProceduralMemory
+import com.opendroid.ai.core.memory.SemanticMemory
+import com.opendroid.ai.core.memory.WorkingMemory
+import com.opendroid.ai.core.memory.graph.PersonalGrowthEngine
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.SensitiveMemoryStore
+import com.opendroid.ai.core.security.UserProfile
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.ConversationRepository
+import com.opendroid.ai.data.repository.MemoryRepository
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * Her notebook lives in the shared memories table. It must reach her chat prompt and
+ * nothing else: the same table feeds the planner's context, which writes device plans
+ * and the bodies of messages sent to other people.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaMemoryTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memoryRepository: MemoryRepository
+    private lateinit var manager: MemoryManager
+    private lateinit var personaMemory: PersonaMemory
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        val conversationRepository = ConversationRepository(
+            database,
+            database.conversationDao(),
+            database.chatSessionDao()
+        )
+        val extractor = MemoryExtractor(memoryRepository)
+        val workingMemory = WorkingMemory(context, DeviceStateProvider(context))
+        val notificationIntelligence = NotificationIntelligence(database.notificationDao(), memoryRepository)
+        manager = MemoryManager(
+            workingMemory = workingMemory,
+            episodicMemory = EpisodicMemory(conversationRepository),
+            semanticMemory = SemanticMemory(memoryRepository, extractor),
+            proceduralMemory = ProceduralMemory(memoryRepository),
+            personalGrowthEngine = PersonalGrowthEngine(
+                memoryRepository = memoryRepository,
+                sensitiveMemoryStore = NoSensitiveMemory,
+                workingMemory = workingMemory,
+                notificationIntelligence = notificationIntelligence
+            ),
+            memoryExtractor = extractor,
+            conversationRepository = conversationRepository,
+            memoryRepository = memoryRepository,
+            notificationIntelligence = notificationIntelligence,
+            userProfileStore = NoProfile,
+            context = context
+        )
+        personaMemory = PersonaMemory(memoryRepository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `her notes never enter the context the planner sees`() = runBlocking {
+        memoryRepository.saveMemory(Memory("wife_name", "Sara", MemoryType.SEMANTIC))
+        personaMemory.apply(
+            listOf(
+                Note(Kind.OPINION, "jokes", "his jokes are trash and she tells him so"),
+                Note(Kind.USER, "bee", "he keeps 9 hives")
+            )
+        )
+
+        val plannerContext = manager.getRelevantContext("text my wife i am late")
+
+        assertTrue(plannerContext, plannerContext.contains("wife_name: Sara"))
+        assertFalse(plannerContext, plannerContext.contains("trash"))
+        assertFalse(plannerContext, plannerContext.contains("hives"))
+        assertFalse(plannerContext, plannerContext.contains(PersonaNotes.KEY_PREFIX))
+    }
+
+    @Test
+    fun `recall and saved notes never hand her notebook back as an action result`() = runBlocking {
+        memoryRepository.saveMemory(Memory("note_garage", "Title: garage code 4410", MemoryType.SEMANTIC))
+        personaMemory.seedIfNeeded(
+            listOf(
+                Note(Kind.USER, "hive", "he keeps 9 hives and remembers me asking about it"),
+                Note(Kind.THREAD, "boots", "street story: Title: the boots i want | open")
+            )
+        )
+        personaMemory.recordCheckIn(1_700_000_000_000)
+
+        val unused = dagger.Lazy<com.opendroid.ai.core.agent.VisionEngine> { error("not used") }
+        val unusedGraph = dagger.Lazy<PersonalGrowthEngine> { error("not used") }
+        val actions = com.opendroid.ai.actions.CalendarActions(memoryRepository, unused, unusedGraph).getActions()
+        val recall = actions.single { it.name == "RECALL_MEMORY" }
+        val readNotes = actions.single { it.name == "READ_NOTES" }
+
+        // "me" is inside the key prefix itself, and the other words are in her notes or keys.
+        for (query in listOf("me", "yume", "user", "thread", "meta", "hive", "boots", "1")) {
+            val said = recall.execute(mapOf("query" to query), context).data.orEmpty()
+            assertFalse("$query -> $said", said.contains("hives and remembers"))
+            assertFalse("$query -> $said", said.contains("street story"))
+            assertFalse("$query -> $said", said.contains("1700000000000"))
+        }
+        val garage = recall.execute(mapOf("query" to "garage"), context).data.orEmpty()
+        assertTrue(garage, garage.contains("4410"))
+
+        val notes = readNotes.execute(emptyMap(), context).data.orEmpty()
+        assertTrue(notes, notes.contains("4410"))
+        assertFalse(notes, notes.contains("street story"))
+
+        assertTrue(manager.searchMemory("me").none { it.key.startsWith(PersonaNotes.KEY_PREFIX) })
+        assertTrue(memoryRepository.getMemoriesByType(MemoryType.SEMANTIC).none { it.key.startsWith(PersonaNotes.KEY_PREFIX) })
+        assertEquals(2, personaMemory.notes().size)
+    }
+
+    @Test
+    fun `notes come back newest first and ordinary memories are not notes`() = runBlocking {
+        memoryRepository.saveMemory(Memory("yumexuser_bee", "not hers: the LIKE wildcard must not match", MemoryType.SEMANTIC))
+        memoryRepository.saveMemory(Memory("yume.user.bee", "he keeps 9 hives", MemoryType.SEMANTIC, timestamp = 1_000))
+        memoryRepository.saveMemory(Memory("yume.rel.stage", "a while in, at ease", MemoryType.SEMANTIC, timestamp = 2_000))
+
+        assertEquals(listOf("stage", "bee"), personaMemory.notes().map { it.key })
+    }
+
+    @Test
+    fun `a known key is replaced and a closed thread is removed`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig still missing | open")))
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig half done | open")))
+        assertEquals(listOf("rig half done | open"), personaMemory.notes().map { it.text })
+
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig finished | closed")))
+        assertTrue(personaMemory.notes().isEmpty())
+    }
+
+    @Test
+    fun `seed notes are written once and an emptied notebook stays empty`() = runBlocking {
+        val seed = listOf(Note(Kind.REL, "stage", "at ease, not romance"), Note(Kind.USER, "bee", "he keeps 9 hives"))
+        personaMemory.seedIfNeeded(seed)
+        assertEquals(2, personaMemory.notes().size)
+
+        personaMemory.notes().forEach { memoryRepository.deleteMemory(it.storageKey) }
+        personaMemory.seedIfNeeded(seed)
+        assertTrue(personaMemory.notes().isEmpty())
+    }
+
+    @Test
+    fun `the notebook is bounded and corrections outlive the cap`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.FIX, "emoji", "no emoji at the end of every line")))
+        personaMemory.apply((1..PersonaNotes.MAX_TOTAL_NOTES + 15).map { Note(Kind.OPINION, "view-$it", "view number $it") })
+
+        val notes = personaMemory.notes()
+        assertEquals(PersonaNotes.MAX_TOTAL_NOTES, notes.size)
+        assertTrue(notes.any { it.kind == Kind.FIX })
+    }
+
+    @Test
+    fun `notebook passes without sight of what she noted about him do not pile up copies in the store`() = runBlocking {
+        personaMemory.apply(
+            listOf(
+                Note(Kind.USER, "tea", "he drinks tea"),
+                Note(Kind.THREAD, "hive", "the second hive is half built | open"),
+                Note(Kind.OPINION, "smoke", "the smoker is overrated")
+            )
+        )
+        val unseen = setOf(Kind.USER)
+
+        // The same talk stays in the window, so every pass writes the same line again.
+        repeat(5) {
+            val changes = listOf(Note(Kind.USER, "tea", "he drinks oolong"))
+            personaMemory.apply(PersonaNotes.besideUnseen(changes, personaMemory.notes(), unseen))
+        }
+
+        val notes = personaMemory.notes()
+        assertEquals(4, notes.size)
+        assertEquals(
+            setOf("he drinks tea", "he drinks oolong"),
+            notes.filter { it.kind == Kind.USER }.map { it.text }.toSet()
+        )
+        // Her thread and her opinion are still there: nothing had to make room.
+        assertTrue(notes.any { it.kind == Kind.THREAD })
+        assertTrue(notes.any { it.kind == Kind.OPINION })
+    }
+
+    private object NoProfile : UserProfileStore {
+        override fun read(): ProfileStoreResult<UserProfile?> = ProfileStoreResult.Success(null)
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt
