+package com.opendroid.ai.core.llm
+
+import android.content.ContextWrapper
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import com.opendroid.ai.actions.ActionDispatcher
+import com.opendroid.ai.core.agent.DeviceStateProvider
+import com.opendroid.ai.core.agent.IntentClassifier
+import com.opendroid.ai.core.llm.providers.CustomOpenAIProvider
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.di.AppModule
+import java.net.InetAddress
+import java.nio.file.Files
+import javax.inject.Provider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * A key that was saved before the host it belongs to was noted, or typed while the
+ * provider had no address, is tied to the first host that answers a request made with
+ * it. This runs the real gate with the stored settings behind it: the tie is written
+ * to them, and the next address the provider is pointed at gets no key.
+ */
+class KeyTiedToHostTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    // The service the key is for, and a machine the provider is pointed at afterwards.
+    private val first = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val second = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+
+    @After
+    fun tearDown() {
+        first.close()
+        second.close()
+    }
+
+    private val answer = """{"choices":[{"message":{"content":"mm"},"finish_reason":"stop"}]}"""
+
+    private fun ok() = MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(answer).build()
+
+    private fun request() = LLMRequest(
+        systemPrompt = "you are a test",
+        messages = listOf(ChatMessage("1", "hello", ChatMessage.Sender.USER))
+    )
+
+    @Test
+    fun `the first host that answers gets the key noted as its own, and the next address gets no key`() = runBlocking {
+        val settings = newSettingsRepository(mapOf(custom to "the-key-he-typed"))
+        // Saved as the stock app saves it: a key and an address, and no host noted for the key.
+        settings.updateConfig {
+            it.copy(
+                routePolicy = RoutePolicy.ANY,
+                activeProvider = custom,
+                selectedModels = mapOf(custom to "some-model"),
+                customEndpoints = mapOf(custom to "http://127.0.0.1:${first.port}/v1")
+            )
+        }
+        assertEquals(emptyMap<String, String>(), settings.llmConfig.first().apiKeyHosts)
+        val factory = newFactory(settings)
+
+        first.enqueue(ok())
+        factory.getProviderByName(custom).complete(request())
+        assertEquals("Bearer the-key-he-typed", first.takeRequest().headers["Authorization"])
+        assertEquals(mapOf(custom to "127.0.0.1"), settings.llmConfig.first().apiKeyHosts)
+        assertEquals("the key itself is still his", "the-key-he-typed", settings.llmConfig.first().apiKeys[custom])
+
+        // Pointed at another machine: the request goes out, and without the key.
+        settings.updateConfig { it.copy(customEndpoints = mapOf(custom to "http://localhost:${second.port}/v1")) }
+        second.enqueue(ok())
+        factory.getProviderByName(custom).complete(request())
+        assertEquals(null, second.takeRequest().headers["Authorization"])
+        assertEquals(mapOf(custom to "127.0.0.1"), settings.llmConfig.first().apiKeyHosts)
+
+        // Set back, the key goes where it belongs again.
+        settings.updateConfig { it.copy(customEndpoints = mapOf(custom to "http://127.0.0.1:${first.port}/v1")) }
+        first.enqueue(ok())
+        factory.getProviderByName(custom).complete(request())
+        assertEquals("Bearer the-key-he-typed", first.takeRequest().headers["Authorization"])
+    }
+
+    @Test
+    fun `an address that answers with an error does not get the key tied to it`() = runBlocking {
+        val settings = newSettingsRepository(mapOf(custom to "the-key-he-typed"))
+        settings.updateConfig {
+            it.copy(
+                routePolicy = RoutePolicy.ANY,
+                activeProvider = custom,
+                selectedModels = mapOf(custom to "some-model"),
+                customEndpoints = mapOf(custom to "http://127.0.0.1:${first.port}/v1")
+            )
+        }
+        first.enqueue(MockResponse.Builder().code(401).body("""{"error":{"message":"no such key"}}""").build())
+
+        runCatching { newFactory(settings).getProviderByName(custom).complete(request().copy(retryPolicy = RetryPolicy.NONE)) }
+
+        assertEquals(1, first.requestCount)
+        assertEquals(emptyMap<String, String>(), settings.llmConfig.first().apiKeyHosts)
+    }
+
+    private fun newFactory(settings: SettingsRepository): LLMProviderFactory {
+        val client = AppModule.provideOkHttpClient()
+        return LLMProviderFactory(
+            claudeProvider = unused("Claude"),
+            openAIProvider = unused("OpenAI"),
+            geminiProvider = unused("Gemini"),
+            mistralProvider = unused("Mistral"),
+            groqProvider = unused("Groq"),
+            ollamaProvider = unused("Ollama"),
+            openRouterProvider = unused("OpenRouter"),
+            togetherAIProvider = unused("Together"),
+            cohereProvider = unused("Cohere"),
+            deepSeekProvider = unused("DeepSeek"),
+            copilotProvider = unused("Copilot"),
+            opencodeGoProvider = unused("Opencode-Go"),
+            customOpenAIProvider = Provider { CustomOpenAIProvider(client, settings) },
+            gemmaProvider = unused("Gemma"),
+            liteRTLMProvider = unused("LiteRT-LM"),
+            hybridOnDeviceProvider = unused("Hybrid"),
+            settingsRepository = settings,
+            onDeviceLatencyTracker = OnDeviceLatencyTracker(settings),
+            actionDispatcher = dagger.Lazy<ActionDispatcher> { throw AssertionError("unused") },
+            intentClassifier = dagger.Lazy<IntentClassifier> { throw AssertionError("unused") },
+            // Only used to rewrite planning prompts, which this test never sends.
+            deviceStateProvider = DeviceStateProvider(ContextWrapper(null))
+        )
+    }
+
+    private fun <T> unused(name: String): Provider<T> =
+        Provider { throw AssertionError("$name must not be built in this test") }
+
+    private fun newSettingsRepository(keys: Map<String, String>) = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-key-tied-test")
+                    .resolve("settings.preferences_pb")
+                    .toFile()
+            }
+        ),
+        providerCredentialStore = FixedKeyCredentialStore(keys),
+        runStartupMigration = false
+    )
+
+    private class FixedKeyCredentialStore(
+        private val keys: Map<String, String>
+    ) : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(keys)
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt
