--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/ChatRecordTest.kt
@@ -0,0 +1,419 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStatus
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * What the phone did, what it is waiting for and what it never did are on record in the
+ * chat in the app's own words. These tests hold the places where the loop writes that
+ * record: they read the source, as the other tests of the loop do, and fail when one of
+ * those places goes back to guessing, to the planner's wording, or to silence.
+ */
+class ChatRecordTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private val loop = File(main, "core/agent/AgentLoop.kt").readText()
+
+    private fun body(from: String, to: String): String {
+        assertTrue("not found: $from", loop.contains(from))
+        return loop.substringAfter(from).substringBefore(to)
+    }
+
+    // ── The badge on a message of his ────────────────────────────────────────────────
+
+    @Test
+    fun `a message of his is stored with what it is`() {
+        assertEquals(PersonaPrompts.OWNER_TALK_BADGE, ownerRowBadge(answersPendingQuestion = false, secret = false, tapped = false))
+        assertEquals(PersonaPrompts.OWNER_ANSWER_BADGE, ownerRowBadge(answersPendingQuestion = true, secret = false, tapped = false))
+        assertEquals(PersonaPrompts.OWNER_PICK_BADGE, ownerRowBadge(answersPendingQuestion = true, secret = false, tapped = true))
+        assertEquals(PersonaPrompts.OWNER_SECRET_BADGE, ownerRowBadge(answersPendingQuestion = true, secret = true, tapped = false))
+        // Only an answer can be one of these: a new message is decided later, by its plan.
+        assertEquals(PersonaPrompts.OWNER_TALK_BADGE, ownerRowBadge(answersPendingQuestion = false, secret = true, tapped = true))
+    }
+
+    @Test
+    fun `an answer that is a secret is never written into the chat`() {
+        assertEquals(PersonaPrompts.SECRET_MARKER, ownerRowText("4471", answersPendingQuestion = true, secret = true))
+        assertEquals("im late", ownerRowText("im late", answersPendingQuestion = true, secret = false))
+        assertEquals("4471 is my lucky number", ownerRowText("4471 is my lucky number", answersPendingQuestion = false, secret = true))
+
+        val submit = body("private fun submitQuery(", "override fun retryRequest(")
+        assertTrue(submit.contains("text = ownerRowText(query, isAnsweringPendingQuestion, pendingAtScheduleTime?.secret == true)"))
+        assertTrue(submit.contains("modelBadge = ownerRowBadge("))
+        // What he typed still reaches the step that asked for it.
+        assertTrue(submit.contains("pending.deferred.complete(UserReply(query, tappedContact))"))
+        // The row is the only place the message is written to.
+        assertEquals(1, Regex("""conversationRepository\.insertMessage\(sessionId, userMsg\)""").findAll(submit).count())
+    }
+
+    @Test
+    fun `a message that becomes a shortcut or a plan is marked as a command, and one that held a secret keeps a marker`() {
+        val alias = body("private suspend fun executeAliasDirect(", "override fun dismissChatError()")
+        assertTrue(alias.contains("markOwnerCommand(plan, sessionId)"))
+        val planned = body("private suspend fun generatePlan(", "suspend fun personaCheckIn(")
+        val talkOnly = planned.indexOf("if (persona.isActive(config) && isTalkOnlyPlan(plan)) {")
+        val marked = planned.indexOf("if (!isTalkOnlyPlan(plan)) markOwnerCommand(plan, sessionId)")
+        val started = planned.indexOf("planManager.startNewPlan(plan, context, PlanStatus.PROPOSED)")
+        // Talk that the planner answered in words is not a command; a real plan is marked before it starts.
+        assertTrue(talkOnly in 0 until marked)
+        assertTrue(marked < started)
+
+        val mark = body("private suspend fun markOwnerCommand(", "// Speak callback to be implemented by TTS service")
+        assertTrue(mark.contains("PlanRecord.takesASecret(plan)"))
+        assertTrue(mark.contains("PersonaPrompts.OWNER_SECRET_BADGE"))
+        assertTrue(mark.contains("PersonaPrompts.SECRET_MARKER"))
+        assertTrue(mark.contains("PersonaPrompts.OWNER_COMMAND_BADGE"))
+        // The row is marked where it stands. Stored again it would move behind the rows
+        // the app wrote since, and an edit of the message would leave those behind.
+        val row = body("private suspend fun markOwnerRow(", "private suspend fun markOwnerCommand(")
+        assertTrue(row.contains("conversationRepository.remarkMessage(sessionId, marked)"))
+        assertFalse(row.contains("insertMessage("))
+        // The row in hand is set once, at the top of the task, under the lock.
+        assertTrue(body("private suspend fun processQueryLocked(", "_chatError.value?.resumePlanId").contains("ownerRowInHand = userMsg.copy(imageBase64 = null)"))
+    }
+
+    // ── Questions in the middle of a plan ────────────────────────────────────────────
+
+    @Test
+    fun `a question is in the chat and spoken before the app waits for the answer`() {
+        val ask = body("suspend fun askOwner(", "// The owner's row the task in hand started from.")
+        val stored = ask.indexOf("saveAppRow(")
+        val spoken = ask.indexOf("onSpeakCallback?.invoke(question)")
+        val waits = ask.indexOf("awaitUserReply(sessionId, secret)")
+        assertTrue(stored >= 0)
+        assertTrue(spoken > stored)
+        assertTrue(waits > spoken)
+        assertTrue(ask.contains("base = com.opendroid.ai.core.persona.PersonaPrompts.QUESTION_BADGE"))
+        // A confirmation names the step it guards, read off the plan and not off the question.
+        assertTrue(ask.contains("PlanRecord.nextStepLine(plan, asking.stepId)"))
+        assertTrue(ask.contains("PlanRecord.answerIsASecret(plan, asking.stepId)"))
+        // Only for a step of the plan that asks itself: a question from inside a macro
+        // is not said to guard the plan's next step.
+        assertTrue(ask.contains("val asking = PlanRecord.askingStep("))
+        assertTrue(ask.contains("stepInHand?.takeIf { it.planId == plan?.planId }?.stepId"))
+        assertTrue(ask.contains("if (kind == Ask.CONFIRMATION && plan != null && asking != null) {"))
+        // The step that asks is the one the plan loop is running.
+        val dispatch = body("private suspend fun executePlanLoop(", "private suspend fun pauseForRetry(")
+        assertTrue(dispatch.contains("stepInHand = StepInHand(currentPlanState.planId, stepToExecute.stepId)"))
+        assertTrue(dispatch.contains("stepInHand = null"))
+    }
+
+    @Test
+    fun `a question that quotes a step that read his data is stored under the private mark`() {
+        val ask = body("suspend fun askOwner(", "// The owner's row the task in hand started from.")
+        val mark = ask.substringAfter("planRowStaysPrivate(").substringBefore("base = ")
+        assertTrue(mark.contains("kind == Ask.CONTACT_CHOICE"))
+        assertTrue(mark.contains("PlanRecord.questionMayHoldPersonalData(plan, asking, ::canonicalNamesOf)"))
+
+        // "read my latest notification and ask me whether to reply", private mode on, both routes hosted.
+        val hosted = com.opendroid.ai.data.models.LLMConfig(privateMode = true)
+        assertFalse(hosted.plannerWasToldEverything())
+        val read = PlanStep(
+            stepId = "s1", order = 1, description = "", action = "READ_NOTIFICATIONS",
+            status = StepStatus.COMPLETED, result = "Riya: the hive inspector comes on friday"
+        )
+        val asks = PlanStep(
+            stepId = "s2", order = 2, description = "", action = "ASK_USER",
+            params = mapOf("question" to "You got: \$s1. Reply?"), status = StepStatus.RUNNING
+        )
+        val plan = Plan(planId = "p1", goal = "", estimatedDuration = "", estimatedSteps = 2, steps = listOf(read, asks))
+        val canonical: (PlanStep) -> String = { it.action }
+        val names: (PlanStep) -> Collection<String> = { listOf(it.action) }
+        fun badge(plan: Plan, stepIdInHand: String?): String {
+            val asking = PlanRecord.askingStep(plan, stepIdInHand, canonical)
+            return PersonaPrompts.appRowBadge(
+                planRowStaysPrivate(hosted, PlanRecord.questionMayHoldPersonalData(plan, asking, names)),
+                base = PersonaPrompts.QUESTION_BADGE
+            )
+        }
+        assertEquals("Question (private)", badge(plan, "s2"))
+        // The same question in the planner's own words is an ordinary question.
+        val plain = plan.copy(steps = listOf(read, asks.copy(params = mapOf("question" to "Reply to it?"))))
+        assertEquals("Question", badge(plain, "s2"))
+
+        // What her next prompt and the stock chat then get in its place.
+        val row = com.opendroid.ai.data.models.ChatMessage(
+            id = "q", text = "You got: Riya: the hive inspector comes on friday. Reply?",
+            sender = com.opendroid.ai.data.models.ChatMessage.Sender.AGENT, modelBadge = badge(plan, "s2")
+        )
+        val hers = PersonaPrompts.shapeHistory(listOf(row), holdBackPrivateResults = true).deviceActivity.single()
+        assertEquals(PersonaPrompts.QUESTION_LABEL + PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER, hers)
+        val stock = PersonaPrompts.stockHistory(listOf(row), holdBack = true).single().text
+        assertFalse(stock, stock.contains("hive"))
+    }
+
+    @Test
+    fun `the three asking actions ask through the loop and no longer speak or wait by themselves`() {
+        val actions = File(main, "actions/SystemActions.kt").readText()
+        fun action(name: String) = actions.substringAfter("private class $name(").substringBefore("\n    }\n")
+        val confirm = action("ConfirmAction")
+        val select = action("PromptUserSelectionAction")
+        val askUser = action("AskUserAction")
+
+        assertTrue(confirm.contains("agentLoop.get().askOwner(prompt, AgentLoop.Ask.CONFIRMATION)"))
+        assertTrue(select.contains("agentLoop.get().askOwner(promptText, AgentLoop.Ask.CONTACT_CHOICE)"))
+        assertTrue(askUser.contains("agentLoop.get().askOwner(question)"))
+        for (source in listOf(confirm, select, askUser)) {
+            assertFalse(source.contains("awaitUserResponse"))
+            assertFalse(source.contains("onSpeakCallback"))
+        }
+        // Nothing outside the loop waits for him behind the chat's back.
+        val waiters = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { it.readText().contains("awaitUserResponse(") }
+            .map { it.name }.toList()
+        assertEquals(listOf("AgentLoop.kt"), waiters)
+    }
+
+    @Test
+    fun `his answer is stored once, by the reply path`() {
+        val picker = body("private suspend fun handleContactPicker(", "private suspend fun handleNeedsInput(")
+        val missing = body("private suspend fun handleNeedsInput(", "private suspend fun handlePendingUserAction(")
+        for (source in listOf(picker, missing)) {
+            assertFalse(source.contains("sender = ChatMessage.Sender.USER"))
+        }
+        // Both questions are marked as questions, and a prompt for a secret keeps the answer out of the chat.
+        assertTrue(picker.contains("base = com.opendroid.ai.core.persona.PersonaPrompts.QUESTION_BADGE"))
+        assertTrue(missing.contains("base = com.opendroid.ai.core.persona.PersonaPrompts.QUESTION_BADGE"))
+        assertTrue(missing.contains("awaitUserReply(sessionId, secret = isSecretParam(actionName, paramKey))"))
+    }
+
+    @Test
+    fun `the value a secret prompt asks for is a secret, its name is not`() {
+        assertTrue(isSecretParam("SAVE_SENSITIVE_INFO", "secret"))
+        assertFalse(isSecretParam("SAVE_SENSITIVE_INFO", "key"))
+        assertFalse(isSecretParam("SEND_SMS", "message"))
+    }
+
+    @Test
+    fun `the chat shows that it is waiting for his answer`() {
+        assertTrue(loop.contains("override val waitingForAnswerSessionId: StateFlow<String?> = _waitingForAnswerSessionId.asStateFlow()"))
+        val viewModel = File(main, "ui/viewmodel/ChatViewModel.kt").readText()
+        assertTrue(viewModel.contains("agentLoop.waitingForAnswerSessionId, sessions"))
+        val screen = File(main, "ui/screens/ChatScreen.kt").readText()
+        assertTrue(screen.contains("val waitingForAnswer by viewModel.waitingForAnswer.collectAsState()"))
+        assertTrue(screen.contains("text = \"waiting for your answer\""))
+    }
+
+    // ── What never ran ───────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a rejected plan leaves a row, and a no with nothing proposed changes nothing`() {
+        val reject = body("override fun rejectProposedPlan() {", "private fun livePlan(")
+        assertTrue(reject.contains("val shown = (_agentState.value as? AgentState.PlanProposed)?.plan ?: return"))
+        assertTrue(reject.contains("PlanRecord.rejected(rejected, ::canonicalNameOf)"))
+        assertTrue(reject.contains("planManager.cancelPlan(rejected.planId)"))
+        // The plan in memory is dropped only if it is still the rejected one.
+        assertTrue(reject.contains("if (planManager.currentPlan.value?.planId == rejected.planId) planManager.clearPlan()"))
+    }
+
+    @Test
+    fun `a stopped plan leaves a row that says what had run`() {
+        val cancel = body("override fun cancelCurrentTask(record: Boolean) {", "private suspend fun resolveStaleProposedPlan(")
+        assertTrue(cancel.contains("PlanRecord.dropped(dropped, \"stopped before it was approved\", ::canonicalNameOf)"))
+        assertTrue(cancel.contains("PlanRecord.stopped(stopped, ::canonicalNameOf, waitingForAnswer = wasWaitingForAnswer)"))
+        // The plan is cancelled either way; only the row is the caller's to decline,
+        // when it is emptying or deleting the chat the row would land in.
+        assertTrue(cancel.contains("if (record) {"))
+        assertTrue(cancel.contains("if (stopped != null && record) {"))
+        assertEquals(2, Regex("""planManager\.cancelPlan\(""").findAll(cancel).count())
+        assertTrue(loop.contains("fun cancelCurrentTask(record: Boolean = true)"))
+        val viewModel = File(main, "ui/viewmodel/ChatViewModel.kt").readText()
+        assertEquals(2, Regex("""agentLoop\.cancelCurrentTask\(record = false\)""").findAll(viewModel).count())
+        // Stop, in the chat and in the Plan tab, keeps the row.
+        assertTrue(viewModel.substringAfter("fun stopTask() {").contains("agentLoop.cancelCurrentTask()"))
+        // The steps are read after the job has unwound and before the plan is redacted.
+        val joined = cancel.lastIndexOf("jobToCancel.join()")
+        val read = cancel.indexOf("val stopped = planManager.currentPlan.value")
+        val cancelled = cancel.indexOf("planManager.cancelPlan(planIdToCancel)")
+        assertTrue(joined in 0 until read)
+        assertTrue(read < cancelled)
+
+        val replaced = body("private suspend fun resolveStaleProposedPlan(", "private fun abandonWaitingTask(")
+        assertTrue(replaced.contains("PlanRecord.dropped(replaced, \"a new message came before it was approved\", ::canonicalNameOf)"))
+        val declined = body("private suspend fun cancelDeclinedPlan(", "private suspend fun parkedForApproval(")
+        assertTrue(declined.contains("PlanRecord.stopped(stopped, ::canonicalNameOf, why = \"you said no\", declinedStepId = step.stepId)"))
+    }
+
+    @Test
+    fun `a running plan that his next message or a retry cuts off leaves a row`() {
+        val cut = body("private fun cutOffTaskInFlight(", "private suspend fun processQueryLocked(")
+        // Which plan and which chat are read before the job is cancelled and unwinds.
+        val read = cut.indexOf("val running = planCutOff(planManager.currentPlan.value, taskInFlight = jobToCancel.isActive)")
+        val session = cut.indexOf("val taskSessionId = _activeTaskSessionId.value")
+        val cancelled = cut.indexOf("jobToCancel.cancel()")
+        assertTrue(read >= 0)
+        assertTrue(session > read)
+        assertTrue(cancelled > session)
+        // The steps are read after the job has unwound and before the plan is redacted.
+        val joined = cut.indexOf("jobToCancel.join()")
+        val stopped = cut.indexOf("val stopped = planManager.currentPlan.value")
+        val stored = cut.indexOf("planManager.cancelPlan(stopped.planId)")
+        assertTrue(joined > cancelled)
+        assertTrue(stopped > joined)
+        assertTrue(stored > stopped)
+        assertTrue(cut.contains("it.planId == running.planId && it.status == PlanStatus.RUNNING"))
+        assertTrue(cut.contains("PlanRecord.stopped(stopped, ::canonicalNameOf, why = why, waitingForAnswer = waitingForAnswer)"))
+
+        // A new message: the record is waited for before the message is stored and
+        // again before the new task can start a plan of its own.
+        val submit = body("private fun submitQuery(", "override fun retryRequest(")
+        assertTrue(submit.contains("cutOff = cutOffTaskInFlight(why = \"a new message came\")"))
+        assertFalse(submit.contains("currentJob?.cancel()"))
+        val waited = submit.indexOf("kotlinx.coroutines.withTimeoutOrNull(CUT_OFF_RECORD_WAIT_MILLIS) { record.join() }")
+        val storedRow = submit.indexOf("conversationRepository.insertMessage(sessionId, userMsg)")
+        val waitedAgain = submit.indexOf("cutOff?.join()")
+        val locked = submit.indexOf("queryMutex.withLock {")
+        assertTrue(waited >= 0)
+        assertTrue(storedRow > waited)
+        assertTrue(waitedAgain > storedRow)
+        assertTrue(locked > waitedAgain)
+
+        // A retry: the same, and the plan it resumes is not touched.
+        val retry = body("private fun launchRetry(", "private fun cutOffTaskInFlight(")
+        assertTrue(retry.contains("cutOff = cutOffTaskInFlight(why = \"a retry was started\", waitingForAnswer = waitingSession != null)"))
+        assertFalse(retry.contains("currentJob?.cancel()"))
+        assertTrue(retry.indexOf("cutOff?.join()") in 0 until retry.indexOf("resolveStaleProposedPlan(sessionId)"))
+    }
+
+    @Test
+    fun `only a plan that is running in a task still in flight is cut off`() {
+        fun plan(status: PlanStatus) = Plan(
+            planId = "p1", goal = "", estimatedDuration = "", estimatedSteps = 1,
+            steps = listOf(PlanStep(stepId = "s1", order = 1, description = "", action = "SET_ALARM")),
+            status = status
+        )
+        val running = plan(PlanStatus.RUNNING)
+        assertEquals(running, planCutOff(running, taskInFlight = true))
+        // A paused plan is what Retry resumes; a proposed one is dealt with where the new task starts.
+        assertEquals(null, planCutOff(plan(PlanStatus.PAUSED), taskInFlight = true))
+        assertEquals(null, planCutOff(plan(PlanStatus.PROPOSED), taskInFlight = true))
+        assertEquals(null, planCutOff(plan(PlanStatus.COMPLETED), taskInFlight = true))
+        // With no task in flight the plan is not being run by anything this could stop.
+        assertEquals(null, planCutOff(running, taskInFlight = false))
+        assertEquals(null, planCutOff(null, taskInFlight = true))
+
+        // What the row then says: that it was stopped, why, and what had and had not run.
+        val sent = PlanStep(
+            stepId = "s1", order = 1, description = "", action = "SEND_SMS",
+            params = mapOf("contact" to "Mom", "message" to "im late"),
+            status = StepStatus.COMPLETED, result = "Message sent to Mom!"
+        )
+        val alarm = PlanStep(stepId = "s2", order = 2, description = "", action = "SET_ALARM", status = StepStatus.RUNNING)
+        val row = PlanRecord.stopped(
+            running.copy(steps = listOf(sent, alarm)), { it.action }, why = "a new message came"
+        )
+        assertEquals(
+            "Stopped (a new message came): Send SMS to Mom, Set alarm\n" +
+                "Already ran: Send SMS to Mom\n" +
+                "Interrupted: Set alarm (it may or may not have gone through)",
+            row
+        )
+    }
+
+    // ── The planner's words are not facts ────────────────────────────────────────────
+
+    @Test
+    fun `the trace of a plan that runs unasked is built from the steps`() {
+        val trace = body("private suspend fun recordAutoApprovedTrace(", "private fun canonicalNamesOf(")
+        assertTrue(trace.contains("text = PlanRecord.running(plan)"))
+        assertTrue(trace.contains("onSpeakCallback?.invoke(PlanRecord.runningSpoken(plan))"))
+        assertFalse(trace.contains("plan.goal"))
+        assertFalse(trace.contains("it.description"))
+        assertTrue(trace.contains("holdsPersonalData = PlanRecord.stepLinesNameDetails(plan)"))
+    }
+
+    @Test
+    fun `what the planner says while a plan runs is never spoken as an outcome`() {
+        val run = body("private suspend fun executePlanLoop(", "private suspend fun pauseForRetry(")
+        assertFalse(run.contains("onSpeakCallback?.invoke(reEval.speech)"))
+        assertFalse(run.contains("onSpeakCallback?.invoke(replan.speech)"))
+        assertTrue(run.contains("savePlannerReason(replan.speech, currentPlanState, sessionId)"))
+        // After every step, whatever the planner decided: its reason for going on is
+        // kept as much as its reason for stopping or changing the plan.
+        val afterStep = run.substringAfter("val continuation = PlanContinuation.afterReEvaluation(reEval.decision)")
+            .substringBefore("when (continuation) {")
+        assertTrue(afterStep.contains("savePlannerReason("))
+        assertTrue(afterStep.contains("reEval.speech,"))
+        assertTrue(afterStep.contains("goesOn = continuation == PlanContinuation.Continue"))
+        assertFalse(afterStep.contains("if ("))
+
+        val reason = body("private suspend fun savePlannerReason(", "private suspend fun speakAndSaveSummary(")
+        assertTrue(reason.contains("PersonaPrompts.PLANNER_GOES_ON_PREFIX else \"Planner's reason: \""))
+        assertTrue(reason.contains("savePlannerRow(opening + shown, sessionId, holdsPersonalData = false)"))
+        // A reason that cannot be kept is told as that when the plan stopped, and left out when it only went on.
+        assertTrue(reason.contains("if (goesOn && heldSecret) return"))
+        assertTrue(reason.contains("base = com.opendroid.ai.core.persona.PersonaPrompts.PLANNER_BADGE"))
+        assertFalse(reason.contains("onSpeakCallback"))
+        assertFalse(reason.contains("speakLine("))
+    }
+
+    @Test
+    fun `a plan the planner ends early with nothing failed is stored as stopped, not as failed`() {
+        val run = body("private suspend fun executePlanLoop(", "private suspend fun pauseForRetry(")
+        val abandon = run.substringAfter("PlanContinuation.Abandon -> {").substringBefore("PlanContinuation.Modify -> {")
+        assertTrue(abandon.contains("if (currentPlanState.steps.any { it.status == StepStatus.FAILED }) {"))
+        assertTrue(abandon.contains("planManager.updatePlanStatus(PlanStatus.FAILED)"))
+        assertTrue(abandon.contains("planManager.cancelPlan(currentPlanState.planId)"))
+    }
+
+    @Test
+    fun `the summary of a run is the record built from its steps`() {
+        val summary = body("private suspend fun speakAndSaveSummary(", "private suspend fun speakAndSaveMessage(")
+        assertTrue(summary.contains("val record = PlanRecord.of("))
+        assertTrue(summary.contains("val summaryText = record.text"))
+        // No line is made up from the planner's goal any more, and none stands in for a result.
+        assertFalse(summary.contains("plan.goal"))
+        assertFalse(summary.contains("phrasebook.goalDone()"))
+        assertFalse(summary.contains("phrasebook.failure()"))
+        assertFalse(loop.contains("humanizeGoalDone"))
+        assertFalse(loop.contains("humanizeFailure"))
+        // A plan that only stopped is not put to her as done or failed, and neither is
+        // one in which a part was done and a part failed.
+        assertTrue(summary.contains("val reportedBySteps = record.fromSteps && !record.stopped && record.plainOutcome"))
+        // The planner's words about its own plan are kept apart, under their own badge.
+        assertTrue(summary.contains("record.plannerWords?.let { words ->"))
+        assertTrue(summary.contains("savePlannerRow("))
+        // The row keeps the mark that holds his private data off a readable route: what
+        // a step read, the contact a saved pick stands for, and who a step line names.
+        val mark = summary.substringAfter("val staysPrivate = record.fromSteps && planRowStaysPrivate(")
+            .substringBefore("val exactBadge = ")
+        assertTrue(mark.contains("PersonalDataResults.summaryHolds(plan.steps, isSuccess = true, ::canonicalNamesOf)"))
+        assertTrue(mark.contains("PersonalDataResults.summaryHolds(plan.steps, isSuccess = false, ::canonicalNamesOf)"))
+        assertTrue(mark.contains("record.namesSteps && PlanRecord.stepLinesNameDetails(plan)"))
+        assertTrue(summary.contains("val exactBadge = com.opendroid.ai.core.persona.PersonaPrompts.appRowBadge(staysPrivate)"))
+        // A step left with him is known to the record as that.
+        assertTrue(summary.contains("handedOver = { step -> handedOverSteps.contains(stepKey(plan.planId, step.stepId)) }"))
+        val handOver = loop.substringAfter("} else if (actionResult is ActionResult.UserActionRequired) {")
+            .substringBefore("planManager.updateStepStatus(")
+        assertTrue(handOver.contains("handedOverSteps.add(stepKey(currentPlanState.planId, stepToExecute.stepId))"))
+    }
+
+    // ── What she is shown ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `her reply is marked when it was written with his screen in front of her, stopped or not`() {
+        val chat = body("private suspend fun executeSimpleQuery(", "private suspend fun generatePlan(")
+        assertTrue(chat.contains("val sawScreen = personaOn && persona.chatSeesImages(chatConfig) && userMsg.imageBase64 != null"))
+        assertTrue(chat.contains("com.opendroid.ai.core.persona.PersonaPrompts.replyBadge(sawScreen)"))
+        assertTrue(chat.contains("com.opendroid.ai.core.persona.PersonaPrompts.replyBadge(sawScreen, stopped = true)"))
+    }
+
+    @Test
+    fun `enough rows are read that the talk survives a run of commands, and app lines get their age`() {
+        assertTrue(loop.contains("private const val PERSONA_HISTORY_MESSAGES = 48"))
+        assertTrue(48 >= PersonaPrompts.MAX_DIALOGUE_ROWS * 3)
+        val chat = body("private suspend fun executeSimpleQuery(", "private suspend fun generatePlan(")
+        val shaped = chat.substringAfter("val shaped = com.opendroid.ai.core.persona.PersonaPrompts.shapeHistory(")
+            .substringBefore("lastMsgs = shaped.dialogue")
+        assertTrue(shaped.contains("holdBackPrivateResults = holdsBack"))
+        assertTrue(shaped.contains("nowMillis = System.currentTimeMillis()"))
+    }
+}
