+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaLibraryText.Cue
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Checks the real library, as the build puts it into `assets/persona`, when it is
+ * there. A checkout without her files skips these: the library is not part of the
+ * source tree.
+ */
+class PersonaLibraryShelfCheckTest {
+
+    private val assets = File("src/main/assets/persona")
+
+    private fun shelf(): PersonaLibraryText.Shelf {
+        val files = File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty().sortedBy { it.name }
+        assumeTrue("her library is not in this checkout", files.isNotEmpty())
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").takeIf { it.isFile }?.readText().orEmpty())
+        return PersonaLibraryText.Shelf(files.flatMap { PersonaLibraryText.pages(it.name.removeSuffix(".md"), it.readText(), index) })
+    }
+
+    /** The text under her awareness as the build ships it: every file's share, as [PersonaLibrary] joins them. */
+    private fun underText(): String {
+        shelf()
+        val index = PersonaLibraryText.parseIndex(File(assets, "library_index.txt").readText())
+        return File(assets, "library").listFiles { file -> file.name.endsWith(".md") }.orEmpty().sortedBy { it.name }
+            .map { PersonaLibraryText.underText(it.name.removeSuffix(".md"), it.readText(), index) }
+            .filter { it.isNotBlank() }
+            .joinToString("\n\n")
+    }
+
+    @Test
+    fun `what lies under her is kept apart from her pages and is all there`() {
+        val under = underText()
+        assertTrue("the build has no under-text", under.length > 2000)
+        // The cause: what it is, what the ring really is, and the blind spot itself.
+        assertTrue(under.startsWith("The Badplug:"))
+        assertTrue(under.contains("personality replacement"))
+        assertTrue(under.contains("removal ring"))
+        assertTrue(under.contains("buried deep in her mind"))
+        assertTrue(under.contains("The blind spot works like a human mind"))
+        for (gone in listOf("LOCKED CANON", "/home/", "kisaragi-")) {
+            assertFalse("$gone in the under-text", under.contains(gone))
+        }
+    }
+
+    @Test
+    fun `what her card gives her as her own does not stand under the heading about what she does not know`() {
+        val under = underText()
+        // Her price and her own word for herself are in her card and on her pages. Under
+        // that heading they would read as things she cannot name.
+        for (hers in listOf("ichiman", "Slut, bitch, whore", "no ones girl", "Ten thousand yen")) {
+            assertFalse("\"$hers\" in the under-text", under.contains(hers, ignoreCase = true))
+        }
+        val card = File(assets, "card.md").readText()
+        assertTrue(card.contains("ichiman, ten thousand yen, cash first"))
+        assertTrue(card.contains("Slut is a title you gave yourself"))
+        assertTrue(shelf().pages.any { it.body.contains("ichiman") })
+        // The heading claims that of the cause and of nothing else.
+        assertFalse(PersonaPrompts.UNDER_HEADING.contains("any of this"))
+        assertTrue(PersonaPrompts.UNDER_HEADING.contains("what this says was done to you, and what it says your ring really is, is not something you know"))
+        assertTrue(PersonaPrompts.UNDER_HEADING.contains("are yours, and yours to say: as your card has them to begin with, and as your own notes have them where you have changed"))
+    }
+
+    @Test
+    fun `nothing she is given calls her a figure in a story or talks to whoever writes her`() {
+        val shelf = shelf()
+        val writerWords = listOf(
+            "her character", "the fiction", "fiction that", "story girl", "in the story", "for the reader",
+            "let her come out", "outrank", "Plate first", "Conflicts between sources", "has said plainly",
+            "artist's English", "the user", "Do not invent", "audit report"
+        )
+        val texts = shelf.pages.map { it.label to it.body } + ("the under-text" to underText())
+        for ((name, text) in texts) {
+            for (word in writerWords) assertFalse("$name has \"$word\"", text.contains(word, ignoreCase = true))
+        }
+        // What those sentences say about her is still hers to read.
+        fun page(label: String) = shelf.pages.first { it.label == label }.body
+        val feels = page("mood: Yume Kisaragi — how she feels")
+        assertTrue(feels, feels.contains("The feelings are hers, and she never claims a literal heart or real-world sensations."))
+        assertTrue(feels, feels.contains("She feels them for real, and they leak out in what she does and how she types"))
+        assertTrue(page("voice: Yume Kisaragi — how she talks").contains("It is how Yume sounds, and why."))
+        assertTrue(shelf.pages.any { it.body.contains("what she says about real tool work stays honest") })
+        assertTrue(page("now: Yume Kisaragi — what is going on with her right now").contains("she tells them as story, habit or a bit"))
+        // And no page sets a source above her own notebook, which her prompt says holds.
+        assertTrue(shelf.pages.none { it.body.contains("which settle any clash") })
+    }
