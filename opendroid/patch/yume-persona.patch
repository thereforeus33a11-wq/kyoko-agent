@@ -0,0 +1,112 @@
+package com.opendroid.ai.core.persona
+
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.llm.error.LLMException
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.net.InetAddress
+
+/**
+ * A try goes through the one gate every prompt passes, judged with the settings her replies
+ * would have on the model tried, not the saved ones; and it writes nothing back, not even the
+ * host a key belongs to.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class BrainTrialGateTest {
+
+    private val custom = PersonaEngineTestSetup.CUSTOM
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val endpoint = server.url("/v1").toString()
+    private val settings = PersonaEngineTestSetup.settings()
+    private val factory = PersonaEngineTestSetup.factory(settings)
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    /** Saved: her model was typed for another provider, so a request of hers to it goes nowhere. */
+    private fun saved(): LLMConfig = runBlocking {
+        settings.updateConfig {
+            it.copy(
+                routePolicy = RoutePolicy.ENCRYPTED,
+                activeProvider = custom,
+                customEndpoints = mapOf(custom to endpoint),
+                personaChatProvider = custom,
+                personaChatModel = "her-old-model",
+                personaChatModelProvider = "Ollama"
+            )
+        }
+        settings.llmConfig.first()
+    }
+
+    private fun request(config: LLMConfig) =
+        PersonaEngine.requestOfHers(PersonaEngine.replyRequest("her prompt", listOf(ChatMessage("1", "hi", ChatMessage.Sender.USER))), config)
+
+    @Test
+    fun `the gate judges a try with the settings she would have, and the try ties no key`() {
+        val saved = saved()
+        val tried = saved.copy(personaChatModel = "tried-model", personaChatModelProvider = custom, personaChatExtraBody = """{"reasoning_effort":"none"}""")
+        // Judged with the saved settings, the model is one typed for another provider: nothing is sent.
+        try {
+            runBlocking { factory.getProviderByName(custom).complete(request(tried)) }
+            fail("sent with the saved settings")
+        } catch (e: LLMException) {
+            assertEquals(LLMError.ReplyModelForOtherProvider, e.error)
+        }
+        assertEquals(0, server.requestCount)
+
+        server.enqueue(
+            MockResponse.Builder().code(200).setHeader("Content-Type", "application/json")
+                .body("""{"choices":[{"message":{"content":"hey"},"finish_reason":"stop"}],"usage":{"prompt_tokens":100,"completion_tokens":10}}""")
+                .build()
+        )
+        val reply = runBlocking { factory.providerFor(custom, tried).complete(request(tried)) }
+        assertEquals("hey", reply.content)
+        assertEquals(100, reply.promptTokens)
+        val body = JsonParser.parseString(server.takeRequest().body?.utf8().orEmpty()).asJsonObject
+        assertEquals("tried-model", body.get("model").asString)
+        assertEquals("none", body.get("reasoning_effort").asString)
+        assertEquals(PersonaEngine.CHAT_TEMPERATURE.toDouble(), body.get("temperature").asDouble, 1e-6)
+        // His key went where the provider points, and nothing was written back: the key is still tied to no host.
+        assertEquals(saved, runBlocking { settings.llmConfig.first() })
+        assertFalse(custom in runBlocking { settings.llmConfig.first() }.apiKeyHosts)
+    }
+
+    @Test
+    fun `a route his setting does not allow is refused before anything is sent, whatever is saved`() {
+        val saved = saved()
+        val hosted = saved.copy(
+            customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+            personaChatModel = "deepseek-v4-1-flash-1017-uncensored",
+            personaChatModelProvider = custom,
+            trustVenicePrivate = false
+        )
+        try {
+            runBlocking { factory.providerFor(custom, hosted).complete(request(hosted)) }
+            fail("sent on a hosted route")
+        } catch (e: LLMException) {
+            assertEquals(LLMError.PrivateRouteRequired, e.error)
+            assertFalse(e.requestSent)
+        }
+        assertEquals(0, server.requestCount)
+        assertTrue(BrainChoice.whyNot(hosted, "deepseek-v4-1-flash-1017-uncensored")!!.contains(BrainChoice.TRUST_SWITCH))
+    }
+}
