+    /**
+     * The one turn a request for a moment of hers ends in. A request has to end in a
+     * turn, and nobody wrote this one: it says so, and it says nothing else. The facts
+     * about the moment are in the system text, where nothing can label them as his.
+     */
+    const val TURN =
+        "(not from him, and not a message: the app puts this line here because a request has to end in a turn. " +
+            "it is your own time now. the last block of the text above says what that is.)"
+
+    /** Opens the recent talk where it is given to her as text and not as turns. */
+    const val TALK_HEADING = "=== THE TALK WITH HIM SO FAR (the last of it, oldest first. \"he\" wrote those lines, \"you\" wrote yours) ==="
+
+    /** Opens the block that tells her what a moment of her own is. It stands last in the text. */
+    const val HEADING = "=== YOUR OWN TIME ==="
+
+    /** A span of time in the few words her prompt uses: "20 min", "3 h", "1 h 30 min", "2 days". */
+    fun span(millis: Long): String {
+        val minutes = (millis + MINUTE / 2) / MINUTE
+        return when {
+            minutes < 60 -> "$minutes min"
+            minutes < 24 * 60 -> if (minutes % 60 == 0L) "${minutes / 60} h" else "${minutes / 60} h ${minutes % 60} min"
+            minutes % (24 * 60) == 0L -> if (minutes == 24 * 60L) "1 day" else "${minutes / (24 * 60)} days"
+            else -> "${minutes / 60} h"
+        }
+    }
+
+    /**
+     * The recent talk as a block of the system text. The request for a moment of hers
+     * carries no turn of his: a transcript in the text says who wrote what, and nothing
+     * in it stands where his next message would.
+     */
+    fun talkBlock(dialogue: List<ChatMessage>): String = buildString {
+        append(TALK_HEADING).append('\n')
+        val rows = dialogue.filter { it.text.isNotBlank() }
+        if (rows.isEmpty()) {
+            append("(nothing has been said in this chat yet)")
+        } else {
+            append(
+                rows.joinToString("\n") { row ->
+                    val who = if (row.sender == ChatMessage.Sender.USER) "he" else "you"
+                    // A line of the talk must not be able to open a section of this text.
+                    "$who: " + row.text.trim().replace("===", "= = =")
+                }
+            )
+        }
+    }
