+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersonaNotesTest {
+
+    @Test
+    fun `a well formed line becomes a note`() {
+        val note = PersonaNotes.parseLine("user | hive | he keeps 9 hives and talks about it too much")
+        assertEquals(Note(Kind.USER, "hive", "he keeps 9 hives and talks about it too much"), note)
+        assertEquals("yume.user.hive", note!!.storageKey)
+    }
+
+    @Test
+    fun `keys are normalised and bullets tolerated`() {
+        val note = PersonaNotes.parseLine("- Opinion | Bad Jokes | his jokes are bad and he knows")
+        assertEquals(Note(Kind.OPINION, "bad-jokes", "his jokes are bad and he knows"), note)
+    }
+
+    @Test
+    fun `lines that do not fit the form are dropped`() {
+        for (line in listOf(
+            "", "NONE", "# comment", "user | hive", "mood | x1 | something", "user | !! | text",
+            "user | a | too short key", "user | ok-key | hi", "just a sentence about him"
+        )) {
+            assertNull(line, PersonaNotes.parseLine(line))
+        }
+    }
+
+    @Test
+    fun `long text is cut and control characters removed`() {
+        val note = PersonaNotes.parseLine("rel | stage | " + "x".repeat(500) + "\u0007")!!
+        assertEquals(PersonaNotes.NOTE_CEILING_CHARS, note.text.length)
+        assertFalse(note.text.contains('\u0007'))
+        // The cut is said in the note itself, so what is left is not taken for the whole.
+        assertTrue(note.text.endsWith(PersonaPrompts.CUT_MARK))
+    }
+
+    @Test
+    fun `a reading says which notes it shortened, and a note that only carries the mark of an earlier cut is not one`() {
+        val long = "rel | stage | " + "x".repeat(500)
+        val cutBefore = PersonaNotes.parseLine(long)!!
+        // The note as it was stored after that cut, and as "Copy her notebook" writes it: under 400 characters, mark and all.
+        val copied = cutBefore.toLine()
+        assertTrue(copied.contains(PersonaPrompts.CUT_MARK))
+
+        val reading = PersonaNotes.read("me | soda | melon soda is mine\n$copied\n" + long.replace("stage", "stage-2"))
+
+        assertEquals(listOf("soda", "stage", "stage-2"), reading.notes.map { it.key })
+        assertEquals(listOf("stage-2"), reading.shortened.map { it.key })
+        assertEquals(cutBefore, reading.notes[1])
+        // A thread that was cut keeps its status behind the mark, and counts all the same.
+        val thread = PersonaNotes.read("thread | tab | " + "y".repeat(500) + " | closed")
+        assertEquals(thread.notes, thread.shortened)
+        assertTrue(thread.notes.single().text.endsWith(PersonaPrompts.CUT_MARK + " | closed"))
+        // The last line under a key is the note: a short one written over a long one was not shortened.
+        assertTrue(PersonaNotes.read("$long\nrel | stage | past the polite part").shortened.isEmpty())
+        assertEquals(listOf("stage"), PersonaNotes.read("rel | stage | past the polite part\n$long").shortened.map { it.key })
+        // A line the length limit broke off is taken out of both.
+        val broken = PersonaNotes.withoutBrokenLine(PersonaNotes.read("me | soda | melon soda is mine\n$long"), "me | soda | melon soda is mine\n$long")
+        assertEquals(listOf("soda"), broken.notes.map { it.key })
+        assertTrue(broken.shortened.isEmpty())
+    }
+
+    @Test
+    fun `a note that runs over what she is told is kept whole, up to twice that length`() {
+        assertEquals(200, PersonaNotes.MAX_NOTE_CHARS)
+        assertEquals(400, PersonaNotes.NOTE_CEILING_CHARS)
+        // A model cannot count characters. This thread is some 230 long, and she closed it.
+        val text = "he promised the voice model before the rig, then spent two weeks on boots and called it progress. " +
+            "i told him twice. he says after payday. i do not believe him and i stopped asking, which he will " +
+            "notice in about a month | closed"
+        assertTrue(text.length in 201..399)
+        val note = PersonaNotes.parseLine("thread | rig-voice | $text")!!
+        assertEquals(text, note.text)
+        assertTrue(note.isClosedThread)
+        assertFalse(note.text.contains(PersonaPrompts.CUT_MARK))
+        assertTrue(PersonaNotes.read("thread | rig-voice | $text").shortened.isEmpty())
+    }
+
+    @Test
+    fun `a thread that is too long is cut between two words and keeps its status, so a closed one stays closed`() {
+        val phrase = "the tab at the host club went up again and momo still has not paid it back "
+        val body = "street story: " + phrase.repeat(6)
+        assertTrue(body.length > PersonaNotes.NOTE_CEILING_CHARS)
+        for (status in listOf("open", "stalled", "closed")) {
+            val note = PersonaNotes.parseLine("thread | momo-tab | $body| $status")!!
+            assertTrue(note.text, note.text.length <= PersonaNotes.NOTE_CEILING_CHARS)
+            assertTrue(note.text, note.text.endsWith(PersonaPrompts.CUT_MARK + " | $status"))
+            assertEquals(status == "closed", note.isClosedThread)
+            // Not in the middle of a word.
+            val lastWord = note.text.substringBefore(PersonaPrompts.CUT_MARK).substringAfterLast(' ')
+            assertTrue(lastWord, lastWord in phrase.trim().split(' '))
+        }
+        // Only a thread has a status: the same words at the end of another note are its text.
+        val user = PersonaNotes.parseLine("user | door | " + "x".repeat(500) + " | closed")!!
+        assertTrue(user.text.endsWith(PersonaPrompts.CUT_MARK))
+    }
+
+    @Test
+    fun `the last line of a reply that broke off at the length limit is not kept as a whole note`() {
+        val content = "me | soda | melon soda is mine\nuser | bees | he keeps bees and sells the ho"
+        val reading = PersonaNotes.read(content, limit = 5)
+        assertEquals(listOf("soda", "bees"), reading.notes.map { it.key })
+
+        val cutOff = PersonaNotes.withoutBrokenLine(reading, content)
+        assertEquals(listOf("soda"), cutOff.notes.map { it.key })
+        assertEquals(listOf("user | bees | he keeps bees and sells the ho"), cutOff.notTaken)
+
+        // A last line that was no note anyway changes nothing, and neither does an empty reply.
+        val talk = "me | soda | melon soda is mine\nand that is all i"
+        assertEquals(listOf("soda"), PersonaNotes.withoutBrokenLine(PersonaNotes.read(talk), talk).notes.map { it.key })
+        assertTrue(PersonaNotes.withoutBrokenLine(PersonaNotes.read(""), "").notes.isEmpty())
+    }
+
+    @Test
+    fun `a key is made to fit instead of losing the note under it`() {
+        assertEquals("dads-job", PersonaNotes.parseLine("user | dad's-job | his dad drives a truck")!!.key)
+        assertEquals("dads-job", PersonaNotes.parseLine("user | Dad\u2019s Job | his dad drives a truck")!!.key)
+        assertEquals("v2-0-rig", PersonaNotes.parseLine("thread | v2.0_rig | the rig is half done | open")!!.key)
+        // A slug that is too long is cut to the longest key there is, and still parses.
+        val long = PersonaNotes.parseLine("user | the story of the day he found the first swarm in the orchard | he tells it at every dinner")!!
+        assertEquals("the-story-of-the-day-he-found-the-first", long.key)
+        assertEquals(long, PersonaNotes.parseLine(long.toLine()))
+        // What is no key at all is still none.
+        assertNull(PersonaNotes.parseLine("user | ?! | he tells it at every dinner"))
+    }
+
+    @Test
+    fun `reading a block says which lines were meant as notes and were not taken`() {
+        val reading = PersonaNotes.read(
+            """
+            NONE
+            a word of talk that is no note
+            # a comment | with a bar
+            me | soda | melon soda is mine
+            mood | x1 | not a kind the notebook has
+            user | bees
+            user | bees | he keeps bees
+            rel | stage | past the polite part
+            """.trimIndent(),
+            limit = 2
+        )
+        assertEquals(listOf("soda", "bees"), reading.notes.map { it.key })
+        // No kind, no text, and one line past the limit. Talk, NONE and a comment are not counted.
+        assertEquals(
+            listOf("mood | x1 | not a kind the notebook has", "user | bees", "rel | stage | past the polite part"),
+            reading.notTaken
+        )
+        assertEquals(reading.notes, PersonaNotes.parse("me | soda | melon soda is mine\nuser | bees | he keeps bees"))
+        assertTrue(PersonaNotes.read("NONE").notTaken.isEmpty())
+    }
+
+    @Test
+    fun `parse keeps the last note per key and honours the limit`() {
+        val text = """
+            user | bee | he keeps 9 hives
+            chatter that is not a note
+            user | bee | he sold the hive
+            thread | body | 3d model: rig still missing | open
+            opinion | hosts | hosts are scammers with good hair
+            fix | emoji | stop ending lines with an emoji
+        """.trimIndent()
+        val all = PersonaNotes.parse(text)
+        assertEquals(listOf("he sold the hive"), all.filter { it.key == "bee" }.map { it.text })
+        assertEquals(4, all.size)
+        assertEquals(2, PersonaNotes.parse(text, limit = 2).size)
+    }
+
+    @Test
+    fun `a closed thread is recognised`() {
+        assertTrue(PersonaNotes.parseLine("thread | body | rig finished | closed")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("thread | body | rig missing | open")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("user | door | he closed the shop | closed")!!.isClosedThread)
+    }
+
+    @Test
+    fun `storage round trip and foreign rows`() {
+        val note = Note(Kind.THREAD, "body", "rig missing | open")
+        assertEquals(note, PersonaNotes.fromStorage(note.storageKey, note.text))
+        assertNull(PersonaNotes.fromStorage("wife_name", "Sara"))
+        assertNull(PersonaNotes.fromStorage("yume.meta.seeded", "1"))
+        assertNull(PersonaNotes.fromStorage("yume.user.", "x"))
+    }
+
+    @Test
+    fun `render groups the notes under headings in a fixed order, what he corrected first`() {
+        val notes = listOf(
+            Note(Kind.OPINION, "hosts", "hosts are scammers"),
+            Note(Kind.USER, "bee", "he keeps 9 hives"),
+            Note(Kind.ME, "soda", "melon soda is mine and i do not share"),
+            Note(Kind.FIX, "emoji", "an emoji at the end of every line read as fake"),
+            Note(Kind.THREAD, "body", "rig missing | open"),
+            Note(Kind.REL, "stage", "past the polite part")
+        )
+        val block = PersonaNotes.render(notes)
+        val order = listOf(
+            "What he corrected or called fake (the detail as it is now, or the line and what was off: examples, not a ban list):",
+            "- an emoji at the end of every line read as fake",
+            "Where you two stand:",
+            "- past the polite part",
+            "Who you are now (your own call, newer than your files; you change it when you change):",
+            "- melon soda is mine and i do not share",
+            "What you know about him:",
+            "- he keeps 9 hives",
+            "Still going on:",
+            "- rig missing | open",
+            "What you think now:",
+            "- hosts are scammers"
+        )
+        assertEquals(order.joinToString("\n"), block)
+        // A correction is an example she keeps, not an order she now follows.
+        assertFalse(block.contains("this is how you do it now"))
+        assertEquals("", PersonaNotes.render(emptyList()))
+    }
+
+    private fun sized(kind: Kind, key: String, chars: Int) = Note(kind, key, "$key ".padEnd(chars, 'x'))
+
+    @Test
+    fun `what he corrected gets a third of the room at most, so it cannot push out the rest`() {
+        // Each note costs 100 characters: twelve corrections would have filled the room alone.
+        val fixes = (1..12).map { sized(Kind.FIX, "fix-$it", 97) }
+        val aboutHim = (1..12).map { sized(Kind.USER, "him-$it", 97) }
+
+        val block = PersonaNotes.render(fixes + aboutHim, maxChars = 1200)
+
+        val shownFixes = (1..12).filter { block.contains("- fix-$it x") }
+        val shownAboutHim = (1..12).filter { block.contains("- him-$it x") }
+        // A third of 1,200 holds the four newest corrections; the rest of the room is for the rest.
+        assertEquals(listOf(1, 2, 3, 4), shownFixes)
+        assertEquals((1..8).toList(), shownAboutHim)
+        assertTrue(block.indexOf("- fix-1 ") < block.indexOf("- him-1 "))
+        assertTrue(block, block.endsWith("\n(12 older notes of yours are not shown here)"))
+    }
+
+    @Test
+    fun `corrections beyond their third are still shown when everything else has had its place`() {
+        val fixes = (1..6).map { sized(Kind.FIX, "fix-$it", 97) }
+        val block = PersonaNotes.render(fixes + Note(Kind.USER, "bees", "he keeps bees"), maxChars = 1200)
+        for (number in 1..6) assertTrue("fix-$number", block.contains("- fix-$number x"))
+        assertTrue(block.contains("- he keeps bees"))
+        assertFalse(block.contains("not shown"))
+    }
+
+    @Test
+    fun `notes that do not fit are counted in one line, and they are always the older ones`() {
+        val views = (1..6).map { Note(Kind.OPINION, "view-$it", "view number $it holds") }
+
+        // Each costs 22 characters, so 70 hold three.
+        assertEquals(
+            "What you think now:\n- view number 1 holds\n- view number 2 holds\n- view number 3 holds\n" +
+                "(3 older notes of yours are not shown here)",
+            PersonaNotes.render(views, maxChars = 70)
+        )
+        assertTrue(PersonaNotes.render(views.take(4), maxChars = 70).endsWith("\n(1 older note of yours is not shown here)"))
+        assertFalse(PersonaNotes.render(views, maxChars = 6 * 22).contains("not shown"))
+
+        // A short old note does not slip in past a newer one that did not fit.
+        val uneven = listOf(
+            Note(Kind.OPINION, "aa", "a".repeat(30)),
