+    /** "your last outing: <your go: words>, <ago>, <minutes> min: <counts>. ..." */
+    internal fun lastOutingLine(outing: LastOuting, nowMillis: Long, thoughtsLeftOut: Boolean): String =
+        when {
+            outing.isLook -> lastLookLine(outing, nowMillis, thoughtsLeftOut)
+            outing.onHisScreen -> lastPhoneLine(outing, nowMillis, thoughtsLeftOut)
+            else -> lastReadLine(outing, nowMillis, thoughtsLeftOut)
+        } + if (outing.untoldDrops > 0) " " + com.opendroid.ai.core.life.KidGuard.NOT_KEPT else ""
