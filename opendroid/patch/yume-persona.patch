+    /**
+     * How long ago something was written, in the few words her prompt gives it. Rough on
+     * purpose: she only has to know whether a line is from just now or from another day.
+     */
+    internal fun age(elapsedMillis: Long): String {
+        val minutes = elapsedMillis / 60_000
+        return when {
+            minutes < 1 -> "just now"
+            minutes < 60 -> "$minutes min ago"
+            minutes < 24 * 60 -> "${minutes / 60} h ago"
+            minutes < 48 * 60 -> "yesterday"
+            else -> "${minutes / (24 * 60)} days ago"
+        }
+    }
