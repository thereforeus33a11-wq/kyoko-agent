+/** Timeout and extra request-body options for the active hosted OpenAI-compatible provider. */
+@Composable
+fun HostedProviderOptionsCard(config: LLMConfig, viewModel: SettingsViewModel) {
+    val provider = config.activeProvider
+    val savedTimeout = config.resolvedCloudTimeoutSeconds()
+    var timeoutText by remember { mutableStateOf(savedTimeout.toString()) }
+    LaunchedEffect(savedTimeout) {
+        val typed = timeoutText.toIntOrNull()?.let(CloudTimeout::clamp)
+        if (typed != savedTimeout) timeoutText = savedTimeout.toString()
+    }
+    val extraBody = config.extraBodyParams[provider].orEmpty()
+
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp)) {
+            Text(
+                text = "HOSTED MODEL OPTIONS",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = TextPrimary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = timeoutText,
+                onValueChange = { input ->
+                    val digits = input.filter(Char::isDigit).take(3)
+                    timeoutText = digits
+                    digits.toIntOrNull()?.let(viewModel::updateCloudTimeout)
+                },
+                label = { Text("Response Timeout (seconds)", fontSize = 12.sp) },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                colors = fieldColors(),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .onFocusChanged { focus ->
+                        if (!focus.isFocused) timeoutText = savedTimeout.toString()
+                    }
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = "How long to wait for a reply (${CloudTimeout.MIN_SECONDS}–${CloudTimeout.MAX_SECONDS}s). Applies to Custom OpenAI Compatible and OpenRouter.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = extraBody,
+                onValueChange = { viewModel.updateExtraBodyParams(provider, it) },
+                label = { Text("Extra request options (JSON)", fontSize = 12.sp) },
+                isError = !OpenAiCompatExtras.isValidExtraBody(extraBody),
+                minLines = 2,
+                maxLines = 6,
+                colors = fieldColors(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = "Optional. A JSON object added to every request to $provider, for options the endpoint documents, for example {\"reasoning_effort\": \"none\"}. Ignored unless it is valid JSON.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+        }
+    }
+}
