+// ── "Her day". Each sentence says what the code does, and a test holds them against it.
+
+/** Over the list: what it is made of, and what it never holds. */
+internal const val HER_DAY_HINT =
+    "What she did on her own, from the app's log: when, where, the titles of the pages she opened, her search " +
+        "words, the commands she gave the phone, counts and model calls, and how each ended. What she thought, " +
+        "noted or felt is never in it. Entries older than 90 days go by themselves."
+
+/** Asked before the log is cleared: what goes, and what stays. */
+internal const val HER_DAY_CLEAR_CONFIRM =
+    "Every entry of her day is deleted from this phone, except an outing still running. Her notes, her thoughts, " +
+        "her wonders and the count of her calls on her own stay as they are."
+
+/** What the list says while there is nothing in it. */
+internal const val HER_DAY_EMPTY = "Nothing yet: she has done nothing on her own that the log keeps."
+
+/**
+ * "Her day": what she did on her own, day by day, newest first, with a Clear button that
+ * asks first. Opened from her card screen.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun HerDayScreen(viewModel: HerDayViewModel, onNavigateBack: () -> Unit) {
+    var confirmClear by remember { mutableStateOf(false) }
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(
+                        text = "HER DAY",
+                        fontFamily = FontFamily.Monospace,
+                        fontWeight = FontWeight.Bold,
+                        color = TextPrimary,
+                        fontSize = 20.sp
+                    )
+                },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(imageVector = Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back", tint = TextPrimary)
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBackground)
+            )
+        },
+        containerColor = DarkBackground
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .padding(horizontal = 16.dp, vertical = 8.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Text(text = HER_DAY_HINT, fontSize = 11.sp, color = TextSecondary)
+            if (viewModel.status.isNotEmpty()) {
+                Text(text = viewModel.status, fontSize = 12.sp, color = AccentCyan)
+            }
+            val days = viewModel.days
+            if (days == null) {
+                CircularProgressIndicator(color = AccentCyan)
+                return@Column
+            }
+            OutlinedButton(
+                onClick = { confirmClear = true },
+                enabled = days.isNotEmpty(),
+                modifier = Modifier.fillMaxWidth()
+            ) { Text("Clear her day", color = AccentRed) }
+            if (days.isEmpty()) {
+                Text(text = HER_DAY_EMPTY, fontSize = 12.sp, color = TextSecondary)
+                return@Column
+            }
+            LazyColumn(
+                modifier = Modifier.fillMaxSize(),
+                verticalArrangement = Arrangement.spacedBy(6.dp)
+            ) {
+                days.forEach { day ->
+                    item(key = "day-" + day.heading) {
+                        Text(
+                            text = day.heading.uppercase(),
+                            fontSize = 11.sp,
+                            fontWeight = FontWeight.Bold,
+                            fontFamily = FontFamily.Monospace,
+                            color = AccentCyan,
+                            modifier = Modifier.padding(top = 8.dp)
+                        )
+                    }
+                    items(day.lines) { line ->
+                        Text(text = line, fontSize = 12.sp, color = TextPrimary)
+                    }
+                }
+            }
+        }
+    }
+
+    if (confirmClear) {
+        AlertDialog(
+            onDismissRequest = { confirmClear = false },
+            title = { Text("Clear her day?") },
+            text = { Text(HER_DAY_CLEAR_CONFIRM) },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmClear = false
+                    viewModel.clear()
+                }) { Text("Clear it") }
+            },
+            dismissButton = { TextButton(onClick = { confirmClear = false }) { Text("Cancel") } }
+        )
+    }
+}
