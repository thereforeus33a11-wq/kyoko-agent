+    // ── Charsets ─────────────────────────────────────────────────────────────────────
+
+    private val META_CHARSET = Regex("""(?i)<meta[^>]+charset\s*=\s*["']?\s*([A-Za-z0-9._:-]+)""")
+    private val XML_ENCODING = Regex("""(?i)<\?xml[^>]+encoding\s*=\s*["']([A-Za-z0-9._:-]+)["']""")
+    private val HEADER_CHARSET = Regex("""(?i)charset\s*=\s*["']?([A-Za-z0-9._:-]+)""")
