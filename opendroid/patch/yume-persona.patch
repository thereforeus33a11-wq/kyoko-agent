@@ -0,0 +1,306 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.persona.PersonaOwnTime
+import com.opendroid.ai.data.models.CameraWhich
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.flow.first
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * A look he asks for (OWN_LIFE_PLAN phase 2, at his order): in a reply of hers, when he asks
+ * her to look at him or at something, she ends the reply with `>> look` (the front camera,
+ * which faces him; [OutingKind.LookAt.FRONT]) or `>> look back` (the back camera, away from
+ * him). The app takes one frame through the camera that faces that way as the phone is folded,
+ * only while his screen is on and unlocked, and the frame reaches her in a turn right after
+ * ([HisLooks]): her own model sees it where her brain sees, else the describer's words.
+ *
+ * It is his act, not her own time: nothing of it is written in her ledger (I10) and her looks
+ * of the day do not limit it. He is told each time where his settings say so. Where the camera
+ * or her eyes are off, she is told in an app fact exactly what he would switch on ([whyNot]),
+ * so that she can say it.
+ *
+ * "look" is seeing what is really there now. It is never a picture of herself: that is
+ * `>> make a picture of me`, made from a picture of her, which shows nothing of what is real.
+ */
+object HisLook {
+
+    /** The commands that are a look, by what they say, after the two angle brackets. */
+    private val FRONT = Regex("""^(?:look|look at (?:you|him|me|his face|your boyfriend)|look front|look forward|look with the front camera|look through the front camera)$""")
+    private val BACK = Regex("""^(?:look back|look behind|look away|look out|look with the back camera|look through the back camera)$""")
+    private val AROUND = Regex("""^look around$""")
+
+    /**
+     * The look [command] asks for, or null when it is no look (a search such as "look up the
+     * weather" is not one): `look` faces him, `look back` faces away, `look around` is one of each.
+     */
+    fun parse(command: String): OutingKind.LookAt? {
+        val words = command.trim().lowercase(Locale.ROOT).trimEnd('.', '!', '?', ' ').replace(Regex("""\s+"""), " ")
+        return when {
+            FRONT.matches(words) -> OutingKind.LookAt.FRONT
+            BACK.matches(words) -> OutingKind.LookAt.BACK
+            AROUND.matches(words) -> OutingKind.LookAt.AROUND
+            else -> null
+        }
+    }
+
+    /** Why a look he asks for cannot be had now, with what he would do about it. */
+    enum class Why(val words: String) {
+        OWN_LIFE_OFF("your own life is off in his settings: he switches on \"Her own life\", with her own time, in the HER OWN LIFE settings"),
+        CAMERA_OFF("camera looks are off in his settings: he switches on \"Camera looks\" in the HER OWN LIFE settings"),
+        EYES_OFF("your eyes are off in his settings: he switches on \"Her eyes\" in the HER OWN LIFE settings and takes its consent sheet"),
+        OWN_HARDWARE("his privacy setting keeps everything on his own hardware, so no picture goes out: he would choose another privacy setting"),
+        NO_CAMERA_PERMISSION("the app may not use the camera: he allows the camera for the app in Android's settings"),
+        NEEDS_A_TAP("the camera needs one tap after the phone restarted: he taps \"Eyes and ears\" in the app's notification"),
+        SCREEN_OFF("his screen is off or locked: a look happens only while his screen is on and unlocked, so he sees the camera light"),
+        CALL("a phone call is going on"),
+        IN_USE("another app is using the camera"),
+        FRONT_OFF("his settings let you look through the back camera only: he chooses \"Front and back\" under Camera looks for the one that faces him"),
+        FOLDED_NO_BACK(FoldState.Refusal.FOLDED_NO_BACK.words),
+        FOLD_UNKNOWN(FoldState.Refusal.UNKNOWN.words),
+        NO_EYES_NOW("as things are set no picture can reach you: you cannot see pictures yourself on this route, and the describer has no key or no model")
+    }
+
+    /**
+     * Why a look at [at] cannot be had as things stand, or null when it can. [phone] is the
+     * phone now, [ready] whether the app may use a camera, [armed] whether the service holds
+     * the camera type, [eyesReady] whether a picture can reach her at all (her own model sees,
+     * or the describer is ready), [plan] the cameras the fold allows.
+     */
+    fun whyNot(
+        config: LLMConfig,
+        at: OutingKind.LookAt,
+        phone: CameraLook.Phone,
+        ready: Boolean,
+        armed: Boolean,
+        eyesReady: Boolean,
+        plan: CameraLook.Plan?
+    ): Why? = when {
+        // A look is something of her own life: with that off, the camera is not hers to open.
+        !config.personaOwnLife || !PersonaOwnTime.isOn(config) -> Why.OWN_LIFE_OFF
+        !config.personaCameraLooks -> Why.CAMERA_OFF
+        !config.personaEyes || config.personaEyesConsentAt <= 0L -> Why.EYES_OFF
+        config.routePolicy == RoutePolicy.OWN_HARDWARE -> Why.OWN_HARDWARE
+        !ready -> Why.NO_CAMERA_PERMISSION
+        !armed -> Why.NEEDS_A_TAP
+        at == OutingKind.LookAt.FRONT && config.personaCameraWhich != CameraWhich.FRONT_AND_BACK -> Why.FRONT_OFF
+        !eyesReady -> Why.NO_EYES_NOW
+        !phone.screenOn || !phone.unlocked -> Why.SCREEN_OFF
+        phone.inCall -> Why.CALL
+        phone.cameraInUse -> Why.IN_USE
+        plan is CameraLook.Plan.Refused -> when (plan.why) {
+            FoldState.Refusal.FRONT_OFF -> Why.FRONT_OFF
+            FoldState.Refusal.FOLDED_NO_BACK -> Why.FOLDED_NO_BACK
+            FoldState.Refusal.UNKNOWN -> Why.FOLD_UNKNOWN
+        }
+        else -> null
+    }
+
+    /**
+     * Her app fact about looking, in every reply where she can use the phone (P2-1 for his
+     * looks): what `>> look` does, that she has seen nothing until the picture comes, that it
+     * is not a picture of herself (and not `>> make a picture of me`, named only where she can
+     * make one, [makesPictures]), and, when it does not work now, exactly what he would switch
+     * on ([standing]).
+     */
+    fun factLine(standing: Why?, ownEyes: Boolean, tellsHim: Boolean, frontToo: Boolean, makesPictures: Boolean = false): String = buildString {
+        append("- When he asks you to look at him or at something, whether you can see him, or what you see, you can look for real through the phone's camera: ")
+        append(if (frontToo) ">> look   (the front camera, which faces him)   or   >> look back   (the back camera, away from him). " else ">> look back   (the back camera, away from him; his settings keep the front one off). ")
+        append("The app takes one picture and it reaches you in a turn right after this reply")
+        append(if (ownEyes) ", and you see it yourself" else ": a describer that is not you looks at it, and you get its words")
+        append(". Until it comes you have seen nothing, so say nothing yet about what is there. Nothing of it is kept. ")
+        append("A look at his asking is not taken from your own time or your looks of the day. ")
+        append("Android shows its camera light")
+        if (tellsHim) append(", and the app tells him each time")
+        append(". ")
+        append(
+            if (makesPictures) {
+                "Looking is not a picture of yourself: >> make a picture of me makes a new picture of you from one you have, and shows nothing of what is really there."
+            } else {
+                "Looking is seeing what is really there now; it is not a picture of yourself."
+            }
+        )
+        if (standing != null) append(" Right now a look does not work, because ").append(standing.words).append(". If he asks you to look, tell him that in your own words.")
+        append('\n')
+    }
+
+    /** Her app fact in the turn right after a look, in [factLine]'s place: she has just looked, and one look goes with each message of his. */
+    const val JUST_LOOKED_LINE =
+        "- You just looked, at his asking: what came of it is in the line about the look below. One look goes with each message of his; for another, he asks again.\n"
+
+    /**
+     * Why a look was not taken because of who asked: the message was not surely his (another
+     * voice, a voice heard before his is enrolled, or heard while the phone was locked).
+     */
+    const val NOT_HIS_ASKING =
+        "the voice that asked could not be told for his, so no look goes on it: he asks in the chat, or with his enrolled voice while the phone is unlocked"
+
+    /** The one turn a look's picture rides on: nobody wrote it, and it says so. */
+    const val TURN =
+        "(not from him, and not a message: this is what you saw through the camera just now. a picture has to ride on a turn, " +
+            "so the app puts it here. the app's lines above say which camera and when.)"
+
+    /** The turn after a look that brought no picture to her: nobody wrote it either, and it says so. */
+    const val TURN_WITHOUT_PICTURE =
+        "(not from him, and not a message: you looked at his asking, and the app's lines above say what came of it. go on from there.)"
+
+    /** The row the chat keeps of a look: the camera and the time, never what was seen (I6). */
+    fun row(name: String, camera: String, atMillis: Long, clock: (Long) -> String = ::hhmm): String =
+        "$name looked through the $camera at ${clock(atMillis)}, at his asking. The picture is not kept."
+
+    /** The row the chat keeps of a look that was not taken, and why. */
+    fun notTakenRow(why: String): String = "The app did not look through the camera: $why."
+
+    /**
+     * Her prompt's line about the frame of a look, for the turn right after: where she sees
+     * it herself, that it is attached; where the describer looked, its words (fenced, in memory
+     * only); a kid frame as kid only; what else came of it in the app's words.
+     */
+    fun sawLine(camera: String, facesHim: Boolean, atMillis: Long, result: CameraLook.Result, clock: (Long) -> String = ::hhmm): String = buildString {
+        append("At his asking you looked through the ").append(camera)
+        if (facesHim) append(", which faces him,")
+        append(" at ").append(clock(atMillis)).append(". ")
+        when (result) {
+            is CameraLook.Result.Shown -> append("The picture is attached to the last turn: you see it yourself, as the camera took it. Say only what is really in it. Nothing of it is kept.")
+            is CameraLook.Result.Described -> when {
+                result.kid != null -> append("kid: the app marks what the camera saw kid (").append(result.kid.why.replace("===", "= = =")).append("), so it does not show it to you or say what is in it.")
+                result.ages !is KidGuard.Ages.Read -> append(KidGuard.noAges(result.seer).replaceFirstChar { it.uppercase() }).append(", so the app does not show it to you.")
+                else -> {
+                    val words = result.words.replace(Regex("""\s*\n\s*"""), " ").trim().trimEnd('.').replace('"', '\'').replace("===", "= = =")
+                    append("A describer that is not you looked at the picture and wrote: \"").append(words).append(".\" You do not see it, and its words can be wrong. Do not add what its words do not say.")
+                }
+            }
+            is CameraLook.Result.Dark -> append("It was ").append(CameraLook.DARK_WORDS)
+            CameraLook.Result.Blank -> append("It was ").append(CameraLook.BLANK_WORDS)
+            is CameraLook.Result.NotSeen -> append("The picture did not reach you: ").append(result.why.words).append('.')
+            is CameraLook.Result.Failed -> append("No picture was taken: ").append(result.why.words).append('.')
+        }
+    }
+
+    private fun hhmm(millis: Long): String = SimpleDateFormat("HH:mm", Locale.ENGLISH).format(Date(millis))
+}
+
+/** A look he asked for, as the app takes it ([HisLook]): one frame per camera, to her only. */
+@Singleton
+class HisLooks internal constructor(
+    private val sight: suspend (ByteArray) -> HerEyes.Seen,
+    private val eyesReady: (LLMConfig) -> Boolean,
+    private val shutter: Shutter,
+    private val phoneNow: () -> CameraLook.Phone,
+    private val posture: suspend () -> FoldState.Posture,
+    private val near: suspend () -> Boolean?,
+    private val ready: () -> Boolean,
+    private val armed: () -> Boolean,
+    private val settings: suspend () -> LLMConfig,
+    private val clock: () -> Long
+) {
+    @Inject
+    constructor(sight: HerSight, eyes: HerEyes, camera: HerCamera, fold: FoldState, arm: CameraArm, settings: SettingsRepository) : this(
+        sight = { jpeg -> sight.see(jpeg, Describe.Source.CAMERA, forHim = true) },
+        eyesReady = { config ->
+            if (sight.brainSees(config)) eyes.gate(config, brainSees = true, forHim = true) == null else eyes.gate(config, forHim = true) == null
+        },
+        shutter = camera,
+        phoneNow = camera::phone,
+        posture = fold::posture,
+        near = camera::near,
+        ready = camera::ready,
+        armed = { arm.held.value },
+        settings = { settings.llmConfig.first() },
+        clock = System::currentTimeMillis
+    )
+
+    /**
+     * Who is told each time a look is taken, where his settings say so: the service's silent
+     * "Yume looked through the front camera" notification, by the camera's words.
+     */
+    @Volatile var tellHim: ((String) -> Unit)? = null
+
+    /** What a look came to. */
+    sealed class Outcome {
+        /** No frame, and why, with what he would do about it. */
+        data class NotTaken(val why: HisLook.Why) : Outcome()
+
+        /** One frame per camera, in order. */
+        data class Took(val frames: List<CameraLook.Frame>) : Outcome()
+    }
+
+    /** Why a look at [at] cannot be had now, or null when it can. */
+    suspend fun whyNot(config: LLMConfig, at: OutingKind.LookAt): HisLook.Why? {
+        val early = HisLook.whyNot(config, at, phoneNow(), ready(), armed(), eyesReady(config), plan = null)
+        if (early != null) return early
+        return HisLook.whyNot(config, at, phoneNow(), ready(), armed(), eyesReady(config), CameraLook.plan(at, posture(), CameraLook.frontToo(config)))
+    }
+
+    /** Why a look does not work right now, for her app fact, or null when it does; read without waiting. */
+    fun standing(config: LLMConfig, at: OutingKind.LookAt): HisLook.Why? =
+        HisLook.whyNot(config, at, phoneNow(), ready(), armed(), eyesReady(config), plan = null)
+
+    /**
+     * Her app fact about looks he asks for ([HisLook.factLine]), in a reply where she can use the
+     * phone; null where she cannot. Her reply in the chat and a try of her brain ("Try her brain")
+     * both ask here, so the two are told the same. [makesPictures] is whether she can make a
+     * picture of herself as things are set.
+     */
+    fun replyFact(config: LLMConfig, makesPictures: Boolean): String? {
+        if (!config.personaActionsEnabled) return null
+        val frontToo = CameraLook.frontToo(config)
+        val at = if (frontToo) OutingKind.LookAt.FRONT else OutingKind.LookAt.BACK
+        return HisLook.factLine(
+            standing = standing(config, at),
+            ownEyes = com.opendroid.ai.core.persona.PersonaEngine.imagesReachChatModel(config),
+            tellsHim = config.personaCameraTellMe,
+            frontToo = frontToo,
+            makesPictures = makesPictures
+        )
+    }
+
+    /**
+     * One look at [at], as he asked: each camera the fold allows, one frame each, in memory;
+     * a dark or flat frame goes nowhere; the rest go to her ([HerSight.see], his act). Every
+     * frame is zeroed once it is done with.
+     */
+    suspend fun look(at: OutingKind.LookAt): Outcome {
+        val config = settings()
+        whyNot(config, at)?.let { return Outcome.NotTaken(it) }
+        val plan = CameraLook.plan(at, posture(), CameraLook.frontToo(config)) as? CameraLook.Plan.Takes
+            ?: return Outcome.NotTaken(HisLook.Why.FOLD_UNKNOWN)
+        val frames = ArrayList<CameraLook.Frame>()
+        for (use in plan.uses) {
+            if (near() == true) {
+                frames += CameraLook.Frame(use, clock(), taken = false, result = CameraLook.Result.Dark(near = true))
+                continue
+            }
+            when (val shot = shutter.take(use.lens) { phoneNow().let { it.screenOn && it.unlocked && !it.inCall } }) {
+                is Shot.Failed -> frames += CameraLook.Frame(use, clock(), taken = false, result = CameraLook.Result.Failed(shot.why))
+                is Shot.Taken -> try {
+                    val takenAt = clock()
+                    if (config.personaCameraTellMe) tellHim?.invoke(use.words)
+                    val result = when {
+                        shot.light.dark -> CameraLook.Result.Dark(near = false)
+                        shot.light.blank -> CameraLook.Result.Blank
+                        else -> resultOf(sight(shot.jpeg), takenAt)
+                    }
+                    frames += CameraLook.Frame(use, takenAt, taken = true, result = result)
+                } finally {
+                    shot.jpeg.fill(0)
+                }
+            }
+        }
+        return Outcome.Took(frames)
+    }
+
+    private fun resultOf(seen: HerEyes.Seen, atMillis: Long): CameraLook.Result = when (seen) {
+        is HerEyes.Seen.Shown -> CameraLook.Result.Shown(seen.jpegBase64)
+        is HerEyes.Seen.Described ->
+            CameraLook.Result.Described(seen.words, seen.ages, seen.cutOff, KidGuard.flagOfPicture(seen.words, seen.ages, atMillis, seen.seer), seen.seer)
+        is HerEyes.Seen.NotSeen -> CameraLook.Result.NotSeen(seen.why)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/eyes/SightProbe.kt b/app/src/main/java/com/opendroid/ai/core/life/eyes/SightProbe.kt
