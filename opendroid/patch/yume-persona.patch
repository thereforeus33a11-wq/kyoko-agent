+        val originalBytes = File(uri.path!!).readBytes()
+
+        val picture = add(uri, Kind.BACKGROUND)
+
+        val file = storedFile(picture)
+        assertEquals(1024 to 768, sizeOf(file))
+        // JPEG, whatever the picture was before.
+        val head = file.readBytes().take(3).map { it.toInt() and 0xFF }
+        assertEquals(listOf(0xFF, 0xD8, 0xFF), head)
+        assertTrue(picture.file.endsWith(".jpg"))
+        assertFalse(picture.asGiven)
+        assertArrayEquals(originalBytes, File(uri.path!!).readBytes())
+        assertEquals(512 to 1024, sizeOf(storedFile(add(picked(900, 1800), Kind.BACKGROUND))))
+        assertEquals(300 to 200, sizeOf(storedFile(add(picked(300, 200), Kind.BACKGROUND))))
+    }
+
