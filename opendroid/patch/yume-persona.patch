+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+/**
+ * "Try her brain" ([BrainTrial]), on his tap only: his choice of two to four models (the
+ * shortlist ticked to start with), his one message or the last real exchange, her real reply
+ * prompt to each through the route it would take as her brain, the replies side by side with
+ * time, tokens and price, and one tap to make a model hers ([BrainChoice.use]). The replies
+ * live in this screen's memory only and are gone when it closes or a new try starts.
+ */
+@HiltViewModel
+class BrainTrialViewModel internal constructor(
+    private val settings: suspend () -> LLMConfig,
+    private val save: suspend ((LLMConfig) -> LLMConfig) -> Unit,
+    private val trial: BrainTrial
+) : ViewModel() {
+
+    @Inject
+    constructor(
+        settings: SettingsRepository,
+        engine: PersonaEngine,
+        factory: LLMProviderFactory,
+        conversations: ConversationRepository,
+        hisLooks: dagger.Lazy<HisLooks>
+    ) : this(
+        settings = { settings.llmConfig.first() },
+        save = { update -> settings.updateConfig(update) },
+        trial = BrainTrial(
+            // The chat he is in, read only: a chat that does not exist yet is not made for this.
+            recentRows = { conversations.currentSessionId.first()?.let { conversations.getLastMessages(it, HISTORY_ROWS) }.orEmpty() },
+            prompt = { config, rows -> engine.trialRequest(config, rows, lookLine(hisLooks, engine, config)) },
+            send = { config, request -> factory.providerFor(HerBrain.PROVIDER, config).complete(request) }
+        )
+    )
+
+    /** One model as the list offers it. */
+    class Choice(
+        val id: String,
+        val label: String,
+        /** What the research says of it, for a model of the shortlist; empty otherwise. */
+        val note: String,
+        val shortlisted: Boolean,
+        /** Why it cannot be tried or chosen as things are set; null when it can. */
+        val whyNot: String?,
+        val route: String,
+        val senses: String,
+        val thinking: String,
+        /** What a typical reply of hers costs on it, or null where the price is not known. */
+        val typicalUsd: Double?,
+        /** It is her brain now. */
+        val current: Boolean
+    )
+
+    /** One model's place in the results: waiting, her reply, or why there is none. */
+    class Row(
+        val choice: Choice,
+        val millis: Long? = null,
+        val shown: BrainTrial.Shown? = null
+    ) {
+        val done: Boolean get() = shown != null
+    }
+
+    var choices by mutableStateOf<List<Choice>>(emptyList())
+        private set
+
+    /** The models chosen for the next try. */
+    var chosen by mutableStateOf<Set<String>>(emptySet())
+        private set
+
+    /** The models outside the shortlist are shown too. */
+    var showAll by mutableStateOf(false)
+        private set
+
+    /** His message for the try, never stored. */
+    var message by mutableStateOf("")
+        private set
+
+    /** The last real exchange is asked again instead of his message. */
+    var useLast by mutableStateOf(false)
+        private set
+
+    var running by mutableStateOf(false)
+        private set
+
+    /** What stands in the way of a try, or a word about the last one or a choice made. */
+    var status by mutableStateOf("")
+        private set
+
+    /** Her brain now, in a line. */
+    var now by mutableStateOf("")
+        private set
+
+    val rows = mutableStateListOf<Row>()
+
+    private var job: Job? = null
+    private var ticked = false
+
+    init {
+        viewModelScope.launch { refresh() }
+    }
+
+    private suspend fun refresh() {
+        val config = settings()
+        choices = choicesFor(config)
+        now = nowLine(config)
+        if (!ticked) {
+            ticked = true
+            chosen = defaultChosen(choices)
+        }
+    }
+
+    fun toggle(id: String) {
+        if (running) return
+        val choice = choices.firstOrNull { it.id == id } ?: return
+        chosen = when {
+            id in chosen -> chosen - id
+            choice.whyNot != null -> chosen.also { status = choice.whyNot }
+            chosen.size >= BrainModels.MAX_PER_TRY -> chosen.also { status = "At most ${BrainModels.MAX_PER_TRY} side by side: untick one first." }
+            else -> chosen + id
+        }
+    }
+
+    fun updateShowAll(on: Boolean) {
+        showAll = on
+    }
+
+    fun updateMessage(text: String) {
+        if (!running) message = text
+    }
+
+    fun updateUseLast(on: Boolean) {
+        if (!running) useLast = on
+    }
+
+    /** What the chosen models cost in all for one typical reply each, as the screen shows it before a try. */
+    fun cost(): Double = choices.filter { it.id in chosen }.sumOf { it.typicalUsd ?: 0.0 }
+
+    /** Her real reply prompt to each chosen model, all at once. */
+    fun start() {
+        if (running) return
+        val picked = choices.filter { it.id in chosen }
+        if (picked.size < BrainModels.MIN_PER_TRY || picked.size > BrainModels.MAX_PER_TRY) {
+            status = "Choose ${BrainModels.MIN_PER_TRY} to ${BrainModels.MAX_PER_TRY} models."
+            return
+        }
+        val ask = if (useLast) BrainTrial.Ask.LastExchange else BrainTrial.Ask.Typed(message)
+        rows.clear()
+        running = true
+        status = ""
+        job = viewModelScope.launch {
+            try {
+                val config = settings()
+                HerBrain.whyNotMove(config)?.let {
+                    status = it
+                    return@launch
+                }
+                picked.forEach { rows += Row(it) }
+                trial.run(config, picked.map { it.id }, ask) { entry ->
+                    val index = rows.indexOfFirst { it.choice.id == entry.model }
+                    if (index >= 0) rows[index] = Row(rows[index].choice, entry.millis, entry.shown)
+                }
+                val failed = rows.count { it.shown !is BrainTrial.Shown.Reply }
+                status = if (failed == 0) "Done." else "Done. $failed without a reply: why is said in its place."
+            } catch (e: CancellationException) {
+                status = "Stopped."
+                throw e
+            } finally {
+                running = false
+            }
+        }
+    }
+
+    fun stop() {
+        job?.cancel()
+    }
+
+    /** "Use this one": her replies, her notebook and her own time go to [id] from now on ([BrainChoice.use]). */
+    fun use(id: String) {
+        if (running) return
+        viewModelScope.launch {
+            val config = settings()
+            BrainChoice.whyNot(config, id)?.let {
+                status = it
+                return@launch
+            }
+            save { BrainChoice.use(it, id) }
+            val saved = settings()
+            choices = choicesFor(saved)
+            now = nowLine(saved)
+            status = usedLine(saved, id)
+        }
+    }
+
+    override fun onCleared() {
+        rows.clear()
+        super.onCleared()
+    }
+
+    companion object {
+        /** As many stored rows as her reply in the chat is built from. */
+        const val HISTORY_ROWS = BrainTrial.HISTORY_ROWS
+
+        /** Her app fact about looks he can ask for, as her reply in the chat gets it; null when it cannot be read. */
+        private suspend fun lookLine(hisLooks: dagger.Lazy<HisLooks>, engine: PersonaEngine, config: LLMConfig): String? = try {
+            hisLooks.get().replyFact(config, makesPictures = engine.makesPictures(config))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            null
+        }
+
+        /**
+         * Every model her brain can be tried on as [config] stands: the shortlist first in its
+         * order, then the rest of the encrypted and Private-tier models by name, with any model
+         * Venice's live list now has in its Private tier that this build's copy does not.
+         */
+        fun choicesFor(config: LLMConfig): List<Choice> {
+            val shortlist = BrainModels.SHORTLIST.map { it.id }
+            val listed = BrainModels.ALL.map { it.id }
+            val live = config.veniceTiers.keys.filter { VenicePrivateTier.isPrivateTier(it, config) }
+            val ids = (shortlist + (listed + live).distinct().sorted()).distinct().filter { BrainChoice.offered(config, it) }
+            return ids.map { id -> choiceOf(config, id) }
+        }
+
+        private fun choiceOf(config: LLMConfig, id: String): Choice {
+            val pick = BrainModels.SHORTLIST.firstOrNull { it.id == id }
+            return Choice(
+                id = id,
+                label = BrainModels.labelOf(id),
+                note = pick?.note.orEmpty(),
+                shortlisted = pick != null,
+                whyNot = BrainChoice.whyNot(config, id),
+                route = BrainChoice.routeWords(config, id),
+                senses = sensesLine(config, id),
+                thinking = BrainModels.thinkingLine(id),
+                typicalUsd = BrainModels.typicalUsd(id),
+                current = isCurrent(config, id)
+            )
+        }
+
+        /** The model her replies go to now: the one set for them, else the selected model of their provider. */
+        private fun herModel(config: LLMConfig): String =
+            config.personaChatModel.trim().ifEmpty { config.selectedModelFor(config.replyProviderName()) }
+
+        /** Whether [id] is her brain now. */
+        fun isCurrent(config: LLMConfig, id: String): Boolean =
+            config.replyProviderName() == HerBrain.PROVIDER && herModel(config).equals(id.trim(), ignoreCase = true)
+
+        /** The first of the shortlist that can be tried as things are set, as many as one try takes. */
+        fun defaultChosen(choices: List<Choice>): Set<String> =
+            choices.filter { it.shortlisted && it.whyNot == null }.take(BrainModels.MAX_PER_TRY).map { it.id }.toSet()
+
+        /**
+         * What reaches her through [id] as her brain: pictures and sound as Venice lists them
+         * and its route carries them, and what the probe of her brain found of it, where it was
+         * probed.
+         */
+        fun sensesLine(config: LLMConfig, id: String): String {
+            val senses = BrainModels.senses(id, config)
+            val takes = when {
+                senses.sees && senses.hears -> "sees and hears"
+                senses.sees -> "sees, does not hear"
+                senses.hears -> "hears, does not see"
+                senses.untrusted && (senses.modelSees || senses.modelHears) ->
+                    "text only while Venice's Private tier is not trusted for her: the model ${if (senses.modelSees && senses.modelHears) "sees and hears" else if (senses.modelSees) "sees" else "hears"}, " +
+                        "but your pictures and voice go to it only once you switch on \"${BrainChoice.TRUST_SWITCH}\", so pictures reach her through the describer"
+                senses.modelSees -> "text only on this route: the model sees, but the encrypted route carries text only, so pictures reach her through the describer"
+                else -> "text only: pictures reach her through the describer"
+            }
+            val probe = SightProbe.recorded(BrainChoice.withBrain(config, id), SightProbe.Probe.BRAIN)
+            return if (probe == null) "$takes (Venice's list)" else "$takes (Venice's list); the probe: ${probe.result.words}"
+        }
+
+        /** Her brain as [config] has it now. */
+        fun nowLine(config: LLMConfig): String {
+            val model = herModel(config).ifEmpty { "the main provider's model" }
+            return "Now: her replies, her notebook and her own time on $model, through ${config.replyProviderName()}."
+        }
+
+        /** What "Use this one" did, said after it. */
+        fun usedLine(config: LLMConfig, id: String): String {
+            val pictures = if (config.personaChatSeesImages) "Pictures meant for her go to it directly, after the age check." else "Pictures reach her through the describer."
+            val options = config.personaChatExtraBody.ifBlank { "none of their own (the app asks for thinking off)" }
+            return "${BrainModels.labelOf(id)} now writes her replies, her notebook and her own time. $pictures " +
+                "Her reply options: $options. \"${HerBrain.BACK_LABEL}\" in Her own senses moves her back."
+        }
+    }
+}
