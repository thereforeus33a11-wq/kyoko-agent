@@ -0,0 +1,66 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * "Try picture models": on his tap, one test picture of her per model he chose, the same
+ * scene and the same seed for each, so he can see them side by side with what each cost
+ * ([SelfPicturePlans.trial]). The scene is not sexual: a selfie in her usual outfit on a Tokyo
+ * street at night ([PicturePrompts.TRIAL_SCENE]).
+ *
+ * Every test picture goes through the same age check as any picture of her
+ * ([SelfPictureMaker.checked]): one that does not pass is thrown away unseen and counted, and
+ * he is told so in its place. The pictures that pass stay in memory for the screen only: they
+ * are never written to the phone and never added to her pictures. It is his act: no call of
+ * it is counted as hers.
+ */
+class PictureTrial(private val maker: SelfPictureMaker, private val clock: () -> Long = System::currentTimeMillis) {
+
+    /** What one model came to. */
+    class Entry(val model: PictureModels.Model, val cost: Double, val millis: Long, val shown: Shown)
+
+    sealed class Shown {
+        /** The test picture, in memory only, after the age check passed it. */
+        class Picture(val bytes: ByteArray, val note: String) : Shown() {
+            override fun toString(): String = "Picture(${bytes.size} bytes)"
+        }
+
+        /** No picture to show, and why: a failed request, or thrown away unseen by the age check or Venice's flag. */
+        class NotShown(val why: String, val thrownAway: Boolean) : Shown()
+    }
+
+    /**
+     * Each of [models] in turn, [onEach] told as each is done. [references] are her originals
+     * and masters for the match, [source] the original or master an edit model starts from.
+     */
+    suspend fun run(
+        models: List<PictureModels.Model>,
+        references: List<SourceImage>,
+        source: SourceImage?,
+        match: Boolean,
+        seed: Int = SelfPicturePlans.seed(),
+        onEach: suspend (Entry) -> Unit
+    ) {
+        for (model in models.distinct()) {
+            val started = clock()
+            val cost = SelfPicturePlans.trialCost(model, match, references.isNotEmpty())
+            val plan = SelfPicturePlans.trial(model, references, source, match, seed)
+            if (plan == null) {
+                onEach(Entry(model, 0.0, 0, Shown.NotShown(NO_SOURCE, thrownAway = false)))
+                continue
+            }
+            val shown = when (val result = maker.checked(plan, counted = false)) {
+                is SelfPictureMaker.Result.Ok -> Shown.Picture(result.picture.bytes, result.picture.note)
+                is SelfPictureMaker.Result.NotMade -> Shown.NotShown(result.why, thrownAway = false)
+                is SelfPictureMaker.Result.ThrownAway -> Shown.NotShown(result.why, thrownAway = true)
+            }
+            onEach(Entry(model, cost, clock() - started, shown))
+        }
+    }
+
+    companion object {
+        const val NO_SOURCE = "An edit model starts from an original or a master picture of her, and she has none. Add one in Her pictures."
+
+        /** What a trial of [models] costs in all, before it starts. */
+        fun cost(models: List<PictureModels.Model>, match: Boolean, hasReferences: Boolean): Double =
+            models.distinct().sumOf { SelfPicturePlans.trialCost(it, match, hasReferences) }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/ReferenceSheets.kt b/app/src/main/java/com/opendroid/ai/core/persona/ReferenceSheets.kt
