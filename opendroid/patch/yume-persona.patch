diff --git a/app/src/main/cpp/yume_jtalk.cpp b/app/src/main/cpp/yume_jtalk.cpp
new file mode 100644
index 0000000..c47cfdf
--- /dev/null
+++ b/app/src/main/cpp/yume_jtalk.cpp
@@ -0,0 +1,161 @@
+// Her voice's Japanese reading, on the phone: Open JTalk's text front end.
+//
+// It runs the same steps, in the same order, as pyopenjtalk 0.4.1's run_frontend() and
+// make_label(), on the same Open JTalk source (r9y9/open_jtalk 462fc38) and the same
+// dictionary (open_jtalk_dic_utf_8-1.11). Her phone voice was trained on labels made
+// that way, so the phone reads her text the way the voice learned it. Nothing leaves
+// the phone: this is a dictionary lookup and a set of rules.
+//
+// One handle holds one loaded dictionary. Calls on a handle are serialized.
+
+#include <jni.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "mecab.h"
+#include "njd.h"
+#include "jpcommon.h"
+#include "text2mecab.h"
+#include "mecab2njd.h"
+#include "njd_set_pronunciation.h"
+#include "njd_set_digit.h"
+#include "njd_set_accent_phrase.h"
+#include "njd_set_accent_type.h"
+#include "njd_set_unvoiced_vowel.h"
+#include "njd_set_long_vowel.h"
+#include "njd2jpcommon.h"
+
+namespace {
+
+struct JTalk {
+    Mecab mecab;
+    NJD njd;
+    JPCommon jpcommon;
+    std::mutex lock;
+};
+
+// Longest sentence accepted, in UTF-8 bytes. text2mecab() writes into a buffer it does
+// not bound, and can widen each byte up to three (half-width to full-width), so the
+// buffer is sized from the input and the input is capped. The caller splits sentences.
+constexpr size_t kMaxInputBytes = 4096;
+
+std::vector<std::string> labels(JTalk *j, const std::string &text) {
+    std::vector<std::string> out;
+    std::vector<char> buff(text.size() * 4 + 64, 0);
+    text2mecab(buff.data(), text.c_str());
+    Mecab_analysis(&j->mecab, buff.data());
+    mecab2njd(&j->njd, Mecab_get_feature(&j->mecab), Mecab_get_size(&j->mecab));
+    njd_set_pronunciation(&j->njd);
+    njd_set_digit(&j->njd);
+    njd_set_accent_phrase(&j->njd);
+    njd_set_accent_type(&j->njd);
+    njd_set_unvoiced_vowel(&j->njd);
+    njd_set_long_vowel(&j->njd);
+    njd2jpcommon(&j->jpcommon, &j->njd);
+    JPCommon_make_label(&j->jpcommon);
+    int size = JPCommon_get_label_size(&j->jpcommon);
+    char **feature = JPCommon_get_label_feature(&j->jpcommon);
+    for (int i = 0; i < size && feature != nullptr; i++) {
+        if (feature[i] != nullptr) out.emplace_back(feature[i]);
+    }
+    JPCommon_refresh(&j->jpcommon);
+    NJD_refresh(&j->njd);
+    Mecab_refresh(&j->mecab);
+    return out;
+}
+
+std::string utf8(JNIEnv *env, jstring s) {
+    // GetStringUTFChars gives modified UTF-8, which differs from UTF-8 for characters
+    // outside the BMP (emoji) and for NUL; take the UTF-16 and encode it ourselves.
+    std::string out;
+    const jsize n = env->GetStringLength(s);
+    const jchar *c = env->GetStringChars(s, nullptr);
+    if (c == nullptr) return out;
+    for (jsize i = 0; i < n; i++) {
+        uint32_t cp = c[i];
+        if (cp >= 0xD800 && cp <= 0xDBFF && i + 1 < n && c[i + 1] >= 0xDC00 && c[i + 1] <= 0xDFFF) {
+            cp = 0x10000 + ((cp - 0xD800) << 10) + (c[i + 1] - 0xDC00);
+            i++;
+        } else if (cp >= 0xD800 && cp <= 0xDFFF) {
+            cp = 0xFFFD;
+        }
+        if (cp == 0) continue;
+        if (cp < 0x80) {
+            out += static_cast<char>(cp);
+        } else if (cp < 0x800) {
+            out += static_cast<char>(0xC0 | (cp >> 6));
+            out += static_cast<char>(0x80 | (cp & 0x3F));
+        } else if (cp < 0x10000) {
+            out += static_cast<char>(0xE0 | (cp >> 12));
+            out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+            out += static_cast<char>(0x80 | (cp & 0x3F));
+        } else {
+            out += static_cast<char>(0xF0 | (cp >> 18));
+            out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+            out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+            out += static_cast<char>(0x80 | (cp & 0x3F));
+        }
+    }
+    env->ReleaseStringChars(s, c);
+    return out;
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_com_opendroid_ai_core_voice_own_OpenJTalk_nativeOpen(JNIEnv *env, jclass, jstring dicDir) {
+    std::string dir = utf8(env, dicDir);
+    auto *j = new JTalk();
+    Mecab_initialize(&j->mecab);
+    NJD_initialize(&j->njd);
+    JPCommon_initialize(&j->jpcommon);
+    if (dir.empty() || Mecab_load(&j->mecab, dir.c_str()) != TRUE) {
+        Mecab_clear(&j->mecab);
+        NJD_clear(&j->njd);
+        JPCommon_clear(&j->jpcommon);
+        delete j;
+        return 0;
+    }
+    return reinterpret_cast<jlong>(j);
+}
+
+extern "C" JNIEXPORT jobjectArray JNICALL
+Java_com_opendroid_ai_core_voice_own_OpenJTalk_nativeLabels(JNIEnv *env, jclass, jlong handle, jstring text) {
+    auto *j = reinterpret_cast<JTalk *>(handle);
+    jclass stringClass = env->FindClass("java/lang/String");
+    if (j == nullptr || stringClass == nullptr) return nullptr;
+    std::string input = utf8(env, text);
+    if (input.size() > kMaxInputBytes) return nullptr;
+    std::vector<std::string> out;
+    {
+        std::lock_guard<std::mutex> guard(j->lock);
+        out = labels(j, input);
+    }
+    jobjectArray result = env->NewObjectArray(static_cast<jsize>(out.size()), stringClass, nullptr);
+    if (result == nullptr) return nullptr;
+    for (size_t i = 0; i < out.size(); i++) {
+        // Labels are ASCII, so modified UTF-8 and UTF-8 agree.
+        jstring s = env->NewStringUTF(out[i].c_str());
+        if (s == nullptr) return nullptr;
+        env->SetObjectArrayElement(result, static_cast<jsize>(i), s);
+        env->DeleteLocalRef(s);
+    }
+    return result;
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_opendroid_ai_core_voice_own_OpenJTalk_nativeClose(JNIEnv *, jclass, jlong handle) {
+    auto *j = reinterpret_cast<JTalk *>(handle);
+    if (j == nullptr) return;
+    {
+        std::lock_guard<std::mutex> guard(j->lock);
+        Mecab_clear(&j->mecab);
+        NJD_clear(&j->njd);
+        JPCommon_clear(&j->jpcommon);
+    }
+    delete j;
+}
