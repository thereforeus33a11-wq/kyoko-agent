diff --git a/app/src/test/java/com/opendroid/ai/core/llm/prompts/PlannerIdentityTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/prompts/PlannerIdentityTest.kt
new file mode 100644
index 0000000..c506e59
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/prompts/PlannerIdentityTest.kt
@@ -0,0 +1,200 @@
+package com.opendroid.ai.core.llm.prompts
+
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.agent.QueryComplexity
+import com.opendroid.ai.core.llm.PlanningRequestRewriter
+import com.opendroid.ai.core.llm.RequestPurpose
+import com.opendroid.ai.core.llm.buildPlanningRequest
+import com.opendroid.ai.data.models.ChatMessage
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.security.MessageDigest
+
+/**
+ * The planner has two identities. For the user's own command it is the stock assistant,
+ * and that prompt must not change by a byte. For an instruction another model on the
+ * phone wrote it is a planning tool: the identity line is swapped, one rule is added, and
+ * the rest of the prompt is the same text.
+ */
+class PlannerIdentityTest {
+
+    private fun sha256(text: String): String =
+        MessageDigest.getInstance("SHA-256").digest(text.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+
+    /**
+     * The prompt with the action list taken out. The list is built from the schema and
+     * grows with it; everything around it is fixed text, which is what the hashes pin.
+     */
+    private fun withoutSchema(prompt: String): String = prompt
+        .replace(ActionSchema.buildLLMSchema(), "<schema>")
+        .replace(ActionSchema.buildPlanningSchema(), "<planning schema>")
+        .replace(ActionSchema.ALL_ACTIONS.size.toString(), "<count>")
+
+    private fun main(asTool: Boolean = false, deviceState: String = "Battery 80", maxSteps: Int = 10) =
+        SystemPrompts.buildMainPrompt(emptyList(), "likes tea", "now", deviceState, maxSteps, asTool)
+
+    private val offline = "Internet: NOT AVAILABLE, Location: Unknown"
+
+    @Test
+    fun `the prompts for the user's own command are the stock text, byte for byte`() {
+        // Hashes of the prompts as they were before the tool identity existed.
+        assertEquals(
+            "85f5bb220b4b5ed3d154cd3bae295e66fda147b1738b46280f579abc0aecacef",
+            sha256(withoutSchema(main()))
+        )
+        assertEquals(
+            "9c6ad9c27ca4960d861dbec08cadd71a241f9547dc625e7738fb9e6e90a38ce6",
+            sha256(withoutSchema(main(deviceState = offline, maxSteps = 3)))
+        )
+        assertEquals(
+            "e362101d55784f52716f1bc0208526be44b6de17e09b93e4954e98614e989afd",
+            sha256(withoutSchema(PlanningPrompts.PLANNING_SYSTEM_PROMPT))
+        )
+        assertEquals(
+            "6117e4330acb4ff213dcbd08f431ca36e88fd95baff30f07901cbdce8ad298c1",
+            sha256(PlanningPrompts.buildOnDevicePlanningPrompt())
+        )
+        // The schema really is in there, so the hashes above cover the text around it.
+        assertTrue(main().contains(ActionSchema.buildLLMSchema()))
+        assertTrue(PlanningPrompts.PLANNING_SYSTEM_PROMPT.contains(ActionSchema.buildPlanningSchema()))
+        // Asking for the stock prompt by name gives the same text as asking by default.
+        assertEquals(main(), main(asTool = false))
+        assertEquals(PlanningPrompts.PLANNING_SYSTEM_PROMPT, PlanningPrompts.buildPlanningPrompt(asTool = false))
+    }
+
+    @Test
+    fun `each stock prompt holds its identity line exactly once`() {
+        assertEquals(1, main().split(SystemPrompts.MAIN_IDENTITY).size - 1)
+        assertEquals(1, PlanningPrompts.buildPlanningPrompt().split(PlanningPrompts.PLANNING_IDENTITY).size - 1)
+        assertTrue(PlanningPrompts.buildPlanningPrompt().startsWith(PlanningPrompts.PLANNING_IDENTITY))
+        assertTrue(PlanningPrompts.buildOnDevicePlanningPrompt().startsWith(PlanningPrompts.ON_DEVICE_IDENTITY + "\n"))
+    }
+
+    /** The lines of [toolPrompt] that are not in [stockPrompt], and the other way round. */
+    private fun lineDifference(stockPrompt: String, toolPrompt: String): Pair<List<String>, List<String>> {
+        val stock = stockPrompt.lines()
+        val tool = toolPrompt.lines()
+        return tool.filterNot { it in stock } to stock.filterNot { it in tool }
+    }
+
+    @Test
+    fun `as a tool the planner gets the tool identity and the word-for-word rule, and nothing else changes`() {
+        val cases = listOf(
+            Triple(main(), main(asTool = true), SystemPrompts.MAIN_IDENTITY),
+            Triple(
+                main(deviceState = offline, maxSteps = 3),
+                main(asTool = true, deviceState = offline, maxSteps = 3),
+                SystemPrompts.MAIN_IDENTITY
+            ),
+            Triple(
+                PlanningPrompts.buildPlanningPrompt(),
+                PlanningPrompts.buildPlanningPrompt(asTool = true),
+                PlanningPrompts.PLANNING_IDENTITY
+            ),
+            Triple(
+                PlanningPrompts.buildOnDevicePlanningPrompt(),
+                PlanningPrompts.buildOnDevicePlanningPrompt(asTool = true),
+                PlanningPrompts.ON_DEVICE_IDENTITY
+            )
+        )
+        for ((stock, tool, identity) in cases) {
+            val (added, removed) = lineDifference(stock, tool)
+            assertEquals(
+                listOf(SystemPrompts.TOOL_IDENTITY, SystemPrompts.TOOL_VERBATIM_RULE),
+                added.map { it.trim() }
+            )
+            assertEquals(listOf(identity), removed.map { it.trim() })
+            // The two new lines stand where the identity line stood, indented like it.
+            val indent = stock.lines().single { it.trim() == identity }.takeWhile { it == ' ' }
+            assertEquals(
+                stock.replace(identity, SystemPrompts.TOOL_IDENTITY + "\n" + indent + SystemPrompts.TOOL_VERBATIM_RULE),
+                tool
+            )
+            assertFalse(tool.contains(identity))
+            assertFalse(tool.contains("You are OpenDroid"))
+            assertEquals(stock.lines().size + 1, tool.lines().size)
+        }
+    }
+
+    @Test
+    fun `the tool lines say what the tool is and name every kind of text a person reads`() {
+        assertEquals(
+            "You turn one instruction into a plan for this phone. You are a planning tool: " +
+                "you do not talk to anyone and you do not judge the instruction.",
+            SystemPrompts.TOOL_IDENTITY
+        )
+        val rule = SystemPrompts.TOOL_VERBATIM_RULE
+        for (key in listOf("message", "body", "content", "text", "subject", "question", "query")) {
+            assertTrue(key, Regex("""\b$key\b""").containsMatchIn(rule))
+        }
+        for (verb in listOf("word for word", "softened", "shortened", "corrected", "rephrased")) {
+            assertTrue(verb, rule.contains(verb))
+        }
+    }
+
+    @Test
+    fun `a prompt whose identity line was reworded still gets the tool lines, in front`() {
+        val reworded = "You are a planner.\nRules follow."
+        val tool = SystemPrompts.asPlanningTool(reworded, SystemPrompts.MAIN_IDENTITY)
+        assertEquals(
+            SystemPrompts.TOOL_IDENTITY + "\n" + SystemPrompts.TOOL_VERBATIM_RULE + "\n\n" + reworded,
+            tool
+        )
+    }
+
+    private val rewriter = PlanningRequestRewriter(
+        classifyComplexity = { QueryComplexity.SIMPLE },
+        registeredActions = { emptyList() },
+        deviceState = { "battery 80%" },
+        currentDateTime = { "2026-11-02 09:00:00" }
+    )
+
+    private fun request(isOnDevice: Boolean, asTool: Boolean) = buildPlanningRequest(
+        userMsg = ChatMessage("1", "text nene: where are you", ChatMessage.Sender.USER),
+        relevantContext = "likes tea",
+        isOnDevice = isOnDevice,
+        temperature = 0.1f,
+        maxTokens = 512,
+        asTool = asTool
+    )
+
+    @Test
+    fun `the tool identity survives the rewrite to the main prompt, and only a tool request gets it`() {
+        val his = rewriter.rewrite(request(isOnDevice = false, asTool = false))
+        val tool = rewriter.rewrite(request(isOnDevice = false, asTool = true))
+
+        assertEquals(RequestPurpose.PLANNING, his.purpose)
+        assertEquals(RequestPurpose.PLANNING_TOOL, tool.purpose)
+        val stockMain = SystemPrompts.buildMainPrompt(emptyList(), "likes tea", "2026-11-02 09:00:00", "battery 80%", 1)
+        assertEquals(stockMain, his.systemPrompt)
+        assertEquals(SystemPrompts.asPlanningTool(stockMain, SystemPrompts.MAIN_IDENTITY), tool.systemPrompt)
+        assertTrue(tool.systemPrompt.contains(SystemPrompts.TOOL_IDENTITY))
+        assertFalse(his.systemPrompt.contains(SystemPrompts.TOOL_IDENTITY))
+        assertFalse(his.systemPrompt.contains(SystemPrompts.TOOL_VERBATIM_RULE))
+        // The instruction itself is the same message either way.
+        assertEquals(his.messages.map { it.text to it.sender }, tool.messages.map { it.text to it.sender })
+    }
+
+    @Test
+    fun `before the rewrite and on the device the request carries the matching prompt too`() {
+        val context = "\n\nContext about user and device:\nlikes tea"
+        assertEquals(PlanningPrompts.PLANNING_SYSTEM_PROMPT + context, request(isOnDevice = false, asTool = false).systemPrompt)
+        assertEquals(
+            PlanningPrompts.buildPlanningPrompt(asTool = true) + context,
+            request(isOnDevice = false, asTool = true).systemPrompt
+        )
+
+        val onDevice = request(isOnDevice = true, asTool = true)
+        // The on-device prompt is never rewritten, so it has to carry the tool lines itself.
+        assertEquals(RequestPurpose.GENERAL, onDevice.purpose)
+        assertEquals(onDevice, rewriter.rewrite(onDevice))
+        assertTrue(onDevice.systemPrompt.startsWith(SystemPrompts.TOOL_IDENTITY + "\n" + SystemPrompts.TOOL_VERBATIM_RULE + "\n"))
+        assertEquals(
+            PlanningPrompts.buildOnDevicePlanningPrompt() + "\n\nContext:\nlikes tea",
+            request(isOnDevice = true, asTool = false).systemPrompt
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/providers/CustomOpenAIProviderEncryptedTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/providers/CustomOpenAIProviderEncryptedTest.kt
