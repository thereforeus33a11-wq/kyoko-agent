+    // ── What an automatic retry may say about the attempt before it ──────────────────
+
+    /** The provider behind the gate every request passes, with the retries it makes by itself and no waiting. */
+    private fun gated() = WrappedLLMProvider(
+        delegate = provider,
+        configProvider = {
+            LLMConfig(
+                activeProvider = provider.name,
+                selectedModels = mapOf(provider.name to model),
+                apiKeys = mapOf(provider.name to apiKey),
+                customEndpoints = mapOf(provider.name to venice)
+            )
+        },
+        retryRuntime = RetryRuntime(nowMillis = { 0L }, delayMillis = {}, jitterMillis = { 0L })
+    )
+
+    private fun gatedFailure(): LLMException =
+        assertThrows(LLMException::class.java) { runBlocking { gated().complete(newRequest().copy(model = null, providerConfig = null)) } }
+
+    private val busy: () -> MockResponse = {
+        MockResponse.Builder().code(503).setHeader("Content-Type", "application/json").body("{}").build()
+    }
