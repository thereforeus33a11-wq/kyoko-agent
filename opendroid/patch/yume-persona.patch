+package com.opendroid.ai.core.life.ears
+
+import android.Manifest
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.data.db.MigrationTestApplication
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.io.File
+
+/** The ears do not open without the microphone permission, nor without their models on the phone. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class SherpaHearingGateTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val models = EarsModelStore(context)
+    private val hearing = SherpaHearing(context, models, VoicePrintStore(context))
+    private val listener = object : HearingEngine.Listener {
+        override fun heard(heard: Heard) = Unit
+    }
+
+    @Test
+    fun `without the microphone permission nothing opens`() {
+        shadowOf(context).denyPermissions(Manifest.permission.RECORD_AUDIO)
+        assertEquals(HearingEngine.Closed.NO_PERMISSION, hearing.open(listener))
+        assertFalse(hearing.isOpen)
+    }
+
+    @Test
+    fun `without the models nothing opens, for either recogniser`() {
+        shadowOf(context).grantPermissions(Manifest.permission.RECORD_AUDIO)
+        for (choice in EarsModels.Recognizer.entries) {
+            hearing.recognizer = choice
+            assertFalse(models.ready(choice))
+            assertEquals(EarsModels.needed(choice), models.missing(choice))
+            assertEquals(HearingEngine.Closed.NO_MODELS, hearing.open(listener))
+            assertFalse(hearing.isOpen)
+        }
+    }
+
+    @Test
+    fun `the models live in the app's no-backup storage`() {
+        assertEquals(File(context.noBackupFilesDir, EarsModelStore.DIRECTORY), models.root)
+        assertTrue(models.root.path.startsWith(context.noBackupFilesDir.path))
+        assertEquals(0L, models.bytesOnPhone())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/SoundGateTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/SoundGateTest.kt
new file mode 100644
index 0000000..7a69db4
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/SoundGateTest.kt
@@ -0,0 +1,109 @@
+package com.opendroid.ai.core.life.ears
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Random
+import kotlin.math.PI
+import kotlin.math.sin
+
+/** Sounds that are not speech, cut out beside the VAD: a laugh comes through, speech and clicks do not. */
+class SoundGateTest {
+
+    private val frame = SherpaPipeline.WINDOW
+    private val room = Random(3)
+
+    private fun quiet(frames: Int) = FloatArray(frames * frame) { (room.nextGaussian() * 0.0005).toFloat() }
+
+    private fun loud(frames: Int) = FloatArray(frames * frame) { (0.1 * sin(2 * PI * 150 * it / 16_000.0)).toFloat() }
+
+    /** Feeds [audio] frame by frame from [startAt] ms; [speechAt] says when the VAD hears speech. */
+    private fun run(
+        gate: SoundGate,
+        audio: FloatArray,
+        startAt: Long = 0,
+        speechAt: (Long) -> Boolean = { false },
+    ): List<SoundGate.Clip> {
+        val out = ArrayList<SoundGate.Clip>()
+        var at = startAt
+        var i = 0
+        while (i < audio.size) {
+            val f = audio.copyOfRange(i, i + frame)
+            i += frame
+            at += 32
+            gate.feed(f, at, speechAt(at))?.let { out += it }
+        }
+        return out
+    }
+
+    @Test
+    fun `a sound over the room's noise comes out once, with a little of what came before`() {
+        val gate = SoundGate()
+        val audio = quiet(31) + loud(19) + quiet(47)
+        val clips = run(gate, audio)
+        assertEquals(1, clips.size)
+        val c = clips.single()
+        // The sound began at 992 ms; the clip takes 100 ms before it.
+        assertEquals(892.0, c.startedAt.toDouble(), 33.0)
+        // It ended at 1,600 ms, and the clip after 400 ms of quiet.
+        assertEquals(2_000.0, c.endedAt.toDouble(), 40.0)
+        val from = 31 * frame - 1_600
+        assertArrayEquals(audio.copyOfRange(from, from + c.samples.size), c.samples, 0f)
+        assertEquals(c.samples.size * 1000.0 / 16_000, c.millis.toDouble(), 40.0)
+    }
+
+    @Test
+    fun `what the VAD takes for speech is not a sound, while it lasts or just after`() {
+        // Speech while the sound is on.
+        assertTrue(run(SoundGate(), quiet(31) + loud(19) + quiet(47)) { it in 1_200L..1_400L }.isEmpty())
+        // Speech heard only once the sound has ended, while the clip waits.
+        assertTrue(run(SoundGate(), quiet(31) + loud(19) + quiet(47)) { it in 2_020L..2_100L }.isEmpty())
+        // Speech well after the clip came out takes nothing back.
+        assertEquals(1, run(SoundGate(), quiet(31) + loud(19) + quiet(47)) { it > 2_400L }.size)
+    }
+
+    @Test
+    fun `a click is too short to be a sound`() {
+        assertTrue(run(SoundGate(), quiet(31) + loud(5) + quiet(40)).isEmpty())
+        // A quiet sound in a quiet room is still under the floor's margin, or under -55 dB.
+        val faint = FloatArray(19 * frame) { (0.001 * sin(2 * PI * 150 * it / 16_000.0)).toFloat() }
+        assertTrue(run(SoundGate(), quiet(31) + faint + quiet(40)).isEmpty())
+    }
+
+    @Test
+    fun `a long sound is cut at 4 s, and goes on in a clip of its own`() {
+        val clips = run(SoundGate(), quiet(31) + loud(200) + quiet(40))
+        assertTrue(clips.size >= 2)
+        assertTrue(clips.first().millis <= SoundGate.MAX_CLIP_MILLIS + 150)
+        assertTrue(clips[1].startedAt >= clips[0].endedAt)
+    }
+
+    @Test
+    fun `the floor follows the room down at once and up slowly`() {
+        val gate = SoundGate()
+        run(gate, quiet(31))
+        val floor = gate.floorDb!!
+        assertEquals(-66.0, floor.toDouble(), 2.0)
+        // Ten seconds of a loud sound lift it by about 5 dB, not to the sound.
+        run(gate, loud(312), startAt = 1_000)
+        assertEquals(floor + 5.0, gate.floorDb!!.toDouble(), 1.0)
+        run(gate, quiet(20), startAt = 11_000)
+        assertEquals(floor.toDouble(), gate.floorDb!!.toDouble(), 2.0)
+        gate.reset()
+        assertNull(gate.floorDb)
+    }
+
+    @Test
+    fun `after a reset nothing gathered before it comes out`() {
+        val gate = SoundGate()
+        run(gate, quiet(31) + loud(10))
+        gate.reset()
+        // After a reset nothing that was gathered comes out.
+        assertTrue(run(gate, quiet(40), startAt = 2_000).isEmpty())
+        val clips = run(gate, quiet(31) + loud(19) + quiet(47), startAt = 5_000)
+        assertNotNull(clips.singleOrNull())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/TarReaderTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/TarReaderTest.kt
new file mode 100644
index 0000000..c07e6d4
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/TarReaderTest.kt
@@ -0,0 +1,110 @@
+package com.opendroid.ai.core.life.ears
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+
+/** The tar reader: entries by name and size, long names, pax paths, checksums. */
+class TarReaderTest {
+
+    private fun header(name: String, size: Int, type: Char = '0', ustarPrefix: String = ""): ByteArray {
+        val h = ByteArray(512)
+        fun put(off: Int, s: String) = s.toByteArray(Charsets.UTF_8).copyInto(h, off)
+        put(0, name)
+        put(100, "0000644\u0000")
+        put(108, "0000000\u0000")
+        put(116, "0000000\u0000")
+        put(124, "%011o\u0000".format(size))
+        put(136, "00000000000\u0000")
+        h[156] = type.code.toByte()
+        put(257, "ustar\u0000")
+        put(263, "00")
+        if (ustarPrefix.isNotEmpty()) put(345, ustarPrefix)
+        for (i in 148 until 156) h[i] = ' '.code.toByte()
+        val sum = h.sumOf { it.toInt() and 0xff }
+        put(148, "%06o\u0000 ".format(sum))
+        return h
+    }
+
+    private fun entry(out: ByteArrayOutputStream, name: String, content: ByteArray, type: Char = '0', prefix: String = "") {
+        out.write(header(name, content.size, type, prefix))
+        out.write(content)
+        out.write(ByteArray((512 - content.size % 512) % 512))
+    }
+
+    private fun read(t: TarReader): ByteArray {
+        val out = ByteArrayOutputStream()
+        val b = ByteArray(7)
+        while (true) {
+            val n = t.read(b, 0, b.size)
+            if (n < 0) break
+            out.write(b, 0, n)
+        }
+        return out.toByteArray()
+    }
+
+    @Test
+    fun `entries come with their names, sizes and contents, read or skipped`() {
+        val out = ByteArrayOutputStream()
+        entry(out, "dir/", ByteArray(0), type = '5')
+        entry(out, "dir/a.bin", ByteArray(1000) { it.toByte() })
+        entry(out, "dir/b.txt", "hello".toByteArray())
+        out.write(ByteArray(1024))
+        val t = TarReader(ByteArrayInputStream(out.toByteArray()))
+        val d = t.next()!!
+        assertEquals("dir/", d.name)
+        assertFalse(d.isFile)
+        val a = t.next()!!
+        assertEquals("dir/a.bin" to 1000L, a.name to a.size)
+        assertTrue(a.isFile)
+        // a.bin is not read: it is skipped.
+        val b = t.next()!!
+        assertEquals("dir/b.txt", b.name)
+        assertEquals("hello", String(read(t)))
+        assertNull(t.next())
+    }
+
+    @Test
+    fun `a GNU long name and a pax path name the entry after them`() {
+        val out = ByteArrayOutputStream()
+        val long = "x".repeat(150) + "/model.onnx"
+        entry(out, "././@LongLink", (long + "\u0000").toByteArray(), type = 'L')
+        entry(out, "short", "1".toByteArray())
+        val record = "path=pax/name.txt\n"
+        val length = record.length + 3
+        entry(out, "PaxHeader", "$length $record".toByteArray(), type = 'x')
+        entry(out, "truncated", "2".toByteArray())
+        entry(out, "name.txt", "3".toByteArray(), prefix = "with/prefix")
+        out.write(ByteArray(1024))
+        val t = TarReader(ByteArrayInputStream(out.toByteArray()))
+        assertEquals(long, t.next()!!.name)
+        assertEquals("pax/name.txt", t.next()!!.name)
+        assertEquals("with/prefix/name.txt", t.next()!!.name)
+        assertNull(t.next())
+    }
+
+    @Test
+    fun `a damaged header is refused`() {
+        val out = ByteArrayOutputStream()
+        entry(out, "a", "1".toByteArray())
+        val bytes = out.toByteArray()
+        bytes[3] = 'z'.code.toByte()
+        assertThrows(IOException::class.java) { TarReader(ByteArrayInputStream(bytes)).next() }
+    }
+
+    @Test
+    fun `an archive that ends inside an entry fails`() {
+        val out = ByteArrayOutputStream()
+        out.write(header("a", 5000))
+        out.write(ByteArray(100))
+        val t = TarReader(ByteArrayInputStream(out.toByteArray()))
+        t.next()
+        assertThrows(IOException::class.java) { read(t) }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/VoiceEnrolmentTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/VoiceEnrolmentTest.kt
new file mode 100644
index 0000000..8e01c4f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/VoiceEnrolmentTest.kt
@@ -0,0 +1,188 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.persona.TestThoughtsCipher
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import kotlin.math.abs
+
+/** His voiceprint: three takes, each checked; judged by cosine; kept sealed. */
+class VoiceEnrolmentTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    // Voices as directions: his near e0, another's near e1.
+    private fun voice(main: Int, wobble: Float = 0.1f, seed: Int = 0) = FloatArray(16) { i ->
+        (if (i == main) 1f else 0f) + wobble * (((i * 31 + seed * 17) % 7) - 3) / 3f
+    }
+
+    private val sentence get() = VoiceEnrolment.SENTENCES
+
+    @Test
+    fun `cosine, unit length and the mean direction`() {
+        val a = floatArrayOf(3f, 4f)
+        assertEquals(1f, VoiceMath.norm(VoiceMath.unit(a)), 1e-6f)
+        assertEquals(1f, VoiceMath.cosine(a, floatArrayOf(6f, 8f)), 1e-6f)
+        assertEquals(0f, VoiceMath.cosine(floatArrayOf(1f, 0f), floatArrayOf(0f, 2f)), 1e-6f)
+        assertEquals(-1f, VoiceMath.cosine(floatArrayOf(1f, 0f), floatArrayOf(-5f, 0f)), 1e-6f)
+        assertEquals(0f, VoiceMath.cosine(floatArrayOf(0f, 0f), a), 0f)
+        // A long and a short vector weigh the same in the mean.
+        val m = VoiceMath.meanDirection(listOf(floatArrayOf(100f, 0f), floatArrayOf(0f, 1f)))
+        assertTrue(abs(m[0] - m[1]) < 1e-6f)
+    }
+
+    @Test
+    fun `three good takes make his print, and it tells his voice from another`() {
+        val e = VoiceEnrolment("titanet-small-en")
+        assertEquals(sentence[0], e.sentence)
+        assertEquals(VoiceEnrolment.Take.Kept(sentence[1]), e.take(voice(0, seed = 1), 6_000, sentence[0]))
+        assertEquals(VoiceEnrolment.Take.Kept(sentence[2]), e.take(voice(0, seed = 2), 6_000, sentence[1].lowercase()))
+        assertNull(e.result())
+        assertEquals(VoiceEnrolment.Take.Kept(null), e.take(voice(0, seed = 3), 6_000, sentence[2]))
+        val print = e.result()!!
+        assertEquals(3, print.takes)
+        assertEquals("titanet-small-en", print.modelId)
+        assertEquals(Voice.HIM, print.judge(voice(0, seed = 4)).first)
+        assertEquals(Voice.OTHER, print.judge(voice(5, seed = 4)).first)
+    }
+
+    @Test
+    fun `a take too short, not the sentence, or in another voice does not count`() {
+        val e = VoiceEnrolment("m")
+        assertEquals(VoiceEnrolment.Take.Again(VoiceEnrolment.TOO_LITTLE), e.take(voice(0), 1_500, sentence[0]))
+        assertEquals(VoiceEnrolment.Take.Again(VoiceEnrolment.TOO_LITTLE), e.take(null, 6_000, sentence[0]))
+        assertEquals(VoiceEnrolment.Take.Again(VoiceEnrolment.NOT_THE_SENTENCE), e.take(voice(0), 6_000, "the weather is nice today"))
+        assertEquals(VoiceEnrolment.Take.Again(VoiceEnrolment.NOT_THE_SENTENCE), e.take(voice(0), 6_000, null))
+        assertEquals(0, e.step)
+        e.take(voice(0), 6_000, sentence[0])
+        assertEquals(VoiceEnrolment.Take.Again(VoiceEnrolment.NOT_THE_SAME_VOICE), e.take(voice(7), 6_000, sentence[1]))
+        assertEquals(1, e.step)
+        e.restart()
+        assertEquals(0, e.step)
+        assertEquals(sentence[0], e.sentence)
+    }
+
+    @Test
+    fun `most of the sentence is enough, as a recogniser writes it`() {
+        assertEquals(1.0, VoiceEnrolment.sentenceShare(sentence[2], "Yume, tell me what you read about today and what you thought of it while you were reading."), 1e-9)
+        assertTrue(VoiceEnrolment.sentenceShare(sentence[0], "the quick brown fox jumps over the lazy dog and the dog does not seem") >= VoiceEnrolment.MIN_SENTENCE_SHARE)
