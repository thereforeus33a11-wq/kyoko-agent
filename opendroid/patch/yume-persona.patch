--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/ui/viewmodel/HerDayViewModel.kt
@@ -0,0 +1,196 @@
+package com.opendroid.ai.ui.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingHost
+import dagger.hilt.android.lifecycle.HiltViewModel
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** One day of "Her day": its heading, and what she did that day, newest first. */
+data class HerDayGroup(val heading: String, val lines: List<String>)
+
+/**
+ * The days of [entries], newest first, each with its lines newest first ([herDayLine]).
+ * A day is headed "Today", "Yesterday" or its date, in [zone].
+ */
+internal fun herDayGroups(
+    entries: List<HerLog.Entry>,
+    nowMillis: Long,
+    zone: TimeZone = TimeZone.getDefault(),
+    locale: Locale = Locale.getDefault()
+): List<HerDayGroup> {
+    fun dayOf(millis: Long): Triple<Int, Int, Int> = Calendar.getInstance(zone, locale).run {
+        timeInMillis = millis
+        Triple(get(Calendar.YEAR), get(Calendar.MONTH), get(Calendar.DAY_OF_MONTH))
+    }
+    val today = dayOf(nowMillis)
+    val yesterday = dayOf(Calendar.getInstance(zone, locale).run {
+        timeInMillis = nowMillis
+        add(Calendar.DAY_OF_MONTH, -1)
+        timeInMillis
+    })
+    val dated = SimpleDateFormat("EEE d MMM yyyy", locale).apply { timeZone = zone }
+    return entries.sortedByDescending { it.startedAt }
+        .groupBy { dayOf(it.startedAt) }
+        .map { (day, ofDay) ->
+            val heading = when (day) {
+                today -> "Today"
+                yesterday -> "Yesterday"
+                else -> dated.format(Date(ofDay.first().startedAt))
+            }
+            HerDayGroup(heading, ofDay.map { herDayLine(it, zone, locale) })
+        }
+}
+
+/**
+ * One line of "Her day" for [entry], from what the log holds and nothing else: times, the
+ * kind, where, the titles she opened and her search words, counts, calls and how it ended.
+ * The log holds none of her thoughts, notes or feel lines (I8), so no line can show one.
+ *
+ * "21:40–21:47 reading · ja.wikipedia.org · 'egg (雑誌)', search 'egg magazine' · 4 steps,
+ * 1 page opened, 1 search · 4 calls · she was done"
+ */
+internal fun herDayLine(entry: HerLog.Entry, zone: TimeZone = TimeZone.getDefault(), locale: Locale = Locale.getDefault()): String {
+    val clock = SimpleDateFormat("HH:mm", locale).apply { timeZone = zone }
+    val start = clock.format(Date(entry.startedAt))
+    val end = entry.endedAt?.let { clock.format(Date(it)) }
+    val time = when {
+        entry.endedBy == HerLog.EndedBy.RUNNING -> "$start–now"
+        end == null || end == start -> start
+        else -> "$start–$end"
+    }
+    return when (entry.kind) {
+        HerLog.Kind.NOT_STARTED -> buildString {
+            append(time).append(" a go: of hers did not start")
+            if (entry.where.isNotBlank()) append(" (").append(entry.where).append(")")
+            entry.notStarted?.let { append(": ").append(it.words) }
+        }
+        // "14:02 looked through the back camera · 1 picture looked at, 1 step · 2 calls · she was done"
+        HerLog.Kind.LOOK -> listOfNotNull(
+            "$time looked through the " + entry.where.ifBlank { "camera" },
+            countsText(entry.counts - com.opendroid.ai.core.life.eyes.CameraLook.CAMERA_LOOKS).takeIf { it.isNotEmpty() },
+            refusalsText(entry.refusals).takeIf { it.isNotEmpty() },
+            callsText(entry.calls),
+            entry.endedBy.words
+        ).joinToString(" · ")
+        HerLog.Kind.COMMAND -> listOfNotNull(
+            "$time a command of hers on the phone: " + entry.what.joinToString(", ") { "'$it'" },
+            entry.counts.keys.firstOrNull(),
+            callsText(entry.calls)
+        ).joinToString(" · ")
+        else -> listOfNotNull(
+            "$time ${entry.kind.word}",
+            entry.where.takeIf { it.isNotBlank() },
+            entry.what.takeIf { it.isNotEmpty() }?.joinToString(", ", transform = ::whatText),
+            countsText(entry.counts).takeIf { it.isNotEmpty() },
+            refusalsText(entry.refusals).takeIf { it.isNotEmpty() },
+            callsText(entry.calls),
+            entry.endedBy.words
+        ).joinToString(" · ")
+    }
+}
+
+/** A title she opened in quotes; her search words after "search". */
+private fun whatText(what: String): String =
+    if (what.startsWith("search: ")) "search '" + what.removePrefix("search: ") + "'" else "'$what'"
+
+private fun callsText(calls: Int): String = if (calls == 1) "1 call" else "$calls calls"
+
+/** The counts of an outing in words: "4 steps, 2 pages opened, 1 search". */
+internal fun countsText(counts: Map<String, Int>): String = counts.filterValues { it > 0 }.map { (key, n) ->
+    val (one, many) = COUNT_WORDS[key] ?: return@map "$key $n"
+    "$n " + if (n == 1) one else many
+}.joinToString(", ")
+
+private val COUNT_WORDS: Map<String, Pair<String, String>> = mapOf(
+    HerLog.Tally.STEPS to ("step" to "steps"),
+    HerLog.Tally.OPENED to ("page opened" to "pages opened"),
+    HerLog.Tally.SEARCHES to ("search" to "searches"),
+    HerLog.Tally.THOUGHTS to ("step with a thought of hers" to "steps with a thought of hers"),
+    HerLog.Tally.NOTES to ("note" to "notes"),
+    HerLog.Tally.FEELINGS to ("feel line" to "feel lines"),
+    HerLog.Tally.WONDERS to ("wonder" to "wonders"),
+    HerLog.Tally.SAID to ("line to you" to "lines to you"),
+    OutingHost.FEEDS_FOLLOWED to ("feed followed" to "feeds followed"),
+    OutingHost.PICTURES_LOOKED to ("picture looked at" to "pictures looked at"),
+    com.opendroid.ai.core.life.eyes.CameraLook.CAMERA_LOOKS to ("camera look" to "camera looks"),
+    com.opendroid.ai.core.life.eyes.CameraLook.TOO_DARK to ("frame too dark to describe" to "frames too dark to describe")
+)
+
+/**
+ * Refusals and skips by category only, never what was refused: "2 not sent (his name),
+ * 1 not fetched (robots), 1 >> line not run".
+ */
+internal fun refusalsText(refusals: Map<String, Int>): String = refusals.filterValues { it > 0 }.map { (category, n) ->
+    fun why(rest: String) = rest.lowercase().replace('_', ' ')
+    when {
+        category == HerLog.Tally.COMMAND_NOT_RUN -> if (n == 1) "1 >> line not run" else "$n >> lines not run"
+        category.startsWith("guard:") -> "$n not sent (" + why(category.removePrefix("guard:")) + ")"
+        category.startsWith("fetch:") -> "$n not fetched (" + why(category.removePrefix("fetch:")) + ")"
+        category.startsWith(OutingHost.EYES_PREFIX) -> "$n not described (" + why(category.removePrefix(OutingHost.EYES_PREFIX)) + ")"
+        category.startsWith(com.opendroid.ai.core.life.eyes.CameraLook.CAMERA_PREFIX) ->
+            "$n no picture (" + why(category.removePrefix(com.opendroid.ai.core.life.eyes.CameraLook.CAMERA_PREFIX)) + ")"
+        category == com.opendroid.ai.core.life.KidGuard.UNCHECKED ->
+            (if (n == 1) "1 picture" else "$n pictures") + " not shown (the describer gave no ages)"
+        category.startsWith(HerLog.KID_PREFIX) -> "$n skipped as a kid's (" + why(category.removePrefix(HerLog.KID_PREFIX)) + ")"
+        else -> "$n " + why(category)
+    }
+}.joinToString(", ")
+
+/**
+ * "Her day": what she did on her own, from the app's log of it, by day. The log holds
+ * times, places, titles, her search words and counts; it is shown here as it is, and can
+ * be cleared.
+ */
+@HiltViewModel
+class HerDayViewModel internal constructor(
+    private val log: HerLog,
+    private val clock: () -> Long,
+    private val zone: () -> TimeZone
+) : ViewModel() {
+
+    @Inject
+    constructor(log: HerLog) : this(log, System::currentTimeMillis, TimeZone::getDefault)
+
+    /** Her days, newest first; null until the log has been read. */
+    var days by mutableStateOf<List<HerDayGroup>?>(null)
+        private set
+
+    /** What came of the last Clear; empty before. */
+    var status by mutableStateOf("")
+        private set
+
+    init {
+        // Read again whenever the log changes: an outing that runs adds to it step by step.
+        viewModelScope.launch {
+            log.changed.collect {
+                val entries = withContext(Dispatchers.IO) { log.entries() }
+                days = herDayGroups(entries, clock(), zone())
+            }
+        }
+    }
+
+    /** Deletes every entry of her day, except one still running. Only his confirmed tap on the screen calls it. */
+    fun clear() {
+        viewModelScope.launch {
+            withContext(Dispatchers.IO) { log.clear() }
+            status = HER_DAY_CLEARED
+        }
+    }
+
+    companion object {
+        const val HER_DAY_CLEARED = "Her day is cleared. The count of her calls on her own is kept: it is not part of this list."
+    }
+}
