+    /**
+     * What becomes of a command line in a moment of her own, said as the app will really
+     * treat it: with her own actions off nothing is started; on every rein it is a
+     * command of hers like one from a reply. His own approval setting is asked first on
+     * every rein ([PersonaActions.decideStart]), so what her rein does not cover still
+     * runs where that setting lets it. On [PersonaRein.ASK] the rest waits in the chat for
+     * his yes, as a card, with a notification that says only that she wants something
+     * done. What a carried-out command takes in calls is said once, further down
+     * ([costLine]).
+     */
+    internal fun commandLine(actionsEnabled: Boolean, rein: PersonaRein): String {
+        // Whatever the rein, and whatever his setting ([PersonaPrompts.MACRO_WORDS_SHOWN_FIRST]).
+        val macroWords = " a saved macro whose steps send words always waits in the chat for his yes, whatever " +
+            "his setting or your rein: those words were saved earlier."
+        val form = "  >> <a command>           "
+        val one = " one command at most: of several the last counts and the others are kept in the chat as not run. " +
+            "it has not happened until one of the app's lines says so."
+        return when {
+            !actionsEnabled ->
+                form + "is not carried out: he has switched your own actions off. the line is kept in the chat as not run."
+            rein == PersonaRein.ASK ->
+                form + "something you do on the phone, as your own act. it is shown to him for a yes first, unless his " +
+                    "own approval setting lets it run: it waits in the chat as a card, and he gets a notification that " +
+                    "says only that you want to do something. it runs once he says yes, and nothing is read aloud." +
+                    macroWords + one
+            rein == PersonaRein.PHONE ->
+                form + "something you do on the phone, as your own act. what stays on the phone runs now. anything " +
+                    "that sends words off it (a message, a call, a post, a search) waits in the chat for his yes, " +
+                    "unless his own approval setting lets it run, and so does a command whose words repeat a " +
+                    "notification or one of the app's lines. while it waits he gets a notification that says only " +
+                    "that you want to do something, and nothing is read aloud." + macroWords + one
+            else ->
+                form + "something you do on the phone, as your own act. it runs now, without asking. one exception: " +
+                    "a command whose words repeat a notification or one of the app's lines may be someone else's, " +
+                    "so your rein does not count for it: unless his own approval setting lets it run, it waits in " +
+                    "the chat for his yes, with a notification that says only that you want to do something. " +
+                    "nothing is read aloud." + macroWords + one
+        }
+    }
