+package com.opendroid.ai.ui.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.HerNow
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnLifeStatus
+import com.opendroid.ai.core.persona.PersonaLibrary
+import com.opendroid.ai.core.persona.PersonaMemory
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.core.persona.PersonaOwnTime
+import com.opendroid.ai.core.persona.PersonaSleep
+import com.opendroid.ai.core.persona.PersonaStore
+import com.opendroid.ai.core.persona.PersonaThoughts
+import dagger.hilt.android.lifecycle.HiltViewModel
+import java.io.IOException
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** What a screen has to say about a saved edit of the card and the built-in card of this version. */
+enum class CardEditNotice {
+    /** Nothing: there is no saved edit, or it stands on the built-in card as it is now. */
+    NONE,
+
+    /** The built-in card is another one than the edit was made on. */
+    BUILT_IN_CHANGED,
+
+    /** The edit is older than the record of what it was made on. */
+    CANNOT_TELL
+}
+
+internal fun PersonaStore.EditBase.toNotice(): CardEditNotice = when (this) {
+    PersonaStore.EditBase.NONE, PersonaStore.EditBase.CURRENT -> CardEditNotice.NONE
+    PersonaStore.EditBase.CHANGED -> CardEditNotice.BUILT_IN_CHANGED
+    PersonaStore.EditBase.UNKNOWN -> CardEditNotice.CANNOT_TELL
+}
+
+/**
+ * What the card screen says after lines were handed to her: [added] are the notes that
+ * went into her notebook out of [lineCount] lines, and [notRead] the lines that are no
+ * notes. A line that is not added is named, so that he does not believe she has it.
+ * [shortened] is how many of the notes were too long and were cut by this hand-over
+ * ([PersonaNotes.Reading.shortened]). A note that was cut long ago and still carries the
+ * mark is not counted: nothing was taken from it now. The mark is said to be in the
+ * note, not at its end, because a thread keeps its status behind it.
+ */
+internal fun notesStatusFor(
+    lineCount: Int,
+    added: List<PersonaNotes.Note>,
+    notRead: List<String>,
+    shortened: Int = 0
+): String {
+    if (added.isEmpty()) return "Nothing added. Each line has to read: kind | key | note"
+    val cutPart = when (shortened) {
+        0 -> ""
+        1 -> " 1 note was longer than ${PersonaNotes.NOTE_CEILING_CHARS} characters and was cut there; it is marked [cut]."
+        else -> " $shortened notes were longer than ${PersonaNotes.NOTE_CEILING_CHARS} characters and were cut there; they are marked [cut]."
+    }
+    if (notRead.isEmpty()) return "Added ${added.size}. They are in her notebook now.$cutPart"
+    val named = notRead.take(MAX_LINES_NAMED).joinToString("; ") { line ->
+        "\"" + (if (line.length > MAX_LINE_NAMED_CHARS) line.take(MAX_LINE_NAMED_CHARS) + "..." else line) + "\""
+    }
+    val more = if (notRead.size > MAX_LINES_NAMED) " and ${notRead.size - MAX_LINES_NAMED} more" else ""
+    return "Added ${added.size} of $lineCount lines. The rest did not fit the form: $named$more.$cutPart"
+}
+
+private const val MAX_LINES_NAMED = 3
+private const val MAX_LINE_NAMED_CHARS = 60
+
+/**
+ * What the card screen says once her notebook was emptied: how many notes went, and how
+ * many rows of her archive with them (the old texts of notes she wrote over, and the
+ * notes she or the notebook let go).
+ */
+internal fun emptiedLine(notes: Int, archived: Int): String {
+    if (notes == 0 && archived == 0) return "Her notebook was empty already."
+    if (notes == 0) {
+        val archivePart = if (archived == 1) "1 archived note was deleted." else "$archived archived notes were deleted."
+        return "Her notebook is empty now: it held no notes, but $archivePart The starting notes are not written again."
+    }
+    val with = if (notes == 1) "it" else "them"
+    val archivePart = when (archived) {
+        0 -> ""
+        1 -> " 1 archived note went with $with."
+        else -> " $archived archived notes went with $with."
+    }
+    val notesPart = if (notes == 1) "1 note was deleted." else "$notes notes were deleted."
+    return "Her notebook is empty now: $notesPart$archivePart The starting notes are not written again."
+}
+
+/**
+ * What the card screen says about her own time, in times and counts only: when her last
+ * moment was and what it came to (she wrote to him, kept it to herself, or let it pass),
+ * how many moments the last 24 hours held, when the next one is due, how many attempts
+ * in a row did not come about, and until when she sleeps. All of it is read off what
+ * the app stores about her own time ([PersonaOwnTime.State]), which holds none of her
+ * words. With it he can tell a quiet moment she chose from one that failed.
+ *
+ * An attempt is counted as it starts and cleared once it comes about, so a moment that
+ * is under way while the screen looks counts as one that has not come about yet.
+ */
+internal fun ownTimeStatusLines(
+    state: PersonaOwnTime.State,
+    nowMillis: Long,
+    zone: TimeZone = TimeZone.getDefault(),
+    locale: Locale = Locale.getDefault()
+): List<String> = buildList {
+    val format = SimpleDateFormat("d MMM, HH:mm", locale).apply { timeZone = zone }
+    fun at(millis: Long) = format.format(Date(millis))
+    fun ago(millis: Long) = if (millis < 60_000L) "just now" else PersonaOwnTime.span(millis) + " ago"
+    fun inSpan(millis: Long) = if (millis < 60_000L) "now" else "in " + PersonaOwnTime.span(millis)
+
+    if (state.lastAtMillis > 0) {
+        val did = when (state.lastDid) {
+            PersonaOwnTime.Did.SAID -> " She wrote to you."
+            PersonaOwnTime.Did.KEPT -> " She kept it to herself."
+            PersonaOwnTime.Did.PASSED -> " She let it pass."
+            null -> ""
+        }
+        add("Last moment: ${at(state.lastAtMillis)} (${ago(nowMillis - state.lastAtMillis)}).$did")
+    } else {
+        add("She has had no moment of her own yet.")
+    }
+    add("Moments in the last 24 hours: ${state.momentsOfTheDay(nowMillis).size}.")
+    if (!state.on) {
+        add("Her own time is not running now: it is switched off, or has not been looked at since it was switched on.")
+        return@buildList
+    }
+    if (PersonaSleep.isAsleep(state, nowMillis)) {
+        val until = state.sleepUntil
+        add(
+            if (until > nowMillis) {
+                "Asleep until ${at(until)} (${inSpan(until - nowMillis)}). No moment comes while she sleeps; your message wakes her."
+            } else {
+                "Asleep: she meant to wake at ${at(until)} (${ago(nowMillis - until)}) and wakes when the phone gets to it."
+            }
+        )
+    } else {
+        add(
+            when (val wake = state.wake) {
+                is PersonaOwnTime.Wake.At ->
+                    if (wake.atMillis <= nowMillis) {
+                        "Next moment: due now. It comes when the phone gets to it."
+                    } else {
+                        "Next moment: about ${at(wake.atMillis)} (${inSpan(wake.atMillis - nowMillis)})."
+                    }
+                PersonaOwnTime.Wake.WhenHeWrites ->
+                    "Next moment: the usual gap after her reply to your next message. She asked to wait for you."
+                PersonaOwnTime.Wake.Unset ->
+                    "Next moment: none set yet. The first comes " +
+                        "${PersonaOwnTime.span(PersonaOwnTime.FIRST_MOMENT_AFTER_MILLIS)} after her first reply."
+            }
+        )
+    }
+    when (state.failures) {
+        0 -> Unit
+        1 -> add("The last attempt did not come about. The app tries again later.")
+        else -> add(
+            "The last ${state.failures} attempts in a row did not come about. Each new try waits longer, " +
+                "up to ${PersonaOwnTime.span(PersonaOwnTime.MAX_RETRY_WAIT_MILLIS)}."
+        )
+    }
+}
+
+/**
+ * All the screen says about her private thoughts: how many are kept and since when.
+ * Nothing of what they say is ever read for it.
+ */
+internal fun thoughtsCountLine(count: Int, oldestAtMillis: Long?, locale: Locale = Locale.getDefault()): String = when {
+    count <= 0 || oldestAtMillis == null -> "She has kept no thoughts of her own on this phone."
+    else -> {
+        val since = SimpleDateFormat("d MMM yyyy", locale).format(Date(oldestAtMillis))
+        if (count == 1) "She has kept 1 thought of her own on this phone, from $since." else
+            "She has kept $count thoughts of her own on this phone, the oldest from $since."
+    }
+}
+
+/**
+ * What the card screen says about her own life, in counts, times and places only: his
+ * calls on her own in the last 24 hours by what they were for, with an estimated price;
+ * her upkeep calls and the pages fetched for her; what she is doing now; her outings of
+ * the last 24 hours; kid skips where there were any; and how many wonders she has open.
+ * Nothing she wrote, read or thought is in any of it: the ledger holds purposes, models
+ * and counts, the log titles and counts, and her wonders are only counted.
+ *
+ * [ownTimeOn] is whether her own time runs at all: without it nothing of her own life
+ * does, whatever its switch says.
+ */
+internal fun ownLifeStatusLines(snapshot: OwnLifeStatus.Snapshot, ownTimeOn: Boolean, nowMillis: Long): List<String> = buildList {
+    val switchedOn = snapshot.config.personaOwnLife
+    when {
+        !switchedOn -> add(
+            "Her own life is switched off: she goes on no outing and keeps no list of wonders. Her moments are " +
+                "counted all the same, and his number of calls on her own does not hold them."
+        )
+        !ownTimeOn -> add("Her own life is switched on, but her own time is off, so none of it runs.")
+    }
+    val summary = snapshot.summary
+    if (summary == null) {
+        add("Calls on her own: the count cannot be read, so no outing starts.")
+    } else {
+        add(summary.statusLine(withCap = switchedOn))
+        summary.upkeepLine()?.let(::add)
+        summary.fetchesLine()?.let(::add)
+    }
+    eyesStatusLine(
+        snapshot.config, summary,
+        camera = com.opendroid.ai.core.life.eyes.CameraLook.describedToday(snapshot.entries, nowMillis, com.opendroid.ai.core.life.OutingHost.PICTURES_LOOKED)
+    )?.let(::add)
+    cameraStatusLine(snapshot.config, snapshot.cameraHeld, snapshot.cameraReady)?.let(::add)
+    add(HerNow.statusLine(snapshot.now, nowMillis))
+    add(HerLog.outingsLine(snapshot.entries, nowMillis) ?: "Outings in 24 h: none.")
+    HerLog.kidsLine(snapshot.entries, nowMillis)?.let(::add)
+    snapshot.openWonders?.let { add("Open wonders: $it.") }
+}
+
+/**
+ * Her eyes on the status card, counts and a price only: "Eyes: 9 pictures in 24 h, of 60.
+ * About $0.01." while they are on or were used in the last 24 hours; why the app stopped
+ * them, where it did. Null while they are off and unused.
+ */
+internal fun eyesStatusLine(config: com.opendroid.ai.data.models.LLMConfig, summary: OwnLedger.Summary?, camera: Int = 0): String? {
+    val stopped = config.personaEyesStoppedWhy.takeIf { it.isNotBlank() }?.let { "Eyes: stopped. $it" }
+    if (stopped != null) return stopped
+    val used = summary?.byPurpose?.get(com.opendroid.ai.core.life.OwnPurpose.EYES) ?: 0
+    if (!config.personaEyes && used == 0) return null
+    val perDay = com.opendroid.ai.core.life.eyes.HerEyes.perDay(config)
+    return summary?.eyesLine(perDay, camera) ?: "Eyes: the count cannot be read."
+}
+
+/**
+ * Her camera looks on the status card, while he has switched them on: "Camera: ready." where
+ * the service holds the camera type, "Camera: needs one tap ..." after a start from the
+ * background, until he taps Eyes and ears on the app's notification. Null while they are off.
+ */
+internal fun cameraStatusLine(config: com.opendroid.ai.data.models.LLMConfig, held: Boolean, ready: Boolean = true): String? = when {
+    !config.personaCameraLooks -> null
+    !ready -> CAMERA_NOT_ALLOWED
+    held -> CAMERA_READY
+    else -> CAMERA_NEEDS_TAP
+}
+
+internal const val CAMERA_READY = "Camera: ready."
+internal const val CAMERA_NOT_ALLOWED =
+    "Camera: the app may not use the camera. Allow it on the Permissions screen; until then she has no camera looks."
+internal const val CAMERA_NEEDS_TAP = "Camera: needs one tap (Eyes and ears, on the app's notification). Until then she has no camera looks."
+
+/**
+ * Backs the screen where the owner reads and edits the persona's character card, hands
+ * her notes, and can delete her private thoughts without ever being shown them.
+ */
+@HiltViewModel
+class PersonaViewModel @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val library: PersonaLibrary,
+    private val thoughts: PersonaThoughts,
+    private val ownLife: OwnLifeStatus
+) : ViewModel() {
+
+    /** How many private thoughts of hers are kept and since when. Empty until it has been asked. */
+    var thoughtsLine by mutableStateOf("")
+        private set
+
+    /** What came of the last time her private thoughts were emptied. */
+    var thoughtsStatus by mutableStateOf("")
+        private set
+
+    /** What the screen says about her own time ([ownTimeStatusLines]). Empty until it has been asked. */
+    var ownTimeLines by mutableStateOf<List<String>>(emptyList())
+        private set
+
+    /** Reads what is stored about her own time, for its times and counts. Nothing she wrote is in it. */
+    fun loadOwnTimeStatus(nowMillis: () -> Long = System::currentTimeMillis) {
+        viewModelScope.launch {
+            val state = withContext(Dispatchers.IO) { memory.ownTime() }
+            ownTimeLines = ownTimeStatusLines(state, nowMillis())
+        }
+    }
+
+    /** What the screen says about her own life ([ownLifeStatusLines]). Empty until it has been asked. */
+    var ownLifeLines by mutableStateOf<List<String>>(emptyList())
+        private set
+
+    /** Reads her own life's counts, times and places for the screen. Nothing she wrote is read for it. */
+    fun loadOwnLifeStatus(nowMillis: () -> Long = System::currentTimeMillis) {
+        viewModelScope.launch {
+            val at = nowMillis()
+            val snapshot = ownLife.read(at)
+            ownLifeLines = ownLifeStatusLines(snapshot, PersonaOwnTime.isOn(snapshot.config), at)
+        }
+    }
+
+    /** Asks how many thoughts are kept and since when. That is all this screen ever asks of them. */
+    fun loadThoughtsCount() {
+        viewModelScope.launch {
+            val summary = thoughts.summary()
+            thoughtsLine = thoughtsCountLine(summary.count, summary.oldestAtMillis)
+        }
+    }
+
+    /** Deletes every private thought of hers, unseen. Only his own confirmed action on this screen calls it. */
+    fun emptyThoughts() {
+        viewModelScope.launch {
+            val status = try {
+                val deleted = thoughts.wipe()
+                if (deleted == 0) "There were no thoughts of hers to delete." else
+                    "Her private thoughts are deleted: $deleted of them. None was shown."
+            } catch (e: IOException) {
+                "Her private thoughts could not be deleted. They are still on this phone."
+            }
+            // The count first, so that the screen never shows the old one beside the new status.
+            val summary = thoughts.summary()
+            thoughtsLine = thoughtsCountLine(summary.count, summary.oldestAtMillis)
+            thoughtsStatus = status
+        }
+    }
+
+    /** What the library holds, for the line under its setting. Empty until it has been read. */
+    var librarySummary by mutableStateOf("")
+        private set
+
+    /** The text field in which the owner hands her notes, and what came of the last hand-over. */
+    var notesDraft by mutableStateOf("")
+        private set
+    var notesStatus by mutableStateOf("")
+        private set
+
+    fun onNotesDraftChange(text: String) {
+        notesDraft = text
+        notesStatus = ""
+    }
+
+    /**
+     * Puts the lines of the draft into her notebook, on this phone. Each line is
+     * `kind | key | note`, the form her own notes have. Nothing is sent anywhere.
+     *
+     * A notebook that was copied on another phone after its start says so in its first
+     * line. It is then taken over as the notebook it is: the starting notes are not
+     * written into it a second time. A starting note in it that the build on the other
+     * phone wrote, and she never rewrote, is given the wording of this build, once its
+     * lines are all in ([PersonaMemory.refreshStartingNotes]); what she wrote is hers.
+     *
+     * What is said afterwards is what happened: how many lines were added, which lines
+     * were not because they are no notes, and how many notes were too long and were cut
+     * by this hand-over.
+     */
+    fun giveNotes() {
+        val text = notesDraft
+        viewModelScope.launch {
+            val reading = PersonaNotes.read(text)
+            val notes = reading.notes
+            val lines = text.lines().map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }
+            val notRead = lines.filter { PersonaNotes.parseLine(it) == null }
+            if (notes.isNotEmpty()) {
+                withContext(Dispatchers.IO) {
+                    val handedOver = PersonaNotes.carriesStartedMark(text)
+                    // Started before its lines go in: a first start of hers here that comes in between
+                    // would write in the starting notes she let go on the other phone.
+                    if (handedOver) memory.markStarted()
+                    memory.apply(notes)
+                    // Only once its lines are in: a look over the notebook from before them must not count for them.
+                    if (handedOver) {
+                        memory.handedOver()
+                        memory.refreshStartingNotes(store.seedNotes(), store.previousSeedNotes())
+                    }
+                }
+            }
+            notesStatus = notesStatusFor(lines.size, notes, notRead, shortened = reading.shortened.size)
+            if (notes.isNotEmpty() && notRead.isEmpty()) notesDraft = ""
+        }
+    }
+
+    /**
+     * Hands [toClipboard] her whole notebook as `kind | key | note` lines, the form
+     * [giveNotes] takes, so that it can be carried to another install. A notebook that
+     * has had its start says so in a first line of its own ([PersonaNotes.STARTED_MARK]).
+     * The notes are only read here; where the text goes after that is the clipboard's business.
+     */
+    fun copyNotebook(toClipboard: (String) -> Unit) {
+        viewModelScope.launch {
+            val (notes, started) = withContext(Dispatchers.IO) { memory.notes() to memory.isStarted() }
+            if (notes.isEmpty()) {
+                notesStatus = "Her notebook is empty. Nothing was copied."
+                return@launch
+            }
+            // Whether it has had its starting notes travels with it, so they are not written in again there.
+            toClipboard(PersonaNotes.export(notes, started))
+            notesStatus = "Copied ${notes.size} notes. On the other phone, paste them into the field above " +
+                "and add them: that is how her notebook is moved."
+        }
+    }
+
+    /** How many rows her archive holds, for the question asked before her notebook is emptied. Null until it has been read. */
+    var archivedCount by mutableStateOf<Int?>(null)
+        private set
+
+    /** Reads how many rows her archive holds. That count is all this screen ever reads of it. */
+    fun loadArchiveCount() {
+        archivedCount = null
+        viewModelScope.launch {
+            archivedCount = withContext(Dispatchers.IO) { memory.archiveCount() }
+        }
+    }
+
+    /** Deletes every note of hers, her archive and how she feels. The starting notes are not written again afterwards. */
+    fun emptyNotebook() {
+        viewModelScope.launch {
+            val deleted = withContext(Dispatchers.IO) { memory.empty() }
+            notesStatus = emptiedLine(deleted.notes, deleted.archived)
+        }
+    }
+
+    fun loadLibrarySummary() {
+        if (librarySummary.isNotEmpty()) return
+        viewModelScope.launch {
+            val shelf = library.shelf()
+            librarySummary = if (shelf.pages.isEmpty()) {
+                "This build has none of her files beyond the card."
+            } else {
+                "${library.fileCount} of her files are on this phone, ${shelf.pages.size} pages, " +
+                    "about ${shelf.totalChars / 1000},000 characters."
+            }
+        }
+    }
+
+    // Snapshot state, not a StateFlow: a text field this long drops characters when
+    // every keystroke makes an asynchronous round trip.
+    var cardText by mutableStateOf("")
+        private set
+    var isLoading by mutableStateOf(true)
+        private set
+
+    /** True when a saved edit, not the bundled card, is what she runs on. */
+    var usesSavedEdit by mutableStateOf(false)
+        private set
+    var hasUnsavedChanges by mutableStateOf(false)
+        private set
+
+    /** What there is to say about the saved edit and the built-in card of this version. */
+    var editNotice by mutableStateOf(CardEditNotice.NONE)
+        private set
+
+    /** Why the last save, restore or choice did not go through; empty when it did. */
+    var cardError by mutableStateOf("")
+        private set
+
+    private data class Stored(val text: String, val edited: Boolean, val notice: CardEditNotice)
+
+    private fun readStored() = Stored(store.card(), store.hasOverride(), store.editBase().toNotice())
+
+    /** Shows what is stored. With [keepTyped] the text in the editor, saved or not, is left as he has it. */
+    private fun show(stored: Stored, keepTyped: Boolean = false) {
+        if (!keepTyped) {
+            cardText = stored.text
+            hasUnsavedChanges = false
+        }
+        usesSavedEdit = stored.edited
+        editNotice = stored.notice
+        cardError = ""
+    }
+
+    init {
+        viewModelScope.launch {
+            show(withContext(Dispatchers.IO) { readStored() })
+            isLoading = false
+        }
+    }
+
+    fun onTextChange(text: String) {
+        cardText = text
+        hasUnsavedChanges = true
+    }
+
+    /**
+     * Changes what is stored and then shows what is stored. A write that fails leaves
+     * the text in the editor as it is and says so on the screen: storage that is full is
+     * no reason to lose what he typed, or to take the app down with it.
+     */
+    private fun change(failure: String, keepTyped: Boolean = false, then: () -> Unit = {}, write: () -> Unit) {
+        viewModelScope.launch {
+            val stored = try {
+                withContext(Dispatchers.IO) {
+                    write()
+                    readStored()
+                }
+            } catch (e: IOException) {
+                cardError = failure
+                return@launch
+            }
+            show(stored, keepTyped)
+            then()
+        }
+    }
+
+    /**
+     * Saves the text; she uses it from her next reply. Saving an empty card restores the
+     * bundled one. [then] runs once the text is stored, and not at all when it could not be.
+     */
+    fun save(then: () -> Unit = {}) {
+        val text = cardText
+        change("The card could not be saved. Your text is still here; the card she runs on is unchanged.", then = then) {
+            store.saveCard(text)
+        }
+    }
+
+    /** Removes the saved edit, so that she runs on the built-in card of this version. */
+    fun restoreBundled() {
+        change("Your edit could not be removed. She still runs on it.") { store.saveCard("") }
+    }
+
+    /**
+     * Keeps the saved edit although the built-in card is another one now. Only the notice
+     * goes: what he is typing in the editor at that moment is not touched.
+     */
+    fun keepEdit() {
+        change("That could not be stored. Nothing was changed.", keepTyped = true) { store.keepEdit() }
+    }
+}
