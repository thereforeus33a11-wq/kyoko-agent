+        val choice = PersonaPictureRules.choose(pictures, "tell me the whole story of the night", turn = 0)!!
+        assertEquals("a", choice.picture.id)
+        assertNull(PersonaPictureRules.choose(listOf(background("page", "x")), "x", turn = 0))
+    }
+
+    // ── How it is attached ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `the picture rides on his first message and his words are not touched`() {
+        val dialogue = listOf(he("morning"), she("mm"), he("what are you wearing"))
+        val sent = PersonaPictureRules.withOwnPicture(dialogue, OwnPicture("aGVy", "plate outfit"))
+
+        assertEquals("aGVy", sent[0].imageBase64)
+        assertEquals(dialogue[0].copy(imageBase64 = "aGVy"), sent[0])
+        assertEquals(dialogue.drop(1), sent.drop(1))
+        assertEquals(dialogue.map { it.text }, sent.map { it.text })
+        // What was handed in is left as it was: the caller keeps the dialogue without the picture.
+        assertNull(dialogue[0].imageBase64)
+    }
+
+    @Test
+    fun `nothing is attached without a picture, without a message of his, or beside another image`() {
+        val dialogue = listOf(he("morning"), she("mm"), he("look at this", image = "c2NyZWVu"))
+        assertSame(dialogue, PersonaPictureRules.withOwnPicture(dialogue, null))
+        assertSame(dialogue, PersonaPictureRules.withOwnPicture(dialogue, OwnPicture("aGVy", "")))
+
+        val onFirst = listOf(he("what is this", image = "c2NyZWVu"))
+        assertSame(onFirst, PersonaPictureRules.withOwnPicture(onFirst, OwnPicture("aGVy", "")))
+
+        val onlyHers = listOf(she("mm"))
