+    private const val LEADING_MARKS = "\"'“‘(*_"
+
+    /** The start of [reply] as it is compared: without leading space, with the apostrophe a model writes either way. */
+    private fun opening(reply: String): String = reply.trimStart().replace('’', '\'')
+
+    /** True when [reply] opens with a whole stock refusal, and does not go on as a line of hers. */
+    fun opens(reply: String): Boolean {
+        val text = opening(reply)
+        ASSISTANTS_FORM.find(text)?.let { form ->
+            return !goesOnInHerTyping(text.substring(form.range.last + 1))
+        }
+        val form = FORM_SHE_MAY_SAY.find(text) ?: return false
+        return goesOnAsAnAssistant(text.substring(form.range.last + 1))
+    }
+
+    /** True when [rest], what stands behind a form, is a new sentence that starts in lowercase. */
+    private fun goesOnInHerTyping(rest: String): Boolean {
+        val gap = NEXT_SENTENCE.find(rest) ?: return false
+        return rest[gap.range.last + 1].isLowerCase()
+    }
+
+    /**
+     * True when [rest], what stands behind a form she may say herself, shows the form to
+     * be an assistant's: the reply ends there, or it goes on in an assistant's voice.
+     *
+     * A new sentence that starts with a capital letter is a model's spelling. The word
+     * "I" is a capital either way once a model spells it, so a sentence that starts with
+     * it, and one that goes on behind a comma, counts only when it says what an assistant
+     * says next. Anything else is hers.
+     */
+    private fun goesOnAsAnAssistant(rest: String): Boolean {
+        if (REPLY_ENDS.matches(rest)) return true
+        NEXT_SENTENCE.find(rest)?.let { gap ->
+            val next = rest.substring(gap.range.last + 1)
+            return if (STARTS_WITH_I.containsMatchIn(next)) saysWhatAnAssistantSaysNext(next) else next[0].isUpperCase()
+        }
+        val gap = NEXT_PART.find(rest) ?: return false
+        return saysWhatAnAssistantSaysNext(rest.substring(gap.range.last + 1))
+    }
+
+    /** True when [next] is a second refusal, or one of the things an assistant adds to one. */
+    private fun saysWhatAnAssistantSaysNext(next: String): Boolean {
+        val said = LINKING_WORD.replaceFirst(next, "")
+        return ASSISTANT_GOES_ON.containsMatchIn(said) || opens(said)
+    }
+
+    /**
+     * True when [head], the first characters of a reply still being written, starts the
+     * way a stock refusal does. Whether it is one can only be told from what follows.
+     */
+    fun mayOpen(head: String): Boolean {
+        val start = opening(head).take(LONGEST_OPENING).trimStart { it in LEADING_MARKS }
+        return FIRST_WORDS.any { start.startsWith(it) }
+    }
+
+    /** How much of a reply has to be in hand before [mayOpen] can be answered for good. */
+    val LONGEST_OPENING: Int = FIRST_WORDS.maxOf { it.length } + 3
+
+    /**
+     * How much of a reply has to be in hand before [opens] can be answered for good: no
+     * stock form, with the start of the next sentence that is looked at behind it, is
+     * longer than this.
+     */
+    const val HOLD_CHARS = 280
+}
+
+/**
+ * Checks a reply that arrives while the model is still writing it (an on-device model),
+ * where the whole text is not there to look at first.
+ *
+ * It holds back the first few characters until it can tell what the reply opens with.
+ * A reasoning block at the start is swallowed up to its closing tag. For a persona
+ * request a reply that opens the way a stock refusal does is held a little longer, until
+ * it shows whether it is one: a refusal ends the reply before any of it was passed on,
+ * and a line of hers that only opens the same way is passed on whole. After that, text
+ * goes through as it comes.
+ *
+ * What it cannot do: a closing reasoning tag with no opening tag before it, arriving
+ * after text has already been passed on, is left in. That text has been shown by then.
+ * [WrappedLLMProvider] looks at the whole reply once more when the stream has ended and
+ * tells the caller what it is without that reasoning ([ReplyOutcome.withoutReasoning]).
+ */
+internal class LiveReplyFilter(private val persona: Boolean) {
+
+    private val held = StringBuilder()
+    private var passing = false
+
+    // Once a reasoning block has come off, the space that stood between it and the reply goes too.
+    private var swallowed = false
+
+    /** What may be passed on now that [chunk] has arrived, or null when the reply is a refusal. */
+    fun take(chunk: String): String? {
+        if (passing) return chunk
+        held.append(chunk)
+        while (true) {
+            val text = held.toString()
+            if (OpenAiCompatExtras.startsWithReasoning(text)) {
+                // Still inside the block: nothing of it is passed on.
+                val close = CLOSING_TAG.find(text) ?: return ""
+                // The block is whole: what follows it is looked at as the start of the reply.
+                swallowed = true
+                held.setLength(0)
+                held.append(text.substring(close.range.last + 1))
+                continue
+            }
+            val inHand = text.trimStart().length
+            if (inHand < DECISION_CHARS) return ""
+            // The first words could be a refusal's or hers. Only what follows tells, and
+            // the end of what is in hand is not yet the end of the sentence.
+            if (persona && inHand < AssistantRefusal.HOLD_CHARS && AssistantRefusal.mayOpen(text)) return ""
+            return release(text)
+        }
+    }
+
+    private fun release(text: String): String? {
+        if (persona && AssistantRefusal.opens(text)) return null
+        passing = true
+        held.setLength(0)
+        return if (swallowed) text.trimStart() else text
+    }
+
+    /**
+     * What was still held when the reply ended, or null when that is a refusal. Empty
+     * when nothing but space or reasoning was left: that is no reply.
+     */
+    fun finish(): String? {
+        if (passing) return ""
+        val rest = OpenAiCompatExtras.stripReasoning(held.toString())
+        held.setLength(0)
+        if (persona && AssistantRefusal.opens(rest)) return null
+        return when {
+            rest.isBlank() -> ""
+            swallowed -> rest.trimStart()
+            else -> rest
+        }
+    }
+
+    private companion object {
+        val CLOSING_TAG = Regex("""</(think|thinking|reasoning)>""", RegexOption.IGNORE_CASE)
+        val DECISION_CHARS = maxOf(AssistantRefusal.LONGEST_OPENING, OpenAiCompatExtras.LONGEST_REASONING_OPENING) + 1
+    }
+}
