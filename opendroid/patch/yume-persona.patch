+        internal fun chatProviderOrMain(config: LLMConfig): String =
+            chatProviderName(config) ?: ProviderCatalog.canonicalName(config.activeProvider)
+
+        /**
+         * The model her replies go to with [config], as one text: provider, model and
+         * address. Two configurations with the same text send to the same model.
+         */
+        internal fun chatModelKey(config: LLMConfig): String {
+            val provider = chatProviderOrMain(config)
+            val model = config.personaChatModel.trim().ifEmpty {
+                if (ProviderCatalog.isKnown(provider)) config.selectedModelFor(provider) else ""
+            }
+            return listOf(provider, model, RouteClassifier.endpointOf(config, provider)).joinToString("\n")
+        }
+
+        /**
+         * Whether a request to [provider] can carry an image. The models that run inside
