+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.HerLog
+
+/**
+ * When his screen may be lent to her, and when it is his again (OWN_LIFE_PLAN §1.1, the lent
+ * screen, without a work profile: his own apps on his own screen, look only).
+ *
+ * It may start ([mayStart]) only while his screen is on and unlocked, with no call, nothing of
+ * his playing, and the phone not in his hand: nothing of his touched it within [HAND_MILLIS].
+ * His own yes on the question (his settings ask him first) is the hand-over, and the touch that
+ * gave it does not count.
+ *
+ * Once it runs, [LendWatch] ends it the instant he takes the phone back: a touch of his on the
+ * screen, a tap, a long press or a text of his in any app, his screen going off or locking, a
+ * call, a notification or the shade over the app, or another app in front. Her own touches make
+ * the same signals: a finger going down just as one of her presses starts is hers ([herPress]),
+ * and what an app reports during and just after a move of hers is hers ([herMove]). Anything
+ * else is his, and a false alarm ends the outing, which is the safe way to be wrong.
+ *
+ * Pure: the times are passed in, and a test runs every case.
+ */
+object LendRules {
+
+    /** Nothing of his touched the phone for this long before it may be lent. */
+    const val HAND_MILLIS = 60_000L
+
+    /** His yes on the question this recently is the hand-over: the touch that gave it does not count. */
+    const val YES_MILLIS = 2 * 60_000L
+
+    /** The phone as lending it needs it, read now. */
+    data class Phone(
+        val screenOn: Boolean,
+        val unlocked: Boolean,
+        val inCall: Boolean,
+        /** Music or a video of his plays: he may be watching or listening. */
+        val hisSound: Boolean,
+        /** When something of his last touched it (a tap, a scroll, a text, an unlock), or 0. */
+        val lastTouchedAt: Long,
+        /** The accessibility service is connected: without it nothing can be seen or moved. */
+        val hands: Boolean
+    )
+
+    /** Why his screen may not be lent now. */
+    enum class Refusal(val notStarted: HerLog.NotStarted) {
+        NO_HANDS(HerLog.NotStarted.NO_HANDS),
+        LOCKED(HerLog.NotStarted.SCREEN_LOCKED),
+        CALL(HerLog.NotStarted.ON_A_CALL),
+        HIS_SOUND(HerLog.NotStarted.HIS_SOUND),
+        IN_HIS_HAND(HerLog.NotStarted.IN_HIS_HAND)
+    }
+
+    /**
+     * Why his screen may not be lent at [nowMillis], or null when it may. [hisYesAt] is when he
+     * let her on the question his settings asked, or 0.
+     */
+    fun mayStart(phone: Phone, nowMillis: Long, hisYesAt: Long = 0L): Refusal? = when {
+        !phone.hands -> Refusal.NO_HANDS
+        !phone.screenOn || !phone.unlocked -> Refusal.LOCKED
+        phone.inCall -> Refusal.CALL
+        phone.hisSound -> Refusal.HIS_SOUND
+        hisYesAt > 0L && nowMillis - hisYesAt in 0..YES_MILLIS -> null
+        phone.lastTouchedAt > 0L && nowMillis - phone.lastTouchedAt < HAND_MILLIS -> Refusal.IN_HIS_HAND
+        else -> null
+    }
+}
+
+/**
+ * One lent screen, watched: what has ended it, once something has. Her own moves are marked so
+ * that what they cause is not taken for him, in two kinds: [herPress] where her finger goes down
+ * on the screen (a touch felt then is hers), and [herMove] for what an app reports of a move of
+ * hers (a tap, a back, a search, the app opening), which makes no touch of its own.
+ */
+class LendWatch(private val startedAt: Long) {
+
+    /** What took the screen back. */
+    enum class Ending(val endedBy: HerLog.EndedBy) {
+        /** He touched the screen, tapped, typed, or her touch was cut off by his. */
+        TOUCHED(HerLog.EndedBy.TAKEOVER),
+
+        /** His screen went off or locked. */
+        LOCKED(HerLog.EndedBy.SCREEN_OFF),
+
+        /** A call. */
+        CALL(HerLog.EndedBy.CALL),
+
+        /** A notification, the shade or a dialog of the system came over the app. */
+        NOTIFICATION(HerLog.EndedBy.NOTIFICATION),
+
+        /** Another app came in front without a move of hers: his doing. */
+        OTHER_APP(HerLog.EndedBy.TAKEOVER),
+
+        /** A move of hers took her out of the app (a back on its first screen, a link to another app). */
+        LEFT_APP(HerLog.EndedBy.DONE),
+
+        /** A screen that is his to answer came up: a sign-in, a payment, a permission, the store. */
+        NEEDS_HIM(HerLog.EndedBy.NEEDS_HIM)
+    }
+
+    /** What the screen told: each from the accessibility service or the phone, with its time. */
+    sealed class Signal {
+        abstract val atMillis: Long
+
+        /** A finger on the screen: the watcher overlay felt a touch outside it, or on it. */
+        data class Touch(override val atMillis: Long) : Signal()
+
+        /** A tap, a long press, a text typed, as an app reported it. */
+        data class Interaction(override val atMillis: Long, val packageName: String) : Signal()
+
+        /** The window in front is now [packageName]'s; [systemOver] a system window other than the bars covers the app. */
+        data class Front(override val atMillis: Long, val packageName: String, val systemOver: Boolean = false) : Signal()
+
+        data class ScreenOff(override val atMillis: Long) : Signal()
+        data class Call(override val atMillis: Long) : Signal()
+
+        /** A touch of hers was cancelled before it ended: something else touched the screen. */
+        data class Cut(override val atMillis: Long) : Signal()
+    }
+
+    @Volatile var ending: Ending? = null
+        private set
+
+    /**
+     * Her app has come to the front once ([arrived]). Until it has, what is in front is the
+     * screen it opens over (home, his app, this one) and says nothing about his hand.
+     */
+    @Volatile var arrived: Boolean = false
+        private set
+
+    /** Her app is in front: from here another app in front is his doing, or where her move took her. */
+    fun arrived() {
+        arrived = true
+    }
+
+    private val moves = ArrayList<LongRange>()
+    private val presses = ArrayList<LongRange>()
+    private val lock = Any()
+
+    /**
+     * A move of hers runs from [fromMillis] to [toMillis]: what an app reports of it (a tap, a
+     * text, the window in front) is hers, during it and for [GRACE_MILLIS] after. A finger on
+     * the screen is not: only [herPress] makes a touch hers.
+     */
+    fun herMove(fromMillis: Long, toMillis: Long) {
+        synchronized(lock) {
+            moves += (fromMillis - LEAD_MILLIS)..(toMillis + GRACE_MILLIS)
+            // Only the recent ones matter.
+            while (moves.size > KEPT_MOVES) moves.removeAt(0)
+        }
+    }
+
+    /**
+     * Her finger goes down on the screen at [atMillis]: a touch felt within [LEAD_MILLIS] before
+     * it and [PRESS_TOUCH_MILLIS] after it is hers. The watcher feels a touch as the finger goes
+     * down, so a touch later in her swipe, or after it, is his.
+     */
+    fun herPress(atMillis: Long) {
+        synchronized(lock) {
+            presses += (atMillis - LEAD_MILLIS)..(atMillis + PRESS_TOUCH_MILLIS)
+            while (presses.size > KEPT_MOVES) presses.removeAt(0)
+        }
+    }
+
+    private fun hers(atMillis: Long): Boolean = synchronized(lock) { moves.any { atMillis in it } }
+
+    private fun herTouch(atMillis: Long): Boolean = synchronized(lock) { presses.any { atMillis in it } }
+
+    /**
+     * Takes [signal] in, for the app she is in ([appPackages]); the ending once one holds, and the
+     * first ending stays. [ownPackage] is this app's (its overlay and its notification), [launchers]
+     * are the home screens, [keyboards] the input methods.
+     */
+    fun signal(
+        signal: Signal,
+        appPackages: Collection<String>,
+        ownPackage: String = "",
+        launchers: Collection<String> = emptyList(),
+        keyboards: Collection<String> = emptyList()
+    ): Ending? {
+        ending?.let { return it }
+        // What came before the screen was lent is not about this outing: his yes on the question among it.
+        if (signal.atMillis < startedAt) return null
+        val found = when (signal) {
+            is Signal.ScreenOff -> Ending.LOCKED
+            is Signal.Call -> Ending.CALL
+            is Signal.Cut -> Ending.TOUCHED
+            is Signal.Touch -> if (herTouch(signal.atMillis)) null else Ending.TOUCHED
+            is Signal.Interaction -> when {
+                hers(signal.atMillis) -> null
+                // This app's own overlay and notification are not his touch on the screen.
+                signal.packageName == ownPackage -> null
+                else -> Ending.TOUCHED
+            }
+            is Signal.Front -> front(signal, appPackages, ownPackage, launchers, keyboards)
+        }
+        if (found != null) ending = found
+        return ending
+    }
+
+    private fun front(
+        signal: Signal.Front,
+        appPackages: Collection<String>,
+        ownPackage: String,
+        launchers: Collection<String>,
+        keyboards: Collection<String>
+    ): Ending? {
+        if (signal.systemOver) return Ending.NOTIFICATION
+        val front = signal.packageName
+        if (front in appPackages) arrived = true
+        return when {
+            front.isBlank() || front in appPackages || front in keyboards || front == ownPackage || front == SYSTEM_UI -> null
+            front in HisApps.CALL_PACKAGES -> Ending.CALL
+            front in HisApps.GATE_PACKAGES -> Ending.NEEDS_HIM
+            // Before her app is in front, the screen it opens over is still there: nothing to end.
+            !arrived -> null
+            hers(signal.atMillis) -> Ending.LEFT_APP
+            front in launchers -> Ending.OTHER_APP
+            else -> Ending.OTHER_APP
+        }
+    }
+
+    companion object {
+        /** What an app reports this long after a move of hers is still hers: a tap opens a page, a list settles. */
+        const val GRACE_MILLIS = 1_500L
+
+        /** A touch of hers can be felt a moment before the move is marked. */
+        const val LEAD_MILLIS = 60L
+
+        /** How long after her finger goes down the touch it makes can still arrive. */
+        const val PRESS_TOUCH_MILLIS = 250L
+
+        const val SYSTEM_UI = "com.android.systemui"
+
+        private const val KEPT_MOVES = 32
+    }
+}
+
+/**
+ * When something of his last touched the phone ([LendRules.Phone.lastTouchedAt]), from what the
+ * screen tells while it is not lent: a tap, a long press, a text, a window coming up, and his
+ * thumb moving what is in front (a scroll, a selection, a focus in the app in front). Scrolling
+ * is how he uses the phone most: a feed he reads without a tap is in his hand. A carousel that
+ * moves by itself only keeps her off his screen longer, which is the safe way to be wrong.
+ *
+ * Pure: the accessibility service tells it each event, by kind ([Event]), and a test can run
+ * every case.
+ */
+class HisHand {
+
+    /** What the screen told, by kind. */
+    enum class Event { CLICK, LONG_CLICK, TEXT, TOUCH, WINDOW, SCROLL, SELECTED, FOCUSED, OTHER }
+
+    @Volatile var lastTouchedAt: Long = 0L
+        private set
+
+    /** The package whose window last came up: the app in front. */
+    @Volatile var front: String = ""
+        private set
+
+    /**
+     * An [event] from [packageName] at [atMillis]. While the screen is [lent] to her nothing of it
+     * is his hand (her moves make the same events); the app in front is still followed.
+     */
+    fun event(event: Event, packageName: String, atMillis: Long, lent: Boolean = false) {
+        if (event == Event.WINDOW && packageName.isNotBlank()) front = packageName
+        if (lent) return
+        val his = when (event) {
+            Event.CLICK, Event.LONG_CLICK, Event.TEXT, Event.TOUCH, Event.WINDOW -> true
+            // His thumb on what is in front: the app in front, or one that does not say which it is.
+            Event.SCROLL, Event.SELECTED, Event.FOCUSED -> packageName.isBlank() || front.isBlank() || packageName == front
+            Event.OTHER -> false
+        }
+        if (his) touched(atMillis)
+    }
+
+    /** Something of his touched the phone at [atMillis]: an unlock, the screen going off. */
+    fun touched(atMillis: Long) {
+        if (atMillis > lastTouchedAt) lastTouchedAt = atMillis
+    }
+}
+
+/**
+ * His sound while she is on his screen: turned down to nothing, and a mark kept of what it was,
+ * so that an app stopped mid-outing (an update, a crash) puts it back when it is up again. Pure.
+ */
+object QuietMark {
+    /**
+     * The volume to put back when the app is up again, or null: a mark of [was] was kept and the
+     * sound is still at nothing ([now]); a volume he set meanwhile stays his.
+     */
+    fun restore(was: Int?, now: Int): Int? = if (was != null && was > 0 && now == 0) was else null
+}
