+        // Her last notebook pass read up to half an hour ago: what ended since is hers to read.
+        assertEquals(listOf("night"), RecordLines.forNotebook(entries, now - 30 * 60_000L, now).map { it.id })
+        // Oldest first by when each ended.
+        assertEquals(listOf("older", "night"), RecordLines.forMoment(entries, now).map { it.id })
+        assertEquals(listOf("older", "night"), RecordLines.forReply(entries, "anything", now).map { it.id })
+        // Her line says how long ago it ran.
+        val line = RecordForHer { entries }.forReply("anything", heldBack = false, nowMillis = now).last()
+        assertTrue(line, line.startsWith(PersonaPrompts.age(60_000L) + ": your command in a moment of your own"))
+
+        // The record keeps it by when it ended too: made 31 days ago, ended 29 days ago, it stays.
+        val long = textEntry("long", now - 31 * DAY).copy(endedAt = now - 29 * DAY)
+        assertEquals(listOf("long"), PhoneLog.retained(listOf(long), now).map { it.id })
+    }
+
+    @Test
+    fun `held back, a reply is told only the newest entries, never older ones his message picked`() {
+        val recent = textEntry("recent", now - HOUR, to = "Mom", words = "home soon")
+        val patel = textEntry("patel", now - 12 * DAY, to = "Dr. Patel", words = "about the biopsy results")
+        val others = (1..20).map { i -> textEntry("o$i", now - (3 + i % 20) * DAY, to = "Mom", words = "ok") }
+        val all = listOf(recent, patel) + others
+        val message = "did the note to dr. patel about the biopsy ever go?"
+        assertTrue(RecordLines.forReply(all, message, now).any { it.id == "patel" })
