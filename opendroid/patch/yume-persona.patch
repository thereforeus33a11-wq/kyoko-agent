+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.phone.HumanMotion.Energy
+import com.opendroid.ai.core.life.phone.HumanMotion.Quirk
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Random
+import kotlin.math.abs
+import kotlin.math.hypot
+
+/**
+ * How her finger moves on his screen, checked by its distributions and bounds over many seeded
+ * moves: swipes curve but stay on the screen and off its edges, they speed up and slow down,
+ * their durations are a person's, no two in a row are the same, the slips are rare, taps land
+ * near the centre and never off the target, and her energy moves the pace the way her clock
+ * moves her.
+ */
+class HumanMotionTest {
+
+    private val area = HumanMotion.Area(1080, 2520)
+
+    private fun motion(seed: Long = 7) = HumanMotion(Random(seed))
+
+    /** The main swipe of a scroll: the longest touch in it. */
+    private fun main(plan: HumanMotion.Plan): HumanMotion.Touch = plan.touches.maxByOrNull { abs(it.end.y - it.start.y) }!!
+
+    /** How far the points of [touch] stray from the straight line between its ends, at most, over its length. */
+    private fun bend(touch: HumanMotion.Touch): Double {
+        val a = touch.start
+        val b = touch.end
+        val chord = hypot((b.x - a.x).toDouble(), (b.y - a.y).toDouble())
+        if (chord < 1) return 0.0
+        return touch.points.maxOf { p ->
+            abs((b.x - a.x).toDouble() * (a.y - p.y) - (a.x - p.x).toDouble() * (b.y - a.y)) / chord
+        } / chord
+    }
+
+    @Test
+    fun `swipes curve gently and stay on the screen, off the edges where android's gestures start`() {
+        val m = motion()
+        repeat(600) { i ->
+            val shape = HisApps.Shape.entries[i % HisApps.Shape.entries.size]
+            val plan = m.scroll(area, down = i % 3 != 0, shape = shape, energy = Energy.entries[i % Energy.entries.size], bit = i % 7 == 0)
+            for (touch in plan.touches) {
+                for (p in touch.points) {
+                    assertTrue("x $p", p.x >= area.width * HumanMotion.EDGE - 1 && p.x <= area.width * (1 - HumanMotion.EDGE) + 1)
+                    assertTrue("y $p", p.y >= area.height * HumanMotion.TOP - 1 && p.y <= area.height * HumanMotion.BOTTOM + 1)
+                }
+                // One stroke from finger down to finger up: each part starts where the last one ended.
+                touch.parts.zipWithNext { a, b -> assertEquals(a.points.last(), b.points.first()) }
+                assertTrue(touch.parts.all { it.durationMillis >= HumanMotion.MIN_PART_MILLIS && it.points.size >= 2 })
+            }
+            val swipe = main(plan)
+            // Not a ruler line, and not a wild arc either.
+            val bent = bend(swipe)
+            assertTrue("bend $bent", bent > 0.01 && bent < 0.2)
+        }
+    }
+
+    @Test
+    fun `a swipe speeds up and slows down, and a flick is let go while it still moves`() {
+        val m = motion(11)
+        repeat(200) {
+            val flick = main(m.scroll(area, down = true, shape = HisApps.Shape.PAGER, energy = Energy.EASY))
+            val speeds = flick.parts.map { it.length / it.durationMillis }
+            // Ease in: the first stretch is slower than the fastest.
+            assertTrue(speeds.first() < speeds.max() * 0.5)
+            // Let go moving: the last stretch still runs at a good share of the fastest.
+            assertTrue(speeds.last() > speeds.max() * 0.2)
+            val drag = main(m.scroll(area, down = true, shape = HisApps.Shape.FEED, energy = Energy.EASY, bit = true))
+            val moving = drag.parts.dropLast(1).map { it.length / it.durationMillis }
+            // A slow drag eases out to rest, and rests a moment before the finger lifts.
+            assertTrue(moving.first() < moving.max() * 0.5)
+            assertTrue(moving.last() < moving.max() * 0.5)
+            assertTrue(drag.parts.last().length < 1.0)
+        }
+    }
+
+    @Test
+    fun `durations are a person's - flicks, drags and presses in human ranges`() {
+        val m = motion(3)
+        repeat(500) { i ->
+            val energy = Energy.entries[i % Energy.entries.size]
+            val flick = main(m.scroll(area, down = true, shape = HisApps.Shape.PAGER, energy = energy))
+            val moving = flick.durationMillis
+            // Each of its parts is a whole number of milliseconds: the sum may be a few off its bounds.
+            assertTrue("flick $moving", moving in HumanMotion.FLICK_MILLIS.first - 10..HumanMotion.FLICK_MILLIS.last + 10)
+            val drag = main(m.scroll(area, down = false, shape = HisApps.Shape.FEED, energy = energy, bit = true))
+            assertTrue("drag ${drag.durationMillis}", drag.durationMillis in HumanMotion.DRAG_MILLIS.first..HumanMotion.DRAG_MILLIS.last + 200)
+            val press = m.press(area, Box(400, 1000, 680, 1120), energy)!!
+            assertTrue("press ${press.durationMillis}", press.durationMillis in HumanMotion.PRESS_MILLIS)
+        }
+    }
+
+    @Test
+    fun `no two swipes in a row are the same`() {
+        val m = motion(5)
+        var last: HumanMotion.Touch? = null
+        repeat(300) {
+            val swipe = main(m.scroll(area, down = true, shape = HisApps.Shape.FEED, energy = Energy.SHARP))
+            last?.let { before ->
+                assertNotEquals(before.start, swipe.start)
+                assertNotEquals(before.end, swipe.end)
+            }
+            last = swipe
+        }
+    }
+
+    @Test
+    fun `the slips are rare - an overshoot and a short one back, a short scroll, a hesitation - and never wacky`() {
+        val m = motion(19)
+        val n = 3_000
+        val plans = (1..n).map { m.scroll(area, down = true, shape = HisApps.Shape.FEED, energy = Energy.EASY) }
+        val overshoots = plans.count { Quirk.OVERSHOT in it.quirks }
+        val shorts = plans.count { Quirk.SHORT in it.quirks }
+        val hesitations = plans.count { Quirk.HESITATED in it.quirks }
+        assertTrue("overshoots $overshoots", overshoots in (n * 0.025).toInt()..(n * 0.09).toInt())
+        assertTrue("shorts $shorts", shorts in (n * 0.02).toInt()..(n * 0.08).toInt())
+        assertTrue("hesitations $hesitations", hesitations in (n * 0.035).toInt()..(n * 0.11).toInt())
+        // An overshoot is the scroll, a beat, and a short slow drag back the other way.
+        val over = plans.first { Quirk.OVERSHOT in it.quirks }
+        val (forth, back) = over.touches.takeLast(2)
+        assertTrue(forth.end.y < forth.start.y && back.end.y > back.start.y)
+        assertTrue(abs(back.end.y - back.start.y) < abs(forth.end.y - forth.start.y) * 0.6)
+        // Never two slips piled on one scroll, and never more than three touches.
+        assertTrue(plans.none { it.touches.size > 3 })
+        assertTrue(plans.none { Quirk.OVERSHOT in it.quirks && Quirk.SHORT in it.quirks })
+        // A pager turns a page or springs back: it never overshoots.
+        val pager = (1..1_000).map { m.scroll(area, down = true, shape = HisApps.Shape.PAGER, energy = Energy.HYPED) }
+        assertEquals(0, pager.count { Quirk.OVERSHOT in it.quirks })
+        // Its main swipe is long enough to turn the page.
+        assertTrue(pager.all { abs(main(it).end.y - main(it).start.y) > area.height * 0.25 })
+        // A short one on a pager springs back and is done again: a weak swipe, then a real one.
+        val sprung = pager.first { Quirk.SHORT in it.quirks }
+        assertEquals(2, sprung.touches.size)
+        assertTrue(abs(sprung.touches[0].end.y - sprung.touches[0].start.y) < abs(sprung.touches[1].end.y - sprung.touches[1].start.y))
+    }
+
+    @Test
+    fun `her energy moves the pace - quicker and choppier when hyped, slower and lazier when groggy`() {
+        fun meanFlick(energy: Energy) = motion(23).let { m -> (1..400).map { main(m.scroll(area, true, HisApps.Shape.PAGER, energy)).durationMillis }.average() }
+        fun meanWait(energy: Energy) = motion(29).let { m -> (1..400).map { m.scroll(area, true, HisApps.Shape.FEED, energy).waitMillis }.average() }
+        fun meanBeat(energy: Energy) = motion(31).let { m -> (1..400).map { m.beat(energy) }.average() }
+        assertTrue(meanFlick(Energy.HYPED) < meanFlick(Energy.EASY))
+        assertTrue(meanFlick(Energy.EASY) < meanFlick(Energy.GROGGY))
+        assertTrue(meanFlick(Energy.SHARP) < meanFlick(Energy.LAZY))
+        assertTrue(meanWait(Energy.HYPED) < meanWait(Energy.EASY))
+        assertTrue(meanWait(Energy.EASY) < meanWait(Energy.GROGGY))
+        assertTrue(meanBeat(Energy.HYPED) < meanBeat(Energy.LAZY))
+        // Choppier when hyped: her swipes start in a wider spread.
+        fun spread(energy: Energy): Double {
+            val m = motion(37)
+            val xs = (1..400).map { main(m.scroll(area, true, HisApps.Shape.FEED, energy)).start.x.toDouble() }
+            val mean = xs.average()
+            return xs.map { (it - mean) * (it - mean) }.average()
+        }
+        assertTrue(spread(Energy.HYPED) > spread(Energy.SHARP))
+    }
+
+    @Test
+    fun `a tap lands a little off the centre and a touch low, always on its target, held about a tenth of a second`() {
+        val m = motion(41)
+        val target = Box(400, 1000, 680, 1120)
+        val presses = (1..1_000).map { m.press(area, target, Energy.EASY)!! }
+        for (press in presses) {
+            for (p in press.points) {
+                assertTrue(p.x >= target.left + target.width * HumanMotion.TAP_INSET - 3 && p.x <= target.right - target.width * HumanMotion.TAP_INSET + 3)
+                assertTrue(p.y >= target.top + target.height * HumanMotion.TAP_INSET - 3 && p.y <= target.bottom - target.height * HumanMotion.TAP_INSET + 3)
+            }
+            // The finger rolls a hair, far under the distance that would make it a drag.
+            assertTrue(press.length < 3.0)
+        }
+        val dx = presses.map { it.start.x - target.centerX }
+        val dy = presses.map { it.start.y - target.centerY }
+        // Not dead on the centre, and not far from it.
+        assertTrue(presses.map { it.start }.distinct().size > 900)
+        assertTrue(dx.map { abs(it) }.average() > 4 && dx.map { abs(it) }.average() < target.width * 0.2)
+        // A touch low: the pad of the finger lands below where her eye and her nail are.
+        assertTrue(dy.average() > 0 && dy.average() < target.height * 0.15)
+        val held = presses.map { it.durationMillis }.average()
+        assertTrue("held $held", held in 70.0..110.0)
+        // A tap is a beat, then the press.
+        val tap = m.tap(area, target, Energy.EASY)!!
+        assertTrue(tap.moves.first() is HumanMotion.Move.Wait)
+        assertEquals(1, tap.touches.size)
+        // The lead of a tap is its waits only: the screen is read again before the press.
+        val lead = m.lead(Energy.EASY)
+        assertTrue(lead.moves.isNotEmpty() && lead.moves.all { it is HumanMotion.Move.Wait })
+    }
+
+    /** A phone of 1080 by 2520 pixels at 2.625 pixels a dp, like the Flip 7's inner screen. */
+    private val phone = HumanMotion.Area(1080, 2520, density = 2.625f)
+    private fun dp(v: Double) = v * 2.625
+
+    @Test
+    fun `a tap's offset is a finger's few dp, the same on a whole post as on a button`() {
+        val m = motion(53)
+        val card = Box(0, 400, 1080, 1720)
+        for (energy in Energy.entries) {
+            val presses = (1..600).map { m.press(phone, card, energy)!! }
+            val off = presses.map { hypot((it.start.x - card.centerX).toDouble(), (it.start.y - card.centerY).toDouble()) }
+            // Never more than about 18 dp from the middle of a card 500 dp tall (2.5 spreads of at most 4.7 dp each way, and the lean).
+            assertTrue("$energy max ${off.max()}", off.max() < dp(19.0))
+            // And not dead on it.
+            assertTrue("$energy mean ${off.average()}", off.average() > dp(1.5))
+        }
+        // A spread of at most about 4 to 6 dp, groggy the widest.
+        val groggy = (1..2_000).map { m.press(phone, card, Energy.GROGGY)!!.start.x - card.centerX }
+        val sd = kotlin.math.sqrt(groggy.map { (it - groggy.average()) * (it - groggy.average()) }.average())
+        assertTrue("sd $sd", sd > dp(3.5) && sd < dp(6.0))
+    }
+
+    @Test
+    fun `a press on a post never lands on its like row, its avatar or its follow pill`() {
+        // An X post row, 124 dp tall, clickable as a whole: avatar on the left, the action row along its bottom third.
+        val row = Box(0, 600, 1080, 600 + dp(124.0).toInt())
+        val avatar = Box(dp(12.0).toInt(), 620, dp(56.0).toInt(), 620 + dp(44.0).toInt())
+        val actionTop = row.bottom - dp(40.0).toInt()
+        val actions = listOf(0.15, 0.31, 0.47, 0.63, 0.79).map { x ->
+            Box((x * 1080).toInt(), actionTop, (x * 1080 + 140).toInt(), row.bottom - 4)
+        }
+        val like = actions[2]
+        for (seed in 1L..40L) {
+            val m = motion(seed)
+            for (energy in Energy.entries) {
+                repeat(50) {
+                    val press = m.press(phone, row, energy, keepOff = actions + avatar)!!
+                    for (p in press.points) {
+                        for (box in actions + avatar) {
+                            assertFalse("on $box at $p", box.contains(p.x.toDouble(), p.y.toDouble()))
+                        }
+                    }
+                }
+            }
+        }
+        // Even with the middle of the row taken by a control, the free spot nearest it is pressed, never the like.
+        val middle = Box(200, row.top + 20, 880, row.bottom - 20)
+        repeat(200) {
+            val press = motion(it.toLong()).press(phone, row, Energy.HYPED, keepOff = listOf(middle, like))!!
+            assertFalse(middle.contains(press.start.x.toDouble(), press.start.y.toDouble()))
+            assertFalse(like.contains(press.start.x.toDouble(), press.start.y.toDouble()))
+            assertTrue(row.contains(press.start.x.toDouble(), press.start.y.toDouble()))
+        }
+        // A Reel, the whole screen: the Follow pill by the author's name near the bottom is never pressed.
+        val reel = Box(0, 0, 1080, 2520)
+        val follow = Box(300, 2050, 520, 2130)
+        for (seed in 1L..20L) {
+            val m = motion(seed)
+            repeat(200) {
+                val p = m.press(phone, reel, Energy.GROGGY, keepOff = listOf(follow))!!.start
+                assertFalse(follow.contains(p.x.toDouble(), p.y.toDouble()))
+            }
+        }
+    }
+
+    @Test
+    fun `a target with no free spot is not pressed at all`() {
+        val button = Box(400, 1000, 520, 1120)
+        // A like button over all of it.
+        assertNull(motion().press(phone, button, Energy.EASY, keepOff = listOf(Box(380, 980, 540, 1140))))
+        assertNull(motion().tap(phone, button, Energy.EASY, keepOff = listOf(Box(380, 980, 540, 1140))))
+        // A box beside it does not count.
+        assertTrue(motion().press(phone, button, Energy.EASY, keepOff = listOf(Box(700, 1000, 800, 1120))) != null)
+    }
+
+    @Test
+    fun `pauses scale with what is on the screen and with what holds her`() {
+        val m = motion(43)
+        val short = (1..200).map { m.reading(40, 0.0, Energy.EASY) }.average()
+        val long = (1..200).map { m.reading(150, 0.0, Energy.EASY) }.average()
+        val japanese = (1..200).map { m.reading(150, 1.0, Energy.EASY) }.average()
+        assertTrue(short < long)
+        // Japanese is read character by character more slowly than English is skimmed.
+        assertTrue(long < japanese)
+        assertTrue((1..200).all { m.reading(100_000, 1.0, Energy.GROGGY) <= HumanMotion.READ_MILLIS.last })
+        assertTrue((1..200).all { m.reading(0, 0.0, Energy.HYPED) >= HumanMotion.READ_MILLIS.first })
+        // She stays about as long as she said, as a person keeps time.
+        repeat(200) { assertTrue(m.watch(20, Energy.EASY) in 18_000L..22_500L) }
+        assertTrue(m.watch(500, Energy.EASY) <= HumanMotion.WATCH_MILLIS.last)
+        repeat(100) { assertTrue(m.typing(12, Energy.EASY) in 1_500L..3_500L) }
+    }
+
+    @Test
+    fun `the same seed moves the same way, so a test can hold her to it`() {
+        val a = motion(99).scroll(area, true, HisApps.Shape.FEED, Energy.EASY)
+        val b = motion(99).scroll(area, true, HisApps.Shape.FEED, Energy.EASY)
+        assertEquals(a, b)
+    }
+
+    @Test
+    fun `her clock in Tokyo sets her energy as her files have a night move her, and her pace word nudges it`() {
+        val table = listOf(
+            16 to 30 to Energy.GROGGY, 18 to 0 to Energy.EASY, 21 to 0 to Energy.EASY, 23 to 0 to Energy.SHARP,
+            0 to 30 to Energy.SHARP, 2 to 0 to Energy.HYPED, 4 to 30 to Energy.LAZY, 6 to 0 to Energy.GROGGY, 12 to 0 to Energy.GROGGY
+        )
+        for ((time, energy) in table) assertEquals("${time.first}:${time.second}", energy, Energy.ofTokyo(time.first, time.second))
+        // 2 am in Tokyo is 17:00 UTC the day before.
+        assertEquals(Energy.HYPED, Energy.at(java.time.Instant.parse("2026-11-20T17:00:00Z").toEpochMilli()))
+        assertEquals(Energy.HYPED, Energy.SHARP.nudged(PhoneVerb.Pace.QUICK))
+        assertEquals(Energy.HYPED, Energy.HYPED.nudged(PhoneVerb.Pace.QUICK))
+        assertEquals(Energy.LAZY, Energy.EASY.nudged(PhoneVerb.Pace.SLOW))
+        assertEquals(Energy.GROGGY, Energy.GROGGY.nudged(PhoneVerb.Pace.SLOW))
+        assertEquals(Energy.EASY, Energy.EASY.nudged(null))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/phone/LendWatchTest.kt b/app/src/test/java/com/opendroid/ai/core/life/phone/LendWatchTest.kt
