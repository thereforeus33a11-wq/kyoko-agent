+    private fun plan(
+        wish: Wish?,
+        given: Boolean = wish != null,
+        lastGap: Long = 0,
+        moments: List<Long> = listOf(now),
+        bounds: Bounds = this.bounds,
+        zone: TimeZone = utc
+    ) = PersonaOwnTime.plan(wish, given, now, zone, lastGap, moments, bounds)
+
+    @Test
+    fun `a span she names is the time she is woken, and the gap she chose is remembered`() {
+        val planned = plan(Wish.After(3 * hour))
+        assertEquals(Wake.At(now + 3 * hour), planned.wake)
+        assertEquals(Why.ASKED, planned.why)
+        assertEquals(3 * hour, planned.chosenGapMillis)
+        assertNull(planned.moved)
+    }
+
+    @Test
+    fun `a wish sooner than the least gap is raised to it, and one further than seven days is brought back`() {
+        val soon = plan(Wish.After(2 * minute))
+        assertEquals(Wake.At(now + 15 * minute), soon.wake)
+        assertEquals(Moved.TOO_SOON, soon.moved)
+        assertEquals(15 * minute, soon.chosenGapMillis)
+        // Exactly the least gap is not moved.
+        assertNull(plan(Wish.After(15 * minute)).moved)
+
+        val far = plan(Wish.After(30 * day))
+        assertEquals(Wake.At(now + 7 * day), far.wake)
+        assertEquals(Moved.TOO_FAR, far.moved)
+        assertEquals(7 * day, PersonaOwnTime.MAX_WISH_MILLIS)
+        assertNull(plan(Wish.After(7 * day)).moved)
+
+        // The owner's own number, whatever it is.
+        val wide = Bounds(minGapMillis = 2 * hour, maxPerDay = 24)
+        assertEquals(Wake.At(now + 2 * hour), plan(Wish.After(20 * minute), bounds = wide).wake)
+    }
+
+    @Test
+    fun `a clock time is the next time his clock shows it, also across midnight and in his zone`() {
+        // 22:10 now: 02:30 is tomorrow, 23:00 is today.
+        assertEquals(Wake.At(now + 4 * hour + 20 * minute), plan(Wish.At(2, 30)).wake)
+        assertEquals(Wake.At(now + 50 * minute), plan(Wish.At(23, 0)).wake)
+        // The time it is now means the same time tomorrow, not this instant.
+        assertEquals(Wake.At(now + day), plan(Wish.At(22, 10)).wake)
+        // A clock time closer than the least gap is raised to it, not pushed a whole day.
+        val close = plan(Wish.At(22, 15))
+        assertEquals(Wake.At(now + 15 * minute), close.wake)
+        assertEquals(Moved.TOO_SOON, close.moved)
+        // His clock, not the phone's UTC: in Tokyo it is 07:10 on Wednesday.
+        val tokyo = TimeZone.getTimeZone("Asia/Tokyo")
+        assertEquals(Wake.At(now + 50 * minute), plan(Wish.At(8, 0), zone = tokyo).wake)
+        assertEquals(now + 50 * minute, PersonaOwnTime.nextClockTime(now, tokyo, 8, 0))
+        // The gap of a clock time is remembered like any other.
+        assertEquals(50 * minute, plan(Wish.At(23, 0)).chosenGapMillis)
+    }
