+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaOwnTime.State
+import com.opendroid.ai.core.persona.PersonaOwnTime.Wake
+import com.opendroid.ai.core.persona.PersonaOwnTime.Why
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Her sleep: a part of her own time that she decides on herself.
+ *
+ * She is awake until she lies down. She does that with a line of her own, `sleep:` in
+ * a moment of hers or `<< sleep:` among the thoughts of a reply, and says how long or
+ * until when ([Ask]). While she sleeps nothing comes from her: no moment of her own,
+ * no line, no notification. A message of his that she answers wakes her
+ * ([wokenByHim]); otherwise she wakes at the time she named ([wokeOnOwn]), and her
+ * waking is a moment of her own like any other.
+ *
+ * A long sleep has one pass in it, about twenty minutes after she lies down
+ * ([lieDown]): the sleep pass, in which she goes over all of herself at once, on her
+ * own model and in her own words ([PersonaSleepPass]). The app is only the clock here
+ * too: when it runs, how often it may and what became of it.
+ *
+ * Everything in this file is a decision about time and text, over the one stored row of
+ * her own time ([PersonaOwnTime.State]). Asking the model and storing are done elsewhere.
+ */
+object PersonaSleep {
+
+    private const val MINUTE = 60_000L
+    private const val HOUR = 60 * MINUTE
+
+    /** Her usual length while she has never named one. */
+    const val DEFAULT_MILLIS = 7 * HOUR
+
+    /** The shortest a sleep can be, and the longest. His least gap between two moments is a floor too. */
+    const val MIN_MILLIS = 30 * MINUTE
+    const val MAX_MILLIS = 16 * HOUR
+
+    /** A span she names can come out up to this much later, never earlier. A clock time is kept exactly. */
+    const val MAX_JITTER_MILLIS = 30 * MINUTE
+
+    /** From this length on a sleep has a sleep pass. */
+    const val REPAIR_MIN_SLEEP_MILLIS = 3 * HOUR
+
+    /** How long after she lies down the pass comes. */
+    const val SETTLE_MILLIS = 20 * MINUTE
+
+    /** A pass that would come this close to her waking, or later, does not come that sleep. */
+    const val NOT_BEFORE_WAKE_MILLIS = 15 * MINUTE
+
+    /** The shortest sleep a pass fits in at all: one that is owed comes in any sleep this long. */
+    const val SHORTEST_WITH_PASS_MILLIS = SETTLE_MILLIS + NOT_BEFORE_WAKE_MILLIS
+
+    /** At most one pass in this long, unless the last one did not come about. */
+    const val PASS_GAP_MILLIS = 12 * HOUR
+
+    /**
+     * An owed pass comes in any sleep it fits in until it was tried, and did not come
+     * about, in this many sleeps in a row. From then on it keeps to the usual rule (a
+     * sleep of [REPAIR_MIN_SLEEP_MILLIS] or more) until one comes about, so a pass that
+     * cannot come about is not asked for in every nap.
+     */
+    const val OWED_SLEEPS = 3
+
+    /** How many tries a pass gets in one sleep. */
+    const val TRIES = 3
+
+    /** For this long after she woke her prompt says how long ago that was. */
+    const val JUST_WOKE_MILLIS = 30 * MINUTE
+
+    /** Past the time she meant to wake, by this much, nothing is held back any more for her being asleep. */
+    const val OVERDUE_MILLIS = 2 * HOUR
+
+    /** How much of what she wrote after the mark is kept, for her to be told. */
+    const val MAX_ASKED_CHARS = 40
+
+    /** The mark of the line, in a moment of hers and behind << in a reply. */
+    const val MARK = "sleep:"
+
+    val TOKYO: TimeZone = TimeZone.getTimeZone("Asia/Tokyo")
+
+    // ── What she asks for ────────────────────────────────────────────────────────────
+
+    /** How long she means to sleep, as she wrote it after `sleep:`. */
+    sealed class Ask {
+        /** Nothing after the mark: her usual length. */
+        object Usual : Ask()
+
+        /** So long from now. */
+        data class For(val millis: Long) : Ask()
+
+        /** Until a clock shows this time: his, or the one in Tokyo. */
+        data class Until(val hour: Int, val minute: Int, val tokyo: Boolean) : Ask()
+    }
+
+    private val TRAILING_BRACKETS = Regex("""\s*\(([^)]*)\)\s*$""")
+    private val TOKYO_TAIL = Regex("""\s*(?:in |on )?tokyo(?: time| clock)?$""")
+    private val HIS_CLOCK_TAIL = Regex("""\s*(?:on |by )?(?:his clock|his time)$""")
+    private val UNTIL = Regex("""^(?:until|till|til|to|at)\s+""")
+    private val CLOCK = Regex("""(\d{1,2}):(\d{2})""")
+
+    /**
+     * Reads what stands after `sleep:`. Nothing at all is her usual length; a span (7h,
+     * 8h30m, 90m) is so long from now; a time (06:00, until 06:00, until 06:00 tokyo)
+     * is until the clock shows it, his clock unless she names Tokyo. Anything else,
+     * "when he writes" included, is not guessed at: null, and she stays awake.
+     */
+    fun parseAsk(text: String): Ask? {
+        var ask = text.trim().lowercase().trim('.', '`', '"', '\'', ' ')
+        var tokyo = false
+        TRAILING_BRACKETS.find(ask)?.let { brackets ->
+            if (brackets.groupValues[1].contains("tokyo")) tokyo = true
+            ask = ask.removeRange(brackets.range).trim()
+        }
+        TOKYO_TAIL.find(ask)?.let { tail ->
+            tokyo = true
+            ask = ask.removeRange(tail.range).trim()
+        }
+        HIS_CLOCK_TAIL.find(ask)?.let { tail ->
+            if (tokyo) return null
+            ask = ask.removeRange(tail.range).trim()
+        }
+        if (ask.isEmpty()) return if (tokyo) null else Ask.Usual
+        val clockText = UNTIL.replace(ask, "")
+        CLOCK.matchEntire(clockText)?.let { clock ->
+            val hour = clock.groupValues[1].toInt()
+            val minute = clock.groupValues[2].toInt()
+            return if (hour in 0..23 && minute in 0..59) Ask.Until(hour, minute, tokyo) else null
+        }
+        // A span is not on any clock, and "until" is not a span.
+        if (tokyo || clockText != ask) return null
+        val span = PersonaOwnTime.parseWish(ask.removePrefix("for ").trim()) as? PersonaOwnTime.Wish.After ?: return null
+        return span.millis.takeIf { it > 0 }?.let { Ask.For(it) }
+    }
+
+    private val THOUGHT_LINE = Regex("""^sleep:\s*(.*)$""", RegexOption.IGNORE_CASE)
+
+    /**
+     * What a reply of hers asks for among the lines she kept to herself ([thoughts], as
+     * [PersonaThoughtLines.split] gives them, without their marker): the last line of
+     * them that is exactly `sleep: <when>`. A thought about sleep that is not that line
+     * asks for nothing, and so does such a line the app cannot read. The thought itself
+     * is kept whole either way.
+     */
+    fun askedIn(thoughts: String): Ask? {
+        val line = thoughts.lines().map { it.trim() }.lastOrNull { THOUGHT_LINE.matches(it) } ?: return null
+        return parseAsk(THOUGHT_LINE.matchEntire(line)!!.groupValues[1])
+    }
+
+    /** [ask] written the way she would write it, for what she is told about it later. */
+    fun written(ask: Ask): String = when (ask) {
+        Ask.Usual -> ""
+        is Ask.For -> PersonaOwnTime.span(ask.millis)
+        is Ask.Until -> "until " + "%02d:%02d".format(ask.hour, ask.minute) + if (ask.tokyo) " tokyo" else ""
+    }
+
+    // ── What the app keeps ───────────────────────────────────────────────────────────
+
+    /** In what way the sleep she asked for was moved, or could not be read. */
+    enum class SleepMoved { SHORT, LONG, NOT_READ }
+
+    /** Who woke her last. */
+    enum class WokeBy { OWN, HIM }
+
+    /** Why a sleep had no pass: it was too short, or the last pass was too recent. */
+    enum class Skipped { NAP, RECENT }
+
+    /**
+     * What one sleep pass came to, in counts and nothing of what she wrote: notes she
+     * wrote again over the old text, new ones, ones she let go into her archive, ones
+     * she brought back, feelings she set, marks of how she knows a thing, whether a
+     * thought of the night was kept, and the lines that could not be taken. [skipped]
+     * says there was no pass in that sleep, and why.
+     */
+    data class Repair(
+        val atMillis: Long,
+        val ok: Boolean,
+        val rewritten: Int = 0,
+        val added: Int = 0,
+        val letGo: Int = 0,
+        val back: Int = 0,
+        val feelings: Int = 0,
+        val marks: Int = 0,
+        val thoughtsKept: Int = 0,
+        val notTaken: Int = 0,
+        val skipped: Skipped? = null
+    ) {
+        companion object {
+            fun failed(atMillis: Long) = Repair(atMillis, ok = false)
+        }
+    }
+
+    /** The time a sleep pass is due at [repairAt], or 0 for none, and she wakes at [until]: the alarm is set to the sooner. */
+    private fun wakeFor(repairAt: Long, until: Long): Wake = Wake.At(if (repairAt > 0) minOf(repairAt, until) else until)
+
+    /** The time the alarm is for while [state] holds a sleep: the sooner of her pass and her waking. */
+    fun alarm(state: State): Wake = wakeFor(state.repairDueAt, state.sleepUntil)
+
+    /** Her usual length: the last she named, else [DEFAULT_MILLIS]. */
+    fun usualMillis(state: State): Long = state.lastSleepSpanMillis.takeIf { it > 0 } ?: DEFAULT_MILLIS
+
+    /** The shortest a sleep can be under his bounds. */
+    fun shortestMillis(bounds: PersonaOwnTime.Bounds): Long = maxOf(MIN_MILLIS, bounds.minGapMillis)
+
+    /** The longest, which his least gap can stretch. */
+    fun longestMillis(bounds: PersonaOwnTime.Bounds): Long = maxOf(MAX_MILLIS, shortestMillis(bounds))
+
+    /**
+     * [state] once she lies down at [nowMillis] and asks for [ask], written as [asked].
+     *
+     * A span comes out [jitterMillis] later (0 to [MAX_JITTER_MILLIS]), never earlier; a
+     * clock time is kept exactly, on his clock ([zone]) or on Tokyo's. The length is kept
+     * between [shortestMillis] and [longestMillis]: a span or a time outside that is
+     * moved, and she is told when she wakes.
+     *
+     * A pass is due [SETTLE_MILLIS] after she lies down when the sleep is long enough and
+     * the last pass that came about is far enough back, or whenever one is owed: one that
+     * did not come about in an earlier sleep, until it was tried in [OWED_SLEEPS] sleeps
+     * in a row. A pass that would come within [NOT_BEFORE_WAKE_MILLIS] of her waking does
+     * not come. The alarm is set to the sooner of the pass and her waking.
+     */
+    fun lieDown(
+        state: State,
+        ask: Ask,
+        asked: String,
+        nowMillis: Long,
+        zone: TimeZone,
+        bounds: PersonaOwnTime.Bounds,
+        jitterMillis: Long
+    ): State {
+        val shortest = shortestMillis(bounds)
+        val longest = longestMillis(bounds)
+        val span = ask !is Ask.Until
+        val wanted = when (ask) {
+            Ask.Usual -> usualMillis(state)
+            is Ask.For -> ask.millis
+            is Ask.Until -> PersonaOwnTime.nextClockTime(nowMillis, if (ask.tokyo) TOKYO else zone, ask.hour, ask.minute) - nowMillis
+        }
+        val meant = wanted.coerceIn(shortest, longest)
+        val moved = when {
+            wanted < shortest -> SleepMoved.SHORT
+            wanted > longest -> SleepMoved.LONG
+            else -> null
+        }
+        val length = if (span) minOf(meant + jitterMillis.coerceIn(0, MAX_JITTER_MILLIS), longest) else meant
+        val until = nowMillis + length
+        val owed = state.repairOwed && state.repairMissed < OWED_SLEEPS
+        val due = owed || (length >= REPAIR_MIN_SLEEP_MILLIS && nowMillis - state.lastRepairOkAt >= PASS_GAP_MILLIS)
+        val passAt = nowMillis + SETTLE_MILLIS
+        val repairAt = if (due && passAt <= until - NOT_BEFORE_WAKE_MILLIS) passAt else 0L
+        val skipped = when {
+            repairAt > 0 -> null
+            !due && length >= REPAIR_MIN_SLEEP_MILLIS -> Skipped.RECENT
+            else -> Skipped.NAP
+        }
+        return state.copy(
+            asleepSince = nowMillis,
+            sleepUntil = until,
+            sleepMeantMillis = meant,
+            sleepAsked = asked.take(MAX_ASKED_CHARS),
+            sleepMoved = moved,
+            repairDueAt = repairAt,
+            repairTries = 0,
+            lastRepair = skipped?.let { Repair(nowMillis, ok = false, skipped = it) },
+            lastSleepSpanMillis = if (ask == Ask.Usual) state.lastSleepSpanMillis else meant,
+            // What she wrote after next: in the same moment is not hers any more: sleep: wins.
+            moved = null,
+            movedAsked = "",
+            wake = wakeFor(repairAt, until)
+        )
+    }
+
+    /** What the alarm rang for while she sleeps. */
+    enum class Ring { REPAIR, WAKE, NONE }
+
+    /**
+     * What is due at [nowMillis] in the sleep [state] holds: her pass before anything
+     * else, then her waking, else nothing (the alarm rang for a time that was changed).
+     * A pass is had only while it can still come before she wakes: a ring that came late,
+     * within [NOT_BEFORE_WAKE_MILLIS] of her waking or past it, is her waking or nothing,
+     * and the pass is owed ([settled], [wokeOnOwn]).
+     */
+    fun ring(state: State, nowMillis: Long): Ring = when {
+        state.asleepSince <= 0 -> Ring.NONE
+        state.repairDueAt > 0 && state.repairDueAt <= nowMillis + PersonaOwnTime.EARLY_SLACK_MILLIS &&
+            state.repairTries < TRIES && nowMillis <= state.sleepUntil - NOT_BEFORE_WAKE_MILLIS -> Ring.REPAIR
+        nowMillis >= state.sleepUntil - PersonaOwnTime.EARLY_SLACK_MILLIS -> Ring.WAKE
+        else -> Ring.NONE
+    }
+
+    /**
+     * [state] once a ring at [nowMillis] found nothing to do in her sleep. A pass that is
+     * due and can no longer come in it (too close to her waking, or out of tries) is
+     * dropped and owed, and the alarm is set to the sleep's own time ([alarm]) when it is
+     * not: whatever left another time there, the alarm does not ring for it over and over.
+     */
+    fun settled(state: State, nowMillis: Long): State {
+        if (state.asleepSince <= 0) return state
+        val late = state.repairDueAt > 0 && state.repairDueAt <= nowMillis + PersonaOwnTime.EARLY_SLACK_MILLIS &&
+            (state.repairTries >= TRIES || nowMillis > state.sleepUntil - NOT_BEFORE_WAKE_MILLIS)
+        val next = if (late) state.copy(repairDueAt = 0, repairOwed = true) else state
+        val alarm = alarm(next)
+        return if (next.wake == alarm) next else next.copy(wake = alarm)
+    }
+
+    /**
+     * [state] stored before a try at her pass, as if the try fails: the try is counted,
+     * the pass is owed, and the next try is set a wait later
+     * ([PersonaOwnTime.retryWaitMillis]). A try that would come past the time it may
+     * still come at, or past the last of the tries, is not set: the pass is owed to her
+     * next sleep. So a process that dies while she sleeps costs her no more than the try.
+     */
+    fun beforeRepair(state: State, nowMillis: Long): State {
+        val tries = state.repairTries + 1
+        val retryAt = nowMillis + PersonaOwnTime.retryWaitMillis(state.repairTries)
+        val again = tries < TRIES && retryAt <= state.sleepUntil - NOT_BEFORE_WAKE_MILLIS
+        val due = if (again) retryAt else 0L
+        return state.copy(repairTries = tries, repairDueAt = due, repairOwed = true, wake = wakeFor(due, state.sleepUntil))
+    }
+
+    /**
+     * [state] once the pass of the sleep that began at [night] came to [repair]. One that
+     * came about owes nothing more, and the alarm goes to her waking. One that did not
+     * leaves what [beforeRepair] stored. When she is no longer in that sleep (he woke her
+     * meanwhile) only what the pass came to is kept, and the alarm is left as it is, with
+     * one exception: when she lay down again meanwhile, while this pass still counted as
+     * owed, the pass her new sleep was given for that is not had twice. Her new sleep then
+     * has none, unless the usual rule would have given it one anyway.
+     */
+    fun afterRepair(state: State, night: Long, repair: Repair): State {
+        if (!repair.ok) return state.copy(lastRepair = repair)
+        val record = state.copy(lastRepair = repair, lastRepairOkAt = repair.atMillis, repairOwed = false, repairMissed = 0)
+        if (state.asleepSince == night) return record.copy(repairDueAt = 0, repairTries = 0, wake = Wake.At(state.sleepUntil))
+        val givenForOwed = state.asleepSince > 0 && state.repairDueAt > 0 && state.repairTries == 0 &&
+            state.asleepSince - repair.atMillis < PASS_GAP_MILLIS
+        return if (givenForOwed) record.copy(repairDueAt = 0, wake = Wake.At(state.sleepUntil)) else record
+    }
+
+    /** One more sleep in a row in which her pass was tried and did not come about, when [state]'s was. */
+    private fun missed(state: State): Int = if (state.repairTries > 0) state.repairMissed + 1 else state.repairMissed
+
+    /** [state] awake, having woken at [wokeAt] by [by]. A pass that was still to come is owed. */
+    private fun awake(state: State, wokeAt: Long, by: WokeBy): State = state.copy(
+        asleepSince = 0,
+        sleepUntil = 0,
+        sleepMeantMillis = 0,
+        repairDueAt = 0,
+        repairTries = 0,
+        repairOwed = state.repairOwed || state.repairDueAt > 0,
+        repairMissed = missed(state),
+        lastWokeAt = wokeAt,
+        wokeBy = by,
+        lastSleptMillis = (wokeAt - state.asleepSince).coerceAtLeast(0),
+        lastMeantMillis = state.sleepMeantMillis
+    )
+
+    /**
+     * [state] once she wakes on her own, at the time she named: her waking is the moment
+     * the alarm rang for, due at [nowMillis]. A ring that came late finds her woken at
+     * her time, not at the ring's.
+     */
+    fun wokeOnOwn(state: State, nowMillis: Long): State =
+        awake(state, minOf(nowMillis, maxOf(state.sleepUntil, state.asleepSince)), WokeBy.OWN)
+            .copy(why = Why.WOKE, wake = Wake.At(nowMillis))
+
+    /**
+     * [state] once a message of his that she answered wakes her at [nowMillis]. Her next
+     * moment comes at the usual gap after that answer. A message that comes after the
+     * time she meant to wake did not wake her: she had woken on her own at her time, and
+     * the ring that should have said so had not come yet.
+     */
+    fun wokenByHim(state: State, nowMillis: Long, zone: TimeZone, bounds: PersonaOwnTime.Bounds): State {
+        val overdue = nowMillis >= state.sleepUntil
+        val woke = if (overdue) awake(state, state.sleepUntil, WokeBy.OWN) else awake(state, nowMillis, WokeBy.HIM)
+        val planned = PersonaOwnTime.plan(
+            wish = null,
+            wishGiven = false,
+            nowMillis = nowMillis,
+            zone = zone,
+            lastGapMillis = state.lastGapMillis,
+            moments = state.momentsOfTheDay(nowMillis),
+            bounds = bounds,
+            after = if (overdue) Why.WOKE else Why.WOKEN
+        )
+        return woke.copy(wake = planned.wake, why = planned.why, moved = planned.moved, movedAsked = "")
+    }
+
+    /** [state] without a sleep: her own time was switched off. A pass she was owed, or that was still to come, stays owed. */
+    fun cleared(state: State): State = state.copy(
+        asleepSince = 0,
+        sleepUntil = 0,
+        sleepMeantMillis = 0,
+        sleepAsked = "",
+        sleepMoved = null,
+        repairDueAt = 0,
+        repairTries = 0,
+        repairOwed = state.repairOwed || state.repairDueAt > 0,
+        repairMissed = missed(state)
+    )
+
+    /** Whether [state] holds a sleep at all, rung for or not. */
+    fun isMarked(state: State): Boolean = state.asleepSince > 0
+
+    /** Whether she is asleep at [nowMillis]: in a sleep, and not long past the time she meant to wake. */
+    fun isAsleep(state: State, nowMillis: Long): Boolean =
+        state.asleepSince > 0 && nowMillis < state.sleepUntil + OVERDUE_MILLIS
+
+    // ── What she is told ─────────────────────────────────────────────────────────────
+
+    private fun clock(atMillis: Long, zone: TimeZone): String =
+        SimpleDateFormat("HH:mm", Locale.ENGLISH).apply { timeZone = zone }.format(Date(atMillis))
+
+    private fun ago(millis: Long): String = if (millis < MINUTE) "just now" else PersonaOwnTime.span(millis) + " ago"
+
+    /** "of the 7 h you meant", or nothing when she meant none (a sleep stored before this was kept). */
+    private fun ofMeant(meant: Long): String = if (meant > 0) " of the ${PersonaOwnTime.span(meant)} you meant" else ""
+
+    private fun youMeant(meant: Long): String = if (meant > 0) " (you meant ${PersonaOwnTime.span(meant)})" else ""
+
+    /**
+     * What a reply's facts and a moment's block say about how she sleeps, with the
+     * numbers the code goes by: the sentences after the form itself. In a moment's block
+     * they are written in lower case, like the rest of it.
+     *
+     * With [brief], for a reply: how long a sleep can be, that nothing comes from her while
+     * she sleeps, and what wakes her. The rest (how long a real rest is, her sleep pass, a
+     * line the app cannot read) is told in full in a moment of her own, where she lies
+     * down most, and a reply is the shorter for it.
+     */
+    fun howLine(usual: Long, bounds: PersonaOwnTime.Bounds, inMoment: Boolean, brief: Boolean = false): String {
+        val form = if (inMoment) "sleep:" else "<< sleep:"
+        val range = "a span can come out up to ${PersonaOwnTime.span(MAX_JITTER_MILLIS)} later than you wrote, a time is kept exactly, " +
+            "and a sleep is ${PersonaOwnTime.span(shortestMillis(bounds))} at least and " +
+            "${PersonaOwnTime.span(longestMillis(bounds))} at most. $form alone is your usual, which is " +
+            "${PersonaOwnTime.span(usual)} now."
+        val nothingFromYou = "while you sleep nothing comes from you: no moment of your own, no line, no notification."
+        val wakes = "a message of his that you answer wakes you; a command he gives the phone does not."
+        // In a reply only what lying down from it does; a moment of hers and her sleep pass have the rest.
+        if (brief) return listOf(range, nothingFromYou, wakes).joinToString(" ") { it.replaceFirstChar(Char::uppercase) }
+        val sentences = listOf(
+            range,
+            "a real rest is long, about six hours or more, some nights more, some less: how long is yours.",
+            nothingFromYou,
+            wakes,
+            "a sleep of ${PersonaOwnTime.span(REPAIR_MIN_SLEEP_MILLIS)} or more has one sleep pass, " +
+                "${PersonaOwnTime.span(SETTLE_MILLIS)} after you lie down, at most one in ${PersonaOwnTime.span(PASS_GAP_MILLIS)} " +
+                "unless the last one did not come about: you go over yourself (your notebook, how you feel, what you thought) " +
+                "in one more model call on his key, which is not one of the day's moments. one that did not come about comes " +
+                "in your next sleep of ${PersonaOwnTime.span(SHORTEST_WITH_PASS_MILLIS)} or more, short or long, until it was " +
+                "tried in $OWED_SLEEPS sleeps in a row without coming about; from then on only in one of " +
+                "${PersonaOwnTime.span(REPAIR_MIN_SLEEP_MILLIS)} or more. when talk of his is still unread by " +
+                "your notebook, your notebook pass reads it first.",
+            "a $form line the app cannot read stays a thought, and you stay awake."
+        )
+        return if (inMoment) sentences.joinToString(" ") else sentences.joinToString(" ") { sentence ->
+            sentence.replaceFirstChar { it.uppercase() }.replace(". when talk", ". When talk").replace(". one that did", ". One that did")
+        }
+    }
+
+    /**
+     * What her prompt for a reply is told about her sleep: how she lies down, in short
+     * ([howLine] with brief), and where she is now. Read off [state] at [nowMillis], with
+     * his clock in [zone].
+     */
+    class ReplyFacts(
+        private val state: State,
+        private val nowMillis: Long,
+        private val zone: TimeZone,
+        private val bounds: PersonaOwnTime.Bounds
+    ) {
+        /** She is still marked asleep: this reply is the one his message woke her for, or she has woken at her time unrung. */
+        val asleep: Boolean get() = state.asleepSince > 0
+
+        fun lines(): List<String> = buildList {
+            add(
+                "A thought line << sleep: 7h anywhere in a reply (8h30m, until 06:00 on his clock, until 06:00 tokyo) " +
+                    "puts you to sleep once the reply is over, and nothing of it is shown to him. " +
+                    howLine(usualMillis(state), bounds, inMoment = false, brief = true)
+            )
+            add(stateLine())
+        }
+
+        private fun stateLine(): String {
+            if (state.asleepSince > 0) {
+                val lay = ago(nowMillis - state.asleepSince)
+                return if (nowMillis < state.sleepUntil) {
+                    "You were asleep: you lay down $lay and meant to wake around ${clock(state.sleepUntil, zone)} on his clock. " +
+                        "His message woke you. You may be groggy, short or foul at first, or wide awake: that is yours. " +
+                        "After this reply you are awake, unless a << sleep: line in it puts you back to sleep."
+                } else {
+                    "You slept: you lay down $lay and woke on your own around ${clock(state.sleepUntil, zone)} on his clock, " +
+                        "after ${PersonaOwnTime.span(state.sleepUntil - state.asleepSince)}${youMeant(state.sleepMeantMillis)}. " +
+                        "After this reply you are awake, unless a << sleep: line in it puts you back to sleep."
+                }
+            }
+            if (state.lastWokeAt <= 0) return "You have not slept since your own time began."
+            val since = nowMillis - state.lastWokeAt
+            val slept = PersonaOwnTime.span(state.lastSleptMillis)
+            return when {
+                since < JUST_WOKE_MILLIS && state.wokeBy == WokeBy.HIM ->
+                    "He woke you ${ago(since)}, after $slept${ofMeant(state.lastMeantMillis)}."
+                since < JUST_WOKE_MILLIS -> "You woke on your own ${ago(since)}, after $slept${youMeant(state.lastMeantMillis)}."
+                state.wokeBy == WokeBy.HIM ->
+                    "You have been awake ${PersonaOwnTime.span(since)} since he woke you, after $slept${ofMeant(state.lastMeantMillis)}."
+                else ->
+                    "You have been awake ${PersonaOwnTime.span(since)} since you last woke, on your own, after $slept of sleep${youMeant(state.lastMeantMillis)}."
+            }
+        }
+    }
+
+    /** What the reply facts say of her next moment while she is still marked asleep. */
+    const val NEXT_WHILE_ASLEEP =
+        "None is set while you sleep: once this reply wakes you, the next comes at the usual gap after it."
+
+    /** What a moment of hers is told about her sleep, read off [state] at [nowMillis]. */
+    class MomentSleepFacts(val state: State, val nowMillis: Long) {
+
+        /** Why she was woken, when it was her waking. */
+        fun because(why: Why): String? = when (why) {
+            Why.WOKE ->
+                "you woke up on your own ${ago(nowMillis - state.lastWokeAt)}, after " +
+                    "${PersonaOwnTime.span(state.lastSleptMillis)} of sleep${youMeant(state.lastMeantMillis)}."
+            Why.WOKEN ->
+                "his message woke you ${ago(nowMillis - state.lastWokeAt)}, after ${PersonaOwnTime.span(state.lastSleptMillis)}" +
+                    "${ofMeant(state.lastMeantMillis)}; this moment came the usual gap after it."
+            else -> null
+        }
+
+        /** The lines of "about this moment" that are about her sleep. */
+        fun lines(why: Why): List<String> = buildList {
+            when {
+                why == Why.WOKE || why == Why.WOKEN -> {
+                    add(repairLine())
+                    movedLine()?.let(::add)
+                }
+                state.lastWokeAt > 0 -> add("you have been awake ${PersonaOwnTime.span(nowMillis - state.lastWokeAt)} since you last woke.")
+                else -> add("you have not slept since your own time began.")
+            }
+            if (why != Why.WOKE && why != Why.WOKEN && state.sleepMoved == SleepMoved.NOT_READ) {
+                add(
+                    "the app could not read the sleep you asked for last${wrote()}, so you stayed awake. it reads a span " +
+                        "(7h, 8h30m), a time (until 06:00, until 06:00 tokyo), or sleep: alone for your usual."
+                )
+            }
+        }
+
+        private fun wrote(): String = if (state.sleepAsked.isBlank()) "" else " (you wrote: ${state.sleepAsked.replace("===", "= = =")})"
+
+        private fun movedLine(): String? = when (state.sleepMoved) {
+            SleepMoved.SHORT ->
+                "the sleep you asked for${wrote()} was shorter than a sleep can be, so it was made ${PersonaOwnTime.span(state.lastMeantMillis)}."
+            SleepMoved.LONG ->
+                "the sleep you asked for${wrote()} was longer than a sleep can be, so it was made ${PersonaOwnTime.span(state.lastMeantMillis)}."
+            else -> null
+        }
+
+        /** What became of the pass of the sleep she just woke from. */
+        fun repairLine(): String {
+            val repair = state.lastRepair
+            // An owed pass that has not come about in a few sleeps in a row keeps to the usual rule from then on.
+            val nextTime = if (state.repairMissed >= OWED_SLEEPS) {
+                "the next time you sleep ${PersonaOwnTime.span(REPAIR_MIN_SLEEP_MILLIS)} or more"
+            } else {
+                "the next time you sleep"
+            }
+            val owedNote = if (state.repairOwed) " a pass that did not come about before is tried $nextTime." else ""
+            return when {
+                repair?.skipped == Skipped.NAP && state.repairOwed ->
+                    "it was a nap, too short for a sleep pass.$owedNote"
+                repair?.skipped == Skipped.NAP ->
+                    "it was a nap: a sleep under ${PersonaOwnTime.span(REPAIR_MIN_SLEEP_MILLIS)} has no sleep pass."
+                repair?.skipped == Skipped.RECENT ->
+                    "your last sleep pass was under ${PersonaOwnTime.span(PASS_GAP_MILLIS)} before, so this sleep had none."
+                repair != null && repair.ok -> "while you slept you went over yourself: ${counts(repair)}."
+                else -> "your sleep pass did not come about; it is tried $nextTime."
+            }
+        }
+    }
+
+    private fun counted(count: Int, one: String, many: String): String? = when {
+        count <= 0 -> null
+        count == 1 -> "1 $one"
+        else -> "$count $many"
+    }
+
+    /** What a pass came to, in the words of the line her waking gets. */
+    fun counts(repair: Repair): String {
+        val done = listOfNotNull(
+            counted(repair.rewritten, "note written again", "notes written again"),
+            counted(repair.added, "new", "new"),
+            counted(repair.letGo, "let go into your archive", "let go into your archive"),
+            counted(repair.back, "brought back", "brought back"),
+            counted(repair.feelings, "feeling set", "feelings set"),
+            counted(repair.marks, "mark of how you know a thing", "marks of how you know a thing"),
+            if (repair.thoughtsKept > 0) "a thought of the night kept" else null
+        )
+        val said = if (done.isEmpty()) "nothing changed" else done.joinToString(", ")
+        val untaken = counted(repair.notTaken, "line could not be taken", "lines could not be taken")
+        return if (untaken == null) said else "$said; $untaken"
+    }
+}
