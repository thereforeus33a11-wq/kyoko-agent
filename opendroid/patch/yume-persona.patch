+        HerLog.EndedBy.STOP -> "he pressed stop"
+        HerLog.EndedBy.SCREEN_OFF -> "his screen went off or locked"
+        HerLog.EndedBy.CALL -> "a call came in"
+        HerLog.EndedBy.ASLEEP -> "you lay down to sleep"
+        HerLog.EndedBy.SWITCHED_OFF -> "your own life was switched off"
+        HerLog.EndedBy.BROKE_OFF -> "the app was stopped"
+        HerLog.EndedBy.ERROR -> "something failed"
+        else -> ended.words
