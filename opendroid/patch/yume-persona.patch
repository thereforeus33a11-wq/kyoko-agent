+++ b/app/src/main/java/com/opendroid/ai/core/life/eyes/SightProbe.kt
@@ -0,0 +1,342 @@
+package com.opendroid.ai.core.life.eyes
+
+import android.util.Log
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.llm.error.LLMException
+import com.opendroid.ai.core.llm.providers.OpenAiCompatExtras
+import com.opendroid.ai.core.llm.providers.cancellable
+import com.opendroid.ai.core.persona.PersonaEngine
