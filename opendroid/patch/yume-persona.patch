+import com.opendroid.ai.data.repository.ConversationRepository
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.di.AppModule
+import java.nio.file.Files
+import java.util.concurrent.CopyOnWriteArrayList
+import javax.inject.Provider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * What a test needs to build the engine the way the app does, with her model behind a
+ * local socket: settings in a file of their own, and a provider factory in which only
+ * the OpenAI-compatible provider can be built.
+ */
+internal object PersonaEngineTestSetup {
+
+    const val CUSTOM = "Custom OpenAI Compatible"
+
+    fun settings(): SettingsRepository = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-persona-test")
+                    .resolve("settings.preferences_pb")
+                    .toFile()
+            }
+        ),
+        providerCredentialStore = FixedKeyCredentialStore(mapOf(CUSTOM to "custom-test-key")),
+        runStartupMigration = false
+    )
+
+    fun factory(settings: SettingsRepository): LLMProviderFactory {
+        val client = AppModule.provideOkHttpClient()
+        return LLMProviderFactory(
+            claudeProvider = unused("Claude"),
+            openAIProvider = unused("OpenAI"),
+            geminiProvider = unused("Gemini"),
+            mistralProvider = unused("Mistral"),
+            groqProvider = unused("Groq"),
+            ollamaProvider = unused("Ollama"),
+            openRouterProvider = unused("OpenRouter"),
+            togetherAIProvider = unused("Together"),
+            cohereProvider = unused("Cohere"),
+            deepSeekProvider = unused("DeepSeek"),
+            copilotProvider = unused("Copilot"),
+            opencodeGoProvider = unused("Opencode-Go"),
+            customOpenAIProvider = Provider { CustomOpenAIProvider(client, settings) },
+            gemmaProvider = unused("Gemma"),
+            liteRTLMProvider = unused("LiteRT-LM"),
+            hybridOnDeviceProvider = unused("Hybrid"),
+            settingsRepository = settings,
+            onDeviceLatencyTracker = OnDeviceLatencyTracker(settings),
+            actionDispatcher = dagger.Lazy<ActionDispatcher> { throw AssertionError("unused") },
+            intentClassifier = dagger.Lazy<IntentClassifier> { throw AssertionError("unused") },
+            // Only used to rewrite planning prompts, which these tests never send.
+            deviceStateProvider = DeviceStateProvider(ContextWrapper(null))
+        )
+    }
+
+    /**
+     * What the phone knows about him and about itself, over [database], the way the app
+     * builds it. Her engine reads the block about him from it.
+     */
+    fun memoryManager(context: Context, database: OpenDroidDatabase, profile: UserProfileStore): MemoryManager {
+        val memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        val conversations = ConversationRepository(database, database.conversationDao(), database.chatSessionDao())
+        val extractor = MemoryExtractor(memoryRepository)
+        val workingMemory = WorkingMemory(context, DeviceStateProvider(context))
+        val notificationIntelligence = NotificationIntelligence(database.notificationDao(), memoryRepository)
+        return MemoryManager(
+            workingMemory = workingMemory,
+            episodicMemory = EpisodicMemory(conversations),
+            semanticMemory = SemanticMemory(memoryRepository, extractor),
+            proceduralMemory = ProceduralMemory(memoryRepository),
+            personalGrowthEngine = PersonalGrowthEngine(
+                memoryRepository = memoryRepository,
+                sensitiveMemoryStore = NoSensitiveMemory,
+                workingMemory = workingMemory,
+                notificationIntelligence = notificationIntelligence
+            ),
+            memoryExtractor = extractor,
+            conversationRepository = conversations,
+            memoryRepository = memoryRepository,
+            notificationIntelligence = notificationIntelligence,
+            userProfileStore = profile,
+            context = context
+        )
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+
+    private fun <T> unused(name: String): Provider<T> =
+        Provider { throw AssertionError("$name must not be built in this test") }
+
+    /**
+     * A profile with nothing but a name. The app's own store unlocks the profile through
+     * the Keystore, which must not happen on the main thread: [readsOnMainThread] counts
+     * the reads that did.
+     */
+    class ProfileNamed(private val name: String) : UserProfileStore {
+        private val reads = CopyOnWriteArrayList<Boolean>()
+
+        val readCount: Int get() = reads.size
+        val readsOnMainThread: Int get() = reads.count { it }
+
+        override fun read(): ProfileStoreResult<UserProfile?> {
+            reads += Looper.myLooper() == Looper.getMainLooper()
+            return ProfileStoreResult.Success(UserProfile(name, ""))
+        }
+
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private class FixedKeyCredentialStore(
+        private val keys: Map<String, String>
+    ) : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(keys)
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
