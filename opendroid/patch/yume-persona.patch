--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/SpeechTextNormalizerTest.kt
@@ -0,0 +1,127 @@
+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class SpeechTextNormalizerTest {
+
+    private fun plain(text: String) = SpeechTextNormalizer.normalize(text)
+    private fun persona(text: String) = SpeechTextNormalizer.normalize(text, personaVoice = true)
+
+    @Test
+    fun `plain english passes through unchanged`() {
+        val text = "Alarm set for 7:30 AM. I'm done, and it's ready."
+        assertEquals(text, plain(text))
+        assertEquals(text, persona(text))
+    }
+
+    @Test
+    fun `markup, bullets, links and emoji are not read aloud`() {
+        assertEquals("Battery is 80 percent", plain("**Battery** is `80 percent` 🔋"))
+        assertEquals("Wifi. Bluetooth", plain("• Wifi\n• Bluetooth"))
+        assertEquals("see a link for more", plain("see https://example.com/a?b=1 for more"))
+        assertEquals("ok", plain("ok ♡"))
+        assertEquals("look at you", plain("look at you 😏💅"))
+    }
+
+    @Test
+    fun `line breaks become sentence stops without doubling punctuation`() {
+        assertEquals("Done! Next one. Last", plain("Done!\nNext one.\n\nLast"))
+    }
+
+    @Test
+    fun `text that is only symbols or punctuation is silent`() {
+        assertEquals("", plain("😏"))
+        assertEquals("", plain("."))
+        assertEquals("", plain("..."))
+        assertEquals("", persona("~"))
+    }
+
+    @Test
+    fun `persona laughter, tildes and stretched vowels are speakable`() {
+        assertEquals("haha", persona("www"))
+        assertEquals("haha stop", persona("wwwww stop"))
+        assertEquals("neh", persona("ne~"))
+        assertEquals("ichiman and body all yours", persona("ichiman and body aaall yours"))
+        assertEquals("so boring", persona("sooo boring"))
+    }
+
+    @Test
+    fun `persona noises get a spoken form`() {
+        assertEquals("tsk. dasai", persona("tch. dasai"))
+        assertEquals("pff. your girl?", persona("pfft. your girl?"))
+        assertEquals("mhm. later", persona("mm. later"))
+        assertEquals("hmm", persona("fuun"))
+        assertEquals("ee jan", persona("ii jan"))
+    }
+
+    @Test
+    fun `missing apostrophes are restored for whole lowercase words only`() {
+        assertEquals("I'm not free. don't ask", persona("im not free. dont ask"))
+        assertEquals("you're late and that's boring", persona("youre late and thats boring"))
+        // Words that only look like contractions stay as typed.
+        assertEquals("well i throw it", persona("well i throw it"))
+        assertEquals("the wonton is cold", persona("the wonton is cold"))
+        assertEquals("important", persona("important"))
+    }
+
+    @Test
+    fun `units and capitalised app text survive the persona pass`() {
+        assertEquals("the gap is 5 mm wide", persona("the gap is 5 mm wide"))
+        assertEquals("Heading NE on the map", persona("Heading NE on the map"))
+        assertEquals("I'm setting that up", persona("I'm setting that up"))
+    }
+
+    @Test
+    fun `persona pass is off by default`() {
+        assertEquals("im here www", plain("im here www"))
+    }
+
+    @Test
+    fun `sums, addresses and file names are not markup`() {
+        for (text in listOf(
+            "12*5*2 = 120",
+            "Send email to john_doe_smith@example.com",
+            "Delete file tax_return_2024.pdf",
+            "2 * 3 * 4 is 24",
+            "snake_case and my_var_name stay"
+        )) {
+            assertEquals(text, plain(text))
+        }
+        assertEquals("this is bold and this is too", plain("this is **bold** and _this_ is too"))
+    }
+
+    @Test
+    fun `text that is not hers is read as written`() {
+        // What a step result, an approval prompt or someone else's message gets: the base pass only.
+        for (text in listOf(
+            "Der Wecker ist im Kalender gestellt",
+            "je ne sais pas",
+            "Rainfall (mm): 12",
+            "Send message to cooolguy",
+            "Type ii diabetes",
+            "see you in ~20 min",
+            "wont be long, dont wait"
+        )) {
+            assertEquals(text, plain(text))
+        }
+    }
+
+    @Test
+    fun `her respelling only ever touches a whole plain word`() {
+        assertEquals("cantó", persona("cantó"))
+        assertEquals("neşe", persona("neşe"))
+        assertEquals("code fff3a1", persona("code fff3a1"))
+        assertEquals("mail bob@im.example", persona("mail bob@im.example"))
+        assertEquals("the file is dont_touch.txt", persona("the file is dont_touch.txt"))
+    }
+
+    @Test
+    fun `a custom lexicon replaces whole words`() {
+        val lexicon = mapOf("maji" to "mah jee")
+        assertEquals(
+            "mah jee? you win it?",
+            SpeechTextNormalizer.normalize("maji? you win it?", personaVoice = true, lexicon = lexicon)
+        )
+    }
+}
