+package com.opendroid.ai.data.repository
+
+import android.app.Application
+import android.content.Context
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * What became of a message of the owner's is written onto the row it already has. The
+ * row keeps its place in the chat, so "edit and resend", which removes a message and
+ * everything stored after it, still removes what the app wrote in answer to it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = Application::class)
+class ConversationRepositoryRemarkTest {
+
+    private val context: Context
+        get() = ApplicationProvider.getApplicationContext()
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var repository: ConversationRepository
+    private lateinit var chat: String
+
+    private val his = ChatMessage(id = "his", text = "set an alarm for 7", sender = ChatMessage.Sender.USER, timestamp = 1_000, modelBadge = "said")
+    private val announcement = ChatMessage(id = "app", text = "alarm. ok", sender = ChatMessage.Sender.AGENT, timestamp = 2_000, modelBadge = "alias")
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        repository = ConversationRepository(database, database.conversationDao(), database.chatSessionDao())
+        chat = runBlocking { repository.createSession("chat") }
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    private fun rows(): List<ChatMessage> = runBlocking { repository.getMessages(chat).first() }
+
+    @Test
+    fun `marking his message as a command changes its badge and leaves everything else as it was`() = runBlocking {
+        repository.insertMessage(chat, his)
+        repository.insertMessage(chat, announcement)
+
+        assertTrue(repository.remarkMessage(chat, his.copy(modelBadge = "command")))
+
+        assertEquals(listOf(his.copy(modelBadge = "command"), announcement), rows())
+    }
+
+    @Test
+    fun `an edit of a message that was marked still removes the rows the app wrote after it`() = runBlocking {
+        repository.insertMessage(chat, his)
+        repository.insertMessage(chat, announcement)
+        repository.remarkMessage(chat, his.copy(modelBadge = "command"))
+
+        repository.deleteMessageAndAfter(chat, his.id)
+
+        assertEquals(emptyList<ChatMessage>(), rows())
+    }
+
+    @Test
+    fun `storing the row again is what moved it behind the app's row`() = runBlocking {
+        // What marking used to do, kept here so that the reason for the update stays visible.
+        repository.insertMessage(chat, his)
+        repository.insertMessage(chat, announcement)
+        repository.insertMessage(chat, his.copy(modelBadge = "command"))
+
+        repository.deleteMessageAndAfter(chat, his.id)
+
+        assertEquals(listOf(announcement), rows())
+    }
+
+    @Test
+    fun `a secret leaves the row with the badge, in place`() = runBlocking {
+        repository.insertMessage(chat, his.copy(text = "save my door code 4471 as a secret"))
+        repository.insertMessage(chat, announcement)
+
+        repository.remarkMessage(chat, his.copy(modelBadge = "secret", text = "(a secret, kept in the phone's secure store)"))
+
+        val stored = rows()
+        assertEquals("(a secret, kept in the phone's secure store)", stored.first().text)
+        assertEquals("secret", stored.first().modelBadge)
+        assertFalse(stored.joinToString { it.text }.contains("4471"))
+    }
+
+    @Test
+    fun `a message he has deleted is not brought back, and one in another chat is not touched`() = runBlocking {
+        repository.insertMessage(chat, his)
+        repository.clearSession(chat)
+        assertFalse(repository.remarkMessage(chat, his.copy(modelBadge = "command")))
+        assertEquals(emptyList<ChatMessage>(), rows())
+
+        val other = repository.createSession("other")
+        repository.insertMessage(other, his)
+        assertFalse(repository.remarkMessage(chat, his.copy(modelBadge = "command")))
+        assertEquals("said", repository.getMessages(other).first().single().modelBadge)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/data/repository/SettingsRepositorySavedSettingTest.kt b/app/src/test/java/com/opendroid/ai/data/repository/SettingsRepositorySavedSettingTest.kt
new file mode 100644
index 0000000..2eea113
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/data/repository/SettingsRepositorySavedSettingTest.kt
@@ -0,0 +1,142 @@
+package com.opendroid.ai.data.repository
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringPreferencesKey
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.withActiveProvider
+import java.nio.file.Files
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What a phone starts with, and what an update of the app leaves alone.
+ *
+ * A phone with no saved setting starts on this build's provider. A phone that already has
+ * one keeps the provider it had, also where that provider was the stock default and so
+ * was never written into the saved text: an update must not move his words to a provider
+ * he did not pick.
+ */
+class SettingsRepositorySavedSettingTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    @Test
+    fun `a phone with no saved setting starts on this build's provider and keeps it once saved`() = runBlocking {
+        val dataStore = newDataStore()
+        val repository = newRepository(dataStore)
+
+        assertEquals(BuildDefaults.fresh(), repository.llmConfig.first())
+
+        // The first write of anything stores the start with it.
+        repository.updateConfig { it.copy(isDarkMode = false) }
+        val saved = dataStore.data.first()[LLM_CONFIG_KEY].orEmpty()
+        assertTrue(saved, saved.contains(custom))
+        val afterwards = newRepository(dataStore).llmConfig.first()
+        assertEquals(custom, afterwards.activeProvider)
+        assertEquals("https://api.venice.ai/api/v1", afterwards.customEndpoints[custom])
+    }
+
+    @Test
+    fun `a setting saved while Gemini was the default stays on Gemini after the update`() = runBlocking {
+        val dataStore = newDataStore()
+        // What an earlier build wrote for a phone left on the stock provider: the fields
+        // that equalled the defaults of the time are not in the text.
+        dataStore.edit { it[LLM_CONFIG_KEY] = """{"routePolicy":"ANY","showFloatingButton":false}""" }
+        val repository = newRepository(dataStore)
+
+        val read = repository.llmConfig.first()
+        assertEquals("Google Gemini", read.activeProvider)
+        assertEquals(RoutePolicy.ANY, read.routePolicy)
+        assertTrue("no address is put in for a provider he never set up", read.customEndpoints.isEmpty())
+
+        // And it stays so through a write of something else.
+        repository.updateConfig { it.copy(isDarkMode = false) }
+        assertEquals("Google Gemini", newRepository(dataStore).llmConfig.first().activeProvider)
+    }
+
+    @Test
+    fun `a saved setting that cannot be read falls back to this build's start`() = runBlocking {
+        val dataStore = newDataStore()
+        dataStore.edit { it[LLM_CONFIG_KEY] = "not a setting" }
+
+        assertEquals(BuildDefaults.fresh(), newRepository(dataStore).llmConfig.first())
+    }
+
+    @Test
+    fun `a reply model saved before its provider was recorded stays with the provider it was used on`() = runBlocking {
+        val dataStore = newDataStore()
+        dataStore.edit {
+            it[LLM_CONFIG_KEY] = """{"activeProvider":"OpenRouter","personaChatModel":"some/model"}"""
+        }
+        val repository = newRepository(dataStore)
+
+        assertEquals("OpenRouter", repository.llmConfig.first().personaChatModelProvider)
+
+        // He moves the main provider. The id was never typed for the new one, and the
+        // record says so from now on.
+        repository.updateConfig { it.withActiveProvider("Ollama") }
+        val moved = newRepository(dataStore).llmConfig.first()
+        assertEquals("Ollama", moved.activeProvider)
+        assertEquals("some/model", moved.personaChatModel)
+        assertEquals("OpenRouter", moved.personaChatModelProvider)
+    }
+
+    private fun newRepository(dataStore: DataStore<Preferences>) = SettingsRepository(
+        dataStore = dataStore,
+        providerCredentialStore = EmptyProviderCredentialStore(),
+        runStartupMigration = false
+    )
+
+    private fun newDataStore() = PreferenceDataStoreFactory.create(
+        scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+        produceFile = {
+            Files.createTempDirectory("opendroid-saved-setting-test")
+                .resolve("settings.preferences_pb")
+                .toFile()
+        }
+    )
+
+    private class EmptyProviderCredentialStore : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+
+    private companion object {
+        val LLM_CONFIG_KEY = stringPreferencesKey("llm_config")
+    }
+}
