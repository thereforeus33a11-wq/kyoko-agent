+    /** Waits until [count] utterances were reported finished on the main thread. */
+    private fun awaitDone(done: List<String>, count: Int) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (System.currentTimeMillis() < deadline) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (done.size >= count) return
+            Thread.sleep(10)
+        }
+        throw AssertionError("expected $count utterance(s) to be reported finished, got $done")
+    }
