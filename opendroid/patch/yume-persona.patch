index 0000000..5df5c22
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsDownloadTest.kt
@@ -0,0 +1,90 @@
+package com.opendroid.ai.core.life.ears
+
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import okio.Buffer
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.net.InetAddress
+
+/** Fetching a model: resumed where it stopped, never longer than pinned, nothing about him sent. */
+class EarsDownloadTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val body = EarsFixtures.lcg(300_000, 5)
+    private val partial: File get() = File(folder.root, "m.part")
+
+    @After
+    fun stop() = server.close()
+
+    private fun fetch(size: Long = body.size.toLong(), keepGoing: () -> Boolean = { true }, httpsOnly: Boolean = false) =
+        EarsDownload(OkHttpClient(), httpsOnly = httpsOnly).fetch(server.url("/m.onnx").toString(), size, partial, keepGoing) {}
+
+    @Test
+    fun `a whole file comes down, with a plain user agent and no cookie or referer`() {
+        server.enqueue(MockResponse.Builder().code(200).body(Buffer().write(body)).build())
+        assertEquals(EarsDownload.Outcome.Done, fetch())
+        assertArrayEquals(body, partial.readBytes())
+        val request = server.takeRequest()
+        assertEquals(EarsDownload.USER_AGENT, request.headers["User-Agent"])
+        assertNull(request.headers["Cookie"])
+        assertNull(request.headers["Referer"])
+        assertNull(request.headers["Range"])
+    }
+
+    @Test
+    fun `a download that stopped goes on from where it was`() {
+        partial.writeBytes(body.copyOf(100_000))
+        server.enqueue(
+            MockResponse.Builder().code(206)
+                .addHeader("Content-Range", "bytes 100000-${body.size - 1}/${body.size}")
+                .body(Buffer().write(body.copyOfRange(100_000, body.size))).build()
+        )
+        assertEquals(EarsDownload.Outcome.Done, fetch())
+        assertEquals("bytes=100000-", server.takeRequest().headers["Range"])
+        assertArrayEquals(body, partial.readBytes())
+    }
+
+    @Test
+    fun `a server that ignores the range starts the file over`() {
+        partial.writeBytes(ByteArray(1000) { 9 })
+        server.enqueue(MockResponse.Builder().code(200).body(Buffer().write(body)).build())
+        assertEquals(EarsDownload.Outcome.Done, fetch())
+        assertArrayEquals(body, partial.readBytes())
+    }
+
+    @Test
+    fun `more than the pinned size is cut off and thrown away`() {
+        server.enqueue(MockResponse.Builder().code(200).body(Buffer().write(body)).build())
+        assertEquals(EarsDownload.Outcome.Refused(EarsDownload.TOO_LONG), fetch(size = 1000))
+        assertFalse(partial.exists())
+    }
+
+    @Test
+    fun `a refusal is reported with its code, and a stop keeps what came`() {
+        server.enqueue(MockResponse.Builder().code(404).build())
+        assertEquals(EarsDownload.Outcome.Refused(404), fetch())
+        server.enqueue(MockResponse.Builder().code(200).body(Buffer().write(body)).build())
+        var calls = 0
+        assertEquals(EarsDownload.Outcome.Interrupted, fetch(keepGoing = { ++calls < 2 }))
+        assertTrue(partial.length() in 1 until body.size)
+    }
+
+    @Test
+    fun `plain http is refused when only https is allowed, as on the phone`() {
+        server.enqueue(MockResponse.Builder().code(200).body(Buffer().write(body)).build())
+        assertEquals(EarsDownload.Outcome.Refused(EarsDownload.NOT_HTTPS), fetch(httpsOnly = true))
+    }
+}
