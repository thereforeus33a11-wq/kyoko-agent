+        assertEquals(1, e.counts[OutingHost.PICTURES_LOOKED])
+        assertEquals(1, ledger.calls()!!.count { it.purpose == OwnPurpose.EYES })
+        assertEquals(1, mind.backs.single().looked)
+        // I8: the description is in her prompt only.
+        val file = File(folder.root, "persona/her_log.json").readText()
+        assertFalse(file.contains("DESCRIPTION_SENTINEL"))
+        assertFalse(mind.backs.single().toString().contains("DESCRIPTION_SENTINEL"))
+        assertTrue(room.lines.isEmpty())
+    }
+
+    @Test
+    fun `her eyes - shut, no look is offered and none is made`() {
+        val eyes = HostEyes(isOpen = false)
