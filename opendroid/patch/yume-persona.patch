+package com.opendroid.ai.core.memory
+
+/**
+ * What [MemoryManager.getRelevantContext] tells a model about the owner and the phone,
+ * as separate pieces instead of one formatted text, for a prompt that words them itself.
+ * A piece the prompt's route may not carry is empty, exactly as it is left out there.
+ */
+data class ContextPieces(
+    val nowMillis: Long,
+    val ownerName: String,
+    val dateOfBirth: String,
+    /** The stored facts as key and value, in the order the store returns them. */
+    val facts: List<Pair<String, String>>,
+    /** Where the phone is, in the words of the device state ("Locating..." when it does not know). */
+    val location: String,
+    val planInHand: Boolean,
+    val planGoal: String,
+    val batteryPercent: Int,
+    /** "Active", "Enabled", "Inactive" or "Unknown", as the device state names it. */
+    val wifiState: String,
+    val online: Boolean,
+    /** The recent notification summary: one entry per notification, each opening with a bullet. */
+    val notifications: String,
+    val notificationPatterns: String,
+    val learnedFromUse: String
+)
