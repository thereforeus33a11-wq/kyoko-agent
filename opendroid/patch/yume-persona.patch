+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.agent.PlanRecord
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStatus
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * How the stored chat reaches her prompt and her notebook pass: what became of a message
+ * of his is read off the badge on its row, the app's lines carry their age and say when
+ * they were cut, a secret is only ever its marker, and a few commands do not push the
+ * talk out of her sight.
+ */
+class PersonaHistoryTest {
+
+    private val minute = 60_000L
+    private val now = 1_700_000_000_000L
+    private var nextId = 0
+
+    private fun owner(text: String, badge: String? = PersonaPrompts.OWNER_TALK_BADGE, minutesAgo: Long = 0) =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.USER, modelBadge = badge, timestamp = now - minutesAgo * minute)
+
+    private fun yume(text: String, badge: String = PersonaPrompts.BADGE, minutesAgo: Long = 0) =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, modelBadge = badge, timestamp = now - minutesAgo * minute)
+
+    private fun app(text: String, badge: String = "System", minutesAgo: Long = 0) =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, modelBadge = badge, timestamp = now - minutesAgo * minute)
+
+    // ── What became of a message of his ──────────────────────────────────────────────
+
+    @Test
+    fun `a command is labelled by its badge even when no row follows it`() {
+        val shaped = PersonaPrompts.shapeHistory(
+            listOf(owner("hi"), yume("mm"), owner("text bob im late", badge = PersonaPrompts.OWNER_COMMAND_BADGE))
+        )
+        assertEquals(
+            listOf("hi", "mm", PersonaPrompts.HANDLED_COMMAND_LABEL + "text bob im late"),
+            shaped.dialogue.map { it.text }
+        )
+    }
+
+    @Test
+    fun `talk that happens to be followed by an app row is not taken for a command`() {
+        // A row marked as not yet a command stays talk, whatever the app writes after it.
+        val shaped = PersonaPrompts.shapeHistory(
+            listOf(owner("you there"), app("I cancelled the plan I proposed here since you started a new task elsewhere."))
+        )
+        assertEquals(listOf("you there"), shaped.dialogue.map { it.text })
+    }
+
+    @Test
+    fun `a row stored before rows were marked is still judged by the row that follows it`() {
+        val shaped = PersonaPrompts.shapeHistory(
+            listOf(owner("call dad", badge = null), app("calling"), owner("what are you doing", badge = null), yume("nothing"))
+        )
+        assertEquals(
+            listOf(PersonaPrompts.HANDLED_COMMAND_LABEL + "call dad\nwhat are you doing", "nothing"),
+            shaped.dialogue.map { it.text }
+        )
+    }
+
+    @Test
+    fun `an answer to the app is labelled as that and is not replayed to her as talk`() {
+        val rows = listOf(
+            owner("text mom", badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("What should I tell Mom?", badge = PersonaPrompts.QUESTION_BADGE),
+            owner("you there?", badge = PersonaPrompts.OWNER_ANSWER_BADGE),
+            app("Message sent to Mom!")
+        )
+        val shaped = PersonaPrompts.shapeHistory(rows)
+        assertEquals(
+            PersonaPrompts.HANDLED_COMMAND_LABEL + "text mom\n" + PersonaPrompts.ANSWER_LABEL + "you there?",
+            shaped.dialogue.single().text
+        )
+        assertTrue(PersonaPrompts.ANSWER_LABEL.contains("not said to you"))
+        // The question is among the app's lines, as a question and not as a result.
+        assertEquals(
+            listOf(PersonaPrompts.QUESTION_LABEL + "What should I tell Mom?", "Message sent to Mom!"),
+            shaped.deviceActivity
+        )
+    }
+
+    @Test
+    fun `shaping the talk a second time does not label it a second time`() {
+        val once = PersonaPrompts.shapeHistory(
+            listOf(
+                owner("torch on", badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+                owner("yes", badge = PersonaPrompts.OWNER_ANSWER_BADGE),
+                yume("mm")
+            )
+        ).dialogue
+        val twice = PersonaPrompts.shapeHistory(once + owner("so", badge = null)).dialogue
+        assertEquals(once.map { it.text } + "so", twice.map { it.text })
+        assertEquals(1, Regex(Regex.escape(PersonaPrompts.HANDLED_COMMAND_LABEL)).findAll(twice.first().text).count())
+    }
+
+    // ── Secrets ──────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a secret he gave is only ever its marker, in her prompt, in her notebook pass and in the stock chat`() {
+        // Even a row that was somehow stored with the words in it.
+        val leaked = owner("save my door code 4471 as a secret", badge = PersonaPrompts.OWNER_SECRET_BADGE)
+        val stored = owner(PersonaPrompts.SECRET_MARKER, badge = PersonaPrompts.OWNER_SECRET_BADGE)
+        for (row in listOf(leaked, stored)) {
+            val rows = listOf(owner("hi"), yume("mm"), row, app("Securely saved 'door' in Level 4 hardware-encrypted storage."))
+            val chat = PersonaPrompts.shapeHistory(rows, nowMillis = now)
+            val notebook = PersonaPrompts.shapeHistory(rows, forNotebook = true)
+            val transcript = PersonaPrompts.reflectionUserPrompt("", notebook.dialogue)
+            val stock = PersonaPrompts.stockHistory(rows, holdBack = false)
+            val everything = chat.dialogue.joinToString { it.text } + chat.deviceActivity.joinToString() +
+                transcript + stock.joinToString { it.text }
+
+            assertFalse(everything, everything.contains("4471"))
+            assertTrue(chat.dialogue.last().text.endsWith(PersonaPrompts.SECRET_MARKER))
+            assertTrue(transcript.contains(PersonaPrompts.SECRET_MARKER))
+            assertEquals(PersonaPrompts.SECRET_MARKER, stock.single { PersonaPrompts.isSecretRow(it) }.text)
+        }
+        assertEquals("(a secret, kept in the phone's secure store)", PersonaPrompts.SECRET_MARKER)
+    }
+
+    @Test
+    fun `only a row of his can stand for a secret`() {
+        assertFalse(PersonaPrompts.isSecretRow(app("x", badge = PersonaPrompts.OWNER_SECRET_BADGE)))
+        assertFalse(PersonaPrompts.isSecretRow(owner("x")))
+        val typed = owner("the word secret is not a secret")
+        assertEquals(typed, PersonaPrompts.withoutSecret(typed))
+    }
+
+    // ── A contact he tapped ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `the name of a contact he tapped stays on the phone where a host could read the prompt`() {
+        val rows = listOf(
+            owner("call riya", badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("Which 'riya' do you mean?\n\n1. Riya Fernhill", badge = PersonaPrompts.appRowBadge(true, PersonaPrompts.QUESTION_BADGE)),
+            owner("Riya Fernhill", badge = PersonaPrompts.OWNER_PICK_BADGE),
+            app("Calling now.")
+        )
+        val held = PersonaPrompts.shapeHistory(rows, holdBackPrivateResults = true)
+        val heldText = held.dialogue.joinToString { it.text } + held.deviceActivity.joinToString()
+        assertFalse(heldText, heldText.contains("Fernhill"))
+        assertTrue(heldText, heldText.contains(PersonaPrompts.PICKED_CONTACT_PLACEHOLDER))
+        // Held back, the row still says that it was a question.
+        assertEquals(PersonaPrompts.QUESTION_LABEL + PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER, held.deviceActivity.first())
+
+        val stock = PersonaPrompts.stockHistory(rows, holdBack = true).joinToString { it.text }
+        assertFalse(stock, stock.contains("Fernhill"))
+
+        // Her notebook pass goes the same way as her replies, so it is held back there too.
+        val talk = rows + listOf(yume("she never picks up"), owner("she will"))
+        val notebook = PersonaPrompts.reflectionUserPrompt(
+            "",
+            PersonaPrompts.shapeHistory(talk, holdBackPrivateResults = true, forNotebook = true).dialogue
+        )
+        assertFalse(notebook, notebook.contains("Fernhill"))
+        assertTrue(notebook, notebook.contains("he: " + PersonaPrompts.HANDLED_COMMAND_LABEL + "call riya"))
+        assertTrue(notebook, notebook.contains(PersonaPrompts.ANSWER_LABEL + PersonaPrompts.PICKED_CONTACT_PLACEHOLDER))
+        assertTrue(notebook, notebook.contains("he: she will"))
+        // On a private route the pass reads the name like everything else.
+        val openNotebook = PersonaPrompts.reflectionUserPrompt(
+            "",
+            PersonaPrompts.shapeHistory(talk, forNotebook = true).dialogue
+        )
+        assertTrue(openNotebook, openNotebook.contains("Riya Fernhill"))
+
+        // On a private route she reads it like everything else, labelled as an answer.
+        val open = PersonaPrompts.shapeHistory(rows)
+        assertTrue(open.dialogue.single().text.endsWith(PersonaPrompts.ANSWER_LABEL + "Riya Fernhill"))
+        // Something he typed himself is his own words and is not held back.
+        val typed = owner("the second one", badge = PersonaPrompts.OWNER_ANSWER_BADGE)
+        assertEquals(listOf(typed), PersonaPrompts.withPrivateResultsHeldBack(listOf(typed)))
+    }
+
+    // ── The app's lines ──────────────────────────────────────────────────────────────
+
+    @Test
+    fun `every app line carries its age`() {
+        val shaped = PersonaPrompts.shapeHistory(
+            listOf(
+                owner("silent mode", badge = PersonaPrompts.OWNER_COMMAND_BADGE, minutesAgo = 26 * 60),
+                app("Phone is now on silent mode.", minutesAgo = 26 * 60),
+                app("alarm. ok", badge = "alias", minutesAgo = 3),
+                app("Your alarm is set for 7:00 AM!", minutesAgo = 0)
+            ),
+            nowMillis = now
+        )
+        assertEquals(
+            listOf(
+                "(yesterday) Phone is now on silent mode.",
+                "(3 min ago) " + PersonaPrompts.STARTED_LABEL + "alarm. ok",
+                "(just now) Your alarm is set for 7:00 AM!"
+            ),
+            shaped.deviceActivity
+        )
+    }
+
+    @Test
+    fun `an age is a few plain words`() {
+        assertEquals("just now", PersonaPrompts.age(0))
+        assertEquals("just now", PersonaPrompts.age(59_000))
+        // A clock that was set back must not produce a line from the future.
+        assertEquals("just now", PersonaPrompts.age(-5 * minute))
+        assertEquals("1 min ago", PersonaPrompts.age(minute))
+        assertEquals("59 min ago", PersonaPrompts.age(59 * minute))
+        assertEquals("1 h ago", PersonaPrompts.age(60 * minute))
+        assertEquals("23 h ago", PersonaPrompts.age(23 * 60 * minute + 59 * minute))
+        assertEquals("yesterday", PersonaPrompts.age(24 * 60 * minute))
+        assertEquals("yesterday", PersonaPrompts.age(47 * 60 * minute))
+        assertEquals("2 days ago", PersonaPrompts.age(48 * 60 * minute))
+        assertEquals("9 days ago", PersonaPrompts.age(9 * 24 * 60 * minute))
+    }
+
+    @Test
+    fun `a line that had to be shortened says so`() {
+        val long = "Here are your notifications: " + "Riya says the hive inspector comes on friday. ".repeat(12)
+        val line = PersonaPrompts.shapeHistory(listOf(app(long))).deviceActivity.single()
+        assertTrue(line, line.endsWith(PersonaPrompts.CUT_MARK))
+        assertTrue(line.length < long.length)
+        // A line that fits is left as it is.
+        assertEquals("Flashlight turned on", PersonaPrompts.shapeHistory(listOf(app("Flashlight turned on"))).deviceActivity.single())
+        assertEquals(" [cut]", PersonaPrompts.CUT_MARK)
+    }
+
+    @Test
+    fun `a long first result cannot hide that a later step failed`() {
+        val record = "Here are your notifications: " + "Riya says the hive inspector comes on friday. ".repeat(12) +
+            "\nFailed: set alarm. App 'Clock' is not installed.\nNot run: open app."
+        val line = PersonaPrompts.shapeHistory(listOf(app(record))).deviceActivity.single()
+        assertTrue(line, line.contains(PersonaPrompts.CUT_MARK))
+        assertTrue(line, line.contains("Failed: set alarm. App 'Clock' is not installed."))
+        assertTrue(line, line.endsWith("Not run: open app."))
+        assertFalse(line.contains('\n'))
+    }
+
+    @Test
+    fun `a result of many lines cannot push the line about a failed step out of the row`() {
+        // What the phone read out, eleven lines of it, and then the step that failed.
+        val read = "Here are your notifications:\n" + (1..10).joinToString("\n") { "Riya: message number $it about the hives" }
+        val record = "$read\nFailed: send SMS to Dad. There was no connection."
+        val parts = PersonaPrompts.shapeHistory(listOf(app(record))).deviceActivity.single().split(" / ")
+
+        assertEquals(
+            listOf(
+                // The top of the row, as much of it as fits, and the gap marked where it is.
+                "Here are your notifications:",
+                "Riya: message number 1 about the hives",
+                "Riya: message number 2 about the hives",
+                "Riya: message number 3 about the hives",
+                "Riya: message number 4 about the hives [cut]",
+                // Its last two lines, whatever they are, and the line the app words itself.
+                "Riya: message number 9 about the hives",
+                "Riya: message number 10 about the hives",
+                "Failed: send SMS to Dad. There was no connection."
+            ),
+            parts
+        )
+    }
+
+    @Test
+    fun `every kind of line about a step that did not go through is kept, in the order the record has them`() {
+        val done = (1..9).joinToString("\n") { "Done: step $it." }
+        val record = done + "\nFailed: set alarm. App 'Clock' is not installed." +
+            "\nWaiting for you: send the draft." +
+            "\nStopped before the end. Nothing failed." +
+            "\nInterrupted: call (it may or may not have gone through)." +
+            "\nNot run: open app, set timer."
+        val parts = PersonaPrompts.shapeHistory(listOf(app(record))).deviceActivity.single().split(" / ")
+
+        assertEquals(
+            listOf(
+                // Three of the nine done lines fit beside them: the first and the last two, with the gap marked.
+                "Done: step 1. [cut]", "Done: step 8.", "Done: step 9.",
+                "Failed: set alarm. App 'Clock' is not installed.",
+                "Waiting for you: send the draft.",
+                "Stopped before the end. Nothing failed.",
+                "Interrupted: call (it may or may not have gone through).",
+                "Not run: open app, set timer."
+            ),
+            parts
+        )
+    }
+
+    // A step of a plan as the plan loop leaves it.
+    private fun step(id: String, action: String, status: StepStatus, result: String? = null, error: String? = null) = PlanStep(
+        stepId = id,
+        order = id.filter(Char::isDigit).toInt(),
+        description = "",
+        action = action,
+        params = if (action.startsWith("SEND_")) mapOf("contact" to "Dad", "message" to "running late") else emptyMap(),
+        status = status,
+        result = result,
+        error = error
+    )
+
+    private fun plan(vararg steps: PlanStep) = Plan(
+        planId = "p1",
+        goal = "",
+        estimatedDuration = "",
+        estimatedSteps = steps.size,
+        steps = steps.toList(),
+        status = PlanStatus.FAILED
+    )
+
+    private fun notifications(count: Int) =
+        "Here are your notifications:\n" + (1..count).joinToString("\n") { "Riya: message number $it about the hives" }
+
+    // What the handler of a message that was left as a draft reports, word for word.
+    private val handOff =
