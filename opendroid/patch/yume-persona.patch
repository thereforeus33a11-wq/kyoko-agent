+        TOO_SOON,
+
+        /** Further off than a wish may reach. */
+        TOO_FAR,
+
+        /** The day's moments were used up at the time she asked for. */
+        DAY_USED_UP,
+
+        /** What she wrote after `next:` could not be read, so the default applied. */
+        NOT_READ,
+
+        /** His number of calls on her own was used up at the time she asked for (her own life's ledger). */
