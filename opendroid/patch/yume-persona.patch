+/**
+ * Puts [text] on the clipboard, marked as sensitive, so that Android 13 and later keep
+ * it out of the preview they show after a copy. Her notebook holds what she knows about
+ * the owner.
+ */
+private fun copyToClipboard(context: Context, text: String) {
+    val clip = ClipData.newPlainText("notebook", text)
+    // The name of ClipDescription.EXTRA_IS_SENSITIVE, which older versions do not have.
+    clip.description.extras = PersistableBundle().apply { putBoolean("android.content.extra.IS_SENSITIVE", true) }
+    context.getSystemService(ClipboardManager::class.java)?.setPrimaryClip(clip)
+}
+
+/**
+ * What is said about a saved edit of the card, in the words both screens use, or null
+ * when there is nothing to say. A saved edit takes the place of the built-in card for
+ * good, so when a new version of the app ships another built-in card the owner is
+ * told, instead of running on the old text without knowing.
+ */
+internal fun cardEditNoticeText(notice: CardEditNotice?): String? = when (notice) {
+    CardEditNotice.BUILT_IN_CHANGED ->
+        "The built-in card has changed since your edit. She runs on your edit, so what is new in the built-in card is not in use."
+    CardEditNotice.CANNOT_TELL ->
+        "Your edit was saved before the app kept track of the built-in card, so it cannot tell whether the built-in card has changed since. She runs on your edit."
+    CardEditNotice.NONE, null -> null
+}
+
+/** What is asked before a button throws text of his away: the question, what will happen, and the word that goes ahead. */
+internal class DiscardQuestion(val title: String, val text: String, val confirm: String)
+
+/**
+ * What "Restore built-in" asks before it does anything. With a saved edit
+ * ([usesSavedEdit]) it deletes that edit for good, which is the same act as "Use the new
+ * one" under the notice and is asked in the same words. Without one it only takes back
+ * what he has typed and not saved.
+ */
+internal fun restoreBuiltInQuestion(usesSavedEdit: Boolean): DiscardQuestion = if (usesSavedEdit) {
+    DiscardQuestion(
+        title = "Remove your edit?",
+        text = "She will run on the built-in card. Your edited text is deleted and is not kept anywhere else.",
+        confirm = "Remove my edit"
+    )
+} else {
+    DiscardQuestion(
+        title = "Discard what you typed?",
+        text = "The editor goes back to the built-in card, which is the one she runs on. What you typed is not kept anywhere.",
+        confirm = "Discard it"
+    )
+}
+
+/** The notice of [cardEditNoticeText] with its two choices. Shows nothing when there is nothing to say. */
+@Composable
+internal fun CardEditNoticeRow(notice: CardEditNotice?, onUseBuiltIn: () -> Unit, onKeepMine: () -> Unit) {
+    val text = cardEditNoticeText(notice) ?: return
+    var confirmRemoval by remember { mutableStateOf(false) }
+    Column {
+        Text(text = text, fontSize = 12.sp, color = AccentCyan)
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            TextButton(onClick = { confirmRemoval = true }) {
+                Text(if (notice == CardEditNotice.BUILT_IN_CHANGED) "Use the new one" else "Use the built-in one", color = TextPrimary)
+            }
+            TextButton(onClick = onKeepMine) { Text("Keep mine", color = TextPrimary) }
+        }
+    }
+    if (confirmRemoval) {
+        DiscardDialog(restoreBuiltInQuestion(usesSavedEdit = true), onConfirm = onUseBuiltIn) { confirmRemoval = false }
+    }
+}
+
+/** Asks [question] and calls [onConfirm] only on a yes. [onClose] takes the dialog away either way. */
+@Composable
+private fun DiscardDialog(question: DiscardQuestion, onConfirm: () -> Unit, onClose: () -> Unit) {
+    AlertDialog(
+        onDismissRequest = onClose,
+        title = { Text(question.title) },
+        text = { Text(question.text) },
+        confirmButton = {
+            TextButton(onClick = {
+                onClose()
+                onConfirm()
+            }) { Text(question.confirm) }
+        },
+        dismissButton = { TextButton(onClick = onClose) { Text("Cancel") } }
+    )
+}
