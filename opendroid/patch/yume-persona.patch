diff --git a/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
new file mode 100644
index 0000000..ff05e80
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
@@ -0,0 +1,211 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * Which steps of a plan hold the owner's private data in their result, and how such a
+ * result is shown to a model whose host could read it.
+ *
+ * A step holds private data when its action reads some ([ActionSchema.readsPersonalData]),
+ * or when one of its parameters quotes the result of a step that does: "read my
+ * notifications, then show them" puts the notification text into the second step's result
+ * as well, although showing text reads nothing by itself. A step that reaches a contact
+ * through a saved pick names that contact in its result ([SavedPickNotice]); there only
+ * the name is private, not what the step did.
+ */
+internal object PersonalDataResults {
+
+    /**
+     * Ids of the steps in [steps] whose result holds private data. [canonicalNames] gives
+     * the dispatcher's names for a step's action and its fallback, either of which may have
+     * produced the result. [steps] is read in plan order, so a quote of an earlier step is
+     * seen after that step has been judged.
+     */
+    fun stepIdsHolding(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> {
+        val holding = LinkedHashSet<String>()
+        val quotable = LinkedHashSet<String>()
+        for (step in steps.sortedBy { it.order }) {
+            val reads = canonicalNames(step).any { name ->
+                ActionSchema.readsPersonalData(name) && !namesItsOwnPlace(name, step)
+            }
+            // The same "$stepId" form the executor substitutes. A longer id that starts the
+            // same way also matches, which only errs towards holding more back.
+            val quotes = quotable.any { id -> step.params.values.any { it.contains("$" + id) } }
+            if (reads || quotes) holding += step.stepId
+            // Quoting a step that names a saved contact repeats the name as well.
+            if (reads || quotes || namesSavedContact(step, canonicalNames)) quotable += step.stepId
+        }
+        return holding
+    }
+
+    /**
+     * Ids of the steps in [steps] whose result or error names the contact a saved pick
+     * stands for. Only the actions that resolve a contact can carry that notice.
+     */
+    fun stepIdsNamingContact(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> = steps.filter { namesSavedContact(it, canonicalNames) }.mapTo(LinkedHashSet()) { it.stepId }
+
+    private fun namesSavedContact(step: PlanStep, canonicalNames: (PlanStep) -> Collection<String>): Boolean =
+        (SavedPickNotice.isIn(step.result) || SavedPickNotice.isIn(step.error)) &&
+            canonicalNames(step).any(ActionSchema::resultNamesContact)
+
+    /**
+     * The weather action looks up where he is only when the plan names no place. With a
+     * place in the plan the result is the weather there, which tells the planner's own
+     * route nothing the plan did not already say: a planner his details are held back
+     * from was never told where he is, so the place is one he named himself. A planner
+     * that was told everything may have filled in his town; what its plans say is marked
+     * as a whole where it is stored (see [planRowStaysPrivate]). Mirrors how the action reads its
+     * `location` parameter.
+     */
+    private fun namesItsOwnPlace(canonicalName: String, step: PlanStep): Boolean {
+        if (canonicalName != "GET_WEATHER") return false
+        val place = step.params["location"]?.trim().orEmpty()
+        return place.isNotEmpty() && !place.equals("current location", ignoreCase = true)
+    }
+
+    /**
+     * [steps] as a readable host may see them: everything about a step stays (that it ran,
+     * what it was, whether it worked) except the text of a result in [holding], and the
+     * name and number of a saved contact in a step in [namingContact].
+     */
+    fun heldBack(
+        steps: List<PlanStep>,
+        holding: Set<String>,
+        namingContact: Set<String> = emptySet()
+    ): List<PlanStep> = steps.map { step ->
+        val result = step.result
+        when {
+            step.stepId in holding && !result.isNullOrBlank() -> step.copy(result = placeholder(result))
+            step.stepId in namingContact -> step.copy(
+                result = result?.let(SavedPickNotice::withheld),
+                error = step.error?.let(SavedPickNotice::withheld)
+            )
+            else -> step
+        }
+    }
+
+    /**
+     * [steps] of one plan as a prompt on the main route may carry them. A step result can
+     * be the text of his notifications, messages, clipboard or screen. On a private route
+     * the model reads it like everything else; on a hosted route with private mode on the
+     * text stays on the phone and the model is told only that the step ran and has a
+     * result. [plan] is every step of the plan, so that a quote of an earlier step is seen
+     * whichever of the lists the quoting step is in.
+     */
+    fun forPrompt(
+        config: LLMConfig,
+        steps: List<PlanStep>,
+        plan: List<PlanStep> = steps,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): List<PlanStep> {
+        if (!config.mainRouteHoldsBack()) return steps
+        return heldBack(steps, stepIdsHolding(plan, canonicalNames), stepIdsNamingContact(plan, canonicalNames))
+    }
+
+    /**
+     * True when the summary of a run repeats text that holds private data. A run that
+     * worked ([isSuccess]) is summed up from the results of its completed steps, one that
+     * failed from the error of a failed step.
+     */
+    fun summaryHolds(
+        steps: List<PlanStep>,
+        isSuccess: Boolean,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Boolean {
+        val naming = stepIdsNamingContact(steps, canonicalNames)
+        if (!isSuccess) return steps.any { it.status == StepStatus.FAILED && it.stepId in naming }
+        val holding = stepIdsHolding(steps, canonicalNames)
+        return steps.any {
+            it.status == StepStatus.COMPLETED && !it.result.isNullOrBlank() &&
+                (it.stepId in holding || it.stepId in naming)
+        }
+    }
+
+    /**
+     * Stands in for a result that stays on the phone. It still says that there was one and
+     * how long it is, which is enough to tell "nothing found" from a full answer, and that
+     * a later step can use it: the phone fills `$stepId` in itself.
+     */
+    fun placeholder(result: String): String =
+        "[kept on the phone: ${result.length} characters of the owner's private data. " +
+            "Later steps can still use this result by its step id.]"
+}
+
+/**
+ * The notice an action puts in front of its result when it reached a contact through a
+ * pick he saved earlier: the picker is skipped then, so the result has to say who was
+ * chosen. It names someone from his contacts and shows part of the number, which a model
+ * whose host could read the prompt is not given. The notice is written and recognised
+ * here, so that the two cannot drift apart.
+ */
+internal object SavedPickNotice {
+
+    /** The notice for a contact called [name] whose number is shown as [maskedNumber]. */
+    fun of(name: String, maskedNumber: String): String = "Using $name ($maskedNumber). "
+
+    /** What a readable host gets in its place: that a saved pick was used, not whose. */
+    const val WITHHELD = "Using a saved contact (the name stays on the phone). "
+
+    // Lazy up to the first ")." after an opening parenthesis: that is where the notice
+    // ends, whatever parentheses the name ("Riya (work)") or the number ("(555)***") has.
+    private val FORM = Regex("""Using .+? \(.*?\)\.(?: |$)""")
+
+    /** True when [text] carries the notice, at its start or after an "it failed" prefix. */
+    fun isIn(text: String?): Boolean = text != null && FORM.containsMatchIn(text)
+
+    /** [text] with the notice replaced by [WITHHELD]; everything else is left as it is. */
+    fun withheld(text: String): String = FORM.replace(text, Regex.escapeReplacement(WITHHELD))
+}
+
+/**
+ * The lists of steps the re-evaluation and re-plan prompts are built from, as text. Both
+ * prompts go to the main route, so completed and failed steps pass through
+ * [PersonalDataResults.forPrompt] first.
+ */
+internal object ReEvalInputs {
+
+    /** What the re-evaluation call reads after a step. */
+    fun afterStep(
+        config: LLMConfig,
+        originalGoal: String,
+        completedSteps: List<PlanStep>,
+        failedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String
+    ): String {
+        val plan = completedSteps + failedSteps + remainingSteps
+        return """
+            - Original goal: $originalGoal
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Failed steps: ${encode(PersonalDataResults.forPrompt(config, failedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+
+    /** What the re-plan call reads after a step named an action that does not exist. */
+    fun afterUnknownAction(
+        config: LLMConfig,
+        failedStep: PlanStep,
+        completedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String,
+        encodeStep: (PlanStep) -> String
+    ): String {
+        val plan = completedSteps + failedStep + remainingSteps
+        return """
+            - Failed step: ${encodeStep(failedStep)}
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+}
