+package com.opendroid.ai.core.voice.own
+
+import java.text.Normalizer
+
+/** Which language a piece of her line is read in. */
+enum class Lang(val code: String) { EN("en"), JA("ja") }
+
+/**
+ * How one Latin word of hers is read: in English as [ipa] (words separated by a space),
+ * or in Japanese as [kana] for Open JTalk. [source] names the step of the table's
+ * latin_word_route that knew the word (cmu, weak, override, ja_words, romaji, ...).
+ */
+data class WordReading(val route: Lang, val source: String, val ipa: String = "", val kana: String = "")
+
+/**
+ * Her English words to the phonemes her bilingual voice reads (IPA, one codepoint each),
+ * from en_ipa_table.json and the CMU dictionary. A line-for-line port of the training
+ * side's en_phonemize.py (EnglishWords), so the phone gives the voice the very phonemes
+ * it learned her English from. It is held to that code by the parity fixture
+ * (MixedPhonemesParityTest): every word of her lines, read here and there, must match.
+ *
+ * [pronunciations] is the CMU dictionary: a lowercase word to its first pronunciation
+ * (ARPAbet), or null. Nothing here touches the network or a file.
+ */
+class EnglishPhonemes(
+    private val table: EnglishTable,
+    private val pronunciations: (String) -> List<String>?,
+) {
+
+    /** How one Latin word (letters, with ' inside) is read; [final]: it ends its sentence. */
+    fun read(typed: String, final: Boolean = false): WordReading {
+        val raw = HELD.replace(typed) { it.groupValues[1].repeat(table.heldKeep) }.trim('\'')
+        val lower = raw.lowercase()
+        if (lower.isEmpty()) return WordReading(Lang.EN, "empty")
+        table.jaWords[lower]?.let { return WordReading(Lang.JA, "ja_words", kana = it) }
+        // A word typed in capitals is said letter by letter when the table says so, or
+        // when it is no word at all (NHK); a shouted word stays a word (NO, LINE).
+        if (raw.length in 2..5 && raw.all { it in 'A'..'Z' }) {
+            val known = heldVariants(lower).any { known(it) != null || it in table.weakForms }
+            if (lower in table.capsAsLetters || !known) return WordReading(Lang.EN, "caps", ipa = lettersIpa(lower))
+        }
+        table.weakForms[lower]?.let { wf ->
+            return WordReading(Lang.EN, "weak", ipa = if (final && wf.strong != null) wf.strong else wf.ipa)
+        }
+        table.overrides[lower]?.let { return WordReading(Lang.EN, "override", ipa = arpabetToIpa(it)) }
+        for (v in heldVariants(lower)) {
+            pronunciations(v)?.let { return WordReading(Lang.EN, "cmu", ipa = arpabetToIpa(it)) }
+            if (v != lower) table.overrides[v]?.let { return WordReading(Lang.EN, "override", ipa = arpabetToIpa(it)) }
+            if (v != lower) table.weakForms[v]?.let { return WordReading(Lang.EN, "weak", ipa = it.ipa) }
+        }
+        if ('\'' in lower) {
+            val bare = lower.replace("'", "")
+            table.overrides[bare]?.let { return WordReading(Lang.EN, "override", ipa = arpabetToIpa(it)) }
+            pronunciations(bare)?.let { return WordReading(Lang.EN, "cmu", ipa = arpabetToIpa(it)) }
+        }
+        suffix(lower)?.let { return WordReading(Lang.EN, "suffix", ipa = arpabetToIpa(it)) }
+        if ('\'' !in lower) Romaji.toHiragana(lower)?.let { return WordReading(Lang.JA, "romaji", kana = it) }
+        compound(lower.replace("'", ""))?.let { return WordReading(Lang.EN, "compound", ipa = arpabetToIpa(it)) }
+        if (lower.length == 1 && lower in table.letters) return WordReading(Lang.EN, "letter", ipa = lettersIpa(lower))
+        return WordReading(Lang.JA, "loose", kana = Romaji.toKatakanaLoose(lower.replace("'", "")))
+    }
+
+    /**
+     * ARPAbet (stress digits allowed, "_" a word break) to IPA in espeak's style: the
+     * stress mark right before the stressed vowel. Throws on a phone the table lacks.
+     */
+    fun arpabetToIpa(phones: List<String>): String {
+        val out = StringBuilder()
+        for ((k, p) in phones.withIndex()) {
+            if (p == "_") {
+                out.append(' ')
+                continue
+            }
+            val base = p.trimEnd('0', '1', '2')
+            val stress = p.substring(base.length).ifEmpty { null }
+            if (base in table.vowelsByStress || base in table.vowels) {
+                var v = table.vowelsByStress[base]?.get(stress ?: "0")?.takeIf { it.isNotEmpty() }
+                    ?: table.vowels[base] ?: throw IllegalArgumentException("no vowel for ARPAbet $p")
+                val next = phones.getOrNull(k + 1)?.trimEnd('0', '1', '2') ?: ""
+                if (base in table.rVowelBeforeVowel && (next in table.vowels || next in table.vowelsByStress)) {
+                    // hurry HH ER1 IY0: the r is said before the next vowel (hˈɜːɹi), as espeak writes it.
+                    v = table.rVowelBeforeVowel.getValue(base)[stress ?: "0"]
+                        ?: throw IllegalArgumentException("no r-vowel for ARPAbet $p")
+                }
+                out.append(table.stressMarks[stress ?: ""] ?: "").append(v)
+            } else {
+                out.append(table.consonants[base] ?: throw IllegalArgumentException("unknown ARPAbet phone $p"))
+            }
+        }
+        return out.toString()
+    }
+
+    /** A word's letter names as one word (DJ dˌiːdʒˈeɪ): every letter but the last loses its main stress. */
+    fun lettersIpa(word: String): String {
+        val ls = word.lowercase().map { it.toString() }.filter { it in table.letters }
+        val phones = ArrayList<String>()
+        for ((k, c) in ls.withIndex()) {
+            var ps = table.letters.getValue(c)
+            if (k < ls.size - 1) ps = ps.map { if (it.endsWith("1")) it.dropLast(1) + "2" else it }
+            phones += ps
+        }
+        return arpabetToIpa(phones)
+    }
+
+    private fun known(w: String): List<String>? = table.overrides[w] ?: pronunciations(w)
+
+    /** sooo -> [sooo, so, soo]: each run of 3 identical letters cut to 1, then to 2. */
+    private fun heldVariants(w: String): List<String> {
+        if (!TRIPLE.containsMatchIn(w)) return listOf(w)
+        return listOf(w, TRIPLE.replace(w, "$1"), TRIPLE.replace(w, "$1$1"))
+    }
+
+    private fun lastPhone(phones: List<String>): String = phones.lastOrNull()?.trimEnd('0', '1', '2') ?: ""
+
+    private fun suffix(w: String): List<String>? {
+        for (rule in table.suffixRules) {
+            val suf = rule.suffix
+            if (!w.endsWith(suf) || w.length <= suf.length) continue
+            for (b in rule.bases) {
+                val cut = w.length - b.drop
+                if (cut < table.minBaseLetters) continue
+                if (b.double && !(cut >= 1 && w[cut - 1] == w[cut])) continue
+                val phones = known(w.substring(0, cut) + b.append) ?: continue
+                if (b.sibilant && lastPhone(phones) !in table.sibilants) continue
+                return phones + suffixPhones(rule.add, phones)
+            }
+        }
+        return null
+    }
+
+    private fun suffixPhones(add: String, base: List<String>): List<String> {
+        val last = lastPhone(base)
+        val v = table.voicing[add] ?: return EnglishTable.pyWords(add)
+        val chosen = when {
+            "after_sibilant" in v && last in table.sibilants -> v.getValue("after_sibilant")
+            "after_t_d" in v && last in table.tOrD -> v.getValue("after_t_d")
+            last in table.voiceless -> v.getValue("after_voiceless")
+            else -> v.getValue("else")
+        }
+        return EnglishTable.pyWords(chosen)
+    }
+
+    private fun compound(w: String): List<String>? {
+        for (i in (w.length - table.compoundMinPart) downTo table.compoundMinPart) {
+            val left = known(w.substring(0, i)) ?: continue
+            val right = known(w.substring(i)) ?: continue
+            return left + right
+        }
+        return null
+    }
+
+    // -- numbers ----------------------------------------------------------------------------
+
+    /** 0 up to the table's max, in English words (2026: two thousand twenty six). */
+    fun spellInt(n: Long): List<String> {
+        require(n >= 0 && n <= table.maxNumber) { "number out of range: $n" }
+        if (n < 20) return listOf(table.ones[n.toInt()])
+        if (n < 100) return listOf(table.tens[(n / 10).toInt()]) + if (n % 10 != 0L) listOf(table.ones[(n % 10).toInt()]) else emptyList()
+        if (n < 1000) return listOf(table.ones[(n / 100).toInt()], table.hundred) + if (n % 100 != 0L) spellInt(n % 100) else emptyList()
+        for ((value, name) in table.scales) {
+            if (n >= value) return spellInt(n / value) + name + if (n % value != 0L) spellInt(n % value) else emptyList()
+        }
+        throw IllegalStateException("no scale for $n")
+    }
+
+    /** The cardinal's words as an ordinal: its last word changed (twenty one -> twenty first). */
+    fun ordinal(words: List<String>): List<String> {
+        var last = words.last()
+        last = table.ordinalWords[last] ?: if (last.endsWith("y")) last.dropLast(1) + "ieth" else last + "th"
+        return words.dropLast(1) + last
+    }
+
+    /**
+     * A number token (digits with , . : inside, an ordinal suffix, a currency sign before,
+     * % after) to English words: ¥500 five hundred yen, 7:05 seven oh five, 1st first.
+     */
+    fun spellNumber(token: String): List<String> {
+        var tok = Normalizer.normalize(token, Normalizer.Form.NFKC)
+        var currency: String? = null
+        for ((sym, word) in table.currencyBefore) {
+            val s = Normalizer.normalize(sym, Normalizer.Form.NFKC)
+            if (tok.startsWith(s)) {
+                currency = word
+                tok = tok.substring(s.length)
+                break
+            }
+        }
+        val percent = tok.endsWith("%")
+        if (percent) tok = tok.dropLast(1)
+        var suffix: String? = null
+        for (suf in table.ordinalSuffixes) {
+            if (tok.lowercase().endsWith(suf) && pyIsDigits(tok.dropLast(suf.length))) {
+                suffix = suf
+                tok = tok.dropLast(suf.length)
+                break
+            }
+        }
+        if (THOUSANDS.matches(tok)) tok = tok.replace(table.thousandsSeparator, "")
+        var words: List<String> = when {
+            TIME.matches(tok) -> {
+                val (h, m) = tok.split(":")
+                val minutes = m.toInt()
+                spellInt(h.toLong()) + when {
+                    minutes == 0 -> listOf(table.oClock)
+                    minutes < 10 -> listOf(table.oh) + spellInt(minutes.toLong())
+                    else -> spellInt(minutes.toLong())
+                }
+            }
+            DECIMAL.matches(tok) -> {
+                val (a, b) = tok.split(".")
+                spellDigitsOrInt(a) + table.point + b.map { table.ones[it.digitToInt()] }
+            }
+            DIGITS.matches(tok) -> spellDigitsOrInt(tok).let { if (suffix != null) ordinal(it) else it }
+            // Anything else made of digits and marks: digit by digit.
+            else -> tok.filter { it.isDigit() }.map { table.ones[it.digitToInt()] }
+        }
+        if (percent) words = words + table.percent
+        if (currency != null) {
+            if (words == listOf("one")) currency = table.currencySingular[currency] ?: currency
+            words = words + currency
+        }
+        return words
+    }
+
+    private fun spellDigitsOrInt(digits: String): List<String> {
+        if (digits.length > 1 && digits.startsWith("0")) return digits.map { table.ones[it.digitToInt()] }
+        // More digits than the largest number has: digit by digit (never overflows).
+        if (digits.length > table.maxNumber.toString().length || digits.toLong() > table.maxNumber) {
+            return digits.map { table.ones[it.digitToInt()] }
+        }
+        return spellInt(digits.toLong())
+    }
+
+    companion object {
+        private val HELD = Regex("([A-Za-z])\\1{3,}")
+        private val TRIPLE = Regex("([a-z])\\1\\1")
+        private val THOUSANDS = Regex("[0-9]{1,3}(?:,[0-9]{3})+")
+        private val TIME = Regex("[0-9]{1,2}:[0-9]{2}")
+        private val DECIMAL = Regex("[0-9]+\\.[0-9]+")
+        private val DIGITS = Regex("[0-9]+")
+
+        /** Python's str.isdigit() for the ASCII digits a number token holds after NFKC. */
+        private fun pyIsDigits(s: String): Boolean = s.isNotEmpty() && s.all { it in '0'..'9' }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/own/EnglishTable.kt b/app/src/main/java/com/opendroid/ai/core/voice/own/EnglishTable.kt
new file mode 100644
index 0000000..f5637c9
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/own/EnglishTable.kt
@@ -0,0 +1,165 @@
+package com.opendroid.ai.core.voice.own
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.long
+import java.security.MessageDigest
+
+/**
+ * en_ipa_table.json, read: how her bilingual voice says English. It is the very file her
+ * voice was trained with (voice/scripts/pod/en_ipa_table.json, shipped beside the voice
+ * by make_own_voice.sh), so the phone and the training read every word alike. This class
+ * only holds the table's data; [EnglishPhonemes] and [MixedPhonemes] apply it, each a
+ * port of the training side's reference code (en_phonemize.py, mix_phonemize.py).
+ *
+ * Every map keeps the file's order, because some rules are tried in that order (the
+ * currency signs, the suffix rules, the ordinal suffixes, the number scales).
+ */
+class EnglishTable private constructor(root: JsonObject, val sha256: String) {
+
+    /** One weak form of a function word: [ipa] inside a sentence, [strong] where it ends one. */
+    class WeakForm(val ipa: String, val strong: String?)
+
+    /** One way to find a suffixed word's base: [drop] letters off, [append] on. */
+    class SuffixBase(val drop: Int, val append: String, val double: Boolean, val sibilant: Boolean)
+
+    class SuffixRule(val suffix: String, val bases: List<SuffixBase>, val add: String)
+
+    val name: String = root.string("name")
+    val version: Int = root["version"]!!.jsonPrimitive.int
+    val cmudictSha256: String = root.obj("cmudict").string("sha256")
+
+    val vowels: Map<String, String> = root.obj("vowels").strings()
+    val vowelsByStress: Map<String, Map<String, String>> =
+        root.obj("vowels_by_stress").mapValuesOrdered { it.jsonObject.strings() }
+    val consonants: Map<String, String> = root.obj("consonants").strings()
+    val rVowelBeforeVowel: Map<String, Map<String, String>> =
+        root.obj("r_vowel_before_vowel").obj("vowels").mapValuesOrdered { it.jsonObject.strings() }
+    val stressMarks: Map<String, String> = root.obj("stress_marks").strings()
+
+    val weakForms: Map<String, WeakForm> = root.obj("weak_forms").obj("words").mapValuesOrdered {
+        val o = it.jsonObject
+        WeakForm(o.string("ipa"), (o["strong"] as? JsonPrimitive)?.content)
+    }
+    val overrides: Map<String, List<String>> =
+        root.obj("word_overrides").obj("words").mapValuesOrdered { pyWords(it.jsonPrimitive.content) }
+    val capsAsLetters: Set<String> = root.obj("caps_as_letters").array("words").stringSet()
+    val letters: Map<String, List<String>> = root.obj("letters").mapValuesOrdered { pyWords(it.jsonPrimitive.content) }
+    val jaWords: Map<String, String> = root.obj("ja_words").obj("words").strings()
+
+    val suffixRules: List<SuffixRule> = root.obj("suffixes").array("rules").map { r ->
+        val o = r.jsonObject
+        SuffixRule(
+            suffix = o.string("suffix"),
+            bases = o.array("bases").map { b ->
+                val bo = b.jsonObject
+                SuffixBase(
+                    drop = bo["drop"]!!.jsonPrimitive.int,
+                    append = (bo["append"] as? JsonPrimitive)?.content ?: "",
+                    double = (bo["double"] as? JsonPrimitive)?.booleanOrNull == true,
+                    sibilant = (bo["sibilant"] as? JsonPrimitive)?.booleanOrNull == true,
+                )
+            },
+            add = o.string("add"),
+        )
+    }
+    val voicing: Map<String, Map<String, String>> =
+        root.obj("suffixes").obj("voicing").mapValuesOrdered { it.jsonObject.strings() }
+    val sibilants: Set<String> = root.obj("suffixes").array("sibilants").stringSet()
+    val voiceless: Set<String> = root.obj("suffixes").array("voiceless").stringSet()
+    val tOrD: Set<String> = root.obj("suffixes").array("t_d").stringSet()
+    val minBaseLetters: Int = root.obj("suffixes")["min_base_letters"]!!.jsonPrimitive.int
+    val compoundMinPart: Int = root.obj("compound")["min_part"]!!.jsonPrimitive.int
+    val heldKeep: Int = root.obj("held_letter")["keep"]!!.jsonPrimitive.int
+
+    // Numbers.
+    private val numbers = root.obj("numbers")
+    val ones: List<String> = numbers.array("ones").map { it.jsonPrimitive.content }
+    val tens: List<String> = numbers.array("tens").map { it.jsonPrimitive.content }
+    val hundred: String = numbers.string("hundred")
+    val scales: List<Pair<Long, String>> = numbers.array("scales").map {
+        val pair = it.jsonArray
+        pair[0].jsonPrimitive.long to pair[1].jsonPrimitive.content
+    }
+    val maxNumber: Long = numbers["max"]!!.jsonPrimitive.long
+    val ordinalWords: Map<String, String> = numbers.obj("ordinal_words").strings()
+    val ordinalSuffixes: List<String> = numbers.array("ordinal_suffixes").map { it.jsonPrimitive.content }
+    val point: String = numbers.string("point")
+    val oClock: String = numbers.string("o_clock")
+    val oh: String = numbers.string("oh")
+    val percent: String = numbers.string("percent")
+    val thousandsSeparator: String = numbers.string("thousands_separator")
+    val currencyBefore: Map<String, String> = numbers.obj("currency_before").strings()
+    val currencySingular: Map<String, String> = numbers.obj("currency_singular").strings()
+    val timeWords: Map<String, List<String>> = numbers.obj("time_words").mapValuesOrdered { pyWords(it.jsonPrimitive.content) }
+
+    /** Symbols said as a word next to English (& and, + plus, @ at, = equals). */
+    val symbolWords: Map<String, String> = root.obj("symbols").obj("words").strings()
+
+    // Cutting a line into sentences and segments.
+    private val segmentation = root.obj("segmentation")
+    val abbreviations: Set<String> = segmentation.array("abbreviations").stringSet()
+    val jaEdgePunct: Set<Char> = segmentation.string("ja_edge_punct").toSet()
+    val spaceCodepoints: Set<Int> = segmentation.array("space_codepoints").map { it.jsonPrimitive.int }.toSet()
+    val clausePunct: Set<String> = segmentation.array("clause_punct").stringSet()
+    val terminalPunct: Map<String, String> = segmentation.obj("terminal_punct").strings()
+
+    // Joining the pieces.
+    private val boundaries = root.obj("boundaries")
+    val wordSeparator: String = boundaries.string("word")
+    val clauseMark: String = boundaries.string("clause")
+    val afterClause: String = boundaries.string("after_clause")
+    val switchMark: String = boundaries.string("switch")
+    val sentenceEndDefault: String = boundaries.string("sentence_end_default")
+
+    /**
+     * Every codepoint an English reading of this table can give the voice: the same list
+     * make_own_voice.sh checks against a voice's tokens before it marks the voice as
+     * reading English this way. Japanese pieces give Open JTalk's phonemes, which every
+     * voice of hers has.
+     */
+    fun symbols(): Set<Int> {
+        val texts = ArrayList<String>()
+        texts += vowels.values
+        texts += consonants.values
+        texts += stressMarks.values
+        vowelsByStress.values.forEach { texts += it.values }
+        rVowelBeforeVowel.values.forEach { texts += it.values }
+        weakForms.values.forEach { w -> texts += w.ipa; w.strong?.let { texts += it } }
+        texts += listOf(wordSeparator, clauseMark, afterClause, switchMark, sentenceEndDefault)
+        texts += terminalPunct.values
+        return texts.flatMap { it.codePoints().toArray().asList() }.toSet()
+    }
+
+    companion object {
+        /** Reads the table from its file's bytes (UTF-8 JSON). Throws if it is not one. */
+        fun parse(bytes: ByteArray): EnglishTable {
+            val root = Json.parseToJsonElement(bytes.decodeToString()).jsonObject
+            return EnglishTable(root, sha256Hex(bytes))
+        }
+
+        fun sha256Hex(bytes: ByteArray): String =
+            MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+        /** Python's str.split(): pieces between runs of whitespace, none empty. */
+        internal fun pyWords(s: String): List<String> = s.split(' ', '\t', '\n', '\r').filter { it.isNotEmpty() }
+
+        private fun JsonObject.obj(key: String): JsonObject = this[key]!!.jsonObject
+        private fun JsonObject.array(key: String): JsonArray = this[key]!!.jsonArray
+        private fun JsonObject.string(key: String): String = this[key]!!.jsonPrimitive.content
+        private fun JsonObject.strings(): Map<String, String> = mapValuesOrdered { it.jsonPrimitive.content }
+        private fun JsonArray.stringSet(): Set<String> = mapTo(LinkedHashSet()) { it.jsonPrimitive.content }
+        private fun <T> JsonObject.mapValuesOrdered(f: (kotlinx.serialization.json.JsonElement) -> T): Map<String, T> {
+            val out = LinkedHashMap<String, T>(size * 2)
+            for ((k, v) in this) out[k] = f(v)
+            return out
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/own/JapanesePhonemes.kt b/app/src/main/java/com/opendroid/ai/core/voice/own/JapanesePhonemes.kt
new file mode 100644
index 0000000..da3fb2c
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/own/JapanesePhonemes.kt
@@ -0,0 +1,174 @@
+package com.opendroid.ai.core.voice.own
+
+/**
+ * Open JTalk full-context labels to the phonemes her phone voice was trained on: IPA
+ * plus pitch-accent marks. A line-for-line port of Piper 1.8's `phonemize_japanese.py`
+ * (piper1-gpl 46c3c71), so the phone gives the voice exactly what it learned from.
+ * Tested against that module's own output.
+ *
+ * Prosody marks: ↑ accent rise, ↓ accent fall (the nucleus), # accent phrase boundary,
+ * "," pause, "." end of a statement, "?" end of a question.
+ */
+object JapanesePhonemes {
+
+    const val ACCENT_RISE = "↑"
+    const val ACCENT_FALL = "↓"
+    const val ACCENT_PHRASE_BOUNDARY = "#"
+    const val PAUSE = ","
+    const val DECLARATIVE_END = "."
+    const val INTERROGATIVE_END = "?"
+
+    private val PROSODY_SYMBOLS = setOf(
+        ACCENT_RISE, ACCENT_FALL, ACCENT_PHRASE_BOUNDARY, PAUSE, DECLARATIVE_END, INTERROGATIVE_END
+    )
+
+    /** Open JTalk phone to IPA, as in Piper. Multi-symbol IPA becomes separate phonemes. */
+    val OPENJTALK_TO_IPA: Map<String, String> = mapOf(
+        "a" to "a", "i" to "i", "u" to "ɯ", "e" to "e", "o" to "o",
+        "k" to "k", "ky" to "kʲ", "kw" to "kʷ",
+        "g" to "ɡ", "gy" to "ɡʲ", "gw" to "ɡʷ",
+        "s" to "s", "sh" to "ɕ", "z" to "z", "j" to "dʑ",
+        "t" to "t", "ts" to "ts", "ty" to "tʲ", "ch" to "tɕ",
+        "d" to "d", "dy" to "dʲ",
+        "n" to "n", "ny" to "nʲ",
+        "h" to "h", "hy" to "hʲ", "f" to "ɸ",
+        "b" to "b", "by" to "bʲ", "p" to "p", "py" to "pʲ",
+        "m" to "m", "my" to "mʲ",
+        "y" to "j", "r" to "ɾ", "ry" to "ɾʲ", "w" to "w", "v" to "v",
+        "N" to "ɴ", "cl" to "ʔ"
+    )
+
+    /** Open JTalk writes a devoiced vowel in capitals (desU). */
+    private val DEVOICED_VOWELS = setOf("A", "I", "U", "E", "O")
+
+    private val MORA_FINAL_PHONES = setOf("a", "i", "u", "e", "o", "A", "I", "U", "E", "O", "N", "cl")
+
+    // Python's \s on text is Unicode whitespace; Java's is ASCII unless asked.
+    private val SENTENCE_END = Regex("[。．！？!?]+[」』）】〉》”’\"')\\]\\p{IsWhite_Space}]*")
+
+    private val CURRENT_PHONE = Regex("-(.*?)\\+")
+    private val A1 = Regex("/A:([0-9\\-]+)\\+")
+    private val A2 = Regex("\\+(\\d+)\\+")
+    private val A3 = Regex("\\+(\\d+)/")
+    private val F1 = Regex("/F:(\\d+)_")
+    private val QUESTION = Regex("!(\\d+)_")
+    private const val NO_FEATURE = -50
+
+    /** Splits [text] into sentences, keeping each one's final punctuation (Piper's _split_sentences). */
+    fun splitSentences(text: String): List<String> {
+        val sentences = mutableListOf<String>()
+        var start = 0
+        for (match in SENTENCE_END.findAll(text)) {
+            if (isDecimalPoint(text, match)) continue
+            val sentence = text.substring(start, match.range.last + 1).pyStrip()
+            if (sentence.isNotEmpty()) sentences += sentence
+            start = match.range.last + 1
+        }
+        val tail = text.substring(start).pyStrip()
+        if (tail.isNotEmpty()) sentences += tail
+        return sentences
+    }
+
+    private fun isDecimalPoint(text: String, match: MatchResult): Boolean {
+        if (match.value != ".") return false
+        val before = if (match.range.first > 0) text[match.range.first - 1] else ' '
+        val after = if (match.range.last + 1 < text.length) text[match.range.last + 1] else ' '
+        return before.isDigit() && after.isDigit()
+    }
+
+    /**
+     * One sentence's labels (as Open JTalk made them) to Open JTalk phones plus prosody
+     * marks: Piper's `_phonemize_sentence` after its labels are made.
+     */
+    fun phonesFromLabels(labels: List<String>, dropDevoicedVowels: Boolean = true): List<String> {
+        val phones = mutableListOf<String>()
+        val n = labels.size
+        for ((index, label) in labels.withIndex()) {
+            var phone = CURRENT_PHONE.find(label)?.groupValues?.get(1) ?: continue
+            if (dropDevoicedVowels && phone in DEVOICED_VOWELS) phone = phone.lowercase()
+
+            if (phone == "sil") {
+                // The leading one needs no symbol; the trailing one carries the intonation.
+                if (index == n - 1) {
+                    phones += if (numeric(QUESTION, label) == 1) INTERROGATIVE_END else DECLARATIVE_END
+                }
+                continue
+            }
+            if (phone == "pau") {
+                phones += PAUSE
+                continue
+            }
+            phones += phone
+            if (index >= n - 1) continue
+
+            val a1 = numeric(A1, label)
+            val a2 = numeric(A2, label)
+            val a3 = numeric(A3, label)
+            val f1 = numeric(F1, label)
+            val a2Next = numeric(A2, labels[index + 1])
+
+            if (a3 == 1 && a2Next == 1 && phone in MORA_FINAL_PHONES) {
+                phones += ACCENT_PHRASE_BOUNDARY
+            } else if (a1 == 0 && a2Next == a2 + 1 && a2 != f1) {
+                phones += ACCENT_FALL
+            } else if (a2 == 1 && a2Next == 2) {
+                phones += ACCENT_RISE
+            }
+        }
+        return phones
+    }
+
+    /** Open JTalk phones and marks to the single-codepoint phonemes the voice reads. */
+    fun ipa(phones: List<String>): List<String> {
+        val out = mutableListOf<String>()
+        for (phone in phones) {
+            if (phone in PROSODY_SYMBOLS) {
+                out += phone
+                continue
+            }
+            val ipa = OPENJTALK_TO_IPA[phone] ?: continue
+            var i = 0
+            while (i < ipa.length) {
+                val cp = ipa.codePointAt(i)
+                out += String(Character.toChars(cp))
+                i += Character.charCount(cp)
+            }
+        }
+        return out
+    }
+
+    /**
+     * [text] to one phoneme list per sentence, reading each sentence's labels with
+     * [labelsOf] (Open JTalk on the phone). Sentences that come out empty are dropped,
+     * as in Piper.
+     */
+    fun phonemize(text: String, labelsOf: (String) -> List<String>?): List<List<String>> =
+        splitSentences(text).mapNotNull { sentence ->
+            val labels = labelsOf(sentence) ?: return@mapNotNull null
+            ipa(phonesFromLabels(labels)).takeIf { it.isNotEmpty() }
+        }
+
+    /**
+     * [phonemize] for a line that is said in her voice or not at all: null when a sentence
+     * with something to read in it gives nothing, because Open JTalk refused it or knows
+     * none of it (another script: Cyrillic, Hangul), so that another voice says the line.
+     * A sentence of punctuation alone that gives nothing is dropped, as in [phonemize].
+     */
+    fun phonemizeAll(text: String, labelsOf: (String) -> List<String>?): List<List<String>>? {
+        val out = ArrayList<List<String>>()
+        for (sentence in splitSentences(text)) {
+            val phonemes = labelsOf(sentence)?.let { ipa(phonesFromLabels(it)) }.orEmpty()
+            when {
+                phonemes.isNotEmpty() -> out += phonemes
+                sentence.any { it.isLetterOrDigit() } -> return null
+            }
+        }
+        return out
+    }
+
+    private fun numeric(pattern: Regex, label: String): Int =
+        pattern.find(label)?.groupValues?.get(1)?.toIntOrNull() ?: NO_FEATURE
+
+    /** Python's str.strip(): Unicode whitespace at both ends. */
+    private fun String.pyStrip(): String = trim { Character.isWhitespace(it) || Character.isSpaceChar(it) }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/own/KanaText.kt b/app/src/main/java/com/opendroid/ai/core/voice/own/KanaText.kt
new file mode 100644
index 0000000..bd4e2ec
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/own/KanaText.kt
@@ -0,0 +1,367 @@
+package com.opendroid.ai.core.voice.own
+
+import java.text.Normalizer
+
+/**
+ * Her line, as she types it (mostly English, with Japanese in romaji or in kana), turned
+ * into Japanese text that Open JTalk can read in her voice.
+ *
+ * - Japanese script passes through untouched.
+ * - A romaji word becomes hiragana: maji, dasai, urusee, tch.
+ * - An English word becomes katakana from its dictionary pronunciation (CMU), the way a
+ *   Japanese speaker says it: "smoke" スモーク, "whatever" ワテバー. That is her accent,
+ *   and her voice only knows Japanese sounds.
+ * - A word in neither is read as Japanese would read its letters: "gunnar" グンナー.
+ *
+ * Which reading a Latin word gets: her Japanese words first (some of them are also in the
+ * English dictionary: ne, baka, dame), then her English set phrases, then the
+ * dictionary, then romaji, then the letter-by-letter guess.
+ */
+class KanaText(private val pronunciations: (String) -> List<String>?) {
+
+    /** Converts [typed] (already through the speech normalizer) to text Open JTalk reads. */
+    fun convert(typed: String): String {
+        val text = plainLatin(typed)
+        val out = StringBuilder()
+        var i = 0
+        var lastWasLatinWord = false
+        while (i < text.length) {
+            val c = text[i]
+            when {
+                isLatin(c) -> {
+                    var j = i
+                    while (j < text.length && (isLatin(text[j]) || (text[j] == '\'' && j + 1 < text.length && isLatin(text[j + 1])))) j++
+                    val word = text.substring(i, j)
+                    if (lastWasLatinWord) out.append(' ')
+                    out.append(word(word))
+                    lastWasLatinWord = true
+                    i = j
+                    continue
+                }
+                c == ' ' || c == '\t' -> {
+                    // A space between two English words is kept as a word boundary (Open
+                    // JTalk reads it as none); any other space is dropped.
+                    i++
+                    continue
+                }
+                text.startsWith("...", i) -> { out.append('、'); i += 3; lastWasLatinWord = false; continue }
+                // A decimal point or a thousands comma stays in its number (23.5, 1,299):
+                // Open JTalk reads the number whole, where 。 or 、 would cut it in two.
+                (c == '.' || c == ',') && i > 0 && text[i - 1].isDigit() && i + 1 < text.length && text[i + 1].isDigit() -> {
+                    out.append(c)
+                    lastWasLatinWord = false
+                }
+                else -> {
+                    out.append(PUNCTUATION[c] ?: c)
+                    lastWasLatinWord = false
+                }
+            }
+            i++
+        }
+        return out.toString()
+    }
+
+    /** One Latin-letter word to kana. */
+    fun word(typed: String): String {
+        // A letter held for ever (mmmmm, zzzzzz) is read as held three times: mmm is んー.
+        val raw = HELD_LETTER.replace(typed, "$1$1$1")
+        val lower = raw.lowercase()
+        JAPANESE_WORDS[lower]?.let { return it }
+        ENGLISH_SAYINGS[lower]?.let { return it }
+        if (lower.isEmpty()) return ""
