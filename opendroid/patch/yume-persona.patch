+            "redial", "rebook", "recalculate", "retranslate", "reconvert",
+            "speakerphone", "headphone", "microphone"
+        )
+
+        /**
+         * True when [query] contains a forced-action word at the START of a word.
+         *
+         * These words used to match anywhere, so "ring" fired inside "boring", "text" inside
+         * "context" and "call" inside "basically", and ordinary conversation was sent to the
+         * planner. A word start still catches every inflection ("calling", "texted",
+         * "screenshots") without matching the middle of an unrelated word.
+         */
+        internal fun isForcedAction(query: String): Boolean =
+            FORCED_ACTION_PATTERNS.any { startsAWord(query, it) }
+
+        private fun startsAWord(query: String, pattern: String): Boolean {
+            var from = 0
+            while (true) {
+                val index = query.indexOf(pattern, from, ignoreCase = true)
+                if (index < 0) return false
+                if (index == 0 || !isLatinWordChar(query[index - 1])) return true
+                from = index + 1
+            }
+        }
+
+        /**
+         * Only Latin letters and digits join onto a keyword. Scripts written without
+         * spaces put a keyword straight after their own characters ("打开wifi"), and that
+         * is still the start of the word.
+         */
+        private fun isLatinWordChar(c: Char): Boolean =
+            c.isDigit() || (c.isLetter() && Character.UnicodeScript.of(c.code) == Character.UnicodeScript.LATIN)
+
