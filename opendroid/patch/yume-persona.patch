+    @Test
+    fun `a row about what became of her plan neither hides nor invents a command of his`() {
+        val withdrawn = app(
+            PersonaActionRows.leftGate(PersonaActionRows.LeftGate.LEFT_WAITING, ran = 0, failed = 0),
+            badge = PersonaActionRows.PLAN_BADGE
