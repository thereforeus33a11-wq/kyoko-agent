+package com.opendroid.ai.ui.viewmodel
+
+import com.opendroid.ai.core.llm.error.LLMErrorMapper
+import com.opendroid.ai.core.persona.PictureReading
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What the screen with her pictures tells the owner in words. Kept on this phone is one
+ * thing and shown to her model is another: the screen has to say truthfully where a
+ * picture goes on the route her replies take, and why a button did nothing.
+ */
+class PersonaPicturesViewModelTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    private val hosted = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-vision-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatSeesImages = true
+    )
+
+    private fun says(config: LLMConfig) = PersonaPicturesViewModel.whereAPictureGoes(config)
+
+    @Test
+    fun `a hosted model's provider can see a picture she is shown, and the screen says so`() {
+        val line = says(hosted)
+        assertTrue(line, line.contains("is hosted"))
+        assertTrue(line, line.contains("its provider can read what it is sent, the picture included"))
+        // Private mode keeps his details back there, not her pictures: the line is the same.
+        assertEquals(line, says(hosted.copy(privateMode = true)))
+        assertEquals(line, says(hosted.copy(privateMode = false)))
+    }
+
+    @Test
+    fun `on his own hardware the picture stays his`() {
+        val ownNetwork = says(hosted.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:8080/v1")))
+        assertTrue(ownNetwork, ownNetwork.contains("on your own network"))
+        assertTrue(ownNetwork, ownNetwork.contains("stays on your own machine"))
+        assertFalse(ownNetwork, ownNetwork.contains("hosted"))
+
+        // A model server running on the phone itself, behind the OpenAI-compatible provider.
+        val onPhone = says(hosted.copy(customEndpoints = mapOf(custom to "http://127.0.0.1:8080/v1")))
+        assertTrue(onPhone, onPhone.contains("on this phone"))
+        assertTrue(onPhone, onPhone.contains("It does not leave the phone."))
+    }
+
+    @Test
+    fun `a provider that cannot pass a picture on is named, and nothing is claimed to be sent`() {
+        val inApp = says(LLMConfig(activeProvider = "On-Device AI", personaChatSeesImages = true))
+        assertTrue(inApp, inApp.contains("(On-Device AI) cannot pass a picture on to its model"))
+        assertTrue(inApp, inApp.contains("from the captions"))
+        assertFalse(inApp, inApp.contains("It does not leave the phone."))
+        assertFalse(inApp, inApp.contains("Ollama"))
+
+        val ollama = says(hosted.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434"))
+        assertTrue(ollama, ollama.contains("(Ollama) cannot pass a picture on to its model"))
+        // And he is told the way that does work with the same machine.
+        assertTrue(ollama, ollama.contains("through Custom OpenAI Compatible"))
+        assertTrue(ollama, ollama.contains("/v1"))
+    }
+
+    @Test
+    fun `where no picture is sent the screen says that she is told in words instead`() {
+        val encrypted = says(hosted.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p"))
+        assertTrue(encrypted, encrypted.contains("end to end encrypted"))
+        assertTrue(encrypted, encrypted.contains("carries no pictures"))
+        assertTrue(encrypted, encrypted.contains("from the captions"))
+
+        val switchedOff = says(hosted.copy(personaChatSeesImages = false))
+        assertTrue(switchedOff, switchedOff.contains("is not set to read images"))
+        assertTrue(switchedOff, switchedOff.contains("\"Her model can see screenshots\""))
+        assertTrue(switchedOff, switchedOff.contains("from the captions"))
+        assertFalse(switchedOff, switchedOff.contains("is sent to"))
+    }
+
+    @Test
+    fun `a route his privacy setting refuses gets no picture, and the screen says that instead`() {
+        val refused = says(hosted.copy(routePolicy = RoutePolicy.ENCRYPTED))
+        assertTrue(refused, refused.contains("a route your privacy setting refuses"))
+        assertTrue(refused, refused.contains("nothing is sent to it"))
+        assertFalse(refused, refused.contains("is sent to the model"))
+
+        // Own hardware only: an encrypted model is refused as well.
+        val encryptedRefused = says(
+            hosted.copy(routePolicy = RoutePolicy.OWN_HARDWARE, personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        )
+        assertTrue(encryptedRefused, encryptedRefused.contains("a route your privacy setting refuses"))
+    }
+
+    @Test
+    fun `the reasons under the two disabled buttons are the ones the owner can act on`() {
+        assertEquals(
+            "Her model cannot be sent pictures on this route (the encrypted route carries none). " +
+                "Type what is on it, or give her replies a model that reads images.",
+            PersonaPicturesViewModel.CANNOT_LOOK_REASON
+        )
+        assertTrue(PersonaPicturesViewModel.CANNOT_READ_REASON.contains("the encrypted route carries none"))
+        assertTrue(PersonaPicturesViewModel.CANNOT_READ_REASON.contains("Type the text yourself"))
+    }
+
+    @Test
+    fun `a look that came to nothing is told in one plain line that says nothing was changed`() {
+        fun line(reason: PictureReading.Reason) =
+            PersonaPicturesViewModel.failureLine(PictureReading.Failed(reason), "The caption is unchanged.")
+
+        val lines = PictureReading.Reason.entries.associateWith(::line)
+        for ((reason, text) in lines) {
+            assertTrue("$reason: $text", text.endsWith(" The caption is unchanged."))
+            assertFalse("$reason: $text", text.contains('\n'))
+        }
+        // Each reason reads differently, so he can tell them apart.
+        assertEquals(lines.size, lines.values.toSet().size)
+        assertTrue(lines.getValue(PictureReading.Reason.DECLINED).contains("declined to look"))
+        assertTrue(lines.getValue(PictureReading.Reason.TOOK_TOO_LONG).contains("took too long"))
+        assertTrue(lines.getValue(PictureReading.Reason.EMPTY).contains("sent nothing back"))
+        assertTrue(lines.getValue(PictureReading.Reason.SHE_IS_OFF).contains("switched off"))
+        assertTrue(lines.getValue(PictureReading.Reason.NO_PICTURES_ON_THIS_ROUTE).contains("Not sent"))
+    }
+
+    @Test
+    fun `a route his privacy setting refuses is named as that, with what to do about it`() {
+        val refused = PictureReading.Failed(
+            PictureReading.Reason.CALL_FAILED,
+            LLMErrorMapper.privateRouteRequired("OpenAI", "gpt-4o")
+        )
+
+        val line = PersonaPicturesViewModel.failureLine(refused, "The text below is unchanged.")
+
+        assertTrue(line, line.startsWith("Not sent: OpenAI could read it."))
+        assertTrue(line, line.contains("Your privacy setting does not allow this model's route."))
+        assertTrue(line, line.endsWith(" The text below is unchanged."))
+    }
+
+    @Test
+    fun `once her model has turned a picture down the screen no longer says she is sent one`() {
+        val line = PersonaPicturesViewModel.whereAPictureGoes(hosted, refusedByHerModel = true)
+        assertTrue(line, line.contains("would not take the last picture of her it was sent"))
+        assertTrue(line, line.contains("wrote that reply without it"))
+        assertTrue(line, line.contains("she is told in words what is on them, from the captions"))
+        // What he can do about it, either way.
+        assertTrue(line, line.contains("\"Her model can see screenshots\""))
+        assertTrue(line, line.contains("\"Let her look\""))
+        assertFalse(line, line.contains("When she is shown a picture of herself"))
+        // The same on his own hardware: it is about the model, not about who can read it.
+        val ownNetwork = hosted.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:8080/v1"))
+        assertEquals(line, PersonaPicturesViewModel.whereAPictureGoes(ownNetwork, refusedByHerModel = true))
+        // Without it the line is the one about the route, as before.
+        assertEquals(says(hosted), PersonaPicturesViewModel.whereAPictureGoes(hosted, refusedByHerModel = false))
+
+        // Where no picture is sent anyway, that reason comes first: it is the one that holds.
+        val encrypted = hosted.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertEquals(says(encrypted), PersonaPicturesViewModel.whereAPictureGoes(encrypted, refusedByHerModel = true))
+        val switchedOff = hosted.copy(personaChatSeesImages = false)
+        assertEquals(says(switchedOff), PersonaPicturesViewModel.whereAPictureGoes(switchedOff, refusedByHerModel = true))
+    }
+
+    @Test
+    fun `the line after Save says whether the text reaches her, which hangs on the switch`() {
+        fun saved(ownWording: Boolean, herFilesHaveText: Boolean = true, inHerPrompt: Boolean) =
+            PersonaPicturesViewModel.savedLine(ownWording, herFilesHaveText, inHerPrompt)
+
+        assertEquals(
+            "Saved. This is what lies under her awareness from her next reply on.",
+            saved(ownWording = true, inHerPrompt = true)
+        )
+        val off = saved(ownWording = true, inHerPrompt = false)
+        assertEquals(
+            "Saved. It is left out of her prompt while \"Keep this under her awareness in every reply\" is off.",
+            off
+        )
+        // With the switch off nothing may claim that the text lies under her awareness or applies.
+        assertFalse(off, off.contains("lies under her awareness"))
+
+        // An empty text is not a wording: saving it removes his.
+        assertEquals(
+            "An empty text was saved. Your wording is removed. The text from her files applies again.",
+            saved(ownWording = false, inHerPrompt = true)
+        )
+        val emptyAndOff = saved(ownWording = false, inHerPrompt = false)
+        assertTrue(emptyAndOff, emptyAndOff.contains("is the one kept"))
+        assertTrue(emptyAndOff, emptyAndOff.contains("is off"))
+        assertFalse(emptyAndOff, emptyAndOff.contains("applies again"))
+        val nothingLeft = saved(ownWording = false, herFilesHaveText = false, inHerPrompt = true)
+        assertTrue(nothingLeft, nothingLeft.contains("nothing lies under her awareness"))
+    }
+
+    @Test
+    fun `the line after going back to the text from her files says the same true thing`() {
+        assertEquals(
+            "Your wording is removed. The text from her files applies again.",
+            PersonaPicturesViewModel.removedLine(herFilesHaveText = true, inHerPrompt = true)
+        )
+        val off = PersonaPicturesViewModel.removedLine(herFilesHaveText = true, inHerPrompt = false)
+        assertTrue(off, off.startsWith("Your wording is removed. The text from her files is the one kept."))
+        assertTrue(off, off.contains("is off"))
+        assertFalse(off, off.contains("applies again"))
+        // A build without such a text has nothing under her awareness, whatever the switch says.
+        for (inHerPrompt in listOf(true, false)) {
+            val none = PersonaPicturesViewModel.removedLine(herFilesHaveText = false, inHerPrompt = inHerPrompt)
+            assertTrue(none, none.contains("nothing lies under her awareness"))
+        }
+    }
+
+    @Test
+    fun `after a reading he is told that what he had typed can be brought back`() {
+        val overTyping = PersonaPicturesViewModel.readLine(replacedUnsavedTyping = true)
+        assertTrue(overTyping, overTyping.contains("nothing is saved until you press Save"))
+        assertTrue(overTyping, overTyping.contains("What you had typed is not lost"))
+        assertTrue(overTyping, overTyping.contains("\"Undo the reading\""))
+
+        val overSaved = PersonaPicturesViewModel.readLine(replacedUnsavedTyping = false)
+        assertTrue(overSaved, overSaved.contains("\"Undo the reading\" puts back what the box held before"))
+        assertFalse(overSaved, overSaved.contains("What you had typed"))
+    }
+
+    @Test
+    fun `white space he adds to a caption is not a change to save`() {
+        val stored = "nails,\ngold tips"
+        for (same in listOf(stored, "nails,\ngold tips ", " nails,\ngold tips", "nails,\ngold tips\n", "nails,\n\ngold tips\n\n", "nails,  \n  gold tips")) {
+            assertFalse(same, PersonaPicturesViewModel.captionChanged(same, stored))
+        }
+        for (other in listOf("nails, gold tips", "nails,\ngold tips!", "", "Nails,\ngold tips")) {
+            assertTrue(other, PersonaPicturesViewModel.captionChanged(other, stored))
+        }
+        // No caption yet, and only white space typed: nothing to save.
+        assertFalse(PersonaPicturesViewModel.captionChanged("  \n", ""))
+        assertTrue(PersonaPicturesViewModel.captionChanged("x", ""))
+    }
+}
