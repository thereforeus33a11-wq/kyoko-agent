+    private val MODEL_ID = Regex("""^[a-z0-9][a-z0-9._:-]{1,79}$""")
+
+    /** What the live check says of [model], or null when it was not made or does not name it. */
+    fun live(config: LLMConfig, model: String): Listed? =
+        config.veniceTiers[model.trim().lowercase()]?.let(::decode)
