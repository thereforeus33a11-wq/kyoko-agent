+        val page = Readable.page(html, "https://example.org/wiki/Ganguro")
+        val paragraphs = page.text.split("\n\n")
+        assertTrue(paragraphs.indexOfFirst { it.startsWith("Ganguro is a fashion") } < paragraphs.indexOfFirst { it.startsWith("Magazines such as egg") })
