+        assertTrue(prompt(ownPictureAttached = true, ownPictureCaption = "thats me. obviously!").contains("Its caption: thats me. obviously! It is you"))
+        assertTrue(prompt(ownPictureAttached = true, ownPictureCaption = "tongue out ♡").contains("Its caption: tongue out ♡ It is you"))
+    }
+
+    @Test
