diff --git a/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt b/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt
new file mode 100644
index 0000000..c475616
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt
@@ -0,0 +1,210 @@
+package com.opendroid.ai.actions
+
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.agent.AutomatedSender
+import com.opendroid.ai.core.agent.PlanWords
+import com.opendroid.ai.core.record.SequenceRun
+import com.opendroid.ai.data.db.entities.MacroEntity
+import com.opendroid.ai.data.models.BuildSwitchOffs
+import com.opendroid.ai.data.models.PlanStep
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.json.Json
+
+/**
+ * What a saved macro may run, decided before anything of it runs.
+ *
+ * Whoever is on, a step that switches auto-reply ([BuildSwitchOffs]) is skipped with the
+ * plain line: auto-reply is off in this build, so that step has nothing to do, and the
+ * macro he saved before the update still runs the rest instead of stopping there.
+ *
+ * While she is on, two checks more (plan rules 3 and 7). A macro he switched off does not
+ * run at all, and says so. Of one that is on, every step is addressed the way a step of a
+ * plan is ([PlanWords.withoutAutomated], [AutomatedSender]): one that would message, email,
+ * invite or open a compose link for nobody but an address or number that only sends (a
+ * no-reply address, a short code, a sender ID, a bot) is skipped with the plain reason;
+ * one that also reaches people runs without the address that only sends (someone copied
+ * in or invited); and one whose fallback alone would send to such an address runs without
+ * its fallback. With her off the app is stock, so neither check is made: a switched-off
+ * macro runs, as it always did, and so does a text to a short code.
+ *
+ * A step that uses what a skipped step would have returned is skipped too. The rest runs
+ * as saved, and the macro's result names every step that was skipped or changed, and why.
+ * So does the record of what the phone did ([onRecord]): a skipped step is on it as not
+ * run, and why.
+ *
+ * A call is never skipped, and neither is a text to an emergency number: an emergency line
+ * is not a sender that only sends ([AutomatedSender] decides that, for plans and macros alike).
+ */
+internal object MacroRun {
+
+    /** The action that switched auto-reply on or off; this build has no auto-reply. */
+    private const val AUTO_REPLY_TOGGLE = "AUTO_REPLY_TOGGLE"
+
+    // The same resolver the dispatcher runs, so an alias is judged as what it will do.
+    private val autoMapper = ActionAutoMapper()
+
+    // The same reading of the stored steps RUN_MACRO makes.
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /**
+     * The steps [macro] stores, read the way RUN_MACRO reads them, or null when there are
+     * none it could run: no step data, or data that cannot be read. RUN_MACRO refuses such
+     * a macro, so nothing of it runs.
+     */
+    fun storedSteps(macro: MacroEntity): List<PlanStep>? {
+        if (macro.stepsJson.isBlank()) return null
+        return try {
+            json.decodeFromString<List<PlanStep>>(macro.stepsJson)
+        } catch (e: IllegalArgumentException) {
+            // A SerializationException is one: the data cannot be read as steps.
+            null
+        }
+    }
+
+    /** The line for a macro he switched off. */
+    fun switchedOffLine(name: String): String = "Macro '$name' is switched off, so it did not run."
+
+    /** A step left out of the run, with its place in the macro (counted from 1) and the plain reason. */
+    data class Skipped(val number: Int, val action: String, val reason: String) {
+        val line: String get() = "Step $number ($action) was skipped: ${reason.trimEnd('.')}."
+    }
+
+    /**
+     * A step that runs with an address that only sends taken off it ([reason] names the
+     * address), or, with [fallback], without the fallback that would have sent to one.
+     */
+    data class TakenOff(val number: Int, val action: String, val reason: String, val fallback: Boolean = false) {
+        val line: String
+            get() = if (fallback) {
+                "Step $number ($action): ${reason.trimEnd('.')}, so its fallback was taken off."
+            } else {
+                "Step $number ($action): ${reason.trimEnd('.')}, so it was taken off this step."
+            }
+    }
+
+    /**
+     * The steps that run, in the macro's order and as they will run, and those that were
+     * skipped. [numbers] holds each running step's place in the macro, counted from 1, so a
+     * result can name it so. [takenOff] are the running steps that lost an address or a
+     * fallback on the way.
+     */
+    data class Sorted(
+        val toRun: List<PlanStep>,
+        val skipped: List<Skipped>,
+        val numbers: List<Int> = toRun.indices.map { it + 1 },
+        val takenOff: List<TakenOff> = emptyList()
+    )
+
+    /**
+     * The macro does not run at all: she is on ([herOn]) and he switched it off. Null when
+     * it may run. With her off a switched-off macro runs, as in the stock app.
+     */
+    fun refusal(macro: MacroEntity, herOn: Boolean): ActionResult? =
+        if (!herOn || macro.isEnabled) null else ActionResult.Failure(errorMsg = switchedOffLine(macro.name))
+
+    /**
+     * Splits [steps] into what runs and what is skipped, in the order the macro runs them.
+     * A step that switches auto-reply is skipped whoever is on. While she is on ([herOn])
+     * every step is addressed as a plan's step is ([PlanWords.withoutAutomated]): one sent
+     * to nobody but a sender that only sends is skipped, and one that also reaches people,
+     * or whose fallback alone would send to such a sender, runs without that address or
+     * that fallback.
+     */
+    fun sort(steps: List<PlanStep>, herOn: Boolean): Sorted {
+        val ordered = steps.sortedWith(compareBy<PlanStep> { it.order })
+        val toRun = mutableListOf<PlanStep>()
+        val numbers = mutableListOf<Int>()
+        val skipped = mutableListOf<Skipped>()
+        val takenOff = mutableListOf<TakenOff>()
+        val skippedIds = mutableListOf<String>()
+        ordered.forEachIndexed { index, step ->
+            val action = step.action.ifBlank { "unknown action" }
+            val switchesAutoReply = runsAs(step) == AUTO_REPLY_TOGGLE
+            val addressed = if (herOn && !switchesAutoReply) PlanWords.withoutAutomated(step) else null
+            val reason = (if (switchesAutoReply) BuildSwitchOffs.AUTO_REPLY_OFF else null)
+                ?: addressed?.takeIf { it.step == null }?.let { gone -> gone.taken.joinToString("; ") { it.reason } }
+                ?: skippedIds.firstOrNull { usesResultOf(step, it) }
+                    ?.let { "it uses what a skipped step would have returned" }
+            if (reason == null) {
+                toRun += addressed?.step ?: step
+                numbers += index + 1
+                if (addressed != null && addressed.taken.isNotEmpty()) {
+                    takenOff += if (addressed.fallbackTakenOff) {
+                        listOf(TakenOff(index + 1, action, addressed.taken.joinToString("; ") { it.reason }, fallback = true))
+                    } else {
+                        addressed.taken.map { TakenOff(index + 1, action, it.reason) }
+                    }
+                }
+            } else {
+                skipped += Skipped(index + 1, action, reason)
+                if (step.stepId.isNotBlank()) skippedIds += step.stepId
+            }
+        }
+        return Sorted(toRun, skipped, numbers, takenOff)
+    }
+
+    /**
+     * [result] of the steps that ran, with every step that was skipped or changed named
+     * after it, in the macro's order. The runner counts only the steps it was given, so a
+     * step it stopped at is named by its place in the macro instead. A refusal he gave is
+     * passed on as it is.
+     */
+    fun withSkips(result: ActionResult, sorted: Sorted): ActionResult {
+        if (sorted.skipped.isEmpty() && sorted.takenOff.isEmpty()) return result
+        val notes = sorted.skipped.map { it.number to it.line } + sorted.takenOff.map { it.number to it.line }
+        val lines = notes.sortedBy { it.first }.joinToString(" ") { it.second }
+        return when (result) {
+            is ActionResult.Success -> ActionResult.Success(
+                result.dataMap + ("message" to listOfNotNull(result.data, lines).joinToString(" "))
+            )
+            is ActionResult.Failure -> result.copy(errorMsg = "${inMacroNumbers(result.errorMsg, sorted.numbers)} $lines")
+            else -> result
+        }
+    }
+
+    private val STOPPED_AT = Regex("""^Macro stopped at step (\d+) \(""")
+
+    private fun inMacroNumbers(error: String, numbers: List<Int>): String = STOPPED_AT.replace(error) { match ->
+        val number = match.groupValues[1].toInt().let { numbers.getOrNull(it - 1) ?: it }
+        "Macro stopped at step $number ("
+    }
+
+    /** What a macro whose every step was skipped returns: it did nothing, and says why. */
+    fun nothingRan(name: String, skipped: List<Skipped>): ActionResult =
+        ActionResult.Failure(errorMsg = "Macro '$name' did not run: ${skipped.joinToString(" ") { it.line }}")
+
+    /**
+     * The run of macro [name] as the record of what the phone did is handed it: the steps
+     * [sorted] skipped of [steps] go with it, each in its place and with its reason, so the
+     * record tells them as not run, next to what the rest of the macro did.
+     */
+    fun onRecord(name: String, steps: List<PlanStep>, sorted: Sorted): SequenceRun {
+        // The same order sort() numbered them in.
+        val ordered = steps.sortedWith(compareBy<PlanStep> { it.order })
+        return SequenceRun.macro(
+            name,
+            leftOut = sorted.skipped.mapNotNull { skipped ->
+                ordered.getOrNull(skipped.number - 1)?.let { SequenceRun.LeftOut(skipped.number, it, recordReason(skipped.reason)) }
+            }
+        )
+    }
+
+    /**
+     * [reason] as the record puts it. The record is told to her, so the line that speaks to
+     * him ("nothing answers messages for you") is said of the build instead.
+     */
+    private fun recordReason(reason: String): String =
+        if (reason == BuildSwitchOffs.AUTO_REPLY_OFF) AUTO_REPLY_OFF_ON_RECORD else reason.trimEnd('.')
+
+    private const val AUTO_REPLY_OFF_ON_RECORD = "auto-reply is off in this build"
+
+    /** The action's own name, as the dispatcher will run [step]. */
+    private fun runsAs(step: PlanStep): String =
+        (autoMapper.mapAction(step.action, step.params, emptySet()).mappedAction ?: step.action).trim().uppercase()
+
+    // "$id" and "$$id" are filled in from that step's result; "$s1" is not read out of "$s10".
+    private fun usesResultOf(step: PlanStep, stepId: String): Boolean {
+        val reference = Regex("""\$\$?${Regex.escape(stepId)}(?![A-Za-z0-9_])""")
+        return step.params.values.any { reference.containsMatchIn(it) }
+    }
+}
