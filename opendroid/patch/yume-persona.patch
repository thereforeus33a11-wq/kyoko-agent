+    @Test
+    fun `a reply of hers loses the app's marks and what a model wrote on in his name, and nothing else`() {
+        fun unfold(reply: String) = VeniceE2eeMessages.unfoldReply(reply, marked = true)
+        assertEquals("fine. whatever", unfold("[you] fine. whatever"))
+        assertEquals("fine. whatever", unfold("  [You]fine. whatever"))
+        // The model wrote his next line and an answer to it: the transcript, not her reply.
+        assertEquals("fine", unfold("fine\n[he] are you mad\n[you] no"))
+        assertEquals("fine\nreally", unfold("[you] fine\nreally\n  [He] sure?\n[you] yes\n[he] ok"))
+        // It wrote his next line and stopped there, or ran out of length inside it: a
+        // question he never asked is not kept under her name.
+        assertEquals("fine. its done", unfold("fine. its done\n[he] and the other one?"))
+        assertEquals("fine. its done", unfold("[you] fine. its done\n\n[he] and the oth"))
+        assertEquals("fine\n>> open the map", unfold("fine\n>> open the map\n[he] wai"))
+        // It said his last line over before it answered: her reply is what follows her mark.
+        assertEquals("what", unfold("[he] hello?\n[you] what"))
+        assertEquals("obviously", unfold("[he] did you feed the bees\n[you] obviously"))
+        assertEquals("obviously", unfold("  [He] did you feed the bees\n[he] well?\n  [You]   obviously\n[he] good\n[you] mm"))
+        assertEquals("two lines\nof hers", unfold("[you] [he] hello?\n[you] two lines\nof hers"))
+        // A reply is never turned into nothing: with no line of hers in it, it is handed on as it came.
+        assertEquals("[he] hello?", unfold("[he] hello?"))
+        assertEquals("[he] hello?\n[he] anyone", unfold("[you] [he] hello?\n[he] anyone"))
+        assertEquals("[he] hello?\n[you]", unfold("[he] hello?\n[you]"))
+        assertEquals("[he] hello?\n[you]  \n[he] well", unfold("[he] hello?\n[you]  \n[he] well"))
