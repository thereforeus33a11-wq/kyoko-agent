+        val kept = (1..4).map { app("Planner's reason: the battery is above 20", badge = PersonaPrompts.PLANNER_BADGE) } +
+            (1..3).map { app(goesOn + "fine so far", badge = PersonaPrompts.appRowBadge(true, PersonaPrompts.PLANNER_BADGE)) }
+        val lines = PersonaPrompts.shapeHistory(kept, holdBackPrivateResults = true).deviceActivity
+        assertEquals(4, lines.count { it.contains("the battery is above 20") })
+        assertEquals(2, lines.count { it.contains(PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER) })
