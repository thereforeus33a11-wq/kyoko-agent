+    fun `his voice after a long quiet brings her next moment sooner, and the moment says why`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        runBlocking {
+            memory.saveOwnTime(State(on = true, wake = Wake.At(now + 3 * hour), why = Why.ASKED, lastAtMillis = now - hour, moments = listOf(now - hour)))
+            engine.ownTimeOnHearingHim(heLastWroteAt = now - 5 * hour, nowMillis = now)
+        }
+        val state = runBlocking { memory.ownTime() }
+        assertEquals(Why.HEARD_HIM, state.why)
+        assertEquals(Wake.At(now + PersonaOwnTime.UNLOCK_SOON_MILLIS), state.wake)
+        assertEquals(now + 3 * hour, state.broughtFromAt)
+        assertEquals(now + PersonaOwnTime.UNLOCK_SOON_MILLIS, alarms.last())
+        // He wrote before it came: the time it had comes back.
+        assertEquals(Wake.At(now + 3 * hour), PersonaOwnTime.setBack(state, now + minute, PersonaOwnTime.Bounds.of(config))!!.wake)
+        // The moment says why it came sooner, as P3-2 has it.
+        val facts = PersonaOwnTime.MomentFacts(
+            why = Why.HEARD_HIM, actionsEnabled = true, rein = PersonaRein.ASK, notificationShowsWords = false,
+            bounds = PersonaOwnTime.Bounds.of(config), number = 2, hisClock = "Tuesday 22:10", tokyoClock = "Wednesday 07:10",
+            heLastWrote = "5 h ago", lastMoment = "1 h ago", lastDid = PersonaOwnTime.Did.KEPT, lastHadCommand = false, moved = null,
