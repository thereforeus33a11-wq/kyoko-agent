@@ -0,0 +1,253 @@
+package com.opendroid.ai.core.persona
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.update
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Where the character card comes from: a text file bundled with the app, or the
+ * owner's edited copy when one has been saved from the Persona screen.
+ *
+ * The card is read once and kept in memory; it is a few kilobytes of text that is
+ * needed on every chat reply.
+ *
+ * A saved edit takes the place of the built-in card for good, so next to it the store
+ * keeps which built-in card the edit was made on ([editBase]). When a later version of
+ * the app ships another one, the screens can say so instead of letting the old edit
+ * shadow it in silence.
+ */
+@Singleton
+class PersonaStore internal constructor(
+    private val context: Context,
+    // Reads a file that ships with the app, or "" when the build has none; replaced in tests.
+    private val shipped: (String) -> String
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(context, { path -> readAsset(context, path) })
+
+    // One lock for reading and writing the card, so a reply never reads a half-written edit.
+    private val lock = Any()
+    private var cachedCard: String? = null
+
+    // What ships with an installed app does not change while it runs.
+    private val bundled: String by lazy { shipped("$DIRECTORY/$CARD_FILE") }
+
+    private val changeCount = MutableStateFlow(0)
+
+    /**
+     * Counts up whenever the saved edit is written, removed or confirmed. Whether she is
+     * the one who talks depends on a card being there, so a screen that shows it watches
+     * this beside the settings.
+     */
+    val changes: StateFlow<Int> = changeCount
+
+    private val overrideFile: File
+        get() = File(File(context.filesDir, DIRECTORY), CARD_FILE)
+
+    private val baseFile: File
+        get() = File(File(context.filesDir, DIRECTORY), CARD_BASE_FILE)
+
+    /** The card in use: the owner's saved copy if there is one, otherwise the bundled one. */
+    fun card(): String = synchronized(lock) {
+        cachedCard ?: (readOverride() ?: bundledCard()).also { cachedCard = it }
+    }
+
+    /** The card as shipped, ignoring any saved edit. Empty when the build has none. */
+    fun bundledCard(): String = bundled
+
+    fun hasOverride(): Boolean = overrideFile.isFile
+
+    /**
+     * Saves the owner's edited card. A blank text removes the edit and restores the
+     * bundled card.
+     *
+     * The text is written to a file beside the card and moved into place, so the card on
+     * disk is always either the old one or the new one, whole. A first edit records the
+     * built-in card it was made on. Saving again keeps that record: the edit still stands
+     * on the older built-in card until the owner says which of the two he wants.
+     *
+     * @throws IOException when the edit could not be written or removed. The card in use
+     *   is then unchanged.
+     */
+    @Throws(IOException::class)
+    fun saveCard(text: String) {
+        synchronized(lock) {
+            val file = overrideFile
+            if (text.isBlank()) {
+                if (file.exists() && !file.delete()) throw IOException("The saved card could not be removed")
+                baseFile.delete()
+            } else {
+                val firstEdit = !file.isFile
+                writeWhole(file, text.trim() + "\n")
+                if (firstEdit) recordBase()
+            }
+            cachedCard = null
+        }
+        changeCount.update { it + 1 }
+    }
+
+    /** What a saved edit is to the card that ships with this version of the app. */
+    enum class EditBase {
+        /** There is no saved edit, or this build ships no card to hold it against. */
+        NONE,
+
+        /** The edit was made on the built-in card as it is now, or says the same. */
+        CURRENT,
+
+        /** The built-in card has changed since the edit was saved. */
+        CHANGED,
+
+        /** The edit was saved before the app kept this record, so it cannot tell. */
+        UNKNOWN
+    }
+
+    fun editBase(): EditBase = synchronized(lock) {
+        val edit = readOverride() ?: return EditBase.NONE
+        val shipped = bundledCard()
+        if (shipped.isBlank()) return EditBase.NONE
+        if (edit.trim() == shipped.trim()) return EditBase.CURRENT
+        val recorded = readBase() ?: return EditBase.UNKNOWN
+        if (recorded == fingerprint(shipped)) EditBase.CURRENT else EditBase.CHANGED
+    }
+
+    /**
+     * The owner keeps his edit although the built-in card is another one now. The
+     * built-in card of this version is recorded as the one the edit stands against, so
+     * the notice is not shown again until it changes once more.
+     */
+    @Throws(IOException::class)
+    fun keepEdit() {
+        synchronized(lock) {
+            if (!overrideFile.isFile) return
+            writeWhole(baseFile, fingerprint(bundledCard()) + "\n")
+        }
+        changeCount.update { it + 1 }
+    }
+
+    private val underFile: File
+        get() = File(File(context.filesDir, DIRECTORY), UNDER_FILE)
+
+    /**
+     * The owner's own wording of what lies under her awareness (what made her the way
+     * she is), or null when he has saved none and the text from her files applies.
+     */
+    fun savedUnderText(): String? = try {
+        underFile.takeIf { it.isFile }?.readText()?.takeIf { it.isNotBlank() }
+    } catch (e: Exception) {
+        Log.w(TAG, "Saved under-text could not be read; using the one from her files.")
+        null
+    }
+
+    /**
+     * Saves his wording. A blank text removes it, which brings back the text from her files.
+     *
+     * Like the card, the text is written beside the file and moved into place: a write
+     * that fails part-way (storage that is full) must not empty the wording he saved
+     * before, which she would then lose for the text from her files without a word.
+     *
+     * @throws IOException when the wording could not be written. The one saved before is
+     *   then unchanged.
+     */
+    @Throws(IOException::class)
+    fun saveUnderText(text: String) {
+        // One at a time: two saves share the file the text is written to before it is moved.
+        synchronized(lock) {
+            val file = underFile
+            if (text.isBlank()) {
+                file.delete()
+            } else {
+                writeWhole(file, text.trim() + "\n")
+            }
+        }
+    }
+
+    /** The notes she starts with, from the bundled seed file. */
+    fun seedNotes(): List<PersonaNotes.Note> = PersonaNotes.parse(shipped("$DIRECTORY/$SEED_FILE"))
+
+    /**
+     * The wordings her starting notes had in older builds, from the bundled file beside the
+     * seed file, for [PersonaMemory.refreshStartingNotes]. Every line that reads as a note
+     * counts, so a key can have several. Empty when the build ships none, or it cannot be read.
+     */
+    fun previousSeedNotes(): List<PersonaNotes.Note> = try {
+        shipped("$DIRECTORY/$PREVIOUS_SEED_FILE").lineSequence().mapNotNull { PersonaNotes.parseLine(it) }.toList()
+    } catch (e: Exception) {
+        Log.w(TAG, "Earlier wordings of the starting notes could not be read: ${e.javaClass.simpleName}")
+        emptyList()
+    }
+
+    private fun readOverride(): String? = try {
+        overrideFile.takeIf { it.isFile }?.readText()?.takeIf { it.isNotBlank() }
+    } catch (e: Exception) {
+        Log.w(TAG, "Saved persona card could not be read; using the bundled one.")
+        null
+    }
+
+    private fun readBase(): String? = try {
+        baseFile.takeIf { it.isFile }?.readText()?.trim()?.takeIf { it.isNotEmpty() }
+    } catch (e: Exception) {
+        null
+    }
+
+    /**
+     * Records the built-in card of this version as the one a new edit was made on. If
+     * that cannot be written, no record is better than an old one: the screens then say
+     * they cannot tell, which is true.
+     */
+    private fun recordBase() {
+        try {
+            writeWhole(baseFile, fingerprint(bundledCard()) + "\n")
+        } catch (e: IOException) {
+            baseFile.delete()
+            Log.w(TAG, "The built-in card an edit was made on could not be recorded.")
+        }
+    }
+
+    /** Writes [text] beside [target] and moves it into place, so [target] is never seen half-written. */
+    private fun writeWhole(target: File, text: String) {
+        val directory = target.parentFile ?: throw IOException("No directory to write ${target.name} to")
+        if (!directory.isDirectory && !directory.mkdirs()) throw IOException("The directory for ${target.name} could not be made")
+        val draft = File(directory, target.name + ".tmp")
+        try {
+            FileOutputStream(draft).use { out ->
+                out.write(text.toByteArray(Charsets.UTF_8))
+                out.fd.sync()
+            }
+            if (!draft.renameTo(target)) throw IOException("${target.name} could not be put in place")
+        } finally {
+            // Gone already when the move worked; left over when it did not.
+            draft.delete()
+        }
+    }
+
+    /** SHA-256 of [text] in hex: enough to tell one built-in card from another without keeping a copy. */
+    private fun fingerprint(text: String): String =
+        MessageDigest.getInstance("SHA-256").digest(text.toByteArray(Charsets.UTF_8))
+            .joinToString("") { byte -> ((byte.toInt() and 0xff) + 0x100).toString(16).substring(1) }
+
+    private companion object {
+        const val TAG = "PersonaStore"
+        const val DIRECTORY = "persona"
+        const val CARD_FILE = "card.md"
+        const val CARD_BASE_FILE = "card.base"
+        const val SEED_FILE = "seed_notes.txt"
+        const val PREVIOUS_SEED_FILE = "seed_notes.previous.txt"
+        const val UNDER_FILE = "under.txt"
+
+        fun readAsset(context: Context, path: String): String = try {
+            context.assets.open(path).bufferedReader().use { it.readText() }
+        } catch (e: Exception) {
+            // A build without persona assets simply has no persona.
+            ""
+        }
+    }
+}
