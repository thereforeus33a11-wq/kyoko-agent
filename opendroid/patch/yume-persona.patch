+
+    @Test
+    fun `her eyes - a picture that shows a teen marks the page, and a line of hers about it that reads as sexual is not kept`() {
+        val eyes = HostEyes()
+        hostEyes = eyes
+        sources.articleImage = "https://upload.wikimedia.org/egg.jpg"
+        mind.config = LLMConfig(personaOwnLife = true, personaEyes = true)
