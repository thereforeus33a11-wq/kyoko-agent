+        assertEquals(Manner.SHOUT, Manner.SHOUT.breathyWith(listOf(SoundEvent.LAUGHTER)))
+        assertEquals(listOf("laughing"), HowItSounded.judge(breathy, null, listOf(SoundEvent.LAUGHTER), 0, null, null).phrases())
+        assertEquals(listOf("laughing"), HowItSounded.ofAnother(listOf(SoundEvent.LAUGHTER), breathy).phrases())
+    }
