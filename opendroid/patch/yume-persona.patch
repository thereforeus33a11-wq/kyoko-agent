+/**
+ * What the phone really sends her model, from a fresh install on, with the files this
+ * build ships: the settings a phone starts with ([BuildDefaults]), nothing but his key
+ * entered, her card, her starting notes and her library as `assets/persona` holds them,
+ * and her model at Venice spoken to end to end encrypted. A stand-in for the enclave
+ * attests, opens what the phone sealed with its own key and answers sealed in turn, so
+ * what is checked is the plain text the enclave reads, after every layer of the app
+ * has had its say.
+ *
+ * A chat of his is played through her reply as the loop writes it
+ * (AgentLoop.executeSimpleQuery: its stored rows, its history, her prompt, her request),
+ * her notebook passes come when they are due, then a moment of her own with no message
+ * of his, and her sleep pass. What is held here is that all of her is in each of them:
+ * her whole card, her starting notes, the pages of her files and what lies under her.
+ *
+ * With PROMPT_AUDIT_DIR set, every request is also written there whole (its plain
+ * messages and every option it carries) with the sizes of its parts.
+ * A checkout without her files skips this: they are not part of the source tree.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaPromptAuditTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val assets = File("src/main/assets/persona")
+    private val directory get() = File(context.filesDir, "persona")
+    private val owner = "Ren"
+
+    private val enclave = VeniceE2ee.generateKeyPair()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+
+    // Every request addressed to Venice goes to the stand-in, at the same path.
+    private val askedFor = CopyOnWriteArrayList<String>()
+    private val client = AppModule.provideOkHttpClient().newBuilder()
+        .addInterceptor(Interceptor { chain ->
+            val request = chain.request()
+            askedFor += request.url.newBuilder().query(null).build().toString()
+            val rerouted = request.url.newBuilder().scheme("http").host("127.0.0.1").port(server.port).build()
+            chain.proceed(request.newBuilder().url(rerouted).build())
+        })
+        .build()
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var settings: SettingsRepository
+    private lateinit var memory: PersonaMemory
+    private lateinit var memoryManager: MemoryManager
+    private lateinit var conversations: ConversationRepository
+    private lateinit var engine: PersonaEngine
+    private lateinit var shippedCard: String
+    private val profile = PersonaEngineTestSetup.ProfileNamed(owner)
+
+    /** The time her prompts are built at, and the time of every row stored. */
+    private var at = 0L
+
+    /** One request as the enclave reads it. */
+    private class Sent(
+        val kind: String,
+        val target: String,
+        val headers: Map<String, String>,
+        val wire: String,
+        val body: JsonObject,
+        val system: String,
+        val user: String
+    )
+
+    private val sent = CopyOnWriteArrayList<Sent>()
+    private val chatAnswers = ArrayDeque<String>()
+    private val momentAnswers = ArrayDeque<String>()
+    private val wordsAnswers = ArrayDeque<String>()
+
+    @Before
+    fun setUp() {
+        shippedCard = File(assets, "card.md").takeIf { it.isFile }?.readText().orEmpty()
+        assumeTrue("her files are not in this checkout", shippedCard.isNotBlank() && File(assets, "library").isDirectory)
+        directory.deleteRecursively()
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java).allowMainThreadQueries().build()
+        // Nothing saved: the phone starts on this build's own setting, with his key in the store.
+        settings = PersonaEngineTestSetup.settings()
+        memory = PersonaMemory(MemoryRepository(database.memoryDao(), database.taskHistoryDao(), database.macroDao()))
+        memoryManager = PersonaEngineTestSetup.memoryManager(context, database, profile)
+        conversations = ConversationRepository(database, database.conversationDao(), database.chatSessionDao())
+        engine = PersonaEngine(
+            // The card, her starting notes and her library as the build ships them.
+            store = PersonaStore(context),
+            memory = memory,
+            library = PersonaLibrary(context),
+            settingsRepository = settings,
+            llmProviderFactory = PersonaEngineTestSetup.factory(settings, client),
+            userProfileStore = profile,
