+
+/**
+ * The lines of a reply that she keeps to herself. A line that starts with [MARKER] is
+ * a thought: the mirror of the command line, which goes out to the phone. It is taken
+ * out of the reply before anything else looks at it, so it is never shown, spoken,
+ * stored in the chat, read by her notebook pass or taken for a command.
+ *
+ * Everything here is a decision about text. Keeping the thoughts is [PersonaThoughts].
+ */
+object PersonaThoughtLines {
+
+    const val MARKER = "<<"
+
+    /** Half of [MARKER], alone on a line: all that has arrived of one so far. */
+    internal const val HALF_MARKER = "<"
+
+    /** Opens her thoughts in her own prompt. It says whose they are and who is not shown them. */
+    const val HEADING = "=== YOUR OWN THOUGHTS (yours alone. he is not shown these and the app shows them nowhere) ==="
+
+    /**
+     * A reply without its thought lines, and the thoughts that were in it, one per line.
+     * [marked] says the reply had a thought line at all, also one with nothing after the marker.
+     */
+    data class Split(val text: String, val thoughts: String, val marked: Boolean)
+
+    /** Quotation marks a model may open a line with: the ones [PersonaPrompts.cleanReply] takes off a reply. */
+    private val OPENING_QUOTES = charArrayOf('"', '\u201C', '\u300C')
+    private val CLOSING_QUOTES = charArrayOf('"', '\u201D', '\u300D')
+
+    /** A name a chat model writes in front of a line, in any case, as a label with a colon. */
+    private val NAME_LABEL = Regex("""^(?:yume kisaragi|yume|kisaragi|assistant|ai)\s*:\s*""", RegexOption.IGNORE_CASE)
+
+    /**
+     * [line] without an opening quotation mark, and without a name label in front of it
+     * ("Yume: ", "yume: ") when a marker follows the label: a marker behind either still
+     * opens a thought. Otherwise the reply would lose the label when it is tidied and
+     * show the thought. A label with no marker behind it is left as it is.
+     */
+    private fun bare(line: String): String {
+        val text = line.trim().trimStart(*OPENING_QUOTES).trimStart()
+        val label = NAME_LABEL.find(text) ?: return text
+        val rest = text.substring(label.range.last + 1).trimStart(*OPENING_QUOTES).trimStart()
+        return if (rest.startsWith(HALF_MARKER)) rest else text
+    }
+
+    internal fun isThoughtLine(line: String): Boolean = bare(line).startsWith(MARKER)
+
+    /** What a thought line says, without its marker. A marker closed the way it was opened loses that too. */
+    private fun thoughtOf(line: String): String =
+        bare(line).trimStart('<').trim().trimEnd(*CLOSING_QUOTES).trim().removeSuffix(PersonaActions.MARKER).trim()
+
+    /**
+     * Separates what she says from what she keeps to herself. Every line that starts
+     * with [MARKER] is a thought, wherever it stands. The other lines stay as they were
+     * written and in their order, so a command line that was last before is still last.
+     */
+    fun split(reply: String): Split {
+        if (!reply.contains(MARKER)) return Split(reply, "", marked = false)
+        val said = ArrayList<String>()
+        val thought = ArrayList<String>()
+        var marked = false
+        for (line in reply.lines()) {
+            if (isThoughtLine(line)) {
+                marked = true
+                thoughtOf(line).takeIf { it.isNotEmpty() }?.let { thought += it }
+            } else {
+                said += line
+            }
+        }
+        return Split(if (marked) said.joinToString("\n") else reply, thought.joinToString("\n"), marked)
+    }
+
+    /**
+     * [streamed], a reply that is still coming in, without anything that is or may turn
+     * out to be a thought: no thought line, however much of it has arrived, and no last
+     * line that so far is only half a marker.
+     */
+    fun hidden(streamed: String): String {
+        val lines = streamed.lines().filterNot { isThoughtLine(it) }
+        val last = lines.indexOfLast { it.isNotBlank() }
+        val whole = if (last >= 0 && bare(lines[last]) == HALF_MARKER) lines.take(last) else lines
+        return whole.joinToString("\n")
+    }
+
+    /**
+     * Her latest thoughts as the block of her prompt: each with its age, oldest first,
+     * and unable to open a section of the prompt. Empty when there are none.
+     */
+    fun block(thoughts: List<PersonaThoughts.Thought>, nowMillis: Long): String =
+        thoughts.joinToString("\n") { thought ->
+            "(" + PersonaPrompts.age(nowMillis - thought.atMillis) + ") " + thought.text.trim().replace("===", "= = =")
+        }
+}
