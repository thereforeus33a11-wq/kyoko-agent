+    private val BY_ID: Map<String, Model> = ALL.associateBy { it.id }
+
+    /** The model of [id], or null for one this build's copy of the catalog does not name. */
+    fun of(id: String): Model? = BY_ID[id.trim().lowercase()]
+
+    /** One model of the shortlist, in the order to try them, with what is known of it in a line for him. */
+    data class Pick(val id: String, val note: String)
+
+    /**
+     * The shortlist from the research of 2026-11-19 (UGI leaderboard, EQ-Bench creative writing,
+     * roleplay reports; none of them a test of her), in the order to try them. Her own replies,
+     * side by side, are the test that counts.
+     */
+    val SHORTLIST: List<Pick> = listOf(
+        Pick(
+            VenicePrivateTier.SEEING_BRAIN,
+            "The baseline: the same family as her encrypted brain, uncensored, sees, thinking off. Private tier."
+        ),
+        Pick(
+            "e2ee-kimi-k2-6",
+            "Encrypted, text only. The best writer of the set on public tests, but its family turns adult scenes down more often: watch for that."
+        ),
+        Pick(
+            "xiaomi-mimo-v2-5",
+            "Sees and hears, so his voice can reach her as sound. A weaker writer with thinking off, with some refusals. Private tier."
+        ),
+        Pick(
+            "venice-uncensored-role-play",
+            "The most in voice, but a smaller model: it may drift from her card over a long prompt. Never thinks. Private tier."
+        ),
+        Pick(
+            "kimi-k3",
+            "The ceiling check: strong and dear. Its family turns adult scenes down more often. Private tier."
+        ),
+        Pick(
+            "e2ee-deepseek-v4-1-flash-1017-abliterated",
+            "The encrypted fallback: the same brain as the first, text only."
+        ),
+        Pick(
+            "xiaomi-mimo-v2-6-flash",
+            "Newer and cheaper than MiMo V2.5, sees and hears; no public tests of it yet. Private tier."
+        )
+    )
+
+    /** How many models one try takes: at least two to compare, at most four side by side. */
+    const val MIN_PER_TRY = 2
+    const val MAX_PER_TRY = 4
+
+    /** A reply of hers as the research priced it: about 13,000 tokens in (card, notes, talk) and 200 out. */
+    const val TYPICAL_PROMPT_TOKENS = 13_000
+    const val TYPICAL_REPLY_TOKENS = 200
+
+    /** Whether [id] is spoken to encrypted: an `e2ee-` model, whatever this build's copy says. */
+    fun encrypted(id: String): Boolean = VeniceE2ee.isE2eeModel(id.trim())
+
+    /**
+     * What [id] takes besides text as her brain, as [config] stands: nothing on the encrypted
+     * route, which carries text only; else the live check where it names the model, then this
+     * build's copy of the catalog.
+     */
+    fun senses(id: String, config: LLMConfig): Senses {
+        if (encrypted(id)) return Senses(sees = false, hears = false, modelSees = of(id)?.sees == true)
+        val caps = VenicePrivateTier.caps(id, config)
+        val listed = of(id)
+        val sees = caps?.vision ?: listed?.sees ?: false
+        val hears = caps?.audio ?: listed?.hears ?: false
+        // His pictures and his voice go to a Private-tier model only while he trusts that tier
+        // for her: untrusted, the same model is hosted and readable, and gets his talk only.
+        if (!config.trustVenicePrivate) return Senses(sees = false, hears = false, modelSees = sees, modelHears = hears, untrusted = true)
+        return Senses(sees = sees, hears = hears, modelSees = sees, modelHears = hears)
+    }
+
+    /**
+     * What reaches her through a model: pictures, sound, and whether the model itself sees or
+     * hears where its route carries none. [untrusted]: a Private-tier model while that tier is
+     * not trusted for her, which is then sent text only.
+     */
+    data class Senses(
+        val sees: Boolean,
+        val hears: Boolean,
+        val modelSees: Boolean,
+        val modelHears: Boolean = false,
+        val untrusted: Boolean = false
+    )
+
+    /** How [id] is named on his screen: an encrypted model says so, since several share a name with their Private-tier twin. */
+    fun labelOf(id: String): String {
+        val model = of(id) ?: return id.trim()
+        return if (model.encrypted) "${model.label} (encrypted)" else model.label
+    }
+
+    /**
+     * The extra request options her replies get on [id] ([LLMConfig.personaChatExtraBody]), so
+     * that it answers without thinking first where Venice lets that be said:
+     *  - `reasoning_effort` "none", with Venice's own two switches, where the catalog lists "none";
+     *  - its lowest listed effort where it lists no "none" (thinking cannot be turned off there),
+     *    with only the switch that strips thinking from the reply;
+     *  - blank for an encrypted model (no effort can be set on that route), for a model that does
+     *    not think, and for one this build does not know: the app's own two switches then go with
+     *    every reply of hers, and a model that turns them down is asked again without them.
+     */
+    fun replyOptions(id: String): String {
+        val model = of(id) ?: return ""
+        if (model.encrypted || !model.thinks || model.efforts.isEmpty()) return ""
+        val lowest = model.efforts.first()
+        return if (lowest == "none") {
+            """{"reasoning_effort":"none","venice_parameters":{"disable_thinking":true,"strip_thinking_response":true}}"""
+        } else {
+            """{"reasoning_effort":"$lowest","venice_parameters":{"strip_thinking_response":true}}"""
+        }
+    }
+
+    /** How [id] thinks with [replyOptions], in a few words for him. */
+    fun thinkingLine(id: String): String {
+        val model = of(id) ?: return "not in this build's copy of Venice's list: the app asks for thinking off"
+        return when {
+            !model.thinks -> "does not think"
+            model.encrypted -> "thinking asked off; on the encrypted route its effort cannot be set"
+            model.efforts.isEmpty() -> "thinking asked off"
+            model.efforts.first() == "none" -> "thinking off (it would think at ${model.defaultEffort ?: "its own level"} otherwise)"
+            else -> "thinking cannot be turned off: at its lowest, ${model.efforts.first()}"
+        }
+    }
+
+    /** What one reply costs on [id] with [promptTokens] in and [replyTokens] out, none from Venice's cache; null for an unknown model. */
+    fun usd(id: String, promptTokens: Int, replyTokens: Int): Double? {
+        val model = of(id) ?: return null
+        return (promptTokens * model.inputPerMillion + replyTokens * model.outputPerMillion) / 1_000_000.0
+    }
+
+    /** A typical reply of hers on [id] ([TYPICAL_PROMPT_TOKENS] in, [TYPICAL_REPLY_TOKENS] out). */
+    fun typicalUsd(id: String): Double? = usd(id, TYPICAL_PROMPT_TOKENS, TYPICAL_REPLY_TOKENS)
+
+    /** [usd] in cents, as his screen says it. */
+    fun cents(usd: Double): String = String.format(Locale.US, "%.2f¢", usd * 100)
+}
