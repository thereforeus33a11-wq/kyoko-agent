+++ b/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt
@@ -0,0 +1,185 @@
+package com.opendroid.ai.core.llm
+
+import android.content.ContextWrapper
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import com.opendroid.ai.actions.ActionDispatcher
+import com.opendroid.ai.core.agent.DeviceStateProvider
+import com.opendroid.ai.core.agent.IntentClassifier
+import com.opendroid.ai.core.llm.providers.CustomOpenAIProvider
+import com.opendroid.ai.core.llm.providers.OllamaProvider
+import com.opendroid.ai.core.llm.providers.OpenAIProvider
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import java.io.IOException
+import java.nio.file.Files
+import javax.inject.Provider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.runBlocking
+import okhttp3.OkHttpClient
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The factory is where a plan could change hands. A planning fallback gets the same
+ * request as the active provider, step results included, so the factory hands one out
+ * only if its route is allowed and no more readable than the one the plan was on. It also
+ * decides whether the planner is told where the owner is: on a private route it is.
+ */
+class LLMProviderFactoryRouteTest {
+
+    private val custom = "Custom OpenAI Compatible"
+    private val encrypted = "e2ee-gemma-4-26b-a4b-uncensored-p"
+
+    /** Nothing in these tests may leave: a provider that tried would fail here. */
+    private val client = OkHttpClient.Builder()
+        .addInterceptor { chain -> throw IOException("not sent in this test: ${chain.request().url.host}") }
+        .build()
+
+    /** An encrypted model on the compatible provider, Ollama on his own network, OpenAI hosted. */
+    private fun routes(active: String, policy: RoutePolicy = RoutePolicy.ANY): (LLMConfig) -> LLMConfig = {
+        it.copy(
+            routePolicy = policy,
+            activeProvider = active,
+            selectedModels = mapOf(custom to encrypted, "OpenAI" to "gpt-4o"),
+            customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+            ollamaUrl = "http://192.168.1.20:11434",
+            fallbackProviders = listOf("OpenAI", "Ollama", custom)
+        )
+    }
+
+    private fun planners(configure: (LLMConfig) -> LLMConfig, builtOpenAi: Boolean): List<String> {
+        val factory = newFactory(configure, openAiMayBeBuilt = builtOpenAi)
+        return runBlocking { factory.getPlanningProviders(emptyList()).map { it.name } }
+    }
+
+    @Test
+    fun `a plan on the encrypted route may fall back to his own network, never to a readable host`() {
+        // OpenAI is ticked as a fallback and has a key: it is not even built.
+        assertEquals(listOf(custom, "Ollama"), planners(routes(custom), builtOpenAi = false))
+    }
+
+    @Test
+    fun `a plan on his own network stays there`() {
+        assertEquals(listOf("Ollama"), planners(routes("Ollama"), builtOpenAi = false))
+    }
+
+    @Test
+    fun `a plan on a readable host may fall back to anything the policy allows`() {
+        assertEquals(listOf("OpenAI", "Ollama", custom), planners(routes("OpenAI"), builtOpenAi = true))
+    }
+
+    @Test
+    fun `a fallback the route policy refuses is left out whatever the active route is`() {
+        // Own hardware only: the encrypted model is refused as a fallback too.
+        assertEquals(listOf("Ollama"), planners(routes("Ollama", RoutePolicy.OWN_HARDWARE), builtOpenAi = false))
+        // The active provider itself is always returned; the gate refuses it when it is used.
+        assertEquals(
+            listOf("OpenAI", "Ollama"),
+            planners(routes("OpenAI", RoutePolicy.OWN_HARDWARE), builtOpenAi = true)
+        )
+    }
+
+    @Test
+    fun `the planner is told where he is on a private main route and not on a readable one`() {
+        fun withheldAfterLookup(configure: (LLMConfig) -> LLMConfig): Boolean {
+            val factory = newFactory(configure, openAiMayBeBuilt = true)
+            runBlocking { factory.getActiveProvider() }
+            return factory.withholdLocation
+        }
+
+        assertFalse(withheldAfterLookup(routes("Ollama")))
+        assertFalse(withheldAfterLookup(routes(custom)))
+        assertTrue(withheldAfterLookup(routes("OpenAI")))
+        // He switched private mode off: nothing is held back from the hosted planner either.
+        assertFalse(withheldAfterLookup { routes("OpenAI")(it).copy(privateMode = false) })
+
+        // The planning lookup settles it the same way.
+        val planning = newFactory(routes("Ollama"), openAiMayBeBuilt = false)
+        runBlocking { planning.getPlanningProviders(emptyList()) }
+        assertFalse(planning.withholdLocation)
+        val hostedPlanning = newFactory(routes("OpenAI"), openAiMayBeBuilt = true)
+        runBlocking { hostedPlanning.getPlanningProviders(emptyList()) }
+        assertTrue(hostedPlanning.withholdLocation)
+    }
+
+    private fun newFactory(configure: (LLMConfig) -> LLMConfig, openAiMayBeBuilt: Boolean): LLMProviderFactory {
+        val settings = newSettingsRepository()
+        runBlocking { settings.updateConfig(configure) }
+        return LLMProviderFactory(
+            claudeProvider = unused("Claude"),
+            openAIProvider = if (openAiMayBeBuilt) Provider { OpenAIProvider(client, settings) } else unused("OpenAI"),
+            geminiProvider = unused("Gemini"),
+            mistralProvider = unused("Mistral"),
+            groqProvider = unused("Groq"),
+            ollamaProvider = Provider { OllamaProvider(client, settings) },
+            openRouterProvider = unused("OpenRouter"),
+            togetherAIProvider = unused("Together"),
+            cohereProvider = unused("Cohere"),
+            deepSeekProvider = unused("DeepSeek"),
+            copilotProvider = unused("Copilot"),
+            opencodeGoProvider = unused("Opencode-Go"),
+            customOpenAIProvider = Provider { CustomOpenAIProvider(client, settings) },
+            gemmaProvider = unused("Gemma"),
+            liteRTLMProvider = unused("LiteRT-LM"),
+            hybridOnDeviceProvider = unused("Hybrid"),
+            settingsRepository = settings,
+            onDeviceLatencyTracker = OnDeviceLatencyTracker(settings),
+            actionDispatcher = dagger.Lazy<ActionDispatcher> { throw AssertionError("unused") },
+            intentClassifier = dagger.Lazy<IntentClassifier> { throw AssertionError("unused") },
+            // Only used to rewrite planning prompts, which this test never sends.
+            deviceStateProvider = DeviceStateProvider(ContextWrapper(null))
+        )
+    }
+
+    private fun <T> unused(name: String): Provider<T> =
+        Provider { throw AssertionError("$name must not be built: its route is more readable than the plan's") }
+
+    private fun newSettingsRepository() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-factory-route-test")
+                    .resolve("settings.preferences_pb")
+                    .toFile()
+            }
+        ),
+        providerCredentialStore = FixedKeyCredentialStore(mapOf("OpenAI" to "openai-test-key", custom to "custom-test-key")),
+        runStartupMigration = false
+    )
+
+    private class FixedKeyCredentialStore(
+        private val keys: Map<String, String>
+    ) : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(keys)
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
