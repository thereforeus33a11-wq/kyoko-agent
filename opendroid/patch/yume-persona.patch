diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/EarsGateTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsGateTest.kt
new file mode 100644
index 0000000..ff43112
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsGateTest.kt
@@ -0,0 +1,61 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.life.OutingRules
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** When her ears are open, paused or closed (§1.1 and the gates of phase 3). */
+class EarsGateTest {
+
+    private val open = EarsGate.Input(switchedOn = true, awake = true, permitted = true, micHeld = true, nowMillis = 1_000)
+
+    @Test
+    fun `open only while every gate holds`() {
+        assertEquals(EarsGate.Want.Open, EarsGate.decide(open))
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.SWITCHED_OFF), EarsGate.decide(open.copy(switchedOn = false)))
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.ASLEEP), EarsGate.decide(open.copy(awake = false)))
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.NO_PERMISSION), EarsGate.decide(open.copy(permitted = false)))
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.NEEDS_TAP), EarsGate.decide(open.copy(micHeld = false)))
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.MUTED), EarsGate.decide(open.copy(mutedUntil = 2_000)))
+        assertEquals(EarsGate.Want.Open, EarsGate.decide(open.copy(mutedUntil = 1_000)))
+    }
+
+    @Test
+    fun `sleep and the switch clear what she overheard, the others do not`() {
+        assertTrue(EarsGate.Closed.ASLEEP.clears)
+        assertTrue(EarsGate.Closed.SWITCHED_OFF.clears)
+        EarsGate.Closed.entries.filter { it != EarsGate.Closed.ASLEEP && it != EarsGate.Closed.SWITCHED_OFF }.forEach { assertFalse(it.name, it.clears) }
+    }
+
+    @Test
+    fun `charger only closes them off the charger`() {
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.NOT_CHARGING), EarsGate.decide(open.copy(onlyCharging = true, charging = false)))
+        assertEquals(EarsGate.Want.Open, EarsGate.decide(open.copy(onlyCharging = true, charging = true)))
+    }
+
+    @Test
+    fun `a call, a low battery off the charger and heat pause them`() {
+        assertEquals(EarsGate.Want.Pause(EarsGate.Paused.CALL), EarsGate.decide(open.copy(inCall = true)))
+        assertEquals(EarsGate.Want.Pause(EarsGate.Paused.BATTERY), EarsGate.decide(open.copy(batteryPercent = OutingRules.EARS_BATTERY_PERCENT - 1, charging = false)))
+        assertEquals(EarsGate.Want.Open, EarsGate.decide(open.copy(batteryPercent = OutingRules.EARS_BATTERY_PERCENT, charging = false)))
+        assertEquals(EarsGate.Want.Open, EarsGate.decide(open.copy(batteryPercent = 5, charging = true)))
+        assertEquals(EarsGate.Want.Pause(EarsGate.Paused.HOT), EarsGate.decide(open.copy(thermalStatus = OutingRules.THERMAL_SEVERE)))
+        // Sleep is stronger than a call: closed, not paused.
+        assertEquals(EarsGate.Want.Close(EarsGate.Closed.ASLEEP), EarsGate.decide(open.copy(inCall = true, awake = false)))
+    }
+
+    @Test
+    fun `the day's counts are words of the app's own, and read as counts`() {
+        val day = EarsDay()
+        day.bump(EarsDay.TO_HER, 9)
+        day.bump(EarsDay.OVERHEARD, 5)
+        day.bump(EarsDay.OTHERS_SECONDS, 360)
+        day.bump(EarsDay.OPEN_MINUTES, 380)
+        assertEquals("9 said to her, 5 overheard, others 6 min, not kept, 380 minutes open", EarsDay.text(day.flush()))
+        assertTrue(day.flush().isEmpty())
+        assertEquals(9, day.count(EarsDay.TO_HER))
+        assertEquals("dropped: her voice", EarsDay.dropped(Dropped.HER_VOICE))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/EarsModelInstallerTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsModelInstallerTest.kt
new file mode 100644
index 0000000..0de857c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsModelInstallerTest.kt
@@ -0,0 +1,122 @@
+package com.opendroid.ai.core.life.ears
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/** Models are put in place only when every hash matches, and a cut-off install leaves nothing. */
+class EarsModelInstallerTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val root: File get() = File(folder.root, "ears_models")
+
+    private fun download(bytes: ByteArray = EarsFixtures.MODEL_TAR_BZ2): File =
+        File(folder.root, "download.part").also { it.writeBytes(bytes) }
+
+    @Test
+    fun `an archive whose hashes match is unpacked, only the files the catalog names`() {
+        val model = EarsFixtures.MODEL
+        assertNull(EarsModelInstaller.install(root, model, download()))
+        assertTrue(EarsModelInstaller.isInstalled(root, model))
+        val dir = EarsModelInstaller.folder(root, model)
+        assertEquals(setOf("a.onnx", "tokens.txt", "INSTALLED"), dir.list()!!.toSet())
+        assertEquals("x 0\ny 1\n", File(dir, "tokens.txt").readText())
+        assertEquals(EarsFixtures.A_ONNX_SHA256, EarsModelInstaller.sha256(File(dir, "a.onnx")))
+        assertFalse(File(root, "model-x.part").exists())
+    }
+
+    @Test
+    fun `a download with one byte changed is refused and installs nothing`() {
+        val bad = EarsFixtures.MODEL_TAR_BZ2.copyOf()
+        bad[100] = (bad[100].toInt() xor 1).toByte()
+        assertEquals(EarsModelInstaller.Failure.HASH, EarsModelInstaller.install(root, EarsFixtures.MODEL, download(bad)))
+        assertFalse(EarsModelInstaller.isInstalled(root, EarsFixtures.MODEL))
+        assertFalse(EarsModelInstaller.folder(root, EarsFixtures.MODEL).exists())
+    }
+
+    @Test
+    fun `a download of the wrong size is refused before it is read`() {
+        assertEquals(
+            EarsModelInstaller.Failure.SIZE,
+            EarsModelInstaller.install(root, EarsFixtures.MODEL, download(EarsFixtures.MODEL_TAR_BZ2 + byteArrayOf(0))),
+        )
+    }
+
+    @Test
+    fun `a file whose own hash is wrong is refused, though the archive's matched`() {
+        val model = EarsFixtures.MODEL.copy(files = listOf(EarsModels.Kept("a.onnx", 3000, "0".repeat(64)), EarsFixtures.MODEL.files[1]))
+        assertEquals(EarsModelInstaller.Failure.FILE_HASH, EarsModelInstaller.install(root, model, download()))
+        assertFalse(EarsModelInstaller.folder(root, model).exists())
+    }
+
+    @Test
+    fun `a file the catalog wants that is not in the archive fails the install`() {
+        val model = EarsFixtures.MODEL.copy(files = EarsFixtures.MODEL.files + EarsModels.Kept("missing.onnx", 1, "0".repeat(64)))
+        assertEquals(EarsModelInstaller.Failure.MISSING, EarsModelInstaller.install(root, model, download()))
+        assertFalse(EarsModelInstaller.isInstalled(root, model))
+    }
+
+    @Test
+    fun `a single-file download is kept under its catalog name`() {
+        val bytes = EarsFixtures.lcg(4096, 99)
+        val sha = EarsModelInstaller.sha256(bytes.inputStream())
+        val model = EarsModels.Model("one", EarsModels.Part.VAD, "https://example.invalid/one.onnx", 4096, sha, null, listOf(EarsModels.Kept("one.onnx", 4096, sha)), "test")
+        assertNull(EarsModelInstaller.install(root, model, download(bytes)))
+        assertTrue(EarsModelInstaller.isInstalled(root, model))
+        assertTrue(EarsModelInstaller.file(root, model, "one.onnx").isFile)
+    }
+
+    @Test
+    fun `an install called off midway leaves nothing behind`() {
+        var calls = 0
+        val failure = EarsModelInstaller.install(root, EarsFixtures.MODEL, download()) { ++calls < 3 }
+        assertEquals(EarsModelInstaller.Failure.STOPPED, failure)
+        assertFalse(EarsModelInstaller.folder(root, EarsFixtures.MODEL).exists())
+        assertFalse(File(root, "model-x.part").exists())
+    }
+
+    @Test
+    fun `a folder with a wrong stamp or a short file is not a model, and remove takes it all`() {
+        val model = EarsFixtures.MODEL
+        assertNull(EarsModelInstaller.install(root, model, download()))
+        val dir = EarsModelInstaller.folder(root, model)
+        File(dir, "tokens.txt").writeText("x")
+        assertFalse(EarsModelInstaller.isInstalled(root, model))
+        assertNull(EarsModelInstaller.install(root, model, download()))
+        File(dir, "INSTALLED").writeText("something else")
+        assertFalse(EarsModelInstaller.isInstalled(root, model))
+        assertTrue(EarsModelInstaller.remove(root, model))
+        assertFalse(dir.exists())
+    }
+
+    @Test
+    fun `the catalog pins every model to the official sherpa-onnx releases with a SHA-256`() {
+        for (m in EarsModels.ALL) {
+            assertTrue(m.url, m.url.startsWith("https://github.com/k2-fsa/sherpa-onnx/releases/download/"))
+            assertTrue(m.sha256.matches(Regex("[0-9a-f]{64}")))
+            assertTrue(m.files.isNotEmpty() && m.files.all { it.sha256.matches(Regex("[0-9a-f]{64}")) && it.size > 0 })
+            assertEquals(m.archiveDir != null, m.url.endsWith(".tar.bz2"))
+            if (m.archiveDir == null) assertEquals(m.size to m.sha256, m.files.single().size to m.files.single().sha256)
+            // A kept name never leaves the model's own folder.
+            assertTrue(m.files.all { '/' !in it.name && it.name != ".." })
+        }
+        assertEquals(EarsModels.ALL.size, EarsModels.ALL.map { it.id }.toSet().size)
+    }
+
+    @Test
+    fun `the ears need the VAD, the chosen recogniser and the speaker model, and SenseVoice is the default`() {
+        assertEquals(listOf(EarsModels.SILERO_VAD, EarsModels.SENSE_VOICE, EarsModels.SPEAKER), EarsModels.needed(EarsModels.Recognizer.SENSE_VOICE))
+        assertEquals(EarsModels.MOONSHINE, EarsModels.needed(EarsModels.Recognizer.MOONSHINE)[1])
+        assertEquals(EarsModels.Recognizer.SENSE_VOICE, EarsModels.Recognizer.of(null))
+        assertEquals(EarsModels.Recognizer.SENSE_VOICE, EarsModels.Recognizer.of("WHISPER"))
+        assertEquals(EarsModels.Recognizer.MOONSHINE, EarsModels.Recognizer.of("MOONSHINE"))
+        assertTrue(EarsModels.peakBytes(EarsModels.SENSE_VOICE) > EarsModels.SENSE_VOICE.size + EarsModels.SENSE_VOICE.installedBytes)
+    }
+}
