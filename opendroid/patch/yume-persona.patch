+    private val time = FakeTime()
+    private val mind = Mind()
+    private val room = Room()
+    private val eyes = FakeEyes()
+    private val recorded = CopyOnWriteArrayList<PhoneLogEntry>()
+    private val askGate = CompletableDeferred<Unit>()
