diff --git a/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt
new file mode 100644
index 0000000..f604b91
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt
@@ -0,0 +1,275 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Sorting his message into talk or command must not show it to a model that may not read
+ * it. Where the main model may not, the message is sorted on the phone: plain talk still
+ * reaches the reply, and a command still goes to the planner.
+ */
+class IntentClassifierLocalDecisionTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** The main model is a plain hosted one; [replyModel] is what writes her replies. */
+    private fun config(
+        policy: RoutePolicy,
+        privateMode: Boolean = true,
+        replyModel: String = "",
+        mainModel: String = "some-plain-model"
+    ) = LLMConfig(
+        routePolicy = policy,
+        privateMode = privateMode,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to mainModel),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatModel = replyModel
+    )
+
+    private val encrypted = "e2ee-gemma-4-26b-a4b-uncensored-p"
+
+    @Test
+    fun `a main route the policy refuses is never asked`() {
+        for (policy in listOf(RoutePolicy.ENCRYPTED, RoutePolicy.OWN_HARDWARE)) {
+            for (replyOnOwnRoute in listOf(true, false)) {
+                assertFalse(
+                    "$policy / $replyOnOwnRoute",
+                    IntentClassifier.mayAskModel(config(policy, replyModel = encrypted), replyOnOwnRoute)
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `a readable main route is not asked while her reply is written on a private one`() {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        assertFalse(IntentClassifier.mayAskModel(splitRoutes, replyOnOwnRoute = true))
+
+        val localReplies = config(RoutePolicy.ANY).copy(
+            personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434"
+        )
+        assertFalse(IntentClassifier.mayAskModel(localReplies, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `the main model is asked when it will read the message anyway, or may read everything`() {
+        // No reply of her own: the stock chat goes to the main model whatever is decided here.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY, replyModel = encrypted), replyOnOwnRoute = false))
+        // Her reply is on the same readable route.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY), replyOnOwnRoute = true))
+        // He switched private mode off: nothing is held back from the main route.
+        assertTrue(
+            IntentClassifier.mayAskModel(
+                config(RoutePolicy.ANY, privateMode = false, replyModel = encrypted), replyOnOwnRoute = true
+            )
+        )
+        // The main model is itself on a private route.
+        for (policy in RoutePolicy.entries.filter { it != RoutePolicy.OWN_HARDWARE }) {
+            assertTrue(
+                "$policy",
+                IntentClassifier.mayAskModel(config(policy, mainModel = encrypted), replyOnOwnRoute = true)
+            )
+        }
+        val onDevice = LLMConfig(routePolicy = RoutePolicy.OWN_HARDWARE, activeProvider = "On-Device AI")
+        assertTrue(IntentClassifier.mayAskModel(onDevice, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `plain talk is talk`() {
+        for (query in listOf(
+            "how was your day", "i am upset and want to forget it", "that makes sense", "i get it",
+            "you never listen", "we should do this together", "what's next for us", "i already told you",
+            "my alarm did not go off this morning", "are you still mad at me", "tell me a street story",
+            "ok", "", "   ", "lol", "what do you think about bees", "i will take a nap", "you remember the hive?"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a plain imperative is still talk, however it opens`() {
+        for (query in listOf(
+            "take your time", "show me", "get over here", "turn around", "make me laugh", "save me a seat",
+            "read my mind", "write me a poem about bees", "check this out", "run away with me",
+            "remember when we met", "next time bring flowers", "start over", "please get lost",
+            "hey, make up your mind", "take off your jacket and get on the bike"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a forced-action word inside plain talk does not make it a command`() {
+        for (query in listOf(
+            "i can't find the words for today", "what music did you grow up with", "you never text back",
+            "the news today made me sad", "i'll send you something later", "we should open up more",
+            "let's play a game tonight", "that film had great dialogue", "the texture of that fabric",
+            "i was playing with the idea", "i had a call with the inspector today", "my phone died on the hill",
+            "i keep searching for the right word", "did you find what you were looking for",
+            "i'd google it but i'd rather hear it from you", "phone's dying, talk later"
+        )) {
+            assertTrue("$query should still count as forced when a model is asked", IntentClassifier.isForcedAction(query))
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a call or a message to himself or to her is talk`() {
+        for (query in listOf(
+            "call me when you wake up", "text me later", "message me when you are back", "ring me tomorrow",
+            "send me a picture", "please call me", "hey, text me", "call you later", "call it a day",
+            "Call me maybe", "phone me", "send us off with a song"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+        // Someone else after the same word is a contact.
+        for (query in listOf("call my mom", "text Sam I'm late", "send Riya the list", "message the inspector")) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a command is a command`() {
+        for (query in listOf(
+            // Opening with a forced-action word, after any lead-in.
+            "call dad", "can you text Sam I'm late", "play something loud", "open the camera",
+            "send Riya the list", "find my keys", "search for hive frames", "google bee suits",
+            "please navigate home", "look up the ferry times", "translate this to french",
+            "remember this", "what did i save about the hive", "music", "ok, call dad",
+            // Something only the phone answers for, wherever the word stands.
+            "what's the weather", "turn on the flashlight", "is the wifi on", "how loud is the volume",
+            "i need a screenshot of this", "bluetooth off",
+            // Opening like a command and naming a thing on the phone.
+            "show me my calendar", "create a note about the hive", "check my email", "set a reminder for five",
+            "delete the alarm for monday", "write an email to Riya", "start a timer", "list my reminders",
+            "Please check my calendar", "could you set a reminder for the inspector",
+            "hey, can you show me my calendar", "babe, check my email", "ok now set an alarm",
+            "  >> create a note: jars", "Email Riya the list", "alarm at seven", "note: buy jars",
+            "lock the phone", "lock the screen", "read my notifications", "take a photo", "check the battery",
+            "list my apps", "read my messages", "make a call to the inspector", "pause the music"
+        )) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a thing on the phone counts as a whole word only`() {
+        for (query in listOf(
+            "show me you appreciate it", "make the apple pie", "take the filet off the heat",
+            "read the context again", "check the screenplay"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `sorting on the phone never reaches for a provider`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw AssertionError("the main model must not be asked") }
+        )
+
+        assertFalse(classifier.requiresAction("how was your day", askModel = false))
+        assertFalse(classifier.requiresAction("i get it, that makes sense", askModel = false))
+        assertFalse(classifier.requiresAction("take your time", askModel = false))
+        // A forced word does not short-cut the local sort.
+        assertFalse(classifier.requiresAction("i can't find the words for today", askModel = false))
+        assertFalse(classifier.requiresAction("call me when you wake up", askModel = false))
+        assertTrue(classifier.requiresAction("show me my calendar", askModel = false))
+        assertTrue(classifier.requiresAction("call dad", askModel = false))
+    }
+
+    @Test
+    fun `a failed call still falls back to the words instead of losing the message`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw IllegalStateException("no provider") }
+        )
+
+        // The stock offline fallback, unchanged: any action keyword anywhere.
+        assertEquals(true, classifier.requiresAction("could we take a break"))
+        assertEquals(false, classifier.requiresAction("how was your day"))
+    }
+
+    @Test
+    fun `a command is planned unless the planner's route is refused while she can still answer`() {
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        assertEquals(MessageHandling.TALK, IntentClassifier.handling(refusedMain, personaActive = true, isCommand = false))
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier.handling(refusedMain, personaActive = true, isCommand = true)
+        )
+        // Without her the stock chat would be refused on the same route: the planner's error says so.
+        assertEquals(MessageHandling.PLAN, IntentClassifier.handling(refusedMain, personaActive = false, isCommand = true))
+        // Her own route is refused too: nothing can answer, and the error names the main model.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED), personaActive = true, isCommand = true)
+        )
+        // An allowed planner plans, hosted or private.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ANY, replyModel = encrypted), personaActive = true, isCommand = true)
+        )
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED, mainModel = encrypted), personaActive = true, isCommand = true)
+        )
+    }
+
+    /** Counts how often the classifier reaches for the main model; every attempt fails. */
+    private class CountingFactory : dagger.Lazy<LLMProviderFactory> {
+        var asked = 0
+        override fun get(): LLMProviderFactory {
+            asked++
+            throw IllegalStateException("no provider in this test")
+        }
+    }
+
+    @Test
+    fun `the sort never asks a model while she talks, and asks for the stock chat where it may`() = runBlocking {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        for (settings in listOf(splitRoutes, refusedMain)) {
+            val factory = CountingFactory()
+            val classifier = IntentClassifier(factory)
+            assertEquals(MessageHandling.TALK, classifier.sort("how was your day", settings, personaActive = true))
+            assertEquals(
+                MessageHandling.TALK,
+                classifier.sort("i can't find the words for today", settings, personaActive = true)
+            )
+            assertEquals(MessageHandling.TALK, classifier.sort("call me when you wake up", settings, personaActive = true))
+            assertEquals("${settings.routePolicy}", 0, factory.asked)
+        }
+
+        // A command: planned where the planner may be used, answered by her where it may not.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier(CountingFactory()).sort("call dad", splitRoutes, personaActive = true)
+        )
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier(CountingFactory()).sort("call dad", refusedMain, personaActive = true)
+        )
+
+        // One hosted model for everything would read the message anyway. With her on it is
+        // still not asked: nothing he types is sent anywhere just to be sorted.
+        val oneModel = CountingFactory()
+        IntentClassifier(oneModel).sort("how was your day", config(RoutePolicy.ANY), personaActive = true)
+        IntentClassifier(oneModel).sort(
+            "how was your day", config(RoutePolicy.ANY, privateMode = false), personaActive = true
+        )
+        assertEquals(0, oneModel.asked)
+        // The stock chat, without her, is unchanged: the main model is asked.
+        val stock = CountingFactory()
+        IntentClassifier(stock).sort("how was your day", splitRoutes, personaActive = false)
+        assertEquals(1, stock.asked)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/MessageShapeTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/MessageShapeTest.kt
new file mode 100644
index 0000000..8b4b989
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/MessageShapeTest.kt
@@ -0,0 +1,338 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * With the persona on, his message is hers unless it is plainly for the phone. The
+ * decision is made from the words, on the phone, and these tables are the decision.
+ */
+class MessageShapeTest {
+
+    private val names = listOf("Yume")
+
+    private fun shape(
+        query: String,
+        multiStep: Boolean = false,
+        screenshotReachesHer: Boolean = false,
+        lastAction: String? = null,
+        lastParams: Map<String, String>? = null
+    ) = IntentClassifier.shapeWhilePersonaTalks(query, names, multiStep, screenshotReachesHer, lastAction, lastParams)
+
+    private fun shortcut(query: String): AliasResolver.ActionHint? = (shape(query) as? MessageShape.Shortcut)?.hint
+
+    @Test
+    fun `talk that holds an action word is still talk`() {
+        for (query in listOf(
+            // The lines the stock keyword routing took away from her.
+            "dont text me that again", "wanna play something", "my phone is dying", "flash me",
+            "call me cute one more time",
+            // An action word further in decides nothing.
+            "i can't find the words for today", "what music did you grow up with", "you never text back",
+            "the news today made me sad", "i'll send you something later", "we should open up more",
+            "did you find what you were looking for", "i had a call with the inspector today",
+            // Opening with one, and then turning to her or to himself.
+            "call me when you wake up", "text me later", "send me a picture", "call you later", "call it a day",
+            "play with me", "search for me", "find it", "send it", "google it", "open it", "phone me",
+            "play for us",
+            // Opening with one, and then saying something about the thing.
+            "music is too loud in here", "phone is dying", "weather was awful all week", "wifi keeps dropping",
+            "news isn't what it used to be", "text didn't go through, i think", "phone's dying, talk later",
+            // A longer word that only begins like one.
+            "texture of that fabric", "playing along is not my thing", "finders keepers",
+            // A question put to her.
+            "text him back?", "call her now?", "open it or leave it?", "play something?",
+            // Plain talk.
+            "how was your day", "that makes sense", "i get it", "tell me a street story", "lol", "ok", "",
+            "   ", "yume", "hey yume", "oi", "what do you think about bees", "i will take a nap",
+            // Imperatives that are not for the phone.
+            "take your time", "show me", "make me laugh", "get over here", "turn around", "start over",
+            // Asking her to remember is hers to do.
+            "remember this: i keep bees", "remember this moment",
+            // An opening the app does not take for an address.
+            "honestly, find someone else", "babe, call mom"
+        )) {
+            assertEquals(query, MessageShape.Talk, shape(query))
+        }
+    }
+
+    @Test
+    fun `a message that opens with a forced-action word is a command, with or without an address`() {
+        for (query in listOf(
+            "open spotify", "call mom", "text Sam I'm late", "send Riya the list", "find my keys",
+            "search for hive frames", "google bee suits", "play something loud", "navigate home",
+            "look up the ferry times", "translate this to french", "launch the camera app", "dial 5550100",
+            "take me to the station", "what did i save about the hive", "save this number as dad",
+            // With an address in front.
+            "yume, call mom", "Yume call mom", "hey yume, open spotify", "hey yume open spotify", "oi, call mom",
+            "ok call dad", "okay, text Sam I'm late", "please open spotify", "pls call mom",
+            "can you call mom", "could you open spotify", "would you text Sam I'm late",
+            "ok yume, can you please open spotify", "hey, yume, call mom",
+            // A polite request keeps its question mark.
+            "can you call mom?", "could you open spotify?",
+            // An article does not hide the order.
+            "set a reminder to feed the bees", "open the camera app"
+        )) {
+            assertEquals(query, MessageShape.Command, shape(query))
+        }
+    }
+
+    @Test
+    fun `an alarm or a timer the app can read by itself runs as a shortcut`() {
+        val alarm = shortcut("set an alarm for 7")
+        assertEquals("SET_ALARM", alarm?.action)
+        assertEquals("Alarm", alarm?.baseParams?.get("label"))
+        assertEquals("SET_ALARM", shortcut("yume, set an alarm for 7:30 am")?.action)
+
+        val timer = shortcut("set a timer for 10 minutes")
+        assertEquals("SET_TIMER", timer?.action)
+        assertEquals("600", timer?.baseParams?.get("duration"))
+
+        // What the shortcut cannot carry in full is left to the planner.
+        assertEquals(MessageShape.Command, shape("set an alarm for saturday at 7"))
+        // And a wish that only mentions waking up is said to her.
+        assertEquals(MessageShape.Talk, shape("dont wake me up at 7"))
+        assertEquals(MessageShape.Talk, shape("i need a timer in my life"))
+    }
+
+    /** Messages that are an alias and nothing else, and the action each one runs. */
+    private val wholeAliases = mapOf(
+        "flashlight" to "TOGGLE_FLASHLIGHT",
+        "turn on the flashlight" to "TOGGLE_FLASHLIGHT",
+        "yume, flashlight" to "TOGGLE_FLASHLIGHT",
+        "hey yume, torch on" to "TOGGLE_FLASHLIGHT",
+        "take a screenshot" to "TAKE_SCREENSHOT",
+        "can you take a screenshot?" to "TAKE_SCREENSHOT",
+        "wifi off" to "TOGGLE_WIFI",
+        "toggle wifi" to "TOGGLE_WIFI",
+        "lock the screen" to "LOCK_SCREEN",
+        "lock my phone" to "LOCK_SCREEN",
+        "do not disturb" to "TOGGLE_DND",
+        "volume 40" to "SET_VOLUME",
+        "set brightness to 30%" to "SET_BRIGHTNESS",
+        "weather" to "GET_WEATHER",
+        "open settings" to "OPEN_APP",
+        "read my notes" to "READ_NOTES",
+        "remember this" to "READ_AND_REMEMBER_SCREEN",
+        "open youtube and search lofi beats" to "PLAY_YOUTUBE"
+    )
+
+    @Test
+    fun `an alias counts only as the whole message`() {
+        for ((query, action) in wholeAliases) {
+            assertEquals(query, action, shortcut(query)?.action)
+        }
+
+        // The same words inside a sentence are talk.
+        for (query in listOf(
+            "what do you see in me", "the music is too loud", "i left the light on again",
+            "you make my screen off days better", "i could sleep for a week", "this lock is broken",
+            "the flashlight died on the hill", "my settings are a mess", "that camera loves you",
+            "i need a screenshot of your face"
+        )) {
+            assertEquals(query, MessageShape.Talk, shape(query))
+        }
+    }
+
+    @Test
+    fun `a word that is also ordinary talk counts only quite alone`() {
+        for (word in listOf("sleep", "light", "loud", "silent", "bright", "dim", "lock", "mute")) {
+            assertTrue(word, shape(word) is MessageShape.Shortcut)
+            assertTrue(word, shape("${word.replaceFirstChar(Char::uppercase)}.") is MessageShape.Shortcut)
+            // With anything around it, an address included, it is said to her.
+            for (talk in listOf("ok $word", "yume, $word", "$word now", "please $word", "so $word", "$word then")) {
+                assertEquals(talk, MessageShape.Talk, shape(talk))
+            }
+        }
+        // A switching verb makes it an order again.
+        assertEquals("TOGGLE_FLASHLIGHT", shortcut("turn on the light")?.action)
+        assertEquals("on", shortcut("turn on the light")?.baseParams?.get("state"))
+    }
+
+    @Test
+    fun `the shortcuts that answer a question do not fire`() {
+        for (query in listOf(
+            "what do you remember about my jeep", "what do you remember about us", "recall memory about the hive",
+            "what's the weather", "what is the weather", "who do i talk to most", "what are my routines",
+            "what's in clipboard", "weather?", "flashlight?"
+        )) {
+            assertEquals(query, MessageShape.Talk, shape(query))
+        }
+    }
+
+    @Test
+    fun `a question about the screen goes to her when a screenshot reaches her, and to the app's reader when not`() {
+        for (query in listOf(
+            "read my screen", "read screen", "what's on my screen", "what's on my screen?", "whats on screen",
+            "what do you see", "what do you see?", "look at my screen", "describe my screen", "analyze screen",
+            "yume, read my screen", "can you read my screen?"
+        )) {
+            assertEquals(query, MessageShape.ScreenTalk, shape(query, screenshotReachesHer = true))
+            assertEquals(query, "ANALYZE_SCREENSHOT", shortcut(query)?.action)
+        }
+        // Reading the screen in order to save it stays the app's own action either way.
+        assertEquals(
+            "READ_AND_REMEMBER_SCREEN",
+            (shape("save this screen", screenshotReachesHer = true) as MessageShape.Shortcut).hint.action
+        )
+    }
+
+    @Test
+    fun `a follow-up on the last switch still works, except the phrases said to a person`() {
+        val off = shape("turn it off", lastAction = "TOGGLE_FLASHLIGHT", lastParams = mapOf("state" to "on"))
+        assertEquals(
+            MessageShape.Shortcut(AliasResolver.ActionHint("TOGGLE_FLASHLIGHT", mapOf("state" to "off"))),
+            off
+        )
+        assertTrue(shape("ok turn it on", lastAction = "TOGGLE_WIFI") is MessageShape.Shortcut)
+        for (query in listOf("stop it", "no, stop it", "start it", "ok stop it please")) {
+            assertEquals(query, MessageShape.Talk, shape(query, lastAction = "TOGGLE_FLASHLIGHT"))
+        }
+        // Nothing ran before: nothing to follow up on.
+        assertEquals(MessageShape.Talk, shape("turn it off"))
+        // The stock resolver is unchanged: without the exception "stop it" is still a command.
+        assertEquals("off", AliasResolver.resolveContextual("stop it", "TOGGLE_FLASHLIGHT", null)?.baseParams?.get("state"))
+    }
+
+    @Test
+    fun `a request for several things is never cut down to a shortcut that reads part of it`() {
+        assertEquals(MessageShape.Command, shape("open spotify and then text mom i'm late", multiStep = true))
+        assertEquals(MessageShape.Command, shape("set a timer for 10 minutes and then text mom", multiStep = true))
+        assertEquals(MessageShape.Command, shape("set an alarm for 7", multiStep = true))
+        assertEquals(MessageShape.Talk, shape("we talked and then i went home", multiStep = true))
+        assertEquals(MessageShape.Talk, shape("turn it off", multiStep = true, lastAction = "TOGGLE_WIFI"))
+    }
+
+    @Test
+    fun `a whole-message alias is one action, whatever the count of action words says`() {
+        // The loop's finding is a count of action words. An alias that is the whole
+        // message is one action by construction, so the count does not hold it back.
+        for ((query, action) in wholeAliases) {
+            assertEquals(query, action, (shape(query, multiStep = true) as? MessageShape.Shortcut)?.hint?.action)
+        }
+        assertEquals(MessageShape.ScreenTalk, shape("read my screen", multiStep = true, screenshotReachesHer = true))
+    }
+
+    /** Fails the test as soon as anything reaches for a provider. */
+    private val noModel = dagger.Lazy<LLMProviderFactory> { throw AssertionError("no model may be asked while she talks") }
+
+    /** The shape as the loop works it out: with its own finding about several things, not a fixed one. */
+    private fun shapeInLoop(query: String, screenshotReachesHer: Boolean = false): MessageShape {
+        val multiStep = IntentClassifier(noModel).classifyComplexity(query) != QueryComplexity.SIMPLE
+        return shape(query, multiStep = multiStep, screenshotReachesHer = screenshotReachesHer)
+    }
+
+    @Test
+    fun `in the loop every whole-message alias runs as its shortcut`() {
+        // These score as several things in the loop: three or more action words each.
+        for (query in listOf("turn on the flashlight", "turn off the wifi", "can you take a screenshot?", "flashlight")) {
+            assertTrue(query, IntentClassifier(noModel).classifyComplexity(query) != QueryComplexity.SIMPLE)
+        }
+        val asHeSaysThem = wholeAliases + mapOf(
+            "turn off the wifi" to "TOGGLE_WIFI",
+            "please turn on wifi" to "TOGGLE_WIFI",
+            "yume, turn on wifi" to "TOGGLE_WIFI",
+            "yume, take a screenshot" to "TAKE_SCREENSHOT",
+            "set the volume to 40" to "SET_VOLUME",
+            "hey yume, turn off the flashlight" to "TOGGLE_FLASHLIGHT",
+            "turn on bluetooth please" to "TOGGLE_BLUETOOTH",
+            "show my notes" to "READ_NOTES"
+        )
+        for ((query, action) in asHeSaysThem) {
+            assertEquals(query, action, (shapeInLoop(query) as? MessageShape.Shortcut)?.hint?.action)
+        }
+        assertEquals("on", (shapeInLoop("yume, turn on wifi") as MessageShape.Shortcut).hint.baseParams["state"])
+        assertEquals("40", (shapeInLoop("set the volume to 40") as MessageShape.Shortcut).hint.baseParams["level"])
+    }
+
+    @Test
+    fun `in the loop talk stays talk and a command stays a command`() {
+        for (query in listOf(
+            "dont text me that again", "wanna play something", "my phone is dying", "flash me",
+            "call me cute one more time", "what do you see in me", "the music is too loud",
+            "i left the light on again, then went to bed", "we talked and then i went home",
+            "what do you remember about my jeep", "what's the weather"
+        )) {
+            assertEquals(query, MessageShape.Talk, shapeInLoop(query))
+        }
+        for (query in listOf(
+            "open spotify", "yume, call mom", "open spotify and then text mom i'm late",
+            "can you text Sam I'm late", "search for hive frames and send Riya the list"
+        )) {
+            assertEquals(query, MessageShape.Command, shapeInLoop(query))
+        }
+        // An alarm either runs as its shortcut or is planned: it is never taken for talk.
+        for (query in listOf("set an alarm for 7", "set alarm for 7", "set a timer for 10 minutes")) {
+            assertTrue(query, shapeInLoop(query) != MessageShape.Talk)
+        }
+    }
+
+    @Test
+    fun `a longer question about the screen is hers too when a screenshot reaches her`() {
+        val longer = listOf(
+            "read my screen and tell me what it says", "read my screen babe", "read the screen and sum it up for me",
+            "yume, read my screen and tell me who wrote", "can you read my screen and tell me what it says?",
+            "read screen, what does the error mean", "screenshot and analyze this page for me",
+            // "for me" after the question says who it is read to. It is still the order.
+            "read my screen for me and tell me what it says", "read the screen to me, slowly"
+        )
+        for (query in longer) {
+            assertEquals(query, MessageShape.ScreenTalk, shape(query, screenshotReachesHer = true))
+            assertEquals(query, MessageShape.ScreenTalk, shapeInLoop(query, screenshotReachesHer = true))
+            // Without a picture she can read, the app's own reader has to do it: a command.
+            assertEquals(query, MessageShape.Command, shape(query))
+        }
+        // Saving what is on the screen stays the app's own action, with or without a picture.
+        for (query in listOf(
+            "read my screen and save it to my notes", "read my screen and remember the meeting time",
+            "read the screen and save the details"
+        )) {
+            assertEquals(query, MessageShape.Command, shape(query, screenshotReachesHer = true))
+        }
+        // Talk that only opens like a question about the screen is still talk.
+        assertEquals(MessageShape.Talk, shape("what do you see in me", screenshotReachesHer = true))
+    }
+
+    @Test
+    fun `the decision is the same for every way of writing her name`() {
+        for (query in listOf("YUME, call mom", "yume,call mom", "  Yume ,  call mom", "“yume, call mom”")) {
+            assertEquals(query, MessageShape.Command, shape(query))
+        }
+        // Without a name to go by, the name is just a word.
+        assertEquals(
+            MessageShape.Talk,
+            IntentClassifier.shapeWhilePersonaTalks("yume, call mom", emptyList(), multiStep = false, screenshotReachesHer = false)
+        )
+    }
+
+    @Test
+    fun `with her on, sorting never asks a model, whatever the routes are`() = runBlocking {
+        val custom = "Custom OpenAI Compatible"
+        val oneHostedModel = LLMConfig(
+            routePolicy = RoutePolicy.ANY,
+            privateMode = false,
+            activeProvider = custom,
+            selectedModels = mapOf(custom to "some-plain-model"),
+            customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+        )
+        val configs = listOf(
+            oneHostedModel,
+            oneHostedModel.copy(privateMode = true),
+            oneHostedModel.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p"),
+            oneHostedModel.copy(routePolicy = RoutePolicy.ENCRYPTED),
+            LLMConfig(routePolicy = RoutePolicy.OWN_HARDWARE, activeProvider = "On-Device AI")
+        )
+        val classifier = IntentClassifier(noModel)
+        for (config in configs) {
+            for (query in listOf("how was your day", "could we take a break", "call dad", "i get it")) {
+                // Throws if the main model is asked.
+                classifier.sort(query, config, personaActive = true)
+            }
+        }
+    }
+}
