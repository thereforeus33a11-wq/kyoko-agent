+     */
+    val GATE_PACKAGES: Set<String> = setOf(
+        "com.android.vending",
+        "com.google.android.packageinstaller",
+        "com.android.packageinstaller",
+        "com.google.android.permissioncontroller",
+        "com.android.permissioncontroller",
+        "com.android.settings",
+        "com.samsung.android.settings",
+        "com.google.android.gms",
+        "com.google.android.gsf.login",
+        "com.osp.app.signin",
+        "com.samsung.android.spay",
+        "com.samsung.android.samsungpass",
+        "com.google.android.apps.walletnfcrel",
+        "com.android.credentialmanager",
+        "com.google.android.apps.subscriptions.red",
+        "com.paypal.android.p2pmobile",
+        "jp.ne.paypay.android.app"
+    )
+
+    /** The phone's call screens: a window of one of them is a call taking the foreground. */
+    val CALL_PACKAGES: Set<String> = setOf(
+        "com.android.incallui",
+        "com.samsung.android.incallui",
+        "com.google.android.dialer",
+        "com.android.dialer",
+        "com.samsung.android.dialer",
+        "com.android.server.telecom"
+    )
+
+    /** The app [packageName] belongs to, or null when it is none she may visit. */
+    fun byPackage(packageName: String): App? = ALL.firstOrNull { packageName in it.packages }
+
+    /**
+     * The app [words] name, or null: her word for it, its name, or one of the other names
+     * ("insta", "ツイッター", "the tiktok app", "youtube shorts"). The words must be the app
+     * alone, give or take "the", "his", "app" and "on".
+     */
+    fun byWords(words: String): App? {
+        val plain = plain(words)
+        if (plain.isEmpty()) return null
+        return ALL.firstOrNull { app -> app.words.any { plain(it) == plain } }
+    }
+
+    /**
+     * The app named first in [words], with the words that are left ("youtube cat videos" is
+     * YouTube and "cat videos"; "cat videos on youtube" is YouTube and "cat videos"), or null
+     * when no app is named at the start or after "on" / "in" at the end.
+     */
+    fun named(words: String): Pair<App, String>? {
+        val tokens = words.trim().split(Regex("""\s+""")).filter { it.isNotEmpty() }
+        if (tokens.isEmpty()) return null
+        // An app named at the start: the longest run of words that names one.
+        for (take in minOf(tokens.size, 4) downTo 1) {
+            val app = byWords(tokens.take(take).joinToString(" ")) ?: continue
+            return app to tokens.drop(take).joinToString(" ").trim()
+        }
+        // "<what> on <app>", "<what> in <app>", "<what> の <app>": the last such word, so "cats in kabukicho on youtube" is YouTube.
+        val tail = Regex("""^(.*)\s+(?:on|in|at|from|で|の)\s+(.+)$""", RegexOption.IGNORE_CASE).matchEntire(words.trim()) ?: return null
+        val app = byWords(tail.groupValues[2]) ?: return null
+        return app to tail.groupValues[1].trim()
+    }
+
+    private val FILLER = setOf("the", "his", "my", "your", "app", "application", "on", "in", "a", "アプリ")
+
+    private fun plain(words: String): String =
+        words.lowercase().replace(Regex("""[「」"'`.,!?。、！？]"""), " ").split(Regex("""\s+"""))
+            .filter { it.isNotEmpty() && it !in FILLER }
+            .joinToString(" ")
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/phone/HisScreen.kt b/app/src/main/java/com/opendroid/ai/core/life/phone/HisScreen.kt
new file mode 100644
index 0000000..81464d8
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/phone/HisScreen.kt
@@ -0,0 +1,331 @@
+package com.opendroid.ai.core.life.phone
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.AudioManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.PowerManager
+import android.app.KeyguardManager
+import android.util.Log
+import android.view.KeyEvent
+import android.view.accessibility.AccessibilityEvent
+import android.view.inputmethod.InputMethodManager
+import com.opendroid.ai.accessibility.LentScreenHands
+import com.opendroid.ai.accessibility.OpenDroidAccessibilityService
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * His screen, lent to her, on the phone ([PhoneTime]): his apps of [HisApps] that are installed,
+ * the phone's state, the accessibility service's hands, the watch on his screen while it is lent,
+ * the sound, and giving the screen back. Thin: what is decided is decided in this package's pure
+ * parts ([LendRules], [LendWatch], [LookOnly], [HumanMotion], [Fronts]).
+ *
+ * The accessibility service tells it what happens on the screen ([onEvent], [onScreenOff],
+ * [onUnlocked]): that is when he last touched the phone, and, while it is lent, the signals that
+ * end it.
+ */
+@Singleton
+class HisScreen @Inject constructor(@ApplicationContext private val context: Context) : PhoneTime {
+
+    /** When something of his last touched the phone: taps, texts, windows and his scrolling ([HisHand]). */
+    private val hand = HisHand()
+    @Volatile private var listener: ((LendWatch.Signal) -> Unit)? = null
+
+    /** True while her outing is on his screen: the habit engine learns nothing from it. */
+    val lent: Boolean get() = listener != null
+
+    private val main = Handler(Looper.getMainLooper())
+
+    override val ownPackage: String get() = context.packageName
+
+    private fun service(): OpenDroidAccessibilityService? = OpenDroidAccessibilityService.getInstance()
+
+    // ── What the accessibility service tells ─────────────────────────────────────────────
+
+    /** An event on the screen, as the accessibility service got it. */
+    fun onEvent(type: Int, packageName: String, atMillis: Long) {
+        val watching = listener
+        // His hand: something of his touched the phone, in this app too, his scrolling in the app in front among it.
+        hand.event(kindOf(type), packageName, atMillis, lent = watching != null)
+        if (watching == null) return
+        when (type) {
+            AccessibilityEvent.TYPE_TOUCH_INTERACTION_START -> watching(LendWatch.Signal.Touch(atMillis))
+            AccessibilityEvent.TYPE_VIEW_CLICKED, AccessibilityEvent.TYPE_VIEW_LONG_CLICKED, AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED ->
+                watching(LendWatch.Signal.Interaction(atMillis, packageName))
+            AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED, AccessibilityEvent.TYPE_WINDOWS_CHANGED -> front(atMillis)?.let(watching)
+        }
+    }
+
+    fun onScreenOff(atMillis: Long) {
+        hand.touched(atMillis)
+        listener?.invoke(LendWatch.Signal.ScreenOff(atMillis))
+    }
+
+    fun onUnlocked(atMillis: Long) {
+        hand.touched(atMillis)
+    }
+
+    private fun kindOf(type: Int): HisHand.Event = when (type) {
+        AccessibilityEvent.TYPE_VIEW_CLICKED -> HisHand.Event.CLICK
+        AccessibilityEvent.TYPE_VIEW_LONG_CLICKED -> HisHand.Event.LONG_CLICK
+        AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED -> HisHand.Event.TEXT
+        AccessibilityEvent.TYPE_TOUCH_INTERACTION_START -> HisHand.Event.TOUCH
+        AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED -> HisHand.Event.WINDOW
+        AccessibilityEvent.TYPE_VIEW_SCROLLED -> HisHand.Event.SCROLL
+        AccessibilityEvent.TYPE_VIEW_SELECTED -> HisHand.Event.SELECTED
+        AccessibilityEvent.TYPE_VIEW_FOCUSED -> HisHand.Event.FOCUSED
+        else -> HisHand.Event.OTHER
+    }
+
+    private fun front(atMillis: Long): LendWatch.Signal.Front? {
+        val service = service() ?: return null
+        val metrics = context.resources.displayMetrics
+        val (front, over) = Fronts.of(
+            LentScreenHands.windowsOf(service),
+            metrics.widthPixels, metrics.heightPixels, ownPackage
+        )
+        return LendWatch.Signal.Front(atMillis, front, over)
+    }
+
+    // ── PhoneTime ───────────────────────────────────────────────────────────────────────
+
+    override fun installed(): Map<HisApps.App, String> {
+        val pm = context.packageManager
+        val found = LinkedHashMap<HisApps.App, String>()
+        for (app in HisApps.ALL) {
+            val pkg = app.packages.firstOrNull { pm.getLaunchIntentForPackage(it) != null } ?: continue
+            found[app] = pkg
+        }
+        return found
+    }
+
+    override fun phone(): LendRules.Phone {
+        val power = context.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        val keyguard = context.getSystemService(Context.KEYGUARD_SERVICE) as? KeyguardManager
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        val inCall = audio != null && audio.mode != AudioManager.MODE_NORMAL && audio.mode != AudioManager.MODE_INVALID
+        return LendRules.Phone(
+            screenOn = power?.isInteractive == true,
+            unlocked = keyguard != null && !keyguard.isKeyguardLocked,
+            inCall = inCall,
+            // Her own sound is off while she is on his screen: what plays then is not his.
+            hisSound = listener == null && audio?.isMusicActive == true,
+            lastTouchedAt = hand.lastTouchedAt,
+            hands = service() != null
+        )
+    }
+
+    override suspend fun inFront(): PhoneTime.Before {
+        val service = service() ?: return PhoneTime.Before.Unknown
+        val metrics = context.resources.displayMetrics
+        val (front, _) = Fronts.of(LentScreenHands.windowsOf(service), metrics.widthPixels, metrics.heightPixels, "")
+        return when {
+            front.isBlank() -> PhoneTime.Before.Unknown
+            front in launchers() -> PhoneTime.Before.Home
+            else -> PhoneTime.Before.App(front)
+        }
+    }
+
+    override val hands: PhoneSpace.Hands = object : PhoneSpace.Hands {
+        override suspend fun open(packageName: String): Boolean = withContext(Dispatchers.Main) {
+            val intent = context.packageManager.getLaunchIntentForPackage(packageName) ?: return@withContext false
+            try {
+                // From the service, which may start an activity: his app's task comes to the front as it was.
+                (service() ?: context).startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                true
+            } catch (e: Exception) {
+                Log.w(TAG, "His app did not open: ${e.javaClass.simpleName}")
+                false
+            }
+        }
+
+        override suspend fun screen(): Screen? = withContext(Dispatchers.Main) { service()?.let { LentScreenHands.read(it, System.currentTimeMillis()) } }
+
+        override suspend fun touch(touch: HumanMotion.Touch): Boolean {
+            val service = service() ?: return false
+            return LentScreenHands.touch(service, touch)
+        }
+
+        override suspend fun back(): Boolean = withContext(Dispatchers.Main) {
+            service()?.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_BACK) == true
+        }
+
+        override suspend fun search(field: ScreenNode, words: String): Boolean = withContext(Dispatchers.Main) {
+            service()?.let { LentScreenHands.search(it, field, words) } == true
+        }
+    }
+
+    override suspend fun frame(packageName: String): PhoneTime.Frame {
+        val service = service() ?: return PhoneTime.Frame.None("the app's accessibility service is off")
+        return withContext(Dispatchers.Main) {
+            val metrics = context.resources.displayMetrics
+            // A heads-up or the shade over the app holds his messages: no picture is taken while one is up.
+            val systemOver = Fronts.of(LentScreenHands.windowsOf(service), metrics.widthPixels, metrics.heightPixels, ownPackage).second
+            LentScreenHands.frame(service, packageName, systemOver)
+        }
+    }
+
+    override fun watch(app: String, onSignal: (LendWatch.Signal) -> Unit): AutoCloseable {
+        listener = onSignal
+        val service = service()
+        main.post {
+            service?.showLendBar("Yume · $app · looking only · touch the phone to take it back") {
+                listener?.invoke(LendWatch.Signal.Touch(System.currentTimeMillis()))
+            }
+        }
+        // A call and the screen are looked at each second as well: not every phone tells them by an event.
+        val poll = object : Runnable {
+            override fun run() {
+                val watching = listener ?: return
+                val phone = phone()
+                val now = System.currentTimeMillis()
+                if (!phone.screenOn || !phone.unlocked) watching(LendWatch.Signal.ScreenOff(now))
+                if (phone.inCall) watching(LendWatch.Signal.Call(now))
+                main.postDelayed(this, POLL_MILLIS)
+            }
+        }
+        main.postDelayed(poll, POLL_MILLIS)
+        return AutoCloseable {
+            listener = null
+            main.removeCallbacks(poll)
+            main.post { service()?.hideLendBar() }
+        }
+    }
+
+    override suspend fun giveBack(before: PhoneTime.Before, herPackage: String, hers: Boolean): PhoneTime.GaveBack = withContext(Dispatchers.Main) {
+        val service = service()
+        val metrics = context.resources.displayMetrics
+        val front = service?.let { Fronts.of(LentScreenHands.windowsOf(it), metrics.widthPixels, metrics.heightPixels, "").first }.orEmpty()
+        val elsewhere = front.isNotBlank() && front != herPackage && front != ownPackage
+        // Somewhere else already, by his own doing: what is in front is his, and stays.
+        if (elsewhere && !hers) return@withContext PhoneTime.GaveBack(PhoneTime.GaveBack.How.LEFT, "not touched: he was already somewhere else")
+        // Somewhere else by a move of hers (a link to another app, a back out of it, her app still opening): his screen is put back all the same.
+        val note = if (elsewhere) ", after her own move had left the app" else ""
+        val starter: Context = service ?: context
+        try {
+            when (before) {
+                is PhoneTime.Before.App -> {
+                    if (before.packageName == herPackage && !elsewhere) {
+                        return@withContext PhoneTime.GaveBack(PhoneTime.GaveBack.How.AS_IT_WAS, "his app, where it was")
+                    }
+                    val intent = context.packageManager.getLaunchIntentForPackage(before.packageName)
+                    if (intent == null) {
+                        starter.startActivity(home())
+                        return@withContext PhoneTime.GaveBack(PhoneTime.GaveBack.How.GIVEN, "home$note")
+                    }
+                    starter.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                    PhoneTime.GaveBack(PhoneTime.GaveBack.How.GIVEN, "his app$note")
+                }
+                else -> {
+                    starter.startActivity(home())
+                    PhoneTime.GaveBack(PhoneTime.GaveBack.How.GIVEN, "home$note")
+                }
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "His screen was not given back: ${e.javaClass.simpleName}")
+            PhoneTime.GaveBack(PhoneTime.GaveBack.How.FAILED, "not given back: android refused")
+        }
+    }
+
+    private fun home(): Intent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+
+    override fun quiet(): AutoCloseable {
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return AutoCloseable { }
+        val was = try {
+            audio.getStreamVolume(AudioManager.STREAM_MUSIC)
+        } catch (e: Exception) {
+            return AutoCloseable { }
+        }
+        // The mark first, written through at once: an app stopped mid-outing puts his sound back when it is up again (restoreLeftovers).
+        if (!marks().edit().putInt(QUIET_WAS, was).commit()) return AutoCloseable { }
+        try {
+            audio.setStreamVolume(AudioManager.STREAM_MUSIC, 0, 0)
+        } catch (e: Exception) {
+            // Do Not Disturb can refuse it: then the sound is as he had it.
+            marks().edit().remove(QUIET_WAS).apply()
+            return AutoCloseable { }
+        }
+        return AutoCloseable {
+            try {
+                // Put back only what she took: a volume he set meanwhile stays his.
+                QuietMark.restore(was, audio.getStreamVolume(AudioManager.STREAM_MUSIC))?.let { audio.setStreamVolume(AudioManager.STREAM_MUSIC, it, 0) }
+            } catch (e: Exception) {
+                Log.w(TAG, "The sound was not put back: ${e.javaClass.simpleName}")
+            } finally {
+                marks().edit().remove(QUIET_WAS).apply()
+            }
+        }
+    }
+
+    override fun restoreLeftovers() {
+        if (listener != null) return
+        val marks = marks()
+        if (!marks.contains(QUIET_WAS)) return
+        val was = marks.getInt(QUIET_WAS, -1)
+        try {
+            val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+            if (audio != null) {
+                QuietMark.restore(was, audio.getStreamVolume(AudioManager.STREAM_MUSIC))?.let {
+                    audio.setStreamVolume(AudioManager.STREAM_MUSIC, it, 0)
+                    Log.i(TAG, "His sound, left at nothing by an outing broken off, is put back")
+                }
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "The sound left by an outing was not put back: ${e.javaClass.simpleName}")
+        } finally {
+            marks.edit().remove(QUIET_WAS).apply()
+        }
+    }
+
+    override fun pauseHerSound(always: Boolean): Boolean {
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager ?: return false
+        return try {
+            if (!always && !audio.isMusicActive) return false
+            val at = android.os.SystemClock.uptimeMillis()
+            audio.dispatchMediaKeyEvent(KeyEvent(at, at, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MEDIA_PAUSE, 0))
+            audio.dispatchMediaKeyEvent(KeyEvent(at, at, KeyEvent.ACTION_UP, KeyEvent.KEYCODE_MEDIA_PAUSE, 0))
+            true
+        } catch (e: Exception) {
+            Log.w(TAG, "Her sound was not paused: ${e.javaClass.simpleName}")
+            false
+        }
+    }
+
+    override suspend fun clearShade(): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return false
+        return withContext(Dispatchers.Main) {
+            service()?.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_DISMISS_NOTIFICATION_SHADE) == true
+        }
+    }
+
+    private fun marks() = context.getSharedPreferences(MARKS, Context.MODE_PRIVATE)
+
+    override fun launchers(): Set<String> = try {
+        context.packageManager.queryIntentActivities(Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME), PackageManager.MATCH_DEFAULT_ONLY)
+            .mapNotNull { it.activityInfo?.packageName }.toSet()
+    } catch (e: Exception) {
+        emptySet()
+    }
+
+    override fun keyboards(): Set<String> = try {
+        (context.getSystemService(Context.INPUT_METHOD_SERVICE) as? InputMethodManager)?.enabledInputMethodList?.map { it.packageName }?.toSet().orEmpty()
+    } catch (e: Exception) {
+        emptySet()
+    }
+
+    private companion object {
+        const val TAG = "HisScreen"
+        const val POLL_MILLIS = 1_000L
+
+        /** What an outing on his screen leaves to be put back if the app is stopped in it: his volume before. */
+        const val MARKS = "his_screen_lent"
+        const val QUIET_WAS = "quiet_was"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/phone/HumanMotion.kt b/app/src/main/java/com/opendroid/ai/core/life/phone/HumanMotion.kt
new file mode 100644
index 0000000..0506ee0
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/phone/HumanMotion.kt
@@ -0,0 +1,466 @@
+package com.opendroid.ai.core.life.phone
+
+import java.util.Calendar
+import java.util.Random
+import java.util.TimeZone
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToLong
+import kotlin.math.sin
+import kotlin.math.sqrt
+
+/**
+ * How her finger moves on his screen: each verb of hers turned into touches and waits the way a
+ * nineteen-year-old who lives on her phone moves, subtly. Not a robot (straight lines at one
+ * speed, the same swipe twice, taps dead on the centre) and not a show (nothing wacky on
+ * purpose): the small things a thumb does by itself.
+ *
+ * - A swipe runs on a gentle curve, the arc a thumb makes pivoting at its base, never a ruler
+ *   line. It speeds up and slows down (a minimum-jerk profile), and a flick is let go while it
+ *   still moves, so a feed flings and a pager turns; a slow drag comes to rest before the finger
+ *   lifts. Its length, its speed, where it starts and how much it bends differ every time.
+ * - A tap lands a few dp off the centre, a touch low (her long nails: the pad lands below where
+ *   she looks), with a press of about a tenth of a second and the slight roll of a finger. The
+ *   offset is a finger's, the same few dp on a button as on a whole post, and the press keeps off
+ *   every other control inside what she taps ([press]): a post's like or repost row is never
+ *   under her finger when she opens the post.
+ * - There is a beat before a tap, and pauses that scale with what is on the screen: the time to
+ *   read its text, a longer stay where her own model says something holds her ([watch]).
+ * - Now and then, rarely: a scroll that goes too far and a short one back, a hesitation before
+ *   moving, a scroll a little short (on a pager, one that does not turn and is done again).
+ * - Her energy sets the pace ([Energy]): quicker and choppier when she is hyped, slower and lazier
+ *   when she is tired or groggy. Her clock in Tokyo gives the baseline, as her files say it moves
+ *   her ([Energy.at]), and a pace word of hers in a step nudges it ([Energy.nudged]).
+ *
+ * This is how she moves, not a disguise: she has no account of her own to protect from anyone,
+ * she only looks, and every act is in her log and the phone's record.
+ *
+ * Pure apart from [random], which a test seeds; nothing here touches Android. The accessibility
+ * service plays a [Touch] as a chain of continued strokes, one per [Part].
+ */
+class HumanMotion(private val random: Random) {
+
+    /** How lively she is. Ordered from the slowest to the quickest. */
+    enum class Energy {
+        /** Just up, dawn-wrecked, or in her sleeping hours. */
+        GROGGY,
+
+        /** The dip before dawn: sluggish, half-lidded. */
+        LAZY,
+
+        /** Evening: playful, easy. */
+        EASY,
+
+        /** Prime time and the last train: sharp, cold-eyed, precise. */
+        SHARP,
+
+        /** One to four in the morning: loud, sloppy, quick. */
+        HYPED;
+
+        /** A notch livelier for [PhoneVerb.Pace.QUICK], a notch lazier for [PhoneVerb.Pace.SLOW]. */
+        fun nudged(pace: PhoneVerb.Pace?): Energy = when (pace) {
+            null -> this
+            PhoneVerb.Pace.QUICK -> entries[min(ordinal + 1, entries.lastIndex)]
+            PhoneVerb.Pace.SLOW -> entries[max(ordinal - 1, 0)]
+        }
+
+        companion object {
+            private val TOKYO: TimeZone = TimeZone.getTimeZone("Asia/Tokyo")
+
+            /** Her energy by her clock in Tokyo at [millis]. */
+            fun at(millis: Long): Energy {
+                val clock = Calendar.getInstance(TOKYO).apply { timeInMillis = millis }
+                return ofTokyo(clock.get(Calendar.HOUR_OF_DAY), clock.get(Calendar.MINUTE))
+            }
+
+            /**
+             * Her energy at [hour]:[minute] in Tokyo, as her files have a night move her: waking at
+             * dusk groggy, the mirror hour and the early street easy, prime time and the last train
+             * sharp, one to four loud and quick, the dip before dawn lazy, dawn and her sleeping
+             * hours groggy.
+             */
+            fun ofTokyo(hour: Int, minute: Int): Energy {
+                val at = (hour.coerceIn(0, 23)) * 60 + minute.coerceIn(0, 59)
+                return when (at) {
+                    in 60 until 240 -> HYPED
+                    in 240 until 330 -> LAZY
+                    in 330 until 960 -> GROGGY
+                    in 960 until 1050 -> GROGGY
+                    in 1050 until 1320 -> EASY
+                    else -> SHARP
+                }
+            }
+        }
+    }
+
+    /**
+     * What an energy does to her moves, as factors on an easy evening's: [speed] on how fast a
+     * swipe runs, [pause] on waits, [length] on how far a scroll goes, [spread] on how much a
+     * swipe wanders, [tapSpread] on how far off the centre a tap lands, [press] on how long a
+     * tap is held, and how often the small slips come ([overshoot], [short], [hesitate]).
+     */
+    data class Pace(
+        val speed: Double,
+        val pause: Double,
+        val length: Double,
+        val spread: Double,
+        val tapSpread: Double,
+        val press: Double,
+        val overshoot: Double,
+        val short: Double,
+        val hesitate: Double
+    )
+
+    data class Point(val x: Float, val y: Float)
+
+    /** One stretch of a finger's movement: its points, a smooth curve, run through in [durationMillis]. */
+    data class Part(val points: List<Point>, val durationMillis: Long) {
+        val length: Double get() = points.zipWithNext { a, b -> dist(a, b) }.sum()
+    }
+
+    /** One touch: down at the first point, through every part in turn, up at the end. A tap is one part. */
+    data class Touch(val parts: List<Part>) {
+        val start: Point get() = parts.first().points.first()
+        val end: Point get() = parts.last().points.last()
+        val durationMillis: Long get() = parts.sumOf { it.durationMillis }
+        val points: List<Point> get() = parts.flatMap { it.points }
+        val length: Double get() = parts.sumOf { it.length }
+    }
+
+    sealed class Move {
+        data class Wait(val millis: Long) : Move()
+        data class Press(val touch: Touch) : Move()
+    }
+
+    /** The small slips a plan holds, for the tests and the log's counts. */
+    enum class Quirk { OVERSHOT, SHORT, HESITATED }
+
+    /** What one verb comes to: waits and touches in order, and the slips among them. */
+    data class Plan(val moves: List<Move>, val quirks: Set<Quirk> = emptySet()) {
+        val touches: List<Touch> get() = moves.filterIsInstance<Move.Press>().map { it.touch }
+        val waitMillis: Long get() = moves.filterIsInstance<Move.Wait>().sumOf { it.millis }
+        val totalMillis: Long get() = waitMillis + touches.sumOf { it.durationMillis }
+    }
+
+    /** The screen a plan is for, in pixels; [density] its pixels to a dp, or 0 for a phone's about [Screen.PHONE_DP_WIDE] dp wide. */
+    data class Area(val width: Int, val height: Int, val density: Float = 0f) {
+        val pxPerDp: Double get() = if (density > 0f) density.toDouble() else (width / Screen.PHONE_DP_WIDE).coerceAtLeast(1.0)
+    }
+
+    // ── Scrolls ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One scroll, [down] on to what comes next (her finger moves up) or back up, in an app of
+     * [shape], at [energy]; [bit] a short, slow one. On a pager a scroll always turns the page.
+     */
+    fun scroll(area: Area, down: Boolean, shape: HisApps.Shape, energy: Energy, bit: Boolean = false): Plan {
+        val pace = PACES.getValue(energy)
+        val h = area.height.toDouble()
+        val moves = ArrayList<Move>()
+        val quirks = HashSet<Quirk>()
+        val pager = shape == HisApps.Shape.PAGER
+        val short = !bit && chance(SHORT_CHANCE * pace.short)
+        val overshoot = !pager && !bit && !short && chance(OVERSHOOT_CHANCE * pace.overshoot)
+        moves += Move.Wait(ms(uniform(80.0, 260.0) * pace.pause))
+        if (chance(HESITATE_CHANCE * pace.hesitate)) {
+            moves += Move.Wait(ms(uniform(350.0, 1_100.0) * pace.pause))
+            quirks += Quirk.HESITATED
+        }
+        val slow = bit && !pager
+        var fraction = when {
+            pager -> gauss(0.40, 0.045)
+            slow -> gauss(0.15, 0.03)
+            else -> gauss(0.34, 0.06)
+        } * pace.length
+        if (short && pager) {
+            // A swipe that does not turn the page: it springs back, and she does it again.
+            moves += Move.Press(swipe(area, down, gauss(0.17, 0.02) * h, energy, flick = false, base = 300.0))
+            moves += Move.Wait(ms(uniform(250.0, 650.0) * pace.pause))
+            quirks += Quirk.SHORT
+        } else if (short) {
+            fraction *= uniform(0.55, 0.75)
+            quirks += Quirk.SHORT
+        }
+        if (overshoot) fraction *= uniform(1.2, 1.4)
+        val base = when {
+            slow -> 400.0
+            pager -> 230.0
+            else -> 260.0
+        }
+        moves += Move.Press(swipe(area, down, fraction * h, energy, flick = !slow, base = base))
+        if (overshoot) {
+            // Too far: a beat, and a short slow drag back.
+            moves += Move.Wait(ms(uniform(220.0, 520.0) * pace.pause))
+            moves += Move.Press(swipe(area, !down, uniform(0.08, 0.15) * h, energy, flick = false, base = 320.0))
+            quirks += Quirk.OVERSHOT
+        }
+        return Plan(moves, quirks)
+    }
+
+    /**
+     * One swipe of [length] pixels, [down] on to what comes next (the finger moves up). A
+     * [flick] is let go while it still moves; otherwise it comes to rest before the finger lifts.
+     */
+    private fun swipe(area: Area, down: Boolean, length: Double, energy: Energy, flick: Boolean, base: Double): Touch {
+        val pace = PACES.getValue(energy)
+        val w = area.width.toDouble()
+        val h = area.height.toDouble()
+        val top = TOP * h
+        val bottom = BOTTOM * h
+        val left = EDGE * w
+        val right = (1 - EDGE) * w
+        // Her right thumb: a little right of the middle, lower half for a swipe up.
+        val x0 = clamp(gauss(0.62 * w, 0.055 * w * pace.spread), 0.24 * w, 0.82 * w)
+        val y0: Double
+        val y1: Double
+        if (down) {
+            y0 = clamp(gauss(0.70 * h, 0.035 * h * pace.spread), 0.56 * h, 0.82 * h)
+            y1 = max(top, y0 - length)
+        } else {
+            y0 = clamp(gauss(0.32 * h, 0.035 * h * pace.spread), 0.20 * h, 0.44 * h)
+            y1 = min(bottom, y0 + length)
+        }
+        // A thumb swiping up drifts in toward the palm; swiping down, out again a little.
+        val drift = uniform(0.015, 0.06) * w * (if (down) -1.0 else 0.6)
+        val x1 = clamp(x0 + drift, left, right)
+        // The bend: a quadratic curve whose control point sits off the chord toward the thumb's pivot.
+        val chord = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0)).coerceAtLeast(1.0)
+        val bow = chord * uniform(0.05, 0.13) * sqrt(pace.spread)
+        val nx = -(y1 - y0) / chord
+        val ny = (x1 - x0) / chord
+        val sign = if (nx >= 0) 1.0 else -1.0
+        val cx = clamp((x0 + x1) / 2 + nx * sign * bow * 2, left, right)
+        val cy = clamp((y0 + y1) / 2 + ny * sign * bow * 2, top, bottom)
+        val curve = (0..SAMPLES).map { i ->
+            val t = i.toDouble() / SAMPLES
+            val u = 1 - t
+            Point((u * u * x0 + 2 * u * t * cx + t * t * x1).toFloat(), (u * u * y0 + 2 * u * t * cy + t * t * y1).toFloat())
+        }
+        val along = curve.zipWithNext { a, b -> dist(a, b) }.runningFold(0.0) { sum, d -> sum + d }
+        val total = along.last().coerceAtLeast(1e-6)
+        val bounds = if (flick) FLICK_MILLIS else DRAG_MILLIS
+        val duration = clamp(base * uniform(0.85, 1.15) / pace.speed, bounds.first.toDouble(), bounds.last.toDouble())
+        // A flick is let go at 80 to 90 per cent of the profile, still moving; a drag runs it out.
+        val end = if (flick) uniform(0.80, 0.90) else 1.0
+        val parts = ArrayList<Part>(PARTS + 1)
+        val partMillis = max(MIN_PART_MILLIS, (duration / PARTS).roundToLong())
+        var from = 0.0
+        for (i in 1..PARTS) {
+            val to = minimumJerk(end * i / PARTS) / minimumJerk(end)
+            parts += Part(slice(curve, along, total, from, to), partMillis)
+            from = to
+        }
+        if (!flick) {
+            // The finger rests a moment before it lifts, so the list does not fling on.
+            val last = curve.last()
+            parts += Part(listOf(last, Point(last.x + 0.5f, last.y)), ms(uniform(40.0, 110.0) / pace.speed))
+        }
+        return Touch(parts)
+    }
+
+    /** The points of [curve] from [from] to [to] of its length, the ends found on it exactly. */
+    private fun slice(curve: List<Point>, along: List<Double>, total: Double, from: Double, to: Double): List<Point> {
+        fun at(fraction: Double): Point {
+            val target = fraction.coerceIn(0.0, 1.0) * total
+            val i = along.indexOfFirst { it >= target }.let { if (it <= 0) 1 else it }
+            val span = (along[i] - along[i - 1]).coerceAtLeast(1e-9)
+            val f = ((target - along[i - 1]) / span).coerceIn(0.0, 1.0)
+            val a = curve[i - 1]
+            val b = curve[i]
+            return Point((a.x + (b.x - a.x) * f).toFloat(), (a.y + (b.y - a.y) * f).toFloat())
+        }
+        val inner = curve.indices.filter { along[it] > from * total && along[it] < to * total }.map { curve[it] }
+        val points = listOf(at(from)) + inner + listOf(at(to))
+        // A stretch too short to measure still moves a hair, so every part is a path with a length.
+        return if (points.size == 2 && dist(points[0], points[1]) < 0.01) listOf(points[0], Point(points[0].x, points[0].y - 0.01f)) else points
+    }
+
+    // ── Taps ────────────────────────────────────────────────────────────────────────────
+
+    /** A tap on [target], at [energy]: a beat, then a press a few dp off its centre, kept off [keepOff]. Null when no spot of it is free. */
+    fun tap(area: Area, target: Box, energy: Energy, keepOff: List<Box> = emptyList()): Plan? {
+        val lead = lead(energy)
+        val press = press(area, target, energy, keepOff) ?: return null
+        return Plan(lead.moves + Move.Press(press), lead.quirks)
+    }
+
+    /** What comes before a tap's press: the beat, and now and then a hesitation. Waits only. */
+    fun lead(energy: Energy): Plan {
+        val pace = PACES.getValue(energy)
+        val moves = ArrayList<Move>()
+        val quirks = HashSet<Quirk>()
+        moves += Move.Wait(beat(energy))
+        if (chance(HESITATE_CHANCE * 0.8 * pace.hesitate)) {
+            moves += Move.Wait(ms(uniform(300.0, 900.0) * pace.pause))
+            quirks += Quirk.HESITATED
+        }
+        return Plan(moves, quirks)
+    }
+
+    /**
+     * The press of a tap on [target]: a few dp off its centre, a touch low, held about a tenth of
+     * a second, the finger rolling a hair. The offset is a finger's, in dp, not a share of the
+     * target, so a big card is pressed near its middle as a button is. It lands on no box of
+     * [keepOff] (the other controls inside or over the target), nor within [KEEP_OFF_DP] of one:
+     * the same spread is drawn again where it would, then the free spot of the target nearest
+     * its centre is taken. Null when no spot of the target is free.
+     */
+    fun press(area: Area, target: Box, energy: Energy, keepOff: List<Box> = emptyList()): Touch? {
+        val pace = PACES.getValue(energy)
+        val dp = area.pxPerDp
+        val margin = KEEP_OFF_DP * dp
+        val near = keepOff.filter { it.overlaps(target) }
+        fun free(x: Double, y: Double): Boolean = near.none { box ->
+            x >= box.left - margin && x <= box.right + margin && y >= box.top - margin && y <= box.bottom + margin
+        }
+        val w = target.width.toDouble()
+        val h = target.height.toDouble()
+        val left = if (w < 6) target.centerX.toDouble() else target.left + min(TAP_INSET * w, TAP_EDGE_DP * dp)
+        val right = if (w < 6) target.centerX.toDouble() else target.right - min(TAP_INSET * w, TAP_EDGE_DP * dp)
+        val top = if (h < 6) target.centerY.toDouble() else target.top + min(TAP_INSET * h, TAP_EDGE_DP * dp)
+        val bottom = if (h < 6) target.centerY.toDouble() else target.bottom - min(TAP_INSET * h, TAP_EDGE_DP * dp)
+        val sd = TAP_SD_DP * dp * pace.tapSpread
+        var spot: Pair<Double, Double>? = null
+        for (attempt in 0 until TAP_TRIES) {
+            val x = clamp(target.centerX + gauss(TAP_RIGHT_DP * dp, sd), left, right)
+            val y = clamp(target.centerY + gauss(TAP_LOW_DP * dp, sd), top, bottom)
+            if (free(x, y)) {
+                spot = x to y
+                break
+            }
+        }
+        if (spot == null) {
+            // Every draw fell on another control: the free spot nearest the centre, if there is one.
+            val steps = FREE_GRID
+            val found = (0..steps).flatMap { i -> (0..steps).map { j -> left + (right - left) * i / steps to top + (bottom - top) * j / steps } }
+                .filter { (x, y) -> free(x, y) }
+                .minByOrNull { (x, y) -> (x - target.centerX) * (x - target.centerX) + (y - target.centerY) * (y - target.centerY) }
+                ?: return null
+            // A hair off the grid, where that is still free.
+            val nudged = found.first + gauss(0.0, dp) to found.second + gauss(0.0, dp)
+            spot = if (free(nudged.first, nudged.second) && target.contains(nudged.first, nudged.second)) nudged else found
+        }
+        val (x, y) = spot
+        val px = clamp(x, 1.0, area.width - 1.0)
+        val py = clamp(y, 1.0, area.height - 1.0)
+        val held = ms(clamp(gauss(88.0, 22.0) * pace.press, PRESS_MILLIS.first.toDouble(), PRESS_MILLIS.last.toDouble()))
+        val angle = uniform(0.0, 2 * Math.PI)
+        val roll = uniform(0.0, 2.2)
+        val start = Point(px.toFloat(), py.toFloat())
+        val rx = clamp(px + cos(angle) * roll, 1.0, area.width - 1.0)
+        val ry = clamp(py + sin(angle) * roll, 1.0, area.height - 1.0)
+        // The roll stays on the free spot: where it would reach another control, the finger holds still.
+        val rolled = if (free(rx, ry) && target.contains(rx, ry)) Point(rx.toFloat(), ry.toFloat()) else start
+        return Touch(listOf(Part(listOf(start, rolled), held)))
+    }
+
+    // ── Pauses ──────────────────────────────────────────────────────────────────────────
+
+    /** The beat before a tap or a step back: the eye finds it, the thumb gets there. */
+    fun beat(energy: Energy): Long = ms(uniform(260.0, 620.0) * PACES.getValue(energy).pause)
+
+    /** How long the screen is let settle after a move before she looks again: the app animates. */
+    fun settle(energy: Energy): Long = ms(uniform(450.0, 900.0) * sqrt(PACES.getValue(energy).pause))
+
+    /**
+     * How long it takes her to read [chars] characters of what is on the screen, [japanese] the
+     * share of them in Japanese (read at about 9 a second, English skimmed at about 24): at least
+     * [READ_MILLIS] first, at most its last.
+     */
+    fun reading(chars: Int, japanese: Double, energy: Energy): Long {
+        val share = japanese.coerceIn(0.0, 1.0)
+        val perSecond = 24.0 * (1 - share) + 9.0 * share
+        val millis = (500.0 + chars.coerceAtLeast(0) / perSecond * 1_000) * PACES.getValue(energy).pause * uniform(0.85, 1.15)
+        return ms(clamp(millis, READ_MILLIS.first.toDouble(), READ_MILLIS.last.toDouble()))
+    }
+
+    /** How long her long nails take to type [chars] characters into a search box: a fifth of a second a letter or so. */
+    fun typing(chars: Int, energy: Energy): Long =
+        ms(clamp(chars.coerceAtLeast(1) * uniform(170.0, 260.0) * PACES.getValue(energy).pause, TYPE_MILLIS.first.toDouble(), TYPE_MILLIS.last.toDouble()))
+
+    /** How long she stays on what holds her when she said [seconds]: about that, as a person keeps time. */
+    fun watch(seconds: Int, energy: Energy): Long {
+        val lean = when (energy) {
+            Energy.GROGGY, Energy.LAZY -> 1.05
+            Energy.HYPED -> 0.95
+            else -> 1.0
+        }
+        val millis = seconds.coerceIn(PhoneVerb.WATCH_MIN_SECONDS, PhoneVerb.WATCH_MAX_SECONDS) * 1_000.0 * lean * uniform(0.93, 1.1)
+        return ms(clamp(millis, WATCH_MILLIS.first.toDouble(), WATCH_MILLIS.last.toDouble()))
+    }
+
+    // ── Chance ──────────────────────────────────────────────────────────────────────────
+
+    private fun chance(p: Double): Boolean = random.nextDouble() < p
+    private fun uniform(lo: Double, hi: Double): Double = lo + (hi - lo) * random.nextDouble()
+    private fun gauss(mean: Double, sd: Double): Double = mean + sd * random.nextGaussian().coerceIn(-2.5, 2.5)
+
+    companion object {
+        /** The bands of the screen a swipe stays inside: off the edges where Android's own gestures start. */
+        const val EDGE = 0.12
+        const val TOP = 0.14
+        const val BOTTOM = 0.86
+
+        /** A tap lands inside this much of its target's edge at the least, or [TAP_EDGE_DP] where that is less. */
+        const val TAP_INSET = 0.15
+        const val TAP_EDGE_DP = 6.0
+
+        /**
+         * How far off the centre a tap lands, in dp: a spread of [TAP_SD_DP] (times her energy's
+         * [Pace.tapSpread], so 4.7 dp at the most), a hair to the right ([TAP_RIGHT_DP], her right
+         * thumb) and a touch low ([TAP_LOW_DP], her nails).
+         */
+        const val TAP_SD_DP = 3.5
+        const val TAP_RIGHT_DP = 0.6
+        const val TAP_LOW_DP = 1.8
+
+        /** A press keeps this far off every other control inside its target, in dp. */
+        const val KEEP_OFF_DP = 2.0
+
+        /** How often the spread is drawn again where it fell on another control, and the grid a free spot is then looked for on. */
+        private const val TAP_TRIES = 24
+        private const val FREE_GRID = 16
+
+        /** How many stretches a swipe is played in: each runs at its own speed. */
+        const val PARTS = 6
+        const val SAMPLES = 32
+        const val MIN_PART_MILLIS = 8L
+
+        val FLICK_MILLIS = 110L..520L
+        val DRAG_MILLIS = 220L..1_100L
+        val PRESS_MILLIS = 45L..190L
+        val READ_MILLIS = 400L..12_000L
+        val WATCH_MILLIS = 2_500L..66_000L
+        val TYPE_MILLIS = 600L..9_000L
+
+        /** How often, on an easy evening, a scroll goes too far (never on a pager), comes up short, or waits. */
+        const val OVERSHOOT_CHANCE = 0.055
+        const val SHORT_CHANCE = 0.045
+        const val HESITATE_CHANCE = 0.07
+
+        val PACES: Map<Energy, Pace> = mapOf(
+            Energy.GROGGY to Pace(speed = 0.70, pause = 1.6, length = 0.86, spread = 1.25, tapSpread = 1.35, press = 1.3, overshoot = 1.3, short = 1.8, hesitate = 2.0),
+            Energy.LAZY to Pace(speed = 0.78, pause = 1.35, length = 0.88, spread = 1.15, tapSpread = 1.15, press = 1.2, overshoot = 1.0, short = 1.6, hesitate = 1.4),
+            Energy.EASY to Pace(speed = 1.0, pause = 1.0, length = 1.0, spread = 1.0, tapSpread = 1.0, press = 1.0, overshoot = 1.0, short = 1.0, hesitate = 1.0),
+            Energy.SHARP to Pace(speed = 1.15, pause = 0.8, length = 1.0, spread = 0.8, tapSpread = 0.8, press = 0.9, overshoot = 0.6, short = 0.6, hesitate = 0.6),
+            Energy.HYPED to Pace(speed = 1.38, pause = 0.62, length = 1.12, spread = 1.35, tapSpread = 1.2, press = 0.85, overshoot = 1.8, short = 0.6, hesitate = 0.5)
+        )
+
+        /** The minimum-jerk profile: how far along a smooth reach is at [t] of its time, 0 to 1. */
+        fun minimumJerk(t: Double): Double {
+            val x = t.coerceIn(0.0, 1.0)
+            return x * x * x * (10 - 15 * x + 6 * x * x)
+        }
+
+        internal fun dist(a: Point, b: Point): Double {
+            val dx = (a.x - b.x).toDouble()
+            val dy = (a.y - b.y).toDouble()
+            return sqrt(dx * dx + dy * dy)
+        }
+
+        private fun clamp(v: Double, lo: Double, hi: Double): Double = if (hi < lo) (lo + hi) / 2 else v.coerceIn(lo, hi)
+        private fun ms(v: Double): Long = max(1L, abs(v).roundToLong())
+    }
+}
