+    private class Room : OutingHost.Room {
+        val lines = CopyOnWriteArrayList<String>()
+        val asked = CopyOnWriteArrayList<Pair<HerLog.Kind, Int>>()
+        @Volatile var askOvers = 0
+        override suspend fun said(line: String, atMillis: Long) {
+            lines += line
+        }
+
+        override suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String) {
+            asked += kind to maxMinutes
+        }
+
+        override fun askOver() {
+            askOvers++
+        }
+    }
+
+    /** Her eyes as the host sees them: open or shut, and scripted words; each look is one EYES call in the ledger, as HerEyes writes it. */
+    private inner class HostEyes(@Volatile var isOpen: Boolean = true) : Eyes {
+        val seen = ArrayDeque<HerEyes.Seen>()
+        val described = CopyOnWriteArrayList<Describe.Source>()
+        override fun open(config: LLMConfig, nowMillis: Long) = isOpen
+        override fun leftToday(config: LLMConfig, nowMillis: Long): Int = 60
+        override suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen {
+            described += source
+            ledger.record(OwnPurpose.EYES, "google-gemma-4-31b-it", 900, 90, ok = true)
+            return synchronized(seen) { seen.removeFirstOrNull() } ?: HerEyes.Seen.Described("A plain picture.", KidGuard.Ages.Read(emptySet()))
+        }
+    }
+
+    @Volatile private var hostEyes: Eyes? = null
+
+    private val mind = Mind()
+    private val sources = Sources()
+    private val room = Room()
+    @Volatile private var power = OutingHost.Power(80, charging = false, thermalStatus = 0)
+    private var onWait: () -> Unit = {}
+
+    // How a go: that asks him first waits out its 30 minutes: held until a test lets it pass.
+    private val askGate = CompletableDeferred<Unit>()
+    private val askWaited = CopyOnWriteArrayList<Long>()
+
+    private fun host() = OutingHost(
+        mind = mind,
+        sources = sources,
+        his = { OutgoingGuard.His(name = "Ren Mizuno") },
+        ledger = ledger,
+        log = log,
+        herNow = herNow,
+        life = life,
+        headlines = { _, _ -> Glance.Look(emptyList(), null) },
+        herFeeds = { Feeds.DEFAULTS },
+        phone = { power },
+        clock = { now.get() },
+        wait = { millis ->
+            now.addAndGet(millis)
+            onWait()
+            delay(1)
+        },
+        scope = scope,
+        askWait = { millis ->
+            askWaited += millis
+            askGate.await()
+            now.addAndGet(millis)
+        },
+        eyes = hostEyes
+    )
+
+    private fun reply(vararg lines: String) {
+        synchronized(mind.replies) { lines.forEach { mind.replies.addLast(it) } }
+    }
+
+    private fun read(words: String = "read about egg magazine") = words.substringAfter("go: ").let { it to OutingKind.parse(it) }
+
+    private fun started(host: OutingHost, words: String = "read about egg magazine"): OutingHost.Began = runBlocking {
+        val (written, parsed) = read(words)
+        host.go(written, parsed).also { withTimeout(10_000) { host.awaitEnd() } }
+    }
