diff --git a/app/src/test/java/com/opendroid/ai/core/record/RecordSealTest.kt b/app/src/test/java/com/opendroid/ai/core/record/RecordSealTest.kt
new file mode 100644
index 0000000..4232266
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/record/RecordSealTest.kt
@@ -0,0 +1,86 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.security.EncryptedSecret
+import com.opendroid.ai.core.security.SecretAeadCipher
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.fail
+import org.junit.Test
+import java.security.GeneralSecurityException
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+
+/**
+ * The record's seal: AES-GCM with the IV written in front of the ciphertext, bound to the
+ * record. The Keystore itself is not on the JVM, so the cipher here is the same AES/GCM
+ * with a key held in memory, standing in for the one the Keystore holds.
+ */
+class RecordSealTest {
+
+    /** AES-256/GCM/NoPadding with a software key and a fresh random IV per seal, as the Keystore cipher does. */
+    private class SoftwareCipher : SecretAeadCipher {
+        private val key: SecretKey = KeyGenerator.getInstance("AES").apply { init(256) }.generateKey()
+
+        override fun encrypt(plaintext: ByteArray, aad: ByteArray): EncryptedSecret {
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.ENCRYPT_MODE, key)
+            cipher.updateAAD(aad)
+            return EncryptedSecret(cipher.iv, cipher.doFinal(plaintext))
+        }
+
+        override fun decrypt(iv: ByteArray, ciphertext: ByteArray, aad: ByteArray): ByteArray {
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.DECRYPT_MODE, key, GCMParameterSpec(128, iv))
+            cipher.updateAAD(aad)
+            return cipher.doFinal(ciphertext)
+        }
+
+        override fun resetForReentry() = Unit
+    }
+
+    private val plain = "Send SMS to Nene: \"running late\"".toByteArray()
+
+    @Test
+    fun `a sealed record opens to what was sealed, with a fresh 12-byte IV in front`() {
+        val cipher = SoftwareCipher()
+        val seal = KeystoreRecordSeal(cipher)
+        val once = seal.seal(plain)
+        val twice = seal.seal(plain)
+        assertArrayEquals(plain, seal.open(once))
+        assertArrayEquals(plain, seal.open(twice))
+        // A fresh IV each time: the same record never seals to the same bytes.
+        assertFalse(once.copyOfRange(0, KeystoreRecordSeal.IV_BYTES).contentEquals(twice.copyOfRange(0, KeystoreRecordSeal.IV_BYTES)))
+        // The IV, then the ciphertext and its 16-byte tag.
+        assertEquals(KeystoreRecordSeal.IV_BYTES + plain.size + 16, once.size)
+        assertFalse(String(once).contains("Nene"))
+        assertEquals("yume_phone_record", KeystoreRecordSeal.KEY_ALIAS)
+    }
+
+    @Test
+    fun `a changed byte, a short file or another key does not open`() {
+        val seal = KeystoreRecordSeal(SoftwareCipher())
+        val sealed = seal.seal(plain)
+        val changed = sealed.copyOf().also { it[it.size - 1] = (it[it.size - 1].toInt() xor 1).toByte() }
+        for (bad in listOf(changed, sealed.copyOfRange(0, 20), KeystoreRecordSeal(SoftwareCipher()).seal(plain))) {
+            try {
+                seal.open(bad)
+                fail("opened bytes it should not")
+            } catch (expected: GeneralSecurityException) {
+                // The store sets such a file aside.
+            }
+        }
+    }
+
+    @Test
+    fun `the test seal round-trips and never holds the clear text`() {
+        val seal = FakeSeal()
+        val sealed = seal.seal(plain)
+        assertArrayEquals(plain, seal.open(sealed))
+        assertNotEquals(String(plain), String(sealed))
+        assertFalse(String(sealed).contains("Nene"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/record/RecordTestSupport.kt b/app/src/test/java/com/opendroid/ai/core/record/RecordTestSupport.kt
new file mode 100644
index 0000000..d4cc512
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/record/RecordTestSupport.kt
@@ -0,0 +1,64 @@
+package com.opendroid.ai.core.record
+
+import java.security.GeneralSecurityException
+
+/** A seal for tests: reversible, not the clear text, and it knows its own bytes. */
+internal class FakeSeal : RecordSeal {
+    var sealed = 0
+        private set
+
+    override fun seal(plain: ByteArray): ByteArray {
+        sealed++
+        return MARK + plain.map { (it.toInt() xor 0x5A).toByte() }.toByteArray()
+    }
+
+    override fun open(sealed: ByteArray): ByteArray {
+        if (sealed.size < MARK.size || !sealed.copyOfRange(0, MARK.size).contentEquals(MARK)) {
+            throw GeneralSecurityException("not sealed by this seal")
+        }
+        return sealed.copyOfRange(MARK.size, sealed.size).map { (it.toInt() xor 0x5A).toByte() }.toByteArray()
+    }
+
+    private companion object {
+        val MARK = "FAKESEAL".toByteArray()
+    }
+}
+
+/** A seal whose key is gone: it seals, but nothing it is given can be opened. */
+internal class KeyGoneSeal : RecordSeal {
+    override fun seal(plain: ByteArray): ByteArray = FakeSeal().seal(plain)
+    override fun open(sealed: ByteArray): ByteArray = throw GeneralSecurityException("key is gone")
+}
+
+internal const val DAY = 24L * 60 * 60 * 1000
+internal const val HOUR = 60L * 60 * 1000
+
+/** One entry of his: a text to [to] with [words], [at] millis. */
+internal fun textEntry(
+    id: String,
+    at: Long,
+    to: String = "Nene",
+    words: String = "running late",
+    who: Starter = Starter.HIM_CHAT,
+    why: String? = "text $to that i'm $words",
+    how: LetThrough? = LetThrough.HIS_YES,
+    end: StepEnd = StepEnd.DONE,
+    reason: String? = null
+) = PhoneLogEntry(
+    id = id,
+    at = at,
+    who = who,
+    why = why,
+    letThrough = how,
+    steps = listOf(
+        PhoneLogStep(
+            line = "Send SMS to $to",
+            kind = "Send SMS",
+            app = "Messages",
+            words = listOf(SentWords("message", words)),
+            end = end,
+            reason = reason
+        )
+    ),
+    outcome = if (end == StepEnd.DONE) Outcome.DONE else Outcome.FAILED
+)
diff --git a/app/src/test/java/com/opendroid/ai/core/record/WordsPassRecordTest.kt b/app/src/test/java/com/opendroid/ai/core/record/WordsPassRecordTest.kt
new file mode 100644
index 0000000..33111df
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/record/WordsPassRecordTest.kt
@@ -0,0 +1,79 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.agent.PlanWordsPass
+import com.opendroid.ai.core.persona.HerWords
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * The record holds a plan as the words pass left it. The words a step sent are the final
+ * ones, hers where she wrote them, never the planning tool's draft; a step the pass left
+ * out is gone from the plan and so is not on the record, as a step the plan never had is
+ * not; and a plan the pass left with nothing to run has no entry, as a plan that only
+ * talked has none.
+ */
+class WordsPassRecordTest {
+
+    private fun step(id: String, order: Int, action: String, params: Map<String, String>) = PlanStep(
+        stepId = id, order = order, description = "the planner's description", action = action, params = params, fallback = ""
+    )
+
+    private val draft =
+        "Hello Tumblr Support,\n\nI am writing because my blog was flagged by mistake.\n\nBest regards,\nRen"
+
+    private val steps = listOf(
+        step("s1", 1, "SEND_EMAIL", mapOf("to" to "support@tumblr.com", "subject" to "Request to review my flagged blog", "body" to draft)),
+        step("s2", 2, "SEND_SMS", mapOf("contact" to "56767", "message" to "STOP")),
+        step("s3", 3, "SEND_SMS", mapOf("contact" to "Mom", "message" to "emailed tumblr"))
+    )
+
+    private val his = PlanWordsPass.Origin(
+        HerWords.From.HIM,
+        "email tumblr support about my blog being flagged, text 56767 STOP, and text mom emailed tumblr"
+    )
+
+    private val hers = mapOf("subject" to "my blog got flagged", "body" to "hey, my blog got flagged for nothing. look at it again pls")
+
+    private fun ran(steps: List<PlanStep>) = Plan(
+        planId = "p1",
+        goal = "the planner's goal",
+        estimatedDuration = "",
+        estimatedSteps = steps.size,
+        steps = steps.map { it.copy(status = StepStatus.COMPLETED) }
+    )
+
+    @Test
+    fun `the record holds the words the pass left in the plan, hers where she wrote them, and not the steps it left out`() = runBlocking {
+        val pass = PlanWordsPass.run(steps, his, write = { ask -> HerWords.Answer.Written(ask.fields.associateWith { hers.getValue(it) }) })
+
+        val entry = PlanEntries.of(ran(pass.steps), PlanStarts.Start(who = Starter.HIM_CHAT), PlanEntries.Ending.Finished(isSuccess = true))!!
+
+        // The text to a short code was left out: it is not on the record, and nothing says it ran.
+        assertEquals(listOf("Send email to support@tumblr.com", "Send SMS to Mom"), entry.steps.map { it.line })
+        // Her words for the email, his own for his mother.
+        val email = entry.steps[0].words.filter { it.param in setOf("subject", "body") }
+        assertEquals(listOf(SentWords("subject", hers.getValue("subject")), SentWords("body", hers.getValue("body"))), email)
+        assertEquals(listOf(SentWords("message", "emailed tumblr")), entry.steps[1].words)
+        assertEquals(Outcome.DONE, entry.outcome)
+        // Nothing of the planning tool's draft, or of the step that went, is kept.
+        val kept = Json.encodeToString(entry)
+        for (gone in listOf("Best regards", "Hello Tumblr", "Request to review", "56767", "STOP")) {
+            assertFalse(gone, kept.contains(gone))
+        }
+    }
+
+    @Test
+    fun `a plan the pass left with nothing to run has no entry`() = runBlocking {
+        val pass = PlanWordsPass.run(steps.take(2), his, write = { HerWords.Answer.Refused })
+        assertEquals(emptyList<PlanStep>(), pass.steps)
+        assertNull(PlanEntries.of(ran(pass.steps), PlanStarts.Start(who = Starter.HIM_CHAT), PlanEntries.Ending.NotRun(refused = false)))
+    }
+}
