+    fun `a line is playing from its start to its end, and then remembered for a minute`() {
+        now = 1_000
+        VoiceOut.started("a", "nee, kiite")
+        assertTrue(VoiceOut.playing)
+        assertEquals(1_000L, VoiceOut.playingSince())
+        now = 3_000
+        VoiceOut.ended("a")
+        assertFalse(VoiceOut.playing)
+        val s = VoiceOut.since(2_000).single()
+        assertEquals(1_000L to 3_000L, s.startedAt to s.endedAt)
+        assertTrue(VoiceOut.since(3_001).isEmpty())
+        now = 3_000 + VoiceOut.KEEP_MILLIS + 1
+        assertTrue(VoiceOut.since(0).isEmpty())
+    }
+
+    @Test
+    fun `an end for a line it never heard of is ignored, and his voice cuts only the line being said`() {
+        now = 0
+        VoiceOut.ended("nobody")
+        VoiceOut.started("a", "one")
+        now = 500
+        VoiceOut.ended("a")
+        VoiceOut.started("b", "two")
+        now = 900
+        VoiceOut.cutByHim(800)
+        val (a, b) = VoiceOut.since(0)
+        assertNull(a.cutByHimAt)
+        assertEquals(800L, b.cutByHimAt)
+    }
+
+    @Test
+    fun `a line that never reported its end does not keep the ears deaf for good`() {
+        now = 0
+        VoiceOut.started("stuck", "never ends")
+        now = VoiceOut.LONGEST_LINE_MILLIS + 1
+        assertFalse(VoiceOut.playing)
+        now = VoiceOut.LONGEST_LINE_MILLIS + VoiceOut.KEEP_MILLIS + 1
+        assertTrue(VoiceOut.since(0).isEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/WakeReplyGateTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/WakeReplyGateTest.kt
