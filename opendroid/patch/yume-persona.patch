+        assertTrue(back.said)
+        assertEquals(HerLog.EndedBy.DONE, back.endedBy)
+        // What she saw: the page under its own heading, last; what she did so far, with her reaction.
+        val second = mind.texts[1]
+        assertTrue(second.indexOf(OutingPrompt.HEADING) < second.indexOf(OutingPrompt.IN_FRONT_HEADING))
+        assertTrue(second.contains("en.wikipedia.org · Egg (magazine) · part 1 of 2"))
+        assertTrue(second, second.contains("1. opened en.wikipedia.org \"Egg (magazine)\", part 1 of 2. you thought: \"egg. obviously"))
+        assertTrue(second.contains("say: <a line to him>     once in the whole outing. it lands in the chat with a notification. you used it already."))
+        assertTrue(mind.texts[2].contains("part 2 of 2"))
+        assertFalse(host.running)
+        assertEquals(HerNow.Now.Nothing, herNow.now.value)
+    }
