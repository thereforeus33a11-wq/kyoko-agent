+        )
+        // He wrote and she was awake for it: her next moment is set from here in both cases, and a
+        // << sleep: line among her thoughts puts her to sleep, unless the reply ran into its limit.
+        val call = "persona.ownTimeAfterReply(sleep = heard?.sleep?.takeUnless { replyOutcome.cutOff })"
+        assertEquals(2, Regex(Regex.escape(call)).findAll(reply).count())
+        assertTrue(only.contains(call))
+        assertEquals(0, Regex("""persona\.ownTimeAfterReply\(\)""").findAll(loop).count())
+        // Never from a reply that was stopped or failed: both leave before either call.
+        val stopped = reply.substringAfter("} catch (streamError: CancellationException) {").substringBefore("throw streamError")
+        val failed = reply.substringAfter("} catch (streamError: LLMException) {").substringBefore("return\n")
+        assertFalse(stopped.contains("ownTimeAfterReply"))
+        assertFalse(failed.contains("ownTimeAfterReply"))
+    }
+
+    @Test
+    fun `an unlock is passed on by its time alone, and can only bring her next moment forward`() {
+        val a11y = File(main, "accessibility/OpenDroidAccessibilityService.kt").readText()
+        val present = a11y.substringAfter("Intent.ACTION_USER_PRESENT -> {").substringBefore("Intent.ACTION_SCREEN_ON ->")
+        assertTrue(present.contains("agentLoop.personaPhoneUnlocked()"))
+        // Of the chat only when he last wrote is read, by its time: no text of it, and nothing is made.
+        val unlocked = loop.substringAfter("suspend fun personaPhoneUnlocked(").substringBefore("private fun isFreeForCheckIn(")
+        assertTrue(unlocked.contains("conversationRepository.currentSessionId.first() ?: return"))
+        assertTrue(unlocked.contains(".lastOrNull { it.sender == ChatMessage.Sender.USER }?.timestamp"))
+        assertFalse(unlocked.contains(".text"))
+        assertFalse(unlocked.contains("ensureCurrentSessionId"))
+        assertTrue(unlocked.contains("persona.ownTimeOnUnlock(heLastWroteAt, nowMillis)"))
+        // Her engine asks no model for it and leaves a moment that is being had alone.
+        val onUnlock = engine.substringAfter("suspend fun ownTimeOnUnlock(").substringBefore("data class OwnMoment(")
+        assertTrue(onUnlock.contains("if (!ownTimeIsOn(config) || inOwnMoment.get()) return"))
+        assertTrue(onUnlock.contains("PersonaOwnTime.broughtForward(state, nowMillis, heLastWroteAt, bounds) ?: return"))
+        assertTrue(onUnlock.contains("ownTimeLock.withLock {"))
+        for (never in listOf("complete(", "answeredWhole(", "thoughts.", "memory.notes(")) {
+            assertFalse(never, onUnlock.contains(never))
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaPhrasebookTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaPhrasebookTest.kt
