+    internal class ParsedReply(val text: String?, val finishReason: String?, val blocked: Boolean, val totalTokens: Int)
+
+    /**
+     * Reads a `generateContent` answer without trusting its shape. [ParsedReply.blocked]
+     * is true when the prompt was blocked (`promptFeedback.blockReason`) or the answer was
+     * stopped by a filter (`finishReason` one of [BLOCKED_FINISH_REASONS]); such an answer
+     * has no candidates, or a candidate without text.
+     */
+    internal fun parseReply(body: String): ParsedReply {
+        val root = try {
+            gson.fromJson(body, JsonObject::class.java)
+        } catch (e: Exception) {
+            null
+        } ?: throw LLMErrorMapper.malformed(name, "")
+        fun JsonObject.string(key: String): String? =
+            get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+        fun JsonObject.obj(key: String): JsonObject? = get(key)?.takeIf { it.isJsonObject }?.asJsonObject
+        fun JsonObject.array(key: String) = get(key)?.takeIf { it.isJsonArray }?.asJsonArray
+
+        val promptBlocked = root.obj("promptFeedback")?.string("blockReason")?.isNotBlank() == true
+        val candidate = root.array("candidates")?.firstOrNull()?.takeIf { it.isJsonObject }?.asJsonObject
+        val finishReason = candidate?.string("finishReason")
+        val text = candidate?.obj("content")?.array("parts")
+            ?.mapNotNull { part -> part.takeIf { it.isJsonObject }?.asJsonObject?.string("text") }
+            ?.takeIf { it.isNotEmpty() }
+            ?.joinToString("")
+        val totalTokens = root.obj("usageMetadata")?.get("totalTokenCount")
+            ?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isNumber }?.asInt ?: 0
+        return ParsedReply(
+            text = text,
+            finishReason = finishReason,
+            blocked = promptBlocked || finishReason in BLOCKED_FINISH_REASONS,
+            totalTokens = totalTokens
         )
     }
 
