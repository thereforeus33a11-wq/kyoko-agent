+                PlanApprovalSummary.OutgoingText(3, "people", "Sam, Riya"),
+                PlanApprovalSummary.OutgoingText(4, "name", "Autumn honey"),
+                PlanApprovalSummary.OutgoingText(4, "objective", "sell forty jars"),
+                PlanApprovalSummary.OutgoingText(5, "message", "swarm at the gate")
+            ),
+            found
+        )
+        val lines = PlanApprovalSummary.stepLines(
+            validated.copy(
+                steps = listOf(
+                    step("s1", 1, "SEND_EMAIL", mapOf("to" to "riya@example.com", "cc" to "sam@example.com")),
+                    step("s3", 2, "SPLIT_BILL", mapOf("totalAmount" to "900", "people" to "Sam, Riya")),
+                    step("s5", 3, "SEND_WHATSAPP_GROUP", mapOf("groupName" to "Beekeepers", "message" to "swarm at the gate"))
