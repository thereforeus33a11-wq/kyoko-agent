+import java.net.InetAddress
+import java.net.UnknownHostException
+import java.nio.charset.Charset
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.TimeUnit
+
+/**
+ * The fetch guard: where a fetch may go (the SSRF table), what it sends, what it takes,
+ * robots.txt, and the pace per host. The sites are a TLS MockWebServer on loopback, which
+ * the test lets through by name only; the guard itself stays on for every other address.
+ */
+class HerFetcherTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val authority = HeldCertificate.Builder().certificateAuthority(0).build()
+    private val serverCertificate = HeldCertificate.Builder()
+        .commonName("site.test")
+        .addSubjectAlternativeName("site.test")
+        .addSubjectAlternativeName("other.test")
+        .addSubjectAlternativeName("private.test")
+        .signedBy(authority)
+        .build()
+    private val server = MockWebServer().also {
+        it.useHttps(HandshakeCertificates.Builder().heldCertificate(serverCertificate).build().sslSocketFactory())
+        it.start(InetAddress.getByName("127.0.0.1"), 0)
+    }
+    private val trusting = HandshakeCertificates.Builder().addTrustedCertificate(authority.certificate).build()
+    private val base = OkHttpClient.Builder().sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager).build()
+
+    private val loopback = InetAddress.getByName("127.0.0.1")
+
+    /** site.test and other.test are the test server; private.test is a home router. */
+    private val dns = Dns { host ->
+        when (host) {
+            "site.test", "other.test" -> listOf(InetAddress.getByAddress(host, loopback.address))
+            "private.test" -> listOf(InetAddress.getByAddress(host, byteArrayOf(192.toByte(), 168.toByte(), 1, 1)))
+            "mixed.test" -> listOf(InetAddress.getByAddress(host, byteArrayOf(93, 184.toByte(), 216.toByte(), 34)), InetAddress.getByAddress(host, byteArrayOf(10, 0, 0, 1)))
+            else -> throw UnknownHostException(host)
+        }
+    }
+
+    private var now = 1_000_000L
+    private val waits = CopyOnWriteArrayList<Long>()
+    private val ledger = OwnLedger({ File(folder.root, "ledger.json") }, { now })
+
+    private fun fetcher(limits: HerFetcher.Limits = HerFetcher.Limits(perHostMillis = 0)) = HerFetcher(
+        base = base,
+        systemDns = dns,
+        // The test server is on loopback: let it through by its names, and nothing else.
+        addressAllowed = { address -> (address.hostName in setOf("site.test", "other.test") && address.isLoopbackAddress) || PublicAddress.isPublic(address) },
+        limits = limits,
+        clock = { now },
+        pause = { waits += it; now += it },
+        ledger = ledger
+    )
+
+    private fun url(path: String, host: String = "site.test") = "https://$host:${server.port}$path"
+
+    private val requests = CopyOnWriteArrayList<RecordedRequest>()
+
+    private fun serve(robots: String? = "User-agent: *\nAllow: /\n", route: (RecordedRequest) -> MockResponse) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                requests += request
+                if (request.target == "/robots.txt") {
+                    return if (robots == null) MockResponse.Builder().code(404).build()
+                    else MockResponse.Builder().code(200).addHeader("Content-Type", "text/plain").body(robots).build()
+                }
+                return route(request)
+            }
+        }
+    }
+
+    private fun html(body: String, type: String = "text/html; charset=utf-8") =
+        MockResponse.Builder().code(200).addHeader("Content-Type", type).body(body).build()
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    // ── Where a fetch may go ─────────────────────────────────────────────────────────
+
+    private fun v4(vararg parts: Int) = InetAddress.getByAddress(parts.map { it.toByte() }.toByteArray())
+    private fun v6(text: String) = InetAddress.getByName(text)
+
+    @Test
+    fun `the SSRF table - only public addresses`() {
+        val refused = listOf(
+            v4(127, 0, 0, 1), v4(0, 0, 0, 0), v4(10, 1, 2, 3), v4(172, 16, 0, 1), v4(172, 31, 255, 255), v4(192, 168, 0, 1),
+            v4(169, 254, 169, 254), v4(100, 64, 0, 1), v4(100, 127, 255, 254), v4(192, 0, 0, 1), v4(192, 0, 2, 1),
+            v4(198, 18, 0, 1), v4(198, 51, 100, 7), v4(203, 0, 113, 9), v4(224, 0, 0, 1), v4(255, 255, 255, 255),
+            v6("::1"), v6("::"), v6("fe80::1"), v6("fc00::1"), v6("fd12:3456::1"), v6("fec0::1"), v6("ff02::1"),
+            v6("::ffff:127.0.0.1"), v6("::ffff:10.0.0.1"), v6("64:ff9b::a00:1"), v6("2002:a00:1::"), v6("2001:0:4136:e378::1"),
+            v6("2001:db8::1")
+        )
+        for (address in refused) assertFalse(address.hostAddress, PublicAddress.isPublic(address))
+        val public = listOf(v4(93, 184, 216, 34), v4(8, 8, 8, 8), v4(100, 63, 0, 1), v4(100, 128, 0, 1), v4(172, 32, 0, 1), v6("2606:4700::1111"), v6("::ffff:8.8.8.8"), v6("2002:808:808::"))
+        for (address in public) assertTrue(address.hostAddress, PublicAddress.isPublic(address))
+    }
+
+    @Test
+    fun `names that are literals or local are refused before any lookup`() {
+        val table = mapOf(
+            "10.0.0.1" to Why.IP_LITERAL, "127.1" to Why.IP_LITERAL, "2130706433" to Why.IP_LITERAL, "0x7f.0.0.1" to Why.IP_LITERAL,
+            "[::1]" to Why.IP_LITERAL, "fe80::1" to Why.IP_LITERAL,
+            "localhost" to Why.LOCAL_NAME, "router" to Why.LOCAL_NAME, "printer.local" to Why.LOCAL_NAME,
+            "abc.onion" to Why.LOCAL_NAME, "nas.home.arpa" to Why.LOCAL_NAME, "dev.localhost" to Why.LOCAL_NAME
+        )
+        for ((host, why) in table) assertEquals(host, why, HerFetcher.hostRefusal(host))
+        assertNull(HerFetcher.hostRefusal("ja.wikipedia.org"))
+        assertNull(HerFetcher.hostRefusal("123.example.com"))
+    }
+
+    @Test
+    fun `only https, and never to a private or unknown address`() = runBlocking {
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.NOT_HTTPS), fetcher.fetch("http://site.test/"))
+        assertEquals(Fetched.Refused(Why.IP_LITERAL), fetcher.fetch("https://192.168.1.1/admin"))
+        assertEquals(Fetched.Refused(Why.IP_LITERAL), fetcher.fetch("https://[::1]/"))
+        assertEquals(Fetched.Refused(Why.LOCAL_NAME), fetcher.fetch("https://printer.local/"))
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch(url("/", host = "private.test")))
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch("https://mixed.test/"))
+        assertEquals(Fetched.Refused(Why.NO_ADDRESS), fetcher.fetch("https://nowhere.test/"))
+        assertEquals(Fetched.Refused(Why.BAD_URL), fetcher.fetch("not a url"))
+        assertEquals(0, server.requestCount)
+    }
+
+    @Test
+    fun `each redirect is checked again - a redirect to a private address is refused`() = runBlocking {
+        serve { request ->
+            when (request.target) {
+                "/to-private" -> MockResponse.Builder().code(302).addHeader("Location", url("/admin", host = "private.test")).build()
+                "/to-literal" -> MockResponse.Builder().code(301).addHeader("Location", "https://10.0.0.1/").build()
+                "/to-http" -> MockResponse.Builder().code(302).addHeader("Location", "http://site.test:${server.port}/").build()
+                "/to-other" -> MockResponse.Builder().code(307).addHeader("Location", url("/page", host = "other.test")).build()
+                "/page" -> html("<p>arrived</p>")
