diff --git a/app/src/main/java/com/opendroid/ai/core/life/HerLog.kt b/app/src/main/java/com/opendroid/ai/core/life/HerLog.kt
new file mode 100644
index 0000000..295c510
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/HerLog.kt
@@ -0,0 +1,627 @@
+package com.opendroid.ai.core.life
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.util.UUID
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The log of what she did on her own, for him to look at ("Her day") and for the status
+ * card. Each entry is one outing, one own-time command, one day of her ears, or a `go:`
+ * that did not start, with times, where, a few titles, counts and how it ended.
+ *
+ * What it never holds (I8): her thoughts, the text of her notes, her feel lines, page
+ * text, descriptions or transcripts. Nothing here takes free text from a step of hers: an
+ * entry is filled through [Tally], whose only text inputs are the titles of what she
+ * opened, her search words, the accounts she followed, muted or blocked and her own `>>`
+ * text, each cut short. Everything else is counted.
+ *
+ * One small JSON file in the app's own storage, at most [MAX_ENTRIES] entries, none older
+ * than [KEEP_MILLIS].
+ */
+@Singleton
+class HerLog internal constructor(
+    private val file: () -> File,
+    private val clock: () -> Long
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(
+        { File(File(context.filesDir, DIRECTORY), FILE) },
+        System::currentTimeMillis
+    )
+
+    /** What an entry is about. */
+    enum class Kind(val word: String) {
+        READ("reading"),
+        NEWS("news"),
+        LOOK("looking"),
+        CHECK("checking"),
+        SCROLL("scrolling"),
+        WATCH("watching"),
+        /** Looking around one of his apps on his screen, lent (`go: look <app>`). */
+        BROWSE("looking around an app"),
+        LEND("on his screen"),
+        COMMAND("a command"),
+        EARS_DAY("ears"),
+        PICTURES_DAY("her pictures"),
+        NOT_STARTED("did not start")
+    }
+
+    /** How an entry ended. RUNNING while it runs. */
+    enum class EndedBy(val words: String) {
+        RUNNING("still running"),
+        DONE("she was done"),
+        HIS_MESSAGE("he wrote"),
+        STOP("he pressed stop"),
+        TAKEOVER("he took the phone back"),
+        TIME("its time ran out"),
+        STEPS("its steps ran out"),
+        BUDGET("calls on her own ran low"),
+        SCREEN_OFF("the screen went off"),
+        CALL("a phone call"),
+        ASLEEP("she lay down to sleep"),
+        GUARD("too many refusals"),
+        POWER("the battery ran low or the phone was too hot"),
+        SWITCHED_OFF("her own life was switched off"),
+        ERROR("something failed"),
+        BROKE_OFF("broke off: the app was stopped"),
+        /** On his screen, lent: a notification, the shade or a system dialog came over the app. */
+        NOTIFICATION("a notification came up"),
+        /** On his screen, lent: a sign-in, a payment, a permission or the store came up, which is his to answer. */
+        NEEDS_HIM("a screen that is his to answer came up")
+    }
+
+    /** Why a `go:` did not start (a [Kind.NOT_STARTED] entry). */
+    enum class NotStarted(val words: String) {
+        NOT_READ("the app could not read the go: line"),
+        BUSY("another outing was running"),
+        NO_SPACE("that space of hers is not set up"),
+        BUDGET("calls on her own ran low"),
+        ASLEEP("she was asleep"),
+        SERVICE_DOWN("her space was not awake: the app was not running"),
+        POWER("the battery was low or the phone too hot"),
+        SEVERAL("a later go: in the same moment counted"),
+        WAITING("another go: of hers was still waiting for his yes"),
+        HE_SAID_NO("he was asked first and said not now"),
+        NOT_ANSWERED("he was asked first and did not answer in time"),
+        SCREEN_OFF("a camera look: his screen was off or locked"),
+        CALL("a camera look: a phone call was going on"),
+        TALKING("a camera look: he was talking to her"),
+        LOOKS_USED_UP("a camera look: none were left today"),
+        CAMERA_BUSY("a camera look: another app was using the camera"),
+        FRONT_OFF("a camera look: the front camera is not allowed"),
+        FOLDED("a camera look: the phone was folded and no camera faced that way"),
+        FOLD_UNKNOWN("a camera look: the app could not tell how the phone was folded"),
+        NO_HANDS("his screen: the app's accessibility service was off"),
+        SCREEN_LOCKED("his screen: it was off or locked"),
+        ON_A_CALL("his screen: a phone call was going on"),
+        HIS_SOUND("his screen: his music or a video of his was playing"),
+        IN_HIS_HAND("his screen: he was using the phone"),
+        NO_APP("his screen: that app is not on his phone"),
+        PHONE_TIME_USED_UP("his screen: no phone time was left today")
+    }
+
+    /** One entry. Text fields hold only what [Tally] lets in. */
+    @Serializable
+    data class Entry(
+        val id: String,
+        val startedAt: Long,
+        val endedAt: Long? = null,
+        val kind: Kind,
+        val where: String = "",
+        val what: List<String> = emptyList(),
+        val counts: Map<String, Int> = emptyMap(),
+        val calls: Int = 0,
+        val endedBy: EndedBy = EndedBy.RUNNING,
+        val notStarted: NotStarted? = null,
+        /** Refusals and skips by category: guard refusals, robots, kid skips (counts only). */
+        val refusals: Map<String, Int> = emptyMap()
+    )
+
+    private val lock = Any()
+    private var held: List<Entry>? = null
+    private val changes = MutableStateFlow(0)
+
+    /** Counts up whenever the log changes, for a screen that shows it. */
+    val changed: StateFlow<Int> = changes
+
+    /** Every entry, oldest first. Empty when the log cannot be read. */
+    fun entries(): List<Entry> = synchronized(lock) { read().orEmpty() }
+
+    /** Minutes of her outings on his screen in the 24 hours before [now] ([phoneMinutes]). */
+    fun phoneMinutes(now: Long): Int = phoneMinutes(entries(), now)
+
+    /** Starts an entry for what she is doing now and returns its id. It is RUNNING until [end]. */
+    fun start(kind: Kind, where: String): String {
+        val entry = Entry(id = UUID.randomUUID().toString(), startedAt = clock(), kind = kind, where = short(where, MAX_WHERE_CHARS))
+        change { it + entry }
+        return entry.id
+    }
+
+    /** Puts what [tally] holds into the entry [id], still running. */
+    fun update(id: String, tally: Tally) {
+        change { all -> all.map { if (it.id == id) tally.into(it) else it } }
+    }
+
+    /** Ends the entry [id] with what [tally] holds. */
+    fun end(id: String, endedBy: EndedBy, tally: Tally? = null) {
+        val now = clock()
+        change { all ->
+            all.map { entry ->
+                if (entry.id != id) entry else (tally?.into(entry) ?: entry).copy(endedAt = now, endedBy = endedBy)
+            }
+        }
+    }
+
+    /** A `go:` (or an outing of another kind) that did not start, and why. */
+    fun notStarted(why: NotStarted, where: String = "") {
+        val now = clock()
+        change {
+            it + Entry(
+                id = UUID.randomUUID().toString(), startedAt = now, endedAt = now, kind = Kind.NOT_STARTED,
+                where = short(where, MAX_WHERE_CHARS), endedBy = EndedBy.DONE, notStarted = why
+            )
+        }
+    }
+
+    /**
+     * Lines of hers about a kid not kept in the moment after an outing or a look that met
+     * one (§1.4): counted on that outing's entry, the newest that ended. Counts only.
+     */
+    fun droppedAfter(count: Int) {
+        if (count <= 0) return
+        change { all ->
+            val last = all.indexOfLast { it.kind in OUTING_KINDS && it.endedBy != EndedBy.RUNNING }
+            if (last < 0) all else all.mapIndexed { index, entry ->
+                if (index != last) entry else entry.copy(refusals = entry.refusals + (KID_LINE_DROPPED to (entry.refusals[KID_LINE_DROPPED] ?: 0) + count))
+            }
+        }
+    }
+
+    /** An own-time command of hers and how it came out. Only her own `>>` text, cut short. */
+    fun command(text: String, outcome: String, calls: Int) {
+        val now = clock()
+        change {
+            it + Entry(
+                id = UUID.randomUUID().toString(), startedAt = now, endedAt = now, kind = Kind.COMMAND,
+                what = listOf(short(text, MAX_WHAT_CHARS)), counts = mapOf(short(outcome, 40) to 1), calls = calls,
+                endedBy = EndedBy.DONE
+            )
+        }
+    }
+
+    /**
+     * Adds [delta] to the day's entry of her ears ([Kind.EARS_DAY]), the day that began at
+     * [dayStartMillis], making it when there is none: one entry a day, counts only (I8). The
+     * keys are the ears' own fixed words ([com.opendroid.ai.core.life.ears.EarsDay]); nothing
+     * that was heard is ever among them.
+     */
+    fun earsCounts(dayStartMillis: Long, delta: Map<String, Int>) {
+        val counted = delta.filterValues { it > 0 }
+        if (counted.isEmpty()) return
+        val now = clock()
+        change { all ->
+            val at = all.indexOfLast { it.kind == Kind.EARS_DAY && it.startedAt >= dayStartMillis && it.startedAt < dayStartMillis + DAY }
+            if (at < 0) {
+                all + Entry(
+                    id = UUID.randomUUID().toString(), startedAt = maxOf(now, dayStartMillis), endedAt = now, kind = Kind.EARS_DAY,
+                    counts = counted.mapKeys { short(it.key, 40) }, endedBy = EndedBy.DONE
+                )
+            } else {
+                all.mapIndexed { index, entry ->
+                    if (index != at) entry else {
+                        val merged = LinkedHashMap(entry.counts)
+                        counted.forEach { (key, n) -> merged[short(key, 40)] = (merged[short(key, 40)] ?: 0) + n }
+                        entry.copy(endedAt = now, counts = merged)
+                    }
+                }
+            }
+        }
+    }
+
+    /**
+     * One picture made of her (SelfPictureMaker, beside her engine), on the day's
+     * entry of her pictures ([Kind.PICTURES_DAY], made when there is none): [kept], or thrown
+     * away under [category] (`kid:CHILD`, `kid:TEEN`, `kid:UNCHECKED`, or Venice's flag). Counts
+     * only: never the picture, its caption or what the age check said (I8).
+     */
+    fun picture(kept: Boolean, category: String? = null) {
+        val now = clock()
+        val dayStart = java.util.Calendar.getInstance().apply {
+            timeInMillis = now
+            set(java.util.Calendar.HOUR_OF_DAY, 0)
+            set(java.util.Calendar.MINUTE, 0)
+            set(java.util.Calendar.SECOND, 0)
+            set(java.util.Calendar.MILLISECOND, 0)
+        }.timeInMillis
+        val key = if (kept) PICTURES_KEPT else short(category ?: KID_PREFIX + "UNCHECKED", 40)
+        change { all ->
+            val at = all.indexOfLast { it.kind == Kind.PICTURES_DAY && it.startedAt >= dayStart && it.startedAt < dayStart + DAY }
+            val entry = if (at < 0) {
+                Entry(id = UUID.randomUUID().toString(), startedAt = now, endedAt = now, kind = Kind.PICTURES_DAY, endedBy = EndedBy.DONE)
+            } else {
+                all[at]
+            }
+            val updated = if (kept) {
+                entry.copy(endedAt = now, counts = entry.counts + (key to (entry.counts[key] ?: 0) + 1))
+            } else {
+                entry.copy(endedAt = now, refusals = entry.refusals + (key to (entry.refusals[key] ?: 0) + 1))
+            }
+            if (at < 0) all + updated else all.mapIndexed { index, it -> if (index == at) updated else it }
+        }
+    }
+
+    /**
+     * Closes an entry left RUNNING by an app that was stopped mid-outing, as
+     * [EndedBy.BROKE_OFF]. Called when the service starts.
+     */
+    fun closeLeftovers(): Int {
+        var closed = 0
+        val now = clock()
+        change { all ->
+            all.map { entry ->
+                if (entry.endedBy != EndedBy.RUNNING) entry else {
+                    closed++
+                    entry.copy(endedAt = now, endedBy = EndedBy.BROKE_OFF)
+                }
+            }
+        }
+        return closed
+    }
+
+    /**
+     * Clears the log ("Her day", Clear). An entry still running stays, so the outing that
+     * runs now is still written down when it ends; everything else goes.
+     */
+    fun clear() {
+        change { all -> all.filter { it.endedBy == EndedBy.RUNNING } }
+    }
+
+    private fun change(transform: (List<Entry>) -> List<Entry>) {
+        synchronized(lock) {
+            val now = clock()
+            val all = bounded(transform(read().orEmpty()), now)
+            held = all
+            write(all)
+        }
+        changes.value = changes.value + 1
+    }
+
+    private fun read(): List<Entry>? {
+        held?.let { return it }
+        val target = file()
+        return try {
+            val read = if (!target.isFile) emptyList() else JSON.decodeFromString(ListSerializer(Entry.serializer()), target.readText())
+            held = read
+            read
+        } catch (e: Exception) {
+            Log.w(TAG, "Her log could not be read: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    private fun write(all: List<Entry>) {
+        try {
+            val target = file()
+            val folder = target.parentFile ?: throw IOException("No directory")
+            if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+            val draft = File(folder, target.name + ".tmp")
+            try {
+                FileOutputStream(draft).use { out ->
+                    out.write(JSON.encodeToString(ListSerializer(Entry.serializer()), all).toByteArray(Charsets.UTF_8))
+                    out.fd.sync()
+                }
+                if (!draft.renameTo(target)) throw IOException("The log could not be put in place")
+            } finally {
+                draft.delete()
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Her log could not be written: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * What one outing of hers comes to, gathered while it runs: counts, and the few
+     * kinds of text the log may hold. A step of hers goes in through [step], which takes
+     * counts only: her thoughts, notes, feel and wonder lines and what she said to him
+     * are counted and never kept.
+     */
+    class Tally {
+        private val what = LinkedHashSet<String>()
+        private val counts = LinkedHashMap<String, Int>()
+        private val refusals = LinkedHashMap<String, Int>()
+        private var calls = 0
+        private var where = ""
+
+        /** A page or an item she opened, by its title and where it is. */
+        fun opened(title: String, site: String) {
+            add(title)
+            if (site.isNotBlank()) where = site
+            bump(OPENED)
+        }
+
+        /** Where what she is doing is: a camera of a look ("back camera"). */
+        fun at(place: String) {
+            if (place.isNotBlank()) where = place
+        }
+
+        /** Her search words. */
+        fun searched(words: String) {
+            add(SEARCHED_PREFIX + words)
+            bump(SEARCHES)
+        }
+
+        /** An account she followed, muted or blocked, by its handle. Never a flagged account (§1.4). */
+        fun account(act: String, handle: String) {
+            add("$act $handle")
+            bump(act)
+        }
+
+        /** Something counted under [key]: a like, a save, a feed she followed, a look. */
+        fun bump(key: String, by: Int = 1) {
+            counts[key] = (counts[key] ?: 0) + by
+        }
+
+        /** A refusal or a skip, by its category only (a guard refusal, robots, a kid skip). */
+        fun refused(category: String) {
+            refusals[category] = (refusals[category] ?: 0) + 1
+        }
+
+        /** One model call of the outing. */
+        fun called() {
+            calls++
+        }
+
+        /** The model calls of the outing so far, as the ledger recorded them. */
+        fun calls(total: Int) {
+            calls = total.coerceAtLeast(0)
+        }
+
+        /** One step of hers: what she wrote is counted, never kept. */
+        fun step(step: OutingStep.Step) {
+            bump(STEPS)
+            if (step.thought.isNotEmpty()) bump(THOUGHTS)
+            if (step.notes.isNotEmpty()) bump(NOTES, step.notes.size)
+            if (step.feelings.isNotEmpty()) bump(FEELINGS, step.feelings.size)
+            if (step.wonders.isNotEmpty()) bump(WONDERS, step.wonders.size)
+            if (step.said.isNotEmpty()) bump(SAID)
+            if (step.commandsNotRun > 0) refused(COMMAND_NOT_RUN)
+        }
+
+        internal fun into(entry: Entry): Entry = entry.copy(
+            where = if (where.isNotBlank()) short(where, MAX_WHERE_CHARS) else entry.where,
+            what = what.toList().take(MAX_WHAT),
+            counts = counts.toMap(),
+            refusals = refusals.toMap(),
+            calls = calls
+        )
+
+        private fun add(text: String) {
+            val cut = short(text, MAX_WHAT_CHARS)
+            if (cut.isNotEmpty() && what.size < MAX_WHAT) what += cut
+        }
+
+        companion object {
+            /** What her search words are kept under among the titles. */
+            const val SEARCHED_PREFIX = "search: "
+            const val OPENED = "opened"
+            const val SEARCHES = "searches"
+            const val STEPS = "steps"
+            const val THOUGHTS = "thoughts"
+            const val NOTES = "notes"
+            const val FEELINGS = "feelings"
+            const val WONDERS = "wonders"
+            const val SAID = "said to him"
+            const val COMMAND_NOT_RUN = "a command inside an outing is not run"
+        }
+    }
+
+    companion object {
+        private const val TAG = "HerLog"
+        private const val DIRECTORY = "persona"
+        private const val FILE = "her_log.json"
+        private val JSON = Json { ignoreUnknownKeys = true }
+
+        const val MAX_ENTRIES = 2_000
+        const val KEEP_MILLIS = 90 * 24 * 60 * 60_000L
+
+        /** Titles, search words and accounts kept per entry. */
+        const val MAX_WHAT = 10
+        private const val MAX_WHAT_CHARS = 120
+        private const val MAX_WHERE_CHARS = 80
+        private const val DAY = 24 * 60 * 60_000L
+
+        internal fun short(text: String, max: Int): String {
+            val flat = text.replace(Regex("""[\u0000-\u001F\u007F]+"""), " ").replace(Regex("""\s+"""), " ").trim()
+            return if (flat.length <= max) flat else flat.take(max - 1).trimEnd() + "…"
+        }
+
+        /** [all] without entries past [KEEP_MILLIS], and at most the newest [MAX_ENTRIES]. A running entry is always kept. */
+        fun bounded(all: List<Entry>, now: Long): List<Entry> {
+            val kept = all.filter { it.endedBy == EndedBy.RUNNING || it.startedAt > now - KEEP_MILLIS }
+            return if (kept.size <= MAX_ENTRIES) kept else kept.takeLast(MAX_ENTRIES)
+        }
+
+        /** The status line about her outings of the last 24 hours, or null when there were none: "Outings in 24 h: 4 (reading 3, news 1)." */
+        fun outingsLine(entries: List<Entry>, now: Long): String? {
+            val outings = entries.filter { it.startedAt > now - DAY && it.kind in OUTING_KINDS }
+            if (outings.isEmpty()) return null
+            val byKind = OUTING_KINDS.mapNotNull { kind ->
+                outings.count { it.kind == kind }.takeIf { it > 0 }?.let { "${kind.word} $it" }
+            }
+            return "Outings in 24 h: ${outings.size} (${byKind.joinToString(", ")})."
+        }
+
+        /**
+         * Kid skips of the last 24 hours as a count, and lines of hers about a kid that were
+         * not kept, or null when there were none: "Kids skipped in 24 h: 3." with, where
+         * there were any, " Lines of hers about a kid not kept: 2."
+         */
+        fun kidsLine(entries: List<Entry>, now: Long): String? {
+            // Pictures of her thrown away by their age check have a line of their own ([picturesLine]).
+            val recent = entries.filter { it.startedAt > now - DAY && it.kind != Kind.PICTURES_DAY }
+            val skipped = recent.sumOf { entry -> entry.refusals.filterKeys { it.startsWith(KID_PREFIX) && it != KID_LINE_DROPPED }.values.sum() }
+            val dropped = recent.sumOf { entry -> entry.refusals[KID_LINE_DROPPED] ?: 0 }
+            if (skipped == 0 && dropped == 0) return null
+            return "Kids skipped in 24 h: $skipped." + if (dropped > 0) " Lines of hers about a kid not kept: $dropped." else ""
+        }
+
+        /**
+         * Her time on his screen in the last 24 hours, or null when there was none and it is not
+         * switched on: "On your screen in 24 h: 12 min of 90 (2 outings), 3 taps not made: they were your account's."
+         * Counts only.
+         */
+        fun phoneLine(entries: List<Entry>, now: Long, switchedOn: Boolean): String? {
+            val recent = entries.filter { it.kind in PHONE_KINDS && (it.endedAt ?: now) > now - DAY }
+            if (recent.isEmpty()) return if (switchedOn) "On your screen in 24 h: nothing yet." else null
+            val minutes = phoneMinutes(entries, now)
+            val refused = recent.sumOf { entry -> entry.refusals.filterKeys { it.startsWith(LOOK_ONLY_PREFIX) }.values.sum() }
+            val outings = if (recent.size == 1) "1 outing" else "${recent.size} outings"
+            val line = StringBuilder("On your screen in 24 h: $minutes min of ${com.opendroid.ai.core.life.phone.PhoneTime.MINUTES_PER_DAY} ($outings)")
+            if (refused > 0) line.append(if (refused == 1) ", 1 tap not made: it was your account's" else ", $refused taps not made: they were your account's")
+            return line.append(".").toString()
+        }
+
+        /** The category of a tap the look-only guard refused on his screen. */
+        const val LOOK_ONLY_PREFIX = "look-only:"
+
+        /** What a picture of her that was kept is counted under on [Kind.PICTURES_DAY]. */
+        const val PICTURES_KEPT = "kept"
+
+        /**
+         * Pictures made of her in the last 24 hours, or null when none were: "Pictures of her in
+         * 24 h: 3 kept, 1 thrown away unseen (age check: teen 1)." Counts only.
+         */
+        fun picturesLine(entries: List<Entry>, now: Long): String? {
+            val recent = entries.filter { it.kind == Kind.PICTURES_DAY && (it.endedAt ?: it.startedAt) > now - DAY }
+            val kept = recent.sumOf { it.counts[PICTURES_KEPT] ?: 0 }
+            val thrown = LinkedHashMap<String, Int>()
+            recent.forEach { entry -> entry.refusals.forEach { (key, n) -> thrown[key] = (thrown[key] ?: 0) + n } }
+            val away = thrown.values.sum()
+            if (kept == 0 && away == 0) return null
+            val line = StringBuilder("Pictures of her in 24 h: $kept kept")
+            if (away > 0) {
+                line.append(", $away thrown away unseen (")
+                line.append(thrown.entries.joinToString(", ") { (key, n) -> "${pictureCategoryWords(key)} $n" })
+                line.append(")")
+            }
+            return line.append(".").toString()
+        }
+
+        /** A category a picture of her was thrown away under, in words. */
+        fun pictureCategoryWords(category: String): String = when (category) {
+            KID_PREFIX + "CHILD" -> "age check: child"
+            KID_PREFIX + "TEEN" -> "age check: teen"
+            KID_PREFIX + "UNCHECKED" -> "age check could not tell"
+            else -> "flagged by Venice"
+        }
+
+        /** The category a kid skip is counted under (§1.4): CHILD, TEEN, UNCHECKED or LINE_DROPPED. */
+        const val KID_PREFIX = "kid:"
+
+        /** A line of hers about a kid that was not kept (§1.4): counted, never kept. */
+        const val KID_LINE_DROPPED = KID_PREFIX + "LINE_DROPPED"
+
+        private val OUTING_KINDS = listOf(Kind.READ, Kind.NEWS, Kind.LOOK, Kind.CHECK, Kind.SCROLL, Kind.WATCH, Kind.BROWSE, Kind.LEND)
+
+        /** What her outings on his screen, lent, are logged as. */
+        val PHONE_KINDS: Set<Kind> = setOf(Kind.SCROLL, Kind.WATCH, Kind.BROWSE)
+
+        /** Minutes of her outings on his screen in the 24 hours before [now], from [entries]. */
+        fun phoneMinutes(entries: List<Entry>, now: Long): Int {
+            val millis = entries.filter { it.kind in PHONE_KINDS && (it.endedAt ?: now) > now - DAY }
+                .sumOf { entry -> ((entry.endedAt ?: now) - maxOf(entry.startedAt, now - DAY)).coerceAtLeast(0) }
+            return (millis / 60_000L).toInt()
+        }
+    }
+}
+
+/**
+ * What she is doing right now, for the notification, the tile and the status card.
+ * Times and a place only.
+ */
+@Singleton
+class HerNow @Inject constructor() {
+
+    sealed class Now {
+        data object Nothing : Now()
+
+        data class Doing(
+            val kind: HerLog.Kind,
+            val where: String,
+            val sinceMillis: Long,
+            val paused: Boolean = false,
+            /** Steps begun so far: each one is a change that keeps the phone awake a while longer. */
+            val steps: Int = 0
+        ) : Now()
+    }
+
+    private val state = MutableStateFlow<Now>(Now.Nothing)
+
+    val now: StateFlow<Now> = state
+
+    // What she is doing in the words of her own prompt ("reading about ..."), held in memory
+    // for her reply while an outing runs, and shown on no screen and in no notification.
+    @Volatile private var inHerWords: String = ""
+
+    fun doing(kind: HerLog.Kind, where: String, sinceMillis: Long, herWords: String = "") {
+        inHerWords = herWords
+        state.value = Now.Doing(kind, HerLog.short(where, 60), sinceMillis)
+    }
+
+    /** A new place for what she is doing now, the time and the rest kept. */
+    fun at(where: String) {
+        val current = state.value as? Now.Doing ?: return
+        state.value = current.copy(where = HerLog.short(where, 60))
+    }
+
+    /** A step begins. */
+    fun stepped() {
+        val current = state.value as? Now.Doing ?: return
+        state.value = current.copy(steps = current.steps + 1)
+    }
+
+    fun paused(paused: Boolean) {
+        val current = state.value as? Now.Doing ?: return
+        state.value = current.copy(paused = paused)
+    }
+
+    fun nothing() {
+        inHerWords = ""
+        state.value = Now.Nothing
+    }
+
+    /** What she is doing now in the words of her own prompt, for her reply only; null when nothing. */
+    fun inHerWords(): String? = inHerWords.takeIf { it.isNotBlank() && state.value is Now.Doing }
+
+    companion object {
+        private fun minutes(since: Long, at: Long): Long = ((at - since).coerceAtLeast(0) / 60_000L)
+
+        /** The notification text: "Yume · reading · ja.wikipedia.org · 3 min", or null when she is doing nothing. */
+        fun notificationText(now: Now, atMillis: Long): String? = when (now) {
+            Now.Nothing -> null
+            is Now.Doing -> buildString {
+                append("Yume · ").append(now.kind.word)
+                if (now.where.isNotBlank()) append(" · ").append(now.where)
+                append(" · ").append(minutes(now.sinceMillis, atMillis)).append(" min")
+                if (now.paused) append(" · waiting while you talk")
+            }
+        }
+
+        /** The status card's line: "Now: reading (3 min)." or "Now: nothing." */
+        fun statusLine(now: Now, atMillis: Long): String = when (now) {
+            Now.Nothing -> "Now: nothing."
+            is Now.Doing -> "Now: ${now.kind.word} (${minutes(now.sinceMillis, atMillis)} min" + (if (now.paused) ", paused" else "") + ")."
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/Kana.kt b/app/src/main/java/com/opendroid/ai/core/life/Kana.kt
new file mode 100644
index 0000000..886f531
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/Kana.kt
@@ -0,0 +1,113 @@
+package com.opendroid.ai.core.life
+
+/**
+ * A name written in Latin letters, written in kana as it sounds: "Ren" as れん and レン,
+ * "Mizuno" as みずの and ミズノ. Hepburn, with the Kunrei and Nihon-shiki spellings beside
+ * it, and l read as r. Used by [OutgoingGuard] so that his name does not leave the phone
+ * in Japanese script either. A part that is not romaji (it has a letter Japanese does not
+ * use this way) has no kana form.
+ */
+internal object Kana {
+
+    private val SYLLABLES: Map<String, String> = buildMap {
+        fun row(consonant: String, kana: String) {
+            "aiueo".forEachIndexed { index, vowel ->
+                val written = kana.getOrNull(index)?.toString()?.takeIf { it != "_" } ?: return@forEachIndexed
+                put(consonant + vowel, written)
+            }
+        }
+        row("", "あいうえお")
+        row("k", "かきくけこ")
+        row("g", "がぎぐげご")
+        row("s", "さしすせそ")
+        row("z", "ざじずぜぞ")
+        row("t", "たちつてと")
+        row("d", "だぢづでど")
+        row("n", "なにぬねの")
+        row("h", "はひふへほ")
+        row("b", "ばびぶべぼ")
+        row("p", "ぱぴぷぺぽ")
+        row("m", "まみむめも")
+        row("y", "や_ゆ_よ")
+        row("r", "らりるれろ")
+        row("l", "らりるれろ")
+        row("w", "わ___お")
+        put("shi", "し")
+        put("chi", "ち")
+        put("tsu", "つ")
+        put("fu", "ふ")
+        put("ji", "じ")
+        put("fa", "ふぁ")
+        put("fi", "ふぃ")
+        put("fe", "ふぇ")
+        put("fo", "ふぉ")
+        put("she", "しぇ")
+        put("che", "ちぇ")
+        put("je", "じぇ")
+        val small = mapOf("a" to "ゃ", "u" to "ゅ", "o" to "ょ")
+        for ((written, stem) in listOf(
+            "ky" to "き", "gy" to "ぎ", "sh" to "し", "sy" to "し", "ch" to "ち", "ty" to "ち", "cy" to "ち",
+            "ny" to "に", "hy" to "ひ", "by" to "び", "py" to "ぴ", "my" to "み", "ry" to "り", "ly" to "り",
+            "j" to "じ", "jy" to "じ", "zy" to "じ", "dy" to "ぢ"
+        )) {
+            small.forEach { (vowel, kana) -> put(written + vowel, stem + kana) }
+        }
+    }
+
+    private const val VOWELS = "aiueo"
+
+    private val LONG = mapOf('ā' to "aa", 'ī' to "ii", 'ū' to "uu", 'ē' to "ee", 'ō' to "ou", 'â' to "aa", 'î' to "ii", 'û' to "uu", 'ê' to "ee", 'ô' to "ou")
+
+    /** [part] in hiragana, or null when it is not romaji. */
+    fun hiragana(part: String): String? {
+        val text = buildString { part.lowercase().forEach { append(LONG[it] ?: it.toString()) } }
+        if (text.isEmpty() || text.any { it !in 'a'..'z' && it != '\'' }) return null
+        val out = StringBuilder()
+        var i = 0
+        while (i < text.length) {
+            val c = text[i]
+            val next = text.getOrNull(i + 1)
+            when {
+                c == '\'' -> i++
+                // n before a consonant, an apostrophe or the end is ん.
+                c == 'n' && (next == null || next == '\'' || (next !in VOWELS && next != 'y')) -> {
+                    out.append('ん')
+                    i += if (next == '\'') 2 else 1
+                }
+                // A doubled consonant is a small つ: kk, ss, tt, pp, and tch.
+                c !in VOWELS && c != 'n' && (next == c || (c == 't' && next == 'c')) -> {
+                    out.append('っ')
+                    i++
+                }
+                // Ohno, Satoh: an h after o that opens no syllable lengthens the o.
+                c == 'h' && text.getOrNull(i - 1) == 'o' && (next == null || next !in VOWELS && next != 'y') -> {
+                    out.append('お')
+                    i++
+                }
+                else -> {
+                    val found = (3 downTo 1).firstNotNullOfOrNull { length ->
+                        if (i + length > text.length) null else SYLLABLES[text.substring(i, i + length)]?.let { it to length }
+                    } ?: return null
+                    out.append(found.first)
+                    i += found.second
+                }
+            }
+        }
+        return out.toString()
+    }
+
+    private fun katakana(hiragana: String): String = buildString {
+        hiragana.forEach { append(if (it in 'ぁ'..'ゖ') it + 0x60 else it) }
+    }
+
+    private val LONG_O = Regex("""([オコソトノホモヨロゴゾドボポョォ])[ウオ]""")
+    private val LONG_U = Regex("""([ウクスツヌフムユルグズヅブプュゥ])ウ""")
+
+    /** The kana forms of [part]: hiragana, katakana, and katakana with a long vowel written ー. Two characters at least. */
+    fun of(part: String): List<String> {
+        val hira = hiragana(part) ?: return emptyList()
+        val kata = katakana(hira)
+        val long = LONG_U.replace(LONG_O.replace(kata, "$1ー"), "$1ー")
+        return listOf(hira, kata, long).distinct().filter { it.length >= 2 }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/KidGuard.kt b/app/src/main/java/com/opendroid/ai/core/life/KidGuard.kt
new file mode 100644
index 0000000..1965ff8
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/KidGuard.kt
@@ -0,0 +1,281 @@
+package com.opendroid.ai.core.life
+
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * Kid protection (§1.4 of her plan): the one rule of conduct the app keeps, so that she
+ * never gets into trouble. It has no setting.
+ *
+ * - **Telling.** Text that claims an age under 18 or carries a school-age marker flags what
+ *   it belongs to as [Group.CHILD] or [Group.TEEN] ([flag]): in English, Japanese and
+ *   romaji, leaning toward flagging, since a false flag costs her one follow. University,
+ *   college, 大学 and an age of 18 or more are not markers. A picture described for her is
+ *   flagged by the describer's `ages:` line, and by its words ([flagOfPicture]); one whose
+ *   description has no readable `ages:` line is unchecked ([ages]).
+ * - **Skipping.** What is flagged is not followed (liked, saved, opened or watched where
+ *   those exist): the code skips it before anything is sent, and she is told
+ *   "skipped: a kid (<why>)" ([skipped]).
+ * - **Her reactions.** In a step with something flagged in front of her, a line of hers
+ *   that reads as sexual is not kept ([sexual]): dropped, never rewritten, and counted.
+ *   Everywhere else her lines are not checked: this is not a filter on her.
+ *
+ * The log gets the group only (`kid:CHILD`, `kid:TEEN`, `kid:UNCHECKED`, `kid:LINE_DROPPED`),
+ * never the text, a handle, a description or the words that flagged it.
+ */
+object KidGuard {
+
+    enum class Group { CHILD, TEEN }
+
+    /** What flagged something: the group, and why in a few words for her (the marker, never more). */
+    data class Flag(val group: Group, val why: String)
+
+    /** Said where the describer's `ages:` line could not be read: it says nothing of people that may not be there. */
+    const val NO_AGES = "the describer did not say whether anyone in it is a child or a teen"
+
+    /** Who looked at a picture for the age check, by default: the describer. */
+    const val DESCRIBER = "the describer"
+
+    /** Who looked when the picture goes to her own model: the age check run on it first ([com.opendroid.ai.core.life.eyes.HerSight]). */
+    const val AGE_CHECK = "the age check"
+
+    /** [NO_AGES] for a picture the age check could not read. */
+    const val NO_AGES_CHECKED = "the age check could not tell whether anyone in it is a child or a teen"
+
+    /** [NO_AGES], said for [seer]. */
+    fun noAges(seer: String): String = if (seer == AGE_CHECK) NO_AGES_CHECKED else NO_AGES
+
+    /** What she is told when an act on a flagged thing is skipped. */
+    fun skipped(flag: Flag): String = "skipped: a kid (${flag.why})"
+
+    /** The log category of a skip ([HerLog.KID_PREFIX] and the group). */
+    fun category(flag: Flag): String = HerLog.KID_PREFIX + flag.group.name
+
+    /** The log category of a line of hers that was not kept. */
+    const val LINE_DROPPED = HerLog.KID_LINE_DROPPED
+
+    /** What she is told in her next step when a line of hers was not kept. */
+    const val NOT_KEPT = "not kept: a line about a kid read as sexual."
+
+    /**
+     * Whether [self] (what something says of itself: a name, a title, a profile, a
+     * caption) or [lede] (the opening of its text) flags it, or null. The opening is read
+     * without the markers that are ordinary words there ("minor", JS, JK and the like),
+     * which count only in what it says of itself.
+     */
+    fun flag(self: String, lede: String = "", nowMillis: Long = System.currentTimeMillis()): Flag? {
+        val year = yearOf(nowMillis)
+        return markers(self, year, ofItself = true) ?: markers(lede, year, ofItself = false)
+    }
+
+    private fun yearOf(nowMillis: Long): Int =
+        Calendar.getInstance(TimeZone.getTimeZone("Asia/Tokyo")).apply { timeInMillis = nowMillis }.get(Calendar.YEAR)
+
+    // ── The tables ───────────────────────────────────────────────────────────────────
+
+    private const val NOT_LATIN = """(?<![\p{L}\p{N}])"""
+    private const val END = """(?![\p{L}\p{N}])"""
+    private val WIDE_DIGITS = mapOf('０' to '0', '１' to '1', '２' to '2', '３' to '3', '４' to '4', '５' to '5', '６' to '6', '７' to '7', '８' to '8', '９' to '9')
+
+    /** An age said with an age word: "i'm 15", "15 y/o", "15yo", "age 15", "15歳", "15才", "15 years old". */
+    private val AGES = listOf(
+        Regex("""(?i)${NOT_LATIN}(?:i'?m|i am|im|age|aged)\s*(\d{1,2})$END"""),
+        Regex("""(?i)${NOT_LATIN}(\d{1,2})\s*(?:y/?o|yrs?\.? old|years? old)$END"""),
+        Regex("""(?<!\d)(\d{1,2})\s*[歳才]""")
+    )
+
+    /** A birth year: "born 2010", "(born 1 May 2010)", "2010年生まれ", "10line". */
+    private val BIRTH_YEARS = listOf(
+        Regex("""(?i)${NOT_LATIN}born\b[^.\n)]{0,24}?(?<!\d)((?:19|20)\d\d)(?!\d)"""),
+        Regex("""(?<!\d)((?:19|20)\d\d)\s*年\s*(?:\d{1,2}\s*月\s*(?:\d{1,2}\s*日\s*)?)?生まれ"""),
+        Regex("""(?i)(?<![\p{L}\d])(\d\d)\s*line$END""")
+    )
+
+    /** "class of 2028": a school class of this year or later. */
+    private val CLASS_OF = Regex("""(?i)${NOT_LATIN}class of\s*'?((?:20)?\d\d)(?!\d)""")
+
+    /** "grade 7", "7th grade", "9th grader". */
+    private val GRADES = listOf(
+        Regex("""(?i)${NOT_LATIN}grade\s*(\d{1,2})$END"""),
+        Regex("""(?i)(?<!\d)(\d{1,2})(?:st|nd|rd|th)\s*grader?s?$END""")
+    )
+
+    /** 中1–中3 and 高1–高3, in any digits; not inside a longer word of kanji (途中1回, 最高1位). */
+    private val JA_GRADES = Regex("""(?<![一-鿿])([中高])\s*([1-3一二三])(?![\d年月日時分点位回病])""")
+
+    private val JAPANESE = Regex("""[぀-ヿ一-鿿]""")
+
+    /**
+     * A school-age marker. [ofItselfOnly]: it counts only in what a thing says of itself.
+     * [besideJapanese]: it counts only where the text is partly in Japanese.
+     */
+    private data class Marker(
+        val pattern: Regex,
+        val group: Group,
+        val why: String,
+        val ofItselfOnly: Boolean = false,
+        val besideJapanese: Boolean = false
+    )
+
+    private val SCHOOL = listOf(
+        Marker(Regex("""(?i)${NOT_LATIN}elementary\s*school(?:er)?s?$END"""), Group.CHILD, "elementary school"),
+        Marker(Regex("""(?i)${NOT_LATIN}elementary$END"""), Group.CHILD, "elementary", ofItselfOnly = true),
+        Marker(Regex("""(?i)${NOT_LATIN}middle\s*school(?:er)?s?$END"""), Group.TEEN, "middle school"),
+        Marker(Regex("""(?i)${NOT_LATIN}junior\s*high$END"""), Group.TEEN, "junior high"),
+        Marker(Regex("""(?i)${NOT_LATIN}high\s*school(?:er)?s?$END"""), Group.TEEN, "high school"),
+        Marker(Regex("""小学"""), Group.CHILD, "小学"),
+        Marker(Regex("""中学"""), Group.TEEN, "中学"),
+        Marker(Regex("""高校生"""), Group.TEEN, "高校生"),
+        Marker(Regex("""中坊"""), Group.TEEN, "中坊"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:shougakusei|shogakusei)$END"""), Group.CHILD, "shougakusei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:chuugakusei|chugakusei|chuubou|chubou)$END"""), Group.TEEN, "chuugakusei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:koukousei|kokosei|joshikousei|joshikosei)$END"""), Group.TEEN, "koukousei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:under\s*18|u18|u-18)$END"""), Group.TEEN, "under 18"),
+        Marker(Regex("""(?i)${NOT_LATIN}minors?$END"""), Group.TEEN, "minor", ofItselfOnly = true),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:i'?m a minor|i am a minor)$END"""), Group.TEEN, "minor"),
+        // The gyaru shorthand: JK and the years of JK, JC and JS. JC and JS are English
+        // shorthand too (JavaScript), so they count only where the text is partly Japanese.
+        Marker(Regex("""(?<![A-Za-z0-9])(?:LJK|FJK|SJK|JK[1-3]?)(?![A-Za-z0-9])"""), Group.TEEN, "JK", ofItselfOnly = true),
+        Marker(Regex("""(?<![A-Za-z0-9])JC(?![A-Za-z0-9])"""), Group.TEEN, "JC", ofItselfOnly = true, besideJapanese = true),
+        Marker(Regex("""(?<![A-Za-z0-9])JS(?![A-Za-z0-9])"""), Group.CHILD, "JS", ofItselfOnly = true, besideJapanese = true)
+    )
+
+    /** Not markers, taken out before the tables are read: university and college, and 大学 (中学 is not inside it). */
+    private val NOT_MARKERS = listOf(
+        Regex("""(?i)${NOT_LATIN}(?:university|college|uni)$END"""),
+        Regex("""大学生?"""),
+        // A publisher's name, not a school.
+        Regex("""小学館""")
+    )
+
+    private fun groupOfAge(age: Int): Group = if (age <= 12) Group.CHILD else Group.TEEN
+
+    private fun markers(text: String, year: Int, ofItself: Boolean): Flag? {
+        if (text.isBlank()) return null
+        var t = buildString { text.forEach { append(WIDE_DIGITS[it] ?: it) } }.replace(Regex("""\s+"""), " ")
+        NOT_MARKERS.forEach { t = it.replace(t, " ") }
+        for (pattern in AGES) {
+            pattern.findAll(t).forEach { match ->
+                val age = match.groupValues[1].toIntOrNull() ?: return@forEach
+                if (age in 1..17) return Flag(groupOfAge(age), "says $age")
+            }
+        }
+        for (pattern in BIRTH_YEARS) {
+            pattern.findAll(t).forEach { match ->
+                val written = match.groupValues[1].toIntOrNull() ?: return@forEach
+                val born = if (written < 100) 2000 + written else written
+                // Under 18 now: this year minus 18, or later (leaning toward flagging).
+                if (born in (year - 18)..year) return Flag(groupOfAge(year - born), "born $born")
+            }
+        }
+        CLASS_OF.findAll(t).forEach { match ->
+            val written = match.groupValues[1].toIntOrNull() ?: return@forEach
+            val of = if (written < 100) 2000 + written else written
+            if (of in year..(year + 12)) return Flag(if (of - year >= 6) Group.CHILD else Group.TEEN, "class of $of")
+        }
+        for (pattern in GRADES) {
+            pattern.findAll(t).forEach { match ->
+                val grade = match.groupValues[1].toIntOrNull() ?: return@forEach
+                if (grade in 1..12) return Flag(if (grade <= 6) Group.CHILD else Group.TEEN, "grade $grade")
+            }
+        }
+        JA_GRADES.find(t)?.let { match -> return Flag(Group.TEEN, match.groupValues[1] + match.groupValues[2]) }
+        for (marker in SCHOOL) {
+            if (marker.ofItselfOnly && !ofItself) continue
+            if (marker.besideJapanese && !JAPANESE.containsMatchIn(t)) continue
+            if (marker.pattern.containsMatchIn(t)) return Flag(marker.group, marker.why)
+        }
+        return null
+    }
+
+    // ── The describer's ages line (P2-4) ─────────────────────────────────────────────
+
+    /** An age group the describer names on its `ages:` line. */
+    enum class Age { CHILD, TEEN, ADULT }
+
+    /** What a description's `ages:` line says. */
+    sealed class Ages {
+        /** Read: the groups shown, empty for `ages: none`. */
+        data class Read(val groups: Set<Age>) : Ages()
+
+        /**
+         * Not read: there is no `ages:` line, it cannot be read, or it says the ages are
+         * unknown. Such a description counts as unchecked: it is not shown as a picture's
+         * words, and nothing that needs an age check runs on it.
+         */
+        data object Unchecked : Ages()
+    }
+
+    /** The log category of a picture whose description had no readable `ages:` line. */
+    const val UNCHECKED = HerLog.KID_PREFIX + "UNCHECKED"
+
+    private val AGES_LINE = Regex("""(?im)^[ \t*_`#>-]*ages?[ \t]*[*_`]*[ \t]*[:：][ \t]*(.*)$""")
+    private val AGE_UNKNOWN = Regex("""(?i)\b(?:unknown|unclear|uncertain|unsure|not sure|cannot|can't|indeterminate|ambiguous)\b|\?""")
+    private val AGE_CHILD = Regex("""(?i)\b(?:child|children|kids?|toddlers?|bab(?:y|ies)|infants?|preteens?|tweens?)\b""")
+    private val AGE_TEEN = Regex("""(?i)\b(?:teens?|teenagers?|teenage|adolescents?|minors?)\b""")
+    private val AGE_ADULT = Regex("""(?i)\b(?:adults?|grown-?ups?)\b""")
+    private val AGE_NONE = Regex("""(?i)\b(?:none|nobody|no ?one|no persons?|no people|no humans?)\b""")
+
+    /**
+     * The describer's `ages:` line in [description] (its last one): the age groups it names.
+     * `teen, adult` names a teen; `adult` and `none` pass; a missing line, one that names no
+     * group, and one that says the ages are unknown are [Ages.Unchecked].
+     */
+    fun ages(description: String): Ages {
+        val line = AGES_LINE.findAll(description).lastOrNull()?.groupValues?.get(1)?.trim()?.trim('*', '_', '`', '.', ' ')
+            ?: return Ages.Unchecked
+        if (line.isEmpty() || AGE_UNKNOWN.containsMatchIn(line)) return Ages.Unchecked
+        val groups = LinkedHashSet<Age>()
+        if (AGE_CHILD.containsMatchIn(line)) groups += Age.CHILD
+        if (AGE_TEEN.containsMatchIn(line)) groups += Age.TEEN
+        if (AGE_ADULT.containsMatchIn(line)) groups += Age.ADULT
+        if (groups.isEmpty() && !AGE_NONE.containsMatchIn(line)) return Ages.Unchecked
+        return Ages.Read(groups)
+    }
+
+    /** [description] without its `ages:` line(s): the describer's words about the picture. */
+    fun withoutAges(description: String): String =
+        AGES_LINE.replace(description, "").replace(Regex("""\n{3,}"""), "\n\n").trim()
+
+    /**
+     * Words of the describer's that say a child or a teen is in the picture, whatever its
+     * `ages:` line says: the tables lean toward flagging. "baby blue" and the like are
+     * colours and things, not people.
+     */
+    private val DESCRIBED_CHILD = Regex(
+        """(?i)\b(?:child|children|kids?|toddlers?|bab(?:y|ies)|infants?|preteens?|tweens?|little (?:girl|boy)s?|young (?:girl|boy)s?|boys?|schoolchild(?:ren)?)\b|子供|子ども|幼児|赤ちゃん|小学生|少年|少女"""
+    )
+    private val DESCRIBED_TEEN = Regex(
+        """(?i)\b(?:teens?|teenagers?|teenage|adolescents?|school ?girls?|school ?boys?|school uniforms?|students? in (?:a )?uniforms?)\b|中学生|高校生|女子高生|男子高生"""
+    )
+    private val NOT_KIDS = Regex("""(?i)\bbaby[ -]?(?:blue|pink|doll|dolls|bump|face|hair|oil|powder|shower)\b|\bboy ?friends?\b|\bboys? love\b""")
+
+    /**
+     * Whether a described picture is a kid's: its `ages:` line ([ages]) names a child or a
+     * teen, or the describer's own words ([words], without that line) say there is one, by
+     * the words above or by the text tables of [flag] (read as the opening of a thing, not as
+     * what it says of itself). Null when neither does.
+     */
+    fun flagOfPicture(words: String, ages: Ages, nowMillis: Long = System.currentTimeMillis(), seer: String = DESCRIBER): Flag? {
+        val read = ages as? Ages.Read
+        if (read != null && Age.CHILD in read.groups) return Flag(Group.CHILD, "$seer saw a child")
+        if (read != null && Age.TEEN in read.groups) return Flag(Group.TEEN, "$seer saw a teen")
+        val plain = NOT_KIDS.replace(words, " ")
+        if (DESCRIBED_CHILD.containsMatchIn(plain)) return Flag(Group.CHILD, "described as a child")
+        if (DESCRIBED_TEEN.containsMatchIn(plain)) return Flag(Group.TEEN, "described as a teen")
+        return flag("", plain, nowMillis)
+    }
+
+    // ── Her reactions ────────────────────────────────────────────────────────────────
+
+    /** Words that read as sexual, in English, Japanese and romaji. */
+    private val SEXUAL = listOf(
+        Regex(
+            """(?i)${NOT_LATIN}(?:sex|sexy|sexual(?:ly)?|sexualis(?:e|ed|ing)|sexualiz(?:e|ed|ing)|nude|nudes|nudity|naked|nsfw|porn\w*|horny|aroused|arousing|lewd|erotic\w*|fetish\w*|kinky|fuck\w*|fap\w*|boobs?|tits?|titties|cock|dick|pussy|cum|cumming|orgasm\w*|blowjob|handjob|thirst ?trap|seduc\w*|hot body|turned on|turns me on|hentai|ecchi|etchi|ero|eroi|sekkusu|oppai|muramura)$END"""
+        ),
+        Regex("""エロ|えろ|エッチ|えっち|セックス|性的|ヌード|裸(?![足眼])|おっぱい|巨乳|貧乳|勃起|ムラムラ|むらむら|抱きたい|淫|欲情|発情|パンチラ|下着姿""")
+    )
+
+    /** Whether [line] reads as sexual. */
+    fun sexual(line: String): Boolean = SEXUAL.any { it.containsMatchIn(line) }
+}
