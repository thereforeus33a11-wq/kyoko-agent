+++ b/app/src/main/java/com/opendroid/ai/core/persona/VeniceImages.kt
@@ -0,0 +1,225 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.eyes.EyesImage
+import com.opendroid.ai.core.llm.providers.cancellable
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.util.Base64
+import java.util.concurrent.TimeUnit
+
+/**
+ * Venice's three image endpoints as her pictures use them, by Venice's API reference
+ * (docs.venice.ai, swagger 20261118): what each request holds, and what is read of each answer.
+ *
+ * - `POST /image/generate` ([generate]): model, prompt, negative prompt, size, steps and
+ *   guidance where the model is sized in pixels, a seed chosen on the phone, unblurred
+ *   (`safe_mode` false), without Venice's watermark (`hide_watermark` true), without the prompt
+ *   written into the file (`embed_exif_metadata` false), as PNG, one picture, answered as JSON
+ *   with the picture in base64. Never `enhance_prompt` (Venice would rewrite the prompt, and
+ *   could drop the adult guard), never a style preset or a LoRA strength.
+ * - `POST /image/edit` ([edit]): model, the one picture, prompt, unblurred, PNG, and an aspect
+ *   ratio where one is wanted. It takes no negative prompt, seed, steps, guidance, watermark or
+ *   strength: a request with any of those is turned down, so none is sent.
+ * - `POST /image/multi-edit` ([multiEdit]): the same, with `modelId` (not `model`) and the
+ *   pictures in order: the one to change first, then the ones it is matched to.
+ *
+ * Every answer is read for `x-venice-is-content-violation` (a picture Venice flags is never
+ * kept: it can be blacked out) and `x-venice-is-blurred`. Bytes that are not a PNG, JPEG or
+ * WebP by their first bytes are no picture.
+ */
+object VeniceImages {
+
+    const val GENERATE_URL = "https://${PersonaSelfPictures.HOST}/api/v1/image/generate"
+    const val EDIT_URL = "https://${PersonaSelfPictures.HOST}/api/v1/image/edit"
+    const val MULTI_EDIT_URL = "https://${PersonaSelfPictures.HOST}/api/v1/image/multi-edit"
+
+    /** The resolution tier asked of a model that has tiers: 1K, the price the settings show. */
+    const val RESOLUTION = "1K"
+
+    /** The largest seed Venice takes. */
+    const val MAX_SEED = 999_999_999
+
+    enum class Endpoint { GENERATE, EDIT, MULTI_EDIT }
+
+    /** One request for a picture, as it is sent. Its body holds pictures, so it is never written out whole. */
+    class Call(val endpoint: Endpoint, val url: String, val model: String, val body: String) {
+        fun at(url: String): Call = Call(endpoint, url, model, body)
+        override fun toString(): String = "Call($endpoint, $model, ${body.length} chars)"
+    }
+
+    /** A new picture of her drawn from words on [model]. */
+    fun generate(model: PictureModels.Model, prompt: String, negative: String, shape: PicturePrompts.Shape, seed: Int): Call {
+        require(model.kind == PictureModels.Kind.GENERATE) { "not a generate model" }
+        val body = buildJsonObject {
+            put("model", model.id)
+            put("prompt", prompt.take(model.promptLimit))
+            put("negative_prompt", negative.take(model.promptLimit))
+            when (model.sizing) {
+                PictureModels.Sizing.PIXELS -> {
+                    put("width", shape.width)
+                    put("height", shape.height)
+                    model.steps?.let { put("steps", it) }
+                    model.cfg?.let { put("cfg_scale", it) }
+                }
+                PictureModels.Sizing.RATIO -> {
+                    put("aspect_ratio", shape.ratio)
+                    if (model.resolutions) put("resolution", RESOLUTION)
+                }
+            }
+            put("seed", seed.coerceIn(0, MAX_SEED))
+            // Unblurred: pictures of her can be explicit (kisaragi-pics), and the phone is his.
+            put("safe_mode", false)
+            put("hide_watermark", true)
+            put("embed_exif_metadata", false)
+            put("format", "png")
+            put("return_binary", false)
+            put("variants", 1)
+        }.toString()
+        return Call(Endpoint.GENERATE, GENERATE_URL, model.id, body)
+    }
+
+    /** A small change to one picture of her ([imageBase64]) on the edit [model]. */
+    fun edit(model: PictureModels.Model, imageBase64: String, prompt: String, aspectRatio: String? = null): Call {
+        require(model.kind == PictureModels.Kind.EDIT) { "not an edit model" }
+        val body = buildJsonObject {
+            put("model", model.id)
+            put("image", imageBase64)
+            put("prompt", prompt.take(model.promptLimit))
+            aspectRatio?.let { put("aspect_ratio", it) }
+            put("safe_mode", false)
+            put("output_format", "png")
+        }.toString()
+        return Call(Endpoint.EDIT, EDIT_URL, model.id, body)
+    }
+
+    /** [images] on the edit [model] at once: the first is changed, the rest are what it is matched to. */
+    fun multiEdit(model: PictureModels.Model, images: List<String>, prompt: String, aspectRatio: String? = null): Call {
+        require(model.kind == PictureModels.Kind.EDIT) { "not an edit model" }
+        require(images.isNotEmpty()) { "no picture" }
+        val body = buildJsonObject {
+            put("modelId", model.id)
+            putJsonArray("images") { images.forEach { add(JsonPrimitive(it)) } }
+            put("prompt", prompt.take(model.promptLimit))
+            aspectRatio?.let { put("aspect_ratio", it) }
+            put("safe_mode", false)
+            put("output_format", "png")
+        }.toString()
+        return Call(Endpoint.MULTI_EDIT, MULTI_EDIT_URL, model.id, body)
+    }
+
+    /** What came of a request for a picture. */
+    sealed class Made {
+        /** The picture, as Venice sent it. The caller zeroes it once it is kept or thrown away. */
+        class Picture(val bytes: ByteArray) : Made() {
+            override fun toString(): String = "Picture(${bytes.size} bytes)"
+        }
+
+        /** No picture. [sent]: the request left the phone (it may have been charged); false where Venice was never reached. */
+        class Failed(val why: String, val sent: Boolean = true) : Made()
+
+        /** Venice flagged the picture as against its terms (it can come back blacked out): never shown, never kept. */
+        data object Blocked : Made()
+    }
+
+    private val JSON_TYPE = "application/json".toMediaType()
+    private val JSON = Json { ignoreUnknownKeys = true }
+
+    /**
+     * Sends [call] and waits for the picture. A cancel (he pressed Stop, or wrote something
+     * new) cancels the request itself. Never throws for a failed request.
+     */
+    suspend fun send(client: OkHttpClient, key: String, call: Call): Made = withContext(Dispatchers.IO) {
+        val slow = client.newBuilder()
+            .readTimeout(150, TimeUnit.SECONDS)
+            .writeTimeout(60, TimeUnit.SECONDS)
+            .callTimeout(180, TimeUnit.SECONDS)
+            // The picture goes to one address and nowhere else.
+            .followRedirects(false)
+            .followSslRedirects(false)
+            .build()
+        val request = Request.Builder()
+            .url(call.url)
+            .header("Authorization", "Bearer $key")
+            .post(call.body.toRequestBody(JSON_TYPE))
+            .build()
+        try {
+            slow.cancellable(request) { response ->
+                val type = response.header("Content-Type").orEmpty().lowercase()
+                when {
+                    response.header("x-venice-is-content-violation").equals("true", ignoreCase = true) -> Made.Blocked
+                    response.header("x-venice-is-blurred").equals("true", ignoreCase = true) ->
+                        Made.Failed("The picture came back blurred, so it is not kept.")
+                    response.isSuccessful && call.endpoint == Endpoint.GENERATE && type.startsWith("application/json") ->
+                        readGenerate(response.body.string())
+                    response.isSuccessful && type.startsWith("image/") ->
+                        picture(response.body.bytes())
+                    response.isSuccessful -> Made.Failed("The image service did not send back a picture.")
+                    response.code == 401 || response.code == 403 -> Made.Failed("The image service did not take the Venice key.")
+                    response.code == 402 -> Made.Failed("The Venice balance is too low to make a picture.")
+                    response.code == 422 -> Made.Failed("Venice's content rules turned this picture down.")
+                    response.code == 429 -> Made.Failed("The image service is busy. Try again in a minute.")
+                    response.code == 400 || response.code == 415 -> Made.Failed("The image service could not take this request (${response.code}).")
+                    response.code >= 500 -> Made.Failed("The image service is down or overloaded (${response.code}). Try again later.")
+                    else -> Made.Failed("The image service said no (${response.code}).")
+                }
+            }
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            throw e
+        } catch (e: java.net.SocketTimeoutException) {
+            Made.Failed("The image service took too long to answer. The picture may have been made and charged, but none came back.")
+        } catch (e: java.io.InterruptedIOException) {
+            Made.Failed("The image service took too long to answer. The picture may have been made and charged, but none came back.")
+        } catch (e: java.net.UnknownHostException) {
+            Made.Failed("The image service could not be reached.", sent = false)
+        } catch (e: java.net.ConnectException) {
+            Made.Failed("The image service could not be reached.", sent = false)
+        } catch (e: Exception) {
+            Made.Failed("The connection to the image service broke off. No picture came back.")
+        }
+    }
+
+    /** [bytes] as a picture, when they are one by their first bytes. */
+    internal fun picture(bytes: ByteArray?): Made {
+        if (bytes == null || bytes.isEmpty()) return Made.Failed("The image service sent back no picture.")
+        return when (EyesImage.kindOf(bytes)) {
+            EyesImage.Kind.PNG, EyesImage.Kind.JPEG, EyesImage.Kind.WEBP -> Made.Picture(bytes)
+            else -> {
+                bytes.fill(0)
+                Made.Failed("What came back is not a picture.")
+            }
+        }
+    }
+
+    /** The first picture of a generate answer ([json]: `{id, images: [base64], timing}`). */
+    internal fun readGenerate(json: String): Made {
+        val root = try {
+            JSON.parseToJsonElement(json) as? JsonObject
+        } catch (e: Exception) {
+            null
+        } ?: return Made.Failed("The image service sent back an answer that could not be read.")
+        val images = (root["images"] as? JsonArray).orEmpty()
+        val first = (images.firstOrNull() as? JsonPrimitive)?.takeIf { it.isString }?.content
+        if (first.isNullOrEmpty()) {
+            val refused = (root["content_policy_violation_count"] as? JsonPrimitive)?.intOrNull ?: 0
+            return if (refused > 0) Made.Blocked else Made.Failed("The image service sent back no picture.")
+        }
+        val bytes = try {
+            Base64.getDecoder().decode(first.substringAfter("base64,"))
+        } catch (e: IllegalArgumentException) {
+            return Made.Failed("The image service sent back a picture that could not be read.")
+        }
+        return picture(bytes)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/HistoryImport.kt b/app/src/main/java/com/opendroid/ai/core/record/HistoryImport.kt
new file mode 100644
index 0000000..4521121
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/HistoryImport.kt
@@ -0,0 +1,190 @@
+package com.opendroid.ai.core.record
+
+import android.content.Context
+import androidx.core.content.edit
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.memory.ExecutionHistoryPrivacy
+import com.opendroid.ai.data.db.dao.NotificationDao
+import com.opendroid.ai.data.db.dao.TaskHistoryDao
+import com.opendroid.ai.data.db.entities.NotificationEntity
+import com.opendroid.ai.data.db.entities.TaskHistoryEntity
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * On the update that brings the record, what the app already knew the phone had done in
+ * the last 30 days goes into it once, as [Starter.IMPORTED] entries:
+ *
+ *  - the plans in the app's history (the `task_history` table), one entry per plan with a
+ *    step for every row it logged. Those rows were stored with every email field and every
+ *    secret already redacted, and a redacted value is not kept as words. Their parameters
+ *    are the ones the step ran with, so a value filled in from an earlier step stands in
+ *    them as text: a step after one that read his data keeps no words, since they may
+ *    quote what was read. What a step returned is never brought in.
+ *  - the messages the old auto-reply answered (notifications marked auto-replied): who it
+ *    answered in which app, and the reply it wrote. Never the message it answered. An email
+ *    reply went out through the mail app's own reply in the notification where it had one,
+ *    with no tap of his, and was opened as a draft for him where it had not; the row was
+ *    marked the same either way. So an email reply is recorded as [StepEnd.UNKNOWN]: it may
+ *    have been sent, and the record never says it was not.
+ *
+ * A plan in the history that also ran after the update (before the record was first
+ * opened) is on the record under its own id: its copy here ([copyOf]) is then not kept.
+ *
+ * The flag that it is done ([Flag]) is set only once the entries are written ([done]).
+ */
+@Singleton
+class HistoryImport internal constructor(
+    private val taskHistory: suspend () -> List<TaskHistoryEntity>,
+    private val notificationsSince: suspend (Long) -> List<NotificationEntity>,
+    private val flag: Flag
+) : PhoneLog.OneTimeImport {
+
+    @Inject
+    constructor(
+        taskHistoryDao: TaskHistoryDao,
+        notificationDao: NotificationDao,
+        @ApplicationContext context: Context
+    ) : this(
+        taskHistory = { taskHistoryDao.getTaskHistoryFlow().first() },
+        notificationsSince = { since -> notificationDao.getNotificationsSince(since, limit = MAX_NOTIFICATIONS) },
+        flag = PrefsFlag(context)
+    )
+
+    /** Whether the import has been done on this install. */
+    interface Flag {
+        fun isSet(): Boolean
+        fun set()
+    }
+
+    override suspend fun pending(nowMillis: Long): List<PhoneLogEntry>? {
+        if (flag.isSet()) return null
+        val since = nowMillis - PhoneLog.MAX_AGE_MILLIS
+        return fromTaskHistory(taskHistory().filter { it.timestamp >= since }) +
+            fromAutoReplies(notificationsSince(since).filter { it.timestamp >= since })
+    }
+
+    override fun done() = flag.set()
+
+    override fun copyOf(id: String): String = importedPlanId(id)
+
+    private class PrefsFlag(context: Context) : Flag {
+        private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        override fun isSet(): Boolean = prefs.getBoolean(KEY_IMPORTED, false)
+        override fun set() = prefs.edit(commit = true) { putBoolean(KEY_IMPORTED, true) }
+    }
+
+    companion object {
+        private const val PREFS = "phone_record"
+        private const val KEY_IMPORTED = "history_imported_v1"
+        private const val MAX_NOTIFICATIONS = 5000
+        private const val NO_PLAN = "n/a"
+
+        private val json = Json { ignoreUnknownKeys = true }
+
+        /** The id of the import's entry for the plan [planId] of the app's history. */
+        fun importedPlanId(planId: String): String = "imported-plan-$planId"
+
+        /** Why an email reply of the old auto-reply is not known to have been sent or not. */
+        internal const val EMAIL_REPLY_UNKNOWN =
+            "sent through the mail app's own reply when it had one, otherwise left as a draft for him; which one is not known"
+
+        /**
+         * What a handler says when it left the step with him (a draft, a chat with the
+         * words ready, a payment app, a settings screen): the history did not keep the kind
+         * of result, only its words.
+         */
+        private val HANDED_OVER = Regex(
+            """tap send|sending was not verified|send it manually|please (?:turn|switch) it|""" +
+                """was opened instead|enter your UPI PIN""",
+            RegexOption.IGNORE_CASE
+        )
+
+        /** One entry per plan in [rows], the history's rows of the steps that ran. */
+        internal fun fromTaskHistory(rows: List<TaskHistoryEntity>): List<PhoneLogEntry> =
+            rows.filter { it.planId != NO_PLAN && it.actionType != ExecutionHistoryPrivacy.PLAN_GENERATION }
+                .groupBy { it.planId }
+                .mapNotNull { (planId, planRows) -> planEntry(planId, planRows.sortedWith(compareBy({ it.timestamp }, { it.id }))) }
+
+        private fun planEntry(planId: String, rows: List<TaskHistoryEntity>): PhoneLogEntry? {
+            val steps = rows.mapIndexed { index, row ->
+                PlanStep(
+                    stepId = "h${index + 1}",
+                    order = index + 1,
+                    description = "",
+                    action = row.actionType,
+                    params = params(row.paramsJson),
+                    status = if (row.success) StepStatus.COMPLETED else StepStatus.FAILED,
+                    error = row.errorMessage
+                )
+            }
+            // A step after one that read his data may carry what was read in its words.
+            val firstRead = steps.indexOfFirst { ActionSchema.readsPersonalData(PlanEntries.mappedName(it)) }
+            val handedOver = steps.filterIndexed { index, step ->
+                !rows[index].success && step.error?.let(HANDED_OVER::containsMatchIn) == true
+            }.map { it.stepId }.toSet()
+            val plan = Plan(
+                planId = planId,
+                goal = "",
+                estimatedDuration = "",
+                estimatedSteps = steps.size,
+                steps = steps,
+                createdAt = rows.first().timestamp
+            )
+            return PlanEntries.of(
+                plan = plan,
+                start = PlanStarts.Start(who = Starter.IMPORTED),
+                ending = PlanEntries.Ending.Finished(isSuccess = rows.all { it.success }),
+                fallbackWho = Starter.IMPORTED,
+                handedOver = { it.stepId in handedOver },
+                wordsKept = { step -> firstRead < 0 || step.order - 1 <= firstRead },
+                id = importedPlanId(planId),
+                endedAtMillis = rows.last().timestamp
+            )
+        }
+
+        /**
+         * The history's parameters, as text; a value that is not text is kept as it was
+         * written. A value the history redacted is left out: it says nothing of the step.
+         */
+        private fun params(paramsJson: String): Map<String, String> = try {
+            (json.parseToJsonElement(paramsJson) as? JsonObject).orEmpty().mapValues { (_, value) ->
+                (value as? JsonPrimitive)?.takeIf { it.isString }?.content ?: value.toString()
+            }.filterValues { it.trim() != ExecutionHistoryPrivacy.REDACTED }
+        } catch (e: Exception) {
+            emptyMap()
+        }
+
+        /** One entry for each message the old auto-reply answered, with the reply it sent. */
+        internal fun fromAutoReplies(rows: List<NotificationEntity>): List<PhoneLogEntry> =
+            rows.filter { it.isAutoReplied && !it.autoReplyText.isNullOrBlank() }.map { row ->
+                val to = row.contactName?.takeIf { it.isNotBlank() }
+                    ?: row.senderEmail?.takeIf { it.isNotBlank() }
+                    ?: row.title.takeIf { it.isNotBlank() }
+                val email = row.category == "EMAIL" || !row.senderEmail.isNullOrBlank()
+                val step = PhoneLogStep(
+                    line = "Auto-reply" + to?.let { " to $it" }.orEmpty(),
+                    kind = "Auto-reply",
+                    app = row.appName.takeIf { it.isNotBlank() },
+                    words = listOf(SentWords("reply", row.autoReplyText.orEmpty())),
+                    end = if (email) StepEnd.UNKNOWN else StepEnd.DONE,
+                    reason = if (email) EMAIL_REPLY_UNKNOWN else null
+                )
+                PhoneLogEntry(
+                    id = "imported-reply-${row.id}",
+                    at = row.timestamp,
+                    who = Starter.IMPORTED,
+                    steps = listOf(step),
+                    outcome = if (email) Outcome.UNKNOWN else Outcome.DONE
+                ).bounded()
+            }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/OutingEntries.kt b/app/src/main/java/com/opendroid/ai/core/record/OutingEntries.kt
new file mode 100644
index 0000000..3e0e912
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/OutingEntries.kt
@@ -0,0 +1,99 @@
+package com.opendroid.ai.core.record
+
+import java.util.UUID
+
+/**
+ * The entry of one outing of hers on his screen, lent ([Starter.HER_OUTING]): she was in one of
+ * his apps, logged in as him, and only looked. The phone did what her outing did there, so the
+ * record holds it beside what he and his macros did: which app, how she got the screen (his
+ * setting or his yes), every kind of move with its count, each search with her words as they
+ * were typed into the app, the taps the look-only guard refused, and how the screen was given
+ * back.
+ *
+ * What it never holds: what was on his screen (posts, captions, comments, pictures, what her
+ * eyes said of them), her thoughts, and her lines. A label she tapped is not kept either: the
+ * record keeps what the phone did, not what it showed.
+ */
+object OutingEntries {
+
+    /** One outing on his screen, as it ended. */
+    data class PhoneTime(
+        /** The app's name: "TikTok". */
+        val app: String,
+        /** Her go: words, cut short, for "why". */
+        val words: String,
+        val startedAt: Long,
+        val endedAt: Long,
+        /** He let her on the question his settings asked; otherwise his setting let it start. */
+        val hisYes: Boolean,
+        /** Her app was launched on his screen. */
+        val opened: Boolean,
+        /** It came to the front: an app launched that never showed is an outing that failed. */
+        val arrived: Boolean = opened,
+        val scrolls: Int = 0,
+        val taps: Int = 0,
+        val tabs: Int = 0,
+        val backs: Int = 0,
+        val watchedMillis: Long = 0L,
+        /** Her search words, as they were typed into the app's search box, in order. */
+        val searches: List<String> = emptyList(),
+        /** Searches whose words were held back: they would have carried something about him. */
+        val searchesHeldBack: Int = 0,
+        /** Taps the look-only guard refused, by what they would have been ("a like or a dislike"). */
+        val refused: Map<String, Int> = emptyMap(),
+        /** How it ended, in plain words: "he took the phone back". */
+        val ended: String,
+        /** How the screen was given back: "home", "his app", or why it was not touched. */
+        val gaveBack: String,
+        /** Ended early: by his hand, a call, a lock, a rule; not by her being done. */
+        val early: Boolean
+    )
+
+    fun phoneTime(run: PhoneTime): PhoneLogEntry {
+        val steps = ArrayList<PhoneLogStep>()
+        fun step(line: String, kind: String, end: StepEnd = StepEnd.DONE, words: List<SentWords> = emptyList(), reason: String? = null) {
+            steps += PhoneLogStep(line = line, kind = kind, app = run.app, words = words, end = end, reason = reason)
+        }
+        if (run.opened) step("opened ${run.app} on his screen", "Open app") else step("opened ${run.app} on his screen", "Open app", StepEnd.FAILED)
+        if (run.opened && !run.arrived) step("${run.app} did not come to the front", "Open app", StepEnd.FAILED)
+        if (run.scrolls > 0) step("scrolled ${times(run.scrolls)}", "Scroll")
+        if (run.taps > 0) step("tapped into ${count(run.taps, "post, video, profile or comments", "posts, videos, profiles or comments")}", "Tap")
+        if (run.tabs > 0) step("switched tabs ${times(run.tabs)}", "Switch tab")
+        if (run.backs > 0) step("went back ${times(run.backs)}", "Back")
+        for (words in run.searches) step("searched ${run.app}", "Search", words = listOf(SentWords("search", words)))
+        if (run.searchesHeldBack > 0) {
+            step(
+                "searches not typed: ${run.searchesHeldBack}", "Search", StepEnd.NOT_RUN,
+                reason = "her words would have carried something about him"
+            )
+        }
+        if (run.watchedMillis > 0) step("watched for ${duration(run.watchedMillis)}", "Watch")
+        for ((what, n) in run.refused) {
+            step("not tapped: ${count(n, what, what)}", "Look only", StepEnd.NOT_RUN, reason = "she has no account of her own and only looks")
+        }
+        step("gave the screen back: ${run.gaveBack}", "Give back", if (run.gaveBack.startsWith("not ")) StepEnd.NOT_RUN else StepEnd.DONE)
+        return PhoneLogEntry(
+            id = "outing-${UUID.randomUUID()}",
+            at = run.startedAt,
+            endedAt = run.endedAt,
+            who = Starter.HER_OUTING,
+            why = run.words.takeIf { it.isNotBlank() }?.let { "go: $it; it ended: ${run.ended}" } ?: "it ended: ${run.ended}",
+            letThrough = if (run.hisYes) LetThrough.HIS_YES else LetThrough.HIS_SETTING,
+            steps = steps,
+            outcome = when {
+                !run.opened || !run.arrived -> Outcome.FAILED
+                run.early -> Outcome.STOPPED
+                else -> Outcome.DONE
+            }
+        ).bounded()
+    }
+
+    private fun times(n: Int): String = if (n == 1) "once" else "$n times"
+
+    private fun count(n: Int, one: String, many: String): String = if (n == 1) "1 $one" else "$n $many"
+
+    private fun duration(millis: Long): String {
+        val seconds = (millis + 500) / 1_000
+        return if (seconds < 60) "$seconds s" else "${seconds / 60} min ${seconds % 60} s"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt
new file mode 100644
index 0000000..4ddaa06
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt
@@ -0,0 +1,186 @@
+package com.opendroid.ai.core.record
+
+import android.util.Log
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+
+/**
+ * The record of what the phone did: one sealed file, [FILE] in [dir] (the app's
+ * `files/record`), with the entries as JSON inside.
+ *
+ * Every change goes through one lock and is written whole: to a file beside it first,
+ * which then takes the record's place, so a write that is cut short leaves the last good
+ * record. It keeps at most [MAX_ENTRIES] entries and none older than [MAX_AGE_MILLIS]: the
+ * rest are dropped on every write and left out of every read ([retained]).
+ *
+ * A record that cannot be opened (the key is gone after a reinstall, the file was changed
+ * or is not one) is moved aside as `phone_log.sealed.bad`, and the record starts empty.
+ * Nothing here throws to the caller: a record that cannot be read reads as empty, and an
+ * entry that cannot be written is dropped with a line in the log that names no content.
+ *
+ * [history] is the one-time import of what the app already knew before the record came:
+ * asked once, the first time the record is opened in this process, and told it is done
+ * only after its entries are written. A run the import brings in that the record also
+ * holds under its own id (a plan that ran after the update, before the record was first
+ * opened) is kept once, as the record's own entry: the import's copy of it is dropped.
+ */
+class PhoneLog(
+    private val dir: File,
+    private val seal: RecordSeal,
+    private val clock: () -> Long = System::currentTimeMillis,
+    private val history: OneTimeImport = OneTimeImport.NONE
+) {
+    private val lock = Mutex()
+
+    // What the file holds, once it has been read in this process. Null until then.
+    private var held: List<PhoneLogEntry>? = null
+
+    /**
+     * Adds [entry], or puts it in the place of the entry with the same id, and of the
+     * import's copy of the same run.
+     */
+    suspend fun put(entry: PhoneLogEntry) = work {
+        val now = clock()
+        val copy = history.copyOf(entry.id)
+        val all = loaded(now).filterNot { it.id == entry.id || it.id == copy } + entry.bounded()
+        store(retained(all, now))
+    }
+
+    /** Every entry the record keeps now, oldest first. */
+    suspend fun entries(): List<PhoneLogEntry> = work {
+        val now = clock()
+        val all = loaded(now)
+        val kept = retained(all, now)
+        // What has aged out is dropped from the file too, not only from what is read.
+        if (kept.size != all.size) store(kept) else held = kept
+        kept
+    }
+
+    private suspend fun <T> work(block: suspend () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }
+
+    /** What the file holds, with the one-time import brought in on the first open. */
+    private suspend fun loaded(now: Long): List<PhoneLogEntry> {
+        held?.let { return it }
+        val read = read()
+        held = read
+        val imported = try {
+            history.pending(now)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The record's import did not run: ${e.javaClass.simpleName}")
+            null
+        } ?: return read
+        // Nothing twice: not an entry already brought in, nor a copy of a run the record holds itself.
+        val known = read.map { it.id }.toSet()
+        val shadowed = known + known.mapNotNull(history::copyOf)
+        val merged = read + imported.filterNot { it.id in shadowed }.map { it.bounded() }
+        if (store(retained(merged, now))) history.done()
+        return held ?: read
+    }
+
+    private fun read(): List<PhoneLogEntry> {
+        val file = File(dir, FILE)
+        if (!file.exists()) return emptyList()
+        return try {
+            val plain = seal.open(file.readBytes())
+            json.decodeFromString(Stored.serializer(), String(plain, Charsets.UTF_8)).entries
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            // A record nobody can open is not guessed at, and not written over: it is set aside.
+            Log.w(TAG, "The record could not be opened and is set aside: ${e.javaClass.simpleName}")
+            setAside(file)
+            emptyList()
+        }
+    }
+
+    private fun setAside(file: File) {
+        val bad = File(dir, FILE + BAD_SUFFIX)
+        try {
+            Files.move(file.toPath(), bad.toPath(), StandardCopyOption.REPLACE_EXISTING)
+        } catch (e: Exception) {
+            Log.w(TAG, "The unreadable record could not be moved: ${e.javaClass.simpleName}")
+            if (!file.delete()) Log.w(TAG, "The unreadable record could not be removed either")
+        }
+    }
+
+    /** Writes [entries] whole and keeps them as what the file holds. False when nothing could be written. */
+    private fun store(entries: List<PhoneLogEntry>): Boolean {
+        return try {
+            if (!dir.exists() && !dir.mkdirs()) throw IOException("No record directory")
+            val sealed = seal.seal(json.encodeToString(Stored.serializer(), Stored(VERSION, entries)).toByteArray(Charsets.UTF_8))
+            val tmp = File(dir, FILE + TMP_SUFFIX)
+            tmp.outputStream().use { out ->
+                out.write(sealed)
+                out.fd.sync()
+            }
+            try {
+                Files.move(tmp.toPath(), File(dir, FILE).toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING)
+            } catch (e: Exception) {
+                Files.move(tmp.toPath(), File(dir, FILE).toPath(), StandardCopyOption.REPLACE_EXISTING)
+            }
+            held = entries
+            true
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The record was not written: ${e.javaClass.simpleName}")
+            false
+        }
+    }
+
+    @Serializable
+    private data class Stored(val v: Int, val entries: List<PhoneLogEntry>)
+
+    /**
+     * What the app knew of what the phone did before the record came, put into it once.
+     * [pending] gives the entries to bring in, or null once that is done; [done] is called
+     * when they are written. [copyOf] is the id the import gives its own copy of the run
+     * the record holds as [id] (null when it makes none), so the two are never both kept.
+     */
+    interface OneTimeImport {
+        suspend fun pending(nowMillis: Long): List<PhoneLogEntry>?
+        fun done()
+        fun copyOf(id: String): String? = null
+
+        companion object {
+            val NONE: OneTimeImport = object : OneTimeImport {
+                override suspend fun pending(nowMillis: Long): List<PhoneLogEntry>? = null
+                override fun done() = Unit
+            }
+        }
+    }
+
+    companion object {
+        const val DIR = "record"
+        const val FILE = "phone_log.sealed"
+        const val BAD_SUFFIX = ".bad"
+        private const val TMP_SUFFIX = ".tmp"
+        private const val VERSION = 1
+        private const val TAG = "PhoneLog"
+
+        const val MAX_ENTRIES = 600
+        const val MAX_AGE_MILLIS = 30L * 24 * 60 * 60 * 1000
+
+        private val json = Json { ignoreUnknownKeys = true; encodeDefaults = false }
+
+        /**
+         * The entries the record keeps of [entries] at [nowMillis]: none that ended more
+         * than [MAX_AGE_MILLIS] ago, and of the rest the newest [MAX_ENTRIES], oldest first.
+         */
+        fun retained(entries: List<PhoneLogEntry>, nowMillis: Long): List<PhoneLogEntry> =
+            entries.filter { it.lastAt >= nowMillis - MAX_AGE_MILLIS }
+                .sortedBy { it.lastAt }
+                .takeLast(MAX_ENTRIES)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt
new file mode 100644
index 0000000..e10693b
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt
@@ -0,0 +1,211 @@
+package com.opendroid.ai.core.record
+
+import kotlinx.serialization.Serializable
+
+/**
+ * One thing the phone did, or was asked to do and did not do, as the record of what the
+ * phone did keeps it: when, who started it, why, how it was let through, and what each
+ * step did and how it ended.
+ *
+ * Everything in an entry is read off what ran: the steps as they were given and how each
+ * one ended. What an entry never holds: a secret a step was given, what a step read off
+ * the screen, out of a notification, the clipboard or any other store of his (only that
+ * the step ran), her thoughts and her replies. [PlanEntries] and the other builders are
+ * where that is made true; [bounded] keeps each text to its size.
+ *
+ * [id] is the run's own id. A plan is recorded under its plan id, so a later record of the
+ * same plan (a paused plan that was resumed and finished) takes the place of the earlier
+ * one instead of standing beside it.
+ *
+ * An entry is kept, ordered, picked and aged by [lastAt]: when it ended, not when it
+ * started. A plan that waited at the gate for hours and ran a minute ago is what the phone
+ * did a minute ago.
+ */
+@Serializable
+data class PhoneLogEntry(
+    val id: String,
+    /** When it started (a plan: when it was made), in millis. */
+    val at: Long,
+    /** When it ended and went on the record as it stands, in millis; null when that is [at]. */
+    val endedAt: Long? = null,
+    val who: Starter,
+    /** His message, her command, or the macro's or routine's name, cut short. Null when there is none to tell. */
+    val why: String? = null,
+    /** How it was let through; null when it never came to a gate, or ran under one this record cannot name. */
+    val letThrough: LetThrough? = null,
+    val steps: List<PhoneLogStep>,
+    val outcome: Outcome
+) {
+    /** When it ended, or when it started where nothing later is known: what the record goes by. */
+    val lastAt: Long get() = endedAt ?: at
+
+    /** The entry with every text cut to the size the record keeps. */
+    fun bounded(): PhoneLogEntry = copy(
+        why = why?.let { cut(oneLine(it), MAX_WHY_CHARS) }?.takeIf { it.isNotEmpty() },
+        steps = steps.take(MAX_STEPS).map { it.bounded() }
+    )
+
+    companion object {
+        const val MAX_WHY_CHARS = 200
+        const val MAX_WORDS_CHARS = 1000
+        const val MAX_LINE_CHARS = 160
+        const val MAX_REASON_CHARS = 200
+        const val MAX_STEPS = 40
+
+        /** What a text that was cut ends in. The same mark her prompt explains. */
+        const val CUT_MARK = " [cut]"
+
+        internal fun cut(text: String, max: Int): String =
+            if (text.length <= max) text else text.take((max - CUT_MARK.length).coerceAtLeast(1)).trimEnd() + CUT_MARK
+
+        internal fun oneLine(text: String): String = text.replace(Regex("""\s+"""), " ").trim()
+    }
+}
+
+/** Who started what an entry records. */
+@Serializable
+enum class Starter {
+    /** His message in the chat. */
+    HIM_CHAT,
+
+    /** His voice: the voice service, or his own voice heard by her ears. */
+    HIM_VOICE,
+
+    /** His message matched a shortcut and ran without the planner. */
+    HIM_SHORTCUT,
+
+    /** His tap on one of the app's screens, such as Publish on a social post. */
+    HIM_SCREEN,
+
+    /** Her command at the end of a reply of hers. */
+    HER_REPLY,
+
+    /** Her command in a moment of her own. */
+    HER_OWN_TIME,
+
+    /** She, on an outing of her own in one of his apps, on his screen he lent her (look only). */
+    HER_OUTING,
+
+    /** A saved macro. */
+    MACRO,
+
+    /** A routine. */
+    ROUTINE,
+
+    /** The app by itself, with nobody's tap or message behind it. */
+    APP,
+
+    /** Put into the record from the app's older history on the update that brought the record. */
+    IMPORTED
+}
+
+/** How what an entry records was let through. */
+@Serializable
+enum class LetThrough {
+    /** His approval setting let it run without asking. */
+    HIS_SETTING,
+
+    /** Her rein let a command of hers run without asking. */
+    HER_REIN,
+
+    /** He said yes: on the approval card or by voice. */
+    HIS_YES,
+
+    /** He said no, or cancelled it: what was not run is recorded as not run. */
+    HIS_NO,
+
+    /** His own tap on the app's screen. */
+    HIS_TAP
+}
+
+/**
+ * One step of an entry. [line] names the action and who or what it acts on, as the
+ * approval card names it. [kind] is the action alone, which is all a route that holds his
+ * details back is told. [words] are what the step sent to a person, posted or typed into
+ * another app, or put on the clipboard, each in full up to its cap; a value the phone
+ * fills in from an earlier step is named as that, never quoted.
+ *
+ * Where the step's own action failed and its fallback ran in its place, the step is the
+ * fallback, as it ran, and [insteadOf] is the kind of the action that failed first.
+ */
+@Serializable
+data class PhoneLogStep(
+    val line: String,
+    val kind: String,
+    /** The app the step acts in, when it is known. */
+    val app: String? = null,
+    val words: List<SentWords> = emptyList(),
+    val end: StepEnd,
+    /** Why it failed, or what was left for him, in plain words; null when there is none fit to keep. */
+    val reason: String? = null,
+    /** The kind of the action that was tried first and failed, when a fallback ran in its place. */
+    val insteadOf: String? = null
+) {
+    fun bounded(): PhoneLogStep = copy(
+        line = PhoneLogEntry.cut(PhoneLogEntry.oneLine(line), PhoneLogEntry.MAX_LINE_CHARS),
+        kind = PhoneLogEntry.cut(PhoneLogEntry.oneLine(kind), PhoneLogEntry.MAX_LINE_CHARS),
+        insteadOf = insteadOf?.let { PhoneLogEntry.cut(PhoneLogEntry.oneLine(it), PhoneLogEntry.MAX_LINE_CHARS) }
+            ?.takeIf { it.isNotEmpty() },
+        app = app?.let { PhoneLogEntry.cut(PhoneLogEntry.oneLine(it), MAX_APP_CHARS) }?.takeIf { it.isNotEmpty() },
+        words = words.map { it.copy(text = PhoneLogEntry.cut(it.text.trim(), PhoneLogEntry.MAX_WORDS_CHARS)) }
+            .filter { it.text.isNotEmpty() },
+        reason = reason?.let { PhoneLogEntry.cut(PhoneLogEntry.oneLine(it), PhoneLogEntry.MAX_REASON_CHARS) }
+            ?.takeIf { it.isNotEmpty() }
+    )
+
+    private companion object {
+        const val MAX_APP_CHARS = 60
+    }
+}
+
+/** One text a step sent, under the parameter that carried it ("message", "subject", "body"). */
+@Serializable
+data class SentWords(val param: String, val text: String)
+
+/** How one step ended. */
+@Serializable
+enum class StepEnd {
+    DONE,
+    FAILED,
+
+    /** Left open for him: a draft, a dialer or a payment waiting for his tap. Never "sent". */
+    LEFT_OPEN,
+
+    /** It was under way when the run was stopped: whether it went through is not known. */
+    INTERRUPTED,
+
+    NOT_RUN,
+
+    /**
+     * It ran, but how it ended is not known: it may have gone through, or have been left
+     * open for him. The old auto-reply's email replies are such: sent through the mail
+     * app's own reply where it had one, opened as a draft where it had not, and nothing
+     * kept which.
+     */
+    UNKNOWN
+}
+
+/** How a whole run ended. */
+@Serializable
+enum class Outcome {
+    /** Every step was done. */
+    DONE,
+
+    /** Nothing was done, and something failed. */
+    FAILED,
+
+    /** Some steps were done and some failed or never ran. */
+    PARTLY,
+
+    /** What it did ends with something left open for him, and nothing failed. */
+    LEFT_OPEN,
+
+    /** It was stopped, or ended early, before the end. */
+    STOPPED,
+
+    /** Nothing of it ran. */
+    NOT_RUN,
+
+    /** Nothing failed, but whether some of it went through is not known ([StepEnd.UNKNOWN]). */
+    UNKNOWN
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt
new file mode 100644
index 0000000..c131aae
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt
@@ -0,0 +1,66 @@
+package com.opendroid.ai.core.record
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CoroutineExceptionHandler
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import java.io.File
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * What every place that runs something on the phone hands its entry to: the plan loop,
+ * macros and routines, and the sends from the social screens. [put] never waits and
+ * never throws, so writing the record can neither hold up nor break what it records.
+ *
+ * [NONE] keeps nothing: what a test or a caller without the record gets.
+ */
+fun interface PhoneRecorder {
+    fun put(entry: PhoneLogEntry)
+
+    companion object {
+        val NONE: PhoneRecorder = PhoneRecorder { }
+    }
+}
+
+/**
+ * The record of what the phone did, as the app has it: the sealed file in its own storage
+ * (`files/record/phone_log.sealed`, [PhoneLog]), with the plans and auto-replies of the
+ * last 30 days brought in once on the update that brings it ([HistoryImport]).
+ *
+ * Entries are written in the order they are put, on a scope of the record's own, so a
+ * plan that was stopped still gets its entry written after its coroutine is gone.
+ */
+@Singleton
+class PhoneRecord internal constructor(private val log: PhoneLog) : PhoneRecorder {
+
+    @Inject
+    constructor(
+        @ApplicationContext context: Context,
+        seal: RecordSeal,
+        history: HistoryImport
+    ) : this(PhoneLog(File(context.filesDir, PhoneLog.DIR), seal, history = history))
+
+    // One writer at a time, in order: the log's own lock keeps the file whole, and a single
+    // thread keeps two entries put one after the other from being written the other way round.
+    private val scope = CoroutineScope(
+        SupervisorJob() + Dispatchers.IO.limitedParallelism(1) + CoroutineExceptionHandler { _, e ->
+            Log.w(TAG, "An entry of the record was not written: ${e.javaClass.simpleName}")
+        }
+    )
+
+    override fun put(entry: PhoneLogEntry) {
+        scope.launch { log.put(entry) }
+    }
+
+    /** Every entry the record keeps now, oldest first. Empty when it cannot be read. */
+    suspend fun entries(): List<PhoneLogEntry> = log.entries()
+
+    private companion object {
+        const val TAG = "PhoneRecord"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt b/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt
new file mode 100644
index 0000000..2139ada
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt
@@ -0,0 +1,275 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.actions.ActionAutoMapper
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.agent.PlanApprovalSummary
+import com.opendroid.ai.core.agent.PlanPrivacy
+import com.opendroid.ai.core.agent.PlanRecord
+import com.opendroid.ai.core.agent.isTalkAction
+import com.opendroid.ai.core.memory.ExecutionHistoryPrivacy
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * The record's entry for one run of steps: a plan of his or hers, a macro or a routine,
+ * or a plan from the app's older history. Built from the steps as they stand when the run
+ * has ended, the way [PlanRecord] builds the chat's row, and holding only what the record
+ * may hold:
+ *
+ *  - Each step is its line from [PlanApprovalSummary] (the action and who or what it acts
+ *    on), the action alone for a route that holds his details back, the app where it is
+ *    known, the words it sent, and how it ended.
+ *  - The words are [PlanApprovalSummary.outgoingTexts]: text a step sends to a person or a
+ *    site, and the text the phone put on the clipboard (which he can paste anywhere), never
+ *    one that stays in a store of the phone (a note, the secure store), never a secret
+ *    parameter, and a value filled in from an earlier step's result is named as that
+ *    ("[the answer to step 2]"), never quoted. The plan is redacted first
+ *    ([PlanPrivacy.redactPlan]), so a secret quoted anywhere else in it is gone too.
+ *  - A step is told as it ran ([AsRun]): the fallback that ran in its place, with the kind
+ *    of the action that failed first, and the values he gave when it asked for one. A
+ *    step kept back before the run began is told as not run, with why. A step that only
+ *    saves a draft for his tap ([DRAFTS_FOR_HIM]: a post, a campaign's posts, replies to
+ *    comments) is told as left open for him, never as done: nothing of it went out.
+ *  - What a step returned is never kept: of a step that read his notifications, his screen
+ *    or his mail, only that it ran. A failed reading step keeps no reason either, since a
+ *    handler's error can quote what it read.
+ *  - The plan's goal, its step descriptions and what its talk steps said are the planner's
+ *    words about its own plan, not what the phone did: none of them is kept. Talk steps and
+ *    the steps that only ask him something are left out.
+ *
+ * A run with no step left to record (a plan that only talked) has no entry.
+ */
+internal object PlanEntries {
+
+    /** How a run ended, as the one who ran it saw it. */
+    sealed interface Ending {
+        /** It came to its end; [isSuccess] as the plan loop judged it. */
+        data class Finished(val isSuccess: Boolean) : Ending
+
+        /**
+         * It was stopped while it ran, or paused partway: what ran is told, the rest is not
+         * run. With [waitingForAnswer] the step under way was waiting for his answer, so it
+         * had not run either.
+         */
+        data class Stopped(val waitingForAnswer: Boolean = false) : Ending
+
+        /** It never got past the gate. [refused] when he said no to it or cancelled it. */
+        data class NotRun(val refused: Boolean) : Ending
+
+        /** He said no to the question of step [stepId] while it ran: that step and the rest did not run. */
+        data class Declined(val stepId: String) : Ending
+    }
+
+    /**
+     * What a step really ran as, where its plan's own step does not say it: the [action] of
+     * the fallback that ran in its place, and the values he gave when the step asked for
+     * them ([given], secrets left out), laid over its parameters.
+     */
+    data class AsRun(val action: String? = null, val given: Map<String, String> = emptyMap())
+
+    private val autoMapper = ActionAutoMapper()
+
+    // The action that puts its text where he can paste it anywhere: the record keeps that text.
+    private const val CLIPBOARD = "COPY_TO_CLIPBOARD"
+    private const val CLIPBOARD_TEXT = "text"
+
+    /** The name a step's action runs under, as the approval card resolves it. */
+    fun mappedName(step: PlanStep): String =
+        (autoMapper.mapAction(step.action, step.params, emptySet()).mappedAction ?: step.action).trim().uppercase()
+
+    /**
+     * The entry for [plan], or null when it has no step to record.
+     *
+     * [start] is what was noted of who started it, why and how it was let through, and
+     * [fallbackWho] is who is named when nothing was noted. [handedOver] is true for a
+     * step that was left with him to finish (a draft waiting for his tap); [toldAlready]
+     * for one that ended by handing the rest to him (a dialer open and waiting): both are
+     * left open, never done. [wordsKept] is false for a step whose words are not to be
+     * kept, such as a step from the older history whose words may quote what an earlier
+     * step read. [ranAs] is how a step really ran where the plan does not say it ([AsRun]).
+     * [endedAtMillis] is when the run ended; null when that is not known. [leftOut] holds
+     * the steps that were kept back before the run began (a macro's step that switches
+     * auto-reply, or one to a sender that only sends), by their index in [plan]'s steps,
+     * with the plain reason: each is not run, for that reason, however the run ended.
+     */
+    fun of(
+        plan: Plan,
+        start: PlanStarts.Start?,
+        ending: Ending,
+        fallbackWho: Starter = Starter.HIM_CHAT,
+        canonicalName: (PlanStep) -> String = ::mappedName,
+        handedOver: (PlanStep) -> Boolean = { false },
+        toldAlready: (PlanStep) -> Boolean = { false },
+        wordsKept: (PlanStep) -> Boolean = { true },
+        ranAs: (PlanStep) -> AsRun? = { null },
+        id: String = plan.planId,
+        atMillis: Long = plan.createdAt,
+        endedAtMillis: Long? = null,
+        leftOut: Map<Int, String> = emptyMap()
+    ): PhoneLogEntry? {
+        // Of a step whose fallback ran, the kind of the action that failed first.
+        val firstTried = PlanApprovalSummary.stepLines(plan.copy(steps = plan.steps.map { it.copy(params = emptyMap()) }))
+        val asRan = plan.steps.map { ranAs(it) }
+        // Redacted as it was written and again as it ran: a fallback can count fewer of the
+        // step's parameters as secret than the action it stands in for.
+        val written = PlanPrivacy.redactPlan(plan)
+        val ran = written.copy(
+            steps = written.steps.mapIndexed { index, step ->
+                val how = asRan[index] ?: return@mapIndexed step
+                step.copy(action = how.action?.takeIf { it.isNotBlank() } ?: step.action, params = step.params + how.given)
+            }
+        )
+        val safe = PlanPrivacy.redactPlan(ran)
+        val lines = PlanApprovalSummary.stepLines(safe)
+        val kinds = PlanApprovalSummary.stepLines(safe.copy(steps = safe.steps.map { it.copy(params = emptyMap()) }))
+        val words = (PlanApprovalSummary.outgoingTexts(safe) + clipboardTexts(safe))
+            .filter { it.text.trim() != ExecutionHistoryPrivacy.REDACTED }
+            .groupBy { it.step - 1 }
+        val declinedAt = (ending as? Ending.Declined)?.let { declined -> safe.steps.indexOfFirst { it.stepId == declined.stepId } }
+            ?.takeIf { it >= 0 }
+
+        val steps = safe.steps.mapIndexedNotNull { index, step ->
+            val canonical = canonicalName(step)
+            if (isTalkAction(canonical) || canonical in PlanRecord.ASKING_ACTIONS) return@mapIndexedNotNull null
+            val reads = ActionSchema.readsPersonalData(canonical)
+            // A plan that never got past the gate has run nothing, unless it was shown again
+            // after a change while it ran: the steps that had run by then say so themselves.
+            val (end, reason) = when {
+                index in leftOut -> StepEnd.NOT_RUN to leftOut[index]
+                declinedAt != null && index == declinedAt -> StepEnd.NOT_RUN to HE_SAID_NO
+                declinedAt != null && index > declinedAt && step.status != StepStatus.COMPLETED -> StepEnd.NOT_RUN to null
+                ending is Ending.Stopped && ending.waitingForAnswer && step.status == StepStatus.RUNNING -> StepEnd.NOT_RUN to null
+                else -> endOf(step, canonical, reads, handedOver(step), toldAlready(step))
+            }
+            PhoneLogStep(
+                line = lines.getOrElse(index) { step.action },
+                kind = kinds.getOrElse(index) { step.action },
+                app = appOf(canonical, step.params),
+                words = if (wordsKept(step)) {
+                    words[index].orEmpty().map { SentWords(it.param, it.text) }
+                } else {
+                    emptyList()
+                },
+                end = end,
+                reason = reason,
+                insteadOf = firstTried.getOrNull(index)
+                    ?.takeIf { asRan[index]?.action?.isNotBlank() == true && step.action != plan.steps[index].action }
+            ).bounded()
+        }
+        if (steps.isEmpty()) return null
+
+        val how = when {
+            ending is Ending.NotRun && ending.refused -> LetThrough.HIS_NO
+            ending is Ending.NotRun -> null
+            ending is Ending.Declined -> LetThrough.HIS_NO
+            else -> start?.how
+        }
+        return PhoneLogEntry(
+            id = id,
+            at = atMillis,
+            endedAt = endedAtMillis?.takeIf { it != atMillis },
+            who = start?.who ?: fallbackWho,
+            why = start?.why?.takeUnless { PlanRecord.takesASecret(plan) },
+            letThrough = how,
+            steps = steps,
+            outcome = outcomeOf(steps, ending)
+        ).bounded()
+    }
+
+    /**
+     * The text each clipboard step of [plan] put on the clipboard, as its words. The card
+     * does not count it as sent, but it is what the phone handed him to paste anywhere. A
+     * value filled in from an earlier step is named as that, never quoted.
+     */
+    private fun clipboardTexts(plan: Plan): List<PlanApprovalSummary.OutgoingText> =
+        plan.steps.mapIndexedNotNull { index, step ->
+            if (mappedName(step) != CLIPBOARD || CLIPBOARD_TEXT in ActionSchema.sensitiveParamNames) return@mapIndexedNotNull null
+            val mapping = autoMapper.mapAction(step.action, step.params, emptySet())
+            val params = if (mapping.mappedAction != null) mapping.mappedParams else step.params
+            params[CLIPBOARD_TEXT]?.takeIf(String::isNotBlank)?.let { text ->
+                PlanApprovalSummary.OutgoingText(index + 1, CLIPBOARD_TEXT, PlanApprovalSummary.withStepAnswersNamed(text, plan.steps))
+            }
+        }
+
+    /**
+     * The actions that only save a draft for him to publish or send himself, with what the
+     * record says of each that ran: publishing stays his tap (plan rule 5), so the step is
+     * left open for him, and a post he publishes later goes on the record by itself.
+     */
+    internal val DRAFTS_FOR_HIM = mapOf(
+        "SOCIAL_CREATE_POST" to "saved as a draft for him to publish",
+        "SOCIAL_CREATE_CAMPAIGN" to "its posts were saved as drafts for him to publish",
+        "SOCIAL_DRAFT_REPLIES" to "any replies it drafted wait for him to send"
+    )
+
+    private fun endOf(step: PlanStep, canonical: String, reads: Boolean, handedOver: Boolean, toldAlready: Boolean): Pair<StepEnd, String?> =
+        when (step.status) {
+            StepStatus.COMPLETED -> when {
+                toldAlready -> StepEnd.LEFT_OPEN to PlanRecord.reason(step.result)
+                canonical in DRAFTS_FOR_HIM -> StepEnd.LEFT_OPEN to DRAFTS_FOR_HIM.getValue(canonical)
+                else -> StepEnd.DONE to null
+            }
+            StepStatus.FAILED -> when {
+                handedOver -> StepEnd.LEFT_OPEN to PlanRecord.reason(step.error)
+                step.error?.startsWith(BLOCKED) == true -> StepEnd.NOT_RUN to NEEDED_A_FAILED_STEP
+                // A reading step's error can quote what it read.
+                reads -> StepEnd.FAILED to null
+                else -> StepEnd.FAILED to PlanRecord.reason(step.error)
+            }
+            StepStatus.RUNNING -> StepEnd.INTERRUPTED to null
+            StepStatus.PENDING -> StepEnd.NOT_RUN to null
+        }
+
+    /**
+     * How the whole run ended. Nothing run is [Outcome.NOT_RUN]. A run that was stopped,
+     * or ended early with nothing failed, is [Outcome.STOPPED]. Then: all done, all failed,
+     * something whose end is not known and nothing failed, done or failed with something
+     * left open for him, and anything else is a part.
+     */
+    fun outcomeOf(steps: List<PhoneLogStep>, ending: Ending): Outcome {
+        val ends = steps.map { it.end }
+        val done = ends.count { it == StepEnd.DONE }
+        val failed = ends.count { it == StepEnd.FAILED }
+        val open = ends.count { it == StepEnd.LEFT_OPEN }
+        val unknown = ends.count { it == StepEnd.UNKNOWN }
+        return when {
+            ends.all { it == StepEnd.NOT_RUN } -> Outcome.NOT_RUN
+            StepEnd.INTERRUPTED in ends || ending is Ending.Stopped || ending is Ending.Declined ||
+                ending is Ending.NotRun -> Outcome.STOPPED
+            ending is Ending.Finished && !ending.isSuccess && failed == 0 && open == 0 && unknown == 0 -> Outcome.STOPPED
+            done == ends.size -> Outcome.DONE
+            unknown > 0 && failed == 0 && done + open + unknown == ends.size -> Outcome.UNKNOWN
+            open > 0 && failed == 0 && done + open == ends.size -> Outcome.LEFT_OPEN
+            failed > 0 && done == 0 && open == 0 -> Outcome.FAILED
+            else -> Outcome.PARTLY
+        }
+    }
+
+    /** The app a step acts in: the one it names, or the one its action always uses. */
+    fun appOf(canonical: String, params: Map<String, String>): String? =
+        APP_PARAMS.firstNotNullOfOrNull { params[it]?.trim()?.takeIf(String::isNotEmpty) }
+            ?: ACTION_APPS[canonical]
+
+    private val APP_PARAMS = listOf("appName", "app", "app_name", "packageName", "package")
+
+    private val ACTION_APPS = mapOf(
+        "SEND_WHATSAPP" to "WhatsApp",
+        "SEND_WHATSAPP_GROUP" to "WhatsApp",
+        "SEND_TELEGRAM" to "Telegram",
+        "OPEN_TELEGRAM" to "Telegram",
+        "SEND_SMS" to "Messages",
+        "SEND_EMAIL" to "the email app",
+        "MAKE_CALL" to "the phone app",
+        "MAKE_VIDEO_CALL" to "the phone app",
+        "PLAY_YOUTUBE" to "YouTube",
+        "BOOK_UBER" to "Uber",
+        "BOOK_OLA" to "Ola",
+        "SEARCH_AMAZON" to "Amazon",
+        "SEARCH_FLIPKART" to "Flipkart"
+    )
+
+    private const val BLOCKED = "Skipped: depends on failed step"
+    private const val NEEDED_A_FAILED_STEP = "it needed a step that failed"
+    private const val HE_SAID_NO = "he said no"
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt b/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt
new file mode 100644
index 0000000..bd73bb7
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt
@@ -0,0 +1,112 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.agent.PlanPrivacy
+
+/**
+ * Who started each plan the chat loop has in hand, why, and how it was let through, noted
+ * where each of those is known (his message became a plan, her command did, a gate let it
+ * run) and read once the plan has ended, when its entry is written. Beside that, how its
+ * steps really ran where the plan itself does not say it ([PlanEntries.AsRun]): the
+ * fallback that ran in a step's place, and the values he gave when a step asked for one.
+ * And how many times the plan has gone on the record, so that a run that breaks off is
+ * put on it only when nothing else has put it there.
+ *
+ * Kept in memory, for the newest [max] plans only: a plan is recorded when it ends, which
+ * is soon after it starts or waits at the gate. A plan noted nowhere (one resumed after the
+ * app was restarted) is recorded with what its entry can still say.
+ */
+class PlanStarts(private val max: Int = MAX_PLANS) {
+
+    /** What is known of how a plan started. Any part can be unknown. */
+    data class Start(val who: Starter? = null, val why: String? = null, val how: LetThrough? = null)
+
+    private val starts = newest<Start>()
+    private val runs = newest<MutableMap<String, PlanEntries.AsRun>>()
+    private val puts = newest<Int>()
+
+    private fun <T> newest() = object : LinkedHashMap<String, T>() {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, T>): Boolean = size > max
+    }
+
+    /** [planId] was started by [who], for [why]. How it is let through is noted apart, when it passes a gate. */
+    @Synchronized
+    fun started(planId: String, who: Starter, why: String?) {
+        starts[planId] = Start(who, why?.takeIf { it.isNotBlank() }, starts[planId]?.how)
+    }
+
+    /**
+     * [planId] was let through by [how]. With [keepEarlier] a gate noted before stands: a
+     * plan that runs on her rein also runs as approved, and it is her rein that let it.
+     */
+    @Synchronized
+    fun letThrough(planId: String, how: LetThrough, keepEarlier: Boolean = false) {
+        val now = starts[planId] ?: Start()
+        if (keepEarlier && now.how != null) return
+        starts[planId] = now.copy(how = how)
+    }
+
+    @Synchronized
+    fun of(planId: String): Start? = starts[planId]
+
+    /** Step [stepId] of [planId] is run afresh: what an earlier run of it was noted as no longer holds. */
+    @Synchronized
+    fun stepStarted(planId: String, stepId: String) {
+        runs[planId]?.remove(stepId)
+    }
+
+    /**
+     * The fallback [action] ran in the place of step [stepId] of [planId]. It runs with the
+     * step's own parameters, so values given to the step that failed first do not carry over.
+     */
+    @Synchronized
+    fun fallbackRan(planId: String, stepId: String, action: String) {
+        if (action.isBlank()) return
+        steps(planId)[stepId] = PlanEntries.AsRun(action = action)
+    }
+
+    /**
+     * Step [stepId] of [planId], run as [action], asked him for values and ran again with
+     * what he gave it ([given]): an answer he typed, or the contact he picked. It is noted,
+     * but never a secret: a parameter the app treats as one is left out ([kept]).
+     */
+    @Synchronized
+    fun valuesGiven(planId: String, stepId: String, action: String, given: Map<String, String>) {
+        val kept = kept(action, given)
+        if (kept.isEmpty()) return
+        val steps = steps(planId)
+        val now = steps[stepId] ?: PlanEntries.AsRun()
+        steps[stepId] = now.copy(given = now.given + kept)
+    }
+
+    /** How step [stepId] of [planId] really ran, where it was noted. */
+    @Synchronized
+    internal fun asRun(planId: String, stepId: String): PlanEntries.AsRun? = runs[planId]?.get(stepId)
+
+    /** [planId] has gone on the record once more. */
+    @Synchronized
+    fun recorded(planId: String) {
+        puts[planId] = (puts[planId] ?: 0) + 1
+    }
+
+    /** How many times [planId] has gone on the record in this process. */
+    @Synchronized
+    fun timesRecorded(planId: String): Int = puts[planId] ?: 0
+
+    private fun steps(planId: String): MutableMap<String, PlanEntries.AsRun> = runs.getOrPut(planId) { mutableMapOf() }
+
+    companion object {
+        private const val MAX_PLANS = 64
+
+        /**
+         * What the record may keep of the values he gave a step of [action] ([given]): none
+         * that is blank, and none under a parameter the app treats as a secret, for that
+         * action or any other.
+         */
+        internal fun kept(action: String, given: Map<String, String>): Map<String, String> {
+            val plain = given.filter { (key, value) -> value.isNotBlank() && key !in ActionSchema.sensitiveParamNames }
+            val redacted = PlanPrivacy.redactParams(action, plain)
+            return plain.filter { (key, value) -> redacted[key] == value }
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt
new file mode 100644
index 0000000..928d240
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt
@@ -0,0 +1,48 @@
+package com.opendroid.ai.core.record
+
+import android.util.Log
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.core.persona.PhoneRecordLink
+import kotlinx.coroutines.CancellationException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her door to the record of what the phone did ([PhoneRecordLink]): the entries are picked
+ * ([RecordLines]) and worded here, and she is handed the finished lines, each with its age
+ * (from when it ended) in the words her prompt gives the app's other lines ([PersonaPrompts.age]).
+ *
+ * A record that cannot be read is no lines at all: her prompt is never held up by it.
+ */
+@Singleton
+class RecordForHer internal constructor(private val entries: suspend () -> List<PhoneLogEntry>) : PhoneRecordLink {
+
+    @Inject
+    constructor(record: PhoneRecord) : this({ record.entries() })
+
+    override suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forReply(it, hisMessage, nowMillis, heldBack) }
+
+    override suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forMoment(it, nowMillis) }
+
+    override suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forNotebook(it, sinceMillis, nowMillis) }
+
+    private suspend fun worded(
+        heldBack: Boolean,
+        nowMillis: Long,
+        pick: (List<PhoneLogEntry>) -> List<PhoneLogEntry>
+    ): List<String> = try {
+        pick(entries()).map { RecordLines.line(it, heldBack, PersonaPrompts.age(nowMillis - it.lastAt)) }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        Log.w(TAG, "The record was not read for her: ${e.javaClass.simpleName}")
+        emptyList()
+    }
+
+    private companion object {
+        const val TAG = "RecordForHer"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt
new file mode 100644
index 0000000..afb66d9
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt
@@ -0,0 +1,196 @@
+package com.opendroid.ai.core.record
+
+/**
+ * Which entries of the record she is told, and how each reads: one line per entry, in the
+ * app's plain words, with its age in front.
+ *
+ * Which entries, each by when it ended ([PhoneLogEntry.lastAt]):
+ *  - A reply of hers ([forReply]): the newest of the last two days, and older ones (within
+ *    the record's 30 days) that his message is about: they share a word with it that is
+ *    rare in the record, such as who a message went to, an app, or a word that was sent.
+ *    Where her route holds his details back, only the newest: which older entries his
+ *    message picked would tell who they went to and what they said.
+ *  - A moment of her own ([forMoment]): the last day.
+ *  - Her notebook pass ([forNotebook]): what ended since its last pass.
+ * Each list is oldest first, the way the app's other lines are.
+ *
+ * How each reads ([line]): who started it and why, how it was let through, then every
+ * step with who or what it acts on, the app, the words it sent and how it ended. Where her
+ * route holds his details back, an entry keeps only its kind and its time: who started it,
+ * how it was let through, the bare action of each step and how it ended. Who a step went
+ * to, what it said, his message, a reason (which can name a contact) and a macro's name
+ * stay on the phone.
+ */
+internal object RecordLines {
+
+    const val REPLY_RECENT = 8
+    const val REPLY_RELATED = 4
+    const val MOMENT_ENTRIES = 8
+    const val NOTEBOOK_ENTRIES = 12
+
+    const val RECENT_MILLIS = 2L * 24 * 60 * 60 * 1000
+    const val DAY_MILLIS = 24L * 60 * 60 * 1000
+
+    /** How much of one sent text her prompt shows. The record keeps more. */
+    const val MAX_SHOWN_WORDS_CHARS = 280
+
+    /** How long one entry's line can be in her prompt. */
+    const val MAX_LINE_CHARS = 900
+
+    // An entry stamped a little ahead of the clock (a clock that moved) is still shown.
+    private const val CLOCK_SLACK_MILLIS = 60_000L
+
+    fun forReply(entries: List<PhoneLogEntry>, hisMessage: String, nowMillis: Long, heldBack: Boolean = false): List<PhoneLogEntry> {
+        val shown = entries.filter { it.lastAt <= nowMillis + CLOCK_SLACK_MILLIS && it.lastAt >= nowMillis - PhoneLog.MAX_AGE_MILLIS }
+        val recentFrom = nowMillis - RECENT_MILLIS
+        val recent = shown.filter { it.lastAt >= recentFrom }.sortedBy { it.lastAt }.takeLast(REPLY_RECENT)
+        if (heldBack) return recent
+        val older = shown.filter { it.lastAt < recentFrom }
+        val related = about(older, shown, hisMessage).take(REPLY_RELATED)
+        return (related + recent).distinctBy { it.id }.sortedBy { it.lastAt }
+    }
+
+    fun forMoment(entries: List<PhoneLogEntry>, nowMillis: Long): List<PhoneLogEntry> =
+        entries.filter { it.lastAt <= nowMillis + CLOCK_SLACK_MILLIS && it.lastAt >= nowMillis - DAY_MILLIS }
+            .sortedBy { it.lastAt }
+            .takeLast(MOMENT_ENTRIES)
+
+    fun forNotebook(entries: List<PhoneLogEntry>, sinceMillis: Long, nowMillis: Long): List<PhoneLogEntry> =
+        entries.filter {
+            it.lastAt > sinceMillis && it.lastAt <= nowMillis + CLOCK_SLACK_MILLIS && it.lastAt >= nowMillis - PhoneLog.MAX_AGE_MILLIS
+        }
+            .sortedBy { it.lastAt }
+            .takeLast(NOTEBOOK_ENTRIES)
+
+    /**
+     * The entries of [candidates] that [message] is about, best first: those that share
+     * the most of its rare words, and of two alike the newer. A word is rare when few
+     * entries of the whole record ([all]) hold it, so a word every entry has ("send",
+     * an app he uses every day) points at none of them.
+     */
+    fun about(candidates: List<PhoneLogEntry>, all: List<PhoneLogEntry>, message: String): List<PhoneLogEntry> {
+        if (candidates.isEmpty()) return emptyList()
+        val asked = words(message)
+        if (asked.isEmpty()) return emptyList()
+        val wordsOf = all.associate { it.id to words(searchText(it)) }
+        val holding = wordsOf.values.flatMap { it }.groupingBy { it }.eachCount()
+        // In a tenth of the record at most, and never fewer than two entries: one other entry may share it.
+        val rareAt = maxOf(2, all.size / 10)
+        val rare = asked.filter { (holding[it] ?: 0) in 1..rareAt }.toSet()
+        if (rare.isEmpty()) return emptyList()
+        return candidates
+            .map { entry -> entry to (wordsOf[entry.id] ?: words(searchText(entry))).count { it in rare } }
+            .filter { it.second > 0 }
+            .sortedWith(compareByDescending<Pair<PhoneLogEntry, Int>> { it.second }.thenByDescending { it.first.lastAt })
+            .map { it.first }
+    }
+
+    /** What of an entry his message can be about: why, who and what each step acted on, the app, the words. */
+    private fun searchText(entry: PhoneLogEntry): String = buildString {
+        entry.why?.let { append(it).append(' ') }
+        entry.steps.forEach { step ->
+            append(step.line).append(' ')
+            step.app?.let { append(it).append(' ') }
+            step.words.forEach { append(it.text).append(' ') }
+        }
+    }
+
+    /** The words of [text] that can tell entries apart: letters and digits, lowercased, no common words. */
+    internal fun words(text: String): Set<String> =
+        WORD.findAll(text.lowercase()).map { it.value }
+            .filter { word -> (word.length >= 3 || word.any { it.code > 0x2E7F }) && word !in COMMON }
+            .toSet()
+
+    private val WORD = Regex("""[\p{L}\p{N}]+""")
+
+    private val COMMON = setOf(
+        "the", "and", "for", "you", "your", "yours", "with", "that", "this", "these", "those", "from", "into", "onto",
+        "are", "was", "were", "been", "being", "have", "has", "had", "not", "but", "can", "could", "would", "should",
+        "will", "just", "what", "when", "where", "which", "who", "whom", "why", "how", "all", "any", "some", "about",
+        "did", "does", "doing", "done", "its", "him", "his", "her", "hers", "she", "they", "them", "their",
+        "our", "out", "off", "now", "then", "than", "there", "here", "too", "very", "yes", "yeah", "okay", "please",
+        "also", "again", "still", "yet", "get", "got", "let", "lets", "say", "said", "tell", "told", "ask", "asked",
+        "send", "sent", "text", "texted", "message", "messages", "msg", "email", "mail", "call", "called", "open",
+        "opened", "app", "apps", "phone", "step", "steps", "answer", "set", "run", "ran", "make", "made", "today",
+        "tomorrow", "yesterday", "earlier", "later", "one", "two"
+    )
+
+    /** One entry as her prompt reads it, behind its [age] ("3 h ago"). */
+    fun line(entry: PhoneLogEntry, heldBack: Boolean, age: String): String {
+        val text = buildString {
+            append(age).append(": ")
+            append(whoPart(entry, heldBack))
+            howPart(entry.letThrough)?.let { append("; ").append(it) }
+            append(". ")
+            val steps = entry.steps.map { stepPart(it, heldBack) }
+            if (steps.size == 1) {
+                append(steps.single())
+            } else {
+                append(steps.withIndex().joinToString(" ") { (i, step) -> "${i + 1}) $step" })
+            }
+        }
+        return PhoneLogEntry.cut(safe(text), MAX_LINE_CHARS)
+    }
+
+    private fun whoPart(entry: PhoneLogEntry, heldBack: Boolean): String {
+        val why = entry.why?.takeUnless { heldBack }?.let { quoted(it, PhoneLogEntry.MAX_WHY_CHARS) }
+        return when (entry.who) {
+            Starter.HIM_CHAT -> "he asked in the chat" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_VOICE -> "he asked by voice" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_SHORTCUT -> "his shortcut" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_SCREEN -> "his tap on the app's own screen"
+            Starter.HER_REPLY -> "your command in a reply" + why?.let { ": $it" }.orEmpty()
+            Starter.HER_OWN_TIME -> "your command in a moment of your own" + why?.let { ": $it" }.orEmpty()
+            Starter.HER_OUTING -> "you, on an outing of your own on his screen" + why?.let { ": $it" }.orEmpty()
+            Starter.MACRO -> "a saved macro" + why?.let { " ($it)" }.orEmpty()
+            Starter.ROUTINE -> "a routine" + why?.let { " ($it)" }.orEmpty()
+            Starter.APP -> "the app by itself"
+            Starter.IMPORTED -> "from the app's history before this record"
+        }
+    }
+
+    private fun howPart(how: LetThrough?): String? = when (how) {
+        LetThrough.HIS_SETTING -> "his approval setting let it run"
+        LetThrough.HER_REIN -> "your rein let it run"
+        LetThrough.HIS_YES -> "he said yes"
+        LetThrough.HIS_NO -> "he said no"
+        LetThrough.HIS_TAP -> "he tapped it himself"
+        null -> null
+    }
+
+    private fun stepPart(step: PhoneLogStep, heldBack: Boolean): String = buildString {
+        if (heldBack) {
+            append(step.kind)
+        } else {
+            append(step.line)
+            step.app?.takeUnless { step.line.contains(it, ignoreCase = true) }?.let { append(" (").append(it).append(')') }
+            when (step.words.size) {
+                0 -> Unit
+                1 -> append(": ").append(quoted(step.words.single().text, MAX_SHOWN_WORDS_CHARS))
+                else -> append(": ").append(step.words.joinToString(", ") { "${it.param} ${quoted(it.text, MAX_SHOWN_WORDS_CHARS)}" })
+            }
+        }
+        // A fallback that ran in the place of the step's own action: which one failed first (its kind only).
+        step.insteadOf?.let { append(" (in place of ").append(it).append(", which failed)") }
+        append(" - ").append(endPart(step, heldBack))
+    }
+
+    private fun endPart(step: PhoneLogStep, heldBack: Boolean): String {
+        val reason = step.reason?.takeUnless { heldBack }
+        return when (step.end) {
+            StepEnd.DONE -> "done"
+            StepEnd.FAILED -> "failed" + reason?.let { ": $it" }.orEmpty()
+            StepEnd.LEFT_OPEN -> "left open for him to finish, not done by the phone" + reason?.let { ": $it" }.orEmpty()
+            StepEnd.INTERRUPTED -> "under way when it was stopped: it may or may not have gone through"
+            StepEnd.NOT_RUN -> "not run" + reason?.let { " ($it)" }.orEmpty()
+            StepEnd.UNKNOWN -> "how it ended is not known: it may have gone through" + reason?.let { " ($it)" }.orEmpty()
+        }
+    }
+
+    /** [text] on one line in quotation marks, cut to [max]. */
+    private fun quoted(text: String, max: Int): String =
+        "\"" + PhoneLogEntry.cut(text.lines().map { it.trim() }.filter { it.isNotEmpty() }.joinToString(" / "), max) + "\""
+
+    /** A line that cannot open a section of her prompt. */
+    private fun safe(text: String): String = PhoneLogEntry.oneLine(text).replace("===", "= = =")
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt
new file mode 100644
index 0000000..31615dc
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt
@@ -0,0 +1,59 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.security.AndroidKeyStoreAeadCipher
+import com.opendroid.ai.core.security.SecretAeadCipher
+import java.nio.charset.StandardCharsets
+import java.security.GeneralSecurityException
+
+/**
+ * Seals the record of what the phone did before it is written, and opens it again. The
+ * record names who he wrote to and what was sent, so it is never on the disk in the clear.
+ *
+ * [open] throws when the bytes cannot be opened: a key that is gone (the app was
+ * reinstalled, the Keystore was reset), a file that was changed or cut short. The store
+ * sets such a file aside and starts again; it never guesses at what it held.
+ */
+interface RecordSeal {
+    fun seal(plain: ByteArray): ByteArray
+
+    @Throws(GeneralSecurityException::class)
+    fun open(sealed: ByteArray): ByteArray
+}
+
+/**
+ * The seal on the phone: AES-256 in GCM mode with no padding, under a key that is made in
+ * the Android Keystore and never leaves it ([KEY_ALIAS]). Each seal takes a fresh random
+ * 12-byte IV from the Keystore, which is written in front of the ciphertext; GCM's tag
+ * follows the ciphertext, so a changed byte anywhere fails [open]. The bytes are bound to
+ * this record ([AAD]), so no other sealed text of the app can be put in its place.
+ *
+ * Built on the app's one Keystore cipher ([AndroidKeyStoreAeadCipher]), so there is still
+ * a single audited crypto implementation.
+ */
+class KeystoreRecordSeal internal constructor(private val cipher: SecretAeadCipher) : RecordSeal {
+
+    constructor() : this(AndroidKeyStoreAeadCipher(KEY_ALIAS))
+
+    override fun seal(plain: ByteArray): ByteArray {
+        val sealed = cipher.encrypt(plain, AAD)
+        check(sealed.iv.size == IV_BYTES) { "The Keystore gave a ${sealed.iv.size}-byte IV" }
+        return sealed.iv + sealed.ciphertext
+    }
+
+    override fun open(sealed: ByteArray): ByteArray {
+        if (sealed.size < IV_BYTES + TAG_BYTES) throw GeneralSecurityException("Too short to be a sealed record")
+        return cipher.decrypt(
+            iv = sealed.copyOfRange(0, IV_BYTES),
+            ciphertext = sealed.copyOfRange(IV_BYTES, sealed.size),
+            aad = AAD
+        )
+    }
+
+    companion object {
+        /** The Keystore alias of the record's key. */
+        const val KEY_ALIAS = "yume_phone_record"
+        const val IV_BYTES = 12
+        private const val TAG_BYTES = 16
+        private val AAD = "opendroid.phone_record.v1".toByteArray(StandardCharsets.UTF_8)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RunEntries.kt b/app/src/main/java/com/opendroid/ai/core/record/RunEntries.kt
new file mode 100644
index 0000000..3fca638
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RunEntries.kt
@@ -0,0 +1,149 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.agent.PlanRecord
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import java.util.UUID
+
+/**
+ * Who a run of saved steps is ([SequenceRun]): a macro or a routine, by its name. The
+ * executor that runs both is handed one by its caller, so that the run goes on the record
+ * as what it is, with every step inside it.
+ *
+ * [leftOut] are the saved steps its caller kept back before the run began (a macro's step
+ * that switches auto-reply, or one to a sender that only sends): the executor never sees
+ * them, but the record tells them in their places, as not run and why.
+ */
+data class SequenceRun(val who: Starter, val name: String, val leftOut: List<LeftOut> = emptyList()) {
+
+    /**
+     * A saved [step] kept back before the run began: its [place] among the saved steps in
+     * the order they run, counted from 1, and the plain [reason] it was kept back.
+     */
+    data class LeftOut(val place: Int, val step: PlanStep, val reason: String)
+
+    companion object {
+        fun macro(name: String, leftOut: List<LeftOut> = emptyList()) = SequenceRun(Starter.MACRO, name, leftOut)
+        fun routine(name: String) = SequenceRun(Starter.ROUTINE, name)
+    }
+}
+
+/** The entries of runs that are not plans of the chat loop: macros, routines and sends from the app's screens. */
+internal object RunEntries {
+
+    /**
+     * The entry of one run of [run]'s saved steps, [steps] as they stand when it ended:
+     * the steps the executor was given, in the order it runs them. The steps kept back
+     * before the run ([SequenceRun.leftOut]) are put back in their places, as not run and
+     * why. [handedOverStepId] is a step that left something open for him (a draft waiting
+     * for his tap), which ends the run without being done. [fallbacks] are the fallback
+     * actions that ran in the place of a step that failed, by step id. It started at
+     * [atMillis] and ended at [endedAtMillis].
+     */
+    fun sequence(
+        run: SequenceRun,
+        steps: List<PlanStep>,
+        ending: PlanEntries.Ending,
+        handedOverStepId: String?,
+        atMillis: Long,
+        endedAtMillis: Long? = null,
+        fallbacks: Map<String, String> = emptyMap()
+    ): PhoneLogEntry? {
+        val (all, keptBack) = withLeftOut(steps, run.leftOut)
+        val plan = Plan(
+            planId = "${run.who.name.lowercase()}-${UUID.randomUUID()}",
+            goal = run.name,
+            estimatedDuration = "",
+            estimatedSteps = all.size,
+            steps = all,
+            createdAt = atMillis
+        )
+        return PlanEntries.of(
+            plan = plan,
+            start = PlanStarts.Start(who = run.who, why = run.name),
+            ending = ending,
+            fallbackWho = run.who,
+            handedOver = { it.stepId == handedOverStepId },
+            ranAs = { step -> fallbacks[step.stepId]?.let { PlanEntries.AsRun(action = it) } },
+            endedAtMillis = endedAtMillis,
+            leftOut = keptBack
+        )
+    }
+
+    /**
+     * [ran] with the steps of [leftOut] put back in their places, each as not yet run, and
+     * the reason of each by its index in the list that comes back. A place past the end,
+     * or one taken twice, puts the step after the ones before it, so no step is lost.
+     */
+    private fun withLeftOut(ran: List<PlanStep>, leftOut: List<SequenceRun.LeftOut>): Pair<List<PlanStep>, Map<Int, String>> {
+        if (leftOut.isEmpty()) return ran to emptyMap()
+        val waiting = ArrayDeque(leftOut.sortedBy { it.place })
+        val all = ArrayList<PlanStep>(ran.size + leftOut.size)
+        val reasons = HashMap<Int, String>()
+        // Puts back every step kept back at the next place, or at any place before it.
+        fun putBack(toTheEnd: Boolean) {
+            while (waiting.isNotEmpty() && (toTheEnd || waiting.first().place <= all.size + 1)) {
+                val out = waiting.removeFirst()
+                reasons[all.size] = out.reason
+                all += out.step.copy(status = StepStatus.PENDING, result = null, error = null)
+            }
+        }
+        for (step in ran) {
+            putBack(toTheEnd = false)
+            all += step
+        }
+        putBack(toTheEnd = true)
+        return all to reasons
+    }
+
+    /** What a send from a social screen was. */
+    enum class SocialSend(val kind: String, val param: String) {
+        POST("Publish post", "content"),
+        COMMENT_REPLY("Reply to comment", "reply"),
+        INBOX_REPLY("Reply to message", "reply")
+    }
+
+    /**
+     * The entry of one send to a social site: [send] on [platform], to [to] (the author
+     * answered, or the account a post goes out from), with [words] in full. [actor] is who
+     * the social code says started it: "USER" is his own tap on the app's screen, anything
+     * else is the app by itself. [error] is why it failed, null when it went through.
+     */
+    fun social(
+        send: SocialSend,
+        platform: String,
+        to: String?,
+        words: String,
+        actor: String,
+        error: String?,
+        atMillis: Long
+    ): PhoneLogEntry {
+        val byHim = actor == HIS_TAP_ACTOR
+        val target = to?.trim()?.takeIf { it.isNotEmpty() }
+        val line = when (send) {
+            SocialSend.POST -> send.kind + (target?.let { " as $it" }.orEmpty())
+            else -> send.kind + (target?.let { " from $it" }.orEmpty())
+        }
+        val failed = error != null
+        val step = PhoneLogStep(
+            line = "$line on $platform",
+            kind = send.kind,
+            app = platform,
+            words = listOf(SentWords(send.param, words)),
+            end = if (failed) StepEnd.FAILED else StepEnd.DONE,
+            reason = if (failed) PlanRecord.reason(error) else null
+        )
+        return PhoneLogEntry(
+            id = "social-${UUID.randomUUID()}",
+            at = atMillis,
+            who = if (byHim) Starter.HIM_SCREEN else Starter.APP,
+            letThrough = if (byHim) LetThrough.HIS_TAP else null,
+            steps = listOf(step),
+            outcome = if (failed) Outcome.FAILED else Outcome.DONE
+        ).bounded()
+    }
+
+    /** The actor the social code gives a send made by his own tap. */
+    const val HIS_TAP_ACTOR = "USER"
+}
