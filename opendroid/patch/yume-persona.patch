+package com.opendroid.ai.core.agent
+
+/**
+ * Whether a message of the owner's asks about what is on his screen, so that a
+ * screenshot is taken and sent along with it.
+ *
+ * A screenshot shows whatever is open: a chat, a banking app, a notification. It is
+ * taken only when the message asks for the screen to be looked at ("read my screen",
+ * "what is on my screen"), or is nothing but a pointing phrase with "this" in it and
+ * only the screen to point at ("read this", "what is this").
+ *
+ * Talk takes none. A word that merely occurs in it does not ("stop showing off", "need
+ * sunscreen", "what am i to you"). A sentence about the screen that asks nobody to look
+ * does not ("i can't see the screen in this sun", "i'll check the screen brightness
+ * later"). And a follow-up to something that was just said does not: "what does that
+ * mean", "what's that", "explain that" point at the talk, not at the screen. When in
+ * doubt nothing is captured; he can always say "read my screen".
+ */
+internal object ScreenContext {
+
+    /** Words that only open a request and ask for nothing by themselves. */
+    private const val POLITE =
+        """(?:(?:hey|hi|ok|okay|so|and|now|then|well|wait|please|pls|yume|just|quickly|""" +
+            """can you|could you|would you|will you|go ahead and|i want you to|i need you to)[, ]+)*"""
+
+    /** Where a request can begin: at the start of the message or of a clause of it. */
+    private const val OPENS = """(?:^|[.!?,;] ?)$POLITE"""
+
+    /** The screen itself, not a thing that has the word in its name ("screen time", "screen protector"). */
+    private const val THE_SCREEN =
+        """\b(?:my|the|this) (?:screen|display)\b""" +
+            """(?![ -]?(?:protector|saver|time|shot|door|name|recorder|recording|brightness|resolution|""" +
+            """size|lock|timeout|rotation|orientation|settings|sharing|share|mirroring|reader))"""
+
+    /** Verbs that ask for something to be looked at when they open a request. */
+    private const val LOOK =
+        """(?:read|look at|take a look at|have a look at|check|describe|explain|summari[sz]e|translate)"""
+
+    /**
+     * A request to look at the screen: the verb opens the message or a clause of it, and
+     * the screen follows a few words on. "see" counts only as a question put to her
+     * ("can you see my screen"), never as "i can barely see my screen".
+     */
+    private val ASKS_TO_LOOK = Regex(
+        """$OPENS(?:$LOOK|(?:can|could|do) you see)\b[^.!?:,;]{0,20}$THE_SCREEN"""
+    )
+
+    /** A question about what the screen shows, wherever it stands in the message. */
+    private val ASKS_WHAT_IT_SHOWS = Regex(
+        """\bwhat(?:'s| is|s)(?: written| shown| showing| displayed| up| open)? on $THE_SCREEN|""" +
+            """\bwhat do you see on $THE_SCREEN"""
+    )
+
+    private val LOOKING_AT = Regex("""\bwhat am i looking at\b""")
+
+    private const val WHAT_IS_OPEN = """this (?:page|app|article|chat|message|email|post|screenshot)\b"""
+
+    /** The same kind of request about "this page", "this app" and the like. */
+    private val ASKS_ABOUT_WHAT_IS_OPEN = Regex("""$OPENS$LOOK\b[^.!?:,;]{0,12}\b$WHAT_IS_OPEN""")
+
+    private const val TAIL = """(?:[, ]+(?:out|aloud|out loud|for me|to me|please|pls|here|now))*[.!? ]*"""
+
+    /**
+     * Messages that are nothing but a pointing phrase: there is only the screen to point
+     * at. Only "this" points there. "that" and "it" point back at what was just said.
+     */
+    private val POINTS_AT_THE_SCREEN = listOf(
+        Regex("""^$POLITE(?:read|remember) this$TAIL$"""),
+        Regex("""^${POLITE}what(?:'s| is|s) this$TAIL$"""),
+        Regex("""^${POLITE}what does this say$TAIL$"""),
+        Regex("""^${POLITE}what(?:'s| is|s) $WHAT_IS_OPEN$TAIL$""")
+    )
+
+    /** Text after a colon is the thing he means: "remember this: i hate mushrooms". */
+    private val GIVES_THE_TEXT_ITSELF = Regex(""":\s*\S""")
+
+    fun isAskedFor(query: String): Boolean {
+        val text = query.lowercase().replace('’', '\'').replace(Regex("""\s+"""), " ").trim()
+        if (text.isEmpty()) return false
+        if (ASKS_TO_LOOK.containsMatchIn(text) || ASKS_WHAT_IT_SHOWS.containsMatchIn(text) ||
+            LOOKING_AT.containsMatchIn(text)
+        ) {
+            return true
+        }
+        if (GIVES_THE_TEXT_ITSELF.containsMatchIn(text)) return false
+        return ASKS_ABOUT_WHAT_IS_OPEN.containsMatchIn(text) || POINTS_AT_THE_SCREEN.any { it.matches(text) }
+    }
+}
