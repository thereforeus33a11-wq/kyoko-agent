+    // ── What an automatic retry may say about the attempt before it ──────────────────
+
+    /** The provider behind the gate every request passes, with the retries it makes by itself and no waiting. */
+    private fun gated() = WrappedLLMProvider(
+        delegate = provider,
+        configProvider = {
+            LLMConfig(
+                activeProvider = provider.name,
+                selectedModels = mapOf(provider.name to model),
+                apiKeys = mapOf(provider.name to apiKey),
+                customEndpoints = mapOf(provider.name to venice)
+            )
+        },
+        retryRuntime = RetryRuntime(nowMillis = { 0L }, delayMillis = {}, jitterMillis = { 0L })
+    )
+
+    private fun gatedFailure(): LLMException =
+        assertThrows(LLMException::class.java) { runBlocking { gated().complete(newRequest().copy(model = null, providerConfig = null)) } }
+
+    private val busy: () -> MockResponse = {
+        MockResponse.Builder().code(503).setHeader("Content-Type", "application/json").body("{}").build()
+    }
+
+    @Test
+    fun `when a retry finds the enclave failing its check, it is not said that nothing was sent`() {
+        val moods = Moods()
+        // The message goes out, encrypted to a key that had just passed, and the server is
+        // busy. By the time it is tried again the enclave no longer checks out.
+        moods.chatAnswer = { moods.proofHolds = false; busy() }
+        serveWith(moods)
+
+        val failure = gatedFailure()
+
+        assertEquals(LLMError.EncryptionCheckFailed, failure.error)
+        assertTrue("the first attempt did leave the phone", failure.earlierAttemptSent)
+        assertFalse(failure.replyDiscarded)
+        assertFalse(failure.retryable)
+        assertEquals("sent once, and not again after the failed check", 1, moods.chats)
+        assertEquals(2, attestationsAsked())
+    }
+
+    @Test
+    fun `a retry after an attempt that sent nothing still says that nothing was sent`() {
+        var attestations = 0
+        var chats = 0
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                if (!request.target.orEmpty().startsWith("/api/v1/tee/attestation")) {
+                    chats++
+                    return busy()
+                }
+                // Busy when first asked for its proof; a proof that does not hold after that.
+                if (attestations++ == 0) return busy()
+                val nonce = request.url.queryParameter("nonce").orEmpty()
+                val quote = TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce))
+                return json(TestEnclave.attestation(model, nonce, enclave.publicKeyHex, quote, verified = "false"))
+            }
+        }
+
+        val failure = gatedFailure()
+
+        assertNotSent(failure)
+        assertFalse("no attempt left the phone", failure.earlierAttemptSent)
+        assertEquals(0, chats)
+        assertEquals(2, attestations)
+    }
