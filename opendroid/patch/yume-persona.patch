+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.MemoryRepository
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+
+/**
+ * Her unprompted line: what her answer to the app's note comes to, and that asking her
+ * is recorded apart from a line she actually wrote.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaCheckInTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memoryRepository: MemoryRepository
+    private lateinit var personaMemory: PersonaMemory
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        personaMemory = PersonaMemory(memoryRepository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    private fun answer(reply: String, mayAct: Boolean) = PersonaEngine.checkInFrom(reply, mayAct) { "hold on" }
+
+    // ── What her answer comes to ─────────────────────────────────────────────────────
+
+    @Test
+    fun `a single full stop, or nothing, is her choosing to stay silent`() {
+        for (silence in listOf(".", " . ", "", "...", "\n")) {
+            assertNull("<$silence>", answer(silence, mayAct = false))
+            assertNull("<$silence>", answer(silence, mayAct = true))
+        }
+    }
+
+    @Test
+    fun `a line is taken as she wrote it, tidied the way a reply is`() {
+        assertEquals(PersonaEngine.CheckIn("the neon is on again", null), answer("Yume: the neon is on again", mayAct = false))
+    }
+
+    @Test
+    fun `on ask a command at the end of the line is dropped and the line stays`() {
+        val checkIn = answer("bored. putting something on\n>> play music", mayAct = false)
+        assertEquals(PersonaEngine.CheckIn("bored. putting something on", null), checkIn)
+        // A command with no words and no leave to act is nothing at all.
+        assertNull(answer(">> play music", mayAct = false))
+    }
+
+    @Test
+    fun `with the phone given to her the command comes back with the line`() {
+        val checkIn = answer("bored. putting something on\n>> play music", mayAct = true)
+        assertEquals(PersonaEngine.CheckIn("bored. putting something on", "play music"), checkIn)
+        // The command is never part of what is shown.
+        assertFalse(checkIn!!.line.contains(PersonaActions.MARKER))
+        // A command alone still leaves a line of hers in the chat.
+        assertEquals(PersonaEngine.CheckIn("hold on", "flashlight on"), answer(">> flashlight on", mayAct = true))
+    }
+
+    // ── An attempt is not a line ─────────────────────────────────────────────────────
+
+    @Test
+    fun `an attempt that wrote nothing is stored apart from the last line she wrote`() = runBlocking {
+        assertEquals(0L, personaMemory.checkInNotBefore())
+        assertEquals(0L, personaMemory.lastCheckInAt())
+
+        personaMemory.deferCheckIn(1_700_000_900_000)
+
+        assertEquals(1_700_000_900_000, personaMemory.checkInNotBefore())
+        // Asking her did not count as her having written.
+        assertEquals(0L, personaMemory.lastCheckInAt())
+
+        personaMemory.recordCheckIn(1_700_000_000_000)
+        assertEquals(1_700_000_000_000, personaMemory.lastCheckInAt())
+        assertEquals(1_700_000_900_000, personaMemory.checkInNotBefore())
+    }
+
+    @Test
+    fun `the wait is not a note of hers and never reaches a prompt as a fact`() = runBlocking {
+        personaMemory.deferCheckIn(1_700_000_900_000)
+
+        assertTrue(personaMemory.notes().isEmpty())
+        val facts = memoryRepository.getValidMemoriesByType(MemoryType.SEMANTIC)
+        assertTrue(facts.toString(), facts.none { it.value.contains("1700000900000") })
+    }
+
+    @Test
+    fun `after a silence that is due one failed attempt is tried again a quarter of an hour later`() {
+        val hour = 60L * 60 * 1000
+        val now = 1_000 * hour
+        val talk = listOf(
+            com.opendroid.ai.data.models.ChatMessage("o", "hi", com.opendroid.ai.data.models.ChatMessage.Sender.USER, now - 5 * hour),
+            com.opendroid.ai.data.models.ChatMessage("y", "mm", com.opendroid.ai.data.models.ChatMessage.Sender.AGENT, now - 5 * hour, PersonaPrompts.BADGE)
+        )
+        // The attempt at `now` failed: only the wait was recorded, no line.
+        val notBefore = now + CheckInRule.RETRY_AFTER_FAILURE_MILLIS
+        assertFalse(CheckInRule.isDue(talk, now + 5 * 60_000, 21, lastCheckInAt = 0L, notBefore = notBefore))
+        assertTrue(CheckInRule.isDue(talk, now + 16 * 60_000, 21, lastCheckInAt = 0L, notBefore = notBefore))
+        // Had the attempt been recorded as a line, as it used to be, she could not write
+        // again until he had written and six more hours had passed.
+        assertFalse(CheckInRule.isDue(talk, now + 16 * 60_000, 21, lastCheckInAt = now, notBefore = 0L))
+    }
+
+    // ── How the engine and the loop use it ───────────────────────────────────────────
+
+    @Test
+    fun `the engine records the attempt before the call and leaves the line to be reported once it is stored`() {
+        val engine = File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        val checkIn = engine.substringAfter("suspend fun checkInLine(").substringBefore("suspend fun checkInWritten(")
+        val attempt = checkIn.indexOf("memory.deferCheckIn(nowMillis + CheckInRule.RETRY_AFTER_FAILURE_MILLIS)")
+        val call = checkIn.indexOf("chatProvider(config).complete(")
+        assertTrue(attempt >= 0)
+        assertTrue(call > attempt)
+        // Asking her never counts as a line: only checkInWritten records one.
+        assertFalse(checkIn.contains("memory.recordCheckIn("))
+        assertTrue(checkIn.contains("memory.deferCheckIn(nowMillis + CheckInRule.RETRY_AFTER_SILENCE_MILLIS)"))
+        // She is offered her own actions only where the rule allows them, and the app's
+        // lines put in front of her are recent ones.
+        assertTrue(checkIn.contains("val mayAct = CheckInRule.mayAct(config)"))
+        assertTrue(checkIn.contains("ownActions = mayAct"))
+        assertTrue(checkIn.contains("activityMaxAgeMillis = CheckInRule.MAX_APP_LINE_AGE_MILLIS"))
+        assertTrue(checkIn.contains("settings = CheckInRule.Settings.of(config)"))
+        assertTrue(checkIn.contains("notBefore = memory.checkInNotBefore()"))
+    }
+
+    @Test
+    fun `the loop reports the line as written only after it is in the chat, and runs her command as one of hers`() {
+        val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        val checkIn = loop.substringAfter("suspend fun personaCheckIn(").substringBefore("private fun isFreeForCheckIn(")
+        val stored = checkIn.indexOf("conversationRepository.insertMessage(sessionId, message)")
+        val written = checkIn.indexOf("persona.checkInWritten(nowMillis)")
+        assertTrue(stored >= 0)
+        assertTrue(written > stored)
+        // A command is taken only where the rule allows one and there is a context to run it in.
+        assertTrue(checkIn.contains("val mayAct = context != null && com.opendroid.ai.core.persona.CheckInRule.mayAct(checkInConfig)"))
+        assertTrue(checkIn.contains("if (command != null && context != null && mayAct) {"))
+
+        val action = loop.substringAfter("private fun startCheckInAction(").substringBefore("private suspend fun runPersonaAction(")
+        // Under the same lock as every task, and through the same door as any command of hers.
+        assertTrue(action.contains("queryMutex.withLock {"))
+        assertTrue(action.contains("runPersonaAction("))
+        assertTrue(action.contains("screenshotAttached = false"))
+        // Nothing here plans, approves or runs by itself.
+        assertFalse(action.contains("executePlanLoop("))
+        assertFalse(action.contains("proposePlan("))
+        assertFalse(action.contains("planManager."))
+
+        // A line being read out or an error card does not keep her from writing; a task of his does.
+        val free = loop.substringAfter("private fun isFreeForCheckIn(").substringBefore("private fun startCheckInAction(")
+        for (busy in listOf("AgentState.Thinking", "AgentState.ExecutingPlan", "AgentState.PlanProposed", "AgentState.Listening")) {
+            assertTrue(busy, free.contains("state is $busy"))
+        }
+        assertFalse(free.contains("AgentState.Speaking"))
+        assertFalse(free.contains("AgentState.Error"))
+        assertTrue(free.contains("!isWaitingForUserInput"))
+    }
+}
