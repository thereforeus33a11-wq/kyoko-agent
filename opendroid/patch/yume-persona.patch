+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.agent.herRouteHoldsBack
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.HerNow
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnLife
+import com.opendroid.ai.core.life.Wonders
+import com.opendroid.ai.core.life.ears.Overheard
+import com.opendroid.ai.core.life.eyes.Looks
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.llm.error.LLMErrorMapper
+import com.opendroid.ai.core.memory.MemoryManager
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.ConversationRepository
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * "Try her brain", run against her engine the way the app builds it: each model is asked with
+ * her real reply prompt (the one her reply in the chat is built from, on the settings she would
+ * have on that model), through the route that model takes, and nothing of the try is left
+ * behind: no row, note, thought, feeling, log line, ledger call or setting, and what she
+ * overheard is still there for her next real reply.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class BrainTrialTest {
+
+    private val custom = PersonaEngineTestSetup.CUSTOM
+    private val seeing = VenicePrivateTier.SEEING_BRAIN
+    private val encrypted = "e2ee-kimi-k2-6"
+    private val look = "LOOKS: he can ask you to look through the camera."
+    private var now = 1_800_000_000_000L
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory get() = File(context.filesDir, "persona")
+    private val lifeDirectory get() = File(context.filesDir, "brain-trial-test")
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var settings: SettingsRepository
+    private lateinit var memory: PersonaMemory
+    private lateinit var memoryManager: MemoryManager
+    private lateinit var conversations: ConversationRepository
+    private lateinit var thoughts: PersonaThoughts
+    private lateinit var pictures: PersonaPictures
+    private lateinit var ledger: OwnLedger
+    private lateinit var engine: PersonaEngine
+    private val overheard = Overheard { now }
+    private val profile = PersonaEngineTestSetup.ProfileNamed("Ren")
+    private val sent = CopyOnWriteArrayList<Pair<LLMConfig, LLMRequest>>()
+    private val hersOnHerOwn = CopyOnWriteArrayList<Boolean>()
+
+    /** The phone's record as her engine is handed it: what it was asked, and the lines it gives. */
+    private class Record : PhoneRecordLink {
+        var lines: List<String> = emptyList()
+        val asked = CopyOnWriteArrayList<Triple<String, String, Boolean>>()
+        override suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String> {
+            asked += Triple("reply", hisMessage, heldBack)
+            return lines
+        }
+        override suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String> {
+            asked += Triple("moment", "", heldBack)
+            return lines
+        }
+        override suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String> {
+            asked += Triple("notebook", "", heldBack)
+            return lines
+        }
+    }
+    private val record = Record()
+
+    @Before
+    fun setUp() {
+        directory.deleteRecursively()
+        lifeDirectory.deleteRecursively()
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java).allowMainThreadQueries().build()
+        settings = PersonaEngineTestSetup.settings()
+        val store = PersonaStore(context)
+        store.saveCard("You are Yume. {{owner}} built you.")
+        memory = PersonaMemory(
+            MemoryRepository(memoryDao = database.memoryDao(), taskHistoryDao = database.taskHistoryDao(), macroDao = database.macroDao())
+        )
+        ledger = OwnLedger({ File(lifeDirectory, "own_ledger.json") }, { now })
+        val log = HerLog({ File(lifeDirectory, "her_log.json") }, { now })
+        val life = OwnLife(ledger, log, HerNow(), Wonders({ lifeDirectory }, TestThoughtsCipher()), null as Looks?, overheard)
+        memoryManager = PersonaEngineTestSetup.memoryManager(context, database, profile)
+        conversations = ConversationRepository(database, database.conversationDao(), database.chatSessionDao())
+        thoughts = testThoughts(directory)
+        pictures = PersonaPictures(context)
+        engine = PersonaEngine(
+            store = store,
+            memory = memory,
+            library = PersonaLibrary(context),
+            settingsRepository = settings,
+            llmProviderFactory = PersonaEngineTestSetup.factory(settings),
+            userProfileStore = profile,
+            pictures = pictures,
+            memoryManager = memoryManager,
+            thoughts = thoughts,
+            ownLife = life,
+            phoneRecord = record
+        )
+        engine.clock = { now }
+        configure { it }
+        runBlocking {
+            memory.apply(listOf(Note(Kind.USER, "bees", "he keeps bees on the roof"), Note(Kind.ME, "soda", "melon soda is mine")))
+            val session = conversations.createSession()
+            talk(session, "did you eat", her = false)
+            talk(session, "melon bread. you", her = true)
+            talk(session, "what are you doing tonight", her = false)
+            talk(session, "sleeping probably. why", her = true)
+            // Her starting notes are written once a process, by whichever prompt of hers comes first.
+            engine.chatSystemPrompt(settings.llmConfig.first(), "", emptyList(), screenshotAttached = false, nowMillis = now - 200_000)
+        }
+        overheard.add(Overheard.Line(now - 60_000, "where did I leave the charger", listOf("quietly"), his = true))
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+        directory.deleteRecursively()
+        lifeDirectory.deleteRecursively()
+    }
+
+    private var rowAt = 1_799_999_000_000L
+
+    private suspend fun talk(session: String, text: String, her: Boolean) {
+        rowAt += 60_000
+        conversations.insertMessage(
+            session,
+            ChatMessage(
+                id = "row-$rowAt",
+                text = text,
+                sender = if (her) ChatMessage.Sender.AGENT else ChatMessage.Sender.USER,
+                timestamp = rowAt,
+                modelBadge = if (her) PersonaPrompts.replyBadge(false) else PersonaPrompts.OWNER_TALK_BADGE
+            )
+        )
+    }
+
+    private fun configure(change: (LLMConfig) -> LLMConfig): LLMConfig = runBlocking {
+        settings.updateConfig { config ->
+            change(
+                config.copy(
+                    routePolicy = RoutePolicy.ENCRYPTED,
+                    activeProvider = custom,
+                    selectedModels = mapOf(custom to "e2ee-deepseek-v4-1-flash-1017-abliterated"),
+                    customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+                    trustVenicePrivate = true,
+                    privateMode = true,
+                    personaLibraryChars = 0,
+                    personaOwnLife = true,
+                    personaOpenMic = true,
+                    personaCheckInsEnabled = true
+                )
+            )
+        }
+        settings.llmConfig.first()
+    }
+
+    private fun trial(fail: Set<String> = emptySet()) = BrainTrial(
+        recentRows = { conversations.currentSessionId.first()?.let { conversations.getLastMessages(it, BrainTrial.HISTORY_ROWS) }.orEmpty() },
+        prompt = { config, rows -> engine.trialRequest(config, rows, look) },
+        send = { config, request ->
+            sent += config to request
+            hersOnHerOwn += currentCoroutineContext()[OwnCall] != null
+            if (request.modelOverride in fail) throw LLMErrorMapper.providerRefused(custom, request.modelOverride.orEmpty())
+            LLMResponse(
+                content = "mm. tonight im yours\n<< he asked about tonight. i like that\n>> play some music",
+                tokensUsed = 0,
+                model = request.modelOverride.orEmpty(),
+                provider = custom,
+                latencyMs = 0,
+                promptTokens = 13_000,
+                completionTokens = 200
+            )
+        },
+        clock = { now }
+    )
+
+    private fun run(config: LLMConfig, models: List<String>, ask: BrainTrial.Ask, fail: Set<String> = emptySet()): List<BrainTrial.Entry> {
+        val entries = CopyOnWriteArrayList<BrainTrial.Entry>()
+        runBlocking { trial(fail).run(config, models, ask) { entries += it } }
+        return entries.sortedBy { models.indexOf(it.model) }
+    }
+
+    private fun sentTo(model: String): LLMRequest = sent.single { it.second.modelOverride == model }.second
+
+    @Test
+    fun `each model is asked with her real reply prompt, built as her reply in the chat is`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        assertNull(HerBrain.whyNotMove(config))
+        val typed = BrainTrial.Ask.Typed("come over later?")
+        run(config, listOf(seeing, encrypted), typed)
+        assertEquals(2, sent.size)
+        for (model in listOf(seeing, encrypted)) {
+            val asHers = BrainChoice.withBrain(config, model)
+            val request = sentTo(model)
+            // The rows her reply is built from: the recent talk of the chat, then his message.
+            val rows = runBlocking { conversations.getLastMessages(conversations.currentSessionId.first()!!, BrainTrial.HISTORY_ROWS) }.takeLast(BrainTrial.HISTORY_ROWS - 1) +
+                ChatMessage("his", "come over later?", ChatMessage.Sender.USER, timestamp = now, modelBadge = PersonaPrompts.OWNER_TALK_BADGE)
+            // As the chat loop builds her reply to his talk: what its route holds back, the context read for his
+            // message, the rows shaped, and her prompt with the same pieces (no picture, sound or planner's note).
+            val heldBack = asHers.herRouteHoldsBack()
+            val shaped = PersonaPrompts.shapeHistory(rows, holdBackPrivateResults = heldBack, nowMillis = now)
+            val expected = runBlocking {
+                engine.chatSystemPrompt(
+                    config = asHers,
+                    relevantContext = memoryManager.getRelevantContext("come over later?", lean = heldBack),
+                    deviceActivity = shaped.deviceActivity,
+                    screenshotAttached = false,
+                    cues = engine.libraryCues(shaped.dialogue),
+                    lookLine = look,
+                    hisMessage = "come over later?"
+                )
+            }
+            assertEquals(model, expected, request.systemPrompt)
+            assertEquals(shaped.dialogue.map { it.sender to it.text }, request.messages.map { it.sender to it.text })
+            assertEquals("come over later?", request.messages.last().text)
+            // Her reply's own sampling, room and mark, on the model tried, with the options "Use this one" would set.
+            val hers = PersonaEngine.requestOfHers(PersonaEngine.replyRequest(expected, shaped.dialogue), asHers)
+            assertEquals(hers.temperature, request.temperature)
+            assertEquals(PersonaEngine.CHAT_TEMPERATURE, request.temperature)
+            assertEquals(PersonaEngine.CHAT_MAX_TOKENS, request.maxTokens)
+            assertEquals(ResponseFormat.TEXT, request.responseFormat)
+            assertTrue(request.persona)
+            assertEquals(model, request.modelOverride)
+            assertEquals(hers.extraBodyOverride, request.extraBodyOverride)
+            assertEquals(hers.thinkingOff, request.thinkingOff)
+            assertEquals(hers.keepsOwnSampling, request.keepsOwnSampling)
+            // Her prompt is hers: her card, her notes, what she overheard, and the line about looks.
+            assertTrue(request.systemPrompt.contains("You are Yume. Ren built you."))
+            assertTrue(request.systemPrompt.contains("melon soda is mine"))
+            assertTrue(request.systemPrompt.contains("where did I leave the charger"))
+            assertTrue(request.systemPrompt.contains(look))
+            // No picture and no sound go with a try.
+            assertTrue(request.messages.none { it.imageBase64 != null || it.moreImagesBase64.isNotEmpty() || it.audioBase64 != null })
+            // Sent with the settings she would have on it.
+            assertEquals(asHers, sent.single { it.second.modelOverride == model }.first)
+        }
+    }
+
+    @Test
+    fun `a try and her reply are told what the phone did for his message, and a moment of her own is not told it there`() {
+        record.lines = listOf("2 h ago: he asked in the chat: \"text nene i'm late\"; he said yes. Send SMS to Nene: \"late\" - done")
+        val config = runBlocking { settings.llmConfig.first() }
+        run(config, listOf(encrypted), BrainTrial.Ask.Typed("did nene answer?"))
+        val system = sentTo(encrypted).systemPrompt
+        assertTrue(system.contains(PersonaPrompts.PHONE_RECORD_HEADING + "\n- " + record.lines.single() + "\n"))
+        assertTrue(system.contains(PersonaPrompts.PHONE_RECORD_FACT))
+        // Asked for his message, with his details held back as her route on that model holds them.
+        val asHers = BrainChoice.withBrain(config, encrypted)
+        assertEquals(listOf(Triple("reply", "did nene answer?", asHers.herRouteHoldsBack())), record.asked.toList())
+
+        // Her chat prompt for a moment of her own or a step of an outing does not ask: the moment has its own block.
+        record.asked.clear()
+        val moment = runBlocking {
+            engine.chatSystemPrompt(config, "", emptyList(), screenshotAttached = false, inOwnTime = true, hisMessage = "x")
+        }
+        val outing = runBlocking {
+            engine.chatSystemPrompt(config, "", emptyList(), screenshotAttached = false, onOuting = true, hisMessage = "x")
+        }
+        val noMessage = runBlocking { engine.chatSystemPrompt(config, "", emptyList(), screenshotAttached = false) }
+        assertTrue(record.asked.isEmpty())
+        for (prompt in listOf(moment, outing, noMessage)) assertFalse(prompt.contains(PersonaPrompts.PHONE_RECORD_HEADING))
+    }
+
+    @Test
+    fun `a try leaves nothing behind, and what she overheard is still there for her next real reply`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        val session = runBlocking { conversations.currentSessionId.first()!! }
+        fun snapshot() = runBlocking {
+            listOf(
+                conversations.getLastMessages(session, 1_000).map { listOf(it.id, it.text, it.modelBadge, it.timestamp) },
+                conversations.sessions.first().map { it.id to it.updatedAt },
+                database.memoryDao().getAllMemories().map { listOf(it.key, it.value, it.timestamp) }.sortedBy { it.toString() },
+                thoughts.summary().count,
+                pictures.turn(),
+                settings.llmConfig.first(),
+                lifeDirectory.list()?.sorted().orEmpty()
+            )
+        }
+        val before = snapshot()
+        val entries = run(config, listOf(seeing, encrypted), BrainTrial.Ask.Typed("come over later?")) +
+            run(config, listOf(seeing, encrypted), BrainTrial.Ask.LastExchange)
+        assertEquals(4, entries.count { it.shown is BrainTrial.Shown.Reply })
+        assertEquals(before, snapshot())
+        // Her ledger counts none of it: no call ran as a call of hers on her own.
+        assertTrue(hersOnHerOwn.none { it })
+        assertEquals(emptyList<OwnLedger.Call>(), ledger.calls().orEmpty())
+        // What she overheard is still to be told, and her next real reply is told it.
+        assertEquals(1, overheard.size())
+        val next = runBlocking { engine.chatSystemPrompt(config, "", emptyList(), screenshotAttached = false) }
+        assertTrue(next.contains("where did I leave the charger"))
+        assertEquals(0, overheard.size())
+    }
+
+    @Test
+    fun `her reply is shown as the chat would show it, and her thought and command are only said`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        val entry = run(config, listOf(seeing), BrainTrial.Ask.Typed("come over later?")).single()
+        val reply = entry.shown as BrainTrial.Shown.Reply
+        assertEquals("mm. tonight im yours", reply.said)
+        assertTrue(reply.keptToHerself.contains("he asked about tonight"))
+        assertEquals("play some music", reply.command)
+        assertEquals(13_000, reply.promptTokens)
+        assertEquals(200, reply.replyTokens)
+        assertTrue(reply.counted)
+        assertEquals(BrainModels.usd(seeing, 13_000, 200)!!, reply.usd!!, 0.0)
+        // The thought was not kept as hers.
+        assertEquals(0, runBlocking { thoughts.summary().count })
+    }
+
+    @Test
+    fun `the last exchange is asked again without her answer to it, and a typed message comes after the talk`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        run(config, listOf(seeing), BrainTrial.Ask.LastExchange)
+        val again = sent.single().second.messages
+        assertEquals("what are you doing tonight", again.last().text)
+        assertEquals(ChatMessage.Sender.USER, again.last().sender)
+        assertTrue(again.none { it.text.contains("sleeping probably") })
+        sent.clear()
+        run(config, listOf(seeing), BrainTrial.Ask.Typed("come over later?"))
+        val typed = sent.single().second.messages
+        assertEquals("come over later?", typed.last().text)
+        assertTrue(typed.any { it.text.contains("sleeping probably") })
+        // A blank message is not sent anywhere.
+        sent.clear()
+        val blank = run(config, listOf(seeing, encrypted), BrainTrial.Ask.Typed("  "))
+        assertTrue(sent.isEmpty())
+        assertTrue(blank.all { (it.shown as BrainTrial.Shown.NotTried).why == BrainTrial.NO_MESSAGE })
+    }
+
+    @Test
+    fun `each model goes by the trust setting, and a model that fails or cannot go says so in its place`() {
+        // Untrusted, with private routes only: the Private-tier model is not asked, the encrypted one is.
+        val untrusted = configure { it.copy(trustVenicePrivate = false) }
+        val entries = run(untrusted, listOf(seeing, encrypted), BrainTrial.Ask.Typed("come over later?"), fail = setOf(encrypted))
+        val notTried = entries.first { it.model == seeing }.shown as BrainTrial.Shown.NotTried
+        assertTrue(notTried.why.contains(BrainChoice.TRUST_SWITCH))
+        val failed = entries.first { it.model == encrypted }.shown as BrainTrial.Shown.Failed
+        assertTrue(failed.why.contains("turned her reply down"))
+        assertEquals(listOf(encrypted), sent.map { it.second.modelOverride })
+
+        // Untrusted where any route may run: hosted, so her notes about him stay on the phone; encrypted, she has them.
+        sent.clear()
+        val any = configure { it.copy(trustVenicePrivate = false, routePolicy = RoutePolicy.ANY) }
+        run(any, listOf(seeing, encrypted), BrainTrial.Ask.Typed("come over later?"))
+        assertFalse(sentTo(seeing).systemPrompt.contains("he keeps bees on the roof"))
+        assertTrue(sentTo(encrypted).systemPrompt.contains("he keeps bees on the roof"))
+
+        // At most four, each once.
+        sent.clear()
+        val trusted = configure { it }
+        val many = listOf(seeing, encrypted, "xiaomi-mimo-v2-5", "venice-uncensored-role-play", "kimi-k3", seeing)
+        assertEquals(4, run(trusted, many, BrainTrial.Ask.Typed("hi")).size)
+        assertEquals(4, sent.map { it.second.modelOverride }.distinct().size)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/BrainTrialWiringTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/BrainTrialWiringTest.kt
new file mode 100644
index 0000000..7f7b455
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/BrainTrialWiringTest.kt
@@ -0,0 +1,120 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * How "Try her brain" is wired: her prompt in a try is built from the same pieces as her reply
+ * in the chat, it goes through the same gate with the settings she would have, and nothing on
+ * its way writes anything of hers or counts as a call of hers. The chat loop needs a phone to
+ * run, so these tests read its source and fail when a piece of it moves away from the try's.
+ */
+class BrainTrialWiringTest {
+
+    private fun source(path: String) = File("src/main/java/com/opendroid/ai/$path").readText()
+
+    private val loop = source("core/agent/AgentLoop.kt")
+    private val engine = source("core/persona/PersonaEngine.kt")
+    private val reply = loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+    private val trialRequest = engine.substringAfter("suspend fun trialRequest(").substringBefore("    /**\n     * True when no earlier talk")
+
+    @Test
+    fun `her prompt in a try is built from the same pieces as her reply to his talk in the chat`() {
+        // What is held back: the route of her replies, in both.
+        assertTrue(reply.contains("val holdsBack = if (personaOn) chatConfig.herRouteHoldsBack() else chatConfig.mainRouteHoldsBack()"))
+        assertTrue(source("core/agent/RouteHoldBack.kt").contains("internal fun LLMConfig.herRouteHoldsBack(): Boolean = holdsBackDetails(RouteClassifier.personaRoute(this))"))
+        assertTrue(trialRequest.contains("val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))"))
+        // The context about him, read for his message.
+        assertTrue(reply.contains("val relevantContext = memoryManager.getRelevantContext(userMsg.text, lean = holdsBack)"))
+        assertTrue(trialRequest.contains("val readForHim = memoryManager.getRelevantContext(his, lean = heldBack)"))
+        assertTrue(trialRequest.contains("relevantContext = readForHim,"))
+        // The rows, shaped the same way, and as many of them.
+        assertTrue(reply.contains("if (personaOn) PERSONA_HISTORY_MESSAGES else 10"))
+        assertTrue(loop.contains("private const val PERSONA_HISTORY_MESSAGES = ${BrainTrial.HISTORY_ROWS}"))
+        assertTrue(reply.contains("holdBackPrivateResults = holdsBack,"))
+        assertTrue(trialRequest.contains("PersonaPrompts.shapeHistory("))
+        assertTrue(trialRequest.contains("holdBackPrivateResults = heldBack,"))
+        assertTrue(trialRequest.contains("nowMillis = clock()"))
+        // Her prompt: the one builder, with the same pieces.
+        val herPrompt = reply.substringAfter("suspend fun herPrompt(").substringBefore("promptWithoutPicture = ")
+        assertTrue(herPrompt.contains("persona.chatSystemPrompt("))
+        assertTrue(herPrompt.contains("relevantContext = relevantContext,"))
+        assertTrue(herPrompt.contains("deviceActivity = shaped.deviceActivity +"))
+        assertTrue(herPrompt.contains("cues = persona.libraryCues(shaped.dialogue),"))
+        assertTrue(herPrompt.contains("lookFact(chatConfig)"))
+        assertTrue(trialRequest.contains("chatSystemPrompt("))
+        assertTrue(trialRequest.contains("deviceActivity = shaped.deviceActivity,"))
+        assertTrue(trialRequest.contains("cues = libraryCues(shaped.dialogue),"))
+        assertTrue(trialRequest.contains("lookLine = lookLine,"))
+        assertTrue(trialRequest.contains("screenshotAttached = false,"))
+        assertTrue(trialRequest.contains("trial = true"))
+        // What the chat adds for a talk turn with nothing more on it is nothing: no heard line, no sight line, no planner's note.
+        assertTrue(source("core/persona/PersonaPrompts.kt").contains("note?.trim()?.takeIf { it.isNotEmpty() }?.let {"))
+        // The line about looks is worded in one place for both.
+        val look = loop.substringAfter("private suspend fun lookFact(").substringBefore("private fun seenTurnMessages(")
+        assertTrue(look.contains("hisLooks.get().replyFact(config, makesPictures = persona.makesPictures(config))"))
+        assertTrue(source("ui/viewmodel/BrainTrialViewModel.kt").contains("hisLooks.get().replyFact(config, makesPictures = engine.makesPictures(config))"))
+        // The request: her reply's own sampling, room and format, marked as hers.
+        val request = loop.substringAfter("val chatRequest = LLMRequest(").substringBefore("provider.streamComplete(")
+        assertTrue(request.contains("temperature = if (personaOn) com.opendroid.ai.core.persona.PersonaEngine.CHAT_TEMPERATURE else 0.5f"))
+        assertTrue(request.contains("maxTokens = if (personaOn) com.opendroid.ai.core.persona.PersonaEngine.CHAT_MAX_TOKENS else 500"))
+        assertTrue(request.contains("responseFormat = ResponseFormat.TEXT"))
+        assertTrue(loop.contains("if (personaOn) persona.withChatModel(chatRequest, chatConfig) else chatRequest"))
+        val replyRequest = engine.substringAfter("internal fun replyRequest(").substringBefore("/** Her replies want more variety")
+        assertTrue(replyRequest.contains("temperature = CHAT_TEMPERATURE,"))
+        assertTrue(replyRequest.contains("maxTokens = CHAT_MAX_TOKENS,"))
+        assertTrue(replyRequest.contains("responseFormat = ResponseFormat.TEXT"))
+        assertTrue(trialRequest.contains("return withChatModel(replyRequest(systemPrompt, shaped.dialogue), config)"))
+    }
+
+    @Test
+    fun `a try goes through the same gate, judged with the settings she would have, and ties no key`() {
+        val viewModel = source("ui/viewmodel/BrainTrialViewModel.kt")
+        assertTrue(viewModel.contains("send = { config, request -> factory.providerFor(HerBrain.PROVIDER, config).complete(request) }"))
+        val factory = source("core/llm/LLMProviderFactory.kt")
+        val providerFor = factory.substringAfter("fun providerFor(name: String, config: LLMConfig): LLMProvider {").substringBefore("private fun rawProvider(")
+        assertTrue(providerFor.contains("configProvider = { config },"))
+        assertFalse(providerFor.contains("tieKey"))
+        assertFalse(providerFor.contains("updateConfig"))
+        // Each model is asked with the settings "Use this one" would leave.
+        val trial = source("core/persona/BrainTrial.kt")
+        assertTrue(trial.contains("val asIfHers = BrainChoice.withBrain(config, model)"))
+        assertTrue(trial.contains("val request = prompt(asIfHers, rows)"))
+        assertTrue(trial.contains("val response = send(asIfHers, request)"))
+        // The chat he is in is read, never made.
+        assertTrue(viewModel.contains("conversations.currentSessionId.first()?.let { conversations.getLastMessages(it, HISTORY_ROWS) }.orEmpty()"))
+        assertFalse(viewModel.contains("ensureCurrentSessionId"))
+    }
+
+    @Test
+    fun `nothing on a try's way writes anything of hers, uses up what she overheard, or counts as her own call`() {
+        val prompt = engine.substringAfter("suspend fun chatSystemPrompt(").substringBefore("suspend fun trialRequest(")
+        assertTrue(prompt.contains("(if (trial) ownLife.overheardNow(config) else ownLife.overheard(config))"))
+        assertEquals(1, Regex("""ownLife\.overheard\(config\)""").findAll(prompt).count())
+        val life = source("core/life/OwnLife.kt")
+        assertTrue(life.contains("if (config.personaOwnLife && config.personaOpenMic) heard?.peek() else null"))
+        val peek = source("core/life/ears/Overheard.kt").substringAfter("fun peek(): Taken? = synchronized(lock) {").substringBefore("/** How many lines")
+        for (write in listOf("lines.clear()", "since = ", "shown = ", "shownAt = ", "othersMillis = ", "anyoneMillis = ")) {
+            assertFalse(write, peek.contains(write))
+        }
+        val writes = listOf(
+            "insertMessage", "storeMessage", "deleteMessage", "withoutThoughts", "keepThought", "thoughts.keep", "saveOwnTime",
+            "updateMood", "recordReflection", "onReply(", "memory.apply", "HerLog", "herLog", "OwnCall", "counted(", "ownPictureFor",
+            "turnTaken", "ownLife.overheard(", "updateConfig", "ensureCurrentSessionId", "createSession"
+        )
+        val trial = source("core/persona/BrainTrial.kt")
+        val viewModel = source("ui/viewmodel/BrainTrialViewModel.kt")
+        // The screen's one write is "Use this one", his choice, through save.
+        val tryPath = viewModel.substringAfter("fun start() {").substringBefore("fun stop() {")
+        for (write in writes) {
+            assertFalse("trialRequest: $write", trialRequest.contains(write))
+            assertFalse("BrainTrial: $write", trial.contains(write))
+            assertFalse("the try in the screen: $write", tryPath.contains(write) || tryPath.contains("save {"))
+        }
+        assertEquals(1, Regex("""save \{""").findAll(viewModel).count())
+        assertTrue(viewModel.substringAfter("fun use(id: String) {").contains("save { BrainChoice.use(it, id) }"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/HerBrainTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/HerBrainTest.kt
new file mode 100644
index 0000000..64aa29b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/HerBrainTest.kt
@@ -0,0 +1,124 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.eyes.SightProbe
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The one tap that gives her her own eyes, and the one that moves her back: her replies go to
+ * the Private-tier model that sees, with the tier trusted and pictures on; the planner stays
+ * on the encrypted model; what she had is kept and comes back as it was.
+ */
+class HerBrainTest {
+
+    private val start = BuildDefaults.fresh().copy(
+        apiKeys = mapOf(BuildDefaults.PROVIDER to "his-venice-key"),
+        personaChatExtraBody = """{"reasoning_effort":"none"}"""
+    )
+
+    @Test
+    fun `the tap moves her replies to the model that sees, and the planner stays encrypted`() {
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.personaRoute(start))
+        assertFalse(PersonaEngine.imagesReachChatModel(start))
+        assertNull(HerBrain.whyNotMove(start))
+
+        val moved = HerBrain.move(start)
+        assertTrue(HerBrain.moved(moved))
+        assertEquals(VenicePrivateTier.SEEING_BRAIN, moved.personaChatModel)
+        assertEquals(BuildDefaults.PROVIDER, moved.personaChatProvider)
+        assertEquals(BuildDefaults.PROVIDER, moved.personaChatModelProvider)
+        assertTrue(moved.trustVenicePrivate)
+        assertTrue(moved.personaChatSeesImages)
+        // That model takes no sound, as Venice lists it.
+        assertFalse(moved.personaChatHearsAudio)
+        assertEquals(RoutePrivacy.PRIVATE_TIER, RouteClassifier.personaRoute(moved))
+        assertTrue(PersonaEngine.imagesReachChatModel(moved))
+        assertFalse(PersonaEngine.soundReachesChatModel(moved))
+        // The planner and the rest of the main provider are where they were.
+        assertEquals(start.activeProvider, moved.activeProvider)
+        assertEquals(start.selectedModels, moved.selectedModels)
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.mainRoute(moved))
+        // His options for her stay his.
+        assertEquals(start.personaChatExtraBody, moved.personaChatExtraBody)
+    }
+
+    @Test
+    fun `the tap back puts her brain where it was, and a second tap forward keeps the first record`() {
+        val moved = HerBrain.move(HerBrain.move(start))
+        val back = HerBrain.moveBack(moved)
+        assertEquals(start.personaChatProvider, back.personaChatProvider)
+        assertEquals(start.personaChatModel, back.personaChatModel)
+        assertEquals(start.personaChatModelProvider, back.personaChatModelProvider)
+        assertEquals(start.personaChatSeesImages, back.personaChatSeesImages)
+        assertEquals("", back.personaBrainBefore)
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.personaRoute(back))
+        // His trust is a switch of its own: going back leaves it as he set it.
+        assertTrue(back.trustVenicePrivate)
+        // Nothing kept, nothing changed.
+        assertEquals(start, HerBrain.moveBack(start))
+    }
+
+    @Test
+    fun `no tap without Venice to move to`() {
+        val elsewhere = start.copy(customEndpoints = mapOf(BuildDefaults.PROVIDER to "http://192.168.1.20:11434/v1"))
+        assertTrue(HerBrain.whyNotMove(elsewhere)!!.contains("is not pointed at https://api.venice.ai/api/v1"))
+        assertEquals(elsewhere, HerBrain.move(elsewhere))
+        val noKey = start.copy(apiKeys = emptyMap())
+        assertTrue(HerBrain.whyNotMove(noKey)!!.contains("Enter your Venice key first"))
+        assertEquals(noKey, HerBrain.move(noKey))
+    }
+
+    @Test
+    fun `a model that hears gets her voice switch, and a probe that found her blind takes her eyes`() {
+        val hearing = HerBrain.move(start).copy(personaChatModel = "xiaomi-mimo-v2-5", personaChatHearsAudio = true)
+        assertTrue(PersonaEngine.soundReachesChatModel(hearing))
+        assertTrue(PersonaEngine.imagesReachChatModel(hearing))
+        // Venice lists a model as blind: no picture goes to it, whatever the switch says.
+        val blind = hearing.copy(personaChatModel = "deepseek-v4-flash", trustVenicePrivate = true)
+        assertTrue(SightProbe.brainBlind(blind))
+        assertFalse(PersonaEngine.imagesReachChatModel(blind))
+        assertFalse(PersonaEngine.soundReachesChatModel(blind))
+        // The probe found the moved brain blind: the describer is used instead.
+        val moved = HerBrain.move(start)
+        val probed = SightProbe.withRecord(moved, SightProbe.Probe.BRAIN, SightProbe.Record(SightProbe.Result.NOT_SEEN, VenicePrivateTier.SEEING_BRAIN, 1L))
+        assertFalse(PersonaEngine.imagesReachChatModel(probed))
+        val seen = SightProbe.withRecord(moved, SightProbe.Probe.BRAIN, SightProbe.Record(SightProbe.Result.SEES, VenicePrivateTier.SEEING_BRAIN, 1L))
+        assertTrue(PersonaEngine.imagesReachChatModel(seen))
+        // A probe that could not be asked says nothing.
+        val failed = SightProbe.withRecord(moved, SightProbe.Probe.BRAIN, SightProbe.Record(SightProbe.Result.FAILED, VenicePrivateTier.SEEING_BRAIN, 1L))
+        assertTrue(PersonaEngine.imagesReachChatModel(failed))
+    }
+
+    @Test
+    fun `the card says where her brain is and what Venice can read`() {
+        assertTrue(HerBrain.routeLine(start).contains("end to end encrypted. That route carries text only"))
+        assertTrue(HerBrain.routeLine(HerBrain.move(start)).contains("Venice's Private tier, trusted for her: Venice reads what it is sent to answer it and keeps nothing."))
+        assertTrue(HerBrain.MOVE_LABEL.startsWith("Her own eyes: move her brain to deepseek-v4-1-flash-1017-uncensored"))
+        assertTrue(HerBrain.MOVE_NOTE.contains("not end to end encrypted"))
+        assertTrue(HerBrain.MOVE_NOTE.contains("One tap moves her back."))
+    }
+
+    @Test
+    fun `a request of hers carries no more pictures than her model takes`() {
+        val moved = HerBrain.move(start)
+        assertEquals(10, PersonaEngine.picturesHerModelTakes(moved))
+        assertEquals(1, PersonaEngine.picturesHerModelTakes(moved.copy(personaChatModel = "gemma-4-uncensored")))
+        // A model Venice does not list: no limit is known here.
+        assertEquals(Int.MAX_VALUE, PersonaEngine.picturesHerModelTakes(moved.copy(personaChatModel = "some-model-of-his")))
+    }
+
+    @Test
+    fun `the move needs his Venice key for Venice, not a key typed for another host`() {
+        val typedElsewhere = start.copy(apiKeyHosts = mapOf(BuildDefaults.PROVIDER to "openrouter.ai"))
+        assertTrue(HerBrain.whyNotMove(typedElsewhere)!!.contains("Enter your Venice key first"))
+        assertEquals(start, HerBrain.move(start.copy(apiKeys = emptyMap())).copy(apiKeys = start.apiKeys))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/HerRefsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/HerRefsTest.kt
new file mode 100644
index 0000000..435afea
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/HerRefsTest.kt
@@ -0,0 +1,193 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaPicture.Provenance
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * The list of her reference pictures that come with the app: what is read of it, what is put
+ * in on a start, and that this build carries none.
+ */
+class HerRefsTest {
+
+    private val a = "a".repeat(64)
+    private val b = "b".repeat(64)
+
+    private fun list(vararg entries: String) = """{"version": 1, "files": [${entries.joinToString(",")}]}"""
+
+    private fun entry(file: String, kind: String = "ORIGINAL", sha: String = a, view: String = "full body, front", note: String = "round 7 render") =
+        """{"file": "$file", "kind": "$kind", "view": "$view", "sha256": "$sha", "note": "$note"}"""
+
+    @Test
+    fun `an empty list, no list, or text that is no list puts nothing in`() {
+        assertTrue(HerRefs.parse(null).isEmpty())
+        assertTrue(HerRefs.parse("").isEmpty())
+        assertTrue(HerRefs.parse("""{"version": 1, "files": []}""").isEmpty())
+        assertTrue(HerRefs.parse("not json").isEmpty())
+        assertTrue(HerRefs.parse("""["full_front.png"]""").isEmpty())
+    }
+
+    @Test
+    fun `each entry is read with its kind, side, hash and note, and one that is not safe or not an original or master is skipped`() {
+        val read = HerRefs.parse(
+            list(
+                entry("full_front.png", "ORIGINAL", a, "full body, front", "Yume, round 7; 2026-11-19"),
+                entry("full_back.png", "master", b, "full body, back"),
+                entry("../card.md", sha = "c".repeat(64)),
+                entry("sub/full.png", sha = "d".repeat(64)),
+                entry("made.png", kind = "DERIVED", sha = "e".repeat(64)),
+                entry("no_hash.png", sha = "1234"),
+                entry("again.png", sha = a),
+                entry("notes.txt", sha = "f".repeat(64))
+            )
+        )
+        assertEquals(listOf("full_front.png", "full_back.png"), read.map { it.file })
+        assertEquals(listOf(Provenance.ORIGINAL, Provenance.MASTER), read.map { it.kind })
+        assertEquals("full body, back", read[1].view)
+        assertEquals("Yume, round 7; 2026-11-19", read[0].note)
+        assertEquals(a, read[0].sha256)
+    }
+
+    @Test
+    fun `the list as tools prepare_assets writes it is read whole`() {
+        // Written by opendroid/tools/prepare_assets.sh from opendroid/her_refs, where APPROVED stands beside the renders.
+        val written = """
+            {
+             "version": 1,
+             "files": [
+              {
+               "file": "face_side.png",
+               "kind": "ORIGINAL",
+               "view": "face close-up, side (her right: lip ring and right ear hoop side)",
+               "sha256": "2520311fbd3ed9ecbe776d13723800f29732870468b4f1f64ac9364bae3f5969",
+               "bytes": 962023,
+               "note": "Yume Kisaragi, adult woman (19), 3D model round 7, clothed in her round-7 outfit and accessories; 2026-11-19"
+              },
+              {
+               "file": "full_front.png",
+               "kind": "ORIGINAL",
+               "view": "full body, front",
+               "sha256": "2fc091b087a0db6ec47c8955dadcd1029e64abdd9331236e9fb5d6538d49260f",
+               "bytes": 617235,
+               "note": "Yume Kisaragi, adult woman (19), 3D model round 7, clothed in her round-7 outfit and accessories; 2026-11-19"
+              }
+             ]
+            }
+        """.trimIndent()
+        val read = HerRefs.parse(written)
+        assertEquals(listOf("face_side.png", "full_front.png"), read.map { it.file })
+        assertEquals("face close-up, side (her right: lip ring and right ear hoop side)", read[0].view)
+        assertTrue(read.all { it.kind == Provenance.ORIGINAL && it.note.endsWith("; 2026-11-19") })
+        // The front render is a side a sheet is made from; the face is not.
+        val pictures = read.mapIndexed { i, entry -> HerRefs.picture(entry, "p$i", "p$i.png", i.toLong()) }
+        assertEquals(listOf(null, ReferenceSheets.Side.FRONT), pictures.map { ReferenceSheets.sideOf(it) })
+    }
+
+    @Test
+    fun `a start puts in what the phone was never given, once, and nothing it holds already`() {
+        val entries = HerRefs.parse(list(entry("full_front.png", sha = a), entry("full_back.png", sha = b, view = "full body, back")))
+        val empty = PersonaPictureRules.Index()
+        assertEquals(listOf("full_front.png", "full_back.png"), HerRefs.seeding(empty, entries).add.map { it.file })
+
+        // After the first start both are remembered: the next start puts nothing in, even after he removed one.
+        val first = PersonaPictureRules.withSeeded(empty, listOf(HerRefs.picture(entries[0], "x", "x.png", 1L)), listOf(a, b))
+        assertTrue(HerRefs.seeding(first, entries).add.isEmpty())
+        assertTrue(HerRefs.seeding(PersonaPictureRules.withRemoved(first, "x"), entries).add.isEmpty())
+
+        // A picture he added himself with the same bytes is not put in twice; it is remembered as given.
+        val his = PersonaPicture(id = "his", file = "his.png", kind = PersonaPicture.Kind.SELF, asGiven = true, sha256 = a)
+        val seeding = HerRefs.seeding(PersonaPictureRules.Index(pictures = listOf(his)), entries)
+        assertEquals(listOf("full_back.png"), seeding.add.map { it.file })
+        assertEquals(listOf(a), seeding.known)
+    }
+
+    @Test
+    fun `a bundled picture comes in as it is named in the list, as given, and in room of its own`() {
+        val entry = HerRefs.parse(list(entry("face_front.png", "MASTER", a, "face close-up, front", "round 7"))).single()
+        val picture = HerRefs.picture(entry, "id1", "id1.png", 5L)
+        assertEquals(PersonaPicture.Origin.BUNDLED, picture.origin)
+        assertEquals(Provenance.MASTER, picture.provenance)
+        assertTrue(picture.asGiven)
+        assertEquals("reference picture: face close-up, front", picture.caption)
+        assertEquals(PersonaPicture.CaptionBy.APP, picture.captionBy)
+        assertEquals("round 7", picture.note)
+        assertTrue(PictureSources.mayBeSource(picture))
+        // Reference pictures never take his room or hers.
+        val his = (1..PersonaPictureRules.MAX_SELF).map { PersonaPicture(id = "h$it", file = "h$it.jpg", kind = PersonaPicture.Kind.SELF) }
+        val full = PersonaPictureRules.Index(pictures = his)
+        assertEquals(PersonaPictureRules.MAX_REFERENCES, PersonaPictureRules.referenceRoom(full))
+        val seeded = PersonaPictureRules.withSeeded(full, listOf(picture), listOf(a))
+        assertEquals(his.size + 1, PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(seeded)).pictures.size)
+        assertEquals(listOf(a), PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(seeded)).seeded)
+        // More than fit are not put in, and not remembered, so they can come in once there is room.
+        val refs = (1..PersonaPictureRules.MAX_REFERENCES).map { picture.copy(id = "r$it", file = "r$it.png", sha256 = "%064d".format(it)) }
+        val noRoom = PersonaPictureRules.Index(pictures = refs)
+        assertTrue(HerRefs.seeding(noRoom, HerRefs.parse(list(entry("x.png", sha = b)))).add.isEmpty())
+    }
+
+    @Test
+    fun `once a newer set has come, an earlier one the list no longer names is retired, and what he set himself stands`() {
+        val c = "c".repeat(64)
+        val d = "d".repeat(64)
+        val setA = HerRefs.parse(list(entry("full_front.png", sha = a), entry("full_back.png", "MASTER", b, "full body, back")))
+        val setB = HerRefs.parse(list(entry("full_front.png", sha = c), entry("full_back.png", sha = d, view = "full body, back")))
+        val first = PersonaPictureRules.withSeeded(
+            PersonaPictureRules.Index(), setA.mapIndexed { i, e -> HerRefs.picture(e, "a$i", "a$i.png", 1L + i) }, setA.map { it.sha256 }
+        )
+        // The same build again changes nothing.
+        assertEquals(first, HerRefs.retired(first, setA))
+        // He approves the older front himself; then a build brings set B.
+        val approved = PersonaPictureRules.withProvenance(first, "a0", Provenance.MASTER)!!
+        assertTrue(approved.pictures.first().provenanceByOwner)
+        val withB = PersonaPictureRules.withSeeded(approved, setB.mapIndexed { i, e -> HerRefs.picture(e, "b$i", "b$i.png", 10L + i) }, setB.map { it.sha256 })
+        val after = HerRefs.retired(withB, setB)
+        assertEquals(
+            listOf("a0 MASTER", "a1 DERIVED", "b0 ORIGINAL", "b1 ORIGINAL"),
+            after.pictures.map { "${it.id} ${it.provenance}" }
+        )
+        assertEquals(PictureSources.RETIRED_LINE, PictureSources.line(after.pictures[1]))
+        assertEquals("Master · approved by you", PictureSources.line(after.pictures[0]))
+        // The newer set is what is matched to; his approved one only after it.
+        assertEquals(listOf("b0", "a0"), PersonaSelfPictures.references(after.pictures).map { it.id })
+        // A build that lists A again gives its pictures the list's kind back, his own choice still standing.
+        val back = HerRefs.retired(after, setA)
+        assertEquals(listOf("a0 MASTER", "a1 MASTER", "b0 DERIVED", "b1 DERIVED"), back.pictures.map { "${it.id} ${it.provenance}" })
+    }
+
+    @Test
+    fun `a build that brings no set of its own retires nothing`() {
+        val setA = HerRefs.parse(list(entry("full_front.png", sha = a)))
+        val index = PersonaPictureRules.withSeeded(PersonaPictureRules.Index(), listOf(HerRefs.picture(setA.single(), "a0", "a0.png", 1L)), listOf(a))
+        // No list, an empty one, or one none of whose pictures came onto the phone (their bytes did not match, or there was no room).
+        assertEquals(index, HerRefs.retired(index, emptyList()))
+        assertEquals(index, HerRefs.retired(index, HerRefs.parse(list())))
+        assertEquals(index, HerRefs.retired(index, HerRefs.parse(list(entry("other.png", sha = b)))))
+        // A picture he added, one she made and a sheet are never touched by a list.
+        val others = index.copy(
+            pictures = index.pictures + listOf(
+                PersonaPicture(id = "his", file = "his.png", kind = PersonaPicture.Kind.SELF, sha256 = "e".repeat(64)),
+                PersonaPicture(id = "hers", file = "hers.jpg", kind = PersonaPicture.Kind.SELF, made = true),
+                PersonaPicture(id = "sheet", file = "s.png", kind = PersonaPicture.Kind.SELF, origin = PersonaPicture.Origin.SHEET, provenance = Provenance.MASTER, provenanceByOwner = true)
+            )
+        )
+        val retired = HerRefs.retired(others, HerRefs.parse(list(entry("his.png", sha = "e".repeat(64)))))
+        assertEquals(listOf("a0 DERIVED", "his ORIGINAL", "hers DERIVED", "sheet MASTER"), retired.pictures.map { "${it.id} ${it.provenance}" })
+        // Who set a provenance is kept across a restart.
+        assertTrue(PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(others)).pictures.last().provenanceByOwner)
+        assertFalse(PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(others)).pictures.first().provenanceByOwner)
+    }
+
+    @Test
+    fun `the app tree never commits bundled reference pictures, which come in at build time only where he approved them`() {
+        // This build carries none (the owner's decision): finished renders are added later, by tools/prepare_assets.sh.
+        assertTrue(File("../.gitignore").readText().contains("/app/src/main/assets/her_refs/"))
+        // Whatever list a build carries is read by the same rules, and every file it names is beside it.
+        val manifest = File("src/main/assets/her_refs/manifest.json")
+        if (manifest.isFile) {
+            for (entry in HerRefs.parse(manifest.readText())) assertTrue(entry.file, File(manifest.parentFile, entry.file).isFile)
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/HerWordsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/HerWordsTest.kt
