+    /**
+     * "your last time on his screen: <your go: words>, <ago>, <minutes> min in tiktok: ..." What she
+     * did there, in counts and the labels of what she opened (other people's words), how it ended,
+     * and that the screen went back to him.
+     */
+    internal fun lastPhoneLine(outing: LastOuting, nowMillis: Long, thoughtsLeftOut: Boolean): String = buildString {
+        append("your last time on his screen: ").append(quoted(outing.words)).append(", ").append(PersonaPrompts.age(nowMillis - outing.endedAt))
+        append(", ").append(outing.minutes).append(" min")
+        if (outing.app.isNotBlank()) append(" in ").append(outing.app.lowercase())
+        append(": ")
+        val counts = buildList {
+            add(if (outing.steps == 1) "1 step" else "${outing.steps} steps")
+            if (outing.scrolls > 0) add(if (outing.scrolls == 1) "1 scroll" else "${outing.scrolls} scrolls")
+            if (outing.opened > 0) {
+                val labels = outing.titles.joinToString(", ") { quoted(it) }
+                add((if (outing.opened == 1) "1 thing opened" else "${outing.opened} things opened") + if (labels.isEmpty()) "" else " ($labels)")
+            }
+            if (outing.searches > 0) add(if (outing.searches == 1) "1 search" else "${outing.searches} searches")
+            if (outing.watchedSeconds > 0) add("watched for ${outing.watchedSeconds} s")
+            if (outing.looked > 0) add(if (outing.looked == 1) "1 look at the screen" else "${outing.looked} looks at the screen")
+            if (outing.refused > 0) add(if (outing.refused == 1) "1 tap not made: it was his account's" else "${outing.refused} taps not made: they were his account's")
+            if (outing.said) add("you said something to him from it")
+        }
+        append(counts.joinToString(", "))
+        HerLog.EndedBy.entries.firstOrNull { it.name == outing.ended }?.let { append("; it ended: ").append(endedWords(it)) }
+        // Only what really happened to his screen: given back, left as he had it, after his call.
+        val back = com.opendroid.ai.core.life.phone.PhoneTime.GaveBack.How.entries.firstOrNull { it.name == outing.screenBack }
+            ?: com.opendroid.ai.core.life.phone.PhoneTime.GaveBack.How.GIVEN
+        append(". ").append(back.herWords).append(". ")
+        append(
+            if (thoughtsLeftOut) {
+                "what you thought on it is kept on the phone and not in this text. "
+            } else {
+                "what you thought on it is among your thoughts above. "
+            }
+        )
+        append("what you saw is gone, except what you noted.")
+    }
