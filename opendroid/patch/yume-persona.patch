diff --git a/app/src/main/java/com/opendroid/ai/accessibility/LentScreenHands.kt b/app/src/main/java/com/opendroid/ai/accessibility/LentScreenHands.kt
new file mode 100644
index 0000000..d820d1e
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/accessibility/LentScreenHands.kt
@@ -0,0 +1,346 @@
+package com.opendroid.ai.accessibility
+
+import android.accessibilityservice.AccessibilityService
+import android.accessibilityservice.GestureDescription
+import android.graphics.Bitmap
+import android.graphics.Path
+import android.graphics.Rect
+import android.os.Build
+import android.os.Bundle
+import android.view.accessibility.AccessibilityNodeInfo
+import android.view.accessibility.AccessibilityWindowInfo
+import com.opendroid.ai.core.life.phone.Box
+import com.opendroid.ai.core.life.phone.FrameCheck
+import com.opendroid.ai.core.life.phone.FrameRoute
+import com.opendroid.ai.core.life.phone.LookOnly
+import com.opendroid.ai.core.life.phone.HumanMotion
+import com.opendroid.ai.core.life.phone.PhoneTime
+import com.opendroid.ai.core.life.phone.Screen
+import com.opendroid.ai.core.life.phone.ScreenNode
+import com.opendroid.ai.core.life.phone.WindowSeen
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.suspendCancellableCoroutine
+import java.io.ByteArrayOutputStream
+import kotlin.coroutines.resume
+
+/**
+ * The code's hands on his screen while he lends it to her, on the accessibility service: reading
+ * the app's window as plain data ([read]), playing a touch of hers as a chain of continued strokes
+ * so that it speeds up and slows down as a finger does ([touch]), a picture of the app's window
+ * only ([frame]), and her search words into a search box ([search]). Thin: every decision about
+ * what is read, tapped or typed is made in `core/life/phone`, where it is tested.
+ */
+internal object LentScreenHands {
+
+    /** What is in front: the active app window's nodes, as [Screen], and every window. Null when nothing can be read. */
+    fun read(service: AccessibilityService, atMillis: Long): Screen? {
+        val metrics = service.resources.displayMetrics
+        val windows = windowsOf(service)
+        val root = try {
+            service.rootInActiveWindow
+        } catch (e: Exception) {
+            null
+        } ?: return null
+        return try {
+            val nodes = ArrayList<ScreenNode>()
+            collect(root, nodes, metrics.widthPixels, metrics.heightPixels)
+            Screen(
+                packageName = root.packageName?.toString().orEmpty(),
+                width = metrics.widthPixels,
+                height = metrics.heightPixels,
+                nodes = nodes,
+                windows = windows,
+                atMillis = atMillis,
+                density = metrics.density
+            )
+        } finally {
+            root.recycle()
+        }
+    }
+
+    /** The windows on the screen, top first, as plain data. */
+    fun windowsOf(service: AccessibilityService): List<WindowSeen> = try {
+        service.windows.map { window ->
+            val rect = Rect()
+            window.getBoundsInScreen(rect)
+            val root = window.root
+            val pkg = root?.packageName?.toString().orEmpty()
+            root?.recycle()
+            WindowSeen(
+                type = when (window.type) {
+                    AccessibilityWindowInfo.TYPE_APPLICATION -> WindowSeen.Type.APPLICATION
+                    AccessibilityWindowInfo.TYPE_INPUT_METHOD -> WindowSeen.Type.INPUT_METHOD
+                    AccessibilityWindowInfo.TYPE_SYSTEM -> WindowSeen.Type.SYSTEM
+                    AccessibilityWindowInfo.TYPE_ACCESSIBILITY_OVERLAY -> WindowSeen.Type.ACCESSIBILITY_OVERLAY
+                    AccessibilityWindowInfo.TYPE_SPLIT_SCREEN_DIVIDER -> WindowSeen.Type.SPLIT_SCREEN_DIVIDER
+                    else -> WindowSeen.Type.OTHER
+                },
+                packageName = pkg,
+                title = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) window.title?.toString().orEmpty() else "",
+                bounds = Box(rect.left, rect.top, rect.right, rect.bottom),
+                active = window.isActive,
+                focused = window.isFocused
+            )
+        }
+    } catch (e: Exception) {
+        emptyList()
+    }
+
+    /** The visible nodes of the tree under [node], depth first, at most [Screen.MAX_NODES]. */
+    private fun collect(node: AccessibilityNodeInfo, out: MutableList<ScreenNode>, width: Int, height: Int) {
+        if (out.size >= Screen.MAX_NODES) return
+        val rect = Rect()
+        node.getBoundsInScreen(rect)
+        val onScreen = node.isVisibleToUser && rect.right > 0 && rect.bottom > 0 && rect.left < width && rect.top < height
+        if (onScreen) {
+            val text = node.text?.toString().orEmpty()
+            val desc = node.contentDescription?.toString().orEmpty()
+            val hint = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) node.hintText?.toString().orEmpty() else ""
+            val worth = node.isClickable || node.isEditable || node.isScrollable || text.isNotBlank() || desc.isNotBlank()
+            if (worth) {
+                out += ScreenNode(
+                    text = text.take(MAX_TEXT),
+                    desc = desc.take(MAX_TEXT),
+                    hint = hint.take(MAX_TEXT),
+                    viewId = node.viewIdResourceName.orEmpty(),
+                    className = node.className?.toString().orEmpty(),
+                    bounds = Box(rect.left, rect.top, rect.right, rect.bottom),
+                    clickable = node.isClickable,
+                    editable = node.isEditable,
+                    password = node.isPassword,
+                    scrollable = node.isScrollable,
+                    selected = node.isSelected,
+                    // What a tap lands on: for a clickable that says nothing itself, and for every small one,
+                    // whose own words can be only a count ("12K") while a heart inside it says what it is.
+                    inside = if (node.isClickable && (text.isBlank() && desc.isBlank() || small(rect, width, height))) insideOf(node).take(MAX_TEXT) else ""
+                )
+            }
+        }
+        for (i in 0 until node.childCount) {
+            if (out.size >= Screen.MAX_NODES) return
+            val child = node.getChild(i) ?: continue
+            collect(child, out, width, height)
+            child.recycle()
+        }
+    }
+
+    /** A clickable this small is a button, read with what is inside it ([LookOnly.SMALL_SHARE]). */
+    private fun small(rect: Rect, width: Int, height: Int): Boolean =
+        width > 0 && height > 0 && rect.width().toLong() * rect.height() < LookOnly.SMALL_SHARE * width.toLong() * height
+
+    /** The words inside a clickable node, joined, each child's text and its description both: what a tap on it lands on. */
+    private fun insideOf(node: AccessibilityNodeInfo, depth: Int = 0): String {
+        if (depth > 3) return ""
+        val parts = ArrayList<String>()
+        for (i in 0 until node.childCount) {
+            val child = node.getChild(i) ?: continue
+            val said = listOfNotNull(
+                child.text?.toString()?.takeIf { it.isNotBlank() },
+                child.contentDescription?.toString()?.takeIf { it.isNotBlank() }
+            ).distinct()
+            if (said.isNotEmpty()) parts += said else insideOf(child, depth + 1).takeIf { it.isNotBlank() }?.let { parts += it }
+            child.recycle()
+            if (parts.size >= 6) break
+        }
+        return parts.joinToString("\n")
+    }
+
+    /**
+     * Plays [touch]: its first part as a stroke that will go on, each next part as its
+     * continuation, the last one lifting the finger. False when a part was cancelled (a touch of
+     * his cuts hers off) or could not be sent. A cancelled job lifts the finger where it is.
+     */
+    suspend fun touch(service: AccessibilityService, touch: HumanMotion.Touch): Boolean {
+        var stroke: GestureDescription.StrokeDescription? = null
+        var down = false
+        try {
+            for ((index, part) in touch.parts.withIndex()) {
+                val path = Path()
+                val first = part.points.first()
+                path.moveTo(first.x.coerceAtLeast(0f), first.y.coerceAtLeast(0f))
+                for (point in part.points.drop(1)) path.lineTo(point.x.coerceAtLeast(0f), point.y.coerceAtLeast(0f))
+                val goesOn = index < touch.parts.lastIndex
+                val duration = part.durationMillis.coerceAtLeast(1L)
+                stroke = stroke?.continueStroke(path, 0, duration, goesOn) ?: GestureDescription.StrokeDescription(path, 0, duration, goesOn)
+                down = goesOn
+                if (!dispatch(service, GestureDescription.Builder().addStroke(stroke).build())) {
+                    down = false
+                    return false
+                }
+            }
+            down = false
+            return true
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            return false
+        } finally {
+            // A finger left down by a stroke that was to go on is lifted where it is.
+            val last = stroke
+            if (down && last != null) {
+                try {
+                    val end = touch.parts.last().points.last()
+                    val lift = Path().apply { moveTo(end.x.coerceAtLeast(0f), end.y.coerceAtLeast(0f)) }
+                    service.dispatchGesture(GestureDescription.Builder().addStroke(last.continueStroke(lift, 0, 1, false)).build(), null, null)
+                } catch (e: Exception) {
+                    // The system cut the stroke off already: nothing is down.
+                }
+            }
+        }
+    }
+
+    private suspend fun dispatch(service: AccessibilityService, gesture: GestureDescription): Boolean =
+        suspendCancellableCoroutine { going ->
+            val sent = try {
+                service.dispatchGesture(
+                    gesture,
+                    object : AccessibilityService.GestureResultCallback() {
+                        override fun onCompleted(gestureDescription: GestureDescription?) {
+                            if (going.isActive) going.resume(true)
+                        }
+
+                        override fun onCancelled(gestureDescription: GestureDescription?) {
+                            if (going.isActive) going.resume(false)
+                        }
+                    },
+                    null
+                )
+            } catch (e: Exception) {
+                false
+            }
+            if (!sent && going.isActive) going.resume(false)
+        }
+
+    /** Her [words] into the search box at [field]'s place, then the keyboard's search key. */
+    fun search(service: AccessibilityService, field: ScreenNode, words: String): Boolean {
+        val root = service.rootInActiveWindow ?: return false
+        try {
+            val node = find(root, field) ?: return false
+            try {
+                if (!node.isEditable) return false
+                val arguments = Bundle().apply { putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, words) }
+                if (!node.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, arguments)) return false
+                return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                    node.performAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_IME_ENTER.id)
+                } else {
+                    true
+                }
+            } finally {
+                node.recycle()
+            }
+        } finally {
+            root.recycle()
+        }
+    }
+
+    /** The editable node at [field]'s place in the tree under [node], or null. */
+    private fun find(node: AccessibilityNodeInfo, field: ScreenNode): AccessibilityNodeInfo? {
+        val rect = Rect()
+        node.getBoundsInScreen(rect)
+        if (node.isEditable && rect.left == field.bounds.left && rect.top == field.bounds.top && rect.right == field.bounds.right && rect.bottom == field.bounds.bottom) {
+            return AccessibilityNodeInfo.obtain(node)
+        }
+        for (i in 0 until node.childCount) {
+            val child = node.getChild(i) ?: continue
+            val found = find(child, field)
+            child.recycle()
+            if (found != null) return found
+        }
+        return null
+    }
+
+    /**
+     * A picture of [packageName]'s window only (Android 14 and later), never of the whole display
+     * ([FrameRoute]): none on an older android, none when the window is not found alone, none
+     * while a system window other than the bars is over the app ([systemOver]). A protected window
+     * comes back as [PhoneTime.Frame.Hidden]: refused as secure, or black.
+     */
+    suspend fun frame(service: AccessibilityService, packageName: String, systemOver: Boolean): PhoneTime.Frame {
+        val windowId = if (Build.VERSION.SDK_INT >= FrameRoute.WINDOW_ALONE_SDK) {
+            try {
+                service.windows.firstOrNull { window ->
+                    window.type == AccessibilityWindowInfo.TYPE_APPLICATION && window.root?.let { root ->
+                        val pkg = root.packageName?.toString()
+                        root.recycle()
+                        pkg == packageName
+                    } == true
+                }?.id
+            } catch (e: Exception) {
+                null
+            }
+        } else {
+            null
+        }
+        val route = FrameRoute.of(Build.VERSION.SDK_INT, windowId, systemOver)
+        if (route is FrameRoute.Route.None) return PhoneTime.Frame.None(route.why)
+        val window = (route as FrameRoute.Route.Window).windowId
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return PhoneTime.Frame.None("this android cannot take a picture of the app's window alone")
+        return suspendCancellableCoroutine { going ->
+            val callback = object : AccessibilityService.TakeScreenshotCallback {
+                override fun onSuccess(screenshot: AccessibilityService.ScreenshotResult) {
+                    val buffer = screenshot.hardwareBuffer
+                    val result = try {
+                        val wrapped = Bitmap.wrapHardwareBuffer(buffer, screenshot.colorSpace)
+                        val bitmap = wrapped?.copy(Bitmap.Config.ARGB_8888, false)
+                        wrapped?.recycle()
+                        if (bitmap == null) {
+                            PhoneTime.Frame.None("the picture could not be read")
+                        } else {
+                            try {
+                                if (FrameCheck.hidden(luma(bitmap))) {
+                                    PhoneTime.Frame.Hidden
+                                } else {
+                                    val out = ByteArrayOutputStream()
+                                    bitmap.compress(Bitmap.CompressFormat.JPEG, JPEG_QUALITY, out)
+                                    PhoneTime.Frame.Taken(out.toByteArray())
+                                }
+                            } finally {
+                                bitmap.recycle()
+                            }
+                        }
+                    } catch (e: Exception) {
+                        PhoneTime.Frame.None("the picture could not be read")
+                    } finally {
+                        buffer.close()
+                    }
+                    if (going.isActive) going.resume(result)
+                }
+
+                override fun onFailure(errorCode: Int) {
+                    val result = if (errorCode == AccessibilityService.ERROR_TAKE_SCREENSHOT_SECURE_WINDOW) {
+                        PhoneTime.Frame.Hidden
+                    } else {
+                        PhoneTime.Frame.None("android did not give a picture of the app's window")
+                    }
+                    if (going.isActive) going.resume(result)
+                }
+            }
+            try {
+                service.takeScreenshotOfWindow(window, service.mainExecutor, callback)
+            } catch (e: Exception) {
+                if (going.isActive) going.resume(PhoneTime.Frame.None("android did not give a picture of the app's window"))
+            }
+        }
+    }
+
+    /** Brightness samples of [bitmap], on a grid of about 24 by 24. */
+    private fun luma(bitmap: Bitmap): IntArray {
+        val stepX = (bitmap.width / 24).coerceAtLeast(1)
+        val stepY = (bitmap.height / 24).coerceAtLeast(1)
+        val out = ArrayList<Int>()
+        var y = stepY / 2
+        while (y < bitmap.height) {
+            var x = stepX / 2
+            while (x < bitmap.width) {
+                val c = bitmap.getPixel(x, y)
+                out += ((c shr 16 and 0xff) * 299 + (c shr 8 and 0xff) * 587 + (c and 0xff) * 114) / 1000
+                x += stepX
+            }
+            y += stepY
+        }
+        return out.toIntArray()
+    }
+
+    private const val MAX_TEXT = 300
+    private const val JPEG_QUALITY = 80
+}
