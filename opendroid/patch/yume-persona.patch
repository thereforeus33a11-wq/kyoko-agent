+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.phone.LookOnly.Act
+import com.opendroid.ai.core.life.phone.LookOnly.Verdict
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The look-only guard of her time on his screen: she has no accounts of her own, these are his
+ * apps and his account, so every act on the account is refused before anything is tapped, and
+ * text goes only into a search box. Looking (posts, profiles, comments, tabs to look at, the
+ * search) is let through.
+ */
+class LookOnlyTest {
+
+    private val screen = Screen("com.zhiliaoapp.musically", 1080, 2520, emptyList())
+
+    /** A small button in the middle of the screen, the size of TikTok's right rail. */
+    private fun button(text: String = "", desc: String = "", id: String = "", box: Box = Box(940, 1300, 1060, 1420), inside: String = "", hint: String = "") =
+        ScreenNode(text = text, desc = desc, hint = hint, viewId = id, bounds = box, clickable = true, inside = inside)
+
+    @Test
+    fun `every act on his account is refused, in English and Japanese`() {
+        val table = listOf(
+            "Like" to Act.LIKE, "Like video. 12.3K likes" to Act.LIKE, "Liked" to Act.LIKE, "Unlike" to Act.LIKE,
+            "like this video along with 12,345 other people" to Act.LIKE, "Dislike this video" to Act.LIKE,
+            "いいね" to Act.LIKE, "いいね 1.2万" to Act.LIKE, "高く評価" to Act.LIKE, "❤ 1,204" to Act.LIKE,
+            "Follow" to Act.FOLLOW, "Following" to Act.FOLLOW, "Follow back" to Act.FOLLOW, "フォロー" to Act.FOLLOW, "フォローする" to Act.FOLLOW,
+            "Subscribe" to Act.SUBSCRIBE, "Subscribe to Gal Channel." to Act.SUBSCRIBE, "チャンネル登録" to Act.SUBSCRIBE, "Join" to Act.SUBSCRIBE,
+            "Remind me" to Act.SUBSCRIBE,
+            "Add a comment…" to Act.COMMENT, "Add comment..." to Act.COMMENT, "コメントを追加…" to Act.COMMENT, "コメントする" to Act.COMMENT,
+            "Reply" to Act.REPLY, "返信" to Act.REPLY, "リプライ" to Act.REPLY,
+            "Repost" to Act.POST, "Post" to Act.POST, "Quote" to Act.POST, "投稿" to Act.POST, "リポスト" to Act.POST,
+            "Messages" to Act.MESSAGE, "Send message" to Act.MESSAGE, "メッセージ" to Act.MESSAGE, "DM" to Act.MESSAGE,
+            "Share" to Act.SHARE, "Share video" to Act.SHARE, "Send post" to Act.SHARE, "Copy link" to Act.SHARE, "シェア" to Act.SHARE, "共有" to Act.SHARE,
+            "Save" to Act.SAVE, "Bookmark" to Act.SAVE, "Add to playlist" to Act.SAVE, "Watch later" to Act.SAVE, "保存" to Act.SAVE, "後で見る" to Act.SAVE,
+            "Buy now" to Act.BUY, "Add to cart" to Act.BUY, "購入" to Act.BUY, "カートに入れる" to Act.BUY,
+            "Send gift" to Act.GIFT, "Coins" to Act.GIFT, "Super Thanks" to Act.GIFT, "ギフト" to Act.GIFT, "投げ銭" to Act.GIFT,
+            "Download" to Act.DOWNLOAD, "ダウンロード" to Act.DOWNLOAD,
+            "Upvote" to Act.VOTE, "Downvote" to Act.VOTE, "投票" to Act.VOTE,
+            "Duet" to Act.CREATE, "Use this sound" to Act.CREATE, "+" to Act.CREATE, "撮影" to Act.CREATE,
+            "Settings" to Act.SETTINGS, "Edit profile" to Act.SETTINGS, "設定" to Act.SETTINGS, "ログアウト" to Act.SETTINGS,
+            "Not interested" to Act.ACCOUNT, "Report" to Act.ACCOUNT, "Block" to Act.ACCOUNT, "More options" to Act.ACCOUNT,
+            "興味なし" to Act.ACCOUNT, "通報" to Act.ACCOUNT,
+            "Log in" to Act.GATE, "Sign up" to Act.GATE, "Install" to Act.GATE, "ログイン" to Act.GATE, "許可" to Act.GATE
+        )
+        for ((label, act) in table) {
+            assertEquals(label, Verdict.Refused(act), LookOnly.tap(button(desc = label), screen))
+            // The same as the control's own text.
+            assertEquals(label, Verdict.Refused(act), LookOnly.tap(button(text = label), screen))
+        }
+    }
+
+    @Test
+    fun `looking is let through - profiles, comments, replies, posts and the search`() {
+        val allowed = listOf(
+            "nene_gal profile", "Go to nene_gal's profile", "@momo.0721",
+            "Read or add comments. 234 comments", "Comments", "Comment", "コメント", "コメント 56", "View all 12 comments", "View 3 replies",
+            "3件の返信を表示", "Search", "検索", "more", "Sound: original sound - nene_gal", "Play video", "Pause"
+        )
+        for (label in allowed) assertEquals(label, Verdict.Allowed, LookOnly.tap(button(desc = label), screen))
+    }
+
+    @Test
+    fun `a big card opens though a word of its title would act, and the same word on a button does not`() {
+        val card = Box(0, 300, 1080, 1500)
+        assertEquals(Verdict.Allowed, LookOnly.tap(button(text = "Like a boss: kabukicho compilation", box = card), screen))
+        assertEquals(Verdict.Allowed, LookOnly.tap(button(text = "follow me around shibuya 109", box = card), screen))
+        assertEquals(Verdict.Refused(Act.LIKE), LookOnly.tap(button(text = "Like a boss"), screen))
+        // The act word alone on a big card is still the act.
+        assertEquals(Verdict.Refused(Act.FOLLOW), LookOnly.tap(button(text = "Follow", box = card), screen))
+        // A long phrase that is plainly the act counts at any size.
+        assertEquals(Verdict.Refused(Act.LIKE), LookOnly.tap(button(desc = "like this video along with 300 other people", box = card), screen))
+    }
+
+    @Test
+    fun `view ids of the major apps are read, opening comments is looking`() {
+        val instagram = HisApps.INSTAGRAM
+        assertEquals(Verdict.Refused(Act.LIKE), LookOnly.tap(button(id = "com.instagram.android:id/row_feed_button_like"), screen, instagram))
+        assertEquals(Verdict.Refused(Act.SAVE), LookOnly.tap(button(id = "com.instagram.android:id/row_feed_button_save"), screen, instagram))
+        assertEquals(Verdict.Refused(Act.MESSAGE), LookOnly.tap(button(id = "com.instagram.android:id/action_bar_inbox_button"), screen, instagram))
+        assertEquals(Verdict.Refused(Act.CREATE), LookOnly.tap(button(id = "com.instagram.android:id/creation_tab"), screen, instagram))
+        assertEquals(Verdict.Allowed, LookOnly.tap(button(id = "com.instagram.android:id/row_feed_button_comment"), screen, instagram))
+        assertEquals(Verdict.Refused(Act.SUBSCRIBE), LookOnly.tap(button(id = "com.google.android.youtube:id/subscribe_button"), screen, HisApps.YOUTUBE))
+        assertEquals(Verdict.Refused(Act.LIKE), LookOnly.tap(button(id = "com.google.android.youtube:id/like_button"), screen, HisApps.YOUTUBE))
