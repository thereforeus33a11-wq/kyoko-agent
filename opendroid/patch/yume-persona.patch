+
+/**
+ * "Make her reference sheets" as he uses it: what a tap would make and its price, nothing sent
+ * without an original or a master or where no picture may be made, each sheet age-checked and
+ * kept as derived, and his approval making one a master.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class ReferenceSheetsViewModelTest {
+
+    private val venice = "Custom OpenAI Compatible"
+    private val settings = AtomicReference(
+        LLMConfig(
+            customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+            apiKeys = mapOf(venice to "his-venice-key"),
+            personaMakesPictures = true
+        )
+    )
+    private val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+    private val marked = CopyOnWriteArrayList<Pair<String, Provenance>>()
+    private val pictures = AtomicReference<List<PersonaPicture>>(emptyList())
+    private val room = AtomicReference(24)
+
+    private fun picture(id: String, view: String, provenance: Provenance = Provenance.ORIGINAL, origin: Origin = Origin.BUNDLED) =
+        PersonaPicture(id = id, file = "$id.png", kind = PersonaPicture.Kind.SELF, caption = "reference picture: $view", origin = origin, provenance = provenance, view = view)
+
+    private val renders = listOf(
+        picture("front", "full body, front"),
+        picture("back", "full body, back"),
+        picture("right", "full body, her right side (camera on her right)"),
+        picture("face", "face close-up, front")
+    )
+
+    private fun png(mark: Int) = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), mark.toByte())
+
+    private fun viewModel() = ReferenceSheetsViewModel(
+        settings = { settings.get() },
+        pictures = { pictures.get() },
+        room = { room.get() },
+        runOf = { _ ->
+            var n = 0
+            ReferenceSheetRun(
+                maker = SelfPictureMaker(
+                    send = { call -> sent += call; VeniceImages.Made.Picture(png(++n)) },
+                    // The third sheet reads as a child.
+                    check = { image, _ ->
+                        val answer = if (image[4] == 3.toByte()) "ages: child" else "ages: adult"
+                        MadePictureCheck.judge(HerEyes.Seen.Described("", KidGuard.ages(answer), seer = KidGuard.AGE_CHECK))
+                    },
+                    counts = object : SelfPictureMaker.Counts {
+                        override fun kept() = Unit
+                        override fun notKept(category: String) = Unit
+                    }
+                ),
+                source = { id -> pictures.get().firstOrNull { it.id == id }?.let { SourceImage.of(it, "B64-$id") } },
+                keep = { _, caption, view, look ->
+                    PersonaPictures.Added.Stored(
+                        PersonaPicture(
+                            id = "sheet-${look.name}-$view", file = "s.png", kind = PersonaPicture.Kind.SELF, caption = caption,
+                            origin = Origin.SHEET, provenance = Provenance.DERIVED, view = view, sheetLook = look.name
+                        )
+                    )
+                }
+            )
+        },
+        setProvenance = { id, to -> marked += id to to; true },
+        remove = { _ -> },
+        thumbnailOf = { null }
+    )
+
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Test
+    fun `without an original or a master nothing is made or sent, and he is told so`() {
+        pictures.set(listOf(picture("made", "full body, front", Provenance.DERIVED, Origin.HER).copy(made = true)))
+        val model = viewModel()
+        await("the plan") { model.planned != null }
+        assertTrue(model.planned is ReferenceSheets.Planned.Nothing)
+        model.start()
+        await("the tap to end") { !model.running && model.status.isNotEmpty() }
+        assertEquals(ReferenceSheets.NO_BASES_WHY, model.status)
+        assertTrue(sent.isEmpty())
+        assertTrue(model.rows.isEmpty())
+    }
+
+    @Test
+    fun `nothing is sent where no picture may be made, or where the sheets would not fit`() {
+        pictures.set(renders)
+        settings.set(settings.get().copy(personaMakesPictures = false))
+        val model = viewModel()
+        model.start()
+        await("the tap to end") { !model.running && model.status.isNotEmpty() }
+        assertEquals("Making pictures of her is switched off in Settings, Persona.", model.status)
+        settings.set(settings.get().copy(personaMakesPictures = true))
+        room.set(5)
+        model.start()
+        await("the tap to end") { !model.running && model.status.startsWith("Nothing made") }
+        assertEquals(ReferenceSheets.noRoom(5, 6), model.status)
+        assertTrue(sent.isEmpty())
+    }
+
+    @Test
+    fun `a tap makes each sheet from her originals, keeps the ones the age check passes as derived, and his approval makes one a master`() {
+        pictures.set(renders)
+        val model = viewModel()
+        await("the plan") { model.planned is ReferenceSheets.Planned.Sheets }
+        assertEquals(0.24, model.cost(), 1e-9)
+        assertTrue(model.fromLine().startsWith("From: full body, front (original); full body, back (original);"))
+
+        model.start()
+        await("the sheets") { !model.running && model.status.startsWith("Done") }
+        assertEquals(6, sent.size)
+        assertEquals(6, model.rows.size)
+        assertEquals(5, model.rows.count { it.pictureId != null })
+        // The third was read as a child: not kept, said in its place.
+        assertTrue(model.rows[2].why.startsWith("Not kept: the picture came out wrong: the age check read the woman drawn as a child"))
+        assertEquals("Done: 5 of 6 kept, each derived until you approve it.", model.status)
+        assertTrue(model.rows.none { it.approved })
+
+        val first = model.rows[0].pictureId!!
+        model.approve(first)
+        await("the approval") { model.rows[0].approved }
+        assertEquals(listOf(first to Provenance.MASTER), marked.toList())
+        assertEquals(ReferenceSheetsViewModel.APPROVED_LINE, model.status)
+        model.takeBack(first)
+        await("the approval taken back") { !model.rows[0].approved }
+        assertEquals(first to Provenance.DERIVED, marked.last())
+    }
+
+    @Test
+    fun `what the screens say is what the code does`() {
+        assertTrue(REFERENCE_SHEETS_HINT.contains("front, back and side, each in a plain fitted base layer and in her outfit"))
+        assertTrue(REFERENCE_SHEETS_HINT.contains("never from a picture a model made"))
+        assertTrue(REFERENCE_SHEETS_HINT.contains("Every sheet goes through the age check before it is shown or kept"))
+        assertTrue(REFERENCE_SHEETS_HINT.contains("never a base for another picture until you approve it: then it is a master"))
+        assertTrue(MAKE_REFERENCE_SHEETS_HINT.contains("derived until you approve each"))
+        val source = File("src/main/java/com/opendroid/ai/core/persona/ReferenceSheets.kt").readText()
+        assertTrue(source.contains("val made = maker.make(plan, sheet.caption, counted = false, keep = { bytes, caption -> keep(bytes, caption, sheet.view, sheet.look) })"))
+        val store = File("src/main/java/com/opendroid/ai/core/persona/PersonaPictures.kt").readText()
+        assertTrue(store.contains("provenance = PersonaPicture.Provenance.DERIVED,\n                asGiven = true,"))
+        assertTrue(ReferenceSheets.Look.entries.map { it.word } == listOf("plain fitted base layer", "her outfit"))
+        assertTrue(ReferenceSheets.Side.entries.map { it.word } == listOf("front", "back", "side"))
+        // The sheets read their pictures to work from as sources, and nowhere else.
+        val sheetModel = File("src/main/java/com/opendroid/ai/ui/viewmodel/ReferenceSheetsViewModel.kt").readText()
+        assertTrue(sheetModel.contains("source = { id -> pictures.source(id) },"))
+        assertTrue(sheetModel.contains("keep = { bytes, caption, view, look -> pictures.addSheet(bytes, caption, view, look) }"))
+    }
+
+    @Test
+    fun `where her pictures are listed each shows what it is, the one change he can make, and the rule once`() {
+        val screen = File("src/main/java/com/opendroid/ai/ui/screens/PersonaPicturesScreen.kt").readText()
+        assertTrue(screen.contains("text = picture.provenance,"))
+        assertTrue(screen.contains("onClick = { viewModel.setProvenance(picture.id, choice.to) },"))
+        assertTrue(screen.contains("Note(viewModel.sourcesNote)"))
+        val model = File("src/main/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModel.kt").readText()
+        assertTrue(model.contains("provenance = if (picture.kind == PersonaPicture.Kind.SELF) PictureSources.line(picture) else \"\","))
+        assertTrue(model.contains("choice = PictureSources.choice(picture),"))
+        assertTrue(model.contains("status = if (pictures.setProvenance(id, to)) {"))
+    }
+}
