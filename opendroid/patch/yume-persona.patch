+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaPictureRulesTest.kt
@@ -0,0 +1,558 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.persona.PersonaPicture.CaptionBy
+import com.opendroid.ai.core.persona.PersonaPicture.Kind
+import com.opendroid.ai.core.persona.PersonaPictureRules.Index
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The rules about her pictures that need no phone: what the index file holds and
+ * survives, the limits, how large a stored picture is, when she is shown herself and
+ * which picture it is.
+ */
+class PersonaPictureRulesTest {
+
+    private fun self(id: String, caption: String = "", by: CaptionBy = CaptionBy.OWNER) =
+        PersonaPicture(id = id, file = "$id.jpg", kind = Kind.SELF, caption = caption, captionBy = by, addedAt = 7)
+
+    private fun background(id: String, caption: String = "") =
+        PersonaPicture(id = id, file = "$id.jpg", kind = Kind.BACKGROUND, caption = caption, addedAt = 9)
+
+    private var nextId = 0
+    private fun he(text: String, image: String? = null) =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.USER, imageBase64 = image)
+    private fun she(text: String, badge: String = PersonaPrompts.BADGE) =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, modelBadge = badge)
+    private fun app(text: String, badge: String = "System") =
+        ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, modelBadge = badge)
+
+    private fun shown(
+        pictures: List<PersonaPicture>,
+        hisMessage: String,
+        firstReply: Boolean,
+        imageAttached: Boolean = false,
+        turn: Int = 0
+    ) = PersonaPictureRules.pictureFor(pictures, hisMessage, firstReply, imageAttached, turn)
+
+    // ── The index file ───────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the index comes back as it was written`() {
+        val index = Index(
+            turn = 5,
+            pictures = listOf(
+                self("a", "red hair down, tongue out", CaptionBy.HER),
+                self("b"),
+                background("c", "the page")
+            )
+        )
+        assertEquals(index, PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(index)))
+    }
+
+    @Test
+    fun `text that is not an index gives an empty one and never throws`() {
+        for (broken in listOf("", "   ", "not json", "{", "[]", "null", "42", "{\"pictures\": 3}", "{\"turn\": \"x\"}")) {
+            assertEquals(broken, Index(), PersonaPictureRules.parseIndex(broken))
+        }
+    }
+
+    @Test
+    fun `an entry that cannot be read is skipped and the others are kept`() {
+        val text = """
+            {"turn": 2, "extra": true, "pictures": [
+              {"id": "a", "file": "a.jpg", "kind": "SELF", "caption": "one", "captionBy": "HER", "addedAt": 1},
+              {"id": "b", "file": "b.jpg", "kind": "PORTRAIT"},
+              "just a string",
+              {"id": "c", "kind": "SELF"},
+              {"id": "", "file": "d.jpg", "kind": "SELF"},
+              {"id": "a", "file": "again.jpg", "kind": "SELF"},
+              {"id": "e", "file": "e.jpg", "kind": "BACKGROUND", "unknown": 1}
+            ]}
+        """.trimIndent()
+
+        val index = PersonaPictureRules.parseIndex(text)
+
+        assertEquals(2, index.turn)
+        assertEquals(listOf("a", "e"), index.pictures.map { it.id })
+        assertEquals(CaptionBy.HER, index.pictures[0].captionBy)
+        assertEquals(Kind.BACKGROUND, index.pictures[1].kind)
+    }
+
+    @Test
+    fun `an entry that names a file outside the picture folder is not followed`() {
+        for (name in listOf("../card.md", "/data/data/x/databases/app.db", "a/b.jpg", "a.png", ".jpg", "a b.jpg", "..jpg")) {
+            val text = """{"pictures": [{"id": "x", "file": ${quoted(name)}, "kind": "SELF"}]}"""
+            assertEquals(name, emptyList<PersonaPicture>(), PersonaPictureRules.parseIndex(text).pictures)
+            assertFalse(name, PersonaPictureRules.isPictureFileName(name))
+        }
+        assertTrue(PersonaPictureRules.isPictureFileName("0b1c2d3e-aaaa-bbbb-cccc-0123456789ab.jpg"))
+    }
+
+    private fun quoted(text: String) = "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
+
+    @Test
+    fun `an index that holds too much is cut back to what the store may hold`() {
+        val many = (1..15).map { self("s$it") } + background("old") + background("new")
+        val index = PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(Index(pictures = many)))
+
+        assertEquals((1..12).map { "s$it" }, index.pictures.filter { it.kind == Kind.SELF }.map { it.id })
+        assertEquals(listOf("new"), index.pictures.filter { it.kind == Kind.BACKGROUND }.map { it.id })
+    }
+
+    @Test
+    fun `a turn count below zero is read as zero`() {
+        assertEquals(0, PersonaPictureRules.parseIndex("""{"turn": -4, "pictures": []}""").turn)
+    }
+
+    // ── Limits ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `she can have twelve pictures of herself and the thirteenth is refused`() {
+        var index = Index()
+        repeat(PersonaPictureRules.MAX_SELF) { index = PersonaPictureRules.withAdded(index, self("s$it"))!! }
+        assertEquals(12, index.pictures.size)
+        assertFalse(PersonaPictureRules.hasRoomFor(index, Kind.SELF))
+        assertNull(PersonaPictureRules.withAdded(index, self("one-too-many")))
+        // A full shelf of her own pictures still takes the background picture.
+        assertTrue(PersonaPictureRules.hasRoomFor(index, Kind.BACKGROUND))
+        assertEquals(13, PersonaPictureRules.withAdded(index, background("b"))!!.pictures.size)
+    }
+
+    @Test
+    fun `there is one background picture and a new one takes its place`() {
+        val first = PersonaPictureRules.withAdded(Index(pictures = listOf(self("s"))), background("first"))!!
+        val second = PersonaPictureRules.withAdded(first, background("second"))!!
+
+        assertEquals(listOf("s", "second"), second.pictures.map { it.id })
+        assertEquals(1, second.pictures.count { it.kind == Kind.BACKGROUND })
+    }
+
+    @Test
+    fun `removing and captioning touch only the picture that is named`() {
+        val index = Index(turn = 3, pictures = listOf(self("a", "old"), self("b", "stays"), background("c")))
+
+        val captioned = PersonaPictureRules.withCaption(index, "a", "  gold hoops,\n\n  tan  ", CaptionBy.HER)
+        assertEquals("gold hoops,\ntan", captioned.pictures[0].caption)
+        assertEquals(CaptionBy.HER, captioned.pictures[0].captionBy)
+        assertEquals(index.pictures[1], captioned.pictures[1])
+        assertEquals(index.pictures[2], captioned.pictures[2])
+
+        // The same words once more, with white space he added, are no change: they stay hers.
+        assertEquals(captioned, PersonaPictureRules.withCaption(captioned, "a", "gold hoops,\ntan \n\n", CaptionBy.OWNER))
+        assertEquals(CaptionBy.HER, PersonaPictureRules.withCaption(captioned, "a", " gold hoops,\n tan", CaptionBy.OWNER).pictures[0].captionBy)
+        // Other words are his.
+        val retyped = PersonaPictureRules.withCaption(captioned, "a", "gold hoops, tan", CaptionBy.OWNER)
+        assertEquals("gold hoops, tan", retyped.pictures[0].caption)
+        assertEquals(CaptionBy.OWNER, retyped.pictures[0].captionBy)
+
+        val removed = PersonaPictureRules.withRemoved(index, "b")
+        assertEquals(listOf("a", "c"), removed.pictures.map { it.id })
+        assertEquals(3, removed.turn)
+        assertEquals(index, PersonaPictureRules.withRemoved(index, "not there"))
+    }
+
+    @Test
+    fun `a caption is at most three hundred characters and ends on a whole word`() {
+        assertEquals("short one", PersonaPictureRules.fitCaption("  short one \n"))
+        assertEquals("", PersonaPictureRules.fitCaption(" \n \n"))
+
+        val long = (1..80).joinToString(" ") { "word$it" }
+        val fitted = PersonaPictureRules.fitCaption(long)
+        assertTrue(fitted.length <= PersonaPictureRules.MAX_CAPTION_CHARS)
+        assertTrue(long.startsWith(fitted))
+        // The cut fell between two words: what follows it in the original is a space.
+        assertEquals(' ', long[fitted.length])
+
+        // One unbroken run has no word to end on and is cut at the limit.
+        assertEquals(300, PersonaPictureRules.fitCaption("x".repeat(400)).length)
+        // Exactly at the limit nothing is cut.
+        assertEquals(300, PersonaPictureRules.fitCaption("y".repeat(300)).length)
+    }
+
+    // ── Size ─────────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a stored picture is at most 1024 on its longer side and keeps its shape`() {
+        val cases = listOf(
+            Triple(4000, 3000, 1024 to 768),
+            Triple(3000, 4000, 768 to 1024),
+            Triple(1024, 1024, 1024 to 1024),
+            Triple(1025, 500, 1024 to 500),
+            Triple(800, 600, 800 to 600),
+            Triple(5000, 5, 1024 to 1),
+            Triple(1, 9000, 1 to 1024),
+            Triple(0, 0, 0 to 0)
+        )
+        for ((width, height, expected) in cases) {
+            assertEquals("$width x $height", expected, PersonaPictureRules.scaledSize(width, height))
+        }
+    }
+
+    @Test
+    fun `a large picture is decoded smaller, but never below the stored size`() {
+        val cases = listOf(
+            (800 to 600) to 1,
+            (1024 to 768) to 1,
+            (2047 to 1000) to 1,
+            (2048 to 1536) to 2,
+            (4000 to 3000) to 2,
+            (4096 to 4096) to 4,
+            (12000 to 9000) to 8
