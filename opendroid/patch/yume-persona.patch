+++ b/app/src/test/java/com/opendroid/ai/actions/InformationActionsTruthTest.kt
@@ -0,0 +1,79 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import android.content.ContextWrapper
+import android.content.Intent
+import android.os.Bundle
+import androidx.test.core.app.ApplicationProvider
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The actions that only open a page or a search on his screen say so, and claim nothing
+ * they never read: "Here's what I found" came back after a browser had merely been
+ * opened, and a line of hers about the result could then speak of results.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class InformationActionsTruthTest {
+
+    private class Opened(base: Context) : ContextWrapper(base) {
+        val started = mutableListOf<Intent>()
+        override fun startActivity(intent: Intent) {
+            started += intent
+        }
+
+        override fun startActivity(intent: Intent, options: Bundle?) {
+            started += intent
+        }
+    }
+
+    private val context = Opened(ApplicationProvider.getApplicationContext())
+
+    private fun run(name: String, params: Map<String, String>): String {
+        val action = InformationActions().getActions().first { it.name == name }
+        val result = runBlocking { action.execute(params, context) }
+        assertTrue(result.toString(), result.success)
+        return result.data.toString()
+    }
+
+    @Test
+    fun `an action that only opens a search says it opened one and that nothing was read`() {
+        val said = mapOf(
+            "WEB_SEARCH" to run("WEB_SEARCH", mapOf("query" to "egg magazine")),
+            "GET_NEWS" to run("GET_NEWS", mapOf("topic" to "shibuya")),
+            "DEFINE_WORD" to run("DEFINE_WORD", mapOf("word" to "gyaru")),
+            "CHECK_STOCK" to run("CHECK_STOCK", mapOf("symbol" to "SONY")),
+            "CONVERT_UNITS" to run("CONVERT_UNITS", mapOf("value" to "5", "from" to "km", "to" to "mi")),
+            "CURRENCY_CONVERT" to run("CURRENCY_CONVERT", mapOf("amount" to "5", "from" to "USD", "to" to "JPY")),
+            "TRANSLATE" to run("TRANSLATE", mapOf("text" to "hello")),
+            "SUMMARIZE_URL" to run("SUMMARIZE_URL", mapOf("url" to "https://example.com/a")),
+            "FACT_CHECK" to run("FACT_CHECK", mapOf("claim" to "the moon is cheese"))
+        )
+        assertEquals("Opened a web search for 'egg magazine' on your screen; nothing was read.", said["WEB_SEARCH"])
+        assertEquals("Opened a news search for 'shibuya' on your screen; nothing was read.", said["GET_NEWS"])
+        assertEquals("Opened that page on your screen; nothing was read or summarized.", said["SUMMARIZE_URL"])
+        assertEquals("Opened a search about that claim on your screen; nothing was read or checked.", said["FACT_CHECK"])
+        said.forEach { (name, line) ->
+            assertTrue(name, line.startsWith("Opened "))
+            assertTrue(name, line.contains("on your screen; nothing was read"))
+            for (claim in listOf("Here's", "found", "for you!", "Let me")) assertFalse("$name: $line", line.contains(claim))
+        }
+        // Each of them did open something on his screen, which is all it says it did.
+        assertEquals(said.size, context.started.size)
+    }
+
+    @Test
+    fun `no information action is left that claims what it never read`() {
+        val source = java.io.File("src/main/java/com/opendroid/ai/actions/InformationActions.kt").readText()
+        for (claim in listOf("Here's what I found", "Here's the latest", "Here's the definition", "Here's the stock info", "Let me check that for you", "Here's the weather for")) {
+            assertFalse(claim, source.contains(claim))
+        }
+    }
+}
