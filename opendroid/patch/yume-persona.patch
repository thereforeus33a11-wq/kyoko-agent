+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.persona.BrainChoice
+import com.opendroid.ai.core.persona.BrainModels
+import com.opendroid.ai.core.persona.BrainTrial
+import com.opendroid.ai.core.persona.HerBrain
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/** What "Try her brain" says, held against what the code does. */
+class BrainWordingTest {
+
+    private fun source(path: String) = File("src/main/java/com/opendroid/ai/$path").readText()
+
+    @Test
+    fun `the screen says what a try sends, where, and that it leaves nothing behind`() {
+        val hint = BRAIN_TRIAL_HINT
+        assertTrue(hint.contains("built the way her reply in the chat is"))
+        assertTrue(source("core/persona/PersonaEngine.kt").contains("suspend fun trialRequest(config: LLMConfig, rows: List<ChatMessage>, lookLine: String?): LLMRequest {"))
+        assertTrue(hint.contains("all at once"))
+        assertTrue(source("core/persona/BrainTrial.kt").contains("launch { onEach(one(config, model, rows)) }"))
+        assertTrue(hint.contains("an e2ee model end to end encrypted, a Private-tier model to Venice readable to answer and nothing kept, only while you trust that tier for her"))
+        assertTrue(hint.contains("nothing is written to the chat, her notebook, her thoughts, her mood, her log, her memory or her sleep pass"))
+        assertTrue(hint.contains("what she overheard is not used up"))
+        assertTrue(hint.contains("none of it is counted as a call of hers"))
+        assertTrue(hint.contains("No picture goes with a try"))
+        assertTrue(source("core/persona/PersonaEngine.kt").contains("rows.map { it.copy(imageBase64 = null, moreImagesBase64 = emptyList(), audioBase64 = null) }"))
+        assertTrue(BRAIN_TRIAL_MESSAGE_HINT.contains("It is not stored."))
+        assertTrue(BRAIN_TRIAL_LAST_HINT.contains("without her reply to it"))
+        assertTrue(source("core/persona/BrainTrial.kt").contains("Rows.Ready(recent.subList(0, last + 1).toList())"))
+        assertTrue(BRAIN_TRIAL_CHOOSE_HINT.startsWith("Tick ${BrainModels.MIN_PER_TRY} to ${BrainModels.MAX_PER_TRY}."))
+        assertEquals("Trust Venice's Private tier for her", BrainChoice.TRUST_SWITCH)
+        assertEquals(SensesWording.TRUST_TITLE, BrainChoice.TRUST_SWITCH)
+    }
+
+    @Test
+    fun `use this one says what it sets, and the way back is named as it is on the senses card`() {
+        assertTrue(BRAIN_TRIAL_USE_HINT.contains("her replies, her notebook and her own time go to that model"))
+        assertTrue(BRAIN_TRIAL_USE_HINT.contains("answer without thinking first where Venice lets that be said"))
+        assertTrue(BRAIN_TRIAL_USE_HINT.contains("pictures meant for her go to it directly, after the age check"))
+        assertTrue(BRAIN_TRIAL_USE_HINT.contains("\"${HerBrain.BACK_LABEL}\" in Her own senses"))
+        val choice = source("core/persona/BrainTrial.kt")
+        assertTrue(choice.contains("personaChatExtraBody = BrainModels.replyOptions(id),"))
+        assertTrue(choice.contains("personaChatSeesImages = senses.sees,"))
+        // The planner stays where it is: nothing of the main provider is touched.
+        val withBrain = choice.substringAfter("fun withBrain(config: LLMConfig, model: String): LLMConfig {").substringBefore("    /**")
+        assertFalse(withBrain.contains("activeProvider") || withBrain.contains("selectedModels") || withBrain.contains("trustVenicePrivate") || withBrain.contains("routePolicy"))
+        assertTrue(BrainTrial.NO_EXCHANGE.contains("Type one here instead"))
+    }
+
+    @Test
+    fun `the settings card offers the try, and the route leads to it`() {
+        assertTrue(TRY_BRAIN_HINT.contains("two to four models side by side"))
+        assertTrue(TRY_BRAIN_HINT.contains("Nothing of it is kept"))
+        val card = source("ui/screens/PersonaSettingsCards.kt")
+        assertTrue(card.contains("CardEditorRow(title = TRY_BRAIN_TITLE, description = TRY_BRAIN_HINT, action = \"TRY\", onEditCard = onTryBrain)"))
+        val navigation = source("ui/Navigation.kt")
+        assertTrue(navigation.contains("composable(OpenDroidRoutes.BRAIN_TRIAL)"))
+        assertTrue(navigation.contains("navController.navigate(OpenDroidRoutes.BRAIN_TRIAL)"))
+        // "Make her reference sheets" follows it on the same call (added with the sheets).
+        assertTrue(source("ui/screens/SettingsScreen.kt").contains("onNavigateToPictureModels, onTryBrain = onNavigateToBrainTrial, onMakeReferenceSheets = onNavigateToReferenceSheets) }"))
+        // His tap only: nothing else in the app starts a try.
+        val starts = File("src/main/java/com/opendroid/ai").walkTopDown()
+            .filter { it.isFile && it.extension == "kt" && it.readText().contains("BrainTrial(") }
+            .map { it.relativeTo(File("src/main/java/com/opendroid/ai")).path.replace('\\', '/') }
+            .toSet()
+        assertEquals(setOf("core/persona/BrainTrial.kt", "ui/viewmodel/BrainTrialViewModel.kt"), starts)
+    }
+}
