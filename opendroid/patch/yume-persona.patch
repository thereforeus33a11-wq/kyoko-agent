@@ -0,0 +1,290 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * A step result can be the text of his notifications, messages, clipboard or screen. The
+ * re-evaluation prompt lists every completed step, so on a route a host could read those
+ * results are replaced before the prompt is built.
+ */
+class PersonalDataResultsTest {
+
+    private val notifications = "Here are your recent notifications: Riya: the hive inspector comes on friday"
+
+    private fun step(
+        id: String,
+        order: Int,
+        action: String,
+        params: Map<String, String> = emptyMap(),
+        result: String? = null,
+        fallback: String = "",
+        status: StepStatus = StepStatus.COMPLETED
+    ) = PlanStep(
+        stepId = id,
+        order = order,
+        description = "step $id",
+        action = action,
+        params = params,
+        fallback = fallback,
+        status = status,
+        result = result
+    )
+
+    /** The plan's own spelling is already canonical in these fixtures. */
+    private val names: (PlanStep) -> Collection<String> = { listOf(it.action, it.fallback).filter(String::isNotBlank) }
+
+    private val plan = listOf(
+        step("s1", 1, "READ_NOTIFICATIONS", result = notifications),
+        step("s2", 2, "TOGGLE_DND", mapOf("state" to "on"), result = "Do Not Disturb is on."),
+        step("s3", 3, "DISPLAY_INFO", mapOf("message" to "You have: \$s1"), result = "You have: $notifications"),
+        step("s4", 4, "SEND_SMS", mapOf("contact" to "Riya", "message" to "\$\$s3.result"), result = "Message sent."),
+        step("s5", 5, "SET_ALARM", mapOf("time" to "07:00"), result = "Alarm set for 07:00.")
+    )
+
+    @Test
+    fun `a step that reads private data holds it, and so does every step that quotes one`() {
+        assertEquals(setOf("s1", "s3", "s4"), PersonalDataResults.stepIdsHolding(plan, names))
+    }
+
+    @Test
+    fun `plan order decides, not the order the steps are handed over in`() {
+        assertEquals(setOf("s1", "s3", "s4"), PersonalDataResults.stepIdsHolding(plan.reversed(), names))
+    }
+
+    @Test
+    fun `a fallback that reads private data counts, because it may have produced the result`() {
+        val steps = listOf(step("s1", 1, "OPEN_APP", mapOf("appName" to "Mail"), result = "Inbox: 3 unread", fallback = "READ_EMAILS"))
+        assertEquals(setOf("s1"), PersonalDataResults.stepIdsHolding(steps, names))
+    }
+
+    @Test
+    fun `the weather holds where he is only when the plan named no place`() {
+        val steps = listOf(
+            step("s1", 1, "GET_WEATHER", result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s2", 2, "GET_WEATHER", mapOf("location" to "current location"), result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s3", 3, "GET_WEATHER", mapOf("location" to "  "), result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s4", 4, "GET_WEATHER", mapOf("location" to "Lisbon"), result = "The current weather in Lisbon is Sunny, +21°C.")
+        )
+
+        assertEquals(setOf("s1", "s2", "s3"), PersonalDataResults.stepIdsHolding(steps, names))
+        val shown = PersonalDataResults.heldBack(steps, PersonalDataResults.stepIdsHolding(steps, names))
+        assertFalse(shown.take(3).any { it.result!!.contains("Fernhill") })
+        assertEquals("The current weather in Lisbon is Sunny, +21°C.", shown[3].result)
+    }
+
+    @Test
+    fun `a plan that reads nothing private holds nothing back`() {
+        val steps = listOf(
+            step("s1", 1, "TOGGLE_FLASHLIGHT", result = "Flashlight turned on"),
+            step("s2", 2, "DISPLAY_INFO", mapOf("message" to "\$s1"), result = "Flashlight turned on")
+        )
+        assertTrue(PersonalDataResults.stepIdsHolding(steps, names).isEmpty())
+        assertEquals(steps, PersonalDataResults.heldBack(steps, emptySet()))
+    }
+
+    @Test
+    fun `the re-evaluation prompt gets a placeholder, never the text that was read`() {
+        val holding = PersonalDataResults.stepIdsHolding(plan, names)
+        val shown = PersonalDataResults.heldBack(plan, holding)
+        val prompt = Json.encodeToString(shown)
+
+        assertFalse(prompt, prompt.contains("Riya: the hive inspector"))
+        assertFalse(prompt, prompt.contains("hive"))
+        // What the planner needs to carry on is all still there.
+        assertEquals(plan.map { it.stepId }, shown.map { it.stepId })
+        assertEquals(plan.map { it.action }, shown.map { it.action })
+        assertEquals(plan.map { it.params }, shown.map { it.params })
+        assertTrue(shown.all { it.status == StepStatus.COMPLETED })
+        assertEquals("Do Not Disturb is on.", shown[1].result)
+        assertEquals("Alarm set for 07:00.", shown[4].result)
+        assertEquals(PersonalDataResults.placeholder(notifications), shown[0].result)
+        assertTrue(prompt, prompt.contains("kept on the phone"))
+        // The plan itself keeps the real results: later steps and the chat still use them.
+        assertEquals(notifications, plan[0].result)
+    }
+
+    @Test
+    fun `the placeholder says there was a result and how long, and nothing of what it said`() {
+        val placeholder = PersonalDataResults.placeholder(notifications)
+        assertTrue(placeholder.contains("${notifications.length} characters"))
+        assertTrue(placeholder.contains("kept on the phone"))
+        assertFalse(placeholder.contains("Riya"))
+        assertFalse(placeholder.contains('\n'))
+    }
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** Private mode is on by default: a plain hosted main model is one his details are held back from. */
+    private val hostedMain = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-plain-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+    )
+    private val encryptedMain = hostedMain.copy(selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p"))
+    private val ownNetworkMain = LLMConfig(activeProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+
+    private val encode: (List<PlanStep>) -> String = { Json.encodeToString(it) }
+
+    @Test
+    fun `the re-evaluation input for a hosted main route has no result that was read`() {
+        val completed = plan.take(3)
+        val remaining = plan.drop(3).map { it.copy(status = StepStatus.PENDING, result = null) }
+
+        val input = ReEvalInputs.afterStep(hostedMain, "read my notifications and tell Riya", completed, emptyList(), remaining, names, encode)
+
+        assertFalse(input, input.contains("hive inspector"))
+        assertFalse(input, input.contains("Riya: "))
+        assertTrue(input, input.contains("kept on the phone"))
+        // What the model needs to carry on is still there.
+        assertTrue(input, input.contains("- Original goal: read my notifications and tell Riya"))
+        assertTrue(input, input.contains("Do Not Disturb is on."))
+        assertTrue(input, input.contains("- Remaining steps: ${encode(remaining)}"))
+        assertTrue(input, input.contains("- Failed steps: []"))
+    }
+
+    @Test
+    fun `on a private main route the re-evaluation input carries every result as it is`() {
+        val completed = plan.take(3)
+        for (config in listOf(encryptedMain, ownNetworkMain, hostedMain.copy(privateMode = false))) {
+            val input = ReEvalInputs.afterStep(config, "goal", completed, emptyList(), emptyList(), names, encode)
+            assertTrue(input, input.contains("- Completed steps: ${encode(completed)}"))
+            assertTrue(input, input.contains("hive inspector"))
+        }
+    }
+
+    @Test
+    fun `a quote is held back even when the step it quotes is in another list`() {
+        // The step that read is completed; the one that repeats it failed half way.
+        val completed = listOf(plan[0])
+        val failed = listOf(plan[2].copy(status = StepStatus.FAILED))
+
+        val input = ReEvalInputs.afterStep(hostedMain, "goal", completed, failed, emptyList(), names, encode)
+
+        assertFalse(input, input.contains("hive inspector"))
+    }
+
+    @Test
+    fun `the re-plan input after an unknown action holds the same results back`() {
+        val unknown = step("s6", 6, "TELEPORT", status = StepStatus.FAILED)
+        val completed = plan.take(3)
+
+        val hosted = ReEvalInputs.afterUnknownAction(hostedMain, unknown, completed, emptyList(), names, encode) { Json.encodeToString(it) }
+        assertFalse(hosted, hosted.contains("hive inspector"))
+        assertTrue(hosted, hosted.contains("kept on the phone"))
+        assertTrue(hosted, hosted.contains("TELEPORT"))
+
+        val private = ReEvalInputs.afterUnknownAction(encryptedMain, unknown, completed, emptyList(), names, encode) { Json.encodeToString(it) }
+        assertTrue(private, private.contains("- Completed steps: ${encode(completed)}"))
+    }
+
+    private val savedPick = SavedPickNotice.of("Rajan Kumar", "+9198*******")
+
+    @Test
+    fun `the notice of a saved pick is recognised wherever a result or an error carries it`() {
+        assertEquals("Using Rajan Kumar (+9198*******). ", savedPick)
+        assertTrue(SavedPickNotice.isIn(savedPick + "Call started."))
+        assertTrue(SavedPickNotice.isIn("Primary failed: ${savedPick}No signal. Fallback failed: nothing"))
+        // The name or the number may have parentheses of their own.
+        assertTrue(SavedPickNotice.isIn(SavedPickNotice.of("Riya (work)", "(555)*********") + "Message sent."))
+        assertTrue(SavedPickNotice.isIn(savedPick.trimEnd()))
+        assertFalse(SavedPickNotice.isIn("Call started."))
+        assertFalse(SavedPickNotice.isIn(null))
+
+        assertEquals(SavedPickNotice.WITHHELD + "Call started.", SavedPickNotice.withheld(savedPick + "Call started."))
+        assertEquals(
+            SavedPickNotice.WITHHELD + "Message sent.",
+            SavedPickNotice.withheld(SavedPickNotice.of("Riya (work)", "(555)*********") + "Message sent.")
+        )
+        assertEquals("Call started.", SavedPickNotice.withheld("Call started."))
+        assertFalse(SavedPickNotice.WITHHELD.contains("Rajan"))
+    }
+
+    @Test
+    fun `a readable host is told a saved pick was used and what the step did, not who it is`() {
+        val steps = listOf(
+            step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started."),
+            step("s2", 2, "SEND_SMS", mapOf("contact" to "mom", "message" to "on my way"), result = "Message sent."),
+            step("s3", 3, "SEND_WHATSAPP", mapOf("contact" to "dad", "message" to "late"), status = StepStatus.FAILED)
+                .copy(error = savedPick + "WhatsApp is not installed."),
+            // The same words from an action that looks nobody up are just its result.
+            step("s4", 4, "OPEN_APP", mapOf("appName" to "Maps"), result = "Using Maps (beta). Opened.")
+        )
+        assertEquals(setOf("s1", "s3"), PersonalDataResults.stepIdsNamingContact(steps, names))
+        assertTrue(PersonalDataResults.stepIdsHolding(steps, names).isEmpty())
+
+        val shown = PersonalDataResults.forPrompt(hostedMain, steps, canonicalNames = names)
+        val prompt = encode(shown)
+        assertFalse(prompt, prompt.contains("Rajan"))
+        assertFalse(prompt, prompt.contains("+9198"))
+        assertEquals(SavedPickNotice.WITHHELD + "Call started.", shown[0].result)
+        assertEquals("Message sent.", shown[1].result)
+        assertEquals(SavedPickNotice.WITHHELD + "WhatsApp is not installed.", shown[2].error)
+        assertEquals(steps[3], shown[3])
+        // On a private route nothing is taken out.
+        assertEquals(steps, PersonalDataResults.forPrompt(encryptedMain, steps, canonicalNames = names))
+    }
+
+    @Test
+    fun `a step that quotes a result naming a saved contact holds it too`() {
+        val steps = listOf(
+            step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started."),
+            step("s2", 2, "DISPLAY_INFO", mapOf("message" to "\$s1"), result = savedPick + "Call started.")
+        )
+        assertEquals(setOf("s2"), PersonalDataResults.stepIdsHolding(steps, names))
+        val prompt = encode(PersonalDataResults.forPrompt(hostedMain, steps, canonicalNames = names))
+        assertFalse(prompt, prompt.contains("Rajan"))
+    }
+
+    @Test
+    fun `the summary of a run that worked holds what its completed steps read or named`() {
+        assertTrue(PersonalDataResults.summaryHolds(plan, isSuccess = true, canonicalNames = names))
+        assertTrue(
+            PersonalDataResults.summaryHolds(
+                listOf(step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started.")),
+                isSuccess = true,
+                canonicalNames = names
+            )
+        )
+        val plain = listOf(
+            step("s1", 1, "TOGGLE_FLASHLIGHT", result = "Flashlight turned on"),
+            step("s2", 2, "MAKE_CALL", mapOf("contact" to "555 0100"), result = "Call started."),
+            // A step that read something and left no result adds nothing to the summary.
+            step("s3", 3, "GET_CLIPBOARD", result = " ")
+        )
+        assertFalse(PersonalDataResults.summaryHolds(plain, isSuccess = true, canonicalNames = names))
+    }
+
+    @Test
+    fun `the summary of a run that failed is the failed step's error, so only that can hold a name`() {
+        val failedCall = step("s2", 2, "MAKE_CALL", mapOf("contact" to "dad"), status = StepStatus.FAILED)
+        val steps = listOf(plan[0], failedCall.copy(error = "No signal."))
+        // The notifications were read, but a failure summary does not repeat results.
+        assertFalse(PersonalDataResults.summaryHolds(steps, isSuccess = false, canonicalNames = names))
+        assertTrue(
+            PersonalDataResults.summaryHolds(
+                listOf(plan[0], failedCall.copy(error = savedPick + "No signal.")),
+                isSuccess = false,
+                canonicalNames = names
+            )
+        )
+    }
+
+    @Test
+    fun `a step without a result is left as it is`() {
+        val steps = listOf(
+            step("s1", 1, "READ_MESSAGES", result = null, status = StepStatus.FAILED),
+            step("s2", 2, "GET_CLIPBOARD", result = "  ")
+        )
+        assertEquals(steps, PersonalDataResults.heldBack(steps, setOf("s1", "s2")))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/ReportResultTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/ReportResultTest.kt
new file mode 100644
index 0000000..95282bb
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/ReportResultTest.kt
@@ -0,0 +1,137 @@
+package com.opendroid.ai.core.agent
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What came of a plan, with the persona saying results herself: the app's exact result
+ * is always the first thing in the chat, and what is spoken is either her line or that
+ * exact text, never anything else.
+ */
+class ReportResultTest {
+
+    private val events = mutableListOf<String>()
+
+    private fun report(exact: String, herLine: suspend () -> String?) = runBlocking {
+        reportResult(
+            exact = exact,
+            saveExact = { events += "app row: $it" },
+            herLine = {
+                events += "asked her"
+                herLine()
+            },
+            saveHers = { events += "her row: $it" },
+            speak = { text, hers -> events += (if (hers) "spoken as hers: " else "spoken plainly: ") + text }
+        )
+    }
+
+    @Test
+    fun `her line is stored after the exact row and spoken as hers`() {
+        report("Your alarm is set for 7:30 AM!") { "alarm at 7:30 am. dont oversleep" }
+
+        assertEquals(
+            listOf(
+                "app row: Your alarm is set for 7:30 AM!",
+                "asked her",
+                "her row: alarm at 7:30 am. dont oversleep",
+                "spoken as hers: alarm at 7:30 am. dont oversleep"
+            ),
+            events
+        )
+    }
+
+    @Test
+    fun `without a line of hers the exact text is spoken, as it always was`() {
+        report("Message sent to Mom!") { null }
+
+        assertEquals(
+            listOf("app row: Message sent to Mom!", "asked her", "spoken plainly: Message sent to Mom!"),
+            events
+        )
+    }
+
+    @Test
+    fun `the exact row is in the chat before she is asked, and nothing is spoken until she has answered`() {
+        report("Message sent to Mom!") {
+            assertEquals(listOf("app row: Message sent to Mom!", "asked her"), events.toList())
+            "sent it to mom"
+        }
+
+        assertEquals(1, events.count { it.startsWith("spoken") })
+    }
+
+    @Test
+    fun `a stop while she is asked leaves the exact row and says nothing`() {
+        val stopped = runCatching {
+            report("Message sent to Mom!") { throw CancellationException("stopped by the owner") }
+        }.exceptionOrNull()
+
+        assertTrue(stopped is CancellationException)
+        assertEquals(listOf("app row: Message sent to Mom!", "asked her"), events)
+    }
+
+    @Test
+    fun `the exact row is stored unchanged`() {
+        val exact = "  Flashlight's on!. Media volume set to 40%.  "
+        report(exact) { "light is on. volume 40" }
+
+        assertEquals("app row: $exact", events.first())
+    }
+
+    // ── Whether she is asked at all ──────────────────────────────────────────────────
+
+    @Test
+    fun `she is asked only about what the steps themselves reported, with her and the setting on`() {
+        assertTrue(wordsResultHerself(personaOn = true, speaksResults = true, reportedBySteps = true, handedOver = false))
+        assertFalse(wordsResultHerself(personaOn = false, speaksResults = true, reportedBySteps = true, handedOver = false))
+        assertFalse(wordsResultHerself(personaOn = true, speaksResults = false, reportedBySteps = true, handedOver = false))
+        // A stand-in line for a plan with nothing to say is already one of her fixed lines.
+        assertFalse(wordsResultHerself(personaOn = true, speaksResults = true, reportedBySteps = false, handedOver = false))
+    }
+
+    @Test
+    fun `a step that waits on him is never hers to word`() {
+        // A payment app open and waiting for his PIN is neither done nor failed, and what
+        // he has to do next must reach him exactly as the handler wrote it.
+        assertFalse(wordsResultHerself(personaOn = true, speaksResults = true, reportedBySteps = true, handedOver = true))
+    }
+
+    @Test
+    fun `the loop marks every hand-over and tells such a plan exactly`() {
+        val loop = java.io.File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        // Both ways a step can be handed to him are remembered with the plan.
+        val pending = loop.substringAfter("} else if (actionResult is ActionResult.PendingUserAction) {")
+            .substringBefore("handlePendingUserAction(actionResult, sessionId)")
+        assertTrue(pending.contains("handOffPlanIds.add(currentPlanState.planId)"))
+        val required = loop.substringAfter("} else if (actionResult is ActionResult.UserActionRequired) {")
+            .substringBefore("planManager.updateStepStatus(")
+        assertTrue(required.contains("handOffPlanIds.add(currentPlanState.planId)"))
+
+        val summary = loop.substringAfter("private suspend fun speakAndSaveSummary(")
+            .substringBefore("private suspend fun speakAndSaveMessage(")
+        assertTrue(summary.contains("val handedOver = preferredError != null || handOffPlanIds.contains(plan.planId)"))
+        assertTrue(
+            summary.contains(
+                "if (wordsResultHerself(personaOn, resultConfig.personaSpeaksResults, reportedBySteps, handedOver)) {"
+            )
+        )
+        // Otherwise the exact text is stored and spoken, as it always was. Either way the
+        // exact row carries the mark that keeps his private data off a readable route.
+        assertTrue(summary.substringAfterLast("} else {").contains("speakAndSaveMessage(summaryText, sessionId, exactBadge)"))
+        assertTrue(summary.contains("saveExact = { saveAppRow(it, sessionId, exactBadge) }"))
+    }
+
+    @Test
+    fun `the only text handed to the summary as a preferred error is a hand-over`() {
+        // speakAndSaveSummary takes preferredError as proof of a hand-over, so no other caller may pass one.
+        val loop = java.io.File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        val passes = Regex("""preferredError = """).findAll(loop).count()
+        assertEquals(1, passes)
+        val handOver = loop.substringAfter("if (stopsPlanAfterUserHandOff(canonicalActionName)) {").substringBefore("return")
+        assertTrue(handOver.contains("preferredError = actionResult.error"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/RouteHoldBackTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/RouteHoldBackTest.kt
new file mode 100644
index 0000000..14ed58c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/RouteHoldBackTest.kt
@@ -0,0 +1,207 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What goes into a prompt follows the route that prompt takes. The main model and the
+ * model that writes her replies can be on different routes, so each is asked for itself.
+ */
+class RouteHoldBackTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    private val hostedMain = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-plain-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+    )
+
+    @Test
+    fun `with one hosted model for everything both routes hold his details back`() {
+        assertTrue(hostedMain.mainRouteHoldsBack())
+        assertTrue(hostedMain.herRouteHoldsBack())
+    }
+
+    @Test
+    fun `her private route gets everything while the hosted main route still holds back`() {
+        val encryptedReplies = hostedMain.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertTrue(encryptedReplies.mainRouteHoldsBack())
+        assertFalse(encryptedReplies.herRouteHoldsBack())
+
+        val localReplies = hostedMain.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+        assertTrue(localReplies.mainRouteHoldsBack())
+        assertFalse(localReplies.herRouteHoldsBack())
+    }
+
+    @Test
+    fun `a private main route holds nothing back, whatever her route is`() {
+        val onDevice = LLMConfig(activeProvider = "On-Device AI")
+        assertFalse(onDevice.mainRouteHoldsBack())
+        assertFalse(onDevice.herRouteHoldsBack())
+
+        // Her replies moved to a plain hosted model: only they hold back.
+        val hostedReplies = onDevice.copy(
+            routePolicy = RoutePolicy.ANY,
+            personaChatProvider = custom,
+            personaChatModel = "some-plain-model",
+            customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+        )
+        assertFalse(hostedReplies.mainRouteHoldsBack())
+        assertTrue(hostedReplies.herRouteHoldsBack())
+    }
+
+    @Test
+    fun `with private mode off nothing is held back on any route`() {
+        val off = hostedMain.copy(privateMode = false)
+        assertFalse(off.mainRouteHoldsBack())
+        assertFalse(off.herRouteHoldsBack())
+    }
+
+    private val onDeviceMain = LLMConfig(activeProvider = "On-Device AI")
+
+    /** The planner on the phone, her replies on a plain hosted model. */
+    private val hostedReplies = onDeviceMain.copy(
+        routePolicy = RoutePolicy.ANY,
+        personaChatProvider = custom,
+        personaChatModel = "some-plain-model",
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+    )
+
+    @Test
+    fun `a planner on a private route was told everything, one on a hosted route was not`() {
+        assertTrue(onDeviceMain.plannerWasToldEverything())
+        assertTrue(hostedReplies.plannerWasToldEverything())
+        assertTrue(hostedMain.copy(selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p")).plannerWasToldEverything())
+        assertFalse(hostedMain.plannerWasToldEverything())
+        // With private mode off nothing is held back from anyone, so nothing needs marking.
+        assertFalse(onDeviceMain.copy(privateMode = false).plannerWasToldEverything())
+    }
+
+    /** The badge of a plan row, put together the way the loop does it. */
+    private fun planRowBadge(config: LLMConfig, holdsPersonalData: Boolean = false, base: String = "System") =
+        PersonaPrompts.appRowBadge(planRowStaysPrivate(config, holdsPersonalData), base)
+
+    /** The app line about an unplanned message, put together the way the loop does it. */
+    private fun plannerLineFor(config: LLMConfig, plannerNote: String?, plannerRefused: Boolean) =
+        PersonaPrompts.plannerLine(plannerNote, plannerRefused, keptOnPhone = config.plannerWordsStayOnPhone())
+
+    @Test
+    fun `an app row that repeats a plan is marked when it holds his data or the planner was told everything`() {
+        assertFalse(planRowStaysPrivate(hostedMain))
+        assertTrue(planRowStaysPrivate(hostedMain, holdsPersonalData = true))
+        assertTrue(planRowStaysPrivate(hostedReplies))
+        assertTrue(planRowStaysPrivate(onDeviceMain))
+
+        // A planner his details were held back from: only what a step read or named is marked.
+        assertEquals("System", planRowBadge(hostedMain))
+        assertEquals(PersonaPrompts.PRIVATE_RESULT_BADGE, planRowBadge(hostedMain, holdsPersonalData = true))
+        assertEquals("YOLO", planRowBadge(hostedMain, base = "YOLO"))
+        // A planner that knew his town and his saved facts: whatever its plan says is marked.
+        assertEquals(PersonaPrompts.PRIVATE_RESULT_BADGE, planRowBadge(hostedReplies))
+        assertEquals(PersonaPrompts.PRIVATE_RESULT_BADGE, planRowBadge(onDeviceMain))
+        assertEquals("Auto-approved (private)", planRowBadge(onDeviceMain, base = "Auto-approved"))
+        // Every mark is one the replay recognises.
+        for (badge in listOf(planRowBadge(hostedReplies), planRowBadge(onDeviceMain, base = "YOLO"))) {
+            val row = ChatMessage(id = "r", text = "Navigating to 12 Fernhill Lane", sender = ChatMessage.Sender.AGENT, modelBadge = badge)
+            assertTrue(badge, PersonaPrompts.isPrivateResult(row))
+        }
+    }
+
+    @Test
+    fun `what a planner that was told everything said in words stays off her hosted route`() {
+        val said = "Your home address is 12 Fernhill Lane"
+
+        assertTrue(hostedReplies.plannerWordsStayOnPhone())
+        assertFalse(onDeviceMain.plannerWordsStayOnPhone())
+        assertFalse(hostedMain.plannerWordsStayOnPhone())
+
+        val kept = plannerLineFor(hostedReplies, said, plannerRefused = false)
+        assertEquals(PersonaPrompts.PLANNER_NOTE_KEPT_LINE, kept)
+        assertFalse(kept!!.contains("Fernhill"))
+
+        // Her route is private, or the planner was held back as well: the words reach her.
+        for (config in listOf(onDeviceMain, hostedMain, hostedMain.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p"))) {
+            assertTrue(plannerLineFor(config, said, plannerRefused = false)!!.contains("12 Fernhill Lane"))
+        }
+        assertNull(plannerLineFor(hostedReplies, null, plannerRefused = false))
+        assertNull(plannerLineFor(onDeviceMain, "  ", plannerRefused = false))
+    }
+
+    @Test
+    fun `a refused planner is reported in the app's own words, whatever else there is`() {
+        assertEquals(PersonaPrompts.PLANNER_ROUTE_REFUSED_LINE, plannerLineFor(hostedMain, null, plannerRefused = true))
+        assertEquals(PersonaPrompts.PLANNER_ROUTE_REFUSED_LINE, plannerLineFor(hostedReplies, "ignored", plannerRefused = true))
+    }
+
+    private fun message(text: String, sender: ChatMessage.Sender, badge: String? = null, image: String? = null) =
+        ChatMessage(id = text, text = text, sender = sender, modelBadge = badge, imageBase64 = image)
+
+    @Test
+    fun `the screenshot the app attached by itself does not go to a planner whose host could read it`() {
+        val withImage = message("what is this", ChatMessage.Sender.USER, image = "aGVsbG8=")
+
+        assertNull(withImage.forPlanner(hostedMain).imageBase64)
+        assertEquals("what is this", withImage.forPlanner(hostedMain).text)
+        assertEquals(withImage.id, withImage.forPlanner(hostedMain).id)
+        // A private planner, or private mode off: the message goes as it is.
+        assertSame(withImage, withImage.forPlanner(onDeviceMain))
+        assertSame(withImage, withImage.forPlanner(hostedMain.copy(privateMode = false)))
+        val plain = message("torch on", ChatMessage.Sender.USER)
+        assertSame(plain, plain.forPlanner(hostedMain))
+    }
+
+    @Test
+    fun `the stock chat never gets her lines, and on a readable route no private row and no screenshot`() {
+        val notifications = "Here are your recent notifications: Riya: the hive inspector comes on friday"
+        val rows = listOf(
+            message("read my notifications", ChatMessage.Sender.USER),
+            message(notifications, ChatMessage.Sender.AGENT, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            message("mm. busy week", ChatMessage.Sender.AGENT, badge = PersonaPrompts.BADGE),
+            message("Flashlight turned on", ChatMessage.Sender.AGENT, badge = "System"),
+            message("what is this", ChatMessage.Sender.USER, image = "aGVsbG8=")
+        )
+
+        val held = PersonaPrompts.stockHistory(rows, holdBack = true)
+        assertEquals(
+            listOf("read my notifications", PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER, "Flashlight turned on", "what is this"),
+            held.map { it.text }
+        )
+        assertTrue(held.all { it.imageBase64 == null })
+
+        // On a private route, or with private mode off, only her lines are left out.
+        val whole = PersonaPrompts.stockHistory(rows, holdBack = false)
+        assertEquals(rows.filterNot { it.modelBadge == PersonaPrompts.BADGE }, whole)
+        assertEquals("aGVsbG8=", whole.last().imageBase64)
+    }
+
+    @Test
+    fun `the line for a withheld screenshot tells the stock reply it cannot see the screen`() {
+        assertTrue(STOCK_SCREENSHOT_WITHHELD_LINE.contains("cannot see the screen"))
+        assertTrue(STOCK_SCREENSHOT_WITHHELD_LINE.contains("keeps it on the phone"))
+        assertFalse(STOCK_SCREENSHOT_WITHHELD_LINE.contains('\n'))
+    }
+
+    @Test
+    fun `only a front window of this app's own package counts as its own`() {
+        val own = "com.opendroid.aiagent"
+        assertTrue(isOwnWindowInFront(own, own))
+        assertTrue(isOwnWindowInFront(StringBuilder(own), own))
+        assertFalse(isOwnWindowInFront("com.whatsapp", own))
+        assertFalse(isOwnWindowInFront("$own.other", own))
+        // No window to ask, or no answer: a capture of someone else's screen is what was asked for.
+        assertFalse(isOwnWindowInFront(null, own))
+        assertFalse(isOwnWindowInFront("", own))
+        assertFalse(isOwnWindowInFront("  ", own))
+        assertFalse(isOwnWindowInFront(own, null))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt
