+                        viewModel.underText.isBlank() -> "Her files have no such text in this build, and you have saved none"
+                        else -> "The text from her files · ${viewModel.underText.length} characters · press Edit to start from it"
+                    },
+                    fontSize = 11.sp,
+                    fontFamily = FontFamily.Monospace,
+                    color = if (viewModel.underHasUnsavedChanges) AccentCyan else TextSecondary
+                )
+                OutlinedTextField(
+                    value = viewModel.underText,
+                    onValueChange = viewModel::onUnderTextChange,
+                    readOnly = !viewModel.underEditing,
+                    textStyle = TextStyle(fontSize = 13.sp, fontFamily = FontFamily.Monospace, color = TextPrimary),
+                    colors = fieldColors(),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .heightIn(min = 160.dp, max = 420.dp)
+                )
+                Note("{{owner}} stands for your profile name. Changes apply from her next reply.")
+                if (viewModel.underEditing) {
+                    Button(
+                        onClick = viewModel::saveUnderText,
+                        enabled = viewModel.underHasUnsavedChanges,
+                        colors = ButtonDefaults.buttonColors(containerColor = AccentCyan, contentColor = DarkBackground),
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text("Save") }
+                } else {
+                    Button(
+                        onClick = viewModel::startEditingUnderText,
+                        colors = ButtonDefaults.buttonColors(containerColor = AccentCyan, contentColor = DarkBackground),
+                        modifier = Modifier.fillMaxWidth()
+                    ) { Text("Edit") }
+                }
+                if (viewModel.canUndoReading) {
