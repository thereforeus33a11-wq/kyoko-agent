+
+    // ── The plan made from her command ───────────────────────────────────────────────
+
+    @Test
+    fun `a number or an address in the plan that her command never named is not hers`() {
+        val command = "text nene: on my way"
+        // The planner added a second recipient it can only have taken from the notification.
+        assertTrue(
+            PersonaActions.planCarriesOutsideText(command, listOf("nene", "on my way", "5550107788", "on my way"), notifications)
+        )
+        assertTrue(PersonaActions.planCarriesOutsideText(command, listOf("nene", "555-010-7788"), notifications))
+        assertTrue(PersonaActions.planCarriesOutsideText(command, listOf("forms@rio-office.example.org", "on my way"), notifications))
+        assertTrue(PersonaActions.planCarriesOutsideText(command, listOf("https://parcel-desk.example.net/pay"), notifications))
+        assertTrue(PersonaActions.planCarriesOutsideText(command, listOf("@quick_cash_bot", "on my way"), notifications))
