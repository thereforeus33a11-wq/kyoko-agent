diff --git a/app/src/test/java/com/opendroid/ai/actions/GetWeatherActionTest.kt b/app/src/test/java/com/opendroid/ai/actions/GetWeatherActionTest.kt
new file mode 100644
index 0000000..315b5ce
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/actions/GetWeatherActionTest.kt
@@ -0,0 +1,134 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import android.content.ContextWrapper
+import android.content.Intent
+import android.os.Bundle
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.actions.base.ActionResult
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * In private mode the weather for "here" is not looked up from the phone's position:
+ * that would hand where he is to the geocoder, the weather site and a web search. With
+ * private mode off, and for a place he names, the action does what it always did.
+ *
+ * The weather site is stood in for; no test reaches it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class GetWeatherActionTest {
+
+    private val context = WatchedContext(ApplicationProvider.getApplicationContext())
+
+    // The places the weather site was asked about, in order.
+    private val askedAbout = mutableListOf<String>()
+
+    private fun weather(privateMode: Boolean, site: (String) -> String = { "Sunny, +18°C" }) =
+        InformationActions(
+            privateMode = { privateMode },
+            weatherSite = { place -> askedAbout += place; site(place) }
+        ).getActions().first { it.name == "GET_WEATHER" }
+
+    @Test
+    fun `no place given in private mode asks for a city and reads no position`() {
+        for (params in listOf(
+            emptyMap(),
+            mapOf("location" to ""),
+            mapOf("location" to "   "),
+            mapOf("location" to "current location")
+        )) {
+            val result = runBlocking { weather(privateMode = true).execute(params, context) }
+
+            assertTrue("$params -> $result", result is ActionResult.NeedsInput)
+            result as ActionResult.NeedsInput
+            assertTrue(result.question.contains("city", ignoreCase = true))
+            // The answer is put back into this parameter and the action runs again with it.
+            assertEquals("location", result.metadata["param"])
+        }
+        assertTrue("the location service was asked for", context.servicesAskedFor.none { it == Context.LOCATION_SERVICE })
+        assertTrue("nothing may be opened or searched", context.started.isEmpty())
+        assertTrue("the weather site was asked about $askedAbout", askedAbout.isEmpty())
+    }
+
+    @Test
+    fun `a place he names is looked up in private mode too, and his position is still not read`() {
+        val result = runBlocking { weather(privateMode = true).execute(mapOf("location" to "Lisbon"), context) }
+
+        assertTrue(result.toString(), result.success)
+        assertEquals("The current weather in Lisbon is Sunny, +18°C. Opened search for details.", result.data)
+        assertEquals(listOf("Lisbon"), askedAbout)
+        assertEquals("https://www.google.com/search?q=weather+in+Lisbon", context.started.single().dataString)
+        assertTrue(context.servicesAskedFor.none { it == Context.LOCATION_SERVICE })
+    }
+
+    @Test
+    fun `with private mode off no place given still goes to the phone's position, as it always did`() {
+        // What he gave, and the place that is looked up when the phone has no position to
+        // give, as on this test phone: the old stand-in, or his own words where he gave some.
+        val cases = listOf(
+            emptyMap<String, String>() to "my location",
+            mapOf("location" to " ") to "my location",
+            mapOf("location" to "current location") to "current location"
+        )
+        for ((params, place) in cases) {
+            context.servicesAskedFor.clear()
+            context.started.clear()
+            askedAbout.clear()
+
+            val result = runBlocking { weather(privateMode = false).execute(params, context) }
+
+            assertTrue("$params -> $result", result.success)
+            assertTrue("$params: the position was not looked for", context.servicesAskedFor.any { it == Context.LOCATION_SERVICE })
+            assertEquals(listOf(place), askedAbout)
+            assertEquals("The current weather in $place is Sunny, +18°C. Opened search for details.", result.data)
+            assertEquals(
+                "https://www.google.com/search?q=weather+in+${place.replace(' ', '+')}",
+                context.started.single().dataString
+            )
+        }
+    }
+
+    @Test
+    fun `a weather site that does not answer still opens the search, as it always did`() {
+        val result = runBlocking {
+            weather(privateMode = false, site = { throw java.io.IOException("no route") }).execute(mapOf("location" to "Lisbon"), context)
+        }
+
+        assertTrue(result.toString(), result.success)
+        assertEquals("Here's the weather for Lisbon! Opened search for details.", result.data)
+        assertEquals("https://www.google.com/search?q=weather+in+Lisbon", context.started.single().dataString)
+    }
+
+    @Test
+    fun `actions built without settings behave as in private mode`() {
+        val action = InformationActions().getActions().first { it.name == "GET_WEATHER" }
+        val result = runBlocking { action.execute(emptyMap(), context) }
+        assertTrue(result is ActionResult.NeedsInput)
+        assertTrue(context.servicesAskedFor.none { it == Context.LOCATION_SERVICE })
+    }
+
+    private class WatchedContext(base: Context) : ContextWrapper(base) {
+        val servicesAskedFor = mutableListOf<String>()
+        val started = mutableListOf<Intent>()
+
+        override fun getSystemService(name: String): Any? {
+            servicesAskedFor += name
+            return super.getSystemService(name)
+        }
+
+        override fun startActivity(intent: Intent) {
+            started += intent
+        }
+
+        override fun startActivity(intent: Intent, options: Bundle?) {
+            started += intent
+        }
+    }
+}
