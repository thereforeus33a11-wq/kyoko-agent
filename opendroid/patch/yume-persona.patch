+     */
+    fun parts(text: String, size: Int = PART_CHARS): List<String> {
+        val whole = text.trim()
+        if (whole.isEmpty()) return emptyList()
+        if (whole.length <= size) return listOf(whole)
+        val parts = ArrayList<String>()
+        var current = StringBuilder()
+        fun flush() {
+            if (current.isNotBlank()) parts += current.toString().trim()
+            current = StringBuilder()
+        }
+        for (paragraph in whole.split(Regex("""\n\s*\n"""))) {
+            var rest = paragraph.trim()
+            while (rest.length > size) {
+                flush()
+                val window = rest.substring(0, size)
+                val cut = maxOf(window.lastIndexOf("。"), window.lastIndexOf(". "), window.lastIndexOf("\n")).takeIf { it > size / 2 }?.plus(1) ?: size
+                parts += rest.substring(0, cut).trim()
+                rest = rest.substring(cut).trim()
+            }
+            if (current.length + rest.length + 2 > size) flush()
+            if (current.isNotEmpty()) current.append("\n\n")
+            current.append(rest)
+        }
+        flush()
+        return parts
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/reading/ReadingSpace.kt b/app/src/main/java/com/opendroid/ai/core/life/reading/ReadingSpace.kt
