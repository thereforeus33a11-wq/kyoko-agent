+@Composable
+private fun fieldColors() = OutlinedTextFieldDefaults.colors(
+    focusedBorderColor = AccentCyan,
+    unfocusedBorderColor = BorderColor,
+    focusedTextColor = TextPrimary,
+    unfocusedTextColor = TextPrimary
+)
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(
+        text = text,
+        fontSize = 11.sp,
+        fontWeight = FontWeight.Bold,
+        fontFamily = FontFamily.Monospace,
+        color = AccentCyan,
+        modifier = Modifier.padding(top = 10.dp)
+    )
+}
+
+@Composable
+private fun Note(text: String) {
+    Text(text = text, fontSize = 11.sp, color = TextSecondary)
+}
+
+/** A stored picture, small. Decoded off the main thread; an empty box until it is there or when its file is gone. */
+@Composable
+private fun PictureThumbnail(id: String, viewModel: PersonaPicturesViewModel, description: String) {
+    val image by produceState<ImageBitmap?>(initialValue = null, key1 = id) {
+        value = viewModel.thumbnail(id)?.asImageBitmap()
+    }
+    val shape = RoundedCornerShape(8.dp)
+    Box(
+        modifier = Modifier
+            .size(96.dp)
+            .clip(shape)
+            .border(1.dp, BorderColor, shape)
+    ) {
+        image?.let {
+            Image(
+                bitmap = it,
+                contentDescription = description,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.fillMaxSize()
+            )
+        }
+    }
+}
+
+/** One picture of her: the picture, its caption to edit, who wrote the caption, and what can be done with it. */
+@Composable
+private fun SelfPictureCard(
+    picture: PersonaPicturesViewModel.Shown,
+    viewModel: PersonaPicturesViewModel,
+    canLook: Boolean,
+    looking: Boolean
+) {
+    // The draft lives here while he types and starts over from the stored caption
+    // whenever that changes, which is also how a caption she wrote shows up.
+    var draft by remember(picture.id, picture.caption) { mutableStateOf(picture.caption) }
+    // Asked of the caption as it would be stored: a space or an empty line at its end
+    // is not kept, so it is nothing to save and does not make her words his.
+    val changed = PersonaPicturesViewModel.captionChanged(draft, picture.caption)
+    val shape = RoundedCornerShape(12.dp)
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .border(1.dp, BorderColor, shape)
+            .padding(12.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            PictureThumbnail(picture.id, viewModel, "A picture of her")
+            OutlinedTextField(
+                value = draft,
+                onValueChange = { draft = it.take(viewModel.maxCaptionChars) },
+                label = { Text("What is on it, the way she would say it", fontSize = 12.sp) },
+                textStyle = TextStyle(fontSize = 13.sp, color = TextPrimary),
+                minLines = 2,
+                maxLines = 5,
+                colors = fieldColors(),
+                modifier = Modifier.weight(1f)
+            )
+        }
+        Text(
+            text = when {
+                changed -> "${draft.length} of ${viewModel.maxCaptionChars} characters · not saved"
+                picture.caption.isBlank() -> "No caption yet"
+                picture.captionIsHers -> "Written by her, when she looked at it"
+                else -> "Written by you"
+            },
+            fontSize = 11.sp,
+            fontFamily = FontFamily.Monospace,
+            color = if (changed) AccentCyan else TextSecondary
+        )
+        // Three buttons side by side have to fit a narrow phone: they share the width and keep their padding small.
+        val tight = PaddingValues(horizontal = 8.dp)
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            verticalAlignment = Alignment.CenterVertically
+        ) {
+            Button(
+                onClick = { viewModel.saveCaption(picture.id, draft) },
+                enabled = changed,
+                colors = ButtonDefaults.buttonColors(containerColor = AccentCyan, contentColor = DarkBackground),
+                contentPadding = tight,
+                modifier = Modifier.weight(1f)
+            ) { Text("Save", maxLines = 1) }
+            OutlinedButton(
+                onClick = { viewModel.letHerLook(picture.id) },
+                enabled = canLook && viewModel.lookingAt == null,
+                contentPadding = tight,
+                modifier = Modifier.weight(1.4f)
+            ) {
+                if (looking) {
+                    CircularProgressIndicator(color = AccentCyan, strokeWidth = 2.dp, modifier = Modifier.size(16.dp))
+                } else {
+                    Text("Let her look", color = TextPrimary, maxLines = 1)
+                }
+            }
+            OutlinedButton(
+                onClick = { viewModel.remove(picture.id) },
+                contentPadding = tight,
+                modifier = Modifier.weight(1.1f)
+            ) { Text("Remove", color = TextPrimary, maxLines = 1) }
+        }
+    }
+}
