+        Glance.momentLine(life.glance)?.let { add(it.removePrefix("- ").replace("===", "= = =")) }
+        life.lastOuting?.let { add(lastOutingLine(it, life.nowMillis, thoughtsLeftOut)) }
+        if (life.kidNotKept > 0) add(com.opendroid.ai.core.life.KidGuard.NOT_KEPT)
+        life.goMissed?.let { add(goMissedLine(it, life.runnable, frontToo = life.camera?.frontToo == true)) }
+    }
