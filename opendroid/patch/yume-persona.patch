+package com.opendroid.ai.core.life.reading
+
+import org.jsoup.Jsoup
+import org.jsoup.nodes.Document
+import org.jsoup.nodes.Element
+import org.jsoup.nodes.Node
+import org.jsoup.nodes.TextNode
+import org.jsoup.select.NodeTraversor
+import org.jsoup.select.NodeVisitor
+import java.net.URI
+import java.nio.ByteBuffer
+import java.nio.charset.CharacterCodingException
+import java.nio.charset.Charset
+import java.nio.charset.CodingErrorAction
+
+/**
+ * The readable text of a page: its title, the text of its main content without menus,
+ * sidebars and footers, the links in it, its feeds and its lead picture. Text-density
+ * scoring in the manner of Readability, on a page parsed by jsoup. And the bytes of a
+ * page decoded by the charset it declares or, failing that, the one it reads as: Shift_JIS
+ * and EUC-JP are told apart, as Japanese sites still use both.
+ */
+object Readable {
+
+    data class Link(val title: String, val url: String) {
+        val domain: String get() = try {
+            URI(url).host.orEmpty().removePrefix("www.")
+        } catch (e: Exception) {
+            ""
+        }
+    }
+
+    data class Page(
+        val title: String,
+        val text: String,
+        val links: List<Link>,
+        /** The page's own feeds (`<link rel=alternate>`), for `do: follow`. */
+        val feeds: List<String>,
+        /** Its lead picture (`og:image`), for a look later. */
+        val image: String?
+    )
+
+    /** About how long one part of a page is when she reads it. */
+    const val PART_CHARS = 6_000
+
+    private const val MAX_LINKS = 40
+    private const val MIN_PARAGRAPH_CHARS = 25
+
+    // ── Charsets ─────────────────────────────────────────────────────────────────────
+
+    private val META_CHARSET = Regex("""(?i)<meta[^>]+charset\s*=\s*["']?\s*([A-Za-z0-9._:-]+)""")
+    private val XML_ENCODING = Regex("""(?i)<\?xml[^>]+encoding\s*=\s*["']([A-Za-z0-9._:-]+)["']""")
+    private val HEADER_CHARSET = Regex("""(?i)charset\s*=\s*["']?([A-Za-z0-9._:-]+)""")
+
+    /**
+     * [bytes] as text. The charset is the first of: a byte order mark, the charset of
+     * [contentType], one the document declares in its first bytes (`<meta charset>`, an
+     * http-equiv, an XML declaration), UTF-8 when the bytes are valid UTF-8, then whichever
+     * of Shift_JIS and EUC-JP the bytes read as, and windows-1252 last.
+     */
+    fun decode(bytes: ByteArray, contentType: String = ""): String {
+        bom(bytes)?.let { (charset, skip) -> return String(bytes, skip, bytes.size - skip, charset) }
+        val declared = HEADER_CHARSET.find(contentType)?.groupValues?.get(1)
+            ?: declaredIn(bytes)
+        charsetOf(declared)?.let { return String(bytes, it) }
+        return String(bytes, detect(bytes))
+    }
+
+    /** The charset a document declares within its first bytes, or null. */
+    private fun declaredIn(bytes: ByteArray): String? {
+        val head = String(bytes, 0, minOf(bytes.size, 4_096), Charsets.ISO_8859_1)
+        return META_CHARSET.find(head)?.groupValues?.get(1) ?: XML_ENCODING.find(head)?.groupValues?.get(1)
+    }
+
+    private fun bom(bytes: ByteArray): Pair<Charset, Int>? = when {
+        bytes.size >= 3 && bytes[0] == 0xEF.toByte() && bytes[1] == 0xBB.toByte() && bytes[2] == 0xBF.toByte() -> Charsets.UTF_8 to 3
+        bytes.size >= 2 && bytes[0] == 0xFE.toByte() && bytes[1] == 0xFF.toByte() -> Charsets.UTF_16BE to 2
+        bytes.size >= 2 && bytes[0] == 0xFF.toByte() && bytes[1] == 0xFE.toByte() -> Charsets.UTF_16LE to 2
+        else -> null
+    }
+
+    /** A charset by its label, with the labels Japanese sites use mapped as browsers map them. */
+    internal fun charsetOf(label: String?): Charset? {
+        val name = label?.trim()?.lowercase()?.takeIf { it.isNotEmpty() } ?: return null
+        val wanted = when (name) {
+            "shift_jis", "shift-jis", "sjis", "x-sjis", "ms_kanji", "csshiftjis", "windows-31j", "cp932", "ms932" -> SHIFT_JIS_NAMES
+            "euc-jp", "eucjp", "x-euc-jp", "cseucpkdfmtjapanese" -> listOf("EUC-JP")
+            "iso-2022-jp", "csiso2022jp" -> listOf("ISO-2022-JP")
+            "utf8", "utf-8", "unicode-1-1-utf-8" -> listOf("UTF-8")
+            // Browsers read latin-1 as windows-1252.
+            "iso-8859-1", "latin1", "us-ascii", "ascii", "windows-1252" -> listOf("windows-1252", "ISO-8859-1")
+            else -> listOf(name)
+        }
+        return wanted.firstNotNullOfOrNull { candidate ->
+            try {
+                if (Charset.isSupported(candidate)) Charset.forName(candidate) else null
+            } catch (e: Exception) {
+                null
+            }
+        }
+    }
+
+    private val SHIFT_JIS_NAMES = listOf("windows-31j", "Shift_JIS")
+
+    private fun strictly(bytes: ByteArray, charset: Charset): String? = try {
+        charset.newDecoder()
+            .onMalformedInput(CodingErrorAction.REPORT)
+            .onUnmappableCharacter(CodingErrorAction.REPORT)
+            .decode(ByteBuffer.wrap(bytes))
+            .toString()
+    } catch (e: CharacterCodingException) {
+        null
+    }
+
+    /** The charset undeclared bytes read as. */
+    internal fun detect(bytes: ByteArray): Charset {
+        if (strictly(bytes, Charsets.UTF_8) != null) return Charsets.UTF_8
+        val candidates = (listOfNotNull(charsetOf("shift_jis"), charsetOf("euc-jp")))
+            .mapNotNull { charset -> strictly(bytes, charset)?.let { charset to japaneseScore(it) } }
+        candidates.maxByOrNull { it.second }?.takeIf { it.second > 0 }?.let { return it.first }
+        return charsetOf("windows-1252") ?: Charsets.ISO_8859_1
+    }
+
+    /**
+     * How much [text] reads as Japanese: kana count most, common kanji next, and
+     * half-width katakana and rare symbols, which a wrong guess produces, count against.
+     */
+    private fun japaneseScore(text: String): Int {
+        var score = 0
+        for (c in text) {
+            score += when (c) {
+                in 'ぁ'..'ゖ' -> 3 // hiragana
+                in 'ァ'..'ヺ' -> 2 // katakana
+                in '　'..'〿' -> 2 // Japanese punctuation
+                in '一'..'鿿' -> 1 // kanji
+                in '｡'..'ﾟ' -> -2 // half-width katakana
+                in '─'..'╿', in ''..'' -> -3 // box drawing, private use
+                else -> 0
+            }
+        }
+        return score
+    }
+
+    // ── Readable text ────────────────────────────────────────────────────────────────
+
+    private val UNWANTED_TAGS = "script, style, noscript, template, svg, canvas, iframe, object, embed, form, button, input, " +
+        "select, textarea, nav, header, footer, aside, menu, dialog, [hidden], [aria-hidden=true], " +
+        "[role=navigation], [role=banner], [role=contentinfo], [role=complementary], [role=dialog]"
+
+    private val NEGATIVE = Regex(
+        """(?i)(?:^|[\s_-])(?:nav|navi|navbar|menu|header|footer|foot|sidebar|side|widget|breadcrumbs?|banner|ads?|advert\w*|""" +
+            """promo\w*|sponsor\w*|share|sharing|social|sns|related|recommend\w*|ranking|popular|comments?|cookie\w*|consent|""" +
+            """subscribe|newsletter|signup|login|modal|popup|pager|pagination|tags?|meta|byline|author-box|outbrain|taboola)(?:$|[\s_-])"""
+    )
+    private val POSITIVE = Regex("""(?i)(?:^|[\s_-])(?:article|content|main|post|entry|story|body|text|blog|honbun|kiji|news-?body)(?:$|[\s_-])""")
+    private val SENTENCE_MARKS = Regex("""[,、。，．.!?！？]""")
+
+    /** Reads [html] as fetched from [baseUrl]. */
+    fun page(html: String, baseUrl: String): Page {
+        val doc = Jsoup.parse(html, baseUrl)
+        val title = titleOf(doc)
+        val feeds = doc.select("link[rel~=(?i)alternate][type~=(?i)(rss|atom)][href]")
+            .map { it.absUrl("href") }.filter { it.startsWith("https://") }.distinct()
+        val image = doc.selectFirst("meta[property=og:image][content], meta[name=og:image][content], meta[name=twitter:image][content]")
+            ?.absUrl("content")?.takeIf { it.startsWith("https://") }
+        clean(doc)
+        val body = doc.body()
+        val main = mainOf(body)
+        val text = textOf(main).ifBlank { textOf(body) }
+        val links = (linksIn(main) + linksIn(body)).distinctBy { it.url }.take(MAX_LINKS)
+        return Page(title, text, links, feeds, image)
+    }
+
+    private fun titleOf(doc: Document): String {
+        val og = doc.selectFirst("meta[property=og:title][content]")?.attr("content")?.trim().orEmpty()
+        val title = og.ifEmpty { doc.title().trim() }
+        return flat(title.ifEmpty { doc.selectFirst("h1")?.text()?.trim().orEmpty() })
+    }
+
+    private fun clean(doc: Document) {
+        doc.select(UNWANTED_TAGS).remove()
+        doc.body().select("*").filter { element ->
+            val names = element.className() + " " + element.id()
+            names.isNotBlank() && NEGATIVE.containsMatchIn(names) && !POSITIVE.containsMatchIn(names) &&
+                element.tagName() !in setOf("html", "body", "article", "main")
+        }.forEach { it.remove() }
+    }
+
+    /** The element whose paragraphs score highest: Readability's text-density scoring, simplified. */
+    private fun mainOf(body: Element): Element {
+        val scores = HashMap<Element, Double>()
+        for (paragraph in body.select("p, pre, td, blockquote, dd, li")) {
+            val text = paragraph.text()
+            if (text.length < MIN_PARAGRAPH_CHARS) continue
+            val worth = 1.0 + SENTENCE_MARKS.findAll(text).count() + minOf(text.length / 100, 3)
+            val parent = paragraph.parent() ?: continue
+            scores.merge(parent, worth + initial(parent, scores), Double::plus)
+            parent.parent()?.let { scores.merge(it, worth / 2 + initial(it, scores), Double::plus) }
+            parent.parent()?.parent()?.let { scores.merge(it, worth / 3 + initial(it, scores), Double::plus) }
+        }
+        val best = scores.entries.maxByOrNull { (element, score) -> score * (1 - linkDensity(element)) }?.key ?: return body
+        // A best that is one of several siblings of an article body: take their common parent.
+        val parent = best.parent()
+        if (parent != null && parent != body) {
+            val siblings = parent.children().count { child -> (scores[child] ?: 0.0) >= (scores[best] ?: 0.0) * 0.3 && child != best }
+            if (siblings >= 2) return parent
+        }
+        return best
+    }
+
+    /** What an element counts for by itself, once: its tag and its class and id. */
+    private fun initial(element: Element, scores: Map<Element, Double>): Double {
+        if (scores.containsKey(element)) return 0.0
+        var score = when (element.tagName()) {
+            "article" -> 10.0
+            "main" -> 8.0
+            "div", "section" -> 5.0
+            "pre", "td", "blockquote" -> 3.0
+            "ol", "ul", "dl", "li", "form" -> -3.0
+            "h1", "h2", "h3", "h4", "h5", "h6", "th" -> -5.0
+            else -> 0.0
+        }
+        val names = element.className() + " " + element.id()
+        if (POSITIVE.containsMatchIn(names)) score += 25
+        if (NEGATIVE.containsMatchIn(names)) score -= 25
+        return score
+    }
+
+    private fun linkDensity(element: Element): Double {
+        val all = element.text().length
+        if (all == 0) return 1.0
+        val inLinks = element.select("a").sumOf { it.text().length }
+        return inLinks.toDouble() / all
+    }
+
+    private val BLOCKS = setOf(
+        "p", "div", "section", "article", "main", "li", "ul", "ol", "dl", "dt", "dd", "pre", "blockquote",
+        "h1", "h2", "h3", "h4", "h5", "h6", "table", "tr", "td", "th", "figcaption", "br", "hr"
+    )
+
+    /** The text of [root], one block to a paragraph. */
+    private fun textOf(root: Element): String {
+        val out = StringBuilder()
+        NodeTraversor.traverse(object : NodeVisitor {
+            override fun head(node: Node, depth: Int) {
+                when {
+                    node is TextNode -> out.append(node.text())
+                    node is Element && node.tagName() in BLOCKS -> out.append('\n')
+                }
+            }
+
+            override fun tail(node: Node, depth: Int) {
+                if (node is Element && node.tagName() in BLOCKS) out.append('\n')
+            }
+        }, root)
+        return out.lines()
+            .map { flat(it) }
+            .fold(ArrayList<String>()) { kept, line ->
+                if (line.isEmpty()) {
+                    if (kept.isNotEmpty() && kept.last().isNotEmpty()) kept += ""
+                } else {
+                    kept += line
+                }
+                kept
+            }
+            .joinToString("\n")
+            .replace(Regex("""\n{2,}"""), "\n\n")
+            .trim()
+    }
+
+    private fun linksIn(root: Element): List<Link> = root.select("a[href]").mapNotNull { anchor ->
+        val url = anchor.absUrl("href").substringBefore('#')
+        val title = flat(anchor.text()).ifEmpty { flat(anchor.attr("title")) }
+        if (!url.startsWith("https://") || title.length < 2) null else Link(title.take(120), url)
+    }
+
+    private fun flat(text: String): String = text.replace(' ', ' ').replace(Regex("""[\s　]+"""), " ").trim()
+
+    /**
+     * [text] cut into parts of about [size] characters, at paragraph ends where it can,
+     * else at the end of a sentence, else where the size runs out.
+     */
+    fun parts(text: String, size: Int = PART_CHARS): List<String> {
+        val whole = text.trim()
+        if (whole.isEmpty()) return emptyList()
+        if (whole.length <= size) return listOf(whole)
+        val parts = ArrayList<String>()
+        var current = StringBuilder()
+        fun flush() {
+            if (current.isNotBlank()) parts += current.toString().trim()
+            current = StringBuilder()
+        }
+        for (paragraph in whole.split(Regex("""\n\s*\n"""))) {
+            var rest = paragraph.trim()
+            while (rest.length > size) {
+                flush()
+                val window = rest.substring(0, size)
+                val cut = maxOf(window.lastIndexOf("。"), window.lastIndexOf(". "), window.lastIndexOf("\n")).takeIf { it > size / 2 }?.plus(1) ?: size
+                parts += rest.substring(0, cut).trim()
+                rest = rest.substring(cut).trim()
+            }
+            if (current.length + rest.length + 2 > size) flush()
+            if (current.isNotEmpty()) current.append("\n\n")
+            current.append(rest)
+        }
+        flush()
+        return parts
+    }
+}
