+    @Test
+    fun `a pass on a route a host could read is sent nothing that can be about him, and what it may not repeat waits for a private one`() {
+        // A model at a public address, whose host can read what it is sent: the route that holds his details back.
+        val name = "models.example.com"
+        val certificate = HeldCertificate.Builder().addSubjectAlternativeName(name).build()
+        val hosted = MockWebServer().also {
+            it.useHttps(HandshakeCertificates.Builder().heldCertificate(certificate).build().sslSocketFactory())
+            it.start(InetAddress.getByName("127.0.0.1"), 0)
+        }
+        try {
+            val trusting = HandshakeCertificates.Builder().addTrustedCertificate(certificate.certificate).build()
+            // The name is answered by the server of this test, and by nothing between the two.
+            val engine = engine(
+                client = AppModule.provideOkHttpClient().newBuilder()
+                    .dns(Dns { listOf(InetAddress.getByName("127.0.0.1")) })
+                    .proxy(java.net.Proxy.NO_PROXY)
+                    .sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager)
+                    .build()
+            )
+            val onPrivateRoute = config()
+            configure {
+                it.copy(
+                    routePolicy = RoutePolicy.ANY,
+                    privateMode = true,
+                    customEndpoints = mapOf(custom to "https://$name:${hosted.port}/v1")
+                )
+            }
+            assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(config()))
+            runBlocking {
+                memory.apply(
+                    listOf(
+                        Note(Kind.USER, "bees", "he keeps bees"),
+                        Note(Kind.OPINION, "inbox", "saw: his inbox has 4,000 unread"),
+                        Note(Kind.ME, "soda", "melon soda is mine and i do not share")
+                    )
+                )
+                // Her last pass, on the private route, wrote more lines than the notebook takes at a time.
+                memory.recordNotTaken(listOf("user | sister | his sister gets married in june", "me | boots | the boots are mine at last"))
+            }
+            val exact = "From Mom: \"dad is back in hospital, call me\""
+            val rows = talk + listOf(
+                his("read my last message", 4_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+                app(exact, 4_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+                hers("mom says dad is back in hospital, call me", 4_020, badge = PersonaPrompts.resultBadge(staysPrivate = true)),
+                // A line of hers from before result lines had a badge, and one she wrote unprompted behind a marked row.
+                his("and the one before it", 5_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+                app("From Riya Fernhill: \"the inspector comes at 9:30\"", 5_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+                hers("riya fernhill says the inspector comes at 9:30", 5_020),
+                hers("still alive over there?", 5_020 + 3 * 60 * 60_000L),
+                his("Riya Fernhill", 5_030 + 3 * 60 * 60_000L, badge = PersonaPrompts.OWNER_PICK_BADGE)
+            )
+            answer("user | hives | he has a second hive up now\nme | quiet | i wrote first and i would again", from = hosted)
+
+            engine.afterReply(rows)
+
+            assertEquals(0, server.requestCount)
+            val request = hosted.takeRequest(10, java.util.concurrent.TimeUnit.SECONDS)
+            assertNotNull("the pass did not reach the hosted model", request)
+            val sent = request!!.body?.utf8().orEmpty()
+            // Her own talk with him is there, and what is hers alone.
+            assertTrue(sent, sent.contains("the second hive is up"))
+            assertTrue(sent, sent.contains("still alive over there?"))
+            assertTrue(sent, sent.contains("me | soda | melon soda is mine and i do not share"))
+            assertTrue(sent, sent.contains(PersonaPrompts.PICKED_CONTACT_PLACEHOLDER))
+            // Nothing that can be about him: her notes about him, what she saw, what the phone read out,
+            // her lines about it under either badge, the contact he tapped, and the line about his sister.
+            for (detail in listOf("he keeps bees", "4,000 unread", "hospital", "inspector", "Fernhill", "fernhill", "sister", "june")) {
+                assertFalse(detail, sent.contains(detail))
+            }
+            assertTrue(sent, sent.contains("(Not shown: what you have noted about him, and what you saw on his screen."))
+            assertTrue(sent, sent.contains(
+                "(Before this pass you wrote 2 lines the notebook could not take, so nothing of them is in it: " +
+                    "me | boots | the boots are mine at last. The other one is not repeated here: this goes through a hosted " +
+                    "service that can read what it is sent, and a line is repeated on it only when it is a note that cannot be about him. "
+            ))
+            // What she wrote is kept on the phone whatever the route, and the line that was not repeated waits.
+            assertEquals(setOf("bees", "inbox", "soda", "hives", "quiet"), runBlocking { memory.notes() }.map { it.key }.toSet())
+            assertEquals(listOf("user | sister | his sister gets married in june"), runBlocking { memory.notTaken() })
+
+            // Back on the private route the next pass is shown it, and then it is done with.
+            configure { it.copy(routePolicy = onPrivateRoute.routePolicy, customEndpoints = onPrivateRoute.customEndpoints) }
+            assertTrue(RouteClassifier.personaRoute(config()).isPrivate)
+            answer("user | sister | his sister gets married in june")
+            engine.afterReply(talk.map { it.copy(id = it.id + "-later", timestamp = it.timestamp + 24 * 60 * 60_000L) })
+            val later = asked()
+            assertTrue(later, later.contains(
+                "(Before this pass you wrote a line the notebook could not take, so nothing of it is in it: " +
+                    "user | sister | his sister gets married in june. A line needs a kind from the list"
+            ))
+            assertTrue(later, later.contains("user | bees | he keeps bees"))
+            assertTrue(runBlocking { memory.notTaken() }.isEmpty())
+            assertTrue(runBlocking { memory.notes() }.any { it.key == "sister" })
+        } finally {
+            hosted.close()
+        }
+    }
