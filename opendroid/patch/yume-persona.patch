+        val roomy = VeniceE2eeMessages.requestBody("e2ee-some-model", mapOf("max_tokens" to 6000), emptyList())
+        assertEquals(6000, roomy["max_tokens"])
+
+        // A plain route on one of the three: sent, her own temperature included, the app's keys not.
+        val plain = replyOptionsNote(ownNetwork)
+        assertTrue(plain.startsWith("The options in that field are sent with her replies to Ollama, temperature and the token limit included"))
+        assertTrue(plain.contains("her notebook pass and her line about a result keep their own for those two"))
