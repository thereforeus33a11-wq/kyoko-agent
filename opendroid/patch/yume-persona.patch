+package com.opendroid.ai.core.llm
+
+import com.opendroid.ai.core.llm.RouteClassifier.HostKind
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RoutePrivacyTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    @Test
+    fun `loopback addresses are this phone`() {
+        for (endpoint in listOf(
+            "http://127.0.0.1:8080/v1", "http://localhost:11434", "127.0.0.1:1234", "http://[::1]:8080/v1",
+            "http://127.9.9.9", "https://LOCALHOST/v1"
+        )) {
+            assertEquals(endpoint, HostKind.LOOPBACK, RouteClassifier.hostKind(endpoint))
+        }
+    }
+
+    @Test
+    fun `private ranges and private names are his own network`() {
+        for (endpoint in listOf(
+            "http://192.168.1.20:11434", "http://10.0.0.5/v1", "http://172.16.4.4:8000", "http://172.31.255.1",
+            "http://100.101.102.103:11434", "http://169.254.1.1", "http://desktop.local:11434",
+            "http://pc.lan/v1", "http://gaming-pc:1234/v1", "https://box.tailnet-abc.ts.net/v1",
+            "http://[fd12:3456::1]:8080", "http://[fe80::1]:8080", "http://nas.home.arpa"
+        )) {
+            assertEquals(endpoint, HostKind.PRIVATE, RouteClassifier.hostKind(endpoint))
+        }
+    }
+
+    @Test
+    fun `everything else is public, and doubt counts as public`() {
+        for (endpoint in listOf(
+            "https://api.venice.ai/api/v1", "https://example.com", "http://172.32.0.1", "http://192.169.1.1",
+            "http://100.63.0.1", "http://100.128.0.1", "http://8.8.8.8", "", "   ", "http://",
+            "http://999.1.1.1", "http://1.2.3", "http://10.0.0.5.evil.com/v1", "https://localhost.evil.com",
+            "http://[2001:db8::1]", "http://192.168.1.1.nip.io"
+        )) {
+            assertEquals(endpoint, HostKind.PUBLIC, RouteClassifier.hostKind(endpoint))
+        }
+    }
+
+    @Test
+    fun `the on-device providers are on the phone whatever else is set`() {
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("On-Device AI", "gemma-4-on-device", ""))
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("Gemma 4 (On-device)", "x", "https://example.com"))
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("LiteRT-LM (On-device)", "x", ""))
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("Google Gemini", "gemini-nano", ""))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Google Gemini", "gemini-2.5-flash", ""))
+    }
+
+    @Test
+    fun `an endpoint he typed decides for the providers that take one`() {
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("Ollama", "llama3", "http://127.0.0.1:11434"))
+        assertEquals(RoutePrivacy.OWN_NETWORK, RouteClassifier.classify("Ollama", "llama3", "http://192.168.1.20:11434"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Ollama", "llama3", "https://ollama.example.com"))
+        assertEquals(RoutePrivacy.OWN_NETWORK, RouteClassifier.classify(custom, "any", "http://10.0.0.2:8080/v1"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "any", "https://api.venice.ai/api/v1"))
+        // A provider with a fixed address is hosted even if a private-looking endpoint is stored for it.
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("OpenAI", "gpt-4o", "http://127.0.0.1"))
+    }
+
+    @Test
+    fun `only an encrypted model on the compatible provider at the one known host counts as encrypted`() {
+        val venice = "https://api.venice.ai/api/v1"
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.classify(custom, "e2ee-gemma-4-26b-a4b-uncensored-p", venice))
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.classify(custom, " E2EE-model ", venice))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "venice-uncensored-1-2", venice))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "not-e2ee-model", venice))
+        // The other providers send plain bodies whatever the model is called.
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("OpenRouter", "e2ee-anything", ""))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("OpenAI", "e2ee-anything", ""))
+        // The provider refuses the exchange with any other host, so the label must not promise it.
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "e2ee-model", "https://example.com/v1"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "e2ee-model", "https://api.venice.ai.evil.com/v1"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify(custom, "e2ee-model", "http://api.venice.ai/api/v1"))
+    }
+
+    @Test
+    fun `a relay on his own machine to a company's models is hosted`() {
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Copilot API", "gpt-4o", "http://127.0.0.1:4141"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Copilot API", "gpt-4o", "http://192.168.1.20:4141"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Ollama", "gpt-oss:120b-cloud", "http://127.0.0.1:11434"))
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.classify("Ollama", "qwen3-coder:cloud", "http://192.168.1.20:11434"))
+        assertEquals(RoutePrivacy.ON_DEVICE, RouteClassifier.classify("Ollama", "cloudy-model:12b", "http://127.0.0.1:11434"))
+    }
+
+    @Test
+    fun `her route follows her own provider and model, else the main one`() {
+        val base = LLMConfig(
