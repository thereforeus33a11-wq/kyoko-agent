+/** A stored picture, small. Decoded off the main thread; an empty box until it is there or when its file is gone. */
+@Composable
+private fun PictureThumbnail(id: String, viewModel: PersonaPicturesViewModel, description: String) {
+    val image by produceState<ImageBitmap?>(initialValue = null, key1 = id) {
+        value = viewModel.thumbnail(id)?.asImageBitmap()
+    }
+    val shape = RoundedCornerShape(8.dp)
+    Box(
+        modifier = Modifier
+            .size(96.dp)
+            .clip(shape)
+            .border(1.dp, BorderColor, shape)
+    ) {
+        image?.let {
+            Image(
+                bitmap = it,
+                contentDescription = description,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.fillMaxSize()
+            )
+        }
+    }
+}
