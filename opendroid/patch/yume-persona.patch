+        assertTrue(RoutePrivacy.ENCRYPTED.isAtLeastAsPrivateAs(RoutePrivacy.PRIVATE_TIER))
+        assertFalse(RoutePrivacy.PRIVATE_TIER.isAtLeastAsPrivateAs(RoutePrivacy.ENCRYPTED))
