@@ -0,0 +1,40 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+
+/**
+ * When the persona may write first. Deliberately conservative: an unprompted line
+ * costs a model call and lands as a notification, so it must be rare and never pile up.
+ */
+object CheckInRule {
+    /** The chat has to have been silent at least this long. */
+    const val MIN_QUIET_MILLIS = 3L * 60 * 60 * 1000
+
+    /** And she must not have written first more recently than this. */
+    const val MIN_GAP_MILLIS = 6L * 60 * 60 * 1000
+
+    /** Waking hours only (local time, start inclusive, end exclusive). */
+    const val FIRST_HOUR = 9
+    const val LAST_HOUR = 23
+
+    fun isDue(
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        hourOfDay: Int,
+        lastCheckInAt: Long
+    ): Boolean {
+        if (hourOfDay < FIRST_HOUR || hourOfDay >= LAST_HOUR) return false
+        // She never opens an empty chat: there has to be a conversation to pick up.
+        val lastOwnerMessage = recentMessages.lastOrNull { it.sender == ChatMessage.Sender.USER } ?: return false
+        val lastMessage = recentMessages.last()
+        if (nowMillis - lastMessage.timestamp < MIN_QUIET_MILLIS) return false
+        if (nowMillis - lastCheckInAt < MIN_GAP_MILLIS) return false
+        // One unprompted line per silence: he has to have written since her last one.
+        return lastOwnerMessage.timestamp > lastCheckInAt
+    }
+
+    fun hoursQuiet(recentMessages: List<ChatMessage>, nowMillis: Long): Long {
+        val last = recentMessages.lastOrNull()?.timestamp ?: return 0
+        return ((nowMillis - last) / (60L * 60 * 1000)).coerceAtLeast(1)
+    }
+}
