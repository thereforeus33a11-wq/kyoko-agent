+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.life.eyes.SightProbe
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.ui.viewmodel.PersonaPicturesViewModel
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What his screens say of her own senses: the card HER OWN SENSES, the privacy card while he
+ * trusts Venice's Private tier, where a picture of her goes on that tier, and why the switch
+ * for pictures changes nothing when her model is known not to see.
+ */
+class SensesWordingTest {
+
+    private val moved = HerBrain.move(BuildDefaults.fresh().copy(apiKeys = mapOf(BuildDefaults.PROVIDER to "k")))
+
+    @Test
+    fun `the card says what trusting the tier means, and what it takes on Venice's word`() {
+        assertTrue(SensesWording.TRUST_HINT.contains("Nothing about you is held back from it"))
+        assertTrue(SensesWording.TRUST_HINT.contains("It is not end to end encrypted."))
+        assertTrue(SensesWording.SEES_HINT.contains("after the app checks each for kids"))
+        assertTrue(SensesWording.HEARS_HINT.contains("Only your voice, never another one. Nothing of it is kept."))
+        assertTrue(SensesWording.PROBE_NOTE.contains("nothing of yours or hers"))
+        assertEquals("Venice lists ${VenicePrivateTier.SEEING_BRAIN} as taking no sound: she gets your words and how they sounded. xiaomi-mimo-v2-5 hears.", SensesWording.hearsNote(moved))
+        assertEquals("Venice lists xiaomi-mimo-v2-5 as taking sound.", SensesWording.hearsNote(moved.copy(personaChatModel = "xiaomi-mimo-v2-5")))
+        assertTrue(PrivacyWording.PRIVATE_TIER_TRUSTED.contains("It is not end to end encrypted"))
+    }
+
+    @Test
+    fun `a picture of her on the tier goes to her own model, and a blind model is named as the reason`() {
+        assertTrue(PersonaPicturesViewModel.whereAPictureGoes(moved).contains("on Venice's Private tier, which you trust for her: she sees it herself"))
+        assertNull(screenshotSwitchNote(moved))
+        val blind = SightProbe.withRecord(moved, SightProbe.Probe.BRAIN, SightProbe.Record(SightProbe.Result.REFUSED, VenicePrivateTier.SEEING_BRAIN, 1L, 400))
+        assertTrue(screenshotSwitchNote(blind)!!.contains("the model that writes her replies is known not to see"))
+        assertTrue(screenshotSwitchNote(HerBrain.moveBack(moved).copy(personaChatSeesImages = true))!!.contains("end to end encrypted"))
+    }
+}
