+++ b/app/src/main/java/com/opendroid/ai/core/service/CheckInNotification.kt
@@ -0,0 +1,134 @@
+package com.opendroid.ai.core.service
+
+import android.app.Notification
+import android.app.PendingIntent
+import android.content.Context
+import androidx.core.app.NotificationCompat
+
+/**
+ * The notifications for what she marked for the owner in a moment of her own: a line
+ * she wrote to him, and a plan of hers that waits for his yes.
+ *
+ * A notification is not private to the app that posts it: it can be read on the lock
+ * screen, and the system hands its text to every other app with notification access (a
+ * watch, a car, another assistant), which may pass it on. Her line is written from her
+ * notebook and the recent talk, so unless the owner asked to see her words here the
+ * notification only says that she wrote. The line itself is in the chat either way.
+ * The one about a plan never says more than that there is one: what the plan is stands
+ * on its card in the chat. Her thoughts are in no notification at all.
+ *
+ * Where her words are shown and she wrote a command for the phone with them, the app's
+ * own note about the command stands in front of them. Her line may speak of the command
+ * as done, and the notification is all the owner reads without opening the chat: what
+ * the phone did must not reach him from her line alone.
+ *
+ * Where his settings ask him first before an outing of hers, one more notification asks
+ * him to let it start: it names the kind of outing and its length, never her words.
+ */
+internal object CheckInNotification {
+
+    /** What the notification says when it does not show her words. */
+    fun wroteTitle(name: String): String = "$name wrote to you"
+
+    /** All the notification says when a plan of hers waits for his yes. */
+    fun wantsTitle(name: String): String = "$name wants to do something"
+
+    /**
+     * The notification for a plan she started in a moment of her own that waits in the
+     * chat for his yes. It carries the title and nothing of the plan, and is marked
+     * private like the one that hides her words. It is shown again at each of her
+     * moments for as long as the plan waits, and sounds only the first time.
+     */
+    fun buildWants(context: Context, channelId: String, name: String, open: PendingIntent?): Notification =
+        NotificationCompat.Builder(context, channelId)
+            .setSmallIcon(android.R.drawable.stat_notify_chat)
+            .setAutoCancel(true)
+            .setContentIntent(open)
+            .setContentTitle(wantsTitle(name))
+            .setOnlyAlertOnce(true)
+            .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+            .build()
+
+    /**
+     * What the notification shows where it shows her words. [commandMark] is the app's
+     * note about a command she wrote with the line, or null when she wrote none. It
+     * stands in front of her words, where a notification that is shown shortened cannot
+     * cut it off.
+     */
+    fun shownText(line: String, commandMark: String?): String =
+        if (commandMark.isNullOrBlank()) line else "$commandMark $line"
+
+    /** [name] is who wrote; it is handed in so that this file needs nothing from her own code. */
+    fun build(
+        context: Context,
+        channelId: String,
+        name: String,
+        line: String,
+        showText: Boolean,
+        open: PendingIntent?,
+        commandMark: String? = null
+    ): Notification {
+        val builder = NotificationCompat.Builder(context, channelId)
+            .setSmallIcon(android.R.drawable.stat_notify_chat)
+            .setAutoCancel(true)
+            .setContentIntent(open)
+        if (showText) {
+            val shown = shownText(line, commandMark)
+            builder.setContentTitle(name)
+                .setContentText(shown)
+                .setStyle(NotificationCompat.BigTextStyle().bigText(shown))
+        } else {
+            // No text at all, so there is nothing for a lock screen or another app to
+            // show; and marked private, so a lock screen set to hide content hides this too.
+            builder.setContentTitle(wroteTitle(name))
+                .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+        }
+        return builder.build()
+    }
+
+    /**
+     * What the notification says when his settings ask him first before an outing of hers:
+     * what kind of outing, for how long at most, and that it is in her own space. Her
+     * `go:` words are not in it. [kind] is the log's word for it ("reading", "news"). For a
+     * look, [camera] is what she would look through: "the back camera", or "the front camera,
+     * which faces you".
+     */
+    fun outingAskText(name: String, kind: String, maxMinutes: Int, waitsMinutes: Int, camera: String = ""): String {
+        // A look is one frame through a camera, not an outing of minutes.
+        if (kind == "looking") {
+            val through = camera.ifBlank { "the phone's camera" }
+            return "$name wants one look through $through, while your screen is on. It waits $waitsMinutes min for your answer."
+        }
+        val what = when (kind) {
+            "news" -> "read the news from her feeds"
+            "reading" -> "read up on something"
+            else -> kind
+        }
+        return "$name wants to go off and $what for up to $maxMinutes min, in her own space and not on your phone. " +
+            "It waits $waitsMinutes min for your answer."
+    }
+
+    /**
+     * The notification that asks him to let an outing of hers start, with "Let her" and
+     * "Not now". It goes by itself once the question is over ([timeoutMillis]).
+     */
+    fun buildOutingAsk(
+        context: Context,
+        channelId: String,
+        text: String,
+        letHer: PendingIntent,
+        notNow: PendingIntent,
+        open: PendingIntent?,
+        timeoutMillis: Long
+    ): Notification =
+        NotificationCompat.Builder(context, channelId)
+            .setSmallIcon(android.R.drawable.stat_notify_chat)
+            .setContentIntent(open)
+            .setContentText(text)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+            .addAction(0, "Let her", letHer)
+            .addAction(0, "Not now", notNow)
+            .setOnlyAlertOnce(true)
+            .setTimeoutAfter(timeoutMillis)
+            .build()
+}
