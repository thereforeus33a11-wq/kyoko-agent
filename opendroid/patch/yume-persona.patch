+/**
+ * Her ears, while her own life is on: the switch, and while it is on the recogniser and its
+ * models, charging only, his voice, and whether others may talk to her.
+ */
+@Composable
+private fun HerEarsSettings(
+    config: LLMConfig,
+    viewModel: SettingsViewModel,
+    ears: com.opendroid.ai.ui.viewmodel.EarsViewModel = hiltViewModel()
+) {
+    SettingSwitchRow(
+        title = EARS_TITLE,
+        description = EARS_HINT,
+        checked = config.personaOpenMic,
+        onCheckedChange = viewModel::updatePersonaOpenMic
+    )
+    if (!config.personaOpenMic) return
+    val recognizer = com.opendroid.ai.core.life.ears.EarsModels.Recognizer.of(config.personaEarsModel)
+    LaunchedEffect(recognizer) {
+        ears.watch(recognizer)
+        ears.loadEnrolled()
+    }
+    SettingChoiceRow(
+        label = "How her ears turn speech into words",
+        options = EARS_MODEL_CHOICES,
+        selected = recognizer.name,
+        onSelect = viewModel::updatePersonaEarsModel
+    )
+    val status = ears.modelStatus
+    FeedRow(
+        name = "Models for her ears",
+        note = earsModelLine(status),
+        action = when {
+            status?.ready == true -> "DELETE"
+            status?.downloading == true || status?.waiting == true -> "CANCEL"
+            else -> "DOWNLOAD"
+        },
+        onAction = {
+            when {
+                status?.ready == true -> ears.deleteModels()
+                status?.downloading == true || status?.waiting == true -> ears.cancelDownload()
+                else -> ears.download(recognizer)
+            }
+        }
+    )
+    SettingSwitchRow(
+        title = EARS_CHARGING_TITLE,
+        description = EARS_CHARGING_HINT,
+        checked = config.personaOpenMicOnlyCharging,
+        onCheckedChange = viewModel::updatePersonaOpenMicOnlyCharging
+    )
+    val enrolled = ears.enrolled
+    FeedRow(
+        name = EARS_ENROL_TITLE,
+        note = if (enrolled == true) EARS_ENROLLED else EARS_NOT_ENROLLED,
+        action = if (enrolled == true) "ENROL AGAIN" else "ENROL",
+        onAction = ears::startEnrolment
+    )
+    if (enrolled == true) {
+        Text(
+            text = "FORGET MY VOICE",
+            fontSize = 12.sp,
+            fontWeight = FontWeight.Bold,
+            fontFamily = FontFamily.Monospace,
+            color = AccentCyan,
+            modifier = Modifier.clickable(onClick = ears::forgetVoice)
+        )
+    }
+    SettingSwitchRow(
+        title = EARS_OTHERS_TITLE,
+        description = EARS_OTHERS_HINT,
+        checked = config.personaEarsOthersMayTalk,
+        onCheckedChange = viewModel::updatePersonaEarsOthersMayTalk
+    )
+    if (ears.notice.isNotEmpty()) Text(text = ears.notice, fontSize = 11.sp, color = AccentCyan)
+    ears.enrolling?.let { e ->
+        AlertDialog(
+            onDismissRequest = { if (!e.listening) ears.cancelEnrolment() },
+            title = { Text("Your voice: sentence ${e.step} of ${e.of}") },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                    Text(text = "\"${e.sentence}\"", fontSize = 16.sp, color = TextPrimary)
+                    Text(text = e.note, fontSize = 12.sp, color = TextSecondary)
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = ears::readNow, enabled = !e.listening) { Text(if (e.listening) "Listening" else "READ IT") }
+            },
+            dismissButton = { TextButton(onClick = ears::cancelEnrolment, enabled = !e.listening) { Text("Stop") } }
+        )
+    }
+}
