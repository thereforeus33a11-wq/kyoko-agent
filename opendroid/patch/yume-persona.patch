+package com.opendroid.ai.core.life.eyes
+
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Base64
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * The in-app probes: one test picture made by the app and one fixed question, and nothing
+ * else; what each answer says; what is kept; that a picture is never sent on a route that is
+ * called encrypted (Venice documents no encrypted picture part); and that TEE-only mode is
+ * asked in the clear and recorded as that.
+ */
+class SightProbeTest {
+
+    private val settings = AtomicReference(
+        HerBrain.move(
+            BuildDefaults.fresh().copy(apiKeys = mapOf(BuildDefaults.PROVIDER to "his-venice-key"), wakePhrases = "hey Ren SENTINEL")
+        )
+    )
+    private val asked = CopyOnWriteArrayList<LLMRequest>()
+    private val posted = CopyOnWriteArrayList<Triple<String, String, String>>()
+    private var reply: () -> String = { "Red and blue." }
+    private var postAnswer: Pair<Int, String> = 200 to """{"choices":[{"message":{"content":"red, blue"}}]}"""
+
+    private fun prober() = SightProber(
+        settings = { settings.get() },
+        save = { update -> settings.set(update(settings.get())) },
+        complete = { _, request ->
+            asked += request
+            LLMResponse(reply(), 10, "m", "p", 1L)
+        },
+        post = { url, key, body ->
+            posted += Triple(url, key, body)
+            postAnswer
+        },
+        clock = { 77L }
+    )
+
+    @Test
+    fun `the test picture is a real small JPEG made by the app`() {
+        val bytes = Base64.getDecoder().decode(SightProbe.TEST_JPEG)
+        assertEquals(0xFF.toByte(), bytes[0])
+        assertEquals(0xD8.toByte(), bytes[1])
+        assertTrue(bytes.size in 200..4000)
+    }
+
+    @Test
+    fun `the probe of her brain is the test picture and one question on her route, and its answer is kept`() = runBlocking {
+        val record = prober().probeBrain()
+        assertEquals(SightProbe.Result.SEES, record.result)
+        assertEquals(VenicePrivateTier.SEEING_BRAIN, record.model)
+        val request = asked.single()
+        assertEquals(SightProbe.SYSTEM, request.systemPrompt)
+        assertEquals(SightProbe.QUESTION, request.messages.single().text)
+        assertEquals(SightProbe.TEST_JPEG, request.messages.single().imageBase64)
+        assertEquals(VenicePrivateTier.SEEING_BRAIN, request.modelOverride)
+        assertFalse((request.systemPrompt + request.messages.single().text).contains("Ren"))
+        assertEquals(record, SightProbe.recorded(settings.get(), SightProbe.Probe.BRAIN))
+        assertFalse(SightProbe.brainBlind(settings.get()))
+        assertTrue(SightProbe.lines(settings.get()).first().contains("took the test picture and named its colours"))
+    }
+
+    @Test
+    fun `an answer that names no colour, or a picture turned down, marks her brain blind`() = runBlocking {
+        reply = { "I'm not able to see images." }
+        assertEquals(SightProbe.Result.NOT_SEEN, prober().probeBrain().result)
+        assertTrue(SightProbe.brainBlind(settings.get()))
