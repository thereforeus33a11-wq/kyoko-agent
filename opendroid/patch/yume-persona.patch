+/**
+ * The texts of the privacy card that speak of her. With [hers] false (the app runs as
+ * stock: no card, or the switch off) they speak of the app alone, since there is then
+ * no card, no notebook and no reply route of hers to speak of.
+ */
+internal object PrivacyWording {
+    /** Said under the routes while he trusts Venice's Private tier for her ([LLMConfig.trustVenicePrivate]). */
+    const val PRIVATE_TIER_TRUSTED =
+        "You trust Venice's Private tier for her (HER OWN SENSES): a model of that tier at Venice counts as a private " +
+            "route, so it may run and nothing about you is held back from it. It is not end to end encrypted: Venice " +
+            "reads what it is sent to answer it, and says it keeps nothing."
+
+    fun mainRouteLabel(hers: Boolean): String = if (hers) "Your commands and plans" else "Commands, plans and replies"
+
+    fun plainHostedAllowed(hers: Boolean): String =
+        "A plain hosted model is allowed. Whoever hosts it can read what it is sent: the conversation" +
+            (if (hers) ", her card" else "") + " and, unless the switch below is on, your details."
+
+    /** Under "Only this phone or my own network". It speaks of models, which is what that choice decides. */
+    const val OWN_HARDWARE_ONLY =
+        "No model at a company is used: a model that is not on this phone or on your own network is refused " +
+            "before anything is sent to it."
+
+    /**
+     * Under "That, or end to end encrypted": what the phone checks about the key it
+     * encrypts to and what it takes on the host's word, as VeniceE2ee.modelKeyFromAttestation
+     * has it. A test holds these sentences against that code.
+     */
+    const val ENCRYPTED_ONLY =
+        "A model at a company is used only end to end encrypted (a model id starting with e2ee-): the prompt is " +
+            "encrypted on this phone to a key that Venice presents as the key of a sealed enclave running the " +
+            "model. The phone checks that the proof of that is fresh, names this model, carries this key and " +
+            "does not come from an enclave in debug mode. It does not check the hardware maker's signature on " +
+            "the proof, so that the key belongs to a real enclave rests on Venice's word: a Venice that set out " +
+            "to cheat could read the prompt. The only route that needs no such trust, and where nothing leaves " +
+            "at all, is your own hardware. A plain hosted model is refused before anything is sent."
+
+    /**
+     * What private mode keeps back, and from whom. The last sentence is the one thing it
+     * does on every route: his position is not handed to the geocoding service
+     * (DeviceStateProvider.lookupAllowedBy).
+     */
+    fun privateModeHint(hers: Boolean): String = if (hers) {
+        "Your date of birth, where you are, the text of your notifications, what the phone read out to you, what she has noted about you and her own thoughts are left out of anything sent to a model that can be read by its host. " +
+            "Noted about you means every note of hers that can be about you: her notes about you and about the two of you, her threads and opinions other than her street stories, any other note that speaks of you, and what she saw on your screen. " +
+            "On a private route (this phone, your own network, the end to end encrypted one, or Venice's Private tier while you trust it for her) she sees all of it. $POSITION_STAYS she gets it as coordinates rounded to about a kilometre."
+    } else {
+        "Your date of birth, where you are, the text of your notifications and what the phone read out to you are left out of anything sent to a model that can be read by its host. On a private route (this phone, your own network, the end to end encrypted one, or Venice's Private tier while you trust it for her) the model gets all of it. $POSITION_STAYS the model gets it as coordinates rounded to about a kilometre."
+    }
+
+    private const val POSITION_STAYS =
+        "While this is on, your position is also not sent to the phone's geocoding service to be turned into a " +
+            "place name: on a private route"
+
+    /**
+     * What private mode does not keep back: a screen he asks to have read. The app's
+     * screen reader (VisionEngine) sends the screenshot, or the text on the screen, to
+     * the main model and reads no setting, and a model of hers that is shown screenshots
+     * gets the screenshot with his message whatever her route holds back
+     * (PersonaEngine.imagesReachChatModel). Said at the switch, because the hint above
+     * it speaks of "anything sent" to a readable host, and what is on a screen can be
+     * the text of a notification.
+     */
+    fun screenOnRequest(hers: Boolean): String =
+        "This switch does not keep back a screen you ask to have read: \"read my screen\" sends the screenshot, " +
+            "or the text on the screen, to the main model" +
+            (if (hers) ", or the screenshot to her model when that is shown screenshots" else "") +
+            ", also when that is a plain hosted model." + OWN_CHAT_NOT_READ
+
+    fun storedOnThisPhone(hers: Boolean): String =
+        (if (hers) {
+            "Everything she knows is stored on this phone only: the chat, her notebook, her own thoughts, her files."
+        } else {
+            "The chat and what the app has stored about you are on this phone only."
+        }) + " Backups to the cloud are switched off for this app. An ElevenLabs voice sends each line it speaks to ElevenLabs, so it is used only when plain hosted models are allowed, and while the switch above is on " +
+            (if (hers) "only for her own lines, and only when those come from a plain hosted model" else "not at all") +
+            "; everything else is said by the phone's own voice."
+
+    /**
+     * Where what he says is turned into text, from what the phone offers ([onDevice]:
+     * Android's on-device recogniser is there; [anyRecogniser]: a speech service is
+     * installed at all) and from whether the online recogniser may be used
+     * ([cloudAllowed], PreferredRecognizer.cloudAllowed). Worded from the order of
+     * choices in PreferredRecognizer; a test holds it against that code.
+     */
+    fun voiceInput(onDevice: Boolean, anyRecogniser: Boolean, cloudAllowed: Boolean): String {
+        if (!anyRecogniser) {
+            return if (onDevice) {
+                "Voice input: speech is turned into text by Android's on-device recogniser, on this phone. " +
+                    "It is the only recogniser here: where it does not have your language there is no voice input."
+            } else {
+                "Voice input: this phone has no speech recogniser, so there is no voice input and no wake phrase."
+            }
+        }
+        val first = if (onDevice) {
+            "Voice input: this phone has Android's on-device recogniser, which turns speech into text on the " +
+                "phone, and it is used first. Where it does not have your language, the phone's speech service " +
+                "is asked to work offline instead."
+        } else {
+            "Voice input: this phone has no on-device recogniser of Android's (Android 12 and later can have " +
+                "one), so the phone's speech service is asked to work offline."
+        }
+        val request = " That is a request the speech service can ignore: whether it keeps to it is up to its maker."
+        val last = if (cloudAllowed) {
+            " When the service answers that it cannot work offline, it is asked again without the request, and " +
+                "what you say can then go to its maker's servers. In wake-word mode that is the sound of the room."
+        } else {
+            " When the service answers that it cannot work offline, voice input stops and says so. It is asked " +
+                "without the request only when \"$ROUTE_POLICY_ANY_LABEL\" is chosen above."
+        }
+        return first + request + last
+    }
+}
