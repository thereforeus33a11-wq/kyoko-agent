+
+    // ── The glance ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the glance looks as far as the feeds that came in, and no further when none did`() {
+        val sinces = CopyOnWriteArrayList<Long>()
+        var look = Glance.Look(emptyList(), null)
+        val glancing = OutingHost(
+            mind, sources, { OutgoingGuard.His("Ren Mizuno") }, ledger, log, herNow, life,
+            { _, since -> sinces += since; look }, { Feeds.DEFAULTS }, { power }, { now.get() }, { now.addAndGet(it) }, scope
+        )
+        val config = LLMConfig(personaOwnLife = true)
+        runBlocking {
+            // Nothing came in: the next glance still asks from where she last really looked.
+            assertEquals(emptyList<Glance.Headline>(), glancing.glance(config, 1_000L))
+            assertEquals(emptyList<Glance.Headline>(), glancing.glance(config, 2_000L))
