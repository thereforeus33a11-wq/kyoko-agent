+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/SherpaHearing.kt
@@ -0,0 +1,518 @@
+package com.opendroid.ai.core.life.ears
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.pm.PackageManager
+import android.media.AudioFormat
+import android.media.AudioManager
+import android.media.AudioRecord
+import android.media.AudioRecordingConfiguration
+import android.media.MediaRecorder
+import android.media.audiofx.AcousticEchoCanceler
+import android.media.audiofx.NoiseSuppressor
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.Process
+import android.util.Log
+import androidx.core.content.ContextCompat
+import com.opendroid.ai.core.voice.VoiceOut
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her ears on sherpa-onnx (OWN_LIFE_PLAN phase 3, PRESENCE_PLAN §2): the microphone read at
+ * 16 kHz from the voice-communication source, with Android's echo canceller and noise
+ * suppressor where the phone has them (else the voice-recognition source), Silero VAD on
+ * every frame, and the recogniser only on speech ([SherpaPipeline]), with how it sounded
+ * ([HowItSounded]) measured against his usual ([SoundUsual]). Beside the VAD a [SoundGate]
+ * catches the sounds that are not speech (a laugh, a cough), for the recogniser to name. The
+ * models are loaded when the ears open and let go of when they close.
+ *
+ * The phone's own voice is not taken for his: what falls while it speaks, or just after, is
+ * cut away, and a transcript that reads like a line it just said is dropped ([VoiceOut],
+ * [HearingRules]). Where the echo canceller is on, his voice coming in over hers for
+ * [HearingRules.BARGE_IN_MILLIS] cuts her off ([HearingEngine.Listener.overHer]); with his
+ * voice enrolled, only his voice does.
+ *
+ * Nothing it hears is written anywhere (I6): samples stay in memory and are zeroed once
+ * done with, and what was heard goes only to the listener. The one thing kept is how he
+ * usually sounds (a few numbers: level, pitch, pace), sealed with his voiceprint.
+ *
+ * The engine does not decide when the ears may be open (her own life and the open-mic
+ * setting on, awake, the service holding the microphone type, the battery): whoever opens
+ * it does.
+ */
+@Singleton
+class SherpaHearing @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val models: EarsModelStore,
+    private val prints: VoicePrintStore,
+) : HearingEngine {
+
+    /** Which recogniser to load the next time the ears open (`personaEarsModel`). */
+    @Volatile var recognizer: EarsModels.Recognizer = EarsModels.Recognizer.SENSE_VOICE
+
+    /**
+     * Whether another voice than his is written down (`personaEarsOthersMayTalk`). With no
+     * voice of his enrolled, every voice is, since nobody's can be told apart.
+     */
+    @Volatile var othersMayTalk: () -> Boolean = { false }
+
+    /**
+     * Whether his speech itself is kept with what is heard ([Heard.clip]), for a model of hers
+     * that hears (`personaChatHearsAudio`). Off: only the words and how they sounded.
+     */
+    @Volatile var keepClips: Boolean = false
+
+    /** Whether the phone cancels its own echo on the microphone now: known once the ears are open. */
+    @Volatile var echoCancelled: Boolean = false
+        private set
+
+    private val lock = Any()
+    @Volatile private var session: Session? = null
+
+    override val isOpen: Boolean get() = session?.let { !it.closing } ?: false
+
+    override fun open(listener: HearingEngine.Listener): HearingEngine.Closed? {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            return HearingEngine.Closed.NO_PERMISSION
+        }
+        val choice = recognizer
+        if (!models.ready(choice)) return HearingEngine.Closed.NO_MODELS
+        synchronized(lock) {
+            // Already open: the newest listener is the one told from now on.
+            session?.takeIf { !it.closing }?.let {
+                it.listener = listener
+                return null
+            }
+            val previous = session
+            val s = Session(listener, choice, previous)
+            session = s
+            s.start()
+        }
+        return null
+    }
+
+    override fun pause() {
+        session?.setPaused(true)
+    }
+
+    override fun resume() {
+        session?.setPaused(false)
+    }
+
+    override fun close() {
+        synchronized(lock) { session?.close() }
+    }
+
+    /** His voiceprint was saved or forgotten: an open session reads it again. */
+    fun printChanged() {
+        session?.reloadPrint = true
+    }
+
+    /**
+     * Listens for one take of his enrolment, up to [maxMillis]: the speech heard until he
+     * has read for [VoiceEnrolment.MIN_TAKE_MILLIS] and then paused for [TAKE_END_PAUSE_MILLIS].
+     * While a take is under way the ears hand nothing else on. Opens the microphone for it
+     * if the ears are closed, and closes it again after. Null when the microphone or the
+     * models cannot be had. Nothing of the take is kept but what comes back.
+     */
+    suspend fun takeForEnrolment(maxMillis: Long = 15_000): SherpaPipeline.EnrolSample? {
+        val quiet = object : HearingEngine.Listener {
+            override fun heard(heard: Heard) = Unit
+        }
+        val opened = if (isOpen) false else {
+            if (open(quiet) != null) return null
+            true
+        }
+        try {
+            val s = session ?: return null
+            val take = Take()
+            s.take = take
+            val speech = withTimeoutOrNull(maxMillis) { take.done.await() } ?: s.endTake()
+            s.take = null
+            if (speech == null || speech.isEmpty()) return null
+            return withContext(Dispatchers.IO) { s.enrol(speech) }
+        } finally {
+            session?.take = null
+            // Closed again only if nobody opened the ears for her in the meantime.
+            if (opened && session?.listener === quiet) close()
+        }
+    }
+
+    /** One take being collected by the capture thread. */
+    private class Take {
+        val parts = ArrayList<FloatArray>()
+        var speechMillis = 0L
+        var lastEnd = 0L
+        val done = CompletableDeferred<FloatArray>()
+
+        fun joined(): FloatArray {
+            val out = FloatArray(parts.sumOf { it.size })
+            var at = 0
+            for (p in parts) {
+                p.copyInto(out, at)
+                at += p.size
+                p.fill(0f)
+            }
+            parts.clear()
+            return out
+        }
+    }
+
+    /** One opening of the ears: the capture thread, the thread that writes words, and the models. */
+    private inner class Session(
+        @Volatile var listener: HearingEngine.Listener,
+        private val choice: EarsModels.Recognizer,
+        private val previous: Session?,
+    ) {
+        @Volatile var closing = false
+        @Volatile private var paused = false
+        @Volatile var reloadPrint = true
+        @Volatile var take: Take? = null
+        @Volatile private var print: VoicePrint? = null
+        // How he usually sounds, learned on as the ears hear him; the words thread's.
+        @Volatile private var usual: SoundUsual? = null
+        @Volatile private var usualKept = 0
+        @Volatile private var pipeline: SherpaPipeline? = null
+        private val gate = SoundGate()
+        @Volatile private var silenced = false
+        private val words: ExecutorService = Executors.newSingleThreadExecutor { r -> Thread(r, "HerEars-words") }
+        private val pending = AtomicInteger()
+        private val barge = HearingRules.BargeIn()
+        private val main = Handler(Looper.getMainLooper())
+        private var record: AudioRecord? = null
+        private val effects = ArrayList<android.media.audiofx.AudioEffect>()
+        private val thread = Thread({ run() }, "HerEars-capture")
+
+        fun start() = thread.start()
+
+        fun close() {
+            closing = true
+        }
+
+        fun setPaused(p: Boolean) {
+            paused = p
+        }
+
+        fun endTake(): FloatArray? {
+            val t = take ?: return null
+            return synchronized(t) { if (t.parts.isEmpty()) null else t.joined() }
+        }
+
+        fun enrol(speech: FloatArray): SherpaPipeline.EnrolSample? {
+            val p = pipeline ?: return null
+            return try {
+                words.submit<SherpaPipeline.EnrolSample> { p.enrolTake(speech) }.get(30, TimeUnit.SECONDS)
+            } catch (e: Exception) {
+                // The ears closed under the take, or it took too long: no take.
+                speech.fill(0f)
+                null
+            }
+        }
+
+        private fun run() {
+            previous?.thread?.join()
+            val am = context.getSystemService(AudioManager::class.java)
+            var callback: AudioManager.AudioRecordingCallback? = null
+            try {
+                val p = try {
+                    SherpaPipeline.load(models.root, choice)
+                } catch (t: Throwable) {
+                    Log.e(TAG, "Her ears could not load their models: ${t.javaClass.simpleName}")
+                    fail(HearingEngine.Closed.LOAD_FAILED)
+                    return
+                }
+                pipeline = p
+                if (closing) return
+                Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO)
+                val rec = openRecord() ?: run {
+                    fail(HearingEngine.Closed.MIC_UNAVAILABLE)
+                    return
+                }
+                record = rec
+                callback = watchSilencing(am, rec)
+                val shorts = ShortArray(SherpaPipeline.WINDOW)
+                val frame = FloatArray(SherpaPipeline.WINDOW)
+                rec.startRecording()
+                if (rec.recordingState != AudioRecord.RECORDSTATE_RECORDING) {
+                    fail(HearingEngine.Closed.MIC_UNAVAILABLE)
+                    return
+                }
+                while (!closing) {
+                    if (paused) {
+                        rec.stop()
+                        p.reset()
+                        gate.reset()
+                        barge.reset()
+                        // Push-to-talk or an approval listen has the microphone; it is a few seconds.
+                        while (paused && !closing) Thread.sleep(PAUSED_POLL_MILLIS)
+                        if (closing) break
+                        rec.startRecording()
+                        continue
+                    }
+                    if (reloadPrint) {
+                        reloadPrint = false
+                        val read = kotlinx.coroutines.runBlocking { prints.get() }
+                        print = read
+                        usual = read?.let { it.usual?.copy() ?: SoundUsual() }
+                        usualKept = usual?.learned ?: 0
+                    }
+                    val n = rec.read(shorts, 0, shorts.size)
+                    if (n < 0) {
+                        Log.w(TAG, "The microphone stopped giving sound ($n)")
+                        fail(HearingEngine.Closed.MIC_UNAVAILABLE)
+                        return
+                    }
+                    if (n == 0) continue
+                    val now = HearingRules.now()
+                    if (silenced) {
+                        // A call or another app holds the microphone: what comes is silence, and
+                        // nothing of it is listened to.
+                        p.reset()
+                        gate.reset()
+                        barge.reset()
+                        continue
+                    }
+                    val chunk = if (n == frame.size) frame else FloatArray(n)
+                    for (i in 0 until n) chunk[i] = shorts[i] / 32768f
+                    val segments = p.feed(chunk, now)
+                    val clip = gate.feed(chunk, now, p.speechNow())
+                    chunk.fill(0f)
+                    shorts.fill(0)
+                    bargeIn(p, now)
+                    for (s in segments) handle(p, s)
+                    clip?.let { handleSound(p, it) }
+                    take?.let { checkTake(it, p, now) }
+                }
+            } catch (t: Throwable) {
+                Log.e(TAG, "Her ears stopped: ${t.javaClass.simpleName}")
+                fail(HearingEngine.Closed.MIC_UNAVAILABLE)
+            } finally {
+                callback?.let { runCatching { am?.unregisterAudioRecordingCallback(it) } }
+                record?.let { r ->
+                    runCatching { r.stop() }
+                    r.release()
+                }
+                record = null
+                effects.forEach { runCatching { it.release() } }
+                effects.clear()
+                words.shutdown()
+                // The models are let go of only once nothing is using them: freed under a
+                // segment still being written down, the native side would crash.
+                val drained = runCatching { words.awaitTermination(60, TimeUnit.SECONDS) }.getOrDefault(false)
+                if (drained) {
+                    pipeline?.let { keepUsual(it.speakerModelId, force = true) }
+                    pipeline?.release()
+                } else {
+                    Log.w(TAG, "Her ears' models were left loaded: a segment never finished")
+                }
+                pipeline = null
+                print = null
+                usual = null
+                gate.reset()
+                take?.done?.complete(FloatArray(0))
+                echoCancelled = false
+                synchronized(lock) { if (session === this) session = null }
+            }
+        }
+
+        @SuppressLint("MissingPermission")
+        private fun openRecord(): AudioRecord? {
+            val minBuffer = AudioRecord.getMinBufferSize(SherpaPipeline.SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+            if (minBuffer <= 0) return null
+            // Two seconds of room, so a slow word does not lose sound while the next frame waits.
+            val size = maxOf(minBuffer, SherpaPipeline.SAMPLE_RATE * 2 * 2)
+            for (source in listOf(MediaRecorder.AudioSource.VOICE_COMMUNICATION, MediaRecorder.AudioSource.VOICE_RECOGNITION)) {
+                val rec = try {
+                    AudioRecord(source, SherpaPipeline.SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, size)
+                } catch (e: Exception) {
+                    null
+                } ?: continue
+                if (rec.state != AudioRecord.STATE_INITIALIZED) {
+                    rec.release()
+                    continue
+                }
+                if (source == MediaRecorder.AudioSource.VOICE_COMMUNICATION) {
+                    if (AcousticEchoCanceler.isAvailable()) {
+                        AcousticEchoCanceler.create(rec.audioSessionId)?.let { aec ->
+                            runCatching { aec.enabled = true }
+                            effects += aec
+                            echoCancelled = aec.enabled
+                        }
+                    }
+                    if (NoiseSuppressor.isAvailable()) {
+                        NoiseSuppressor.create(rec.audioSessionId)?.let { ns ->
+                            runCatching { ns.enabled = true }
+                            effects += ns
+                        }
+                    }
+                }
+                Log.i(TAG, "Her ears: source=$source echo cancelled=$echoCancelled")
+                return rec
+            }
+            return null
+        }
+
+        /** Android silences this app's recording while a call or a privileged app holds the microphone (API 29+). */
+        private fun watchSilencing(am: AudioManager?, rec: AudioRecord): AudioManager.AudioRecordingCallback? {
+            if (am == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return null
+            val cb = object : AudioManager.AudioRecordingCallback() {
+                override fun onRecordingConfigChanged(configs: MutableList<AudioRecordingConfiguration>) {
+                    val mine = configs.firstOrNull { it.clientAudioSessionId == rec.audioSessionId } ?: return
+                    val now = mine.isClientSilenced
+                    if (now != silenced) {
+                        silenced = now
+                        if (!closing) listener.silenced(now)
+                    }
+                }
+            }
+            am.registerAudioRecordingCallback(cb, main)
+            return cb
+        }
+
+        private fun bargeIn(p: SherpaPipeline, now: Long) {
+            val playingSince = VoiceOut.playingSince()
+            val from = barge.step(now, playingSince, p.speechNow(), echoCancelled) ?: return
+            if (playingSince == null) return
+            if (p.overHerVoice(print, now - from)) {
+                barge.confirmed(playingSince)
+                VoiceOut.cutByHim(from - HearingRules.ONSET_MILLIS)
+                if (!closing) listener.overHer()
+            } else {
+                barge.vetoed(now)
+            }
+        }
+
+        private fun handle(p: SherpaPipeline, s: SherpaPipeline.Segment) {
+            val t = take
+            if (t != null) {
+                // His enrolment takes every segment: nothing else is listened to meanwhile.
+                synchronized(t) {
+                    t.parts += s.samples.copyOf()
+                    t.speechMillis += s.millis
+                    t.lastEnd = s.endedAt
+                }
+                s.samples.fill(0f)
+                return
+            }
+            if (pending.get() >= MAX_PENDING) {
+                s.samples.fill(0f)
+                if (!closing) listener.dropped(Dropped.BUSY, s.millis)
+                return
+            }
+            pending.incrementAndGet()
+            val transcribeOthers = othersMayTalk()
+            val current = print
+            val his = usual
+            words.execute {
+                try {
+                    if (closing) {
+                        s.samples.fill(0f)
+                        return@execute
+                    }
+                    val spells = VoiceOut.since(s.startedAt - HearingRules.ECHO_TEXT_MILLIS)
+                    val overHer = HearingRules.cutHerOff(s.startedAt, s.endedAt, spells)
+                    tell(p.hear(s, current, transcribeOthers, spells, overHer, his, keepClip = keepClips))
+                    keepUsual(p.speakerModelId, force = false)
+                } catch (t: Throwable) {
+                    s.samples.fill(0f)
+                    Log.w(TAG, "A stretch of speech could not be written down: ${t.javaClass.simpleName}")
+                } finally {
+                    pending.decrementAndGet()
+                }
+            }
+        }
+
+        /** A sound the gate cut out: named by the recogniser, or let go. Never during an enrolment take. */
+        private fun handleSound(p: SherpaPipeline, clip: SoundGate.Clip) {
+            if (take != null || pending.get() >= MAX_PENDING) {
+                clip.samples.fill(0f)
+                return
+            }
+            pending.incrementAndGet()
+            val transcribeOthers = othersMayTalk()
+            val current = print
+            val his = usual
+            words.execute {
+                try {
+                    if (closing) {
+                        clip.samples.fill(0f)
+                        return@execute
+                    }
+                    val spells = VoiceOut.since(clip.startedAt - HearingRules.ECHO_TEXT_MILLIS)
+                    tell(p.hearSound(clip, current, transcribeOthers, spells, his))
+                } catch (t: Throwable) {
+                    clip.samples.fill(0f)
+                    Log.w(TAG, "A sound could not be named: ${t.javaClass.simpleName}")
+                } finally {
+                    pending.decrementAndGet()
+                }
+            }
+        }
+
+        private fun tell(out: SherpaPipeline.Outcome) {
+            if (closing) return
+            when (out) {
+                is SherpaPipeline.Outcome.Kept -> listener.heard(out.heard)
+                is SherpaPipeline.Outcome.Let -> listener.dropped(out.why, out.millis)
+            }
+        }
+
+        /**
+         * Keeps how he usually sounds with his print, once it has learned [KEEP_USUAL_EVERY]
+         * more stretches of his voice, or whatever it learned when the ears close ([force]).
+         */
+        private fun keepUsual(modelId: String, force: Boolean) {
+            val u = usual ?: return
+            val more = u.learned - usualKept
+            if (more <= 0 || (!force && more < KEEP_USUAL_EVERY)) return
+            val learnedWith = print ?: return
+            usualKept = u.learned
+            runCatching { kotlinx.coroutines.runBlocking { prints.keepUsual(modelId, u, of = learnedWith) } }
+                .onFailure { Log.w(TAG, "How he usually sounds could not be kept: ${it.javaClass.simpleName}") }
+        }
+
+        private fun checkTake(t: Take, p: SherpaPipeline, now: Long) {
+            val ready = synchronized(t) {
+                t.speechMillis >= VoiceEnrolment.MIN_TAKE_MILLIS && !p.speechNow() && now - t.lastEnd >= TAKE_END_PAUSE_MILLIS
+            }
+            if (ready && !t.done.isCompleted) {
+                val joined = synchronized(t) { t.joined() }
+                t.done.complete(joined)
+            }
+        }
+
+        private fun fail(why: HearingEngine.Closed) {
+            val wasClosing = closing
+            closing = true
+            if (!wasClosing) listener.failed(why)
+        }
+    }
+
+    companion object {
+        private const val TAG = "HerEars"
+
+        /** Speech waiting to be written down past this is let go of (counted as [Dropped.BUSY]). */
+        const val MAX_PENDING = 3
+
+        /** A take of his enrolment ends this long after he stops reading. */
+        const val TAKE_END_PAUSE_MILLIS = 1_200L
+
+        /** How he usually sounds is kept again after this many more stretches of his voice. */
+        const val KEEP_USUAL_EVERY = 25
+
+        private const val PAUSED_POLL_MILLIS = 50L
+    }
+}
