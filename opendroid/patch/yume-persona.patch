+/** CMU pronunciations (ARPAbet) to katakana, as a Japanese speaker would say the word. */
+object Arpabet {
+
+    private val VOWELS = setOf("AA", "AE", "AH", "AO", "AW", "AY", "EH", "ER", "EY", "IH", "IY", "OW", "OY", "UH", "UW")
+
+    // Kana for consonant + vowel row (a i u e o).
+    private val ROWS: Map<String, List<String>> = mapOf(
+        "" to listOf("ア", "イ", "ウ", "エ", "オ"),
+        "K" to listOf("カ", "キ", "ク", "ケ", "コ"), "G" to listOf("ガ", "ギ", "グ", "ゲ", "ゴ"),
+        "S" to listOf("サ", "シ", "ス", "セ", "ソ"), "Z" to listOf("ザ", "ジ", "ズ", "ゼ", "ゾ"),
+        "SH" to listOf("シャ", "シ", "シュ", "シェ", "ショ"), "ZH" to listOf("ジャ", "ジ", "ジュ", "ジェ", "ジョ"),
+        "CH" to listOf("チャ", "チ", "チュ", "チェ", "チョ"), "JH" to listOf("ジャ", "ジ", "ジュ", "ジェ", "ジョ"),
+        "T" to listOf("タ", "ティ", "トゥ", "テ", "ト"), "D" to listOf("ダ", "ディ", "ドゥ", "デ", "ド"),
+        "TH" to listOf("サ", "シ", "ス", "セ", "ソ"), "DH" to listOf("ザ", "ジ", "ズ", "ゼ", "ゾ"),
+        "N" to listOf("ナ", "ニ", "ヌ", "ネ", "ノ"), "M" to listOf("マ", "ミ", "ム", "メ", "モ"),
+        "HH" to listOf("ハ", "ヒ", "フ", "ヘ", "ホ"), "F" to listOf("ファ", "フィ", "フ", "フェ", "フォ"),
+        "V" to listOf("バ", "ビ", "ブ", "ベ", "ボ"), "B" to listOf("バ", "ビ", "ブ", "ベ", "ボ"),
+        "P" to listOf("パ", "ピ", "プ", "ペ", "ポ"), "L" to listOf("ラ", "リ", "ル", "レ", "ロ"),
+        "R" to listOf("ラ", "リ", "ル", "レ", "ロ"), "W" to listOf("ワ", "ウィ", "ウ", "ウェ", "ウォ"),
+        "Y" to listOf("ヤ", "イ", "ユ", "イェ", "ヨ"), "NG" to listOf("ンガ", "ンギ", "ング", "ンゲ", "ンゴ")
+    )
+
+    // A consonant with no vowel after it, with the vowel Japanese puts there.
+    private val CODA: Map<String, String> = mapOf(
+        "K" to "ク", "G" to "グ", "S" to "ス", "Z" to "ズ", "SH" to "シュ", "ZH" to "ジュ", "CH" to "チ",
+        "JH" to "ジ", "T" to "ト", "D" to "ド", "TH" to "ス", "DH" to "ズ", "N" to "ン", "M" to "ム",
+        "HH" to "", "F" to "フ", "V" to "ブ", "B" to "ブ", "P" to "プ", "L" to "ル", "R" to "ル",
+        "W" to "ウ", "Y" to "イ", "NG" to "ング"
+    )
+
+    private val SMALL = mapOf(0 to "ャ", 2 to "ュ", 3 to "ェ", 4 to "ョ")
+    private val SHORT_VOWELS = setOf("AA", "AE", "AH", "EH", "IH", "UH", "AO")
+    private val GEMINATING = setOf("P", "T", "K", "CH", "JH", "D", "G")
+
+    /** [phones] like "S M OW1 K" (stress digits allowed); [spelling] helps with a few vowels. */
+    fun toKatakana(phones: List<String>, spelling: String = ""): String {
+        // An r-coloured vowel before another vowel is "a" plus an r that starts the next
+        // syllable: cigarette S IH G ER EH T is shi-ga-re-tto, not shi-ga-e-tto.
+        val split = mutableListOf<String>()
+        for ((k, p) in phones.withIndex()) {
+            val base = p.trimEnd('0', '1', '2')
+            val next = phones.getOrNull(k + 1)?.trimEnd('0', '1', '2')
+            if (base == "ER" && next != null && next in VOWELS) {
+                split += "AH" + p.drop(2)
+                split += "R"
+            } else {
+                split += p
+            }
+        }
+        val ph = split.map { it.trimEnd('0', '1', '2') }
+        val stress = split.map { p -> p.lastOrNull()?.takeIf { it.isDigit() }?.digitToInt() ?: -1 }
+        val out = StringBuilder()
+        var i = 0
+        while (i < ph.size) {
+            val p = ph[i]
+            if (p in VOWELS) {
+                appendVowel(out, "", ph, stress, i, spelling)
+                i++
+                continue
+            }
+            val next = ph.getOrNull(i + 1)
+            // Consonant + Y + vowel: palatal (cute キュート, music ミュージック).
+            if (next == "Y" && p != "Y" && ph.getOrNull(i + 2) in VOWELS && p in ROWS) {
+                val v = ph[i + 2]
+                val row = row(v, spelling)
+                val iKana = ROWS.getValue(p)[1]
+                out.append(if (row == 1) iKana else iKana + (SMALL[row] ?: ""))
+                appendVowelTail(out, ph, stress, i + 2)
+                i += 3
+                continue
+            }
+            if (next != null && next in VOWELS) {
+                appendVowel(out, p, ph, stress, i + 1, spelling)
+                i += 2
+                continue
+            }
+            // T S and D Z with no vowel after them are one sound: it's イッツ, kids キッズ.
+            if (((p == "T" && next == "S") || (p == "D" && next == "Z")) && ph.getOrNull(i + 2) !in VOWELS) {
+                if (i > 0 && ph[i - 1] in SHORT_VOWELS) out.append("ッ")
+                out.append(if (p == "T") "ツ" else "ズ")
+                i += 2
+                continue
+            }
+            // A consonant with no vowel after it.
+            val wordFinal = next == null
+            when {
+                p == "R" && i > 0 && ph[i - 1] in VOWELS -> if (!out.endsWith("ー")) out.append("ー")
+                p == "M" && next in setOf("B", "P", "M") -> out.append("ン")
+                p == "NG" && next in setOf("K", "G") -> out.append("ン")
+                else -> {
+                    if (wordFinal && p in GEMINATING && i > 0 && ph[i - 1] in SHORT_VOWELS) out.append("ッ")
+                    out.append(CODA[p] ?: "")
+                }
+            }
+            i++
+        }
+        return out.toString()
+    }
+
+    /** Which vowel row (a i u e o) an ARPAbet vowel starts in. */
+    private fun row(v: String, spelling: String): Int = when (v) {
+        "AA" -> if ('o' in spelling && 'a' !in spelling) 4 else 0
+        "AE", "AH", "AW", "AY", "ER" -> 0
+        "EH", "EY" -> 3
+        "IH", "IY" -> 1
+        "AO", "OW", "OY" -> 4
+        "UH", "UW" -> 2
+        else -> 0
+    }
+
+    private fun appendVowel(out: StringBuilder, consonant: String, ph: List<String>, stress: List<Int>, i: Int, spelling: String) {
+        val v = ph[i]
+        val r = row(v, spelling)
+        val kana = if (consonant in setOf("K", "G") && v == "AE") {
+            ROWS.getValue(consonant)[1] + "ャ"
+        } else {
+            (ROWS[consonant] ?: ROWS.getValue(""))[r]
+        }
+        out.append(kana)
+        appendVowelTail(out, ph, stress, i)
+    }
+
+    /** The second half of a long vowel or a diphthong. */
+    private fun appendVowelTail(out: StringBuilder, ph: List<String>, stress: List<Int>, i: Int) {
+        val v = ph[i]
+        val final = i == ph.size - 1
+        val stressed = stress[i] >= 1
+        val nextIsVowel = ph.getOrNull(i + 1) in VOWELS
+        when (v) {
+            "AW" -> out.append("ウ")
+            "AY", "OY" -> out.append("イ")
+            "EY" -> out.append(if (final || nextIsVowel) "イ" else "ー")
+            "ER" -> if (!nextIsVowel) out.append("ー")
+            "IY", "UW", "OW" -> if (stressed || final) out.append("ー")
+            "AO" -> if (stressed && (final || nextIsVowel)) out.append("ー")
+        }
+    }
+}
+
+/** Romaji (Hepburn and the common chat spellings) to kana. */
+object Romaji {
+
+    private val TABLE: Map<String, String> = buildMap {
+        val rows = mapOf(
+            "" to "あいうえお", "k" to "かきくけこ", "s" to "さしすせそ", "t" to "たちつてと", "n" to "なにぬねの",
+            "h" to "はひふへほ", "m" to "まみむめも", "r" to "らりるれろ", "g" to "がぎぐげご", "z" to "ざじずぜぞ",
+            "d" to "だぢづでど", "b" to "ばびぶべぼ", "p" to "ぱぴぷぺぽ"
+        )
+        for ((c, kana) in rows) for ((k, v) in "aiueo".withIndex()) put(c + v, kana[k].toString())
+        putAll(mapOf(
+            "ya" to "や", "yu" to "ゆ", "yo" to "よ", "wa" to "わ", "wo" to "を", "shi" to "し", "chi" to "ち",
+            "tsu" to "つ", "fu" to "ふ", "ji" to "じ", "di" to "でぃ", "du" to "どぅ", "ti" to "てぃ",
+            "si" to "し", "zi" to "じ", "tu" to "つ", "hu" to "ふ",
+            "fa" to "ふぁ", "fi" to "ふぃ", "fe" to "ふぇ", "fo" to "ふぉ", "je" to "じぇ", "she" to "しぇ",
+            "che" to "ちぇ", "ye" to "いぇ", "wi" to "うぃ", "we" to "うぇ", "va" to "ゔぁ", "vi" to "ゔぃ",
+            "vu" to "ゔ", "ve" to "ゔぇ", "vo" to "ゔぉ"
+        ))
+        for ((c, i) in listOf("k" to "き", "g" to "ぎ", "n" to "に", "h" to "ひ", "m" to "み", "r" to "り",
+                              "b" to "び", "p" to "ぴ", "d" to "ぢ")) {
+            put(c + "ya", i + "ゃ"); put(c + "yu", i + "ゅ"); put(c + "yo", i + "ょ")
+        }
+        for ((c, i) in listOf("sh" to "し", "ch" to "ち", "j" to "じ")) {
+            put(c + "a", i + "ゃ"); put(c + "u", i + "ゅ"); put(c + "o", i + "ょ")
+        }
+        put("jya", "じゃ"); put("jyu", "じゅ"); put("jyo", "じょ")
+    }
+    private val MAX_KEY = TABLE.keys.maxOf { it.length }
+    private const val CONSONANTS = "bcdfghjkmnprstvwyz"
+
+    /** Strict: the whole word must read as romaji, or null. */
+    fun toHiragana(word: String): String? = parse(word, loose = false)
+
+    /** Loose, for a word that is neither English nor romaji (a name): katakana, best effort. */
+    fun toKatakanaLoose(word: String): String =
+        (parse(word, loose = true) ?: "").map { c -> if (c in 'ぁ'..'ゖ') c + 0x60 else c }.joinToString("")
+
+    private fun parse(word: String, loose: Boolean): String? {
+        val out = StringBuilder()
+        var i = 0
+        while (i < word.length) {
+            val c = word[i]
+            if (c == '-' || c == '~') { out.append('ー'); i++; continue }
+            // Doubled consonant: a small tsu (kitte, matcha via "tch").
+            if (i + 1 < word.length && c in CONSONANTS && c != 'n' &&
+                (word[i + 1] == c || (c == 't' && word[i + 1] == 'c'))) {
+                out.append('っ'); i++; continue
+            }
+            var matched = false
+            for (len in MAX_KEY downTo 1) {
+                if (i + len > word.length) continue
+                val kana = TABLE[word.substring(i, i + len)] ?: continue
+                out.append(kana); i += len; matched = true
+                break
+            }
+            if (matched) continue
+            if (c == 'n') {
+                // Syllabic n: at the end, before a consonant, or written n'.
+                out.append('ん'); i++
+                if (i < word.length && word[i] == '\'') i++
+                continue
+            }
+            if (!loose) return null
+            // Loose: a lone consonant takes the vowel Japanese gives it; a lone r after a
+            // vowel lengthens it (gunnar グンナー).
+            when {
+                c == 'r' && i > 0 && word[i - 1] in "aeiou" -> out.append('ー')
+                c == 't' || c == 'd' -> out.append(if (c == 't') 'と' else 'ど')
+                c in CONSONANTS || c in "lqx" -> TABLE[(if (c == 'l') 'r' else if (c == 'q') 'k' else if (c == 'x') 'k' else if (c == 'c') 'k' else c) + "u"]?.let { out.append(it) }
+                else -> Unit
+            }
+            i++
+        }
+        return out.toString()
+    }
+}
