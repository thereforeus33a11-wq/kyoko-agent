+++ b/app/src/test/java/com/opendroid/ai/core/voice/own/BilingualVoiceTest.kt
@@ -0,0 +1,219 @@
+package com.opendroid.ai.core.voice.own
+
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.cases
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.cmu
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.labelsOf
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.mixed
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.string
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.table
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Which way her own voice reads her English, by what its files say, and the guard on the
+ * phonemes it is given. Her voice today (yume-20261118-f037defb1012) learned Japanese
+ * phonemes only and must go on reading English as katakana, sounding exactly as it does;
+ * only a voice packed as bilingual by make_own_voice.sh reads English as English.
+ */
+class BilingualVoiceTest {
+
+    private val tableBytes = resource("own_voice/en_ipa_table.json")
+    private val tokensTxt = resource("own_voice/mixed/tokens.txt").decodeToString()
+
+    /**
+     * A config.json shaped like her voice's today: Piper's fields, Japanese phonemes, and no
+     * yume_english (the real one is not in the repository: it is part of her voice).
+     */
+    private val todaysConfig = """
+        {"audio": {"sample_rate": 22050}, "espeak": {"voice": "ja"}, "phoneme_type": "japanese",
+         "num_symbols": 256, "num_speakers": 1,
+         "inference": {"noise_scale": 0.667, "length_scale": 1.0, "noise_w": 0.8},
+         "phoneme_id_map": {"_": [0], "^": [1], "$": [2], " ": [3], "a": [14]},
+         "speaker_id_map": {}, "hop_length": 256, "default_speaker_id": 0, "piper_version": "1.5.0"}
+    """.trimIndent()
+
+    /** The same config as make_own_voice.sh writes it with ENGLISH_TABLE set. */
+    private fun bilingualConfig(sha: String = table.sha256, phonemes: String = "en_ipa_table") = """
+        {"audio": {"sample_rate": 22050}, "phoneme_type": "japanese",
+         "yume_english": {"phonemes": "$phonemes", "table": "${table.name}", "table_version": ${table.version},
+                          "table_sha256": "$sha"}}
+    """.trimIndent()
+
+    @Test
+    fun `her voice today reads English as katakana`() {
+        val reading = BilingualVoice.choose(todaysConfig, tableBytes, tokensTxt)
+        assertTrue(reading is BilingualVoice.Reading.Katakana)
+        // Not a fault: the voice simply knows Japanese phonemes only.
+        assertFalse((reading as BilingualVoice.Reading.Katakana).broken)
+        // Whatever else is or is not beside it.
+        assertTrue(BilingualVoice.choose(todaysConfig, null, null) is BilingualVoice.Reading.Katakana)
+    }
+
+    @Test
+    fun `the voice on this machine, when there is one, reads as its files say`() {
+        // OWN_VOICE_DIR=<opendroid/own_voice> checks the real voice (never committed).
+        val dir = System.getenv("OWN_VOICE_DIR")?.let(::File)
+        assumeTrue(dir != null && File(dir, "voice/config.json").exists())
+        val config = File(dir, "voice/config.json").readText()
+        val reading = BilingualVoice.choose(
+            config, File(dir, "en_ipa_table.json").takeIf { it.exists() }?.readBytes(),
+            File(dir, "voice/tokens.txt").takeIf { it.exists() }?.readText(),
+        )
+        val marked = Json.parseToJsonElement(config).jsonObject.containsKey(BilingualVoice.MARKER)
+        assertEquals(marked, reading is BilingualVoice.Reading.English)
+        if (File(dir, "VERSION").readText().trim() == "yume-20261118-f037defb1012") {
+            assertTrue(reading is BilingualVoice.Reading.Katakana)
+        }
+    }
+
+    @Test
+    fun `a voice packed as bilingual reads English as English`() {
+        val reading = BilingualVoice.choose(bilingualConfig(), tableBytes, tokensTxt)
+        assertTrue(reading is BilingualVoice.Reading.English)
+        val english = reading as BilingualVoice.Reading.English
+        assertEquals(table.sha256, english.table.sha256)
+        assertEquals(BilingualVoice.tokenCodepoints(tokensTxt), english.tokens)
+        // The digest may be written in capitals.
+        assertTrue(BilingualVoice.choose(bilingualConfig(table.sha256.uppercase()), tableBytes, tokensTxt) is BilingualVoice.Reading.English)
+    }
+
+    @Test
+    fun `files that disagree keep katakana, and say why`() {
+        fun broken(r: BilingualVoice.Reading) = r is BilingualVoice.Reading.Katakana && r.broken
+        // Another table than the one the voice was trained with.
+        assertTrue(broken(BilingualVoice.choose(bilingualConfig("0".repeat(64)), tableBytes, tokensTxt)))
+        val edited = tableBytes.decodeToString().replaceFirst("\"ɑː\"", "\"a\"").encodeToByteArray()
+        assertTrue(broken(BilingualVoice.choose(bilingualConfig(), edited, tokensTxt)))
+        // A voice trained with another table and packed with it, its files agreeing: still not
+        // a table this build's reader was checked against, so it is not read as English.
+        val packedWithEdited = BilingualVoice.choose(bilingualConfig(EnglishTable.sha256Hex(edited)), edited, tokensTxt)
+        assertTrue(broken(packedWithEdited))
+        assertTrue((packedWithEdited as BilingualVoice.Reading.Katakana).why.contains("not a table this build was checked against"))
+        // No table, no tokens, a way of reading this build does not know.
+        assertTrue(broken(BilingualVoice.choose(bilingualConfig(), null, tokensTxt)))
+        assertTrue(broken(BilingualVoice.choose(bilingualConfig(), tableBytes, null)))
+        assertTrue(broken(BilingualVoice.choose(bilingualConfig(phonemes = "espeak"), tableBytes, tokensTxt)))
+        assertTrue(broken(BilingualVoice.choose("""{"yume_english": true}""", tableBytes, tokensTxt)))
+        // A voice without a token the table can give (ɹ) is not the voice the table was trained into.
+        val noR = tokensTxt.lines().filterNot { it.startsWith("ɹ ") }.joinToString("\n")
+        val r = BilingualVoice.choose(bilingualConfig(), tableBytes, noR)
+        assertTrue(broken(r))
+        assertTrue((r as BilingualVoice.Reading.Katakana).why.contains("U+0279"))
+        // An unreadable config.json is not a bilingual one.
+        assertFalse(broken(BilingualVoice.choose("{not json", tableBytes, tokensTxt)))
+        assertTrue(BilingualVoice.choose("{not json", tableBytes, tokensTxt) is BilingualVoice.Reading.Katakana)
+    }
+
+    @Test
+    fun `tokens are read as sherpa-onnx and the training side read them`() {
+        val tokens = BilingualVoice.tokenCodepoints(tokensTxt)
+        assertEquals(161, tokensTxt.lines().count { it.isNotEmpty() })
+        assertEquals(161, tokens.size)
+        // The space token's line is "  3": its symbol is all before the last space.
+        assertTrue(' '.code in tokens)
+        assertTrue('ɡ'.code in tokens && 'ˈ'.code in tokens && '↓'.code in tokens)
+        assertEquals(setOf('a'.code), BilingualVoice.tokenCodepoints("a 14\r\nab 99\n\nnoid\n"))
+    }
+
+    @Test
+    fun `every phoneme of every fixture line is a token of the voice`() {
+        val tokens = BilingualVoice.tokenCodepoints(tokensTxt)
+        val missing = HashMap<Int, String>()
+        for (case in cases) {
+            val text = string(case, "text")
+            for (s in mixed.phonemize(text, labelsOf).orEmpty()) for (p in s) {
+                if (p.codePointAt(0) !in tokens) missing.putIfAbsent(p.codePointAt(0), text)
+            }
+        }
+        assertEquals("phonemes with no token, with a line that gives each", emptyMap<Int, String>(), missing)
+    }
+
+    @Test
+    fun `a phoneme the voice has no token for is left out, as in training`() {
+        val tokens = BilingualVoice.tokenCodepoints(tokensTxt) - 'ɹ'.code
+        val kept = BilingualVoice.keepKnown(listOf(listOf("ɹ", "ˈ", "ɛ", "d", "."), listOf("ɹ")), tokens)
+        assertEquals(setOf('ɹ'.code), kept.dropped)
+        // The second sentence had nothing else: it is not given at all.
+        assertEquals(1, kept.sentences.size)
+        assertArrayEquals("ˈɛd.".codePoints().toArray(), kept.sentences[0])
+        // Nothing to leave out: the phonemes go as they are.
+        val all = BilingualVoice.keepKnown(listOf(listOf("a", "↓")), BilingualVoice.tokenCodepoints(tokensTxt))
+        assertEquals(emptySet<Int>(), all.dropped)
+        assertArrayEquals(intArrayOf('a'.code, '↓'.code), all.sentences[0])
+    }
+
+    @Test
+    fun `the English reader gives the port's phonemes as codepoints, guarded by the tokens`() {
+        val tokens = BilingualVoice.tokenCodepoints(tokensTxt)
+        val fallback = LineReader { error("not used") }
+        val reader = LineReaders.english(mixed, tokens, labelsOf, fallback)
+        for (text in listOf("maji? that's crazy ne", "あんたってほんとに crazy だね", "okay, whatever.")) {
+            val want = mixed.phonemize(text, labelsOf)!!.map { s -> s.map { it.codePointAt(0) } }
+            assertEquals(text, want, reader.read(text)!!.map { it.toList() })
+        }
+        // A line her voice cannot read is not hers to say: another voice says it.
+        assertNull(reader.read("안녕"))
+        // A missing token is reported and left out.
+        val dropped = ArrayList<Set<Int>>()
+        val noR = LineReaders.english(mixed, tokens - 'ɹ'.code, labelsOf, fallback, onDropped = { dropped += it })
+        val crazy = noR.read("crazy")!!
+        assertFalse('ɹ'.code in crazy[0])
+        assertEquals(listOf(setOf('ɹ'.code)), dropped)
+    }
+
+    @Test
+    fun `a line the port fails on is still said in her voice, the katakana way`() {
+        val tokens = BilingualVoice.tokenCodepoints(tokensTxt)
+        val katakana = LineReader { listOf(intArrayOf('a'.code)) }
+        val errors = ArrayList<Exception>()
+        val reader = LineReaders.english(mixed, tokens, { throw IllegalStateException("labels broke") }, katakana, onError = { errors += it })
+        assertEquals(listOf(listOf('a'.code)), reader.read("ねえ")!!.map { it.toList() })
+        assertEquals(1, errors.size)
+    }
+
+    @Test
+    fun `the katakana reader is today's path, unchanged`() {
+        // One label set per sentence, of one mora each.
+        val sil = "xx^xx-sil+xx=xx/A:xx+xx+xx/F:xx_xx#xx_xx@xx_xx|xx_xx"
+        val labels = listOf(sil, "xx^sil-a+sil=xx/A:0+1+1/F:1_1#0_xx@1_1|1_1", sil)
+        val kana = KanaText { cmu[it] }
+        val reader = LineReaders.katakana(kana, { labels })
+        for (text in listOf("smoke? whatever. ねえ", "maji de, i love her", "5時に来て")) {
+            val want = JapanesePhonemes.phonemizeAll(kana.convert(text)) { labels }!!
+                .map { s -> s.map { it.codePointAt(0) } }
+            assertEquals(text, want, reader.read(text)!!.map { it.toList() })
+        }
+        assertNull(LineReaders.katakana(kana) { null }.read("ねえ"))
+    }
+
+    @Test
+    fun `pure Japanese reads the same on both paths, byte for byte`() {
+        // Piper's own phonemes for her Japanese lines (JapanesePhonemesTest's cases).
+        val ja = Json.parseToJsonElement(resource("own_voice/ja_phonemes.json").decodeToString()).jsonObject["cases"]!!.jsonArray
+        var checked = 0
+        for (case in ja.map { it.jsonObject }) {
+            val text = case["text"]!!.jsonPrimitive.content
+            if (text.any { it in 'a'..'z' || it in 'A'..'Z' }) continue
+            val sentences = case["sentences"]!!.jsonArray.map { it.jsonPrimitive.content }
+            val labels = case["labels"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            val bySentence = sentences.zip(labels).toMap()
+            val japanese = JapanesePhonemes.phonemizeAll(text) { bySentence[it] }
+            assertEquals(text, japanese, mixed.phonemize(text) { bySentence[it] })
+            checked++
+        }
+        assertTrue(checked >= 40)
+    }
+
+    private fun resource(name: String): ByteArray =
+        javaClass.classLoader!!.getResourceAsStream(name)!!.use { it.readBytes() }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/own/BreathingTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/own/BreathingTest.kt
new file mode 100644
index 0000000..ca93723
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/own/BreathingTest.kt
@@ -0,0 +1,198 @@
+package com.opendroid.ai.core.voice.own
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.pow
+import kotlin.math.sin
+import kotlin.math.sqrt
+import kotlin.random.Random
+
+/**
+ * Her breathing while she talks: only between sentences, only when her lungs need it, as
+ * quiet as her own breaths, never the same breath twice, and her voice falling a little
+ * across a breath.
+ */
+class BreathingTest {
+
+    @get:Rule val folder = TemporaryFolder()
+
+    private val rate = 22050
+
+    private fun noise(seconds: Float, seed: Int, amp: Float = 0.05f, sr: Int = rate): FloatArray {
+        val r = Random(seed)
+        return FloatArray((seconds * sr).toInt()) { (r.nextFloat() * 2 - 1) * amp }
+    }
+
+    private val bank = BreathBank(mapOf(
+        Breathing.Kind.CATCH to noise(0.26f, 1),
+        Breathing.Kind.SOFT to noise(0.28f, 2),
+        Breathing.Kind.QUICK to noise(0.31f, 3),
+        Breathing.Kind.DEEP to noise(0.65f, 4),
+    ))
+
+    /** A sentence of [seconds]: a steady voiced tone, about as loud as her speech. */
+    private fun sentence(seconds: Float) = FloatArray((seconds * rate).toInt()) { (0.3 * sin(2 * PI * 220 * it / rate)).toFloat() }
+
+    private var now = 1_000_000L
+    private fun breathing(seed: Int = 7) = Breathing(bank, rate, Random(seed)) { now }
+
+    /** Says sentences of these lengths as one line; what came before each. */
+    private fun say(b: Breathing, vararg seconds: Float): List<Pair<Breathing.Before, FloatArray>> {
+        val line = b.line(IntArray(seconds.size) { (seconds[it] / 0.075f).toInt() })
+        return seconds.map { line.next(sentence(it)) }.also { line.ended() }
+    }
+
+    @Test
+    fun `a short line is said on the air she has`() {
+        repeat(20) { seed ->
+            val out = say(breathing(seed), 0.6f, 0.5f)
+            assertEquals(Breathing.Before.Air, out[0].first)
+            assertTrue(out[1].first is Breathing.Before.Pause)
+            now += 60_000
+        }
+    }
+
+    @Test
+    fun `she breathes only between sentences, before her air would run out`() {
+        val lengths = floatArrayOf(1.5f, 1.4f, 1.6f, 1.2f, 1.5f, 1.7f, 1.3f, 1.4f)
+        val out = say(breathing(), *lengths)
+        var sinceBreath = 0f
+        var breaths = 0
+        out.forEachIndexed { i, (before, _) ->
+            if (before is Breathing.Before.Breath) { breaths++; sinceBreath = 0f }
+            sinceBreath += lengths[i]
+            // A group's air never goes past what one breath holds (one sentence may, alone).
+            assertTrue("group at sentence $i holds ${sinceBreath}s", Breathing.AIR_PER_SECOND * sinceBreath <= Breathing.GROUP_MAX_L + 1e-4f || sinceBreath == lengths[i])
+        }
+        assertTrue("an 11.6 s line takes breaths on the way ($breaths)", breaths >= 2)
+        // Every boundary is either a breath or a pause; never nothing in the middle of a line.
+        out.drop(1).forEach { assertFalse(it.first == Breathing.Before.Air) }
+    }
+
+    @Test
+    fun `a breath is as quiet as hers, under her speech`() {
+        val out = say(breathing(), 2.5f, 2.4f, 2.6f, 2.2f)
+        val speech = Breathing.speechLevel(sentence(1f), rate)
+        val breaths = out.mapNotNull { it.first as? Breathing.Before.Breath }
+        assertTrue(breaths.isNotEmpty())
+        for (b in breaths) {
+            val level = Breathing.percentile(Breathing.frameLevels(b.samples, rate), 0.90f)
+            val under = speech - level
+            assertTrue("${b.kind} sits $under dB under her speech", under in 24f..39f)
+            assertTrue(b.holdSeconds in Breathing.HOLD_MIN_S..Breathing.HOLD_MAX_S)
+        }
+    }
+
+    @Test
+    fun `never the same breath twice`() {
+        val b = breathing()
+        val drawn = (0 until 12).map { b.breath(0.3f, -10f).samples }
+        for (i in drawn.indices) for (j in i + 1 until drawn.size) {
+            val same = drawn[i].size == drawn[j].size && drawn[i].indices.all { abs(drawn[i][it] - drawn[j][it]) < 1e-6f }
+            assertFalse("breaths $i and $j are the same", same)
+        }
+    }
+
+    @Test
+    fun `a breath is deeper before a longer group`() {
+        val b = breathing()
+        val catch = b.breath(0.15f, -10f)
+        val deep = b.breath(0.55f, -10f)
+        assertEquals(Breathing.Kind.CATCH, catch.kind)
+        assertEquals(Breathing.Kind.DEEP, deep.kind)
+        assertTrue(deep.samples.size > catch.samples.size)
+    }
+
+    @Test
+    fun `her voice falls a little across a breath and comes back after the next`() {
+        val lengths = floatArrayOf(1.5f, 1.5f, 1.5f, 1.5f, 1.5f, 1.5f)
+        val out = say(breathing(), *lengths)
+        val n = (0.05f * rate).toInt()
+        fun ratio(i: Int, atStart: Boolean): Float {
+            val src = sentence(lengths[i]); val y = out[i].second
+            val range = if (atStart) 0 until n else (y.size - n) until y.size
+            return sqrt(range.sumOf { (y[it] * y[it]).toDouble() } / range.sumOf { (src[it] * src[it]).toDouble() }).toFloat()
+        }
+        val next = (1 until out.size).first { out[it].first is Breathing.Before.Breath }
+        val start = ratio(0, true); val end = ratio(next - 1, false)
+        assertTrue("starts full: $start", start > 0.98f)
+        assertTrue("falls: $start -> $end", end < start - 0.05f)
+        assertTrue("by no more than ${Breathing.DECLINE_DB} dB: $end", end >= 10f.pow(-Breathing.DECLINE_DB / 20f) - 0.005f)
+        assertTrue("full again after the breath", ratio(next, true) > 0.98f)
+    }
+
+    @Test
+    fun `a line right after her last goes on the same breath`() {
+        val b = breathing()
+        say(b, 1.5f, 1.2f)
+        now += 800
+        val next = say(b, 0.8f)
+        assertEquals(Breathing.Before.Air, next[0].first)
+        // Long after, a new line starts fresh: a short one on the air she has.
+        now += 60_000
+        assertEquals(Breathing.Before.Air, say(b, 0.7f)[0].first)
+        // Right after a long line that used her breath, the next sentence needs a new one.
+        now += 60_000
+        say(b, 2.5f, 2.3f)
+        now += 500
+        assertTrue(say(b, 1.5f)[0].first is Breathing.Before.Breath)
+    }
+
+    @Test
+    fun `pauses follow her speech rate`() {
+        val slow = say(breathing(3), 0.5f, 0.5f)[1].first as Breathing.Before.Pause
+        now += 60_000
+        val b = breathing(3)
+        val line = b.line(intArrayOf(6, 6))
+        line.next(sentence(0.5f), pace = 2f)
+        val fast = line.next(sentence(0.5f), pace = 2f).first as Breathing.Before.Pause
+        assertEquals(slow.seconds / 2f, fast.seconds, 1e-4f)
+        assertTrue(slow.seconds in 0.29f..0.41f)
+    }
+
+    private fun writeBank(dir: File, sr: Int, kinds: List<Breathing.Kind> = Breathing.Kind.entries) {
+        dir.mkdirs()
+        // As breath_bank.py --format f32 writes it, extra fields and all.
+        File(dir, "bank.json").writeText("""{"sr": $sr, "breaths": {"catch": {"source": "yume_07.wav", "from": 2.9, "to": 3.16, "seconds": 0.26, "level_re_speech_db": -30.7}}}""")
+        for (k in kinds) {
+            val x = noise(0.3f, k.ordinal, sr = sr)
+            val buf = ByteBuffer.allocate(x.size * 4).order(ByteOrder.LITTLE_ENDIAN)
+            x.forEach { buf.putFloat(it) }
+            File(dir, "${k.asset}.f32").writeBytes(buf.array())
+        }
+    }
+
+    @Test
+    fun `the bank loads as the build ships it, at her voice's sample rate`() {
+        val same = folder.newFolder("same").also { writeBank(it, rate) }
+        val bankSame = BreathBank.load(same, rate)
+        assertNotNull(bankSame)
+        assertEquals((0.3f * rate).toInt(), bankSame!!.clip(Breathing.Kind.DEEP).size)
+        val other = folder.newFolder("other").also { writeBank(it, 44100) }
+        val bankOther = BreathBank.load(other, rate)
+        assertNotNull(bankOther)
+        val want = (0.3f * 44100).toInt() / 2
+        assertTrue(abs(bankOther!!.clip(Breathing.Kind.CATCH).size - want) <= 2)
+    }
+
+    @Test
+    fun `no bank, or a broken one, means no breath`() {
+        assertNull(BreathBank.load(File(folder.root, "absent"), rate))
+        val missing = folder.newFolder("missing").also { writeBank(it, rate, listOf(Breathing.Kind.CATCH)) }
+        assertNull(BreathBank.load(missing, rate))
+        val torn = folder.newFolder("torn").also { writeBank(it, rate) }
+        File(torn, "deep.f32").writeBytes(byteArrayOf(1, 2, 3))
+        assertNull(BreathBank.load(torn, rate))
+    }
+}
