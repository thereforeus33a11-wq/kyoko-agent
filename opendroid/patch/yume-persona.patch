+        if (checkingEyes) return
+        checkingEyes = true
+        viewModelScope.launch {
+            val verdict = try {
+                checkModel(config, id)
+            } catch (e: kotlinx.coroutines.CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                EyesModels.judge(id, null)
+            }
+            eyesStatus = eyesVerdictText(id, verdict)
+            if (verdict is EyesModels.Verdict.Accepted) save(id)
+            checkingEyes = false
+        }
+    }
