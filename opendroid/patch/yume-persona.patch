+{
+  "name": "yume-en-ipa",
+  "version": 1,
+  "about": [
+    "How her phone voice reads English: one table, read by en_phonemize.py (training) and by the phone's EnglishPhonemes.kt (to come), so both give the voice the same phoneme codepoints.",
+    "English goes to IPA in the style espeak-ng en-us writes (the style her base voice, Piper hifi_tts_92, learned): stress mark right before the stressed vowel, length marks, diphthongs as two codepoints, no flapping, no glottal stops.",
+    "Every emitted symbol is one codepoint of the voice's tokens.txt. g is U+0261 (ASCII g is another id).",
+    "Japanese stays Japanese: kana and kanji, her romaji words (ja_words) and Latin words that read only as romaji go through Open JTalk exactly as before.",
+    "The rules for splitting a line into sentences and segments, and for joining them, are in 'segmentation' and 'boundaries'; mix_phonemize.py is the reference implementation."
+  ],
+  "cmudict": {
+    "file": "cmudict.dict",
+    "sha256": "81917843c7f44ce2b094ac63873c2c7a4cf802040792c455ba3ca406891c3d22",
+    "rule": "Lines 'word PH PH ...'; text after '#' is a comment; a word with '(' is a variant and is skipped; the first entry of a word wins. Lookup is by the lowercased word."
+  },
+  "vowels": {
+    "AA": "ɑː", "AE": "æ", "AO": "ɔː", "AW": "aʊ", "AY": "aɪ", "EH": "ɛ", "EY": "eɪ", "IH": "ɪ",
+    "OW": "oʊ", "OY": "ɔɪ", "UH": "ʊ", "UW": "uː"
+  },
+  "vowels_by_stress": {
+    "AH": {"0": "ə", "1": "ʌ", "2": "ʌ"},
+    "ER": {"0": "ɚ", "1": "ɜː", "2": "ɜː"},
+    "IY": {"0": "i", "1": "iː", "2": "iː"}
+  },
+  "consonants": {
+    "B": "b", "CH": "tʃ", "D": "d", "DH": "ð", "F": "f", "G": "ɡ", "HH": "h", "JH": "dʒ", "K": "k",
+    "L": "l", "M": "m", "N": "n", "NG": "ŋ", "P": "p", "R": "ɹ", "S": "s", "SH": "ʃ", "T": "t",
+    "TH": "θ", "V": "v", "W": "w", "Y": "j", "Z": "z", "ZH": "ʒ"
+  },
+  "r_vowel_before_vowel": {
+    "about": "ER right before another vowel inside a word (hurry, every, worry) keeps its r for that vowel, as espeak writes it.",
+    "vowels": {"ER": {"0": "əɹ", "1": "ɜːɹ", "2": "ɜːɹ"}}
+  },
+  "stress_marks": {"1": "ˈ", "2": "ˌ"},
+  "stress_rule": "The mark goes right before the stressed vowel's IPA (espeak style): 'hello' həlˈoʊ. Stress 0 has no mark. IY0 is short i (espeak's happY vowel); IY1 and IY2 are iː.",
+  "word_break_in_arpabet": "_",
+
+  "weak_forms": {
+    "about": "Function words, said reduced and unstressed. 'strong' is used when the word ends its sentence (where you from?, yes i am): the last word of an English segment that is the sentence's last segment. Words without 'strong' are always weak.",
+    "words": {
+      "a": {"ipa": "ɐ"},
