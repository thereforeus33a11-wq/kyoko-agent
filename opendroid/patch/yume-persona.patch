+    @Test
+    fun `the echoed number is the same number in capitals or with 0x in front`() {
+        val key = VeniceE2ee.generateKeyPair().publicKeyHex
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        val quote = TestEnclave.hex(TestEnclave.quote(key, nonce))
+        for (echoed in listOf(nonce.uppercase(), "0x$nonce", " 0x${nonce.uppercase()} ")) {
+            assertEquals(echoed, key, VeniceE2ee.modelKeyFromAttestation(TestEnclave.attestation(model, echoed, key, quote), nonce, model))
+        }
+        assertThrows(IOException::class.java) {
+            VeniceE2ee.modelKeyFromAttestation(TestEnclave.attestation(model, "0x" + VeniceE2ee.newNonceHex(), key, quote), nonce, model)
+        }
+    }
+
+    @Test
+    fun `the key agreed with one sender is worked out once for a whole reply`() {
+        val recipient = VeniceE2ee.generateKeyPair()
+        val derived = HashMap<String, ByteArray>()
+
+        // Pieces under one sender key, as an enclave that keeps its key for a reply sends them.
+        val sender = java.security.SecureRandom()
+        val first = VeniceE2ee.encrypt("one ", recipient.publicKeyHex, FixedKeyRandom(sender))
+        val second = VeniceE2ee.encrypt("two", recipient.publicKeyHex, FixedKeyRandom(sender))
+        assertEquals(first.take(130), second.take(130))
+        assertEquals("one ", VeniceE2ee.decrypt(first, recipient.privateKey, derived))
+        val agreed = derived.values.single()
+        assertEquals("two", VeniceE2ee.decrypt(second, recipient.privateKey, derived))
+        assertEquals(1, derived.size)
+        assertTrue("the same key object is used again, not derived again", derived.values.single() === agreed)
+
+        // A piece under another sender key gets its own entry and still opens.
+        val other = VeniceE2ee.encrypt("three", recipient.publicKeyHex)
+        assertEquals("three", VeniceE2ee.decrypt(other, recipient.privateKey, derived))
+        assertEquals(2, derived.size)
+
+        // A remembered key does not make a tampered piece pass.
+        val tampered = second.dropLast(1) + (if (second.last() == '0') '1' else '0')
+        assertThrows(IOException::class.java) { VeniceE2ee.decrypt(tampered, recipient.privateKey, derived) }
+        // And without a map everything works as before.
+        assertEquals("two", VeniceE2ee.decrypt(second, recipient.privateKey))
+    }
+
+    /** Hands out the same scalar for the sender key every time and fresh bytes for everything else. */
+    private class FixedKeyRandom(private val real: java.security.SecureRandom) : java.security.SecureRandom() {
+        override fun nextBytes(bytes: ByteArray) {
+            if (bytes.size == 32) bytes.fill(7) else real.nextBytes(bytes)
+        }
+    }
+
+    @Test
+    fun `an attested key is remembered per address and model for its lifetime only`() {
+        val venice = VeniceE2ee.pinnedBaseUrl("https://api.venice.ai/api/v1")!!
+        var now = 50_000L
+        val cache = AttestedKeyCache(lifetimeMillis = 1_000).also { it.now = { now } }
+
+        assertEquals(null, cache.get(venice, "e2ee-a"))
+        cache.put(venice, "e2ee-a", "key-a")
+        assertEquals("key-a", cache.get(venice, " E2EE-A "))
+        assertEquals("another model has a key of its own", null, cache.get(venice, "e2ee-b"))
+
+        now += 999
+        assertEquals("key-a", cache.get(venice, "e2ee-a"))
+        now += 1
+        assertEquals("at its lifetime the key is gone", null, cache.get(venice, "e2ee-a"))
+
+        cache.put(venice, "e2ee-a", "key-a2")
+        cache.forget(venice, "e2ee-a")
+        assertEquals(null, cache.get(venice, "e2ee-a"))
+
+        cache.put(venice, "e2ee-a", "key-a3")
+        now -= 5_000
+        assertEquals("a clock set back is no reason to trust it longer", null, cache.get(venice, "e2ee-a"))
+    }
