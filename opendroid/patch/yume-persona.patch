+        if (outing.camera.isNotBlank()) append(", through the ").append(outing.camera)
+        append(": ")
+        val ended = HerLog.EndedBy.entries.firstOrNull { it.name == outing.ended }
+        when {
+            outing.steps > 0 -> {
+                append(if (outing.looked == 1) "1 picture described, and you had a moment of looking" else "${outing.looked} pictures described, and you had a moment of looking")
+                if (outing.said) append(", and you said something to him from it")
+                append(". ")
+                append(if (thoughtsLeftOut) "what you thought then is kept on the phone and not in this text. " else "what you thought then is among your thoughts above. ")
+                append("what you saw is gone, except what you noted.")
