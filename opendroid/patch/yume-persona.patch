+    @Test
+    fun `once the day's moments are used up the next one waits until the oldest falls out of the 24 hours`() {
+        val three = Bounds(minGapMillis = 15 * minute, maxPerDay = 3)
+        // Two before this one: there is room for none after it until the oldest is a day old.
+        val moments = listOf(now - 5 * hour, now - 2 * hour, now)
+        val planned = plan(Wish.After(20 * minute), moments = moments, bounds = three)
+        assertEquals(Wake.At(now - 5 * hour + day), planned.wake)
+        assertEquals(Moved.DAY_USED_UP, planned.moved)
+        // With room left the wish stands.
+        assertNull(plan(Wish.After(20 * minute), moments = listOf(now - 2 * hour, now), bounds = three).moved)
+        // A wish that is later than that anyway is not touched.
+        assertEquals(Wake.At(now + 2 * day), plan(Wish.After(2 * day), moments = moments, bounds = three).wake)
+        // The default waits the same way.
+        assertEquals(Wake.At(now - 5 * hour + day), plan(null, moments = moments, bounds = three).wake)
+
+        assertEquals(0L, PersonaOwnTime.earliestWithRoom(listOf(now), 3))
+        assertEquals(now + day, PersonaOwnTime.earliestWithRoom(listOf(now), 1))
+        // More moments than the count allows (he lowered it): the one that has to fall out is further back.
+        assertEquals(now - hour + day, PersonaOwnTime.earliestWithRoom(listOf(now - 3 * hour, now - hour, now), 2))
+        assertEquals(Long.MAX_VALUE, PersonaOwnTime.earliestWithRoom(listOf(now), 0))
+    }
