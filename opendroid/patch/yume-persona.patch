+
+    // ── robots.txt and pace ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `robots txt is honoured, for her token before the star group, and cached`() = runBlocking {
+        serve(robots = "User-agent: *\nDisallow: /private\n\nUser-agent: YumeReader\nDisallow: /no-yume\nAllow: /no-yume/ok\n") { html("<p>x</p>") }
