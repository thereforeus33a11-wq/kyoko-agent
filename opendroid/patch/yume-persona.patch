+        Regex("""^\s*<(think|thinking|reasoning)>(?:[ \t]*\r?\n|\S).*$""", setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL))
+    private val REASONING_TAG = Regex("""<(/?)(think|thinking|reasoning)>""", RegexOption.IGNORE_CASE)
+
+    /** An opening reasoning tag at the very start of a reply, with nothing but space before it. */
+    private val REASONING_OPENING = Regex("""^\s*<(think|thinking|reasoning)>""", RegexOption.IGNORE_CASE)
+
+    /** The longest opening tag, for a reader that has to decide on the first few characters of a stream. */
+    const val LONGEST_REASONING_OPENING = "<reasoning>".length
+
+    /** True when [head], the start of a reply, opens with a reasoning tag. */
+    fun startsWithReasoning(head: String): Boolean = REASONING_OPENING.containsMatchIn(head)
+
+    /**
+     * Removes a model's visible reasoning from [content]. Some models put their scratch
+     * work inline before the answer; left in, it would be shown in chat, read aloud, sent
+     * in auto-replies and can break the plan JSON it precedes.
