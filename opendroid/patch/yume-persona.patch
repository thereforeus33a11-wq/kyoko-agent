+package com.opendroid.ai.core.persona
+
+/**
+ * Stand-ins for her originals in the tests of the requests that send her pictures to work from.
+ * A [SourceImage] is only ever made from an original or a master ([SourceImage.of]); these are
+ * made the same way, from an original of hers whose bytes are [base64] as given.
+ */
+internal fun src(base64: String): SourceImage =
+    SourceImage.of(PersonaPicture(id = "src-$base64", file = "src.png", kind = PersonaPicture.Kind.SELF), base64)!!
+
+/** [base64] each as [src]. */
+internal fun refs(vararg base64: String): List<SourceImage> = base64.map(::src)
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/TestThoughts.kt b/app/src/test/java/com/opendroid/ai/core/persona/TestThoughts.kt
new file mode 100644
