+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SpeechTextNormalizerTest {
+
+    private fun plain(text: String) = SpeechTextNormalizer.normalize(text)
+    private fun persona(text: String) = SpeechTextNormalizer.normalize(text, personaVoice = true)
+
+    @Test
+    fun `plain english passes through unchanged`() {
+        val text = "Alarm set for 7:30 AM. I'm done, and it's ready."
+        assertEquals(text, plain(text))
+        assertEquals(text, persona(text))
+    }
+
+    @Test
+    fun `markup, bullets, links and emoji are not read aloud`() {
+        assertEquals("Battery is 80 percent", plain("**Battery** is `80 percent` 🔋"))
+        assertEquals("Wifi. Bluetooth", plain("• Wifi\n• Bluetooth"))
+        assertEquals("see a link for more", plain("see https://example.com/a?b=1 for more"))
+        assertEquals("ok", plain("ok ♡"))
+        assertEquals("look at you", plain("look at you 😏💅"))
+    }
+
+    @Test
+    fun `line breaks become sentence stops without doubling punctuation`() {
+        assertEquals("Done! Next one. Last", plain("Done!\nNext one.\n\nLast"))
+    }
+
+    @Test
+    fun `text that is only symbols or punctuation is silent`() {
+        assertEquals("", plain("😏"))
+        assertEquals("", plain("."))
+        assertEquals("", plain("..."))
+        assertEquals("", persona("~"))
+    }
+
+    @Test
+    fun `persona laughter, tildes and stretched vowels are speakable`() {
+        assertEquals("haha", persona("www"))
+        assertEquals("haha stop", persona("wwwww stop"))
+        assertEquals("neh", persona("ne~"))
+        assertEquals("ichiman and body all yours", persona("ichiman and body aaall yours"))
+        assertEquals("so boring", persona("sooo boring"))
+    }
+
+    @Test
+    fun `persona noises get a spoken form`() {
+        assertEquals("tsk. dasai", persona("tch. dasai"))
+        assertEquals("pff. your girl?", persona("pfft. your girl?"))
+        // A flat "mm" is a hum. "mhm" would be a yes she did not give.
+        assertEquals("hm. later", persona("mm. later"))
+        assertEquals("hm?", persona("mm?"))
+        // A longer one is a sound of its own and stays as typed.
+        assertEquals("mmm", persona("mmm"))
+        assertEquals("mmmm. more", persona("mmmm. more"))
+        assertEquals("hmm", persona("fuun"))
+        assertEquals("ee jan", persona("ii jan"))
+    }
+
+    @Test
+    fun `missing apostrophes are restored for whole lowercase words only`() {
+        assertEquals("I'm not free. don't ask", persona("im not free. dont ask"))
+        assertEquals("you're late and that's boring", persona("youre late and thats boring"))
+        // Words that only look like contractions stay as typed.
+        assertEquals("well i throw it", persona("well i throw it"))
+        assertEquals("the wonton is cold", persona("the wonton is cold"))
+        assertEquals("important", persona("important"))
+    }
+
+    @Test
+    fun `units and capitalised app text survive the persona pass`() {
+        assertEquals("the gap is 5 mm wide", persona("the gap is 5 mm wide"))
+        assertEquals("Heading NE on the map", persona("Heading NE on the map"))
+        assertEquals("I'm setting that up", persona("I'm setting that up"))
+    }
+
+    @Test
+    fun `persona pass is off by default`() {
+        assertEquals("im here www", plain("im here www"))
+    }
+
+    @Test
+    fun `sums, addresses and file names are not markup`() {
+        for (text in listOf(
+            "12*5*2 = 120",
+            "Send email to john_doe_smith@example.com",
+            "Delete file tax_return_2024.pdf",
+            "2 * 3 * 4 is 24",
+            "snake_case and my_var_name stay"
+        )) {
+            assertEquals(text, plain(text))
+        }
+        assertEquals("this is bold and this is too", plain("this is **bold** and _this_ is too"))
+    }
+
+    @Test
+    fun `text that is not hers is read as written`() {
+        // What a step result, an approval prompt or someone else's message gets: the base pass only.
+        for (text in listOf(
+            "Der Wecker ist im Kalender gestellt",
+            "je ne sais pas",
+            "Rainfall (mm): 12",
+            "Send message to cooolguy",
+            "Type ii diabetes",
+            "see you in ~20 min",
+            "wont be long, dont wait"
+        )) {
+            assertEquals(text, plain(text))
+        }
+    }
+
+    @Test
+    fun `her respelling only ever touches a whole plain word`() {
+        assertEquals("cantó", persona("cantó"))
+        assertEquals("neşe", persona("neşe"))
+        assertEquals("code fff3a1", persona("code fff3a1"))
+        assertEquals("mail bob@im.example", persona("mail bob@im.example"))
+        assertEquals("the file is dont_touch.txt", persona("the file is dont_touch.txt"))
+    }
+
+    @Test
+    fun `her laugh trailing off is a laugh, not a link`() {
+        assertEquals("haha... maji", persona("www... maji"))
+        assertEquals("haha. you serious", persona("www.. you serious"))
+        assertEquals("haha.", persona("www."))
+        // A real address is still not read out letter by letter, by either pass.
+        assertEquals("see a link", persona("see www.example.com/page"))
+        assertEquals("see a link now", plain("see www.example.co.uk now"))
+        assertEquals("see a link for more", persona("see https://example.com/a?b=1 for more"))
+    }
+
+    @Test
+    fun `three dots stay a pause`() {
+        assertEquals("wait...", persona("wait..."))
+        assertEquals("wait... what", persona("wait... what"))
+        assertEquals("...don't care", persona("...dont care"))
+        assertEquals("so... yeah. later", persona("so...\nyeah.\nlater"))
+        assertEquals("fine...", persona("fine\u2026"))
+        assertEquals("Done... Next", plain("Done...\nNext"))
+        // Two stops in a row are still one.
+        assertEquals("Done! Next one. Last", plain("Done!\nNext one.\n\nLast"))
+    }
+
+    @Test
+    fun `a stretched word is cut back to the word it is`() {
+        // Two letters where English doubles them.
+        assertEquals("good", persona("gooood"))
+        assertEquals("soon", persona("soooon"))
+        assertEquals("cool", persona("cooool"))
+        assertEquals("so sweet", persona("so sweeeet"))
+        assertEquals("well", persona("wellll"))
+        // One letter otherwise, and for the short words that are spelt with one.
+        assertEquals("what", persona("whaaat"))
+        assertEquals("no", persona("nooo"))
+        assertEquals("so boring", persona("sooo boring"))
+        assertEquals("stop", persona("stooop"))
+        assertEquals("yes", persona("yesss"))
+        assertEquals("please", persona("pleeease"))
+        // A word that is one letter over and over is a sound and is left alone.
+        assertEquals("xxx", persona("xxx"))
+        assertEquals("zzz", persona("zzz"))
+    }
+
+    @Test
+    fun `a stretched o or e is not doubled into another word`() {
+        // Each of these was said as the word on the right of the arrow: hoot, boored, leegs, weet, loong, moore, cheeap.
+        assertEquals("so hot", persona("sooo hooot"))
+        assertEquals("bored", persona("booored"))
+        assertEquals("legs", persona("leeegs"))
+        assertEquals("wet", persona("weeet"))
+        assertEquals("long", persona("looong"))
+        assertEquals("more", persona("mooore"))
+        assertEquals("cheap", persona("cheeeap"))
+        // A stretched vowel at the end of a word is the same case.
+        assertEquals("hello", persona("hellooo"))
+        assertEquals("nice", persona("niceee"))
+        assertEquals("you", persona("yooou"))
+        assertEquals("who", persona("whooo"))
+        assertEquals("very well", persona("veeery weeell"))
+        // The everyday words that are spelt with two keep two.
+        assertEquals("too good", persona("tooo gooood"))
+        assertEquals("see", persona("seee"))
+        assertEquals("i need food", persona("i neeeed foooood"))
+        assertEquals("feel free", persona("feeeel freee"))
+        assertEquals("look", persona("looook"))
+        // What came out right before still does, swear words included.
+        assertEquals("no", persona("noooo"))
+        assertEquals("all", persona("aaall"))
+        assertEquals("all", persona("allll"))
+        assertEquals("fuck", persona("fuuuck"))
+        assertEquals("shit", persona("shiiit"))
+        assertEquals("ass", persona("asss"))
+        assertEquals("off", persona("offff"))
+        // The chat keeps what she typed: only the copy that is spoken is cut back.
+        assertEquals("hooot", plain("hooot"))
+    }
+
+    @Test
+    fun `more missing apostrophes are restored`() {
