+        HerLog.EndedBy.TIME -> "its minutes ran out"
+        HerLog.EndedBy.STEPS -> "its steps ran out"
+        HerLog.EndedBy.BUDGET -> "his calls on your own ran low"
+        HerLog.EndedBy.ASLEEP -> "you lay down to sleep"
+        HerLog.EndedBy.GUARD -> "three of your searches or links would have carried something about him"
