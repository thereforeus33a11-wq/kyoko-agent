+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * She grows. Her past stays as her files tell it; who she is now is where she started,
+ * and her own notes are newer than any page. She changes them herself, in her notebook
+ * and in her own time, from what is said and from what she does and makes. She gets
+ * older, and is never younger than she is.
+ */
+class PersonaGrowthTest {
+
+    private val tokyo = TimeZone.getTimeZone("Asia/Tokyo")
+
+    private fun at(year: Int, month: Int, day: Int): Long =
+        Calendar.getInstance(tokyo).apply { clear(); set(year, month - 1, day, 12, 0) }.timeInMillis
+
+    @Test
+    fun `her notes hold over her card and files for who she is now, and the past does not move`() {
+        val rule = PersonaPrompts.NOTES_OVER_FILES
+        assertTrue(rule.contains("You are not frozen"))
+        assertTrue(rule.contains("your note holds"))
+        assertTrue(rule.contains("What happened to you stays as your files tell it: a note never changes the past."))
+        assertTrue(rule.contains("never younger than your age"))
+        val prompt = PersonaPrompts.chatSystemPrompt(
+            card = "card", ownerName = "Sam", autoModeLabel = "OFF", relevantContext = "", notes = "",
+            deviceActivity = emptyList(), screenshotAttached = false, ageNow = 20
+        )
+        assertTrue(prompt.contains("- $rule"))
+        assertTrue(prompt.contains("You are 20 today (born 19 august 2007)."))
+        // Her pages say what they are: her past, and where she started.
+        assertTrue(PersonaPrompts.LIBRARY_HEADING.contains("who you are in them is where you started"))
+        assertTrue(PersonaPrompts.UNDER_HEADING.contains("as your card has them to begin with, and as your own notes have them where you have changed"))
+        // The notebook pass is told so too, and no longer that her look and who she is do not move.
+        val pass = PersonaPrompts.REFLECTION_SYSTEM_PROMPT
+        assertFalse(pass.contains("your age, your look, your ring, who you are"))
+        assertTrue(pass.contains("Your age, your ring and what happened to you do not move. Who you are now can change, and it is you who changes it"))
+        assertTrue(pass.contains("Longing for the girl before"))
+    }
+
+    @Test
