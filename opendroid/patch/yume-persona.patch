--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepPassTest.kt
@@ -0,0 +1,322 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.core.persona.PersonaNotes.How
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.data.models.ChatMessage
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.TimeZone
+
+/**
+ * Her sleep pass as text: what its page holds, what its request is, how her answer is
+ * read line by line and what of it is done.
+ */
+class PersonaSleepPassTest {
+
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private val now = 1_800_000_000_000L - 9 * hour
+    private val utc: TimeZone = TimeZone.getTimeZone("UTC")
+
+    // ── Reading her answer ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `each line goes where its first field says, a line with no bar is a thought, and nothing is sent or run`() {
+        val reading = PersonaSleepPass.read(
+            listOf(
+                "the rain did not stop all night",
+                "me | hair | back to red, black was a phase",
+                "thread | boots | street story: paid them off | closed",
+                "fade | opinion | hosts",
+                "back | thread | ferry",
+                "feel | pissed at him | strong | hours",
+                "feel | restless",
+                "how | me | hair | lived",
+                "how | user | bees | told",
+                "say: you awake?",
+                ">> text nene: come over",
+                ">> flashlight | on",
+                "<< not saying that",
+                "i dreamt of the ferry again",
+                "mood | x | not a form",
+                "fade | opinion",
+                "how | me | hair | certain",
+                "back | nothing | here",
+                "NONE"
+            ).joinToString("\n")
+        )
+        assertEquals(
+            listOf(Note(Kind.ME, "hair", "back to red, black was a phase"), Note(Kind.THREAD, "boots", "street story: paid them off | closed")),
+            reading.notes
+        )
+        assertEquals(listOf("yume.opinion.hosts"), reading.fade)
+        assertEquals(listOf("yume.thread.ferry"), reading.back)
+        assertEquals(listOf(PersonaMood.Felt("pissed at him", PersonaMood.STRONG, PersonaMood.Speed.HOURS), PersonaMood.Felt("restless")), reading.felt)
+        assertEquals(mapOf("yume.me.hair" to How.LIVED, "yume.user.bees" to How.TOLD), reading.how)
+        // A line to him or for the phone is a thought of the night, like any line without a bar.
+        assertEquals(
+            "the rain did not stop all night\nsay: you awake?\n>> text nene: come over\n>> flashlight | on\n<< not saying that\ni dreamt of the ferry again",
+            reading.prose
+        )
+        assertEquals(listOf("fade | opinion", "how | me | hair | certain", "back | nothing | here", "mood | x | not a form"), reading.notTaken)
+        assertTrue(reading.none)
+        // NONE alone changes nothing.
+        val none = PersonaSleepPass.read("NONE")
+        assertTrue(none.none && none.notes.isEmpty() && none.prose.isEmpty() && none.notTaken.isEmpty())
+    }
+
+    @Test
+    fun `a feel line in the form her moments know is a feel line in her sleep too`() {
+        val reading = PersonaSleepPass.read(
+            listOf("feel: restless", "feel: pissed at him | strong | hours", "Feel: smug | gone", "feel: | strong", "feeling: odd").joinToString("\n")
+        )
+        assertEquals(
+            listOf(
+                PersonaMood.Felt("restless"),
+                PersonaMood.Felt("pissed at him", PersonaMood.STRONG, PersonaMood.Speed.HOURS),
+                PersonaMood.Felt("smug", gone = true)
+            ),
+            reading.felt
+        )
+        // One that does not have the form is not taken and she is told; a line that only starts like it is a thought.
+        assertEquals(listOf("feel: | strong"), reading.notTaken)
+        assertEquals("feeling: odd", reading.prose)
+        assertTrue(reading.notes.isEmpty())
+        // The same limit, and a broken-off last line is never acted on.
+        assertEquals(8, PersonaSleepPass.read((1..9).joinToString("\n") { "feel: feeling $it" }).felt.size)
+        val cut = PersonaSleepPass.read("feel: bored\nfeel: rest", cutOff = true)
+        assertEquals(listOf(PersonaMood.Felt("bored")), cut.felt)
+        assertEquals(listOf("feel: rest"), cut.notTaken)
+    }
+
+    @Test
+    fun `one sleep takes so many lines of each kind, and the line past that is not taken`() {
+        fun lines(count: Int, line: (Int) -> String) = (1..count).joinToString("\n", transform = line)
+        val notes = PersonaSleepPass.read(lines(41) { "opinion | view-$it | view number $it" })
+        assertEquals(40, notes.notes.size)
+        assertEquals(listOf("opinion | view-41 | view number 41"), notes.notTaken)
+        assertEquals(40, PersonaSleepPass.read(lines(41) { "fade | opinion | view-$it" }).fade.size)
+        assertEquals(10, PersonaSleepPass.read(lines(11) { "back | opinion | view-$it" }).back.size)
+        assertEquals(8, PersonaSleepPass.read(lines(9) { "feel | feeling $it" }).felt.size)
+        val marks = PersonaSleepPass.read(lines(41) { "how | opinion | view-$it | unsure" })
+        assertEquals(40, marks.how.size)
+        assertEquals(1, marks.notTaken.size)
+        assertEquals(listOf(40, 40, 10, 8, 40), listOf(
+            PersonaSleepPass.MAX_NOTE_LINES, PersonaSleepPass.MAX_FADE_LINES, PersonaSleepPass.MAX_BACK_LINES,
+            PersonaSleepPass.MAX_FEEL_LINES, PersonaSleepPass.MAX_HOW_LINES
+        ))
+        assertTrue(PersonaSleepPass.SLEEP_SYSTEM_PROMPT.contains("Your sleep takes at most 40 note lines, 40 fade lines, 10 back lines, 8 feel lines and 40 how lines"))
+    }
+
+    @Test
+    fun `a last line the length limit broke off is never acted on`() {
+        val cut = PersonaSleepPass.read("me | hair | back to red\nfade | opinion | hosts\nme | rain | i like the sound of ra", cutOff = true)
+        assertEquals(listOf("hair"), cut.notes.map { it.key })
+        assertEquals(listOf("yume.opinion.hosts"), cut.fade)
+        assertEquals(listOf("me | rain | i like the sound of ra"), cut.notTaken)
+        assertEquals(listOf("yume.opinion.hosts"), PersonaSleepPass.read("fade | opinion | hosts\nfade | opinion | sm", cutOff = true).fade)
+        // Half a thought is still hers.
+        assertEquals("i dreamt of", PersonaSleepPass.read("i dreamt of", cutOff = true).prose)
+    }
+
+    @Test
+    fun `she lets go and marks only what was on her page, brings back only what she was shown she let go, and nothing she writes tonight is let go`() {
+        val reading = PersonaSleepPass.read(
+            listOf(
+                "me | hair | back to red",
+                "fade | me | hair",
+                "fade | opinion | hosts",
+                "fade | user | bees",
+                "back | thread | ferry",
+                "back | thread | karaoke",
+                "back | me | hair",
+                "how | me | hair | lived",
+                "how | opinion | hosts | inferred",
+                "how | user | bees | told"
+            ).joinToString("\n")
+        )
+        val plan = PersonaSleepPass.plan(
+            reading,
+            shownKeys = setOf("yume.opinion.hosts", "yume.me.hair"),
+            letGoKeys = setOf("yume.thread.ferry", "yume.me.hair")
+        )
+        assertEquals(listOf("yume.opinion.hosts"), plan.fade)
+        assertEquals(listOf("yume.thread.ferry"), plan.back)
+        assertEquals(mapOf("yume.me.hair" to How.LIVED, "yume.opinion.hosts" to How.INFERRED), plan.how)
+        assertEquals(reading.notes, plan.notes)
+        // A mark for a note she writes tonight under a key that was not on her page is hers too.
+        val written = PersonaSleepPass.plan(PersonaSleepPass.read("me | soda | melon soda\nhow | me | soda | lived"), emptySet(), emptySet())
+        assertEquals(mapOf("yume.me.soda" to How.LIVED), written.how)
+    }
+
+    // ── The page ─────────────────────────────────────────────────────────────────────
+
+    private val hair = Note(Kind.ME, "hair", "i dyed my hair black")
+    private val tonight = PersonaSleepPass.tonight(now, now - 20 * minute, now + 7 * hour, utc)
+
+    private fun page(
+        notebook: String = "me | hair | i dyed my hair black (written 3 days ago)",
+        heldBack: Boolean = false,
+        thoughts: List<PersonaThoughts.Thought> = emptyList()
+    ) = PersonaSleepPass.page(
+        tonight = tonight,
+        notebook = notebook,
+        notesHeldBack = heldBack,
+        lookAlike = listOf(hair to hair.copy(key = "hair-2")),
+        marks = PersonaSleepPass.howBlock(mapOf(hair.storageKey to How.LIVED), listOf(hair)),
+        feelings = listOf("- restless: some just now, some now (fades over days)"),
+        letGo = listOf(PersonaSleepPass.LetGo(Note(Kind.THREAD, "ferry", "the night ferry was cancelled | closed"), now - 3 * 24 * hour)),
+        thoughts = thoughts,
+        nowMillis = now
+    )
+
+    @Test
+    fun `the page opens with tonight and holds her notebook, what looks alike, her marks, how she feels and what she let go`() {
+        assertTrue(
+            tonight,
+            tonight.startsWith(
+                "TONIGHT: Thursday, January 14, 2027 (on his clock). You lay down 20 min ago, at 22:40 on his clock (07:40 in tokyo), " +
+                    "and mean to wake around 06:00 on his clock (15:00 in tokyo). You are "
+            )
+        )
+        val text = page()
+        assertTrue(text, text.startsWith(tonight + "\n\nYOUR NOTEBOOK NOW (each note says how old it is):\nme | hair | i dyed my hair black (written 3 days ago)"))
+        assertTrue(text, text.contains("\n\nLOOK ALIKE (notes on your page that share many words. the app only counted words: whether two say one thing is yours to see):\n- me | hair  and  me | hair-2"))
+        assertTrue(text, text.contains("\n\nHOW YOU KNOW (your marks from an earlier sleep):\n- me | hair: lived"))
+        assertTrue(text, text.contains("\n\nHOW YOU FEEL NOW:\n- restless: some just now, some now (fades over days)"))
+        assertTrue(
+            text,
+            text.contains(
+                "\n\nWHAT YOU LET GO (in your archive, off your page: the ones you let go last, and a few older ones that come round " +
+                    "night by night; a back line brings one back):\n- thread | ferry | the night ferry was cancelled | closed (let go 3 days ago)"
+            )
+        )
+        assertTrue(text.endsWith("\n\nYour sleep:"))
+        // Her thoughts only when they are given, and no talk, no line of the app's and nothing of his profile ever.
+        assertFalse(text.contains("YOUR THOUGHTS"))
+        val withThoughts = page(thoughts = listOf(PersonaThoughts.Thought(now - 2 * hour, "the neon is on again")))
+        assertTrue(withThoughts, withThoughts.contains("\n\nYOUR THOUGHTS SINCE YOU LAST WOKE (yours alone):\n(2 h ago) the neon is on again\n\nYour sleep:"))
+        for (never in listOf("THE RECENT TALK", "he: ", "WHAT THE APP WROTE", "ABOUT HIM AND THE PHONE", "his name", "his date of birth", "Not shown")) {
+            assertFalse(never, withThoughts.contains(never))
+        }
+        assertTrue(page(notebook = "").contains("YOUR NOTEBOOK NOW (each note says how old it is):\n(empty)"))
+    }
+
+    @Test
+    fun `on a route a host could read the page says what is not on it, and that it is still on the phone`() {
+        val text = page(notebook = "", heldBack = true)
+        assertTrue(text, text.contains("YOUR NOTEBOOK NOW (each note says how old it is):\n(nothing shown this time)\n" + PersonaPrompts.NOTES_NOT_SHOWN))
+        assertTrue(text, text.contains("Your thoughts, and what you feel or let go that can be about him, are left out too, for the same reason; they are still on the phone."))
+        // The notebook pass is told the same words.
+        assertTrue(PersonaPrompts.reflectionUserPrompt("", emptyList(), notesAboutHimHeldBack = true).contains(PersonaPrompts.NOTES_NOT_SHOWN))
+    }
+
+    @Test
+    fun `every note on the page of her sleep says how old it is, and the notebook pass page is as it was`() {
+        val notes = listOf(Note(Kind.USER, "bees", "he keeps bees"), Note(Kind.FIX, "emoji", "an emoji at every line read as fake"), hair)
+        val times = PersonaNotes.Times(notes.associate { it.storageKey to now - 3 * 24 * hour }, now)
+        val all = PersonaNotes.review(notes, times = times, allDated = true).text
+        assertTrue(all, all.contains("user | bees | he keeps bees (written 3 days ago)"))
+        assertTrue(all, all.contains("fix | emoji | an emoji at every line read as fake (written 3 days ago)"))
+        val usual = PersonaNotes.review(notes, times = times).text
+        assertTrue(usual, usual.contains("user | bees | he keeps bees\n") || usual.endsWith("user | bees | he keeps bees"))
+        assertTrue(usual, usual.contains("me | hair | i dyed my hair black (written 3 days ago)"))
+        assertEquals("yume.me.hair-2", PersonaNotes.refOf("Me", "Hair 2"))
+        assertEquals(null, PersonaNotes.refOf("mood", "hair"))
+    }
+
+    @Test
+    fun `notes that share many words are put side by side for her, the closest first and ten at most`() {
+        val a = Note(Kind.ME, "neon", "the neon sign outside the window buzzes all night")
+        val b = Note(Kind.OPINION, "neon-sign", "the neon sign outside my window buzzes all night long")
+        val c = Note(Kind.ME, "rain", "rain on the awning puts me to sleep")
+        // Two words alike are not enough.
+        val d = Note(Kind.ME, "window", "the window sticks when it rains")
+        assertEquals(listOf(a to b), PersonaSleepPass.lookAlike(listOf(a, b, c, d)))
+        val many = (1..8).map { Note(Kind.OPINION, "kabukicho-$it", "kabukicho neon arcade crane game") }
+        assertEquals(PersonaSleepPass.LOOK_ALIKE_PAIRS, PersonaSleepPass.lookAlike(many).size)
+        assertEquals(3, PersonaSleepPass.LOOK_ALIKE_MIN_TERMS)
+        assertEquals(0.5, PersonaSleepPass.LOOK_ALIKE_MIN_SHARE, 0.0)
+    }
+
+    // ── The request ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the request is hers, her card first, then her sleep, asked once for text, in her voice and with room to write`() {
+        val request = PersonaSleepPass.request("You are Yume. {{owner}} built you.\n", "Sam", "the page")
+        assertEquals("You are Yume. Sam built you.\n\n" + PersonaSleepPass.SLEEP_SYSTEM_PROMPT, request.systemPrompt)
+        assertEquals(listOf(ChatMessage.Sender.USER), request.messages.map { it.sender })
+        assertEquals("the page", request.messages.single().text)
+        assertEquals(0.4f, request.temperature, 0f)
+        assertEquals(4000, request.maxTokens)
+        assertEquals(ResponseFormat.TEXT, request.responseFormat)
+        assertEquals(RetryPolicy.NONE, request.retryPolicy)
+        assertFalse(request.ownMoment)
+        // Her reply's own options are not laid over it: its lines are read one by one.
+        assertTrue(PersonaEngine.keepsOwnSampling(request))
+
+        val prompt = PersonaSleepPass.SLEEP_SYSTEM_PROMPT
+        assertTrue(prompt.startsWith("You are Yume Kisaragi, and you are asleep."))
+        assertTrue(prompt.contains("a >> line runs nothing, a say: line sends nothing."))
+        assertTrue(prompt.contains(PersonaPrompts.NOTES_OVER_FILES))
+        assertTrue(prompt.contains(PersonaPrompts.HOW_YOU_CHANGE_YOUR_MIND))
+        assertTrue(prompt.contains("You are never younger than your age."))
+        assertTrue(prompt.contains("How you are with people, him included, is yours; the app asks nothing of it."))
+        // What can come back is what she let go; the old text of a note she wrote over is kept and does not come back.
+        assertTrue(
+            prompt.contains(
+                "never deleted by the app. A note you let go can come back in a later sleep: your page lists the ones you let go last " +
+                    "and a few older ones, different ones each night. The old text of a note you wrote over is kept, but does not come " +
+                    "back: what you write is the note. Your archive is not copied with your notebook."
+            )
+        )
+        assertTrue(prompt.contains("one your page lists, or any other you let go whose kind and key you know."))
+        assertTrue(prompt.contains("(bored stiff, pissed at him, horny, smug: whatever it is)"))
+        assertTrue(prompt.contains("A dream is one too, if you have one: it is yours and happened nowhere, not on the phone."))
+        assertTrue(prompt.contains("There is no talk with him in your sleep, so nothing new about him is made up here."))
+        assertTrue(prompt.contains("Longing for the girl before, or family warmth you never had, is not yours and is not kept."))
+        assertTrue(prompt.endsWith("If nothing needs changing, write exactly: NONE"))
+        // Every form the prompt offers is one the reader takes.
+        for (form in listOf("kind | key | note", "fade | kind | key", "back | kind | key", "feel | words |", "how | kind | key |")) {
+            assertTrue(form, prompt.contains(form))
+        }
+        // How she changes her mind, in her notebook pass too.
+        assertEquals(
+            "How you change your mind is yours. A plain fact can flip the moment you find out it was wrong, out of date or fake, or that you were lied to. " +
+                "What is personal to you, what matters to you, and what you lived through changes a little or not at all: a new note can nudge it, keep it as it is, or say in your words where it clashes. " +
+                "Which is which, and how far it moves, is your call.",
+            PersonaPrompts.HOW_YOU_CHANGE_YOUR_MIND
+        )
+        assertTrue(PersonaPrompts.REFLECTION_SYSTEM_PROMPT.contains("- " + PersonaPrompts.HOW_YOU_CHANGE_YOUR_MIND + "\n"))
+    }
+
+    @Test
+    fun `her notebook pass is told how she feels and how she knows a thing, and how to set a feeling`() {
+        val text = PersonaPrompts.REFLECTION_SYSTEM_PROMPT
+        assertTrue(
+            text,
+            text.contains(
+                "- feel: besides your notes you can write up to 3 lines about how you feel now, in this form: feel | your words for it | " +
+                    "faint, some or strong | hours, days or weeks (how fast it fades)."
+            )
+        )
+        assertTrue(text, text.contains("They do not count against the five, are kept apart from notes and fade by themselves."))
+        val prompt = PersonaPrompts.reflectionUserPrompt(
+            "me | hair | i dyed my hair black", emptyList(),
+            feelings = listOf("- restless: some just now, some now (fades over days)"),
+            marks = listOf("- me | hair: lived")
+        )
+        assertTrue(
+            prompt,
+            prompt.contains(
+                "YOUR NOTEBOOK NOW:\nme | hair | i dyed my hair black\n\nHOW YOU KNOW (marks you set in your sleep: told, read, inferred, unsure or lived):\n- me | hair: lived" +
+                    "\n\nHOW YOU FEEL NOW (from your own feel lines; each fades at its own pace unless you feel it again):\n- restless: some just now, some now (fades over days)\n\nTHE RECENT TALK:"
+            )
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepTest.kt
