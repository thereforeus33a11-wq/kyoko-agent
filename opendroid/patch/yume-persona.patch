+    /** A caption on one line, unable to open a section of the prompt. Its words stay as they were written. */
+    private fun captionOnOneLine(caption: String): String =
+        caption.replace(Regex("""\s+"""), " ").trim().replace("===", "= = =")
+
+    /**
+     * The app's line about the picture of herself that rides on the first message. The
+     * caption is passed on as a caption, not stated by the app as fact: the owner or she
+     * wrote it, and the app has not looked at the picture.
+     */
+    private fun ownPictureLine(caption: String): String {
+        val kept = captionOnOneLine(caption)
+        val captionPart = when {
+            kept.isEmpty() -> ""
+            kept.last().isLetterOrDigit() -> "Its caption: $kept. "
+            else -> "Its caption: $kept "
+        }
+        return "- A picture of you is attached to the first message below: your own picture, kept on this phone. " +
+            captionPart + "It is you, not his screen."
+    }
+
+    /** One line per caption, as many whole captions as fit into [MAX_PICTURE_LIST_CHARS]. */
+    private fun pictureList(captions: List<String>): String {
+        val lines = ArrayList<String>()
+        var used = 0
+        for (caption in captions) {
+            val line = "- " + captionOnOneLine(caption)
+            if (line.length <= 2) continue
+            // The line break between two lines counts too.
+            val cost = line.length + if (lines.isEmpty()) 0 else 1
+            if (used + cost > MAX_PICTURE_LIST_CHARS) continue
+            lines += line
+            used += cost
+        }
+        return lines.joinToString("\n")
+    }
