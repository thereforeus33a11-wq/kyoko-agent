+    /**
+     * A stand-in whose answers can be changed between requests: whether the enclave's
+     * proof holds, and what a chat request is answered with (null for an encrypted "ok").
+     */
+    private class Moods(var proofHolds: Boolean = true, var chatAnswer: (() -> MockResponse)? = null, var chats: Int = 0)
+
+    private fun serveWith(moods: Moods) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                if (request.target.orEmpty().startsWith("/api/v1/tee/attestation")) {
+                    val nonce = request.url.queryParameter("nonce").orEmpty()
+                    val quote = TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce))
+                    return json(
+                        if (moods.proofHolds) {
+                            TestEnclave.attestation(model, nonce, enclave.publicKeyHex, quote)
+                        } else {
+                            TestEnclave.attestation(model, nonce, enclave.publicKeyHex, quote, verified = "false")
+                        }
+                    )
+                }
+                moods.chats++
+                moods.chatAnswer?.let { return it() }
+                val clientKey = request.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty()
+                val piece = delta("content", VeniceE2ee.encrypt("ok", clientKey))
+                return MockResponse.Builder().code(200).setHeader("Content-Type", "text/event-stream")
+                    .body("data: $piece\n\ndata: [DONE]\n\n").build()
+            }
+        }
+    }
+
+    private val turnedDown: () -> MockResponse = {
+        MockResponse.Builder().code(400).setHeader("Content-Type", "application/json").body("{}").build()
+    }
