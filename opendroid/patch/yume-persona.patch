--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/ui/viewmodel/PictureModelsViewModelTest.kt
@@ -0,0 +1,135 @@
+package com.opendroid.ai.ui.viewmodel
+
+import android.os.Looper
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.persona.MadePictureCheck
+import com.opendroid.ai.core.persona.PersonaPicture
+import com.opendroid.ai.core.persona.PictureModels
+import com.opendroid.ai.core.persona.PictureTrial
+import com.opendroid.ai.core.persona.SelfPictureMaker
+import com.opendroid.ai.core.persona.SourceImage
+import com.opendroid.ai.core.persona.VeniceImages
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * "Try picture models" as he uses it: the price before he starts, one tile per model as each
+ * comes back, the ones the age check did not pass said in their place and not shown, nothing
+ * tried where no picture may be made, and one tap to make a model hers.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class PictureModelsViewModelTest {
+
+    private val venice = "Custom OpenAI Compatible"
+    private val settings = AtomicReference(
+        LLMConfig(
+            customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+            apiKeys = mapOf(venice to "his-venice-key"),
+            personaMakesPictures = true
+        )
+    )
+    private val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+    private val keys = CopyOnWriteArrayList<String>()
+
+    private fun png(mark: Int) = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), mark.toByte())
+
+    private fun viewModel() = PictureModelsViewModel(
+        settings = { settings.get() },
+        save = { update -> settings.set(update(settings.get())) },
+        pictures = { listOf(PersonaPicture(id = "a", file = "a.jpg", kind = PersonaPicture.Kind.SELF, caption = "full body front plate")) },
+        source = { id -> SourceImage.of(PersonaPicture(id = id, file = "$id.jpg", kind = PersonaPicture.Kind.SELF), "B64-$id") },
+        trialOf = { key ->
+            keys += key
+            PictureTrial(
+                SelfPictureMaker(
+                    send = { call ->
+                        sent += call
+                        VeniceImages.Made.Picture(png(if (call.model == PictureModels.LUSTIFY_V8.id) 1 else 2))
+                    },
+                    check = { image, _ ->
+                        val answer = if (image[4] == 1.toByte()) "ages: child" else "ages: adult"
+                        MadePictureCheck.judge(HerEyes.Seen.Described("", KidGuard.ages(answer), seer = KidGuard.AGE_CHECK))
+                    },
+                    counts = object : SelfPictureMaker.Counts {
+                        override fun kept() = Unit
+                        override fun notKept(category: String) = Unit
+                    }
+                )
+            )
+        }
+    )
+
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Test
+    fun `a try makes one tile per chosen model, shows the ones that passed and says why the others are not shown`() {
+        val model = viewModel()
+        await("the current models") { model.current != null }
+        assertEquals("wai-Illustrious" to "qwen-edit-uncensored", model.current)
+        // What is chosen at first, and what it costs before anything is made.
+        assertEquals(PictureModelsViewModel.DEFAULT_CHOSEN, model.chosen)
+        assertEquals(0.11, model.cost(), 1e-9)
+        model.toggle(PictureModels.CHROMA)
+        model.toggle(PictureModels.KREA_TURBO)
+        assertEquals(0.06, model.cost(), 1e-9)
+        model.updateMatch(true)
+        assertEquals(0.14, model.cost(), 1e-9)
+        model.updateMatch(false)
+
+        model.start()
+        await("the try to end") { !model.running && model.status.startsWith("Done") }
+        assertEquals(listOf("his-venice-key"), keys)
+        assertEquals(listOf("wai-Illustrious", "lustify-v8", "qwen-edit-uncensored"), model.rows.map { it.model.id })
+        assertNotNull(model.rows[0].bytes)
+        // Read as a child: no picture on the screen, said in its place.
+        assertNull(model.rows[1].bytes)
+        assertTrue(model.rows[1].thrownAway)
+        assertTrue(model.rows[1].why.startsWith("Not kept: the picture came out wrong: the age check read the woman drawn as a child"))
+        assertEquals("Done. 1 thrown away unseen: the age check did not pass them.", model.status)
+        // The edit model starts from his first picture of her.
+        assertTrue(sent.single { it.endpoint == VeniceImages.Endpoint.EDIT }.body.contains("B64-a"))
+
+        // One tap makes a model hers.
+        model.use(PictureModels.LUSTIFY_V8)
+        await("the choice to be saved") { settings.get().personaPictureModel == "lustify-v8" }
+        model.use(PictureModels.FIRERED_EDIT)
+        await("the edit choice to be saved") { settings.get().personaPictureEditModel == "firered-image-edit" }
+        await("the current models") { model.current == ("lustify-v8" to "firered-image-edit") }
+    }
+
+    @Test
+    fun `nothing is tried where no picture may be made, or with nothing chosen`() {
+        settings.set(settings.get().copy(personaMakesPictures = false))
+        val model = viewModel()
+        model.start()
+        await("the try to end") { !model.running && model.status.isNotEmpty() }
+        assertEquals("Making pictures of her is switched off in Settings, Persona.", model.status)
+        assertTrue(sent.isEmpty())
+        assertTrue(model.rows.isEmpty())
+
+        PictureModelsViewModel.DEFAULT_CHOSEN.forEach { id -> model.toggle(PictureModels.of(id)!!) }
+        model.start()
+        assertEquals("Choose at least one model.", model.status)
+        assertTrue(sent.isEmpty())
+    }
+}
