+    @Test
+    fun `a reply that broke off on the way is a failed call, never a reply with half a command at its end`() {
+        // Two pieces and then the stream is over: no reason it ended, no end marker.
+        val brokenOff = { clientKey: String, _: Int ->
+            "data: ${delta("content", VeniceE2ee.encrypt("fine. doing it\n", clientKey))}\n\n" +
+                "data: ${delta("content", VeniceE2ee.encrypt(">> text sam i cant make it tonight beca", clientKey))}\n\n"
+        }
+        serveStream(brokenOff)
+        val failure = assertThrows(LLMException::class.java) { complete(newRequest().copy(persona = true)) }
+        assertEquals("the server's failure, not an unreadable answer and not a lost connection", LLMError.ServerError, failure.error)
+        assertTrue("the message had gone out", failure.requestSent)
+        assertFalse(failure.replyDiscarded)
+        assertTrue(failure.retryable)
+
+        // The same for a stream the server ends with an error.
+        serveStream { clientKey, _ ->
+            "data: ${delta("content", VeniceE2ee.encrypt("fine", clientKey))}\n\n" +
+                "data: {\"error\":{\"message\":\"upstream failed\",\"type\":\"server_error\"}}\n\n"
+        }
+        assertEquals(LLMError.ServerError, assertThrows(LLMException::class.java) { complete() }.error)
+        // The key behind an exchange that failed is not kept.
+        serve(listOf("ok"))
+        val before = attestationsAsked()
+        assertEquals("ok", complete().content)
+        assertEquals(before + 1, attestationsAsked())
+    }
