+        )
+        assertFalse(PersonaActions.wordsMayBeSomeoneElses("call 5550107788", screenshotAttached = false, outsideText = ""))
+    }
+
+    @Test
+    fun `free rein sends her own message at once and shows him one that repeats a stranger's number`() {
+        fun runs(command: String, screenshot: Boolean = false) = PersonaActions.runsOnRein(
