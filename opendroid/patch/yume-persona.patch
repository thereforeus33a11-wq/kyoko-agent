@@ -0,0 +1,367 @@
+package com.opendroid.ai.core.voice.own
+
+import java.text.Normalizer
+
+/**
+ * Her line, as she types it (mostly English, with Japanese in romaji or in kana), turned
+ * into Japanese text that Open JTalk can read in her voice.
+ *
+ * - Japanese script passes through untouched.
+ * - A romaji word becomes hiragana: maji, dasai, urusee, tch.
+ * - An English word becomes katakana from its dictionary pronunciation (CMU), the way a
+ *   Japanese speaker says it: "smoke" スモーク, "whatever" ワテバー. That is her accent,
+ *   and her voice only knows Japanese sounds.
+ * - A word in neither is read as Japanese would read its letters: "gunnar" グンナー.
+ *
+ * Which reading a Latin word gets: her Japanese words first (some of them are also in the
+ * English dictionary: ne, baka, dame), then her English set phrases, then the
+ * dictionary, then romaji, then the letter-by-letter guess.
+ */
+class KanaText(private val pronunciations: (String) -> List<String>?) {
+
+    /** Converts [typed] (already through the speech normalizer) to text Open JTalk reads. */
+    fun convert(typed: String): String {
+        val text = plainLatin(typed)
+        val out = StringBuilder()
+        var i = 0
+        var lastWasLatinWord = false
+        while (i < text.length) {
+            val c = text[i]
+            when {
+                isLatin(c) -> {
+                    var j = i
+                    while (j < text.length && (isLatin(text[j]) || (text[j] == '\'' && j + 1 < text.length && isLatin(text[j + 1])))) j++
+                    val word = text.substring(i, j)
+                    if (lastWasLatinWord) out.append(' ')
+                    out.append(word(word))
+                    lastWasLatinWord = true
+                    i = j
+                    continue
+                }
+                c == ' ' || c == '\t' -> {
+                    // A space between two English words is kept as a word boundary (Open
+                    // JTalk reads it as none); any other space is dropped.
+                    i++
+                    continue
+                }
+                text.startsWith("...", i) -> { out.append('、'); i += 3; lastWasLatinWord = false; continue }
+                // A decimal point or a thousands comma stays in its number (23.5, 1,299):
+                // Open JTalk reads the number whole, where 。 or 、 would cut it in two.
+                (c == '.' || c == ',') && i > 0 && text[i - 1].isDigit() && i + 1 < text.length && text[i + 1].isDigit() -> {
+                    out.append(c)
+                    lastWasLatinWord = false
+                }
+                else -> {
+                    out.append(PUNCTUATION[c] ?: c)
+                    lastWasLatinWord = false
+                }
+            }
+            i++
+        }
+        return out.toString()
+    }
+
+    /** One Latin-letter word to kana. */
+    fun word(typed: String): String {
+        // A letter held for ever (mmmmm, zzzzzz) is read as held three times: mmm is んー.
+        val raw = HELD_LETTER.replace(typed, "$1$1$1")
+        val lower = raw.lowercase()
+        JAPANESE_WORDS[lower]?.let { return it }
+        ENGLISH_SAYINGS[lower]?.let { return it }
+        if (lower.isEmpty()) return ""
+        val allCaps = raw.length in 2..5 && raw.all { it.isUpperCase() }
+        if (allCaps && pronunciations(lower) == null) return raw.map { LETTERS[it.lowercaseChar()] ?: "" }.joinToString("")
+        pronunciations(lower)?.let { return Arpabet.toKatakana(it, lower) }
+        // A romaji word, if it reads as one.
+        if (!lower.contains('\'')) Romaji.toHiragana(lower)?.let { return it }
+        if (raw.length == 1) return LETTERS[lower[0]] ?: ""
+        return Romaji.toKatakanaLoose(lower.replace("'", ""))
+    }
+
+    private fun isLatin(c: Char) = c in 'a'..'z' || c in 'A'..'Z'
+
+    companion object {
+        private val HELD_LETTER = Regex("([A-Za-z])\\1{3,}")
+        private val ACCENTS = Regex("(?<=[A-Za-z])\\p{Mn}+")
+        private val CURLY_APOSTROPHE = Regex("(?<=[A-Za-z])[’ʼ](?=[A-Za-z])")
+
+        /**
+         * Latin letters as plain ASCII, so a word is not broken into pieces and pauses:
+         * full-width letters (ｏｋ), accents (café, Pokémon) and a curly apostrophe inside
+         * a word (don’t). Kana keep their voiced marks: only a mark on a Latin letter goes.
+         */
+        internal fun plainLatin(text: String): String {
+            val narrow = buildString(text.length) {
+                for (c in text) append(if (c in 'Ａ'..'Ｚ' || c in 'ａ'..'ｚ') c - 0xFEE0 else c)
+            }
+            val bare = Normalizer.normalize(
+                ACCENTS.replace(Normalizer.normalize(narrow, Normalizer.Form.NFD), ""),
+                Normalizer.Form.NFC
+            )
+            return CURLY_APOSTROPHE.replace(bare, "'")
+        }
+
+        private val PUNCTUATION = mapOf(
+            '.' to '。', ',' to '、', '?' to '？', '!' to '！', ':' to '、', ';' to '、',
+            '-' to '、', '"' to '「', '(' to '、', ')' to '、'
+        )
+
+        /**
+         * Her Japanese, written in romaji, that the English dictionary would take for a
+         * word of its own, and her people's names. Read the Japanese way, always.
+         */
+        val JAPANESE_WORDS: Map<String, String> = mapOf(
+            "ne" to "ね", "nee" to "ねえ", "nene" to "ねね", "momo" to "もも", "ayame" to "あやめ",
+            "reina" to "れいな", "yume" to "ゆめ", "kisaragi" to "きさらぎ",
+            "baka" to "ばか", "dame" to "だめ", "hai" to "はい", "oi" to "おい", "tch" to "ちっ",
+            "chi" to "ちっ", "heh" to "へっ", "hah" to "はっ", "hm" to "ふーん", "hmm" to "ふーん",
+            "mm" to "んー", "mmm" to "んー", "ugh" to "うっ", "pff" to "ぷっ", "pfft" to "ぷっ",
+            "tsk" to "ちっ", "ara" to "あら", "mama" to "まま", "papa" to "ぱぱ", "san" to "さん",
+            "chan" to "ちゃん", "kun" to "くん", "sama" to "さま", "desu" to "です", "masu" to "ます",
+            "kimo" to "きも", "uzai" to "うざい", "maji" to "まじ", "dasai" to "ださい", "gachi" to "がち",
+            "urusee" to "うるせえ", "urusai" to "うるさい", "yabai" to "やばい", "sugoi" to "すごい",
+            "kawaii" to "かわいい", "ossan" to "おっさん", "oniisan" to "おにいさん", "senpai" to "せんぱい",
+            "betsu" to "べつ", "ni" to "に", "sore" to "それ", "demo" to "でも", "ano" to "あの",
+            "nani" to "なに", "nande" to "なんで", "itadakimasu" to "いただきます", "tadaima" to "ただいま",
+            "otsukare" to "おつかれ", "mukatsuku" to "むかつく", "jiwaru" to "じわる", "choroi" to "ちょろい",
+            "yoyuu" to "よゆう", "bibitteru" to "びびってる", "kashikomarimashita" to "かしこまりました",
+            "hatachi" to "はたち", "zako" to "ざこ", "un" to "うん", "ee" to "ええ", "ii" to "いい",
+            "nya" to "にゃ", "e" to "え", "kusa" to "くさ", "muri" to "むり", "yoshi" to "よし",
+            "de" to "で", "yo" to "よ", "mo" to "も", "ko" to "こ"
+        )
+
+        /** English she says the Japanese way, set phrases more than words. */
+        val ENGLISH_SAYINGS: Map<String, String> = mapOf(
+            "ok" to "オッケー", "okay" to "オッケー", "k" to "オッケー", "lol" to "ロル", "bro" to "ブロ",
+            "yeah" to "イェー", "yep" to "イェップ", "nope" to "ノープ", "bye" to "バイバイ", "hi" to "ハイ",
+            "hey" to "ヘイ", "yes" to "イエス", "no" to "ノー", "wow" to "ワオ", "omg" to "オーマイガー",
+            "haha" to "ははっ", "ha" to "はっ", "hahaha" to "あははっ", "i" to "アイ", "a" to "ア",
