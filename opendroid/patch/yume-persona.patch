+    /** The most of her open threads that "about this moment" names. */
+    const val MAX_THREADS_NAMED = 8
+
+    /**
+     * The keys of her threads that are still going on, as her page for this moment shows
+     * them: only notes that were on that page ([shownKeys], their storage keys), so a
+     * note the route left out, or one the page had no room for, is not named. Keys only,
+     * in the order of the notebook, at most [MAX_THREADS_NAMED].
+     */
+    fun openThreads(notes: List<PersonaNotes.Note>, shownKeys: Set<String>): List<String> =
+        notes.asSequence()
+            .filter { it.kind == PersonaNotes.Kind.THREAD && !it.isClosedThread && it.storageKey in shownKeys }
+            .map { it.key }
+            .distinct()
+            .take(MAX_THREADS_NAMED)
+            .toList()
