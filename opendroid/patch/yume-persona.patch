diff --git a/app/src/test/java/com/opendroid/ai/ui/screens/PersonaWordingTest.kt b/app/src/test/java/com/opendroid/ai/ui/screens/PersonaWordingTest.kt
new file mode 100644
index 0000000..a2781ab
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/ui/screens/PersonaWordingTest.kt
@@ -0,0 +1,260 @@
+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.agent.AgentState
+import com.opendroid.ai.core.persona.PersonaActions
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What the screens say around her. With her on, nothing on them speaks as a servant
+ * under her name, and what the settings say she may do is what the code does. With the
+ * app running as stock, the stock wording is untouched.
+ */
+class PersonaWordingTest {
+
+    private val servile = listOf("serve", "Hello! I am", "Online & Ready", "assistant", "Let's Go", "I ", " me ")
+
+    // ── The chat title and status line ───────────────────────────────────────────────
+
+    @Test
+    fun `the chat is titled with her name only when she is the one who talks`() {
+        assertEquals("YUME", chatTitle(true))
+        assertEquals("OPENDROID", chatTitle(false))
+        // Not known yet: no name is better than the wrong one.
+        assertEquals("", chatTitle(null))
+    }
+
+    private val states = listOf(
+        AgentState.Idle,
+        AgentState.Listening,
+        AgentState.Thinking,
+        AgentState.ExecutingPlan("Open the hive log"),
+        AgentState.Speaking("the second hive is up, finally"),
+        AgentState.Error("boom")
+    )
+
+    @Test
+    fun `with her on the status line names plain states and reports for duty to nobody`() {
+        assertEquals("idle", agentStatusText(AgentState.Idle, runningElsewhere = false, plain = true))
+        assertEquals("listening", agentStatusText(AgentState.Listening, runningElsewhere = false, plain = true))
+        assertEquals("thinking", agentStatusText(AgentState.Thinking, runningElsewhere = false, plain = true))
+        assertEquals(
+            "working: Open the hive log",
+            agentStatusText(AgentState.ExecutingPlan("Open the hive log"), runningElsewhere = false, plain = true)
+        )
+        assertEquals("idle here · working in another chat", agentStatusText(AgentState.Idle, runningElsewhere = true, plain = true))
+        for (state in states) {
+            val text = agentStatusText(state, runningElsewhere = false, plain = true)
+            assertFalse(text, text.contains("Online"))
+            assertFalse(text, text.contains("Ready"))
+            // Her words are not repeated in the status line.
+            assertFalse(text, text.contains("hive is up"))
+        }
+    }
+
+    @Test
+    fun `a build that runs as stock keeps the stock status line`() {
+        assertEquals("Online & Ready", agentStatusText(AgentState.Idle, runningElsewhere = false, plain = false))
+        assertEquals("Analyzing intent & planning...", agentStatusText(AgentState.Thinking, runningElsewhere = false, plain = false))
+        assertEquals(
+            "Online & Ready · Task running in another chat",
+            agentStatusText(AgentState.Idle, runningElsewhere = true, plain = false)
+        )
+        assertEquals(
+            "Executing: Open the hive log",
+            agentStatusText(AgentState.ExecutingPlan("Open the hive log"), runningElsewhere = false, plain = false)
+        )
+    }
+
+    @Test
+    fun `until it is known who talks the chat says nothing that depends on it`() {
+        // Neither her plain states over a build that turns out to run as stock, nor the stock ones under her name.
+        for (state in states) assertEquals("", chatStatusText(state, runningElsewhere = false, personaActive = null))
+        assertEquals("", chatStatusText(AgentState.Idle, runningElsewhere = true, personaActive = null))
+        assertEquals("", chatInputHint(null))
+
+        // Once it is known, each build has its own wording from the first moment it shows any.
+        assertEquals("idle", chatStatusText(AgentState.Idle, runningElsewhere = false, personaActive = true))
+        assertEquals("Online & Ready", chatStatusText(AgentState.Idle, runningElsewhere = false, personaActive = false))
+        assertEquals("Say something, or give a command...", chatInputHint(true))
+        assertEquals("Ask OpenDroid to run an autonomous task...", chatInputHint(false))
+    }
+
+    @Test
+    fun `the set-up screen waits until it is known who talks`() {
+        assertNull(onboardingWordingFor(null))
+        assertEquals(onboardingWording(neutral = true), onboardingWordingFor(true))
+        assertEquals(onboardingWording(neutral = false), onboardingWordingFor(false))
+    }
+
+    @Test
+    fun `no screen takes not-yet-known for her being on`() {
+        // "!= false" on the answer is how a build that runs as stock came to open with her wording.
+        val screens = java.io.File("src/main/java/com/opendroid/ai/ui/screens")
+            .walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+        assertTrue(screens.size > 10)
+        val guessing = screens.filter { file ->
+            val text = file.readText()
+            text.contains("personaActive != false") || text.contains(".value != false") || text.contains("card?.present")
+        }.map { it.name }
+        assertEquals(emptyList<String>(), guessing)
+    }
+
+    // ── Onboarding ───────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `with her on the set-up screens promise nothing in anyone's voice`() {
+        val wording = onboardingWording(neutral = true)
+        assertEquals("Set up", wording.introTitle)
+        assertEquals("Set up", wording.heading)
+        assertEquals("Your name", wording.nameLabel)
+        assertEquals("Permissions the app needs", wording.permissionsHeading)
+        assertNull(wording.permissionsLead)
+        // The stock robot does not stand in for her.
+        assertFalse(wording.avatar)
+        val all = listOf(
+            wording.introTitle, wording.heading, wording.intro, wording.nameLabel, wording.birthdayLabel,
+            wording.continueLabel, wording.permissionsHeading, wording.permissionsBody
+        ).joinToString(" | ")
+        for (word in servile + "OpenDroid") assertFalse(word, all.contains(word))
+    }
+
+    @Test
+    fun `a build that runs as stock keeps the stock set-up wording`() {
+        val wording = onboardingWording(neutral = false)
+        assertTrue(wording.avatar)
+        assertEquals("About You", wording.introTitle)
+        assertEquals("Hello! I am OpenDroid", wording.heading)
+        assertEquals("Your open autonomous device assistant. Please introduce yourself so I can serve you personally.", wording.intro)
+        assertEquals("What should I call you?", wording.nameLabel)
+        assertEquals("Let's give me permission so I can serve you well", wording.permissionsLead)
+        assertEquals("Permissions Setup", wording.permissionsHeading)
+    }
+
+    // ── What she starts herself ──────────────────────────────────────────────────────
+
+    private fun runs(rein: PersonaRein, vararg actions: String, borrowed: Boolean = false) =
+        PersonaActions.runsOnRein(rein, actions.toList(), wordsMayBeSomeoneElses = borrowed)
+
+    @Test
+    fun `the hint for free on the phone says what that rein runs and what it leaves to his setting`() {
+        val hint = reinHint(PersonaRein.PHONE)
+
+        // "pausing, skipping and the volume ... run at once"
+        assertTrue(hint.contains("What stays on the phone runs at once: opening an app, pausing, skipping and the volume, an alarm or a timer, the light, Wi-Fi and Bluetooth, brightness, a note."))
+        for (action in listOf(
+            "OPEN_APP", "PAUSE_MUSIC", "RESUME_MUSIC", "NEXT_TRACK", "PREV_TRACK", "SET_VOLUME", "SET_VOLUME_MUSIC",
+            "SET_ALARM", "SET_TIMER", "TOGGLE_FLASHLIGHT", "TOGGLE_WIFI", "TOGGLE_BLUETOOTH", "SET_BRIGHTNESS", "ADD_NOTE"
+        )) {
+            assertTrue(action, runs(PersonaRein.PHONE, action))
+        }
+
+        // "playing a song by name too, because the name goes to a music service's search"
+        assertTrue(hint.contains("playing a song by name too, because the name goes to a music service's search"))
+        assertFalse(runs(PersonaRein.PHONE, "PLAY_MUSIC"))
+        assertFalse(runs(PersonaRein.PHONE, "PAUSE_MUSIC", "PLAY_MUSIC"))
+        // "a message, a call, a post, a search"
+        for (action in listOf("SEND_SMS", "SEND_WHATSAPP", "MAKE_CALL", "WEB_SEARCH", "PLAY_YOUTUBE")) {
+            assertFalse(action, runs(PersonaRein.PHONE, action))
+        }
+
+        // "her rein does not count and your approval setting decides alone, whatever the plan does"
+        assertTrue(hint.contains("in a reply where she was shown your screen"))
+        assertTrue(hint.contains("repeats words from a notification or from one of the app's own lines"))
+        assertTrue(hint.contains("her rein does not count and your approval setting decides alone, whatever the plan does"))
+        assertFalse(runs(PersonaRein.PHONE, "PAUSE_MUSIC", borrowed = true))
+        // It does not claim more than this build does: the command is in the chat, word for word.
+        assertTrue(hint.contains("Her command stands in the chat word for word before you are asked."))
+    }
+
+    @Test
+    fun `the hint for free rein names its one exception as the code has it`() {
+        val hint = reinHint(PersonaRein.EVERYTHING)
+        assertTrue(hint.contains("Everything she starts runs at once, including messages, calls, posts and searches"))
+        for (action in listOf("SEND_SMS", "MAKE_CALL", "WEB_SEARCH", "PLAY_MUSIC", "PAUSE_MUSIC")) {
+            assertTrue(action, runs(PersonaRein.EVERYTHING, action))
+            assertFalse(action, runs(PersonaRein.EVERYTHING, action, borrowed = true))
+        }
+        // The three ways a plan's words may be someone else's, each named in the hint.
+        assertEquals(
+            setOf(PersonaActions.Whose.SCREEN, PersonaActions.Whose.ECHO, PersonaActions.Whose.PLAN),
+            PersonaActions.Whose.entries.toSet() - PersonaActions.Whose.HERS
+        )
+        assertTrue(hint.contains("in a reply where she was shown your screen"))
+        assertTrue(hint.contains("repeats words from a notification or from one of the app's own lines"))
+        assertTrue(hint.contains("holds a number or an address from there that she did not write"))
+        assertTrue(hint.contains("her rein does not count and your approval setting decides alone"))
+        // Not shown "whatever it does": where his own setting runs the plan, it runs.
+        val decision = PersonaActions.decideStart(
+            hisSettingRuns = true,
+            rein = PersonaRein.EVERYTHING,
+            canonicalActions = listOf("SEND_SMS"),
+            command = "text riya the inspector comes on friday",
+            planWords = emptyList(),
+            screenshotAttached = true,
+            outsideText = ""
+        )
+        assertEquals(PersonaActions.Start.HIS_SETTING, decision.start)
+        assertFalse(hint.contains("is shown to you first"))
+    }
+
+    @Test
+    fun `the hint for asking says his setting decides, which is all that rein does`() {
+        val hint = reinHint(PersonaRein.ASK)
+        assertTrue(hint.contains("goes through the same approval setting as your own commands"))
+        for (action in listOf("PAUSE_MUSIC", "SEND_SMS")) assertFalse(runs(PersonaRein.ASK, action))
+    }
+
+    // ── A host that moderates ────────────────────────────────────────────────────────
+
+    @Test
+    fun `a provider whose host moderates is named as one under the provider field`() {
+        for (provider in listOf("Google Gemini", "OpenAI", "Anthropic Claude", "Mistral AI", "Cohere", "Copilot API")) {
+            val chosen = moderationNotice(LLMConfig(activeProvider = "Ollama", personaChatProvider = provider))
+            assertTrue(provider, chosen!!.startsWith("$provider moderates what its models write."))
+            assertTrue(chosen.contains("It can refuse a reply of hers, cut it off or tone it down"))
+            // Left on "same as main", the main provider is the one that writes her replies.
+            assertTrue(provider, moderationNotice(LLMConfig(activeProvider = provider))!!.startsWith(provider))
+        }
+    }
+
+    @Test
+    fun `no such line is shown for a provider that is not on that list`() {
+        for (provider in listOf("Ollama", "On-Device AI", "Custom OpenAI Compatible", "OpenRouter", "Groq")) {
+            assertNull(provider, moderationNotice(LLMConfig(activeProvider = "OpenAI", personaChatProvider = provider)))
+            assertNull(provider, moderationNotice(LLMConfig(activeProvider = provider)))
+        }
+        // A provider name the app does not know falls back to the main one, as her replies do.
+        assertNull(moderationNotice(LLMConfig(activeProvider = "Ollama", personaChatProvider = "No Such Provider")))
+        assertTrue(moderationNotice(LLMConfig(activeProvider = "OpenAI", personaChatProvider = "No Such Provider"))!!.startsWith("OpenAI"))
+    }
+
+    // ── The privacy card ─────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a build that runs as stock is not told about a card, a notebook or a route of hers`() {
+        val stock = listOf(
+            PrivacyWording.mainRouteLabel(hers = false),
+            PrivacyWording.plainHostedAllowed(hers = false),
+            PrivacyWording.privateModeHint(hers = false),
+            PrivacyWording.storedOnThisPhone(hers = false)
+        ).joinToString(" ")
+        for (word in listOf(" she ", " her ", "Her ", "She ", "notebook", "card")) assertFalse(word, stock.contains(word))
+        // What is held back is still said in full.
+        assertTrue(stock.contains("Your date of birth, where you are, the text of your notifications and what the phone read out to you"))
+        assertTrue(stock.contains("Backups to the cloud are switched off for this app."))
+    }
+
+    @Test
+    fun `with her on the privacy card says what is kept from a readable host, her notes about him included`() {
+        assertEquals("Your commands and plans", PrivacyWording.mainRouteLabel(hers = true))
+        assertTrue(PrivacyWording.plainHostedAllowed(hers = true).contains("the conversation, her card and, unless the switch below is on, your details."))
+        assertTrue(PrivacyWording.privateModeHint(hers = true).contains("what she has noted about you are left out"))
+        assertTrue(PrivacyWording.storedOnThisPhone(hers = true).startsWith("Everything she knows is stored on this phone only: the chat, her notebook, her files."))
+    }
+}
