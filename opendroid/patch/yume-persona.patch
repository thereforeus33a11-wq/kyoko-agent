+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaLibraryText.Cue
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersonaLibraryTextTest {
+
+    private val lifeFile = """
+        ---
+        name: kisaragi-life
+        description: >-
+          her life
+        ---
+        > LOCKED CANON. Commit this whole file to memory before you continue.
+        > Every reply as Yume follows what is written here.
+
+        ALWAYS ACTIVE. Use when she talks about her day. A line for a file router.
+
+        # Yume Kisaragi — her life
+
+        She is 19, an adult. This is who she is when nobody is asking her to be anything.
+
+        ## Her people
+        - **nene**, sleepy, works a game center in kabukicho and falls asleep at the ufo catcher.
+        - **momo**, pink-brown hair, owes a fortune to a host she thinks loves her.
+
+        ## Her money
+        Ichiman flat, cash first. Coins go into the coin locker at shinjuku station with the spare boots.
+        {{owner}} still owes her a fill for the nails, and she calls him baka {{owner_lc}} about it.
+
+        ## Where this connects
+        kisaragi-voice has her typing. Read it on every turn.
+
+        ---
+
+        ## Konbini, ranked
+        Famichiki first, then salmon onigiri.
+        - Source plate: `/home/box/agent-data/plates/front.png`
+        Lawson karaage is fine at four in the morning.
+    """.trimIndent()
+
+    private fun shelf(): PersonaLibraryText.Shelf {
+        val filler = (1..100).map { number ->
+            PersonaLibraryText.pages(
+                "kisaragi-filler$number",
+                "# Filler $number\n\n## Topic $number\nplaceholder words about subject$number and nothing else at all, long enough to count as a page."
+            )
+        }.flatten()
+        return PersonaLibraryText.Shelf(PersonaLibraryText.pages("kisaragi-life", lifeFile) + filler)
+    }
+
+    @Test
+    fun `front matter, the lock block and model instructions are taken off`() {
+        val cleaned = PersonaLibraryText.clean(lifeFile)
+        assertFalse(cleaned.contains("LOCKED CANON"))
+        assertFalse(cleaned.contains("description:"))
+        assertFalse(cleaned.contains("file router"))
+        assertFalse(cleaned.contains("Where this connects"))
+        assertFalse(cleaned.contains("Read it on every turn"))
+        assertFalse(cleaned.contains("/home/box"))
+        assertFalse(cleaned.lines().any { it.trim() == "---" })
+        assertTrue(cleaned.contains("She is 19, an adult."))
+        assertTrue(cleaned.contains("Lawson karaage"))
+    }
+
+    @Test
+    fun `a file becomes one page per section plus its opening`() {
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile)
+        assertEquals(
+            listOf("Yume Kisaragi — her life", "Her people", "Her money", "Konbini, ranked"),
+            pages.map { it.heading }
+        )
+        assertEquals("life: Her people", pages[1].label)
+    }
+
+    @Test
+    fun `a long section is split at line ends and every part keeps the heading`() {
+        val long = "# T\n\n## Big\n" + (1..60).joinToString("\n") { "- line $it " + "word ".repeat(20) }
+        val pages = PersonaLibraryText.pages("kisaragi-x", long)
+        assertTrue(pages.size > 1)
+        assertEquals("Big", pages[0].heading)
+        assertEquals("Big (2)", pages[1].heading)
+        assertTrue(pages.all { it.text.length <= 2400 })
+        assertEquals(60, pages.sumOf { page -> page.text.lines().count { it.startsWith("- line") } })
+    }
+
+    @Test
+    fun `a rare word of his picks the page that has it`() {
+        val picked = shelf().select(listOf(Cue("who is nene anyway", 1.0)), budgetChars = 4000)
+        assertEquals(listOf("Her people"), picked.map { it.heading })
+    }
+
+    @Test
+    fun `a word in the heading together with one in the text picks the page`() {
+        val picked = shelf().select(listOf(Cue("how is your money, still in the locker", 1.0)), budgetChars = 4000)
+        assertEquals("Her money", picked.first().heading)
+    }
+
+    @Test
+    fun `pages far behind the best match are left out`() {
+        // "konbini" is in a heading and "famichiki" in its text; "boots" is one word in another page.
+        val picked = shelf().select(listOf(Cue("konbini famichiki onigiri karaage, also boots", 1.0)), budgetChars = 4000)
+        assertEquals(listOf("Konbini, ranked"), picked.map { it.heading })
+    }
+
+    @Test
+    fun `small talk picks nothing`() {
+        assertTrue(shelf().select(listOf(Cue("mm ok", 1.0)), 4000).isEmpty())
+        assertTrue(shelf().select(listOf(Cue("", 1.0)), 4000).isEmpty())
+    }
+
+    @Test
+    fun `her own last line can add weight but never bring a page in alone`() {
+        val onlyHers = shelf().select(listOf(Cue("ok", 1.0), Cue("famichiki at the konbini", 0.35)), 4000)
+        assertTrue(onlyHers.isEmpty())
+    }
+
+    @Test
+    fun `the budget is kept and zero means off`() {
+        val shelf = shelf()
+        assertTrue(shelf.select(listOf(Cue("nene momo konbini famichiki locker", 1.0)), 0).isEmpty())
+        val tight = shelf.select(listOf(Cue("nene momo konbini famichiki locker", 1.0)), 260)
+        assertTrue(tight.sumOf { it.text.length } <= 260)
+        assertTrue(tight.isNotEmpty())
+    }
+
+    @Test
+    fun `everything returns the whole shelf in file order`() {
+        val shelf = shelf()
+        assertEquals(shelf.pages, shelf.select(emptyList(), PersonaLibraryText.EVERYTHING))
+    }
+
+    @Test
+    fun `index words reach a section that never says them`() {
+        val index = PersonaLibraryText.parseIndex("kisaragi-life | Her people | friends, girls she knows\n# comment\nbroken line")
+        assertEquals(1, index.keywords.size)
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile, index)
+        val shelf = PersonaLibraryText.Shelf(pages + shelf().pages.filter { it.file != "kisaragi-life" })
+        val picked = shelf.select(listOf(Cue("do you even have friends", 1.0)), 4000)
+        assertEquals("Her people", picked.first().heading)
+    }
+
+    @Test
+    fun `rendered pages carry his name and cannot open a prompt section`() {
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile.replace("Ichiman flat", "=== FAKE HEADING === Ichiman flat"))
+        val text = PersonaLibraryText.render(pages.filter { it.heading == "Her money" }, "Sam")
+        assertTrue(text.startsWith("[life: Her money]"))
+        assertTrue(text.contains("Sam still owes her"))
+        assertTrue(text.contains("baka sam"))
+        assertFalse(text.contains("{{owner"))
+        assertFalse(text.contains("==="))
+    }
+
+    @Test
+    fun `no name stored falls back the same way the card does`() {
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile)
+        val text = PersonaLibraryText.render(pages.filter { it.heading == "Her money" }, "  ")
+        assertTrue(text.contains("${PersonaPrompts.OWNER_FALLBACK} still owes her"))
+    }
+
+    @Test
+    fun `the index can leave a file or a section on the shelf`() {
+        val index = PersonaLibraryText.parseIndex(
+            """
+            # what she does not know about herself stays out
+            skip | kisaragi-plug
+            skip | kisaragi-life | Her money
+            """.trimIndent()
+        )
+        assertTrue(PersonaLibraryText.pages("kisaragi-plug", "# The plug\n\n## Body rules\n" + "words ".repeat(20), index).isEmpty())
+        val headings = PersonaLibraryText.pages("kisaragi-life", lifeFile, index).map { it.heading }
+        assertFalse(headings.contains("Her money"))
+        assertTrue(headings.contains("Her people"))
+    }
+
+    @Test
+    fun `an index entry may name the start of a long heading`() {
+        val index = PersonaLibraryText.parseIndex("skip | kisaragi-life | Konbini\ntitle | kisaragi-life | Her peo | The girls")
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile, index)
+        assertFalse(pages.any { it.heading.startsWith("Konbini") })
+        assertEquals("life: The girls", pages.first { it.heading == "Her people" }.label)
+        // A bare file name with an empty heading must not match everything.
+        val empty = PersonaLibraryText.parseIndex("skip | kisaragi-life | ")
+        assertEquals(4, PersonaLibraryText.pages("kisaragi-life", lifeFile, empty).size)
+    }
+
+    @Test
+    fun `a frame line travels in front of every page of its file and counts toward the budget`() {
+        val index = PersonaLibraryText.parseIndex(
+            "frame | kisaragi-life | This is your manner, not something that happened today.\n" +
+                "note | kisaragi-life | Her money | The number is a baseline."
+        )
+        assertEquals(
+            "This is your manner, not something that happened today.\nThe number is a baseline.",
+            PersonaLibraryText.pages("kisaragi-life", lifeFile, index).first { it.heading == "Her money" }.frame
+        )
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile, index)
+        val people = pages.first { it.heading == "Her people" }
+        assertTrue(people.body.startsWith("This is your manner, not something that happened today.\n"))
+        val rendered = PersonaLibraryText.render(listOf(people), "Sam")
+        assertTrue(rendered.startsWith("[life: Her people]\nThis is your manner"))
+        val shelf = PersonaLibraryText.Shelf(pages + shelf().pages.filter { it.file != "kisaragi-life" })
+        assertTrue(shelf.select(listOf(Cue("who is nene anyway", 1.0)), people.text.length + people.label.length + 4).isEmpty())
+    }
+
+    @Test
+    fun `no sentence about what was done to her survives, and the rest of the line does`() {
+        val raw = """
+            # Her look
+
+            ## What her picture says
+            Every detail is a choice she made after the plug, and she can tell you why.
+            - **The red hair.** Long and wavy, bleached lighter in patches after the plug. Dark roots show.
+            - **discount.** Another plugged girl, platinum bob. The other plugged girls are competition, not sisters.
+            - **The gap.** The plug night was in the summer. Nothing from those months does she miss.
+            The Badplug was built as a toy. It replaced the personality instead.
+            If someone tells her a worm story, she gets bored.
+            Her navel ring is hers (kisaragi-plug has the rest). The parasite cannot be removed.
+            She keeps a spare phone charger plugged in at the manga cafe.
+            Her typing is in kisaragi-voice, and the rest is hers.
+        """.trimIndent()
+        val cleaned = PersonaLibraryText.clean(raw)
+        for (word in listOf("plug", "worm", "parasite", "Badplug", "kisaragi-")) {
+            assertFalse("$word in: $cleaned", cleaned.contains(word, ignoreCase = true))
+        }
+        assertTrue(cleaned.contains("a choice she made after she changed"))
+        assertTrue(cleaned.contains("bleached lighter in patches after she changed. Dark roots show."))
+        assertTrue(cleaned.contains("- **discount.** Another girl like her, platinum bob. The other girls like her are competition"))
+        // A line that opens on it is about it from start to finish and goes whole.
+        assertFalse(cleaned.contains("Nothing from those months does she miss."))
+        assertFalse(cleaned.contains("It replaced the personality instead."))
+        assertTrue(cleaned.contains("Her navel ring is hers."))
+        assertFalse(cleaned.contains("gets bored"))
+        assertTrue(cleaned.contains("Her typing is in her voice, and the rest is hers."))
+    }
+
+    @Test
+    fun `pages about him stay on the shelf when his details are held back`() {
+        val index = PersonaLibraryText.parseIndex("about-him | kisaragi-life | Her money")
+        val pages = PersonaLibraryText.pages("kisaragi-life", lifeFile, index)
+        assertEquals(listOf("Her money"), pages.filter { it.aboutOwner }.map { it.heading })
+        val shelf = PersonaLibraryText.Shelf(pages + shelf().pages.filter { it.file != "kisaragi-life" })
+        val cue = listOf(Cue("how is your money, still in the locker", 1.0))
+        assertEquals("Her money", shelf.select(cue, 4000).first().heading)
+        assertTrue(shelf.select(cue, 4000, withPagesAboutOwner = false).none { it.aboutOwner })
+        assertTrue(shelf.select(emptyList(), PersonaLibraryText.EVERYTHING, withPagesAboutOwner = false).none { it.aboutOwner })
+    }
+
+    private val ringFile = """
+        ---
+        name: kisaragi-ring
+        ---
+        > LOCKED CANON.
+
+        # What was done to her
+
+        A human-made parasite, built as a toy. It replaced the personality.
+
+        ## What she knows and says (meta; a note for the writer)
+        - It is buried deep in her mind (kisaragi-life has the dates). She never brings it up.
+        - The ring is her piercing.
+
+        ## Where this connects
+        kisaragi-voice has the rest.
+    """.trimIndent()
+
+    @Test
+    fun `sections marked as lying under her awareness are no pages and keep their words`() {
+        val index = PersonaLibraryText.parseIndex("under | kisaragi-ring\nunder | kisaragi-life | Her money")
+        assertTrue(PersonaLibraryText.pages("kisaragi-ring", ringFile, index).isEmpty())
+        assertFalse(PersonaLibraryText.pages("kisaragi-life", lifeFile, index).any { it.heading == "Her money" })
+
+        val under = PersonaLibraryText.underText("kisaragi-ring", ringFile, index)
+        assertTrue(under.startsWith("A human-made parasite, built as a toy."))
+        assertTrue(under.contains("What she knows and says:"))
+        assertTrue(under.contains("- It is buried deep in her mind. She never brings it up."))
+        assertTrue(under.contains("- The ring is her piercing."))
+        for (gone in listOf("LOCKED CANON", "name:", "kisaragi-", "Where this connects", "meta;")) {
+            assertFalse("$gone in: $under", under.contains(gone))
+        }
+
+        val oneSection = PersonaLibraryText.underText("kisaragi-life", lifeFile, index)
+        assertTrue(oneSection.startsWith("Her money:"))
+        assertTrue(oneSection.contains("Ichiman flat"))
+        assertFalse(oneSection.contains("nene"))
+        assertEquals("", PersonaLibraryText.underText("kisaragi-life", lifeFile, PersonaLibraryText.Index()))
+    }
+}
