+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * "Try her brain" as he uses it: the shortlist ticked to start with, two to four models at a
+ * time, the replies side by side as they come back, failures said in their place, nothing of
+ * the settings changed by a try, and one tap to make a model hers.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class BrainTrialViewModelTest {
+
+    private val venice = HerBrain.PROVIDER
+    private val seeing = VenicePrivateTier.SEEING_BRAIN
+    private val his = LLMConfig(
+        activeProvider = venice,
+        selectedModels = mapOf(venice to "e2ee-deepseek-v4-1-flash-1017-abliterated"),
+        customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+        apiKeys = mapOf(venice to "his-venice-key"),
+        routePolicy = RoutePolicy.ENCRYPTED,
+        trustVenicePrivate = true
+    )
+    private val settings = AtomicReference(his)
+    private val asked = CopyOnWriteArrayList<String>()
+    private val saves = CopyOnWriteArrayList<LLMConfig>()
+
+    private fun viewModel(fail: Set<String> = emptySet()) = BrainTrialViewModel(
+        settings = { settings.get() },
+        save = { update -> settings.set(update(settings.get()).also { saves += it }) },
+        trial = BrainTrial(
+            recentRows = { listOf(ChatMessage("1", "what are you doing tonight", ChatMessage.Sender.USER)) },
+            prompt = { config, rows -> PersonaEngine.requestOfHers(PersonaEngine.replyRequest("her prompt", rows), config) },
+            send = { _, request ->
+                val model = request.modelOverride.orEmpty()
+                asked += model
+                if (model in fail) throw LLMErrorMapper.providerRefused(venice, model)
+                LLMResponse(content = "reply from $model", tokensUsed = 0, model = model, provider = venice, latencyMs = 0, promptTokens = 13_000, completionTokens = 200)
+            }
+        )
+    )
+
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Test
+    fun `the shortlist comes first and is ticked to start with, as many as one try takes`() {
+        val model = viewModel()
+        await("the choices") { model.choices.isNotEmpty() }
+        assertEquals(BrainModels.SHORTLIST.map { it.id }, model.choices.take(BrainModels.SHORTLIST.size).map { it.id })
+        assertTrue(model.choices.drop(BrainModels.SHORTLIST.size).none { it.shortlisted })
+        assertEquals(BrainModels.SHORTLIST.take(4).map { it.id }.toSet(), model.chosen)
+        assertEquals(BrainModels.SHORTLIST.take(4).sumOf { BrainModels.typicalUsd(it.id)!! }, model.cost(), 1e-12)
+        // Every model offered is encrypted or of the Private tier, and none anonymized is.
+        assertTrue(model.choices.all { BrainChoice.offered(his, it.id) })
+        assertTrue(model.choices.none { it.id == "gemini-4-carbon" })
+        // Her brain now is marked.
+        assertTrue(model.choices.single { it.id == "e2ee-deepseek-v4-1-flash-1017-abliterated" }.current)
+        assertEquals(1, model.choices.count { it.current })
+        assertEquals("Now: her replies, her notebook and her own time on e2ee-deepseek-v4-1-flash-1017-abliterated, through $venice.", model.now)
+    }
+
+    @Test
+    fun `untrusted, only the encrypted models are ticked, and a model that cannot go is not ticked at all`() {
+        settings.set(his.copy(trustVenicePrivate = false))
+        val model = viewModel()
+        await("the choices") { model.choices.isNotEmpty() }
+        assertEquals(setOf("e2ee-kimi-k2-6", "e2ee-deepseek-v4-1-flash-1017-abliterated"), model.chosen)
+        model.toggle(seeing)
+        assertFalse(seeing in model.chosen)
+        assertTrue(model.status.contains(BrainChoice.TRUST_SWITCH))
+        assertTrue(model.choices.single { it.id == seeing }.whyNot!!.contains(BrainChoice.TRUST_SWITCH))
+    }
+
+    @Test
+    fun `at most four side by side, and at least two`() {
+        val model = viewModel()
+        await("the choices") { model.choices.isNotEmpty() }
+        model.toggle("kimi-k3")
+        assertFalse("kimi-k3" in model.chosen)
+        assertTrue(model.status.contains("At most 4"))
+        listOf("e2ee-kimi-k2-6", "xiaomi-mimo-v2-5", "venice-uncensored-role-play").forEach(model::toggle)
+        assertEquals(setOf(seeing), model.chosen)
+        model.updateMessage("come over later?")
+        model.start()
+        assertEquals("Choose 2 to 4 models.", model.status)
+        assertTrue(asked.isEmpty())
+    }
+
+    @Test
+    fun `a try shows each reply in its place, says why a model gave none, and changes no setting`() {
+        val model = viewModel(fail = setOf("e2ee-kimi-k2-6"))
+        await("the choices") { model.choices.isNotEmpty() }
+        model.updateMessage("come over later?")
+        model.start()
+        await("the try to end") { !model.running && model.status.startsWith("Done") }
+        assertEquals(BrainModels.SHORTLIST.take(4).map { it.id }, model.rows.map { it.choice.id })
+        assertEquals(4, asked.size)
+        val seen = model.rows.first { it.choice.id == seeing }.shown as BrainTrial.Shown.Reply
+        assertEquals("reply from $seeing", seen.said)
+        val failed = model.rows.first { it.choice.id == "e2ee-kimi-k2-6" }.shown as BrainTrial.Shown.Failed
+        assertTrue(failed.why.contains("turned her reply down"))
+        assertEquals("Done. 1 without a reply: why is said in its place.", model.status)
+        // A try is not a choice: nothing was saved.
+        assertTrue(saves.isEmpty())
+        assertEquals(his, settings.get())
+    }
+
+    @Test
+    fun `the last exchange can be asked again, and a try with no message of his asks nothing`() {
+        val model = viewModel()
+        await("the choices") { model.choices.isNotEmpty() }
+        model.start()
+        await("the try to end") { !model.running && model.status.startsWith("Done") }
+        assertTrue(asked.isEmpty())
+        assertTrue(model.rows.all { (it.shown as BrainTrial.Shown.NotTried).why == BrainTrial.NO_MESSAGE })
+        model.updateUseLast(true)
+        model.start()
+        await("the try to end") { !model.running && asked.size == 4 }
+    }
+
+    @Test
+    fun `use this one makes the model hers, and says how to go back`() {
+        val model = viewModel()
+        await("the choices") { model.choices.isNotEmpty() }
+        model.use(seeing)
+        await("the choice to be saved") { settings.get().personaChatModel == seeing }
+        assertEquals(BrainChoice.use(his, seeing), settings.get())
+        await("the screen to say so") { model.status.isNotEmpty() }
+        assertTrue(model.status.contains("now writes her replies, her notebook and her own time"))
+        assertTrue(model.status.contains("Pictures meant for her go to it directly, after the age check."))
+        assertTrue(model.status.contains(HerBrain.BACK_LABEL))
+        assertTrue(model.choices.single { it.id == seeing }.current)
+        assertTrue(model.now.contains(seeing))
+        // A model that cannot go is not made hers.
+        settings.set(settings.get().copy(trustVenicePrivate = false))
+        val before = settings.get()
+        model.use("kimi-k3")
+        await("the reason") { model.status.contains(BrainChoice.TRUST_SWITCH) }
+        assertEquals(before, settings.get())
+    }
+}
