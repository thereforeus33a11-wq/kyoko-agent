index 0000000..b241e4a
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/llm/providers/TdxQuote.kt
@@ -0,0 +1,175 @@
+package com.opendroid.ai.core.llm.providers
+
+import java.io.IOException
+import java.util.Base64
+
+/**
+ * The two fields of an Intel TDX quote this app reads, cut out of the quote by position.
+ *
+ * A quote is the statement a hardware enclave makes about itself. Its layout is fixed by
+ * Intel's "TDX DCAP Quoting Library API" document: a 48-byte header, then the report
+ * body. Version 4 puts the body right after the header; version 5 puts a 6-byte
+ * type-and-size prefix in front of it. In both, the body starts with the same 584 bytes:
+ *
+ *     offset 120, 8 bytes   TD attributes; the low byte is the "under debug" group
+ *     offset 520, 64 bytes  report data, chosen by the software inside the enclave
+ *
+ * Nothing here verifies the quote's signature: this only reads what the quote says.
+ */
+internal class TdxQuote private constructor(
+    val version: Int,
+    private val tdAttributes: ByteArray,
+    val reportData: ByteArray
+) {
+    /**
+     * True when any "TD under debug" bit is set. Such an enclave can be looked into by
+     * the machine that hosts it, so nothing may be encrypted to a key from one. Intel
+     * reserves the whole low byte for this group and says any bit set means untrusted.
+     */
+    val isDebug: Boolean get() = tdAttributes[0].toInt() != 0
+
+    companion object {
+        private const val HEADER_BYTES = 48
+        private const val V5_BODY_PREFIX_BYTES = 6
+        private const val TD_REPORT_BYTES = 584
+        private const val TD_ATTRIBUTES_OFFSET = 120
+        private const val TD_ATTRIBUTES_BYTES = 8
+        private const val REPORT_DATA_OFFSET = 520
+        const val REPORT_DATA_BYTES = 64
+
+        private const val TEE_TYPE_TDX = 0x81L
+        private const val V5_BODY_TDX_1_0 = 2
+        private const val V5_BODY_TDX_1_5 = 3
+
+        /** Reads a quote given as hex or as base64, the two forms it is served in. */
+        fun parse(encoded: String): TdxQuote {
+            val text = encoded.filterNot(Char::isWhitespace).removePrefix("0x")
+            if (text.isEmpty()) throw IOException("Hardware quote is empty")
+            val isHex = text.length % 2 == 0 && text.all { Character.digit(it, 16) >= 0 }
+            val bytes = if (isHex) {
+                VeniceE2ee.unhex(text)
+            } else {
+                try {
+                    Base64.getDecoder().decode(text.replace('-', '+').replace('_', '/'))
+                } catch (e: IllegalArgumentException) {
+                    throw IOException("Hardware quote is neither hex nor base64")
+                }
+            }
+            return parse(bytes)
+        }
+
+        fun parse(quote: ByteArray): TdxQuote {
+            if (quote.size < HEADER_BYTES) throw IOException("Hardware quote is too short")
+            val version = uint16(quote, 0)
+            val teeType = uint32(quote, 4)
+            if (teeType != TEE_TYPE_TDX) throw IOException("Hardware quote is not a TDX quote")
+            val bodyStart = when (version) {
+                4 -> HEADER_BYTES
+                5 -> {
+                    if (quote.size < HEADER_BYTES + V5_BODY_PREFIX_BYTES) throw IOException("Hardware quote is too short")
+                    val bodyType = uint16(quote, HEADER_BYTES)
+                    val bodySize = uint32(quote, HEADER_BYTES + 2)
+                    if (bodyType != V5_BODY_TDX_1_0 && bodyType != V5_BODY_TDX_1_5) {
+                        throw IOException("Hardware quote is not a TDX quote")
+                    }
+                    if (bodySize < TD_REPORT_BYTES) throw IOException("Hardware quote body is too short")
+                    HEADER_BYTES + V5_BODY_PREFIX_BYTES
+                }
+                else -> throw IOException("Hardware quote version is not supported")
+            }
+            if (quote.size < bodyStart + TD_REPORT_BYTES) throw IOException("Hardware quote is too short")
+            return TdxQuote(
+                version = version,
+                tdAttributes = quote.copyOfRange(
+                    bodyStart + TD_ATTRIBUTES_OFFSET,
+                    bodyStart + TD_ATTRIBUTES_OFFSET + TD_ATTRIBUTES_BYTES
+                ),
+                reportData = quote.copyOfRange(
+                    bodyStart + REPORT_DATA_OFFSET,
+                    bodyStart + REPORT_DATA_OFFSET + REPORT_DATA_BYTES
+                )
+            )
+        }
+
+        // Quote fields are little-endian.
+        private fun uint16(bytes: ByteArray, offset: Int): Int =
+            (bytes[offset].toInt() and 0xff) or ((bytes[offset + 1].toInt() and 0xff) shl 8)
+
+        private fun uint32(bytes: ByteArray, offset: Int): Long =
+            uint16(bytes, offset).toLong() or (uint16(bytes, offset + 2).toLong() shl 16)
+    }
+}
+
+/**
+ * Keccak-256, the hash Ethereum addresses are made with. It is not SHA3-256: the two
+ * differ in one padding byte, and Android offers neither under this name.
+ */
+internal object Keccak256 {
+    private const val RATE_BYTES = 136
+    private const val KECCAK_PADDING: Byte = 0x01
+
+    private val ROUND_CONSTANTS = longArrayOf(
+        0x0000000000000001L, 0x0000000000008082L, 0x800000000000808aUL.toLong(), 0x8000000080008000UL.toLong(),
+        0x000000000000808bL, 0x0000000080000001L, 0x8000000080008081UL.toLong(), 0x8000000000008009UL.toLong(),
+        0x000000000000008aL, 0x0000000000000088L, 0x0000000080008009L, 0x000000008000000aL,
+        0x000000008000808bL, 0x800000000000008bUL.toLong(), 0x8000000000008089UL.toLong(), 0x8000000000008003UL.toLong(),
+        0x8000000000008002UL.toLong(), 0x8000000000000080UL.toLong(), 0x000000000000800aL, 0x800000008000000aUL.toLong(),
+        0x8000000080008081UL.toLong(), 0x8000000000008080UL.toLong(), 0x0000000080000001L, 0x8000000080008008UL.toLong()
+    )
+    private val ROTATIONS = intArrayOf(1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44)
+    private val LANE_ORDER = intArrayOf(10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1)
+
+    fun digest(input: ByteArray): ByteArray = sponge(input, KECCAK_PADDING)
+
+    /**
+     * The hash with [paddingStart] as the first padding byte. Keccak uses 0x01 and SHA-3
+     * uses 0x06; everything else is shared, which lets a test check this code against
+     * the platform's own SHA3-256.
+     */
+    internal fun sponge(input: ByteArray, paddingStart: Byte): ByteArray {
+        val state = LongArray(25)
+        var offset = 0
+        while (input.size - offset >= RATE_BYTES) {
+            for (i in 0 until RATE_BYTES) xorByte(state, i, input[offset + i])
+            permute(state)
+            offset += RATE_BYTES
+        }
+        val rest = input.size - offset
+        for (i in 0 until rest) xorByte(state, i, input[offset + i])
+        xorByte(state, rest, paddingStart)
+        xorByte(state, RATE_BYTES - 1, 0x80.toByte())
+        permute(state)
+        return ByteArray(32) { i -> (state[i / 8] ushr (8 * (i % 8))).toByte() }
+    }
+
+    private fun xorByte(state: LongArray, position: Int, value: Byte) {
+        state[position / 8] = state[position / 8] xor ((value.toLong() and 0xff) shl (8 * (position % 8)))
+    }
+
+    private fun permute(state: LongArray) {
+        val column = LongArray(5)
+        for (round in 0 until 24) {
+            for (x in 0 until 5) {
+                column[x] = state[x] xor state[x + 5] xor state[x + 10] xor state[x + 15] xor state[x + 20]
+            }
+            for (x in 0 until 5) {
+                val mix = column[(x + 4) % 5] xor java.lang.Long.rotateLeft(column[(x + 1) % 5], 1)
+                for (y in 0 until 25 step 5) state[y + x] = state[y + x] xor mix
+            }
+            var carried = state[1]
+            for (i in 0 until 24) {
+                val lane = LANE_ORDER[i]
+                val next = state[lane]
+                state[lane] = java.lang.Long.rotateLeft(carried, ROTATIONS[i])
+                carried = next
+            }
+            for (y in 0 until 25 step 5) {
+                for (x in 0 until 5) column[x] = state[y + x]
+                for (x in 0 until 5) {
+                    state[y + x] = column[x] xor (column[(x + 1) % 5].inv() and column[(x + 2) % 5])
+                }
+            }
+            state[0] = state[0] xor ROUND_CONSTANTS[round]
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/llm/providers/VeniceE2ee.kt b/app/src/main/java/com/opendroid/ai/core/llm/providers/VeniceE2ee.kt
new file mode 100644
index 0000000..95ffd00
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/llm/providers/VeniceE2ee.kt
@@ -0,0 +1,358 @@
+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import java.io.IOException
+import java.math.BigInteger
+import java.security.GeneralSecurityException
+import java.security.MessageDigest
+import java.security.SecureRandom
+import javax.crypto.Cipher
+import javax.crypto.Mac
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.SecretKeySpec
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+
+/**
+ * Client side of Venice's end-to-end encrypted inference, written from the protocol in
+ * Venice's published "TEE & E2EE Models" guide.
+ *
+ * The prompt is encrypted on this phone to a key that lives inside a hardware enclave
+ * (a TEE). Venice's servers relay ciphertext; only the enclave that runs the model can
+ * read the prompt, and it encrypts the reply back to a key generated here for that one
+ * request. Used for any model whose id starts with `e2ee-`.
+ *
+ * Scheme: ECDH on secp256k1 -> HKDF-SHA256 (info "ecdsa_encryption", no salt) ->
+ * AES-256-GCM. A message is hex of `ephemeral public key (65) || nonce (12) || ciphertext+tag`.
+ *
+ * What "end to end" means here, and what it does not: the text is unreadable to Venice's
+ * own servers and network. It is decrypted inside the enclave, which is run by a partner
+ * of Venice's, and that enclave hands the plain text to the machine that runs the model.
+ * See [modelKeyFromAttestation] for how far this phone can check the enclave itself.
+ */
+internal object VeniceE2ee {
+
+    const val MODEL_PREFIX = "e2ee-"
+
+    /** The one host the encrypted exchange is spoken with. */
+    const val PINNED_HOST = "api.venice.ai"
+
+    /**
+     * The least output room asked for on this route. The models served this way reason
+     * before they answer, some of them always, and the reasoning is paid for out of the
+     * same limit as the answer. A caller that asks for a short answer (a classification, a
+     * one-line reply) would get back nothing but spent reasoning.
+     */
+    const val MIN_OUTPUT_TOKENS = 4000
+
+    private val HKDF_INFO = "ecdsa_encryption".toByteArray(Charsets.US_ASCII)
+    private const val PUBLIC_KEY_BYTES = 65
+    private const val NONCE_BYTES = 12
+    private const val TAG_BYTES = 16
+    private const val ADDRESS_BYTES = 20
+
+    fun isE2eeModel(model: String): Boolean = model.trim().startsWith(MODEL_PREFIX, ignoreCase = true)
+
+    /**
+     * [baseUrl] as an address to send to, or null when it is anything but https on
+     * [PINNED_HOST]. The protocol, the attestation and the limits written down here are
+     * Venice's; any other server that is handed an `e2ee-` model id could answer the
+     * attestation with a key of its own and read everything. So the encrypted path does
+     * not run anywhere else.
+     *
+     * Parsed by the same code that sends the request, and the request is built from the
+     * parsed value, so the host that was checked is the host that is spoken to.
+     */
+    fun pinnedBaseUrl(baseUrl: String): HttpUrl? {
+        val url = baseUrl.trim().toHttpUrlOrNull() ?: return null
+        return url.takeIf { it.isHttps && it.host == PINNED_HOST && it.username.isEmpty() && it.password.isEmpty() }
+    }
+
+    /**
+     * True when [model] is a plain model id. Venice also reads request options from a
+     * `:name=value` tail on the id (`:enable_e2ee=false` among them), which would let a
+     * typed model name switch off what this path exists for.
+     */
+    fun isPlainModelId(model: String): Boolean = ':' !in model
+
+    class KeyPair(val privateKey: BigInteger, val publicKeyHex: String)
+
+    fun generateKeyPair(random: SecureRandom = SecureRandom()): KeyPair {
+        val privateKey = Secp256k1.randomScalar(random)
+        return KeyPair(privateKey, hex(Secp256k1.encode(Secp256k1.multiply(Secp256k1.G, privateKey))))
+    }
+
+    /** Encrypts [plaintext] so that only the holder of [recipientPublicKeyHex]'s private key can read it. */
+    fun encrypt(plaintext: String, recipientPublicKeyHex: String, random: SecureRandom = SecureRandom()): String {
+        val recipient = Secp256k1.decode(normalizePublicKey(recipientPublicKeyHex))
+        val ephemeral = generateKeyPair(random)
+        val key = deriveKey(Secp256k1.multiply(recipient, ephemeral.privateKey))
+        val nonce = ByteArray(NONCE_BYTES).also(random::nextBytes)
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+        cipher.init(Cipher.ENCRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(TAG_BYTES * 8, nonce))
+        val sealed = cipher.doFinal(plaintext.toByteArray(Charsets.UTF_8))
+        return ephemeral.publicKeyHex + hex(nonce) + hex(sealed)
+    }
+
+    /** Decrypts a message that was encrypted to the public key of [privateKey]. */
+    fun decrypt(ciphertextHex: String, privateKey: BigInteger): String {
+        val raw = unhex(ciphertextHex.removePrefix("0x"))
+        if (raw.size < PUBLIC_KEY_BYTES + NONCE_BYTES + TAG_BYTES) throw IOException("Encrypted reply is too short")
+        val sender = Secp256k1.decode(raw.copyOfRange(0, PUBLIC_KEY_BYTES))
+        val nonce = raw.copyOfRange(PUBLIC_KEY_BYTES, PUBLIC_KEY_BYTES + NONCE_BYTES)
+        val key = deriveKey(Secp256k1.multiply(sender, privateKey))
+        val opened = try {
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(TAG_BYTES * 8, nonce))
+            cipher.doFinal(raw, PUBLIC_KEY_BYTES + NONCE_BYTES, raw.size - PUBLIC_KEY_BYTES - NONCE_BYTES)
+        } catch (e: GeneralSecurityException) {
+            // Not encrypted to this request's key, or changed on the way.
+            throw IOException("Encrypted reply could not be opened")
+        }
+        return String(opened, Charsets.UTF_8)
+    }
+
+    /** True when [text] has the shape of an encrypted message (even-length hex of at least the minimum size). */
+    fun looksEncrypted(text: String): Boolean =
+        text.length >= (PUBLIC_KEY_BYTES + NONCE_BYTES + TAG_BYTES) * 2 &&
+            text.length % 2 == 0 &&
+            text.all { it in '0'..'9' || it in 'a'..'f' || it in 'A'..'F' }
+
+    /**
+     * The enclave's public key, taken from an attestation only after everything that can
+     * be checked on this phone, without asking anyone else, has been checked.
+     *
+     * Checked here, and the request is not sent unless all of it holds:
+     *  - Venice's answer says the attestation verified;
+     *  - it repeats the random number this request made up, so it is not an old answer;
+     *  - it names the model that was asked for;
+     *  - the key is a real point on the curve;
+     *  - the hardware quote (Intel TDX) is there and well formed, does not come from an
+     *    enclave in debug mode, and carries this key and this request's random number in
+     *    its report data, where the reference client looks for them: the key's
+     *    Ethereum-style address in bytes 0..19, the number in bytes 32..63.
+     *
+     * Taken on Venice's word, because this phone does not check it:
+     *  - that the quote is genuine. Its signature and Intel's certificate chain are not
+     *    verified here, so a relay that set out to cheat could make up a quote that passes
+     *    every check above and get a prompt it can read;
+     *  - what runs inside the enclave. Its measurements are not compared with known good
+     *    values (Venice's guide gives none), and the graphics card evidence is not checked;
+     *  - that the reply is the enclave's, whole and in order. Each piece of the reply is
+     *    encrypted to this request's public key, which travels in a header Venice reads,
+     *    and no piece is signed. Venice cannot read what the enclave wrote, but it could
+     *    leave pieces out, change their order or put in pieces of its own, and nothing
+     *    here would notice. The signed receipt Venice offers for a finished reply is not
+     *    fetched; as measured by the open-source proxy for this protocol, it shows that
+     *    the enclave answered this request, not that these are the bytes it sent.
+     *
+     * So this catches a stale, mismatched or mistaken attestation and a debug enclave,
+     * and keeps the prompt and the reply unreadable to Venice. It does not prove the
+     * hardware, or the reply, to someone who assumes Venice itself is lying.
+     */
+    fun modelKeyFromAttestation(body: String, expectedNonce: String, expectedModel: String): String {
+        val attestation: JsonObject = try {
+            JsonParser.parseString(body).asJsonObject
+        } catch (e: Exception) {
+            throw IOException("Attestation reply could not be read")
+        }
+        val verified = attestation.get("verified")?.takeIf { it.isJsonPrimitive }?.asJsonPrimitive
+        if (verified == null || !verified.isBoolean || !verified.asBoolean) {
+            throw IOException("The model's enclave did not pass attestation")
+        }
+        val nonce = stringField(attestation, "nonce")
+        if (nonce == null || !nonce.equals(expectedNonce, ignoreCase = true)) {
+            throw IOException("Attestation does not match this request")
+        }
+        val model = stringField(attestation, "model")
+        if (model == null || !model.trim().equals(expectedModel.trim(), ignoreCase = true)) {
+            throw IOException("Attestation is for another model")
+        }
+        val key = sequenceOf("signing_key", "signing_public_key")
+            .mapNotNull { name -> stringField(attestation, name) }
+            .firstOrNull { it.isNotBlank() }
+            ?: throw IOException("Attestation carries no key to encrypt to")
+        // Fails here, before anything is encrypted to it, if it is not a point on the curve.
+        val keyBytes = normalizePublicKey(key)
+        Secp256k1.decode(keyBytes)
+
+        val quote = TdxQuote.parse(
+            stringField(attestation, "intel_quote")?.takeIf { it.isNotBlank() }
+                ?: throw IOException("Attestation carries no hardware quote")
+        )
+        if (quote.isDebug) throw IOException("The model's enclave runs in debug mode")
+        val reportData = quote.reportData
+        val boundKey = reportData.copyOfRange(0, ADDRESS_BYTES)
+        if (!MessageDigest.isEqual(boundKey, ethereumAddress(keyBytes))) {
+            throw IOException("The hardware quote is for another key")
+        }
+        val nonceBytes = unhex(expectedNonce)
+        val boundNonce = reportData.copyOfRange(TdxQuote.REPORT_DATA_BYTES - 32, TdxQuote.REPORT_DATA_BYTES)
+        // The reference client accepts the number as sent or as its SHA-256.
+        if (!MessageDigest.isEqual(boundNonce, nonceBytes) &&
+            !MessageDigest.isEqual(boundNonce, MessageDigest.getInstance("SHA-256").digest(nonceBytes))
+        ) {
+            throw IOException("The hardware quote is for another request")
+        }
+        return key
+    }
+
+    /** The last 20 bytes of Keccak-256 over the key's two coordinates. */
+    internal fun ethereumAddress(uncompressedPublicKey: ByteArray): ByteArray =
+        Keccak256.digest(uncompressedPublicKey.copyOfRange(1, PUBLIC_KEY_BYTES)).copyOfRange(32 - ADDRESS_BYTES, 32)
+
+    private fun stringField(json: JsonObject, name: String): String? =
+        json.get(name)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+
+    fun newNonceHex(random: SecureRandom = SecureRandom()): String = hex(ByteArray(32).also(random::nextBytes))
+
+    private fun normalizePublicKey(publicKeyHex: String): ByteArray {
+        var keyHex = publicKeyHex.trim().removePrefix("0x")
+        // 128 digits are the two coordinates without the 04 in front. The length alone
+        // decides: a first coordinate can itself begin with 04.
+        if (keyHex.length == 128) keyHex = "04$keyHex"
+        return unhex(keyHex)
+    }
+
+    private fun deriveKey(sharedPoint: Secp256k1.Point): ByteArray {
+        val x = sharedPoint.x ?: throw IOException("Key agreement failed")
+        return hkdfSha256(Secp256k1.to32Bytes(x), HKDF_INFO, 32)
+    }
+
+    /** HKDF (RFC 5869) with SHA-256 and no salt. */
+    internal fun hkdfSha256(inputKey: ByteArray, info: ByteArray, length: Int): ByteArray {
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(SecretKeySpec(ByteArray(32), "HmacSHA256"))
+        val pseudoRandomKey = mac.doFinal(inputKey)
+        val output = ByteArray(length)
+        var previous = ByteArray(0)
+        var filled = 0
+        var counter = 1
+        while (filled < length) {
+            mac.init(SecretKeySpec(pseudoRandomKey, "HmacSHA256"))
+            mac.update(previous)
+            mac.update(info)
+            mac.update(counter.toByte())
+            previous = mac.doFinal()
+            val take = minOf(previous.size, length - filled)
+            System.arraycopy(previous, 0, output, filled, take)
+            filled += take
+            counter++
+        }
+        return output
+    }
+
+    internal fun hex(bytes: ByteArray): String {
+        val digits = "0123456789abcdef"
+        val out = StringBuilder(bytes.size * 2)
+        for (b in bytes) {
+            val v = b.toInt() and 0xff
+            out.append(digits[v ushr 4]).append(digits[v and 0x0f])
+        }
+        return out.toString()
+    }
+
+    internal fun unhex(text: String): ByteArray {
+        if (text.length % 2 != 0) throw IOException("Malformed hex")
+        return ByteArray(text.length / 2) { i ->
+            val hi = Character.digit(text[i * 2], 16)
+            val lo = Character.digit(text[i * 2 + 1], 16)
+            if (hi < 0 || lo < 0) throw IOException("Malformed hex")
+            ((hi shl 4) or lo).toByte()
+        }
+    }
+}
+
+/**
+ * The encrypted exchange did not go as the protocol says: part of the reply was readable
+ * on the way, or would not open with this request's key. The message is a fixed
+ * sentence, never anything taken from the exchange.
+ */
+internal class E2eeProtocolException(message: String) : IOException(message)
+
+/**
+ * The secp256k1 curve, y^2 = x^3 + 7 over a prime field, with only what key agreement
+ * needs. Android's built-in providers do not offer this curve.
+ */
+internal object Secp256k1 {
+    private val P = BigInteger("fffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f", 16)
+    val N = BigInteger("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141", 16)
+    private val SEVEN = BigInteger.valueOf(7)
+    private val TWO = BigInteger.valueOf(2)
+    private val THREE = BigInteger.valueOf(3)
+
+    /** An affine point; both coordinates null is the point at infinity. */
+    class Point(val x: BigInteger?, val y: BigInteger?) {
+        val isInfinity: Boolean get() = x == null || y == null
+    }
+
+    val G = Point(
+        BigInteger("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798", 16),
+        BigInteger("483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8", 16)
+    )
+    private val INFINITY = Point(null, null)
+
+    fun randomScalar(random: SecureRandom): BigInteger {
+        while (true) {
+            val candidate = BigInteger(256, random)
+            if (candidate.signum() > 0 && candidate < N) return candidate
+        }
+    }
+
+    fun multiply(point: Point, scalar: BigInteger): Point {
+        var k = scalar.mod(N)
+        var result = INFINITY
+        var addend = point
+        while (k.signum() > 0) {
+            if (k.testBit(0)) result = add(result, addend)
+            addend = add(addend, addend)
+            k = k.shiftRight(1)
+        }
+        return result
+    }
+
+    private fun add(a: Point, b: Point): Point {
+        if (a.isInfinity) return b
+        if (b.isInfinity) return a
+        val ax = a.x!!
+        val ay = a.y!!
+        val bx = b.x!!
+        val by = b.y!!
+        val slope = if (ax == bx) {
+            if (ay.add(by).mod(P).signum() == 0) return INFINITY
+            THREE.multiply(ax).multiply(ax).multiply(TWO.multiply(ay).modInverse(P)).mod(P)
+        } else {
+            by.subtract(ay).multiply(bx.subtract(ax).modInverse(P)).mod(P)
+        }
+        val x = slope.multiply(slope).subtract(ax).subtract(bx).mod(P)
+        val y = slope.multiply(ax.subtract(x)).subtract(ay).mod(P)
+        return Point(x, y)
+    }
+
+    /** Parses an uncompressed point (04 || x || y) and rejects anything that is not on the curve. */
+    fun decode(bytes: ByteArray): Point {
+        if (bytes.size != 65 || bytes[0] != 0x04.toByte()) throw IOException("Unsupported public key form")
+        val x = BigInteger(1, bytes.copyOfRange(1, 33))
+        val y = BigInteger(1, bytes.copyOfRange(33, 65))
+        if (x >= P || y >= P) throw IOException("Public key is out of range")
+        val left = y.multiply(y).mod(P)
+        val right = x.multiply(x).multiply(x).add(SEVEN).mod(P)
+        if (left != right) throw IOException("Public key is not on the curve")
+        return Point(x, y)
+    }
+
+    fun encode(point: Point): ByteArray {
+        val x = point.x ?: throw IOException("Cannot encode the point at infinity")
+        val y = point.y ?: throw IOException("Cannot encode the point at infinity")
+        return byteArrayOf(0x04) + to32Bytes(x) + to32Bytes(y)
+    }
+
+    fun to32Bytes(value: BigInteger): ByteArray {
+        val raw = value.toByteArray()
+        val out = ByteArray(32)
+        val length = minOf(raw.size, 32)
+        System.arraycopy(raw, raw.size - length, out, 32 - length, length)
+        return out
+    }
+}
