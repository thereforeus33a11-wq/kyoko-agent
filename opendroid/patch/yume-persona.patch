+        // A retry: the same, and the plan it resumes is not touched.
+        val retry = body("private fun launchRetry(", "private fun cutOffTaskInFlight(")
+        assertTrue(retry.contains("cutOff = cutOffTaskInFlight(why = \"a retry was started\", waitingForAnswer = waitingSession != null)"))
+        assertFalse(retry.contains("currentJob?.cancel()"))
+        assertTrue(retry.indexOf("cutOff?.join()") in 0 until retry.indexOf("resolveStaleProposedPlan(sessionId)"))
