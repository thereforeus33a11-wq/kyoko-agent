+            CANNOT + """ """ + REFUSED_ACT + """|""" +
+            """as an ai\b[^.!?\n]{0,40}?,? i (?:can['’]t|cannot|can not|won['’]t|will not|do not|don['’]t|am (?:unable|not able))\b)""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** True when [reply] is a model declining to look, not a description of a picture. */
+    fun isStockRefusal(reply: String): Boolean = STOCK_REFUSAL.containsMatchIn(reply.trim())
+}
