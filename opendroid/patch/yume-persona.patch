+@Singleton
+class PersonaPictures internal constructor(
+    private val context: Context,
+    private val bundle: Bundle
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(context, AssetBundle(context))
+
+    /** Where the pictures that come with the app are read from: the app's assets, or a stand-in in a test. */
+    interface Bundle {
+        /** The text of [HerRefs.MANIFEST], or null when the build carries none. */
+        fun manifest(): String?
+
+        /** The bytes of [file] in [HerRefs.DIRECTORY], or null when it is not there. */
+        fun open(file: String): ByteArray?
+    }
+
+    /** The app's own assets. */
+    private class AssetBundle(private val context: Context) : Bundle {
+        override fun manifest(): String? = read(HerRefs.MANIFEST)?.toString(Charsets.UTF_8)
+        override fun open(file: String): ByteArray? = read(HerRefs.DIRECTORY + "/" + file)
+
+        private fun read(path: String): ByteArray? = try {
+            context.assets.open(path).use { it.readBytes() }
+        } catch (e: java.io.IOException) {
+            null
+        }
+    }
+
+    /** What came of adding a picture. */
+    sealed class Added {
+        data class Stored(val picture: PersonaPicture) : Added()
+
+        /** She already has as many pictures of herself as the store holds. */
+        data object Full : Added()
+
+        /** The picture could not be opened or is not an image. */
+        data object Unreadable : Added()
+    }
+
+    @Volatile private var bundleRead = false
+
+    private val directory: File
+        get() = File(File(context.filesDir, PERSONA_DIRECTORY), PICTURES_DIRECTORY)
+
+    private val indexFile: File
+        get() = File(directory, INDEX_FILE)
+
+    private val lock = Mutex()
+
+    @Volatile private var loaded: PersonaPictureRules.Index? = null
+
+    private val current = MutableStateFlow<List<PersonaPicture>>(emptyList())
+
+    /** The pictures as last read or changed, for a screen to follow. Empty until [list] has run once. */
+    val pictures: StateFlow<List<PersonaPicture>> = current.asStateFlow()
+
+    private val unlistedCount = MutableStateFlow(0)
+
+    /**
+     * How many picture files lie in the folder that the list does not name: what is left
+     * when the index, or an entry of it, could not be read. They are never shown to her
+     * and never sent anywhere. Zero until [list] has run once.
+     */
+    val unlisted: StateFlow<Int> = unlistedCount.asStateFlow()
+
+    /** Every picture whose file is there, in the order they were added. */
+    suspend fun list(): List<PersonaPicture> = withContext(Dispatchers.IO) {
+        lock.withLock { index().pictures }
+    }
+
+    /**
+     * Copies the image behind [uri] into the store as a picture of [kind]. A picture of her is
+     * an original and is kept as he gave it, byte for byte ([addAsGiven]). A background
+     * picture is scaled down and stored as JPEG, and takes the place of the one that was there.
+     */
+    suspend fun add(uri: Uri, kind: PersonaPicture.Kind): Added = withContext(Dispatchers.IO) {
+        lock.withLock {
+            if (kind == PersonaPicture.Kind.SELF) return@withLock addAsGiven(uri)
+            val id = UUID.randomUUID().toString()
+            val picture = PersonaPicture(id = id, file = "$id.jpg", kind = kind, addedAt = System.currentTimeMillis())
+            // Asked before the image is opened: a full store does not decode anything.
+            val after = PersonaPictureRules.withAdded(index(), picture) ?: return@withLock Added.Full
+            val bitmap = decodeScaled(uri) ?: return@withLock Added.Unreadable
+            val file = File(directory, picture.file)
+            try {
+                directory.mkdirs()
+                file.outputStream().use { out ->
+                    if (!bitmap.compress(Bitmap.CompressFormat.JPEG, PersonaPictureRules.JPEG_QUALITY, out)) {
+                        throw IllegalStateException("not compressed")
+                    }
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "A picture could not be stored: ${e.javaClass.simpleName}")
+                file.delete()
+                return@withLock Added.Unreadable
+            } finally {
+                bitmap.recycle()
+            }
+            save(after)
+            Added.Stored(picture)
+        }
+    }
+
+    /**
+     * A picture of her he adds, kept as he gave it: the bytes behind [uri] written to the
+     * store unchanged, with their SHA-256, as an original. Only bytes that are a picture by
+     * their first bytes and that the phone can read the size of are kept.
+     */
+    private fun addAsGiven(uri: Uri): Added {
+        val id = UUID.randomUUID().toString()
+        // Asked before the image is read: a full store reads nothing.
+        if (!PersonaPictureRules.hasRoomFor(index(), PersonaPicture.Kind.SELF)) return Added.Full
+        val bytes = try {
+            readSource(uri)
+        } catch (e: Exception) {
+            Log.w(TAG, "A picture could not be read: ${e.javaClass.simpleName}")
+            null
+        } catch (e: OutOfMemoryError) {
+            Log.w(TAG, "A picture was too large to read")
+            null
+        } ?: return Added.Unreadable
+        val ending = endingOf(bytes) ?: return Added.Unreadable
+        val picture = PersonaPicture(
+            id = id,
+            file = "$id.$ending",
+            kind = PersonaPicture.Kind.SELF,
+            addedAt = System.currentTimeMillis(),
+            origin = PersonaPicture.Origin.ADDED,
+            provenance = PersonaPicture.Provenance.ORIGINAL,
+            asGiven = true,
+            sha256 = sha256(bytes)
+        )
+        val after = PersonaPictureRules.withAdded(index(), picture) ?: return Added.Full
+        if (!writeAsGiven(picture.file, bytes)) return Added.Unreadable
+        save(after)
+        return Added.Stored(picture)
+    }
+
+    /**
+     * Stores [bytes], a reference sheet made on his tap ([ReferenceSheets]), as it came: the
+     * same bytes, so that once he approves it as a master it is kept whole. It is derived until
+     * then. [caption] says which look and side it is, [view] the side, [look] the look. [Added.Full] where no
+     * reference picture fits any more: nothing is pushed out for it.
+     */
+    suspend fun addSheet(bytes: ByteArray, caption: String, view: String, look: ReferenceSheets.Look): Added = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val ending = endingOf(bytes)?.takeIf { it == "png" || it == "jpg" || it == "webp" } ?: return@withLock Added.Unreadable
+            val id = UUID.randomUUID().toString()
+            val picture = PersonaPicture(
+                id = id,
+                file = "$id.$ending",
+                kind = PersonaPicture.Kind.SELF,
+                caption = PersonaPictureRules.fitCaption(caption),
+                captionBy = PersonaPicture.CaptionBy.APP,
+                addedAt = System.currentTimeMillis(),
+                origin = PersonaPicture.Origin.SHEET,
+                provenance = PersonaPicture.Provenance.DERIVED,
+                asGiven = true,
+                view = view,
+                sha256 = sha256(bytes),
+                sheetLook = look.name
+            )
+            val after = PersonaPictureRules.withSheet(index(), picture) ?: return@withLock Added.Full
+            if (!writeAsGiven(picture.file, bytes)) return@withLock Added.Unreadable
+            save(after)
+            Added.Stored(picture)
+        }
+    }
+
+    /**
+     * Sets picture [id] to [to] where he may make that change ([PictureSources.changed]):
+     * his approval of a reference sheet as a master, or taking it back; a picture he added
+     * marked as made by a model, or as an original again; a bundled one taken out of the bases
+     * or approved. The file is not touched. False where the change is not one he can make.
+     */
+    suspend fun setProvenance(id: String, to: PersonaPicture.Provenance): Boolean = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val after = PersonaPictureRules.withProvenance(index(), id, to) ?: return@withLock false
+            save(after)
+            true
+        }
+    }
+
+    /**
+     * Stores [bytes], a picture of herself that she made, with [caption] in her words.
+     * When she already has [PersonaPictureRules.MAX_MADE] of her own, her oldest one goes,
+     * file and all. None of the pictures he added is touched.
+     */
+    suspend fun addMade(bytes: ByteArray, caption: String): Added = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val id = UUID.randomUUID().toString()
+            val picture = PersonaPicture(
+                id = id,
+                file = "$id.jpg",
+                kind = PersonaPicture.Kind.SELF,
+                caption = PersonaPictureRules.fitCaption(caption),
+                captionBy = PersonaPicture.CaptionBy.HER,
+                addedAt = System.currentTimeMillis(),
+                made = true
+            )
+            val bitmap = decodeBytes(bytes) ?: return@withLock Added.Unreadable
+            val file = File(directory, picture.file)
+            try {
+                directory.mkdirs()
+                file.outputStream().use { out ->
+                    if (!bitmap.compress(Bitmap.CompressFormat.JPEG, PersonaPictureRules.JPEG_QUALITY, out)) {
+                        throw IllegalStateException("not compressed")
+                    }
+                }
+            } catch (e: Exception) {
+                Log.w(TAG, "A picture she made could not be stored: ${e.javaClass.simpleName}")
+                file.delete()
+                return@withLock Added.Unreadable
+            } finally {
+                bitmap.recycle()
+            }
+            val (after, out) = PersonaPictureRules.withMade(index(), picture)
+            save(after)
+            out.forEach { old -> fileOf(old.id)?.delete() }
+            Added.Stored(picture)
+        }
+    }
+
+    /** How many more reference pictures fit ([PersonaPictureRules.referenceRoom]). */
+    suspend fun referenceRoom(): Int = withContext(Dispatchers.IO) {
+        lock.withLock { PersonaPictureRules.referenceRoom(index()) }
+    }
+
+    /** Removes picture [id] and deletes its file. */
+    suspend fun remove(id: String) = withContext(Dispatchers.IO) {
+        lock.withLock { save(PersonaPictureRules.withRemoved(index(), id)) }
+    }
+
+    /**
+     * Sets the caption of picture [id]. [by] records whether the owner typed it or she
+     * said it. A text that is the caption already changes nothing, so saving her words
+     * again does not make them his.
+     */
+    suspend fun setCaption(id: String, text: String, by: PersonaPicture.CaptionBy) = withContext(Dispatchers.IO) {
+        lock.withLock {
+            val before = index()
+            val after = PersonaPictureRules.withCaption(before, id, text, by)
+            if (after != before) save(after)
+        }
+    }
+
+    /**
+     * Deletes the picture files the list does not name ([unlisted]). Only the owner asks
+     * for this: the store itself never deletes a file it has no entry for.
+     */
+    suspend fun removeUnlisted() = withContext(Dispatchers.IO) {
+        lock.withLock {
+            unlistedFiles(index()).forEach { it.delete() }
+            unlistedCount.value = unlistedFiles(index()).size
+        }
+    }
+
+    /**
+     * Picture [id] as base64, the form a request carries an image in, for a model to see:
+     * the stored JPEG where the store keeps one; for a picture kept as given, a JPEG no larger
+     * than [PersonaPictureRules.MAX_SIDE] made from it in memory, upright, the file untouched.
+     * Null when it is gone. Never what an image model works from: that is [source].
+     */
+    suspend fun base64(id: String): String? = withContext(Dispatchers.IO) {
+        val (picture, file) = lock.withLock { entryOf(id) } ?: return@withContext null
+        try {
+            val bytes = file.readBytes()
+            val sent = if (picture.asGiven) jpegCopy(bytes, PersonaPictureRules.MAX_SIDE, PersonaPictureRules.JPEG_QUALITY) else bytes
+            sent?.let { Base64.encodeToString(it, Base64.NO_WRAP) }
+        } catch (e: Exception) {
+            Log.w(TAG, "A picture could not be read: ${e.javaClass.simpleName}")
+            null
+        } catch (e: OutOfMemoryError) {
+            Log.w(TAG, "A picture was too large to read")
+            null
+        }
+    }
+
+    /**
+     * Picture [id] as an image model is given it to work from ([SourceImage]): only where the
