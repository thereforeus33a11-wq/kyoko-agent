+    /** What she is told about a wish of hers that was moved, or null when none was. */
+    internal fun movedLine(moved: Moved?, asked: String, bounds: Bounds): String? {
+        val wrote = if (asked.isBlank()) "" else " (you wrote: ${asked.replace("===", "= = =")})"
+        return when (moved) {
+            null -> null
+            Moved.TOO_SOON ->
+                "the time you asked for last$wrote was sooner than his setting allows, so it was moved: two " +
+                    "moments are at least ${span(bounds.minGapMillis)} apart."
+            Moved.TOO_FAR ->
+                "the time you asked for last$wrote was further off than a wish can reach, so it was moved to " +
+                    "${span(MAX_WISH_MILLIS)} from then."
+            Moved.DAY_USED_UP ->
+                "the day's moments were used up at the time you asked for last$wrote, so this one was moved to " +
+                    "when the oldest of them fell out of the 24 hours."
+            Moved.NOT_READ ->
+                "the app could not read the time you asked for last$wrote, so the usual gap applied. it reads a " +
+                    "span (20m, 3h, 1h30m, 2d), a time on his clock (02:30), or: when he writes."
+            Moved.CALLS_USED_UP ->
+                "his number of calls on your own was used up at the time you asked for$wrote, so this moment " +
+                    "waited until one fell out of the 24 hours."
+        }
+    }
+
+    private fun did(did: Did?, hadCommand: Boolean): String {
+        val what = when (did) {
+            Did.SAID -> "you said something to him"
+            Did.PASSED -> "you let it pass"
+            else -> "you kept it to yourself"
+        }
+        // The app's lines reach back to her last moment when she wrote a command in it ([appLineMaxAgeMillis]).
+        return if (hadCommand) {
+            "$what, and wrote a command for the phone. what the app wrote about it since is among its lines " +
+                "further up, unless newer lines of the app have pushed it out"
+        } else {
+            what
+        }
+    }
