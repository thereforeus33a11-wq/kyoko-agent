+import java.util.TimeZone
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * What her prompts are told of what her ears overheard (P3-1), and his voice heard again
+ * bringing her next moment sooner (P3-2): once, in her next reply or moment, and never where
+ * his details are held back.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaEngineEarsTest {
+
+    private val custom = PersonaEngineTestSetup.CUSTOM
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private val utc: TimeZone = TimeZone.getTimeZone("UTC")
+    private var now = 1_800_000_000_000L
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val endpoint = server.url("/v1").toString()
+    private val directory get() = File(context.filesDir, "persona")
+    private val lifeDirectory get() = File(context.filesDir, "ears-test")
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var settings: SettingsRepository
+    private lateinit var memory: PersonaMemory
+    private lateinit var engine: PersonaEngine
+    private val overheard = Overheard { now }
+    private val profile = PersonaEngineTestSetup.ProfileNamed("Ren")
+    private val alarms = CopyOnWriteArrayList<Long?>()
+
+    @Before
+    fun setUp() {
+        directory.deleteRecursively()
+        lifeDirectory.deleteRecursively()
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java).allowMainThreadQueries().build()
+        settings = PersonaEngineTestSetup.settings()
+        val store = PersonaStore(context)
+        store.saveCard("You are Yume. {{owner}} built you.")
+        memory = PersonaMemory(
+            MemoryRepository(memoryDao = database.memoryDao(), taskHistoryDao = database.taskHistoryDao(), macroDao = database.macroDao())
+        )
+        val ledger = OwnLedger({ File(lifeDirectory, "own_ledger.json") }, { now })
+        val log = HerLog({ File(lifeDirectory, "her_log.json") }, { now })
+        val wonders = Wonders({ lifeDirectory }, TestThoughtsCipher())
+        val life = OwnLife(ledger, log, HerNow(), wonders, null as Looks?, overheard)
+        engine = PersonaEngine(
+            store = store,
+            memory = memory,
+            library = PersonaLibrary(context),
+            settingsRepository = settings,
+            llmProviderFactory = PersonaEngineTestSetup.factory(settings),
+            userProfileStore = profile,
+            pictures = PersonaPictures(context),
+            memoryManager = PersonaEngineTestSetup.memoryManager(context, database, profile),
+            thoughts = testThoughts(directory),
+            ownTimeAlarm = OwnTimeAlarm { alarms += it },
+            ownLife = life
+        )
+        engine.clock = { now }
+        configure { it.copy(personaOwnLife = true, personaOpenMic = true) }
+    }
+
+    @After
+    fun tearDown() {
+        server.close()
+        database.close()
+        directory.deleteRecursively()
+        lifeDirectory.deleteRecursively()
+    }
+
+    private fun configure(change: (LLMConfig) -> LLMConfig): LLMConfig = runBlocking {
+        settings.updateConfig { config ->
+            change(
+                config.copy(
+                    routePolicy = RoutePolicy.ANY,
+                    activeProvider = custom,
+                    selectedModels = mapOf(custom to "her-model"),
+                    customEndpoints = mapOf(custom to endpoint),
+                    personaLibraryChars = 0,
+                    personaCheckInsEnabled = true
+                )
+            )
+        }
+        settings.llmConfig.first()
+    }
+
+    /** A plain hosted model whose provider can read what it is sent, with private mode on: his details are held back. */
+    private fun hosted(config: LLMConfig) = config.copy(customEndpoints = mapOf(custom to "https://api.example.com/v1"), privateMode = true)
+
+    private fun replyPrompt(config: LLMConfig): String = runBlocking { engine.chatSystemPrompt(config, "", emptyList(), screenshotAttached = false) }
+
+    private fun overhear(words: String) = overheard.add(Overheard.Line(now - minute, words, listOf("quietly"), his = true))
+
+    @Test
+    fun `her next reply is told what she overheard, once`() {
+        val config = runBlocking { settings.llmConfig.first() }
+        overhear("where did I leave the charger")
+        val first = replyPrompt(config)
+        assertTrue(first.contains("- What you overheard near the phone since you were last told, not said to you, through the phone's microphone"))
+        // With what is true of him now, not among the plain facts of the app.
+        assertTrue(first.indexOf("What you overheard") > first.indexOf("=== ABOUT HIM AND THE PHONE RIGHT NOW ==="))
+        assertTrue(first.indexOf("What you overheard") < first.indexOf("=== YOUR OWN NOTES"))
+        assertTrue(first.contains("he said \"where did I leave the charger\" (quietly)"))
+        now += Overheard.REBUILD_MILLIS + 1
+        assertFalse(replyPrompt(config).contains("where did I leave the charger"))
+    }
+
+    @Test
+    fun `where his details are held back nothing overheard is said, and it is not used up`() {
+        val held = configure { hosted(it).copy(personaOwnLife = true, personaOpenMic = true) }
