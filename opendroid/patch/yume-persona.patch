+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OwnLife
+import com.opendroid.ai.core.life.eyes.CameraLook
+import com.opendroid.ai.core.persona.PersonaOwnTime.Bounds
+import com.opendroid.ai.core.persona.PersonaOwnTime.State
+import com.opendroid.ai.core.persona.PersonaOwnTime.Wake
+import com.opendroid.ai.core.persona.PersonaOwnTime.Why
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her camera looks in her moments (OWN_LIFE_PLAN phase 2, P2-1): the look offered only while
+ * one can be had, in words that say what the code does; what she is told when one did not
+ * start, and after one; a look keeping her next moment's time; and the kept-line check in the
+ * moment after she met a kid (§1.4), with PK-2 told at the next one.
+ */
+class PersonaCameraLookTest {
+
+    private val minute = 60_000L
+    private val now = 1_800_000_000_000L
+    private val bounds = Bounds(minGapMillis = 15 * minute, maxPerDay = 24)
+    private val reads = setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS)
+
+    private fun offer(frontToo: Boolean = false, left: Int = 6, tells: Boolean = true, screenOff: Boolean = false, foldable: Boolean = true) =
+        CameraLook.Offer(frontToo = frontToo, left = left, tellsHim = tells, screenOff = screenOff, foldable = foldable)
+
+    private fun life(runnable: Set<OutingKind.Kind>, camera: CameraLook.Offer?, lastOuting: PersonaOwnTime.LastOuting? = null, kidNotKept: Int = 0) =
+        PersonaOwnTime.Life(
+            nowMillis = now, runnable = runnable, maxMinutes = 15, maxSteps = 12, cap = 150, left = 120,
+            lastOuting = lastOuting, camera = camera, kidNotKept = kidNotKept
+        )
+
+    @Test
+    fun `P2-1 - the look is offered only while it can be had, and says what the code does`() {
+        val backOnly = PersonaOwnTime.goLine(life(reads + OutingKind.Kind.LOOK, offer()))!!
+        assertTrue(backOnly, backOnly.contains("go: look back"))
+        assertFalse(backOnly.contains("[back | front | around]"))
+        assertTrue(backOnly.contains("one look through the phone's back camera, which faces away from him; his settings keep the front one off."))
+        assertTrue(backOnly.contains("only while his screen is on and unlocked: android shows its camera light, and the app tells him each time."))
+        assertTrue(backOnly.contains("a describer that is not you looks at the picture, and you get its words in a moment of looking right after; the picture is not kept."))
+        // Back only, folded: the look is refused, and she is told so before she asks.
+        assertTrue(backOnly.contains("folded, no camera faces away from him, so it does not start."))
+        assertTrue(backOnly.contains("his message, a call or his screen going off calls it off."))
+        assertTrue(backOnly.contains("6 looks left today."))
+        // The outing's own sentences are said of the outings to read, not of the look.
+        assertTrue(backOnly, backOnly.contains("  an outing to read or for the news starts right after this moment and runs by itself, step by step. it ends when you are done"))
+        assertFalse(backOnly.contains("  it starts right after this moment"))
+
+        val both = PersonaOwnTime.goLine(life(reads + OutingKind.Kind.LOOK, offer(frontToo = true, left = 1, tells = false, screenOff = true)))!!
+        assertTrue(both.contains("go: look [back | front | around]"))
+        assertTrue(both.contains("back faces away from him, front faces him, around is one of each."))
+        assertTrue(both.contains("folded, only the outer camera works, and it faces him."))
+        // A phone with no hinge is told nothing about folding.
+        assertFalse(PersonaOwnTime.goLine(life(reads + OutingKind.Kind.LOOK, offer(foldable = false)))!!.contains("folded"))
+        assertFalse(both.contains("the app tells him each time"))
+        assertTrue(both.contains("1 look left today. his screen is off now, so a look now would not start."))
+
+        // Not runnable: no look line, whatever the offer says, and the reading outing reads as before.
+        val readOnly = PersonaOwnTime.goLine(life(reads, offer()))!!
+        assertFalse(readOnly.contains("go: look"))
+        assertTrue(readOnly.contains("it ends when you are done"))
+
+        // A look alone: nothing about minutes and steps of an outing.
+        val lookOnly = PersonaOwnTime.goLine(life(setOf(OutingKind.Kind.LOOK), offer()))!!
+        assertTrue(lookOnly.contains("go: look back"))
+        assertFalse(lookOnly.contains("steps run out"))
+        assertTrue(lookOnly.endsWith("a go: line the app cannot read stays a thought, and you are told at your next moment."))
+        assertEquals("read <words or a link>, news [japan | world | <a topic>], look [back | front | around]", PersonaOwnTime.goReads(reads + OutingKind.Kind.LOOK))
+        assertEquals("read <words or a link>, news [japan | world | <a topic>], look back", PersonaOwnTime.goReads(reads + OutingKind.Kind.LOOK, frontToo = false))
+        // A go: line not read, with back only: she is told the look she has.
+        val notRead = PersonaOwnTime.lifeLines(
+            life(reads + OutingKind.Kind.LOOK, offer()).copy(goMissed = PersonaOwnTime.GoMissed("look sideways", HerLog.NotStarted.NOT_READ.name)),
+            thoughtsLeftOut = false
+        ).last()
+        assertTrue(notRead, notRead.endsWith("look back."))
+
+    }
+
+    @Test
+    fun `her own life offers a look only where his switch is on and a look can be had`() {
+        val config = LLMConfig(personaOwnLife = true, personaCameraLooks = true)
+        assertEquals(reads + OutingKind.Kind.LOOK, OwnLife.runnable(config, looking = true))
+        assertEquals(reads, OwnLife.runnable(config, looking = false))
+        assertEquals(reads, OwnLife.runnable(config.copy(personaCameraLooks = false), looking = true))
+        assertEquals(setOf(OutingKind.Kind.LOOK), OwnLife.runnable(config.copy(personaReads = false), looking = true))
+        assertEquals(emptySet<OutingKind.Kind>(), OwnLife.runnable(config.copy(personaOwnLife = false), looking = true))
+    }
+
+    @Test
+    fun `a look that did not start is told by why, in the app's words`() {
+        fun missed(why: HerLog.NotStarted) = PersonaOwnTime.goMissedLine(PersonaOwnTime.GoMissed("look back", why.name), reads)
+        assertTrue(missed(HerLog.NotStarted.SCREEN_OFF).contains("his screen was off or locked: a look happens only while his screen is on"))
+        assertTrue(missed(HerLog.NotStarted.CALL).contains("a phone call was going on."))
+        assertTrue(missed(HerLog.NotStarted.TALKING).contains("he was talking to you just then."))
+        assertTrue(missed(HerLog.NotStarted.LOOKS_USED_UP).contains("no more looks through the camera today."))
+        assertTrue(missed(HerLog.NotStarted.CAMERA_BUSY).contains("another app was using the camera."))
+        assertTrue(missed(HerLog.NotStarted.FRONT_OFF).contains("the back camera only."))
+        assertTrue(missed(HerLog.NotStarted.FOLDED).contains("the phone was folded"))
+        assertTrue(missed(HerLog.NotStarted.FOLD_UNKNOWN).contains("could not tell how the phone was folded"))
+        // A look's own bounds: 10 calls left, the battery at 20%; an outing's stay as they were.
+        assertTrue(missed(HerLog.NotStarted.BUDGET).endsWith("fewer than 10 of his calls on your own were left."))
+        assertTrue(missed(HerLog.NotStarted.POWER).endsWith("the phone's battery was under 20% or it was too hot."))
+        assertTrue(
+            PersonaOwnTime.goMissedLine(PersonaOwnTime.GoMissed("read about gyaru", HerLog.NotStarted.BUDGET.name), reads)
+                .endsWith("fewer than 20 of his calls on your own were left.")
+        )
+        for (why in HerLog.NotStarted.entries) assertTrue(why.name, missed(why).startsWith("your last go: line"))
+    }
+
+    private val look = PersonaOwnTime.LastOuting(
+        kind = "look", words = "look back", startedAt = now - 20 * minute, endedAt = now - 19 * minute,
+        minutes = 1, steps = 1, opened = 0, searches = 0, titles = emptyList(), ended = HerLog.EndedBy.DONE.name,
+        said = false, looked = 1, camera = "back camera"
+    )
+
+    @Test
+    fun `after a look she is told what came of it, never what the describer wrote`() {
+        val had = PersonaOwnTime.lastOutingLine(look, now, thoughtsLeftOut = false)
+        assertEquals(
+            "your last look: \"look back\", 19 min ago, through the back camera: 1 picture described, and you had a moment of looking. " +
+                "what you thought then is among your thoughts above. what you saw is gone, except what you noted.",
+            had
+        )
+        val off = PersonaOwnTime.lastOutingLine(look.copy(steps = 0, looked = 0, ended = HerLog.EndedBy.HIS_MESSAGE.name), now, false)
+        assertTrue(off, off.endsWith("it was called off: he wrote to you."))
+        val dark = PersonaOwnTime.lastOutingLine(look.copy(steps = 0, looked = 0, unseen = CameraLook.unseen(CameraLook.Looked(
+            listOf(CameraLook.Frame(com.opendroid.ai.core.life.eyes.FoldState.Pick.Use(
+                com.opendroid.ai.core.life.eyes.FoldState.Side.BACK, com.opendroid.ai.core.life.eyes.FoldState.Lens.BACK, "back camera"
+            ), now, true, CameraLook.Result.Dark(near = false))), stopped = false
+        ))), now, false)
+        assertTrue(dark, dark.endsWith("too dark: the phone is probably face down or in a pocket; no eyes call was spent."))
+        // A line of hers about a kid that was not kept in her moment of looking is told here (PK-2).
+        assertTrue(PersonaOwnTime.lastOutingLine(look.copy(untoldDrops = 1), now, false).endsWith(KidGuard.NOT_KEPT))
+        assertTrue(PersonaOwnTime.lifeLines(life(reads, null, kidNotKept = 2), thoughtsLeftOut = false).contains(KidGuard.NOT_KEPT))
+        // What a reply of hers is told of it.
+        val entry = HerLog.Entry("l", now - 19 * minute, now - 19 * minute, HerLog.Kind.LOOK, where = "back camera", endedBy = HerLog.EndedBy.DONE)
+        val reply = PersonaOwnTime.lifeReplyLines(com.opendroid.ai.core.life.OwnLifeLink.ForReply(listOf(entry), null), now)
+        assertEquals(listOf("Since you last talked to him, on your own (from the app's log, what really happened): looked through the back camera, 19 min ago."), reply)
+    }
+
+    @Test
+    fun `a look keeps her next moment's time, and what it came to is stored with no description`() {
+        val state = State(on = true, wake = Wake.At(now + 2 * 60 * minute), why = Why.ASKED, lastAtMillis = now - 30 * minute)
+        val back = PersonaOwnTime.cameBack(state, look, now, bounds)
+        assertEquals(state.wake, back.wake)
+        assertEquals(Why.ASKED, back.why)
+        assertEquals(look, back.lastOuting)
+        // An outing to read is brought forward as before.
+        val read = look.copy(kind = "read", camera = "")
+        assertEquals(Why.CAME_BACK, PersonaOwnTime.cameBack(state, read, now, bounds).why)
+        // Stored and read back with its camera, why nothing was shown, and the kid marks.
+        val kept = back.copy(lastOuting = look.copy(unseen = "no picture was taken: the camera failed", untoldDrops = 1, metKid = true), kidNotKept = 2)
+        assertEquals(kept, PersonaOwnTime.decode(PersonaOwnTime.encode(kept)))
+    }
+
+    @Test
+    fun `the moment after meeting a kid drops her lines that read as sexual, and keeps her acts`() {
+        val reply = "<< she was so sexy\nnote: me | uniform | sexy school look\nsay: lol that kid\nfeel: weird | faint | hours\nnext: 2h\ngo: read about uniforms"
+        val checked = PersonaOwnTime.parse(reply, life = reads, kid = true)
+        assertEquals(2, checked.kidLinesDropped)
+        assertFalse(checked.thoughts.contains("sexy"))
+        assertTrue(checked.notes.isEmpty())
+        assertEquals("lol that kid", checked.said)
+        assertEquals(1, checked.feelings.size)
+        assertEquals("2h", checked.wishText)
+        assertTrue(checked.outing?.runs == true)
+        // Without a kid nothing is checked: this is not a filter on her.
+        val free = PersonaOwnTime.parse(reply, life = reads, kid = false)
+        assertEquals(0, free.kidLinesDropped)
+        assertTrue(free.thoughts.contains("sexy"))
+        assertEquals(1, free.notes.size)
+        assertNull(PersonaOwnTime.parse("<< ok", kid = false).outing)
+    }
+
+    @Test
+    fun `her replies know she has a look in her moments and none in a reply, and her moment of looking is told as one`() {
+        val back = PersonaOwnTime.lifeReplyLines(com.opendroid.ai.core.life.OwnLifeLink.ForReply(emptyList(), null, camera = offer()), now)
+        assertEquals(
+            listOf(
+                "In a moment of your own you can take one look through the phone's camera while his screen is on (go: look back). " +
