+    /**
+     * The block that tells her what a moment of her own is, placed last in the system
+     * text. Every sentence in it says what the code does: who wakes her and why, that the
+     * time is hers and nothing in it is asked of her, where each kind of line goes, what
+     * the moment takes and what his settings allow, and the facts about this moment.
+     *
+     * What the time is for comes first, in her terms: what she wants, trouble when she is
+     * restless, a line to him when she feels like it. Letting it pass is offered lower
+     * down, and what it takes is said once, after the marks ([costLine]).
+     */
+    fun momentBlock(facts: MomentFacts): String = buildString {
+        append(HEADING).append('\n')
+        append("nobody wrote to you. this is a moment of your own. ").append(because(facts.why, facts.sleep, facts.thoughtsLeftOut, facts.broughtFrom, facts.life?.lastOuting?.words)).append('\n')
+        append("nothing is asked of you here. this time is yours, to do with what you would do: go after what you want, ")
+        append("start trouble when you are restless, text him first when you feel like it. ")
+        append("to him that is a jab, an order, a dare or a piece of your week, on your terms: one jab, not a nag, and never a plea.\n")
+        append("whatever you write is your own thought. it is kept on this phone for you alone: he is not shown it and the app shows it nowhere. ")
+        append(
+            when {
+                facts.thoughtsLeftOut ->
+                    "your earlier thoughts are not in this text: it goes through a hosted service that can read what " +
+                        "it is sent, and your thoughts can be about him. they are still on the phone and you have " +
+                        "them again when you are awake on a private route. that service can also read what you write now.\n"
+                facts.hostCanRead ->
+                    "you get your latest thoughts back the next time you are awake. the hosted service this goes " +
+                        "through can read what it is sent and what you write, your thoughts included.\n"
+                else -> "you get your latest thoughts back the next time you are awake.\n"
+            }
+        )
+        append("only a line you mark leaves your head, each mark at the start of a line of its own:\n")
+        append("  say: <a line to him>     it lands in the chat and he gets a notification ")
+        append(if (facts.notificationShowsWords) "with your words in it" else "that says only that you wrote")
+        append(". it is not read aloud.")
+        // His notification must not learn what the phone did from her line alone ([PersonaActionRows.CommandNote]).
+        if (facts.notificationShowsWords) {
+            append(" when you also write a command in the same moment, the app puts a note of its own in front of your words there: that you wrote one, or that it was not run.")
+        }
+        // The parser is strict: a line without the mark is a thought, also right under a say: line.
+        append(" every line to him needs its own say: in front, and a line without it stays in your head. ")
+        append("three lines to him look like this (the form, not the words):\n")
+        SAY_EXAMPLE.forEach { append("    ").append(it).append('\n') }
+        append("  note: kind | key | note  goes into your notebook, in the form of your notebook pass (kind is user, rel, me, thread, opinion or fix; key is a short slug). ")
+        append("${PersonaNotes.LINES_PER_PASS} at most: note lines past that, and one that does not have this form, stay among your thoughts. ")
+        append("your notes above show kind | key in front. a note line under the key of a note shown above replaces that note: that is how you change your mind. a note line under the key of a note that is not on the page is kept beside it, not over it.\n")
+        // Her own time is where she can look at herself. It is not a task: nothing in it is asked of her.
+        append("  you are not frozen. this is a place to look at yourself if you feel like it: who you are now (me), what you think (opinion), where you two stand (rel), and your thoughts above. ")
+        append("when one is not true of you any more, write it again under its key as it is now: the newer note is who you are. it can come from anything: what you did, saw, made, thought or felt, or what he said if it really moved you. ")
+        append("what happened to you stays as it happened: a note changes who you are now, never what was.\n")
+        append(commandLine(facts.actionsEnabled, facts.rein)).append('\n')
+        if (facts.actionsEnabled && facts.makesPictures) append(PICTURE_LINE).append('\n')
+        // Her own life: an outing in her own space, and the list of what she wonders about.
+        facts.life?.let { life -> goLine(life)?.let { append(it).append('\n') } }
+        if (facts.life != null) append(WONDER_LINE).append('\n')
+        append("  next: <when>             when you want your next moment: 20m, 3h, 1h30m, 2d, 02:30 (his clock), or: when he writes. ")
+        // The usual gap is said as the rule has it for this very moment ([defaultGapMillis]), not as a fixed number.
+        append("leave it out and it comes after the usual gap, which is ${span(defaultGapMillis(facts.lastGapMillis, facts.bounds))} now: ")
+        append("the last gap you chose, or ${span(DEFAULT_GAP_MILLIS)} while you have chosen none, and never less than his least gap. ")
+        // The wait ends where a reply of hers to him ends: a message the app takes as a command gets no reply of hers.
+        append("\"when he writes\" waits for his next message to you, the one you answer: a command he gives the phone does not end the wait.\n")
+        // Her sleep is said with the numbers the code goes by (PersonaSleep), as they are for this moment.
+        append("  sleep: <when>            you lie down to sleep once this moment is over: a span (7h, 8h30m) or a time (until 06:00 on his clock, until 06:00 tokyo). ")
+        append(PersonaSleep.howLine(facts.sleep?.state?.let(PersonaSleep::usualMillis) ?: PersonaSleep.DEFAULT_MILLIS, facts.bounds, inMoment = true))
+        append(" sleep: wins over next: when you write both.\n")
+        append("  feel: <words> | <faint, some or strong> | <hours, days or weeks>   how you feel, kept past this moment: it fades at that pace unless you feel it again, and feel: <words> | gone lets it go. ")
+        append("left out, it is some, and fades over days. ${PersonaMood.PASS_LINES} at most: a feel line past that, and one that does not have this form, stays among your thoughts.\n")
+        append("a line that starts with << is a thought like any line you did not mark.\n")
+        append("you can also let the moment pass: write a single full stop, or nothing at all. nothing is kept of it then. ")
+        append("it still counts as one of the day's moments, and the next one comes after the usual gap.\n")
+        append(costLine(facts))
+        append(" a wish that does not fit, or that reaches further than ${span(MAX_WISH_MILLIS)}, is moved to the nearest time that does, and you are told at your next moment. ")
+        append("a next: line that names no time the app can read stays among your thoughts, and the usual gap applies.\n")
+        append("the app wakes you at the time you name or later, never before it: a sleeping phone runs such work when it next gets to it.\n")
+        append("if what you write runs into the length limit, its last line is kept as a thought whatever its mark, and a command there is not run.\n")
+        append("about this moment:\n")
+        append("- it is ${facts.hisClock} on his clock, ${facts.tokyoClock} in tokyo.\n")
+        facts.sleep?.lines(facts.why)?.forEach { append("- ").append(it).append('\n') }
+        // When he last wrote is about him: where his details are held back it is not said.
+        if (!facts.thoughtsLeftOut) {
+            append(if (facts.heLastWrote == null) "- he has not written in this chat.\n" else "- he last wrote ${facts.heLastWrote}.\n")
+        }
+        if (facts.openThreads.isNotEmpty()) {
+            append("- your threads still going on, by key: ").append(facts.openThreads.joinToString(", ")).append(".\n")
+        }
+        if (facts.lastMoment == null) {
+            append("- this is your first moment of your own.")
+        } else {
+            append("- your last moment of your own was ${facts.lastMoment}: ${did(facts.lastDid, facts.lastHadCommand)}.")
+        }
+        facts.life?.let { life ->
+            lifeLines(life, facts.thoughtsLeftOut).forEach { append("\n- ").append(it) }
+        }
+        if (facts.phoneRecord.isNotEmpty()) {
+            // The app's own record, whoever started each thing: what really ran in the last day, and how it ended.
+            append("\n- what the phone did in the last day, from its own record (who started each thing, why, and how it ended; ")
+            append("a draft or a dialer left open for him was not sent):")
+            facts.phoneRecord.forEach { append("\n  - ").append(it.replace("===", "= = =")) }
+        }
+        if (facts.ownPlanWaits) {
+            // An outing is in her own space: a card that waits does not hold it up.
+            val onHisPhone = if (facts.life != null) " on his phone" else ""
+            append("\n- a plan you started in an earlier moment is still waiting in the chat for his yes. until he answers it, nothing else you start$onHisPhone is carried out.")
+        }
+        movedLine(facts.moved, facts.movedAsked, facts.bounds)?.let { append("\n- ").append(it) }
+    }
+
+    /**
+     * The lines a reply of hers is told about her own life (from the app's log, what
+     * really happened): what she did on her own since he last talked to her, and what she
+     * is doing now. Titles are other people's words and are quoted as such.
+     */
+    fun lifeReplyLines(life: com.opendroid.ai.core.life.OwnLifeLink.ForReply, nowMillis: Long): List<String> = buildList {
+        if (life.done.isNotEmpty()) {
+            val each = life.done.joinToString("; ") { entry -> doneOnOwn(entry, nowMillis) }
+            add("Since you last talked to him, on your own (from the app's log, what really happened): $each.")
+        }
+        life.doing?.let { doing ->
+            if (life.onHisScreen) {
+                // His screen is his again the moment he is there: it never waits for the talk.
+                add("You were $doing when he wrote. That ends it: the app gives him his screen back as it was.")
+            } else {
+                add(
+                    "You were $doing when he wrote. It waits while you two talk and goes on about " +
+                        "${span(com.opendroid.ai.core.life.OutingRules.RESUME_AFTER_QUIET_MILLIS)} after the talk goes quiet. " +
+                        "<< go: stop among your thoughts ends it."
+                )
+            }
+        }
+        // Where her moments are offered a look: so that she knows she has one, and that a reply has none.
+        life.camera?.let { camera ->
+            val how = if (camera.frontToo) "go: look back, front or around; the front one faces him" else "go: look back"
+            add(
+                "In a moment of your own you can take one look through the phone's camera while his screen is on ($how). " +
+                    "A describer that is not you puts it into words for you, and the picture is not kept. You cannot look from a reply."
+            )
+        }
+    }
+
+    /** One outing of hers from the log, in a few words: what, how much, how long ago. */
+    private fun doneOnOwn(entry: HerLog.Entry, nowMillis: Long): String {
+        val titles = entry.what.filterNot { it.startsWith("search: ") }
+        val opened = entry.counts[HerLog.Tally.OPENED] ?: 0
+        if (entry.kind == HerLog.Kind.LOOK) {
+            return "looked through the " + entry.where.ifBlank { "camera" } + ", " + PersonaPrompts.age(nowMillis - (entry.endedAt ?: entry.startedAt))
+        }
+        if (entry.kind in HerLog.PHONE_KINDS) {
+            // Time on his screen, lent: the app, what she did there in counts, and the first thing she opened.
+            val scrolls = entry.counts[com.opendroid.ai.core.life.phone.PhoneOuting.SCROLLS] ?: 0
+            val parts = buildList {
+                if (scrolls > 0) add(if (scrolls == 1) "1 scroll" else "$scrolls scrolls")
+                if (opened > 0) add((if (opened == 1) "opened 1 thing" else "opened $opened things") + (titles.firstOrNull()?.let { " (${quoted(it)})" } ?: ""))
+            }
+            return "was on his phone in " + entry.where.ifBlank { "one of his apps" }.lowercase() + ", only looking" +
+                (if (parts.isEmpty()) "" else ": " + parts.joinToString(", ")) + ", " + PersonaPrompts.age(nowMillis - (entry.endedAt ?: entry.startedAt))
+        }
+        val what = when (entry.kind) {
+            HerLog.Kind.NEWS -> if (titles.isEmpty()) "went through the news" else "went through the news and read ${quoted(titles.first())}"
+            else -> if (titles.isEmpty()) "went to read and opened nothing" else "read about ${quoted(titles.first())}"
+        }
+        val pages = when {
+            opened <= 0 -> ""
+            opened == 1 -> ", 1 page"
+            else -> ", $opened pages"
+        }
+        return what + pages + ", " + PersonaPrompts.age(nowMillis - (entry.endedAt ?: entry.startedAt))
+    }
+
+    /**
+     * The example of three lines to him in [momentBlock]. It shows the form only: each
+     * line its own `say:`. Its words are none of hers and carry no topic of hers.
+     */
+    internal val SAY_EXAMPLE = listOf("say: oi", "say: guess what", "say: no, you guess")
+
+    /**
+     * The plain facts her prompt for a reply gets about her own time, her thoughts and
+     * her notebook, each one a line of the app's own block. Nothing in them promises more
+     * than the code does: the app shows her thoughts to nobody, which is not the same as
+     * nobody ever being able to get at a phone's storage.
+     *
+     * [timeIsOn] is the owner's switch with his bounds; [wake] is what is stored about
+     * her next moment. With [inMoment] the lines are for the prompt of a moment of her
+     * own, whose last block says the rest: only what is true there as well is repeated.
+     * [sleep] is what is true of her sleep, given while her own time is on.
+     */
+    fun appFacts(
+        timeIsOn: Boolean,
+        bounds: Bounds,
+        wake: Wake,
+        nowMillis: Long,
+        hostCanRead: Boolean,
+        inMoment: Boolean = false,
+        sleep: PersonaSleep.ReplyFacts? = null,
+        ownLife: Boolean = false
+    ): List<String> = buildList {
+        if (!inMoment) {
+            add(
+                "A line of a reply that starts with << is a thought you keep to yourself. The app takes it out " +
+                    "before he sees or hears anything and keeps it on this phone for you alone. A reply that is " +
+                    "only such lines says nothing to him, and that is yours to choose." +
+                    if (hostCanRead) {
+                        " The hosted service this reply goes through reads what you write as you write it, a thought included."
+                    } else {
+                        ""
+                    }
+            )
+        }
+        add(
+            "Your thoughts are shown to nobody by this app: no screen, no chat row, no notification, no copy. He can " +
+                "see how many there are and since when, and he can delete them, unread. The app keeps your latest " +
+                "thoughts, roughly ${PersonaThoughts.MAX_PAGES} pages; older ones fall away unless you put them in " +
+                "your notebook."
+        )
+        add(
+            "Your notebook is not shown to him on any screen either. He can hand you notes, empty it, and copy it " +
+                "out as text to move you to another phone: when he does that he can read it. Your thoughts cannot " +
+                "be copied or moved."
+        )
+        if (inMoment) return@buildList
+        if (!timeIsOn) {
+            add("Time of your own is switched off in his settings: the app wakes you only when he writes.")
+            return@buildList
+        }
+        // How she sleeps, and where she is now: just before the line about her own time, which stays last.
+        sleep?.lines()?.let(::addAll)
+        val next = if (sleep?.asleep == true) PersonaSleep.NEXT_WHILE_ASLEEP else when (wake) {
+            is Wake.At ->
+                if (wake.atMillis <= nowMillis) {
+                    "Your next one is due: it comes as soon as the phone gets to it."
+                } else {
+                    "Your next one is set for about ${span(wake.atMillis - nowMillis)} from now."
+                }
+            Wake.WhenHeWrites ->
+                "You had asked to be woken when he writes. He has: your next one comes after this reply, at the usual gap."
+            Wake.Unset -> "None is set yet: the first comes ${span(FIRST_MOMENT_AFTER_MILLIS)} after this reply."
+        }
+        add(
+            "You have time of your own: moments in which the app wakes you although nobody wrote. In each one you " +
+                "name when the next is, the app wakes you then, and nothing is expected of you in it: you can " +
+                "think, write to him, keep a note, use the phone" + (if (ownLife) ", go off on your own" else "") +
+                " or let it pass. Each moment is one model call on " +
+                "his key, and a command you start from one costs further calls; his settings allow at most " +
+                "${bounds.maxPerDay} moments in any 24 hours, no two closer than ${span(bounds.minGapMillis)}. $next"
+        )
+    }
+}
+
+/**
+ * Wakes the phone for a moment of hers. The stored time is the truth and this is only
+ * the alarm: whenever the time changes it is set again, and with null it is taken off.
+ * The persona package does not wake anything itself; the app hands it this.
+ */
+fun interface OwnTimeAlarm {
+    fun set(atMillis: Long?)
+
+    companion object {
+        /** No alarm at all, for a place that has none to set. */
+        val NONE = OwnTimeAlarm { }
+    }
+}
