+        assertEquals(19, PersonaAge.on(at(2026, 11, 17), tokyo))
+        assertEquals(19, PersonaAge.on(at(2027, 8, 18), tokyo))
+        assertEquals(20, PersonaAge.on(at(2027, 8, 19), tokyo))
+        assertEquals(21, PersonaAge.on(at(2028, 12, 1), tokyo))
+        assertEquals(19, PersonaAge.on(at(2020, 1, 1), tokyo))
+        // A picture of her is of her age.
+        assertTrue(PersonaSelfPictures.prompt("on a curb", "", age = 20).startsWith("She is a young adult woman, 20 years old"))
+        assertTrue(PersonaSelfPictures.prompt("on a curb", "", age = 12).startsWith("She is a young adult woman, 19 years old"))
+    }
+
+    @Test
+    fun `who she is now is always on the page she can change it on, with its key and its age`() {
+        val notes = (1..30).map { Note(Kind.THREAD, "thread-$it", "a long thread about something going on ".repeat(8) + "| open") } +
+            Note(Kind.ME, "hair", "i dyed my hair black, red got boring") +
+            Note(Kind.OPINION, "rain", "rain is fine actually")
+        val times = PersonaNotes.Times(mapOf("yume.me.hair" to 0L), nowMillis = 3 * 24 * 60 * 60_000L)
+        val review = PersonaNotes.review(notes, maxChars = 2000, times = times)
+        assertTrue(review.text.lines().first().startsWith("me | hair | i dyed my hair black"))
+        assertTrue(review.text.contains("(written 3 days ago)"))
+        assertTrue("yume.me.hair" in review.shownKeys && "yume.opinion.rain" in review.shownKeys)
+
+        val keyed = PersonaNotes.renderKeyed(notes, maxChars = 2000)
+        assertTrue(keyed.text.contains("- me | hair | i dyed my hair black, red got boring"))
+        assertTrue(keyed.text.contains("Who you are now (your own call, newer than your files; you change it when you change):"))
+        assertTrue("yume.me.hair" in keyed.shownKeys)
+        // A line under a key she was shown replaces that note; under any other it goes beside.
+        val changed = PersonaNotes.besideUnseen(
+            listOf(Note(Kind.ME, "hair", "back to red, black was a phase")), notes, leftOut = null, shownKeys = keyed.shownKeys
+        )
+        assertEquals(listOf(Note(Kind.ME, "hair", "back to red, black was a phase")), changed)
+    }
+
+    @Test
+    fun `her own time lets her look at herself and change her mind, and keeps the past as it was`() {
+        val engine = File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        assertTrue(engine.contains("inOwnTime = true, nowMillis = nowMillis, shownNotes = { shownKeys = it }"))
+        assertTrue(engine.contains("val placed = PersonaNotes.besideUnseen(moment.notes, memory.notes(), unseen, shownKeys = shownKeys)\n                    memory.apply(placed)"))
+        val block = File("src/main/java/com/opendroid/ai/core/persona/PersonaOwnTime.kt").readText()
+        assertTrue(block.contains("a note line under the key of a note shown above replaces that note: that is how you change your mind."))
+        assertTrue(block.contains("what happened to you stays as it happened: a note changes who you are now, never what was."))
+    }
+
+    @Test
+    fun `her notebook learns from what she did and made, not only from what was said`() {
+        val command = ChatMessage("c", "Yume's own command: \"play usseewa loud\"", Sender.AGENT, modelBadge = PersonaActions.COMMAND_BADGE)
+        val act = PersonaNotebookTalk.asHerOwnAct(command)!!
+        assertEquals(PersonaNotebookTalk.DID_LABEL + "play usseewa loud", act.text)
