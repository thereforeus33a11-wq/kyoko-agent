+package com.opendroid.ai.core.life.ears
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.IOException
+
+/** The bzip2 reader the models are unpacked with, on archives made by bzip2 1.0.8. */
+class Bzip2InputStreamTest {
+
+    private fun inflate(bytes: ByteArray, chunk: Int = 8192): ByteArray {
+        val out = java.io.ByteArrayOutputStream()
+        Bzip2InputStream(ByteArrayInputStream(bytes)).use { input ->
+            val buffer = ByteArray(chunk)
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                out.write(buffer, 0, n)
+            }
+        }
+        return out.toByteArray()
+    }
+
+    @Test
+    fun `two blocks of text, long runs and random bytes come back exactly`() {
+        assertArrayEquals(EarsFixtures.payload(), inflate(EarsFixtures.PAYLOAD_BZ2))
+    }
+
+    @Test
+    fun `reading a byte at a time gives the same as reading in chunks`() {
+        assertArrayEquals(EarsFixtures.payload(), inflate(EarsFixtures.PAYLOAD_BZ2, chunk = 1))
+    }
+
+    @Test
+    fun `streams one after the other are read as one`() {
+        assertEquals("hello world", String(inflate(EarsFixtures.TWO_STREAMS), Charsets.US_ASCII))
+    }
+
+    @Test
+    fun `a flipped bit in a block fails instead of giving wrong bytes`() {
+        val bad = EarsFixtures.PAYLOAD_BZ2.copyOf()
+        bad[bad.size / 2] = (bad[bad.size / 2].toInt() xor 0x10).toByte()
+        assertThrows(IOException::class.java) { inflate(bad) }
+    }
+
+    @Test
+    fun `a cut-off stream fails`() {
+        val cut = EarsFixtures.PAYLOAD_BZ2.copyOf(EarsFixtures.PAYLOAD_BZ2.size - 20)
+        assertThrows(IOException::class.java) { inflate(cut) }
+    }
+
+    @Test
+    fun `what is not bzip2 is refused at once`() {
+        assertThrows(IOException::class.java) { Bzip2InputStream(ByteArrayInputStream("PK\u0003\u0004 not bzip2".toByteArray())) }
+        assertThrows(IOException::class.java) { Bzip2InputStream(ByteArrayInputStream(ByteArray(0))) }
+    }
+
+    @Test
+    fun `bytes after the last stream that start no new one fail`() {
+        assertThrows(IOException::class.java) { inflate(EarsFixtures.TWO_STREAMS + "junk".toByteArray()) }
+    }
+}
