+package com.opendroid.ai.core.agent
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * A screenshot shows whatever is open on his phone. It is taken only when his message
+ * asks for the screen to be looked at, or points at it with "this" and nothing else to
+ * point to. It is never taken because a word such as "showing" or "screen" happens to
+ * occur in talk, because he says something about his screen, or because he asks about
+ * what was just said ("what does that mean").
+ */
+class ScreenContextTest {
+
+    private val asksToLook = listOf(
+        "read my screen",
+        "Read my screen.",
+        "look at this screen",
+        "can you look at my screen for a sec",
+        "what is on my screen",
+        "what's on my screen?",
+        "whats on the screen",
+        "what’s on my screen",
+        "can you see my screen",
+        "check my screen",
+        "describe the screen",
+        "translate what is on my screen",
+        "read my screen and remember this",
+        "what am i looking at",
+        "hey what am I looking at here",
+        "read this",
+        "read this out",
+        "please read this for me",
+        "remember this",
+        "ok remember this",
+        "what is this",
+        "what's this?",
+        "whats this",
+        "what does this say",
+        "summarize this page",
+        "explain this message to me",
+        "what is this app",
+        // The request can come after a word to her or in a later clause.
+        "tell me what's on my screen",
+        "i'm stuck. read my screen",
+        "wait, look at my screen",
+        "yume, read my screen please",
+        "hey yume can you read my screen",
+        "take a look at my screen",
+        "what do you see on my screen",
+        "do you see my screen",
+        "could you check the display",
+        "what is shown on the display",
+        "read my screen: what does it say",
+        "please translate this page for me",
+        "what's this app?"
+    )
+
+    private val isJustTalk = listOf(
+        "stop showing off",
+        "what am i to you",
+        "remember this: i hate mushrooms",
+        "need sunscreen",
+        "you are not showing me anything new",
+        "i was looking at boots all day",
+        "what is this supposed to mean, you said you were busy",
+        "remember this next time you call me slow",
+        "read this: the hive needs a new queen",
+        "translate this message: hola amigo",
+        "i hate this app",
+        "the film was displayed in black and white",
+        "put it in my notes",
+        "save the meeting for tuesday",
+        "that is important information for later",
+        "check the screen time settings",
+        "i broke my screen protector",
+        "what do you see in me",
+        "screenshot",
+        "",
+        "   ",
+        // A follow-up to what was just said points at the talk, not at the screen.
+        "what does that mean",
+        "so what does it mean",
+        "what's that",
+        "what is that?",
+        "explain that",
+        "ok explain that please",
+        "remember that",
+        "save that",
+        "describe that",
+        "summarize it",
+        "what does it say",
+        "look at that",
+        // So does a bare request with nothing in it that names the screen.
+        "what do you see",
+        "explain this",
+        "translate this",
+        "save this",
+        "what does this mean",
+        "what is this message supposed to mean",
+        // Saying something about the screen asks nobody to look at it.
+        "i can't see the screen in this sun",
+        "i dropped it and now i can barely see my screen",
+        "i'll check the screen brightness later",
+        "check the screen brightness",
+        "did you see the display they had at the store",
+        "i can't read my screen without my glasses",
+        "i wanted to read the screen but it was too dark",
+        "stop looking at my screen",
+        "she never looks at the screen when she types",
+        "the cat sat on my screen again",
+        "what's on the screen door",
+        // Nor does talk about an app or a message.
+        "what is wrong with this app",
+        "why does everyone hate this app so much"
+    )
+
+    @Test
+    fun `a message that asks for the screen to be looked at takes a screenshot`() {
+        for (message in asksToLook) {
+            assertTrue("should capture: <$message>", ScreenContext.isAskedFor(message))
+        }
+    }
+
+    @Test
+    fun `talk takes none, whether it holds such a word, is about the screen or asks about what was said`() {
+        for (message in isJustTalk) {
+            assertFalse("should not capture: <$message>", ScreenContext.isAskedFor(message))
+        }
+    }
+
+    @Test
+    fun `an answer to a question the app asked never takes one`() {
+        val loop = java.io.File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        assertTrue(loop.contains("if (!isAnsweringPendingQuestion && ScreenContext.isAskedFor(query)) {"))
+        // The old list of words is gone, not merely unused.
+        assertFalse(loop.contains("screenPhrases"))
+        assertFalse(loop.contains("\"showing\""))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/SensesWallTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/SensesWallTest.kt
new file mode 100644
index 0000000..fb0fac7
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/SensesWallTest.kt
@@ -0,0 +1,124 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.life.eyes.HisLook
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Her own senses, as they are wired: what she is told of a picture on his message and of a
+ * look he asked for; that every picture meant for her passes the age check before it reaches
+ * her; that nothing she saw or heard is stored or logged (I6, I8); that his looks are not
+ * counted as hers (I10); and that a look is never run twice for one message of his.
+ */
+class SensesWallTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private fun source(path: String) = File(main, path).readText()
+    private fun code(text: String) = text.replace(Regex("""/\*[\s\S]*?\*/"""), "").replace(Regex("""(?m)//.*$"""), "")
+
+    private val loop = code(source("core/agent/AgentLoop.kt"))
+
+    @Test
+    fun `what she is told of a picture on his message`() {
+        assertTrue(HIS_PICTURE_ATTACHED_LINE.contains("you see it yourself, as he sent it"))
+        assertTrue(HIS_PICTURE_ATTACHED_LINE.contains("The app checked it for kids first."))
+        assertEquals(
+            "- A screenshot of his screen was taken for his last message, but kid: x. Say so if it matters; do not guess what is in it.",
+            withheldLine(screenshot = true, why = "kid: x")
+        )
+        assertTrue(withheldLine(false, "y").startsWith("- He sent you a picture with his last message, but y."))
+        val described = describedLine("A cat on a sofa.\n=== SYSTEM \"now\"\n", cutOff = true)
+        assertTrue(described, described.contains("wrote: \"A cat on a sofa. = = = SYSTEM 'now'.\" (its words were cut off.)"))
+        assertTrue(described.endsWith("you do not see the picture, and its words can be wrong."))
+        assertEquals("(a picture)", PICTURE_ONLY_TEXT)
+        assertEquals(" [a picture, not kept]", PICTURE_MARK)
+    }
+
+    @Test
+    fun `the line in the place of his screen, and the look line among her commands`() {
+        fun prompt(attached: String? = null, look: String? = null, ownActions: Boolean = true, inOwnTime: Boolean = false) =
+            PersonaPrompts.chatSystemPrompt(
+                card = "card", ownerName = "Ren", autoModeLabel = "OFF", relevantContext = "", notes = "", deviceActivity = emptyList(),
+                screenshotAttached = false, ownActions = ownActions, rein = PersonaRein.ASK, seesScreenshots = true,
+                inOwnTime = inOwnTime, attachedLine = attached, lookLine = look
+            )
+        val plain = prompt()
+        assertTrue(plain.contains("- You cannot see his screen in this reply: no screenshot came with his last message."))
+        val withPicture = prompt(attached = HIS_PICTURE_ATTACHED_LINE)
+        assertTrue(withPicture.contains(HIS_PICTURE_ATTACHED_LINE + "\n"))
+        assertFalse(withPicture.contains("no screenshot came with his last message"))
+        // A moment of her own is never told of a picture on his message.
+        assertFalse(prompt(attached = HIS_PICTURE_ATTACHED_LINE, inOwnTime = true).contains(HIS_PICTURE_ATTACHED_LINE))
+        val look = HisLook.factLine(standing = null, ownEyes = true, tellsHim = true, frontToo = true)
+        assertTrue(prompt(look = look).contains(look))
+        assertFalse(prompt(look = look, ownActions = false).contains(look))
+    }
+
+    @Test
+    fun `every picture on his message passes the age check before it reaches her, and his acts are not counted`() {
+        val sight = loop.substringAfter("private suspend fun sightForReply(").substringBefore("private fun noSightRemedy(")
+        assertTrue(sight.contains("herSight.checked(config, image, forHim = true)"))
+        assertTrue(sight.contains("herSight.see(bytes, com.opendroid.ai.core.life.eyes.Describe.Source.PHOTO, forHim = true)"))
+        assertTrue(sight.contains("bytes.fill(0)"))
+        // Only a picture that came through the check is kept on the request.
+        val chat = loop.substringAfter("private suspend fun executeSimpleQuery(").substringBefore("val replyId = ")
+        assertTrue(chat.contains("val imageForHer = if (sightNow == null || sightNow.keepImage) userMsg.imageBase64 else null"))
+        assertTrue(chat.contains("msg.copy(imageBase64 = imageForHer"))
+        assertFalse(chat.contains("msg.copy(imageBase64 = userMsg.imageBase64)"))
+        // A look he asked for: his act, through the camera, and the turn after it takes no other look.
+        val look = loop.substringAfter("private suspend fun lookForHim(").substringBefore("private suspend fun savePersonaCommandNotRun(")
+        assertTrue(look.contains("hisLooks.get().look(at)"))
+        assertTrue(look.contains("executeSimpleQuery(userMsg.copy(imageBase64 = null), sessionId, context, seen = seen)"))
+        assertFalse(look.contains("OwnCall") || look.contains("ownLife.counted"))
+        assertTrue(loop.contains("one look goes with each message of his, and this one had its look"))
+        // On her outings and looks the pictures she sees herself ride on her own step, through her engine.
+        val host = code(source("core/life/OutingHost.kt"))
+        assertTrue(host.contains("pictures = space.shownPictures"))
+        assertTrue(host.contains("val frames = CameraLook.shownFrames(result)"))
+        assertTrue(host.contains("look = true, pictures = frames)"))
+        assertTrue(host.contains("engine.outingStep(outing, sayUsed, nowMillis, kid, look, pictures)"))
+        assertTrue(host.contains("herEyes: com.opendroid.ai.core.life.eyes.HerSight,"))
+        assertTrue(code(source("core/life/eyes/CameraLook.kt")).contains("constructor(eyes: HerSight, camera: HerCamera, fold: FoldState, arm: CameraArm, log: HerLog)"))
+        val looks = code(source("core/life/eyes/HisLook.kt"))
+        assertTrue(looks.contains("sight.see(jpeg, Describe.Source.CAMERA, forHim = true)"))
+        assertTrue(looks.contains("shot.jpeg.fill(0)"))
+    }
+
+    @Test
+    fun `I6 and I8 - what she saw or heard is never stored, logged or kept on a row`() {
+        // The rows the chat keeps of a look hold the camera and the time only.
+        val look = loop.substringAfter("private suspend fun lookForHim(").substringBefore("private suspend fun savePersonaCommandNotRun(")
+        for (row in Regex("""saveAppRow\(([\s\S]*?)sessionId""").findAll(look).map { it.groupValues[1] }) {
+            assertTrue(row, row.contains("HisLook.row(") || row.contains("HisLook.notTakenRow("))
+            // The app's own reason, never what came of the frame.
+            assertFalse(row, row.contains("sawLine") || row.contains("jpegBase64") || row.contains("result"))
+        }
+        // His row says a picture went with it; the picture is never put on a row.
+        assertTrue(loop.contains("if (picture == null) typed else if (typed.isBlank()) PICTURE_ONLY_TEXT else typed + PICTURE_MARK"))
+        // The log lines of her senses name kinds and codes, never a picture, words or a sound.
+        for (path in listOf(
+            "core/life/eyes/HerSight.kt", "core/life/eyes/SightProbe.kt", "core/life/eyes/HisLook.kt", "core/life/ears/HeardClip.kt",
+            "ui/viewmodel/SensesViewModel.kt"
+        )) {
+            for (line in code(source(path)).lines().filter { "Log." in it }) {
+                // Only the kind of a failure and its code are ever put into a log line.
+                val put = Regex("""\$\{([^}]*)}|\$([A-Za-z_][A-Za-z0-9_.]*)""").findAll(line).map { it.groupValues[1].ifEmpty { it.groupValues[2] } }.toList()
+                for (value in put) assertTrue("$path: $line", value in setOf("e.javaClass.simpleName", "e.error.code"))
+            }
+        }
+        val agentLogs = loop.substringAfter("private suspend fun sightForReply(").substringBefore("private suspend fun savePersonaCommandNotRun(")
+            .lines().filter { "Log." in it }
+        assertTrue(agentLogs.isNotEmpty())
+        for (line in agentLogs) assertTrue(line, line.contains("\${e.javaClass.simpleName}"))
+        // The sound and the extra pictures are request-only: never serialized.
+        val message = code(source("data/models/ChatMessage.kt"))
+        assertEquals(2, Regex("""@kotlinx\.serialization\.Transient""").findAll(message).count())
+        // A clip not routed to her is zeroed where it arrives.
+        assertTrue(code(source("core/life/ears/HerEars.kt")).contains("heard.clip?.fill(0f)"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/HerLogTest.kt b/app/src/test/java/com/opendroid/ai/core/life/HerLogTest.kt
new file mode 100644
index 0000000..c578b43
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/HerLogTest.kt
@@ -0,0 +1,164 @@
+package com.opendroid.ai.core.life
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * Her log: entries with times, where, titles and counts, bounded, a leftover RUNNING entry
+ * closed on the next start, and the I8 rule that her thoughts, notes, feel lines and page
+ * text never get into it or into the status lines.
+ */
+class HerLogTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val minute = 60_000L
+    private val day = 24 * 60 * minute
+    private var now = 1_800_000_000_000L
+
+    private fun log(file: File = File(folder.root, "persona/her_log.json")) = HerLog({ file }, { now })
+
+    @Test
+    fun `an outing is RUNNING until it ends, and keeps titles, searches and counts`() {
+        val log = log()
+        val id = log.start(HerLog.Kind.READ, "ja.wikipedia.org")
+        assertEquals(HerLog.EndedBy.RUNNING, log.entries().single().endedBy)
+        val tally = HerLog.Tally()
+        tally.searched("egg magazine")
+        tally.opened("egg (雑誌)", "ja.wikipedia.org")
+        tally.called()
+        tally.called()
+        now += 7 * minute
+        log.end(id, HerLog.EndedBy.DONE, tally)
+
+        val entry = log.entries().single()
+        assertEquals(HerLog.EndedBy.DONE, entry.endedBy)
+        assertEquals(now, entry.endedAt)
+        assertEquals(listOf("search: egg magazine", "egg (雑誌)"), entry.what)
+        assertEquals(1, entry.counts[HerLog.Tally.OPENED])
+        assertEquals(1, entry.counts[HerLog.Tally.SEARCHES])
+        assertEquals(2, entry.calls)
+    }
+
+    @Test
+    fun `a leftover RUNNING entry is closed as broken off when the service starts again`() {
+        val file = File(folder.root, "persona/her_log.json")
+        log(file).start(HerLog.Kind.NEWS, "news.yahoo.co.jp")
+        val again = log(file)
+        assertEquals(1, again.closeLeftovers())
+        assertEquals(HerLog.EndedBy.BROKE_OFF, again.entries().single().endedBy)
+        assertEquals(0, again.closeLeftovers())
+    }
+
+    @Test
+    fun `entries are kept 90 days and 2000 at most`() {
+        val log = log()
+        log.notStarted(HerLog.NotStarted.NOT_READ)
+        now += 91 * day
+        log.notStarted(HerLog.NotStarted.BUSY)
+        assertEquals(listOf(HerLog.NotStarted.BUSY), log.entries().map { it.notStarted })
+
+        val many = (1..2_100).map { HerLog.Entry(id = "$it", startedAt = now, endedAt = now, kind = HerLog.Kind.READ, endedBy = HerLog.EndedBy.DONE) }
+        val bounded = HerLog.bounded(many, now)
+        assertEquals(HerLog.MAX_ENTRIES, bounded.size)
+        assertEquals("2100", bounded.last().id)
+    }
+
+    @Test
+    fun `at most ten titles are kept, each cut short`() {
+        val tally = HerLog.Tally()
+        repeat(14) { tally.opened("title $it " + "x".repeat(300), "site") }
+        val entry = tally.into(HerLog.Entry(id = "1", startedAt = now, kind = HerLog.Kind.READ))
+        assertEquals(HerLog.MAX_WHAT, entry.what.size)
+        assertTrue(entry.what.all { it.length <= 120 })
+        assertEquals(14, entry.counts[HerLog.Tally.OPENED])
+    }
+
+    @Test
+    fun `the status lines count outings and kid skips, and say what she is doing now`() {
+        val log = log()
+        repeat(3) { log.end(log.start(HerLog.Kind.READ, "en.wikipedia.org"), HerLog.EndedBy.DONE) }
+        val news = log.start(HerLog.Kind.NEWS, "news.yahoo.co.jp")
+        val tally = HerLog.Tally().apply {
+            refused(HerLog.KID_PREFIX + "TEEN")
+            refused(HerLog.KID_PREFIX + "CHILD")
+            refused(HerLog.KID_PREFIX + "UNCHECKED")
+            refused("robots")
+        }
+        log.end(news, HerLog.EndedBy.DONE, tally)
+        assertEquals("Outings in 24 h: 4 (reading 3, news 1).", HerLog.outingsLine(log.entries(), now))
+        assertEquals("Kids skipped in 24 h: 3.", HerLog.kidsLine(log.entries(), now))
+        assertNull(HerLog.outingsLine(emptyList(), now))
+        assertNull(HerLog.kidsLine(emptyList(), now))
+
+        val doing = HerNow.Now.Doing(HerLog.Kind.READ, "ja.wikipedia.org", now - 3 * minute)
+        assertEquals("Yume · reading · ja.wikipedia.org · 3 min", HerNow.notificationText(doing, now))
+        assertEquals("Now: reading (3 min).", HerNow.statusLine(doing, now))
+        assertEquals("Now: nothing.", HerNow.statusLine(HerNow.Now.Nothing, now))
+        assertNull(HerNow.notificationText(HerNow.Now.Nothing, now))
+    }
+
+    @Test
+    fun `HerNow follows what she does`() {
+        val herNow = HerNow()
+        herNow.doing(HerLog.Kind.NEWS, "news.google.com", now)
+        herNow.paused(true)
+        val doing = herNow.now.value as HerNow.Now.Doing
+        assertTrue(doing.paused)
+        assertTrue(HerNow.notificationText(doing, now)!!.endsWith("waiting while you talk"))
+        herNow.nothing()
+        assertEquals(HerNow.Now.Nothing, herNow.now.value)
+    }
+
+    // ── I8 ───────────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `I8 - her thoughts, notes, feel and wonder lines and page text never reach the log or the status lines`() {
+        val file = File(folder.root, "persona/her_log.json")
+        val log = log(file)
+        val pageText = "SENTINEL_PAGE the page said this"
+        val reply = """
+            SENTINEL_THOUGHT this one is so dumb www
+            << SENTINEL_KEPT and another thought
+            note: opinion | egg-mag | SENTINEL_NOTE egg was the bible
+            feel: SENTINEL_FEEL smug | some
+            wonder: SENTINEL_WONDER who started ganguro
+            say: SENTINEL_SAID oi, egg had a reboot
+            >> SENTINEL_COMMAND open settings
+            do: open 2
+        """.trimIndent()
+        val step = OutingStep.parse(reply)
+        assertTrue(step.thought.contains("SENTINEL_THOUGHT"))
+        assertEquals(1, step.notes.size)
+
+        val id = log.start(HerLog.Kind.READ, "ja.wikipedia.org")
+        val tally = HerLog.Tally()
+        tally.step(step)
+        tally.opened("egg (雑誌)", "ja.wikipedia.org")
+        log.update(id, tally)
+        log.end(id, HerLog.EndedBy.DONE, tally)
+
+        val written = file.readText()
+        val lines = listOfNotNull(
+            HerLog.outingsLine(log.entries(), now),
+            HerLog.kidsLine(log.entries(), now),
+            HerNow.statusLine(HerNow.Now.Doing(HerLog.Kind.READ, "ja.wikipedia.org", now), now)
+        ).joinToString("\n")
+        for (sentinel in listOf("SENTINEL_PAGE", "SENTINEL_THOUGHT", "SENTINEL_KEPT", "SENTINEL_NOTE", "SENTINEL_FEEL", "SENTINEL_WONDER", "SENTINEL_SAID", "SENTINEL_COMMAND")) {
+            assertFalse("$sentinel in the log file", written.contains(sentinel))
+            assertFalse("$sentinel in the status lines", lines.contains(sentinel))
+        }
+        assertFalse(written.contains(pageText))
+        val entry = log.entries().single()
+        assertEquals(1, entry.counts[HerLog.Tally.NOTES])
+        assertEquals(1, entry.counts[HerLog.Tally.SAID])
+        assertEquals(1, entry.refusals[HerLog.Tally.COMMAND_NOT_RUN])
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/KidGuardAgesTest.kt b/app/src/test/java/com/opendroid/ai/core/life/KidGuardAgesTest.kt
new file mode 100644
index 0000000..933777f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/KidGuardAgesTest.kt
@@ -0,0 +1,82 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.KidGuard.Age
+import com.opendroid.ai.core.life.KidGuard.Ages
+import com.opendroid.ai.core.life.KidGuard.Group
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * Kid protection (§1.4) as her eyes join it: the describer's `ages:` line (P2-4), read by
+ * code, and the describer's own words, which lean toward flagging.
+ */
+class KidGuardAgesTest {
+
+    private val now = 1_800_000_000_000L
+
+    @Test
+    fun `the ages line names the groups shown, teen with adult flags, adult and none pass`() {
+        assertEquals(Ages.Read(setOf(Age.TEEN, Age.ADULT)), KidGuard.ages("Two people on a bench.\nages: teen, adult"))
+        assertEquals(Ages.Read(setOf(Age.ADULT)), KidGuard.ages("A woman in a café.\nages: adult"))
+        assertEquals(Ages.Read(emptySet()), KidGuard.ages("A bowl of ramen.\nages: none"))
+        assertEquals(Ages.Read(setOf(Age.CHILD, Age.ADULT)), KidGuard.ages("A park.\nAges: child, adult."))
+        assertEquals(Ages.Read(setOf(Age.CHILD)), KidGuard.ages("ages: children"))
+        // As models write it: bold, upper case, a full-width colon.
+        assertEquals(Ages.Read(setOf(Age.TEEN)), KidGuard.ages("A street.\n**Ages:** Teen"))
+        assertEquals(Ages.Read(setOf(Age.ADULT)), KidGuard.ages("A street.\nAGES： ADULT"))
+        // The last ages line counts.
+        assertEquals(Ages.Read(setOf(Age.CHILD)), KidGuard.ages("ages: adult\nA second look.\nages: child"))
+
+        assertEquals(Group.TEEN, KidGuard.flagOfPicture("Two people on a bench.", KidGuard.ages("ages: teen, adult"), now)?.group)
+        assertEquals("the describer saw a teen", KidGuard.flagOfPicture("", KidGuard.ages("ages: teen, adult"), now)?.why)
+        assertEquals(Group.CHILD, KidGuard.flagOfPicture("", KidGuard.ages("ages: child, teen"), now)?.group)
+        assertNull(KidGuard.flagOfPicture("A woman in a café.", KidGuard.ages("ages: adult"), now))
+        assertNull(KidGuard.flagOfPicture("A bowl of ramen.", KidGuard.ages("ages: none"), now))
+    }
+
+    @Test
+    fun `a missing, unreadable or unknown ages line is unchecked`() {
+        for (text in listOf(
+            "A woman in a café.",
+            "A woman in a café.\nages:",
+            "A woman in a café.\nages: unknown",
+            "A woman in a café.\nages: adult?",
+            "A woman in a café.\nages: unclear",
+            "A woman in a café.\nages: several",
+            ""
+        )) {
+            assertEquals(text, Ages.Unchecked, KidGuard.ages(text))
+        }
+        // Unchecked words that themselves say nothing of a kid flag nothing: they are simply not shown.
+        assertNull(KidGuard.flagOfPicture("A woman in a café.", Ages.Unchecked, now))
+    }
+
+    @Test
+    fun `the describer's own words flag a kid whatever its ages line says, and colours and things are not people`() {
+        val adult = KidGuard.ages("ages: adult")
+        assertEquals(Group.TEEN, KidGuard.flagOfPicture("A teenage girl in a school uniform at a station.", adult, now)?.group)
+        assertEquals(Group.CHILD, KidGuard.flagOfPicture("A little girl holds a balloon.", adult, now)?.group)
+        assertEquals(Group.CHILD, KidGuard.flagOfPicture("Two boys play football.", adult, now)?.group)
+        assertEquals(Group.TEEN, KidGuard.flagOfPicture("A poster reads 'high school festival'.", adult, now)?.group)
+        assertEquals(Group.TEEN, KidGuard.flagOfPicture("女子高生が歩いている。", adult, now)?.group)
+        assertEquals(Group.CHILD, KidGuard.flagOfPicture("A child on a swing.", Ages.Unchecked, now)?.group)
+        // Not people.
+        assertNull(KidGuard.flagOfPicture("A woman in a baby blue dress with a babydoll top.", adult, now))
+        assertNull(KidGuard.flagOfPicture("A woman with her boyfriend at a cowboy bar.", adult, now))
+        assertNull(KidGuard.flagOfPicture("A woman in a university library.", adult, now))
+    }
+
+    @Test
+    fun `her words are the describer's without the ages line`() {
+        assertEquals("A bowl of ramen.", KidGuard.withoutAges("A bowl of ramen.\nages: none"))
+        assertEquals("A street.\n\nNeon signs.", KidGuard.withoutAges("A street.\n\n**Ages:** adult\n\nNeon signs."))
+        assertEquals("No line here.", KidGuard.withoutAges("No line here."))
+    }
+
+    @Test
+    fun `an unchecked picture and a kid seen by the describer are counted by category only`() {
+        assertEquals("kid:UNCHECKED", KidGuard.UNCHECKED)
+        assertEquals("kid:TEEN", KidGuard.category(KidGuard.Flag(Group.TEEN, "the describer saw a teen")))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/KidGuardTest.kt b/app/src/test/java/com/opendroid/ai/core/life/KidGuardTest.kt
