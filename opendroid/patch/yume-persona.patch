+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.agent.AgentState
+import com.opendroid.ai.core.persona.PersonaActions
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What the screens say around her. With her on, nothing on them speaks as a servant
+ * under her name, and what the settings say she may do is what the code does. With the
+ * app running as stock, the stock wording is untouched.
+ */
+class PersonaWordingTest {
+
+    private val servile = listOf("serve", "Hello! I am", "Online & Ready", "assistant", "Let's Go", "I ", " me ")
+
+    // ── The chat title and status line ───────────────────────────────────────────────
+
+    @Test
+    fun `the chat is titled with her name only when she is the one who talks`() {
+        assertEquals("YUME", chatTitle(true))
+        assertEquals("OPENDROID", chatTitle(false))
+        // Not known yet: no name is better than the wrong one.
+        assertEquals("", chatTitle(null))
+    }
+
+    @Test
+    fun `clearing a chat or wiping the history says what is kept for her notebook`() {
+        assertEquals(null, clearedChatNotice(false))
+        assertEquals(null, clearedChatNotice(null))
+        assertEquals("Chat cleared. $NOTEBOOK_KEEPS_UNREAD", clearedChatNotice(true))
+        assertTrue(CHAT_HISTORY_WIPED_NOTICE.contains("is kept on this phone until a notebook pass of hers has read it"))
+        // Both are said where the rows go.
+        val chat = java.io.File("src/main/java/com/opendroid/ai/ui/screens/ChatScreen.kt").readText()
+        assertTrue(chat.substringAfter("viewModel.clearChat()").substringBefore("Text(\"Clear\"").contains("clearedChatNotice(personaActive)"))
+        val memory = java.io.File("src/main/java/com/opendroid/ai/ui/screens/MemoryScreen.kt").readText()
+        assertTrue(memory.substringAfter("viewModel.clearMemories(MemoryType.EPISODIC)").substringBefore("}").contains("CHAT_HISTORY_WIPED_NOTICE"))
+        // And both of those clears keep the unread rows first, as deleting does.
+        val repository = java.io.File("src/main/java/com/opendroid/ai/data/repository/ConversationRepository.kt").readText()
+        assertTrue(repository.substringAfter("suspend fun clearSession(").substringBefore("}").contains("tellMessagesGo(leavingFrom(sessionId))"))
+        assertTrue(repository.substringAfter("suspend fun clearAllSessions(").substringBefore("conversationDao.clear").contains("tellMessagesGo("))
+    }
+
+    @Test
+    fun `deleting a chat says what is kept of it for her notebook, and only when she is the one who talks`() {
+        assertEquals("\"Bees\" and its messages will be permanently deleted.", deleteChatWarning("Bees", personaActive = false))
+        assertEquals(deleteChatWarning("Bees", false), deleteChatWarning("Bees", null))
+        assertEquals(
+            "\"Bees\" and its messages will be permanently deleted. What the two of you said in it that her notebook " +
+                "has not read yet is kept on this phone until a notebook pass of hers has read it.",
+            deleteChatWarning("Bees", personaActive = true)
+        )
+        // That is what happens: the store tells before a chat goes, and her engine keeps the unread rows until a pass read them.
+        val repository = java.io.File("src/main/java/com/opendroid/ai/data/repository/ConversationRepository.kt").readText()
+        val delete = repository.substringAfter("suspend fun deleteSession(").substringBefore("suspend fun ensureCurrentSessionId(")
+        assertTrue(delete.indexOf("tellMessagesGo(leavingFrom(sessionId))") in 0 until delete.indexOf("conversationDao.clearSession(sessionId)"))
+        val engine = java.io.File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        assertTrue(engine.contains("memoryManager.episodicMemory.beforeRowsGo(::keepUnread)"))
+        val keep = engine.substringAfter("private suspend fun keepUnread(").substringBefore("internal suspend fun reflect(")
+        assertTrue(keep.contains("if (!isActive(settingsRepository.llmConfig.first())) return@withContext"))
+        assertTrue(keep.contains("memory.keepLeftBehind(PersonaNotebookTalk.toKeep(rows))"))
+        assertTrue(engine.contains("memory.dropLeftBehind(page.readUpTo)"))
+    }
+
+    private val states = listOf(
+        AgentState.Idle,
+        AgentState.Listening,
+        AgentState.Thinking,
+        AgentState.ExecutingPlan("Open the hive log"),
+        AgentState.Speaking("the second hive is up, finally"),
+        AgentState.Error("boom")
+    )
+
+    @Test
+    fun `with her on the status line names plain states and reports for duty to nobody`() {
+        assertEquals("idle", agentStatusText(AgentState.Idle, runningElsewhere = false, plain = true))
+        assertEquals("listening", agentStatusText(AgentState.Listening, runningElsewhere = false, plain = true))
+        assertEquals("thinking", agentStatusText(AgentState.Thinking, runningElsewhere = false, plain = true))
