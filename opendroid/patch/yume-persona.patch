+
+    @Test
+    fun `the facts of the approval prompt come from the steps, and only the service puts her words around them`() {
+        val service = File(mainSources, "core/service/OpenDroidService.kt").readText()
+        val call = service.substringAfter("persona.phrasebook.approvalPrompt(").substringBefore("textToSpeechEngine.speak(")
+        assertTrue(call.contains("stepCount = PlanApprovalSummary.stepCount(state.plan)"))
