+package com.opendroid.ai.core.llm
+
+import com.opendroid.ai.core.llm.providers.VeniceE2ee
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.selectedModelFor
+import java.net.URI
+
+/**
+ * Who can read what is sent to a model, judged from the configuration alone.
+ *
+ * The owner's rule is that what he tells her stays with her. A prompt has to go to
+ * whichever model writes the answer, so the rule comes down to where that model runs:
+ *
+ *  - [ON_DEVICE]: on this phone. Nothing leaves it.
+ *  - [OWN_NETWORK]: on a machine at a private address (his PC, a home server, a private
+ *    tunnel). It leaves the phone and stays his.
+ *  - [ENCRYPTED]: at a company, but encrypted on this phone to a key that exists only
+ *    inside a sealed enclave. The company carries text it cannot read.
+ *  - [PRIVATE_TIER]: at Venice, on a model of its Private tier ([VenicePrivateTier]), while
+ *    the owner trusts that tier for her ([LLMConfig.trustVenicePrivate]). Venice reads the
+ *    prompt to answer it and keeps nothing of it. Only a trusted call is ever judged so: the
+ *    same model untrusted is [HOSTED].
+ *  - [HOSTED]: at a company, readable by it.
+ */
+enum class RoutePrivacy {
+    ON_DEVICE, OWN_NETWORK, ENCRYPTED, PRIVATE_TIER, HOSTED;
+
+    /**
+     * True when nobody but the owner's own hardware, or a sealed enclave, can read the
+     * prompt, or it goes to a host he trusts for her that keeps nothing ([PRIVATE_TIER]).
+     */
+    val isPrivate: Boolean get() = this != HOSTED
+
+    /**
+     * The routes are declared from the most private to the least, so a request may be
+     * handed from [other] to this one without more people being able to read it.
+     */
+    fun isAtLeastAsPrivateAs(other: RoutePrivacy): Boolean = ordinal <= other.ordinal
+
+    val label: String
+        get() = when (this) {
+            ON_DEVICE -> "on this phone"
+            OWN_NETWORK -> "on your own network"
+            ENCRYPTED -> "end to end encrypted"
+            PRIVATE_TIER -> "Venice Private tier, trusted: read to answer, nothing kept"
+            HOSTED -> "hosted, readable by the provider"
+        }
+
+    /**
+     * What the label takes on trust, said where the label is shown. Null for a route
+     * whose label holds as it stands.
+     *
+     * "Own network" is judged by the address. What is checked when a request is made is
+     * that the machine it reaches is at a private address
+     * ([com.opendroid.ai.core.util.CleartextGuard]); whose machine that is cannot be
+     * checked. A hotel's or a cafe's network has private addresses of its own, and can
+     * answer a name with one.
+     */
+    val smallPrint: String?
+        get() = when (this) {
+            OWN_NETWORK ->
+                "\"On your own network\" is judged by the address. The app sends only where the machine it reaches " +
+                    "is at a private address; it cannot tell whose machine that is. On a network that is not " +
+                    "yours, the same address or name can be someone else's machine, and plain http can be read " +
+                    "by that network."
+            PRIVATE_TIER ->
+                "\"Venice Private tier\" is Venice's word: it runs these models itself and says it keeps no prompt " +
+                    "and no answer. It is not end to end encrypted. Venice reads what it is sent, his details, " +
+                    "pictures and sound included, to answer it; the phone cannot check that nothing is kept. " +
+                    "It counts as private only because you trust it for her."
+            else -> null
+        }
+}
+
+/** Whether a call on [route] may be made at all. */
+fun RoutePolicy.allows(route: RoutePrivacy): Boolean = when (this) {
+    RoutePolicy.OWN_HARDWARE -> route == RoutePrivacy.ON_DEVICE || route == RoutePrivacy.OWN_NETWORK
+    RoutePolicy.ENCRYPTED -> route.isPrivate
+    RoutePolicy.ANY -> true
+}
+
+/**
+ * Whether the owner's own details (date of birth, where he is, notification text, what
+ * she has noted about him, what the phone read out to him) are left out of a prompt on
+ * [route]. On a private route nothing is held back: she may look at everything, because
+ * nobody else can. On a plain hosted route private mode keeps those details on the phone.
+ */
+fun LLMConfig.holdsBackDetails(route: RoutePrivacy): Boolean = privateMode && !route.isPrivate
+
+/** The providers that are reached at an address the owner types, and so can be pointed at another machine. */
+private val TYPED_ADDRESS_PROVIDERS = setOf("Custom OpenAI Compatible", "Ollama", "Copilot API")
+
+/**
+ * The host a key belongs to when it is typed for [provider] now: the host of the address
+ * that provider is set to. Empty for a provider with a fixed address, and while no
+ * address is set. Recorded in [LLMConfig.apiKeyHosts] when the key field is edited.
+ */
+fun LLMConfig.keyHostNow(provider: String): String {
+    val name = ProviderCatalog.canonicalName(provider)
+    if (name !in TYPED_ADDRESS_PROVIDERS) return ""
+    return RouteClassifier.hostOf(RouteClassifier.endpointOf(this, name)).orEmpty()
+}
+
+/**
+ * This setting with [host] noted as the one that [key], just typed for [provider],
+ * belongs to ([keyHostNow], read when the key was typed). A key that was cleared, and a
+ * provider with a fixed address or none set yet, has no entry.
+ */
+fun LLMConfig.withKeyHost(provider: String, key: String, host: String): LLMConfig {
+    val name = ProviderCatalog.canonicalName(provider)
+    return copy(apiKeyHosts = if (key.isBlank() || host.isEmpty()) apiKeyHosts - name else apiKeyHosts + (name to host))
+}
+
+/**
+ * The key to send with a request to [provider] at [endpoint]: the stored key, or none
+ * when that key belongs to another host than the one the provider points at now. A key
+ * is a secret he gave to one machine. Pointing the provider somewhere else (from a hosted
+ * service to a server on his desk, or to another service) must not hand it to the new one.
+ *
+ * A key that is tied to no host yet ([keyIsUntied]) goes where the provider points.
+ */
+fun LLMConfig.apiKeyFor(provider: String, endpoint: String): String {
+    val name = ProviderCatalog.canonicalName(provider)
+    val key = apiKeys[name].orEmpty()
+    val typedFor = apiKeyHosts[name].orEmpty()
+    if (key.isBlank() || typedFor.isEmpty() || name !in TYPED_ADDRESS_PROVIDERS) return key
+    return if (RouteClassifier.hostOf(endpoint) == typedFor) key else ""
+}
+
+/**
+ * True when the key stored for [provider], one whose address he types, is tied to no
+ * host yet: it was saved before hosts were noted, or typed while the provider had no
+ * address. There was no host to note for it then. It is tied to the first host that
+ * answers a request made with it ([withKeyTiedTo]), so that it does not follow the
+ * provider to every address it is pointed at afterwards.
+ */
+fun LLMConfig.keyIsUntied(provider: String): Boolean {
+    val name = ProviderCatalog.canonicalName(provider)
+    return name in TYPED_ADDRESS_PROVIDERS && apiKeys[name].orEmpty().isNotBlank() && apiKeyHosts[name].isNullOrEmpty()
+}
+
+/**
+ * This setting with the key of [provider] tied to the host of [endpoint], which has
+ * just answered a request that carried [key]. Unchanged unless [key] is still the key
+ * that is stored and it is tied to no host yet: a key he has typed since, and the host
+ * noted for it, are not touched.
+ */
+fun LLMConfig.withKeyTiedTo(provider: String, endpoint: String, key: String): LLMConfig {
+    val name = ProviderCatalog.canonicalName(provider)
+    if (!keyIsUntied(name) || apiKeys[name] != key) return this
+    val host = RouteClassifier.hostOf(endpoint).orEmpty()
+    return if (host.isEmpty()) this else copy(apiKeyHosts = apiKeyHosts + (name to host))
+}
+
+/**
+ * What the key list says under the key of [provider]: where that key goes. Null for a
+ * provider with a fixed address and where no key is stored. Each sentence says what
+ * [apiKeyFor] does with the key as things stand.
+ */
+fun LLMConfig.keyHostNote(provider: String): String? {
+    val name = ProviderCatalog.canonicalName(provider)
+    if (name !in TYPED_ADDRESS_PROVIDERS || apiKeys[name].orEmpty().isBlank()) return null
+    val tiedTo = apiKeyHosts[name].orEmpty()
+    val pointsAt = keyHostNow(name)
+    return when {
+        tiedTo.isEmpty() ->
+            "This key is not tied to an address yet. It goes to the address set for $name, and once a message " +
+                "or a connection test sent with it is answered there, only to that host."
+        tiedTo == pointsAt -> "This key is sent to $tiedTo only."
+        pointsAt.isEmpty() -> "This key belongs to $tiedTo and is sent there only. $name has no address set now."
+        else ->
+            "This key belongs to $tiedTo and is sent there only. $name is set to another address now, and " +
+                "nothing sent to that one carries this key. Enter the key for it here, or set the address back."
+    }
+}
+
+object RouteClassifier {
+
+    /**
+     * Providers whose endpoint the owner types in and whose model then runs at that
+     * address, so it may be his own hardware. "Copilot API" is not one of them: what
+     * runs at its address is a relay to a company's hosted models, wherever it listens.
+     */
+    private val OWN_ENDPOINT_PROVIDERS = setOf("Ollama", "Custom OpenAI Compatible")
+
+    /** The one host the encrypted exchange is spoken with; the provider refuses any other. */
+    private const val ENCRYPTED_HOST = "api.venice.ai"
+
+    /**
+     * Ollama serves models tagged this way from its own servers, whatever address the app
+     * talks to. It does so on its OpenAI-style /v1 address as well, which is reached
+     * through the compatible provider, so the tag counts for both providers. A model on
+     * another server that happens to be named this way is taken for hosted too: where
+     * the name leaves a doubt, the answer is the one that sends less.
+     */
+    private val OLLAMA_CLOUD_TAG = Regex("""(?i)[:\-]cloud$""")
+
+    /**
+     * The route a request to [provider] with [model] at [endpoint] takes. [trustedTier] says
+     * whether a model is of Venice's Private tier and trusted for her ([trustedTierOf]); a
+     * call made without the settings trusts none.
+     */
+    fun classify(provider: String, model: String, endpoint: String, trustedTier: (String) -> Boolean = { false }): RoutePrivacy {
+        val name = ProviderCatalog.canonicalName(provider)
+        if (ProviderCatalog.isOnDevice(name)) return RoutePrivacy.ON_DEVICE
+        // No model id turns a hosted provider into one on the phone. ("gemini-nano" used to
+        // count as on this phone; what answered under that id was a fixed sentence, not a model.)
+        val relayedToACompany = name in OWN_ENDPOINT_PROVIDERS && OLLAMA_CLOUD_TAG.containsMatchIn(model.trim())
+        if (name in OWN_ENDPOINT_PROVIDERS && !relayedToACompany) {
+            when (hostKind(endpoint)) {
+                HostKind.LOOPBACK -> return RoutePrivacy.ON_DEVICE
+                HostKind.PRIVATE -> return RoutePrivacy.OWN_NETWORK
+                HostKind.PUBLIC -> Unit
+            }
+        }
+        // The encrypted exchange exists only in the OpenAI-compatible provider, and only
+        // with the one host whose enclaves it knows how to check.
+        if (name == "Custom OpenAI Compatible" && VeniceE2ee.isE2eeModel(model) && hostOf(endpoint) == ENCRYPTED_HOST &&
+            endpoint.trim().startsWith("https://", ignoreCase = true)
+        ) {
+            return RoutePrivacy.ENCRYPTED
+        }
+        // Venice's Private tier, trusted for her: only through the compatible provider, only
+        // at Venice's one address over https, and only for a model of that tier.
+        if (name == "Custom OpenAI Compatible" && !VeniceE2ee.isE2eeModel(model) && hostOf(endpoint) == ENCRYPTED_HOST &&
+            endpoint.trim().startsWith("https://", ignoreCase = true) && trustedTier(model.trim())
+        ) {
+            return RoutePrivacy.PRIVATE_TIER
+        }
+        return RoutePrivacy.HOSTED
+    }
+
+    /**
+     * Whether [model] is of Venice's Private tier ([VenicePrivateTier.isPrivateTier]) and he
+     * trusts that tier for her ([LLMConfig.trustVenicePrivate]), as [config] stands.
+     */
+    fun trustedTierOf(config: LLMConfig): (String) -> Boolean =
+        { model -> config.trustVenicePrivate && VenicePrivateTier.isPrivateTier(model, config) }
+
+    /** [classify] with the trust in Venice's Private tier that [config] holds. */
+    fun classify(config: LLMConfig, provider: String, model: String, endpoint: String): RoutePrivacy =
+        classify(provider, model, endpoint, trustedTierOf(config))
+
+    /** The route [provider] takes as configured, with [modelOverride] in place of its selected model. */
+    fun classify(config: LLMConfig, provider: String, modelOverride: String? = null): RoutePrivacy {
+        val name = ProviderCatalog.canonicalName(provider)
+        val model = modelOverride?.trim()?.takeIf { it.isNotEmpty() }
+            ?: if (ProviderCatalog.isKnown(name)) config.selectedModelFor(name) else ""
+        return classify(name, model, endpointOf(config, name), trustedTierOf(config))
+    }
+
+    /** The route the planner and everything else on the main provider takes. */
+    fun mainRoute(config: LLMConfig): RoutePrivacy = classify(config, config.activeProvider)
+
+    /** The route her own replies, her notebook and her own time take. */
+    fun personaRoute(config: LLMConfig): RoutePrivacy {
+        val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+        val provider = if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) chosen else config.activeProvider
+        return classify(config, provider, config.personaChatModel)
+    }
+
+    fun endpointOf(config: LLMConfig, provider: String): String = when (ProviderCatalog.canonicalName(provider)) {
+        "Copilot API" -> config.copilotUrl.trim()
+        "Ollama" -> config.ollamaUrl.trim()
+        else -> config.customEndpoints[ProviderCatalog.canonicalName(provider)].orEmpty().trim()
+    }
+
+    /**
+     * True when a request to [endpoint] would travel without TLS: it says http://, or it
+     * names no scheme at all, which the providers read as http. Anyone on the way can read
+     * such a request, so it is only for a machine of the owner's own ([cleartextStaysHis]).
+     */
+    internal fun isCleartext(endpoint: String): Boolean {
+        val trimmed = endpoint.trim()
+        if (trimmed.isEmpty()) return false
+        return if ("://" in trimmed) trimmed.startsWith("http://", ignoreCase = true) else true
+    }
+
+    /** Whether an unencrypted request to [endpoint] stays on this phone or on his own network. */
+    internal fun cleartextStaysHis(endpoint: String): Boolean = hostKind(endpoint) != HostKind.PUBLIC
+
+    /** The port Ollama listens on unless it is told otherwise. */
+    private const val OLLAMA_PORT = 11434
+
+    /**
+     * What is said under the address field of [provider] about the address typed into
+     * it, or null when there is nothing to add. Two things the address alone shows:
+     *
+     *  - It is a name that reads as his own machine. A name is not an address: it is
+     *    looked up by whichever network the phone is on. The sentence says what is
+     *    checked for it and what is not.
+     *  - It is the compatible provider pointed at the port of an Ollama server. Through
+     *    that server's OpenAI-style address no context size can be asked for, so a
+     *    prompt longer than the model's context is cut from the front without a word.
+     *    The Ollama provider asks for the context by the size of the prompt.
+     */
+    fun addressNote(provider: String, endpoint: String): String? {
+        val name = ProviderCatalog.canonicalName(provider)
+        if (name !in OWN_ENDPOINT_PROVIDERS) return null
+        val host = hostOf(endpoint) ?: return null
+        val notes = mutableListOf<String>()
+        val isAName = ':' !in host && !host.all { it.isDigit() || it == '.' }
+        if (isAName && hostKind(endpoint) == HostKind.PRIVATE) {
+            notes += "\"$host\" is a name, and a name is looked up by whichever network the phone is on. The app " +
+                "sends to it only when it leads to a private address, and cannot tell whose machine is at that " +
+                "address."
+        }
+        if (name == "Custom OpenAI Compatible" && portOf(endpoint) == OLLAMA_PORT) {
+            notes += "This is the port of an Ollama server. Through its /v1 address the app cannot ask for a context " +
+                "size, and Ollama cuts a prompt that is longer than the model's context from the front without " +
+                "saying so. Set the context on that machine (PARAMETER num_ctx in a Modelfile, or " +
+                "OLLAMA_CONTEXT_LENGTH), or use the Ollama provider, which asks for the context a prompt needs."
+        }
+        return notes.takeIf { it.isNotEmpty() }?.joinToString(" ")
+    }
+
+    /** The port written in [endpoint], or -1 when it names none or cannot be read. */
+    private fun portOf(endpoint: String): Int {
+        val trimmed = endpoint.trim()
+        return try {
+            URI(if ("://" in trimmed) trimmed else "http://$trimmed").port
+        } catch (e: Exception) {
+            -1
+        }
+    }
+
+    internal enum class HostKind { LOOPBACK, PRIVATE, PUBLIC }
+
+    /**
+     * Sorts the host of [endpoint] by its literal form only. A name is never looked up:
+     * an answer from DNS could be anything, and the point of this check is to be certain.
+     * So a public-looking name that happens to resolve to a private address counts as
+     * public, which errs on the side of not sending.
+     */
+    /** The host of [endpoint] in lower case, or null when it has none that can be read. */
+    internal fun hostOf(endpoint: String): String? {
+        val trimmed = endpoint.trim()
+        if (trimmed.isEmpty()) return null
+        return try {
+            URI(if ("://" in trimmed) trimmed else "http://$trimmed").host
+        } catch (e: Exception) {
+            null
+        }?.lowercase()?.removeSurrounding("[", "]")?.trimEnd('.')
+    }
+
+    internal fun hostKind(endpoint: String): HostKind {
+        val host = hostOf(endpoint) ?: return HostKind.PUBLIC
+        if (host == "localhost" || host.endsWith(".localhost")) return HostKind.LOOPBACK
+        if (':' in host) return ipv6Kind(host)
+        val octets = host.split('.')
+        if (octets.size == 4 && octets.all { part -> part.isNotEmpty() && part.length <= 3 && part.all(Char::isDigit) }) {
+            val (a, b) = octets.map { it.toInt() }
+            if (octets.any { it.toInt() > 255 }) return HostKind.PUBLIC
+            return when {
+                a == 127 -> HostKind.LOOPBACK
+                a == 10 -> HostKind.PRIVATE
+                a == 172 && b in 16..31 -> HostKind.PRIVATE
+                a == 192 && b == 168 -> HostKind.PRIVATE
+                a == 169 && b == 254 -> HostKind.PRIVATE
+                // Carrier-grade NAT space, which private tunnels such as Tailscale use.
+                a == 100 && b in 64..127 -> HostKind.PRIVATE
+                else -> HostKind.PUBLIC
+            }
+        }
+        // All digits and dots but not four octets: not an address anyone should trust.
+        if (host.all { it.isDigit() || it == '.' }) return HostKind.PUBLIC
+        return if (PRIVATE_SUFFIXES.any { host.endsWith(it) } || '.' !in host) HostKind.PRIVATE else HostKind.PUBLIC
+    }
+
+    /**
+     * Sorts an address a connection was really opened to, by the same ranges [hostKind]
+     * uses for an address that is written out. A name says where a request is meant to
+     * go; this says where it went ([com.opendroid.ai.core.util.CleartextGuard]).
+     */
+    internal fun addressKind(address: java.net.InetAddress): HostKind {
+        if (address.isLoopbackAddress) return HostKind.LOOPBACK
+        val bytes = address.address
+        val first = bytes[0].toInt() and 0xff
+        val second = bytes[1].toInt() and 0xff
+        val private = when (bytes.size) {
+            4 -> first == 10 || (first == 172 && second in 16..31) || (first == 192 && second == 168) ||
+                (first == 169 && second == 254) || (first == 100 && second in 64..127)
+            // Unique local addresses (fc00::/7) and link-local ones (fe80::/10).
+            16 -> (first and 0xfe) == 0xfc || (first == 0xfe && (second and 0xc0) == 0x80)
+            else -> false
+        }
+        return if (private) HostKind.PRIVATE else HostKind.PUBLIC
+    }
+
+    private fun ipv6Kind(host: String): HostKind {
+        val address = host.substringBefore('%')
+        return when {
+            address == "::1" -> HostKind.LOOPBACK
+            address.startsWith("fc") || address.startsWith("fd") -> HostKind.PRIVATE
+            address.startsWith("fe8") || address.startsWith("fe9") ||
+                address.startsWith("fea") || address.startsWith("feb") -> HostKind.PRIVATE
+            else -> HostKind.PUBLIC
+        }
+    }
+
+    /**
+     * Name endings that only exist on a private network: mDNS, the usual home-router
+     * domains, and a Tailscale tailnet. A bare single-label name is private too, since
+     * nothing on the public internet answers to one.
+     *
+     * A name is not an address, though. On a network that is not his, whoever runs it
+     * decides what such a name leads to. So the name only decides how the route is
+     * labelled and judged before a request is made; when the request is made, the
+     * machine the connection reached has to be on this phone or at a private address
+     * itself, or nothing is written to it ([com.opendroid.ai.core.util.CleartextGuard]).
+     */
+    private val PRIVATE_SUFFIXES = listOf(".local", ".lan", ".home", ".home.arpa", ".internal", ".ts.net")
+}
