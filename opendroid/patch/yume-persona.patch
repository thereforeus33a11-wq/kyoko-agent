+    /** Her engine: scripted replies, read the way her engine reads them, one counted call per step. */
+    private inner class Mind : OutingHost.Mind {
+        var config = LLMConfig(personaOwnLife = true, personaLendScreen = true)
+        @Volatile var asleepNow = false
+        val replies = ArrayDeque<String>()
+        val texts = CopyOnWriteArrayList<String>()
+        val apps = CopyOnWriteArrayList<String>()
+        val pictures = CopyOnWriteArrayList<List<String>>()
+        val backs = CopyOnWriteArrayList<OutingHost.Back>()
+        val missed = CopyOnWriteArrayList<Pair<String, HerLog.NotStarted>>()
+        var duringStep: (Int) -> Unit = {}
+        @Volatile var gate: CompletableDeferred<Unit>? = null
+
+        override suspend fun config(): LLMConfig = config
+        override fun lifeOn(config: LLMConfig): Boolean = config.personaOwnLife
+        override fun thoughtsShown(config: LLMConfig): Boolean = true
+        override suspend fun asleep(): Boolean = asleepNow
+        override suspend fun step(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, look: Boolean): OutingStep.Step? =
+            error("a step on his screen is a phone step")
+
+        override suspend fun phoneStep(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, pictures: List<String>, app: String): OutingStep.Step? {
+            texts += outing
+            apps += app
+            this.pictures += pictures.toList()
+            duringStep(texts.size)
+            gate?.await()
+            now.addAndGet(20_000)
+            ledger.record(OwnPurpose.OUTING_STEP, "e2ee-her-model", 14_000, 600, ok = true)
+            val reply = synchronized(replies) { replies.removeFirstOrNull() } ?: return null
+            return OutingStep.parse(reply, sayUsed = sayUsed, kid = kid)
+        }
+
+        override suspend fun cameBack(back: OutingHost.Back, nowMillis: Long) {
+            backs += back
+        }
+
+        override suspend fun missed(words: String, why: HerLog.NotStarted) {
+            missed += words to why
+        }
+    }
+
+    private class Room : OutingHost.Room {
+        val lines = CopyOnWriteArrayList<String>()
+        val asked = CopyOnWriteArrayList<Triple<HerLog.Kind, Int, String>>()
+        override suspend fun said(line: String, atMillis: Long) {
+            lines += line
+        }
+
+        override suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String) {
+            asked += Triple(kind, maxMinutes, camera)
+        }
+    }
+
+    /** Her eyes: scripted, one EYES call each, as her sight writes it. */
+    private inner class FakeEyes : Eyes {
+        val seen = ArrayDeque<HerEyes.Seen>()
+        val described = CopyOnWriteArrayList<Describe.Source>()
+        val bytes = CopyOnWriteArrayList<ByteArray>()
+        override fun open(config: LLMConfig, nowMillis: Long) = true
+        override fun leftToday(config: LLMConfig, nowMillis: Long): Int = 60
+        override suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen {
+            described += source
+            bytes += image
+            ledger.record(OwnPurpose.EYES, "her-sight", 900, 60, ok = true)
+            return synchronized(seen) { seen.removeFirstOrNull() } ?: HerEyes.Seen.Described("A phone screen with a video.", KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)))
+        }
+    }
+
+    private object NoSources : ReadingSpace.Sources {
+        override suspend fun search(words: String): Wikipedia.Result<List<Wikipedia.Hit>> = Wikipedia.Result.Empty
+        override suspend fun article(title: String, lang: String): Wikipedia.Result<Wikipedia.Article> = Wikipedia.Result.Empty
+        override suspend fun fetch(url: String): HerFetcher.Fetched = HerFetcher.Fetched.Refused(HerFetcher.Why.ROBOTS)
+        override suspend fun feed(feed: Feeds.Feed): Feeds.Read = Feeds.Read.Items(feed, emptyList())
+        override fun follow(url: String, name: String): HerFeeds.Followed = HerFeeds.Followed.ADDED
+    }
