@@ -0,0 +1,423 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.PersonaRein
+
+/**
+ * How the persona uses the phone herself: the last line of a reply may be
+ * `>> <plain command>`. The app takes that line out of what is shown and spoken and
+ * hands the command to the normal planner, so whatever the planner can do for the
+ * owner it can do for her. There is no list of what she may ask for.
+ *
+ * What differs from one of his commands is only who is asked first ([decideStart]).
+ * His own approval setting always counts. Where it would stop the plan, her rein
+ * ([PersonaRein], see [runsOnRein]) may still let it run:
+ *
+ *  - ASK: never. His setting decides, exactly as for a command of his.
+ *  - PHONE: a plan made only of [STAYS_ON_PHONE] actions runs at once.
+ *  - EVERYTHING: all of it runs at once.
+ *
+ * Her rein never runs a plan whose words may be someone else's ([whoseWords]). Then
+ * his setting decides alone, and when the plan is shown to him he is told why.
+ *
+ * Everything in this file is a pure decision about text. Planning, approval and
+ * running stay with the loop that runs the owner's commands.
+ */
+object PersonaActions {
+
+    const val MARKER = ">>"
+
+    /** Badge of the chat row that records a plan which ran on her rein, without a prompt. */
+    const val REIN_BADGE = "Her rein"
+
+    /** Badge of the chat row that keeps a command of hers, word for word. */
+    const val COMMAND_BADGE = "Her command"
+
+    /**
+     * The same row for a command whose words may be someone else's. It has a badge of
+     * its own because it is treated differently later: see [isHerOwnWordsRow].
+     */
+    const val BORROWED_BADGE = "Her command (outside words)"
+
+    /**
+     * True for a chat row that holds nothing but her own words and the app's fixed
+     * wording around them. Such a row is left out of the outside text a later command is
+     * held against, or her repeating herself would look like repeating a stranger. A row
+     * with [BORROWED_BADGE] is not one of these: what it quotes may have come from
+     * outside, so a later command that repeats it is still an echo.
+     */
+    fun isHerOwnWordsRow(badge: String?): Boolean = badge == REIN_BADGE || badge == COMMAND_BADGE
+
+    /**
+     * True for any of the rows the app writes about a command of hers. They quote her,
+     * so like her own lines they are not replayed to the stock assistant when she is
+     * switched off.
+     */
+    fun isCommandRow(badge: String?): Boolean =
+        badge == REIN_BADGE || badge == COMMAND_BADGE || badge == BORROWED_BADGE
+
+    /**
+     * Canonical names of the actions whose whole effect stays on the phone: they send no
+     * words to another person or to a site, and read none of his messages, files, notes
+     * or screen. On the PHONE rein a plan made only of these runs without asking.
+     *
+     * Left out on purpose, although they look local:
+     *  - PLAY_MUSIC and PLAY_YOUTUBE hand her words to a music or video service's search;
+     *  - CALCULATE and CONVERT_UNITS open a web search with her text (CALCULATE whenever
+     *    it cannot work the sum out itself);
+     *  - CREATE_CALENDAR_EVENT can carry invitations to other people;
+     *  - TOGGLE_MOBILE_DATA and TOGGLE_HOTSPOT can cost money or let other devices on;
+     *  - COPY_TO_CLIPBOARD and CLEAR_CLIPBOARD replace what he had copied;
+     *  - TAKE_PHOTO_BACKGROUND takes a picture without him pressing anything;
+     *  - UPDATE_PREFERENCE and SAVE_SENSITIVE_INFO write what the app holds to be facts
+     *    about him.
+     * None of these is closed to her. They go through his approval setting.
+     */
+    val STAYS_ON_PHONE: Set<String> = setOf(
+        // Apps and the screen. The camera actions only open the camera; he presses the button.
+        "OPEN_APP", "CLOSE_APP", "LOCK_SCREEN", "TAKE_SCREENSHOT", "SET_WALLPAPER", "TAKE_PHOTO", "RECORD_VIDEO",
+        // Switches and levels.
+        "TOGGLE_FLASHLIGHT", "TOGGLE_DND", "TOGGLE_WIFI", "TOGGLE_BLUETOOTH",
+        "SET_BRIGHTNESS", "SET_VOLUME", "SET_RINGER_MODE", "GET_SYSTEM_INFO",
+        // Time. A reminder or a task opens the calendar editor, where he saves it himself.
+        "SET_ALARM", "SET_TIMER", "SET_REMINDER", "CREATE_TASK",
+        // Music that is already there to control.
+        "PAUSE_MUSIC", "RESUME_MUSIC", "NEXT_TRACK", "PREV_TRACK", "SET_VOLUME_MUSIC",
+        // A note in the app's own store.
+        "ADD_NOTE",
+        // Steps the planner puts around the others: a pause, a question to him, a line on screen.
+        "WAIT", "ASK_USER", "DISPLAY_INFO", "CHAT"
+    )
+
+    private const val MIN_COMMAND_CHARS = 3
+
+    /** Long enough for a message to someone to fit in the command. */
+    private const val MAX_COMMAND_CHARS = 500
+
+    data class Split(val text: String, val command: String?)
+
+    /**
+     * Separates what she says from what she wants done. Only a `>>` line that is the
+     * last line counts as a command, so there is one command per reply at most; any
+     * other `>>` line is simply removed, so a marker in the middle of a reply can never
+     * be shown, spoken or run.
+     */
+    fun split(reply: String): Split {
+        val lines = reply.lines()
+        val lastContent = lines.indexOfLast { it.isNotBlank() }
+        if (lastContent < 0) return Split("", null)
+        var command: String? = null
+        val kept = ArrayList<String>(lines.size)
+        for ((index, line) in lines.withIndex()) {
+            val trimmed = line.trim()
+            if (!trimmed.startsWith(MARKER)) {
+                kept += line
+                continue
+            }
+            if (index == lastContent) {
+                command = trimmed.removePrefix(MARKER).trim().trim('`', '"').trim()
+                    .takeIf { it.length in MIN_COMMAND_CHARS..MAX_COMMAND_CHARS && it.any(Char::isLetter) }
+            }
+        }
+        return Split(kept.joinToString("\n").trim(), command)
+    }
+
+    /** True only when there is at least one action and every one of them stays on the phone. */
+    fun allStayOnPhone(canonicalActions: Collection<String>): Boolean =
+        canonicalActions.isNotEmpty() && canonicalActions.all { it in STAYS_ON_PHONE }
+
+    /**
+     * Whether her rein alone lets a plan she started run without asking. False does not
+     * mean no: it means the owner's own approval setting decides, exactly as it would
+     * for one of his commands.
+     *
+     * [canonicalActions] are all actions of the plan as it will run, fallbacks included.
+     * [wordsMayBeSomeoneElses] is what [whoseWords] found. Her rein is his trust in her,
+     * not in whoever wrote what she was shown, so a plan whose words may be someone
+     * else's is never run on it. That holds for PHONE too: a note is an action that
+     * stays on the phone, and a note made of a stranger's words would be read back to
+     * the planner as a fact about him from then on. It also keeps the three reins in
+     * order: whatever PHONE lets run, EVERYTHING lets run as well.
+     */
+    fun runsOnRein(
+        rein: PersonaRein,
+        canonicalActions: Collection<String>,
+        wordsMayBeSomeoneElses: Boolean
+    ): Boolean = when (rein) {
+        PersonaRein.ASK -> false
+        PersonaRein.PHONE -> allStayOnPhone(canonicalActions) && !wordsMayBeSomeoneElses
+        PersonaRein.EVERYTHING -> canonicalActions.isNotEmpty() && !wordsMayBeSomeoneElses
+    }
+
+    /** Whose words a command of hers, and the plan made from it, may be. */
+    enum class Whose {
+        /** Nothing says they are anyone's but hers. */
+        HERS,
+
+        /** She wrote the command with a screenshot in front of her: what stands on a screen was written by others. */
+        SCREEN,
+
+        /** The command repeats text that reached the phone from outside. */
+        ECHO,
+
+        /** The plan made from the command holds a number or an address from outside that her command does not. */
+        PLAN
+    }
+
+    /**
+     * Whether the words of [command] may be someone else's rather than hers. They may be
+     * when the reply that held the command was written with a screenshot in front of her,
+     * because whatever stands on a screen was written by others, or when the command
+     * repeats text that reached the phone from outside ([echoesOutsideText]).
+     */
+    fun wordsMayBeSomeoneElses(command: String, screenshotAttached: Boolean, outsideText: String): Boolean =
+        screenshotAttached || echoesOutsideText(command, outsideText)
+
+    /**
+     * The same question, asked of the plan as well, with the reason in the answer.
+     * [planWords] are the parameter values the planner wrote. The planner works from
+     * more than her command, so a recipient, a link or an account in a step that her
+     * command never named, and that stands in the outside text, is not hers either
+     * ([planCarriesOutsideText]).
+     */
+    fun whoseWords(
+        command: String,
+        planWords: Collection<String>,
+        screenshotAttached: Boolean,
+        outsideText: String
+    ): Whose = when {
+        screenshotAttached -> Whose.SCREEN
+        echoesOutsideText(command, outsideText) -> Whose.ECHO
+        planCarriesOutsideText(command, planWords, outsideText) -> Whose.PLAN
+        else -> Whose.HERS
+    }
+
+    /** How a plan she started gets under way. */
+    enum class Start {
+        /** His own approval setting lets it run, as it would for the same command from him. */
+        HIS_SETTING,
+
+        /** His setting would stop it and her rein lets it run. */
+        HER_REIN,
+
+        /** It is shown to him for a yes. */
+        ASK
+    }
+
+    /** What [decideStart] found: how the plan starts, and whose its words may be. */
+    data class StartDecision(val start: Start, val whose: Whose) {
+        val wordsMayBeSomeoneElses: Boolean get() = whose != Whose.HERS
+    }
+
+    /**
+     * The whole decision about a plan she started, in one place.
+     *
+     * His own setting is asked first and always counts: [hisSettingRuns] is the stock
+     * rule's answer for this plan and this command. Only where it would stop the plan is
+     * her [rein] asked, and her rein never runs a plan whose words may be someone else's.
+     * Whose the words may be is worked out on every rein, so that a plan which is shown
+     * to him can say why.
+     *
+     * [canonicalActions] are every action the plan can run as it will run, fallbacks
+     * included. [planWords] are the parameter values as the planner wrote them, before
+     * the app put a number from the owner's address book in the place of a name: what
+     * the planner wrote is what could have come from somewhere else. [screenshotAttached]
+     * and [outsideText] describe the reply that held the command: whether an image went
+     * to her with it, and the notification text and app lines that were on the phone
+     * when her prompt was built.
+     */
+    fun decideStart(
+        hisSettingRuns: Boolean,
+        rein: PersonaRein,
+        canonicalActions: Collection<String>,
+        command: String,
+        planWords: Collection<String>,
+        screenshotAttached: Boolean,
+        outsideText: String
+    ): StartDecision {
+        val whose = whoseWords(command, planWords, screenshotAttached, outsideText)
+        val start = when {
+            hisSettingRuns -> Start.HIS_SETTING
+            runsOnRein(rein, canonicalActions, whose != Whose.HERS) -> Start.HER_REIN
+            else -> Start.ASK
+        }
+        return StartDecision(start, whose)
+    }
+
+    // ── What the chat keeps of a command of hers ─────────────────────────────────────
+
+    /**
+     * The row that keeps [command] in the chat word for word, written before anything is
+     * planned. Her reply is stored without its command line and a plan's step lines name
+     * only the action and who it goes to, so without this row the owner could not see
+     * what she asked for in his name, and she could not truthfully say later what it was.
+     * [who] is her name as the chat shows it.
+     */
+    fun commandRecord(who: String, command: String): String = "$who's own command: \"$command\""
+
+    /**
+     * The row for a command that was not passed on at all, because it repeats her own
+     * notes about him and the only planner there is runs where his details are not to be
+     * read. The command stays on the phone, in this row, and he can give it himself.
+     */
+    fun keptRecord(who: String, command: String): String =
+        "$who's own command stayed on the phone: \"$command\"\n" +
+            "It repeats what her notes say about you, and the model that would plan it is hosted where " +
+            "private mode keeps your details from being read. Give the command yourself to run it."
+
+    /**
+     * The row that says why a plan of hers is shown to him although her rein, or the look
+     * of the plan, would let one think it runs by itself. Null when the words are hers.
+     */
+    fun shownRecord(who: String, whose: Whose): String? = when (whose) {
+        Whose.HERS -> null
+        Whose.SCREEN ->
+            "Shown to you first: $who wrote that command with your screen in front of her, " +
+                "so its words may be someone else's."
+        Whose.ECHO ->
+            "Shown to you first: that command repeats something from a notification or from one of the " +
+                "app's lines, so its words may be someone else's."
+        Whose.PLAN ->
+            "Shown to you first: the plan made from that command holds a number or an address that $who " +
+                "did not write and that stands in a notification or in one of the app's lines."
+    }
+
+    // ── Whose words ──────────────────────────────────────────────────────────────────
+
+    // The patterns below are built on first use, not when this object loads: [split] runs
+    // on every reply of hers and must not depend on them.
+
+    /** A phone number, an account number, a code: five digits or more, however they are spaced. */
+    private val LONG_NUMBER by lazy { Regex("""\d(?:[\s().-]*\d){4,}""") }
+    private val EMAIL by lazy { Regex("""[a-z0-9._%+-]+@[a-z0-9-]+(?:\.[a-z0-9-]+)*\.[a-z]{2,24}""") }
+
+    /** A link or a bare domain; the host is what is compared. The host of an e-mail address is not one. */
+    private val WEB_ADDRESS by lazy {
+        Regex("""(?<![a-z0-9@._-])(?:https?://)?(?:www\.)?([a-z0-9-]+(?:\.[a-z0-9-]+)*\.[a-z]{2,24})(?![a-z0-9@])""")
+    }
+    private val HANDLE by lazy { Regex("""(?<![a-z0-9._%+-])@([a-z0-9_]{2,})""") }
+
+    /**
+     * A payment address of the form name@bank, the way the payment action takes its
+     * payee. It has no dot after the @, so it is neither an e-mail address nor a handle,
+     * and it is the one token that says where money goes.
+     */
+    private val PAYEE by lazy {
+        Regex("""(?<![a-z0-9._-])[a-z0-9._-]{2,256}@[a-z][a-z0-9]{1,63}(?![a-z0-9]|[.-][a-z0-9])""")
+    }
+    private val DIGIT_SEPARATORS by lazy { Regex("""(?<=\d)[\s().-]+(?=\d)""") }
+    private val HANDLE_NAME by lazy { Regex("""[a-z0-9_]+""") }
+    private val WORD by lazy { Regex("""\p{L}+""") }
+    private val APOSTROPHES by lazy { Regex("""['\u2019]""") }
+
+    private const val MIN_WORD_LETTERS = 4
+    private const val MIN_CONTENT_WORDS = 4
+    private const val ECHO_PERCENT = 60
+
+    private enum class TokenKind { NUMBER, EMAIL, HOST, HANDLE, PAYEE }
+
+    /** One thing that points an action at somebody, in the form it is compared in. */
+    private data class HardToken(val kind: TokenKind, val value: String)
+
+    private val DIGIT_GROUP by lazy { Regex("""\d+""") }
+    private const val MIN_NUMBER_DIGITS = 5
+
+    /**
+     * The long numbers in a stretch of digit groups, as digits only. "555 010 7788" is
+     * one number, but in "5550107788 10 minutes late" a number is followed by a count,
+     * and the two must not be read as one longer number that stands nowhere. So every
+     * run of neighbouring groups with five digits or more is a number to look for.
+     */
+    private fun longNumbers(stretch: String): List<String> {
+        val groups = DIGIT_GROUP.findAll(stretch).map { it.value }.toList()
+        val numbers = mutableListOf<String>()
+        for (first in groups.indices) {
+            val joined = StringBuilder()
+            for (last in first until groups.size) {
+                joined.append(groups[last])
+                if (joined.length >= MIN_NUMBER_DIGITS) numbers += joined.toString()
+            }
+        }
+        return numbers
+    }
+
+    /** The hard tokens of a text that is already lowercase. */
+    private fun hardTokens(text: String): Set<HardToken> = buildSet {
+        LONG_NUMBER.findAll(text).forEach { stretch ->
+            longNumbers(stretch.value).forEach { add(HardToken(TokenKind.NUMBER, it)) }
+        }
+        EMAIL.findAll(text).forEach { add(HardToken(TokenKind.EMAIL, it.value)) }
+        WEB_ADDRESS.findAll(text).forEach { add(HardToken(TokenKind.HOST, it.groupValues[1])) }
+        HANDLE.findAll(text).forEach { add(HardToken(TokenKind.HANDLE, it.groupValues[1])) }
+        PAYEE.findAll(text).forEach { add(HardToken(TokenKind.PAYEE, it.value)) }
+    }
+
+    /** A lowercase text that hard tokens are looked for in. Each kind is read out of it once, when first asked for. */
+    private class SearchedText(text: String) {
+        private val digits by lazy { DIGIT_SEPARATORS.replace(text, "") }
+        private val emails by lazy { EMAIL.findAll(text).map { it.value }.toSet() }
+        private val hosts by lazy { WEB_ADDRESS.findAll(text).map { it.groupValues[1] }.toSet() }
+        private val names by lazy { HANDLE_NAME.findAll(text).map { it.value }.toSet() }
+        private val payees by lazy { PAYEE.findAll(text).map { it.value }.toSet() }
+
+        fun holds(token: HardToken): Boolean = when (token.kind) {
+            TokenKind.NUMBER -> token.value in digits
+            TokenKind.EMAIL -> token.value in emails
+            TokenKind.HOST -> token.value in hosts
+            TokenKind.HANDLE -> token.value in names
+            TokenKind.PAYEE -> token.value in payees
+        }
+    }
+
+    /**
+     * True when [command] repeats something from [outsideText]: text that reached the
+     * phone from other people or from the web (notifications, and the app's own lines
+     * that can quote them).
+     *
+     * Two signs count. A hard token of the command, the kind of thing that points an
+     * action at somebody (a run of five or more digits, an e-mail address, a web address
+     * or domain, an @handle, a payment address), is found in the outside text. Or the
+     * command has at least four words of four letters or more and at least 60 percent of
+     * them are words of the outside text. A short command of her own never trips the
+     * second sign, and a wrong yes costs only a prompt: the plan is shown to the owner
+     * instead of running.
+     */
+    fun echoesOutsideText(command: String, outsideText: String): Boolean {
+        if (command.isBlank() || outsideText.isBlank()) return false
+        val said = command.lowercase()
+        val outside = outsideText.lowercase()
+
+        val searched = SearchedText(outside)
+        if (hardTokens(said).any(searched::holds)) return true
+
+        val words = contentWords(said)
+        if (words.size < MIN_CONTENT_WORDS) return false
+        val outsideWords = contentWords(outside)
+        return words.count { it in outsideWords } * 100 >= words.size * ECHO_PERCENT
+    }
+
+    /**
+     * True when the plan made from [command] points at somebody her command never named:
+     * a hard token in one of [planWords] (the parameter values of the steps) that stands
+     * in [outsideText] and is not in the command itself. The planner reads more than her
+     * command, and a number it took from somewhere else is not her word.
+     *
+     * Only hard tokens count here. The planner rewords what she said as a matter of
+     * course, so the plain words of a step say nothing about where they came from. Each
+     * value is read by itself: an amount in one parameter and a number in the next are
+     * two things.
+     */
+    fun planCarriesOutsideText(command: String, planWords: Collection<String>, outsideText: String): Boolean {
+        if (planWords.isEmpty() || outsideText.isBlank()) return false
+        val outside = SearchedText(outsideText.lowercase())
+        val own = SearchedText(command.lowercase())
+        return planWords.any { value ->
+            hardTokens(value.lowercase()).any { outside.holds(it) && !own.holds(it) }
+        }
+    }
+
+    private fun contentWords(lowercaseText: String): Set<String> =
+        WORD.findAll(APOSTROPHES.replace(lowercaseText, ""))
+            .map { it.value }
+            .filter { it.length >= MIN_WORD_LETTERS }
+            .toSet()
+}
