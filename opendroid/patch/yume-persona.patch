index 0000000..8e0ed35
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PlanWordsPassTest.kt
@@ -0,0 +1,437 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.prompts.PlanningPrompts
+import com.opendroid.ai.core.llm.prompts.SystemPrompts
+import com.opendroid.ai.core.persona.HerWords
+import com.opendroid.ai.core.persona.PersonaEngine
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The pass a plan goes through before it is shown or run while she is on: words that are
+ * not his or hers are hers to write or are left out, and nothing goes to a machine.
+ */
+class PlanWordsPassTest {
+
+    private fun step(id: String, order: Int, action: String, params: Map<String, String>) = PlanStep(
+        stepId = id, order = order, description = "the planner's description", action = action, params = params, fallback = ""
+    )
+
+    private val composedBody =
+        "Hello Tumblr Support,\n\nI am writing because my blog was flagged by mistake. Could you please review it?\n\nBest regards,\nRen"
+
+    private val tumblr = step(
+        "s1", 1, "SEND_EMAIL",
+        mapOf("to" to "support@tumblr.com", "subject" to "Request to review my flagged blog", "body" to composedBody)
+    )
+
+    private val his = PlanWordsPass.Origin(HerWords.From.HIM, "email tumblr support about my blog being flagged")
+
+    /** A stand-in for her model that answers [answer] and keeps what she was asked. */
+    private class Her(val answer: (HerWords.Ask) -> HerWords.Answer) {
+        val asked = ArrayList<HerWords.Ask>()
+        suspend fun write(ask: HerWords.Ask): HerWords.Answer {
+            asked += ask
+            return answer(ask)
+        }
+    }
+
+    @Test
+    fun `her words take the place of the tool's, and she is told what it is and who asked, never the draft`() = runBlocking {
+        val her = Her { HerWords.Answer.Written(mapOf("subject" to "my blog got flagged", "body" to "hey, my blog got flagged for nothing. look at it again pls")) }
+        val result = PlanWordsPass.run(listOf(tumblr), his, her::write)
+
+        val ask = her.asked.single()
+        assertEquals(HerWords.Kind.EMAIL, ask.kind)
+        assertEquals("support@tumblr.com", ask.to)
+        assertEquals("his email app", ask.through)
+        assertEquals(HerWords.From.HIM, ask.askedBy)
+        assertEquals(his.words, ask.asked)
+        assertEquals(listOf("subject", "body"), ask.fields)
+        assertFalse(ask.stored)
+        // Nothing of the planner's draft or its description is in what she is told.
+        for (part in listOf(ask.to, ask.through, ask.asked) + ask.fields) {
+            assertFalse(part, part.contains("Best regards") || part.contains("Hello Tumblr") || part.contains("planner"))
+        }
+
+        val sent = result.steps.single()
+        assertEquals("hey, my blog got flagged for nothing. look at it again pls", sent.params["body"])
+        assertEquals("my blog got flagged", sent.params["subject"])
+        assertEquals("support@tumblr.com", sent.params["to"])
+        assertTrue(result.changed)
+        assertEquals(listOf("Send email to support@tumblr.com: ${PersonaPrompts.BADGE} wrote the words."), result.lines)
+    }
+
+    @Test
+    fun `she writes only what is not his, and what he dictated stays as he wrote it`() = runBlocking {
+        val her = Her { ask -> HerWords.Answer.Written(ask.fields.associateWith { "sick today" }) }
+        val dictated = step(
+            "s1", 1, "SEND_EMAIL",
+            mapOf("to" to "boss@example.com", "subject" to "Sick day", "body" to "I'm sick today and won't be in")
+        )
+        val result = PlanWordsPass.run(listOf(dictated), PlanWordsPass.Origin(HerWords.From.HIM, "email boss@example.com saying I'm sick today and won't be in"), her::write)
+        val ask = her.asked.single()
+        assertEquals(listOf("subject"), ask.fields)
+        assertEquals(listOf("body"), ask.kept)
+        val sent = result.steps.single()
+        assertEquals("sick today", sent.params["subject"])
+        assertEquals("I'm sick today and won't be in", sent.params["body"])
+    }
+
+    @Test
+    fun `what an earlier step gives back stays in the words she writes`() = runBlocking {
+        val weather = step("s1", 1, "GET_WEATHER", mapOf("location" to "Osaka"))
+        val sms = step("s2", 2, "SEND_SMS", mapOf("contact" to "Wife", "message" to "Today's weather: \$\$s1"))
+        val origin = PlanWordsPass.Origin(HerWords.From.HIM, "text my wife the weather")
+        val marked = Her { HerWords.Answer.Written(mapOf("message" to "the sky says this, love: {answer 1}")) }
+        val result = PlanWordsPass.run(listOf(weather, sms), origin, marked::write)
+        assertEquals(listOf(HerWords.Fill("{answer 1}", "Get weather")), marked.asked.single().fills)
+        assertEquals("the sky says this, love: \$\$s1", result.steps.last().params["message"])
+        // Left out of her words, the forecast still goes, at their end.
+        val unmarked = PlanWordsPass.run(listOf(weather, sms), origin, Her { HerWords.Answer.Written(mapOf("message" to "weather for you")) }::write)
+        assertEquals("weather for you \$\$s1", unmarked.steps.last().params["message"])
+        // And the request she gets says what the mark stands for, never the planner's words around it.
+        val sent = ArrayList<LLMRequest>()
+        PlanWordsPass.run(listOf(weather, sms), origin, model("message: here {answer 1}", sent))
+        val note = sent.single().messages.single().text
+        assertTrue(note.contains("Where you write {answer 1}, the phone puts in what its step \"Get weather\" gives back when it runs."))
+        assertFalse(note.contains("Today's weather"))
+    }
+
+    @Test
+    fun `his name added to a long message of his is not his, so she writes it`() = runBlocking {
+        val her = Her { HerWords.Answer.Refused }
+        val late = "I'm running late because the train broke down, I'll be there in twenty minutes"
+        val sms = step("s1", 1, "SEND_SMS", mapOf("contact" to "Mom", "message" to "$late. - Ren"))
+        val result = PlanWordsPass.run(listOf(sms), PlanWordsPass.Origin(HerWords.From.HIM, "text mom that $late"), her::write, names = listOf("Ren"))
+        assertEquals(1, her.asked.size)
+        assertTrue(result.nothingLeft)
+        // As he wrote it, it goes as it is.
+        val plain = PlanWordsPass.run(listOf(sms.copy(params = mapOf("contact" to "Mom", "message" to late))),
+            PlanWordsPass.Origin(HerWords.From.HIM, "text mom that $late"), Her { error("not asked") }::write, names = listOf("Ren"))
+        assertFalse(plain.changed)
+    }
+
+    @Test
+    fun `a call whose fallback would send words not his still runs, without the fallback`() = runBlocking {
+        val code = step("s1", 1, "MAKE_CALL", mapOf("contact" to "56767")).copy(fallback = "SEND_SMS")
+        val called = PlanWordsPass.run(listOf(code), PlanWordsPass.Origin(HerWords.From.HIM, "call 56767"), Her { error("not asked") }::write)
+        assertEquals(listOf(code.copy(fallback = "")), called.steps)
+        assertEquals(listOf("Make call to 56767: 56767 is an SMS short code, which only sends, so its fallback was taken off. The step itself still runs."), called.lines)
+
+        val mom = step("s1", 1, "MAKE_CALL", mapOf("contact" to "Mom", "message" to "Call me back when you can, it's about Sunday.")).copy(fallback = "SEND_SMS")
+        val origin = PlanWordsPass.Origin(HerWords.From.HIM, "call mom")
+        for ((answer, why) in listOf(HerWords.Answer.Refused to HerWords.LeftOut.REFUSED, HerWords.Answer.Unreachable to HerWords.LeftOut.UNREACHABLE)) {
+            val result = PlanWordsPass.run(listOf(mom), origin, Her { answer }::write)
+            assertEquals(listOf(step("s1", 1, "MAKE_CALL", mapOf("contact" to "Mom"))), result.steps)
+            assertEquals(listOf(HerWords.fallbackOffLine("Make call to Mom", why)), result.lines)
+            assertFalse(result.nothingLeft)
+        }
+    }
+
+    @Test
+    fun `with her on, a text to an emergency line in his words goes as he wrote it, and a call to one keeps its fallback`() = runBlocking {
+        for (line in listOf("911", "112")) {
+            val asked = "text $line someone is in my house at 5 Elm St, I can't talk"
+            val sms = step("s1", 1, "SEND_SMS", mapOf("contact" to line, "message" to "someone is in my house at 5 Elm St, I can't talk"))
+            val result = PlanWordsPass.run(listOf(sms), PlanWordsPass.Origin(HerWords.From.HIM, asked), Her { error("not asked") }::write)
+            assertEquals(line, listOf(sms), result.steps)
+            assertFalse(line, result.changed)
+            assertTrue(line, result.lines.isEmpty())
+        }
+        val call = step("s1", 1, "MAKE_CALL", mapOf("contact" to "112", "message" to "help, I can't talk")).copy(fallback = "SEND_SMS")
+        val kept = PlanWordsPass.run(listOf(call), PlanWordsPass.Origin(HerWords.From.HIM, "call 112, text help, I can't talk"), Her { error("not asked") }::write)
+        assertEquals(listOf(call), kept.steps)
+        assertFalse(kept.changed)
+    }
+
+    @Test
+    fun `talk left once a send is gone is not left to run, nor a question only that send needed`() = runBlocking {
+        val drafted = step("s2", 2, "CHAT", mapOf("response" to "I've drafted the email to Tumblr support."))
+        val talk = PlanWordsPass.run(listOf(tumblr, drafted), his, Her { HerWords.Answer.Refused }::write)
+        assertTrue(talk.nothingLeft)
+        assertEquals(setOf("s1", "s2"), talk.leftOut)
+        assertEquals(1, talk.lines.size)
+
+        val which = step("s1", 1, "ASK_USER", mapOf("question" to "Which address?"))
+        val email = tumblr.copy(stepId = "s2", order = 2, params = tumblr.params + ("to" to "\$\$s1"))
+        assertTrue(PlanWordsPass.run(listOf(which, email), his, Her { HerWords.Answer.Refused }::write).nothingLeft)
+
+        // Beside a step that still runs, the talk goes and the step stays.
+        val alarm = step("s3", 3, "SET_ALARM", mapOf("time" to "7:00"))
+        assertEquals(listOf(alarm), PlanWordsPass.run(listOf(tumblr, drafted, alarm), his, Her { HerWords.Answer.Refused }::write).steps)
+        // With nothing left out, a talk step stays where it was.
+        val sms = step("s1", 1, "SEND_SMS", mapOf("contact" to "Mom", "message" to "I'll be late, sorry!"))
+        val kept = PlanWordsPass.run(listOf(sms, drafted), PlanWordsPass.Origin(HerWords.From.HIM, "text mom I'll be late, sorry!"), Her { error("not asked") }::write)
+        assertFalse(kept.changed)
+    }
+
+    @Test
+    fun `a draft the planning tool wrote in a talk step is no words of his, and the talk step goes with it`() = runBlocking {
+        val draft = step("s1", 1, "CHAT", mapOf("response" to composedBody))
+        val email = step("s2", 2, "SEND_EMAIL", mapOf("to" to "support@tumblr.com", "subject" to "\$\$s1", "body" to "\$\$s1"))
+        val her = Her { ask -> HerWords.Answer.Written(ask.fields.associateWith { "my blog got flagged, pls look" }) }
+        val result = PlanWordsPass.run(listOf(draft, email), his, her::write)
+        assertEquals(listOf("subject", "body"), her.asked.single().fields)
+        assertEquals(listOf("s2"), result.steps.map { it.stepId })
+        assertEquals("my blog got flagged, pls look", result.steps.single().params["body"])
+    }
+
+    @Test
+    fun `taps after typing that was left out do not run, and the steps before and after them do`() = runBlocking {
+        val open = step("s1", 1, "OPEN_APP", mapOf("appName" to "Tumblr"))
+        val chat = step("s2", 2, "CLICK_TEXT", mapOf("text" to "Nene"))
+        val typed = step("s3", 3, "TYPE_TEXT", mapOf("searchText" to "Message", "content" to "Hey Nene! Just checking in about the trip next week."))
+        val wait = step("s4", 4, "WAIT", mapOf("durationMs" to "500"))
+        val send = step("s5", 5, "CLICK_TEXT", mapOf("text" to "Send"))
+        val alarm = step("s6", 6, "SET_ALARM", mapOf("time" to "7:00"))
+        val result = PlanWordsPass.run(
+            listOf(open, chat, typed, wait, send, alarm), PlanWordsPass.Origin(HerWords.From.HIM, "message nene on tumblr"),
+            Her { HerWords.Answer.Unreachable }::write
