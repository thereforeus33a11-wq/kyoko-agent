+        assertEquals(his, index.pictures.filterNot { it.made })
+        assertEquals(PersonaPictureRules.MAX_MADE, index.pictures.count { it.made })
+        assertEquals(listOf("m1", "m2"), pushedOut.map { it.id })
+        // Read back, the limits hold the same way.
+        val read = PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(index))
+        assertEquals(index.pictures.map { it.id }, read.pictures.map { it.id })
+    }
+
+    @Test
+    fun `she is told which pictures she made, after his`() {
+        val captions = PersonaPictureRules.captions(
+            listOf(picture("m", "rooftop", made = true), picture("h", "platform"), picture("m2", "curb", made = true))
+        )
