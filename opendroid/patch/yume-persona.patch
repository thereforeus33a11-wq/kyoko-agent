+            val request = LLMRequest(
+                systemPrompt = PersonaPrompts.fillOwner(card.trim(), ownerName) + "\n\n" +
+                    PersonaPrompts.OWN_PICTURE_HEADING + "\n- " + PersonaPrompts.OWN_PICTURE_LINE,
+                messages = listOf(
+                    ChatMessage(
