+
+        viewModel.updatePersonaOwnLife(true)
+        viewModel.updatePersonaOwnCallsPerDay(250)
+        viewModel.updatePersonaOutingMaxMinutes(30)
+        viewModel.updatePersonaOutingMaxSteps(4)
+        viewModel.updatePersonaOutingsAsk(true)
+        viewModel.updatePersonaReads(false)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.YAHOO_ENTERTAINMENT.id, removed = true)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.GOOGLE_NEWS_WORLD.id, removed = true)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.GOOGLE_NEWS_WORLD.id, removed = false)
+        assertTrue(viewModel.addPersonaYouTubeChannel(CHANNEL, "Gyaru TV"))
