+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.apiKeyFor
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.personaOwnTimeKey
+
+/**
+ * New pictures of herself, made by her. What she says is to be different (a place, a pose,
+ * what she wears, how much of it) is drawn as a new picture in her look on a Venice image
+ * model ([PictureModels.generateModelOf], [PicturePrompts.generate]); then, where he left it
+ * on, the new picture is matched to her own pictures so it is her face, her hair, her metal
+ * ([PicturePrompts.match]). A small change to one picture she names is an edit of that
+ * picture ([PicturePrompts.edit]). Every picture that comes back is age-checked before it is
+ * shown or kept ([MadePictureCheck], [SelfPictureMaker]); the ones that pass are kept with the
+ * others ([PersonaPictures.addMade]), and she can see and name them like any picture of herself.
+ *
+ * What leaves the phone for it is the text built here and in [PicturePrompts] (her look as
+ * her picture file fixes it, the adult guard, and her own words about the change) and, for a
+ * change or a match, pictures of her. Nothing of his goes into it: his name is taken out of
+ * her words, and words that hold his details are not sent at all. The models are Venice's
+ * Private tier (no prompt or picture kept), set in [LLMConfig.personaPictureModel] and
+ * [LLMConfig.personaPictureEditModel].
+ *
+ * Everything but the requests themselves ([VeniceImages]) is a decision about text, and is
+ * here so it can be read and tested without a phone.
+ */
+object PersonaSelfPictures {
+
+    /** The host her pictures are made on. Its key is the one his Venice provider already holds. */
+    const val HOST = "api.venice.ai"
+
+    /** Her own words about the change, at most. */
+    const val MAX_ASK_CHARS = 500
+
+    /** The heading of the section of her picture file that fixes how she looks. */
+    const val LOOK_HEADING = "After-state prompt lock"
+
+    /**
+     * Words that ask for the girl she was before, for her younger than she is or childlike,
+     * or for a school: those are not made. The before girl is never put in a picture of this
+     * kind, she is never drawn younger than the 19 she is, and never in a school uniform or a
+     * school setting (canon). "Young" itself is no such word: she is a young woman, and a
+     * young-looking 19 is her. "A minor change" is no minor; "old school" is no school.
+     */
+    private val NOT_MADE = Regex(
+        """(?i)\b(?:satomi|before (?:state|picture|look|girl|me)|the old me|old self|round glasses|glasses on|""" +
+            """sweater vest|navy vest|red bow|long (?:navy )?skirt|backpack|""" +
+            // Any school, of any age, but "old school": schoolgirl, schoolyard, preschool, after school.
+            """(?<!old )(?<!old-)\w*school\w*|""" +
+            """(?:sailor|student|gym) (?:uniform|suit|outfit|clothes)|serafuku|seifuku|sailor ?fuku|gym class|""" +
+            """sailor (?:collar|top|dress)|randoseru|classroom|homeroom|kindergarten|day ?care|""" +
+            """students?(?<!university students?)(?<!college students?)|""" +
+            """child\w*|kid|kids|kid-?like|little girls?|young girls?|very young|loli\w*|shota\w*|mesugaki|chibi|""" +
+            """underage\w*|under-?aged?|prepubescent|pubescent|""" +
+            """teen|teens|teenage|teenager|teenagers|teenaged|preteens?|tweens?|jailbait|barely legal|""" +
+            """(?:as|like|looking like|look like) a minor|minors|toddler|infant|baby ?faced?|aged? down|de-?aged?|age regression|""" +
+            """younger|elementary|junior[ -]?high|""" +
+            // A teen's age spelled out, anywhere: "sixteen".
+            """thirteen|fourteen|fifteen|sixteen|seventeen)\b|""" +
+            // An age under 18 said plainly: "she is 15", "she's 16.", "age: 16", "looks like 15", "a girl of 15".
+            // Not a time or an amount: "at 5 am", "is 5 minutes".
+            """(?i)\b(?:is|was|aged?|age\s*[:=]|age of|she['’]?s|i['’]?m|looks?(?:\s+like)?|appears?(?:\s+to\s+be)?|""" +
+            """seems?(?:\s+to\s+be)?|(?:girl|woman|she|her) of)\s*(?:[1-9]|1[0-7])""" +
+            """(?!\d|[:.,]\d|\s*(?:am|pm|a\.m|p\.m|o['’]?clock|%|min|mins|minutes|hours?|h|cm|kg|m)\b)|""" +
+            // "15 y.o.", "15yo", "15 y/o", "16-year-old", "15 years old".
+            """(?i)\b(?:[1-9]|1[0-7])\s?-?\s?(?:y\s?[./]?\s?o(?![a-z])|yrs?(?![a-z])|years?[ -]old(?!er)|year-old)|""" +
+            // The same with the age spelled: "ten years old", "a twelve-year-old"; "aged twelve"; "she is ten."
+            """(?i)\b(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)[ -](?:years?[ -]old(?!er)|year-old|y/?o\b)|""" +
+            """(?i)\b(?:aged?|age of)\s+(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\b|""" +
+            """(?i)\b(?:is|was|she['’]?s|i['’]?m|looks?(?:\s+like)?)\s+(?:two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)""" +
+            """(?=\s*(?:[.,;!?]|$|and\b|now\b|here\b|again\b))|""" +
+            """(?<![A-Za-z0-9])(?-i:JK)(?![A-Za-z0-9])|制服|セーラー|学生服|女子高生|中学生|高校生|小学生|ランドセル|ロリ|子供|子ども|幼い|幼女|少女|""" +
+            """児童|女児|園児|幼稚園|保育園|学校|教室|メスガキ"""
+    )
+
+    /** Why [ask] is not made, or null when it may be. */
+    fun refusal(ask: String): String? {
+        if (ask.isBlank()) return "Nothing was said about what the picture should show."
+        return refusalOfWords(ask)
+    }
+
+    /**
+     * Why words that pick or describe a picture of her rule it out, or null. Blank words rule
+     * nothing out. Besides the words above, an age under 18, a school year or a school marker
+     * in them ([KidGuard.flag], read as the opening of a text) rules it out too.
+     */
+    fun refusalOfWords(words: String?): String? =
+        if (words != null && (NOT_MADE.containsMatchIn(words) || com.opendroid.ai.core.life.KidGuard.flag("", words) != null)) {
+            NOT_MADE_WHY
+        } else {
+            null
+        }
+
+    /** What she and he are told when words rule a picture out. */
+    const val NOT_MADE_WHY =
+        "Not made: a picture of her is always of her now, an adult, never of the girl before, never younger or childlike, and never in a school uniform or at a school."
+
+    /**
+     * Whether a picture may be made where [config] stands: switched on, with a Venice key,
+     * and not on a privacy setting that keeps everything on his own hardware. Asked by the
+     * action and by her prompt alike, so she is told she can only where she can.
+     */
+    fun allowed(config: LLMConfig): Boolean =
+        config.personaMakesPictures && config.routePolicy != com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE &&
+            veniceKey(config) != null
+
+    /** Why no picture may be made where [config] stands, or null when one may. */
+    fun notAllowed(config: LLMConfig): String? = when {
+        !config.personaMakesPictures -> "Making pictures of her is switched off in Settings, Persona."
+        config.routePolicy == com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE ->
+            "Not made: the privacy setting keeps every model on your own hardware, and pictures are made on Venice."
+        veniceKey(config) == null -> "No Venice key is set, so no picture can be made."
+        else -> null
+    }
+
+    /** Words that make a note of hers about herself one about how she looks. */
+    private val LOOK_WORDS = Regex(
+        """(?i)\b(?:hair|dye[ds]?|dyed|bleach\w*|roots|fringe|bangs|ahoge|tan|tanned|skin|nails?|lashes|liner|make-?up|lipstick|gloss|""" +
+            """piercings?|pierced|hoops?|stud|barbell|tattoos?|ink|outfit|wear(?:s|ing)?|wore|skirt|shirt|bandeau|boots|heels|""" +
+            """choker|cuffs|stockings|thigh-?highs|colou?r|look|style|eyes|brows?)\b"""
+    )
+
+    /** The most of her own words about her look that go into a picture's prompt: whole notes only, never one cut. */
+    const val MAX_LOOK_NOW_CHARS = PicturePrompts.MAX_LOOK_NOW_CHARS
+
+    /**
+     * A note of hers that never goes into a picture's prompt, whatever else it says: any
+     * school or uniform at all ("my old school shirt" too), since her look notes go into every
+     * picture of her.
+     */
+    private val NOT_IN_LOOK = Regex("""(?i)school|uniform|制服|学校""")
+
+    /**
+     * How she looks now in her own words: her notes about herself that are about her
+     * look, newest first, as many whole notes as fit. A note that speaks of him, a street
+     * story and a note about anything else stay out: only her look goes to the image model.
+     * A note that holds a word a picture of her is never made with ([refusalOfWords]: the
+     * girl before, younger, a child, a teen, a school, a uniform) stays out too, so that her
+     * own words never carry one into a picture.
+     */
+    fun lookNow(notes: List<PersonaNotes.Note>, ownerName: String): String {
+        val lines = ArrayList<String>()
+        var used = 0
+        for (note in notes) {
+            if (note.kind != PersonaNotes.Kind.ME || note.isStreetStory || PersonaNotes.canBeAboutHim(note, ownerName)) continue
+            if (!LOOK_WORDS.containsMatchIn(note.text)) continue
+            if (refusalOfWords(note.text) != null || NOT_IN_LOOK.containsMatchIn(note.text)) continue
+            val text = withoutHim(note.text, ownerName).trimEnd('.')
+            if (used + text.length + 2 > MAX_LOOK_NOW_CHARS) continue
+            lines += text
+            used += text.length + 2
+        }
+        return lines.joinToString("; ")
+    }
+
+    /**
+     * [ask] without his name, in any case: the whole name first, then every part of it of
+     * two letters or more, each on its own. Cut to [MAX_ASK_CHARS].
+     */
+    fun withoutHim(ask: String, ownerName: String): String {
+        var text = ask.replace(Regex("""\s+"""), " ").trim()
+        for (pattern in hisNamePatterns(ownerName)) text = pattern.replace(text, "him")
+        return if (text.length > MAX_ASK_CHARS) text.take(MAX_ASK_CHARS).trimEnd() else text
+    }
+
+    /**
+     * Whether [text] holds his name or a part of it, by the rule [withoutHim] takes them
+     * out by. The check on what leaves the phone from her own space uses it
+     * ([com.opendroid.ai.core.life.OutgoingGuard]).
+     */
+    fun holdsHisName(text: String, ownerName: String): Boolean =
+        hisNamePatterns(ownerName).any { it.containsMatchIn(text) }
+
+    /** His whole name, then every part of it of two letters or more, each as a whole word in any case. */
+    private fun hisNamePatterns(ownerName: String): List<Regex> {
+        val name = ownerName.trim()
+        val parts = listOf(name) + name.split(Regex("""[^\p{L}\p{N}]+""")).filter { it.length >= 2 }
+        return parts.filter { it.length >= 2 }.distinct().map { part ->
+            Regex("""(?i)(?<![\p{L}\p{N}])${Regex.escape(part)}(?![\p{L}\p{N}])""")
+        }
+    }
+
+    /** A run of digits as long as a phone number, a street number with a postcode, a date of birth. */
+    private val LONG_NUMBER = Regex("""\d[\d\s().-]{4,}\d""")
+
+    /** An address on the net. */
+    private val ADDRESS = Regex("""(?i)[\w.+-]+@[\w-]+\.\w|https?://|www\.""")
+
+    /**
+     * Why [words] would carry something of his to the image model, or null. They do when
+     * they repeat what her notes about him say ([hisNotes]: what she knows about him and
+     * where the two of them stand), or hold a long number or an address. Her words are
+     * then not sent at all: what is his never leaves the phone for a picture.
+     */
+    fun carriesHisDetails(words: String, hisNotes: String): String? = when {
+        LONG_NUMBER.containsMatchIn(words) || ADDRESS.containsMatchIn(words) ->
+            "Not made: what the picture should show holds a number or an address, and nothing like that goes out with a picture."
+        repeatsHisNotes(words, hisNotes) ->
+            "Not made: what the picture should show repeats what her notes say about you, and that stays on the phone."
+        else -> null
+    }
+
+    /**
+     * Whether [words] repeat what her notes about him say ([hisNotes]): a number, an
+     * address or a handle that stands there, or most of their words. Shared with the check
+     * on what leaves the phone from her own space ([com.opendroid.ai.core.life.OutgoingGuard]).
+     */
+    fun repeatsHisNotes(words: String, hisNotes: String): Boolean =
+        hisNotes.isNotBlank() && PersonaActions.echoesOutsideText(words, hisNotes)
+
+    /**
+     * The section of her picture file that fixes her look, from the file's raw text, or
+     * an empty text when the file has none.
+     */
+    fun look(picturesFile: String): String {
+        val lines = picturesFile.lines()
+        val start = lines.indexOfFirst { it.trim().removePrefix("##").trim().startsWith(LOOK_HEADING, ignoreCase = true) }
+        if (start < 0) return ""
+        return lines.drop(start + 1).takeWhile { !it.trimStart().startsWith("#") }
+            .joinToString(" ") { it.trim() }.replace(Regex("""\s+"""), " ").trim()
+    }
+
+    /**
+     * One side of her in a full-body reference: the views a turnaround is made of, so
+     * that clothes, hair, piercings and tattoos can be worked out on her body later.
+     */
+    enum class View(val word: String, val shot: String) {
+        FRONT("front", "seen straight from the front, facing the camera"),
+        BACK("back", "seen straight from behind, her back to the camera; what is only on her front (the tally on the front of her right thigh, her face) is not seen"),
+        LEFT("left side", "seen from her left side in full profile, facing to the left of the picture"),
+        RIGHT("right side", "seen from her right side in full profile, facing to the right of the picture")
+    }
+
+    /**
+     * The views asked for in [words] ("front, back", "left", "all sides", "turnaround"),
+     * in the order front, back, left, right. Empty when [words] ask for none, and then
+     * the picture is an ordinary one.
+     */
+    fun views(words: String?): List<View> {
+        val asked = words?.lowercase()?.trim().orEmpty()
+        if (asked.isEmpty()) return emptyList()
+        if (Regex("""\b(?:all|every|turn-?around|reference sheet|all sides|four)\b""").containsMatchIn(asked)) return View.entries.toList()
+        return View.entries.filter { view ->
+            when (view) {
+                View.FRONT -> Regex("""\bfront\b""").containsMatchIn(asked)
+                View.BACK -> Regex("""\b(?:back|behind|rear)\b""").containsMatchIn(asked)
+                View.LEFT -> Regex("""\bleft\b""").containsMatchIn(asked) || (Regex("""\bsides?\b""").containsMatchIn(asked) && !Regex("""\bright\b""").containsMatchIn(asked))
+                View.RIGHT -> Regex("""\bright\b""").containsMatchIn(asked) || (Regex("""\bsides?\b""").containsMatchIn(asked) && !Regex("""\bleft\b""").containsMatchIn(asked))
+            }
+        }
+    }
+
+    /** What a body reference shows when nothing else is asked: all of her, nothing in the way. Positive words only. */
+    const val BARE_REFERENCE =
+        "she wears nothing at all and is barefoot, her hands empty, so her whole body can be seen as it is, to design clothes on later; her piercings stay where they are"
+
+    /** How the caption of a picture of one view of her opens. */
+    const val REFERENCE_CAPTION_START = "body reference, "
+
+    /** The caption a picture of one view is kept with. */
+    fun referenceCaption(view: View, ask: String): String =
+        REFERENCE_CAPTION_START + "${view.word} view" + ask.trim().trimEnd('.').takeIf { it.isNotEmpty() }?.let { ": $it" }.orEmpty()
+
+    /**
+     * The caption a small change to a picture of hers is kept with: what that picture is, then
+     * the change ("on the stairs smoking, red nails instead of blue"), so that she and a later
+     * `from` can still tell what it is.
+     */
+    fun changeCaption(from: String, ask: String): String =
+        PersonaPictureRules.fitCaption(from.replace(Regex("""\s+"""), " ").trim().trimEnd('.') + ", " + caption(ask))
+
+    /** A caption that says a picture holds more than her alone: a comic, panels, a before and after. Never a picture to start from. */
+    private val MORE_THAN_HER = Regex(
+        """(?i)\b(?:comic|manga page|panels?|before (?:and|&|/|-) ?after|before-after|collage|side by side|with (?:him|someone|friends?|others))\b"""
+    )
+
+    /** Her pictures that may stand for her: of herself, of her now, and her alone by their captions. */
+    private fun usable(pictures: List<PersonaPicture>): List<PersonaPicture> =
+        pictures.filter { it.kind == PersonaPicture.Kind.SELF && refusalOfWords(it.caption) == null && !MORE_THAN_HER.containsMatchIn(it.caption) }
+
+    /**
+     * The pictures of hers an image model may be given to work from: her originals and masters
+     * ([PictureSources.sources]) that may also stand for her by their captions, so of her now
+     * and her alone. A picture captioned as the girl before, as her younger, at a school, or with
+     * someone else in it is never one, whatever its provenance. Every pick of a picture to send
+     * (the match, the picture a change or a reference sheet starts from) is made from these.
+     */
+    fun bases(pictures: List<PersonaPicture>): List<PersonaPicture> = PictureSources.sources(usable(pictures))
+
+    /**
+     * The picture a new one starts from. [from] are her words about which one ("the one
+     * on the stairs"); the picture whose caption shares most words with them is taken.
+     * Without such words, or when none shares any, the first picture he added is taken:
+     * his pictures are her likeness, and a picture made from a made one drifts.
+     * Null when she has no picture of herself at all.
+     *
+     * This says whether she has a picture of herself to start from at all. What an image
+     * model is given to work from is only ever an original or a master ([references],
+     * [editStart], [PictureSources]).
+     */
+    fun base(pictures: List<PersonaPicture>, from: String?): PersonaPicture? {
+        // A picture whose caption names the girl before, her younger, or more than her alone is never started from.
+        val self = usable(pictures)
+        if (self.isEmpty()) return null
+        named(self, from)?.let { return it }
+        return self.firstOrNull { !it.made } ?: self.first()
+    }
+
+    /**
+     * The picture [from] names by its caption ("the one on the stairs"), or null when
+     * [from] is blank or shares no word with any caption. That picture is the one a small
+     * change is made to.
+     */
+    fun named(pictures: List<PersonaPicture>, from: String?): PersonaPicture? {
+        val wanted = from?.let(PersonaLibraryText::terms).orEmpty()
+        if (wanted.isEmpty()) return null
+        val self = usable(pictures)
+        val best = self.maxByOrNull { picture -> PersonaLibraryText.terms(picture.caption).count { it in wanted } } ?: return null
+        return best.takeIf { PersonaLibraryText.terms(it.caption).any { term -> term in wanted } }
+    }
+
+    private val PLATE_WORDS = Regex("""(?i)\b(?:front|full[ -]?body|plate|standing|whole)\b""")
+    private val FACE_WORDS = Regex("""(?i)\b(?:face|close[ -]?up|portrait|headshot)\b""")
+
+    /** Words of a picture's side ([PersonaPicture.view]) that say it is not seen from the front, and that it is seen from behind. */
+    private val NOT_FRONT = Regex("""(?i)\b(?:back|behind|rear|side|profile|left|right|three[ -]?quarter)\b""")
+    private val FROM_BEHIND = Regex("""(?i)\b(?:back|behind|rear)\b""")
+
+    /**
+     * The pictures of hers that a new picture is matched to ([PicturePrompts.match]): up to
+     * [max] of her originals and masters, never a derived one ([PictureSources]): a picture
+     * made from a made one drifts. Not a reference sheet in the plain base layer: the match
+     * carries her outfit over from these. A full-body front one first and a face one next where
+     * the side it shows or its caption says so; then the others; then a face from the side, a
+     * body from the side, and one seen from behind last. Among pictures of the same place, those
+     * that came with the app come first, the newest set first ([newestBundledFirst]); the rest
+     * in the order they were added.
+     */
+    fun references(pictures: List<PersonaPicture>, max: Int = PictureModels.MATCH_IMAGES - 1): List<PersonaPicture> {
+        // A sheet in the plain base layer is her, but not in what she wears: the match carries her outfit over.
+        val bases = bases(pictures).filterNot { it.sheetLook == ReferenceSheets.Look.BASE_LAYER.name }
+        val ranked = bases.sortedWith(compareBy<PersonaPicture> { picture ->
+            val words = picture.view + " " + picture.caption
+            val side = picture.view.isNotEmpty() && NOT_FRONT.containsMatchIn(picture.view)
+            when {
+                picture.view.isNotEmpty() && FROM_BEHIND.containsMatchIn(picture.view) -> 5
+                side && FACE_WORDS.containsMatchIn(words) -> 3
+                side -> 4
+                PLATE_WORDS.containsMatchIn(words) && !FACE_WORDS.containsMatchIn(words) -> 0
+                FACE_WORDS.containsMatchIn(words) -> 1
+                PLATE_WORDS.containsMatchIn(words) -> 0
+                else -> 2
+            }
+        }.then(newestBundledFirst))
+        return ranked.take(max.coerceAtLeast(0))
+    }
+
+    /**
+     * An order between two of her pictures that are otherwise as good as each other: one that
+     * came with the app before one that did not, and of those the one put in last first. A
+     * newer build brings a newer set; where one of the earlier set is still a base (he approved
+     * it), the newer one is still taken before it. Pictures that did not come with the app keep
+     * the order they were added in.
+     */
+    val newestBundledFirst: Comparator<PersonaPicture> =
+        compareByDescending<PersonaPicture> { it.origin == PersonaPicture.Origin.BUNDLED }
+            .thenByDescending { if (it.origin == PersonaPicture.Origin.BUNDLED) it.addedAt else 0L }
+
+    /**
+     * The picture an edit model starts from where none is named ("Try picture models"): her
+     * first original, else her first master. Never a derived one. Null when she has neither.
+     */
+    fun editStart(pictures: List<PersonaPicture>): PersonaPicture? {
+        val bases = bases(pictures)
+        return bases.firstOrNull { it.provenance == PersonaPicture.Provenance.ORIGINAL } ?: bases.firstOrNull()
+    }
+
+    /**
+     * What she and he are told when the picture she names for a small change is a derived one:
+     * a change is an edit of the picture it starts from, and only an original or a master is
+     * ever started from.
+     */
+    const val NOT_A_BASE_WHY =
+        "Not made: that picture was made by a model, and a change only ever starts from an original or a master of her, so that her look does not drift. A new picture of it can be asked for instead."
+
+    /**
+     * The key his Venice provider holds: the key of the provider whose address is on
+     * [HOST]. Null when he has none there, and then no picture is made.
+     */
+    /**
+     * The key a picture of hers goes out with: in her own time ([ownTime], a call of hers
+     * under an [com.opendroid.ai.core.life.OwnCall]) her own-time key where he set one, so
+     * that its spending limit stands behind it; else his Venice provider's key ([veniceKey]).
+     * Either goes to [HOST] only.
+     */
+    fun keyFor(config: LLMConfig, ownTime: Boolean): String? =
+        (if (ownTime) config.personaOwnTimeKey.trim().takeIf { it.isNotEmpty() } else null) ?: veniceKey(config)
+
+    /**
+     * The key of his provider that points at [HOST], and only when that key belongs to it
+     * ([apiKeyFor]): a key he typed for another host is never sent to Venice.
+     */
+    fun veniceKey(config: LLMConfig): String? =
+        config.customEndpoints.entries
+            .firstOrNull { (_, url) -> RouteClassifier.hostOf(url) == HOST }
+            ?.let { (provider, url) -> config.apiKeyFor(provider, url) }
+            ?.trim()
+            ?.takeIf { it.isNotEmpty() }
+
+    /** How the result of a picture she made opens. The id after it names the picture in her store. */
+    const val MADE_PREFIX = "Made a new picture of her (picture "
+
+    private val MADE_LINE = Regex(Regex.escape(MADE_PREFIX) + """([A-Za-z0-9-]{1,80})\): ?([^\n]*)""")
+
+    /** The ids of the pictures a row says she made, in the order it names them. */
+    fun madePictureIds(text: String?): List<String> =
+        text?.let { MADE_LINE.findAll(it).map { match -> match.groupValues[1] }.toList() }.orEmpty()
+
+    /** The captions of the pictures a row says she made: her own words about each. */
+    fun madePictureCaptions(text: String?): List<String> =
+        text?.let { MADE_LINE.findAll(it).map { match -> match.groupValues[2].trim() }.filter { c -> c.isNotEmpty() }.toList() }.orEmpty()
+
+    /** [text] as it is shown under those pictures: without the ids, which mean nothing to him. */
+    fun shownWithoutIds(text: String): String =
+        MADE_LINE.replace(text) { match -> "Made a new picture of her: " + match.groupValues[2] }
+
+    /**
+     * The line a kept picture is told in: its id and its caption on one line (a caption she
+     * said in two lines is read as one), then the note for him where there is one.
+     */
+    fun keptLine(id: String, caption: String, note: String): String =
+        "$MADE_PREFIX$id): ${caption.replace(Regex("""\s*\n\s*"""), " ").trim()}" + note.takeIf { it.isNotEmpty() }?.let { "\n$it" }.orEmpty()
+
+    /**
+     * [text] as her line about it is held to ([shownWithoutIds]), without the notes that are
+     * for him and are no part of a picture: that it was not matched to her own pictures. The
+     * exact row keeps them.
+     */
+    fun heardOf(text: String): String =
+        shownWithoutIds(text).lines().filterNot { it.trimStart().startsWith(SelfPictureMaker.NOT_MATCHED_PREFIX) }.joinToString("\n")
+
+    /** The caption a picture she made is kept with: her words about it. */
+    fun caption(ask: String): String = ask.replace(Regex("""\s+"""), " ").trim().trimEnd('.')
+}
