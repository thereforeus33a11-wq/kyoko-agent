diff --git a/app/src/test/java/com/opendroid/ai/core/security/LogPrivacyTest.kt b/app/src/test/java/com/opendroid/ai/core/security/LogPrivacyTest.kt
new file mode 100644
index 0000000..f0b3230
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/security/LogPrivacyTest.kt
@@ -0,0 +1,125 @@
+package com.opendroid.ai.core.security
+
+import java.io.File
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Logcat is readable over adb and travels with every bug report. Who wrote to the owner,
+ * what they wrote, his contacts' names and numbers, the replies sent for him and the text
+ * of a plan do not belong in it: log lines carry counts, lengths, kinds and package names
+ * instead.
+ *
+ * This reads the main sources and fails when a log statement prints one of the values
+ * that used to be printed. It is a tripwire for the known shapes, not a proof.
+ */
+class LogPrivacyTest {
+
+    // The size of a value says nothing about its content and may be logged.
+    private val personalValue = Regex(
+        """\$\{?[A-Za-z0-9_.?]*\b(contactName|phoneNumber|replyText|messageText|contactKey|query)\b(?!\??\.(length|size)\b)"""
+    )
+    private val notificationField = Regex(
+        """\$\{(entity|savedEntity|notification)\.(title|text)\b(?!\??\.(length|size)\b)"""
+    )
+    private val contactField = Regex("""\$\{(c|contact|current|allMatches\.first\(\)|exactMatches\.first\(\))\.(name|phoneNumber)\}""")
+
+    // What a failed step says went wrong is written from the step's own values, so it can
+    // name a contact or quote a message.
+    private val stepError = Regex("""\b(rawError|step\.error|actionResult\.error)\b(?!\??\.(length|size)\b)""")
+
+    // A parser's message quotes what it could not read: a plan, a list of contacts.
+    private val parserMessage = Regex("""(?i)\bpars(e|ing)\b.*\$\{?\w+\.(message|localizedMessage)\b""")
+
+    private val logCall = Regex("""\bLog\.[vdiwe]\(""")
+
+    private fun printsPersonalValue(statement: String): Boolean =
+        listOf(personalValue, notificationField, contactField, stepError, parserMessage).any { it.containsMatchIn(statement) }
+
+    /**
+     * The log statement that starts on [lines]`[start]`, through to its closing bracket.
+     * A statement is often broken over a few lines, with the values on the later ones.
+     */
+    private fun logStatement(lines: List<String>, start: Int): String {
+        val statement = StringBuilder()
+        var depth = 0
+        for (index in start until minOf(lines.size, start + MAX_STATEMENT_LINES)) {
+            val line = if (index == start) lines[index].substring(logCall.find(lines[index])!!.range.first) else lines[index]
+            statement.append(line).append(' ')
+            depth += line.count { it == '(' } - line.count { it == ')' }
+            if (depth <= 0) break
+        }
+        return statement.toString()
+    }
+
+    @Test
+    fun `no log line prints a contact, a number, the text of a message or what a parser choked on`() {
+        val root = File("src/main/java/com/opendroid/ai")
+        assertTrue("sources not found at ${root.absolutePath}", root.isDirectory)
+
+        val offending = root.walkTopDown()
+            .filter { it.isFile && it.extension == "kt" }
+            .flatMap { file ->
+                val lines = file.readLines()
+                lines.indices.mapNotNull { index ->
+                    val prints = logCall.containsMatchIn(lines[index]) && printsPersonalValue(logStatement(lines, index))
+                    if (prints) "${file.relativeTo(root).invariantSeparatorsPath}:${index + 1}" else null
+                }
+            }
+            .toList()
+
+        assertTrue("log lines that print personal values: $offending", offending.isEmpty())
+    }
+
+    @Test
+    fun `a log statement is read through to its closing bracket`() {
+        val lines = listOf(
+            """            failedSteps.forEach { step ->""",
+            """                android.util.Log.e("AgentLoop",""",
+            """                    "Step '${'$'}{step.action}' failed: ${'$'}{step.error ?: "unknown"}")""",
+            """            }""",
+            """            val next = describe(${'$'}rawError)"""
+        )
+        val statement = logStatement(lines, 1)
+        assertTrue(statement, statement.contains("step.error"))
+        assertTrue("only the statement itself is read: $statement", !statement.contains("rawError"))
+        assertTrue(printsPersonalValue(statement))
+    }
+
+    @Test
+    fun `the check recognises the shapes it is there to catch`() {
+        val caught = listOf(
+            """Log.d(TAG, "Auto-reply sent to ${'$'}{notification.contactName}: ${'$'}{replyText.take(50)}...")""",
+            """Log.d(TAG, "SMS reply to ${'$'}phoneNumber: ${'$'}outcome")""",
+            """Log.d(TAG, "Saved notification: ${'$'}{entity.appName} — ${'$'}{entity.title}: ${'$'}{entity.text.take(50)}")""",
+            """Log.d(TAG, "    - ${'$'}{c.name} (${'$'}{c.phoneNumber}) score=${'$'}{c.matchScore}")""",
+            """Log.d(TAG, "── Contact Resolution for: '${'$'}query' ──")""",
+            """Log.d("Memory", "Stored contact preference: '${'$'}query' → ${'$'}{contact.name}")""",
+            """android.util.Log.e("AgentLoop", "Action ${'$'}action error: ${'$'}rawError")""",
+            """android.util.Log.e("AgentLoop", "Step '${'$'}{step.action}' failed: ${'$'}{step.error ?: "unknown"}")""",
+            """android.util.Log.w("AgentLoop", "Step failed, fallback succeeded: " + actionResult.error?.let(CrashLogRedactor::redact))""",
+            """android.util.Log.e("AgentLoop", "Failed to parse contact matches: ${'$'}{e.message}")""",
+            """Log.e(TAG, "Parsing the plan failed: ${'$'}{cause.localizedMessage}")"""
+        )
+        for (line in caught) {
+            assertTrue(line, printsPersonalValue(line))
+        }
+        val allowed = listOf(
+            """Log.d(TAG, "Auto-reply sent in ${'$'}{notification.packageName} (${'$'}{replyText.length} chars)")""",
+            """Log.d(TAG, "── Contact Resolution (${'$'}{query.length} chars) ──")""",
+            """Log.d(TAG, "Saved notification from ${'$'}{sbn.packageName} (${'$'}{entity.text.length} chars)")""",
+            """Log.d("Memory", "Stored a contact preference (${'$'}{query.length} chars)")""",
+            """android.util.Log.e("AgentLoop", "Action ${'$'}action error (${'$'}{rawError.length} chars)")""",
+            """android.util.Log.e("AgentLoop", "Step '${'$'}{step.action}' failed (${'$'}{step.error?.length ?: 0} chars of error text)")""",
+            """android.util.Log.e("AgentLoop", "Failed to parse contact matches: ${'$'}{e.javaClass.simpleName}")""",
+            """Log.e(TAG, "Location refresh failed: ${'$'}{e.message}")"""
+        )
+        for (line in allowed) {
+            assertTrue(line, !printsPersonalValue(line))
+        }
+    }
+
+    private companion object {
+        const val MAX_STATEMENT_LINES = 8
+    }
+}
