+    @Test
+    fun `a plan that points at somebody her command did not name is shown to him`() {
+        val decision = decide(
+            PersonaRein.EVERYTHING,
+            actions = listOf("SEND_SMS", "SEND_SMS"),
+            command = "text nene: on my way",
+            planWords = listOf("nene", "on my way", "5550107788", "on my way")
+        )
+        assertEquals(PersonaActions.Start.ASK, decision.start)
+        assertEquals(PersonaActions.Whose.PLAN, decision.whose)
