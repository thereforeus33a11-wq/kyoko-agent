+    private val gson = GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create()
+
+    /** Writes [request] whole, its plain texts and the sizes of their parts, when PROMPT_AUDIT_DIR is set. */
+    private fun dump(case: String, request: Sent) {
+        val dir = System.getenv("PROMPT_AUDIT_DIR")?.takeIf { it.isNotBlank() }?.let(::File) ?: return
+        dir.mkdirs()
+        val params = JsonObject()
+        for ((key, value) in request.body.entrySet()) if (key != "messages") params.add(key, value)
+        val plain = JsonArray().apply {
+            add(JsonObject().apply { addProperty("role", "system"); addProperty("content", request.system) })
+            add(JsonObject().apply { addProperty("role", "user"); addProperty("content", request.user) })
+        }
+        val whole = JsonObject().apply {
+            addProperty("case", case)
+            addProperty("kind", request.kind)
+            addProperty("method", "POST")
+            addProperty("url", "https://api.venice.ai" + request.target)
+            add("headers", gson.toJsonTree(request.headers))
+            add("params", params)
+            add("messages_as_the_enclave_reads_them", plain)
+            addProperty(
+                "messages_on_the_wire",
+                request.body.getAsJsonArray("messages").joinToString(", ") {
+                    it.asJsonObject.get("role").asString + ": " + it.asJsonObject.get("content").asString.length + " chars of ciphertext"
+                }
+            )
+        }
+        File(dir, "$case.json").writeText(gson.toJson(whole))
+        File(dir, "$case.wire.json").writeText(request.wire)
+        File(dir, "$case.system.txt").writeText(request.system)
+        File(dir, "$case.user.txt").writeText(request.user)
+        File(dir, "$case.sizes.txt").writeText(sizes(request))
+    }
+
+    private fun tokens(chars: Int): Int = (chars + 3) / 4
+
+    /** The parts of the system text by its headings, and the user text, in characters and rough tokens (chars / 4). */
+    private fun sizes(request: Sent): String = buildString {
+        val heading = Regex("""(?m)^=== .* ===$""")
+        val system = request.system
+        val starts = heading.findAll(system).map { it.range.first }.toList()
+        val bounds = listOf(0) + starts + system.length
+        append("part".padEnd(72)).append("chars".padStart(8)).append("~tokens".padStart(9)).append('\n')
+        for (i in 0 until bounds.size - 1) {
+            val piece = system.substring(bounds[i], bounds[i + 1])
+            if (piece.isEmpty()) continue
+            val name = if (i == 0) "(card${if (request.kind == "notebook" || request.kind == "sleep") " + pass instructions" else ""})"
+            else piece.lineSequence().first().take(70)
+            append(name.padEnd(72)).append(piece.length.toString().padStart(8)).append(tokens(piece.length).toString().padStart(9)).append('\n')
+        }
+        append("SYSTEM TOTAL".padEnd(72)).append(system.length.toString().padStart(8)).append(tokens(system.length).toString().padStart(9)).append('\n')
+        append("USER TURN".padEnd(72)).append(request.user.length.toString().padStart(8)).append(tokens(request.user.length).toString().padStart(9)).append('\n')
+        val total = system.length + request.user.length
+        append("PROMPT TOTAL".padEnd(72)).append(total.toString().padStart(8)).append(tokens(total).toString().padStart(9)).append('\n')
+    }
+}
