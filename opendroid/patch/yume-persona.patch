+/**
+ * Her ears on the settings card: getting the models (at his tap, over Wi-Fi), deleting them,
+ * and enrolling his voice: he reads three sentences, and only the voiceprint made of them is
+ * kept, sealed ([VoicePrintStore]). Nothing he reads is kept: each take is turned into its
+ * embedding and its measures and let go.
+ */
+@HiltViewModel
+class EarsViewModel @Inject constructor(
+    private val models: EarsModelStore,
+    private val prints: VoicePrintStore,
+    private val hearing: SherpaHearing,
+) : ViewModel() {
+
+    /** Where getting the models for the chosen recogniser stands; null until watched. */
+    var modelStatus by mutableStateOf<EarsModelStore.Status?>(null)
+        private set
+
+    /** What came of the last thing he did here, in a line; empty when nothing. */
+    var notice by mutableStateOf("")
+        private set
+
+    /** Whether his voice is enrolled; null until read. */
+    var enrolled by mutableStateOf<Boolean?>(null)
+        private set
+
+    /** An enrolment under way: the sentence to read, which of the three, and what to do. Null when none is. */
+    var enrolling by mutableStateOf<Enrolling?>(null)
+        private set
+
+    data class Enrolling(val sentence: String, val step: Int, val of: Int, val note: String, val listening: Boolean)
+
+    private var watching: Job? = null
+    private var watched: EarsModels.Recognizer? = null
+    private var enrolment: VoiceEnrolment? = null
+
+    /** Follows the download status for [recognizer]. */
+    fun watch(recognizer: EarsModels.Recognizer) {
+        if (watched == recognizer && watching?.isActive == true) return
+        watched = recognizer
+        watching?.cancel()
+        watching = viewModelScope.launch {
+            models.status(recognizer).collect { modelStatus = it }
+        }
+    }
+
+    fun download(recognizer: EarsModels.Recognizer) {
+        notice = ""
+        models.download(recognizer)
+    }
+
+    fun cancelDownload() = models.cancel()
+
+    /** Deletes every model of her ears from the phone. Her ears stay closed until they are downloaded again. */
+    fun deleteModels() {
+        viewModelScope.launch {
+            notice = if (models.deleteAll()) "The models for her ears are deleted." else "Not every file of her ears' models could be deleted."
+        }
+    }
+
+    fun loadEnrolled() {
+        viewModelScope.launch { enrolled = prints.get() != null }
+    }
+
+    /** Starts his enrolment from its first sentence. */
+    fun startEnrolment() {
+        enrolment?.restart()
+        val e = VoiceEnrolment(EarsModels.SPEAKER.id)
+        enrolment = e
+        enrolling = Enrolling(e.sentence.orEmpty(), 1, e.sentences.size, ENROL_FIRST, listening = false)
+    }
+
+    /**
+     * Listens while he reads the sentence on screen, once. A take that counts moves to the
+     * next sentence; after the third his voiceprint is saved and her ears read it again.
+     */
+    fun readNow() {
+        val e = enrolment ?: return
+        val now = enrolling ?: return
+        if (now.listening) return
+        enrolling = now.copy(listening = true, note = ENROL_LISTENING)
+        viewModelScope.launch {
+            val sample = hearing.takeForEnrolment()
+            if (enrolment !== e) return@launch
+            if (sample == null) {
+                enrolling = now.copy(listening = false, note = ENROL_NO_MIC)
+                return@launch
+            }
+            val took = e.take(sample.embedding, sample.speechMillis, sample.transcript, sample.measure)
+            sample.embedding?.fill(0f)
+            when (took) {
+                is VoiceEnrolment.Take.Again -> enrolling = now.copy(listening = false, note = took.why)
+                is VoiceEnrolment.Take.Kept -> {
+                    val next = took.next
+                    if (next != null) {
+                        enrolling = Enrolling(next, e.step + 1, e.sentences.size, ENROL_NEXT, listening = false)
+                    } else {
+                        val print = e.result()
+                        val saved = print != null && prints.save(print)
+                        e.restart()
+                        enrolment = null
+                        enrolling = null
+                        hearing.printChanged()
+                        enrolled = saved || enrolled == true
+                        notice = if (saved) ENROL_DONE else ENROL_NOT_SAVED
+                    }
+                }
+            }
+        }
+    }
+
+    /** Stops an enrolment; nothing of it is kept. */
+    fun cancelEnrolment() {
+        enrolment?.restart()
+        enrolment = null
+        enrolling = null
+    }
+
+    /** Forgets his voiceprint: every voice that talks to her is taken for his again, and she overhears nothing. */
+    fun forgetVoice() {
+        viewModelScope.launch {
+            prints.forget()
+            hearing.printChanged()
+            enrolled = false
+            notice = "Your voice is forgotten. Every voice that talks to her is taken for yours again, and she overhears nothing."
+        }
+    }
+
+    override fun onCleared() {
+        enrolment?.restart()
+        enrolment = null
+    }
+
+    companion object {
+        const val ENROL_FIRST = "Read the sentence out loud, as you talk, with nobody else talking. Tap READ IT, then read."
+        const val ENROL_LISTENING = "Listening. Read the sentence, then stop."
+        const val ENROL_NEXT = "That one counts. Now this one."
+        const val ENROL_NO_MIC = "The microphone or the models for her ears could not be had. Download the models first, and let the app use the microphone."
+        const val ENROL_DONE = "Your voice is enrolled. Only the voiceprint is kept, sealed on this phone; nothing you read is."
+        const val ENROL_NOT_SAVED = "Your voiceprint could not be saved. Try again."
+    }
+}
