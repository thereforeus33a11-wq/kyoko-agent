+/** Providers whose model id the user may type by hand (endpoint-specific and variant ids). */
+private val HAND_TYPED_MODEL_PROVIDERS = setOf("Custom OpenAI Compatible", "OpenRouter")
+
+/**
+ * Whether a model id that the provider's own list does not contain should be kept.
+ *
+ * Hosted OpenAI-compatible endpoints accept ids their `/models` list never shows: options
+ * written into the id (a suffix that switches reasoning off, a routing variant) and
+ * aliases. Replacing such an id with the first listed model silently changes which model
+ * answers. The provider's untouched seed id is still replaced, as before.
+ */
+internal fun keepsHandTypedModel(provider: String, model: String): Boolean {
+    val canonical = ProviderCatalog.canonicalName(provider)
+    return model.isNotBlank() &&
+        canonical in HAND_TYPED_MODEL_PROVIDERS &&
+        model.trim() != ProviderCatalog.defaultModel(canonical)
+}
