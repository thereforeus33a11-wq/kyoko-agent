+    /** Her `go:` line in a moment: her words as she wrote them, and what the app reads them as ([OutingKind.parse]). */
+    data class Go(val words: String, val parsed: OutingKind.Parsed) {
+        /** The app can start it now. */
+        val runs: Boolean get() = parsed !is OutingKind.Parsed.NotRead
+    }
+
+    /**
+     * What she wrote in a moment of her own, sorted by where each line goes.
+     *
+     * [thoughts] is every line she did not mark, in order, as one text: hers alone.
+     * [said] is all of her `say:` lines as one message to him. [notes] go into her
+     * notebook. [command] is the one command that may be carried out, and [unrun] the
+     * command lines that are not, each with the reason. [wish] is when she wants her
+     * next moment, with [wishText] as she wrote it (null when she named none).
+     * [sleep] is the sleep she lies down to once the moment is over, with [sleepText] as
+     * she wrote it (null when she wrote no `sleep:` line), and [feelings] are the feel
+     * lines she wrote, to be carried past this moment.
+     */
+    data class Moment(
+        val thoughts: String,
+        val said: String,
+        val notes: List<PersonaNotes.Note>,
+        val command: String?,
+        val unrun: List<PersonaActionRows.Unrun>,
+        val wish: Wish?,
+        val wishText: String?,
+        val sleep: PersonaSleep.Ask? = null,
+        val sleepText: String? = null,
+        val feelings: List<PersonaMood.Felt> = emptyList(),
+        /** The marks she put behind her notes in a bracket ([PersonaNotes.markOf]), by storage key. */
+        val marks: Map<String, PersonaNotes.How> = emptyMap(),
+        /** Her last `go:` line, read, while her own life is on; null when she wrote none. */
+        val outing: Go? = null,
+        /** How many `go:` lines came before the last one: they stay thoughts and do not start. */
+        val earlierGoes: Int = 0,
+        /** Her `wonder:` lines, at most [Wonders.PER_MOMENT], while her own life is on. */
+        val wonders: List<Wonders.Line> = emptyList(),
+        /** Lines of hers that were not kept: she came back from meeting a kid, and they read as sexual (§1.4). */
+        val kidLinesDropped: Int = 0
+    ) {
+        /** She wrote a `sleep:` line the app could not read: she stays awake. */
+        val sleepNotRead: Boolean get() = sleepText != null && sleep == null
+
+        /** She let the moment pass: nothing that could be read, or a single full stop. */
+        val passed: Boolean
+            get() = thoughts.isEmpty() && said.isEmpty() && notes.isEmpty() && command == null &&
+                unrun.isEmpty() && wishText == null && sleepText == null && feelings.isEmpty() &&
+                outing == null && wonders.isEmpty()
+
+        /** What she did with it, for the one line her next moment gets about this one. */
+        val did: Did
+            get() = when {
+                said.isNotEmpty() -> Did.SAID
+                passed -> Did.PASSED
+                else -> Did.KEPT
+            }
+    }
