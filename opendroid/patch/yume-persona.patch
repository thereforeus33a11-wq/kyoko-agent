+/** Persona on/off, which provider writes her replies, her own time and wake phrases. */
+@Composable
+fun PersonaSettingsCard(
+    config: LLMConfig,
+    viewModel: SettingsViewModel,
+    providers: List<String>,
+    onEditCard: () -> Unit = {},
+    onOpenPictures: () -> Unit = {},
+    presence: PersonaPresenceViewModel = hiltViewModel()
+) {
+    var providerMenuOpen by remember { mutableStateOf(false) }
+    // Whether she is the one who talks, and what there is to say about her card.
+    val personaActive by presence.active.collectAsState()
+    val card by presence.card.collectAsState()
+    Card(
+        modifier = Modifier
