+    @Test
+    fun `the step that asks is one of the plan's own asking steps, never a macro that asks from inside`() {
+        val confirm = step("s1", "CONFIRM_ACTION", mapOf("message" to "Go ahead?"), status = StepStatus.RUNNING)
+        val macro = step("s1", "RUN_MACRO", mapOf("macroName" to "night"), status = StepStatus.RUNNING)
+        val next = sms.copy(stepId = "s2", status = StepStatus.PENDING, result = null)
+
+        assertEquals(confirm, PlanRecord.askingStep(plan(confirm, next), "s1", canonical))
+        // The macro's own confirmation guards the macro's next step, which the plan does not hold.
+        assertNull(PlanRecord.askingStep(plan(macro, next), "s1", canonical))
+        assertNull(PlanRecord.askingStep(plan(confirm, next), "s2", canonical))
+        assertNull(PlanRecord.askingStep(plan(confirm, next), null, canonical))
+        assertNull(PlanRecord.askingStep(null, "s1", canonical))
+        // The name the dispatcher runs the step under decides, not how the plan spells it.
+        val spelled = confirm.copy(action = "confirm")
+        assertEquals(spelled, PlanRecord.askingStep(plan(spelled, next), "s1") { it.action.uppercase() + "_ACTION" })
+    }
