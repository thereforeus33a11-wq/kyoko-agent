+    @Test
+    fun `an attested key is remembered per address and model for its lifetime only`() {
+        val venice = VeniceE2ee.pinnedBaseUrl("https://api.venice.ai/api/v1")!!
+        var now = 50_000L
+        val cache = AttestedKeyCache(lifetimeMillis = 1_000).also { it.now = { now } }
+
+        assertEquals(null, cache.get(venice, "e2ee-a"))
+        cache.put(venice, "e2ee-a", "key-a")
+        assertEquals("key-a", cache.get(venice, " E2EE-A "))
+        assertEquals("another model has a key of its own", null, cache.get(venice, "e2ee-b"))
+
+        now += 999
+        assertEquals("key-a", cache.get(venice, "e2ee-a"))
+        now += 1
+        assertEquals("at its lifetime the key is gone", null, cache.get(venice, "e2ee-a"))
+
+        cache.put(venice, "e2ee-a", "key-a2")
+        cache.forget(venice, "e2ee-a")
+        assertEquals(null, cache.get(venice, "e2ee-a"))
+
+        cache.put(venice, "e2ee-a", "key-a3")
+        now -= 5_000
+        assertEquals("a clock set back is no reason to trust it longer", null, cache.get(venice, "e2ee-a"))
+    }
