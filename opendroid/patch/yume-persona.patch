+/**
+ * The card screen's model: an edit that cannot be written is reported and not lost, a
+ * saved edit on an older built-in card is pointed out with its two choices, and her
+ * notebook can be copied whole and emptied only on purpose.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaViewModelTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory get() = File(context.filesDir, "persona")
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memory: PersonaMemory
+
+    private fun store(builtIn: String) = PersonaStore(context) { path -> if (path.endsWith("card.md")) builtIn else "" }
+
+    private fun viewModel(store: PersonaStore): PersonaViewModel =
+        PersonaViewModel(store, memory, PersonaLibrary(context), thoughts, ownLife).also { model -> await("the card to load") { !model.isLoading } }
+
+    // Her own life: the ledger, the log, what she does now and her wonders, in her directory, on the test's clock.
+    @Volatile private var lifeConfig = com.opendroid.ai.data.models.LLMConfig(personaCheckInsEnabled = true, personaOwnLife = true)
+    private val ledger by lazy { com.opendroid.ai.core.life.OwnLedger({ File(directory, "own_ledger.json") }, { now }) }
+    private val herLog by lazy { com.opendroid.ai.core.life.HerLog({ File(directory, "her_log.json") }, { now }) }
+    private val herNow = com.opendroid.ai.core.life.HerNow()
+    private val wonders by lazy { com.opendroid.ai.core.life.Wonders({ directory }, com.opendroid.ai.core.persona.TestThoughtsCipher()) }
+    private val ownLife by lazy { com.opendroid.ai.core.life.OwnLifeStatus({ lifeConfig }, ledger, herLog, herNow, wonders) }
+
+    // Her thoughts, sealed with a key that lives in the test.
+    private val thoughts by lazy { com.opendroid.ai.core.persona.testThoughts(directory) }
+
+    // The model reads and writes off the main thread and shows the result on the paused main looper.
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
