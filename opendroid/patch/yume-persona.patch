+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsRoutingTest.kt
@@ -0,0 +1,126 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.voice.VoiceOut
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Where what her ears hear goes: the name, the 30 s window, her chat in front, his voice and another, before and after enrolment. */
+class EarsRoutingTest {
+
+    private val t0 = 1_000_000L
+
+    private fun heard(
+        text: String? = "so what did you read today",
+        voice: Voice = Voice.NOT_ENROLLED,
+        at: Long = t0,
+        millis: Long = 2_000,
+        overHer: Boolean = false,
+        kind: Kind = Kind.SPEECH,
+    ) = Heard(at, at + millis, voice, if (voice == Voice.NOT_ENROLLED) null else 0.5f, text, "en", overHer, null, kind)
+
+    private fun room(
+        enrolled: Boolean = false,
+        others: Boolean = false,
+        chat: Boolean = false,
+        spells: List<VoiceOut.Spell> = emptyList(),
+    ) = EarsRouting.Room(enrolled, others, chat, spells)
+
+    private fun spell(start: Long, end: Long?) = VoiceOut.Spell("s$start", "her line", start, end, null)
+
+    @Test
+    fun `her name makes speech said to her, as a whole word, in English and in kana`() {
+        assertEquals(EarsRouting.Why.NAME, EarsRouting.saidToHer(heard("Yume, what are you doing"), room()))
+        assertEquals(EarsRouting.Why.NAME, EarsRouting.saidToHer(heard("hey yumi come look at this"), room()))
+        assertEquals(EarsRouting.Why.NAME, EarsRouting.saidToHer(heard("ユメちゃん、何してるの"), room()))
+        // Not inside another word, and not an ordinary phrase that sounds like it.
+        assertNull(EarsRouting.saidToHer(heard("that was yummy, you may go"), room()))
+        assertNull(EarsRouting.saidToHer(heard("夢を見た"), room()))
+    }
+
+    @Test
+    fun `within 30 s after her voice ends, or while she speaks, it is said to her`() {
+        val ended = listOf(spell(t0 - 10_000, t0 - 5_000))
+        assertEquals(EarsRouting.Why.AFTER_HER, EarsRouting.saidToHer(heard(at = t0), room(spells = ended)))
+        assertEquals(EarsRouting.Why.AFTER_HER, EarsRouting.saidToHer(heard(at = t0 - 5_000 + 30_000), room(spells = ended)))
+        assertNull(EarsRouting.saidToHer(heard(at = t0 - 5_000 + 30_001), room(spells = ended)))
+        assertEquals(EarsRouting.Why.WHILE_SHE_SPEAKS, EarsRouting.saidToHer(heard(at = t0), room(spells = listOf(spell(t0 - 1_000, null)))))
+        // A line of hers that only starts after he began is not one he answered.
+        assertNull(EarsRouting.saidToHer(heard(at = t0), room(spells = listOf(spell(t0 + 500, t0 + 3_000)))))
+        assertEquals(EarsRouting.Why.OVER_HER, EarsRouting.saidToHer(heard(overHer = true), room()))
+    }
+
+    @Test
+    fun `with her chat in front everything is said to her`() {
+        assertEquals(EarsRouting.Why.CHAT_IN_FRONT, EarsRouting.saidToHer(heard(), room(chat = true)))
+        assertNull(EarsRouting.saidToHer(heard(), room(chat = false)))
+    }
+
+    @Test
+    fun `before enrolment speech said to her is his talk, and anything else is counted`() {
+        val toHer = EarsRouting.route(heard("yume, look"), room())
+        assertTrue(toHer is EarsRouting.Route.ToHer)
+        toHer as EarsRouting.Route.ToHer
+        assertTrue(toHer.fromHim)
+        assertFalse(toHer.enrolled)
+        assertEquals("yume, look", toHer.text)
+        val counted = EarsRouting.route(heard("pass me the salt"), room())
+        assertTrue(counted is EarsRouting.Route.Counted)
+        assertEquals(EarsRouting.Whose.ANYONE, (counted as EarsRouting.Route.Counted).whose)
+    }
+
+    @Test
+    fun `after enrolment his voice not said to her is overheard, and said to her is talk`() {
+        val overheard = EarsRouting.route(heard("where are my keys", Voice.HIM), room(enrolled = true))
+        assertTrue(overheard is EarsRouting.Route.Overheard)
+        assertTrue((overheard as EarsRouting.Route.Overheard).his)
+        val talk = EarsRouting.route(heard("yume, where are my keys", Voice.HIM), room(enrolled = true))
+        assertTrue(talk is EarsRouting.Route.ToHer)
+        assertTrue((talk as EarsRouting.Route.ToHer).fromHim && talk.enrolled)
+    }
+
+    @Test
+    fun `another voice is counted, even when it says her name, unless others may talk to her`() {
+        val named = heard("yume, hi", Voice.OTHER)
+        val counted = EarsRouting.route(named, room(enrolled = true))
+        assertTrue(counted is EarsRouting.Route.Counted)
+        assertEquals(EarsRouting.Whose.ANOTHER, (counted as EarsRouting.Route.Counted).whose)
+        val allowed = EarsRouting.route(named, room(enrolled = true, others = true))
+        assertTrue(allowed is EarsRouting.Route.ToHer)
+        assertFalse((allowed as EarsRouting.Route.ToHer).fromHim)
+        // Not said to her, it is counted whatever the setting.
+        assertTrue(EarsRouting.route(heard("hi there", Voice.OTHER), room(enrolled = true, others = true)) is EarsRouting.Route.Counted)
+        // Words not written down (others may not talk) are only counted.
+        assertTrue(EarsRouting.route(heard(null, Voice.OTHER), room(enrolled = true)) is EarsRouting.Route.Counted)
+    }
+
+    @Test
+    fun `a sound is never a message`() {
+        val laugh = { voice: Voice -> heard(null, voice, kind = Kind.SOUND, millis = 900) }
+        val after = listOf(spell(t0 - 4_000, t0 - 2_000))
+        // His laugh is overheard, said to her or not.
+        assertTrue(EarsRouting.route(laugh(Voice.HIM), room(enrolled = true, spells = after)) is EarsRouting.Route.Overheard)
+        assertTrue(EarsRouting.route(laugh(Voice.HIM), room(enrolled = true)) is EarsRouting.Route.Overheard)
+        // Before enrolment, a laugh right after her line is a sound in the room with her; any other is counted.
+        val near = EarsRouting.route(laugh(Voice.NOT_ENROLLED), room(spells = after))
+        assertTrue(near is EarsRouting.Route.Overheard)
+        assertFalse((near as EarsRouting.Route.Overheard).his)
+        assertTrue(EarsRouting.route(laugh(Voice.NOT_ENROLLED), room()) is EarsRouting.Route.Counted)
+        // Another voice's laugh is counted.
+        assertTrue(EarsRouting.route(laugh(Voice.OTHER), room(enrolled = true, spells = after, others = true)) is EarsRouting.Route.Counted)
+    }
+
+    @Test
+    fun `nothing of what was heard is in a route's toString`() {
+        val secret = "SENTINEL-words-of-his"
+        for (r in listOf(
+            EarsRouting.route(heard(secret), room(chat = true)),
+            EarsRouting.route(heard(secret, Voice.HIM), room(enrolled = true)),
+            EarsRouting.route(heard(secret), room()),
+        )) {
+            assertFalse(r.toString().contains(secret))
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/EarsWiringTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/EarsWiringTest.kt
