diff --git a/app/src/main/cpp/CMakeLists.txt b/app/src/main/cpp/CMakeLists.txt
new file mode 100644
index 0000000..3260233
--- /dev/null
+++ b/app/src/main/cpp/CMakeLists.txt
@@ -0,0 +1,44 @@
+# Her voice's Japanese reading on the phone: Open JTalk's text front end and a small JNI
+# wrapper (yume_jtalk.cpp). No synthesis here; sherpa-onnx speaks.
+#
+# open_jtalk/ is fetched by the build (opendroid/tools/fetch_voice_native.sh) at
+# r9y9/open_jtalk 462fc38, the commit pyopenjtalk 0.4.1 is built from, and is built
+# with pyopenjtalk's own macros, so the labels match the ones her voice was trained on.
+# config.h is mecab's, as Open JTalk's CMake writes it on Linux (LP64, no iconv); the
+# same values hold for 64-bit Android.
+cmake_minimum_required(VERSION 3.22.1)
+project(yumejtalk C CXX)
+
+set(OJT ${CMAKE_CURRENT_SOURCE_DIR}/open_jtalk/src)
+if(NOT EXISTS ${OJT}/jpcommon/jpcommon.c)
+    message(FATAL_ERROR "Open JTalk sources are missing in ${OJT}: run opendroid/tools/fetch_voice_native.sh")
+endif()
+
+set(OJT_DIRS jpcommon mecab/src mecab2njd njd njd2jpcommon njd_set_accent_phrase njd_set_accent_type
+             njd_set_digit njd_set_long_vowel njd_set_pronunciation njd_set_unvoiced_vowel text2mecab)
+set(OJT_SRC "")
+set(OJT_INC ${CMAKE_CURRENT_SOURCE_DIR})
+foreach(d ${OJT_DIRS})
+    file(GLOB c_files ${OJT}/${d}/*.c)
+    file(GLOB cpp_files ${OJT}/${d}/*.cpp)
+    list(APPEND OJT_SRC ${c_files} ${cpp_files})
+    list(APPEND OJT_INC ${OJT}/${d})
+endforeach()
+# All of mecab/src, as pyopenjtalk builds it.
+
+add_library(yumejtalk SHARED yume_jtalk.cpp ${OJT_SRC})
+target_include_directories(yumejtalk PRIVATE ${OJT_INC})
+target_compile_definitions(yumejtalk PRIVATE
+    HAVE_CONFIG_H DIC_VERSION=102 MECAB_DEFAULT_RC="dummy" PACKAGE="open_jtalk" VERSION="1.10" CHARSET_UTF_8)
+target_compile_options(yumejtalk PRIVATE -w -finput-charset=UTF-8 -fexec-charset=UTF-8)
+set_target_properties(yumejtalk PROPERTIES CXX_STANDARD 17)
+if(NOT ANDROID)
+    # A host build, for checking the labels against pyopenjtalk's on a desktop JVM.
+    find_package(JNI REQUIRED)
+    target_include_directories(yumejtalk PRIVATE ${JNI_INCLUDE_DIRS})
+endif()
+if(ANDROID)
+    target_link_libraries(yumejtalk PRIVATE m)
+    # 16 KB pages (Android 15+ devices may use them).
+    target_link_options(yumejtalk PRIVATE "-Wl,-z,max-page-size=16384")
+endif()
