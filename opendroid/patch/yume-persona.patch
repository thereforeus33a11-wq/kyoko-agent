+        internal suspend fun describeOwnPictureFrom(
+            card: String,
+            ownerName: String,
+            pictureBase64: String,
+            timeoutMillis: Long = OWN_PICTURE_TIMEOUT_MILLIS,
+            callScope: CoroutineScope,
+            complete: suspend (LLMRequest) -> LLMResponse
