+        // They are not notes, and not what the planner or a recall is given.
+        assertTrue(personaMemory.notes().isEmpty())
+        assertTrue(personaMemory.writtenAt().isEmpty())
+        assertFalse(manager.getRelevantContext("bees").contains("i keep bees by the way"))
+        assertTrue(manager.searchMemory("bees").isEmpty())
+
+        // A pass read up to the second row: those two go, the third stays.
+        personaMemory.dropLeftBehind(1_010)
+        assertEquals(listOf("m3"), personaMemory.leftBehind(0).map { it.message.id })
+        personaMemory.dropLeftBehind(2_000)
+        assertTrue(personaMemory.leftBehind(0).isEmpty())
+        // Nothing is left of them in the store.
+        assertTrue(memoryRepository.getMemoriesByKeyPrefix("yume.meta.left").isEmpty())
+        // Emptying her notebook is about her notes; dropping nothing is no error.
+        personaMemory.dropLeftBehind(9_000)
