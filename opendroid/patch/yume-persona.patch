+package com.opendroid.ai.core.llm.providers
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Text that comes out of a provider's stream is the reply: it is stored under the name of
+ * whoever wrote it, shown and spoken. So a provider may hand on the model's text and
+ * nothing else. A failure is thrown, where it becomes an error card, and a change of
+ * backend is logged. This reads the provider sources and fails when a stream hands on a
+ * sentence of the app's own.
+ */
+class ProviderStreamTextTest {
+
+    private val providers = File("src/main/java/com/opendroid/ai/core/llm/providers")
+
+    /** The bodies of every `streamComplete` in [source]. */
+    private fun streamBodies(source: String): List<String> =
+        source.split("override fun streamComplete(").drop(1).map { it.substringBefore("\n    override ") }
+
+    private val emitsAppText = Regex("""emit\(\s*"""")
+
+    @Test
+    fun `no provider hands on text of its own in the reply stream`() {
+        val sources = providers.listFiles { file -> file.name.endsWith("Provider.kt") }.orEmpty()
+        assertTrue("expected the provider sources at ${providers.absolutePath}", sources.size >= 14)
+
+        val offenders = sources.filter { file ->
+            streamBodies(file.readText()).any { body -> emitsAppText.containsMatchIn(body.replace("emit(\"\$word \")", "")) }
+        }.map { it.name }
+
+        assertEquals(emptyList<String>(), offenders)
+    }
+
+    @Test
+    fun `the local providers throw what went wrong instead of saying it`() {
+        for (name in listOf("OllamaProvider.kt", "LiteRTLMProvider.kt", "GemmaProvider.kt", "HybridOnDeviceProvider.kt")) {
+            val bodies = streamBodies(File(providers, name).readText())
+            assertEquals(name, 1, bodies.size)
+            val body = bodies.single()
+            for (said in listOf("Error streaming", "Error (LiteRT-LM)", "Error:", "[Switched to")) {
+                assertTrue("$name still says \"$said\" in its stream", !body.contains("emit(\"$said") && !body.contains("emit(\"\\n$said"))
+            }
+        }
+        // The check recognises the shapes it is there to catch.
+        assertTrue(emitsAppText.containsMatchIn("""emit("Error streaming Ollama: ${'$'}{e.message}")"""))
+        assertTrue(emitsAppText.containsMatchIn("emit(\"\\n[Switched to \${fallback.name}]\\n\")"))
+        assertTrue(!emitsAppText.containsMatchIn("emit(chunk)"))
+        assertTrue(!emitsAppText.containsMatchIn("""emit(chunk.candidates.firstOrNull()?.text ?: "")"""))
+    }
+
+    @Test
+    fun `the providers that hand text on while the model writes say so, and only those`() {
+        val live = providers.listFiles { file -> file.name.endsWith("Provider.kt") }.orEmpty()
+            .filter { it.readText().contains("override val streamsLive: Boolean = true") }
+            .map { it.name }
+            .toSet()
+        assertEquals(setOf("LiteRTLMProvider.kt", "GemmaProvider.kt", "HybridOnDeviceProvider.kt"), live)
+    }
+}
