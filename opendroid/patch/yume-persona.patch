+                Note(
+                    if (selfPictures.size >= viewModel.maxSelfPictures) {
+                        "She has ${viewModel.maxSelfPictures} pictures, which is as many as fit. Remove one to add another."
+                    } else {
+                        "${selfPictures.size} of ${viewModel.maxSelfPictures}."
+                    }
+                )
+                if (selfPictures.isNotEmpty() && !(modelSeesPictures && sheIsOn)) {
+                    Note(
+                        if (!sheIsOn) {
+                            "\"Let her look\" is off: she is switched off in Settings, so there is nobody to look."
+                        } else {
+                            "\"Let her look\" is off: " + PersonaPicturesViewModel.CANNOT_LOOK_REASON
+                        }
+                    )
+                }
+
+                SectionTitle("WHAT MADE HER")
+                Note(
+                    "One picture: the page she comes from. It is never shown to her. What it says goes into her prompt " +
