+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.holdsBackDetails
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+
+// What a prompt may carry is decided by the route it travels on, not by one switch for
+// the whole app. The two functions below name the routes the agent's own calls take, so
+// that each call site says in one word whose prompt it is building.
+
+/**
+ * True when a prompt on the main provider (classification, planning, plan critic and
+ * merge, re-evaluation, stock chat, vision, auto-reply) must leave the owner's details
+ * out: a host could read it and private mode is on. False on a private route.
+ */
+internal fun LLMConfig.mainRouteHoldsBack(): Boolean = holdsBackDetails(RouteClassifier.mainRoute(this))
+
+/** The same for the route her replies, her notebook pass and her unprompted lines take. */
+internal fun LLMConfig.herRouteHoldsBack(): Boolean = holdsBackDetails(RouteClassifier.personaRoute(this))
+
+/**
+ * True when private mode is on and the main route is private, so that nothing was held
+ * back from the planner: it was told where he is and what the phone has saved about him,
+ * and may have put any of that into the plan it wrote (a place, a name, an address).
+ * What such a plan says may be replayed only to a route that may see everything too.
+ */
+internal fun LLMConfig.plannerWasToldEverything(): Boolean =
+    privateMode && RouteClassifier.mainRoute(this).isPrivate
+
+/**
+ * Whether an app row that repeats what a plan or one of its steps said (the summary of a
+ * run, the trace of an auto-approved plan, a question a step asks, a hand-off) is one
+ * that only a private route may be given.
+ *
+ * It is when its text holds his private data ([holdsPersonalData]), or when the plan was
+ * written by a planner that was told everything. He sees the row as it is either way.
+ * The mark decides what a later prompt gets: the row on a private route, one line saying
+ * that it stays on the phone where a host could read it.
+ */
+internal fun planRowStaysPrivate(config: LLMConfig, holdsPersonalData: Boolean = false): Boolean =
+    holdsPersonalData || config.plannerWasToldEverything()
+
+/**
+ * True when what the planner answered in words must not be passed on to her reply: her
+ * reply goes through a host that could read it, and the planner was told everything, so
+ * its words may repeat an address or a saved fact that her route is not given.
+ */
+internal fun LLMConfig.plannerWordsStayOnPhone(): Boolean = herRouteHoldsBack() && plannerWasToldEverything()
+
+/**
+ * His message as the planner, the plan critic and the merge step get it. The screenshot
+ * the app attached by itself stays on the phone when the planner's host could read it.
+ * A screen command he gives still works: that capture is taken by the action he asked
+ * for, not carried along by this message.
+ */
+internal fun ChatMessage.forPlanner(config: LLMConfig): ChatMessage =
+    if (config.mainRouteHoldsBack() && imageBase64 != null) copy(imageBase64 = null) else this
+
+/**
+ * Added to the stock system prompt when the screenshot taken for his message was kept on
+ * the phone, so that the reply does not describe a screen it was never shown.
+ */
+internal const val STOCK_SCREENSHOT_WITHHELD_LINE =
+    "A screenshot was taken for the user's last message, but private mode keeps it on the phone: " +
+        "you cannot see the screen in this reply. Say so instead of guessing what is on it. " +
+        "If the user wants the screen read, they can say \"read my screen\"."
+
+/**
+ * True when the window in front belongs to this app. A screenshot taken then shows the
+ * chat itself, his messages and her replies, which every reply already has as text; it
+ * would add nothing and could carry them to a model that was never meant to get them.
+ * An unknown front window counts as someone else's, which is what a capture is for.
+ */
+internal fun isOwnWindowInFront(frontPackage: CharSequence?, ownPackage: String?): Boolean =
+    !frontPackage.isNullOrBlank() && frontPackage.toString() == ownPackage
