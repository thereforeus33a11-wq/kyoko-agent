+                val back = openedAside()
+                if (back.isNotEmpty()) store(back)
+            }
+        }
+        return bounded(held.orEmpty() + unwritten)
+    }
+
+    /**
+     * What [target] holds: nothing when it is not there, and null when it is there and
+     * cannot be opened now. The two are kept apart, because only the first means that
+     * nothing would be lost by writing over it.
+     */
+    private fun open(target: File): List<Thought>? = try {
+        if (!target.isFile) {
+            emptyList()
+        } else {
+            val envelope = SecretEnvelope.decode(target.readText().trim()) ?: throw IOException("Not a sealed file")
+            val plain = cipher.decrypt(envelope.iv, envelope.ciphertext, AAD)
+            JSON.decodeFromString(ListSerializer(Entry.serializer()), String(plain, Charsets.UTF_8))
+                .map { Thought(it.at, it.text) }
+        }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        // Only what kind of failure it was: never anything of the file.
+        Log.w(TAG, "Her thoughts could not be read this time: ${e.javaClass.simpleName}")
+        null
+    }
+
+    /** The files that were moved aside unread, oldest first. */
+    private fun setAside(): List<File> =
+        directory().listFiles { candidate -> candidate.isFile && candidate.name.startsWith(UNREAD_PREFIX) }
+            ?.sortedBy { it.name }
+            .orEmpty()
+
+    /** Those of them that open now, each with the thoughts in it. */
+    private fun openedAside(): List<Pair<File, List<Thought>>> =
+        setAside().mapNotNull { aside -> open(aside)?.let { aside to it } }
+
+    /**
+     * Puts everything she has into the file: what it holds, what is not written yet,
+     * and [back], the thoughts of files moved aside that open again. Those files are
+     * taken away once their thoughts are in the file. When the file cannot be written,
+     * everything stays where it was and is tried again with the next thought.
+     */
+    private fun store(back: List<Pair<File, List<Thought>>>) {
+        val fromFile = held ?: open(file)
+        // What was moved aside is older than what the file holds. A thought that is in
+        // both (a file that was merged and could not be taken away afterwards) is one thought.
+        val earlier = back.flatMap { it.second }
+        val known = if (earlier.isEmpty()) fromFile.orEmpty() else (earlier + fromFile.orEmpty()).distinct()
+        val all = bounded(known + unwritten)
+        if (!write(all, overUnread = fromFile == null)) {
+            if (fromFile != null) held = fromFile
+            return
+        }
+        held = all
+        unwritten = emptyList()
+        back.forEach { it.first.delete() }
+    }
+
+    /**
+     * Moves the file aside under a name of its own, so that a new one can be started
+     * without writing over thoughts nobody has read. Only a few such files are kept:
+     * past [MAX_SET_ASIDE] the oldest, which has not opened in all the tries since, is
+     * let go.
+     */
+    private fun moveAside(target: File): Boolean {
+        setAside().dropLast(MAX_SET_ASIDE - 1).forEach { it.delete() }
+        val folder = target.parentFile ?: return false
+        val free = generateSequence(System.currentTimeMillis()) { it + 1 }
+            .map { File(folder, UNREAD_PREFIX + it) }
+            .first { !it.exists() }
+        return target.renameTo(free)
+    }
+
+    /**
+     * Writes the whole store beside the file and moves it into place, so the file is
+     * never seen half-written. True when the file now holds [all]. With [overUnread] the
+     * file that is there could not be read: it is moved aside first, and only once the
+     * new text is sealed and on the disk, so a Keystore that does not answer at all
+     * leaves everything as it is.
+     */
+    private fun write(all: List<Thought>, overUnread: Boolean): Boolean {
+        try {
+            val target = file
+            val folder = target.parentFile ?: throw IOException("No directory")
+            if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+            val plain = JSON.encodeToString(ListSerializer(Entry.serializer()), all.map { Entry(it.atMillis, it.text) })
+            val sealed = SecretEnvelope.encode(cipher.encrypt(plain.toByteArray(Charsets.UTF_8), AAD))
+            val draft = File(folder, "$FILE.tmp")
+            try {
+                FileOutputStream(draft).use { out ->
+                    out.write(sealed.toByteArray(Charsets.UTF_8))
+                    out.fd.sync()
+                }
+                if (overUnread && !moveAside(target)) throw IOException("The unread file could not be moved aside")
+                if (!draft.renameTo(target)) throw IOException("The file could not be put in place")
+            } finally {
+                // Gone already when the move worked; left over when it did not.
+                draft.delete()
+            }
+            return true
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her thoughts could not be written: ${e.javaClass.simpleName}")
+            return false
+        }
+    }
+
+    @Serializable
+    private data class Entry(val at: Long, val text: String)
+
+    companion object {
+        private const val TAG = "PersonaThoughts"
+        private const val DIRECTORY = "persona"
+        private const val FILE = "thoughts.sealed"
+
+        // A file that was moved aside unread is named with this and the time it was moved.
+        private const val UNREAD_PREFIX = "$FILE.unread-"
+
+        // How many files moved aside unread are kept at most.
+        private const val MAX_SET_ASIDE = 3
+        private const val KEY_ALIAS = "opendroid.persona_thoughts.aes_gcm.v1"
+        private val AAD = "persona-thoughts".toByteArray(Charsets.UTF_8)
+        private val JSON = Json { ignoreUnknownKeys = true }
+
+        /** How many characters of her thoughts are kept. Past it the oldest fall away. */
+        const val MAX_CHARS = 60_000
+
+        /** That bound in pages of about two thousand characters, the way her prompt says it. */
+        const val MAX_PAGES = MAX_CHARS / 2_000
+
+        /** How many characters of her latest thoughts go into one prompt of hers. */
+        const val PROMPT_BUDGET_CHARS = 3_000
+        /** The same in a moment of her own, where she looks back on what she thought. */
+        const val OWN_TIME_BUDGET_CHARS = 8_000
+
+        /** The same on the page of her sleep: what she thought since she last woke, as much of it as fits. */
+        const val SLEEP_BUDGET_CHARS = 5_000
+    }
+}
+
+/**
+ * The lines of a reply that she keeps to herself. A line that starts with [MARKER] is
+ * a thought: the mirror of the command line, which goes out to the phone. It is taken
+ * out of the reply before anything else looks at it, so it is never shown, spoken,
+ * stored in the chat, read by her notebook pass or taken for a command.
+ *
+ * Everything here is a decision about text. Keeping the thoughts is [PersonaThoughts].
+ */
+object PersonaThoughtLines {
+
+    const val MARKER = "<<"
+
+    /** Half of [MARKER], alone on a line: all that has arrived of one so far. */
+    internal const val HALF_MARKER = "<"
+
+    /** Opens her thoughts in her own prompt. It says whose they are and who is not shown them. */
+    const val HEADING = "=== YOUR OWN THOUGHTS (yours alone. he is not shown these and the app shows them nowhere) ==="
+
+    /**
+     * A reply without its thought lines, and the thoughts that were in it, one per line.
+     * [marked] says the reply had a thought line at all, also one with nothing after the marker.
+     */
+    data class Split(val text: String, val thoughts: String, val marked: Boolean)
+
+    /** Quotation marks a model may open a line with: the ones [PersonaPrompts.cleanReply] takes off a reply. */
+    private val OPENING_QUOTES = charArrayOf('"', '\u201C', '\u300C')
+    private val CLOSING_QUOTES = charArrayOf('"', '\u201D', '\u300D')
+
+    /** A name a chat model writes in front of a line, in any case, as a label with a colon. */
+    private val NAME_LABEL = Regex("""^(?:yume kisaragi|yume|kisaragi|assistant|ai)\s*:\s*""", RegexOption.IGNORE_CASE)
+
+    /**
+     * [line] without an opening quotation mark, and without a name label in front of it
+     * ("Yume: ", "yume: ") when a marker follows the label: a marker behind either still
+     * opens a thought. Otherwise the reply would lose the label when it is tidied and
+     * show the thought. A label with no marker behind it is left as it is.
+     */
+    private fun bare(line: String): String {
+        val text = line.trim().trimStart(*OPENING_QUOTES).trimStart()
+        val label = NAME_LABEL.find(text) ?: return text
+        val rest = text.substring(label.range.last + 1).trimStart(*OPENING_QUOTES).trimStart()
+        return if (rest.startsWith(HALF_MARKER)) rest else text
+    }
+
+    internal fun isThoughtLine(line: String): Boolean = bare(line).startsWith(MARKER)
+
+    /** What a thought line says, without its marker. A marker closed the way it was opened loses that too. */
+    private fun thoughtOf(line: String): String =
+        bare(line).trimStart('<').trim().trimEnd(*CLOSING_QUOTES).trim().removeSuffix(PersonaActions.MARKER).trim()
+
+    /**
+     * Separates what she says from what she keeps to herself. Every line that starts
+     * with [MARKER] is a thought, wherever it stands. The other lines stay as they were
+     * written and in their order, so a command line that was last before is still last.
+     */
+    fun split(reply: String): Split {
+        if (!reply.contains(MARKER)) return Split(reply, "", marked = false)
+        val said = ArrayList<String>()
+        val thought = ArrayList<String>()
+        var marked = false
+        for (line in reply.lines()) {
+            if (isThoughtLine(line)) {
+                marked = true
+                thoughtOf(line).takeIf { it.isNotEmpty() }?.let { thought += it }
+            } else {
+                said += line
+            }
+        }
+        return Split(if (marked) said.joinToString("\n") else reply, thought.joinToString("\n"), marked)
+    }
+
+    /**
+     * [streamed], a reply that is still coming in, without anything that is or may turn
+     * out to be a thought: no thought line, however much of it has arrived, and no last
+     * line that so far is only half a marker.
+     */
+    fun hidden(streamed: String): String {
+        val lines = streamed.lines().filterNot { isThoughtLine(it) }
+        val last = lines.indexOfLast { it.isNotBlank() }
+        val whole = if (last >= 0 && bare(lines[last]) == HALF_MARKER) lines.take(last) else lines
+        return whole.joinToString("\n")
+    }
+
+    /**
+     * Her latest thoughts as the block of her prompt: each with its age, oldest first,
+     * and unable to open a section of the prompt. Empty when there are none.
+     */
+    fun block(thoughts: List<PersonaThoughts.Thought>, nowMillis: Long): String =
+        thoughts.joinToString("\n") { thought ->
+            "(" + PersonaPrompts.age(nowMillis - thought.atMillis) + ") " + thought.text.trim().replace("===", "= = =")
+        }
+}
