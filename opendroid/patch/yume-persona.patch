+        clear()
+        set(2026, Calendar.NOVEMBER, 17, 22, 10, 0)
+    }.timeInMillis
+
+    private val bounds = Bounds(minGapMillis = 15 * minute, maxPerDay = 24)
+
+    // ── What a moment of hers comes to ───────────────────────────────────────────────
+
+    @Test
+    fun `every line she does not mark is a thought, kept in order as one text`() {
+        val moment = PersonaOwnTime.parse("the neon is on again.\n\nhe keeps bees. why bees\n<< and i like that he does")
+        assertEquals("the neon is on again.\nhe keeps bees. why bees\nand i like that he does", moment.thoughts)
+        assertEquals("", moment.said)
+        assertTrue(moment.notes.isEmpty())
+        assertNull(moment.command)
+        assertNull(moment.wishText)
+        assertEquals(Did.KEPT, moment.did)
+        assertFalse(moment.passed)
+    }
+
+    @Test
+    fun `the marked lines go where their mark says, and nothing of them stays among her thoughts`() {
+        val moment = PersonaOwnTime.parse(
+            """
+            bored. the rain has not stopped
+            say: still raining here
+            note: me | rain | i like the sound of rain on the awning
+            Say: you up
+            >> flashlight on
+            next: 3h
+            """.trimIndent()
+        )
+        assertEquals("bored. the rain has not stopped", moment.thoughts)
+        // All of her lines to him are one message, in the order she wrote them.
+        assertEquals("still raining here\nyou up", moment.said)
+        assertEquals(listOf(Note(Kind.ME, "rain", "i like the sound of rain on the awning")), moment.notes)
+        assertEquals("flashlight on", moment.command)
+        assertEquals(emptyList<Unrun>(), moment.unrun)
+        assertEquals(Wish.After(3 * hour), moment.wish)
+        assertEquals("3h", moment.wishText)
+        assertEquals(Did.SAID, moment.did)
+    }
+
+    @Test
+    fun `a moment is sorted line by line, whatever comes back`() {
+        data class Case(val reply: String, val check: (PersonaOwnTime.Moment) -> Unit)
+        val cases = listOf(
+            // A mark only counts at the start of a line.
+            Case("i could say: nothing") { assertEquals("i could say: nothing", it.thoughts); assertEquals("", it.said) },
+            // A list dash in front of a mark is tolerated.
+            Case("- say: fine\n* next: 20m") { assertEquals("fine", it.said); assertEquals(Wish.After(20 * minute), it.wish) },
+            // Her line to him is tidied the way a reply is, and no more.
+            Case("say: Yume: \"did *not* sleep\"") { assertEquals("did not sleep", it.said) },
+            // A say line with nothing after the mark says nothing.
+            Case("say:\nhm") { assertEquals("", it.said); assertEquals("hm", it.thoughts) },
+            // Of several times the last one counts.
+            Case("next: 20m\nnext: when he writes") { assertEquals(Wish.WhenHeWrites, it.wish); assertEquals("when he writes", it.wishText) },
+            // A time that cannot be read is still a time she asked for, and the line is kept as she wrote it.
+            Case("next: whenever") {
+                assertNull(it.wish); assertEquals("whenever", it.wishText); assertEquals("next: whenever", it.thoughts)
+            },
+            // It may have been a thought all along: nothing of it is lost, in its place among the others.
+            Case("hm\nnext: after i have thought about what he said about the bees\nfine") {
+                assertNull(it.wish)
+                assertEquals("hm\nnext: after i have thought about what he said about the bees\nfine", it.thoughts)
+            },
+            // A time the app reads is a time and nothing else, and a mark with nothing after it leaves nothing to keep.
+            Case("next: 2h") { assertEquals(Wish.After(2 * hour), it.wish); assertEquals("", it.thoughts) },
+            Case("hm\nnext:") { assertEquals("", it.wishText); assertEquals("hm", it.thoughts) },
+            // A line to him is hers whatever it is made of: no letter and no digit is needed for it to be said.
+            Case("say: ...") { assertEquals("...", it.said); assertEquals(Did.SAID, it.did) },
+            Case("say: ?!") { assertEquals("?!", it.said) },
+            Case("say: \u2661") { assertEquals("\u2661", it.said); assertFalse(it.passed) },
+            Case("say: .") { assertEquals(".", it.said) },
+            // A note that does not have the notebook's form is not lost: it stays a thought as written.
+            Case("note: remember the boots") { assertTrue(it.notes.isEmpty()); assertEquals("note: remember the boots", it.thoughts) },
+            // The thought marker of a reply is simply taken off.
+            Case("<< mine\n<<also mine >>") { assertEquals("mine\nalso mine", it.thoughts) }
+        )
+        for (case in cases) case.check(PersonaOwnTime.parse(case.reply))
+    }
+
+    @Test
