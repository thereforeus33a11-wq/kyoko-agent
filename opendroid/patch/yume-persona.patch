+    @Test
+    fun `how he usually sounds is kept sealed with his print, and only with it`() = runBlocking {
+        val dir = File(folder.root, "ears-usual")
+        val store = VoicePrintStore({ dir }, TestThoughtsCipher())
+        val u = SoundUsual(-31.5f, 3.2f, 5.5f, -14f, mapOf("en" to 162f, "ja" to 140f), 7)
+        // Nothing to keep it with yet.
+        assertFalse(store.keepUsual("titanet-small-en", u))
+        assertTrue(store.save(VoicePrint("titanet-small-en", VoiceMath.unit(voice(0, seed = 9)), 3)))
+        assertFalse(store.keepUsual("another-model", u))
+        assertTrue(store.keepUsual("titanet-small-en", u))
+        val back = VoicePrintStore({ dir }, TestThoughtsCipher()).get()!!.usual!!
+        assertEquals(-31.5f, back.levelDb)
+        assertEquals(3.2f, back.pitchSemitones)
+        assertEquals(5.5f, back.pitchSpread)
+        assertEquals(-14f, back.brightnessDb)
+        assertEquals(162f, back.wordsPerMinute("en"))
+        assertEquals(140f, back.wordsPerMinute("<|ja|>"))
+        assertEquals(7, back.learned)
+        assertFalse(File(dir, "voiceprint.sealed").readText().contains("162"))
+        // What was kept is a copy: learning on after does not change it until it is kept again.
+        u.learn(measure(120.0, 0.05), 20, "en", null)
+        assertEquals(7, store.get()!!.usual!!.learned)
+    }
+
+    @Test
+    fun `how he usually sounds is never kept over a voice he forgot or enrolled again`() = runBlocking {
+        val dir = File(folder.root, "ears-race")
+        val store = VoicePrintStore({ dir }, TestThoughtsCipher())
+        val u = SoundUsual(-31.5f, 3.2f, 5.5f, -14f, mapOf("en" to 162f), 7)
+        val first = VoicePrint("titanet-small-en", VoiceMath.unit(voice(0, seed = 9)), 3)
+        assertTrue(store.save(first))
+        // He enrolled again while the ears still held the first print: the new one stays as it is.
+        val second = VoicePrint("titanet-small-en", VoiceMath.unit(voice(1, seed = 4)), 3)
+        assertTrue(store.save(second))
+        assertFalse(store.keepUsual("titanet-small-en", u, of = first))
+        assertArrayEquals(second.vector, VoicePrintStore({ dir }, TestThoughtsCipher()).get()!!.vector, 0f)
+        assertNull(store.get()!!.usual)
+        // He forgot his voice: nothing brings it back.
+        store.forget()
+        assertFalse(store.keepUsual("titanet-small-en", u, of = second))
+        assertNull(VoicePrintStore({ dir }, TestThoughtsCipher()).get())
+        assertFalse(File(dir, "voiceprint.sealed").exists())
+    }
+
+    @Test
+    fun `his print is kept sealed, read back the same, and forgotten`() = runBlocking {
+        val dir = File(folder.root, "ears")
+        val store = VoicePrintStore({ dir }, TestThoughtsCipher())
+        assertNull(store.get())
+        val print = VoicePrint("titanet-small-en", VoiceMath.unit(voice(0, seed = 9)), 3, 0.42f)
+        assertTrue(store.save(print))
+        val again = VoicePrintStore({ dir }, TestThoughtsCipher()).get()!!
+        assertArrayEquals(print.vector, again.vector, 0f)
+        assertEquals(print.modelId to print.takes, again.modelId to again.takes)
+        assertEquals(0.42f, again.threshold)
+        val onDisk = File(dir, "voiceprint.sealed").readText()
+        assertFalse(onDisk.contains("titanet"))
+        assertFalse(onDisk.contains(VoicePrintStore.encode(print.vector)))
+        // Another key cannot open it: no print, not a wrong one.
+        assertNull(VoicePrintStore({ dir }, TestThoughtsCipher(keyByte = 3)).get())
+        store.forget()
+        assertNull(store.get())
+        assertFalse(File(dir, "voiceprint.sealed").exists())
+    }
+}
