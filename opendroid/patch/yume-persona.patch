+    private fun run(persona: Boolean, vararg chunks: String): Pair<String, Boolean> {
+        val filter = LiveReplyFilter(persona)
+        val out = StringBuilder()
+        for (chunk in chunks) {
+            out.append(filter.take(chunk) ?: return out.toString() to true)
+        }
+        out.append(filter.finish() ?: return out.toString() to true)
+        return out.toString() to false
+    }
