diff --git a/app/src/main/java/com/opendroid/ai/core/voice/VoiceOut.kt b/app/src/main/java/com/opendroid/ai/core/voice/VoiceOut.kt
new file mode 100644
index 0000000..e6da4be
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/VoiceOut.kt
@@ -0,0 +1,89 @@
+package com.opendroid.ai.core.voice
+
+/**
+ * What the phone says out loud, and when: her lines in her own voice, and every other line
+ * the phone's voices say. Her ears hear the room, the phone's speaker included, so a
+ * stretch of speech that falls while the phone speaks, or just after, is the phone and not
+ * him ([com.opendroid.ai.core.life.ears.HearingRules.cleanPart]); and a transcript that
+ * reads like a line just said is the phone too
+ * ([com.opendroid.ai.core.life.ears.HearingRules.soundsLikeThePhone]).
+ *
+ * [TextToSpeechEngine] says when each line starts and ends. Held in memory only, and only
+ * for [KEEP_MILLIS]: the text of what was said is kept for that comparison and for nothing
+ * else.
+ */
+object VoiceOut {
+
+    /** One line said out loud. [endedAt] is null while it is still being said. */
+    class Spell(
+        val id: String,
+        val text: String,
+        val startedAt: Long,
+        val endedAt: Long?,
+        /** When his voice came in over it and cut it off, if it did. */
+        val cutByHimAt: Long?,
+    )
+
+    /** The clock all of the ears' times are on: monotonic milliseconds. Replaced in tests. */
+    @Volatile var clock: () -> Long = { System.nanoTime() / 1_000_000 }
+
+    private val lock = Any()
+    private val spells = ArrayList<Spell>()
+
+    /** The phone has started to say [text], under [id]. */
+    fun started(id: String, text: String) = synchronized(lock) {
+        val now = clock()
+        prune(now)
+        spells.removeAll { it.id == id }
+        spells += Spell(id, text, now, null, null)
+        if (spells.size > MAX_SPELLS) spells.removeAt(0)
+    }
+
+    /** The line under [id] has ended: said to its end, cut off, or never said. Unknown ids are ignored. */
+    fun ended(id: String) = synchronized(lock) {
+        val i = spells.indexOfFirst { it.id == id && it.endedAt == null }
+        if (i >= 0) {
+            val s = spells[i]
+            spells[i] = Spell(s.id, s.text, s.startedAt, clock(), s.cutByHimAt)
+        }
+    }
+
+    /** His voice came in over the line being said, from [at] on. */
+    fun cutByHim(at: Long) = synchronized(lock) {
+        for (i in spells.indices) {
+            val s = spells[i]
+            if (s.endedAt == null && s.cutByHimAt == null) spells[i] = Spell(s.id, s.text, s.startedAt, null, maxOf(at, s.startedAt))
+        }
+    }
+
+    /** True while a line is being said. */
+    val playing: Boolean get() = playingSince() != null
+
+    /** When the line being said started, or null when nothing is being said. */
+    fun playingSince(): Long? = synchronized(lock) {
+        val now = clock()
+        spells.filter { it.endedAt == null && it.startedAt > now - LONGEST_LINE_MILLIS }.minOfOrNull { it.startedAt }
+    }
+
+    /** The lines said, or being said, that ended after [since]; oldest first. */
+    fun since(since: Long): List<Spell> = synchronized(lock) {
+        prune(clock())
+        spells.filter { (it.endedAt ?: Long.MAX_VALUE) >= since }
+    }
+
+    /** Forgets everything (her ears closed, or a test). */
+    fun clear() = synchronized(lock) { spells.clear() }
+
+    private fun prune(now: Long) {
+        // A line that never reported its end is let go of after a while, so the ears do not stay deaf.
+        spells.removeAll { (it.endedAt ?: (it.startedAt + LONGEST_LINE_MILLIS)) < now - KEEP_MILLIS }
+    }
+
+    /** How long a said line is remembered after it ended. */
+    const val KEEP_MILLIS = 60_000L
+
+    /** A line still "being said" after this long is taken to have ended unreported. */
+    const val LONGEST_LINE_MILLIS = 5 * 60_000L
+
+    private const val MAX_SPELLS = 16
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/WakeReplyGate.kt b/app/src/main/java/com/opendroid/ai/core/voice/WakeReplyGate.kt
new file mode 100644
index 0000000..da83dcf
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/WakeReplyGate.kt
@@ -0,0 +1,64 @@
+package com.opendroid.ai.core.voice
+
+/**
+ * Decides when the microphone may open after the wake phrase.
+ *
+ * The phone answers the wake phrase with a word or two. If the recogniser is already
+ * listening while that is said, it writes the phone's own word down as the start of his
+ * request, or as his whole request. So the microphone opens when that one utterance has
+ * ended, and only then; [onDeadline] is the way out when no ending is ever reported.
+ *
+ * Like [ApprovalListenGate] it answers yes exactly once for each time it was armed, so the
+ * ending and the deadline can never both open the microphone.
+ */
+class WakeReplyGate {
+    private var awaitedUtteranceId: String? = null
+
+    @Synchronized
+    fun armFor(utteranceId: String) {
+        awaitedUtteranceId = utteranceId
+    }
+
+    /** Shuts the gate. True when a wake reply was still awaited, so the microphone it would have opened never will. */
+    @Synchronized
+    fun disarm(): Boolean {
+        val wasAwaited = awaitedUtteranceId != null
+        awaitedUtteranceId = null
+        return wasAwaited
+    }
+
+    /** True exactly once, when the utterance that ended is the wake reply that was armed. */
+    @Synchronized
+    fun onUtteranceDone(utteranceId: String): Boolean {
+        if (utteranceId != awaitedUtteranceId) return false
+        awaitedUtteranceId = null
+        return true
+    }
+
+    /** True when the wake reply is still awaited at its deadline; the gate is then spent. */
+    @Synchronized
+    fun onDeadline(): Boolean {
+        if (awaitedUtteranceId == null) return false
+        awaitedUtteranceId = null
+        return true
+    }
+
+    companion object {
+        /** How long the end of the wake reply is waited for before the microphone opens anyway. */
+        const val DEADLINE_MILLIS = 3_000L
+
+        /**
+         * True when [transcript] is nothing but one of [phoneLines], which the phone has
+         * just said itself: the recogniser heard the phone, not him. Compared by letters
+         * and digits alone, since a recogniser returns "mm" for "mm?" and "Say it." for
+         * "say it". A transcript that holds anything more is his and is kept whole.
+         */
+        fun isEchoOf(transcript: String, phoneLines: Collection<String>): Boolean {
+            val heard = bare(transcript)
+            return heard.isNotEmpty() && phoneLines.any { bare(it) == heard }
+        }
+
+        private fun bare(text: String): String =
+            text.lowercase().filter { it.isLetterOrDigit() || it == ' ' }.split(' ').filter { it.isNotEmpty() }.joinToString(" ")
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/WakeTurn.kt b/app/src/main/java/com/opendroid/ai/core/voice/WakeTurn.kt
new file mode 100644
index 0000000..769d1fe
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/WakeTurn.kt
@@ -0,0 +1,106 @@
+package com.opendroid.ai.core.voice
+
+import java.util.UUID
+
+/**
+ * What happens between the wake phrase and the microphone opening.
+ *
+ * He said the wake phrase, so he is about to talk: whatever the phone was saying is cut
+ * off and wake-word detection pauses. The phone answers with a word or two under an id of
+ * its own, and the microphone opens when that one utterance has ended, not before
+ * ([WakeReplyGate]). If no ending is reported in time, the deadline opens it instead.
+ *
+ * Detection is started again only by the listen that follows. So when the wake reply is
+ * cut off before that listen began (Stop, or a message he typed in the meantime), it is
+ * started again from here. Without that the phone would stop answering to the wake
+ * phrase until a setting was saved or the service restarted.
+ *
+ * The service supplies what each step does. This class decides only the order, so that
+ * the order can be tested without a phone.
+ */
+class WakeTurn(
+    private val pauseDetection: () -> Unit,
+    private val resumeDetection: () -> Unit,
+    /** Cuts off whatever the phone is saying and drops what was waiting to be said. */
+    private val stopSpeech: () -> Unit,
+    /** Speaks the wake reply under the given utterance id and returns the words it said. */
+    private val speakReply: (utteranceId: String) -> String,
+    private val openMicrophone: () -> Unit,
+    private val startDeadline: (task: Runnable, delayMillis: Long) -> Unit,
+    private val cancelDeadline: (task: Runnable) -> Unit,
+    private val newUtteranceId: () -> String = { UUID.randomUUID().toString() }
+) {
+    private val gate = WakeReplyGate()
+
+    // The way out when the end of the wake reply is never reported: the microphone opens
+    // anyway. Opening it stops speech first, so a clip still on its way cannot play into it.
+    private val deadline = Runnable {
+        if (gate.onDeadline()) openMicrophone()
+    }
+
+    // What the phone last said in answer to the wake phrase, to tell it from his words.
+    @Volatile private var lastReply: String? = null
+
+    /** The wake phrase was heard. */
+    fun onWakePhrase() {
+        pauseDetection()
+        stopSpeech()
+        val replyId = newUtteranceId()
+        gate.armFor(replyId)
+        lastReply = speakReply(replyId)
+        cancelDeadline(deadline)
+        startDeadline(deadline, WakeReplyGate.DEADLINE_MILLIS)
+    }
+
+    /** An utterance was said to its end. Opens the microphone when it was the wake reply. */
+    fun onUtteranceDone(utteranceId: String) {
+        if (!gate.onUtteranceDone(utteranceId)) return
+        cancelDeadline(deadline)
+        openMicrophone()
+    }
+
+    /**
+     * Speech was cut off by something he did (Stop, a new message). A wake reply that was
+     * still awaited opens no microphone any more, and since no listen will follow it,
+     * wake-word detection is started again here.
+     */
+    fun onSpeechCutOff() {
+        if (disarm()) resumeDetection()
+    }
+
+    /**
+     * A microphone is opening for his words by another way (the bubble, or this turn's
+     * own). An awaited wake reply opens nothing more; the listen that is starting brings
+     * detection back when it ends.
+     */
+    fun onMicrophoneOpening() {
+        disarm()
+    }
+
+    /**
+     * True when [transcript] is only the phone's own answer to the wake phrase, picked up
+     * by the microphone: the line it just said, or any of [otherWakeLines] (a recogniser
+     * may hear one of her replies as another). That is not something he said. Answered
+     * for the listen that follows a wake reply, and once.
+     */
+    fun isOwnReply(transcript: String, otherWakeLines: Collection<String> = emptyList()): Boolean {
+        val reply = lastReply ?: return false
+        lastReply = null
+        return WakeReplyGate.isEchoOf(transcript, otherWakeLines + reply)
+    }
+
+    /** The listen after the wake reply ended without a transcript: there is nothing left to compare. */
+    fun forgetReply() {
+        lastReply = null
+    }
+
+    /** The service is going away. */
+    fun close() {
+        disarm()
+    }
+
+    private fun disarm(): Boolean {
+        cancelDeadline(deadline)
+        return gate.disarm()
+    }
+}
