diff --git a/app/src/main/java/com/opendroid/ai/core/voice/ListenFor.kt b/app/src/main/java/com/opendroid/ai/core/voice/ListenFor.kt
new file mode 100644
index 0000000..13bcd6a
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/ListenFor.kt
@@ -0,0 +1,37 @@
+package com.opendroid.ai.core.voice
+
+import com.opendroid.ai.core.agent.AgentState
+
+/**
+ * What a microphone that opens for his words listens for.
+ *
+ * While a plan waits for his answer, that answer is what is listened for. A listen for a
+ * new request would put Listening in the place of the proposal and lose it, and his
+ * "approve" would arrive as a chat message, which withdraws the plan it was meant to
+ * run. That holds however the microphone was opened: by the wake phrase, or by a tap on
+ * the floating button.
+ */
+internal sealed interface ListenFor {
+
+    /** A new request. */
+    data object Request : ListenFor
+
+    /** His yes or no to the plan [planId]. Anything else he says is a new request. */
+    data class Answer(val planId: String) : ListenFor
+
+    companion object {
+        /** What to listen for while the loop is in [state]. */
+        fun whileIn(state: AgentState): ListenFor =
+            (state as? AgentState.PlanProposed)?.let { Answer(it.plan.planId) } ?: Request
+
+        /**
+         * What the floating button shows for [state]. The listen for his answer leaves
+         * the proposal in place, so by the state alone the button would look the same
+         * before and after he taps it, and he could not tell that the phone is listening.
+         * While a microphone of the app is open over a waiting plan ([microphoneOpen],
+         * see [OpenMicrophones]) the button shows listening.
+         */
+        fun shownOnButton(state: AgentState, microphoneOpen: Boolean): AgentState =
+            if (microphoneOpen && state is AgentState.PlanProposed) AgentState.Listening else state
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/OpenMicrophones.kt b/app/src/main/java/com/opendroid/ai/core/voice/OpenMicrophones.kt
new file mode 100644
index 0000000..60acb96
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/OpenMicrophones.kt
@@ -0,0 +1,49 @@
+package com.opendroid.ai.core.voice
+
+import java.util.Collections
+import java.util.IdentityHashMap
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Whether a recogniser of this app has the microphone open for his words.
+ *
+ * Nothing is said while one has: a recogniser writes down whatever it hears, the phone's
+ * own voice included, and hands that on as something he said. The service that speaks
+ * and the chat screen each have a recogniser of their own, so the fact is kept here, in
+ * the one place both reach. Every [SpeechRecognitionEngine] says when it starts to listen
+ * and when it has stopped, and [TextToSpeechEngine] holds its lines for as long as any of
+ * them is listening.
+ *
+ * The wake-word listener is not counted. In wake-word mode it listens all the time, and
+ * the wake phrase is meant to be heard over the phone's own voice.
+ */
+object OpenMicrophones {
+
+    private val listening: MutableSet<Any> = Collections.newSetFromMap(IdentityHashMap())
+    private val state = MutableStateFlow(false)
+
+    /** True while at least one recogniser is listening. */
+    val open: StateFlow<Boolean> = state
+
+    /** [recogniser] has started to listen. Saying so twice is the same as saying it once. */
+    @Synchronized
+    fun opened(recogniser: Any) {
+        listening += recogniser
+        state.value = true
+    }
+
+    /** [recogniser] has stopped: a result or an error came back, or it was cancelled. */
+    @Synchronized
+    fun closed(recogniser: Any) {
+        listening -= recogniser
+        state.value = listening.isNotEmpty()
+    }
+
+    /** For a listen that never reported its end: it must not keep the phone silent for good. */
+    @Synchronized
+    fun forgetAll() {
+        listening.clear()
+        state.value = false
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt b/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt
new file mode 100644
index 0000000..6a54f07
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/PreferredRecognizer.kt
@@ -0,0 +1,183 @@
+package com.opendroid.ai.core.voice
+
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import androidx.annotation.ChecksSdkIntAtLeast
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+
+/**
+ * Chooses where speech is turned into text.
+ *
+ * The system's default recogniser belongs to whoever made the phone's speech service,
+ * and many of them send the audio to their servers. In wake-word mode that is the sound
+ * of the room, all the time. So recognition on the phone itself is preferred wherever the
+ * phone can do it, in this order:
+ *
+ *  1. Android 12 and later have a recogniser that is guaranteed not to leave the device.
+ *     It is used when the phone says it has one.
+ *  2. Otherwise the default recogniser is used and asked to work offline (see
+ *     [preferOffline]). The platform describes that request as "only use an offline
+ *     engine"; a service is free to honour it or to ignore it.
+ *  3. When the default recogniser says it cannot do that, it is asked again without the
+ *     request, and from then on the audio may go to the speech service's servers. This
+ *     step is taken only where the owner lets a company read what he says anyway
+ *     ([cloudAllowed]). Everywhere else the listener stays on step 2 and says in plain
+ *     words that the phone cannot do this offline ([OFFLINE_UNAVAILABLE]): what he
+ *     says, and in wake-word mode the sound of the room, is not sent to a speech
+ *     service behind his back.
+ *
+ * Which of these a listener is on is kept in a [Choice]. A step down is never taken back
+ * while the listener lives; a new listener starts from the top again.
+ */
+internal object PreferredRecognizer {
+
+    /**
+     * Whether speech may be recognised by the plain default recogniser, whose maker may
+     * get the audio: only under the one route policy that already lets a company read
+     * what he says. Not known yet counts as no.
+     */
+    fun cloudAllowed(config: LLMConfig?): Boolean = config?.routePolicy == RoutePolicy.ANY
+
+    /**
+     * How the offline language is got, and why the online recogniser is not used in its
+     * place. It names the setting; it does not urge him to loosen it.
+     */
+    const val OFFLINE_REMEDY =
+        "Download your language for offline speech recognition in the phone's settings (on most phones: " +
+            "Settings, System, Languages, Speech or On-device recognition), then try again. The online " +
+            "recogniser is not used, because \"Where a model may run\" under Privacy does not allow plain hosted models."
+
+    /**
+     * What a listener reports when the phone cannot turn speech into text without the
+     * network and the online recogniser may not be used.
+     */
+    const val OFFLINE_UNAVAILABLE =
+        "This phone cannot turn speech into text offline in your language, so nothing was listened to. $OFFLINE_REMEDY"
+
+    /** A recogniser, and whether it is the one that stays on the phone. */
+    class Handle(val recognizer: SpeechRecognizer, val onDevice: Boolean)
+
+    // SpeechRecognizer.ERROR_LANGUAGE_NOT_SUPPORTED and ERROR_LANGUAGE_UNAVAILABLE, which
+    // only have names from Android 12 on.
+    private const val ERROR_LANGUAGE_NOT_SUPPORTED = 12
+    private const val ERROR_LANGUAGE_UNAVAILABLE = 13
+
+    @ChecksSdkIntAtLeast(api = Build.VERSION_CODES.S)
+    fun isOnDeviceAvailable(context: Context): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && SpeechRecognizer.isOnDeviceRecognitionAvailable(context)
+
+    /**
+     * The on-device recogniser when there is one and [allowOnDevice] is true, else the
+     * default one, else null when the phone cannot recognise speech at all. Must be
+     * called on the main thread, like the platform calls it wraps.
+     */
+    fun create(context: Context, allowOnDevice: Boolean = true): Handle? {
+        if (allowOnDevice && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && isOnDeviceAvailable(context)) {
+            try {
+                return Handle(SpeechRecognizer.createOnDeviceSpeechRecognizer(context), onDevice = true)
+            } catch (e: Exception) {
+                // The phone reported one and could not start it; the default is tried next.
+            }
+        }
+        if (!SpeechRecognizer.isRecognitionAvailable(context)) return null
+        return Handle(SpeechRecognizer.createSpeechRecognizer(context), onDevice = false)
+    }
+
+    /** Asks the default recogniser to do its work without the network. */
+    fun preferOffline(intent: Intent): Intent = intent.putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
+
+    /**
+     * Asks the recogniser to hand over the words as they were said. From Android 13 on a
+     * recogniser replaces swear words and sexual words with asterisks unless a request
+     * says not to, so what he says to her would arrive censored. Older versions have no
+     * such request: there the masking is a setting of the phone's own speech service
+     * ("Block offensive words"), which only the owner can switch off.
+     */
+    fun unmasked(intent: Intent): Intent {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            intent.putExtra(RecognizerIntent.EXTRA_MASK_OFFENSIVE_WORDS, false)
+        }
+        return intent
+    }
+
+    /**
+     * True when [error] says the recogniser does not have the language, or has not got
+     * it on the phone. The on-device recogniser knows fewer languages than the default
+     * one, and the default one asked to work offline has only the languages that were
+     * downloaded.
+     */
+    fun isLanguageFailure(error: Int): Boolean =
+        error == ERROR_LANGUAGE_NOT_SUPPORTED || error == ERROR_LANGUAGE_UNAVAILABLE
+
+    /** True when [error] says the recogniser wanted a network or a server and did not get one. */
+    fun isNetworkFailure(error: Int): Boolean =
+        error == SpeechRecognizer.ERROR_NETWORK ||
+            error == SpeechRecognizer.ERROR_NETWORK_TIMEOUT ||
+            error == SpeechRecognizer.ERROR_SERVER
+
+    /**
+     * What one listener has found out about the phone so far, and so what it asks for
+     * next. See the order at the top of this file.
+     *
+     * [cloudAllowed] is asked each time it matters, so a change of the setting holds for
+     * a listener that is already running. It defaults to no: a listener built without
+     * settings never leaves the offline request.
+     */
+    class Choice(private val cloudAllowed: () -> Boolean = { false }) {
+
+        /** False once the on-device recogniser has said it lacks the language. */
+        var allowOnDevice = true
+            private set
+
+        // False once the default recogniser has shown it cannot work offline.
+        private var offlineWorks = true
+
+        /**
+         * Whether the next request carries the offline request. The on-device recogniser
+         * needs no asking. The default one is asked until it has shown that it cannot,
+         * and always while the online recogniser may not be used.
+         */
+        fun asksOffline(onDevice: Boolean): Boolean = !onDevice && (offlineWorks || !cloudAllowed())
+
+        /**
+         * True when [error] is the default recogniser saying it cannot do what the
+         * offline request asked, in a listener that may not go on without the request.
+         * The listen has then failed for good until the language is on the phone, and
+         * the caller reports [OFFLINE_UNAVAILABLE].
+         */
+        fun offlineUnavailable(onDevice: Boolean, error: Int): Boolean =
+            !onDevice && !cloudAllowed() && (isLanguageFailure(error) || isNetworkFailure(error))
+
+        /**
+         * Takes in [error] from a recogniser that was the on-device one or not. True when
+         * the error only says that the present choice is not to be had on this phone: the
+         * caller then listens again at once with the next one and reports nothing. False
+         * for every other error, which is reported as it always was.
+         */
+        fun onError(onDevice: Boolean, error: Int): Boolean {
+            if (onDevice) {
+                if (!isLanguageFailure(error)) return false
+                allowOnDevice = false
+                return true
+            }
+            // The offline request is the last step there is while the online recogniser
+            // may not be used: nothing is given up, and the error is the caller's to report.
+            if (!cloudAllowed()) return false
+            if (!offlineWorks) return false
+            if (isLanguageFailure(error)) {
+                offlineWorks = false
+                return true
+            }
+            // Some speech services answer an offline request they cannot serve with a
+            // network or server error instead. Either way the recogniser was not working
+            // offline, so asking again buys nothing. The error may also be a real one, so
+            // it is still reported; only the next request changes.
+            if (isNetworkFailure(error)) offlineWorks = false
+            return false
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/SpeechPieces.kt b/app/src/main/java/com/opendroid/ai/core/voice/SpeechPieces.kt
new file mode 100644
index 0000000..0b015a0
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/SpeechPieces.kt
@@ -0,0 +1,62 @@
+package com.opendroid.ai.core.voice
+
+/**
+ * Cuts a long line into pieces the phone's own voice will take.
+ *
+ * Android's speech engine refuses a text longer than its limit outright: nothing is
+ * heard, and the line would be over without a word of it having been said. A long reply
+ * is therefore handed over in pieces, one behind the other. A piece ends where a
+ * sentence ends when one ends in reach, else between two words, and only a single word
+ * longer than a whole piece is cut inside.
+ */
+internal object SpeechPieces {
+
+    /** The end of a sentence with the space behind it, or a line break. */
+    private val SENTENCE_END = Regex("""[.!?…]+["'”’)\]]*\s|\n""")
+
+    /** [text] in pieces of at most [maxChars] characters, in order, none of them empty. */
+    fun split(text: String, maxChars: Int): List<String> {
+        require(maxChars > 0) { "A piece needs room for at least one character." }
+        val pieces = ArrayList<String>()
+        var rest = text.trim()
+        while (rest.length > maxChars) {
+            val cut = cutPoint(rest, maxChars)
+            pieces += rest.substring(0, cut).trim()
+            rest = rest.substring(cut).trim()
+        }
+        pieces += rest
+        return pieces.filter { it.isNotEmpty() }
+    }
+
+    /** How many characters of [text] make the next piece: always at least one and at most [maxChars]. */
+    private fun cutPoint(text: String, maxChars: Int): Int {
+        val window = text.substring(0, maxChars)
+        SENTENCE_END.findAll(window).lastOrNull()?.let { return it.range.last + 1 }
+        val space = window.indexOfLast(Char::isWhitespace)
+        if (space > 0) return space
+        // One unbroken run of characters. A pair that makes up one character stays together.
+        return if (maxChars > 1 && Character.isHighSurrogate(window.last())) maxChars - 1 else maxChars
+    }
+
+    /**
+     * Hands [pieces] to the engine through [speak], the first in place of whatever the
+     * engine held and the others queued behind it, each under its id from [ids]. False
+     * as soon as the engine refuses one: the line was then not said to its end.
+     */
+    fun queue(pieces: List<String>, ids: List<String>, speak: (text: String, flush: Boolean, id: String) -> Boolean): Boolean {
+        for ((index, piece) in pieces.withIndex()) {
+            if (!speak(piece, index == 0, ids[index])) return false
+        }
+        return true
+    }
+
+    /**
+     * The utterance ids for the pieces of one line. The last piece carries [lineId], so
+     * the line has ended when the engine reports that id; the ones before it get ids of
+     * their own that no other line can have.
+     */
+    fun ids(lineId: String, pieces: Int): List<String> =
+        List(pieces) { index -> if (index == pieces - 1) lineId else "$lineId$PIECE_MARK$index" }
+
+    private const val PIECE_MARK = "#piece-"
+}
