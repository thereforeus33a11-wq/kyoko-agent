+++ b/app/src/main/java/com/opendroid/ai/core/llm/providers/VeniceE2eeMessages.kt
@@ -0,0 +1,88 @@
+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.opendroid.ai.data.models.ChatMessage
+import java.math.BigInteger
+import okio.BufferedSource
+
+/** Shapes a request for the encrypted exchange and reads the encrypted reply. */
+internal object VeniceE2eeMessages {
+
+    class Folded(val system: String, val user: String)
+
+    /**
+     * The protocol encrypts system and user messages only; an assistant message would
+     * travel in the clear. So the earlier conversation, her side included, is folded
+     * into the encrypted system text, and only the newest user message is sent as the
+     * user turn. Images are left out: this path is text only.
+     */
+    fun fold(systemPrompt: String, messages: List<ChatMessage>): Folded {
+        val lastUser = messages.indexOfLast { it.sender == ChatMessage.Sender.USER }
+        val earlier = messages.filterIndexed { index, _ -> index != lastUser }
+            .filter { it.text.isNotBlank() }
+        val system = if (earlier.isEmpty()) {
+            systemPrompt
+        } else {
+            buildString {
+                append(systemPrompt.trimEnd())
+                append("\n\n=== EARLIER IN THIS CONVERSATION (oldest first) ===\n")
+                earlier.forEach { message ->
+                    val who = if (message.sender == ChatMessage.Sender.USER) "User" else "You"
+                    append(who).append(": ").append(message.text.trim()).append('\n')
+                }
+            }.trimEnd()
+        }
+        val user = messages.getOrNull(lastUser)?.text?.takeIf { it.isNotBlank() } ?: "(continue)"
+        return Folded(system, user)
+    }
+
+    /**
+     * Reads the reply, which arrives as server-sent events whose content pieces are each
+     * encrypted to [privateKey]'s public key. A reply that arrives as one JSON object
+     * instead is read the same way.
+     */
+    fun readReply(source: BufferedSource, privateKey: BigInteger): String {
+        val text = StringBuilder()
+        val unframed = StringBuilder()
+        var sawEvents = false
+        while (true) {
+            val line = source.readUtf8Line() ?: break
+            if (line.startsWith("data:")) {
+                sawEvents = true
+                val data = line.removePrefix("data:").trim()
+                if (data.isEmpty() || data == "[DONE]") continue
+                val content = parse(data)?.let(::deltaContent) ?: continue
+                text.append(open(content, privateKey))
+            } else if (!sawEvents) {
+                unframed.append(line)
+            }
+        }
+        if (!sawEvents && unframed.isNotBlank()) {
+            parse(unframed.toString())?.let(::messageContent)?.let { text.append(open(it, privateKey)) }
+        }
+        return text.toString()
+    }
+
+    private fun open(content: String, privateKey: BigInteger): String =
+        if (VeniceE2ee.looksEncrypted(content)) VeniceE2ee.decrypt(content, privateKey) else content
+
+    private fun parse(json: String): JsonObject? = try {
+        JsonParser.parseString(json).takeIf { it.isJsonObject }?.asJsonObject
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun firstChoice(root: JsonObject): JsonObject? =
+        root.get("choices")?.takeIf { it.isJsonArray }?.asJsonArray?.firstOrNull()
+            ?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun deltaContent(root: JsonObject): String? = stringField(firstChoice(root), "delta")
+
+    private fun messageContent(root: JsonObject): String? = stringField(firstChoice(root), "message")
+
+    private fun stringField(choice: JsonObject?, holder: String): String? =
+        choice?.get(holder)?.takeIf { it.isJsonObject }?.asJsonObject
+            ?.get("content")?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+            ?.takeIf { it.isNotEmpty() }
+}
