--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/ui/viewmodel/OwnLifeViewModel.kt
@@ -0,0 +1,165 @@
+package com.opendroid.ai.ui.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.life.eyes.EyesModels
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.life.reading.Feeds
+import com.opendroid.ai.core.life.reading.HerFeeds
+import com.opendroid.ai.core.life.reading.HerFetcher
+import com.opendroid.ai.data.models.LLMConfig
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** A YouTube channel found from an address he pasted: its id and its name. */
+data class FoundChannel(val id: String, val name: String)
+
+private val OG_TITLE = Regex("""<meta[^>]+property=["']og:title["'][^>]+content=["']([^"']{1,120})["']""")
+private val TITLE = Regex("""<title[^>]*>([^<]{1,160})</title>""", RegexOption.IGNORE_CASE)
+
+/** The channel's name on its page: og:title, else the page title without " - YouTube"; null when neither is there. */
+internal fun channelNameInPage(html: String): String? {
+    val raw = OG_TITLE.find(html)?.groupValues?.get(1) ?: TITLE.find(html)?.groupValues?.get(1)?.removeSuffix(" - YouTube")
+    return raw?.let(Feeds::plain)?.takeIf { it.isNotBlank() }
+}
+
+/**
+ * Finds the channel an address he pasted names: `youtube.com/channel/UC…` holds the id
+ * itself; any other channel address (`youtube.com/@name`) is fetched once, by her
+ * fetcher's rules, and the id read off the page. [page] gives a page's text, or null
+ * when it could not be had. The name comes from the page where there is one.
+ */
+internal suspend fun findChannel(address: String, page: suspend (String) -> String?): FoundChannel? {
+    val text = address.trim()
+    if (text.isEmpty()) return null
+    val url = if ("://" in text) text else "https://$text"
+    val inAddress = Feeds.channelIdOf(url)
+    val html = if (url.startsWith("https://") && isYouTube(url)) page(url) else null
+    val id = inAddress ?: html?.let(Feeds::channelIdInPage) ?: return null
+    return FoundChannel(id, html?.let(::channelNameInPage) ?: "YouTube channel")
+}
+
+private fun isYouTube(url: String): Boolean {
+    val host = url.substringAfter("://").substringBefore('/').substringBefore('?').lowercase()
+    return host == "youtube.com" || host.endsWith(".youtube.com")
+}
+
+/**
+ * The own-life card's feeds: the feeds she follows herself, which he can take off, and
+ * the YouTube channels he adds by pasting a channel's address. And the check made when he
+ * chooses a model for her eyes ([HerEyes.checkModel]).
+ */
+@HiltViewModel
+class OwnLifeViewModel internal constructor(
+    private val herFeeds: HerFeeds,
+    private val page: suspend (String) -> String?,
+    private val checkModel: suspend (LLMConfig, String) -> EyesModels.Verdict = { _, id -> EyesModels.judge(id, null) }
+) : ViewModel() {
+
+    @Inject
+    constructor(herFeeds: HerFeeds, fetcher: HerFetcher, eyes: HerEyes) : this(
+        herFeeds,
+        { url -> (fetcher.fetch(url) as? HerFetcher.Fetched.Page)?.text() },
+        eyes::checkModel
+    )
+
+    /** What came of the last model he chose for her eyes; empty before. */
+    var eyesStatus by mutableStateOf("")
+        private set
+
+    /** True while a model for her eyes is being checked. */
+    var checkingEyes by mutableStateOf(false)
+        private set
+
+    /**
