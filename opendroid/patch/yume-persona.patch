+                "London, United Kingdom"
+            },
+            placeNameLookupAllowed = {
+                asked.incrementAndGet()
+                false
+            }
+        )
+        val workingMemory = WorkingMemory(context, provider)
+
+        // Asked for directly, and read the way a prompt and the Memory screen read it.
+        assertEquals("51.51, -0.13", provider.refreshLocationContext(LAT, LNG))
+        assertEquals("51.51, -0.13", workingMemory.locationContext)
+        // A second background refresh starts only when the first has run to its end, so
+        // once the question has been put three times the first one is over.
+        withTimeout(5000) {
+            while (asked.get() < 3) {
+                assertEquals("51.51, -0.13", workingMemory.locationContext)
+                delay(10)
+            }
+        }
+
+        assertEquals(emptyList<Pair<Double, Double>>(), handedOver.toList())
+        assertEquals(null, provider.resolvedLocation.value)
+        // She is still told where he is on a private route, to about a kilometre.
+        assertTrue(provider.getFullStateString().endsWith("Location: 51.51, -0.13"))
+    }
+
+    @Test
+    fun `anything built without settings keeps his position on the phone`() = runBlocking {
+        var lookups = 0
+        val provider = DeviceStateProvider(context, ReverseGeocoder { _, _ ->
+            lookups++
+            "London, United Kingdom"
+        })
+
+        assertEquals("51.51, -0.13", provider.refreshLocationContext(LAT, LNG))
+        assertEquals(0, lookups)
+    }
+
+    @Test
+    fun `the app's own provider asks the geocoder only while private mode is off`() = runBlocking {
+        var lookups = 0
+        val settings = newSettings()
+        val provider = DeviceStateProvider(
+            context,
+            ReverseGeocoder { _, _ ->
+                lookups++
+                "London, United Kingdom"
+            },
+            placeNameLookupAllowed = DeviceStateProvider.lookupAllowedBy(settings)
+        )
+
+        // Private mode is on as the build ships.
+        assertTrue(settings.llmConfig.first().privateMode)
+        assertEquals("51.51, -0.13", provider.refreshLocationContext(LAT, LNG))
+        assertEquals(0, lookups)
+        assertEquals(null, provider.resolvedLocation.value)
+
+        settings.updateConfig { it.copy(privateMode = false) }
+        assertEquals("London, United Kingdom", provider.refreshLocationContext(LAT, LNG))
+        assertEquals(1, lookups)
+
+        // Switched on again: the next cell he moves into is not looked up.
+        settings.updateConfig { it.copy(privateMode = true) }
+        assertEquals("51.61, -0.13", provider.refreshLocationContext(LAT + 0.1, LNG))
+        assertEquals(1, lookups)
+
+        // That is the answer the injected provider is built with.
+        val source = java.io.File("src/main/java/com/opendroid/ai/core/agent/DeviceStateProvider.kt").readText()
+        assertTrue(source.contains("placeNameLookupAllowed = lookupAllowedBy(settingsRepository)"))
+    }
+
+    /** A provider that may look place names up, as the app's own is while private mode is off. */
+    private fun lookingUp(geocoder: ReverseGeocoder) =
+        DeviceStateProvider(context, geocoder, placeNameLookupAllowed = { true })
+
+    private fun newSettings() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-location-test").resolve("settings.preferences_pb").toFile()
+            }
+        ),
+        providerCredentialStore = NoCredentials,
+        runStartupMigration = false
+    )
+
+    private object NoCredentials : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+
     private fun setLastKnownLocation(lat: Double, lng: Double) {
         val locationManager = context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
         shadowOf(locationManager).setProviderEnabled(LocationManager.NETWORK_PROVIDER, true)
