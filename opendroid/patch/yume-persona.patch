+/**
+ * The texts of the privacy card that speak of her. With [hers] false (the app runs as
+ * stock: no card, or the switch off) they speak of the app alone, since there is then
+ * no card, no notebook and no reply route of hers to speak of.
+ */
+internal object PrivacyWording {
+    fun mainRouteLabel(hers: Boolean): String = if (hers) "Your commands and plans" else "Commands, plans and replies"
+
+    fun plainHostedAllowed(hers: Boolean): String =
+        "A plain hosted model is allowed. Whoever hosts it can read what it is sent: the conversation" +
+            (if (hers) ", her card" else "") + " and, unless the switch below is on, your details."
+
+    /** Under "Only this phone or my own network". It speaks of models, which is what that choice decides. */
+    const val OWN_HARDWARE_ONLY =
+        "No model at a company is used: a model that is not on this phone or on your own network is refused " +
+            "before anything is sent to it."
+
+    /**
+     * Under "That, or end to end encrypted": what the phone checks about the key it
+     * encrypts to and what it takes on the host's word, as VeniceE2ee.modelKeyFromAttestation
+     * has it. A test holds these sentences against that code.
+     */
+    const val ENCRYPTED_ONLY =
+        "A model at a company is used only end to end encrypted (a model id starting with e2ee-): the prompt is " +
+            "encrypted on this phone to a key that Venice presents as the key of a sealed enclave running the " +
+            "model. The phone checks that the proof of that is fresh, names this model, carries this key and " +
+            "does not come from an enclave in debug mode. It does not check the hardware maker's signature on " +
+            "the proof, so that the key belongs to a real enclave rests on Venice's word: a Venice that set out " +
+            "to cheat could read the prompt. The only route that needs no such trust, and where nothing leaves " +
+            "at all, is your own hardware. A plain hosted model is refused before anything is sent."
+
+    /**
+     * What private mode keeps back, and from whom. The last sentence is the one thing it
+     * does on every route: his position is not handed to the geocoding service
+     * (DeviceStateProvider.lookupAllowedBy).
+     */
+    fun privateModeHint(hers: Boolean): String = if (hers) {
+        "Your date of birth, where you are, the text of your notifications, what the phone read out to you, what she has noted about you and her own thoughts are left out of anything sent to a model that can be read by its host. " +
+            "Noted about you means every note of hers that can be about you: her notes about you and about the two of you, her threads and opinions other than her street stories, any other note that speaks of you, and what she saw on your screen. " +
+            "On a private route (this phone, your own network, or the end to end encrypted one) she sees all of it. $POSITION_STAYS she gets it as coordinates rounded to about a kilometre."
+    } else {
+        "Your date of birth, where you are, the text of your notifications and what the phone read out to you are left out of anything sent to a model that can be read by its host. On a private route (this phone, your own network, or the end to end encrypted one) the model gets all of it. $POSITION_STAYS the model gets it as coordinates rounded to about a kilometre."
+    }
+
+    private const val POSITION_STAYS =
+        "While this is on, your position is also not sent to the phone's geocoding service to be turned into a " +
+            "place name: on a private route"
+
+    /**
+     * What private mode does not keep back: a screen he asks to have read. The app's
+     * screen reader (VisionEngine) sends the screenshot, or the text on the screen, to
+     * the main model and reads no setting, and a model of hers that is shown screenshots
+     * gets the screenshot with his message whatever her route holds back
+     * (PersonaEngine.imagesReachChatModel). Said at the switch, because the hint above
+     * it speaks of "anything sent" to a readable host, and what is on a screen can be
+     * the text of a notification.
+     */
+    fun screenOnRequest(hers: Boolean): String =
+        "This switch does not keep back a screen you ask to have read: \"read my screen\" sends the screenshot, " +
+            "or the text on the screen, to the main model" +
+            (if (hers) ", or the screenshot to her model when that is shown screenshots" else "") +
+            ", also when that is a plain hosted model." + OWN_CHAT_NOT_READ
+
+    fun storedOnThisPhone(hers: Boolean): String =
+        (if (hers) {
+            "Everything she knows is stored on this phone only: the chat, her notebook, her own thoughts, her files."
+        } else {
+            "The chat and what the app has stored about you are on this phone only."
+        }) + " Backups to the cloud are switched off for this app. An ElevenLabs voice sends each line it speaks to ElevenLabs, so it is used only when plain hosted models are allowed, and while the switch above is on " +
+            (if (hers) "only for her own lines, and only when those come from a plain hosted model" else "not at all") +
+            "; everything else is said by the phone's own voice."
+
+    /**
+     * Where what he says is turned into text, from what the phone offers ([onDevice]:
+     * Android's on-device recogniser is there; [anyRecogniser]: a speech service is
+     * installed at all) and from whether the online recogniser may be used
+     * ([cloudAllowed], PreferredRecognizer.cloudAllowed). Worded from the order of
+     * choices in PreferredRecognizer; a test holds it against that code.
+     */
+    fun voiceInput(onDevice: Boolean, anyRecogniser: Boolean, cloudAllowed: Boolean): String {
+        if (!anyRecogniser) {
+            return if (onDevice) {
+                "Voice input: speech is turned into text by Android's on-device recogniser, on this phone. " +
+                    "It is the only recogniser here: where it does not have your language there is no voice input."
+            } else {
+                "Voice input: this phone has no speech recogniser, so there is no voice input and no wake phrase."
+            }
+        }
+        val first = if (onDevice) {
+            "Voice input: this phone has Android's on-device recogniser, which turns speech into text on the " +
+                "phone, and it is used first. Where it does not have your language, the phone's speech service " +
+                "is asked to work offline instead."
+        } else {
+            "Voice input: this phone has no on-device recogniser of Android's (Android 12 and later can have " +
+                "one), so the phone's speech service is asked to work offline."
+        }
+        val request = " That is a request the speech service can ignore: whether it keeps to it is up to its maker."
+        val last = if (cloudAllowed) {
+            " When the service answers that it cannot work offline, it is asked again without the request, and " +
+                "what you say can then go to its maker's servers. In wake-word mode that is the sound of the room."
+        } else {
+            " When the service answers that it cannot work offline, voice input stops and says so. It is asked " +
+                "without the request only when \"$ROUTE_POLICY_ANY_LABEL\" is chosen above."
+        }
+        return first + request + last
+    }
+}
+
+/**
+ * What an e2ee- model id means, without claiming more than the phone checks: the full
+ * account of what is checked and what is trusted is on the privacy card.
+ */
+internal const val E2EE_MODEL_HINT =
+    "A model id that starts with e2ee- is spoken to end to end encrypted: the prompt is encrypted on this phone " +
+        "to the key presented for the sealed enclave that runs the model. What the phone checks about that key, " +
+        "and what it takes on the host's word, is said under Privacy."
+
+/** Where a model may run, what each configured route is, and what is held back on a readable one. */
+@Composable
+fun PrivacyCard(
+    config: LLMConfig,
+    viewModel: SettingsViewModel,
+    presence: PersonaPresenceViewModel = hiltViewModel()
+) {
+    val mainRoute = RouteClassifier.mainRoute(config)
+    val herRoute = RouteClassifier.personaRoute(config)
+    // Whether she is the one who talks: null until that is known.
+    val hers: Boolean? = presence.active.collectAsState().value
+    // What this phone has to turn speech into text with, asked of the phone itself.
+    val context = LocalContext.current
+    val onDeviceSpeech = remember { PreferredRecognizer.isOnDeviceAvailable(context) }
+    val anySpeech = remember { android.speech.SpeechRecognizer.isRecognitionAvailable(context) }
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            Text(
+                text = "PRIVACY",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            SettingChoiceRow(
+                label = "Where a model may run",
+                options = ROUTE_POLICY_CHOICES,
+                selected = config.routePolicy,
+                onSelect = viewModel::updateRoutePolicy
+            )
+            // The rest is worded for her or for the stock app. Until it is known which,
+            // none of it is shown: a build that runs as stock must not open with a line
+            // about her replies and her notebook.
+            if (hers == null) return@Column
+            RouteLine(PrivacyWording.mainRouteLabel(hers), mainRoute, config.routePolicy.allows(mainRoute))
+            if (hers) RouteLine("Her replies and her notebook", herRoute, config.routePolicy.allows(herRoute))
+            // What a label above takes on trust, where it does.
+            (mainRoute.smallPrint ?: herRoute.smallPrint.takeIf { hers })?.let { smallPrint ->
+                Text(text = smallPrint, fontSize = 10.sp, color = TextSecondary)
+            }
+            Text(
+                text = when (config.routePolicy) {
+                    RoutePolicy.OWN_HARDWARE -> PrivacyWording.OWN_HARDWARE_ONLY
+                    RoutePolicy.ENCRYPTED -> PrivacyWording.ENCRYPTED_ONLY
+                    RoutePolicy.ANY -> PrivacyWording.plainHostedAllowed(hers)
+                },
+                fontSize = 10.sp,
+                color = if (config.routePolicy == RoutePolicy.ANY) AccentCyan else TextSecondary
+            )
+            // Speech is not a model request, so the choice above says nothing about it by itself.
+            Text(
+                text = PrivacyWording.voiceInput(onDeviceSpeech, anySpeech, PreferredRecognizer.cloudAllowed(config)),
+                fontSize = 10.sp,
+                color = if (PreferredRecognizer.cloudAllowed(config)) AccentCyan else TextSecondary
+            )
+            SettingSwitchRow(
+                title = "On a plain hosted model, keep my details on this phone",
+                description = PrivacyWording.privateModeHint(hers),
+                checked = config.privateMode,
+                onCheckedChange = viewModel::updatePrivateMode
+            )
+            Text(
+                text = PrivacyWording.screenOnRequest(hers),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            Text(
+                text = PrivacyWording.storedOnThisPhone(hers),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            SettingSwitchRow(
+                title = "Let other programs on this phone drive the app (MCP server)",
+                description = MCP_SERVER_HINT,
+                checked = config.mcpServerEnabled,
+                onCheckedChange = viewModel::updateMcpServerEnabled
+            )
+        }
+    }
+}
+
+/**
+ * What the MCP switch does, from the code that does it (McpServer): it listens on this
+ * phone only, asks for the app's access token, and then runs what it is told.
+ */
+internal const val MCP_SERVER_HINT =
+    "Off, as it ships: nothing on the phone can reach the app. On: the app listens on this phone only, and a " +
+        "program on the phone that holds the app's access token can run any action or shell command through " +
+        "it and read what comes back, with no approval prompt. Leave it off unless you run such a program yourself."
+
+@Composable
+private fun RouteLine(what: String, route: RoutePrivacy, allowed: Boolean) {
+    Text(
+        text = "$what: ${route.label}" + if (allowed) "" else " — refused by the setting above",
+        fontSize = 12.sp,
+        fontFamily = FontFamily.Monospace,
+        color = if (allowed && route.isPrivate) TextPrimary else AccentCyan
+    )
+}
+
+/**
+ * What the provider's stored options do, and which of them are not sent: the app sets
+ * the temperature and the token limit for each call itself (OpenAiCompatExtras), and
+ * with an e2ee- model ([encrypted]) only numbers and switches go out.
+ */
+internal fun hostedOptionsHint(provider: String, encrypted: Boolean): String =
+    "Optional. A JSON object added to every request to $provider, for options the endpoint documents, for " +
+        "example {\"reasoning_effort\": \"none\"}. Ignored unless it is valid JSON. temperature and the token limit " +
+        "(max_tokens, max_completion_tokens) are ignored here, because the app sets them for each call." +
+        if (encrypted) {
+            " With an e2ee- model only numbers and switches from here are sent; anything else is left out."
+        } else {
+            ""
+        }
+
+/** Timeout and extra request-body options for the active hosted OpenAI-compatible provider. */
+@Composable
+fun HostedProviderOptionsCard(config: LLMConfig, viewModel: SettingsViewModel) {
+    val provider = config.activeProvider
+    val savedTimeout = config.resolvedCloudTimeoutSeconds()
+    var timeoutText by remember { mutableStateOf(savedTimeout.toString()) }
+    LaunchedEffect(savedTimeout) {
+        val typed = timeoutText.toIntOrNull()?.let(CloudTimeout::clamp)
+        if (typed != savedTimeout) timeoutText = savedTimeout.toString()
+    }
+    val extraBody = config.extraBodyParams[provider].orEmpty()
+
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp)) {
+            Text(
+                text = "HOSTED MODEL OPTIONS",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = TextPrimary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = timeoutText,
+                onValueChange = { input ->
+                    val digits = input.filter(Char::isDigit).take(3)
+                    timeoutText = digits
+                    digits.toIntOrNull()?.let(viewModel::updateCloudTimeout)
+                },
+                label = { Text("Response Timeout (seconds)", fontSize = 12.sp) },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                colors = fieldColors(),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .onFocusChanged { focus ->
+                        if (!focus.isFocused) timeoutText = savedTimeout.toString()
+                    }
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = "How long to wait for a reply (${CloudTimeout.MIN_SECONDS}–${CloudTimeout.MAX_SECONDS}s). Applies to Custom OpenAI Compatible and OpenRouter.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = extraBody,
+                onValueChange = { viewModel.updateExtraBodyParams(provider, it) },
+                label = { Text("Extra request options (JSON)", fontSize = 12.sp) },
+                isError = !OpenAiCompatExtras.isValidExtraBody(extraBody),
+                minLines = 2,
+                maxLines = 6,
+                colors = fieldColors(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = hostedOptionsHint(provider, RouteClassifier.mainRoute(config) == RoutePrivacy.ENCRYPTED),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+        }
+    }
+}
+
+/** Pitch and rate for the phone's own voice, and the ElevenLabs model. */
+@Composable
+fun SpeechTuningFields(config: LLMConfig, viewModel: SettingsViewModel) {
+    OutlinedTextField(
+        value = config.elevenLabsModelId,
+        onValueChange = viewModel::updateElevenLabsModelId,
+        label = { Text("ElevenLabs Model ID (optional)", fontSize = 12.sp) },
+        singleLine = true,
+        colors = fieldColors(),
+        modifier = Modifier.fillMaxWidth()
+    )
+    SpeechSlider(
+        label = "Phone voice pitch",
+        value = config.ttsPitch,
+        onChange = { viewModel.updateSpeechTuning(it, config.ttsSpeechRate) }
+    )
+    SpeechSlider(
+        label = "Phone voice speed",
+        value = config.ttsSpeechRate,
+        onChange = { viewModel.updateSpeechTuning(config.ttsPitch, it) }
+    )
+    Text(
+        text = "Pitch and speed apply to the phone's own voice. 1.0 is the engine default; lower is deeper and slower.",
+        fontSize = 10.sp,
+        color = TextSecondary
+    )
+}
+
+@Composable
+private fun SpeechSlider(label: String, value: Float, onChange: (Float) -> Unit) {
+    val shown = SpeechTuning.clamp(value)
+    Column {
+        Text(
+            text = "$label: ${"%.2f".format(java.util.Locale.US, shown)}",
+            fontSize = 12.sp,
+            color = TextPrimary
+        )
+        Slider(
+            value = shown,
+            onValueChange = onChange,
+            valueRange = SpeechTuning.MIN..SpeechTuning.MAX,
+            colors = SliderDefaults.colors(thumbColor = AccentCyan, activeTrackColor = AccentCyan)
+        )
+    }
+}
