--- a/app/src/test/java/com/opendroid/ai/core/agent/PlanApprovalSummaryTest.kt
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PlanApprovalSummaryTest.kt
@@ -163,4 +163,287 @@ class PlanApprovalSummaryTest {
             PlanApprovalSummary.stepLines(plan)
         )
     }
+
+    // ── The words that leave the phone ───────────────────────────────────────────────
+
+    private fun texts(vararg steps: PlanStep) =
+        PlanApprovalSummary.outgoingTexts(validated.copy(steps = steps.toList()))
+
+    @Test
+    fun `a message is shown in full, however long, while its step line stays short`() {
+        val message = "I will be late. " + "The bees swarmed again and I have to get them back in the box. ".repeat(12)
+        assertTrue(message.length > 500)
+        val plan = validated.copy(
+            steps = listOf(step("s1", 1, "SEND_SMS", mapOf("contact" to "+19005550100", "message" to message)))
+        )
+
+        assertEquals(
+            listOf(PlanApprovalSummary.OutgoingText(step = 1, param = "message", text = message)),
+            PlanApprovalSummary.outgoingTexts(plan)
+        )
+        // The line that is read aloud does not grow with it.
+        assertEquals("Send SMS to +19005550100", PlanApprovalSummary.stepLines(plan).single())
+        assertFalse(PlanApprovalSummary.spokenPrompt(plan).contains("bees"))
+    }
+
+    @Test
+    fun `a post's own words are what is shown, and its topic only when it has none`() {
+        // The action saves the post's words as they are; the topic is only what the composer writes from without them.
+        val post = step("s1", 1, "SOCIAL_CREATE_POST", mapOf("topic" to "the v1.1 launch", "content" to "v1.1 is out today.", "platform" to "LinkedIn"))
+        assertEquals(listOf(PlanApprovalSummary.OutgoingText(1, "content", "v1.1 is out today.")), texts(post))
+        val noWords = post.copy(params = mapOf("topic" to "the v1.1 launch", "content" to " "))
+        assertEquals(listOf(PlanApprovalSummary.OutgoingText(1, "topic", "the v1.1 launch")), texts(noWords))
+        // Any other action that takes a topic still shows it.
+        assertEquals(listOf("content", "topic"), texts(step("s1", 1, "SEND_TELEGRAM", mapOf("topic" to "launch", "content" to "x"))).map { it.param })
+    }
+
+    @Test
+    fun `every text parameter of a step that sends words out is listed, in step order`() {
+        val found = texts(
+            step("s1", 1, "GET_WEATHER"),
+            step("s2", 2, "SEND_EMAIL", mapOf("to" to "riya@example.com", "subject" to "Jars", "body" to "Forty jars by Friday.")),
+            step("s3", 3, "WEB_SEARCH", mapOf("query" to "varroa treatment in autumn")),
+            step("s4", 4, "PAY_UPI", mapOf("to" to "bob@upi", "amount" to "500", "note" to "for the frames")),
+            step("s5", 5, "PLAY_YOUTUBE", mapOf("query" to "hive inspection")),
+            step("s6", 6, "TYPE_TEXT", mapOf("searchText" to "Message", "content" to "on my way"))
+        )
+        assertEquals(
+            listOf(
+                PlanApprovalSummary.OutgoingText(2, "subject", "Jars"),
+                PlanApprovalSummary.OutgoingText(2, "body", "Forty jars by Friday."),
+                PlanApprovalSummary.OutgoingText(3, "query", "varroa treatment in autumn"),
+                PlanApprovalSummary.OutgoingText(4, "note", "for the frames"),
+                PlanApprovalSummary.OutgoingText(5, "query", "hive inspection"),
+                PlanApprovalSummary.OutgoingText(6, "content", "on my way")
+            ),
+            found
+        )
+    }
+
+    @Test
