--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/OwnLedger.kt
@@ -0,0 +1,446 @@
+package com.opendroid.ai.core.life
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.AbstractCoroutineContextElement
+import kotlin.coroutines.CoroutineContext
+
+/**
+ * What one of her own calls was for. Her replies to him and his commands have no purpose
+ * here: they are never counted.
+ */
+enum class OwnPurpose(val counted: Counted) {
+    /** A moment of her own. */
+    MOMENT(Counted.LIMITED),
+
+    /** One step of an outing. */
+    OUTING_STEP(Counted.LIMITED),
+
+    /** The planner, the re-evaluations and the result line of a `>>` from her own time. */
+    OWN_COMMAND(Counted.LIMITED),
+
+    /** One picture described for her. */
+    EYES(Counted.LIMITED),
+
+    /** A picture of herself made in her own time. */
+    PICTURE(Counted.LIMITED),
+
+    /** Her proposal of a handle and a name for an account of hers. */
+    SIGNUP(Counted.LIMITED),
+
+    /** Her sleep pass: upkeep, bounded already. */
+    SLEEP_PASS(Counted.SHOWN),
+
+    /** Her notebook pass: upkeep, bounded already. */
+    NOTEBOOK(Counted.SHOWN),
+
+    /** A page or a feed fetched for her: no model call. */
+    FETCH(Counted.COUNTER),
+
+    /** A paid search (Venice search) made for her: no model call, a price of its own. */
+    PAID_SEARCH(Counted.COUNTER);
+
+    enum class Counted {
+        /** A model call that counts against his number of calls on her own. */
+        LIMITED,
+
+        /** A model call that is counted and shown but limited by its own bounds. */
+        SHOWN,
+
+        /** Not a model call: only counted. */
+        COUNTER
+    }
+
+    val isModelCall: Boolean get() = counted != Counted.COUNTER
+}
+
+/**
+ * Marks the coroutine a call of her own runs in, with what it is for. Every model call
+ * made inside it, also by a coroutine started inside it (the planner and the
+ * re-evaluations of an own-time command), is recorded by the provider wrapper
+ * ([com.opendroid.ai.core.llm.WrappedLLMProvider]) through [sink]. A call made outside
+ * one is not hers and is never recorded.
+ */
+class OwnCall(val purpose: OwnPurpose, private val sink: Sink) : AbstractCoroutineContextElement(Key) {
+
+    /** Where a call of hers is written down. It never throws. */
+    fun interface Sink {
+        fun record(purpose: OwnPurpose, model: String, promptTokens: Int?, completionTokens: Int?, ok: Boolean)
+    }
+
+    /**
+     * Writes one call down. [ok] is false for a call that failed after it left the phone.
+     * A failure to write it costs nothing else: the reply stays.
+     */
+    fun record(model: String, promptTokens: Int?, completionTokens: Int?, ok: Boolean) {
+        try {
+            sink.record(purpose, model, promptTokens, completionTokens, ok)
+        } catch (e: Exception) {
+            Log.w(TAG, "A call of hers could not be recorded: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * Writes down one call of hers for another purpose than this mark's, made at its call
+     * site rather than through her model: a picture of herself made while this runs
+     * ([OwnPurpose.PICTURE]). [ok] is false for one that failed after it left the phone.
+     */
+    fun recordAs(purpose: OwnPurpose, model: String, ok: Boolean) {
+        try {
+            sink.record(purpose, model, null, null, ok)
+        } catch (e: Exception) {
+            Log.w(TAG, "A call of hers could not be recorded: ${e.javaClass.simpleName}")
+        }
+    }
+
+    override fun toString(): String = "OwnCall($purpose)"
+
+    companion object Key : CoroutineContext.Key<OwnCall> {
+        private const val TAG = "OwnCall"
+    }
+}
+
+/**
+ * Prices per million tokens for the models her own calls go to, to estimate what her day
+ * costs. Prompt caching through the encrypted route is UNCONFIRMED, so every estimate
+ * assumes none. A call whose provider gave no token counts is estimated at a typical size.
+ */
+object OwnPrices {
+
+    data class Rate(val promptPerMillion: Double, val completionPerMillion: Double)
+
+    /** Her end-to-end encrypted chat model. */
+    val HER_E2EE = Rate(promptPerMillion = 0.375, completionPerMillion = 1.50)
+
+    /** The vision models her eyes may use (Venice Private tier). UNCONFIRMED: measured from `usage` on the phone. */
+    val EYES = Rate(promptPerMillion = 0.15, completionPerMillion = 0.60)
+
+    /** What one Venice search costs. */
+    const val PAID_SEARCH_USD = 0.01
+
+    /** A step or a moment of hers: about 12–16k tokens in and 600 out. */
+    const val TYPICAL_PROMPT_TOKENS = 14_000
+    const val TYPICAL_COMPLETION_TOKENS = 600
+
+    /** One picture described: the image and a short instruction in, at most 350 out. */
+    const val TYPICAL_EYES_PROMPT_TOKENS = 1_000
+    const val TYPICAL_EYES_COMPLETION_TOKENS = 350
+
+    private val TABLE: Map<String, Rate> = mapOf(
+        "google-gemma-4-31b-it" to EYES,
+        "mistral-small-3-2-24b-instruct" to EYES,
+        "nvidia-nemotron-3-5-super-vl-120b-a12b" to EYES,
+        "google-gemma-3-27b-it" to EYES,
+        "qwen3-vl-235b-a22b" to EYES
+    )
+
+    /** The rate for [model]: its own where the table has it, else hers, the dearer one. */
+    fun rate(model: String): Rate = TABLE[model.trim().lowercase()] ?: HER_E2EE
+
+    /** What [call] cost, in US dollars, as far as it can be told. */
+    fun usd(call: OwnLedger.Call): Double = when {
+        call.purpose == OwnPurpose.PAID_SEARCH -> PAID_SEARCH_USD
+        // A picture is priced by its image model (Venice's list); anything else under it is the
+        // age check of one, a chat model's call, priced by its tokens (typical ones where a failed
+        // call has none), never as a picture.
+        call.purpose == OwnPurpose.PICTURE -> com.opendroid.ai.core.persona.PictureModels.of(call.model)?.price ?: byTokens(call)
+        !call.purpose.isModelCall -> 0.0
+        else -> byTokens(call)
+    }
+
+    private fun byTokens(call: OwnLedger.Call): Double {
+        val eyes = call.purpose == OwnPurpose.EYES || call.purpose == OwnPurpose.PICTURE
+        val prompt = call.promptTokens ?: if (eyes) TYPICAL_EYES_PROMPT_TOKENS else TYPICAL_PROMPT_TOKENS
+        val completion = call.completionTokens ?: if (eyes) TYPICAL_EYES_COMPLETION_TOKENS else TYPICAL_COMPLETION_TOKENS
+        val rate = rate(call.model)
+        return (prompt * rate.promptPerMillion + completion * rate.completionPerMillion) / 1_000_000.0
+    }
+}
+
+/**
+ * Her own calls, counted. Every model call made under an [OwnCall] is written here with
+ * when it was, what it was for, the model, its token counts and whether it worked; so are
+ * the fetches and paid searches made for her. Her replies to him and his commands are
+ * never written here.
+ *
+ * His number of calls on her own holds over any 24 hours: [left] says how many of them
+ * are left now. An outing starts only with [Start.OUTING] or more left, and each step of
+ * it runs only with [Start.STEP] or more. A ledger that cannot be read answers null and
+ * nothing starts: it fails closed.
+ *
+ * The ledger is one small JSON file in the app's own storage, beside her other files. It
+ * holds no text of anyone's: purposes, model ids, times and counts only. Calls older than
+ * [KEEP_MILLIS] are pruned.
+ */
+@Singleton
+class OwnLedger internal constructor(
+    private val file: () -> File,
+    private val clock: () -> Long
+) : OwnCall.Sink {
+
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(
+        { File(File(context.filesDir, DIRECTORY), FILE) },
+        System::currentTimeMillis
+    )
+
+    /** One call, as written down. */
+    @Serializable
+    data class Call(
+        val at: Long,
+        val purpose: OwnPurpose,
+        val model: String = "",
+        val promptTokens: Int? = null,
+        val completionTokens: Int? = null,
+        val ok: Boolean = true
+    )
+
+    /** What has to be left in the ledger before something may start. */
+    enum class Start(val needsLeft: Int) {
+        /** An outing. */
+        OUTING(20),
+
+        /** One step of a running outing. */
+        STEP(10),
+
+        /** Any other call of hers. */
+        CALL(1)
+    }
+
+    /** What the status card is told: counts and a price, never what any call said. */
+    data class Summary(
+        val used: Int,
+        val cap: Int,
+        val byPurpose: Map<OwnPurpose, Int>,
+        val usd: Double,
+        /** What her eyes cost of [usd]. */
+        val eyesUsd: Double = 0.0
+    ) {
+        val left: Int get() = (cap - used).coerceAtLeast(0)
+
+        /**
+         * The status card's line, counts and a price only: "Calls on her own: 41 of 150 in
+         * the last 24 h (moments 16, outings 19, commands 6). About $0.22."
+         */
+        fun statusLine(): String = statusLine(withCap = true)
+
+        /**
+         * The same line, and without " of <cap>" where his number does not apply (her own
+         * life is off: only her moments' own bounds hold).
+         */
+        fun statusLine(withCap: Boolean): String {
+            val parts = LINE_PARTS.mapNotNull { (purpose, word) ->
+                byPurpose[purpose]?.takeIf { it > 0 }?.let { "$word $it" }
+            }
+            val inBrackets = if (parts.isEmpty()) "" else " (" + parts.joinToString(", ") + ")"
+            val of = if (withCap) " of $cap" else ""
+            return "Calls on her own: $used$of in the last 24 h$inBrackets. About $" + String.format(java.util.Locale.US, "%.2f", usd) + "."
+        }
+
+        /**
+         * Her upkeep calls of the last 24 hours, which are counted and priced but not held
+         * against his number, or null when there were none: "Upkeep, not held against his
+         * number but in the price above: sleep pass 1, notebook 3."
+         */
+        fun upkeepLine(): String? {
+            val parts = UPKEEP_PARTS.mapNotNull { (purpose, word) ->
+                byPurpose[purpose]?.takeIf { it > 0 }?.let { "$word $it" }
+            }
+            if (parts.isEmpty()) return null
+            return "Upkeep, not held against his number but in the price above: " + parts.joinToString(", ") + "."
+        }
+
+        /**
+         * Her eyes in the last 24 hours: "Eyes: 9 pictures in 24 h, of 60. About $0.01.", with
+         * "(camera 1)" after the count where [camera] of them were looks through the camera.
+         * [perDay] is his number of pictures a day.
+         */
+        fun eyesLine(perDay: Int, camera: Int = 0): String {
+            val looked = byPurpose[OwnPurpose.EYES] ?: 0
+            val throughCamera = if (camera > 0) " (camera $camera)" else ""
+            return "Eyes: $looked picture${if (looked == 1) "" else "s"}$throughCamera in 24 h, of $perDay. About $" +
+                String.format(java.util.Locale.US, "%.2f", eyesUsd) + "."
+        }
+
+        /** Pages and feeds fetched for her in the last 24 hours, or null when none: "Pages and feeds fetched for her in 24 h: 12." */
+        fun fetchesLine(): String? =
+            byPurpose[OwnPurpose.FETCH]?.takeIf { it > 0 }?.let { "Pages and feeds fetched for her in 24 h: $it." }
+
+        private companion object {
+            val UPKEEP_PARTS = listOf(
+                OwnPurpose.SLEEP_PASS to "sleep pass",
+                OwnPurpose.NOTEBOOK to "notebook"
+            )
+
+            val LINE_PARTS = listOf(
+                OwnPurpose.MOMENT to "moments",
+                OwnPurpose.OUTING_STEP to "outings",
+                OwnPurpose.OWN_COMMAND to "commands",
+                OwnPurpose.EYES to "eyes",
+                OwnPurpose.PICTURE to "pictures",
+                OwnPurpose.SIGNUP to "signup"
+            )
+        }
+    }
+
+    private val lock = Any()
+
+    // What the file holds once read; null until then and after a read that failed.
+    private var held: List<Call>? = null
+
+    // Calls that could not be written yet. They count all the same.
+    private var unwritten: List<Call> = emptyList()
+
+    // How many of each purpose were written down since the app started, in memory only.
+    private val recordedSinceStart = java.util.concurrent.ConcurrentHashMap<OwnPurpose, java.util.concurrent.atomic.AtomicInteger>()
+
+    /** Writes a call of hers down ([OwnCall.Sink]). */
+    override fun record(purpose: OwnPurpose, model: String, promptTokens: Int?, completionTokens: Int?, ok: Boolean) {
+        recordedSinceStart.getOrPut(purpose) { java.util.concurrent.atomic.AtomicInteger() }.incrementAndGet()
+        add(Call(clock(), purpose, model.take(MAX_MODEL_CHARS), promptTokens?.coerceAtLeast(0), completionTokens?.coerceAtLeast(0), ok))
+    }
+
+    /** Counts something that is not a model call: [OwnPurpose.FETCH] or [OwnPurpose.PAID_SEARCH]. */
+    fun count(purpose: OwnPurpose) {
+        require(!purpose.isModelCall) { "A model call is recorded with its model and tokens" }
+        recordedSinceStart.getOrPut(purpose) { java.util.concurrent.atomic.AtomicInteger() }.incrementAndGet()
+        add(Call(clock(), purpose))
+    }
+
+    /**
+     * How many calls for [purpose] were written down since the app started, whether or not
+     * the file could be written: the host of her outings counts its steps by it, so that a
+     * step that failed after it was sent is in her log as it is here.
+     */
+    fun recorded(purpose: OwnPurpose): Int = recordedSinceStart[purpose]?.get() ?: 0
+
+    /** The context element that marks a coroutine as a call of hers for [purpose]. */
+    fun call(purpose: OwnPurpose): OwnCall = OwnCall(purpose, this)
+
+    /** Every call kept, oldest first, or null when the ledger cannot be read. */
+    fun calls(): List<Call>? = synchronized(lock) { readLocked()?.let { it + unwritten } }
+
+    /** How many of his calls on her own are left now under [cap], or null when the ledger cannot be read. */
+    fun left(cap: Int, now: Long = clock()): Int? = calls()?.let { leftOf(it, cap, now) }
+
+    /** Whether [start] may begin now under [cap]. False when the ledger cannot be read. */
+    fun canStart(start: Start, cap: Int, now: Long = clock()): Boolean {
+        val left = left(cap, now) ?: return false
+        return left >= start.needsLeft
+    }
+
+    /**
+     * When a call is free again under [cap]: now when one is left, else the moment the
+     * oldest counted call that keeps the count at the cap drops out of the 24 hours. Null
+     * when the ledger cannot be read.
+     */
+    fun roomAgainAt(cap: Int, now: Long = clock()): Long? = calls()?.let { roomAgainAt(it, cap, now) }
+
+    /** Counts and a price for the last 24 hours, or null when the ledger cannot be read. */
+    fun summary(cap: Int, now: Long = clock()): Summary? = calls()?.let { summaryOf(it, cap, now) }
+
+    private fun add(call: Call) {
+        synchronized(lock) {
+            unwritten = unwritten + call
+            val fromFile = readLocked() ?: return
+            val all = pruned(fromFile + unwritten, call.at)
+            if (write(all)) {
+                held = all
+                unwritten = emptyList()
+            }
+        }
+    }
+
+    /** What the file holds: empty when there is none, null when it is there and cannot be read. */
+    private fun readLocked(): List<Call>? {
+        held?.let { return it }
+        val target = file()
+        return try {
+            val read = if (!target.isFile) emptyList() else JSON.decodeFromString(ListSerializer(Call.serializer()), target.readText())
+            held = read
+            read
+        } catch (e: Exception) {
+            Log.w(TAG, "The ledger of her calls could not be read: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    private fun write(all: List<Call>): Boolean = try {
+        val target = file()
+        val folder = target.parentFile ?: throw IOException("No directory")
+        if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+        val draft = File(folder, target.name + ".tmp")
+        try {
+            FileOutputStream(draft).use { out ->
+                out.write(JSON.encodeToString(ListSerializer(Call.serializer()), all).toByteArray(Charsets.UTF_8))
+                out.fd.sync()
+            }
+            if (!draft.renameTo(target)) throw IOException("The ledger could not be put in place")
+        } finally {
+            draft.delete()
+        }
+        true
+    } catch (e: Exception) {
+        Log.w(TAG, "The ledger of her calls could not be written: ${e.javaClass.simpleName}")
+        false
+    }
+
+    companion object {
+        private const val TAG = "OwnLedger"
+        private const val DIRECTORY = "persona"
+        private const val FILE = "own_ledger.json"
+        private const val MAX_MODEL_CHARS = 80
+        private val JSON = Json { ignoreUnknownKeys = true }
+
+        /** His number of calls on her own in any 24 hours, as this build ships it. */
+        const val DEFAULT_CALLS_PER_DAY = 150
+
+        /** The window his number holds over. The same rolling 24 hours her moments are bounded in. */
+        const val WINDOW_MILLIS = 24 * 60 * 60_000L
+
+        /** How long calls are kept at all. */
+        const val KEEP_MILLIS = 30 * WINDOW_MILLIS
+
+        /** Whether [call] counts against his number: a limited model call that worked or left the phone. */
+        fun countsAgainstCap(call: Call): Boolean = call.purpose.counted == OwnPurpose.Counted.LIMITED
+
+        private fun inWindow(call: Call, now: Long): Boolean = call.at > now - WINDOW_MILLIS && call.at <= now
+
+        /** The limited calls of the last 24 hours. */
+        fun usedOf(calls: List<Call>, now: Long): Int = calls.count { countsAgainstCap(it) && inWindow(it, now) }
+
+        fun leftOf(calls: List<Call>, cap: Int, now: Long): Int = (cap - usedOf(calls, now)).coerceAtLeast(0)
+
+        fun roomAgainAt(calls: List<Call>, cap: Int, now: Long): Long {
+            val counted = calls.filter { countsAgainstCap(it) && inWindow(it, now) }.map { it.at }.sorted()
+            if (counted.size < cap) return now
+            // The count drops below the cap once this many of the oldest have dropped out.
+            val mustDrop = counted.size - cap + 1
+            return counted[mustDrop - 1] + WINDOW_MILLIS
+        }
+
+        fun summaryOf(calls: List<Call>, cap: Int, now: Long): Summary {
+            val recent = calls.filter { inWindow(it, now) }
+            return Summary(
+                used = recent.count(::countsAgainstCap),
+                cap = cap,
+                byPurpose = recent.groupingBy { it.purpose }.eachCount(),
+                usd = recent.sumOf(OwnPrices::usd),
+                eyesUsd = recent.filter { it.purpose == OwnPurpose.EYES }.sumOf(OwnPrices::usd)
+            )
+        }
+
+        /** [calls] without those older than [KEEP_MILLIS], oldest first. */
+        fun pruned(calls: List<Call>, now: Long): List<Call> =
+            calls.filter { it.at > now - KEEP_MILLIS }.sortedBy { it.at }
+    }
+}
