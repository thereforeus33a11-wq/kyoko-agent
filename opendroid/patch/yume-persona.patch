+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.service.ServiceNotificationText
+import com.opendroid.ai.ui.viewmodel.herDayLine
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+import java.util.TimeZone
+
+/**
+ * How her ears are wired into the service, the notification, her log and her chat: held
+ * against the code, where a phone is needed to run it.
+ */
+class EarsWiringTest {
+
+    private val service = File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+    private val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+
+    @Test
+    fun `while her ears hold the microphone the wake phrase listener stays off, and comes back when they close`() {
+        assertTrue(service.contains("private fun startWakeWordDetection() {\n        // While her ears are open (or only paused) they take the wake phrase listener's place.\n        if (herEars.holdsTheMic) return"))
+        assertTrue(service.contains("if (herEars.holdsTheMic) {\n            wakeWordDetector.stopListening()\n        } else if (!showFloatingButton && !hearingHim) {\n            startWakeWordDetection()\n        }"))
+        // Before they open, the wake phrase listener lets go of the microphone.
+        assertTrue(service.contains("== com.opendroid.ai.core.life.ears.EarsGate.Want.Open && !herEars.holdsTheMic) {\n                kotlinx.coroutines.withContext(Dispatchers.Main) { wakeWordDetector.stopListening() }"))
+    }
+
+    @Test
+    fun `push-to-talk, the chat screen's microphone and the approval listen borrow the microphone`() {
+        assertEquals(2, Regex("""hearingHim = true\n(        // The button has the microphone: her ears give it up until the listen ends.\n)?        herEars\.lend\(true\)""").findAll(service).count())
+        assertEquals(4, Regex("""herEars\.lend\(com\.opendroid\.ai\.core\.voice\.OpenMicrophones\.open\.value\)""").findAll(service).count())
+        assertTrue(service.contains("com.opendroid.ai.core.voice.OpenMicrophones.open.collect { open -> herEars.lend(open) }"))
+    }
+
+    @Test
+    fun `his voice over hers stops her by the speech generation, as the wake phrase does`() {
+        assertTrue(service.contains("override fun overHer() {\n                mainHandler.post { herVoiceCutOff() }"))
+        assertTrue(service.contains("private fun herVoiceCutOff() {\n        approvalListenGate.disarm()\n        textToSpeechEngine.stop()\n        wakeTurn.onSpeechCutOff()\n    }"))
+        // stop() moves the generation on, and a reply said while she writes it says nothing more after that.
+        val tts = File("src/main/java/com/opendroid/ai/core/voice/TextToSpeechEngine.kt").readText()
+        assertTrue(tts.contains("fun stop() {\n        generation.incrementAndGet()"))
+        assertTrue(loop.contains("if (!speechStoppedSince(speechSince)) {"))
+    }
+
+    @Test
+    fun `what is said to her goes the way his voice messages go, and a plan he heard is answered by his yes`() {
+        assertTrue(service.contains("VoiceApprovalIntent.NONE -> agentLoop.processHeard(text, aloud, this)"))
+        assertTrue(service.contains("if (state is AgentState.PlanProposed && state.plan.planId !in notYetAnnounced) {"))
+        // Another voice is talk to her only, never an answer or a command.
+        assertTrue(service.contains("if (!aloud.fromHim) {\n            agentLoop.anotherVoiceSaid(text, aloud, this)\n            return\n        }"))
+        assertTrue(loop.contains("if (!isFreeForCheckIn() || currentJob?.isActive == true) return false"))
+        assertTrue(loop.contains("executeSimpleQuery(row, sessionId, context)"))
+        // Its words are held against a command of hers as outside text (I3).
+        assertTrue(loop.contains("com.opendroid.ai.core.life.ears.EarsPrompt.anotherVoiceWords(storedMsgs)"))
+        assertTrue(loop.contains("com.opendroid.ai.core.life.ears.EarsPrompt.anotherVoiceWords(recent)"))
+        // How he sounded goes to her reply only, from memory, and is never stored with the row.
+        assertTrue(loop.contains("val aloudNow = if (personaOn) heardAloud.remove(userMsg.id) else null"))
+        assertTrue(loop.contains("val heardLine = aloudNow?.let { com.opendroid.ai.core.life.ears.EarsPrompt.aloudLine(it, hearsIt = hearsHim) }"))
+        // His voice itself rides on his message only where her model hears it, and never on a row.
+        assertTrue(loop.contains("msg.copy(imageBase64 = imageForHer, audioBase64 = if (hearsHim) aloudNow?.clipWav else null)"))
+        assertFalse(loop.contains("aloudLine(aloud)"))
+    }
+
+    @Test
+    fun `only his enrolled voice with the phone unlocked gives commands or answers a plan, anything else is talk only`() {
+        val heard = service.substringAfter("private fun onEarsHeard(").substringBefore("private fun phoneLocked()")
+        // Nothing is handed on once the ears closed or paused since it was heard.
+        assertTrue(heard.contains("if (!herEars.isOpen) return"))
+        // A voice before his is enrolled, or any heard while the phone is locked, is talk only: before any yes or no is read.
+        val talkOnly = heard.indexOf("if (!aloud.provenHis || phoneLocked()) {\n            agentLoop.processHeard(text, aloud.asTalkOnly(), this)\n            return\n        }")
+        assertTrue(talkOnly > 0)
+        assertTrue(talkOnly < heard.indexOf("VoiceApprovalParser.parseAnswerOrRequest(text)"))
+        // A phone whose lock cannot be read counts as locked.
+        assertTrue(service.contains("?.isKeyguardLocked != false"))
+        // Talk only never reaches the planner, a shortcut, a screenshot, a pending question or a look.
+        val talk = loop.substringAfter("fun talkHeard(").substringBefore("fun personaHeardHim(")
+        assertTrue(talk.contains("if (!isFreeForCheckIn() || currentJob?.isActive == true) return false"))
+        assertTrue(talk.contains("executeSimpleQuery(row, sessionId, context)"))
+        assertFalse(talk.contains("submitQuery") || talk.contains("processQueryLocked") || talk.contains("ScreenContext"))
+        assertTrue(talk.contains("if (aloud.provenHis) memoryManager.storeMessage(row, sessionId)"))
+        assertTrue(loop.contains("if (aloud.talkOnly) {\n            talkHeard(query, aloud, context)\n            return\n        }"))
+        assertTrue(loop.contains("val notSurelyHis = aloudNow != null && (aloudNow.talkOnly || !aloudNow.fromHim)"))
+        assertTrue(loop.contains("userMsg.text.takeIf { notSurelyHis }"))
+        assertTrue(loop.contains("} else if (notSurelyHis) {"))
+    }
+
+    @Test
+    fun `her ears are looked at again at once when she lies down or a call starts, and never reopen after the service went`() {
+        assertTrue(service.contains("persona.sleepChanges.collect { nudgeEars() }"))
+        assertTrue(service.contains("addOnModeChangedListener(mainExecutor, listener)"))
+        assertTrue(service.contains("removeOnModeChangedListener(listener)"))
+        assertTrue(service.contains("herEars.startUp()\n        herEars.room = object"))
+    }
+
+    @Test
+    fun `the ears close with the service, and are looked at again when he taps Eyes and ears`() {
+        assertTrue(service.contains("herEars.room = null\n        herEars.shutDown()"))
+        assertTrue(service.contains("// Holding the microphone again, her ears may open.\n            nudgeEars()"))
+        assertTrue(service.contains("awake = !persona.isAsleepNow(),"))
+        assertTrue(service.contains("switchedOn = config.personaOpenMic && persona.ownLifeIsOn(config),"))
+    }
+
+    @Test
+    fun `the notification says she is listening, or why her ears are paused`() {
+        val open = HerEars.Status(HerEars.State.OPEN, null, true, 0L, 0, 0, 0)
+        assertEquals("Yume is awake · listening on this phone", ServiceNotificationText.ears("Yume", open))
+        assertEquals("Yume is awake · her ears are paused (a phone call)", ServiceNotificationText.ears("Yume", open.copy(state = HerEars.State.PAUSED, why = "a phone call")))
+        assertNull(ServiceNotificationText.ears("Yume", open.copy(state = HerEars.State.CLOSED)))
+    }
+
+    @Test
+    fun `the status card counts and never quotes`() {
+        val utc = TimeZone.getTimeZone("UTC")
+        val at = java.util.Calendar.getInstance(utc).apply { clear(); set(2026, 10, 19, 16, 20) }.timeInMillis
+        val status = HerEars.Status(HerEars.State.OPEN, null, true, at, 14, 9, 360)
+        assertEquals("Ears: open since 16:20; heard you 14 times today (9 to her); others 6 min, not kept.", HerEars.statusLine(status, utc))
+        assertEquals("Ears: open since 16:20.", HerEars.statusLine(status.copy(heardHim = 0, toHer = 0, othersSeconds = 0), utc))
+        assertNull(HerEars.statusLine(status.copy(switchedOn = false), utc))
+    }
+
+    @Test
+    fun `one entry a day in her log, read on Her day as counts`() {
+        val dir = Files.createTempDirectory("ears-log").toFile()
+        try {
+            var now = 1_800_000_000_000L
+            val log = HerLog({ File(dir, "her_log.json") }, { now })
+            val day = now - now % (24 * 60 * 60_000L)
+            log.earsCounts(day, mapOf(EarsDay.TO_HER to 3, EarsDay.OPEN_MINUTES to 0))
+            now += 60_000
+            log.earsCounts(day, mapOf(EarsDay.TO_HER to 2, EarsDay.OTHERS_SECONDS to 360))
+            log.earsCounts(day, emptyMap())
+            val entry = log.entries().single()
+            assertEquals(HerLog.Kind.EARS_DAY, entry.kind)
+            assertEquals(mapOf(EarsDay.TO_HER to 5, EarsDay.OTHERS_SECONDS to 360), entry.counts)
+            val line = herDayLine(entry, TimeZone.getTimeZone("UTC"))
+            assertTrue(line, line.endsWith("her ears · 5 said to her, others 6 min, not kept"))
+        } finally {
+            dir.deleteRecursively()
+        }
+    }
+
+    @Test
+    fun `her chat in front is told to her ears from the chat screen`() {
+        val chat = File("src/main/java/com/opendroid/ai/ui/screens/ChatScreen.kt").readText()
+        assertTrue(chat.contains("androidx.lifecycle.Lifecycle.Event.ON_RESUME -> com.opendroid.ai.core.life.ears.ChatInFront.shown(true)"))
+        assertTrue(chat.contains("androidx.lifecycle.Lifecycle.Event.ON_PAUSE -> com.opendroid.ai.core.life.ears.ChatInFront.shown(false)"))
+    }
+
+    @Test
+    fun `nothing her ears hear goes into a log line`() {
+        val sources = File("src/main/java/com/opendroid/ai/core/life/ears").listFiles()!!.filter { it.extension == "kt" }
+        val logLine = Regex("""Log\.[dwie]\([^)]*\$\{?(text|heard|words|transcript|written|line)\b""")
+        sources.forEach { file -> assertFalse(file.name, logLine.containsMatchIn(file.readText())) }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/HeardClipTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/HeardClipTest.kt
new file mode 100644
index 0000000..f2aaf0c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/HeardClipTest.kt
@@ -0,0 +1,120 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.llm.toOpenAIMessages
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.Base64
+
+/**
+ * Hearing him directly: a short clip of his speech, as a WAV file in memory, goes to a model
+ * of hers that hears, beside the words; only his voice, only where her model takes sound and
+ * its route carries more than text; the samples zeroed once the file is made; and no clip in
+ * a row, a log line or a serialized message (I6).
+ */
+class HeardClipTest {
+
+    @Test
+    fun `a clip is a plain 16 kHz mono 16-bit WAV file`() {
+        val samples = floatArrayOf(0f, 0.5f, -0.5f, 1f, -1f, 2f)
+        val bytes = HeardClip.wavBytes(samples)
+        assertEquals(44 + samples.size * 2, bytes.size)
+        assertEquals("RIFF", String(bytes, 0, 4, Charsets.US_ASCII))
+        assertEquals("WAVE", String(bytes, 8, 4, Charsets.US_ASCII))
+        assertEquals("data", String(bytes, 36, 4, Charsets.US_ASCII))
+        val header = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN)
+        assertEquals(1, header.getShort(20).toInt())
+        assertEquals(1, header.getShort(22).toInt())
+        assertEquals(16_000, header.getInt(24))
+        assertEquals(16, header.getShort(34).toInt())
+        assertEquals(samples.size * 2, header.getInt(40))
+        val pcm = (0 until samples.size).map { header.getShort(44 + it * 2).toInt() }
+        assertEquals(listOf(0, 16383, -16383, 32767, -32767, 32767), pcm)
+        assertTrue(Base64.getDecoder().decode(HeardClip.wav(samples)).contentEquals(bytes))
+    }
+
+    private fun toHer(fromHim: Boolean, clip: FloatArray?) = EarsRouting.Route.ToHer(
+        text = "hey, look at this",
+        fromHim = fromHim,
+        enrolled = true,
+        why = EarsRouting.Why.NAME,
+        heard = Heard(0L, 1_000L, if (fromHim) Voice.HIM else Voice.OTHER, 0.8f, "hey, look at this", "en", false, clip = clip)
+    )
+
+    @Test
+    fun `his clip goes with what is said to her and is zeroed, another voice's never does`() {
+        val his = FloatArray(1600) { 0.25f }
+        val aloud = HeardAloud.of(toHer(true, his))
+        assertTrue(aloud.clipWav != null)
+        assertTrue(his.all { it == 0f })
+        assertFalse(aloud.toString().contains(aloud.clipWav!!))
+
+        val other = FloatArray(1600) { 0.25f }
+        val theirs = HeardAloud.of(toHer(false, other))
+        assertNull(theirs.clipWav)
+        assertTrue(other.all { it == 0f })
+        // Before his voice is enrolled the voice could be anyone's: no clip goes as his.
+        val unsure = FloatArray(1600) { 0.25f }
+        val before = HeardAloud.of(
+            EarsRouting.Route.ToHer(
+                text = "hey", fromHim = true, enrolled = false, why = EarsRouting.Why.AFTER_HER,
+                heard = Heard(0L, 1_000L, Voice.NOT_ENROLLED, null, "hey", "en", false, clip = unsure)
+            )
+        )
+        assertNull(before.clipWav)
+        assertTrue(unsure.all { it == 0f })
+        // A heard stretch never shows its clip, nor its words.
+        assertFalse(Heard(0L, 1L, Voice.HIM, null, "SENTINEL_WORDS", null, false, clip = FloatArray(3)).toString().contains("SENTINEL"))
+    }
+
+    @Test
+    fun `she is told she hears it herself only where it goes to her`() {
+        val aloud = HeardAloud(true, true, listOf("laughing"), EarsRouting.Why.NAME, clipWav = "UklGRg==")
+        assertTrue(EarsPrompt.aloudLine(aloud, hearsIt = true).contains(EarsPrompt.HEARD_YOURSELF))
+        assertFalse(EarsPrompt.aloudLine(aloud).contains(EarsPrompt.HEARD_YOURSELF))
+        assertTrue(EarsPrompt.HEARD_YOURSELF.contains("nothing of it is kept"))
+    }
+
+    @Test
+    fun `a clip reaches her only where her model takes sound and its route carries more than text`() {
+        val start = BuildDefaults.fresh().copy(apiKeys = mapOf(BuildDefaults.PROVIDER to "k"), personaChatHearsAudio = true)
+        // Encrypted: text only.
+        assertFalse(HeardClip.reachesHer(start))
+        val moved = HerBrain.move(start)
+        // The seeing brain takes no sound, as Venice lists it.
+        assertFalse(HeardClip.reachesHer(moved.copy(personaChatHearsAudio = true)))
+        val hearing = moved.copy(personaChatModel = "xiaomi-mimo-v2-5", personaChatHearsAudio = true)
+        assertTrue(HeardClip.reachesHer(hearing))
+        assertFalse(HeardClip.reachesHer(hearing.copy(personaChatHearsAudio = false)))
+    }
+
+    @Test
+    fun `a clip and more pictures ride on the request only - Venice's input_audio part - and never into a stored message`() {
+        val message = ChatMessage(
+            // A fixed time: a default time made in the same millisecond as the encoding is left out of it, and read back as another.
+            id = "1", text = "hi", sender = ChatMessage.Sender.USER, timestamp = 1_800_000_000_000L,
+            imageBase64 = "PIC1", moreImagesBase64 = listOf("PIC2"), audioBase64 = "UklGRg=="
+        )
+        @Suppress("UNCHECKED_CAST")
+        val parts = message.let { listOf(it).toOpenAIMessages("system")[1]["content"] as List<Map<String, Any>> }
+        assertEquals(listOf("text", "image_url", "image_url", "input_audio"), parts.map { it["type"] })
+        assertEquals(mapOf("data" to "UklGRg==", "format" to "wav"), parts[3]["input_audio"])
+        assertEquals(mapOf("url" to "data:image/jpeg;base64,PIC2"), parts[2]["image_url"])
+        // Her own reply, or his message without a picture or sound, is plain text as before.
+        assertEquals("hi", listOf(message.copy(imageBase64 = null, moreImagesBase64 = emptyList(), audioBase64 = null)).toOpenAIMessages("s")[1]["content"])
+        // Never serialized, never in a log line.
+        val stored = Json.encodeToString(message)
+        assertFalse(stored, stored.contains("UklGRg==") || stored.contains("PIC2"))
+        assertFalse(message.toString().contains("PIC1") || message.toString().contains("UklGRg==") || message.toString().contains("hi\""))
+        assertEquals(message.copy(moreImagesBase64 = emptyList(), audioBase64 = null), Json.decodeFromString<ChatMessage>(stored))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/HearingRulesTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/HearingRulesTest.kt
new file mode 100644
index 0000000..2a8a939
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/HearingRulesTest.kt
@@ -0,0 +1,124 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.voice.VoiceOut
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** What the ears let go of: too short, too few words, the phone's own voice; and when he cuts her off. */
+class HearingRulesTest {
+
+    private fun spell(start: Long, end: Long?, text: String = "nee, kyou wa nani shiteta no", cut: Long? = null) =
+        VoiceOut.Spell("id$start", text, start, end, cut)
+
+    @Test
+    fun `with the phone silent the whole segment is kept`() {
+        assertEquals(1_000L..2_999L, HearingRules.cleanPart(1_000, 3_000, emptyList()))
+    }
+
+    @Test
+    fun `what falls while the phone speaks, or within 1_5 s after, is cut away`() {
+        // She spoke from 0 to 2 s: the ears take nothing until 3.5 s.
+        assertEquals(3_500L..5_999L, HearingRules.cleanPart(1_000, 6_000, listOf(spell(0, 2_000))))
+        assertNull(HearingRules.cleanPart(1_000, 3_400, listOf(spell(0, 2_000))))
+        // Speech that began before she did keeps what came before her.
+        assertEquals(0L..4_999L, HearingRules.cleanPart(0, 9_000, listOf(spell(5_000, 6_000))))
+        // A line still being said takes everything after its start.
+        assertEquals(0L..999L, HearingRules.cleanPart(0, 60_000, listOf(spell(1_000, null))))
+    }
+
+    @Test
+    fun `the longest clean piece is kept when the phone spoke twice`() {
+        val spells = listOf(spell(2_000, 3_000), spell(6_000, 7_000))
+        // Before her first line (2 s), between the two (1.5 s), after the second (1.5 s): the first is longest.
+        assertEquals(0L..1_999L, HearingRules.cleanPart(0, 10_000, spells))
+        assertEquals(8_500L..11_999L, HearingRules.cleanPart(0, 12_000, spells))
+    }
+
+    @Test
+    fun `a line he cut off is the phone only until he came in, with no tail`() {
+        val cut = spell(1_000, 4_000, cut = 2_000)
+        assertEquals(2_000L..7_999L, HearingRules.cleanPart(1_500, 8_000, listOf(cut)))
+        assertTrue(HearingRules.cutHerOff(2_100, 8_000, listOf(cut)))
+        assertFalse(HearingRules.cutHerOff(9_000, 10_000, listOf(cut)))
+        assertFalse(HearingRules.cutHerOff(2_100, 8_000, listOf(spell(1_000, 4_000))))
+    }
+
+    @Test
+    fun `words are counted in English, Japanese and both mixed`() {
+        assertEquals(0, HearingRules.words("  ...  "))
+        assertEquals(1, HearingRules.words("Yume?"))
+        assertEquals(4, HearingRules.words("yume, what's up?"))
+        assertEquals(1, HearingRules.words("はい"))
+        assertEquals(4, HearingRules.words("ゆめ、何してるの"))
+        assertEquals(5, HearingRules.words("Yume, kawaii ne 本当に"))
+        assertTrue(HearingRules.words("Yume?") < HearingRules.MIN_WORDS)
+        assertTrue(HearingRules.words("yume, what are you doing") >= HearingRules.MIN_WORDS)
+    }
+
+    @Test
+    fun `a transcript of a line the phone just said is the phone, and his own words are not`() {
+        val said = listOf(spell(0, 3_000, text = "I read about egg magazine today, it stopped in 2014."))
+        assertTrue(HearingRules.soundsLikeThePhone("I read about egg magazine today", 4_000, said))
+        assertTrue(HearingRules.soundsLikeThePhone("it stopped in 2014", 10_000, said))
+        assertFalse(HearingRules.soundsLikeThePhone("why did it stop, do you know", 4_000, said))
+        // Long after the line, the same words are his.
+        assertFalse(HearingRules.soundsLikeThePhone("it stopped in 2014", 40_000, said))
+        assertFalse(HearingRules.soundsLikeThePhone("anything", 4_000, emptyList()))
+        // Japanese is compared character by character.
+        val ja = listOf(spell(0, 3_000, text = "別にいいけど、後で文句言わないでよね。"))
+        assertTrue(HearingRules.soundsLikeThePhone("別にいいけど後で文句言わないでよね", 4_000, ja))
+        assertFalse(HearingRules.soundsLikeThePhone("今日は何してたの", 4_000, ja))
+    }
+
+    @Test
+    fun `talking over her cuts her off only with the echo cancelled, after 600 ms, once a line`() {
+        val b = HearingRules.BargeIn()
+        // No echo canceller: never.
+        for (t in 0L..2_000L step 32) assertNull(b.step(t, playingSince = 0, speech = true, echoCancelled = false))
+        b.reset()
+        assertNull(b.step(1_000, 0, true, true))
+        assertNull(b.step(1_500, 0, true, true))
+        assertEquals(1_000L, b.step(1_600, 0, true, true))
+        b.confirmed(0)
+        assertNull(b.step(2_500, 0, true, true))
+        // The next line of hers can be cut off again.
+        assertEquals(2_400L, b.step(3_000, 2_400, true, true))
+    }
+
+    @Test
+    fun `a voice over her that was not his is asked about again later, from when it came in`() {
+        val b = HearingRules.BargeIn()
+        assertNull(b.step(5_000, 4_000, true, true))
+        assertEquals(5_000L, b.step(5_600, 4_000, true, true))
+        b.vetoed(5_600)
+        assertNull(b.step(5_900, 4_000, true, true))
+        assertEquals(5_000L, b.step(6_200, 4_000, true, true))
+        // Silence starts it over.
+        assertNull(b.step(6_300, 4_000, false, true))
+        assertNull(b.step(6_400, 4_000, true, true))
+        assertEquals(6_400L, b.step(7_000, 4_000, true, true))
+        // Speech that began before her line counts from the line's start.
+        val c = HearingRules.BargeIn()
+        assertNull(c.step(0, null, true, true))
+        assertNull(c.step(1_000, 900, true, true))
+        assertEquals(900L, c.step(1_500, 900, true, true))
+    }
+
+    @Test
+    fun `nothing he said shows in a heard segment's string, nor how it sounded`() {
+        val heard = Heard(0, 2_000, Voice.HIM, 0.7f, "SENTINEL words he said", "en", false)
+        assertFalse(heard.toString().contains("SENTINEL"))
+        assertEquals(Kind.SPEECH, heard.kind)
+        val laugh = Heard(
+            0, 1_500, Voice.UNSURE, null, null, null, false,
+            HowItSounded(Tone.HAPPY, listOf(SoundEvent.LAUGHTER), Manner.ORDINARY, null, null, null, null, null, null, null, null),
+            Kind.SOUND,
+        )
+        assertFalse(laugh.toString().lowercase().contains("laugh"))
+        assertFalse(laugh.toString().lowercase().contains("happy"))
+        assertTrue(laugh.toString().contains("SOUND"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/ears/HerEarsTest.kt b/app/src/test/java/com/opendroid/ai/core/life/ears/HerEarsTest.kt
new file mode 100644
index 0000000..a1800bc
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/ears/HerEarsTest.kt
@@ -0,0 +1,415 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.voice.VoiceOut
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+import java.util.TimeZone
+
+/**
+ * Her ears' lifecycle and what becomes of what they hear, with a fake engine: open while she
+ * is awake and the switch is on, closed and cleared on sleep and switch-off, paused for a
+ * call and push-to-talk; what is said to her becomes a message with how it sounded, his voice
+ * not to her is overheard, others are counted; his voice over hers stops her; and nothing
+ * heard reaches a file or the log (I6, I8).
+ */
+class HerEarsTest {
+
+    private class FakeEngine : HearingEngine {
+        var listener: HearingEngine.Listener? = null
+        var opens = 0
+        var closes = 0
+        var pauses = 0
+        var resumes = 0
+        var refuse: HearingEngine.Closed? = null
+        override val isOpen: Boolean get() = listener != null
+        override fun open(listener: HearingEngine.Listener): HearingEngine.Closed? {
+            refuse?.let { return it }
+            opens++
+            this.listener = listener
+            return null
+        }
+        override fun pause() { pauses++ }
+        override fun resume() { resumes++ }
+        override fun close() {
+            closes++
+            listener = null
+        }
+    }
+
+    private class Said(val text: String, val aloud: HeardAloud)
+
+    private val utc = TimeZone.getTimeZone("UTC")
+    private var wall = 1_800_000_000_000L
+    private var mono = 5_000_000L
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private lateinit var dir: File
+    private lateinit var log: HerLog
+    private val overheard = Overheard { wall }
+    private val engine = FakeEngine()
+    private var pick: (LLMConfig) -> EarsEngines.Pick = { EarsEngines.Pick.Engine(engine, "fake:" + it.personaEarsModel) }
+    private val engines = object : EarsEngines {
+        override fun pick(config: LLMConfig, othersMayTalk: () -> Boolean): EarsEngines.Pick = pick(config)
+    }
+    private lateinit var ears: HerEars
+    private val said = ArrayList<Said>()
+    private var cutOff = 0
+    private var broughtSooner = 0
+    private val config = LLMConfig(personaOwnLife = true, personaOpenMic = true)
+    private val awake = EarsGate.Input(switchedOn = true, awake = true, permitted = true, micHeld = true)
+
+    @Before
+    fun setUp() {
+        dir = Files.createTempDirectory("her-ears").toFile()
+        log = HerLog({ File(dir, "her_log.json") }, { wall })
+        ears = HerEars(engines, overheard, log, { wall }, { utc })
+        ears.room = object : HerEars.Room {
+            override fun saidToHer(text: String, aloud: HeardAloud) {
+                said += Said(text, aloud)
+            }
+            override fun overHer() {
+                cutOff++
+            }
+            override fun heardHimAfterQuiet() {
+                broughtSooner++
+            }
+        }
+        VoiceOut.clock = { mono }
+        VoiceOut.clear()
+        ChatInFront.shown(false)
+    }
+
+    @After
+    fun tearDown() {
+        VoiceOut.clear()
+        VoiceOut.clock = { System.nanoTime() / 1_000_000 }
+        dir.deleteRecursively()
+    }
+
+    private fun heard(text: String?, voice: Voice = Voice.NOT_ENROLLED, millis: Long = 2_000, kind: Kind = Kind.SPEECH, sound: HowItSounded? = null) =
+        Heard(mono - millis, mono, voice, null, text, "en", false, sound, kind)
+
+    private fun hear(h: Heard) = engine.listener!!.heard(h)
+
+    @Test
+    fun `the ears open while every gate holds, once, and not before`() {
+        ears.apply(awake.copy(switchedOn = false), config)
+        assertEquals(0, engine.opens)
+        assertEquals(HerEars.State.CLOSED, ears.status.value.state)
+        assertFalse(ears.holdsTheMic)
+        ears.apply(awake, config)
+        ears.apply(awake, config)
+        assertEquals(1, engine.opens)
