+        assertEquals(
+            emptyList<PlanStep>(),
+            PlanModification.changedSteps(before, planOf(listOf(ranOnPhone.copy(params = mapOf("state" to "on")), pendingStep)))
+        )
+    }
+
+    @Test
+    fun `a plan that runs on her rein is not stopped by an answer that changes nothing`() {
+        // In AUTO the stock rule re-checks the whole remainder of a plan nobody approved by
+        // hand, and brightness is not on his allowlist. Her rein started it and still covers it.
+        val before = listOf(ranOnPhone, pendingStep)
+        assertTrue(PlanModification.requiresApproval(AutoMode.AUTO, emptySet(), before, planOf(before), true))
+        assertFalse(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, before, planOf(before), true, ::staysOnPhone
+            )
+        )
+        // A step that leaves the phone and that nobody approved is not covered by PHONE, changed or not.
+        val offPhoneLeft = listOf(ranOnPhone, addedSms)
+        assertTrue(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, offPhoneLeft, planOf(offPhoneLeft), true, ::staysOnPhone
+            )
+        )
+        // The same step in a plan he approved by hand was his yes already.
+        assertFalse(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, offPhoneLeft,
+                planOf(offPhoneLeft + addedAlarm), false, ::staysOnPhone
+            )
+        )
+    }
+
+    @Test
+    fun `a fallback that leaves the phone counts like the step itself`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val withFallback = step("x3", "SET_ALARM", params = mapOf("time" to "7:00"), fallback = "SEND_SMS")
+        assertTrue(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, AutoMode.OFF, before, listOf(ranOnPhone, pendingStep, withFallback)
+            )
+        )
+    }
 }
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt
new file mode 100644
index 0000000..b455c47
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt
@@ -0,0 +1,609 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStatus
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The record of a plan is built from its steps: what ran with what the handler said,
+ * what failed and why, what was only stopped and what never ran. Nothing the planner
+ * wrote about its own plan is told as a result.
+ */
+class PlanRecordTest {
+
+    private fun step(
+        id: String,
+        action: String,
+        params: Map<String, String> = emptyMap(),
+        status: StepStatus = StepStatus.PENDING,
+        result: String? = null,
+        error: String? = null,
+        description: String = "the planner's own words about this step"
+    ) = PlanStep(
+        stepId = id,
+        order = id.filter(Char::isDigit).toIntOrNull() ?: 1,
+        description = description,
+        action = action,
+        params = params,
+        status = status,
+        result = result,
+        error = error
+    )
+
+    private fun plan(vararg steps: PlanStep, goal: String = "Do what he asked, as the planner put it") = Plan(
+        planId = "p1",
+        goal = goal,
+        estimatedDuration = "",
+        estimatedSteps = steps.size,
+        steps = steps.toList(),
+        status = PlanStatus.RUNNING
+    )
+
+    private val canonical: (PlanStep) -> String = { it.action }
+
+    private val sms = step(
+        "s1", "SEND_SMS", mapOf("contact" to "Bob", "message" to "im late"),
+        status = StepStatus.COMPLETED, result = "Message sent to Bob!"
+    )
+    private val alarm = step("s2", "SET_ALARM", mapOf("time" to "07:00"))
+
+    // ── What ran ─────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a plan that worked is told in the handlers' own words, one step to a line`() {
+        val record = PlanRecord.of(
+            plan(sms, alarm.copy(status = StepStatus.COMPLETED, result = "Your alarm is set for 7:00 AM!")),
+            isSuccess = true,
+            canonicalName = canonical
+        )
+        assertEquals("Message sent to Bob!\nYour alarm is set for 7:00 AM!", record.text)
+        assertTrue(record.fromSteps)
+        assertFalse(record.stopped)
+        assertTrue(record.plainOutcome)
+        assertFalse(record.namesSteps)
+        assertNull(record.plannerWords)
+    }
+
+    @Test
+    fun `a hand-over he was told when it happened stays in the record, after what was done, and is not said again`() {
+        val call = step(
+            "s1", "MAKE_CALL", mapOf("contact" to "Bob"),
+            status = StepStatus.COMPLETED, result = "The dialer is open with Bob's number. Tap Call to place the call."
+        )
+        val done = alarm.copy(status = StepStatus.COMPLETED, result = "Your alarm is set for 7:00 AM!")
+        val record = PlanRecord.of(
+            plan(call, done),
+            isSuccess = true,
+            canonicalName = canonical,
+            toldAlready = { it.stepId == "s1" }
+        )
+        assertEquals(
+            "Your alarm is set for 7:00 AM!\nThe dialer is open with Bob's number. Tap Call to place the call.",
+            record.text
+        )
+        assertEquals("Your alarm is set for 7:00 AM!", record.spoken)
+        // The call was not placed by the phone: "it worked" would be wrong about it.
+        assertFalse(record.plainOutcome)
+
+        val onlyTheCall = PlanRecord.of(plan(call), isSuccess = true, canonicalName = canonical, toldAlready = { true })
+        assertEquals(call.result, onlyTheCall.text)
+        assertEquals("", onlyTheCall.spoken)
+    }
+
+    @Test
+    fun `what was not told while the plan ran is spoken exactly as it is stored`() {
+        val record = PlanRecord.of(plan(sms, alarm), isSuccess = false, canonicalName = canonical)
+        assertEquals(record.text, record.spoken)
+    }
+
+    @Test
+    fun `a single result is stored exactly as the handler wrote it`() {
+        val record = PlanRecord.of(plan(sms), isSuccess = true, canonicalName = canonical)
+        assertEquals("Message sent to Bob!", record.text)
+    }
+
+    @Test
+    fun `a step whose handler said nothing is named by its step line, not by the planner's goal`() {
+        val quiet = alarm.copy(status = StepStatus.COMPLETED, result = "Completed successfully.")
+        val record = PlanRecord.of(
+            plan(quiet, goal = "Send a message to everyone"),
+            isSuccess = true,
+            canonicalName = canonical
+        )
+        assertEquals("Done: set alarm.", record.text)
+        assertTrue(record.namesSteps)
+        assertFalse(record.text.contains("message", ignoreCase = true))
+        // Nothing, a bare word and raw data are no result either.
+        for (nothing in listOf(null, "", "ok", "Done.", "{\"displayed\":\"true\"}")) {
+            val text = PlanRecord.of(plan(quiet.copy(result = nothing)), true, canonical).text
+            assertEquals("result <$nothing>", "Done: set alarm.", text)
+        }
+    }
+
+    // ── What failed ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a sent message and an alarm that then failed are both told`() {
+        val record = PlanRecord.of(
+            plan(sms, alarm.copy(status = StepStatus.FAILED, error = "App 'Clock' is not installed.")),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Message sent to Bob!\nFailed: set alarm. App 'Clock' is not installed.", record.text)
+        assertTrue(record.fromSteps)
+        assertFalse(record.stopped)
+        // One part worked and one failed. "It failed" is wrong about the message, so this
+        // is not an outcome she is asked to put in her own words: it is spoken exactly.
+        assertFalse(record.plainOutcome)
+    }
+
+    @Test
+    fun `only a record that is all done or all failed has one plain outcome`() {
+        val done = sms
+        val failed = alarm.copy(status = StepStatus.FAILED, error = "App 'Clock' is not installed.")
+        val pending = step("s3", "OPEN_APP", mapOf("appName" to "Maps"))
+
+        // Nothing but steps that failed: "it failed" is true of all of it.
+        val allFailed = PlanRecord.of(
+            plan(done.copy(status = StepStatus.FAILED, result = null, error = "No SIM card."), failed),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Failed: send SMS to Bob. No SIM card.\nFailed: set alarm. App 'Clock' is not installed.", allFailed.text)
+        assertTrue(allFailed.plainOutcome)
+
+        // A step that never ran is neither done nor failed, beside a failure as beside a result.
+        assertFalse(PlanRecord.of(plan(failed, pending), isSuccess = false, canonicalName = canonical).plainOutcome)
+        assertFalse(
+            PlanRecord.of(
+                plan(failed, pending.copy(status = StepStatus.FAILED, error = "Skipped: depends on failed step s2")),
+                isSuccess = false,
+                canonicalName = canonical
+            ).plainOutcome
+        )
+        // A step that was under way when the run ended may or may not have gone through.
+        assertFalse(
+            PlanRecord.of(plan(failed, pending.copy(status = StepStatus.RUNNING)), isSuccess = false, canonicalName = canonical)
+                .plainOutcome
+        )
+        // A run that only stopped, one that left a step with him and one that ran nothing have none.
+        assertFalse(PlanRecord.of(plan(done, pending), isSuccess = false, canonicalName = canonical).plainOutcome)
+        assertFalse(
+            PlanRecord.of(plan(failed), isSuccess = false, canonicalName = canonical, handedOver = { true }).plainOutcome
+        )
+        val talk = step("s1", "CHAT", status = StepStatus.COMPLETED, result = "Nothing to do.")
+        assertFalse(PlanRecord.of(plan(talk), isSuccess = true, canonicalName = canonical).plainOutcome)
+        // The flag never contradicts what the caller was told about the run.
+        assertFalse(PlanRecord.of(plan(failed), isSuccess = true, canonicalName = canonical).plainOutcome)
+        assertTrue(PlanRecord.of(plan(failed), isSuccess = false, canonicalName = canonical).plainOutcome)
+    }
+
+    @Test
+    fun `a failure with nothing a person can use is still named, without the machine's text`() {
+        val record = PlanRecord.of(
+            plan(
+                alarm.copy(
+                    status = StepStatus.FAILED,
+                    error = "java.lang.NullPointerException: Attempt to invoke virtual method on a null object reference"
+                )
+            ),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Failed: set alarm.", record.text)
+    }
+
+    @Test
+    fun `steps that never ran are listed as not run`() {
+        val record = PlanRecord.of(
+            plan(
+                sms.copy(status = StepStatus.FAILED, result = null, error = "No SIM card."),
+                alarm,
+                step("s3", "OPEN_APP", mapOf("appName" to "Maps"))
+            ),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Failed: send SMS to Bob. No SIM card.\nNot run: set alarm, open app.", record.text)
+    }
+
+    @Test
+    fun `a step that waited on a failed one is not run, not failed`() {
+        val record = PlanRecord.of(
+            plan(
+                sms.copy(status = StepStatus.FAILED, result = null, error = "No SIM card."),
+                alarm.copy(status = StepStatus.FAILED, error = "Skipped: depends on failed step s1")
+            ),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals(
+            "Failed: send SMS to Bob. No SIM card.\nNot run: set alarm (it needed a step that failed).",
+            record.text
+        )
+    }
+
+    // ── What was only stopped ────────────────────────────────────────────────────────
+
+    @Test
+    fun `a plan the planner ended early with nothing failed says that it stopped and nothing failed`() {
+        // "if the battery is below 20 turn on battery saver": the check ran, the condition was false.
+        val check = step(
+            "s1", "GET_SYSTEM_INFO",
+            status = StepStatus.COMPLETED, result = "Battery is at 80%."
+        )
+        val saver = step("s2", "TOGGLE_BATTERY_SAVER")
+        val record = PlanRecord.of(plan(check, saver), isSuccess = false, canonicalName = canonical)
+
+        assertEquals(
+            "Battery is at 80%.\n${PlanRecord.STOPPED_NOTHING_FAILED}\nNot run: toggle battery saver.",
+            record.text
+        )
+        assertTrue(record.stopped)
+        assertFalse(record.text.contains("Failed"))
+    }
+
+    @Test
+    fun `a step left with him to finish is told in the handler's words and is not called a failure`() {
+        val draft = step(
+            "s1", "SEND_EMAIL", mapOf("to" to "bob@example.org"),
+            status = StepStatus.FAILED,
+            error = "I've opened the draft to Bob. Review it and tap send."
+        )
+        val tell = step("s2", "SEND_SMS", mapOf("contact" to "Riya", "message" to "sent it"))
+        val record = PlanRecord.of(
+            plan(draft, tell),
+            isSuccess = false,
+            canonicalName = canonical,
+            handedOver = { it.stepId == "s1" }
+        )
+        assertEquals(
+            "I've opened the draft to Bob. Review it and tap send.\nNot run: send SMS to Riya.",
+            record.text
+        )
+        assertFalse(record.text.contains("Failed"))
+    }
+
+    // ── What the planner said ────────────────────────────────────────────────────────
+
+    @Test
+    fun `what a talk step said is not listed among the results`() {
+        val talk = step(
+            "s2", "CHAT", mapOf("response" to "I've set your alarm and switched on do not disturb."),
+            status = StepStatus.COMPLETED,
+            result = "I've set your alarm and switched on do not disturb."
+        )
+        val record = PlanRecord.of(
+            plan(alarm.copy(status = StepStatus.COMPLETED, result = "Your alarm is set for 7:00 AM!"), talk),
+            isSuccess = true,
+            canonicalName = canonical
+        )
+        assertEquals("Your alarm is set for 7:00 AM!", record.text)
+        assertFalse(record.text.contains("do not disturb"))
+        assertEquals("I've set your alarm and switched on do not disturb.", record.plannerWords)
+    }
+
+    @Test
+    fun `a talk step that only repeats a listed result adds nothing`() {
+        val read = step(
+            "s1", "READ_NOTIFICATIONS",
+            status = StepStatus.COMPLETED, result = "Riya: the hive inspector comes on friday"
+        )
+        val show = step(
+            "s2", "DISPLAY_INFO", mapOf("message" to "\$s1"),
+            status = StepStatus.COMPLETED, result = "Riya: the hive inspector comes on friday"
+        )
+        val record = PlanRecord.of(plan(read, show), isSuccess = true, canonicalName = canonical)
+        assertEquals("Riya: the hive inspector comes on friday", record.text)
+        assertNull(record.plannerWords)
+    }
+
+    @Test
+    fun `a plan of nothing but talk and questions ran nothing, and says so`() {
+        val ask = step("s1", "ASK_USER", status = StepStatus.COMPLETED, result = "tomorrow at nine")
+        val talk = step("s2", "DISPLAY_INFO", status = StepStatus.COMPLETED, result = "Noted, tomorrow at nine.")
+        val record = PlanRecord.of(plan(ask, talk), isSuccess = true, canonicalName = canonical)
+
+        assertEquals(PlanRecord.NOTHING_RAN, record.text)
+        assertFalse(record.fromSteps)
+        assertEquals("Noted, tomorrow at nine.", record.plannerWords)
+    }
+
+    @Test
+    fun `a talk step's answer is kept however short it is`() {
+        val answer = step("s1", "CHAT", mapOf("response" to "4"), status = StepStatus.COMPLETED, result = "4")
+        val record = PlanRecord.of(plan(answer), isSuccess = true, canonicalName = canonical)
+        assertEquals("4", record.plannerWords)
+        assertFalse(record.fromSteps)
+        // A talk step that reported nothing of its own says nothing.
+        val empty = answer.copy(result = "Completed successfully.")
+        assertNull(PlanRecord.of(plan(empty), isSuccess = true, canonicalName = canonical).plannerWords)
+    }
+
+    @Test
+    fun `his answer to a question is not a result of the phone`() {
+        val ask = step("s1", "ASK_USER", status = StepStatus.COMPLETED, result = "tell her i am running late")
+        val confirm = step("s2", "CONFIRM_ACTION", status = StepStatus.COMPLETED, result = "User confirmed: yes please")
+        val record = PlanRecord.of(plan(ask, confirm, sms.copy(stepId = "s3")), isSuccess = true, canonicalName = canonical)
+        assertEquals("Message sent to Bob!", record.text)
+    }
+
+    @Test
+    fun `a secret a step was given is not repeated by the record`() {
+        val save = step(
+            "s1", "SAVE_SENSITIVE_INFO", mapOf("key" to "door", "secret" to "4471"),
+            status = StepStatus.COMPLETED, result = "Securely saved 'door' in Level 4 hardware-encrypted storage."
+        )
+        val echo = step("s2", "ADD_NOTE", status = StepStatus.COMPLETED, result = "Got it! Note 'door 4471' saved.")
+        val record = PlanRecord.of(plan(save, echo), isSuccess = true, canonicalName = canonical)
+        assertFalse(record.text, record.text.contains("4471"))
+        assertTrue(record.text, record.text.contains("Securely saved 'door'"))
+    }
+
+    // ── Why a step failed ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a reason is kept when a person can use it and dropped when it is the machine talking`() {
+        val kept = listOf(
+            "App 'Camera2' not installed.",
+            "Accessibility Service is not running or active.",
+            "I've opened the chat with Bob. Please tap send.",
+            "Couldn't confirm that the message was sent."
+        )
+        for (reason in kept) assertEquals(reason, PlanRecord.reason(reason))
+
+        val dropped = listOf(
+            null,
+            "  ",
+            "java.lang.IllegalStateException: boom",
+            "appName parameter missing",
+            "Unknown execution error",
+            "Execution failed",
+            "kotlinx.coroutines.TimeoutCancellationException: please check the logs",
+            "{\"error\":\"bad\"}"
+        )
+        for (reason in dropped) assertNull("<$reason>", PlanRecord.reason(reason))
+    }
+
+    @Test
+    fun `machine text that stands for a plain reason is replaced by it`() {
+        assertEquals("A permission is missing.", PlanRecord.reason("java.lang.SecurityException: Permission Denial: reading"))
+        assertEquals("No app on the phone can do that.", PlanRecord.reason("android.content.ActivityNotFoundException: No Activity"))
+        assertEquals("There was no connection.", PlanRecord.reason("java.net.UnknownHostException: api.example.org"))
+        assertEquals(
+            "There was no connection.",
+            PlanRecord.reason("Unable to resolve host \"api.example.org\": No address associated with hostname")
+        )
+        assertEquals("There was no connection.", PlanRecord.reason("java.net.ConnectException: Failed to connect to /10.0.0.2:8080"))
+        assertEquals("The connection timed out.", PlanRecord.reason("java.net.SocketTimeoutException: timeout"))
+        assertEquals("The phone has no such action.", PlanRecord.reason("Action 'FLY' is not registered in ActionDispatcher"))
+    }
+
+    @Test
+    fun `an error that is not about the network is never told as a missing connection`() {
+        // IOException is thrown for a full disk and a missing file as well as for a dead network.
+        val disk = "Couldn't save the file: java.io.IOException: No space left on device"
+        assertNull(PlanRecord.reason(disk))
+        assertNull(PlanRecord.reason("java.io.FileNotFoundException: /sdcard/notes.txt (No such file or directory)"))
+        assertNull(PlanRecord.reason("java.io.IOException: unexpected end of stream"))
+
+        val write = step(
+            "s1", "WRITE_FILE", mapOf("fileName" to "notes.txt"),
+            status = StepStatus.FAILED, error = disk
+        )
+        val text = PlanRecord.of(plan(write), isSuccess = false, canonicalName = canonical).text
+        assertTrue(text, text.startsWith("Failed: "))
+        assertFalse(text, text.contains("connection", ignoreCase = true))
+        assertFalse(text, text.contains("IOException"))
+    }
+
+    @Test
+    fun `when a step and its fallback both failed the first reason that can be shown is given`() {
+        assertEquals(
+            "No SIM card.",
+            PlanRecord.reason("Primary failed: No SIM card.. Fallback failed: WhatsApp is not installed.")
+        )
+        assertEquals(
+            "WhatsApp is not installed.",
+            PlanRecord.reason("Primary failed: java.lang.IllegalStateException: x. Fallback failed: WhatsApp is not installed.")
+        )
+    }
+
+    @Test
+    fun `a key in an error never reaches the record, and a long reason is shortened`() {
+        assertNull(PlanRecord.reason("Request failed with key sk-abcdefghijklmnop12345"))
+        val long = "The calendar " + "would not open ".repeat(40)
+        val shown = PlanRecord.reason(long)!!
+        assertTrue(shown.length <= 201)
+        assertTrue(shown.endsWith("…"))
+    }
+
+    // ── Not run, and stopped ─────────────────────────────────────────────────────────
+
+    @Test
+    fun `a rejected plan leaves one row that says none of it ran`() {
+        val proposed = plan(sms.copy(status = StepStatus.PENDING, result = null), alarm)
+        assertEquals("Not run (rejected): Send SMS to Bob, Set alarm", PlanRecord.rejected(proposed, canonical))
+        assertEquals(
+            "Not run (a new message came before it was approved): Send SMS to Bob, Set alarm",
+            PlanRecord.dropped(proposed, "a new message came before it was approved", canonical)
+        )
+    }
+
+    @Test
+    fun `a changed plan that is rejected after steps ran says which had run`() {
+        val row = PlanRecord.rejected(plan(sms, alarm), canonical)
+        assertEquals(
+            "Stopped (rejected): Send SMS to Bob, Set alarm\nAlready ran: Send SMS to Bob\nNot run: Set alarm",
+            row
+        )
+    }
+
+    @Test
+    fun `a stopped plan says what had run, what was under way and what never started`() {
+        val row = PlanRecord.stopped(
+            plan(sms, alarm.copy(status = StepStatus.RUNNING), step("s3", "OPEN_APP")),
+            canonical
+        )
+        assertEquals(
+            "Stopped: Send SMS to Bob, Set alarm, Open app\n" +
+                "Already ran: Send SMS to Bob\n" +
+                "Interrupted: Set alarm (it may or may not have gone through)\n" +
+                "Not run: Open app",
+            row
+        )
+    }
+
+    @Test
+    fun `a plan stopped before anything ran says so, and a step that waited for his answer did not run`() {
+        val waiting = plan(sms.copy(status = StepStatus.RUNNING, result = null), alarm)
+        assertEquals(
+            "Stopped: Send SMS to Bob, Set alarm\nNothing had run yet.\nNot run: Send SMS to Bob, Set alarm",
+            PlanRecord.stopped(waiting, canonical, waitingForAnswer = true)
+        )
+    }
+
+    @Test
+    fun `a step he said no to did not run, whatever its status`() {
+        val confirm = step("s1", "CONFIRM_ACTION", status = StepStatus.FAILED, error = "Action cancelled by user response: no")
+        val declined = plan(sms.copy(stepId = "s0"), confirm, alarm)
+        assertEquals(
+            "Stopped (you said no): Send SMS to Bob, Confirm action, Set alarm\n" +
+                "Already ran: Send SMS to Bob\n" +
+                "Not run: Set alarm",
+            PlanRecord.stopped(declined, canonical, why = "you said no", declinedStepId = "s1")
+        )
+        val refused = plan(sms.copy(status = StepStatus.FAILED, result = null, error = "Action cancelled by user response: no"))
+        assertEquals(
+            "Stopped (you said no): Send SMS to Bob\nNothing had run yet.\nNot run: Send SMS to Bob",
+            PlanRecord.stopped(refused, canonical, why = "you said no", declinedStepId = "s1")
+        )
+    }
+
+    // ── A plan that starts without a prompt ──────────────────────────────────────────
+
+    @Test
+    fun `the trace of a plan that runs unasked names the steps and keeps the goal only as what was asked`() {
+        val unasked = plan(
+            sms.copy(status = StepStatus.PENDING, result = null, description = "Check the weather"),
+            alarm,
+            goal = "Check the weather"
+        )
+        assertEquals(
+            "Running: 2 steps\n• Send SMS to Bob\n• Set alarm\nAsked: Check the weather",
+            PlanRecord.running(unasked)
+        )
+        assertEquals("Running: Send SMS to Bob, Set alarm", PlanRecord.runningSpoken(unasked))
+        assertFalse(PlanRecord.runningSpoken(unasked).contains("weather"))
+    }
+
+    @Test
+    fun `a goal that holds a secret is not kept in the trace`() {
+        val save = step("s1", "SAVE_SENSITIVE_INFO", mapOf("key" to "door", "secret" to "4471"))
+        val trace = PlanRecord.running(plan(save, goal = "save my door code 4471 as a secret"))
+        assertFalse(trace, trace.contains("4471"))
+        assertTrue(trace, trace.startsWith("Running: 1 step\n• Save sensitive info"))
+    }
+
+    // ── What a question guards ───────────────────────────────────────────────────────
+
+    @Test
+    fun `a confirmation names the step it guards, read off the plan`() {
+        val confirm = step("s1", "CONFIRM_ACTION", mapOf("message" to "Shall I check the weather?"), status = StepStatus.RUNNING)
+        val guarded = plan(confirm, sms.copy(stepId = "s2", status = StepStatus.PENDING, result = null), alarm.copy(stepId = "s3"))
+        assertEquals("Next: Send SMS to Bob", PlanRecord.nextStepLine(guarded, "s1", canonical))
+        // Talk and further questions in between are not what it guards.
+        val padded = plan(
+            confirm,
+            step("s2", "DISPLAY_INFO", mapOf("message" to "one moment")),
+            step("s3", "ASK_USER"),
+            alarm.copy(stepId = "s4")
+        )
+        assertEquals("Next: Set alarm", PlanRecord.nextStepLine(padded, "s1", canonical))
+        assertNull(PlanRecord.nextStepLine(plan(confirm), "s1", canonical))
+        assertNull(PlanRecord.nextStepLine(guarded, "not-a-step", canonical))
+    }
+
+    @Test
+    fun `the step that asks is one of the plan's own asking steps, never a macro that asks from inside`() {
+        val confirm = step("s1", "CONFIRM_ACTION", mapOf("message" to "Go ahead?"), status = StepStatus.RUNNING)
+        val macro = step("s1", "RUN_MACRO", mapOf("macroName" to "night"), status = StepStatus.RUNNING)
+        val next = sms.copy(stepId = "s2", status = StepStatus.PENDING, result = null)
+
+        assertEquals(confirm, PlanRecord.askingStep(plan(confirm, next), "s1", canonical))
+        // The macro's own confirmation guards the macro's next step, which the plan does not hold.
+        assertNull(PlanRecord.askingStep(plan(macro, next), "s1", canonical))
+        assertNull(PlanRecord.askingStep(plan(confirm, next), "s2", canonical))
+        assertNull(PlanRecord.askingStep(plan(confirm, next), null, canonical))
+        assertNull(PlanRecord.askingStep(null, "s1", canonical))
+        // The name the dispatcher runs the step under decides, not how the plan spells it.
+        val spelled = confirm.copy(action = "confirm")
+        assertEquals(spelled, PlanRecord.askingStep(plan(spelled, next), "s1") { it.action.uppercase() + "_ACTION" })
+    }
+
+    // ── A question that quotes what a step read ──────────────────────────────────────
+
+    private val names: (PlanStep) -> Collection<String> = { listOf(it.action) }
+
+    @Test
+    fun `a question that quotes a step that read his data holds that data`() {
+        val read = step(
+            "s1", "READ_NOTIFICATIONS",
+            status = StepStatus.COMPLETED, result = "Riya: the hive inspector comes on friday"
+        )
+        val ask = step("s2", "ASK_USER", mapOf("question" to "You got: \$s1. Reply?"), status = StepStatus.RUNNING)
+        val confirm = step("s2", "CONFIRM_ACTION", mapOf("message" to "Send \$s1 on to Bob?"), status = StepStatus.RUNNING)
+        for (asking in listOf(ask, confirm)) {
+            assertTrue(asking.action, PlanRecord.questionMayHoldPersonalData(plan(read, asking), asking, names))
+        }
+        // Through a step in between as well: the quote of a quote carries the same text.
+        val shown = step("s2", "DISPLAY_INFO", mapOf("message" to "\$s1"), status = StepStatus.COMPLETED, result = "Riya: ...")
+        val later = step("s3", "ASK_USER", mapOf("question" to "About \$s2: reply?"), status = StepStatus.RUNNING)
+        assertTrue(PlanRecord.questionMayHoldPersonalData(plan(read, shown, later), later, names))
+    }
+
+    @Test
+    fun `a question in the planner's own words holds none, and one of unknown origin is taken to`() {
+        val read = step("s1", "READ_NOTIFICATIONS", status = StepStatus.COMPLETED, result = "Riya: friday")
+        val plain = step("s2", "ASK_USER", mapOf("question" to "What should I tell Mom?"), status = StepStatus.RUNNING)
+        assertFalse(PlanRecord.questionMayHoldPersonalData(plan(read, plain), plain, names))
+        // His own earlier answer is not his private data read off the phone.
+        val first = step("s1", "ASK_USER", mapOf("question" to "Who?"), status = StepStatus.COMPLETED, result = "mom")
+        val second = step("s2", "ASK_USER", mapOf("question" to "What should I tell \$s1?"), status = StepStatus.RUNNING)
+        assertFalse(PlanRecord.questionMayHoldPersonalData(plan(first, second), second, names))
+
+        // Asked from inside a macro, or outside any plan: what it quotes cannot be seen.
+        assertTrue(PlanRecord.questionMayHoldPersonalData(plan(read, plain), null, names))
+        assertTrue(PlanRecord.questionMayHoldPersonalData(null, null, names))
+    }
+
+    // ── Private data and secrets ─────────────────────────────────────────────────────
+
+    @Test
+    fun `step lines that name who or what a step acts on are told apart from bare actions`() {
+        assertTrue(PlanRecord.stepLinesNameDetails(plan(sms)))
+        assertFalse(PlanRecord.stepLinesNameDetails(plan(alarm)))
+        assertFalse(PlanRecord.stepLinesNameDetails(plan(step("s1", "TOGGLE_FLASHLIGHT", mapOf("state" to "on")))))
+    }
+
+    @Test
+    fun `a plan that takes a secret is recognised, and so is an answer that becomes one`() {
+        val save = step("s2", "SAVE_SENSITIVE_INFO", mapOf("key" to "door", "secret" to "\$s1"))
+        val ask = step("s1", "ASK_USER", mapOf("question" to "What is the code?"))
+        assertTrue(PlanRecord.takesASecret(plan(ask, save)))
+        assertFalse(PlanRecord.takesASecret(plan(sms, alarm)))
+
+        assertTrue(PlanRecord.answerIsASecret(plan(ask, save), "s1"))
+        // An answer that only names the record, or that feeds a message, is no secret.
+        val named = step("s2", "SAVE_SENSITIVE_INFO", mapOf("key" to "\$s1", "secret" to "4471"))
+        assertFalse(PlanRecord.answerIsASecret(plan(ask, named), "s1"))
+        val body = step("s2", "SEND_SMS", mapOf("contact" to "Bob", "message" to "\$s1"))
+        assertFalse(PlanRecord.answerIsASecret(plan(ask, body), "s1"))
+    }
+}
