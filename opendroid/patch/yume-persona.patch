+                val systemPrompt = chatSystemPrompt(
+                    config, relevantContext(), shaped.deviceActivity, screenshotAttached = false, cues = cues,
+                    inOwnTime = true, nowMillis = nowMillis, shownNotes = { shownKeys = it }
+                ) + "\n\n" + PersonaOwnTime.talkBlock(dialogue) + "\n\n" +
