+
+    private fun state(): State = runBlocking { memory.ownTime() }
+
+    private fun moment(at: Long = now, rows: List<ChatMessage> = talk): PersonaEngine.OwnMoment? =
+        runBlocking { engine.ownMoment(relevantContext = { "" }, recentMessages = rows, nowMillis = at, zone = utc) }
