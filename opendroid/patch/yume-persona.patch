+                "(just now) Your alarm is set for 7:00 AM!"
+            ),
+            shaped.deviceActivity
+        )
+    }
+
+    @Test
+    fun `an age is a few plain words`() {
+        assertEquals("just now", PersonaPrompts.age(0))
+        assertEquals("just now", PersonaPrompts.age(59_000))
+        // A clock that was set back must not produce a line from the future.
+        assertEquals("just now", PersonaPrompts.age(-5 * minute))
+        assertEquals("1 min ago", PersonaPrompts.age(minute))
+        assertEquals("59 min ago", PersonaPrompts.age(59 * minute))
+        assertEquals("1 h ago", PersonaPrompts.age(60 * minute))
+        assertEquals("23 h ago", PersonaPrompts.age(23 * 60 * minute + 59 * minute))
+        assertEquals("yesterday", PersonaPrompts.age(24 * 60 * minute))
+        assertEquals("yesterday", PersonaPrompts.age(47 * 60 * minute))
+        assertEquals("2 days ago", PersonaPrompts.age(48 * 60 * minute))
+        assertEquals("9 days ago", PersonaPrompts.age(9 * 24 * 60 * minute))
+    }
+
+    @Test
+    fun `a line that had to be shortened says so`() {
+        val long = "Here are your notifications: " + "Riya says the hive inspector comes on friday. ".repeat(12)
+        val line = PersonaPrompts.shapeHistory(listOf(app(long))).deviceActivity.single()
+        assertTrue(line, line.endsWith(PersonaPrompts.CUT_MARK))
+        assertTrue(line.length < long.length)
