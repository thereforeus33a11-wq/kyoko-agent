+        herNow.doing(logKind, app.name, startedAt, "on his phone in ${app.name.lowercase()} (${OutingPrompt.fenced(words)})")
+        tally.at(app.name)
+        val motion = HumanMotion(random)
+        val watch = LendWatch(startedAt)
+        var endedBy = HerLog.EndedBy.DONE
+        var steps = 0
+        var sayUsed = false
+        var activeMillis = 0L
+        // Her app came to the front; [PhoneSpace.launched] is whether it was opened at all.
+        var arrived = false
+        var space: PhoneSpace? = null
+        val labels = ArrayList<String>()
+        var taps = 0
+        var scrolls = 0
+        var tabs = 0
+        var backs = 0
+        var watched = 0L
+        val searches = ArrayList<String>()
+        var heldBack = 0
+        val refused = LinkedHashMap<String, Int>()
+        var looked = 0
+        var untoldDrops = 0
+        var metKid = false
+        val before = try {
+            time.inFront()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            PhoneTime.Before.Unknown
+        }
+        val own = time.ownPackage
+        val launchers = time.launchers()
+        val keyboards = time.keyboards()
+        var watching: AutoCloseable? = null
+        var quiet: AutoCloseable? = null
+        try {
+            // His yes was tapped in the shade, which a tap there does not close: closed first, so it is not taken for a notification over her app.
+            if (hisYes && time.clearShade()) wait(SHADE_MILLIS)
+            watching = time.watch(app.name) { signal ->
+                watch.signal(signal, app.packages, own, launchers, keyboards)?.let { end(it.endedBy) }
+            }
+            quiet = time.quiet()
+            var config = mind.config()
+            val frames = eyes?.takeIf { it.open(config, clock()) }?.let { minOf(HerEyes.perOuting(config), MAX_FRAMES) } ?: 0
+            var framesLeft = frames
+            val ownEyes = frames > 0 && eyes?.ownEyes(config) == true
+            val here = PhoneSpace(app, packageName, time.hands, motion, his(), watch, clock, wait)
+            space = here
+            val first = here.begin(parsed, HumanMotion.Energy.at(clock()))
+            arrived = !first.left
+            took(first, tally, app)
+            first.searched?.let { searches += it }
+            first.guard?.let { heldBack++ }
+            if (!arrived) {
+                endedBy = HerLog.EndedBy.ERROR
+                return
+            }
+            val history = ArrayList<String>()
+            history += OutingPrompt.historyLine(0, "for your go: line the app " + first.line, null)
+            val seenTalk = life.hisActivityAt.value
+            var tick = clock()
+            while (true) {
+                config = mind.config()
+                watch.ending?.let {
+                    endedBy = it.endedBy
+                    return
+                }
+                endBefore(config, here)?.let {
+                    endedBy = it
+                    return
+                }
+                // His talk ends a lent screen: he is there, and it is his.
+                if (life.talkGoingOn() || life.hisActivityAt.value > seenTalk) {
+                    endedBy = HerLog.EndedBy.HIS_MESSAGE
+                    break
+                }
+                val maxSteps = OwnLife.maxSteps(config)
+                val maxMillis = maxMinutes(config, dayLeft) * MINUTE
+                if (steps >= maxSteps) {
+                    endedBy = HerLog.EndedBy.STEPS
+                    break
+                }
+                if (activeMillis >= maxMillis) {
+                    endedBy = HerLog.EndedBy.TIME
+                    break
+                }
+                val screen = here.screen ?: here.look()
+                if (screen != null) {
+                    // Out of the app without a touch of his: a link of hers to another app, or his doing.
+                    if (screen.packageName.isNotBlank() && screen.packageName !in app.packages) {
+                        watch.signal(LendWatch.Signal.Front(clock(), screen.packageName), app.packages, own, launchers, keyboards)
+                    }
+                    if (LookOnly.gate(screen) != null) {
+                        watch.signal(LendWatch.Signal.Front(clock(), HisApps.GATE_PACKAGES.first()), app.packages, own, launchers, keyboards)
+                    }
+                    watch.ending?.let {
+                        endedBy = it.endedBy
+                        break
+                    }
+                }
+                // A fresh look at the screen through her eyes, while they are open and looks are left.
+                val pictures = ArrayList<String>()
+                val seen = if (framesLeft > 0 && eyes?.open(config, clock()) == true) {
+                    look(packageName, tally, pictures).also { (_, sent) -> if (sent) framesLeft-- }.first
+                } else {
+                    PhonePrompt.Seen.NotSeen(if (frames > 0) "no looks are left on this outing" else "your eyes are not open on this outing")
+                }
+                if (seen is PhonePrompt.Seen.Yourself || seen is PhonePrompt.Seen.Described) looked++
+                here.kidOfFrame((seen as? PhonePrompt.Seen.Kid)?.flag)
+                val kid = here.kidInFront
+                if (kid != null) {
+                    metKid = true
+                    tally.refused(KidGuard.category(kid))
+                }
+                val energy = HumanMotion.Energy.at(clock())
+                val facts = PhonePrompt.Facts(
+                    words = words,
+                    app = app,
+                    kind = kind,
+                    step = steps + 1,
+                    maxSteps = maxSteps,
+                    minutesIn = (activeMillis / MINUTE).toInt(),
+                    maxMinutes = (maxMillis / MINUTE).toInt(),
+                    history = history,
+                    sayUsed = sayUsed,
+                    searchesLeft = here.searchesLeft,
+                    energy = energy,
+                    tokyo = tokyo(clock()),
+                    framesLeft = if (frames > 0) framesLeft else null,
+                    ownEyes = ownEyes
+                )
+                herNow.stepped()
+                untoldDrops = 0
+                val lookedAt = clock()
+                val step = mind.step(PhonePrompt.text(facts, here, seen), sayUsed, lookedAt, kid != null, pictures, app.name)
+                pictures.clear()
+                val now = clock()
+                activeMillis += now - tick
+                tick = now
+                callsSoFar()
+                if (step == null) {
+                    endedBy = HerLog.EndedBy.ERROR
+                    break
+                }
+                steps++
+                tally.step(step)
+                repeat(step.kidLinesDropped) { tally.refused(KidGuard.LINE_DROPPED) }
+                untoldDrops = step.kidLinesDropped
+                config = mind.config()
+                if (!lendOn(config)) {
+                    endedBy = HerLog.EndedBy.SWITCHED_OFF
+                    break
+                }
+                if (mind.asleep()) {
+                    endedBy = HerLog.EndedBy.ASLEEP
+                    break
+                }
+                if (step.said.isNotEmpty() && !sayUsed) {
+                    mind.said(step.said, now)
+                    sayUsed = true
+                }
+                val thought = step.thought.takeIf { mind.thoughtsShown(config) }
+                val notKept = if (step.kidLinesDropped > 0) " " + KidGuard.NOT_KEPT else ""
+                when (val reading = PhoneVerb.of(step.next)) {
+                    PhoneVerb.Reading.Finished, PhoneVerb.Reading.CutOff -> {
+                        endedBy = HerLog.EndedBy.DONE
+                        break
+                    }
+                    is PhoneVerb.Reading.Unread ->
+                        history += OutingPrompt.historyLine(steps, "the app could not read your do: line, so nothing was done", thought) + notKept
+                    is PhoneVerb.Reading.Verb -> {
+                        // She reads what was on the screen before she moves: the time it takes, less the time she took to answer.
+                        val (chars, japanese) = PhonePrompt.readingSize(here.screen)
+                        val readFor = motion.reading(chars, japanese, energy)
+                        val spent = clock() - lookedAt
+                        if (readFor > spent && reading.verb !is PhoneVerb.Refused) wait(readFor - spent)
+                        val did = here.run(reading.verb, HumanMotion.Energy.at(clock()))
+                        took(did, tally, app)
+                        if (did.opened != null && did.tab == null) {
+                            taps++
+                            if (labels.size < MAX_LABELS) labels += did.opened
+                        }
+                        if (did.tab != null) tabs++
+                        if (did.scrolled) scrolls++
+                        if (did.back) backs++
+                        watched += did.watchedMillis
+                        did.searched?.let { searches += it }
+                        did.guard?.let { heldBack++ }
+                        did.refused?.let { refused[it.words] = (refused[it.words] ?: 0) + 1 }
+                        history += OutingPrompt.historyLine(steps, did.line, thought) + notKept
+                        if (did.cut) watch.signal(LendWatch.Signal.Cut(clock()), app.packages, own, launchers, keyboards)
+                        if (did.left) {
+                            endedBy = HerLog.EndedBy.DONE
+                            break
+                        }
+                    }
+                }
+                log.update(id, tally)
+            }
+            watch.ending?.let { endedBy = it.endedBy }
+        } catch (e: CancellationException) {
+            endedBy = watch.ending?.endedBy ?: stoppedBy() ?: HerLog.EndedBy.BROKE_OFF
+            throw e
+        } catch (e: Exception) {
+            endedBy = HerLog.EndedBy.ERROR
+            Log.w(TAG, "Her phone time broke off: ${e.javaClass.simpleName}")
+        } finally {
+            withContext(NonCancellable) {
+                try {
+                    watching?.close()
+                } catch (e: Exception) {
+                    Log.w(TAG, "The watch on his screen did not close: ${e.javaClass.simpleName}")
+                }
+                // Her app was launched: the screen is given back, whatever ended it, the app still opening too.
+                val launched = space?.launched == true
+                val ending = watch.ending
+                // What is in front got there by a move of hers, or her app may still come up: his screen is put back all the same.
+                val hers = !arrived || ending == LendWatch.Ending.LEFT_APP || ending == LendWatch.Ending.NEEDS_HIM
+                val gaveBack = if (launched) giveBack(before, packageName, endedBy, hers) else NOT_OPENED
+                // What she started playing stops before his sound comes back: nothing of his played when she took the screen.
+                if (launched && quiet != null) {
+                    val paused = try {
+                        time.pauseHerSound(always = endedBy == HerLog.EndedBy.CALL)
+                    } catch (e: Exception) {
+                        Log.w(TAG, "Her sound was not paused: ${e.javaClass.simpleName}")
+                        false
+                    }
+                    if (paused) wait(PAUSE_MILLIS)
+                }
+                try {
+                    quiet?.close()
+                } catch (e: Exception) {
+                    Log.w(TAG, "The sound was not put back: ${e.javaClass.simpleName}")
+                }
+                val endedAt = clock()
+                callsSoFar()
+                log.end(id, endedBy, tally)
+                herNow.nothing()
+                recorder.put(
+                    OutingEntries.phoneTime(
+                        OutingEntries.PhoneTime(
+                            app = app.name,
+                            words = words,
+                            startedAt = startedAt,
+                            endedAt = endedAt,
+                            hisYes = hisYes,
+                            opened = launched,
+                            arrived = arrived,
+                            scrolls = scrolls,
+                            taps = taps,
+                            tabs = tabs,
+                            backs = backs,
+                            watchedMillis = watched,
+                            searches = searches.toList(),
+                            searchesHeldBack = heldBack,
+                            refused = refused.toMap(),
+                            ended = endedBy.words,
+                            gaveBack = gaveBack.words,
+                            early = endedBy != HerLog.EndedBy.DONE
+                        )
+                    )
+                )
+                try {
+                    back(came(app, steps, activeMillis, labels, taps, scrolls, searches.size, refused, watched, looked, endedBy, sayUsed, untoldDrops, metKid).copy(screenBack = gaveBack.how))
+                } catch (e: Exception) {
+                    Log.w(TAG, "Her coming back from his screen was not kept: ${e.javaClass.simpleName}")
+                }
+            }
+        }
+    }
+
+    private fun came(
+        app: HisApps.App, steps: Int, activeMillis: Long, labels: List<String>, taps: Int, scrolls: Int, searches: Int,
+        refused: Map<String, Int>, watched: Long, looked: Int, endedBy: HerLog.EndedBy, said: Boolean, untoldDrops: Int, metKid: Boolean
+    ) = Came(
+        app = app.name,
+        steps = steps,
+        minutes = ((activeMillis + MINUTE / 2) / MINUTE).toInt(),
+        opened = labels.toList(),
+        taps = taps,
+        scrolls = scrolls,
+        searches = searches,
+        refused = refused.values.sum(),
+        watchedSeconds = ((watched + 500) / 1_000).toInt(),
+        looked = looked,
+        endedBy = endedBy,
+        said = said,
+        untoldDrops = untoldDrops,
+        metKid = metKid
+    )
+
+    /** What a verb of hers is counted as. */
+    private fun took(did: PhoneSpace.Did, tally: HerLog.Tally, app: HisApps.App) {
+        did.opened?.let { if (did.tab == null) tally.opened(it, app.name) else tally.bump(TABS) }
+        did.searched?.let { tally.searched(it) }
+        if (did.scrolled) tally.bump(SCROLLS)
+        if (did.back) tally.bump(BACKS)
+        if (did.watchedMillis > 0) tally.bump(WATCHED_SECONDS, ((did.watchedMillis + 500) / 1_000).toInt())
+        did.refused?.let { tally.refused(LOOK_ONLY_PREFIX + it.name) }
+        did.guard?.let { tally.refused("guard:" + it.name) }
+        did.kidSkipped?.let { tally.refused(KidGuard.category(it)) }
+        did.quirks.forEach { tally.bump(QUIRK_PREFIX + it.name.lowercase()) }
+    }
+
+    /**
+     * One look at the app's window through her eyes: the picture, then her own sight or the
+     * describer, the age check first either way. What she is shown of it, and whether it went out
+     * (a look used). A picture she sees herself goes into [pictures] for the step only (I6).
+     */
+    private suspend fun look(packageName: String, tally: HerLog.Tally, pictures: MutableList<String>): Pair<PhonePrompt.Seen, Boolean> {
+        val eyes = eyes ?: return PhonePrompt.Seen.NotSeen("your eyes are not open") to false
+        return when (val frame = time.frame(packageName)) {
+            PhoneTime.Frame.Hidden -> {
+                tally.bump(HIDDEN_SCREENS)
+                PhonePrompt.Seen.Hidden to false
+            }
+            is PhoneTime.Frame.None -> PhonePrompt.Seen.NotSeen(frame.why) to false
+            is PhoneTime.Frame.Taken -> try {
+                when (val seen = eyes.describe(frame.bytes, Describe.Source.SCREEN)) {
+                    is HerEyes.Seen.Shown -> {
+                        pictures += seen.jpegBase64
+                        tally.bump(SCREENS_SEEN)
+                        PhonePrompt.Seen.Yourself to true
+                    }
+                    is HerEyes.Seen.Described -> {
+                        tally.bump(SCREENS_SEEN)
+                        val flag = KidGuard.flagOfPicture(seen.words, seen.ages, clock(), seen.seer)
+                        when {
+                            flag != null -> PhonePrompt.Seen.Kid(flag)
+                            seen.ages !is KidGuard.Ages.Read -> {
+                                tally.refused(KidGuard.UNCHECKED)
+                                PhonePrompt.Seen.Unchecked(seen.seer)
+                            }
+                            else -> PhonePrompt.Seen.Described(seen.words, seen.cutOff)
+                        } to true
+                    }
+                    is HerEyes.Seen.NotSeen -> {
+                        tally.refused(EYES_PREFIX + seen.why.name)
+                        PhonePrompt.Seen.NotSeen(seen.why.words) to seen.why.sent
+                    }
+                }
+            } finally {
+                frame.bytes.fill(0)
+            }
+        }
+    }
+
+    /** His switches for a lent screen: her own life, and his screen lent to her. */
+    private fun lendOn(config: LLMConfig): Boolean = mind.lifeOn(config) && config.personaLendScreen
+
+    /** His longest outing, and no more than the phone time that was left today when it began ([dayLeft]). */
+    private fun maxMinutes(config: LLMConfig, dayLeft: Int): Int = minOf(OwnLife.maxMinutes(config), dayLeft.coerceAtLeast(1))
+
+    /**
+     * What ends a lent screen before its next step (§1.1, the lent screen's column): her own life
+     * or the lent screen switched off, she lying down, power, fewer than [OwnLedger.Start.STEP]
+     * calls on her own left, three guard refusals.
+     */
+    private suspend fun endBefore(config: LLMConfig, space: PhoneSpace): HerLog.EndedBy? {
+        val events = power().copy(
+            asleep = mind.asleep(),
+            callsLeft = ledger.left(OwnLife.capOf(config)),
+            switchedOn = lendOn(config),
+            guardRefusals = space.guardRefusals
+        ).events()
+        if (OutingRules.decide(OutingRules.Activity.LENT_SCREEN, events) < OutingRules.Rule.END) return null
+        return when {
+            OutingRules.Event.SWITCH_OFF in events -> HerLog.EndedBy.SWITCHED_OFF
+            OutingRules.Event.ASLEEP in events -> HerLog.EndedBy.ASLEEP
+            OutingRules.Event.GUARD_REFUSALS in events -> HerLog.EndedBy.GUARD
+            OutingRules.Event.POWER_LOW in events -> HerLog.EndedBy.POWER
+            OutingRules.Event.CALLS_LOW in events -> HerLog.EndedBy.BUDGET
+            else -> HerLog.EndedBy.BROKE_OFF
+        }
+    }
+
+    /**
+     * Gives his screen back to how it was. A call is in front of a call's end: then the screen is
+     * left alone until the call is over, and given back only if her app is still in front. Never
+     * fails the caller; the words say how, for the record.
+     */
+    private suspend fun giveBack(before: PhoneTime.Before, packageName: String, endedBy: HerLog.EndedBy, hers: Boolean): PhoneTime.GaveBack {
+        if (endedBy == HerLog.EndedBy.CALL) {
+            scope.launch {
+                val until = clock() + CALL_WAIT_MILLIS
+                while (clock() < until) {
+                    wait(CALL_LOOK_MILLIS)
+                    val phone = time.phone()
+                    if (!phone.inCall) {
+                        // After the call, only her app in front is hers to take away: anything else is his by then.
+                        if (phone.screenOn && phone.unlocked) time.giveBack(before, packageName, hers = false)
+                        break
+                    }
+                }
+            }
+            return PhoneTime.GaveBack(PhoneTime.GaveBack.How.AFTER_CALL, "after the call")
+        }
+        return try {
+            time.giveBack(before, packageName, hers)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "His screen was not given back: ${e.javaClass.simpleName}")
+            PhoneTime.GaveBack(PhoneTime.GaveBack.How.FAILED, "not given back: it failed")
+        }
+    }
+
+    companion object {
+        private const val TAG = "PhoneOuting"
+        private const val MINUTE = 60_000L
+
+        /** The most pictures of his screen on one outing, whatever her eyes allow. */
+        const val MAX_FRAMES = 8
+
+        /** The most labels of what she opened kept for her next moment and the log. */
+        const val MAX_LABELS = 5
+
+        /** How long the shade is let close before her app opens, after his yes in it. */
+        const val SHADE_MILLIS = 450L
+
+        /** How long a pause of her sound is let take before his volume is put back. */
+        const val PAUSE_MILLIS = 400L
+
+        private val NOT_OPENED = PhoneTime.GaveBack(PhoneTime.GaveBack.How.NOT_OPENED, "not touched: the app did not open")
+
+        /** After a call, how long the screen waits to be given back, and how often it looks. */
+        const val CALL_WAIT_MILLIS = 60 * 60_000L
+        const val CALL_LOOK_MILLIS = 2_000L
+
+        const val SCROLLS = "scrolls"
+        const val TABS = "tabs"
+        const val BACKS = "backs"
+        const val WATCHED_SECONDS = "seconds watched"
+        const val SCREENS_SEEN = "screens looked at"
+        const val HIDDEN_SCREENS = "screens the app hid"
+        const val LOOK_ONLY_PREFIX = HerLog.LOOK_ONLY_PREFIX
+        const val QUIRK_PREFIX = "moves "
+        const val EYES_PREFIX = "eyes:"
+
+        fun logKindOf(kind: OutingKind.Kind): HerLog.Kind = when (kind) {
+            OutingKind.Kind.SCROLL -> HerLog.Kind.SCROLL
+            OutingKind.Kind.WATCH -> HerLog.Kind.WATCH
+            else -> HerLog.Kind.BROWSE
+        }
+
+        /** Her clock in Tokyo at [millis], "23:40". */
+        fun tokyo(millis: Long): String =
+            SimpleDateFormat("HH:mm", Locale.ENGLISH).apply { timeZone = TimeZone.getTimeZone("Asia/Tokyo") }.format(Date(millis))
+    }
+}
