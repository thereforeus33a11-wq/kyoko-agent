@@ -0,0 +1,157 @@
+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The order of things between the wake phrase and the open microphone, with the phone's
+ * parts replaced by a list of what was asked of them.
+ */
+class WakeTurnTest {
+
+    private val events = mutableListOf<String>()
+    private var deadline: Runnable? = null
+    private var nextId = 0
+
+    private val turn = WakeTurn(
+        pauseDetection = { events += "detection paused" },
+        resumeDetection = { events += "detection resumed" },
+        stopSpeech = { events += "speech stopped" },
+        speakReply = { id ->
+            events += "reply spoken as $id"
+            "say it"
+        },
+        openMicrophone = { events += "microphone opened" },
+        startDeadline = { task, delayMillis ->
+            events += "deadline set for $delayMillis ms"
+            deadline = task
+        },
+        cancelDeadline = { task -> if (deadline === task) deadline = null },
+        newUtteranceId = { "wake-${++nextId}" }
+    )
+
+    private fun microphonesOpened() = events.count { it == "microphone opened" }
+
+    @Test
+    fun `the microphone opens when the wake reply has ended, and not before`() {
+        turn.onWakePhrase()
+
+        assertEquals(
+            listOf("detection paused", "speech stopped", "reply spoken as wake-1", "deadline set for 3000 ms"),
+            events
+        )
+
+        // Another line ending, such as one that was cut off by the wake phrase, opens nothing.
+        turn.onUtteranceDone("her-reply")
+        assertEquals(0, microphonesOpened())
+
+        turn.onUtteranceDone("wake-1")
+        assertEquals("microphone opened", events.last())
+        assertEquals("the deadline is taken back once the reply has ended", null, deadline)
+
+        turn.onUtteranceDone("wake-1")
+        assertEquals("only once", 1, microphonesOpened())
+    }
+
+    @Test
+    fun `when no ending is reported the deadline opens the microphone, and a late ending opens no second one`() {
+        turn.onWakePhrase()
+
+        deadline!!.run()
+        assertEquals(1, microphonesOpened())
+
+        turn.onUtteranceDone("wake-1")
+        assertEquals(1, microphonesOpened())
+    }
+
+    @Test
+    fun `a wake reply cut off by Stop or by a typed message opens no microphone and brings detection back`() {
+        turn.onWakePhrase()
+        events.clear()
+
+        turn.onSpeechCutOff()
+
+        assertEquals(listOf("detection resumed"), events)
+        assertEquals("no deadline is left to open the microphone later", null, deadline)
+        turn.onUtteranceDone("wake-1")
+        assertEquals(0, microphonesOpened())
+    }
+
+    @Test
+    fun `speech cut off when no wake reply is awaited leaves detection as it is`() {
+        // No wake phrase at all: Stop while she is reading a reply.
+        turn.onSpeechCutOff()
+        assertEquals(emptyList<String>(), events)
+
+        // The listen has begun: its own callbacks bring detection back, not this.
+        turn.onWakePhrase()
+        turn.onUtteranceDone("wake-1")
+        events.clear()
+        turn.onSpeechCutOff()
+        assertEquals(emptyList<String>(), events)
+    }
+
+    @Test
+    fun `a microphone opened another way takes the wake reply's place without touching detection`() {
+        turn.onWakePhrase()
+        events.clear()
+
+        // The bubble is tapped while the wake reply is still being said.
+        turn.onMicrophoneOpening()
+
+        assertEquals(emptyList<String>(), events)
+        assertEquals(null, deadline)
+        turn.onUtteranceDone("wake-1")
+        assertEquals("the listen that is starting is the only one", 0, microphonesOpened())
+    }
+
+    @Test
+    fun `a second wake phrase replaces the first reply`() {
+        turn.onWakePhrase()
+        turn.onWakePhrase()
+
+        turn.onUtteranceDone("wake-1")
+        assertEquals(0, microphonesOpened())
+        turn.onUtteranceDone("wake-2")
+        assertEquals(1, microphonesOpened())
+    }
+
+    @Test
+    fun `the phone's own wake reply coming back through the microphone is told from his words, once`() {
+        turn.onWakePhrase()
+        turn.onUtteranceDone("wake-1")
+
+        assertTrue(turn.isOwnReply("Say it."))
+        // Asked once: the same words in a later listen are his.
+        assertFalse(turn.isOwnReply("say it"))
+
+        turn.onWakePhrase()
+        assertFalse("anything he added makes it his", turn.isOwnReply("say it again louder"))
+
+        // With her on, a recogniser may hear one of her replies as another.
+        turn.onWakePhrase()
+        assertTrue(turn.isOwnReply("what", otherWakeLines = listOf("mm?", "what", "oi")))
+    }
+
+    @Test
+    fun `without a wake reply, or after a listen that heard nothing, no transcript is taken for the phone's`() {
+        assertFalse(turn.isOwnReply("say it"))
+
+        turn.onWakePhrase()
+        turn.forgetReply()
+        assertFalse(turn.isOwnReply("say it"))
+    }
+
+    @Test
+    fun `closing takes the deadline back and resumes nothing`() {
+        turn.onWakePhrase()
+        events.clear()
+
+        turn.close()
+
+        assertEquals(emptyList<String>(), events)
+        assertEquals(null, deadline)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/WakeWordDetectorHearingTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/WakeWordDetectorHearingTest.kt
