+ *
+ * The owner, on her breath: it should sound like it comes from a person like her, her
+ * diaphragm and lungs, the size of her body, her chest rising and falling. Her teacher
+ * voice breathed wrong (a dark rumble and a short hum around each sentence, which the
+ * voice build now cuts away: voice/scripts/pod/edges.py). This puts breath back the way
+ * she breathes on record: the sound is four breaths of her voice actress's own
+ * ([BreathBank], made by voice/scripts/breath_bank.py), and when and how deep follows a
+ * small model of her lungs (the same as voice/scripts/breathe.py, which made the
+ * listening samples):
+ *
+ *  - She is an adult woman of 157 cm. People talk on the middle of their lungs: a breath
+ *    group uses about 0.3-0.6 L of air.
+ *  - Speaking uses about [AIR_PER_SECOND] L of air per second of her speech.
+ *  - A breath group is whole sentences, as many as fit in [GROUP_MAX_L]. When the next
+ *    sentence would not fit she breathes at that sentence boundary, never inside one.
+ *  - The breath is what the next group needs plus [RESERVE_L], drawn through the mouth at
+ *    [INFLOW] L/s: a quick catch before a short group, up to about half a second before a
+ *    long one. Her voice starts a moment after it ends (the hold).
+ *  - The first words of a line are often said on the air she has, breathed while she
+ *    listened: under [OPENER_S] of speech always, under [SOFT_OPENER_S] half the time,
+ *    otherwise she starts on a quiet catch. Her own takes show the same: mostly no audible
+ *    breath at all.
+ *  - A breath is as loud as the air going in: a catch about 34 dB under her speech, a deep
+ *    breath about 27 dB under ([LEVEL_DB]).
+ *  - As the air of a group runs down her voice falls a little, [DECLINE_DB] across the
+ *    group, and comes back after the next breath.
+ *  - Between two sentences of one breath, a pause of about [SENTENCE_PAUSE_S], varied.
+ *  - Never the same breath twice: every one is cut from another place, drawn a few percent
+ *    faster or slower, and a little louder or softer.
+ *
+ * Her feelings are words she writes; nothing here reads them. This is her baseline manner,
+ * the cool, unhurried one. A line that follows her last within [CARRY_MILLIS] goes on the
+ * same breath.
+ *
+ * Without a bank in the build she pauses between sentences as before and adds no breath.
+ */
+class Breathing(
+    private val bank: BreathBank,
+    private val sampleRate: Int,
+    private val random: Random = Random.Default,
+    private val clock: () -> Long = System::currentTimeMillis,
+) {
+
+    enum class Kind(val asset: String) { CATCH("catch"), SOFT("soft"), QUICK("quick"), DEEP("deep") }
+
+    /** What is heard before one sentence of hers. */
+    sealed interface Before {
+        /** Nothing: she says it on the air she has. */
+        data object Air : Before
+
+        /** A pause between two sentences of one breath. */
+        data class Pause(val seconds: Float) : Before
+
+        /** One of her breaths, then the moment her voice takes to start. */
+        class Breath(val kind: Kind, val samples: FloatArray, val holdSeconds: Float) : Before
+    }
+
+    // Seconds of her speech since her last breath, the seconds the group was planned for,
+    // and when her last line ended: what carries from one line to the next.
+    private var groupUsed = 0f
+    private var groupPlanned = 0f
+    private var lastEnded = Long.MIN_VALUE / 2
+
+    /** A line of hers whose sentences hold [codepointCounts] phoneme codepoints each. */
+    fun line(codepointCounts: IntArray): Line = Line(codepointCounts, clock() - lastEnded < CARRY_MILLIS)
+
+    inner class Line internal constructor(private val counts: IntArray, private val continuing: Boolean) {
+        private var index = 0
+        private var secondsPerCodepoint = FIRST_SECONDS_PER_CODEPOINT
+        private var levels = 0f
+        private var levelCount = 0
+
+        /**
+         * Sentence by sentence, in order, as each is made: what to play before it, and the
+         * sentence with her voice's fall across the breath. [pace] is the speech rate the
+         * line is said at (pauses follow it; breaths do not).
+         */
+        fun next(samples: FloatArray, pace: Float = 1f): Pair<Before, FloatArray> {
+            val k = index++
+            val seconds = samples.size / sampleRate.toFloat()
+            counts.getOrNull(k)?.takeIf { it > 0 }?.let { n ->
+                val measured = seconds / n
+                secondsPerCodepoint = if (k == 0) measured else (secondsPerCodepoint + measured) / 2
+            }
+            if (samples.isNotEmpty()) {
+                levels += speechLevel(samples, sampleRate); levelCount++
+            }
+            val speechDb = if (levelCount > 0) levels / levelCount else -20f
+
+            fun estimate(i: Int) = if (i == k) seconds else (counts.getOrNull(i) ?: 0) * secondsPerCodepoint
+            fun groupFrom(start: Int): Float {
+                var t = 0f
+                for (i in start until max(counts.size, start + 1)) {
+                    val d = estimate(i)
+                    if (t > 0f && AIR_PER_SECOND * (t + d) > GROUP_MAX_L) break
+                    t += d
+                }
+                return t
+            }
+            fun breathFor(group: Float, cap: Float = Float.MAX_VALUE): Before.Breath {
+                val inSeconds = min(((AIR_PER_SECOND * group + RESERVE_L) / INFLOW).coerceIn(0.12f, 0.65f), cap)
+                return breath(inSeconds, speechDb)
+            }
+
+            val before: Before = when {
+                k == 0 && !continuing -> {
+                    val group = groupFrom(0)
+                    groupPlanned = group; groupUsed = 0f
+                    when {
+                        group < OPENER_S -> Before.Air
+                        group < SOFT_OPENER_S && random.nextBoolean() -> Before.Air
+                        group < SOFT_OPENER_S -> breathFor(group, cap = 0.2f)
+                        else -> breathFor(group)
+                    }
+                }
+                AIR_PER_SECOND * (groupUsed + seconds) > GROUP_MAX_L -> {
+                    val group = groupFrom(k)
+                    groupPlanned = group; groupUsed = 0f
+                    breathFor(group)
+                }
+                // A line right after her last, on the breath she still has: the gap between
+                // the two lines is its pause.
+                k == 0 -> Before.Air
+                else -> Before.Pause(SENTENCE_PAUSE_S * PAUSE_SCALE * random.range(0.85f, 1.15f) / pace.coerceIn(0.5f, 2f))
+            }
+            groupPlanned = maxOf(groupPlanned, groupUsed + seconds, 1e-3f)
+            val shaped = fall(samples, groupUsed / groupPlanned, (groupUsed + seconds) / groupPlanned)
+            groupUsed += seconds
+            return before to shaped
+        }
+
+        /** The line is over (said to its end or cut off): the next one may go on its breath. */
+        fun ended() {
+            lastEnded = clock()
+        }
+    }
+
+    private fun fall(samples: FloatArray, from: Float, to: Float): FloatArray {
+        val a = from.coerceIn(0f, 1f); val b = to.coerceIn(0f, 1f)
+        val out = FloatArray(samples.size)
+        val n = max(1, samples.size - 1)
+        for (i in samples.indices) {
+            val db = -DECLINE_DB * (a + (b - a) * i / n)
+            out[i] = samples[i] * 10f.pow(db / 20f)
+        }
+        return out
+    }
+
+    internal fun breath(inSeconds: Float, speechDb: Float): Before.Breath {
+        val kind = when {
+            inSeconds < 0.25f -> Kind.CATCH
+            inSeconds < 0.42f -> Kind.SOFT
+            else -> Kind.DEEP
+        }
+        // The fuller breath lends its slow start and its fast end too.
+        val pool = when (kind) {
+            Kind.CATCH -> listOf(Kind.CATCH)
+            Kind.SOFT -> listOf(Kind.SOFT, Kind.QUICK, Kind.DEEP)
+            Kind.QUICK -> listOf(Kind.QUICK, Kind.DEEP)
+            Kind.DEEP -> listOf(Kind.DEEP)
+        }
+        val source = bank.clip(pool[random.nextInt(pool.size)])
+        val drawn = resample(source, random.range(0.94f, 1.06f))
+        val n = (inSeconds * sampleRate).roundToInt().coerceAtLeast(1)
+        val y = when {
+            drawn.size > n -> {
+                val off = random.nextInt(drawn.size - n + 1)
+                drawn.copyOfRange(off, off + n)
+            }
+            drawn.size < n * 0.8f -> resample(drawn, max(1f / 1.3f, drawn.size / n.toFloat()))
+            else -> drawn.copyOf()
+        }
+        val fadeIn = max(1, (0.35f * y.size).toInt())
+        val fadeOut = max(1, min(y.size / 3, (0.03f * sampleRate).toInt()))
+        for (i in 0 until min(fadeIn, y.size)) y[i] *= sin(PI / 2 * i / fadeIn).pow(2).toFloat()
+        for (i in 0 until min(fadeOut, y.size)) {
+            val j = y.size - fadeOut + i
+            if (j >= 0) y[j] *= cos(PI / 2 * (i + 1) / fadeOut).pow(2).toFloat()
+        }
+        val have = percentile(frameLevels(y, sampleRate), 0.90f)
+        val want = speechDb + LEVEL_DB.getValue(kind) + LEVEL_OFFSET_DB + random.range(-1f, 1f)
+        val gain = 10f.pow((want - have) / 20f)
+        for (i in y.indices) y[i] *= gain
+        return Before.Breath(kind, y, random.range(HOLD_MIN_S, HOLD_MAX_S))
+    }
+
+    private fun Random.range(a: Float, b: Float) = a + (b - a) * nextFloat()
+
+    companion object {
+        const val AIR_PER_SECOND = 0.12f
+        const val INFLOW = 1.4f
+        const val GROUP_MAX_L = 0.6f
+        const val RESERVE_L = 0.08f
+        const val OPENER_S = 1.3f
+        const val SOFT_OPENER_S = 4.0f
+        const val SENTENCE_PAUSE_S = 0.32f
+        const val PAUSE_SCALE = 1.10f
+        const val HOLD_MIN_S = 0.10f
+        const val HOLD_MAX_S = 0.16f
+        const val DECLINE_DB = 1.5f
+        const val LEVEL_OFFSET_DB = -1.5f
+        val LEVEL_DB = mapOf(Kind.CATCH to -34f, Kind.SOFT to -31f, Kind.QUICK to -30f, Kind.DEEP to -27f)
+        /** A line that follows her last within this goes on the same breath. */
+        const val CARRY_MILLIS = 2_000L
+        /** How long she takes per phoneme codepoint, before her first sentence says better. */
+        const val FIRST_SECONDS_PER_CODEPOINT = 0.075f
+
+        /** Levels (dB) of 25 ms frames every 10 ms, Hann-windowed, as the voice build measures them. */
+        fun frameLevels(x: FloatArray, sampleRate: Int): FloatArray {
+            val w = (0.025 * sampleRate).toInt().coerceAtLeast(1); val h = (0.01 * sampleRate).toInt().coerceAtLeast(1)
+            val padded = if (x.size < w) x.copyOf(w) else x
+            val n = 1 + (padded.size - w) / h
+            val window = DoubleArray(w) { 0.5 - 0.5 * cos(2 * PI * it / (w - 1).coerceAtLeast(1)) }
+            return FloatArray(n) { f ->
+                var s = 0.0
+                for (i in 0 until w) { val v = padded[f * h + i] * window[i]; s += v * v }
+                (10 * log10(s / w + 1e-12)).toFloat()
+            }
+        }
+
+        /** Her speech level in [x]: the 95th percentile of its frame levels. */
+        fun speechLevel(x: FloatArray, sampleRate: Int): Float = percentile(frameLevels(x, sampleRate), 0.95f)
+
+        fun percentile(values: FloatArray, q: Float): Float {
+            if (values.isEmpty()) return -120f
+            val s = values.sorted()
+            val pos = q * (s.size - 1)
+            val lo = pos.toInt(); val hi = min(lo + 1, s.size - 1)
+            return s[lo] + (s[hi] - s[lo]) * (pos - lo)
+        }
+
+        /** [x] drawn [rate] times faster (linear interpolation; a breath is noise and takes it well). */
+        fun resample(x: FloatArray, rate: Float): FloatArray {
+            if (x.isEmpty() || rate <= 0f) return x.copyOf()
+            val n = max(1, (x.size / rate).toInt())
+            return FloatArray(n) { i ->
+                val p = i * rate
+                val a = p.toInt().coerceAtMost(x.size - 1); val b = min(a + 1, x.size - 1)
+                x[a] + (x[b] - x[a]) * (p - a)
+            }
+        }
+    }
+}
+
+/**
+ * Her breaths as the build ships them (own_voice/breaths, from voice/scripts/breath_bank.py):
+ * bank.json with the sample rate, and one file of little-endian 32-bit float samples per
+ * breath (catch.f32, soft.f32, quick.f32, deep.f32). Her voice actress's own breath:
+ * private, like the rest of her voice.
+ */
+class BreathBank(private val clips: Map<Breathing.Kind, FloatArray>) {
+
+    fun clip(kind: Breathing.Kind): FloatArray = clips.getValue(kind)
+
+    companion object {
+        const val DIR = "breaths"
+
+        /** The bank in [dir] at [sampleRate], or null when it is missing or incomplete (she then adds no breath). */
+        fun load(dir: File, sampleRate: Int): BreathBank? = runCatching {
+            val meta = Json.parseToJsonElement(File(dir, "bank.json").readText()).jsonObject
+            val rate = meta.getValue("sr").jsonPrimitive.int
+            val clips = Breathing.Kind.entries.associateWith { kind ->
+                val bytes = File(dir, "${kind.asset}.f32").readBytes()
+                require(bytes.size >= 4 && bytes.size % 4 == 0) { "${kind.asset}.f32 is not float samples" }
+                val buf = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer()
+                val raw = FloatArray(buf.remaining()).also { buf.get(it) }
+                require(raw.all { it.isFinite() }) { "${kind.asset}.f32 has samples that are not numbers" }
+                if (rate == sampleRate) raw else Breathing.resample(raw, rate / sampleRate.toFloat())
+            }
+            BreathBank(clips)
+        }.getOrNull()
+    }
+}
