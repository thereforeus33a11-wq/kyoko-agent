+    /**
+     * Adds a YouTube channel to her feeds by its channel id ([com.opendroid.ai.core.life.reading.Feeds.youtube]),
+     * named [name]; false when the id is no channel id or the list is full.
+     */
+    fun addPersonaYouTubeChannel(id: String, name: String): Boolean {
+        if (com.opendroid.ai.core.life.reading.Feeds.youtube(id) == null) return false
+        val current = _llmConfig.value.personaReadYouTube
+        if (id !in current && current.size >= com.opendroid.ai.data.models.OwnLifeBounds.MAX_YOUTUBE_CHANNELS) return false
+        val named = name.replace(Regex("""\s+"""), " ").trim().take(60).ifEmpty { "YouTube" }
+        _llmConfig.value = _llmConfig.value.copy(personaReadYouTube = current + (id to named))
+        viewModelScope.launch {
+            configSaver.save(
+                revert = { stored -> copy(personaReadYouTube = personaReadYouTube.withEntryFrom(stored.personaReadYouTube, id)) }
+            ) { stored -> stored.copy(personaReadYouTube = stored.personaReadYouTube + (id to named)) }
+        }
+        return true
+    }
