+            Text(
+                text = "PERSONA",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            // Until the card has been looked for, nothing below is shown: a build without
+            // one must not open with her switch and her settings.
+            val cardState = card ?: return@Column
+            if (!cardState.present) {
+                // A build without a card runs as the stock app: none of the settings below
+                // would do anything, so they are not offered. The editor still is, because
