+object BuildDefaults {
+    const val PROVIDER = "Custom OpenAI Compatible"
+    const val ENDPOINT = "https://api.venice.ai/api/v1"
+
+    /**
+     * The model the build starts on: Venice's uncensored model that is spoken to end to
+     * end encrypted, by its id as published in November 2026. So the first thing sent,
+     * once a key is in, already goes out unreadable to the host. It is only where he
+     * starts: the id is his to change, and one that has been retired fails with a plain
+     * error and sends nothing in the clear.
+     */
+    const val MODEL = "e2ee-deepseek-v4-1-flash-1017-abliterated"
+
+    /** That model thinks before every answer, so the stock minute is too short for it. */
+    const val TIMEOUT_SECONDS = 120
+
+    /**
+     * The setting a phone starts with when none has been saved. It is not the default of
+     * [LLMConfig] itself: a setting that was saved by an earlier build keeps the provider
+     * it had, also where that was the stock one and so was never written down.
+     */
+    fun fresh(): LLMConfig = LLMConfig(
+        activeProvider = PROVIDER,
+        activeModel = MODEL,
+        selectedModels = mapOf(PROVIDER to MODEL),
+        customEndpoints = mapOf(PROVIDER to ENDPOINT),
+        cloudTimeoutSeconds = TIMEOUT_SECONDS,
+        // This build is the owner's own and he asked for her to have time of her own.
+        personaCheckInsEnabled = true
+    )
+}
