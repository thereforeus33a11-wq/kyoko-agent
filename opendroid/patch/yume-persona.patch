@@ -0,0 +1,106 @@
+package com.opendroid.ai.core.persona
+
+import java.security.SecureRandom
+
+/**
+ * Which requests make which picture of her ([SelfPictureMaker.Plan]), from her words, the
+ * models he chose and her own pictures. Pure: what is sent can be read here and in the tests.
+ *
+ * - A new picture ([newPicture]): drawn from words on a generate model, with the adult guard,
+ *   her look and the negative prompt, then matched to two of her originals or masters where he
+ *   left that on. A new scene, pose or side of her is always drawn new, never edited out of
+ *   another picture: an edit model asked to re-pose a picture melts hands and turns shirts
+ *   backwards.
+ * - A change ([change]): one small change to the one picture she names, on an edit model,
+ *   which keeps everything else of it. Only an original or a master is changed this way.
+ *
+ * Every picture of her that a request here carries for a model to work from is a [SourceImage]:
+ * an original or a master, never a derived picture ([PictureSources]). The one picture that is
+ * not, the new one in a match, is the picture being matched, not one it is matched to.
+ * - The test picture of "Try picture models" ([trial]): the same, with a fixed scene that is
+ *   not sexual.
+ */
+object SelfPicturePlans {
+
+    private val random = SecureRandom()
+
+    /** A seed chosen on the phone: Venice does not say which one it used. */
+    fun seed(): Int = random.nextInt(VeniceImages.MAX_SEED + 1)
+
+    /**
+     * A new picture of her on [model]: [ask] (her words, his name out), drawn new; with
+     * [view] one side of a full-body reference, [ask] then being what she wears on it. Where
+     * [match] is on and there are [references] (her originals and masters), it is matched to
+     * them after. Where [match] is on and there are none, it is not matched, and the plan
+     * carries a note that says so ([NO_BASES_NOTE]).
+     */
+    fun newPicture(
+        model: PictureModels.Model,
+        ask: String,
+        references: List<SourceImage>,
+        match: Boolean,
+        seed: Int,
+        age: Int = PersonaAge.AGE_IN_FILES,
+        lookNow: String = "",
+        view: PersonaSelfPictures.View? = null
+    ): SelfPictureMaker.Plan {
+        val shape = if (view != null) PicturePrompts.Shape.PORTRAIT else PicturePrompts.shapeOf(ask)
+        val prompt = PicturePrompts.generate(model, ask, age, lookNow, view)
+        val first = VeniceImages.generate(model, prompt, PicturePrompts.negative(model.style, ask, lookNow), shape, seed)
+        val theirs = references.take(PictureModels.MATCH_IMAGES - 1).map { it.base64 }
+        if (!match) return SelfPictureMaker.Plan(first)
+        if (theirs.isEmpty()) return SelfPictureMaker.Plan(first, note = NO_BASES_NOTE)
+        // Her plate outfit comes over from her pictures only where her words say nothing of what
+        // she wears, or only take some of it off.
+        val outfit = PicturePrompts.outfitOf(ask)
+        val outfitFromPlates = view == null && outfit != PicturePrompts.Outfit.Own
+        val takenOff = outfit is PicturePrompts.Outfit.Less && outfit.off.isNotEmpty()
+        val matchPrompt = PicturePrompts.match(theirs.size, outfitFromPlates, model.style, age, view, takenOff)
+        return SelfPictureMaker.Plan(first) { made ->
+            VeniceImages.multiEdit(PictureModels.MATCH, listOf(made) + theirs, matchPrompt, shape.ratio)
+        }
+    }
+
+    /** What a new picture is kept with where the match was on and she had no original or master to match it to. For him, not for her line. */
+    val NO_BASES_NOTE: String = SelfPictureMaker.notMatched("she has no original or master picture to match it to")
+
+    /** One small change ([ask]) to [source], one of her originals or masters, on the edit [model]. */
+    fun change(
+        model: PictureModels.Model,
+        source: SourceImage,
+        ask: String,
+        age: Int = PersonaAge.AGE_IN_FILES,
+        lookNow: String = ""
+    ): SelfPictureMaker.Plan =
+        SelfPictureMaker.Plan(VeniceImages.edit(model, source.base64, PicturePrompts.edit(ask, age, lookNow), editRatio(ask)))
+
+    private val FULL_BODY = Regex("""(?i)\b(?:full[ -]?body|head to (?:toe|feet)|whole body)\b""")
+
+    /**
+     * The aspect ratio a change asks for: wide or square where her words say so, 3:4 for a
+     * full body (her picture file: careful 3:4 or wide 16:9 for a whole body), else none, and
+     * the picture keeps its own shape.
+     */
+    fun editRatio(ask: String): String? = when {
+        PicturePrompts.shapeOf(ask) == PicturePrompts.Shape.LANDSCAPE -> "16:9"
+        PicturePrompts.shapeOf(ask) == PicturePrompts.Shape.SQUARE -> "1:1"
+        FULL_BODY.containsMatchIn(ask) -> "3:4"
+        else -> null
+    }
+
+    /**
+     * The test picture of "Try picture models" on [model]: a generate model draws
+     * [PicturePrompts.TRIAL_SCENE] (and matches it where [match] is on); an edit model makes it
+     * out of [source], an original or a master of hers, the way her pictures were made before.
+     * Null for an edit model without one to start from.
+     */
+    fun trial(model: PictureModels.Model, references: List<SourceImage>, source: SourceImage?, match: Boolean, seed: Int): SelfPictureMaker.Plan? =
+        when (model.kind) {
+            PictureModels.Kind.GENERATE -> newPicture(model, PicturePrompts.TRIAL_SCENE, references, match, seed)
+            PictureModels.Kind.EDIT -> source?.let { change(model, it, PicturePrompts.TRIAL_EDIT) }
+        }
+
+    /** What the test picture on [model] costs: the model, and the match where it runs. The age check is a fraction of a cent on top. */
+    fun trialCost(model: PictureModels.Model, match: Boolean, hasReferences: Boolean): Double =
+        model.price + if (model.kind == PictureModels.Kind.GENERATE && match && hasReferences) PictureModels.MATCH.price else 0.0
+}
