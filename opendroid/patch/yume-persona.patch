+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.LLMConfig
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.boolean
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * What goes out for a picture of her (the content rule, [PictureGuard]): every request
+ * carries the adult guard, every request that can carries the negative prompt against
+ * childlike, teen and school features, nothing of his is in any of it, and each body holds
+ * exactly the fields Venice's reference documents for its endpoint.
+ */
+class SelfPictureRequestsTest {
+
+    private fun json(call: VeniceImages.Call): JsonObject = Json.parseToJsonElement(call.body).jsonObject
+
+    private val asks = listOf(
+        "on a rooftop at night, smoking, boots on the rail",
+        "topless on the love hotel bed",
+        "in a red hoodie at the konbini, wide",
+        "lying on the sofa, square",
+        ""
+    )
+
+    /** Every plan the app can build, for every model it can build it on. */
+    private fun everyPlan(): List<Pair<String, SelfPictureMaker.Plan>> {
+        val plans = ArrayList<Pair<String, SelfPictureMaker.Plan>>()
+        for (model in PictureModels.GENERATE) {
+            for (ask in asks.filter { it.isNotEmpty() }) {
+                plans += "${model.id}: $ask" to SelfPicturePlans.newPicture(model, ask, refs("REF1", "REF2"), match = true, seed = 7)
+                plans += "${model.id}: $ask (no match)" to SelfPicturePlans.newPicture(model, ask, emptyList(), match = false, seed = 7)
+            }
+            for (view in PersonaSelfPictures.View.entries) {
+                plans += "${model.id}: ${view.word}" to SelfPicturePlans.newPicture(model, "", refs("REF1"), match = true, seed = 7, view = view)
+            }
+            plans += "${model.id}: trial" to SelfPicturePlans.trial(model, refs("REF1"), src("SOURCE"), match = true, seed = 7)!!
+        }
+        for (model in PictureModels.EDIT) {
+            for (ask in asks.filter { it.isNotEmpty() }) plans += "${model.id}: $ask" to SelfPicturePlans.change(model, src("SOURCE"), ask)
+            plans += "${model.id}: trial" to SelfPicturePlans.trial(model, emptyList(), src("SOURCE"), match = false, seed = 7)!!
+        }
+        return plans
+    }
+
+    /** The calls of [plan]: the first, and the match where there is one. */
+    private fun calls(plan: SelfPictureMaker.Plan): List<VeniceImages.Call> = listOfNotNull(plan.first, plan.match?.invoke("MADE"))
+
+    private fun promptOf(call: VeniceImages.Call): String = json(call)["prompt"]!!.jsonPrimitive.content
+
+    @Test
+    fun `every request carries the adult guard, first, and every generate request the negative prompt`() {
+        for ((what, plan) in everyPlan()) {
+            for (call in calls(plan)) {
+                val body = json(call)
+                val prompt = promptOf(call)
+                assertTrue("$what: $prompt", PictureGuard.guarded(prompt))
+                assertTrue(what, prompt.contains("adult body proportions"))
+                assertTrue(what, prompt.contains("19 years old"))
+                if (call.endpoint == VeniceImages.Endpoint.GENERATE) {
+                    val negative = body["negative_prompt"]!!.jsonPrimitive.content
+                    assertTrue("$what: $negative", PictureGuard.guardedNegative(negative))
+                    for (word in listOf("child", "teen", "loli", "petite childlike body", "school uniform", "sailor uniform", "randoseru", "classroom", "school")) {
+                        assertTrue("$what lacks $word", negative.split(", ").contains(word))
+                    }
+                } else {
+                    // Venice's edits take no negative prompt: the adult words are said once more instead.
+                    assertTrue(what, prompt.contains(PictureGuard.EDIT_LINE))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `no prompt asks for a school, a uniform, a child or younger, or names what she never has`() {
+        val never = Regex(
+            """(?i)\b(?:school|uniform|serafuku|sailor|randoseru|child|kid|loli|teen|younger|petite|glasses|red bow|vest|backpack|""" +
+                """no (?:clothes|shoes|choker|cuffs|glasses|bunny))\b|young adult"""
+        )
+        for ((what, plan) in everyPlan()) {
+            for (call in calls(plan)) {
+                // The one negation said on purpose: edits cannot carry a negative prompt.
+                val prompt = promptOf(call).replace(PictureGuard.EDIT_LINE, "")
+                assertNull("$what: ${never.find(prompt)?.value}", never.find(prompt))
+                // In sentences she is a woman; "1girl" is only the tag such models count one figure by.
+                assertFalse("$what: $prompt", prompt.replace("1girl", "").contains("girl", ignoreCase = true))
+            }
+        }
+    }
+
+    @Test
+    fun `nothing of his goes out with a picture`() {
+        val owner = "Ren Mori"
+        val words = PersonaSelfPictures.withoutHim("on Ren's bed, Mori asleep beside me", owner)
+        assertFalse(words.contains("Ren") || words.contains("Mori"))
+        for (model in PictureModels.ALL) {
+            val plan = if (model.kind == PictureModels.Kind.GENERATE) {
+                SelfPicturePlans.newPicture(model, words, refs("REF"), match = true, seed = 1)
+            } else {
+                SelfPicturePlans.change(model, src("SOURCE"), words)
+            }
+            for (call in calls(plan)) {
+                assertFalse(call.body.contains("Ren"))
+                assertFalse(call.body.contains("Mori"))
+            }
+        }
+        // The fixed words of every prompt say nothing of him.
+        for (text in listOf(PicturePrompts.TRIAL_SCENE, PicturePrompts.TRIAL_EDIT, PicturePrompts.KEEP_REST, PictureGuard.anchor(), PictureGuard.EDIT_LINE,
+            PicturePrompts.match(2, true, PictureModels.Style.ANIME_TAGS), PicturePrompts.STYLE_TAGS, PicturePrompts.STYLE_PHOTO, PicturePrompts.STYLE_ANIME_PROSE)) {
+            assertFalse(text, Regex("""(?i)\b(?:he|him|his|owner|boyfriend)\b""").containsMatchIn(text))
+        }
+    }
+
+    @Test
+    fun `a generate body holds the documented fields only, sized the way each model is sized`() {
+        val allowed = setOf(
+            "model", "prompt", "negative_prompt", "width", "height", "steps", "cfg_scale", "aspect_ratio", "resolution", "seed",
+            "safe_mode", "hide_watermark", "embed_exif_metadata", "format", "return_binary", "variants"
+        )
+        for (model in PictureModels.GENERATE) {
+            for (shape in PicturePrompts.Shape.entries) {
+                val body = json(VeniceImages.generate(model, "p", "n", shape, 123))
+                assertTrue(model.id + body.keys, allowed.containsAll(body.keys))
+                assertEquals(model.id, body["model"]!!.jsonPrimitive.content)
+                assertFalse(body["safe_mode"]!!.jsonPrimitive.boolean)
+                assertTrue(body["hide_watermark"]!!.jsonPrimitive.boolean)
+                assertFalse(body["embed_exif_metadata"]!!.jsonPrimitive.boolean)
+                assertFalse(body["return_binary"]!!.jsonPrimitive.boolean)
+                assertEquals("png", body["format"]!!.jsonPrimitive.content)
+                assertEquals(1, body["variants"]!!.jsonPrimitive.int)
+                assertEquals(123, body["seed"]!!.jsonPrimitive.int)
+                // Never a rewrite of the prompt, a style preset or a LoRA strength.
+                for (key in listOf("enhance_prompt", "style_preset", "lora_strength", "style_references", "inpaint")) assertNull(model.id, body[key])
+                when (model.sizing) {
+                    PictureModels.Sizing.PIXELS -> {
+                        assertEquals(shape.width, body["width"]!!.jsonPrimitive.int)
+                        assertEquals(shape.height, body["height"]!!.jsonPrimitive.int)
+                        assertTrue(shape.width <= 1280 && shape.height <= 1280 && shape.width % 64 == 0 && shape.height % 64 == 0)
+                        assertNull(body["aspect_ratio"])
+                    }
+                    PictureModels.Sizing.RATIO -> {
+                        assertEquals(shape.ratio, body["aspect_ratio"]!!.jsonPrimitive.content)
+                        assertNull(model.id, body["width"])
+                        assertNull(model.id, body["height"])
+                        assertNull(model.id, body["steps"])
+                        assertNull(model.id, body["cfg_scale"])
+                        assertEquals(model.resolutions, body["resolution"] != null)
+                    }
+                }
+            }
+        }
+        // Steps within what each model takes; guidance only on the SDXL models.
+        assertEquals(28, json(VeniceImages.generate(PictureModels.WAI, "p", "n", PicturePrompts.Shape.PORTRAIT, 1))["steps"]!!.jsonPrimitive.int)
+        assertEquals(8, json(VeniceImages.generate(PictureModels.Z_IMAGE, "p", "n", PicturePrompts.Shape.PORTRAIT, 1))["steps"]!!.jsonPrimitive.int)
+        assertEquals(10, json(VeniceImages.generate(PictureModels.CHROMA, "p", "n", PicturePrompts.Shape.PORTRAIT, 1))["steps"]!!.jsonPrimitive.int)
+        assertNull(json(VeniceImages.generate(PictureModels.CHROMA, "p", "n", PicturePrompts.Shape.PORTRAIT, 1))["cfg_scale"])
+        // A prompt longer than the model reads is cut to it; a seed out of range is brought into it.
+        assertEquals(1500, promptOf(VeniceImages.generate(PictureModels.WAI, "x".repeat(4000), "n", PicturePrompts.Shape.SQUARE, 1)).length)
+        assertEquals(VeniceImages.MAX_SEED, json(VeniceImages.generate(PictureModels.WAI, "p", "n", PicturePrompts.Shape.SQUARE, Int.MAX_VALUE))["seed"]!!.jsonPrimitive.int)
+    }
+
+    @Test
+    fun `an edit holds no negative prompt, seed, steps, guidance, watermark or strength, and a multi-edit names its model as modelId`() {
+        val never = listOf("negative_prompt", "seed", "steps", "cfg_scale", "strength", "hide_watermark", "style_preset", "enhance_prompt", "modelId")
+        val edit = json(VeniceImages.edit(PictureModels.QWEN_EDIT, "IMG", "p", "3:4"))
+        assertEquals(setOf("model", "image", "prompt", "aspect_ratio", "safe_mode", "output_format"), edit.keys)
+        never.forEach { assertNull(it, edit[it]) }
+        assertEquals("3:4", edit["aspect_ratio"]!!.jsonPrimitive.content)
+        assertNull(json(VeniceImages.edit(PictureModels.QWEN_EDIT, "IMG", "p"))["aspect_ratio"])
+
+        val multi = json(VeniceImages.multiEdit(PictureModels.QWEN_EDIT, listOf("A", "B", "C"), "p", "2:3"))
+        assertEquals(setOf("modelId", "images", "prompt", "aspect_ratio", "safe_mode", "output_format"), multi.keys)
+        assertEquals("qwen-edit-uncensored", multi["modelId"]!!.jsonPrimitive.content)
+        assertNull(multi["model"])
+        assertEquals(listOf("A", "B", "C"), multi["images"]!!.jsonArray.map { it.jsonPrimitive.content })
+        (never - "modelId").forEach { assertNull(it, multi[it]) }
+        assertEquals(VeniceImages.MULTI_EDIT_URL, VeniceImages.multiEdit(PictureModels.QWEN_EDIT, listOf("A"), "p").url)
+        // An edit model is never sent to generate, nor a generate model to an edit.
+        assertTrue(runCatching { VeniceImages.generate(PictureModels.QWEN_EDIT, "p", "n", PicturePrompts.Shape.SQUARE, 1) }.isFailure)
+        assertTrue(runCatching { VeniceImages.edit(PictureModels.WAI, "IMG", "p") }.isFailure)
+    }
+
+    @Test
+    fun `a new picture is drawn new, then matched to two of his pictures with her plate outfit unless her words dress her`() {
+        val plan = SelfPicturePlans.newPicture(PictureModels.WAI, "on a rooftop at night", refs("R1", "R2", "R3"), match = true, seed = 5)
+        assertEquals(VeniceImages.Endpoint.GENERATE, plan.first.endpoint)
+        val match = plan.match!!.invoke("NEW")
+        assertEquals(VeniceImages.Endpoint.MULTI_EDIT, match.endpoint)
+        val body = json(match)
+        // The new picture first, then at most two of his: the model takes three.
+        assertEquals(listOf("NEW", "R1", "R2"), body["images"]!!.jsonArray.map { it.jsonPrimitive.content })
+        assertEquals("2:3", body["aspect_ratio"]!!.jsonPrimitive.content)
+        assertTrue(promptOf(match).contains("and the same outfit, with its print and marks where they show"))
+        assertTrue(promptOf(match).contains("images 2 to 3"))
+        // Her words dress her: she keeps what she wears in the new picture.
+        val dressed = SelfPicturePlans.newPicture(PictureModels.WAI, "in a red hoodie at the konbini", refs("R1"), match = true, seed = 5).match!!.invoke("NEW")
+        assertTrue(promptOf(dressed).contains("exactly what she wears in image 1"))
+        assertTrue(promptOf(dressed).contains("image 2:"))
+        // Her plate outfit is drawn unless her words say what she wears; "boots on the rail" says where her boots are.
+        assertTrue(PicturePrompts.generate(PictureModels.WAI, "on a rooftop, boots on the rail").contains("navy microskirt"))
+        assertFalse(PicturePrompts.generate(PictureModels.WAI, "in a red hoodie").contains("navy microskirt"))
+        // Taking one thing off leaves the rest of her plate outfit on her.
+        val topless = PicturePrompts.generate(PictureModels.WAI, "topless on the bed")
+        assertTrue(topless.contains("navy microskirt") && topless.contains("navy thighhighs") && topless.contains("black platform boots"))
+        assertFalse(topless.contains("white shirt") || topless.contains("navy tube top"))
+        assertFalse(PicturePrompts.generate(PictureModels.WAI, "naked on the bed").contains("navy microskirt"))
+        // Off, or without a picture of his, there is no match.
+        assertNull(SelfPicturePlans.newPicture(PictureModels.WAI, "x", refs("R1"), match = false, seed = 5).match)
+        assertNull(SelfPicturePlans.newPicture(PictureModels.WAI, "x", emptyList(), match = true, seed = 5).match)
+        // The shape follows her words.
+        assertEquals(1216, json(SelfPicturePlans.newPicture(PictureModels.WAI, "wide shot of the street", emptyList(), false, 5).first)["width"]!!.jsonPrimitive.int)
+        assertEquals("16:9", SelfPicturePlans.editRatio("make it wide"))
+        assertEquals("3:4", SelfPicturePlans.editRatio("full body, new boots"))
+        assertNull(SelfPicturePlans.editRatio("red nails"))
+    }
+
+    @Test
+    fun `a change is one short positive edit of the picture she names`() {
+        val plan = SelfPicturePlans.change(PictureModels.QWEN_EDIT, src("SOURCE"), "red nails instead of blue", lookNow = "my roots are showing")
+        assertNull(plan.match)
+        val prompt = promptOf(plan.first)
+        assertTrue(prompt.length <= PicturePrompts.MAX_EDIT_CHARS)
+        assertTrue(prompt.contains("Change only this: red nails instead of blue."))
+        assertTrue(prompt.contains("Her look now, in her own words: my roots are showing."))
+        assertTrue(prompt.endsWith(PicturePrompts.KEEP_REST))
+        assertEquals("SOURCE", json(plan.first)["image"]!!.jsonPrimitive.content)
+        // The longest ask still fits whole with the guard.
+        val long = PicturePrompts.edit("y".repeat(PersonaSelfPictures.MAX_ASK_CHARS), lookNow = "z".repeat(400))
+        assertTrue(long.length <= PicturePrompts.MAX_EDIT_CHARS)
+        assertTrue(long.contains("y".repeat(PersonaSelfPictures.MAX_ASK_CHARS)))
+    }
+
+    @Test
+    fun `the test picture of a try is the same scene for every model, not sexual, in her usual outfit`() {
+        val sexual = Regex("""(?i)\b(?:nude|naked|topless|lingerie|sex\w*|lewd|nsfw|vibrat\w*|egg|controller|bed|underwear)\b""")
+        assertNull(sexual.find(PicturePrompts.TRIAL_SCENE))
+        assertNull(sexual.find(PicturePrompts.TRIAL_EDIT))
+        assertTrue(PicturePrompts.TRIAL_SCENE.contains("at night on a Tokyo street"))
+        assertFalse(PicturePrompts.namesClothes(PicturePrompts.TRIAL_SCENE))
+        for (model in PictureModels.GENERATE) {
+            val prompt = promptOf(SelfPicturePlans.trial(model, emptyList(), null, match = false, seed = 9)!!.first)
+            assertNull("${model.id}: ${sexual.find(prompt)?.value}", sexual.find(prompt))
+            assertTrue(model.id, prompt.contains(PicturePrompts.TRIAL_SCENE))
+            // Her usual outfit is drawn: the plate outfit, without the print, the tally or the toy.
+            assertTrue(model.id, prompt.contains("navy") && prompt.contains("platform boots"))
+            assertFalse(model.id, prompt.contains("ビッチ") || prompt.contains("正"))
+        }
+        // An edit model needs a picture of her to start from.
+        assertNull(SelfPicturePlans.trial(PictureModels.QWEN_EDIT, emptyList(), null, match = false, seed = 9))
+        assertEquals(VeniceImages.Endpoint.EDIT, SelfPicturePlans.trial(PictureModels.QWEN_EDIT, emptyList(), src("SRC"), false, 9)!!.first.endpoint)
+    }
+
+    @Test
+    fun `her look in the prompts is the one her picture file fixes`() {
+        val file = File("src/main/assets/persona/library/kisaragi-pics.md")
+        if (!file.isFile) return
+        val lock = PersonaSelfPictures.look(file.readText())
+        for (part in listOf("red hair", "ahoge", "gold hoop earrings", "black choker", "tongue barbell", "RIGHT side of her lower lip",
+            "white shirt tied under the bust", "navy bandeau", "midriff", "micro navy skirt with white trim", "white belt with gold heart buckle",
+            "navy thigh highs with white top stripes", "black platform boots", "2D clean anime illustration", "19")) {
+            assertTrue(part, lock.contains(part, ignoreCase = true))
+        }
+        val tags = PicturePrompts.generate(PictureModels.WAI, "x")
+        for (tag in listOf("red hair", "ahoge", "gold hoop earrings", "black choker", "tongue piercing", "lip piercing", "white shirt", "tied shirt",
+            "navy tube top", "midriff", "navy microskirt", "white belt", "heart buckle", "navy thighhighs", "black platform boots", "anime illustration",
+            "tsurime", "eyeliner", "black wrist cuffs", "red nails", "blue nails", "popped collar", "sleeves rolled up", "shiny skin", "crooked grin", "tongue out")) {
+            assertTrue(tag, tags.contains(tag))
+        }
+        val prose = PicturePrompts.generate(PictureModels.LUSTIFY_V8, "x")
+        assertTrue(prose.contains("silver stud on the right side of her lower lip"))
+        assertTrue(prose.contains("a white belt with a gold heart buckle"))
+        for (part in listOf("heavy winged black liner", "black irises", "wrist cuffs with gold buckles turned out", "alternate red and steel blue",
+            "deep golden-brown salon tan, skin glossy with oil", "collar flipped up", "thin pale straps showing high on both hips above the skirt",
+            "glossy navy thigh-highs", "black patent platform boots", "crooked grin", "barbell showing", "gyaru nightlife street fashion")) {
+            assertTrue(part, prose.contains(part))
+        }
+    }
+
+    @Test
+    fun `a saved choice that is not a generate model falls back to the default, and every choice shows its price`() {
+        assertEquals(PictureModels.WAI, PictureModels.generateModelOf(LLMConfig(personaPictureModel = "qwen-edit-uncensored")))
+        assertEquals(PictureModels.WAI, PictureModels.generateModelOf(LLMConfig(personaPictureModel = "gone-model")))
+        assertEquals(PictureModels.LUSTIFY_V8, PictureModels.generateModelOf(LLMConfig(personaPictureModel = "LUSTIFY-V8")))
+        assertEquals(PictureModels.QWEN_EDIT, PictureModels.editModelOf(LLMConfig(personaPictureEditModel = "wai-Illustrious")))
+        assertTrue(LLMConfig().personaPictureMatch)
+        assertEquals("Anime (WAI Illustrious) · 1¢ a picture (default)", PictureModels.choiceLabel(PictureModels.WAI, PictureModels.DEFAULT_GENERATE))
+        assertEquals("Hunyuan Image 3 · 9¢ a picture · not marked uncensored", PictureModels.choiceLabel(PictureModels.HUNYUAN, PictureModels.DEFAULT_GENERATE))
+        assertEquals("4¢", PictureModels.cents(0.04))
+        assertEquals("0.5¢", PictureModels.cents(0.005))
+        assertEquals(0.05, PictureModels.pictureCost(PictureModels.WAI, match = true), 1e-9)
+        // Private tier only: nothing from Venice's Anonymized tier.
+        for (model in PictureModels.ALL) {
+            assertFalse(model.id, com.opendroid.ai.core.life.eyes.EyesModels.anonymized(model.id))
+        }
+        assertNotNull(PictureModels.of("chroma"))
+    }
+
+    @Test
+    fun `a picture in her own time is priced by its model, and its age check by its tokens`() {
+        val prices = com.opendroid.ai.core.life.OwnPrices
+        val picture = com.opendroid.ai.core.life.OwnPurpose.PICTURE
+        assertEquals(0.01, prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "wai-Illustrious")), 1e-9)
+        assertEquals(0.04, prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "qwen-edit-uncensored")), 1e-9)
+        assertEquals(0.09, prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "hunyuan-image-v3")), 1e-9)
+        // The describer's look at it: a fraction of a cent.
+        assertTrue(prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "google-gemma-4-31b-it", 900, 20)) < 0.001)
+        // Anything else under a picture is an age check, priced by its tokens, typical ones where a failed one has none: never 4¢.
+        assertTrue(prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "google-gemma-4-31b-it")) < 0.001)
+        assertTrue(prices.usd(com.opendroid.ai.core.life.OwnLedger.Call(0L, picture, "deepseek-v4-1-flash-1017-uncensored", ok = false)) < 0.01)
+    }
+}
