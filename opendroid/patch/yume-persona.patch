+    internal fun phoneLine(phone: com.opendroid.ai.core.life.phone.PhoneTime.Offer): String = buildString {
+        append("      go: scroll <app> / go: watch <app> [<what>] / go: look <app>   you borrow his screen for one of his apps: ")
+        append(phone.apps.take(MAX_APPS_NAMED).joinToString(", "))
+        append(". they are his apps, logged in as him, and you have no accounts of your own, so you only look: ")
+        append("you open, scroll, read, watch and search; no likes, follows, comments, posts, messages, shares or saves. ")
+        append("it runs only while his phone is unlocked and he has not touched it for a minute")
+        if (phone.asks) append(", once he lets you")
+        append(". it ends the moment he touches it, and the app puts his screen back as it was. the sound is off. ")
+        append(if (phone.minutesLeft == 1) "1 min of phone time left today." else "${phone.minutesLeft} min of phone time left today.")
+        if (!phone.free && !phone.asks) append(" he has his phone in hand or it is locked right now, so it would not start now.")
+    }
