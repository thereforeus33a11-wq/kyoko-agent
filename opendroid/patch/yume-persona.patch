+    @Test
+    fun `an unlock after a long quiet brings her next moment to a few minutes from now, inside his bounds`() {
+        val awake = State(on = true, wake = Wake.At(now + 50 * minute), why = Why.ASKED, lastAtMillis = now - hour, moments = listOf(now - hour))
+        fun forward(state: State = awake, heLastWrote: Long? = now - 3 * hour, b: Bounds = bounds) =
+            PersonaOwnTime.broughtForward(state, now, heLastWrote, b)
+
+        assertEquals(now + 3 * minute, forward())
+        // No message of his among the recent rows counts as a long quiet.
+        assertEquals(now + 3 * minute, forward(heLastWrote = null))
+        // He wrote within the last 2 hours: the time stays.
+        assertNull(forward(heLastWrote = now - 2 * hour + minute))
+        assertEquals(now + 3 * minute, forward(heLastWrote = now - 2 * hour))
+        // A moment in the last half hour: the time stays.
+        assertNull(forward(awake.copy(lastAtMillis = now - 29 * minute)))
+        // Asleep, off, waiting for him, nothing set, or after a failed attempt: the time stays.
+        assertNull(forward(awake.copy(asleepSince = now - hour, sleepUntil = now + 5 * hour)))
+        assertNull(forward(awake.copy(on = false)))
+        assertNull(forward(awake.copy(wake = Wake.WhenHeWrites)))
+        assertNull(forward(awake.copy(wake = Wake.Unset)))
+        assertNull(forward(awake.copy(failures = 1)))
+        // The moment of her waking tells her what her sleep pass came to: it stays where it is.
+        assertNull(forward(awake.copy(why = Why.WOKE)))
+        assertNull(forward(awake.copy(why = Why.WOKEN)))
+        // Already sooner than that: the time stays.
+        assertNull(forward(awake.copy(wake = Wake.At(now + 2 * minute))))
+        assertNull(forward(awake.copy(wake = Wake.At(now + 3 * minute))))
+        // His least gap from her last moment holds.
+        assertEquals(now - hour + 70 * minute, forward(b = Bounds(minGapMillis = 70 * minute, maxPerDay = 24)))
+        // And so does the day's count: with the day full, the moment waits until the oldest is a day old.
+        val full = awake.copy(moments = listOf(now - 23 * hour, now - hour), wake = Wake.At(now + 2 * hour))
+        assertEquals(now + hour, forward(full, b = Bounds(minGapMillis = 15 * minute, maxPerDay = 2)))
+        assertNull(forward(full.copy(wake = Wake.At(now + 30 * minute)), b = Bounds(minGapMillis = 15 * minute, maxPerDay = 2)))
+        // The numbers are the ones the rule names.
+        assertEquals(2 * hour, PersonaOwnTime.UNLOCK_QUIET_MILLIS)
+        assertEquals(30 * minute, PersonaOwnTime.UNLOCK_AFTER_MOMENT_MILLIS)
+        assertEquals(3 * minute, PersonaOwnTime.UNLOCK_SOON_MILLIS)
+        // The reason is stored and read back, with the time and the reason it replaced.
+        val unlocked = PersonaOwnTime.unlocked(awake, now + 3 * minute)
+        assertEquals(awake.copy(wake = Wake.At(now + 3 * minute), why = Why.UNLOCKED, broughtFromAt = now + 50 * minute, broughtFromWhy = Why.ASKED), unlocked)
+        val stored = PersonaOwnTime.decode(PersonaOwnTime.encode(unlocked))
+        assertEquals(unlocked, stored)
+        // Brought forward twice, the time from before the first unlock is the one kept.
+        assertEquals(unlocked.copy(wake = Wake.At(now + 2 * minute)), PersonaOwnTime.unlocked(unlocked, now + 2 * minute))
+    }
+
+    @Test
+    fun `a message of his after an unlock gives the moment back the time and the reason it had`() {
+        val awake = State(on = true, wake = Wake.At(now + 50 * minute), why = Why.DEFAULT, lastAtMillis = now - hour, lastGapMillis = 2 * hour)
+        val unlocked = PersonaOwnTime.unlocked(awake, now + 3 * minute)
+        assertEquals(awake, PersonaOwnTime.setBack(unlocked, now + minute, bounds))
+        // A time that has passed meanwhile is due now, not in the past.
+        assertEquals(Wake.At(now + hour), PersonaOwnTime.setBack(unlocked, now + hour, bounds)!!.wake)
+        // Without the time it replaced, it is the usual gap after his message.
+        val bare = awake.copy(why = Why.UNLOCKED)
+        val back = PersonaOwnTime.setBack(bare, now, bounds)!!
+        assertEquals(Wake.At(now + PersonaOwnTime.defaultGapMillis(bare.lastGapMillis, bounds)), back.wake)
+        assertEquals(Why.DEFAULT, back.why)
+        // Nothing an unlock did: nothing to give back.
+        assertNull(PersonaOwnTime.setBack(awake, now, bounds))
+        assertNull(PersonaOwnTime.setBack(unlocked.copy(wake = Wake.WhenHeWrites), now, bounds))
+    }
+}
