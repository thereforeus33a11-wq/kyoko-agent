--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/own/OwnVoice.kt
@@ -0,0 +1,288 @@
+package com.opendroid.ai.core.voice.own
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.SystemClock
+import android.util.Log
+import com.k2fsa.sherpa.onnx.GenerationConfig
+import com.k2fsa.sherpa.onnx.OfflineTts
+import com.k2fsa.sherpa.onnx.OfflineTtsConfig
+import com.k2fsa.sherpa.onnx.OfflineTtsModelConfig
+import com.k2fsa.sherpa.onnx.OfflineTtsVitsModelConfig
+import java.io.File
+import java.io.FileOutputStream
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.concurrent.thread
+
+/**
+ * Her own voice, on the phone: the voice trained from her voice actress's recordings,
+ * run by sherpa-onnx, with Japanese read by Open JTalk. Nothing she says leaves the
+ * phone. The voice reproduces sound from her words and never chooses any.
+ *
+ * The voice's files ship inside the APK (assets/own_voice, added by the build from a
+ * private folder that is never committed) and are unpacked once into the app's own
+ * storage, because Open JTalk reads its dictionary from files.
+ *
+ * One line at a time: [say] blocks until the line has been heard to its end, or [stop]
+ * cut it off.
+ */
+class OwnVoice(private val context: Context) {
+
+    private class Engine(val tts: OfflineTts, val jtalk: OpenJTalk, val kana: KanaText)
+
+    private val lock = Any()
+    // Held by a line from the moment it reads the engine until its sound is released, so
+    // the engine is never freed under a sentence that is still being made.
+    private val inUse = Any()
+    @Volatile private var engine: Engine? = null
+    @Volatile private var unusable = false
+    // A load that failed for a reason that can pass (full storage, a damaged unpack) is
+    // tried again from this time on (SystemClock.elapsedRealtime).
+    @Volatile private var retryAt = 0L
+    @Volatile private var released = false
+    private val stopFlag = AtomicBoolean(false)
+    @Volatile private var track: AudioTrack? = null
+
+    private val home: File get() = File(context.noBackupFilesDir, HOME)
+
+    /** Whether this build carries her voice at all. */
+    fun isBundled(): Boolean =
+        runCatching { context.assets.list(ASSETS)?.contains(STAMP) == true }.getOrDefault(false)
+
+    /** Unpacks and loads the voice if that has not happened yet. False if it cannot be used. */
+    fun prepare(): Boolean {
+        engine?.let { return true }
+        if (unusable || released || SystemClock.elapsedRealtime() < retryAt) return false
+        synchronized(lock) {
+            engine?.let { return true }
+            if (unusable || released || SystemClock.elapsedRealtime() < retryAt) return false
+            return try {
+                if (!isBundled()) { unusable = true; return false }
+                unpackIfNeeded()
+                val voiceDir = File(home, "voice")
+                val tts = OfflineTts(config = OfflineTtsConfig(
+                    model = OfflineTtsModelConfig(
+                        vits = OfflineTtsVitsModelConfig(
+                            model = File(voiceDir, "model.onnx").path,
+                            tokens = File(voiceDir, "tokens.txt").path,
+                        ),
+                        numThreads = THREADS,
+                    )
+                ))
+                val jtalk = OpenJTalk.open(File(home, DICTIONARY).path)
+                    ?: run { tts.release(); error("Open JTalk could not read its dictionary") }
+                val dict = CmuDict.load(File(home, CMUDICT))
+                engine = Engine(tts, jtalk, KanaText { dict[it] })
+                true
+            } catch (e: Throwable) {
+                // A broken or missing voice must not take the app's speech with it: the
+                // phone's own voice says her lines instead.
+                Log.e(TAG, "Her own voice could not be loaded", e)
+                if (e is LinkageError) {
+                    // No native voice for this phone in this build: that does not pass.
+                    unusable = true
+                } else {
+                    // Full storage, a damaged or half-done unpack, a load that failed once:
+                    // what was unpacked goes, so it neither keeps taking the space nor is
+                    // read again as it is, and the voice is tried again after a while.
+                    runCatching { home.deleteRecursively() }
+                    retryAt = SystemClock.elapsedRealtime() + RETRY_AFTER_MILLIS
+                }
+                false
+            }
+        }
+    }
+
+    /**
+     * Says [normalized] (text already through the speech normalizer's persona pass) in her
+     * voice. True when it was heard to its end; false when [stop] cut it off, [cancelled]
+     * was already true, or it failed on the way; null when her voice cannot say it at all
+     * (not loaded, or text Open JTalk cannot read), so that another voice can.
+     */
+    fun say(normalized: String, speed: Float = 1.0f, cancelled: () -> Boolean = { false }): Boolean? {
+        if (!prepare()) return null
+        synchronized(inUse) { return sayWith(engine ?: return null, normalized, speed, cancelled) }
+    }
+
+    private fun sayWith(e: Engine, normalized: String, speed: Float, cancelled: () -> Boolean): Boolean? {
+        stopFlag.set(false)
+        // A stop between the caller's last look and the line above was undone by it. The
+        // caller ends its line before it stops the voice, so the line is seen ended here.
+        if (released || cancelled()) return false
+        val sentences = JapanesePhonemes.phonemizeAll(e.kana.convert(normalized)) { e.jtalk.labels(it) }
+            ?: return null
+        if (sentences.isEmpty()) return true
+        val codepoints = sentences.map { s -> s.map { it.codePointAt(0) }.toIntArray() }.toTypedArray()
+
+        val rate = e.tts.sampleRate()
+        val minBuffer = AudioTrack.getMinBufferSize(rate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_FLOAT)
+        val audio = AudioTrack.Builder()
+            .setAudioAttributes(AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_ASSISTANT)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                .build())
+            .setAudioFormat(AudioFormat.Builder()
+                .setSampleRate(rate)
+                .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                .setEncoding(AudioFormat.ENCODING_PCM_FLOAT)
+                .build())
+            .setBufferSizeInBytes(maxOf(minBuffer, rate * 4 / 2))
+            .setTransferMode(AudioTrack.MODE_STREAM)
+            .build()
+        track = audio
+        var written = 0L
+        fun play(samples: FloatArray) {
+            var off = 0
+            while (off < samples.size && !stopFlag.get()) {
+                val n = audio.write(samples, off, samples.size - off, AudioTrack.WRITE_BLOCKING)
+                if (n <= 0) break
+                off += n
+            }
+            written += off
+        }
+        try {
+            audio.play()
+            val pace = speed.coerceIn(0.5f, 2.0f)
+            val config = GenerationConfig(speed = pace, sid = 0, phonemeCodepoints = codepoints)
+            // A breath of silence first, so a waking speaker does not swallow her first sound.
+            play(FloatArray((rate * LEAD_IN_SECONDS).toInt()))
+            val pause = FloatArray((rate * SENTENCE_PAUSE_SECONDS / pace).toInt())
+            var first = true
+            var failure: Throwable? = null
+            // Each sentence plays as soon as it is made, while the next is being made, with a
+            // short pause between sentences, as a person leaves. The native side calls this
+            // by name as invoke(float[]) returning Integer: a lambda compiled the usual way
+            // (invokedynamic) has only the erased invoke(Object), so nothing would be called
+            // and nothing heard. An object declares it. Nothing is thrown back into native code.
+            val feed = object : (FloatArray) -> Int {
+                override fun invoke(samples: FloatArray): Int = try {
+                    if (stopFlag.get()) {
+                        0
+                    } else {
+                        if (!first) play(pause)
+                        first = false
+                        play(samples)
+                        if (stopFlag.get()) 0 else 1
+                    }
+                } catch (t: Throwable) {
+                    failure = t
+                    0
+                }
+            }
+            e.tts.generateWithConfigAndCallback("", config, feed)
+            failure?.let { throw it }
+            val voiced = written
+            // A streaming track starts only once its buffer is full, so a line shorter than
+            // the buffer would never be heard. Silence behind her line fills the buffer and
+            // pushes the last of it through; what is left of the silence is cut off below.
+            if (!stopFlag.get()) play(FloatArray(audio.bufferCapacityInFrames))
+            // Let her line play out. A device that stops reporting progress does not hold
+            // the line for ever: the wait is bounded by what is still to be heard.
+            val unheard = (voiced - audio.playbackHeadPosition.toLong()).coerceAtLeast(0L)
+            val deadline = System.currentTimeMillis() + unheard * 1000 / rate + 2_000
+            while (!stopFlag.get() && audio.playbackHeadPosition.toLong() < voiced &&
+                System.currentTimeMillis() < deadline) Thread.sleep(20)
+            return !stopFlag.get()
+        } catch (t: Throwable) {
+            Log.e(TAG, "Her own voice failed on a line", t)
+            return false
+        } finally {
+            track = null
+            runCatching { if (stopFlag.get()) { audio.pause(); audio.flush() } ; audio.stop() }
+            audio.release()
+        }
+    }
+
+    /** Cuts off whatever she is saying now, mid-word. */
+    fun stop() {
+        stopFlag.set(true)
+        track?.let { runCatching { it.pause(); it.flush() } }
+    }
+
+    fun release() {
+        released = true
+        stop()
+        // A line being made holds the engine until the sentence under way is done (the
+        // stop makes it the last), so it is freed after that, off the caller's thread.
+        thread(name = "OwnVoiceRelease") {
+            synchronized(inUse) {
+                synchronized(lock) {
+                    engine?.let { it.tts.release(); it.jtalk.close() }
+                    engine = null
+                }
+            }
+        }
+    }
+
+    /** Copies the voice out of the APK once per build of it (the stamp says which). */
+    private fun unpackIfNeeded() {
+        val stamp = context.assets.open("$ASSETS/$STAMP").use { it.readBytes().decodeToString().trim() }
+        val mine = File(home, STAMP)
+        if (mine.exists() && mine.readText().trim() == stamp) return
+        home.deleteRecursively()
+        copyAssetDir(ASSETS, home)
+        mine.writeText(stamp)
+    }
+
+    private fun copyAssetDir(from: String, to: File) {
+        val children = context.assets.list(from) ?: emptyArray()
+        if (children.isEmpty()) {
+            to.parentFile?.mkdirs()
+            val tmp = File(to.path + ".part")
+            context.assets.open(from).use { input ->
+                FileOutputStream(tmp).use { out ->
+                    input.copyTo(out, 1 shl 16)
+                    // On the disk before it takes its name: a power cut must not leave a
+                    // short file under the right name, with a stamp that says all is well.
+                    out.fd.sync()
+                }
+            }
+            check(tmp.renameTo(to)) { "could not place $to" }
+            return
+        }
+        to.mkdirs()
+        for (child in children) {
+            if (child == STAMP && from == ASSETS) continue
+            copyAssetDir("$from/$child", File(to, child))
+        }
+    }
+
+    companion object {
+        private const val TAG = "OwnVoice"
+        const val ASSETS = "own_voice"
+        const val HOME = "own_voice"
+        const val STAMP = "VERSION"
+        const val DICTIONARY = "open_jtalk_dic_utf_8-1.11"
+        const val CMUDICT = "cmudict.dict"
+        private const val THREADS = 2
+        /** Silence before her first sound, in seconds. */
+        const val LEAD_IN_SECONDS = 0.06f
+        /** Pause between two sentences of one line, in seconds at normal speed. */
+        const val SENTENCE_PAUSE_SECONDS = 0.22f
+        /** How long a load that failed for a passing reason waits before it is tried again. */
+        const val RETRY_AFTER_MILLIS = 10 * 60_000L
+    }
+}
+
+/** The CMU Pronouncing Dictionary: word to its first ARPAbet pronunciation. */
+object CmuDict {
+    fun load(file: File): Map<String, List<String>> {
+        if (!file.exists()) return emptyMap()
+        val map = HashMap<String, List<String>>(140_000)
+        file.bufferedReader(Charsets.UTF_8).useLines { lines ->
+            for (line in lines) parseLine(line)?.let { (w, p) -> map.putIfAbsent(w, p) }
+        }
+        return map
+    }
+
+    /** "word PH PH" to (word, phones); variants ("word(2)") and comments are skipped. */
+    fun parseLine(line: String): Pair<String, List<String>>? {
+        val body = line.substringBefore('#').trim()
+        if (body.isEmpty()) return null
+        val parts = body.split(' ').filter { it.isNotEmpty() }
+        if (parts.size < 2 || '(' in parts[0]) return null
+        return parts[0] to parts.drop(1)
+    }
+}
