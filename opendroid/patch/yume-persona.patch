+            activeProvider = custom,
+            apiKeys = mapOf(custom to "venice-key"),
+            customEndpoints = mapOf(custom to venice)
+        ).let { it.withKeyHost(custom, "venice-key", it.keyHostNow(custom)) }
+        assertEquals(mapOf(custom to "api.venice.ai"), typedAtVenice.apiKeyHosts)
+
+        // The same host, however the address is written.
+        for (same in listOf(venice, " https://API.VENICE.AI/api/v1/ ", "https://api.venice.ai/other/path")) {
+            assertEquals(same, "venice-key", typedAtVenice.apiKeyFor(custom, same))
+        }
+        // Pointed at his own machine, or at another service: that one gets no key.
+        for (other in listOf(
+            "http://192.168.1.20:8080/v1", "http://127.0.0.1:8080/v1", "https://openrouter.ai/api/v1",
+            "https://venice.ai/api/v1", "https://api.venice.ai.example.com/v1", ""
+        )) {
+            assertEquals(other, "", typedAtVenice.apiKeyFor(custom, other))
+        }
+
+        // A key saved before the host was recorded goes where the provider points, as it always did.
+        val unrecorded = typedAtVenice.copy(apiKeyHosts = emptyMap())
+        assertEquals("venice-key", unrecorded.apiKeyFor(custom, "http://192.168.1.20:8080/v1"))
+        // A provider with a fixed address has no host to record, and its key is its key.
+        val fixed = LLMConfig(apiKeys = mapOf("OpenAI" to "k"), customEndpoints = mapOf("OpenAI" to "http://127.0.0.1"))
+        assertEquals("", fixed.keyHostNow("OpenAI"))
+        assertEquals(emptyMap<String, String>(), fixed.withKeyHost("OpenAI", "k", fixed.keyHostNow("OpenAI")).apiKeyHosts)
+        assertEquals("k", fixed.apiKeyFor("OpenAI", ""))
+        // The other two typed addresses are held to the same.
+        val ollama = LLMConfig(apiKeys = mapOf("Ollama" to "o"), ollamaUrl = "http://192.168.1.20:11434")
+            .let { it.withKeyHost("Ollama", "o", it.keyHostNow("Ollama")) }
+        assertEquals("o", ollama.apiKeyFor("Ollama", "192.168.1.20:11434"))
+        assertEquals("", ollama.apiKeyFor("Ollama", "https://ollama.example.com"))
+        // Clearing the key clears what was noted for it; typing it again notes the new host.
+        assertEquals(emptyMap<String, String>(), typedAtVenice.withKeyHost(custom, "", "api.venice.ai").apiKeyHosts)
+        val moved = typedAtVenice.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:8080/v1"))
+        val retyped = moved.withKeyHost(custom, "local-key", moved.keyHostNow(custom))
+        assertEquals(mapOf(custom to "192.168.1.20"), retyped.apiKeyHosts)
+    }
