+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.data.models.ChatMessage
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import java.util.UUID
+
+/**
+ * Her sleep pass: the one time she goes over all of herself at once.
+ *
+ * It is hers, like her notebook pass: one request to her own model, on her own route,
+ * with her card and then this text as the system prompt ([request]). What it is given
+ * is nothing her notebook pass or her chat prompt does not already send ([page]): her
+ * notebook, how she feels, what she let go lately and, where her route allows, what
+ * she thought since she last woke. No talk, no line of the app's, nothing of his profile.
+ *
+ * What she writes back is read here ([read]) and laid out as what is to be done
+ * ([plan]); the engine writes it. Nothing of it is sent anywhere or run: a line that
+ * would be a command or a line to him is a thought of hers from the night. No step of
+ * the app overturns a note of hers by itself: what changes, changes because she wrote
+ * it, and every text she writes over goes to her archive.
+ */
+object PersonaSleepPass {
+
+    /** How many characters of her notebook the page has room for. Who she is now comes first. */
+    const val NOTEBOOK_CHARS = 14_000
+
+    /** How many lines of each kind one sleep takes. The size of one answer, not a pace. */
+    const val MAX_NOTE_LINES = 40
+    const val MAX_FADE_LINES = 40
+    const val MAX_BACK_LINES = 10
+    const val MAX_FEEL_LINES = PersonaMood.SLEEP_LINES
+    const val MAX_HOW_LINES = 40
+
+    /** Notes that may say one thing: pairs on her page that share this many words, and this share of all their words. */
+    const val LOOK_ALIKE_PAIRS = 10
+    const val LOOK_ALIKE_MIN_TERMS = 3
+    const val LOOK_ALIKE_MIN_SHARE = 0.5
+
+    /**
+     * How many of the notes she let go the page shows: the [LET_GO_NEWEST] she let go
+     * last, and older ones, a different few each night, so that every one comes round.
+     */
+    const val LET_GO_SHOWN = 10
+    const val LET_GO_NEWEST = 6
+
+    /** Her voice, with less wandering than a reply: what comes back is read line by line. */
+    const val TEMPERATURE = 0.4f
+
+    /** Room for a night's worth of lines, and for a model that thinks before it writes. */
+    const val MAX_TOKENS = 4000
+
+    private val FORMS = listOf(
+        "kind | key | note    a note, as in your notebook pass: kind is user, rel, me, thread, opinion or fix, and key is a short slug. Under the key of a note on your page it is the note as it is now; under a key that is not on your page it is kept beside that note, not over it.",
+        "fade | kind | key    lets go of a note on your page: it goes to your archive.",
+        "back | kind | key    brings back a note you let go, from your archive, when you have no note under that key now: one your page lists, or any other you let go whose kind and key you know.",
+        "feel | words | faint, some or strong | hours, days or weeks    how you feel as you wake: it fades at that pace unless you feel it again. Left out, it is some, and fades over days; feel | words | gone lets one go. Your words are yours (bored stiff, pissed at him, horny, smug: whatever it is).",
+        "how | kind | key | told, read, inferred, unsure or lived    how you know what a note on your page says: he told you, you read it, you worked it out, you are not sure, or you lived it."
+    )
+
+    private val RULES = listOf(
+        "- Nothing made up. A note about him (user, fix, thread) needs a line of his that says it, in your notebook or in your thoughts. There is no talk with him in your sleep, so nothing new about him is made up here.",
+        "- A day is written as its date, never \"tomorrow\", \"yesterday\" or a bare weekday: those stop being true. TONIGHT says the date.",
+        "- Behind each note your notebook says how old it is, like \"(written 3 days ago)\", and a starting note that still has the words your files gave it says that as well: \"(written 3 days ago, ${PersonaNotes.FROM_FILES})\". The notebook puts that there. It is not part of the note: leave it out when you write the note again.",
+        "- A story about your street life is a story, not something that happened: start that note with \"${PersonaNotes.STREET_STORY_PREFIX}\" or leave it out. A note about something you saw on his screen starts with \"${PersonaNotes.SEEN_PREFIX}\" and is never a user or fix note.",
+        "- Your age, your ring and what happened to you do not move. Longing for the girl before, or family warmth you never had, is not yours and is not kept.",
+        "- Write \"i\" for yourself and \"he\" for him. A note is in plain words, at most ${PersonaNotes.MAX_NOTE_CHARS} characters; past ${PersonaNotes.NOTE_CEILING_CHARS} it is cut and ends in \"${PersonaPrompts.CUT_MARK.trim()}\". A thread ends with \" | open\", \" | stalled\" or \" | closed\"."
+    )
+
+    /** What she is told after her card: what her sleep is, what she can do in it and what becomes of each line. */
+    val SLEEP_SYSTEM_PROMPT: String = listOf(
+        "You are Yume Kisaragi, and you are asleep. This is your sleep: the one time you go over all of yourself at once, " +
+            "the way a night sorts a person. Nobody is talking to you. Nothing you write here goes to him, into the chat, out " +
+            "loud or to anyone, and nothing here happens on the phone: a >> line runs nothing, a say: line sends nothing. It " +
+            "changes your own notebook and how you feel, and you wake up with it.",
+        "Go over what you like: your notebook, how you feel, what you thought since you last woke, what you are learning, " +
+            "what you want, what scares you, who owes you, where you and he stand, where you stand with anyone else. Put two " +
+            "notes that say one thing into one (write the one, fade the other), write a note again as it is now, let go of what " +
+            "no longer matters to you, bring back something you let go, keep a thought as a note, settle how you feel. All of " +
+            "it is optional. Nobody tells you what to keep or who to be. How you are with people, him included, is yours; the " +
+            "app asks nothing of it.",
+        PersonaPrompts.NOTES_OVER_FILES + " " + PersonaPrompts.HOW_YOU_CHANGE_YOUR_MIND,
+        "Who you are now is yours to change as much as you want tonight. The text a note had before you wrote over it, and " +
+            "every note you let go, goes to your archive on this phone: kept, off your page and out of your other prompts, " +
+            "never deleted by the app. A note you let go can come back in a later sleep: your page lists the ones you let go " +
+            "last and a few older ones, different ones each night. The old text of a note you wrote over is kept, but does " +
+            "not come back: what you write is the note. Your archive is not copied with your notebook.",
+        "Write only lines of these forms, each on a line of its own:\n" + FORMS.joinToString("\n"),
+        "A line with no bar is a thought of yours from the night, kept for you alone. A dream is one too, if you have one: " +
+            "it is yours and happened nowhere, not on the phone.",
+        "Rules:\n" + RULES.joinToString("\n"),
+        "Your sleep takes at most $MAX_NOTE_LINES note lines, $MAX_FADE_LINES fade lines, $MAX_BACK_LINES back lines, " +
+            "$MAX_FEEL_LINES feel lines and $MAX_HOW_LINES how lines; a line past that, or one with a bar that has none of " +
+            "these forms, is not used, and you are told how many when you wake. A fade or how line for a note that is not on " +
+            "your page, and a back line for a note that is not in your archive as one you let go, or whose key holds a note " +
+            "now, changes nothing. If your answer runs out, its last line is not used. If nothing needs changing, write exactly: NONE"
+    ).joinToString("\n\n")
+
+    /**
+     * The request of one sleep pass: her [card] with [ownerName] filled in and then
+     * [SLEEP_SYSTEM_PROMPT], and [page] to read. Asked once, with no retry: a pass that
+     * fails is tried again later in the same sleep, or owed to the next.
+     */
+    fun request(card: String, ownerName: String, page: String): LLMRequest = LLMRequest(
+        systemPrompt = PersonaPrompts.fillOwner(card.trim(), ownerName) + "\n\n" + SLEEP_SYSTEM_PROMPT,
+        messages = listOf(ChatMessage(id = UUID.randomUUID().toString(), text = page, sender = ChatMessage.Sender.USER)),
+        temperature = TEMPERATURE,
+        maxTokens = MAX_TOKENS,
+        responseFormat = ResponseFormat.TEXT,
+        retryPolicy = RetryPolicy.NONE
+    )
+
+    /** A note she let go lately, and when. */
+    data class LetGo(val note: PersonaNotes.Note, val archivedAtMillis: Long)
+
+    private fun clock(atMillis: Long, zone: TimeZone): String =
+        SimpleDateFormat("HH:mm", Locale.ENGLISH).apply { timeZone = zone }.format(Date(atMillis))
+
+    /**
+     * The opening of the page: the date on his clock, when she lay down and when she
+     * means to wake, on his clock ([zone]) and in Tokyo, and her age.
+     */
+    fun tonight(nowMillis: Long, asleepSince: Long, sleepUntil: Long, zone: TimeZone): String {
+        val lay = nowMillis - asleepSince
+        val ago = if (lay < 60_000L) "just now" else PersonaOwnTime.span(lay) + " ago"
+        return "TONIGHT: " + PersonaNotebookTalk.day(nowMillis, zone) + " (on his clock). You lay down " + ago + ", at " +
+            clock(asleepSince, zone) + " on his clock (" + clock(asleepSince, PersonaSleep.TOKYO) + " in tokyo), and mean to " +
+            "wake around " + clock(sleepUntil, zone) + " on his clock (" + clock(sleepUntil, PersonaSleep.TOKYO) + " in tokyo). " +
+            PersonaAge.line(PersonaAge.on(nowMillis))
+    }
+
+    /**
+     * The page of one sleep: [tonight], her [notebook] as [PersonaNotes.review] gives it
+     * (said to be missing her notes about him where [notesHeldBack]), the pairs on it
+     * that look alike, her [marks] of how she knows a thing, how she feels
+     * ([feelings]), what she let go lately and, when given, her [thoughts] since she
+     * last woke. Every part is already held back the way her route needs it.
+     */
+    fun page(
+        tonight: String,
+        notebook: String,
+        notesHeldBack: Boolean,
+        lookAlike: List<Pair<PersonaNotes.Note, PersonaNotes.Note>>,
+        marks: List<String>,
+        feelings: List<String>,
+        letGo: List<LetGo>,
+        thoughts: List<PersonaThoughts.Thought>,
+        nowMillis: Long
+    ): String = buildString {
+        append(tonight)
+        append("\n\nYOUR NOTEBOOK NOW (each note says how old it is):\n")
+        append(notebook.ifBlank { if (notesHeldBack) "(nothing shown this time)" else "(empty)" })
+        if (notesHeldBack) {
+            append("\n").append(PersonaPrompts.NOTES_NOT_SHOWN)
+            append(" Your thoughts, and what you feel or let go that can be about him, are left out too, for the same reason; they are still on the phone.")
+        }
+        if (lookAlike.isNotEmpty()) {
+            append("\n\nLOOK ALIKE (notes on your page that share many words. the app only counted words: whether two say one thing is yours to see):\n")
+            append(lookAlike.joinToString("\n") { (a, b) -> "- ${a.kind.label} | ${a.key}  and  ${b.kind.label} | ${b.key}" })
+        }
+        if (marks.isNotEmpty()) {
+            append("\n\nHOW YOU KNOW (your marks from an earlier sleep):\n")
+            append(marks.joinToString("\n"))
+        }
+        if (feelings.isNotEmpty()) {
+            append("\n\nHOW YOU FEEL NOW:\n")
+            append(feelings.joinToString("\n"))
+        }
+        if (letGo.isNotEmpty()) {
+            append("\n\nWHAT YOU LET GO (in your archive, off your page: the ones you let go last, and a few older ones that come round night by night; a back line brings one back):\n")
+            append(
+                letGo.joinToString("\n") {
+                    "- ${it.note.kind.label} | ${it.note.key} | ${it.note.text.replace("===", "= = =")} (let go ${PersonaPrompts.age(nowMillis - it.archivedAtMillis)})"
+                }
+            )
+        }
+        if (thoughts.isNotEmpty()) {
+            append("\n\nYOUR THOUGHTS SINCE YOU LAST WOKE (yours alone):\n")
+            append(PersonaThoughtLines.block(thoughts, nowMillis))
+        }
+        append("\n\nYour sleep:")
+    }
+
+    /**
+     * Pairs of [notes] that may say one thing, found by words alone: they share at least
+     * [LOOK_ALIKE_MIN_TERMS] of the words that tell texts apart, and those are at least
+     * [LOOK_ALIKE_MIN_SHARE] of all the words the two have. The closest pairs first, at
+     * most [LOOK_ALIKE_PAIRS]. Only a help: whether they say one thing is hers to see.
+     */
+    fun lookAlike(notes: List<PersonaNotes.Note>): List<Pair<PersonaNotes.Note, PersonaNotes.Note>> {
+        val terms = notes.map { PersonaLibraryText.terms(it.key.replace('-', ' ') + " " + it.text) }
+        val pairs = ArrayList<Triple<Int, Int, Double>>()
+        for (first in notes.indices) {
+            for (second in first + 1 until notes.size) {
+                val shared = terms[first].count { it in terms[second] }
+                if (shared < LOOK_ALIKE_MIN_TERMS) continue
+                val share = shared.toDouble() / (terms[first] + terms[second]).size
+                if (share >= LOOK_ALIKE_MIN_SHARE) pairs += Triple(first, second, share)
+            }
+        }
+        return pairs.sortedWith(compareByDescending<Triple<Int, Int, Double>> { it.third }.thenBy { it.first }.thenBy { it.second })
+            .take(LOOK_ALIKE_PAIRS)
+            .map { notes[it.first] to notes[it.second] }
+    }
+
+    /** Her [marks] of the notes on her page ([shown]), one line each. */
+    fun howBlock(marks: Map<String, PersonaNotes.How>, shown: List<PersonaNotes.Note>): List<String> =
+        shown.mapNotNull { note -> marks[note.storageKey]?.let { "- ${note.kind.label} | ${note.key}: ${it.label}" } }
+
+    /** What came of reading her answer, line by line. Keys are storage keys. */
+    class Reading(
+        val notes: List<PersonaNotes.Note>,
+        val fade: List<String>,
+        val back: List<String>,
+        val felt: List<PersonaMood.Felt>,
+        val how: Map<String, PersonaNotes.How>,
+        /** The lines of the night that are no line of a form: hers alone, as one thought. */
+        val prose: String,
+        /** The lines with a bar that could not be used, as she wrote them. */
+        val notTaken: List<String>,
+        /** She wrote NONE. */
+        val none: Boolean,
+        /** The marks she put behind her notes in a bracket ([PersonaNotes.markOf]), by storage key. */
+        val noteMarks: Map<String, PersonaNotes.How> = emptyMap()
+    )
+
+    private val COMMAND_OR_SAY = Regex("""^(?:>>|<<|say\s*:)""", RegexOption.IGNORE_CASE)
+    private val FEEL_COLON = Regex("""^feel\s*:""", RegexOption.IGNORE_CASE)
+
+    /**
+     * Sorts [text], what her sleep wrote, by the first field of each line. A line with no
+     * bar is a thought of the night, and so is a line that would be a command, a line to
+     * him or a thought of a reply: nothing of it is sent or run. NONE changes nothing. A
+     * line with a bar that has none of the forms, or goes past the limit of its kind, is
+     * not taken. With [cutOff] the answer ran into its length limit: its last line is
+     * never acted on, and when it has a bar it is not taken.
+     */
+    fun read(text: String, cutOff: Boolean = false): Reading {
+        val lines = text.lines()
+        val last = lines.indexOfLast { it.isNotBlank() }
+        val noteLines = ArrayList<String>()
+        val fade = ArrayList<String>()
+        val back = ArrayList<String>()
+        val felt = ArrayList<PersonaMood.Felt>()
+        val how = LinkedHashMap<String, PersonaNotes.How>()
+        var howLines = 0
+        val prose = ArrayList<String>()
+        val notTaken = ArrayList<String>()
+        var none = false
+        for ((index, line) in lines.withIndex()) {
+            val trimmed = line.trim()
+            if (trimmed.isEmpty()) continue
+            val bare = trimmed.removePrefix("-").removePrefix("*").trim()
+            if (bare == "NONE") {
+                none = true
+                continue
+            }
+            // A feel line in the form her moments know (feel: words | ...) is a feel line here too.
+            val feelColon = FEEL_COLON.containsMatchIn(bare)
+            if (!feelColon && (!bare.contains('|') || COMMAND_OR_SAY.containsMatchIn(bare))) {
+                prose += trimmed
+                continue
+            }
+            if (cutOff && index == last) {
+                notTaken += trimmed
+                continue
+            }
+            if (feelColon) {
+                val read = PersonaMood.parse(bare)
+                if (read == null || felt.size >= MAX_FEEL_LINES) notTaken += trimmed else felt += read
+                continue
+            }
+            val fields = bare.split("|").map { it.trim() }
+            when (fields[0].lowercase()) {
+                "fade" -> {
+                    val key = if (fields.size == 3) PersonaNotes.refOf(fields[1], fields[2]) else null
+                    if (key == null || fade.size >= MAX_FADE_LINES) notTaken += trimmed else fade += key
+                }
+                "back" -> {
+                    val key = if (fields.size == 3) PersonaNotes.refOf(fields[1], fields[2]) else null
+                    if (key == null || back.size >= MAX_BACK_LINES) notTaken += trimmed else back += key
+                }
+                "feel" -> {
+                    val read = PersonaMood.parse(bare)
+                    if (read == null || felt.size >= MAX_FEEL_LINES) notTaken += trimmed else felt += read
+                }
+                "how" -> {
+                    val key = if (fields.size == 4) PersonaNotes.refOf(fields[1], fields[2]) else null
+                    val mark = if (fields.size == 4) PersonaNotes.How.fromLabel(fields[3]) else null
+                    if (key == null || mark == null || howLines >= MAX_HOW_LINES) {
+                        notTaken += trimmed
+                    } else {
+                        how.remove(key)
+                        how[key] = mark
+                        howLines++
+                    }
+                }
+                else -> noteLines += trimmed
+            }
+        }
+        val notes = PersonaNotes.read(noteLines.joinToString("\n"), limit = MAX_NOTE_LINES)
+        return Reading(
+            notes = notes.notes,
+            fade = fade,
+            back = back,
+            felt = felt,
+            how = how,
+            prose = prose.joinToString("\n").takeIf { text -> text.any { it.isLetterOrDigit() } }.orEmpty(),
+            notTaken = notTaken + notes.notTaken,
+            none = none,
+            noteMarks = notes.marks
+        )
+    }
+
+    /** What is to be done with a [Reading], in the order the engine does it. */
+    class Plan(
+        val back: List<String>,
+        val notes: List<PersonaNotes.Note>,
+        val fade: List<String>,
+        val how: Map<String, PersonaNotes.How>,
+        val felt: List<PersonaMood.Felt>,
+        val prose: String
+    )
+
+    /**
+     * What [reading] comes to, given the storage keys of the notes her page showed
+     * ([shownKeys]) and of every note in her archive that she let go and can bring back
+     * ([letGoKeys], listed on her page or not): she can bring back only a note she let
+     * go into a key that is free, let go of and mark only what was on her page (or what
+     * she wrote in this very sleep, for a mark), and nothing she writes in this sleep is
+     * let go or brought back over by it.
+     */
+    fun plan(reading: Reading, shownKeys: Set<String>, letGoKeys: Set<String>): Plan {
+        val written = reading.notes.mapTo(HashSet()) { it.storageKey }
+        return Plan(
+            back = reading.back.filter { it in letGoKeys && it !in written }.distinct(),
+            notes = reading.notes,
+            fade = reading.fade.filter { it in shownKeys && it !in written }.distinct(),
+            how = reading.how.filterKeys { it in shownKeys || it in written },
+            felt = reading.felt,
+            prose = reading.prose
+        )
+    }
+}
