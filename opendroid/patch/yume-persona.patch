+        assertEquals(0, server.requestCount)
+    }
+
+    @Test
+    fun `an unlock says the time was named only when she named it, and leaves the moment of her waking alone`() {
+        // The time the app set for it, not one she named.
+        due(State(on = true, wake = Wake.At(now + 50 * minute), why = Why.DEFAULT, lastAtMillis = now - hour, moments = listOf(now - hour)))
+        runBlocking { engine.ownTimeOnUnlock(heLastWroteAt = now - 3 * hour, nowMillis = now) }
+        assertEquals(Why.UNLOCKED, state().why)
+        answer(".")
+        assertNotNull(moment(at = now + 3 * minute))
+        val block = sentMessages()[0].second.substringAfter(PersonaOwnTime.HEADING)
+        assertTrue(block, block.contains("the app woke you sooner than the time set for it: he unlocked his phone"))
+        assertFalse(block, block.contains("the time you named"))
+
+        // His message woke her from a sleep: that moment tells her what her sleep pass came to, and stays where it is.
+        for (why in listOf(Why.WOKEN, Why.WOKE)) {
