+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memoryRepository: MemoryRepository
+    private val vision = WatchedScreenReader()
+
+    @Before
+    fun setUp() {
+        // Built and given a context, never started: starting it needs the whole app.
+        service = Robolectric.buildService(OpenDroidAccessibilityService::class.java).get()
+        service.nodeTraversal = AccessibilityNodeTraversal()
+        OpenDroidAccessibilityService.setInstanceForTest(service)
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+    }
+
+    @After
+    fun tearDown() {
+        OpenDroidAccessibilityService.setInstanceForTest(null)
+        database.close()
+    }
+
+    /** Puts a window of [packageName] in front, showing [lines]. */
+    private fun putInFront(packageName: String, vararg lines: String) {
+        val root = AccessibilityNodeInfo.obtain()
+        root.packageName = packageName
+        for (line in lines) {
+            val node = AccessibilityNodeInfo.obtain()
+            node.packageName = packageName
+            node.text = line
+            shadowOf(root).addChild(node)
+        }
+        shadowOf(service).setRootInActiveWindow(root)
+    }
+
+    private class Picture(val answeredAtOnce: Boolean, val encoded: String?)
+
+    /**
+     * Asks the service for a picture of the screen without waiting for it. A capture is
+     * answered on the main thread, so waiting here would wait for ever; a refusal is
+     * given at once, before any capture is asked for.
+     */
+    private fun askForPicture(): Picture {
+        var answered = false
+        var encoded: String? = null
+        CoroutineScope(Dispatchers.Unconfined).launch {
+            encoded = service.takeScreenshotAndEncode()
+            answered = true
+        }
+        return Picture(answered, encoded)
+    }
+
+    private fun ownChatInFront() = putInFront(service.packageName, "he keeps bees", "her note: nine hives, asks about them")
+
+    private fun otherAppInFront() = putInFront("com.example.notes", "Shopping list", "a red bicycle bell")
+
+    private fun getScreenText(): Action = AdvancedControlActions().getActions().single { it.name == "GET_SCREEN_TEXT" }
+
+    private fun analyzeScreenshot(): Action =
+        SystemActions(dagger.Lazy<AgentLoop> { error("not used") }, vision).getActions().single { it.name == "ANALYZE_SCREENSHOT" }
+
+    private fun readAndRemember(): Action =
+        CalendarActions(memoryRepository, vision, dagger.Lazy<PersonalGrowthEngine> { error("not used") })
+            .getActions().single { it.name == "READ_AND_REMEMBER_SCREEN" }
+
+    // ── The service ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the service hands back neither text nor a picture of this app's own window`() {
+        ownChatInFront()
+
+        assertTrue(service.isOwnWindowInFront())
+        assertEquals("", service.getScreenText())
+        assertEquals("", GenericAppAutomator.scrapeScreen())
+        assertEquals(OWN_SCREEN_NOT_READ, GenericAppAutomator.ownScreenRefusal())
+
+        val picture = askForPicture()
+        assertTrue("the answer must come before any capture is asked for", picture.answeredAtOnce)
+        assertNull(picture.encoded)
+    }
+
+    @Test
+    fun `the service reads another app's window as before`() {
+        otherAppInFront()
+
+        assertFalse(service.isOwnWindowInFront())
+        assertEquals("Shopping list\na red bicycle bell\n", service.getScreenText())
+        assertNull(GenericAppAutomator.ownScreenRefusal())
+
+        val picture = askForPicture()
+        assertTrue("the capture of another app's window is asked for", !picture.answeredAtOnce || picture.encoded != null)
+    }
+
+    @Test
+    fun `with no window in front, or no service connected, nothing is refused`() {
+        assertFalse("no window at all is not this app's window", service.isOwnWindowInFront())
+        assertNull(GenericAppAutomator.ownScreenRefusal())
+
+        OpenDroidAccessibilityService.setInstanceForTest(null)
+        assertNull(GenericAppAutomator.ownScreenRefusal())
+        assertEquals("", GenericAppAutomator.scrapeScreen())
+    }
+
+    // ── The actions ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `every screen-reading action fails with the true reason while this app's own window is in front`() = runBlocking {
+        ownChatInFront()
+
+        val results = mapOf(
+            "GET_SCREEN_TEXT" to getScreenText().execute(emptyMap(), context),
+            "ANALYZE_SCREENSHOT" to analyzeScreenshot().execute(mapOf("question" to "what does it say"), context),
+            "READ_AND_REMEMBER_SCREEN" to readAndRemember().execute(mapOf("topic" to "bees"), context)
+        )
+
+        for ((action, result) in results) {
+            assertFalse("$action -> $result", result.success)
+            assertEquals(action, OWN_SCREEN_NOT_READ, result.error)
+            assertNull("$action must hand nothing back", result.data)
+        }
+        assertEquals("the screen must not be looked at", 0, vision.asked)
+        assertTrue("nothing may be saved from it", memoryRepository.getMemoriesByType(MemoryType.SEMANTIC).isEmpty())
+    }
+
+    @Test
+    fun `the screen-text action reads another app's window`() = runBlocking {
+        otherAppInFront()
+
+        val result = getScreenText().execute(emptyMap(), context)
+
+        assertTrue(result.toString(), result.success)
+        assertEquals("Shopping list\na red bicycle bell\n", result.data)
+    }
+
+    @Test
+    fun `the screenshot actions go on to look at another app's window`() = runBlocking {
+        otherAppInFront()
+
+        val analysis = analyzeScreenshot().execute(mapOf("question" to "what does it say"), context)
+        assertEquals("ANALYZE_SCREENSHOT went on to the screen", 1, vision.asked)
+        assertFalse(OWN_SCREEN_NOT_READ == analysis.error)
+
+        val remembered = readAndRemember().execute(mapOf("topic" to "shopping"), context)
+        assertEquals("READ_AND_REMEMBER_SCREEN went on to the screen", 2, vision.asked)
+        assertFalse(OWN_SCREEN_NOT_READ == remembered.error)
+    }
+
+    @Test
+    fun `the screen-text action answers as before when no service is connected`() = runBlocking {
+        OpenDroidAccessibilityService.setInstanceForTest(null)
+
+        val result = getScreenText().execute(emptyMap(), context)
+
+        assertTrue(result.success)
+        assertEquals("No text visible on screen", result.data)
+    }
+
+    /**
+     * Stands where the screenshot reader stands and counts how often it is asked for.
+     * It then fails, as a reader without a model would; the actions report that
+     * themselves, which is not what these tests are about.
+     */
+    private class WatchedScreenReader : dagger.Lazy<VisionEngine> {
+        var asked = 0
+
+        override fun get(): VisionEngine {
+            asked++
+            error("no model in this test")
+        }
+    }
+}
