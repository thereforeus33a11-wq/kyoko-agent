+    /** A stand-in that turns down every chat request carrying the switches with [status] and [body], and answers the rest. */
+    private fun serveTurningDownSwitches(
+        status: Int = 400,
+        body: String = """{"error":{"message":"unknown field","type":"invalid_request_error"}}""",
+        alwaysTurnDown: Boolean = false
+    ) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                val target = request.target.orEmpty()
+                if (target.startsWith("/api/v1/tee/attestation")) return json(attestation(request.url.queryParameter("nonce").orEmpty()))
+                val sent = request.body?.utf8().orEmpty()
+                synchronized(chatBodies) { chatBodies += sent }
+                if (alwaysTurnDown || sent.contains("disable_thinking")) {
+                    return MockResponse.Builder().code(status).setHeader("Content-Type", "application/json").body(body).build()
+                }
+                val clientKey = request.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty()
+                val piece = delta("content", VeniceE2ee.encrypt("still here", clientKey))
+                return MockResponse.Builder().code(200).setHeader("Content-Type", "text/event-stream")
+                    .body("data: $piece\n\ndata: [DONE]\n\n").build()
+            }
+        }
+    }
