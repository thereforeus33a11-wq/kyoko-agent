diff --git a/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt b/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt
new file mode 100644
index 0000000..311b1fb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt
@@ -0,0 +1,44 @@
+package com.opendroid.ai.core.util
+
+import com.opendroid.ai.core.llm.RouteClassifier
+import java.net.UnknownServiceException
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.Response
+
+/**
+ * Refuses plain http to anything but the owner's own hardware.
+ *
+ * The platform's network security policy permits cleartext in this build: a model on his
+ * own computer is usually plain http at a private address, and that policy can only name
+ * hosts, not address ranges. This puts the rule back in code for every request made with
+ * the app's shared HTTP client. Plain http goes out only to a loopback or private host,
+ * judged from the address as it is written (see [RouteClassifier.hostKind]); anything
+ * else must be https. So an endpoint typed without "https://", a model list fetched with
+ * an API key and a redirect from https to http are not sent in the clear to a public
+ * host.
+ *
+ * Installed twice on the client. As an application interceptor it refuses the address
+ * that was asked for before any connection is opened. As a network interceptor it sees
+ * each redirect as well, and refuses it before the request is written.
+ */
+object CleartextGuard : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        if (!allows(request.url)) {
+            // The same kind of failure the platform's own cleartext policy raises. The
+            // address is left out: failure messages end up in logs.
+            throw UnknownServiceException("Plain http is only sent to this phone or a private address; this server needs https")
+        }
+        return chain.proceed(request)
+    }
+
+    /** True for https anywhere, and for http to a loopback or private host. */
+    fun allows(url: HttpUrl): Boolean {
+        if (url.isHttps) return true
+        // An IPv6 address comes without its brackets here; the classifier reads it with them.
+        val host = if (':' in url.host) "[${url.host}]" else url.host
+        return RouteClassifier.hostKind(host) != RouteClassifier.HostKind.PUBLIC
+    }
+}
