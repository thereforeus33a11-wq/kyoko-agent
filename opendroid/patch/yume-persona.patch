+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.actions.PersonaPictureActions
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.persona.MadePictureAgeCheck
+import com.opendroid.ai.core.persona.PersonaAge
+import com.opendroid.ai.core.persona.PersonaPicture
+import com.opendroid.ai.core.persona.PersonaPictures
+import com.opendroid.ai.core.persona.PersonaSelfPictures
+import com.opendroid.ai.core.persona.PictureModels
+import com.opendroid.ai.core.persona.ReferenceSheetRun
+import com.opendroid.ai.core.persona.ReferenceSheets
+import com.opendroid.ai.core.persona.SelfPictureMaker
+import com.opendroid.ai.core.persona.VeniceImages
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.repository.SettingsRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import okhttp3.OkHttpClient
+import javax.inject.Inject
+
+/**
+ * "Make her reference sheets" ([ReferenceSheets]): what a tap would make and from which of her
+ * originals and masters, what it costs, Start or Stop, each sheet as it comes back (age-checked,
+ * kept as derived), and his approval of each, which makes it a master.
+ *
+ * Nothing is sent before he taps Start, and nothing but the requests for the sheets: her
+ * originals and masters to the image model on his Venice key, each sheet to the age check.
+ */
+@HiltViewModel
+class ReferenceSheetsViewModel internal constructor(
+    private val settings: suspend () -> LLMConfig,
+    private val pictures: suspend () -> List<PersonaPicture>,
+    private val room: suspend () -> Int,
+    private val runOf: (key: String) -> ReferenceSheetRun,
+    private val setProvenance: suspend (String, PersonaPicture.Provenance) -> Boolean,
+    private val remove: suspend (String) -> Unit,
+    private val thumbnailOf: suspend (String) -> Bitmap?,
+    private val clock: () -> Long = System::currentTimeMillis
+) : ViewModel() {
+
+    @Inject
+    constructor(
+        settings: SettingsRepository,
+        pictures: PersonaPictures,
+        client: OkHttpClient,
+        ageCheck: MadePictureAgeCheck,
+        log: HerLog
+    ) : this(
+        settings = { settings.llmConfig.first() },
+        pictures = { pictures.list() },
+        room = { pictures.referenceRoom() },
+        runOf = { key ->
+            ReferenceSheetRun(
+                maker = SelfPictureMaker(
+                    send = { call -> VeniceImages.send(client, key, call) },
+                    check = ageCheck,
+                    counts = PersonaPictureActions.logCounts(log)
+                ),
+                source = { id -> pictures.source(id) },
+                keep = { bytes, caption, view, look -> pictures.addSheet(bytes, caption, view, look) }
+            )
+        },
+        setProvenance = { id, to -> pictures.setProvenance(id, to) },
+        remove = { id -> pictures.remove(id) },
+        thumbnailOf = { id -> pictures.thumbnail(id) }
+    )
+
+    /** One sheet's place on the screen: waiting, kept (with whether he approved it), or why there is none. */
+    data class Row(
+        val look: ReferenceSheets.Look,
+        val side: ReferenceSheets.Side,
+        val pictureId: String? = null,
+        val approved: Boolean = false,
+        val why: String = "",
+        val done: Boolean = false
+    ) {
+        val title: String get() = "${look.word}, ${side.word}"
+    }
+
+    /** What a tap would make, as her pictures stand: the sheets, or why none. */
+    var planned by mutableStateOf<ReferenceSheets.Planned?>(null)
+        private set
+
+    var running by mutableStateOf(false)
+        private set
+
+    /** What stands in the way, or a word about the last tap. */
+    var status by mutableStateOf("")
+        private set
+
+    val rows = mutableStateListOf<Row>()
+
+    private var job: Job? = null
+
+    init {
+        viewModelScope.launch { refresh() }
+    }
+
+    /** Reads her pictures again for what a tap would make. */
+    suspend fun refresh() {
+        planned = ReferenceSheets.plan(pictures())
+    }
+
+    /** The pictures a tap makes the sheets from, in a line: each once, with what it is. */
+    fun fromLine(): String {
+        val sheets = (planned as? ReferenceSheets.Planned.Sheets)?.sheets ?: return ""
+        val used = (sheets.map { it.source } + sheets.flatMap { it.also }).distinctBy { it.id }
+        return "From: " + used.joinToString("; ") { picture ->
+            val what = picture.view.ifEmpty { picture.caption }.ifEmpty { "a picture of her" }
+            "$what (" + picture.provenance.name.lowercase() + ")"
+        } + "."
+    }
+
+    /** What the sheets of a tap cost, before the age checks. */
+    fun cost(): Double = ReferenceSheets.cost((planned as? ReferenceSheets.Planned.Sheets)?.sheets?.size ?: 0)
+
+    /** Every sheet a tap makes, one after the other, each age-checked before it is shown or kept. */
+    fun start() {
+        if (running) return
+        rows.clear()
+        running = true
+        status = ""
+        job = viewModelScope.launch {
+            try {
+                val config = settings()
+                val blocked = PersonaSelfPictures.notAllowed(config)
+                val key = PersonaSelfPictures.keyFor(config, ownTime = false)
+                if (blocked != null || key == null) {
+                    status = blocked ?: "No Venice key is set, so no picture can be made."
+                    return@launch
+                }
+                refresh()
+                val sheets = when (val plan = planned) {
+                    is ReferenceSheets.Planned.Sheets -> plan
+                    is ReferenceSheets.Planned.Nothing -> {
+                        status = plan.why
+                        return@launch
+                    }
+                    null -> {
+                        status = ReferenceSheets.NO_BASES_WHY
+                        return@launch
+                    }
+                }
+                val free = room()
+                if (free < sheets.sheets.size) {
+                    status = ReferenceSheets.noRoom(free, sheets.sheets.size)
+                    return@launch
+                }
+                sheets.sheets.forEach { rows += Row(it.look, it.side) }
+                runOf(key).run(sheets.sheets, PersonaAge.on(clock())) { entry ->
+                    val index = rows.indexOfFirst { it.look == entry.sheet.look && it.side == entry.sheet.side && !it.done }
+                    val row = Row(entry.sheet.look, entry.sheet.side, pictureId = entry.kept?.id, why = entry.why, done = true)
+                    if (index >= 0) rows[index] = row else rows += row
+                }
+                val kept = rows.count { it.pictureId != null }
+                status = listOf(
+                    "Done: $kept of ${rows.size} kept, each derived until you approve it.",
+                    ReferenceSheets.missingLine(sheets)
+                ).filter { it.isNotEmpty() }.joinToString(" ")
+            } catch (e: CancellationException) {
+                status = "Stopped."
+                throw e
+            } finally {
+                running = false
+            }
+        }
+    }
+
+    fun stop() {
+        job?.cancel()
+    }
+
+    /** His approval of sheet [id]: it becomes a master, a base for her other pictures. */
+    fun approve(id: String) = mark(id, PersonaPicture.Provenance.MASTER)
+
+    /** His approval taken back: the sheet is derived again, never a base. */
+    fun takeBack(id: String) = mark(id, PersonaPicture.Provenance.DERIVED)
+
+    private fun mark(id: String, to: PersonaPicture.Provenance) {
+        viewModelScope.launch {
+            if (setProvenance(id, to)) {
+                val index = rows.indexOfFirst { it.pictureId == id }
+                if (index >= 0) rows[index] = rows[index].copy(approved = to == PersonaPicture.Provenance.MASTER)
+                status = if (to == PersonaPicture.Provenance.MASTER) APPROVED_LINE else TAKEN_BACK_LINE
+                refresh()
+            }
+        }
+    }
+
+    /** Throws sheet [id] away, file and all. */
+    fun throwAway(id: String) {
+        viewModelScope.launch {
+            remove(id)
+            val index = rows.indexOfFirst { it.pictureId == id }
+            if (index >= 0) rows[index] = rows[index].copy(pictureId = null, approved = false, why = "Thrown away.")
+            refresh()
+        }
+    }
+
+    suspend fun thumbnail(id: String): Bitmap? = thumbnailOf(id)
+
+    companion object {
+        const val APPROVED_LINE = "Approved: it is a master now, a base for her other pictures."
+        const val TAKEN_BACK_LINE = "Approval taken back: it is derived again and never a base."
+
+        /** A price in words, as the other picture screens give it. */
+        fun cents(dollars: Double): String = PictureModels.cents(dollars)
+    }
+}
