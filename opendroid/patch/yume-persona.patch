+++ b/app/src/main/res/xml/network_security_config.xml
@@ -1,9 +1,25 @@
 <?xml version="1.0" encoding="utf-8"?>
-<network-security-config>
-    <!-- Default: block cleartext (HTTP) traffic for security -->
-    <base-config cleartextTrafficPermitted="false"/>
+<network-security-config xmlns:tools="http://schemas.android.com/tools">
+    <!--
+        Cleartext (HTTP) is permitted here, and restricted in code instead.
 
-    <!-- Allow cleartext only for local servers (Ollama, Copilot local API) -->
+        A model on the owner's own computer is usually plain http at a private address
+        (192.168.x.x, 10.x.x.x, a .local name). This file cannot say "private addresses
+        only": it names hosts, not address ranges, so with cleartext blocked a model on
+        his own network could not be reached at all.
+
+        What takes the block's place:
+        - CleartextGuard, on the app's shared HTTP client, refuses plain http to any host
+          that is not loopback or private, redirects included.
+        - WrappedLLMProvider.resolveRequest refuses a model endpoint the route policy
+          does not allow before a request is built.
+        Requests to fixed hosts elsewhere in the app are https.
+
+        The lint warning about this line is switched off on purpose, for the reason above.
+    -->
+    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration"/>
+
+    <!-- Local servers (Ollama, Copilot local API), as before -->
     <domain-config cleartextTrafficPermitted="true">
         <domain includeSubdomains="true">localhost</domain>
         <domain includeSubdomains="true">127.0.0.1</domain>
diff --git a/app/src/test/java/com/opendroid/ai/accessibility/OwnScreenRefusalTest.kt b/app/src/test/java/com/opendroid/ai/accessibility/OwnScreenRefusalTest.kt
