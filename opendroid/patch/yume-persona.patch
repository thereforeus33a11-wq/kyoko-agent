+                CardEditorRow(description = "Add the text that makes her who she is.", action = "ADD", onEditCard = onEditCard)
+                WakePhrasesField(config, viewModel, personaActive = false)
+                return@Column
+            }
+            SettingSwitchRow(
+                title = "Yume",
+                description = "She is the one who talks: chat replies, the lines around a command, the approval prompt and what came of an action. What the phone actually did is always kept word for word next to her line.",
+                checked = config.personaEnabled,
+                onCheckedChange = viewModel::updatePersonaEnabled
+            )
+            // Which of the lines spoken in her voice no model wrote.
+            Text(text = FIXED_LINES_NOTE, fontSize = 10.sp, color = TextSecondary)
+
+            CardEditorRow(description = "Read or edit the text that makes her who she is.", action = "EDIT", onEditCard = onEditCard)
+            // Her notebook stands on the card screen. Nothing here named it, so it could
+            // only be found by opening the card and scrolling past it.
+            CardEditorRow(title = NOTEBOOK_ROW_TITLE, description = NOTEBOOK_ROW_HINT, action = "OPEN", onEditCard = onEditCard)
+            CardEditNoticeRow(
+                notice = cardState.notice,
+                onUseBuiltIn = presence::useBuiltInCard,
+                onKeepMine = presence::keepEditedCard
+            )
+
+            PersonaPicturesRow(onOpenPictures)
+
+            SettingChoiceRow(
+                label = "How much of her files goes into a reply",
+                options = PersonaLibraryBudget.STEPS,
+                selected = config.personaLibraryChars,
+                onSelect = viewModel::updatePersonaLibraryChars
+            )
+            Text(
+                text = "All of her files are stored in the app. The card is in every reply; the pages that fit what you two are talking about are picked on this phone and added, up to this much.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+
+            Box(modifier = Modifier.fillMaxWidth()) {
+                OutlinedTextField(
+                    value = config.personaChatProvider.ifBlank { SAME_AS_MAIN },
+                    onValueChange = {},
+                    readOnly = true,
+                    label = { Text("Provider for her replies", fontSize = 12.sp) },
+                    singleLine = true,
+                    trailingIcon = {
+                        Icon(
+                            imageVector = Icons.Default.ArrowDropDown,
+                            contentDescription = "Choose the provider for her replies",
+                            tint = TextPrimary,
+                            modifier = Modifier.clickable { providerMenuOpen = true }
+                        )
+                    },
+                    colors = fieldColors(),
+                    modifier = Modifier.fillMaxWidth()
+                )
+                DropdownMenu(expanded = providerMenuOpen, onDismissRequest = { providerMenuOpen = false }) {
+                    DropdownMenuItem(
+                        text = { Text(SAME_AS_MAIN) },
+                        onClick = {
+                            viewModel.updatePersonaChatProvider("")
+                            providerMenuOpen = false
+                        }
+                    )
+                    providers.forEach { name ->
+                        DropdownMenuItem(
+                            text = { Text(name) },
+                            onClick = {
+                                viewModel.updatePersonaChatProvider(name)
+                                providerMenuOpen = false
+                            }
+                        )
+                    }
+                }
+            }
+            moderationNotice(config)?.let { notice ->
+                Text(text = notice, fontSize = 11.sp, color = AccentCyan)
+            }
+            onDeviceReplyNotice(config, cardState.cardTokens)?.let { notice ->
+                Text(text = notice, fontSize = 11.sp, color = AccentCyan)
+            }
+            Text(
+                text = "The main provider plans device actions. A different one here writes only her chat replies, with that provider's own key and model: select it above once to set those, then switch back.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+
+            OutlinedTextField(
+                value = config.personaChatModel,
+                onValueChange = viewModel::updatePersonaChatModel,
+                label = { Text("Model for her replies (optional)", fontSize = 12.sp) },
+                singleLine = true,
+                colors = fieldColors(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            OutlinedTextField(
+                value = config.personaChatExtraBody,
+                onValueChange = viewModel::updatePersonaChatExtraBody,
+                label = { Text("Extra request options for her replies (JSON, optional)", fontSize = 12.sp) },
