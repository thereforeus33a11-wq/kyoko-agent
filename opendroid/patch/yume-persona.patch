+/**
+ * The in-app probes of what her brain can see, tapped by him on the phone, and what they
+ * found ([LLMConfig.sightProbes]). Each sends one tiny test picture made for it ([TEST_JPEG]:
+ * a red square with a blue circle, made by this build) and one fixed question, and nothing
+ * else: nothing of his and nothing of hers.
+ *
+ *  - [Probe.BRAIN]: her own model, on her route, as her replies go. It sees when its answer
+ *    names a colour of the picture. A model that answers without naming one, or that turns
+ *    the picture down, is taken for blind, and no picture meant for her goes to it after that
+ *    ([brainBlind]): the describer is used instead.
+ *  - [Probe.E2EE_IMAGE]: whether a picture can go to Venice end to end encrypted. Venice's
+ *    E2EE guide (docs.venice.ai/guides/features/tee-e2ee-models, read 2026-11-19) documents
+ *    encrypted text content only ("TEE and E2EE are currently available on text models only";
+ *    file uploads "not supported"), so there is no encrypted picture part to send, and none
+ *    is sent: the result is [Result.NOT_DOCUMENTED]. A picture is never sent unencrypted on a
+ *    route that is called encrypted.
+ *  - [Probe.TEE_IMAGE]: one of the encrypted models its catalog marks as seeing, asked in
+ *    TEE-only mode (`venice_parameters.enable_e2ee` false): the request reaches Venice
+ *    readable, as on its Private tier, and runs in an enclave. Recorded and shown as that,
+ *    never as encrypted.
+ */
+object SightProbe {
+
+    /** A 64 x 64 JPEG made by this build for the probes: a red square with a blue circle in it. */
+    const val TEST_JPEG = ""
+
+    /** The colours [TEST_JPEG] holds, as an answer names them. */
+    private val COLOURS = Regex("""(?i)\b(red|blue|scarlet|crimson|navy)\b|赤|青""")
+
+    /** The one question a probe asks. */
+    const val QUESTION = "This is a test picture. Which two colours are in it? Answer in five words or fewer."
+
+    /** The system line of a probe. */
+    const val SYSTEM = "You answer questions about test pictures in a few plain words."
+
+    /** What was probed. */
+    enum class Probe { BRAIN, E2EE_IMAGE, TEE_IMAGE }
+
+    /** What a probe found. */
+    enum class Result(val words: String) {
+        SEES("took the test picture and named its colours"),
+        NOT_SEEN("answered without naming the test picture's colours, so it is taken for blind"),
+        REFUSED("turned the test picture down"),
+        FAILED("could not be asked (no answer, or an error that says nothing about pictures)"),
+        NOT_DOCUMENTED("was not sent: Venice documents no encrypted picture part, its encryption carries text only")
+    }
+
+    /** One probe's finding: what it found, of which model, when, and the status Venice answered with. */
+    data class Record(val result: Result, val model: String, val atMillis: Long, val code: Int? = null)
+
+    /** The key a probe's finding is kept under. */
+    fun key(probe: Probe, config: LLMConfig, model: String? = null): String = when (probe) {
+        Probe.BRAIN -> "brain|" + PersonaEngine.chatModelKey(config).replace('\n', '|').lowercase()
+        Probe.E2EE_IMAGE -> "e2ee-image|" + model.orEmpty().trim().lowercase()
+        Probe.TEE_IMAGE -> "tee-image|" + model.orEmpty().trim().lowercase()
+    }
+
+    /** [record] as it is kept: result, model, time and status, nothing else. */
+    fun encode(record: Record): String =
+        listOf(record.result.name, record.model, record.atMillis.toString(), record.code?.toString().orEmpty()).joinToString(";")
+
+    /** [encode] read back; null for anything else. */
+    fun decode(text: String): Record? {
+        val parts = text.split(';')
+        if (parts.size < 3) return null
+        val result = Result.entries.firstOrNull { it.name == parts[0] } ?: return null
+        val at = parts[2].toLongOrNull() ?: return null
+        return Record(result, parts[1], at, parts.getOrNull(3)?.toIntOrNull())
+    }
+
+    /** What the probe of [probe] last found, as [config] stands. */
+    fun recorded(config: LLMConfig, probe: Probe, model: String? = null): Record? =
+        config.sightProbes[key(probe, config, model)]?.let(::decode)
+
+    /**
+     * The settings with [record] kept for [probe], under the key of the settings it was probed
+     * with ([probedWith]): a model changed while the probe was out is not marked by the
+     * answer of the one before.
+     */
+    fun withRecord(config: LLMConfig, probe: Probe, record: Record, probedWith: LLMConfig = config): LLMConfig =
+        config.copy(sightProbes = config.sightProbes + (key(probe, probedWith, record.model) to encode(record)))
+
+    /** The model her replies are written by, as [config] stands. */
+    fun brainModel(config: LLMConfig): String {
+        val provider = PersonaEngine.chatProviderOrMain(config)
+        return config.personaChatModel.trim().ifEmpty { config.selectedModelFor(provider) }
+    }
+
+    /**
+     * Whether her brain is known not to see, so that no picture meant for her goes to it: the
+     * probe of this very model found it blind or saw it turn the picture down, or Venice lists
+     * the model as one that takes no pictures. A probe that could not be asked says nothing.
+     */
+    fun brainBlind(config: LLMConfig): Boolean {
+        val probed = recorded(config, Probe.BRAIN)?.result
+        if (probed == Result.NOT_SEEN || probed == Result.REFUSED) return true
+        val endpoint = RouteClassifier.endpointOf(config, PersonaEngine.chatProviderOrMain(config))
+        if (RouteClassifier.hostOf(endpoint) != VenicePrivateTier.HOST) return false
+        return VenicePrivateTier.caps(brainModel(config), config)?.vision == false
+    }
+
+    /** What an answer to [QUESTION] says of the model. */
+    fun judge(answer: String): Result =
+        if (COLOURS.containsMatchIn(OpenAiCompatExtras.stripReasoning(answer))) Result.SEES else Result.NOT_SEEN
+
+    private val UNSUPPORTED = Regex("""(?i)unsupported|not supported|does not support|doesn't support|no vision|image|multimodal|vision""")
+
+    /** What an error answer says of the model: it turned the picture down, or nothing. */
+    fun judgeFailure(code: Int?, text: String): Result =
+        if (code in setOf(400, 415, 422) && UNSUPPORTED.containsMatchIn(text)) Result.REFUSED else Result.FAILED
+
+    /** The probe of her brain, as it goes on her route: [SYSTEM], and one turn of [QUESTION] with [TEST_JPEG]. */
+    fun brainRequest(config: LLMConfig): LLMRequest = PersonaEngine.requestOfHers(
+        LLMRequest(
+            systemPrompt = SYSTEM,
+            messages = listOf(
+                ChatMessage(id = UUID.randomUUID().toString(), text = QUESTION, sender = ChatMessage.Sender.USER, imageBase64 = TEST_JPEG)
+            ),
+            temperature = 0f,
+            maxTokens = PROBE_MAX_TOKENS,
+            responseFormat = ResponseFormat.TEXT,
+            retryPolicy = RetryPolicy.NONE
+        ),
+        config
+    ).let { it.copy(thinkingOff = config.personaChatExtraBody.isBlank()) }
+
+    /** Room for a five-word answer, and a little more. */
+    const val PROBE_MAX_TOKENS = 60
+
+    /**
+     * The TEE-only probe's body: [model], [SYSTEM], one turn of [QUESTION] with [TEST_JPEG],
+     * and `enable_e2ee` false, so that it is plainly a request in the clear to Venice. No
+     * E2EE header goes with it ([SightProber.probeEncrypted]).
+     */
+    fun teeBody(model: String): String = buildJsonObject {
+        put("model", model)
+        putJsonArray("messages") {
+            addJsonObject {
+                put("role", "system")
+                put("content", SYSTEM)
+            }
+            addJsonObject {
+                put("role", "user")
+                putJsonArray("content") {
+                    addJsonObject {
+                        put("type", "text")
+                        put("text", QUESTION)
+                    }
+                    addJsonObject {
+                        put("type", "image_url")
+                        putJsonObject("image_url") { put("url", "data:image/jpeg;base64,$TEST_JPEG") }
+                    }
+                }
+            }
+        }
+        put("temperature", 0)
+        put("max_tokens", PROBE_MAX_TOKENS)
+        putJsonObject("venice_parameters") {
+            put("enable_e2ee", false)
+            put("include_venice_system_prompt", false)
+            put("disable_thinking", true)
+        }
+    }.toString()
+
+    /** What his card says the probes found, one line each, as [config] stands. */
+    fun lines(config: LLMConfig, encryptedModel: String = VenicePrivateTier.E2EE_SEEING.first()): List<String> = buildList {
+        val brain = recorded(config, Probe.BRAIN)
+        add(
+            if (brain == null) {
+                "Her model (${brainModel(config)}) has not been probed with a test picture yet."
+            } else {
+                "Her model (${brain.model}) " + brain.result.words + "."
+            }
+        )
+        recorded(config, Probe.E2EE_IMAGE, encryptedModel)?.let {
+            add("A picture end to end encrypted to $encryptedModel " + it.result.words + ".")
+        }
+        recorded(config, Probe.TEE_IMAGE, encryptedModel)?.let {
+            add("$encryptedModel in TEE-only mode (readable by Venice, run in an enclave, not end to end encrypted) " + it.result.words + ".")
+        }
+    }
+}
+
+/** The probes as the app runs them ([SightProbe]), on his tap only. */
+@Singleton
+class SightProber internal constructor(
+    private val settings: suspend () -> LLMConfig,
+    private val save: suspend ((LLMConfig) -> LLMConfig) -> Unit,
+    private val complete: suspend (LLMConfig, LLMRequest) -> LLMResponse,
+    private val post: suspend (url: String, key: String, body: String) -> Pair<Int, String>,
+    private val clock: () -> Long
+) {
+    @Inject
+    constructor(client: OkHttpClient, settings: SettingsRepository, factory: Provider<LLMProviderFactory>) : this(
+        settings = { settings.llmConfig.first() },
+        save = { update -> settings.updateConfig(update) },
+        complete = { config, request ->
+            val chosen = PersonaEngine.chatProviderName(config)
+            val provider = if (chosen == null) factory.get().getActiveProvider() else factory.get().getProviderByName(chosen)
+            provider.complete(request)
+        },
+        post = poster(client),
+        clock = System::currentTimeMillis
+    )
+
+    /** Probes her brain with the test picture on her route and keeps what it found. */
+    suspend fun probeBrain(): SightProbe.Record {
+        val config = settings()
+        val model = SightProbe.brainModel(config)
+        val record = try {
+            val response = withContext(Dispatchers.IO) { complete(config, SightProbe.brainRequest(config)) }
+            SightProbe.Record(SightProbe.judge(response.content), model, clock())
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: LLMException) {
+            Log.w(TAG, "The probe of her model failed: ${e.error.code}")
+            SightProbe.Record(SightProbe.judgeFailure(e.status, e.message.orEmpty()), model, clock(), e.status)
+        } catch (e: Exception) {
+            Log.w(TAG, "The probe of her model failed: ${e.javaClass.simpleName}")
+            SightProbe.Record(SightProbe.Result.FAILED, model, clock())
+        }
+        save { current -> SightProbe.withRecord(current, SightProbe.Probe.BRAIN, record, probedWith = config) }
+        return record
+    }
+
+    /**
+     * Whether a picture can go to [model], one of Venice's encrypted models that its catalog
+     * marks as seeing: end to end encrypted (not documented, so nothing is sent), then in
+     * TEE-only mode, in the clear to Venice. The TEE-only request is made only where his
+     * privacy setting lets a request reach Venice readable ([teeProbeAllowed]), and only with
+     * his Venice key while his Venice provider points at Venice ([VenicePrivateTier.keyOf]).
+     */
+    suspend fun probeEncrypted(model: String = VenicePrivateTier.E2EE_SEEING.first()): Pair<SightProbe.Record, SightProbe.Record?> {
+        val config = settings()
+        val e2ee = SightProbe.Record(SightProbe.Result.NOT_DOCUMENTED, model, clock())
+        val key = VenicePrivateTier.keyOf(config)
+        val tee = if (key == null || !teeProbeAllowed(config)) {
+            null
+        } else {
+            try {
+                val (code, text) = post(CHAT_URL, key, SightProbe.teeBody(model))
+                if (code in 200..299) {
+                    SightProbe.Record(SightProbe.judge(contentOf(text)), model, clock(), code)
+                } else {
+                    SightProbe.Record(SightProbe.judgeFailure(code, text), model, clock(), code)
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "The TEE-only probe failed: ${e.javaClass.simpleName}")
+                SightProbe.Record(SightProbe.Result.FAILED, model, clock())
+            }
+        }
+        save { current ->
+            val withE2ee = SightProbe.withRecord(current, SightProbe.Probe.E2EE_IMAGE, e2ee)
+            if (tee == null) withE2ee else SightProbe.withRecord(withE2ee, SightProbe.Probe.TEE_IMAGE, tee)
+        }
+        return e2ee to tee
+    }
+
+    companion object {
+        private const val TAG = "SightProbe"
+
+        /** Where the TEE-only probe goes: Venice's chat completions, and nowhere else. */
+        const val CHAT_URL = "https://${VenicePrivateTier.HOST}/api/v1/chat/completions"
+
+        /** The words of an OpenAI-style answer; empty when there are none. */
+        internal fun contentOf(json: String): String = try {
+            JsonParser.parseString(json).asJsonObject.getAsJsonArray("choices")?.firstOrNull()?.asJsonObject
+                ?.getAsJsonObject("message")?.get("content")?.takeIf { it.isJsonPrimitive }?.asString.orEmpty()
+        } catch (e: Exception) {
+            ""
+        }
+
+        /**
+         * Whether the TEE-only probe may go: it reaches Venice readable, so only when his privacy
+         * setting allows any route, or when he trusts Venice's Private tier for her (which reads
+         * what it is sent in the same way). Never while everything stays on his own hardware.
+         */
+        fun teeProbeAllowed(config: LLMConfig): Boolean =
+            config.routePolicy == RoutePolicy.ANY || (config.routePolicy == RoutePolicy.ENCRYPTED && config.trustVenicePrivate)
+
+        /** Whether a probe of her brain says anything: her route carries pictures at all. */
+        fun brainProbeMeansSomething(config: LLMConfig): Boolean = RouteClassifier.personaRoute(config) != RoutePrivacy.ENCRYPTED
+
+        /** A client for the one probe that is posted by hand: no cache, no cookies, no redirects. */
+        private fun poster(client: OkHttpClient): suspend (String, String, String) -> Pair<Int, String> {
+            val http = client.newBuilder().cache(null).cookieJar(CookieJar.NO_COOKIES).followRedirects(false).followSslRedirects(false)
+                .callTimeout(60, TimeUnit.SECONDS).build()
+            val type = "application/json".toMediaType()
+            return { url, key, body ->
+                withContext(Dispatchers.IO) {
+                    http.cancellable(
+                        Request.Builder().url(url).header("Authorization", "Bearer $key").header("Accept", "application/json")
+                            .post(body.toRequestBody(type)).build()
+                    ) { response -> response.code to response.body.string().take(64_000) }
+                }
+            }
+        }
+    }
+}
