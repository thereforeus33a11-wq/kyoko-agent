+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class PersonaActionsTest {
+
+    // ── Her command line ─────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a last line after the marker is her command and is not part of what she says`() {
+        val split = PersonaActions.split("boring. fixing that\n>> play eurobeat on youtube")
+        assertEquals("boring. fixing that", split.text)
+        assertEquals("play eurobeat on youtube", split.command)
+    }
+
+    @Test
+    fun `a reply without a marker is all talk`() {
+        val split = PersonaActions.split("mm. later")
+        assertEquals("mm. later", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `a reply that is only a command has no words`() {
+        val split = PersonaActions.split(">> flashlight on\n")
+        assertEquals("", split.text)
+        assertEquals("flashlight on", split.command)
+    }
+
+    @Test
+    fun `a marker that is not the last line is removed and never run`() {
+        val split = PersonaActions.split(">> open the camera\nactually no. too dark")
+        assertEquals("actually no. too dark", split.text)
+        assertNull(split.command)
+
+        // One command per reply: of two marker lines only the last one counts.
+        val two = PersonaActions.split("watch\n>> flashlight on\n>> open the camera")
+        assertEquals("watch", two.text)
+        assertEquals("open the camera", two.command)
+    }
+
+    @Test
+    fun `a marker inside a line is just text`() {
+        val split = PersonaActions.split("he typed >> like a hacker. kimo")
+        assertEquals("he typed >> like a hacker. kimo", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `commands that are empty, symbols only or far too long are ignored`() {
+        assertNull(PersonaActions.split("ok\n>>").command)
+        assertNull(PersonaActions.split("ok\n>> ??").command)
+        assertNull(PersonaActions.split("ok\n>> " + "a".repeat(501)).command)
+        assertEquals("ok", PersonaActions.split("ok\n>> ??").text)
+    }
+
+    @Test
+    fun `a message to someone fits in a command`() {
+        val message = "text nene: " + "the keys are under the blue pot by the back door. ".repeat(8).trim()
+        assertTrue(message.length in 300..500)
+        assertEquals(message, PersonaActions.split("fine. telling her\n>> $message").command)
+        assertEquals("a".repeat(500), PersonaActions.split(">> " + "a".repeat(500)).command)
+    }
+
+    @Test
+    fun `quoting around the command is stripped`() {
+        assertEquals("set a timer for ten minutes", PersonaActions.split("fine\n>> `set a timer for ten minutes`").command)
+    }
+
+    @Test
+    fun `her command may ask for anything, the split does not look at what it says`() {
+        for (command in listOf(
+            "text nene: where are you",
+            "call the dentist",
+            "search the web for cheap flights to osaka",
+            "post good morning on telegram",
+            "delete the file notes.txt"
+        )) {
+            assertEquals(command, PersonaActions.split("mm\n>> $command").command)
+        }
+    }
+
+    // ── What stays on the phone ──────────────────────────────────────────────────────
+
+    @Test
+    fun `every action that stays on the phone exists and none of them is barred from auto approval`() {
+        val schema = ActionSchema.ALL_ACTIONS.associateBy { it.name }
+        val handlerSources = File("src/main/java/com/opendroid/ai/actions").walkTopDown()
+            .filter { it.isFile && it.extension == "kt" }
+            .joinToString("\n") { it.readText() }
+        for (name in PersonaActions.STAYS_ON_PHONE) {
+            val definition = schema[name]
+            val hasHandler = handlerSources.contains("name: String = \"$name\"") ||
+                handlerSources.contains("name = \"$name\"")
+            assertTrue("$name is not a real action", definition != null || hasHandler)
+            assertFalse("$name can never be auto-approved, so it does not run unasked", definition?.neverAutoApprove == true)
+        }
+    }
+
+    @Test
+    fun `nothing that reaches another person, a site, his money or his data stays on the phone`() {
+        val leavesThePhoneOrReadsHim = listOf(
+            // words to another person
+            "MAKE_CALL", "MAKE_VIDEO_CALL", "SEND_SMS", "SEND_WHATSAPP", "SEND_WHATSAPP_GROUP", "SEND_TELEGRAM",
+            "OPEN_TELEGRAM", "SEND_EMAIL", "AUTO_REPLY_TOGGLE", "CREATE_CALENDAR_EVENT",
+            "SOCIAL_CREATE_POST", "SOCIAL_SCHEDULE_POST", "SOCIAL_DRAFT_REPLIES", "SOCIAL_CREATE_CAMPAIGN",
+            // her text to a site or a service
+            "WEB_SEARCH", "GET_NEWS", "GET_WEATHER", "TRANSLATE", "SUMMARIZE_URL", "FACT_CHECK", "CHECK_STOCK",
+            "DEFINE_WORD", "CURRENCY_CONVERT", "CONVERT_UNITS", "CALCULATE", "OPEN_URL", "OPEN_BROWSER",
+            "ENABLE_PRIVATE_MODE", "PLAY_YOUTUBE", "PLAY_MUSIC", "SEARCH_AMAZON", "SEARCH_FLIPKART",
+            "GET_DIRECTIONS", "CHECK_TRAFFIC", "CHECK_FLIGHT", "TRACK_DELIVERY", "INSTALL_APP",
+            // money
+            "PAY_UPI", "SPLIT_BILL", "CHECK_BALANCE", "ORDER_FOOD", "ORDER_GROCERY", "ADD_TO_CART",
+            "BOOK_UBER", "BOOK_OLA", "TOGGLE_MOBILE_DATA", "TOGGLE_HOTSPOT",
+            // deleting and overwriting
+            "DELETE_FILE", "WRITE_FILE", "MOVE_FILE", "COPY_FILE", "ZIP_FILES", "UNZIP_FILE", "CREATE_DIRECTORY",
+            "DELETE_MACRO", "DISMISS_NOTIFICATION", "CLEAR_BROWSER_DATA", "CLEAR_CLIPBOARD", "COPY_TO_CLIPBOARD",
+            "RESTART_DEVICE",
+            // reading what is his
+            "READ_MESSAGES", "READ_EMAILS", "READ_NOTIFICATIONS", "READ_NOTES", "READ_FILE", "LIST_FILES",
+            "RECALL_MEMORY", "QUERY_KNOWLEDGE_GRAPH", "GET_CLIPBOARD", "GET_SCREEN_TEXT", "ANALYZE_SCREENSHOT",
+            "READ_AND_REMEMBER_SCREEN", "LIST_CALENDAR_TODAY", "LIST_CALENDAR_WEEK", "LIST_INSTALLED_APPS",
+            "GET_MORNING_BRIEFING", "SOCIAL_CHECK_INBOX", "VERIFY_CONTACT", "TAKE_PHOTO_BACKGROUND",
+            // writing what the app holds to be facts about him
+            "UPDATE_PREFERENCE", "SAVE_SENSITIVE_INFO",
+            // driving another app's screen, or running a stored sequence of anything
+            "CLICK_TEXT", "CLICK_ID", "CLICK_COORDINATES", "TYPE_TEXT", "TYPE_ID", "PRESS_ENTER", "SCROLL",
+            "RUN_MACRO", "CREATE_MACRO", "SCHEDULE_MACRO", "RUN_ROUTINE", "APPROVE_ROUTINE",
+            // the world outside the phone
+            "SMART_HOME", "TOGGLE_LIGHT", "SET_THERMOSTAT", "LOCK_DOOR"
+        )
+        for (name in leavesThePhoneOrReadsHim) {
+            assertFalse("$name does not stay on the phone", name in PersonaActions.STAYS_ON_PHONE)
+        }
+    }
+
+    @Test
+    fun `every action the schema bars from auto approval is left to his approval setting`() {
+        val barred = ActionSchema.ALL_ACTIONS.filter { it.neverAutoApprove }.map { it.name }
+        assertTrue(barred.isNotEmpty())
+        assertTrue(PersonaActions.STAYS_ON_PHONE.intersect(barred.toSet()).isEmpty())
+    }
+
+    @Test
+    fun `the switches, alarms, notes and music controls she had before still stay on the phone`() {
+        val stillHers = listOf(
+            "OPEN_APP", "TOGGLE_FLASHLIGHT", "TOGGLE_DND", "SET_BRIGHTNESS", "SET_VOLUME", "SET_RINGER_MODE",
+            "LOCK_SCREEN", "TAKE_SCREENSHOT", "GET_SYSTEM_INFO", "SET_ALARM", "SET_TIMER",
+            "PAUSE_MUSIC", "NEXT_TRACK", "PREV_TRACK", "SET_VOLUME_MUSIC", "ADD_NOTE", "SET_REMINDER"
+        )
+        for (name in stillHers) assertTrue(name, name in PersonaActions.STAYS_ON_PHONE)
+    }
+
+    @Test
+    fun `a plan stays on the phone only when every action in it does`() {
+        assertTrue(PersonaActions.allStayOnPhone(listOf("OPEN_APP", "WAIT", "SET_VOLUME")))
+        assertFalse(PersonaActions.allStayOnPhone(listOf("OPEN_APP", "SEND_SMS")))
+        assertFalse(PersonaActions.allStayOnPhone(listOf("TOGGLE_FLASHLIGHT", "SOME_UNKNOWN_ACTION")))
+        assertFalse(PersonaActions.allStayOnPhone(emptyList()))
+    }
+
+    // ── Her rein ─────────────────────────────────────────────────────────────────────
+
+    private val onPhone = listOf("TOGGLE_FLASHLIGHT")
+    private val message = listOf("SEND_SMS")
+    private val mixed = listOf("OPEN_APP", "SEND_WHATSAPP")
+
+    @Test
+    fun `on ASK her rein lets nothing run, his own approval setting decides`() {
+        for (plan in listOf(onPhone, message, mixed)) {
+            assertFalse(PersonaActions.runsOnRein(PersonaRein.ASK, plan, wordsMayBeSomeoneElses = false))
+            assertFalse(PersonaActions.runsOnRein(PersonaRein.ASK, plan, wordsMayBeSomeoneElses = true))
+        }
+    }
+
+    @Test
+    fun `on PHONE what stays on the phone runs and anything that sends words off it does not`() {
+        assertTrue(PersonaActions.runsOnRein(PersonaRein.PHONE, onPhone, wordsMayBeSomeoneElses = false))
+        assertTrue(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("SET_ALARM", "ADD_NOTE"), wordsMayBeSomeoneElses = false))
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, message, wordsMayBeSomeoneElses = false))
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, mixed, wordsMayBeSomeoneElses = false))
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("WEB_SEARCH"), wordsMayBeSomeoneElses = false))
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("MAKE_CALL"), wordsMayBeSomeoneElses = false))
+        // A fallback counts like the action itself: the caller passes both.
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("OPEN_APP", "OPEN_URL"), wordsMayBeSomeoneElses = false))
+    }
+
+    @Test
+    fun `on PHONE a plan whose words may be someone else's goes back to his approval setting too`() {
+        // A note stays on the phone, and a stranger's sentence saved as one would be read
+        // back to the planner as a fact about the owner from then on.
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("ADD_NOTE"), wordsMayBeSomeoneElses = true))
+        assertFalse(PersonaActions.runsOnRein(PersonaRein.PHONE, onPhone, wordsMayBeSomeoneElses = true))
+        assertTrue(PersonaActions.runsOnRein(PersonaRein.PHONE, listOf("ADD_NOTE"), wordsMayBeSomeoneElses = false))
+    }
+
+    @Test
+    fun `each rein lets run everything the one before it does`() {
+        val plans = listOf(onPhone, message, mixed, listOf("ADD_NOTE"), listOf("WEB_SEARCH"), emptyList())
+        for (plan in plans) {
+            for (borrowed in listOf(false, true)) {
+                val ask = PersonaActions.runsOnRein(PersonaRein.ASK, plan, borrowed)
+                val phone = PersonaActions.runsOnRein(PersonaRein.PHONE, plan, borrowed)
+                val everything = PersonaActions.runsOnRein(PersonaRein.EVERYTHING, plan, borrowed)
+                assertTrue("$plan $borrowed", !ask || phone)
+                assertTrue("$plan $borrowed", !phone || everything)
+            }
+        }
+    }
+
+    @Test
+    fun `on EVERYTHING all of it runs`() {
+        for (plan in listOf(onPhone, message, mixed, listOf("WEB_SEARCH"), listOf("MAKE_CALL"), listOf("SOCIAL_CREATE_POST"))) {
+            assertTrue(plan.toString(), PersonaActions.runsOnRein(PersonaRein.EVERYTHING, plan, wordsMayBeSomeoneElses = false))
+        }
+    }
+
+    @Test
+    fun `on EVERYTHING a plan whose words may be someone else's goes back to his approval setting`() {
+        for (plan in listOf(onPhone, message, mixed)) {
+            assertFalse(plan.toString(), PersonaActions.runsOnRein(PersonaRein.EVERYTHING, plan, wordsMayBeSomeoneElses = true))
+        }
