+        assertNull(PersonaNotebookTalk.asHerOwnAct(ChatMessage("s", "Message sent to Bob!", Sender.AGENT, modelBadge = "System")))
+        assertNull(PersonaNotebookTalk.asHerOwnAct(ChatMessage("u", "Yume's own command: \"x\"", Sender.USER, modelBadge = PersonaActions.COMMAND_BADGE)))
+
+        val shaped = PersonaNotebookTalk.shaped(
