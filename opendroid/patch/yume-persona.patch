+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt
@@ -0,0 +1,238 @@
+package com.opendroid.ai.core.persona
+
+import android.util.Log
+import com.opendroid.ai.core.llm.LLMProvider
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.ProviderCatalog
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.approvalSettings
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineExceptionHandler
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import java.util.UUID
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Everything the persona does, in one place, so that the rest of the app asks it a
+ * few narrow questions and never handles her text itself:
+ *
+ *  - is she on, and which provider writes her replies;
+ *  - the system prompt for one chat reply;
+ *  - the fixed lines the app speaks, in her voice ([phrasebook]);
+ *  - keeping her notebook up to date after a chat ([onReply]);
+ *  - an unprompted line when she has been left alone ([checkInLine]).
+ *
+ * Nothing here can start a device action: every call it makes is plain text, and its
+ * output only ever goes to the chat and to speech.
+ */
+@Singleton
+class PersonaEngine @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val settingsRepository: SettingsRepository,
+    private val llmProviderFactory: LLMProviderFactory,
+    private val userProfileStore: UserProfileStore
+) {
+    val phrasebook = PersonaPhrasebook()
+
+    private val scope = CoroutineScope(
+        SupervisorJob() + Dispatchers.Default + CoroutineExceptionHandler { _, e ->
+            Log.w(TAG, "Persona background task failed: ${e.javaClass.simpleName}")
+        }
+    )
+    private val repliesSinceReflection = AtomicInteger(0)
+    private val reflecting = AtomicBoolean(false)
+    private val seeded = AtomicBoolean(false)
+
+    suspend fun isActive(): Boolean = isActive(settingsRepository.llmConfig.first())
+
+    /** On only when switched on and a card exists; a build without the card behaves like stock. */
+    fun isActive(config: LLMConfig): Boolean = config.personaEnabled && store.card().isNotBlank()
+
+    /** The provider that writes her replies: the one chosen for chat, else the active one. */
+    suspend fun chatProvider(config: LLMConfig): LLMProvider {
+        val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+        return if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) {
+            llmProviderFactory.getProviderByName(chosen)
+        } else {
+            llmProviderFactory.getActiveProvider()
+        }
+    }
+
+    /**
+     * Points [request] at the model chosen for her replies, when one is set. Used for
+     * her chat reply, her notebook reflection and her check-ins, and for nothing else.
+     */
+    fun withChatModel(request: LLMRequest, config: LLMConfig): LLMRequest = request.copy(
+        modelOverride = config.personaChatModel.trim().ifEmpty { null },
+        extraBodyOverride = config.personaChatExtraBody.trim().ifEmpty { null }
+    )
+
+    /** Whether a screenshot may be attached to a chat request for this configuration. */
+    fun chatSeesImages(config: LLMConfig): Boolean = config.personaChatSeesImages
+
+    suspend fun chatSystemPrompt(
+        config: LLMConfig,
+        relevantContext: String,
+        deviceActivity: List<String>,
+        screenshotAttached: Boolean,
+        ownActions: Boolean = config.personaActionsEnabled
+    ): String {
+        seedOnce()
+        return PersonaPrompts.chatSystemPrompt(
+            card = store.card(),
+            ownerName = ownerName(),
+            autoModeLabel = config.approvalSettings().mode.name,
+            relevantContext = relevantContext,
+            notes = PersonaNotes.render(memory.notes()),
+            deviceActivity = deviceActivity,
+            screenshotAttached = screenshotAttached,
+            ownActions = ownActions
+        )
+    }
+
+    /**
+     * Called after one of her replies is stored. Every few replies the recent talk is
+     * read once more, off the reply path, and anything worth keeping goes into her
+     * notebook. Failures are silent: a missed note is not worth an error card.
+     */
+    fun onReply(recentMessages: suspend () -> List<ChatMessage>) {
+        if (repliesSinceReflection.incrementAndGet() < REPLIES_PER_REFLECTION) return
+        if (!reflecting.compareAndSet(false, true)) return
+        repliesSinceReflection.set(0)
+        scope.launch {
+            try {
+                reflect(recentMessages())
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "Notebook reflection skipped: ${e.javaClass.simpleName}")
+            } finally {
+                reflecting.set(false)
+            }
+        }
+    }
+
+    internal suspend fun reflect(recentMessages: List<ChatMessage>) {
+        val config = settingsRepository.llmConfig.first()
+        if (!isActive(config)) return
+        // Only what the two of them said. App rows can carry notification or screen text.
+        val dialogue = PersonaPrompts.shapeHistory(recentMessages).dialogue
+        if (dialogue.count { it.sender == ChatMessage.Sender.USER } < 2) return
+        val notebook = PersonaNotes.renderForReview(memory.notes())
+        val response = chatProvider(config).complete(
+            withChatModel(
+              LLMRequest(
+                systemPrompt = PersonaPrompts.REFLECTION_SYSTEM_PROMPT,
+                messages = listOf(
+                    ChatMessage(
+                        id = UUID.randomUUID().toString(),
+                        text = PersonaPrompts.reflectionUserPrompt(notebook, dialogue),
+                        sender = ChatMessage.Sender.USER
+                    )
+                ),
+                temperature = 0.2f,
+                maxTokens = 240,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+              ),
+              config
+            )
+        )
+        val changes = PersonaNotes.parse(response.content, limit = MAX_CHANGES_PER_REFLECTION)
+        if (changes.isNotEmpty()) memory.apply(changes)
+    }
+
+    /**
+     * One unprompted line, or null when it is not the moment, she has nothing to say or
+     * the call fails. The caller decides whether and where to show it; this never touches
+     * the chat. [hourOfDay] is the owner's local hour, 0-23.
+     */
+    suspend fun checkInLine(
+        relevantContext: suspend () -> String,
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        hourOfDay: Int
+    ): String? {
+        val config = settingsRepository.llmConfig.first()
+        if (!isActive(config) || !config.personaCheckInsEnabled) return null
+        val lastCheckIn = memory.lastCheckInAt()
+        if (!CheckInRule.isDue(recentMessages, nowMillis, hourOfDay, lastCheckIn)) return null
+        // Recorded before the call: a failed attempt must not be retried every few minutes.
+        memory.recordCheckIn(nowMillis)
+        val hoursQuiet = CheckInRule.hoursQuiet(recentMessages, nowMillis)
+        val context = relevantContext()
+        val shaped = PersonaPrompts.shapeHistory(recentMessages)
+        val nudge = ChatMessage(
+            id = UUID.randomUUID().toString(),
+            text = PersonaPrompts.checkInPrompt(hoursQuiet),
+            sender = ChatMessage.Sender.USER
+        )
+        // Images from earlier turns are never resent for an unprompted line.
+        val history = PersonaPrompts.shapeHistory(shaped.dialogue.map { it.copy(imageBase64 = null) } + nudge).dialogue
+        return try {
+            val response = chatProvider(config).complete(
+                withChatModel(
+                    LLMRequest(
+                        // An unprompted line never comes with an action: nobody is there to approve it.
+                        systemPrompt = chatSystemPrompt(
+                            config, context, shaped.deviceActivity, screenshotAttached = false, ownActions = false
+                        ),
+                        messages = history,
+                        temperature = CHAT_TEMPERATURE,
+                        maxTokens = 160,
+                        responseFormat = ResponseFormat.TEXT,
+                        retryPolicy = RetryPolicy.NONE
+                    ),
+                    config
+                )
+            )
+            PersonaPrompts.cleanReply(PersonaActions.split(response.content).text)
+                .takeIf { line -> line.any { it.isLetterOrDigit() } }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun ownerName(): String =
+        (userProfileStore.read() as? ProfileStoreResult.Success)?.value?.name.orEmpty()
+
+    private suspend fun seedOnce() {
+        if (!seeded.compareAndSet(false, true)) return
+        try {
+            memory.seedIfNeeded(store.seedNotes())
+        } catch (e: CancellationException) {
+            seeded.set(false)
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Seed notes were not written: ${e.javaClass.simpleName}")
+        }
+    }
+
+    companion object {
+        private const val TAG = "PersonaEngine"
+        private const val REPLIES_PER_REFLECTION = 3
+        private const val MAX_CHANGES_PER_REFLECTION = 3
+
+        /** Her replies want more variety than the stock assistant's 0.5. */
+        const val CHAT_TEMPERATURE = 0.8f
+        // Room for a model that spends some of its allowance before it starts the reply.
+        const val CHAT_MAX_TOKENS = 600
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt
new file mode 100644
index 0000000..731fc64
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt
@@ -0,0 +1,82 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.MemoryRepository
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her notebook, stored as rows of the existing `memories` table under
+ * [PersonaNotes.KEY_PREFIX]. No schema change: the rows are ordinary long-term
+ * memories, so they show up in the Memory screen where the owner can read and
+ * delete them, and they are filtered out of the context the planner sees.
+ */
+@Singleton
+class PersonaMemory @Inject constructor(
+    private val memoryRepository: MemoryRepository
+) {
+    /** All notes, newest first. */
+    suspend fun notes(): List<PersonaNotes.Note> =
+        memoryRepository.getMemoriesByKeyPrefix(PersonaNotes.KEY_PREFIX)
+            // LIKE treats some characters as wildcards, so confirm the prefix for real.
+            .filter { it.key.startsWith(PersonaNotes.KEY_PREFIX) && it.type == MemoryType.SEMANTIC }
+            .sortedByDescending { it.timestamp }
+            .mapNotNull { PersonaNotes.fromStorage(it.key, it.value) }
+
+    /** Writes the starting notes once. A notebook the owner has emptied stays empty. */
+    suspend fun seedIfNeeded(seed: List<PersonaNotes.Note>) {
+        if (memoryRepository.getMemory(SEEDED_KEY) != null) return
+        if (notes().isEmpty()) {
+            // Oldest timestamps first so that anything learned later sorts above the seed.
+            val base = System.currentTimeMillis() - seed.size
+            seed.forEachIndexed { index, note ->
+                memoryRepository.saveMemory(
+                    Memory(note.storageKey, note.text, MemoryType.SEMANTIC, base + index)
+                )
+            }
+        }
+        memoryRepository.saveMemory(Memory(SEEDED_KEY, "1", MemoryType.SEMANTIC))
+    }
+
+    /** Stores [changes]: a note with a known key replaces the old one, a closed thread is removed. */
+    suspend fun apply(changes: List<PersonaNotes.Note>) {
+        for (note in changes) {
+            if (note.isClosedThread) {
+                memoryRepository.deleteMemory(note.storageKey)
+            } else {
+                memoryRepository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC))
+            }
+        }
+        prune()
+    }
+
+    /** When she last wrote unprompted, or 0. Stored so a restart does not make her write again. */
+    suspend fun lastCheckInAt(): Long =
+        memoryRepository.getMemory(CHECK_IN_KEY)?.value?.toLongOrNull() ?: 0L
+
+    suspend fun recordCheckIn(atMillis: Long) {
+        memoryRepository.saveMemory(Memory(CHECK_IN_KEY, atMillis.toString(), MemoryType.SEMANTIC))
+    }
+
+    /** Keeps the notebook bounded: past the cap the oldest threads and opinions go first. */
+    private suspend fun prune() {
+        val all = notes()
+        var excess = all.size - PersonaNotes.MAX_TOTAL_NOTES
+        if (excess <= 0) return
+        val oldestFirst = all.asReversed()
+        val expendable = oldestFirst.filter { it.kind == PersonaNotes.Kind.THREAD || it.kind == PersonaNotes.Kind.OPINION } +
+            oldestFirst.filter { it.kind == PersonaNotes.Kind.USER || it.kind == PersonaNotes.Kind.REL }
+        for (note in expendable) {
+            if (excess <= 0) break
+            memoryRepository.deleteMemory(note.storageKey)
+            excess--
+        }
+    }
+
+    private companion object {
+        /** Not a note (its kind is unknown to [PersonaNotes]); it only records that seeding ran. */
+        const val SEEDED_KEY = "${PersonaNotes.KEY_PREFIX}meta.seeded"
+        const val CHECK_IN_KEY = "${PersonaNotes.KEY_PREFIX}meta.lastcheckin"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt
new file mode 100644
index 0000000..56f2222
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt
@@ -0,0 +1,130 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * The persona's own notebook: short plain-English notes she keeps between chats.
+ *
+ * A note is one line, `kind | key | text`. The same form is used for the seed file
+ * shipped with the app, for what the reflection call returns, and for display, so
+ * there is one parser and it is strict: a line that does not fit is dropped.
+ */
+object PersonaNotes {
+
+    /**
+     * Notes live in the existing `memories` table under this key prefix. The prefix is
+     * what keeps them out of the planner's "facts about user" context. No `_` or `%`:
+     * the DAO looks rows up with SQL LIKE, where those are wildcards.
+     */
+    const val KEY_PREFIX = "yume."
+
+    const val MAX_NOTE_CHARS = 200
+    const val MAX_TOTAL_NOTES = 80
+
+    enum class Kind(val label: String) {
+        /** A lasting fact about the owner. */
+        USER("user"),
+        /** Where the two of them stand. */
+        REL("rel"),
+        /** An ongoing matter; the text ends with its status. */
+        THREAD("thread"),
+        /** A view she holds. */
+        OPINION("opinion"),
+        /** The owner corrected how she should talk or act. */
+        FIX("fix");
+
+        companion object {
+            fun fromLabel(label: String): Kind? = entries.firstOrNull { it.label == label.trim().lowercase() }
+        }
+    }
+
+    data class Note(val kind: Kind, val key: String, val text: String) {
+        val storageKey: String get() = "$KEY_PREFIX${kind.label}.$key"
+
+        /** A thread whose status says it is over; it is removed instead of stored. */
+        val isClosedThread: Boolean
+            get() = kind == Kind.THREAD && CLOSED_STATUS.containsMatchIn(text)
+
+        fun toLine(): String = "${kind.label} | $key | $text"
+    }
+
+    private val KEY_FORM = Regex("^[a-z0-9][a-z0-9-]{1,39}$")
+    private val CLOSED_STATUS = Regex("""\|\s*closed\s*$""", RegexOption.IGNORE_CASE)
+    private val CONTROL_CHARS = Regex("""[\u0000-\u001F\u007F]""")
+
+    /** Parses one `kind | key | text` line, or returns null when it does not fit the form. */
+    fun parseLine(line: String): Note? {
+        val cleaned = line.trim().removePrefix("-").removePrefix("*").trim()
+        if (cleaned.isEmpty() || cleaned.startsWith("#")) return null
+        val parts = cleaned.split("|", limit = 3)
+        if (parts.size != 3) return null
+        val kind = Kind.fromLabel(parts[0]) ?: return null
+        val key = parts[1].trim().lowercase().replace(' ', '-').replace('_', '-')
+        if (!KEY_FORM.matches(key)) return null
+        val text = CONTROL_CHARS.replace(parts[2], " ").replace(Regex("""\s+"""), " ").trim()
+        if (text.length < 3) return null
+        return Note(kind, key, text.take(MAX_NOTE_CHARS))
+    }
+
+    /** Parses a block of lines, keeping at most [limit] valid notes and the last one per key. */
+    fun parse(text: String, limit: Int = Int.MAX_VALUE): List<Note> {
+        val byKey = LinkedHashMap<String, Note>()
+        for (line in text.lineSequence()) {
+            val note = parseLine(line) ?: continue
+            byKey.remove(note.storageKey)
+            byKey[note.storageKey] = note
+            if (byKey.size >= limit) break
+        }
+        return byKey.values.toList()
+    }
+
+    /** Rebuilds a note from a stored row, or null when the row is not a persona note. */
+    fun fromStorage(storageKey: String, value: String): Note? {
+        if (!storageKey.startsWith(KEY_PREFIX)) return null
+        val rest = storageKey.removePrefix(KEY_PREFIX)
+        val kind = Kind.fromLabel(rest.substringBefore('.')) ?: return null
+        val key = rest.substringAfter('.', "")
+        if (key.isEmpty()) return null
+        return Note(kind, key, value)
+    }
+
+    /**
+     * The block that goes into the chat prompt, grouped by kind and capped at [maxChars].
+     * [notes] is expected newest first, so when the cap bites it is old notes that go.
+     */
+    fun render(notes: List<Note>, maxChars: Int = 2400): String {
+        if (notes.isEmpty()) return ""
+        val order = listOf(Kind.FIX, Kind.REL, Kind.USER, Kind.THREAD, Kind.OPINION)
+        val headings = mapOf(
+            Kind.FIX to "He corrected you (this is how you do it now):",
+            Kind.REL to "Where you two stand:",
+            Kind.USER to "What you know about him:",
+            Kind.THREAD to "Still going on:",
+            Kind.OPINION to "What you think:"
+        )
+        var budget = maxChars
+        val kept = LinkedHashMap<Kind, MutableList<String>>()
+        // Corrections first so the cap never drops them, then everything else newest first.
+        val prioritised = notes.filter { it.kind == Kind.FIX } + notes.filterNot { it.kind == Kind.FIX }
+        for (note in prioritised) {
+            val line = "- ${note.text}"
+            if (line.length + 1 > budget) continue
+            budget -= line.length + 1
+            kept.getOrPut(note.kind) { mutableListOf() }.add(line)
+        }
+        return order.mapNotNull { kind ->
+            kept[kind]?.takeIf { it.isNotEmpty() }?.let { lines ->
+                headings.getValue(kind) + "\n" + lines.joinToString("\n")
+            }
+        }.joinToString("\n")
+    }
+
+    /** The same notes as plain `kind | key | text` lines, for the reflection call to read. */
+    fun renderForReview(notes: List<Note>, maxChars: Int = 3000): String {
+        val sb = StringBuilder()
+        for (note in notes) {
+            val line = note.toLine()
+            if (sb.length + line.length + 1 > maxChars) break
+            sb.append(line).append('\n')
+        }
+        return sb.toString().trimEnd()
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt
new file mode 100644
index 0000000..62b14cb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt
@@ -0,0 +1,115 @@
+package com.opendroid.ai.core.persona
+
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.random.Random
+
+/**
+ * The fixed lines the app itself speaks (before a shortcut runs, when a plan has
+ * nothing to report, when it fails), written in the persona's voice.
+ *
+ * These are static on purpose: no model call, so a command such as "flashlight on"
+ * costs nothing extra and can never be reworded into something untrue. Every line
+ * says only what the stock line it replaces said: "starting", "done" or "failed".
+ * Each key has several variants and never repeats the one it used last.
+ */
+class PersonaPhrasebook(private val random: Random = Random.Default) {
+
+    private val lastIndex = ConcurrentHashMap<String, Int>()
+
+    /** Spoken before an action starts. Names the thing; never claims it happened. */
+    fun preSpeech(action: String): String {
+        val options = PRE_SPEECH[action]
+        if (options != null) return pick("pre:$action", options)
+        val readable = action.lowercase().replace("_", " ")
+        return pick("pre:generic", GENERIC_PRE).replace("{action}", readable)
+    }
+
+    /** A plan finished and no step had anything to say for itself. */
+    fun goalDone(): String = pick("done", DONE)
+
+    /** A plan failed and no step left a message worth repeating. */
+    fun failure(): String = pick("failed", FAILED)
+
+    /** The user turned a proposed plan down. */
+    fun cancelled(): String = pick("cancelled", CANCELLED)
+
+    /** A contact name was needed and the reply did not contain one. */
+    fun missedContact(): String = pick("missed", MISSED_CONTACT)
+
+    /** The user picked [name] from a list of matching contacts. */
+    fun usingContact(name: String): String = pick("using", USING_CONTACT).replace("{name}", name)
+
+    /** Stands in for a reply that held nothing but a command of her own. */
+    fun ownAction(): String = pick("own", OWN_ACTION)
+
+    /** Spoken when the wake phrase is heard. Short, and never contains a wake phrase. */
+    fun wakeAck(): String = pick("wake", WAKE)
+
+    private fun pick(key: String, options: List<String>): String {
+        if (options.size == 1) return options[0]
+        val previous = lastIndex[key]
+        var index = random.nextInt(options.size)
+        if (index == previous) index = (index + 1) % options.size
+        lastIndex[key] = index
+        return options[index]
+    }
+
+    companion object {
+        internal val PRE_SPEECH: Map<String, List<String>> = mapOf(
+            "TOGGLE_FLASHLIGHT" to listOf("flashlight. ok", "mm. flashlight", "fine. light"),
+            "SET_ALARM" to listOf("alarm. ok", "mm. alarm", "fine. alarm"),
+            "SET_TIMER" to listOf("timer. ok", "mm. timer", "fine. timer"),
+            "TAKE_SCREENSHOT" to listOf("screenshot. ok", "mm. taking it", "fine. screenshot"),
+            "LOCK_SCREEN" to listOf("locking it", "ok. lock", "mm. locking"),
+            "TOGGLE_WIFI" to listOf("wifi. ok", "mm. wifi", "fine. wifi"),
+            "TOGGLE_BLUETOOTH" to listOf("bluetooth. ok", "mm. bluetooth", "fine. bluetooth"),
+            "TOGGLE_DND" to listOf("do not disturb. ok", "mm. quiet mode", "fine. do not disturb"),
+            "TOGGLE_HOTSPOT" to listOf("hotspot. ok", "mm. hotspot"),
+            "TOGGLE_MOBILE_DATA" to listOf("mobile data. ok", "mm. data"),
+            "SET_VOLUME" to listOf("volume. ok", "mm. volume", "fine. volume"),
+            "SET_BRIGHTNESS" to listOf("brightness. ok", "mm. brightness", "fine. brightness"),
+            "OPEN_APP" to listOf("opening it", "mm. opening", "fine. opening"),
+            "ANALYZE_SCREENSHOT" to listOf("show me your screen", "mm. looking", "ok. let me see"),
+            "READ_AND_REMEMBER_SCREEN" to listOf("reading your screen. keeping what matters", "mm. reading it", "ok. reading and saving"),
+            "READ_NOTES" to listOf("your notes. one sec", "mm. checking notes", "ok. notes"),
+            "RECALL_MEMORY" to listOf("checking what you saved", "mm. looking it up", "ok. checking"),
+            "ADD_NOTE" to listOf("note. ok", "mm. writing it down", "fine. note"),
+            "SET_RINGER_MODE" to listOf("ringer. ok", "mm. ringer"),
+            "PLAY_MUSIC" to listOf("music. ok", "mm. playing", "fine. music"),
+            "MAKE_CALL" to listOf("calling", "mm. calling", "ok. calling")
+        )
+
+        internal val GENERIC_PRE = listOf("ok. {action}", "mm. {action}", "fine. {action}")
+
+        internal val DONE = listOf("done", "there. done", "ok. done", "its done", "mm. done")
+
+        internal val FAILED = listOf(
+            "didnt work. try again",
+            "tch. that failed. try again",
+            "no. it didnt go through",
+            "that broke. say it again",
+            "muri. it failed"
+        )
+
+        internal val CANCELLED = listOf("ok. not doing it", "fine. dropped", "mm. cancelled")
+
+        internal val MISSED_CONTACT = listOf(
+            "didnt catch that. say the name again",
+            "hah? who. say the name",
+            "no name in that. try again"
+        )
+
+        internal val USING_CONTACT = listOf("ok. {name}", "mm. using {name}", "fine. {name}")
+
+        // None of these may read as yes, no or a command: the recogniser that opens next can
+        // hear the phone's own voice, and its transcript may answer a pending confirmation.
+        internal val WAKE = listOf("mm?", "what", "oi", "hah?", "say it")
+
+        internal val OWN_ACTION = listOf("watch", "hold on", "mm. one sec")
+
+        /** Every line the phrasebook can produce, for tests that check their form. */
+        internal fun allLines(): List<String> =
+            PRE_SPEECH.values.flatten() + GENERIC_PRE + DONE + FAILED + CANCELLED +
+                MISSED_CONTACT + USING_CONTACT + WAKE + OWN_ACTION
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaPrompts.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPrompts.kt
new file mode 100644
index 0000000..ae2e85d
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPrompts.kt
@@ -0,0 +1,286 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.prompts.neutralizeFenceDelimiters
+import com.opendroid.ai.data.models.ChatMessage
+
+/**
+ * Prompt text for the persona. Everything here is used only by the plain-text chat
+ * reply, the notebook reflection and the unprompted check-in. The planner, plan
+ * critic and merger, re-evaluation, intent classifier, vision, auto-reply and social
+ * prompts are built elsewhere and never see any of it: that separation is what keeps
+ * her voice out of device actions and out of text sent to other people.
+ */
+object PersonaPrompts {
+
+    /** Stands for the owner's name inside the character card. */
+    const val OWNER_PLACEHOLDER = "{{owner}}"
+
+    /** Used when no profile name is stored; the card is written to read correctly with it. */
+    const val OWNER_FALLBACK = "him"
+
+    /** Label shown above her chat bubbles and used to tell her lines from the app's. */
+    const val BADGE = "Yume"
+
+    /** First line of the app-authored block. Tests look for it to prove where the persona is. */
+    const val APP_FACTS_HEADING = "=== HOW THIS APP WORKS (facts, not character) ==="
+
+    /** Badge of a reply of hers that the owner cut off; still hers when history is replayed. */
+    const val STOPPED_BADGE = "$BADGE (stopped)"
+
+    /**
+     * Put in front of an owner message that the app, not she, went on to answer. It claims
+     * only what is known at that point: the app took it. Whether anything came of it is
+     * for the app's own lines to say.
+     */
+    const val HANDLED_COMMAND_LABEL = "(command to the phone, not for you; what came of it is in the app lines below, if anything) "
+
+    /** Put in front of the app's line that only announces a shortcut ("alarm. ok"). */
+    const val STARTED_LABEL = "started, not confirmed: "
+
+    /** True for a stored row that she wrote, finished or cut off. */
+    fun isHers(message: ChatMessage): Boolean =
+        message.sender != ChatMessage.Sender.USER &&
+            (message.modelBadge == BADGE || message.modelBadge?.startsWith("$BADGE ") == true)
+
+    /** The line her prompt gets when the planner answered in words instead of acting. */
+    fun plannerNoteLine(note: String?): String? =
+        note?.trim()?.takeIf { it.isNotEmpty() }
+            ?.let { "the app did not act on his last message. what it had to say about that: ${oneLine(it)}" }
+
+    /**
+     * App-supplied text on one line, with nothing in it that could pass for one of this
+     * prompt's own section headings or for markup.
+     */
+    private fun oneLine(text: String): String =
+        neutralizeFenceDelimiters(text.replace(Regex("""\s+"""), " "))
+            .replace("===", "= = =")
+            .take(MAX_ACTIVITY_CHARS)
+
+    /** Badge the app puts on the line it says before a shortcut runs. */
+    private const val ALIAS_BADGE = "alias"
+
+    private const val MAX_ACTIVITY_LINES = 6
+    private const val MAX_ACTIVITY_CHARS = 220
+
+    fun fillOwner(card: String, ownerName: String): String =
+        card.replace(OWNER_PLACEHOLDER, ownerName.trim().ifEmpty { OWNER_FALLBACK })
+
+    /**
+     * The whole system prompt for one chat reply: the character card, then facts the
+     * app states in its own words so that no character trait can talk her out of them.
+     */
+    fun chatSystemPrompt(
+        card: String,
+        ownerName: String,
+        autoModeLabel: String,
+        relevantContext: String,
+        notes: String,
+        deviceActivity: List<String>,
+        screenshotAttached: Boolean,
+        ownActions: Boolean = false
+    ): String {
+        val screenLine = if (screenshotAttached) {
