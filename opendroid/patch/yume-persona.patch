+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaOwnTime.Bounds
+import com.opendroid.ai.core.persona.PersonaOwnTime.State
+import com.opendroid.ai.core.persona.PersonaOwnTime.Wake
+import com.opendroid.ai.core.persona.PersonaOwnTime.Why
+import com.opendroid.ai.core.persona.PersonaSleep.Ask
+import com.opendroid.ai.core.persona.PersonaSleep.Repair
+import com.opendroid.ai.core.persona.PersonaSleep.Ring
+import com.opendroid.ai.core.persona.PersonaSleep.SleepMoved
+import com.opendroid.ai.core.persona.PersonaSleep.Skipped
+import com.opendroid.ai.core.persona.PersonaSleep.WokeBy
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.TimeZone
+
+/**
+ * Her sleep as the rules of [PersonaSleep] have it: what a `sleep:` line is read as,
+ * when she wakes and when her pass comes, what a message of his does, and what she is
+ * told about all of it, held against the numbers the code goes by.
+ */
+class PersonaSleepTest {
+
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private val utc: TimeZone = TimeZone.getTimeZone("UTC")
+
+    /** 23:00 on his clock (UTC), 08:00 in Tokyo. */
+    private val now = 1_800_000_000_000L - 9 * hour
+    private val bounds = Bounds(minGapMillis = 15 * minute, maxPerDay = 24)
+
+    private val awake = State(on = true, wake = Wake.At(now), why = Why.ASKED)
+
+    private fun lie(
+        ask: Ask,
+        state: State = awake,
+        at: Long = now,
+        jitter: Long = 0,
+        within: Bounds = bounds,
+        asked: String = PersonaSleep.written(ask)
+    ) = PersonaSleep.lieDown(state, ask, asked, at, utc, within, jitter)
+
+    // ── What a sleep: line is read as ─────────────────────────────────────────────────
+
+    @Test
+    fun `a span, a clock time on his clock or in tokyo, or nothing for her usual, and nothing else`() {
+        assertEquals(Ask.For(7 * hour), PersonaSleep.parseAsk("7h"))
+        assertEquals(Ask.For(8 * hour + 30 * minute), PersonaSleep.parseAsk("8h30m"))
+        assertEquals(Ask.For(7 * hour), PersonaSleep.parseAsk("for 7 hours"))
+        assertEquals(Ask.For(90 * minute), PersonaSleep.parseAsk("90m."))
+        assertEquals(Ask.Until(6, 0, tokyo = false), PersonaSleep.parseAsk("until 06:00"))
+        assertEquals(Ask.Until(6, 0, tokyo = false), PersonaSleep.parseAsk("06:00"))
+        assertEquals(Ask.Until(6, 0, tokyo = false), PersonaSleep.parseAsk("until 06:00 on his clock"))
+        assertEquals(Ask.Until(6, 0, tokyo = false), PersonaSleep.parseAsk("until 06:00 (his clock)"))
+        assertEquals(Ask.Until(6, 0, tokyo = true), PersonaSleep.parseAsk("06:00 tokyo"))
+        assertEquals(Ask.Until(15, 30, tokyo = true), PersonaSleep.parseAsk("until 15:30 Tokyo time"))
+        assertEquals(Ask.Usual, PersonaSleep.parseAsk(""))
+        assertEquals(Ask.Usual, PersonaSleep.parseAsk("   "))
+        for (unread in listOf("soon", "no", "when he writes", "when he writes to me", "until morning", "25:00", "7h tokyo", "forever", "0h")) {
+            assertNull(unread, PersonaSleep.parseAsk(unread))
+        }
+    }
+
+    @Test
+    fun `only an exact sleep line among her thoughts asks for sleep, and the last one counts`() {
+        assertNull(PersonaSleep.askedIn("i should sleep"))
+        assertNull(PersonaSleep.askedIn("sleeping: 7h"))
+        assertNull(PersonaSleep.askedIn(""))
+        assertEquals(Ask.For(7 * hour), PersonaSleep.askedIn("he is boring tonight\nsleep: 7h"))
+        assertEquals(Ask.Until(6, 0, tokyo = false), PersonaSleep.askedIn("sleep: 7h\nSleep: until 06:00"))
+        assertEquals(Ask.Usual, PersonaSleep.askedIn("done with today\nsleep:"))
+        // A line the app cannot read asks for nothing, even after one it could: she stays awake.
+        assertNull(PersonaSleep.askedIn("sleep: 7h\nsleep: soon"))
+    }
+
+    // ── Lying down ───────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a span comes out up to half an hour later and never earlier, and a clock time is kept exactly`() {
+        for ((jitter, later) in listOf(0L to 0L, 17 * minute to 17 * minute, 30 * minute to 30 * minute, 45 * minute to 30 * minute, -5 * minute to 0L)) {
+            val asleep = lie(Ask.For(7 * hour), jitter = jitter)
+            assertEquals("$jitter", now + 7 * hour + later, asleep.sleepUntil)
+            assertEquals(7 * hour, asleep.sleepMeantMillis)
+        }
+        assertEquals(30 * minute, PersonaSleep.MAX_JITTER_MILLIS)
+        // Until 06:00 on his clock: seven hours from 23:00, whatever the jitter.
+        val clock = lie(Ask.Until(6, 0, tokyo = false), jitter = 30 * minute)
+        assertEquals(now + 7 * hour, clock.sleepUntil)
+        assertEquals(PersonaOwnTime.nextClockTime(now, utc, 6, 0), clock.sleepUntil)
+        // Until 15:00 in Tokyo, where it is 08:00 now.
+        val tokyo = lie(Ask.Until(15, 0, tokyo = true), jitter = 30 * minute)
+        assertEquals(now + 7 * hour, tokyo.sleepUntil)
+        assertEquals(PersonaOwnTime.nextClockTime(now, PersonaSleep.TOKYO, 15, 0), tokyo.sleepUntil)
+        // She is asleep from now, and the night is told apart by when she lay down.
+        assertEquals(now, clock.asleepSince)
+        assertEquals("until 06:00", clock.sleepAsked)
+        assertTrue(PersonaSleep.isAsleep(clock, now + hour))
+        assertFalse(PersonaSleep.isAsleep(awake, now))
+    }
+
+    @Test
+    fun `her usual is the last length she named, else seven hours`() {
+        assertEquals(now + 7 * hour, lie(Ask.Usual).sleepUntil)
+        assertEquals(7 * hour, PersonaSleep.DEFAULT_MILLIS)
+        val named = lie(Ask.For(9 * hour))
+        assertEquals(9 * hour, named.lastSleepSpanMillis)
+        val usual = lie(Ask.Usual, state = awake.copy(lastSleepSpanMillis = 9 * hour))
+        assertEquals(now + 9 * hour, usual.sleepUntil)
+        assertEquals(9 * hour, usual.lastSleepSpanMillis)
+    }
+
+    @Test
+    fun `a sleep is kept between half an hour, or his least gap, and sixteen hours, and she is told it was moved`() {
+        val short = lie(Ask.For(10 * minute))
+        assertEquals(now + 30 * minute, short.sleepUntil)
+        assertEquals(SleepMoved.SHORT, short.sleepMoved)
+        // His least gap between two moments is a floor too: her waking is a moment.
+        val gap = lie(Ask.For(hour), within = Bounds(minGapMillis = 2 * hour, maxPerDay = 24))
+        assertEquals(now + 2 * hour, gap.sleepUntil)
+        assertEquals(SleepMoved.SHORT, gap.sleepMoved)
+        val long = lie(Ask.For(20 * hour), jitter = 20 * minute)
+        assertEquals(now + 16 * hour, long.sleepUntil)
+        assertEquals(SleepMoved.LONG, long.sleepMoved)
+        // Sixteen hours at most, the jitter included.
+        assertEquals(now + 16 * hour, lie(Ask.For(16 * hour), jitter = 20 * minute).sleepUntil)
+        // A clock time that is two minutes away is a sleep that is too short.
+        assertEquals(SleepMoved.SHORT, lie(Ask.Until(23, 2, tokyo = false)).sleepMoved)
+        assertNull(lie(Ask.For(8 * hour)).sleepMoved)
+        assertEquals(30 * minute, PersonaSleep.MIN_MILLIS)
+        assertEquals(16 * hour, PersonaSleep.MAX_MILLIS)
+    }
+
+    @Test
+    fun `a long sleep has its pass twenty minutes in, a nap and a sleep soon after the last pass have none, unless one is owed`() {
+        val night = lie(Ask.For(7 * hour))
+        assertEquals(now + 20 * minute, night.repairDueAt)
+        assertEquals(Wake.At(now + 20 * minute), night.wake)
+        assertNull(night.lastRepair)
+        assertEquals(0, night.repairTries)
+
+        val nap = lie(Ask.For(2 * hour))
+        assertEquals(0L, nap.repairDueAt)
+        assertEquals(Wake.At(now + 2 * hour), nap.wake)
+        assertEquals(Skipped.NAP, nap.lastRepair!!.skipped)
+
+        val recent = lie(Ask.For(7 * hour), state = awake.copy(lastRepairOkAt = now - 5 * hour))
+        assertEquals(0L, recent.repairDueAt)
+        assertEquals(Skipped.RECENT, recent.lastRepair!!.skipped)
+        // Twelve hours after the last one, a pass is due again.
+        assertEquals(now + 20 * minute, lie(Ask.For(7 * hour), state = awake.copy(lastRepairOkAt = now - 12 * hour)).repairDueAt)
+
+        // Owed: the pass comes whatever the length and however recent the last one.
+        val owed = awake.copy(repairOwed = true, lastRepairOkAt = now - hour)
+        assertEquals(now + 20 * minute, lie(Ask.For(7 * hour), state = owed).repairDueAt)
+        assertEquals(now + 20 * minute, lie(Ask.For(2 * hour), state = owed).repairDueAt)
+        // Not when it would come within a quarter of an hour of her waking: it stays owed.
+        val tooShort = lie(Ask.For(30 * minute), state = owed)
+        assertEquals(0L, tooShort.repairDueAt)
+        assertTrue(tooShort.repairOwed)
+        assertEquals(Wake.At(now + 30 * minute), tooShort.wake)
+        assertEquals(Skipped.NAP, tooShort.lastRepair!!.skipped)
+    }
+
+    // ── While she sleeps ─────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the ring is her pass first, then her waking, else nothing`() {
+        val night = lie(Ask.For(7 * hour))
+        assertEquals(Ring.NONE, PersonaSleep.ring(night, now))
+        assertEquals(Ring.NONE, PersonaSleep.ring(night, now + 19 * minute))
+        assertEquals(Ring.REPAIR, PersonaSleep.ring(night, now + 20 * minute - 20_000))
+        assertEquals(Ring.REPAIR, PersonaSleep.ring(night, now + 20 * minute))
+        // Both due, or the pass so late it would come within a quarter of an hour of her waking: her waking,
+        // or nothing until then. A late ring does not hold her waking up with a pass.
+        assertEquals(Ring.WAKE, PersonaSleep.ring(night, now + 8 * hour))
+        assertEquals(Ring.WAKE, PersonaSleep.ring(night, now + 7 * hour))
+        assertEquals(Ring.NONE, PersonaSleep.ring(night, now + 7 * hour - 10 * minute))
+        assertEquals(Ring.REPAIR, PersonaSleep.ring(night, now + 7 * hour - 16 * minute))
+        val done = night.copy(repairDueAt = 0)
+        assertEquals(Ring.NONE, PersonaSleep.ring(done, now + 6 * hour))
+        assertEquals(Ring.WAKE, PersonaSleep.ring(done, now + 7 * hour - 20_000))
+        assertEquals(Ring.WAKE, PersonaSleep.ring(done, now + 9 * hour))
+        // Out of tries: never the pass.
+        assertEquals(Ring.NONE, PersonaSleep.ring(night.copy(repairTries = 3), now + 21 * minute))
+        assertEquals(Ring.WAKE, PersonaSleep.ring(night.copy(repairTries = 3), now + 7 * hour))
+        assertEquals(Ring.NONE, PersonaSleep.ring(awake, now))
+    }
+
+    @Test
+    fun `a ring that finds nothing to do owes a pass that came too late, and sends the alarm back to her sleep's own time`() {
+        val night = lie(Ask.For(7 * hour))
+        // Nothing to settle: the stored time is the sleep's own.
+        assertEquals(night, PersonaSleep.settled(night, now + 19 * minute))
+        assertEquals(Wake.At(now + 20 * minute), PersonaSleep.alarm(night))
+        // Too late for the pass: it is owed, and the alarm is for her waking.
+        val late = PersonaSleep.settled(night, now + 7 * hour - 10 * minute)
+        assertEquals(0L, late.repairDueAt)
+        assertTrue(late.repairOwed)
+        assertEquals(Wake.At(now + 7 * hour), late.wake)
+        assertEquals(night.asleepSince, late.asleepSince)
+        // Something left another time in the alarm (a moment's next: over her sleep): her sleep's own time again.
+        val other = night.copy(wake = Wake.At(now + 5 * minute))
+        assertEquals(Wake.At(now + 20 * minute), PersonaSleep.settled(other, now + 6 * minute).wake)
+        assertEquals(night.copy(wake = Wake.At(now + 20 * minute)), PersonaSleep.settled(other.copy(wake = Wake.WhenHeWrites), now + 6 * minute))
+        // Awake, nothing is settled.
+        assertEquals(awake, PersonaSleep.settled(awake, now))
+    }
+
+    @Test
+    fun `an owed pass that keeps failing comes in a nap no longer after a few sleeps, and one that comes about starts the count again`() {
+        val owed = awake.copy(repairOwed = true, lastRepairOkAt = now - 30 * hour)
+        // Tried in a sleep and failed: one more missed sleep in a row.
+        val tried = PersonaSleep.beforeRepair(lie(Ask.For(2 * hour), state = owed), now + 20 * minute)
+        val woke = PersonaSleep.wokeOnOwn(tried, now + 2 * hour)
+        assertEquals(1, woke.repairMissed)
+        assertTrue(woke.repairOwed)
+        // A sleep whose pass never came to be tried (he woke her first) is not counted.
+        val untried = PersonaSleep.wokenByHim(lie(Ask.For(2 * hour), state = owed), now + 10 * minute, utc, bounds)
+        assertEquals(0, untried.repairMissed)
+        assertTrue(untried.repairOwed)
+        // Below the count an owed pass comes in a nap; at it, only by the usual rule.
+        assertEquals(now + 20 * minute, lie(Ask.For(2 * hour), state = owed.copy(repairMissed = 2)).repairDueAt)
+        val backedOff = lie(Ask.For(2 * hour), state = owed.copy(repairMissed = PersonaSleep.OWED_SLEEPS))
+        assertEquals(0L, backedOff.repairDueAt)
+        assertEquals(Skipped.NAP, backedOff.lastRepair!!.skipped)
+        assertEquals(now + 20 * minute, lie(Ask.For(7 * hour), state = owed.copy(repairMissed = PersonaSleep.OWED_SLEEPS)).repairDueAt)
+        // One that comes about owes nothing and counts from nothing again.
+        val night = lie(Ask.For(7 * hour), state = owed.copy(repairMissed = 5))
+        val ok = PersonaSleep.afterRepair(PersonaSleep.beforeRepair(night, now + 20 * minute), night.asleepSince, Repair(now + 20 * minute, ok = true))
+        assertEquals(0, ok.repairMissed)
+        assertFalse(ok.repairOwed)
+        // Switched off in a sleep whose pass failed: counted too.
+        assertEquals(1, PersonaSleep.cleared(tried).repairMissed)
+        // Stored and read back.
+        assertEquals(4, PersonaOwnTime.decode(PersonaOwnTime.encode(awake.copy(repairMissed = 4))).repairMissed)
+    }
+
+    @Test
+    fun `woken while her pass runs and lying down again, she does not have the same pass twice`() {
+        val night = lie(Ask.For(7 * hour))
+        val trying = PersonaSleep.beforeRepair(night, now + 20 * minute)
+        // His message woke her while it ran, and her reply had << sleep: 6h: the pass was owed then, so the new sleep has one.
+        val woken = PersonaSleep.wokenByHim(trying, now + 30 * minute, utc, bounds)
+        val again = lie(Ask.For(6 * hour), state = woken, at = now + 31 * minute)
+        assertEquals(now + 51 * minute, again.repairDueAt)
+        // The first pass came about: the new sleep's is not had, and the alarm is for her waking.
+        val good = Repair(now + 20 * minute, ok = true, rewritten = 1)
+        val after = PersonaSleep.afterRepair(again, night.asleepSince, good)
+        assertEquals(0L, after.repairDueAt)
+        assertEquals(Wake.At(now + 31 * minute + 6 * hour), after.wake)
+        assertEquals(again.asleepSince, after.asleepSince)
+        assertFalse(after.repairOwed)
+        assertEquals(good, after.lastRepair)
+        // When it did not come about, the new sleep keeps its pass.
+        val failed = PersonaSleep.afterRepair(again, night.asleepSince, Repair.failed(now + 20 * minute))
+        assertEquals(now + 51 * minute, failed.repairDueAt)
+        assertTrue(failed.repairOwed)
+    }
+
+    @Test
+    fun `the next try is stored before a try, and a try that would come past her waking is owed instead`() {
+        val night = lie(Ask.For(7 * hour))
+        val first = PersonaSleep.beforeRepair(night, now + 20 * minute)
+        assertEquals(1, first.repairTries)
+        assertTrue(first.repairOwed)
+        assertEquals(now + 35 * minute, first.repairDueAt)
+        assertEquals(Wake.At(now + 35 * minute), first.wake)
+        val second = PersonaSleep.beforeRepair(first, now + 35 * minute)
+        assertEquals(now + 65 * minute, second.repairDueAt)
+        // The third is the last one.
+        val third = PersonaSleep.beforeRepair(second, now + 65 * minute)
+        assertEquals(3, third.repairTries)
+        assertEquals(0L, third.repairDueAt)
+        assertTrue(third.repairOwed)
+        assertEquals(Wake.At(now + 7 * hour), third.wake)
+        assertEquals(3, PersonaSleep.TRIES)
+        // A retry that would land within a quarter of an hour of her waking is not set.
+        val short = lie(Ask.For(40 * minute), state = awake.copy(repairOwed = true))
+        val tried = PersonaSleep.beforeRepair(short, now + 20 * minute)
+        assertEquals(0L, tried.repairDueAt)
+        assertTrue(tried.repairOwed)
+        assertEquals(Wake.At(now + 40 * minute), tried.wake)
+    }
+
+    @Test
+    fun `a pass that came about owes nothing and sends the alarm to her waking, one that did not keeps the retry, and a pass of a sleep she left touches no alarm`() {
+        val night = lie(Ask.For(7 * hour))
+        val trying = PersonaSleep.beforeRepair(night, now + 20 * minute)
+        val good = Repair(now + 20 * minute, ok = true, rewritten = 2, added = 1)
+        val ok = PersonaSleep.afterRepair(trying, night.asleepSince, good)
+        assertFalse(ok.repairOwed)
+        assertEquals(0L, ok.repairDueAt)
+        assertEquals(0, ok.repairTries)
+        assertEquals(now + 20 * minute, ok.lastRepairOkAt)
+        assertEquals(good, ok.lastRepair)
+        assertEquals(Wake.At(now + 7 * hour), ok.wake)
+
+        val failed = PersonaSleep.afterRepair(trying, night.asleepSince, Repair.failed(now + 20 * minute))
+        assertTrue(failed.repairOwed)
+        assertEquals(now + 35 * minute, failed.repairDueAt)
+        assertEquals(trying.wake, failed.wake)
+        assertFalse(failed.lastRepair!!.ok)
+
+        // He woke her while it ran: what it came to is kept, the alarm he set is left as it is.
+        val woken = PersonaSleep.wokenByHim(trying, now + 30 * minute, utc, bounds)
+        val after = PersonaSleep.afterRepair(woken, night.asleepSince, good)
+        assertEquals(woken.wake, after.wake)
+        assertEquals(woken.why, after.why)
+        assertFalse(after.repairOwed)
+        assertEquals(good, after.lastRepair)
+        assertEquals(0L, after.asleepSince)
+    }
+
+    @Test
+    fun `she wakes on her own at her time, and a ring that comes late finds her woken at her time`() {
+        val night = lie(Ask.For(7 * hour)).copy(repairDueAt = 0)
+        val woke = PersonaSleep.wokeOnOwn(night, now + 7 * hour)
+        assertEquals(0L, woke.asleepSince)
+        assertEquals(WokeBy.OWN, woke.wokeBy)
+        assertEquals(now + 7 * hour, woke.lastWokeAt)
+        assertEquals(7 * hour, woke.lastSleptMillis)
+        assertEquals(7 * hour, woke.lastMeantMillis)
+        assertEquals(Why.WOKE, woke.why)
+        assertEquals(Wake.At(now + 7 * hour), woke.wake)
+        assertFalse(woke.repairOwed)
+        val late = PersonaSleep.wokeOnOwn(night, now + 10 * hour)
+        assertEquals(now + 7 * hour, late.lastWokeAt)
