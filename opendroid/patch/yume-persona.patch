+                complete(HerWords.request(card, ownerName, ask))
+            } catch (e: CancellationException) {
+                // The owner stopped the task: that is passed on. Otherwise a time limit
+                // inside the provider cut the call short, which is a failed call.
+                currentCoroutineContext().ensureActive()
+                return HerWords.Answer.Unreachable
+            } catch (e: Exception) {
+                Log.w(TAG, "Her words were not asked for: ${e.javaClass.simpleName}")
+                return HerWords.Answer.Unreachable
