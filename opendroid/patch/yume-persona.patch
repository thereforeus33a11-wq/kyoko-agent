--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/ui/viewmodel/PersonaViewModel.kt
@@ -0,0 +1,225 @@
+package com.opendroid.ai.ui.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.persona.PersonaLibrary
+import com.opendroid.ai.core.persona.PersonaMemory
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.core.persona.PersonaStore
+import dagger.hilt.android.lifecycle.HiltViewModel
+import java.io.IOException
+import javax.inject.Inject
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** What a screen has to say about a saved edit of the card and the built-in card of this version. */
+enum class CardEditNotice {
+    /** Nothing: there is no saved edit, or it stands on the built-in card as it is now. */
+    NONE,
+
+    /** The built-in card is another one than the edit was made on. */
+    BUILT_IN_CHANGED,
+
+    /** The edit is older than the record of what it was made on. */
+    CANNOT_TELL
+}
+
+internal fun PersonaStore.EditBase.toNotice(): CardEditNotice = when (this) {
+    PersonaStore.EditBase.NONE, PersonaStore.EditBase.CURRENT -> CardEditNotice.NONE
+    PersonaStore.EditBase.CHANGED -> CardEditNotice.BUILT_IN_CHANGED
+    PersonaStore.EditBase.UNKNOWN -> CardEditNotice.CANNOT_TELL
+}
+
+/** Backs the screen where the owner reads and edits the persona's character card and hands her notes. */
+@HiltViewModel
+class PersonaViewModel @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val library: PersonaLibrary
+) : ViewModel() {
+
+    /** What the library holds, for the line under its setting. Empty until it has been read. */
+    var librarySummary by mutableStateOf("")
+        private set
+
+    /** The text field in which the owner hands her notes, and what came of the last hand-over. */
+    var notesDraft by mutableStateOf("")
+        private set
+    var notesStatus by mutableStateOf("")
+        private set
+
+    fun onNotesDraftChange(text: String) {
+        notesDraft = text
+        notesStatus = ""
+    }
+
+    /**
+     * Puts the lines of the draft into her notebook, on this phone. Each line is
+     * `kind | key | note`, the form her own notes have. Nothing is sent anywhere.
+     *
+     * A notebook that was copied on another phone after its start says so in its first
+     * line. It is then taken over as the notebook it is: the starting notes are not
+     * written into it a second time.
+     */
+    fun giveNotes() {
+        val text = notesDraft
+        viewModelScope.launch {
+            val notes = PersonaNotes.parse(text)
+            val lines = text.lines().count { it.isNotBlank() && !it.trimStart().startsWith("#") }
+            if (notes.isNotEmpty()) {
+                withContext(Dispatchers.IO) {
+                    memory.apply(notes)
+                    if (PersonaNotes.carriesStartedMark(text)) memory.markStarted()
+                }
+            }
+            notesStatus = when {
+                notes.isEmpty() -> "Nothing added. Each line has to read: kind | key | note"
+                notes.size < lines -> "Added ${notes.size} of $lines lines. The rest did not fit the form."
+                else -> "Added ${notes.size}. They are in her notebook now."
+            }
+            if (notes.isNotEmpty() && notes.size >= lines) notesDraft = ""
+        }
+    }
+
+    /**
+     * Hands [toClipboard] her whole notebook as `kind | key | note` lines, the form
+     * [giveNotes] takes, so that it can be carried to another install. A notebook that
+     * has had its start says so in a first line of its own ([PersonaNotes.STARTED_MARK]).
+     * The notes are only read here; where the text goes after that is the clipboard's business.
+     */
+    fun copyNotebook(toClipboard: (String) -> Unit) {
+        viewModelScope.launch {
+            val (notes, started) = withContext(Dispatchers.IO) { memory.notes() to memory.isStarted() }
+            if (notes.isEmpty()) {
+                notesStatus = "Her notebook is empty. Nothing was copied."
+                return@launch
+            }
+            // Whether it has had its starting notes travels with it, so they are not written in again there.
+            toClipboard(PersonaNotes.export(notes, started))
+            notesStatus = "Copied ${notes.size} notes. On the other phone, paste them into the field above " +
+                "and add them: that is how her notebook is moved."
+        }
+    }
+
+    /** Deletes every note of hers. The starting notes are not written again afterwards. */
+    fun emptyNotebook() {
+        viewModelScope.launch {
+            val deleted = withContext(Dispatchers.IO) { memory.empty() }
+            notesStatus = if (deleted == 0) {
+                "Her notebook was empty already."
+            } else {
+                "Her notebook is empty now: $deleted notes were deleted. The starting notes are not written again."
+            }
+        }
+    }
+
+    fun loadLibrarySummary() {
+        if (librarySummary.isNotEmpty()) return
+        viewModelScope.launch {
+            val shelf = library.shelf()
+            librarySummary = if (shelf.pages.isEmpty()) {
+                "This build has none of her files beyond the card."
+            } else {
+                "${library.fileCount} of her files are on this phone, ${shelf.pages.size} pages, " +
+                    "about ${shelf.totalChars / 1000},000 characters."
+            }
+        }
+    }
+
+    // Snapshot state, not a StateFlow: a text field this long drops characters when
+    // every keystroke makes an asynchronous round trip.
+    var cardText by mutableStateOf("")
+        private set
+    var isLoading by mutableStateOf(true)
+        private set
+
+    /** True when a saved edit, not the bundled card, is what she runs on. */
+    var usesSavedEdit by mutableStateOf(false)
+        private set
+    var hasUnsavedChanges by mutableStateOf(false)
+        private set
+
+    /** What there is to say about the saved edit and the built-in card of this version. */
+    var editNotice by mutableStateOf(CardEditNotice.NONE)
+        private set
+
+    /** Why the last save, restore or choice did not go through; empty when it did. */
+    var cardError by mutableStateOf("")
+        private set
+
+    private data class Stored(val text: String, val edited: Boolean, val notice: CardEditNotice)
+
+    private fun readStored() = Stored(store.card(), store.hasOverride(), store.editBase().toNotice())
+
+    /** Shows what is stored. With [keepTyped] the text in the editor, saved or not, is left as he has it. */
+    private fun show(stored: Stored, keepTyped: Boolean = false) {
+        if (!keepTyped) {
+            cardText = stored.text
+            hasUnsavedChanges = false
+        }
+        usesSavedEdit = stored.edited
+        editNotice = stored.notice
+        cardError = ""
+    }
+
+    init {
+        viewModelScope.launch {
+            show(withContext(Dispatchers.IO) { readStored() })
+            isLoading = false
+        }
+    }
+
+    fun onTextChange(text: String) {
+        cardText = text
+        hasUnsavedChanges = true
+    }
+
+    /**
+     * Changes what is stored and then shows what is stored. A write that fails leaves
+     * the text in the editor as it is and says so on the screen: storage that is full is
+     * no reason to lose what he typed, or to take the app down with it.
+     */
+    private fun change(failure: String, keepTyped: Boolean = false, then: () -> Unit = {}, write: () -> Unit) {
+        viewModelScope.launch {
+            val stored = try {
+                withContext(Dispatchers.IO) {
+                    write()
+                    readStored()
+                }
+            } catch (e: IOException) {
+                cardError = failure
+                return@launch
+            }
+            show(stored, keepTyped)
+            then()
+        }
+    }
+
+    /**
+     * Saves the text; she uses it from her next reply. Saving an empty card restores the
+     * bundled one. [then] runs once the text is stored, and not at all when it could not be.
+     */
+    fun save(then: () -> Unit = {}) {
+        val text = cardText
+        change("The card could not be saved. Your text is still here; the card she runs on is unchanged.", then = then) {
+            store.saveCard(text)
+        }
+    }
+
+    /** Removes the saved edit, so that she runs on the built-in card of this version. */
+    fun restoreBundled() {
+        change("Your edit could not be removed. She still runs on it.") { store.saveCard("") }
+    }
+
+    /**
+     * Keeps the saved edit although the built-in card is another one now. Only the notice
+     * goes: what he is typing in the editor at that moment is not touched.
+     */
+    fun keepEdit() {
+        change("That could not be stored. Nothing was changed.", keepTyped = true) { store.keepEdit() }
+    }
+}
