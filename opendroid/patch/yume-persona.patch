+    }
+
+    @Test
+    fun `a fetch is cancelled at once when the outing ends`() = runBlocking {
+        serve { request ->
+            if (request.target == "/slow") html("<p>slow</p>").newBuilder().headersDelay(10, TimeUnit.SECONDS).build() else html("<p>x</p>")
