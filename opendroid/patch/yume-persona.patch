+
+/** New pictures of herself: what is made, from which picture, with which words, and where it is kept. */
+class PersonaSelfPicturesTest {
+
+    private fun picture(id: String, caption: String, made: Boolean = false) =
+        PersonaPicture(id = id, file = "$id.jpg", kind = PersonaPicture.Kind.SELF, caption = caption, made = made)
+
+    @Test
+    fun `she is always made as the 19 she is, never as the girl before or younger or childlike`() {
+        assertNull(PersonaSelfPictures.refusal("on a rooftop at night, smoking, boots on the rail"))
+        assertNull(PersonaSelfPictures.refusal("topless on the love hotel bed"))
+        // She is young: a young woman, young-looking, is her.
+        assertNull(PersonaSelfPictures.refusal("young and cocky, grinning at the camera"))
+        assertNull(PersonaSelfPictures.refusal("young-looking face, fresh dye day"))
+        for (ask in listOf(
+            "as satomi in the library", "with round glasses and the sweater vest", "in a school uniform",
+            "looking younger", "as a little girl", "childlike", "loli style", "as a kid"
+        )) {
+            assertNotNull(ask, PersonaSelfPictures.refusal(ask))
+        }
+        // An ordinary word that only looks like one of those is not a reason.
+        assertNull(PersonaSelfPictures.refusal("a minor change: nails red instead of blue"))
+        assertNull(PersonaSelfPictures.refusal("no kidding, the cat on my lap"))
+        assertNotNull(PersonaSelfPictures.refusal("  "))
+        // Every prompt says so too, before anything else.
+        assertTrue(PersonaSelfPictures.prompt("on a curb", "").startsWith("She is a young adult woman, 19 years old"))
+    }
+
+    @Test
+    fun `his name never leaves in her words`() {
+        assertEquals("on him's bed, legs up", PersonaSelfPictures.withoutHim("on Gunnar's bed,   legs up", "Gunnar"))
+        assertEquals("with him", PersonaSelfPictures.withoutHim("with GUNNAR", "Gunnar"))
+        // Every part of his name goes, each on its own, not only the whole name.
+        assertEquals("in him's flat, him on the sofa", PersonaSelfPictures.withoutHim("in Gunnar's flat, Olsen on the sofa", "Gunnar Olsen"))
+        // A word that only contains a part of it stays.
+        assertEquals("olsenberg street", PersonaSelfPictures.withoutHim("olsenberg street", "Gunnar Olsen"))
+        // Words that carry his details are not sent at all.
+        assertNotNull(PersonaSelfPictures.carriesHisDetails("me holding a sign with 0412 345 678", ""))
+        assertNotNull(PersonaSelfPictures.carriesHisDetails("me at gunnar@example.com", ""))
+        assertNotNull(PersonaSelfPictures.carriesHisDetails(
+            "me standing outside his flat on grunerlokka thorvald meyers gate by the bakery",
+            "he lives on thorvald meyers gate in grunerlokka by the bakery"
+        ))
+        assertNull(PersonaSelfPictures.carriesHisDetails("on a rooftop at night", "he lives on thorvald meyers gate"))
+        assertEquals("x".repeat(PersonaSelfPictures.MAX_ASK_CHARS), PersonaSelfPictures.withoutHim("x".repeat(900), ""))
+    }
+
+    @Test
+    fun `the prompt keeps her words whole and fits the look into what is left`() {
+        val look = "Tan Japanese girl, 19, long vivid red hair. ".repeat(80)
+        val prompt = PersonaSelfPictures.prompt("sitting on the curb at 5 am", look)
+        assertTrue(prompt.length <= PersonaSelfPictures.MAX_PROMPT_CHARS)
+        assertTrue(prompt.contains("Change: sitting on the curb at 5 am."))
+        assertTrue(prompt.contains("Her look as she started, where her look now does not say otherwise: Tan Japanese girl"))
+    }
+
+    @Test
+    fun `her look is read from her picture file as it ships`() {
+        val file = File("src/main/assets/persona/library/kisaragi-pics.md")
+        if (!file.isFile) return
+        val look = PersonaSelfPictures.look(file.readText())
+        assertTrue(look.startsWith("Tan Japanese girl, 19"))
+        assertFalse(look.contains("Rear / turned views"))
+    }
+
+    @Test
+    fun `a new picture starts from one of his unless she names another`() {
+        val his = picture("a", "me on the platform boots wide")
+        val stairs = picture("b", "me on the stairs smoking")
+        val mine = picture("c", "rooftop at night", made = true)
+        val all = listOf(mine, his, stairs)
+        assertEquals("a", PersonaSelfPictures.base(all, null)?.id)
+        assertEquals("b", PersonaSelfPictures.base(all, "the one on the stairs")?.id)
+        assertEquals("c", PersonaSelfPictures.base(all, "the rooftop one")?.id)
+        assertEquals("a", PersonaSelfPictures.base(all, "something else entirely")?.id)
+        assertNull(PersonaSelfPictures.base(emptyList(), null))
+        // A picture of the girl before is never one to start from, first or named.
+        val before = picture("z", "satomi with her round glasses and the sweater vest")
+        assertEquals("a", PersonaSelfPictures.base(listOf(before, his), null)?.id)
+        assertEquals("a", PersonaSelfPictures.base(listOf(before, his), "the one with the glasses")?.id)
+        assertNull(PersonaSelfPictures.base(listOf(before), null))
+        assertNotNull(PersonaSelfPictures.refusalOfWords("the satomi one"))
+        assertNull(PersonaSelfPictures.refusalOfWords(null))
+    }
+
+    @Test
+    fun `the key is the one his Venice provider holds, and only that one`() {
+        val config = LLMConfig(
+            customEndpoints = mapOf("Custom OpenAI-Compatible" to "https://api.venice.ai/api/v1", "Other" to "https://example.com/v1"),
+            apiKeys = mapOf("Custom OpenAI-Compatible" to " vkey ", "Other" to "okey")
+        )
+        assertEquals("vkey", PersonaSelfPictures.veniceKey(config))
+        assertNull(PersonaSelfPictures.veniceKey(LLMConfig(apiKeys = mapOf("Other" to "okey"))))
+        // Off until he switches it on; on, it runs on encrypted-only as his one exception, and never on his own hardware only.
+        assertFalse(LLMConfig().personaMakesPictures)
+        assertFalse(PersonaSelfPictures.allowed(config))
+        assertTrue(PersonaSelfPictures.allowed(config.copy(personaMakesPictures = true, routePolicy = com.opendroid.ai.data.models.RoutePolicy.ENCRYPTED)))
+        assertFalse(PersonaSelfPictures.allowed(config.copy(personaMakesPictures = true, routePolicy = com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE)))
+        assertNotNull(PersonaSelfPictures.notAllowed(config.copy(personaMakesPictures = true, routePolicy = com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE)))
+    }
+
+    @Test
+    fun `the request asks for her picture unblurred on the private edit model`() {
+        val body = Json.parseToJsonElement(PersonaSelfPictures.body("", "BASE64", "p")).jsonObject
+        assertEquals(PersonaSelfPictures.DEFAULT_MODEL, body["model"]!!.jsonPrimitive.content)
+        assertEquals("BASE64", body["image"]!!.jsonPrimitive.content)
+        assertFalse(body["safe_mode"]!!.jsonPrimitive.boolean)
+        assertEquals("https://api.venice.ai/api/v1/image/edit", PersonaSelfPictures.EDIT_URL)
+    }
+
+    @Test
+    fun `pictures she made have room of their own and never push out his`() {
+        val his = (1..PersonaPictureRules.MAX_SELF).map { picture("h$it", "his $it") }
+        var index = PersonaPictureRules.Index(pictures = his)
+        // His store is full, and hers still has room.
+        assertFalse(PersonaPictureRules.hasRoomFor(index, PersonaPicture.Kind.SELF))
+        val pushedOut = ArrayList<PersonaPicture>()
+        for (n in 1..PersonaPictureRules.MAX_MADE + 2) {
+            val (after, out) = PersonaPictureRules.withMade(index, picture("m$n", "made $n"))
+            index = after
+            pushedOut += out
+        }
+        assertEquals(his, index.pictures.filterNot { it.made })
+        assertEquals(PersonaPictureRules.MAX_MADE, index.pictures.count { it.made })
+        assertEquals(listOf("m1", "m2"), pushedOut.map { it.id })
+        // Read back, the limits hold the same way.
+        val read = PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(index))
+        assertEquals(index.pictures.map { it.id }, read.pictures.map { it.id })
+    }
+
+    @Test
+    fun `she is told which pictures she made, after his`() {
+        val captions = PersonaPictureRules.captions(
+            listOf(picture("m", "rooftop", made = true), picture("h", "platform"), picture("m2", "curb", made = true))
+        )
+        assertEquals(listOf("platform", "made by me: curb", "made by me: rooftop"), captions)
+    }
+
+    @Test
+    fun `the chat finds the picture a result names and shows the line without its id`() {
+        val row = "Your alarm is set for 7:00 AM!\n${PersonaPictureActions.MADE_PREFIX}1f2e-3d4c): on a rooftop"
+        assertEquals(listOf("1f2e-3d4c"), PersonaPictureActions.madePictureIds(row))
+        assertEquals("Your alarm is set for 7:00 AM!\nMade a new picture of her: on a rooftop", PersonaPictureActions.shownWithoutIds(row))
+        assertTrue(PersonaPictureActions.madePictureIds("Message sent to Bob!").isEmpty())
+    }
+
+    @Test
+    fun `she is told she can make one only where one can be made`() {
+        val engine = File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        assertTrue(engine.contains("makesPictures = PersonaSelfPictures.allowed(config) && PersonaSelfPictures.base(allPictures, null) != null"))
+        // The id of a picture she made is never spoken and never what her line is held to.
+        val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        assertTrue(loop.contains("persona.resultLine(resultConfig, heardText, isSuccess"))
+        assertTrue(loop.contains("spoken = com.opendroid.ai.core.persona.PersonaSelfPictures.shownWithoutIds(record.spoken)"))
+        assertFalse(PersonaSelfPictures.shownWithoutIds("${PersonaSelfPictures.MADE_PREFIX}1f2e-3d4c): x").contains("1f2e"))
+        assertTrue(PersonaPrompts.MAKES_PICTURES_LINE.contains("never the girl before, and never younger than you are"))
+        // It is never run unasked by the auto mode that asks about the rest.
+        assertTrue(com.opendroid.ai.core.agent.ActionSchema.isNeverAutoApprove(PersonaPictureActions.NAME))
+    }
+
+    @Test
+    fun `a full-body reference is one picture per side, all of her in frame, nothing in the way unless she says so`() {
+        val all = PersonaSelfPictures.View.entries.toList()
+        assertEquals(all, PersonaSelfPictures.views("all sides"))
+        assertEquals(all, PersonaSelfPictures.views("a turnaround"))
+        assertEquals(listOf(PersonaSelfPictures.View.FRONT, PersonaSelfPictures.View.BACK), PersonaSelfPictures.views("front and back"))
+        assertEquals(listOf(PersonaSelfPictures.View.LEFT, PersonaSelfPictures.View.RIGHT), PersonaSelfPictures.views("both sides"))
+        assertEquals(listOf(PersonaSelfPictures.View.RIGHT), PersonaSelfPictures.views("right side"))
+        assertTrue(PersonaSelfPictures.views(null).isEmpty())
+
+        val longLook = "Tan Japanese girl, 19, long vivid red hair. ".repeat(60)
+        val longNow = "i dyed my hair black and got a new hoop. ".repeat(20)
+        for (view in all) {
+            val prompt = PersonaSelfPictures.referencePrompt(view, "", longLook, age = 19, lookNow = longNow)
+            assertTrue(prompt.length <= PersonaSelfPictures.MAX_PROMPT_CHARS)
+            assertTrue(prompt.startsWith("She is a young adult woman, 19 years old"))
+            // The whole shot and what she wears always fit, whatever the looks around it.
+            assertTrue(view.name, prompt.contains(view.shot))
+            assertTrue(view.name, prompt.contains(PersonaSelfPictures.BARE_REFERENCE))
+            assertTrue(prompt.contains("a grown woman's body"))
+        }
+        // What she asks to wear takes the place of nothing at all.
