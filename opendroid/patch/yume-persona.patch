+                viewModel.ownTimeLines.forEach { line ->
+                    Text(text = line, fontSize = 11.sp, color = TextSecondary)
+                }
+
+                Text(
+                    text = "HER OWN LIFE",
+                    fontSize = 11.sp,
+                    fontWeight = FontWeight.Bold,
+                    fontFamily = FontFamily.Monospace,
+                    color = AccentCyan,
+                    modifier = Modifier.padding(top = 8.dp)
+                )
+                Text(text = OWN_LIFE_STATUS_HINT, fontSize = 11.sp, color = TextSecondary)
+                // Counts, times and places only: nothing she wrote, read or thought is read for these lines.
+                viewModel.ownLifeLines.forEach { line ->
+                    Text(text = line, fontSize = 11.sp, color = TextSecondary)
+                }
+                OutlinedButton(
+                    onClick = onOpenHerDay,
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text("Her day", color = TextPrimary) }
+
+                Text(
+                    text = "HER PRIVATE THOUGHTS",
+                    fontSize = 11.sp,
+                    fontWeight = FontWeight.Bold,
+                    fontFamily = FontFamily.Monospace,
+                    color = AccentCyan,
+                    modifier = Modifier.padding(top = 8.dp)
+                )
+                Text(text = THOUGHTS_HINT, fontSize = 11.sp, color = TextSecondary)
+                // How many and since when, and nothing else: none of what they say is read for this screen.
+                Text(
+                    text = viewModel.thoughtsStatus.ifEmpty { viewModel.thoughtsLine },
+                    fontSize = 11.sp,
+                    color = if (viewModel.thoughtsStatus.isEmpty()) TextSecondary else AccentCyan
+                )
+                OutlinedButton(
+                    onClick = { confirmEmptyThoughts = true },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text("Empty her private thoughts", color = AccentRed) }
+            }
+        }
+    }
+
+    if (askAboutUnsaved) {
+        AlertDialog(
+            onDismissRequest = { askAboutUnsaved = false },
+            title = { Text("Your changes are not saved") },
+            text = { Text("Save them before you leave, or leave without them?") },
+            confirmButton = {
+                TextButton(onClick = {
+                    askAboutUnsaved = false
+                    // Leaves only once the text is stored; a failed save keeps the screen and says why.
+                    viewModel.save(then = onNavigateBack)
+                }) { Text("Save") }
+            },
+            dismissButton = {
+                Row {
+                    TextButton(onClick = {
+                        askAboutUnsaved = false
+                        onNavigateBack()
+                    }) { Text("Discard") }
+                    TextButton(onClick = { askAboutUnsaved = false }) { Text("Keep editing") }
+                }
+            }
+        )
+    }
+
+    if (confirmRestore) {
+        DiscardDialog(restoreBuiltInQuestion(viewModel.usesSavedEdit), onConfirm = viewModel::restoreBundled) {
+            confirmRestore = false
+        }
+    }
+
+    if (confirmCopy) {
+        AlertDialog(
+            onDismissRequest = { confirmCopy = false },
+            title = { Text("Copy her notebook?") },
+            text = { Text(COPY_NOTEBOOK_CONFIRM) },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmCopy = false
+                    viewModel.copyNotebook { text -> copyToClipboard(context, text) }
+                }) { Text("Copy it") }
+            },
+            dismissButton = { TextButton(onClick = { confirmCopy = false }) { Text("Cancel") } }
+        )
+    }
+
+    if (confirmEmptyThoughts) {
+        AlertDialog(
+            onDismissRequest = { confirmEmptyThoughts = false },
+            title = { Text("Empty her private thoughts?") },
+            text = { Text(EMPTY_THOUGHTS_CONFIRM) },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmEmptyThoughts = false
+                    viewModel.emptyThoughts()
+                }) { Text("Empty them", color = AccentRed) }
+            },
+            dismissButton = { TextButton(onClick = { confirmEmptyThoughts = false }) { Text("Cancel") } }
+        )
+    }
+
+    if (confirmEmpty) {
+        AlertDialog(
+            onDismissRequest = { confirmEmpty = false },
+            title = { Text("Empty her notebook?") },
+            text = { Text(emptyNotebookConfirm(viewModel.archivedCount)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmEmpty = false
+                    viewModel.emptyNotebook()
+                }) { Text("Empty it", color = AccentRed) }
+            },
+            dismissButton = { TextButton(onClick = { confirmEmpty = false }) { Text("Cancel") } }
+        )
+    }
+}
