--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/BrainModelsTest.kt
@@ -0,0 +1,135 @@
+package com.opendroid.ai.core.persona
+
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.llm.providers.OpenAiCompatExtras
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The models her brain can be tried on: Venice's catalog as this build copies it, the
+ * shortlist in the research's order, the reply options that turn her thinking off where Venice
+ * lets that be said, and what a reply costs.
+ */
+class BrainModelsTest {
+
+    private fun model(id: String) = BrainModels.of(id) ?: throw AssertionError("$id is not in the catalog copy")
+
+    @Test
+    fun `the shortlist is the research's order, and every model on it is in the catalog copy`() {
+        assertEquals(
+            listOf(
+                "deepseek-v4-1-flash-1017-uncensored", "e2ee-kimi-k2-6", "xiaomi-mimo-v2-5", "venice-uncensored-role-play",
+                "kimi-k3", "e2ee-deepseek-v4-1-flash-1017-abliterated", "xiaomi-mimo-v2-6-flash"
+            ),
+            BrainModels.SHORTLIST.map { it.id }
+        )
+        // The first is the one tap's model: the same family as her encrypted brain, and it sees.
+        assertEquals(VenicePrivateTier.SEEING_BRAIN, BrainModels.SHORTLIST.first().id)
+        for (pick in BrainModels.SHORTLIST) {
+            assertNotNull(pick.id, BrainModels.of(pick.id))
+            assertTrue(pick.id, pick.note.isNotBlank())
+        }
+        assertEquals(2, BrainModels.MIN_PER_TRY)
+        assertEquals(4, BrainModels.MAX_PER_TRY)
+    }
+
+    @Test
+    fun `the catalog copy holds what Venice lists of each model`() {
+        val seeing = model(VenicePrivateTier.SEEING_BRAIN)
+        assertFalse(seeing.encrypted)
+        assertTrue(seeing.sees && seeing.uncensored && seeing.thinks)
+        assertEquals(listOf("none", "low", "high", "max"), seeing.efforts)
+        assertEquals("high", seeing.defaultEffort)
+        assertEquals(0.33, seeing.inputPerMillion, 0.0)
+        assertEquals(1.32, seeing.outputPerMillion, 0.0)
+
+        val kimi = model("e2ee-kimi-k2-6")
+        assertTrue(kimi.encrypted)
+        assertTrue(kimi.efforts.isEmpty())
+        assertEquals(8192, kimi.maxOutput)
+
+        val mimo = model("xiaomi-mimo-v2-5")
+        assertTrue(mimo.sees && mimo.hears)
+
+        val rolePlay = model("venice-uncensored-role-play")
+        assertFalse(rolePlay.thinks)
+        assertEquals(4096, rolePlay.maxOutput)
+
+        // Grok cannot be asked not to think: its lowest effort is "low".
+        assertEquals("low", model("grok-4-7").efforts.first())
+        assertEquals("max", model("kimi-k3").defaultEffort)
+        assertEquals("xhigh", model("qwen-3-8-27b").defaultEffort)
+
+        // An anonymized model is no brain of hers.
+        assertNull(BrainModels.of("gemini-4-carbon"))
+    }
+
+    @Test
+    fun `the copy agrees with the build's list of the Private tier and of the encrypted models that see`() {
+        val private = BrainModels.ALL.filterNot { it.encrypted }
+        assertEquals(VenicePrivateTier.BUILT_IN.keys, private.map { it.id }.toSet())
+        for (model in private) {
+            val caps = VenicePrivateTier.BUILT_IN.getValue(model.id)
+            assertEquals(model.id, caps.vision, model.sees)
+            assertEquals(model.id, caps.audio, model.hears)
+        }
+        for (id in VenicePrivateTier.E2EE_SEEING) {
+            val model = model(id)
+            assertTrue(id, model.encrypted && model.sees)
+        }
+        assertTrue(BrainModels.ALL.filter { it.encrypted }.all { BrainModels.encrypted(it.id) })
+    }
+
+    @Test
+    fun `her reply options turn thinking off where the catalog lists none, and say nothing where nothing can be set`() {
+        fun options(id: String) = JsonParser.parseString(BrainModels.replyOptions(id)).asJsonObject
+
+        val off = options(VenicePrivateTier.SEEING_BRAIN)
+        assertEquals("none", off.get("reasoning_effort").asString)
+        assertTrue(off.getAsJsonObject("venice_parameters").get("disable_thinking").asBoolean)
+        assertTrue(off.getAsJsonObject("venice_parameters").get("strip_thinking_response").asBoolean)
+        for (id in listOf("xiaomi-mimo-v2-5", "xiaomi-mimo-v2-6-flash", "kimi-k3", "qwen-3-8-27b")) {
+            assertEquals(id, "none", options(id).get("reasoning_effort").asString)
+        }
+
+        // Where it cannot be turned off: its lowest effort, and only the switch that strips thinking from the reply.
+        val grok = options("grok-4-7")
+        assertEquals("low", grok.get("reasoning_effort").asString)
+        assertFalse(grok.getAsJsonObject("venice_parameters").has("disable_thinking"))
+        assertEquals("low", options("glm-5-3-flash-uncensored").get("reasoning_effort").asString)
+
+        // Encrypted (no effort can be set there), a model that never thinks, one this build does not know: blank,
+        // so the app's own switches go with her reply and are dropped for a model that turns them down.
+        for (id in listOf("e2ee-kimi-k2-6", "e2ee-deepseek-v4-1-flash-1017-abliterated", "venice-uncensored-role-play", "gemma-4-uncensored", "some-new-model")) {
+            assertEquals(id, "", BrainModels.replyOptions(id))
+        }
+        // Whatever is set is a JSON object the settings field takes.
+        for (model in BrainModels.ALL) assertTrue(model.id, OpenAiCompatExtras.isValidExtraBody(BrainModels.replyOptions(model.id)))
+        // Every effort set is one Venice's reference names.
+        val named = setOf("none", "minimal", "low", "medium", "high", "xhigh", "max")
+        assertTrue(BrainModels.ALL.all { named.containsAll(it.efforts) })
+
+        assertTrue(BrainModels.thinkingLine(VenicePrivateTier.SEEING_BRAIN).startsWith("thinking off"))
+        assertTrue(BrainModels.thinkingLine("grok-4-7").startsWith("thinking cannot be turned off"))
+        assertEquals("does not think", BrainModels.thinkingLine("venice-uncensored-role-play"))
+    }
+
+    @Test
+    fun `a reply costs what the research priced it at, in cents`() {
+        // 13,000 tokens in and 200 out, none from the cache.
+        assertEquals(0.455, BrainModels.typicalUsd(VenicePrivateTier.SEEING_BRAIN)!! * 100, 0.001)
+        assertEquals(1.21, BrainModels.typicalUsd("e2ee-kimi-k2-6")!! * 100, 0.01)
+        assertEquals(0.56, BrainModels.typicalUsd("xiaomi-mimo-v2-5")!! * 100, 0.001)
+        assertEquals(0.69, BrainModels.typicalUsd("venice-uncensored-role-play")!! * 100, 0.001)
+        assertEquals(5.25, BrainModels.typicalUsd("kimi-k3")!! * 100, 0.001)
+        assertEquals(0.5175, BrainModels.typicalUsd("e2ee-deepseek-v4-1-flash-1017-abliterated")!! * 100, 0.0001)
+        assertNull(BrainModels.typicalUsd("some-new-model"))
+        assertEquals("0.46¢", BrainModels.cents(0.00455))
+        assertEquals("5.25¢", BrainModels.cents(0.0525))
+    }
+}
