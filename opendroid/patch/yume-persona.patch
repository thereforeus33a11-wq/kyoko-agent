+    /** A message of his as the talk replays it, labelled with what the app made of it. */
+    private fun ownerText(message: ChatMessage, after: List<ChatMessage>): String {
+        val text = message.text.trim()
+        return when (message.modelBadge) {
+            OWNER_SECRET_BADGE -> HANDLED_COMMAND_LABEL + SECRET_MARKER
+            OWNER_COMMAND_BADGE -> HANDLED_COMMAND_LABEL + text
+            OWNER_ANSWER_BADGE, OWNER_PICK_BADGE -> ANSWER_LABEL + text
+            // Stored before rows were marked: a message the app went on to answer was a command.
+            null -> {
+                // A row about what became of an earlier plan of hers can stand between his
+                // message and what answered it. It answers nothing: the row after it decides.
+                val next = after.firstOrNull { !PersonaActionRows.isPlanRow(it.modelBadge) }
+                // A row that keeps a command of hers stands for a reply of hers that was
+                // nothing but that command. His message was said to her, not to the app.
+                val answeredByApp = next != null && next.sender != ChatMessage.Sender.USER && !isHers(next) &&
+                    !PersonaActions.isCommandRow(next.modelBadge)
+                if (answeredByApp) HANDLED_COMMAND_LABEL + text else text
+            }
+            else -> text
+        }
+    }
