+
+    @Test
+    fun `a description the calendar sends on is shown although the schema does not list it`() {
+        val found = texts(
+            step("s1", 1, "CREATE_CALENDAR_EVENT", mapOf("title" to "Hive check", "date" to "sunday", "description" to "bring the smoker"))
+        )
+        assertEquals(
+            listOf(
