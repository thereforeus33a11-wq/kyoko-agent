+package com.opendroid.ai.core.life.reading
+
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Wikipedia's answers, read from fixtures, and the addresses asked. */
+class WikipediaTest {
+
+    @Test
+    fun `the language follows her words`() {
+        assertEquals("ja", Wikipedia.langOf("渋谷 ギャル"))
+        assertEquals("ja", Wikipedia.langOf("egg 雑誌"))
+        assertEquals("en", Wikipedia.langOf("ganguro"))
+    }
+
+    @Test
+    fun `the addresses asked`() {
+        assertEquals("https://en.wikipedia.org/w/rest.php/v1/search/page?q=egg%20magazine&limit=8", Wikipedia.searchUrl("en", "egg magazine"))
+        val article = Wikipedia.articleUrl("ja", "Egg (雑誌)").toHttpUrl()
+        assertEquals("ja.wikipedia.org", article.host)
+        assertEquals("/w/api.php", article.encodedPath)
+        assertEquals("extracts|pageimages", article.queryParameter("prop"))
+        assertEquals("1", article.queryParameter("explaintext"))
+        assertEquals("2", article.queryParameter("formatversion"))
+        assertEquals("Egg (雑誌)", article.queryParameter("titles"))
+        assertEquals("https://en.wikipedia.org/wiki/Egg_(magazine)", Wikipedia.pageUrl("en", "Egg (magazine)"))
+    }
+
+    @Test
+    fun `a search answer`() {
+        val json = """
+            {"pages":[
+              {"id":1,"key":"Egg_(magazine)","title":"Egg (magazine)","excerpt":"<span class=\"searchmatch\">Egg</span> was a Japanese &quot;gyaru&quot; magazine","description":"Japanese fashion magazine","thumbnail":{"url":"//upload.wikimedia.org/egg.jpg","width":60,"height":80}},
+              {"id":2,"key":"Egg","title":"Egg","excerpt":"An egg is","description":null,"thumbnail":null},
+              {"id":3}
+            ]}
+        """.trimIndent()
+        val hits = Wikipedia.parseSearch(json, "en")!!
+        assertEquals(2, hits.size)
+        assertEquals("Egg (magazine)", hits[0].title)
+        assertEquals("Egg was a Japanese \"gyaru\" magazine", hits[0].excerpt)
+        assertEquals("https://upload.wikimedia.org/egg.jpg", hits[0].thumbnail)
+        assertEquals("", hits[1].description)
+        assertNull(hits[1].thumbnail)
+        assertEquals("https://en.wikipedia.org/wiki/Egg_(magazine)", hits[0].url)
+        assertNull(Wikipedia.parseSearch("<html>", "en"))
+        assertEquals(emptyList<Wikipedia.Hit>(), Wikipedia.parseSearch("{\"pages\":[]}", "en"))
+    }
+
+    @Test
+    fun `an article answer, cut into parts`() {
+        val long = List(4) { "段落" + "あ".repeat(2_500) }.joinToString("\\n\\n")
+        val json = """{"batchcomplete":true,"query":{"pages":[{"pageid":5,"ns":0,"title":"Egg (雑誌)","extract":"$long","thumbnail":{"source":"https://upload.wikimedia.org/egg.jpg","width":640,"height":800}}]}}"""
+        val article = Wikipedia.parseArticle(json, "ja")!!
+        assertEquals("Egg (雑誌)", article.title)
+        assertEquals("ja.wikipedia.org", article.site)
+        assertEquals(2, article.parts.size)
+        assertTrue(article.parts.all { it.length <= Readable.PART_CHARS })
+        assertEquals("https://upload.wikimedia.org/egg.jpg", article.image)
+
+        val missing = Wikipedia.parseArticle("""{"query":{"pages":[{"ns":0,"title":"Nothing here","missing":true}]}}""", "en")!!
+        assertTrue(missing.parts.isEmpty())
+        assertNull(Wikipedia.parseArticle("{}", "en"))
+    }
+}
