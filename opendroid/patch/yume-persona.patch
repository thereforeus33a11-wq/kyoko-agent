+++ b/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWordsTest.kt
@@ -0,0 +1,112 @@
+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.persona.PersonaOwnTime
+import com.opendroid.ai.core.service.CheckInNotification
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What she, he and the record are told of her time on his screen: the go: offer in her moment,
+ * the line about her last time on it, why a go: of hers did not start, what her reply is told, and
+ * the question he is asked.
+ */
+class PhoneTimeWordsTest {
+
+    private val now = 1_800_000_000_000L
+    private val offer = PhoneTime.Offer(apps = listOf("tiktok", "youtube", "instagram"), minutesLeft = 75, free = true, asks = false)
+    private val runnable = setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS, OutingKind.Kind.SCROLL, OutingKind.Kind.WATCH, OutingKind.Kind.BROWSE)
+
+    private fun life(phone: PhoneTime.Offer?, kinds: Set<OutingKind.Kind> = runnable) =
+        PersonaOwnTime.Life(nowMillis = now, runnable = kinds, maxMinutes = 15, maxSteps = 12, cap = 150, left = 120, phone = phone)
+
+    @Test
+    fun `her moment offers his screen only where it is offered, with his apps and the look-only rule`() {
+        val line = PersonaOwnTime.goLine(life(offer))!!
+        assertTrue(line.contains("in your own space, or in one of his apps on his screen where he lends it"))
+        assertTrue(line.contains("go: scroll <app> / go: watch <app> [<what>] / go: look <app>"))
+        assertTrue(line.contains("tiktok, youtube, instagram"))
+        assertTrue(line.contains("you have no accounts of your own, so you only look"))
+        assertTrue(line.contains("no likes, follows, comments, posts, messages, shares or saves"))
+        assertTrue(line.contains("it ends the moment he touches it, and the app puts his screen back as it was"))
+        assertTrue(line.contains("75 min of phone time left today"))
+        // Not offered: the go: line is as it was, his screen not in it.
+        val without = PersonaOwnTime.goLine(life(null, setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS)))!!
+        assertTrue(without.contains("in your own space, not in his apps or on his screen"))
+        assertFalse(without.contains("scroll <app>"))
+        assertTrue(PersonaOwnTime.goReads(runnable).contains("scroll <app>, watch <app> [<what>], look <app>"))
+        // Asked first, and his phone in hand right now.
+        val busy = PersonaOwnTime.phoneLine(offer.copy(free = false))
+        assertTrue(busy.contains("he has his phone in hand or it is locked right now"))
+        assertTrue(PersonaOwnTime.phoneLine(offer.copy(asks = true)).contains("once he lets you"))
+    }
+
+    @Test
+    fun `she is told why a go on his screen did not start, and how her last time on it went`() {
+        for (why in listOf(
+            HerLog.NotStarted.NO_HANDS, HerLog.NotStarted.SCREEN_LOCKED, HerLog.NotStarted.ON_A_CALL, HerLog.NotStarted.HIS_SOUND,
+            HerLog.NotStarted.IN_HIS_HAND, HerLog.NotStarted.NO_APP, HerLog.NotStarted.PHONE_TIME_USED_UP
+        )) {
+            val line = PersonaOwnTime.goMissedLine(PersonaOwnTime.GoMissed("scroll tiktok", why.name), runnable)
+            assertTrue(line, line.startsWith("your last go: line did not start: \"scroll tiktok\"."))
+        }
+        assertTrue(
+            PersonaOwnTime.goMissedLine(PersonaOwnTime.GoMissed("scroll tiktok", HerLog.NotStarted.IN_HIS_HAND.name), runnable)
+                .contains("you borrow it only once he has not touched it for a minute")
+        )
+        val last = PersonaOwnTime.LastOuting(
+            kind = "scroll", words = "scroll tiktok", startedAt = now - 20 * 60_000, endedAt = now - 10 * 60_000, minutes = 9, steps = 6,
+            opened = 2, searches = 1, titles = listOf("nene_gal profile"), ended = HerLog.EndedBy.TAKEOVER.name, said = false,
+            app = "TikTok", scrolls = 14, refused = 1, watchedSeconds = 40
+        )
+        assertTrue(last.onHisScreen)
+        // Kept across a restart, with what she did on his screen.
+        val kept = PersonaOwnTime.decode(PersonaOwnTime.encode(PersonaOwnTime.State(lastOuting = last))).lastOuting
+        assertEquals(last, kept)
+        val line = PersonaOwnTime.lastOutingLine(last, now, thoughtsLeftOut = false)
+        assertTrue(line, line.startsWith("your last time on his screen: \"scroll tiktok\""))
+        assertTrue(line.contains("9 min in tiktok"))
+        assertTrue(line.contains("14 scrolls"))
+        assertTrue(line.contains("2 things opened (\"nene_gal profile\")"))
+        assertTrue(line.contains("1 tap not made: it was his account's"))
+        assertTrue(line.contains("it ended: he took his phone back"))
+        assertTrue(line.contains("the app put his screen back as it was"))
+        // She is told the screen went back only where it did.
+        val left = last.copy(screenBack = PhoneTime.GaveBack.How.LEFT.name)
+        assertEquals(left, PersonaOwnTime.decode(PersonaOwnTime.encode(PersonaOwnTime.State(lastOuting = left))).lastOuting)
+        val leftLine = PersonaOwnTime.lastOutingLine(left, now, thoughtsLeftOut = false)
+        assertFalse(leftLine, leftLine.contains("put his screen back"))
+        assertTrue(leftLine.contains("he was already somewhere else on his phone, so the app left his screen as he had it"))
+        val call = PersonaOwnTime.lastOutingLine(last.copy(screenBack = PhoneTime.GaveBack.How.AFTER_CALL.name), now, thoughtsLeftOut = false)
+        assertTrue(call.contains("the app gives his screen back once his call is over"))
+    }
+
+    @Test
+    fun `her reply is told she was on his phone, only looking, and that his talk ends it`() {
+        val entry = HerLog.Entry(
+            id = "1", startedAt = now - 30 * 60_000, endedAt = now - 20 * 60_000, kind = HerLog.Kind.SCROLL, where = "TikTok",
+            what = listOf("nene_gal profile"), counts = mapOf(PhoneOuting.SCROLLS to 14, HerLog.Tally.OPENED to 1), endedBy = HerLog.EndedBy.TAKEOVER
+        )
+        val lines = PersonaOwnTime.lifeReplyLines(
+            com.opendroid.ai.core.life.OwnLifeLink.ForReply(listOf(entry), doing = "on his phone in tiktok, only looking", onHisScreen = true),
+            now
+        )
+        assertTrue(lines[0], lines[0].contains("was on his phone in tiktok, only looking: 14 scrolls, opened 1 thing (\"nene_gal profile\")"))
+        assertTrue(lines[1], lines[1].contains("That ends it: the app gives him his screen back as it was."))
+        assertFalse(lines[1].contains("It waits while you two talk"))
+    }
+
+    @Test
+    fun `he is asked for his screen by the app's name, and told his touch ends it`() {
+        val text = CheckInNotification.outingAskText("Yume", HerLog.Kind.SCROLL.word, 15, 30, "TikTok")
+        assertTrue(text.startsWith("Yume wants your screen for up to 15 min: TikTok, scrolling, looking only"))
+        assertTrue(text.contains("It ends the moment you touch the phone."))
+        // He is told before his yes that her searches and views are his account's.
+        assertTrue(text.contains("Her searches and what she opens are made from your account: they show in its history and can change what it recommends to you."))
+        val reading = CheckInNotification.outingAskText("Yume", HerLog.Kind.READ.word, 15, 30)
+        assertTrue(reading.contains("in her own space and not on your phone"))
+    }
+}
