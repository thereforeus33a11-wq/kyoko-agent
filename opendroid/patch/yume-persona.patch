+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaPhrasebookTest.kt
@@ -0,0 +1,221 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.voice.WakeWordMatcher
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+class PersonaPhrasebookTest {
+
+    @Test
+    fun `every line is typed the way she types`() {
+        val banned = listOf("sorry", "thank", "please", "lol", "haha", "!")
+        for (line in PersonaPhrasebook.allLines()) {
+            assertEquals("lowercase: $line", line.lowercase(), line)
+            assertFalse("no apostrophes: $line", line.contains('\''))
+            banned.forEach { word -> assertFalse("no \"$word\": $line", line.contains(word)) }
+        }
+    }
+
+    @Test
+    fun `lines spoken before an action never claim it is finished`() {
+        val claims = listOf("done", "sent", "finished", "its on", "its off", "all set")
+        val before = PersonaPhrasebook.PRE_SPEECH.values.flatten() + PersonaPhrasebook.GENERIC_PRE
+        for (line in before) {
+            claims.forEach { claim -> assertFalse("$line claims \"$claim\"", line.contains(claim)) }
+        }
+    }
+
+    @Test
+    fun `an unknown action is named in plain words`() {
+        val line = PersonaPhrasebook(Random(1)).preSpeech("BOOK_TABLE")
+        assertTrue(line, line.endsWith("book table"))
+    }
+
+    @Test
+    fun `the same line is never used twice running`() {
+        val book = PersonaPhrasebook(Random(7))
+        var previous = book.goalDone()
+        repeat(40) {
+            val next = book.goalDone()
+            assertNotEquals(previous, next)
+            previous = next
+        }
+        var previousPre = book.preSpeech("OPEN_APP")
+        repeat(40) {
+            val next = book.preSpeech("OPEN_APP")
+            assertNotEquals(previousPre, next)
+            previousPre = next
+        }
+    }
+
+    @Test
+    fun `the wake reply can never be heard as a wake phrase`() {
+        val phrases = WakeWordMatcher.PERSONA_PHRASES + WakeWordMatcher.STOCK_PHRASES
+        for (line in PersonaPhrasebook.WAKE) {
+            assertFalse(line, WakeWordMatcher.matches(line, phrases))
+            assertTrue("short: $line", line.length <= 8)
+        }
+    }
+
+    @Test
+    fun `the wake reply can never be taken for an answer to a pending question`() {
+        // The recogniser opens while the reply is spoken and can hear the phone itself.
+        for (line in PersonaPhrasebook.WAKE) {
+            assertEquals(line, com.opendroid.ai.actions.ConfirmationReply.Unclear, com.opendroid.ai.actions.ConfirmationReply.parse(line))
+            assertEquals(
+                line,
+                com.opendroid.ai.core.voice.VoiceApprovalIntent.NONE,
+                com.opendroid.ai.core.voice.VoiceApprovalParser.parse(line)
+            )
+        }
+    }
+
+    @Test
+    fun `the contact line carries the name it was given`() {
+        assertTrue(PersonaPhrasebook(Random(3)).usingContact("Dad").contains("Dad"))
+    }
+
+    // ── The approval prompt ──────────────────────────────────────────────────────────
+
+    private val stepLines = listOf("Send SMS to Nene", "Open app", "Pay UPI to Rio Tanaka (amount 250)")
+
+    /** Every prompt the book can produce for these steps: each template, filled in. */
+    private fun everyPrompt(
+        ownIdea: Boolean,
+        count: String,
+        lines: List<String>,
+        borrowed: Boolean = false
+    ): List<String> {
+        val book = PersonaPhrasebook(Random(11))
+        val templates = when {
+            ownIdea && borrowed -> PersonaPhrasebook.APPROVAL_BORROWED
+            ownIdea -> PersonaPhrasebook.APPROVAL_OWN
+            else -> PersonaPhrasebook.APPROVAL
+        }
+        // No line is used twice running, so this many draws go through every variant.
+        val prompts = (1..templates.size * 12).map { book.approvalPrompt(count, lines, ownIdea, borrowed) }.distinct()
+        assertEquals("every variant was drawn", templates.size, prompts.size)
+        return prompts
+    }
+
+    @Test
+    fun `every approval prompt says the step count, every step line in order, and both answers`() {
+        for ((ownIdea, borrowed) in listOf(false to false, true to false, true to true)) {
+            for (prompt in everyPrompt(ownIdea, "3 steps", stepLines, borrowed)) {
+                assertTrue(prompt, prompt.contains("3 steps"))
+                var from = 0
+                for (line in stepLines) {
+                    val at = prompt.indexOf(line, from)
+                    assertTrue("\"$line\" word for word and in order in: $prompt", at >= 0)
+                    from = at + line.length
+                }
+                assertTrue(prompt, Regex("""\bapprove\b""").containsMatchIn(prompt))
+                assertTrue(prompt, Regex("""\bcancel\b""").containsMatchIn(prompt))
+                assertFalse("no placeholder left in: $prompt", prompt.contains('{'))
+            }
+        }
+    }
+
+    @Test
+    fun `a single step is counted as the app counts it`() {
+        for (prompt in everyPrompt(ownIdea = false, count = "1 step", lines = listOf("Toggle flashlight"))) {
+            assertTrue(prompt, prompt.contains("1 step"))
+            assertFalse(prompt, prompt.contains("1 steps"))
+            assertTrue(prompt, prompt.contains("Toggle flashlight"))
+        }
+    }
+
+    @Test
+    fun `a plan she started herself is announced as her idea, and only then`() {
+        val hers = listOf("my idea", "this one is mine", "i want to do this")
+        for (prompt in everyPrompt(ownIdea = true, count = "1 step", lines = listOf("Send SMS to Nene"))) {
+            assertTrue(prompt, hers.any { prompt.contains(it) })
+        }
+        for (prompt in everyPrompt(ownIdea = false, count = "1 step", lines = listOf("Send SMS to Nene"))) {
+            assertFalse(prompt, hers.any { prompt.contains(it) })
+            assertFalse(prompt, prompt.contains("mine"))
+        }
+    }
+
+    @Test
+    fun `a plan of hers whose words may be someone else's is not announced as her idea`() {
+        val vouches = listOf("my idea", "this one is mine", "i want to do this")
+        val prompts = everyPrompt(ownIdea = true, count = "1 step", lines = listOf("Make call to 5550107788"), borrowed = true)
+        for (prompt in prompts) {
+            assertFalse(prompt, vouches.any { prompt.contains(it) })
+            // It says why he is being asked: the words may have come from someone else.
+            assertTrue(prompt, listOf("somebody elses", "may not be my own", "came from outside").any { prompt.contains(it) })
+            assertTrue(prompt, prompt.contains("Make call to 5550107788"))
+        }
+        // The app's finding is only ever said about a plan she started.
+        val his = everyPrompt(ownIdea = false, count = "1 step", lines = listOf("Make call to 5550107788"), borrowed = true)
+        assertEquals(PersonaPhrasebook.APPROVAL.size, his.size)
+        for (prompt in his) assertFalse(prompt, prompt.contains("outside") || prompt.contains("somebody"))
+    }
+
+    @Test
+    fun `the prompt about someone else's words says only that, around the count and the lines`() {
+        val frameWords = setOf(
+            "say", "approve", "or", "cancel", "look", "at", "this", "one", "first", "the", "words", "in", "it", "may",
+            "be", "somebody", "elses", "i", "started", "but", "was", "shown", "things", "and", "not", "my", "own",
+            "careful", "with", "carry", "that", "came", "from", "outside"
+        )
+        for (template in PersonaPhrasebook.APPROVAL_BORROWED) {
+            val words = template.replace("{count}", " ").replace("{lines}", " ")
+                .split(Regex("""[^a-z]+""")).filter { it.isNotEmpty() }
+            for (word in words) assertTrue("\"$word\" in: $template", word in frameWords)
+            assertEquals(template, 1, Regex("""\{count\}""").findAll(template).count())
+            assertEquals(template, 1, Regex("""\{lines\}""").findAll(template).count())
+        }
+    }
+
+    @Test
+    fun `the approval prompt adds nothing of its own about what the plan does`() {
+        // Outside the count and the step lines, the words are only the frame around them.
+        val frameWords = setOf(
+            "say", "approve", "or", "cancel", "the", "plan", "is", "mm", "to", "run",
+            "my", "idea", "this", "one", "mine", "i", "want", "do"
+        )
+        for (template in PersonaPhrasebook.APPROVAL + PersonaPhrasebook.APPROVAL_OWN) {
+            val words = template.replace("{count}", " ").replace("{lines}", " ")
+                .split(Regex("""[^a-z]+""")).filter { it.isNotEmpty() }
+            for (word in words) assertTrue("\"$word\" in: $template", word in frameWords)
+            assertEquals(template, 1, Regex("""\{count\}""").findAll(template).count())
+            assertEquals(template, 1, Regex("""\{lines\}""").findAll(template).count())
+        }
+    }
+
+    @Test
+    fun `a step line is spoken as written even when it looks like a placeholder`() {
+        val prompt = PersonaPhrasebook(Random(5)).approvalPrompt("1 step", listOf("Add note {count} {lines}"), ownIdea = false)
+        assertTrue(prompt, prompt.contains("Add note {count} {lines}"))
+    }
+
+    @Test
+    fun `the line for a command of hers that came to nothing claims nothing`() {
+        val claims = listOf("done", "sent", "set", "worked", "its on", "its off")
+        for (line in PersonaPhrasebook.OWN_ACTION_FAILED) {
+            claims.forEach { claim -> assertFalse("$line claims \"$claim\"", Regex("\\b$claim\\b").containsMatchIn(line)) }
+            assertTrue(line, listOf("didnt", "nothing").any { line.contains(it) })
+        }
+        assertTrue(PersonaPhrasebook(Random(2)).ownActionFailed() in PersonaPhrasebook.OWN_ACTION_FAILED)
+    }
+
+    @Test
+    fun `the line for a plan of hers that broke off does not say that nothing happened`() {
+        // Steps may have run before it stopped.
+        val denies = listOf("nothing happened", "didnt happen", "didnt go through", "nothing ran")
+        val claims = listOf("done it", "all done", "sent", "worked")
+        for (line in PersonaPhrasebook.OWN_ACTION_STOPPED) {
+            denies.forEach { assertFalse("$line says \"$it\"", line.contains(it)) }
+            claims.forEach { assertFalse("$line claims \"$it\"", line.contains(it)) }
+            assertTrue(line, listOf("stopped", "broke off").any { line.contains(it) })
+            assertTrue(line, listOf("may have", "may be", "already happened").any { line.contains(it) })
+        }
+        assertTrue(PersonaPhrasebook(Random(2)).ownActionStopped() in PersonaPhrasebook.OWN_ACTION_STOPPED)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaPromptsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaPromptsTest.kt
