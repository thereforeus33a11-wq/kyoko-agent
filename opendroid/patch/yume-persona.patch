+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * The host of her outings, with her engine, her reading sources and his phone replaced by
+ * fakes and a clock of its own: the loop of steps, what may start and what ends it (the
+ * ledger's thresholds, her sleep, Stop, three guard refusals, his talk), and the
+ * invariants an outing keeps:
+ *
+ *  - I1: nothing reaches his chat but her one say: line, and a >> line is never run;
+ *  - I8: the log holds counts, titles and her search words, never what she thought, noted
+ *    or felt, nor page text;
+ *  - I9: nothing runs while she sleeps, and an outing ends when she lies down;
+ *  - I10: an outing starts only with 20 calls on her own left, and a step only with 10.
+ */
+class OutingHostTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val minute = 60_000L
+    private val now = AtomicLong(1_800_000_000_000L)
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    private val ledger by lazy { OwnLedger({ File(folder.root, "persona/own_ledger.json") }, { now.get() }) }
+    private val log by lazy { HerLog({ File(folder.root, "persona/her_log.json") }, { now.get() }) }
+    private val herNow = HerNow()
+    private val life by lazy {
+        OwnLife(ledger, log, herNow, Wonders({ File(folder.root, "persona") }, TestThoughtsCipher()))
+    }
+
+    @After
+    fun tearDown() {
+        scope.cancel()
+    }
+
+    // ── Fakes ────────────────────────────────────────────────────────────────────────
+
+    /** Her engine: scripted replies, read the way her engine reads them, and one counted call per step. */
+    private inner class Mind : OutingHost.Mind {
+        var config = LLMConfig(personaOwnLife = true)
+        @Volatile var on = true
+        @Volatile var asleepNow = false
+        @Volatile var gate: CompletableDeferred<Unit>? = null
+        val replies = ArrayDeque<String>()
+        val texts = CopyOnWriteArrayList<String>()
+        val backs = CopyOnWriteArrayList<OutingHost.Back>()
+        val missed = CopyOnWriteArrayList<Pair<String, HerLog.NotStarted>>()
+        val kids = CopyOnWriteArrayList<Boolean>()
+        var stepMillis = 30_000L
+        var duringStep: (Int) -> Unit = {}
+
+        override suspend fun config(): LLMConfig = config
+        override fun lifeOn(config: LLMConfig): Boolean = on
+        override fun thoughtsShown(config: LLMConfig): Boolean = true
+        override suspend fun asleep(): Boolean = asleepNow
+
+        override suspend fun step(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, look: Boolean): OutingStep.Step? {
+            texts += outing
+            kids += kid
+            duringStep(texts.size)
+            gate?.await()
+            now.addAndGet(stepMillis)
+            // Her engine runs the step under OwnCall(OUTING_STEP): the ledger counts it.
+            ledger.record(OwnPurpose.OUTING_STEP, "e2ee-her-model", 14_000, 600, ok = true)
+            val reply = synchronized(replies) { replies.removeFirstOrNull() } ?: return null
+            return OutingStep.parse(reply, sayUsed = sayUsed, kid = kid)
+        }
+
+        override suspend fun cameBack(back: OutingHost.Back, nowMillis: Long) {
+            backs += back
+        }
+
+        override suspend fun missed(words: String, why: HerLog.NotStarted) {
+            missed += words to why
+        }
+    }
+
+    /** Wikipedia, pages and feeds: what was asked of them is recorded. */
+    private class Sources : ReadingSpace.Sources {
+        val searched = CopyOnWriteArrayList<String>()
+        val fetched = CopyOnWriteArrayList<String>()
+        val followed = CopyOnWriteArrayList<String>()
+        var parts = listOf("egg was a japanese fashion magazine for gyaru. PAGE_SENTINEL_TEXT", "part two")
+
+        /** What a page by its link comes back as; refused by robots.txt unless a test sets one. */
+        @Volatile var page: HerFetcher.Fetched = HerFetcher.Fetched.Refused(HerFetcher.Why.ROBOTS)
+
+        /** A Wikipedia page's lead picture, where a test gives one. */
+        @Volatile var articleImage: String? = null
+        val images = CopyOnWriteArrayList<String>()
+        val imageBytes = CopyOnWriteArrayList<ByteArray>()
+
+        override suspend fun image(url: String): HerFetcher.Fetched {
+            images += url
+            val bytes = ByteArray(16) { 5 }
+            imageBytes += bytes
+            return HerFetcher.Fetched.Page(url, url, "image/jpeg", bytes, false)
+        }
+
+        override suspend fun search(words: String): Wikipedia.Result<List<Wikipedia.Hit>> {
+            searched += words
+            return Wikipedia.Result.Found(
+                listOf(
+                    Wikipedia.Hit("Egg (magazine)", "Japanese magazine", "a gyaru magazine", "en", null),
+                    Wikipedia.Hit("Gyaru", "Fashion subculture", "", "en", null)
+                )
+            )
+        }
+
+        override suspend fun article(title: String, lang: String): Wikipedia.Result<Wikipedia.Article> =
+            Wikipedia.Result.Found(Wikipedia.Article(title, lang, parts, articleImage))
+
+        override suspend fun fetch(url: String): HerFetcher.Fetched {
+            fetched += url
+            return page
+        }
+
+        override suspend fun feed(feed: Feeds.Feed): Feeds.Read = Feeds.Read.Items(
+            feed, listOf(Feeds.Item("Shibuya opens a new arcade", null, "NHK", null, null, ""))
+        )
+
+        override fun follow(url: String, name: String): HerFeeds.Followed {
+            followed += url
+            return HerFeeds.Followed.ADDED
+        }
+    }
+
+    private class Room : OutingHost.Room {
+        val lines = CopyOnWriteArrayList<String>()
+        val asked = CopyOnWriteArrayList<Pair<HerLog.Kind, Int>>()
+        @Volatile var askOvers = 0
+        override suspend fun said(line: String, atMillis: Long) {
+            lines += line
+        }
+
+        override suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String) {
+            asked += kind to maxMinutes
+        }
+
+        override fun askOver() {
+            askOvers++
+        }
+    }
