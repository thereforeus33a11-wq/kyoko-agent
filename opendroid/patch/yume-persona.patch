index 0000000..21fdfb4
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PictureSources.kt
@@ -0,0 +1,131 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaPicture.Origin
+import com.opendroid.ai.core.persona.PersonaPicture.Provenance
+
+/**
+ * Which of her pictures an image model may work from, and what he may change about that.
+ *
+ * Every picture of her the app holds carries its provenance ([PersonaPicture.provenance]):
+ * an [Provenance.ORIGINAL] (his own picture of her, or one that came with the app as one), a
+ * [Provenance.MASTER] (a reference he approved as a base) or a [Provenance.DERIVED] picture
+ * (anything a model made). The rule is one line: only an original or a master is ever sent to
+ * an image model to work from (the match to her own pictures, a small change, a reference
+ * sheet), never a derived one. A picture made from a made picture drifts a little each time,
+ * and after a few rounds it is no longer quite her; starting every time from the same fixed
+ * set keeps her look where her originals and masters put it.
+ *
+ * The rule is held in two places: here ([mayBeSource], [sources]) for what is picked, and in
+ * the one way a picture's bytes become something an image model is given ([SourceImage.of]),
+ * which asks the same question again of the picture as the store holds it.
+ */
+object PictureSources {
+
+    /** Whether [picture] may be sent to an image model to work from: a picture of her that is an original or a master. */
+    fun mayBeSource(picture: PersonaPicture): Boolean =
+        picture.kind == PersonaPicture.Kind.SELF &&
+            (picture.provenance == Provenance.ORIGINAL || picture.provenance == Provenance.MASTER)
+
+    /** The pictures of [pictures] that may be sent to an image model to work from, in the order they were added. */
+    fun sources(pictures: List<PersonaPicture>): List<PersonaPicture> = pictures.filter(::mayBeSource)
+
+    /**
+     * [picture] set to [to], where he may make that change, else null. What he may change:
+     *
+     * - a picture he added: an original, or derived where he says a model made it, and back;
+     * - a reference sheet: derived until he approves it, then a master, and back;
+     * - a picture that came with the app: as it came, or derived where he takes it out of the
+     *   bases, and approved again as a master;
+     * - a picture she made: always derived. It is hers and stays among her pictures, and is
+     *   never a base.
+     *
+     * Nothing else about the picture changes: the file is not touched. The change is marked as
+     * his ([PersonaPicture.provenanceByOwner]), so the app never sets it back.
+     */
+    fun changed(picture: PersonaPicture, to: Provenance): PersonaPicture? {
+        if (picture.kind != PersonaPicture.Kind.SELF || picture.made || picture.provenance == to) return null
+        val allowed = when (picture.origin) {
+            Origin.ADDED -> to == Provenance.ORIGINAL || to == Provenance.DERIVED
+            Origin.SHEET -> to == Provenance.MASTER || to == Provenance.DERIVED
+            Origin.BUNDLED -> to == Provenance.MASTER || to == Provenance.DERIVED
+            Origin.HER -> false
+        }
+        return if (allowed) picture.copy(provenance = to, provenanceByOwner = true) else null
+    }
+
+    /** The one change he can make to [picture] from where her pictures are listed, as the button says it; null for none. */
+    fun choice(picture: PersonaPicture): Choice? {
+        if (picture.kind != PersonaPicture.Kind.SELF || picture.made) return null
+        return when (picture.origin) {
+            Origin.ADDED -> if (picture.provenance == Provenance.DERIVED) {
+                Choice(IS_ORIGINAL, Provenance.ORIGINAL)
+            } else {
+                Choice(MADE_BY_A_MODEL, Provenance.DERIVED)
+            }
+            Origin.SHEET -> if (picture.provenance == Provenance.MASTER) {
+                Choice(TAKE_BACK, Provenance.DERIVED)
+            } else {
+                Choice(APPROVE, Provenance.MASTER)
+            }
+            Origin.BUNDLED -> if (picture.provenance == Provenance.DERIVED) {
+                Choice(APPROVE, Provenance.MASTER)
+            } else {
+                Choice(NOT_A_BASE, Provenance.DERIVED)
+            }
+            Origin.HER -> null
+        }
+    }
+
+    /** A change he can make, as its button says it. */
+    data class Choice(val label: String, val to: Provenance)
+
+    const val APPROVE = "Approve as master"
+    const val TAKE_BACK = "Take back approval"
+    const val MADE_BY_A_MODEL = "Made by a model"
+    const val IS_ORIGINAL = "It is an original"
+    const val NOT_A_BASE = "Not a base"
+
+    /** What [picture] is, in one short line for the list of her pictures. */
+    fun line(picture: PersonaPicture): String = when (picture.provenance) {
+        Provenance.ORIGINAL -> when (picture.origin) {
+            Origin.BUNDLED -> "Original · came with the app"
+            else -> if (picture.asGiven) "Original · kept as you gave it" else "Original · stored smaller (added before this build)"
+        }
+        Provenance.MASTER ->
+            if (picture.origin == Origin.BUNDLED && !picture.provenanceByOwner) "Master · came with the app" else "Master · approved by you"
+        Provenance.DERIVED -> when (picture.origin) {
+            Origin.HER -> "Derived · she made it"
+            Origin.SHEET -> "Derived · reference sheet, waiting for your approval"
+            Origin.ADDED -> "Derived · you marked it made by a model"
+            Origin.BUNDLED -> if (picture.provenanceByOwner) "Derived · you took it out of the bases" else RETIRED_LINE
+        }
+    }
+
+    /** What a picture that came with an earlier build is, once a newer build brought a set without it ([HerRefs.retired]). */
+    const val RETIRED_LINE = "Derived · an earlier set, replaced by a newer one that came with the app"
+
+    /** Said once where her pictures are listed. */
+    const val RULE_NOTE =
+        "Only originals and masters are ever sent to an image model as a base for a new picture of her. A picture a model made is never one, until you approve it."
+}
+
+/**
+ * A picture of her as an image model is given it to work from: one of her originals or
+ * masters, in base64. The only way to make one is [of], which asks [PictureSources.mayBeSource]
+ * of the picture, so a derived picture cannot be made into one; and the requests that send her
+ * pictures to work from ([SelfPicturePlans], [ReferenceSheets]) take nothing else.
+ */
+class SourceImage private constructor(
+    val base64: String,
+    /** The picture it is, by its id in her store. */
+    val pictureId: String,
+    val provenance: Provenance
+) {
+    override fun toString(): String = "SourceImage($pictureId, $provenance, ${base64.length} chars)"
+
+    companion object {
+        /** [base64], the bytes of [picture], as a source; null when [picture] is no original or master, or there are no bytes. */
+        fun of(picture: PersonaPicture, base64: String): SourceImage? =
+            if (PictureSources.mayBeSource(picture) && base64.isNotEmpty()) SourceImage(base64, picture.id, picture.provenance) else null
+    }
+}
