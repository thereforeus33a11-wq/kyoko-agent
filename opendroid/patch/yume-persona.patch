+    private fun serve(reply: List<String>) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                val target = request.target.orEmpty()
+                return when {
+                    target.startsWith("/v1/tee/attestation") -> {
+                        val nonce = request.url.queryParameter("nonce").orEmpty()
+                        json("""{"verified":$attestationVerified,"nonce":"${if (echoNonce) nonce else "stale"}","signing_key":"${enclave.publicKeyHex}"}""")
+                    }
