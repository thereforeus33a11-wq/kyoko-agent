+            "say: and another thing\n<< more of this\ndo: more",
+            "good enough\ndo: done"
+        )
+
+        assertEquals(OutingHost.Began.Started, started(host))
+
+        // I1: one line reached his chat, the first say: of the outing; the later one stayed a thought.
+        assertEquals(listOf("found the egg page, it's mine now"), room.lines)
+        assertEquals(3, mind.texts.size)
+        val e = entry()
+        assertEquals(HerLog.Kind.READ, e.kind)
