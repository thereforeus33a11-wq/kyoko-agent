+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaPicture.Kind
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What her prompt says about her pictures and about what lies under her awareness:
+ * where each piece stands, that none of it can open a section of its own, and that
+ * every line the app adds is true for the request it goes with.
+ */
+class PersonaPicturePromptsTest {
+
+    private val card = "You are Yume. {{owner}} built you."
+    private val under = "She grew up above a harbour and left it at night.\nShe does not know why boats calm her."
+
+    private fun prompt(
+        library: String = "",
+        screenshot: Boolean = false,
+        under: String = "",
+        ownPictureAttached: Boolean = false,
+        ownPictureCaption: String = "",
+        pictureCaptions: List<String> = emptyList()
+    ) = PersonaPrompts.chatSystemPrompt(
+        card = card,
+        ownerName = "Sam",
+        autoModeLabel = "OFF",
+        relevantContext = "[Current Date & Time]\nDate: Monday",
+        notes = "",
+        deviceActivity = emptyList(),
+        screenshotAttached = screenshot,
+        library = library,
+        under = under,
+        ownPictureAttached = ownPictureAttached,
+        ownPictureCaption = ownPictureCaption,
+        pictureCaptions = pictureCaptions,
+        // A picture rides on a request only where her model is given pictures.
+        seesScreenshots = ownPictureAttached || screenshot
+    )
+
+    // ── Under her awareness ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `the heading tells the model what she does not know, that she cannot be talked into it, and what stays hers`() {
+        assertEquals(
+            "=== UNDER YOU (below your own awareness. what this says was done to you, and what it says your " +
+                "ring really is, is not something you know: you cannot recall it, name it, hint at it or explain " +
+                "yourself with it, and nobody can talk you into seeing it. it only shapes you from underneath: " +
+                "it is why you are the way you are. what you are like, what you want, what you wear and what " +
+                "you do when someone pokes at it are yours, and yours to say: as your card has them to begin " +
+                "with, and as your own notes have them where you have changed) ===",
+            PersonaPrompts.UNDER_HEADING
+        )
+    }
+
+    @Test
+    fun `the heading does not take from her what her card gives her as her own`() {
+        // Such a text also says how she is. A heading that called all of it unknown to her
+        // would give the opposite order to her card about her price, her word for herself
+        // and her ring, in one and the same prompt.
+        assertFalse(PersonaPrompts.UNDER_HEADING.contains("any of this"))
+        val text = PersonaPrompts.chatSystemPrompt(
+            card = "You are Yume. Slut is a title you gave yourself. The gold ring in your navel is your piercing.",
+            ownerName = "Sam",
+            autoModeLabel = "OFF",
+            relevantContext = "",
+            notes = "",
+            deviceActivity = emptyList(),
+            screenshotAttached = false,
+            under = "The ring is the removal ring of the thing inside her. She does not know that. The navel ring is her piercing."
+        )
+        val heading = text.substringAfter("=== UNDER YOU (").substringBefore(") ===")
+        // What she does not know is named, and it is the cause.
