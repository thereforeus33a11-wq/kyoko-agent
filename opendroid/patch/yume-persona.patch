+            pictures = index.pictures.filter { picture ->
+                when (picture.kind) {
+                    PersonaPicture.Kind.BACKGROUND -> picture === background
+                    PersonaPicture.Kind.SELF -> selfLeft-- > 0
+                }
+            }
+        )
+    }
+
+    /** True when [kind] has room for one more. There is always room for a background picture: it takes the old one's place. */
+    fun hasRoomFor(index: Index, kind: PersonaPicture.Kind): Boolean =
+        kind == PersonaPicture.Kind.BACKGROUND || index.pictures.count { it.kind == PersonaPicture.Kind.SELF } < MAX_SELF
