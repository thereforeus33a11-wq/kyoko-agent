+    // ── The folded conversation ──────────────────────────────────────────────────────
+
+    private fun his(text: String) = com.opendroid.ai.data.models.ChatMessage("u", text, com.opendroid.ai.data.models.ChatMessage.Sender.USER)
+    private fun hers(text: String) = com.opendroid.ai.data.models.ChatMessage("a", text, com.opendroid.ai.data.models.ChatMessage.Sender.AGENT)
+
+    @Test
+    fun `the stock request keeps its labels and the newest message of his is the turn to answer`() {
+        val folded = VeniceE2eeMessages.fold("system", listOf(his("one"), hers("two"), his("three")))
+        assertEquals("system\n\n=== EARLIER IN THIS CONVERSATION (oldest first) ===\nUser: one\nYou: two", folded.system)
+        assertEquals("three", folded.user)
+
+        val only = VeniceE2eeMessages.fold("system", listOf(his("hello")))
+        assertEquals("system", only.system)
+        assertEquals("hello", only.user)
+    }
+
+    @Test
+    fun `her request is marked with marks of the app's own, and nothing is moved out of its place`() {
+        val folded = VeniceE2eeMessages.fold("card", listOf(his("one"), hers("two"), his("three")), persona = true)
+        assertEquals("card\n\n=== EARLIER IN THIS CONVERSATION (oldest first) ===\n[he] one\n[you] two", folded.system)
+        assertEquals("three", folded.user)
+        assertTrue(folded.marked)
+
+        // A line of hers stored after his newest one stays after it.
+        val trailing = VeniceE2eeMessages.fold("card", listOf(his("one"), hers("two"), his("three"), hers("four")), persona = true)
+        assertTrue(trailing.system, trailing.system.endsWith("[he] one\n[you] two\n[he] three\n[you] four"))
+        assertEquals("(continue)", trailing.user)
+        assertEquals("(continue)", VeniceE2eeMessages.fold("card", emptyList(), persona = true).user)
+
+        // With nothing said before, there is no transcript and so no mark to echo.
+        assertFalse(VeniceE2eeMessages.fold("card", listOf(his("hello")), persona = true).marked)
+        assertFalse(VeniceE2eeMessages.fold("card", emptyList(), persona = true).marked)
+        // The stock request has its own labels and its reply is never unfolded.
+        assertFalse(VeniceE2eeMessages.fold("system", listOf(his("one"), hers("two"), his("three"))).marked)
+    }
+
+    @Test
+    fun `a reply of hers loses the app's marks and what a model wrote on in his name, and nothing else`() {
+        fun unfold(reply: String) = VeniceE2eeMessages.unfoldReply(reply, marked = true)
+        assertEquals("fine. whatever", unfold("[you] fine. whatever"))
+        assertEquals("fine. whatever", unfold("  [You]fine. whatever"))
+        // The model wrote his next line and an answer to it: the transcript, not her reply.
+        assertEquals("fine", unfold("fine\n[he] are you mad\n[you] no"))
+        assertEquals("fine\nreally", unfold("[you] fine\nreally\n  [He] sure?\n[you] yes\n[he] ok"))
+        // It wrote his next line and stopped there, or ran out of length inside it: a
+        // question he never asked is not kept under her name.
+        assertEquals("fine. its done", unfold("fine. its done\n[he] and the other one?"))
+        assertEquals("fine. its done", unfold("[you] fine. its done\n\n[he] and the oth"))
+        assertEquals("fine\n>> open the map", unfold("fine\n>> open the map\n[he] wai"))
+        // It said his last line over before it answered: her reply is what follows her mark.
+        assertEquals("what", unfold("[he] hello?\n[you] what"))
+        assertEquals("obviously", unfold("[he] did you feed the bees\n[you] obviously"))
+        assertEquals("obviously", unfold("  [He] did you feed the bees\n[he] well?\n  [You]   obviously\n[he] good\n[you] mm"))
+        assertEquals("two lines\nof hers", unfold("[you] [he] hello?\n[you] two lines\nof hers"))
+        // A reply is never turned into nothing: with no line of hers in it, it is handed on as it came.
+        assertEquals("[he] hello?", unfold("[he] hello?"))
+        assertEquals("[he] hello?\n[he] anyone", unfold("[you] [he] hello?\n[he] anyone"))
+        assertEquals("[he] hello?\n[you]", unfold("[he] hello?\n[you]"))
+        assertEquals("[he] hello?\n[you]  \n[he] well", unfold("[he] hello?\n[you]  \n[he] well"))
+    }
+
+    @Test
+    fun `it is said whether a reply was ended at a line made up for him`() {
+        fun ended(reply: String, marked: Boolean = true) = VeniceE2eeMessages.unfold(reply, marked).endedAtHisMark
+        assertTrue(ended("fine\n[he] are you mad\n[you] no"))
+        assertTrue(ended("fine. its done\n[he] and the oth"))
+        assertTrue(ended("[he] hello?\n[you] what\n[he] nothing"))
+        // Only a mark taken off, or nothing done at all: the reply ends where the model ended it.
+        assertFalse(ended("[you] fine. whatever"))
+        assertFalse(ended("[he] hello?\n[you] what"))
+        assertFalse(ended("[he] hello?"))
+        assertFalse(ended("he: hello?\nme: busy"))
+        assertFalse(ended("fine\n[he] are you mad\n[you] no", marked = false))
+    }
+
+    @Test
+    fun `her own lines are never cut, also where she tells what he or somebody said`() {
+        fun unfold(reply: String) = VeniceE2eeMessages.unfoldReply(reply, marked = true)
+        for (kept in listOf(
+            // A bit told the way she texts, one beat per line.
+            "some ossan at last train. listen\nhe: where you live\nme: not your business\nhe pays the cab anyway. ukeru",
+            "me: asks one simple question\nhe: sends a voice note the length of a podcast\nanyway. what do you want",
+            "so here is how that went\nhe: i'll call you\nalso he: never calls",
+            "he: hello?\nme: busy",
+            "He: are you mad\nno. go to sleep",
+            // A line that starts with "you:" is hers too, and keeps its first word.
+            "you: three texts in a row\nme: asleep",
+            "you: late again. me: not surprised",
+            "he: where are they\nyou: at your uncles. obviously",
+            // Brackets inside a line are not the app's mark at the start of one.
+            "fine. [he] is what the app calls you",
+            "tell him [you] is me",
+            "the: what",
+            "she: said no",
+            "then he: nothing. he said nothing",
+            "ask him. he: is not an answer",
+            "your choice. you: always late"
+        )) {
+            assertEquals(kept, unfold(kept))
+        }
+        // A request that carried no marks gets its reply exactly as it came.
+        assertEquals("[you] a\n[he] b\n[you] c", VeniceE2eeMessages.unfoldReply("[you] a\n[he] b\n[you] c", marked = false))
+    }
+
+    @Test
+    fun `in a moment of her own nothing she wrote is cut off as a turn of his`() {
+        // The request of a moment of hers ends in one turn, the app's, and has no talk in
+        // front of it. Nothing is folded into a transcript, so it carries no marks.
+        val folded = VeniceE2eeMessages.fold("system text", listOf(his("(the app's own turn)")), persona = true)
+        assertFalse(folded.marked)
+        assertEquals("system text", folded.system)
+        fun unfold(reply: String) = VeniceE2eeMessages.unfold(reply, folded.marked)
+        for (written in listOf(
+            // Nobody wrote to her: a line that begins like one of his is a thought of hers, and what follows it is kept.
+            "he: asleep, probably.\nsay: you up?\nnext: 2h",
+            "bored.\nhe: never asks\n>> flashlight on",
+            "you: bored.\nhe: never asks",
+            // Where the app put no marks it looks for none: not even its own brackets end what she wrote.
+            "[he] is what the app calls him.\nsay: you up?\nnext: 2h"
+        )) {
+            assertEquals(written, unfold(written).text)
+            assertFalse(written, unfold(written).endedAtHisMark)
+        }
+    }
+
+    @Test
+    fun `reading a reply stops at the end marker and keeps the reason it ended`() {
+        val keys = VeniceE2ee.generateKeyPair()
+        fun piece(text: String) = "{\"choices\":[{\"delta\":{\"content\":\"${VeniceE2ee.encrypt(text, keys.publicKeyHex)}\"}}]}"
+        val stream = buildString {
+            append("data: ").append(piece("mm. ")).append("\n\n")
+            append("data: ").append(piece("later")).append("\n\n")
+            append("data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n")
+            append("data: [DONE]\n\n")
+            // Whatever a relay sends after the end is not part of the reply.
+            append("data: ").append(piece(" and more")).append("\n\n")
+        }
+
+        val reply = VeniceE2eeMessages.readReply(okio.Buffer().writeUtf8(stream), keys.privateKey)
+
+        assertEquals("mm. later", reply.text)
+        assertEquals("stop", reply.finishReason)
+        // A reason that is not a short word is not carried.
+        val odd = "data: " + piece("x") + "\n\ndata: {\"choices\":[{\"delta\":{},\"finish_reason\":\"${"y".repeat(80)}\"}]}\n\n"
+        assertEquals(null, VeniceE2eeMessages.readReply(okio.Buffer().writeUtf8(odd), keys.privateKey).finishReason)
+    }
+
+    @Test
+    fun `a stream that stops without its end is not a reply, and neither is one that carries an error`() {
+        val keys = VeniceE2ee.generateKeyPair()
+        fun piece(text: String) = "{\"choices\":[{\"delta\":{\"content\":\"${VeniceE2ee.encrypt(text, keys.publicKeyHex)}\"}}]}"
+        fun read(stream: String) = VeniceE2eeMessages.readReply(okio.Buffer().writeUtf8(stream), keys.privateKey)
+        val reason = "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n"
+
+        // Broken off on the way: pieces, then nothing. The last line is half a command of hers.
+        val brokenOff = "data: ${piece("fine. doing it\n")}\n\ndata: ${piece(">> text sam i cant make it tonight beca")}\n\n"
+        assertThrows(ReplyBrokeOffException::class.java) { read(brokenOff) }
+        // The server ends the stream with an error, after some of the reply or before any.
+        val failed = "data: ${piece("fine")}\n\ndata: {\"error\":{\"message\":\"upstream failed\",\"type\":\"server_error\"}}\n\n"
+        assertThrows(ReplyBrokeOffException::class.java) { read(failed) }
+        assertThrows(ReplyBrokeOffException::class.java) { read("data: {\"error\":\"overloaded\"}\n\ndata: [DONE]\n\n") }
+        // The fixed sentence says nothing of what had arrived.
+        val message = assertThrows(ReplyBrokeOffException::class.java) { read(brokenOff) }.message.orEmpty()
+        assertFalse(message, message.contains("sam") || message.contains("fine"))
+
+        // The end marker alone, or a reason alone, is a reply that was finished.
+        assertEquals("fine", read("data: ${piece("fine")}\n\ndata: [DONE]\n\n").text)
+        assertEquals("fine", read("data: ${piece("fine")}\n\n$reason").text)
+        // So is a reply sent as one document, and an answer of that shape that is an error is not.
+        val whole = "{\"choices\":[{\"message\":{\"content\":\"${VeniceE2ee.encrypt("fine", keys.publicKeyHex)}\"}}]}"
+        assertEquals("fine", read(whole).text)
+        assertThrows(ReplyBrokeOffException::class.java) { read("{\"error\":{\"message\":\"model unavailable\"}}") }
+        // A body with nothing in it is no stream that broke off: it is an empty answer.
+        assertEquals("", read("").text)
+    }
