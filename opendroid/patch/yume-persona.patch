+    // ── The stand-in for the enclave ─────────────────────────────────────────────────
+
+    private fun enclaveStandIn() = object : Dispatcher() {
+        override fun dispatch(request: RecordedRequest): MockResponse {
+            val target = request.target.orEmpty()
+            if (target.startsWith("/api/v1/tee/attestation")) {
+                val nonce = request.url.queryParameter("nonce").orEmpty()
+                val model = request.url.queryParameter("model").orEmpty()
+                val quote = TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce))
+                return MockResponse.Builder().code(200).setHeader("Content-Type", "application/json")
+                    .body(TestEnclave.attestation(model, nonce, enclave.publicKeyHex, quote)).build()
+            }
+            if (!target.startsWith("/api/v1/chat/completions")) return MockResponse.Builder().code(404).build()
+            val wire = request.body?.utf8().orEmpty()
+            val body = JsonParser.parseString(wire).asJsonObject
+            val messages = body.getAsJsonArray("messages").map { it.asJsonObject }
+            val system = VeniceE2ee.decrypt(messages.first { it.get("role").asString == "system" }.get("content").asString, enclave.privateKey)
+            val user = VeniceE2ee.decrypt(messages.first { it.get("role").asString == "user" }.get("content").asString, enclave.privateKey)
+            val kind = when {
+                system.contains(PersonaSleepPass.SLEEP_SYSTEM_PROMPT) -> "sleep"
+                system == PersonaPrompts.reflectionSystemPrompt(shippedCard, owner) -> "notebook"
+                system.contains(PersonaOwnTime.HEADING) -> "moment"
+                else -> "chat"
+            }
+            val headers = request.headers.names().associateWith { name ->
+                if (name.equals("Authorization", ignoreCase = true)) "Bearer <his key>" else request.headers[name].orEmpty()
+            }
+            sent += Sent(kind, target, headers, wire, body, system, user)
+            val answer = synchronized(this@PersonaPromptAuditTest) {
+                when (kind) {
+                    "chat" -> chatAnswers.removeFirstOrNull() ?: "mm"
+                    "moment" -> momentAnswers.removeFirstOrNull() ?: ""
+                    else -> "NONE"
+                }
+            }
+            val clientKey = request.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty()
+            val events = listOf(
+                """{"choices":[{"delta":{"content":"${VeniceE2ee.encrypt(answer.ifEmpty { " " }, clientKey)}"}}]}""",
+                """{"choices":[{"delta":{},"finish_reason":"stop"}]}"""
+            )
+            return MockResponse.Builder().code(200).setHeader("Content-Type", "text/event-stream")
+                .body(events.joinToString("") { "data: $it\n\n" } + "data: [DONE]\n\n").build()
+        }
+    }
+
+    // ── The app's side, as the loop does it ──────────────────────────────────────────
+
+    /** How many stored rows the loop reads for her reply, as AgentLoop.kt has it. */
+    private val historyRows: Int by lazy {
+        val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        Regex("""PERSONA_HISTORY_MESSAGES = (\d+)""").find(loop)!!.groupValues[1].toInt()
+    }
+
+    private val classifier by lazy { IntentClassifier(dagger.Lazy { PersonaEngineTestSetup.factory(settings, client) }) }
+
+    /**
+     * His message stored and answered the way AgentLoop does it while she is the one who
+     * talks (processQuery, routeWhilePersonaTalks, executeSimpleQuery). Returns how the
+     * phone sorted his message; only talk is answered here.
+     */
+    private suspend fun heWrites(sessionId: String, text: String, replyAt: Long): MessageShape {
+        val config = settings.llmConfig.first()
+        assertTrue(engine.isActive(config))
+        val userMsg = ChatMessage(
+            id = UUID.randomUUID().toString(), text = text, sender = Sender.USER, timestamp = at,
+            modelBadge = PersonaPrompts.OWNER_TALK_BADGE
+        )
+        memoryManager.storeMessage(userMsg, sessionId)
+        conversations.insertMessage(sessionId, userMsg)
+        val shape = IntentClassifier.shapeWhilePersonaTalks(
+            query = text,
+            names = listOf(PersonaPrompts.BADGE),
+            multiStep = classifier.classifyComplexity(text) != com.opendroid.ai.core.agent.QueryComplexity.SIMPLE,
+            screenshotReachesHer = false
+        )
+        if (shape != MessageShape.Talk && shape != MessageShape.ScreenTalk) return shape
+
+        val chatConfig = settings.llmConfig.first()
+        val provider = engine.chatProvider(chatConfig)
+        val holdsBack = chatConfig.herRouteHoldsBack()
+        val relevantContext = memoryManager.getRelevantContext(userMsg.text, lean = holdsBack)
+        val stored = conversations.getLastMessages(sessionId, historyRows)
+        val sendImages = engine.chatSeesImages(chatConfig)
+        val shaped = PersonaPrompts.shapeHistory(
+            if (sendImages) stored else stored.map { it.copy(imageBase64 = null) },
+            holdBackPrivateResults = holdsBack,
+            nowMillis = at
+        )
+        val ownPicture = engine.ownPictureFor(chatConfig, stored, userMsg.text) {
+            conversations.getLastMessages(sessionId, PersonaPictureRules.CHAT_ROWS_LOOKED_BACK)
+        }
+        val systemPrompt = engine.chatSystemPrompt(
+            config = chatConfig,
+            relevantContext = relevantContext,
+            deviceActivity = shaped.deviceActivity + listOfNotNull(
+                PersonaPrompts.plannerLine(null, false, keptOnPhone = chatConfig.plannerWordsStayOnPhone())
+            ),
+            screenshotAttached = sendImages && userMsg.imageBase64 != null,
+            cues = engine.libraryCues(shaped.dialogue),
+            ownPicture = ownPicture
+        )
+        val outcome = ReplyOutcome()
+        val request = LLMRequest(
+            systemPrompt = systemPrompt,
+            messages = PersonaPictureRules.withOwnPicture(shaped.dialogue, ownPicture),
+            temperature = PersonaEngine.CHAT_TEMPERATURE,
+            maxTokens = PersonaEngine.CHAT_MAX_TOKENS,
+            responseFormat = ResponseFormat.TEXT,
+            outcome = outcome
+        )
+        val streamed = StringBuilder()
+        provider.streamComplete(engine.withChatModel(request, chatConfig)).collect { streamed.append(it) }
+        val heard = engine.withoutThoughts(outcome.withoutReasoning ?: streamed.toString())
+        val own = PersonaActions.split(heard.text)
+        val reply = ChatMessage(
+            id = UUID.randomUUID().toString(), text = PersonaPrompts.cleanReply(own.text), sender = Sender.AGENT,
+            timestamp = replyAt, modelBadge = PersonaPrompts.replyBadge(sawScreen = false)
+        )
+        conversations.insertMessage(sessionId, reply)
+        memoryManager.storeMessage(reply, sessionId)
+        engine.onReply()?.join()
+        engine.ownTimeAfterReply(nowMillis = replyAt, sleep = heard.sleep)
+        return shape
+    }
+
+    /** A moment of her own the way AgentLoop.personaOwnTime asks for it, with nobody having written. */
+    private suspend fun ownTime(sessionId: String, nowMillis: Long): PersonaEngine.OwnMoment? {
+        at = nowMillis
