+
+    @Test
+    fun `a payment address is compared whole`() {
+        val bill = "• Messages — ELEC-BOARD: bill due. pay to elec.board@okaxis by friday (Nov 16, 3:45 PM)"
+        // Another payee at the same bank, and the same name at another bank, are not that payee.
+        assertFalse(PersonaActions.echoesOutsideText("pay 500 to water.board@okaxis", bill))
+        assertFalse(PersonaActions.echoesOutsideText("pay 500 to elec.board@oksbi", bill))
+        assertFalse(PersonaActions.echoesOutsideText("pay 500 to board@okaxis", bill))
