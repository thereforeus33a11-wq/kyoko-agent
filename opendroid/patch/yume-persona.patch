+            append(
+                when {
+                    notesAboutHimHeldBack ->
+                        "They are stored on this phone only. This reply goes through a hosted service that can read what it is sent, so what you have noted about him, and what you saw on his screen, is left out this time. Those notes are not gone: they are still on the phone and you have them again when your reply is written on a private route.\n"
+                    hostCanRead ->
+                        "They are stored on this phone only. This reply goes through a hosted service that can read what it is sent, and the notes below go to it with the rest.\n"
+                    else -> "They are stored on this phone and nowhere else.\n"
+                }
+            )
+            // A page of her files cannot be corrected, a note can: without this line a
+            // guessed detail he put right would come back with the page every time.
+            append("- Where one of your own notes and a page of your files disagree about a detail that was only guessed, your note is the newer one and it holds.\n")
+            append('\n')
+            append("=== ABOUT HIM AND THE PHONE RIGHT NOW ===\n")
+            // Text from notifications sits in here: it must not be able to open a section of its own.
+            append(relevantContext.trim().replace("===", "= = =")).append('\n')
+            append('\n')
+            append("=== YOUR OWN NOTES (you wrote these to yourself; \"i\" is you, \"he\" is him) ===\n")
+            append(notes.trim().ifEmpty { if (notesAboutHimHeldBack) "(none shown this time)" else "(none yet)" }).append('\n')
