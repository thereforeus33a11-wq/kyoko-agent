@@ -0,0 +1,52 @@
+package com.opendroid.ai.core.voice
+
+/**
+ * Decides whether a speech-recogniser transcript contains a wake phrase.
+ *
+ * The recogniser is free-form and runs in the device language, so a name it does
+ * not know comes back in several spellings. Phrases are therefore a list, matched
+ * as case-insensitive substrings, exactly as the two built-in phrases always were.
+ */
+object WakeWordMatcher {
+
+    /** What the app listened for before phrases became configurable. */
+    val STOCK_PHRASES: List<String> = listOf("opendroid", "open droid")
+
+    /**
+     * Carrier word plus the spellings an English recogniser tends to produce for "yume".
+     * The bare name is left out on purpose: "you may" and "you me" are ordinary speech.
+     */
+    val PERSONA_PHRASES: List<String> = listOf(
+        "hey yume", "hey yumi", "hey yumei", "hey yoomay", "hey you may", "hey you me",
+        "hey youme", "hey u may", "okay yume", "ok yume", "okay yumi", "ok yumi"
+    )
+
+    fun matches(transcript: String, phrases: List<String>): Boolean {
+        val heard = collapse(transcript)
+        if (heard.isEmpty()) return false
+        return phrases.any { phrase ->
+            val wanted = collapse(phrase)
+            wanted.isNotEmpty() && heard.contains(wanted)
+        }
+    }
+
+    /**
+     * The phrases to listen for: the user's own list when one is set, otherwise the
+     * persona list (when the persona is on) followed by the stock phrases.
+     */
+    fun resolve(userPhrases: String, personaEnabled: Boolean): List<String> {
+        val custom = parse(userPhrases)
+        if (custom.isNotEmpty()) return custom
+        return if (personaEnabled) PERSONA_PHRASES + STOCK_PHRASES else STOCK_PHRASES
+    }
+
+    /** Splits a comma, semicolon or newline separated setting into clean phrases. */
+    fun parse(raw: String): List<String> =
+        raw.split(',', ';', '\n')
+            .map { collapse(it) }
+            .filter { it.length >= 3 }
+            .distinct()
+
+    private fun collapse(text: String): String =
+        text.lowercase().replace(Regex("""\s+"""), " ").trim()
+}
