+     * of Shift_JIS and EUC-JP the bytes read as, and windows-1252 last.
+     */
+    fun decode(bytes: ByteArray, contentType: String = ""): String {
+        bom(bytes)?.let { (charset, skip) -> return String(bytes, skip, bytes.size - skip, charset) }
+        val declared = HEADER_CHARSET.find(contentType)?.groupValues?.get(1)
+            ?: declaredIn(bytes)
