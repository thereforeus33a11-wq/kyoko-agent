+    /**
+     * How many of a row's last lines are kept as well, whatever they open with. A step
+     * that was handed to him to finish is not told in the app's words but in the
+     * handler's own sentence ("... Review it and tap Send; sending was not verified."):
+     * it opens with none of [OUTCOME_OPENINGS], the record puts it after everything that
+     * was done, and what it says of the outcome stands at its end.
+     */
+    private const val ROW_END_LINES = 2
+
+    /**
+     * The text of one of the app's rows as a line of her prompt. A row of several lines
+     * (the record of a plan has one line for each step) is shortened line by line, so a
+     * long first result cannot push out the line that says a later step failed.
+     *
+     * A row of more lines than fit keeps the lines that say a step failed, was
+     * interrupted, never ran or waits for him, wherever they stand, and the last
+     * [ROW_END_LINES] of the others, and fills the room that is left from the top. Where
+     * lines were left out the line before them is marked as cut.
+     *
+     * The lines that tell how the row ended are given the length a row of one line has,
+     * in a short row too: a sentence about a draft that was not sent must not lose
+     * exactly those words to a long list above it.
+     */
+    private fun appText(text: String): String {
+        val lines = text.lines().map { it.trim() }.filter { it.isNotEmpty() }
+        if (lines.size <= 1) return oneLine(text)
+        val outcomes = lines.indices.filter { index -> OUTCOME_OPENINGS.any { lines[index].startsWith(it) } }
+            .take(MAX_ROW_LINES)
+        val others = lines.indices.filterNot { it in outcomes }
+        val room = MAX_ROW_LINES - outcomes.size
+        // The end of the row takes its lines first, though no more than half of the room
+        // that is left: the top says what the row is.
+        val end = others.takeLast(minOf(ROW_END_LINES, (room + 1) / 2))
+        val kept = (others.take(room - end.size) + end + outcomes).distinct().sorted()
+        val howItEnded = (end + outcomes).toSet()
