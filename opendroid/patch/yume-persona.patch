+
+    // ── Coming back ─────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `coming back brings her next moment forward, inside his least gap and the day's room`() {
+        val state = State(on = true, wake = Wake.At(now + 3 * hour), why = Why.ASKED, lastAtMillis = now - 5 * minute, moments = listOf(now - 5 * minute))
+        // A minute from now at the earliest, but never closer to her last moment than his least gap.
+        assertEquals(now - 5 * minute + 15 * minute, PersonaOwnTime.cameBackAt(state, now, bounds))
+        val long = state.copy(lastAtMillis = now - hour)
+        assertEquals(now + minute, PersonaOwnTime.cameBackAt(long, now, bounds))
+        // Only when that is sooner than the time already set.
+        assertNull(PersonaOwnTime.cameBackAt(long.copy(wake = Wake.At(now + 30_000)), now, bounds))
