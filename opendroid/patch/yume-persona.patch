+            // frame and its moment, and time on his screen ends when he writes or touches his phone.
+            val outing = if (camera != null || phone != null) "an outing to read or for the news" else "it"
+            if (life.asks) {
+                append("  his settings ask him first: he gets a notification that you want to go off (not your words), and it starts once he lets you. ")
+                append("if he says not now, or does not answer within ${OUTING_ASK_WAITS_MINUTES} minutes, it does not start, and you are told at your next moment. ")
+                append("one waits at a time: a go: while another waits does not start. once $outing starts it runs by itself, step by step. ")
