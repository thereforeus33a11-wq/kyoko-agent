+            bytes == null -> null
+            Build.VERSION.SDK_INT >= Build.VERSION_CODES.P -> decodeUpright(bytes)
+            else -> decodeAsStored(bytes)
+        }
+        decoded?.let(::scaledDown)?.let(::onWhite)
+    } catch (e: Exception) {
+        Log.w(TAG, "A picture could not be decoded: ${e.javaClass.simpleName}")
+        null
+    } catch (e: OutOfMemoryError) {
+        Log.w(TAG, "A picture was too large to decode")
+        null
+    }
+
+    /**
+     * The file behind [uri], read once while the picker's permission for it holds. Null
+     * when it cannot be opened or is larger than any photo is ([MAX_SOURCE_BYTES]).
+     */
+    private fun readSource(uri: Uri): ByteArray? =
+        context.contentResolver.openInputStream(uri)?.use { input ->
+            val bytes = ByteArrayOutputStream()
+            val buffer = ByteArray(64 * 1024)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                if (bytes.size() + read > MAX_SOURCE_BYTES) return null
+                bytes.write(buffer, 0, read)
+            }
+            bytes.toByteArray()
+        }
+
+    /**
+     * Decodes with the system's image decoder, which turns a photo the way its camera
+     * says it was held. A background picture is often a photographed page, and a page
+     * lying on its side cannot be read into text.
+     */
+    @RequiresApi(Build.VERSION_CODES.P)
+    private fun decodeUpright(bytes: ByteArray): Bitmap =
+        ImageDecoder.createSource(ByteBuffer.wrap(bytes)).decodeBitmap { info, _ ->
+            // In ordinary memory: the picture is scaled and compressed here, which a
+            // bitmap that lives on the graphics chip cannot be.
+            allocator = ImageDecoder.ALLOCATOR_SOFTWARE
+            setTargetSampleSize(PersonaPictureRules.sampleSize(info.size.width, info.size.height))
+        }
+
+    /** The decoder of older phones (Android 8). It takes the picture as it is stored and does not turn it. */
+    internal fun decodeAsStored(bytes: ByteArray): Bitmap? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        val options = BitmapFactory.Options().apply {
+            inSampleSize = PersonaPictureRules.sampleSize(bounds.outWidth, bounds.outHeight)
+        }
+        return BitmapFactory.decodeByteArray(bytes, 0, bytes.size, options)
+    }
+
+    private fun scaledDown(bitmap: Bitmap): Bitmap {
+        val (width, height) = PersonaPictureRules.scaledSize(bitmap.width, bitmap.height)
+        if (width == bitmap.width && height == bitmap.height) return bitmap
+        return replacing(bitmap, bitmap.scale(width, height))
+    }
+
+    private fun onWhite(bitmap: Bitmap): Bitmap {
+        if (!bitmap.hasAlpha()) return bitmap
+        val flat = createBitmap(bitmap.width, bitmap.height).applyCanvas {
+            drawColor(Color.WHITE)
+            drawBitmap(bitmap, 0f, 0f, null)
+        }
+        return replacing(bitmap, flat)
+    }
+
+    /** [next] in place of [previous], whose memory is given back unless the two are the same bitmap. */
+    private fun replacing(previous: Bitmap, next: Bitmap): Bitmap {
+        if (next !== previous) previous.recycle()
+        return next
+    }
+
+    private companion object {
+        const val TAG = "PersonaPictures"
+        const val PERSONA_DIRECTORY = "persona"
+        const val PICTURES_DIRECTORY = "pictures"
+        const val INDEX_FILE = "index.json"
+        const val THUMBNAIL_SIDE = 320
+
+        /** No photo a phone takes is this large; a file that is cannot be a picture to keep. */
+        const val MAX_SOURCE_BYTES = 64 * 1024 * 1024
+    }
+}
