+import javax.inject.Singleton
+
+/**
+ * How a picture meant for her reaches her: with her own eyes where her brain can see, and
+ * through the describer only where it cannot.
+ *
+ * Her brain sees ([brainSees]) when the model that writes her replies is set to take pictures,
+ * its route carries them (the encrypted exchange carries text only), Venice does not list it
+ * as blind, and the probe of it did not find it blind ([SightProbe]). Then a picture goes to
+ * her own model as it is, in her own reply, moment or step ([HerEyes.Seen.Shown]), and the
+ * describer is not used.
+ *
+ * Kid protection stays in front of every picture (§1.4): before a picture reaches her as
+ * content, the age check runs. Where her brain sees, that is her own model's first pass
+ * ([firstPass]): the picture and [Describe.AGES_ONLY], nothing else; its `ages:` line, and
+ * any other word of its answer, are read as the describer's are. A child or a teen in it, by
+ * that line or by those words, or an answer that does not say, and the picture is withheld: she gets one "kid" line ([HerEyes.Seen.Described] without words). Where her brain
+ * cannot see, the describer's own `ages:` line is the check, as before ([HerEyes]).
+ *
+ * The picture is made ready in memory ([EyesImage]: scaled down, JPEG again, its metadata
+ * gone) and kept only for the one request that carries it (I6). A look of hers is one call of
+ * hers in the ledger ([OwnPurpose.EYES]); a look he asked for ([forHim]) is his act, and his
+ * calls are never counted (I10).
+ */
+@Singleton
+class HerSight internal constructor(
+    private val eyes: HerEyes,
+    private val settings: suspend () -> LLMConfig,
+    private val complete: suspend (LLMConfig, LLMRequest) -> LLMResponse,
+    private val ledger: OwnLedger,
+    private val clock: () -> Long,
+    private val prepare: (ByteArray) -> EyesImage.Prepared = EyesImage::prepare
+) : Eyes {
+
+    @Inject
+    constructor(
+        eyes: HerEyes,
+        settings: SettingsRepository,
+        factory: Provider<LLMProviderFactory>,
+        ledger: OwnLedger
+    ) : this(
+        eyes = eyes,
+        settings = { settings.llmConfig.first() },
+        complete = { config, request ->
+            val chosen = PersonaEngine.chatProviderName(config)
+            val provider = if (chosen == null) factory.get().getActiveProvider() else factory.get().getProviderByName(chosen)
+            provider.complete(request)
+        },
+        ledger = ledger,
+        clock = System::currentTimeMillis
+    )
+
+    /** Whether a picture meant for her goes to her own model as [config] stands. */
+    fun brainSees(config: LLMConfig): Boolean = PersonaEngine.imagesReachChatModel(config)
+
+    override fun open(config: LLMConfig, nowMillis: Long): Boolean =
+        if (brainSees(config)) eyes.gate(config, nowMillis, brainSees = true) == null else eyes.open(config, nowMillis)
+
+    override fun leftToday(config: LLMConfig, nowMillis: Long): Int? = eyes.leftToday(config, nowMillis)
+
+    override fun ownEyes(config: LLMConfig): Boolean = brainSees(config)
+
+    override suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen =
+        see(image, source, OwnLedger.Start.STEP, forHim = false)
+
+    /**
+     * One picture for her: shown to her own model where her brain sees, after the age check,
+     * else described by the describer. [image] is the caller's, zeroed by the caller. With
+     * [forHim] it is a look he asked for: not counted, and her looks of the day do not limit it.
+     */
+    suspend fun see(image: ByteArray, source: Describe.Source, needs: OwnLedger.Start = OwnLedger.Start.STEP, forHim: Boolean = false): HerEyes.Seen {
+        val config = settings()
+        if (!brainSees(config)) return eyes.describe(image, source, needs, forHim)
+        eyes.gate(config, clock(), needs, brainSees = true, forHim = forHim)?.let { return HerEyes.Seen.NotSeen(it) }
+        val base64 = when (val prepared = withContext(Dispatchers.Default) { prepare(image) }) {
+            is EyesImage.Prepared.Skipped -> return HerEyes.Seen.NotSeen(HerEyes.whyOf(prepared.why))
+            is EyesImage.Prepared.Jpeg -> try {
+                Base64.getEncoder().encodeToString(prepared.bytes)
+            } finally {
+                prepared.bytes.fill(0)
+            }
+        }
+        return shownAfterCheck(config, base64, forHim)
+    }
+
+    /**
+     * A picture already made ready ([jpegBase64]) for her own model: the age check, then the
+     * picture as content, or the kid line. For his pictures in the chat and his screen, which
+     * reach her in her reply ([forHim]: his act, not counted).
+     */
+    suspend fun checked(config: LLMConfig, jpegBase64: String, forHim: Boolean): HerEyes.Seen =
+        shownAfterCheck(config, jpegBase64, forHim)
+
+    /**
+     * The age check of a picture just made of her, on her own model where her brain sees
+     * ([com.opendroid.ai.core.persona.MadePictureCheck]): [madeCheckRequest], nothing of hers
+     * or his with it. The answer comes back as the describer's would ([HerEyes.Seen.Described],
+     * its words and its `ages:` line, seen by [KidGuard.AGE_CHECK]) for the caller to judge; a
+     * failed call is [HerEyes.Seen.NotSeen]. With [counted] it is a call of hers
+     * ([OwnPurpose.PICTURE]); otherwise it is his act and not counted.
+     */
+    suspend fun checkMade(config: LLMConfig, jpegBase64: String, counted: Boolean): HerEyes.Seen {
+        val request = madeCheckRequest(config, jpegBase64)
+        val call: suspend () -> LLMResponse = { complete(config, request) }
+        return try {
+            val response = withContext(Dispatchers.IO) {
+                if (counted) withContext(OwnCall(OwnPurpose.PICTURE, ledger)) { call() } else call()
+            }
+            val answer = OpenAiCompatExtras.stripReasoning(response.content).trim()
+            if (answer.isEmpty()) {
+                HerEyes.Seen.NotSeen(HerEyes.Why.EMPTY)
+            } else {
+                HerEyes.Seen.Described(KidGuard.withoutAges(answer), KidGuard.ages(answer), seer = KidGuard.AGE_CHECK)
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: LLMException) {
+            Log.w(TAG, "The made-picture check on her own model failed: ${e.error.code}")
+            when (e.error) {
+                // Her model looked and would not say, or said nothing: a check that ran and could
+                // not tell, so the picture does not pass on the describer's word alone.
+                LLMError.ProviderRefused -> HerEyes.Seen.NotSeen(HerEyes.Why.DECLINED)
+                LLMError.MalformedResponse, LLMError.ReplyLimitReached -> HerEyes.Seen.NotSeen(HerEyes.Why.EMPTY)
+                else -> HerEyes.Seen.NotSeen(HerEyes.Why.AGE_CHECK_FAILED)
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "The made-picture check on her own model failed: ${e.javaClass.simpleName}")
+            HerEyes.Seen.NotSeen(HerEyes.Why.AGE_CHECK_FAILED)
+        }
+    }
+
+    /**
+     * The age check's answer read the way the describer's is ([KidGuard.flagOfPicture]): its
+     * `ages:` line, and every other word of it. A model that says more than the one line ("a
+     * teenage girl in a school uniform", then "ages: adult") is taken at those words, and the
+     * picture is withheld; the kid line then names the group its words named.
+     */
+    private suspend fun shownAfterCheck(config: LLMConfig, base64: String, forHim: Boolean): HerEyes.Seen =
+        when (val check = firstPass(config, base64, forHim)) {
+            is Check.Failed -> HerEyes.Seen.NotSeen(check.why)
+            is Check.Done -> {
+                val ages = check.ages
+                val flag = KidGuard.flagOfPicture(check.words, ages, clock(), KidGuard.AGE_CHECK)
+                when {
+                    flag != null -> {
+                        val seen = (ages as? KidGuard.Ages.Read)?.groups.orEmpty() +
+                            if (flag.group == KidGuard.Group.CHILD) KidGuard.Age.CHILD else KidGuard.Age.TEEN
+                        HerEyes.Seen.Described("", KidGuard.Ages.Read(seen), seer = KidGuard.AGE_CHECK)
+                    }
+                    ages is KidGuard.Ages.Read -> HerEyes.Seen.Shown(base64, ages)
+                    else -> HerEyes.Seen.Described("", ages, seer = KidGuard.AGE_CHECK)
+                }
+            }
+        }
+
+    /** What the age check came to: its `ages:` line, and the rest of its words ([words]), never shown to her. */
+    private sealed class Check {
+        class Done(val ages: KidGuard.Ages, val words: String) : Check()
+        class Failed(val why: HerEyes.Why) : Check()
+    }
+
+    /**
+     * Her own model's first pass at a picture: [ageRequest] on her route, its `ages:` line and
+     * its other words read (never shown to her). A look of hers is one call of hers ([OwnPurpose.EYES]); his is not counted.
+     */
+    private suspend fun firstPass(config: LLMConfig, base64: String, forHim: Boolean): Check {
+        val request = ageRequest(config, base64)
+        val call: suspend () -> LLMResponse = { complete(config, request) }
+        return try {
+            val response = withContext(Dispatchers.IO) {
+                if (forHim) call() else withContext(OwnCall(OwnPurpose.EYES, ledger)) { call() }
+            }
+            val answer = OpenAiCompatExtras.stripReasoning(response.content)
+            Check.Done(KidGuard.ages(answer), KidGuard.withoutAges(answer))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: LLMException) {
+            Log.w(TAG, "The age check on her own model failed: ${e.error.code}")
+            Check.Failed(if (e.status == 400 || e.status == 415 || e.status == 422) HerEyes.Why.UNSUPPORTED else HerEyes.Why.AGE_CHECK_FAILED)
+        } catch (e: Exception) {
+            Log.w(TAG, "The age check on her own model failed: ${e.javaClass.simpleName}")
+            Check.Failed(HerEyes.Why.AGE_CHECK_FAILED)
+        }
+    }
+
+    companion object {
+        private const val TAG = "HerSight"
+
+        /** Room for the one line the age check answers with, and for a model that says a little more. */
+        const val AGES_MAX_TOKENS = 60
+
+        /** Room for the two lines of the made-picture check. */
+        const val MADE_CHECK_MAX_TOKENS = 120
+
+        /**
+         * The made-picture check's request on her route: [Describe.MADE_CHECK] as the system
+         * message and one turn of [Describe.MADE_CHECK_TURN] with the picture, as [ageRequest].
+         */
+        fun madeCheckRequest(config: LLMConfig, base64: String): LLMRequest = PersonaEngine.requestOfHers(
+            LLMRequest(
+                systemPrompt = Describe.MADE_CHECK,
+                messages = listOf(
+                    ChatMessage(id = UUID.randomUUID().toString(), text = Describe.MADE_CHECK_TURN, sender = ChatMessage.Sender.USER, imageBase64 = base64)
+                ),
+                temperature = 0f,
+                maxTokens = MADE_CHECK_MAX_TOKENS,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+            ),
+            config
+        ).let { it.copy(thinkingOff = config.personaChatExtraBody.isBlank()) }
+
+        /**
+         * The age check's request on her route: [Describe.AGES_ONLY] as the system message, and
+         * one turn of [Describe.AGES_TURN] with the picture. Nothing of hers or his goes with it:
+         * no card, no notes, no name. It goes to her own model ([PersonaEngine.requestOfHers]),
+         * with her hidden thinking off where he typed no options of hers.
+         */
+        fun ageRequest(config: LLMConfig, base64: String): LLMRequest = PersonaEngine.requestOfHers(
+            LLMRequest(
+                systemPrompt = Describe.AGES_ONLY,
+                messages = listOf(
+                    ChatMessage(id = UUID.randomUUID().toString(), text = Describe.AGES_TURN, sender = ChatMessage.Sender.USER, imageBase64 = base64)
+                ),
+                temperature = 0f,
+                maxTokens = AGES_MAX_TOKENS,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+            ),
+            config
+        ).let { it.copy(thinkingOff = config.personaChatExtraBody.isBlank()) }
+    }
+}
