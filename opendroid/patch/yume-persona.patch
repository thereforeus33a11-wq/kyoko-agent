+    private fun reply(text: String) = MockResponse.Builder()
+        .code(200)
+        .setHeader("Content-Type", "application/json")
+        .body("""{"choices":[{"message":{"content":"$text"}}],"usage":{"total_tokens":7}}""")
+        .build()
