+        assertTrue(engine.pictureRefused(config()))
+
+        // A look that fails changes nothing.
+        server.enqueue(MockResponse.Builder().code(400).body("""{"error":{"message":"no image input"}}""").build())
+        assertEquals(PictureReading.Reason.CALL_FAILED, (runBlocking { engine.describeOwnPicture("aGVy") } as PictureReading.Failed).reason)
+        assertTrue(engine.pictureRefused(config()))
+
+        // A look that comes back read shows that her model takes pictures after all.
+        server.enqueue(reply("black coat. me"))
+        assertEquals(PictureReading.Read("black coat. me"), runBlocking { engine.describeOwnPicture("aGVy") })
+        assertFalse(engine.pictureRefused(config()))
+        assertNotNull(pictureFor(config(), listOf(he("morning"))))
+    }
+
+    @Test
+    fun `every failure a picture can be the reason for gets the second try`() {
+        val failures = listOf(
+            rejected(),
+            LLMException(LLMError.ModelUnavailable, custom, "her-vision-model", status = 404),
+            LLMException(LLMError.ServerError, custom, "her-vision-model", status = 500, retryable = true),
+            LLMErrorMapper.malformed(custom, "her-vision-model", transient = true),
+            LLMException(LLMError.Unknown, custom, "her-vision-model")
+        )
+        for (failure in failures) {
+            val said = runBlocking { engine.orWithoutPicture(config(), failing(failure)) { flowOf("mm") }.toList() }
+            assertEquals(failure.error.code, listOf("mm"), said)
+        }
+    }
+
+    @Test
+    fun `nothing is sent a second time when the picture cannot be why it failed`() {
+        val notThePicture = listOf(
+            // Refused on the phone: nothing was sent, and nothing must be.
+            LLMErrorMapper.privateRouteRequired(custom, "her-vision-model"),
+            LLMErrorMapper.plainHttpRefused(custom, "her-vision-model"),
+            LLMErrorMapper.authMissing(custom, "her-vision-model"),
+            LLMException(LLMError.AuthInvalid, custom, "her-vision-model", status = 401),
+            LLMException(LLMError.RateLimited, custom, "her-vision-model", status = 429, retryable = true),
+            LLMException(LLMError.QuotaExhausted, custom, "her-vision-model", status = 402),
+            LLMErrorMapper.fromThrowable(custom, "her-vision-model", java.net.SocketTimeoutException("timeout")),
+            // Not a provider's answer at all.
+            IllegalStateException("anything else")
+        )
+        for (failure in notThePicture) {
+            var secondTries = 0
+            val thrown = runCatching {
+                runBlocking {
+                    engine.orWithoutPicture(config(), failing(failure)) {
+                        secondTries++
+                        flowOf("mm")
+                    }.toList()
