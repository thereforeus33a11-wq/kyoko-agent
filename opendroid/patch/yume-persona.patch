+            override suspend fun isAvailable() = true
+        }
+        assertFalse(runBlocking { PersonaEngine.answeredWhole(whole("stop"), request) }.cutOff)
+        assertTrue(runBlocking { PersonaEngine.answeredWhole(whole("length"), request) }.cutOff)
