index 0000000..51b23fb
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsTest.kt
@@ -0,0 +1,296 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaThoughts.Thought
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+
+/**
+ * Where her thoughts are kept: one sealed file in the app's own storage, bounded, read
+ * back only as her latest thoughts, wiped whole, and never able to take the app down.
+ */
+class PersonaThoughtsTest {
+
+    private val directory: File = Files.createTempDirectory("persona-thoughts-test").toFile()
+    private val file = File(directory, "thoughts.sealed")
+    private val cipher = TestThoughtsCipher()
+
+    private fun store() = testThoughts(directory, cipher)
+
+    @After
+    fun tearDown() {
+        directory.deleteRecursively()
+    }
+
+    @Test
+    fun `a thought she keeps is there again in a new process, oldest first`() = runBlocking {
+        val first = store()
+        first.keep("the neon is on again", atMillis = 1_000)
+        first.keep("  he keeps bees. why bees\nand why do i like it  ", atMillis = 2_000)
+
+        // A store that has read nothing yet: what it knows is what the file holds.
+        val later = store()
+        assertEquals(
+            listOf(Thought(1_000, "the neon is on again"), Thought(2_000, "he keeps bees. why bees\nand why do i like it")),
+            later.latest()
+        )
+        assertEquals(PersonaThoughts.Summary(2, 1_000), later.summary())
+    }
+
+    @Test
+    fun `the file holds nothing that can be read without the key`() = runBlocking {
+        store().keep("he keeps bees and i will not say that i like it", atMillis = 1_000)
+
+        val onDisk = file.readText()
+        assertTrue(onDisk.startsWith("v1."))
+        for (word in listOf("bees", "keeps", "like")) assertFalse(word, onDisk.contains(word))
+        // Nothing else is written beside it, not even the draft it was written through.
+        assertEquals(listOf("thoughts.sealed"), directory.list()!!.toList())
+        // Another key does not open it: the store reads as empty, and the next thought takes the file's place.
+        val other = testThoughts(directory, TestThoughtsCipher(keyByte = 99))
+        assertEquals(emptyList<Thought>(), other.latest())
+        other.keep("a new start", atMillis = 5_000)
+        assertEquals(listOf(Thought(5_000, "a new start")), testThoughts(directory, TestThoughtsCipher(keyByte = 99)).latest())
+    }
+
+    @Test
+    fun `what is no thought is not kept`() = runBlocking {
+        val thoughts = store()
+        for (nothing in listOf("", "   ", ".", "...", "\n", "-")) thoughts.keep(nothing, atMillis = 1_000)
+        assertEquals(PersonaThoughts.Summary(0, null), thoughts.summary())
+        assertFalse(file.exists())
+    }
+
+    @Test
+    fun `the store keeps her latest thoughts up to its bound, and the oldest fall away`() = runBlocking {
+        val thoughts = store()
+        val long = "x".repeat(10_000)
+        for (i in 1..8) thoughts.keep("$i $long", atMillis = i * 1_000L)
+
+        val kept = store().latest(maxChars = Int.MAX_VALUE)
+        // 60,000 characters hold five thoughts of a little over ten thousand each.
+        assertEquals(listOf(4_000L, 5_000L, 6_000L, 7_000L, 8_000L), kept.map { it.atMillis })
+        assertTrue(kept.sumOf { it.text.length } <= PersonaThoughts.MAX_CHARS)
+        assertEquals(60_000, PersonaThoughts.MAX_CHARS)
+        // The newest always stays, even one that is bigger than the bound by itself.
+        thoughts.keep("big " + "y".repeat(PersonaThoughts.MAX_CHARS), atMillis = 9_000)
+        assertEquals(listOf(9_000L), store().latest(maxChars = Int.MAX_VALUE).map { it.atMillis })
+    }
+
+    @Test
+    fun `her prompt gets the newest thoughts that fit its room, whole, and always the newest one`() = runBlocking {
+        val thoughts = store()
+        thoughts.keep("a".repeat(1_500), atMillis = 1_000)
+        thoughts.keep("b".repeat(1_500), atMillis = 2_000)
+        thoughts.keep("c".repeat(1_400), atMillis = 3_000)
+
+        // 3,000 characters: the two newest fit, the third does not, and none is cut to make it fit.
+        assertEquals(listOf(2_000L, 3_000L), thoughts.latest().map { it.atMillis })
+        assertEquals(3_000, PersonaThoughts.PROMPT_BUDGET_CHARS)
+        assertEquals("b".repeat(1_500), thoughts.latest().first().text)
+        // One that is longer than the room by itself is shortened and marked as shortened.
+        thoughts.keep("d".repeat(5_000), atMillis = 4_000)
+        val only = thoughts.latest().single()
+        assertEquals(4_000L, only.atMillis)
+        assertEquals("d".repeat(3_000) + PersonaPrompts.CUT_MARK, only.text)
+        // The whole of it is still kept.
+        assertEquals(5_000, thoughts.latest(maxChars = Int.MAX_VALUE).last().text.length)
+    }
+
+    @Test
+    fun `wiping deletes every thought and the file, and says how many there were`() = runBlocking {
+        val thoughts = store()
+        thoughts.keep("one", atMillis = 1_000)
+        thoughts.keep("two", atMillis = 2_000)
+
+        assertEquals(2, thoughts.wipe())
+
+        assertFalse(file.exists())
+        assertEquals(PersonaThoughts.Summary(0, null), thoughts.summary())
+        assertEquals(PersonaThoughts.Summary(0, null), store().summary())
+        // Wiping an empty store is nothing.
+        assertEquals(0, thoughts.wipe())
+        // She can think again afterwards.
+        thoughts.keep("three", atMillis = 3_000)
+        assertEquals(listOf(Thought(3_000, "three")), store().latest())
+    }
+
+    @Test
+    fun `a file that cannot be read costs her the thoughts in it and never crashes`() = runBlocking {
+        store().keep("something from before", atMillis = 1_000)
+
+        for (damage in listOf("not a sealed file at all", "", "v1.AAAA.BBBB", file.readText().dropLast(6) + "AAAAAA")) {
+            file.writeText(damage)
+            val thoughts = store()
+            assertEquals(damage, emptyList<Thought>(), thoughts.latest())
+            assertEquals(PersonaThoughts.Summary(0, null), thoughts.summary())
+        }
+        // The next thought starts a good file. The damaged one is moved aside and not written over:
+        // the app cannot tell a file that is broken for good from one it could not open this once.
+        val thoughts = store()
+        thoughts.keep("after the damage", atMillis = 2_000)
+        assertEquals(listOf(Thought(2_000, "after the damage")), store().latest())
+        assertEquals(1, directory.list()!!.count { it.startsWith("thoughts.sealed.unread-") })
+        // A damaged file can be wiped as well, without having been read, and so is the one moved aside.
+        file.writeText("not a sealed file at all")
+        assertEquals(0, store().wipe())
+        assertFalse(file.exists())
+        assertEquals(emptyList<String>(), directory.list()!!.toList())
+    }
+
+    @Test
+    fun `a Keystore that does not answer once costs her nothing`() = runBlocking {
+        store().keep("the neon is on again", atMillis = 1_000)
+        store().keep("he keeps bees. why bees", atMillis = 2_000)
+        val before = listOf(Thought(1_000, "the neon is on again"), Thought(2_000, "he keeps bees. why bees"))
+
+        // It fails while her prompt is built: she gets none this time, and "none" is not what is remembered.
+        val thoughts = store()
+        cipher.failingReads = 1
+        assertEquals(emptyList<Thought>(), thoughts.latest())
+        assertEquals(before, thoughts.latest())
+
+        // It fails for the read a kept thought starts with, while sealing still works: the file
+        // that could not be read is moved aside, never written over, and the new thought has a file.
+        val later = store()
+        cipher.noReads = true
+        later.keep("and i like that he does", atMillis = 3_000)
+        assertEquals(listOf(Thought(3_000, "and i like that he does")), later.latest())
+        val aside = directory.list()!!.filter { it.startsWith("thoughts.sealed.unread-") }
+        assertEquals(1, aside.size)
+        assertTrue(file.isFile)
+
+        // It answers again: with the next thought she keeps, everything from before is hers again, in order.
+        cipher.noReads = false
+        later.keep("the rain has stopped", atMillis = 4_000)
+        val all = before + Thought(3_000, "and i like that he does") + Thought(4_000, "the rain has stopped")
+        assertEquals(all, later.latest(maxChars = Int.MAX_VALUE))
+        assertEquals(listOf("thoughts.sealed"), directory.list()!!.toList())
+        // And in a new process as well.
+        assertEquals(all, store().latest(maxChars = Int.MAX_VALUE))
+        assertEquals(PersonaThoughts.Summary(4, 1_000), store().summary())
+    }
+
+    @Test
+    fun `thoughts that were moved aside unread come back when the app is next started, without a new thought`() = runBlocking {
+        store().keep("from before", atMillis = 1_000)
+        cipher.noReads = true
+        store().keep("kept while nothing could be read", atMillis = 2_000)
+        cipher.noReads = false
+
+        val thoughts = store()
+        assertEquals(
+            listOf(Thought(1_000, "from before"), Thought(2_000, "kept while nothing could be read")),
+            thoughts.latest()
+        )
+        assertEquals(listOf("thoughts.sealed"), directory.list()!!.toList())
+        // Merged once: nothing is doubled by reading again.
+        assertEquals(2, store().summary().count)
+    }
+
+    @Test
+    fun `a file that never opens again stays aside and unread, a few of them at most, and emptying her thoughts takes them along`() = runBlocking {
+        // Each of these files is sealed with a key that is gone by the time the next thought is kept.
+        for (generation in 1..5) {
+            testThoughts(directory, TestThoughtsCipher(keyByte = generation)).keep("thought number $generation", atMillis = generation * 1_000L)
+        }
+
+        val aside = directory.list()!!.filter { it.startsWith("thoughts.sealed.unread-") }
+        // The newest three that could not be read are kept in case they open again; older ones are let go.
+        assertEquals(3, aside.size)
+        val newest = testThoughts(directory, TestThoughtsCipher(keyByte = 5))
+        assertEquals(listOf(Thought(5_000, "thought number 5")), newest.latest())
+        // Reading does not touch them, and a thought kept beside them does not either.
+        newest.keep("another", atMillis = 6_000)
+        assertEquals(aside.toSet(), directory.list()!!.filter { it.startsWith("thoughts.sealed.unread-") }.toSet())
+
+        // He empties her thoughts: the files nobody could read are deleted with the rest.
+        assertEquals(2, newest.wipe())
+        assertEquals(emptyList<String>(), directory.list()!!.toList())
+    }
+
+    @Test
+    fun `with the key gone nothing is read and nothing crashes, and a thought is still hers until the app closes`() = runBlocking {
+        store().keep("from before the key was lost", atMillis = 1_000)
+        cipher.lost = true
+
+        val thoughts = store()
+        assertEquals(emptyList<Thought>(), thoughts.latest())
+        // It cannot be written, and it is not thrown away either.
+        val sealedBefore = file.readText()
+        thoughts.keep("thought without a key", atMillis = 2_000)
+        assertEquals(listOf(Thought(2_000, "thought without a key")), thoughts.latest())
+        assertNull(store().summary().oldestAtMillis)
+        // Nothing could be sealed, so nothing on the disk was touched: the file is neither written over nor moved.
+        assertEquals(sealedBefore, file.readText())
+        assertEquals(listOf("thoughts.sealed"), directory.list()!!.toList())
+        // When the key answers again, what she kept meanwhile goes into the file with her next thought, after what was there.
+        cipher.lost = false
+        thoughts.keep("and one more", atMillis = 3_000)
+        assertEquals(
+            listOf(
+                Thought(1_000, "from before the key was lost"), Thought(2_000, "thought without a key"), Thought(3_000, "and one more")
+            ),
+            store().latest()
+        )
+    }
+
+    @Test
+    fun `the store works in a directory that is not there yet`() = runBlocking {
+        val fresh = File(directory, "persona")
+        val thoughts = testThoughts(fresh, cipher)
+        assertEquals(emptyList<Thought>(), thoughts.latest())
+        thoughts.keep("first", atMillis = 1_000)
+        assertTrue(File(fresh, "thoughts.sealed").isFile)
+    }
+
+    // ── What the store is, read off its source ───────────────────────────────────────
+
+    private val source = File("src/main/java/com/opendroid/ai/core/persona/PersonaThoughts.kt").readText()
+
+    @Test
+    fun `it is sealed with a key in the phone's Keystore and lies in the app's own files, which no backup includes`() {
+        assertTrue(source.contains("AndroidKeyStoreAeadCipher(KEY_ALIAS)"))
+        assertTrue(source.contains("{ File(context.filesDir, DIRECTORY) }"))
+        for (elsewhere in listOf("getExternalFilesDir", "externalCacheDir", "cacheDir", "Environment.", "SharedPreferences", "MediaStore")) {
+            assertFalse(elsewhere, source.contains(elsewhere))
+        }
+        val excluded = """<exclude domain="file" path="."/>"""
+        assertTrue(File("src/main/res/xml/backup_rules.xml").readText().contains(excluded))
+        assertTrue(File("src/main/res/xml/data_extraction_rules.xml").readText().contains(excluded))
+    }
+
+    @Test
+    fun `all file work is off the main thread and under one lock, and a write is moved into place whole`() {
+        val store = source.substringAfter("class PersonaThoughts internal constructor(").substringBefore("companion object {")
+        // One door for every piece of work.
+        assertTrue(store.contains("private suspend fun <T> work(block: () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }"))
+        for (entry in listOf("suspend fun keep(", "suspend fun latest(", "suspend fun summary(", "suspend fun wipe(")) {
+            val body = store.substringAfter(entry).substringBefore("\n    }\n")
+            assertTrue(entry, body.contains("work {"))
+        }
+        // The file is touched only by the two functions that are called inside it.
+        assertEquals(1, Regex("""\.readText\(\)""").findAll(store).count())
+        assertEquals(1, Regex("""FileOutputStream\(""").findAll(store).count())
+        val write = store.substringAfter("private fun write(").substringBefore("@Serializable")
+        assertTrue(write.indexOf("out.fd.sync()") in 0 until write.indexOf("draft.renameTo(target)"))
+    }
+
+    @Test
+    fun `no log line of the store carries anything of a thought`() {
+        val logs = source.lines().filter { it.contains("Log.") }
+        assertTrue(logs.isNotEmpty())
+        for (line in logs) {
+            assertTrue(line, line.contains("\${e.javaClass.simpleName}\")"))
+            for (value in listOf("thought.", "text", "plain", "it.", "all", "message")) {
+                assertFalse("$value in: $line", line.substringAfter("Log.").contains("\$$value") || line.contains("\${$value"))
+            }
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsWallTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsWallTest.kt
