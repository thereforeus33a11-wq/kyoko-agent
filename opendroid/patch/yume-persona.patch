+    /** The store of a build that ships [thisBuild] and the earlier wordings of its starting notes. */
+    private fun storeWithEarlierWordings() = PersonaStore(context) { path ->
+        when {
+            path.endsWith("card.md") -> "You are Yume.\n"
+            path.endsWith("seed_notes.txt") -> thisBuild.joinToString("\n") { it.toLine() }
+            path.endsWith("seed_notes.previous.txt") -> "# earlier wordings\n${oldVoice.toLine()}\n${oldBoots.toLine()}"
+            else -> ""
+        }
+    }
