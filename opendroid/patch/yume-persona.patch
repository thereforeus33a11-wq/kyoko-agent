@@ -0,0 +1,57 @@
+package com.opendroid.ai.core.service
+
+import android.app.Notification
+import android.content.Context
+import androidx.core.app.NotificationCompat
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * A notification's text is handed to the lock screen and to every app with notification
+ * access. Unless the owner asked for her words there, none of them may be in it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class CheckInNotificationTest {
+
+    private val context: Context = ApplicationProvider.getApplicationContext()
+    private val line = "the bees swarmed again. you said you would move the hive"
+
+    private val name = "Yume"
+
+    private fun build(showText: Boolean) =
+        CheckInNotification.build(context, "persona_checkin_channel", name, line, showText, open = null)
+
+    @Test
+    fun `by default it only says that she wrote`() {
+        val notification = build(showText = false)
+
+        assertEquals("Yume wrote to you", notification.extras.getCharSequence(Notification.EXTRA_TITLE).toString())
+        assertNull(notification.extras.getCharSequence(Notification.EXTRA_TEXT))
+        assertNull(notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT))
+        assertNull(notification.tickerText)
+        assertNull(notification.publicVersion)
+        assertEquals(NotificationCompat.VISIBILITY_PRIVATE, notification.visibility)
+        // No field of any kind carries a word of her line.
+        for (key in notification.extras.keySet()) {
+            @Suppress("DEPRECATION")
+            val value = notification.extras.get(key)?.toString().orEmpty()
+            assertFalse("$key carries her line", value.contains("bees") || value.contains("hive"))
+        }
+    }
+
+    @Test
+    fun `her words are shown when the owner switched that on`() {
+        val notification = build(showText = true)
+
+        assertEquals(name, notification.extras.getCharSequence(Notification.EXTRA_TITLE).toString())
+        assertEquals(line, notification.extras.getCharSequence(Notification.EXTRA_TEXT).toString())
+        assertEquals(line, notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT).toString())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/service/CheckInWorkerTest.kt b/app/src/test/java/com/opendroid/ai/core/service/CheckInWorkerTest.kt
new file mode 100644
index 0000000..ef19b31
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/service/CheckInWorkerTest.kt
@@ -0,0 +1,85 @@
+package com.opendroid.ai.core.service
+
+import com.opendroid.ai.core.agent.waitWithoutCancelling
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Whether it is the moment for an unprompted line is looked at by scheduled work, which
+ * the system wakes while the phone sleeps, and only while her lines are switched on.
+ */
+class CheckInWorkerTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    @Test
+    fun `the check for an unprompted line is scheduled work, not a delay that stands still while the phone sleeps`() {
+        val service = File(main, "core/service/OpenDroidService.kt").readText()
+        assertFalse(service.contains("delay("))
+        assertFalse(service.contains("personaCheckIn("))
+        assertTrue(service.contains("applyCheckInSchedule(CheckInWorker.isWanted(personaActive, config.personaCheckInsEnabled))"))
+
+        assertTrue(CheckInWorker.isWanted(personaActive = true, checkInsEnabled = true))
+        assertFalse(CheckInWorker.isWanted(personaActive = true, checkInsEnabled = false))
+        assertFalse(CheckInWorker.isWanted(personaActive = false, checkInsEnabled = true))
+
+        val worker = File(main, "core/service/CheckInWorker.kt").readText()
+        assertTrue(worker.contains("PeriodicWorkRequestBuilder<CheckInWorker>("))
+        assertTrue(worker.contains("entryPoint.agentLoop().personaCheckIn(applicationContext)"))
+        // The notification follows the owner's choice about showing her words.
+        assertTrue(worker.contains("OpenDroidService.showCheckInNotification(applicationContext, line, showText)"))
+        assertTrue(worker.contains("llmConfig.first().checkInShowsText"))
+        // The worker stays outside her package, like every caller but the loop and the service.
+        assertFalse(worker.contains("core.persona."))
+    }
+
+    @Test
+    fun `the work stays until a command her line ended in has run, and never stops it`() {
+        val worker = File(main, "core/service/CheckInWorker.kt").readText()
+        // After the line is shown, and only when there was a line.
+        val shown = worker.indexOf("OpenDroidService.showCheckInNotification(applicationContext, line, showText)")
+        val waits = worker.indexOf("entryPoint.agentLoop().awaitCheckInAction(ACTION_WAIT_MILLIS)")
+        assertTrue(shown >= 0)
+        assertTrue(waits > shown)
+        assertTrue(waits < worker.indexOf("Result.success()"))
+        // Inside the time the system allows scheduled work.
+        assertTrue(CheckInWorker.ACTION_WAIT_MILLIS in 60_000L..9 * 60_000L)
+
+        val loop = File(main, "core/agent/AgentLoop.kt").readText()
+        val action = loop.substringAfter("private fun startCheckInAction(").substringBefore("private suspend fun runPersonaAction(")
+        assertTrue(action.contains("checkInAction = job"))
+        val await = loop.substringAfter("suspend fun awaitCheckInAction(").substringBefore("private fun startCheckInAction(")
+        assertTrue(await.contains("waitWithoutCancelling(checkInAction, timeoutMillis)"))
+        assertFalse(await.contains(".cancel()"))
+    }
+
+    @Test
+    fun `waiting for a job ends with the job or with the time, and leaves the job running`() = runBlocking {
+        assertTrue(waitWithoutCancelling(null, timeoutMillis = 5_000))
+
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        try {
+            val quick = scope.launch { delay(20) }
+            assertTrue(waitWithoutCancelling(quick, timeoutMillis = 5_000))
+            assertTrue(quick.isCompleted)
+
+            // A command that waits for his answer does not end by itself.
+            val endless = scope.launch { awaitCancellation() }
+            assertFalse(waitWithoutCancelling(endless, timeoutMillis = 50))
+            assertTrue(endless.isActive)
+            assertFalse(endless.isCancelled)
+        } finally {
+            scope.cancel()
+        }
+    }
+}
