@@ -0,0 +1,110 @@
+package com.opendroid.ai.core.service
+
+import android.content.Context
+import android.util.Log
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.opendroid.ai.core.agent.AgentLoop
+import com.opendroid.ai.data.repository.SettingsRepository
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import java.util.concurrent.TimeUnit
+
+/**
+ * Looks, now and then, whether it is the moment for an unprompted line, and shows the
+ * line as a notification when one was written.
+ *
+ * It is scheduled work and not a loop inside the service. A delay inside a running
+ * process is counted on a clock that stands still while the phone sleeps, so after hours
+ * on a table the check came due only when the phone was picked up. Scheduled work is
+ * woken by the system, in its maintenance windows while the phone dozes, and survives
+ * the process being put away.
+ *
+ * Whether it is the moment is decided where it always was: the loop asks the rule and
+ * the settings, and returns nothing when her lines are switched off.
+ */
+class CheckInWorker(
+    appContext: Context,
+    workerParams: WorkerParameters
+) : CoroutineWorker(appContext, workerParams) {
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface CheckInWorkerEntryPoint {
+        fun agentLoop(): AgentLoop
+        fun settingsRepository(): SettingsRepository
+    }
+
+    override suspend fun doWork(): Result {
+        val entryPoint = EntryPointAccessors.fromApplication(applicationContext, CheckInWorkerEntryPoint::class.java)
+        return try {
+            // Off the main thread: the check reads the profile store and builds a prompt.
+            val line = withContext(Dispatchers.Default) {
+                entryPoint.agentLoop().personaCheckIn(applicationContext)
+            }
+            if (line != null) {
+                val showText = entryPoint.settingsRepository().llmConfig.first().checkInShowsText
+                OpenDroidService.showCheckInNotification(applicationContext, line, showText)
+                // A command the line ended in is started after the line is stored and runs
+                // by itself. This work is what keeps a dozing phone awake, so it stays
+                // until the command has run its course, a few minutes at most. It only
+                // waits: a command that takes longer is left running.
+                entryPoint.agentLoop().awaitCheckInAction(ACTION_WAIT_MILLIS)
+            }
+            Result.success()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Check-in skipped: ${e.javaClass.simpleName}")
+            // The next period looks again; a failed attempt has its own short wait.
+            Result.success()
+        }
+    }
+
+    companion object {
+        private const val TAG = "CheckInWorker"
+        const val WORK_NAME = "opendroid_persona_check_in"
+
+        /** How often the check runs. The shortest period the system offers for repeating work. */
+        const val PERIOD_MINUTES = 15L
+
+        /**
+         * How long the work stays for a command her line ended in. Well inside the ten
+         * minutes the system gives scheduled work, and far more than a planner call and a
+         * few steps take.
+         */
+        const val ACTION_WAIT_MILLIS = 3 * 60_000L
+
+        /**
+         * Whether the check should be scheduled at all: only with her switched on and her
+         * unprompted lines switched on. Otherwise nothing wakes the phone for it.
+         */
+        fun isWanted(personaActive: Boolean, checkInsEnabled: Boolean): Boolean = personaActive && checkInsEnabled
+
+        /** Schedules the repeating check, or leaves an existing schedule as it is. */
+        fun schedule(context: Context) {
+            val request = PeriodicWorkRequestBuilder<CheckInWorker>(PERIOD_MINUTES, TimeUnit.MINUTES)
+                // The first look comes a period from now, not the moment the switch is flipped.
+                .setInitialDelay(PERIOD_MINUTES, TimeUnit.MINUTES)
+                .build()
+            WorkManager.getInstance(context).enqueueUniquePeriodicWork(
+                WORK_NAME,
+                ExistingPeriodicWorkPolicy.KEEP,
+                request
+            )
+        }
+
+        fun cancel(context: Context) {
+            WorkManager.getInstance(context).cancelUniqueWork(WORK_NAME)
+        }
+    }
+}
