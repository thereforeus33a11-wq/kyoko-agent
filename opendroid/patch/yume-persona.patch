+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.google.gson.JsonPrimitive
+import com.opendroid.ai.data.models.ChatMessage
+import java.io.IOException
+import java.math.BigInteger
+import okio.BufferedSource
+
+/** Shapes a request for the encrypted exchange and reads the encrypted reply. */
+internal object VeniceE2eeMessages {
+
+    class Folded(val system: String, val user: String)
+
+    /**
+     * Venice's guide encrypts system and user messages only, which would leave an
+     * assistant message in the clear; in practice the enclave refuses a request with any
+     * unencrypted message, and takes at most one system message. Folding satisfies both
+     * readings: the earlier conversation, her side included, goes into the one encrypted
+     * system text, and only the newest user message is sent as the user turn. Images are
+     * left out: this path is text only, and an image part cannot be encrypted.
+     */
+    fun fold(systemPrompt: String, messages: List<ChatMessage>): Folded {
+        val lastUser = messages.indexOfLast { it.sender == ChatMessage.Sender.USER }
+        val earlier = messages.filterIndexed { index, _ -> index != lastUser }
+            .filter { it.text.isNotBlank() }
+        val system = if (earlier.isEmpty()) {
+            systemPrompt
+        } else {
+            buildString {
+                append(systemPrompt.trimEnd())
+                append("\n\n=== EARLIER IN THIS CONVERSATION (oldest first) ===\n")
+                earlier.forEach { message ->
+                    val who = if (message.sender == ChatMessage.Sender.USER) "User" else "You"
+                    append(who).append(": ").append(message.text.trim()).append('\n')
+                }
+            }.trimEnd()
+        }
+        val user = messages.getOrNull(lastUser)?.text?.takeIf { it.isNotBlank() } ?: "(continue)"
+        return Folded(system, user)
+    }
+
+    /**
+     * The two messages of a request, each encrypted to [modelKey]. There is exactly one
+     * system message and one user message, and neither carries anything but ciphertext.
+     */
+    fun sealedMessages(folded: Folded, modelKey: String): List<Map<String, String>> = listOf(
+        mapOf("role" to "system", "content" to VeniceE2ee.encrypt(folded.system, modelKey)),
+        mapOf("role" to "user", "content" to VeniceE2ee.encrypt(folded.user, modelKey))
+    )
+
+    /**
+     * Request options that may ride along in the clear: numbers and switches that shape
+     * how the model samples and reasons. Everything else is left out, whatever asked for
+     * it. Venice relays the body unencrypted, so anything in it is readable to Venice.
+     */
+    private val NUMBER_OPTIONS = setOf(
+        "temperature", "top_p", "top_k", "min_p", "min_temp", "max_temp",
+        "frequency_penalty", "presence_penalty", "repetition_penalty", "seed",
+        "max_tokens", "max_completion_tokens"
+    )
+    private val REASONING_OPTIONS = setOf("effort", "enabled", "exclude", "max_tokens")
+
+    /**
+     * `venice_parameters` entries that only shape the reply. The rest search the web,
+     * name a public character or switch the encryption off.
+     */
+    private val VENICE_SWITCHES = setOf("include_venice_system_prompt", "strip_thinking_response", "disable_thinking")
+
+    private val TOKEN_LIMIT_OPTIONS = listOf("max_tokens", "max_completion_tokens")
+
+    /** A switch's value is a number, true or false, or one short word; never a text. */
+    private const val MAX_OPTION_WORD_CHARS = 32
+
+    /**
+     * The body of an encrypted request. [asked] is what the request and the settings
+     * want in it (see [OpenAiCompatExtras.mergeExtraBody]); only the options named above
+     * are taken from it.
+     *
+     * Never present, whatever [asked] holds: `tools`, `tool_choice`, `response_format`
+     * and anything else that carries text. Venice drops tool definitions on this path
+     * without saying so and would have them in the clear; a plan is asked for as JSON in
+     * the encrypted system text instead. `venice_parameters.enable_e2ee` is always true:
+     * false would turn the request into one Venice can read.
+     */
+    fun requestBody(model: String, asked: Map<String, Any>, messages: List<Map<String, String>>): Map<String, Any> {
+        val body = mutableMapOf<String, Any>()
+        for ((key, value) in asked) {
+            when {
+                key in NUMBER_OPTIONS -> if (number(value) != null) body[key] = value
+                key == "reasoning_effort" -> if (isSwitchValue(value)) body[key] = value
+                key == "reasoning" -> switches(value, REASONING_OPTIONS)?.let { body[key] = it }
+            }
+        }
+        // Reasoning is paid for out of the same limit as the answer; see MIN_OUTPUT_TOKENS.
+        for (key in TOKEN_LIMIT_OPTIONS) {
+            val limit = body[key]?.let(::number) ?: continue
+            if (limit < VeniceE2ee.MIN_OUTPUT_TOKENS) body[key] = VeniceE2ee.MIN_OUTPUT_TOKENS
+        }
+        val venice = switches(asked["venice_parameters"], VENICE_SWITCHES).orEmpty().toMutableMap()
+        venice["enable_e2ee"] = true
+        body["venice_parameters"] = venice
+        body["model"] = model
+        body["stream"] = true
+        if (messages.any { !VeniceE2ee.looksEncrypted(it["content"].orEmpty()) }) {
+            throw IOException("A message was not encrypted")
+        }
+        body["messages"] = messages
+        return body
+    }
+
+    /** The entries of a JSON object named in [allowed] whose values are switch values; null when there are none. */
+    private fun switches(value: Any?, allowed: Set<String>): Map<String, Any>? {
+        val source = (value as? JsonElement)?.takeIf { it.isJsonObject }?.asJsonObject ?: return null
+        val kept = source.entrySet()
+            .filter { (name, entry) -> name in allowed && isSwitchValue(entry) }
+            .associate { (name, entry) -> name to (entry as Any) }
+        return kept.takeIf { it.isNotEmpty() }
+    }
+
+    private fun isSwitchValue(value: Any?): Boolean = when (value) {
+        is Number, is Boolean -> true
+        is String -> value.length <= MAX_OPTION_WORD_CHARS
+        is JsonPrimitive -> !value.isString || value.asString.length <= MAX_OPTION_WORD_CHARS
+        else -> false
+    }
+
+    private fun number(value: Any): Double? = when (value) {
+        is Number -> value.toDouble()
+        is JsonPrimitive -> if (value.isNumber) value.asDouble else null
+        else -> null
+    }
+
+    /**
+     * Reads the reply, which arrives as server-sent events whose content pieces are each
+     * encrypted to [privateKey]'s public key. A reply that arrives as one JSON object
+     * instead is read the same way.
+     *
+     * Fails rather than return anything that was readable on the way: a piece of the
+     * reply that is not ciphertext means the exchange was not private, and it is never
+     * shown as her reply. The model's reasoning arrives encrypted beside the reply; it is
+     * dropped unread, and if it arrives in plain text that fails the exchange too.
+     *
+     * The other way round does not hold. A reply made of ciphertext only was unreadable
+     * on the way, but that does not prove who wrote it or that it is complete: the pieces
+     * are encrypted to a public key the relay can see and are not signed, each one on its
+     * own, so a relay could drop, reorder or add pieces without this noticing. See
+     * [VeniceE2ee.modelKeyFromAttestation] for the whole list of what is taken on trust.
+     */
+    fun readReply(source: BufferedSource, privateKey: BigInteger): String {
+        val text = StringBuilder()
+        val unframed = StringBuilder()
+        var sawEvents = false
+        while (true) {
+            val line = source.readUtf8Line() ?: break
+            if (line.startsWith("data:")) {
+                sawEvents = true
+                val data = line.removePrefix("data:").trim()
+                if (data.isEmpty() || data == "[DONE]") continue
+                val piece = parse(data)?.let { holder(it, "delta") } ?: continue
+                text.append(open(piece, privateKey))
+            } else if (!sawEvents) {
+                unframed.append(line)
+            }
+        }
+        if (!sawEvents && unframed.isNotBlank()) {
+            parse(unframed.toString())?.let { holder(it, "message") }?.let { text.append(open(it, privateKey)) }
+        }
+        return text.toString()
+    }
+
+    private val REASONING_FIELDS = listOf("reasoning_content", "reasoning")
+
+    private fun open(piece: JsonObject, privateKey: BigInteger): String {
+        for (field in REASONING_FIELDS) {
+            val reasoning = stringField(piece, field) ?: continue
+            if (reasoning.isNotBlank() && !VeniceE2ee.looksEncrypted(reasoning)) {
+                throw E2eeProtocolException("the reasoning was not encrypted")
+            }
+        }
+        val raw = piece.get("content")
+        if (raw != null && !raw.isJsonNull && !(raw.isJsonPrimitive && raw.asJsonPrimitive.isString)) {
+            // Content given as parts or an object is plain text in another shape.
+            throw E2eeProtocolException("the reply was not encrypted")
+        }
+        val content = stringField(piece, "content") ?: return ""
+        return when {
+            VeniceE2ee.looksEncrypted(content) -> try {
+                VeniceE2ee.decrypt(content, privateKey)
+            } catch (e: IOException) {
+                throw E2eeProtocolException("a piece of the reply could not be opened")
+            }
+            // Spacing between encrypted pieces is sent as it is and says nothing about the
+            // reply; the reference client lets it through for the same reason.
+            content.isBlank() -> content
+            else -> throw E2eeProtocolException("the reply was not encrypted")
+        }
+    }
+
+    private fun parse(json: String): JsonObject? = try {
+        JsonParser.parseString(json).takeIf { it.isJsonObject }?.asJsonObject
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun firstChoice(root: JsonObject): JsonObject? =
+        root.get("choices")?.takeIf { it.isJsonArray }?.asJsonArray?.firstOrNull()
+            ?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun holder(root: JsonObject, name: String): JsonObject? =
+        firstChoice(root)?.get(name)?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun stringField(holder: JsonObject, name: String): String? =
+        holder.get(name)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+            ?.takeIf { it.isNotEmpty() }
+}
