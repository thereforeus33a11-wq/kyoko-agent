@@ -0,0 +1,81 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.data.models.EyesBounds
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Which models may be her eyes: Venice's list where it can be had (vision and the Private
+ * tier), the built-in allowlist where it cannot, and the Anonymized tier never.
+ */
+class EyesModelsTest {
+
+    private fun listing(vararg models: String) = """{"object":"list","data":[${models.joinToString(",")}]}"""
+
+    private fun model(id: String, vision: Boolean? = true, privacy: String? = "private"): String {
+        val capabilities = vision?.let { """"capabilities":{"supportsVision":$it,"supportsFunctionCalling":true}""" }
+        val tier = privacy?.let { """"privacy":"$it"""" }
+        return """{"id":"$id","type":"text","model_spec":{${listOfNotNull(capabilities, tier).joinToString(",")}}}"""
+    }
+
+    @Test
+    fun `his three choices are on the allowlist, the build's default first`() {
+        assertEquals(listOf("google-gemma-4-31b-it", "mistral-small-3-2-24b-instruct", "qwen3-vl-235b-a22b"), EyesModels.CHOICES)
+        assertEquals(EyesBounds.DEFAULT_MODEL, EyesModels.DEFAULT)
+        assertEquals(EyesModels.DEFAULT, LLMConfig().personaEyesModel)
+        assertTrue(EyesModels.ALLOWLIST.containsAll(EyesModels.CHOICES))
+        assertEquals(
+            setOf(
+                "google-gemma-4-31b-it", "mistral-small-3-2-24b-instruct", "nvidia-nemotron-3-5-super-vl-120b-a12b",
+                "google-gemma-3-27b-it", "qwen3-vl-235b-a22b"
+            ),
+            EyesModels.ALLOWLIST
+        )
+    }
+
+    @Test
+    fun `Venice's list decides where it lists vision and the Private tier`() {
+        val list = listing(
+            model("qwen3-vl-235b-a22b"),
+            model("some-new-vl-model"),
+            model("venice-uncensored", vision = false),
+            model("mistral-small-3-2-24b-instruct", privacy = "anonymized"),
+            model("google-gemma-4-31b-it", vision = null, privacy = null)
+        )
+        assertEquals(EyesModels.Verdict.Accepted(listed = true), EyesModels.judge("qwen3-vl-235b-a22b", list))
+        // A model this build does not know is taken when Venice lists it so.
+        assertEquals(EyesModels.Verdict.Accepted(listed = true), EyesModels.judge("some-new-vl-model", list))
+        assertTrue(EyesModels.judge("venice-uncensored", list) is EyesModels.Verdict.Refused)
+        assertTrue(EyesModels.judge("mistral-small-3-2-24b-instruct", list) is EyesModels.Verdict.Refused)
+        // Listed, but without the fields: the allowlist decides (the names are UNCONFIRMED).
+        assertEquals(EyesModels.Verdict.Accepted(listed = false), EyesModels.judge("google-gemma-4-31b-it", list))
+        // Not listed at all: Venice no longer has it.
+        assertTrue(EyesModels.judge("google-gemma-3-27b-it", list) is EyesModels.Verdict.Refused)
+    }
+
+    @Test
+    fun `offline the allowlist decides, and an id it does not hold is refused`() {
+        for (id in EyesModels.ALLOWLIST) assertEquals(EyesModels.Verdict.Accepted(listed = false), EyesModels.judge(id, null))
+        assertEquals(EyesModels.Verdict.Accepted(listed = false), EyesModels.judge("  Google-Gemma-4-31B-it ", null))
+        assertTrue(EyesModels.judge("some-new-vl-model", null) is EyesModels.Verdict.Refused)
+        assertTrue(EyesModels.judge("", null) is EyesModels.Verdict.Refused)
+        assertTrue(EyesModels.judge("not a model id!", null) is EyesModels.Verdict.Refused)
+        // A list that cannot be read is no list.
+        assertEquals(EyesModels.Verdict.Accepted(listed = false), EyesModels.judge("qwen3-vl-235b-a22b", "<html>busy</html>"))
+    }
+
+    @Test
+    fun `the Anonymized tier is always refused, even where a list calls it private and seeing`() {
+        val list = listing(model("claude-sonnet-45"), model("openai-gpt-52"), model("gemini-3-pro"))
+        for (id in listOf("claude-sonnet-45", "openai-gpt-52", "gemini-3-pro", "Claude-Opus-45")) {
+            assertTrue(EyesModels.anonymized(id))
+            assertTrue(id, EyesModels.judge(id, list) is EyesModels.Verdict.Refused)
+            assertTrue(id, EyesModels.judge(id, null) is EyesModels.Verdict.Refused)
+            assertFalse(HerEyes.modelAllowed(id.lowercase()))
+        }
+        assertFalse(EyesModels.anonymized("google-gemma-4-31b-it"))
+    }
+}
