+/** Backs the screen where the owner reads and edits the persona's character card. */
+@HiltViewModel
+class PersonaViewModel @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val library: PersonaLibrary
+) : ViewModel() {
+
+    /** What the library holds, for the line under its setting. Empty until it has been read. */
+    var librarySummary by mutableStateOf("")
+        private set
+
+    /** The text field in which the owner hands her notes, and what came of the last hand-over. */
+    var notesDraft by mutableStateOf("")
+        private set
+    var notesStatus by mutableStateOf("")
+        private set
+
+    fun onNotesDraftChange(text: String) {
+        notesDraft = text
+        notesStatus = ""
+    }
+
+    /**
+     * Puts the lines of the draft into her notebook, on this phone. Each line is
+     * `kind | key | note`, the form her own notes have. Nothing is sent anywhere.
+     */
+    fun giveNotes() {
+        val text = notesDraft
+        viewModelScope.launch {
+            val notes = PersonaNotes.parse(text)
+            val lines = text.lines().count { it.isNotBlank() && !it.trimStart().startsWith("#") }
+            if (notes.isNotEmpty()) withContext(Dispatchers.IO) { memory.apply(notes) }
+            notesStatus = when {
+                notes.isEmpty() -> "Nothing added. Each line has to read: kind | key | note"
+                notes.size < lines -> "Added ${notes.size} of $lines lines. The rest did not fit the form."
+                else -> "Added ${notes.size}. They are in her notebook now."
+            }
+            if (notes.isNotEmpty() && notes.size >= lines) notesDraft = ""
+        }
+    }
+
+    fun loadLibrarySummary() {
+        if (librarySummary.isNotEmpty()) return
+        viewModelScope.launch {
+            val shelf = library.shelf()
+            librarySummary = if (shelf.pages.isEmpty()) {
+                "This build has none of her files beyond the card."
+            } else {
+                "${library.fileCount} of her files are on this phone, ${shelf.pages.size} pages, " +
+                    "about ${shelf.totalChars / 1000},000 characters."
+            }
+        }
+    }
+
+    // Snapshot state, not a StateFlow: a text field this long drops characters when
+    // every keystroke makes an asynchronous round trip.
+    var cardText by mutableStateOf("")
+        private set
+    var isLoading by mutableStateOf(true)
+        private set
+
+    /** True when a saved edit, not the bundled card, is what she runs on. */
+    var usesSavedEdit by mutableStateOf(false)
+        private set
+    var hasUnsavedChanges by mutableStateOf(false)
+        private set
+
+    init {
+        viewModelScope.launch {
+            val (text, edited) = withContext(Dispatchers.IO) { store.card() to store.hasOverride() }
+            cardText = text
+            usesSavedEdit = edited
+            isLoading = false
+        }
+    }
+
+    fun onTextChange(text: String) {
+        cardText = text
+        hasUnsavedChanges = true
+    }
+
+    /** Saves the text; she uses it from her next reply. Saving an empty card restores the bundled one. */
+    fun save() {
+        val text = cardText
+        viewModelScope.launch {
+            val (stored, edited) = withContext(Dispatchers.IO) {
+                store.saveCard(text)
+                store.card() to store.hasOverride()
+            }
+            cardText = stored
+            usesSavedEdit = edited
+            hasUnsavedChanges = false
+        }
+    }
+
+    fun restoreBundled() {
+        viewModelScope.launch {
+            val stored = withContext(Dispatchers.IO) {
+                store.saveCard("")
+                store.card()
+            }
+            cardText = stored
+            usesSavedEdit = false
+            hasUnsavedChanges = false
+        }
+    }
+}
