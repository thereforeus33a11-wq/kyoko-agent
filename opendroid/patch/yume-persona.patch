+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.io.File
+
+/**
+ * His TAKE_PHOTO_BACKGROUND (OWN_LIFE_PLAN phase 2): a background photo is never left on the
+ * phone, and a photo it did not take is not reported as taken. Opening the camera app instead
+ * is a step he still has to take, so it is not a success.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class TakePhotoBackgroundTest {
+
+    private val context: Application = ApplicationProvider.getApplicationContext()
+    private val action = AdvancedControlActions().getActions().single { it.name == "TAKE_PHOTO_BACKGROUND" }
+
+    @Test
+    fun `without the camera permission no photo is taken, the camera app is opened, and that is not a success`() = runBlocking {
+        shadowOf(context.packageManager).setSystemFeature(PackageManager.FEATURE_CAMERA_ANY, true)
+        val result = action.execute(emptyMap(), context)
+        assertFalse(result.success)
+        assertTrue(result is ActionResult.UserActionRequired)
+        assertTrue(result.error.orEmpty(), result.error.orEmpty().contains("no background photo was taken"))
+        assertTrue(result.error.orEmpty().contains(AdvancedControlActions.TakePhotoBackgroundAction.CAMERA_APP_OPENED))
+        assertEquals(MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA, shadowOf(context).nextStartedActivity?.action)
+        // Nothing of a photo anywhere the old action wrote one.
+        val pictures = context.getExternalFilesDir(Environment.DIRECTORY_PICTURES)
+        assertTrue(pictures?.listFiles().isNullOrEmpty())
+    }
+
+    @Test
+    fun `the action writes no file, and says a photo it took was not kept`() {
+        val source = File("src/main/java/com/opendroid/ai/actions/AdvancedControlActions.kt").readText()
+        val body = source.substringAfter("internal class TakePhotoBackgroundAction").substringBefore("private class ListInstalledAppsAction")
+        assertFalse(body.contains("background_photo_"))
+        assertFalse(body.contains("FileOutputStream"))
+        assertFalse(body.contains("getExternalFilesDir"))
+        assertFalse(body.contains("Photo saved"))
+        assertFalse(body.contains("ActionResult(true, \"\$msg"))
+        assertTrue(AdvancedControlActions.TakePhotoBackgroundAction.TAKEN.contains("It was not kept"))
+    }
+}
