+package com.opendroid.ai.core.persona
+
+/**
+ * Her reply, spoken while she writes it (opendroid/PRESENCE_PLAN.md, part 1). Each
+ * sentence goes to her voice the moment it is finished, while she writes the rest, so
+ * she starts talking within a breath of her first sentence instead of after her whole
+ * reply.
+ *
+ * What may be said is decided line by line, the way the reply itself is read:
+ * - A line she keeps to herself ([PersonaThoughtLines.MARKER]) and a command line
+ *   ([PersonaActions.MARKER]) are never said. A line counts as said-text only once its
+ *   start shows it is neither: until then (an opening quote, a name label, half a
+ *   marker) nothing of it is said.
+ * - Within a line that is said-text, only finished sentences are said early.
+ * - Reasoning from the model is never in the reply, but one kind is recognised only
+ *   once the reply is whole. If any reasoning tag shows up, nothing more is said early,
+ *   and the end of the reply decides as it always did.
+ *
+ * At the end, [rest] gives what is left of the reply as it stands, so nothing is said
+ * twice. If what was said early does not match the start of the reply as it stands,
+ * nothing more is said: half a line twice, or a line that was taken back, is worse
+ * than a line cut short.
+ */
+class PersonaLiveSpeech(private val speak: (String) -> Unit) {
+
+    private var said = ""
+    private var off = false
+
+    /** True once anything was said early. */
+    val spokeEarly: Boolean get() = said.isNotEmpty()
+
+    /** Called with the whole reply as streamed so far. */
+    fun onStreamed(streamed: String) {
+        if (off) return
+        if (REASONING.containsMatchIn(streamed)) {
+            off = true
+            return
+        }
+        val ready = speakableSoFar(streamed)
+        if (ready.length <= said.length) return
+        if (!ready.startsWith(said)) {
+            off = true
+            return
+        }
+        val piece = ready.substring(said.length).trim()
+        said = ready
+        if (piece.any { it.isLetterOrDigit() }) speak(piece)
+    }
+
+    /**
+     * What is left to say of [finalSaid], the reply as it stands once whole. All of it if
+     * nothing was said early; null when there is nothing left, or when what was said
+     * early is not how the reply begins.
+     */
+    fun rest(finalSaid: String): String? {
+        if (said.isEmpty()) return finalSaid.ifBlank { null }
+        val done = letters(said)
+        val all = letters(finalSaid)
+        if (!all.startsWith(done)) return null
+        var count = 0
+        var index = 0
+        while (index < finalSaid.length && count < done.length) {
+            if (finalSaid[index].isLetterOrDigit()) count++
+            index++
+        }
+        // Only the closing marks of the sentence already said go: an opening mark of what
+        // follows stays, the * of a gesture above all, or the gesture would be said aloud.
+        val left = finalSaid.substring(index).trimStart { it.isWhitespace() || it in CLOSING_MARKS }
+        return left.takeIf { rest -> rest.any { it.isLetterOrDigit() } }
+    }
+
+    companion object {
+        private val REASONING = Regex("""</?\s*(think|thinking|reasoning|reflection)\b|◁/?think""", RegexOption.IGNORE_CASE)
+        private val OPENING_QUOTES = charArrayOf('"', '“', '「')
+        private const val CLOSING_MARKS = ".!?…,;:。！？、”’」』)]"
+        private val LABELS = listOf("yume kisaragi", "yume", "kisaragi", "assistant", "ai")
+
+        // A sentence ends at . ! ? or an ellipsis followed by a space, or at a Japanese stop.
+        private val SENTENCE_END = Regex("""(?:[.!?…]+["”’」』)\]]*(?=\s))|(?:[。！？]+[」』）]*)""")
+
+        private fun letters(text: String) = text.filter { it.isLetterOrDigit() }.lowercase()
+
+        private enum class Kind { SAID, NOT_SAID, UNDECIDED }
+
+        /** What kind of line [line] is, from its start. [whole]: no more of it is coming. */
+        private fun kind(line: String, whole: Boolean): Kind {
+            val t = line.trim()
+            if (t.isEmpty()) return if (whole) Kind.NOT_SAID else Kind.UNDECIDED
+            if (PersonaThoughtLines.isThoughtLine(line)) return Kind.NOT_SAID
+            if (t.startsWith(PersonaActions.MARKER)) return Kind.NOT_SAID
+            val b = t.trimStart(*OPENING_QUOTES).trimStart()
+            if (b.isEmpty()) return if (whole) Kind.NOT_SAID else Kind.UNDECIDED
+            // Half a marker, or a marker still to come behind a label.
+            if (b.startsWith("<") || b.startsWith(">")) return if (whole && b.length > 1 && b[1] != b[0]) Kind.SAID else if (whole) Kind.NOT_SAID else Kind.UNDECIDED
+            val lower = b.lowercase()
+            for (label in LABELS) {
+                if (!whole && (label + ":").startsWith(lower)) return Kind.UNDECIDED
+                val m = Regex("""^${Regex.escape(label)}\s*:\s*(.*)$""").find(lower) ?: continue
+                val after = m.groupValues[1].trimStart(*OPENING_QUOTES).trimStart()
+                if (after.isEmpty()) return if (whole) Kind.NOT_SAID else Kind.UNDECIDED
+                if (after.startsWith("<")) return if (whole && !after.startsWith("<<")) Kind.SAID else if (whole) Kind.NOT_SAID else Kind.UNDECIDED
+            }
+            return Kind.SAID
+        }
+
+        /**
+         * The said-text of [streamed] that is safe to say now: its finished lines that are
+         * said-text, and the finished sentences of the line still being written when that
+         * line is said-text. Tidied the way the reply will be.
+         */
+        internal fun speakableSoFar(streamed: String): String {
+            val lines = streamed.split('\n')
+            val out = ArrayList<String>()
+            for ((i, line) in lines.withIndex()) {
+                val whole = i < lines.size - 1
+                when (kind(line, whole)) {
+                    Kind.SAID -> if (whole) {
+                        out += line
+                    } else {
+                        // Not a stop inside a gesture still open (*leans back. stretches*):
+                        // half a gesture would be said aloud, the rest of it later.
+                        val end = SENTENCE_END.findAll(line)
+                            .lastOrNull { m -> line.substring(0, m.range.first).count { it == '*' } % 2 == 0 }
+                            ?.range?.last ?: -1
+                        if (end >= 0) out += line.substring(0, end + 1)
+                    }
+                    Kind.NOT_SAID -> Unit
+                    Kind.UNDECIDED -> break
+                }
+            }
+            if (out.isEmpty()) return ""
+            val joined = out.joinToString("\n")
+            return PersonaPrompts.cleanReply(joined).takeIf { it.any(Char::isLetterOrDigit) } ?: ""
+        }
+    }
+}
