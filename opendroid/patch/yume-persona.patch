+/** Where a model may run, what each configured route is, and what is held back on a readable one. */
+@Composable
+fun PrivacyCard(
+    config: LLMConfig,
+    viewModel: SettingsViewModel,
+    presence: PersonaPresenceViewModel = hiltViewModel()
+) {
+    val mainRoute = RouteClassifier.mainRoute(config)
+    val herRoute = RouteClassifier.personaRoute(config)
+    // Whether she is the one who talks: null until that is known.
+    val hers: Boolean? = presence.active.collectAsState().value
+    // What this phone has to turn speech into text with, asked of the phone itself.
+    val context = LocalContext.current
+    val onDeviceSpeech = remember { PreferredRecognizer.isOnDeviceAvailable(context) }
+    val anySpeech = remember { android.speech.SpeechRecognizer.isRecognitionAvailable(context) }
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            Text(
+                text = "PRIVACY",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            SettingChoiceRow(
+                label = "Where a model may run",
+                options = ROUTE_POLICY_CHOICES,
+                selected = config.routePolicy,
+                onSelect = viewModel::updateRoutePolicy
+            )
+            // The rest is worded for her or for the stock app. Until it is known which,
+            // none of it is shown: a build that runs as stock must not open with a line
+            // about her replies and her notebook.
+            if (hers == null) return@Column
+            RouteLine(PrivacyWording.mainRouteLabel(hers), mainRoute, config.routePolicy.allows(mainRoute))
+            if (hers) RouteLine("Her replies and her notebook", herRoute, config.routePolicy.allows(herRoute))
+            // What a label above takes on trust, where it does.
+            (mainRoute.smallPrint ?: herRoute.smallPrint.takeIf { hers })?.let { smallPrint ->
+                Text(text = smallPrint, fontSize = 10.sp, color = TextSecondary)
+            }
+            Text(
+                text = when (config.routePolicy) {
+                    RoutePolicy.OWN_HARDWARE -> PrivacyWording.OWN_HARDWARE_ONLY
+                    RoutePolicy.ENCRYPTED -> PrivacyWording.ENCRYPTED_ONLY
+                    RoutePolicy.ANY -> PrivacyWording.plainHostedAllowed(hers)
+                },
+                fontSize = 10.sp,
+                color = if (config.routePolicy == RoutePolicy.ANY) AccentCyan else TextSecondary
+            )
+            // His trust in Venice's Private tier widens what counts as private: said where the routes are.
+            if (config.trustVenicePrivate && config.routePolicy != RoutePolicy.OWN_HARDWARE) {
+                Text(text = PrivacyWording.PRIVATE_TIER_TRUSTED, fontSize = 10.sp, color = AccentCyan)
+            }
+            // Speech is not a model request, so the choice above says nothing about it by itself.
+            Text(
+                text = PrivacyWording.voiceInput(onDeviceSpeech, anySpeech, PreferredRecognizer.cloudAllowed(config)),
+                fontSize = 10.sp,
+                color = if (PreferredRecognizer.cloudAllowed(config)) AccentCyan else TextSecondary
+            )
+            SettingSwitchRow(
+                title = "On a plain hosted model, keep my details on this phone",
+                description = PrivacyWording.privateModeHint(hers),
+                checked = config.privateMode,
+                onCheckedChange = viewModel::updatePrivateMode
+            )
+            Text(
+                text = PrivacyWording.screenOnRequest(hers),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            Text(
+                text = PrivacyWording.storedOnThisPhone(hers),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            // No switch for other programs to drive the app: the MCP server is off in this build.
+        }
+    }
+}
+
+@Composable
+private fun RouteLine(what: String, route: RoutePrivacy, allowed: Boolean) {
+    Text(
+        text = "$what: ${route.label}" + if (allowed) "" else " — refused by the setting above",
+        fontSize = 12.sp,
+        fontFamily = FontFamily.Monospace,
+        color = if (allowed && route.isPrivate) TextPrimary else AccentCyan
+    )
+}
+
+/**
+ * What the provider's stored options do, and which of them are not sent: the app sets
+ * the temperature and the token limit for each call itself (OpenAiCompatExtras), and
+ * with an e2ee- model ([encrypted]) only numbers and switches go out.
+ */
+internal fun hostedOptionsHint(provider: String, encrypted: Boolean): String =
+    "Optional. A JSON object added to every request to $provider, for options the endpoint documents, for " +
+        "example {\"reasoning_effort\": \"none\"}. Ignored unless it is valid JSON. temperature and the token limit " +
+        "(max_tokens, max_completion_tokens) are ignored here, because the app sets them for each call." +
+        if (encrypted) {
+            " With an e2ee- model only numbers and switches from here are sent; anything else is left out."
+        } else {
+            ""
+        }
+
+/** Timeout and extra request-body options for the active hosted OpenAI-compatible provider. */
+@Composable
+fun HostedProviderOptionsCard(config: LLMConfig, viewModel: SettingsViewModel) {
+    val provider = config.activeProvider
+    val savedTimeout = config.resolvedCloudTimeoutSeconds()
+    var timeoutText by remember { mutableStateOf(savedTimeout.toString()) }
+    LaunchedEffect(savedTimeout) {
+        val typed = timeoutText.toIntOrNull()?.let(CloudTimeout::clamp)
+        if (typed != savedTimeout) timeoutText = savedTimeout.toString()
+    }
+    val extraBody = config.extraBodyParams[provider].orEmpty()
+
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp)) {
+            Text(
+                text = "HOSTED MODEL OPTIONS",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = TextPrimary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = timeoutText,
+                onValueChange = { input ->
+                    val digits = input.filter(Char::isDigit).take(3)
+                    timeoutText = digits
+                    digits.toIntOrNull()?.let(viewModel::updateCloudTimeout)
+                },
+                label = { Text("Response Timeout (seconds)", fontSize = 12.sp) },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                colors = fieldColors(),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .onFocusChanged { focus ->
+                        if (!focus.isFocused) timeoutText = savedTimeout.toString()
+                    }
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = "How long to wait for a reply (${CloudTimeout.MIN_SECONDS}–${CloudTimeout.MAX_SECONDS}s). Applies to Custom OpenAI Compatible and OpenRouter.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            Spacer(modifier = Modifier.height(12.dp))
+            OutlinedTextField(
+                value = extraBody,
+                onValueChange = { viewModel.updateExtraBodyParams(provider, it) },
+                label = { Text("Extra request options (JSON)", fontSize = 12.sp) },
+                isError = !OpenAiCompatExtras.isValidExtraBody(extraBody),
+                minLines = 2,
+                maxLines = 6,
+                colors = fieldColors(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            Spacer(modifier = Modifier.height(6.dp))
+            Text(
+                text = hostedOptionsHint(provider, RouteClassifier.mainRoute(config) == RoutePrivacy.ENCRYPTED),
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+        }
+    }
+}
+
+/** Pitch and rate for the phone's own voice, and the ElevenLabs model. */
+@Composable
+fun SpeechTuningFields(config: LLMConfig, viewModel: SettingsViewModel) {
+    OutlinedTextField(
+        value = config.elevenLabsModelId,
+        onValueChange = viewModel::updateElevenLabsModelId,
+        label = { Text("ElevenLabs Model ID (optional)", fontSize = 12.sp) },
+        singleLine = true,
+        colors = fieldColors(),
+        modifier = Modifier.fillMaxWidth()
+    )
+    SpeechSlider(
+        label = "Phone voice pitch",
+        value = config.ttsPitch,
+        onChange = { viewModel.updateSpeechTuning(it, config.ttsSpeechRate) }
+    )
+    SpeechSlider(
+        label = "Phone voice speed",
+        value = config.ttsSpeechRate,
+        onChange = { viewModel.updateSpeechTuning(config.ttsPitch, it) }
+    )
+    Text(
+        text = "Pitch and speed apply to the phone's own voice. 1.0 is the engine default; lower is deeper and slower.",
+        fontSize = 10.sp,
+        color = TextSecondary
+    )
+}
+
+@Composable
+private fun SpeechSlider(label: String, value: Float, onChange: (Float) -> Unit) {
+    val shown = SpeechTuning.clamp(value)
+    Column {
+        Text(
+            text = "$label: ${"%.2f".format(java.util.Locale.US, shown)}",
+            fontSize = 12.sp,
+            color = TextPrimary
+        )
+        Slider(
+            value = shown,
+            onValueChange = onChange,
+            valueRange = SpeechTuning.MIN..SpeechTuning.MAX,
+            colors = SliderDefaults.colors(thumbColor = AccentCyan, activeTrackColor = AccentCyan)
+        )
+    }
+}
