+    /** How a chat model opens when it apologises or declines instead of doing its job. */
+    private val ASSISTANT_PROSE_OPENINGS = listOf(
+        "sorry", "i'm sorry", "i am sorry", "im sorry", "my apologies", "apologies", "i apologize", "i apologise",
+        "i cannot", "i can't", "i cant", "i can not", "i'm unable", "i am unable", "i'm not able", "i am not able",
+        "i won't", "i wont", "i will not", "i'm afraid", "i am afraid", "i must decline", "i have to decline",
+        "i'm not comfortable", "i am not comfortable", "i don't feel comfortable", "i do not feel comfortable",
+        "as an ai", "as a language model", "as an assistant", "as a helpful assistant", "unfortunately"
