+import java.nio.charset.Charset
+
+/** Readable text out of three kinds of page, and the charsets Japanese sites still use. */
+class ReadableTest {
+
+    private val sjis = Charset.forName("Shift_JIS")
+    private val eucJp = Charset.forName("EUC-JP")
+
+    private val japaneseArticle = """
+        <html><head>
+        <meta http-equiv="Content-Type" content="text/html; charset=Shift_JIS">
+        <title>egg (雑誌) - ギャル雑誌の歴史</title>
+        <link rel="alternate" type="application/rss+xml" href="/rss.xml">
+        <meta property="og:image" content="https://example.jp/egg.jpg">
+        </head><body>
+        <div id="header"><a href="/">トップ</a> <a href="/news">ニュース</a> <a href="/login">ログイン</a></div>
+        <div class="article_body">
+        <h1>egg (雑誌)</h1>
+        <p>『egg』は、1995年に創刊された日本のギャル向けファッション雑誌である。渋谷を中心としたギャル文化を牽引した。</p>
+        <p>2014年に一度休刊したが、2018年にウェブメディアとして復活し、2019年には紙の雑誌も復刊した。</p>
+        <p>誌面では読者モデルが多く起用され、ガングロやヤマンバなどの流行を生んだ。</p>
+        </div>
+        <div class="sidebar"><h3>人気記事</h3><ul><li><a href="/a">ランキング記事その一、とても人気です</a></li></ul></div>
+        <div id="footer">Copyright example.jp</div>
+        </body></html>
+    """.trimIndent()
+
+    @Test
+    fun `a Japanese article in Shift_JIS - its text without the menus`() {
+        val bytes = japaneseArticle.toByteArray(sjis)
+        val html = Readable.decode(bytes, "text/html")
+        val page = Readable.page(html, "https://example.jp/egg")
+        assertEquals("egg (雑誌) - ギャル雑誌の歴史", page.title)
+        assertTrue(page.text.contains("1995年に創刊された日本のギャル向けファッション雑誌"))
+        assertTrue(page.text.contains("ガングロやヤマンバ"))
+        assertFalse(page.text.contains("ログイン"))
+        assertFalse(page.text.contains("ランキング記事"))
+        assertFalse(page.text.contains("Copyright"))
+        assertEquals(listOf("https://example.jp/rss.xml"), page.feeds)
+        assertEquals("https://example.jp/egg.jpg", page.image)
+    }
+
