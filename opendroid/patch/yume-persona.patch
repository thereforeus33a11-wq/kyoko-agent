+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.agent.ActionSchema
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersonaActionsTest {
+
+    @Test
+    fun `a last line after the marker is her command and is not part of what she says`() {
+        val split = PersonaActions.split("boring. fixing that\n>> play eurobeat on youtube")
+        assertEquals("boring. fixing that", split.text)
+        assertEquals("play eurobeat on youtube", split.command)
+    }
+
+    @Test
+    fun `a reply without a marker is all talk`() {
+        val split = PersonaActions.split("mm. later")
+        assertEquals("mm. later", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `a reply that is only a command has no words`() {
+        val split = PersonaActions.split(">> flashlight on\n")
+        assertEquals("", split.text)
+        assertEquals("flashlight on", split.command)
+    }
+
+    @Test
+    fun `a marker that is not the last line is removed and never run`() {
+        val split = PersonaActions.split(">> open the camera\nactually no. too dark")
+        assertEquals("actually no. too dark", split.text)
+        assertNull(split.command)
+
+        val two = PersonaActions.split("watch\n>> flashlight on\n>> open the camera")
+        assertEquals("watch", two.text)
+        assertEquals("open the camera", two.command)
+    }
+
+    @Test
+    fun `a marker inside a line is just text`() {
+        val split = PersonaActions.split("he typed >> like a hacker. kimo")
+        assertEquals("he typed >> like a hacker. kimo", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `commands that are empty, symbols only or far too long are ignored`() {
+        assertNull(PersonaActions.split("ok\n>>").command)
+        assertNull(PersonaActions.split("ok\n>> ??").command)
+        assertNull(PersonaActions.split("ok\n>> " + "a".repeat(400)).command)
+        assertEquals("ok", PersonaActions.split("ok\n>> ??").text)
+    }
+
+    @Test
+    fun `quoting around the command is stripped`() {
+        assertEquals("set a timer for ten minutes", PersonaActions.split("fine\n>> `set a timer for ten minutes`").command)
+    }
+
+    @Test
+    fun `every allowed action exists and none of them can reach another person or his data`() {
+        val known = ActionSchema.ALL_ACTIONS.associateBy { it.name }
+        for (name in PersonaActions.ALLOWED) {
+            val definition = known[name]
+            assertTrue("$name is not a real action", definition != null)
+            assertFalse("$name can never be auto-approved, so it is not hers to run", definition!!.neverAutoApprove)
+        }
+        val forbidden = listOf(
+            "MAKE_CALL", "MAKE_VIDEO_CALL", "SEND_SMS", "SEND_WHATSAPP", "SEND_WHATSAPP_GROUP", "SEND_TELEGRAM",
+            "SEND_EMAIL", "READ_MESSAGES", "READ_EMAILS", "READ_NOTIFICATIONS", "AUTO_REPLY_TOGGLE",
+            "PAY_UPI", "SPLIT_BILL", "CHECK_BALANCE", "ORDER_FOOD", "ORDER_GROCERY", "ADD_TO_CART", "BOOK_UBER",
+            "DELETE_FILE", "WRITE_FILE", "READ_FILE", "MOVE_FILE", "COPY_FILE", "INSTALL_APP", "RESTART_DEVICE",
+            "CLICK_TEXT", "CLICK_ID", "CLICK_COORDINATES", "TYPE_TEXT", "TYPE_ID", "PRESS_ENTER",
+            "RUN_MACRO", "CREATE_MACRO", "SCHEDULE_MACRO", "RUN_ROUTINE", "APPROVE_ROUTINE",
+            "SOCIAL_CREATE_POST", "SOCIAL_SCHEDULE_POST", "SOCIAL_DRAFT_REPLIES",
+            "WEB_SEARCH", "OPEN_URL", "OPEN_BROWSER", "SUMMARIZE_URL", "GET_CLIPBOARD", "COPY_TO_CLIPBOARD",
+            "ANALYZE_SCREENSHOT", "READ_AND_REMEMBER_SCREEN", "GET_SCREEN_TEXT",
+            "ADD_NOTE", "UPDATE_PREFERENCE", "SAVE_SENSITIVE_INFO", "RECALL_MEMORY", "READ_NOTES",
+            "SMART_HOME", "LOCK_DOOR", "CHAT", "ASK_USER", "DISPLAY_INFO"
+        )
+        for (name in forbidden) {
+            assertFalse("$name must not be hers to run", name in PersonaActions.ALLOWED)
+        }
+    }
+
+    @Test
+    fun `a plan is hers to run only when every action in it is allowed`() {
+        assertTrue(PersonaActions.allAllowed(listOf("PLAY_YOUTUBE", "SET_VOLUME")))
+        assertFalse(PersonaActions.allAllowed(listOf("PLAY_YOUTUBE", "SEND_SMS")))
+        assertFalse(PersonaActions.allAllowed(listOf("DISPLAY_INFO")))
+        assertFalse(PersonaActions.allAllowed(emptyList()))
+    }
+
+    @Test
+    fun `nothing that sends free text to the network is hers to run`() {
+        val networkText = setOf(
+            "WEB_SEARCH", "GET_NEWS", "GET_WEATHER", "TRANSLATE", "SUMMARIZE_URL", "FACT_CHECK",
+            "CHECK_STOCK", "DEFINE_WORD", "CURRENCY_CONVERT", "OPEN_URL", "OPEN_BROWSER"
+        )
+        assertTrue(PersonaActions.ALLOWED.intersect(networkText).isEmpty())
+    }
+}
