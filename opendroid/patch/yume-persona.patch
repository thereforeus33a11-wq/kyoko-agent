+        val heard: List<String> = emptyList(),
+        /** Phone time on his screen, lent, as it is offered now, or null when it is not. */
+        val phone: com.opendroid.ai.core.life.phone.PhoneTime.Offer? = null
+    )
+
+    /**
+     * The `go:` offer in [momentBlock], listing only what can run now; null when nothing
+     * can. Every sentence says what the code does: where she goes, how it runs, what ends
+     * it and what she gets back.
+     */
+    internal fun goLine(life: Life): String? {
+        if (life.runnable.isEmpty()) return null
+        val reads = OutingKind.Kind.READ in life.runnable || OutingKind.Kind.NEWS in life.runnable
+        val phone = life.phone?.takeIf { OutingKind.Kind.SCROLL in life.runnable }
+        return buildString {
+            if (phone == null) {
+                append("  go: <what>               you go off on your own for a while, when something grabs you or you are bored: in your own space, not in his apps or on his screen. what you can go do now:\n")
+            } else {
+                append("  go: <what>               you go off on your own for a while, when something grabs you or you are bored: in your own space, or in one of his apps on his screen where he lends it. what you can go do now:\n")
+            }
+            if (OutingKind.Kind.READ in life.runnable) {
+                val where = if (life.paidSearch) "wikipedia and venice search" else "wikipedia"
+                append("      go: read <what you want to know, or an https link>   the app looks your words up on $where, or opens your link, and you read what you open.\n")
+            }
+            if (OutingKind.Kind.NEWS in life.runnable) {
+                append("      go: news [japan | world | <a topic>]                  the latest headlines from your feeds, or a news search for your topic, and you open what grabs you.\n")
+            }
+            val camera = life.camera?.takeIf { OutingKind.Kind.LOOK in life.runnable }
+            if (camera != null) append(lookLine(camera, life.asks)).append('\n')
+            if (phone != null) append(phoneLine(phone)).append('\n')
+            if (!reads) {
