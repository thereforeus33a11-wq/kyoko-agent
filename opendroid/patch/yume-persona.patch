+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        val conversationRepository = ConversationRepository(
+            database,
+            database.conversationDao(),
+            database.chatSessionDao()
+        )
+        val extractor = MemoryExtractor(memoryRepository)
+        val workingMemory = WorkingMemory(context, DeviceStateProvider(context))
+        val notificationIntelligence = NotificationIntelligence(database.notificationDao(), memoryRepository)
+        manager = MemoryManager(
+            workingMemory = workingMemory,
+            episodicMemory = EpisodicMemory(conversationRepository),
+            semanticMemory = SemanticMemory(memoryRepository, extractor),
+            proceduralMemory = ProceduralMemory(memoryRepository),
+            personalGrowthEngine = PersonalGrowthEngine(
+                memoryRepository = memoryRepository,
+                sensitiveMemoryStore = NoSensitiveMemory,
+                workingMemory = workingMemory,
+                notificationIntelligence = notificationIntelligence
+            ),
+            memoryExtractor = extractor,
+            conversationRepository = conversationRepository,
+            memoryRepository = memoryRepository,
+            notificationIntelligence = notificationIntelligence,
+            userProfileStore = NoProfile,
+            context = context
+        )
+        personaMemory = PersonaMemory(memoryRepository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `her notes never enter the context the planner sees`() = runBlocking {
+        memoryRepository.saveMemory(Memory("wife_name", "Sara", MemoryType.SEMANTIC))
+        personaMemory.apply(
+            listOf(
+                Note(Kind.OPINION, "jokes", "his jokes are trash and she tells him so"),
+                Note(Kind.USER, "car", "he drives a jeep")
+            )
+        )
+
+        val plannerContext = manager.getRelevantContext("text my wife i am late")
+
+        assertTrue(plannerContext, plannerContext.contains("wife_name: Sara"))
+        assertFalse(plannerContext, plannerContext.contains("trash"))
+        assertFalse(plannerContext, plannerContext.contains("jeep"))
+        assertFalse(plannerContext, plannerContext.contains(PersonaNotes.KEY_PREFIX))
+    }
+
+    @Test
+    fun `notes come back newest first and ordinary memories are not notes`() = runBlocking {
+        memoryRepository.saveMemory(Memory("yumexuser_car", "not hers: the LIKE wildcard must not match", MemoryType.SEMANTIC))
+        memoryRepository.saveMemory(Memory("yume.user.car", "he drives a jeep", MemoryType.SEMANTIC, timestamp = 1_000))
+        memoryRepository.saveMemory(Memory("yume.rel.stage", "two months in, at ease", MemoryType.SEMANTIC, timestamp = 2_000))
+
+        assertEquals(listOf("stage", "car"), personaMemory.notes().map { it.key })
+    }
+
+    @Test
+    fun `a known key is replaced and a closed thread is removed`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig still missing | open")))
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig half done | open")))
+        assertEquals(listOf("rig half done | open"), personaMemory.notes().map { it.text })
+
+        personaMemory.apply(listOf(Note(Kind.THREAD, "body", "rig finished | closed")))
+        assertTrue(personaMemory.notes().isEmpty())
+    }
+
+    @Test
+    fun `seed notes are written once and an emptied notebook stays empty`() = runBlocking {
+        val seed = listOf(Note(Kind.REL, "stage", "at ease, not romance"), Note(Kind.USER, "car", "he drives a jeep"))
+        personaMemory.seedIfNeeded(seed)
+        assertEquals(2, personaMemory.notes().size)
+
+        personaMemory.notes().forEach { memoryRepository.deleteMemory(it.storageKey) }
+        personaMemory.seedIfNeeded(seed)
+        assertTrue(personaMemory.notes().isEmpty())
+    }
+
+    @Test
+    fun `the notebook is bounded and corrections outlive the cap`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.FIX, "emoji", "no emoji at the end of every line")))
+        personaMemory.apply((1..PersonaNotes.MAX_TOTAL_NOTES + 15).map { Note(Kind.OPINION, "view-$it", "view number $it") })
+
+        val notes = personaMemory.notes()
+        assertEquals(PersonaNotes.MAX_TOTAL_NOTES, notes.size)
+        assertTrue(notes.any { it.kind == Kind.FIX })
+    }
+
+    private object NoProfile : UserProfileStore {
+        override fun read(): ProfileStoreResult<UserProfile?> = ProfileStoreResult.Success(null)
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotesTest.kt
