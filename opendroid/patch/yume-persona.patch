+
+    @Test
+    fun `without captions there is no such block`() {
+        assertFalse(prompt().contains(PersonaPrompts.PICTURES_HEADING))
+        assertFalse(prompt(pictureCaptions = listOf("", "  ", "\n")).contains(PersonaPrompts.PICTURES_HEADING))
+    }
+
+    private fun pictureBlock(captions: List<String>) = prompt(pictureCaptions = captions)
+        .substringAfter(PersonaPrompts.PICTURES_HEADING + "\n").substringBefore("\n\n" + PersonaPrompts.APP_FACTS_HEADING)
+
+    @Test
+    fun `every caption her pictures can have reaches her, whole`() {
+        // As many pictures as she can have, each with a caption as long as one can be.
+        val captions = (1..PersonaPictureRules.MAX_SELF).map { n ->
+            ("picture $n: " + "x".repeat(PersonaPictureRules.MAX_CAPTION_CHARS)).take(PersonaPictureRules.MAX_CAPTION_CHARS)
+        }
+        val block = pictureBlock(captions)
+
+        assertEquals(captions.map { "- $it" }, block.lines())
+        assertTrue(block.length <= PersonaPrompts.MAX_PICTURE_LIST_CHARS)
+        assertEquals(
+            PersonaPictureRules.MAX_SELF * (PersonaPictureRules.MAX_CAPTION_CHARS + 3),
+            PersonaPrompts.MAX_PICTURE_LIST_CHARS
+        )
+        // Where the route carries no picture this list is all she has of them.
+        assertTrue(PersonaPrompts.PICTURES_HEADING.contains("this is what is on them"))
+    }
+
+    @Test
+    fun `what keeps a caption from opening a section does not push the last picture out`() {
+        // "===" is written wider in her prompt. The list counts a caption as it is stored.
+        val captions = (1..PersonaPictureRules.MAX_SELF).map { n ->
+            ("picture $n === " + "x".repeat(PersonaPictureRules.MAX_CAPTION_CHARS)).take(PersonaPictureRules.MAX_CAPTION_CHARS)
+        }
+        val lines = pictureBlock(captions).lines()
+        assertEquals(PersonaPictureRules.MAX_SELF, lines.size)
+        assertTrue(lines.last().startsWith("- picture ${PersonaPictureRules.MAX_SELF} = = = x"))
+    }
+
+    @Test
