+        assertEquals(PictureReading.Read("red hair down. gold hoops"), reading)
+        assertTrue(profile.readCount > readsBefore)
+        assertEquals(0, profile.readsOnMainThread)
+        assertTrue(sentBody().contains("You are Yume. Sam built you."))
+    }
