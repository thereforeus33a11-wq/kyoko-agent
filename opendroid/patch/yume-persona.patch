+        // 2 of 4 words: 50 percent.
+        assertFalse(PersonaActions.echoesOutsideText("alpha bravo zulu yankee", outside))
+        // 3 of 4 words: 75 percent.
+        assertTrue(PersonaActions.echoesOutsideText("alpha bravo charlie zulu", outside))
+    }
+
