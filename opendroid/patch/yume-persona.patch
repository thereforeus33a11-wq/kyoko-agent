+    }
+
+    private fun config(): LLMConfig = runBlocking { settings.llmConfig.first() }
+
+    // ── Helpers ──────────────────────────────────────────────────────────────────────
+
+    private fun answer(text: String, finishReason: String = "stop") {
+        val content = "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""
+        server.enqueue(
+            MockResponse.Builder()
+                .code(200)
+                .setHeader("Content-Type", "application/json")
+                .body("""{"choices":[{"message":{"content":$content},"finish_reason":"$finishReason"}],"usage":{"total_tokens":7}}""")
+                .build()
+        )
+    }
+
+    private fun failure() {
