+    /**
+     * What a command she starts from a moment of her own takes beyond the moment's own
+     * call, said where such a command can be carried out. The plan for it is one more
+     * call. While the plan runs it can be looked at again between its steps, and when
+     * she says results herself her line about what came of it is asked for: each of
+     * those is a call too. The day's count is a count of moments and holds none of them.
+     */
+    internal const val COMMAND_COST =
+        "a command that is carried out takes further model calls on top of the moment's own: one to plan it, " +
+            "and there can be more while the plan runs and for your line about what came of it. " +
+            "the day's count counts moments, not those calls."
+
+    /** [COMMAND_COST] without its last clause, for where his number of calls on her own counts those calls too ([costLine]). */
+    internal val COMMAND_COST_COUNTED: String = COMMAND_COST.substringBefore(" the day's count counts moments")
+
+    /** An outing starts only while this many of his calls on her own are left (the ledger's own rule). */
+    const val OUTING_NEEDS_LEFT = 20
+
+    /** How long a go: of hers waits for his yes where his settings ask him first (the host's own rule). */
+    const val OUTING_ASK_WAITS_MINUTES = 30
+
+    /**
+     * The one place the block says what her own time takes and how far his settings let
+     * it go: the call each moment is, what a command adds where one can be carried out,
+     * his two numbers, and where this moment stands among the day's. Said once, and low
+     * in the block, after what the time is for.
+     */
+    internal fun costLine(facts: MomentFacts): String = buildString {
+        val left = (facts.bounds.maxPerDay - facts.number).coerceAtLeast(0)
+        append("what this time takes, once: each moment is one model call. ")
+        append("his settings let you have at most ${facts.bounds.maxPerDay} moments in any 24 hours, ")
+        append("no two closer than ${span(facts.bounds.minGapMillis)}. this is number ${facts.number} of ${facts.bounds.maxPerDay}; ")
+        append(if (left == 1) "1 is left." else "$left are left.")
+        val life = facts.life
+        if (facts.actionsEnabled) append(' ').append(if (life != null) COMMAND_COST_COUNTED else COMMAND_COST)
+        // With her own life on, every call of hers is counted against his number of them.
+        if (life != null) {
+            val kinds = listOfNotNull(
+                "moments",
+                "commands",
+                if (life.camera != null) "each step of an outing or a look" else "each step of an outing",
+                "each picture the describer looks at for you".takeIf { life.eyes || life.camera != null }
+            )
+            append(" his settings also allow ${life.cap} model calls on your own in any 24 hours, of every kind: ")
+            append(kinds.dropLast(1).joinToString(", ")).append(", and ").append(kinds.last()).append(". ")
+            append(
+                when (val callsLeft = life.left) {
+                    null -> "how many are left cannot be read now, so no outing starts."
+                    else -> (if (callsLeft == 1) "1 is left." else "$callsLeft are left.") +
+                        " an outing starts only while $OUTING_NEEDS_LEFT or more are left" +
+                        if (life.camera != null) ", a look only while ${com.opendroid.ai.core.life.eyes.CameraLook.CALLS_NEEDED} are." else "."
+                }
+            )
+        }
+    }
