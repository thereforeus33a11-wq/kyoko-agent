+    }
+
+    /** The messages of the request that was sent last, as role and text. */
+    private fun sentMessages(): List<Pair<String, String>> {
+        val body = JsonParser.parseString(server.takeRequest().body?.utf8().orEmpty()).asJsonObject
+        return body.getAsJsonArray("messages").map { it.asJsonObject.get("role").asString to it.asJsonObject.get("content").asString }
+    }
