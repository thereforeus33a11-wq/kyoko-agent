+        assertEquals(expected, PersonaNotebookTalk.shaped(messages, heldBack = true).map { it.text })
+        assertEquals(expected, PersonaNotebookTalk.shaped(once, heldBack = true).map { it.text })
+        // A row with no words left is no exact row either: what is kept of a deleted chat is not judged by it.
+        val stubbed = listOf(
+            messages[0], messages[1].copy(text = PersonaNotebookTalk.APP_ROW_STUB), hers("mm. bright", 1_030).message, messages[4]
+        )
+        assertEquals(expected, PersonaNotebookTalk.shaped(stubbed, heldBack = true).map { it.text })
+    }
+
+    @Test
+    fun `her line about a marked result from before such lines had a badge is known for one on the page and in what is kept`() {
+        val exact = "From Mom: \"dad is back in hospital, call me\""
+        val line = "mom says dad is back in hospital, call me"
+        assertTrue(PersonaTruth.keepsFacts(exact, line, success = true))
+        val rows = listOf(
+            his("i keep bees by the way", 1_000), hers("of course you do", 1_010),
+            his("read my last message", 2_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app(exact, 2_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            hers(line, 2_020),
+            // The same in another chat, written in between: each line is judged by the row before it in its own chat.
+            app("Battery is at 80%.", 2_015, chat = "chat-2")
+        ).sortedBy { it.message.timestamp }
+        val resultBadge = PersonaPrompts.resultBadge(staysPrivate = true)
+
+        val marked = PersonaNotebookTalk.withResultLinesMarked(rows)
+        assertEquals(rows.map { it.message.text }, marked.map { it.message.text })
+        assertEquals(resultBadge, marked.single { it.message.text == line }.message.modelBadge)
+        assertEquals(rows.filterNot { it.message.text == line }, marked.filterNot { it.message.text == line })
+
+        // On the page it is no talk: it costs no room, is not among what was said, and no pass reads it.
+        val page = PersonaNotebookTalk.page(rows)
+        assertEquals(resultBadge, page.rows.single { it.message.text == line }.message.modelBadge)
+        assertEquals(listOf("i keep bees by the way", "of course you do", "read my last message"), page.said)
+        for (heldBack in listOf(true, false)) {
+            val read = PersonaNotebookTalk.dialogue(page, heldBack, zone = utc).joinToString { it.text }
+            assertFalse(read, read.contains("hospital"))
+            assertTrue(read, read.contains("i keep bees by the way"))
+        }
+        // A page with room for the three rows of talk and no more: her line goes along with the exact row,
+        // and is not left to open the next page with nothing to tell it by.
+        val small = PersonaNotebookTalk.page(rows, maxChars = 90)
+        assertEquals(rows.size, small.rows.size)
+        assertFalse(small.more)
+
+        // Of a deleted chat it is kept without its words, under the badge that says what it was.
+        val kept = PersonaNotebookTalk.toKeep(rows)
+        assertEquals("-", kept.single { it.message.id == rows.single { row -> row.message.text == line }.message.id }.message.text)
+        assertEquals(resultBadge, kept.single { it.message.id == rows.single { row -> row.message.text == line }.message.id }.message.modelBadge)
+        assertFalse(kept.joinToString { it.message.text }.contains("hospital"))
+        val later = PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(kept), heldBack = true, zone = utc).joinToString { it.text }
+        assertTrue(later, later.contains("i keep bees by the way"))
+        assertFalse(later, later.contains("hospital"))
+    }
+
+    // ── What the pass is told ────────────────────────────────────────────────────────
+
+    @Test
+    fun `the pass is told today's date, what it has read before, and which lines of its last pass were not taken`() {
+        val talk = listOf(his("the one by the river", 1_000).message, hers("ok", 1_010).message)
+        val earlier = listOf(his("my mom has surgery tomorrow", 500).message, hers("which hospital", 510).message)
+
+        val prompt = PersonaPrompts.reflectionUserPrompt(
+            notebook = "me | soda | melon soda is mine",
+            dialogue = talk,
+            today = "Tuesday, November 17, 2026",
+            earlier = earlier,
+            notTaken = listOf("mood | x1 | something i felt", "user | bees")
+        )
+
+        assertTrue(prompt.startsWith("TODAY: Tuesday, November 17, 2026 (on his clock)\n\nYOUR NOTEBOOK NOW:\nme | soda | melon soda is mine\n"))
+        assertTrue(prompt.contains(
+            "(Before this pass you wrote 2 lines the notebook could not take, so nothing of them is in it: " +
+                "mood | x1 | something i felt / user | bees. A line needs a kind from the list, a key and a note; " +
+                "the notebook takes 5 lines at a time; and a line that broke off where your answer ran out is not kept as a note.)"
+        ))
+        val before = prompt.substringAfter("EARLIER (you have read this before; it is here only so that the talk below makes sense):\n")
+            .substringBefore("\n\nTHE RECENT TALK:\n")
+        assertEquals("he: my mom has surgery tomorrow\ni: which hospital", before)
+        assertTrue(prompt.endsWith("THE RECENT TALK:\nhe: the one by the river\ni: ok\n\nYour notebook changes:"))
+
+        // Where a host could read the pass, a line that can be about him is not repeated: she is told how many
+        // there are and why. What is repeated is what PersonaNotes.quotable lets through.
+        val aboutHim: (PersonaNotes.Note) -> Boolean = PersonaNotes.aboutHim("Sam")
+        val lines = listOf(
+            "user | sister | his sister gets married in june", "me | boots | the boots are mine at last",
+            "mood | x1 | sam was in a mood", "me | sam-joke | sam laughed at it"
+        )
+        assertEquals(listOf("me | boots | the boots are mine at last"), PersonaNotes.quotable(lines, aboutHim))
+        assertEquals(lines, PersonaNotes.quotable(lines, leftOut = null))
+        fun told(shown: List<String>, heldBack: Int) = PersonaPrompts.reflectionUserPrompt(
+            "", talk, notesAboutHimHeldBack = true, notTaken = shown, notTakenHeldBack = heldBack
+        ).substringAfter("\n(Before this pass you wrote ").substringBefore(" A line needs a kind from the list")
+        val notRepeated = "not repeated here: this goes through a hosted service that can read what it is sent, " +
+            "and a line is repeated on it only when it is a note that cannot be about him."
+        assertEquals(
+            "4 lines the notebook could not take, so nothing of them is in it: me | boots | the boots are mine at last. " +
+                "The other 3 are $notRepeated",
+            told(listOf("me | boots | the boots are mine at last"), heldBack = 3)
+        )
+        assertEquals(
+            "2 lines the notebook could not take, so nothing of them is in it: me | boots | the boots are mine at last. " +
+                "The other one is $notRepeated",
+            told(listOf("me | boots | the boots are mine at last"), heldBack = 1)
+        )
+        assertEquals("a line the notebook could not take, so nothing of it is in it. It is $notRepeated", told(emptyList(), heldBack = 1))
+        assertEquals("3 lines the notebook could not take, so nothing of them is in it. They are $notRepeated", told(emptyList(), heldBack = 3))
+        val heldPrompt = PersonaPrompts.reflectionUserPrompt("", talk, notesAboutHimHeldBack = true, notTakenHeldBack = 2)
+        assertFalse(heldPrompt.contains("sister"))
+        assertTrue(heldPrompt.contains("the notebook takes 5 lines at a time"))
+
+        // With none of it given the prompt is the notebook and the talk, as it was.
+        val bare = PersonaPrompts.reflectionUserPrompt("me | soda | melon soda is mine", talk)
+        assertEquals("YOUR NOTEBOOK NOW:\nme | soda | melon soda is mine\n\nTHE RECENT TALK:\nhe: the one by the river\ni: ok\n\nYour notebook changes:", bare)
+        // A turn of several rows keeps them apart, and no line of the talk is cut here.
+        val long = "x".repeat(5_000)
+        val merged = PersonaPrompts.reflectionUserPrompt("", listOf(his("flashlight on\n$long", 1).message))
+        assertTrue(merged.contains("he: flashlight on / $long\n"))
+    }
+
+    @Test
+    fun `what the notebook prompt says about days, the talk and a blind line is what the code does`() {
+        val text = PersonaPrompts.REFLECTION_SYSTEM_PROMPT
+        assertTrue(text.contains(
+            "- A day is written as its date. What you are given to read opens with today's date, and the talk says on " +
+                "which day each part of it was said. Write \"on november 18\", never \"tomorrow\", \"yesterday\" or a bare " +
+                "weekday: those stop being true."
+        ))
+        assertTrue(PersonaPrompts.reflectionUserPrompt("", emptyList(), today = "x").startsWith("TODAY: "))
+        assertTrue(PersonaNotebookTalk.dayLabel("x").startsWith("(said on "))
+        assertTrue(text.contains(
+            "- The talk you are given is the part of your talk with him that this notebook has not read yet, oldest first, " +
+                "from every chat. The app's own lines and what you said about a result of the phone are not in it, " +
+                "except what you did yourself, which is marked as such. A line that ends in \"[cut]\" was shortened."
+        ))
+        assertEquals(" [cut]", PersonaPrompts.CUT_MARK)
+        // A blind line never replaces a note: the first is kept under key-unseen, later ones under a number.
+        assertTrue(text.contains(
+            "it is kept beside that note, with \"-unseen\" at the end of its key. If that key is taken too, a number " +
+                "follows it. A line that only says again what such a note says is not kept twice."
+        ))
+        assertTrue(text.contains(
+            "note is in plain words, at most 200 characters. One that runs a little over is kept as you wrote it; " +
+                "past 400 it is cut and ends in \"[cut]\", and a thread keeps its status."
+        ))
+        assertEquals("x".repeat(300) + " | closed", PersonaNotes.parseLine("thread | k1 | " + "x".repeat(300) + " | closed")!!.text)
+        assertTrue(PersonaNotes.parseLine("thread | k1 | " + "x".repeat(500) + " | closed")!!.text.endsWith(" [cut] | closed"))
+        assertEquals(400, PersonaNotes.parseLine("thread | k1 | " + "x".repeat(500) + " | closed")!!.text.length)
+        // The age behind a note is the notebook's, and is said to be: a thread that is still going on, a thing she saw,
+        // a me note and an opinion carry it.
+        assertTrue(text.contains(
+            "- Behind a thread that is still going on, a thing you saw, a me note and an opinion, the notebook says how old the note is, " +
+                "like \"(written 3 days ago)\". A starting note that still has the words your files gave it says \"(from your files)\" " +
+                "instead, whatever its kind. The notebook puts those there. They are not part of the note: leave them out " +
+                "when you write the note again."
+        ))
+        val dated = listOf(
+            PersonaNotes.Note(PersonaNotes.Kind.THREAD, "mom", "his mom has surgery on november 18 | open"),
+            PersonaNotes.Note(PersonaNotes.Kind.THREAD, "rig", "the rig waits for payday | stalled"),
+            PersonaNotes.Note(PersonaNotes.Kind.OPINION, "inbox", "saw: his inbox has 4,000 unread"),
+            PersonaNotes.Note(PersonaNotes.Kind.ME, "soda", "melon soda is mine"),
+            PersonaNotes.Note(PersonaNotes.Kind.OPINION, "rain", "rain is better than sun"),
+            PersonaNotes.Note(PersonaNotes.Kind.THREAD, "tab", "street story: the tab is paid | closed"),
+            PersonaNotes.Note(PersonaNotes.Kind.USER, "bees", "he keeps bees")
+        )
+        val shown = PersonaNotes.review(
+            dated, times = PersonaNotes.Times(dated.associate { it.storageKey to 0L }, nowMillis = 3 * 24 * 60 * 60_000L)
+        ).text.lines()
+        assertEquals(
+            listOf(true, true, true, true, true, false, false),
+            dated.map { note -> shown.single { it.contains(note.key) }.endsWith(" (written 3 days ago)") }
+        )
+        for (line in shown) assertEquals(dated.single { line.contains(it.key) }, PersonaNotes.parseLine(line))
+        // Where what she learns about him is filed is said, because what is filed elsewhere is what a readable route is given.
+        assertTrue(text.contains(
+            "- A me note, a fix note and a street story are about you. What you learn about him or his life is not filed " +
+                "there: it is a user note, or a thread while it is still going on."
+        ))
+        for (kind in listOf(PersonaNotes.Kind.ME, PersonaNotes.Kind.FIX)) {
+            assertFalse(PersonaNotes.canBeAboutHim(PersonaNotes.Note(kind, "key", "a note that is about her alone")))
+        }
+        assertTrue(PersonaNotes.canBeAboutHim(PersonaNotes.Note(PersonaNotes.Kind.USER, "key", "anything")))
+        assertTrue(PersonaNotes.canBeAboutHim(PersonaNotes.Note(PersonaNotes.Kind.THREAD, "key", "anything | open")))
+    }
+
+    @Test
+    fun `what she is told is left out on a readable route is what the test for a note about him leaves out`() {
+        val told = PersonaPrompts.NOTES_ABOUT_HIM_ARE
+        assertEquals(
+            "Noted about him means every note that can be about him: your notes about him and about the two of you, " +
+                "your threads and opinions that are not street stories, and any other note that speaks of him " +
+                "(he, him, his, we, us, our, or his name).",
+            told
+        )
+        fun note(kind: PersonaNotes.Kind, text: String) = PersonaNotes.Note(kind, "key", text)
+        // "your notes about him and about the two of you"
+        assertTrue(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.USER, "plain")))
+        assertTrue(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.REL, "plain")))
+        // "your threads and opinions that are not street stories"
+        assertTrue(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.THREAD, "plain | open")))
+        assertTrue(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.OPINION, "plain")))
+        assertFalse(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.THREAD, "street story: plain | open")))
+        assertFalse(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.OPINION, "street story: plain")))
+        // "any other note that speaks of him (he, him, his, we, us, our, or his name)"
+        for (word in listOf("he", "him", "his", "we", "us", "our", "Sam")) {
+            assertTrue(word, PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.ME, "plain $word plain"), ownerName = "Sam"))
+            assertTrue(word, PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.THREAD, "street story: $word | open"), ownerName = "Sam"))
+        }
+        assertFalse(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.ME, "plain"), ownerName = "Sam"))
+        // Both places that tell her say it in these words, and both add what she saw.
+        val chat = PersonaPrompts.chatSystemPrompt(
+            card = "You are Yume.", ownerName = "Sam", autoModeLabel = "OFF", relevantContext = "", notes = "",
+            deviceActivity = emptyList(), screenshotAttached = false, hostCanRead = true, notesAboutHimHeldBack = true
+        )
+        // In her chat prompt her own thoughts are left out with them, and the one sentence names both.
+        assertTrue(
+            chat.contains(
+                "so what you have noted about him, and what you saw on his screen, is left out this time, and so are " +
+                    "your own thoughts, which can be about him. $told Those notes are not gone, and neither are your thoughts"
+            )
+        )
+        val pass = PersonaPrompts.reflectionUserPrompt("", emptyList(), notesAboutHimHeldBack = true)
+        assertTrue(pass.contains("(Not shown: what you have noted about him, and what you saw on his screen."))
+        assertTrue(pass.contains("$told A new note about him is kept beside them and replaces none of them.)"))
+        assertTrue(PersonaNotes.canBeAboutHim(note(PersonaNotes.Kind.ME, "saw: plain")))
+    }
+}
