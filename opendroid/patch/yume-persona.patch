+            return if (caption.any { it.isLetterOrDigit() }) {
+                PictureReading.Read(caption, cutOff = reading.cutOff)
+            } else {
+                PictureReading.Failed(PictureReading.Reason.EMPTY)
+            }
+        }
+
+        /**
+         * The part of [readBackgroundPicture] that does not care which provider answers.
+         * The system prompt is the one neutral instruction and nothing else.
+         */
+        internal suspend fun readBackgroundPictureFrom(
+            pictureBase64: String,
+            timeoutMillis: Long = BACKGROUND_READING_TIMEOUT_MILLIS,
+            callScope: CoroutineScope,
+            complete: suspend (LLMRequest) -> LLMResponse
+        ): PictureReading = pictureReading(
+            LLMRequest(
+                systemPrompt = PersonaPrompts.BACKGROUND_READING_PROMPT,
+                messages = listOf(
+                    ChatMessage(
+                        id = UUID.randomUUID().toString(),
+                        text = PersonaPrompts.BACKGROUND_READING_TURN,
+                        sender = ChatMessage.Sender.USER,
+                        imageBase64 = pictureBase64
+                    )
+                ),
+                temperature = BACKGROUND_READING_TEMPERATURE,
+                maxTokens = BACKGROUND_READING_MAX_TOKENS,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+            ),
+            timeoutMillis,
+            callScope,
+            complete
+        )
+
+        /**
+         * Sends [request], which carries a picture, once and waits [timeoutMillis] at
+         * most. As in [resultLineFrom] the call runs in [callScope], beside the wait: a
+         * provider cannot be interrupted, and the owner gets his answer when the time is
+         * up. A reply that is a model declining is a failure, not a text about the picture.
+         * A reply that stopped at the length limit is handed back as what it is: a part.
+         */
+        private suspend fun pictureReading(
+            request: LLMRequest,
+            timeoutMillis: Long,
+            callScope: CoroutineScope,
+            complete: suspend (LLMRequest) -> LLMResponse
+        ): PictureReading {
+            val call = callScope.async(Dispatchers.IO) { complete(request) }
+            return try {
+                val response = withTimeoutOrNull(timeoutMillis) { call.await() }
+                    ?: return PictureReading.Failed(PictureReading.Reason.TOOK_TOO_LONG)
+                val text = response.content.trim()
+                when {
+                    text.isEmpty() -> PictureReading.Failed(PictureReading.Reason.EMPTY)
+                    PersonaPictureRules.isStockRefusal(text) -> PictureReading.Failed(PictureReading.Reason.DECLINED)
+                    else -> PictureReading.Read(text, cutOff = com.opendroid.ai.core.llm.FinishReason.isLength(response.finishReason))
+                }
+            } catch (e: CancellationException) {
+                // The owner left the screen: that is passed on. Otherwise it was the call
+                // that was cut short, which is a failed call like any other.
+                currentCoroutineContext().ensureActive()
+                PictureReading.Failed(PictureReading.Reason.CALL_FAILED)
+            } catch (e: LLMException) {
+                PictureReading.Failed(PictureReading.Reason.CALL_FAILED, e)
+            } catch (e: Exception) {
+                PictureReading.Failed(PictureReading.Reason.CALL_FAILED)
+            } finally {
+                call.cancel()
+            }
+        }
+
+        /** How much what she last thought counts when the pages of her files are picked for a moment of her own. */
+        private const val THOUGHT_CUE_WEIGHT = 0.5
+
+        /** What came back from one request of hers, whole, and whether it stopped at the model's length limit. */
+        internal class Answer(val text: String, val cutOff: Boolean)
+
+        /**
+         * Asks [provider] once and waits for the whole answer, on the path that says how
+         * the answer ended. A hosted provider answers in one piece and says it in the
+         * response. A model that runs on the phone hands its text on while it writes and
+         * notes a stop at the length limit only there, so that one is read as a stream.
+         * Either way the request passes the same gate and the same checks as a reply.
+         */
+        internal suspend fun answeredWhole(provider: LLMProvider, request: LLMRequest): Answer {
+            if (!provider.streamsLive) {
+                val response = provider.complete(request)
+                return Answer(response.content, FinishReason.isLength(response.finishReason))
+            }
+            val outcome = ReplyOutcome()
+            val text = StringBuilder()
+            provider.streamComplete(request.copy(outcome = outcome)).collect { text.append(it) }
+            return Answer(outcome.withoutReasoning ?: text.toString(), outcome.cutOff)
+        }
+
+        /**
+         * The request of one moment of her own: [systemPrompt] says everything, and the
+         * one turn is the app's and says so. It asks for her reply's own sampling and has
+         * the room of a reply, so that the options typed for her replies apply to it and
+         * a model that thinks before it answers still gets to write. It is made once.
+         */
+        internal fun ownTimeRequest(systemPrompt: String): LLMRequest = LLMRequest(
+            systemPrompt = systemPrompt,
+            messages = listOf(
+                ChatMessage(id = UUID.randomUUID().toString(), text = PersonaOwnTime.TURN, sender = ChatMessage.Sender.USER)
+            ),
+            temperature = CHAT_TEMPERATURE,
+            maxTokens = CHAT_MAX_TOKENS,
+            responseFormat = ResponseFormat.TEXT,
+            retryPolicy = RetryPolicy.NONE,
+            // Nobody is waiting for a reply: an answer she ends with nothing in it is hers,
+            // and no line of what she writes is taken for his next turn.
+            ownMoment = true
+        )
+
+        /**
+         * The request of one step of an outing of hers: a moment's request ([ownTimeRequest]),
+         * with sampling, room and thinking as for a moment, whose one turn says that she is
+         * out on her own ([com.opendroid.ai.core.life.OutingPrompt.TURN]), or, with [look], that
+         * she had a look of her own ([com.opendroid.ai.core.life.OutingPrompt.LOOK_TURN]).
+         */
+        /**
+         * What her library is searched by on a step on his screen, in [app]: the app named plainly,
+         * as an app, at the weight her own thoughts have in a moment, so that her pages about the
+         * app (and what she knows of apps like it) are offered while she is in it.
+         */
+        internal fun phoneCues(app: String): List<PersonaLibraryText.Cue> =
+            if (app.isBlank()) emptyList() else listOf(PersonaLibraryText.Cue("${app.lowercase()} app", THOUGHT_CUE_WEIGHT))
+
+        internal fun outingRequest(systemPrompt: String, look: Boolean = false): LLMRequest = ownTimeRequest(systemPrompt).copy(
+            messages = listOf(
+                ChatMessage(
+                    id = UUID.randomUUID().toString(),
+                    text = if (look) com.opendroid.ai.core.life.OutingPrompt.LOOK_TURN else com.opendroid.ai.core.life.OutingPrompt.TURN,
+                    sender = ChatMessage.Sender.USER
+                )
+            )
+        )
+
+        /**
+         * [request] with [pictures] on its last turn: the first as its picture, the rest after
+         * it. Unchanged without pictures. Request only: nothing of it is stored (I6).
+         */
+        internal fun withPictures(request: LLMRequest, pictures: List<String>): LLMRequest {
+            if (pictures.isEmpty() || request.messages.isEmpty()) return request
+            val last = request.messages.last()
+            val withThem = last.copy(imageBase64 = pictures.first(), moreImagesBase64 = pictures.drop(1))
+            return request.copy(messages = request.messages.dropLast(1) + withThem)
+        }
+
+        /**
+         * The request of one reply of hers to him, before it is marked as hers ([withChatModel]):
+         * plain text, her reply's sampling and her reply's room. The chat loop builds the same
+         * for her reply, with her picture or a look's turn on it where one goes.
+         */
+        internal fun replyRequest(systemPrompt: String, messages: List<ChatMessage>): LLMRequest = LLMRequest(
+            systemPrompt = systemPrompt,
+            messages = messages,
+            temperature = CHAT_TEMPERATURE,
+            maxTokens = CHAT_MAX_TOKENS,
+            responseFormat = ResponseFormat.TEXT
+        )
+
+        /** Her replies want more variety than the stock assistant's 0.5. */
+        const val CHAT_TEMPERATURE = 0.8f
+        // Room for a model that spends some of its allowance before it starts the reply,
+        // and for a reply of hers that runs long: one that hits the limit is stored
+        // marked as cut off, which should be the exception.
+        const val CHAT_MAX_TOKENS = 1200
+
+        /**
+         * Whether the options typed for her replies may change the temperature and the
+         * length of [request]. They are written for a reply in her voice, which is the one
+         * kind of call that asks for [CHAT_TEMPERATURE], with a moment of her own, which
+         * is in her voice too. Every other call of hers (her
+         * notebook, her line about a result, a plan for a command of hers) set a low
+         * temperature and a short limit so that what comes back can be parsed or checked,
+         * and keeps them whatever those options say.
+         */
+        internal fun keepsOwnSampling(request: LLMRequest): Boolean = request.temperature != CHAT_TEMPERATURE
+
+        /**
+         * [withChatModel], which needs nothing but the settings.
+         *
+         * A call in her voice (her reply, a moment of her own, her look at a picture of
+         * herself: the calls [keepsOwnSampling] lets his options steer) for which he typed
+         * no options of hers asks for her hidden thinking to be off ([LLMRequest.thinkingOff]).
+         * Options he typed for her are sent as he typed them, and nothing is added to
+         * them. Her notebook, her sleep, her line about a result and a plan for a command
+         * of hers keep thinking as they did: they are not in her voice, and what comes
+         * back of them is parsed or checked.
+         */
+        internal fun requestOfHers(request: LLMRequest, config: LLMConfig): LLMRequest {
+            val typed = config.personaChatExtraBody.trim().ifEmpty { null }
+            val ownSampling = keepsOwnSampling(request)
+            return request.copy(
+                modelOverride = config.personaChatModel.trim().ifEmpty { null },
+                extraBodyOverride = typed,
+                persona = true,
+                keepsOwnSampling = ownSampling,
+                thinkingOff = typed == null && !ownSampling
+            )
+        }
+
+        /**
+         * The provider name her replies are asked from, or null for the active provider.
+         * Null only for a blank setting: any other name is handed on, known or not.
+         */
+        internal fun chatProviderName(config: LLMConfig): String? =
+            config.personaChatProvider.trim().takeIf { it.isNotEmpty() }?.let(ProviderCatalog::canonicalName)
+
+        /** How long the owner is kept waiting for her wording of a result before the exact text is spoken. */
+        const val RESULT_LINE_TIMEOUT_MILLIS = 8_000L
+        // Her voice, with less wandering than a chat reply: the line has to keep its facts.
+        private const val RESULT_TEMPERATURE = 0.6f
+        private const val RESULT_MAX_TOKENS = 200
+
+        /**
