+        val stopped = chat.substringAfter("} catch (streamError: CancellationException) {").substringBefore("throw streamError")
+        assertTrue(stopped.contains("if (inserted && shownText.isNotBlank()) {"))
+        assertTrue(stopped.contains("text = shownText,"))
+        // The raw text is read once there, to keep the lines she had marked as her own
+        // thoughts. That is handed to her store, and nothing of it is written to the chat.
+        val keepsThoughts = "persona.withoutThoughts(currentReplyText)"
+        assertTrue(stopped.contains(keepsThoughts))
