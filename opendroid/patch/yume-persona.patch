+++ b/app/src/test/java/com/opendroid/ai/core/agent/IntentClassifierLocalDecisionTest.kt
@@ -0,0 +1,271 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Sorting his message into talk or command must not show it to a model that may not read
+ * it. Where the main model may not, the message is sorted on the phone: plain talk still
+ * reaches the reply, and a command still goes to the planner.
+ */
+class IntentClassifierLocalDecisionTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** The main model is a plain hosted one; [replyModel] is what writes her replies. */
+    private fun config(
+        policy: RoutePolicy,
+        privateMode: Boolean = true,
+        replyModel: String = "",
+        mainModel: String = "some-plain-model"
+    ) = LLMConfig(
+        routePolicy = policy,
+        privateMode = privateMode,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to mainModel),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatModel = replyModel
+    )
+
+    private val encrypted = "e2ee-gemma-4-26b-a4b-uncensored-p"
+
+    @Test
+    fun `a main route the policy refuses is never asked`() {
+        for (policy in listOf(RoutePolicy.ENCRYPTED, RoutePolicy.OWN_HARDWARE)) {
+            for (replyOnOwnRoute in listOf(true, false)) {
+                assertFalse(
+                    "$policy / $replyOnOwnRoute",
+                    IntentClassifier.mayAskModel(config(policy, replyModel = encrypted), replyOnOwnRoute)
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `a readable main route is not asked while her reply is written on a private one`() {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        assertFalse(IntentClassifier.mayAskModel(splitRoutes, replyOnOwnRoute = true))
+
+        val localReplies = config(RoutePolicy.ANY).copy(
+            personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434"
+        )
+        assertFalse(IntentClassifier.mayAskModel(localReplies, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `the main model is asked when it will read the message anyway, or may read everything`() {
+        // No reply of her own: the stock chat goes to the main model whatever is decided here.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY, replyModel = encrypted), replyOnOwnRoute = false))
+        // Her reply is on the same readable route.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY), replyOnOwnRoute = true))
+        // He switched private mode off: nothing is held back from the main route.
+        assertTrue(
+            IntentClassifier.mayAskModel(
+                config(RoutePolicy.ANY, privateMode = false, replyModel = encrypted), replyOnOwnRoute = true
+            )
+        )
+        // The main model is itself on a private route.
+        for (policy in RoutePolicy.entries.filter { it != RoutePolicy.OWN_HARDWARE }) {
+            assertTrue(
+                "$policy",
+                IntentClassifier.mayAskModel(config(policy, mainModel = encrypted), replyOnOwnRoute = true)
+            )
+        }
+        val onDevice = LLMConfig(routePolicy = RoutePolicy.OWN_HARDWARE, activeProvider = "On-Device AI")
+        assertTrue(IntentClassifier.mayAskModel(onDevice, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `plain talk is talk`() {
+        for (query in listOf(
+            "how was your day", "i am upset and want to forget it", "that makes sense", "i get it",
+            "you never listen", "we should do this together", "what's next for us", "i already told you",
+            "my alarm did not go off this morning", "are you still mad at me", "tell me a street story",
+            "ok", "", "   ", "lol", "what do you think about bees", "i will take a nap", "you remember the hive?"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a plain imperative is still talk, however it opens`() {
+        for (query in listOf(
+            "take your time", "show me", "get over here", "turn around", "make me laugh", "save me a seat",
+            "read my mind", "write me a poem about bees", "check this out", "run away with me",
+            "remember when we met", "next time bring flowers", "start over", "please get lost",
+            "hey, make up your mind", "take off your jacket and get on the bike"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a forced-action word inside plain talk does not make it a command`() {
+        for (query in listOf(
+            "i can't find the words for today", "what music did you grow up with", "you never text back",
+            "the news today made me sad", "i'll send you something later", "we should open up more",
+            "let's play a game tonight", "that film had great dialogue", "the texture of that fabric",
+            "i was playing with the idea", "i had a call with the inspector today", "my phone died on the hill",
+            "i keep searching for the right word", "did you find what you were looking for",
+            "i'd google it but i'd rather hear it from you", "phone's dying, talk later"
+        )) {
+            assertTrue("$query should still count as forced when a model is asked", IntentClassifier.isForcedAction(query))
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a call or a message to himself or to her is talk`() {
+        for (query in listOf(
+            "call me when you wake up", "text me later", "message me when you are back", "ring me tomorrow",
+            "send me a picture", "please call me", "hey, text me", "call you later", "call it a day",
+            "Call me maybe", "phone me", "send us off with a song"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+        // Someone else after the same word is a contact.
+        for (query in listOf("call my mom", "text Sam I'm late", "send Riya the list", "message the inspector")) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a command is a command`() {
+        for (query in listOf(
+            // Opening with a forced-action word, after any lead-in.
+            "call dad", "can you text Sam I'm late", "play something loud", "open the camera",
+            "send Riya the list", "find my keys", "search for hive frames", "google bee suits",
+            "please navigate home", "look up the ferry times", "translate this to french",
+            "remember this", "what did i save about the hive", "music", "ok, call dad",
+            // Something only the phone answers for, wherever the word stands.
+            "what's the weather", "turn on the flashlight", "is the wifi on", "how loud is the volume",
+            "i need a screenshot of this", "bluetooth off",
+            // Opening like a command and naming a thing on the phone.
+            "show me my calendar", "create a note about the hive", "check my email", "set a reminder for five",
+            "delete the alarm for monday", "write an email to Riya", "start a timer", "list my reminders",
+            "Please check my calendar", "could you set a reminder for the inspector",
+            "hey, can you show me my calendar", "babe, check my email", "ok now set an alarm",
+            "  >> create a note: jars", "Email Riya the list", "alarm at seven", "note: buy jars",
+            "lock the phone", "lock the screen", "read my notifications", "take a photo", "check the battery",
+            "list my apps", "read my messages", "make a call to the inspector", "pause the music"
+        )) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a thing on the phone counts as a whole word only`() {
+        for (query in listOf(
+            "show me you appreciate it", "make the apple pie", "take the filet off the heat",
+            "read the context again", "check the screenplay"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `sorting on the phone never reaches for a provider`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw AssertionError("the main model must not be asked") }
+        )
+
+        assertFalse(classifier.requiresAction("how was your day", askModel = false))
+        assertFalse(classifier.requiresAction("i get it, that makes sense", askModel = false))
+        assertFalse(classifier.requiresAction("take your time", askModel = false))
+        // A forced word does not short-cut the local sort.
+        assertFalse(classifier.requiresAction("i can't find the words for today", askModel = false))
+        assertFalse(classifier.requiresAction("call me when you wake up", askModel = false))
+        assertTrue(classifier.requiresAction("show me my calendar", askModel = false))
+        assertTrue(classifier.requiresAction("call dad", askModel = false))
+    }
+
+    @Test
+    fun `a failed call still falls back to the words instead of losing the message`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw IllegalStateException("no provider") }
+        )
+
+        // The stock offline fallback, unchanged: any action keyword anywhere.
+        assertEquals(true, classifier.requiresAction("could we take a break"))
+        assertEquals(false, classifier.requiresAction("how was your day"))
+    }
+
+    @Test
+    fun `a command is planned unless the planner's route is refused while she can still answer`() {
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        assertEquals(MessageHandling.TALK, IntentClassifier.handling(refusedMain, personaActive = true, isCommand = false))
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier.handling(refusedMain, personaActive = true, isCommand = true)
+        )
+        // Without her the stock chat would be refused on the same route: the planner's error says so.
+        assertEquals(MessageHandling.PLAN, IntentClassifier.handling(refusedMain, personaActive = false, isCommand = true))
+        // Her own route is refused too: nothing can answer, and the error names the main model.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED), personaActive = true, isCommand = true)
+        )
+        // An allowed planner plans, hosted or private.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ANY, replyModel = encrypted), personaActive = true, isCommand = true)
+        )
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED, mainModel = encrypted), personaActive = true, isCommand = true)
+        )
+    }
+
+    /** Counts how often the classifier reaches for the main model; every attempt fails. */
+    private class CountingFactory : dagger.Lazy<LLMProviderFactory> {
+        var asked = 0
+        override fun get(): LLMProviderFactory {
+            asked++
+            throw IllegalStateException("no provider in this test")
+        }
+    }
+
+    @Test
+    fun `the loop's sort asks the main model only where it may read the message`() = runBlocking {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        for (settings in listOf(splitRoutes, refusedMain)) {
+            val factory = CountingFactory()
+            val classifier = IntentClassifier(factory)
+            assertEquals(MessageHandling.TALK, classifier.sort("how was your day", settings, personaActive = true))
+            assertEquals(
+                MessageHandling.TALK,
+                classifier.sort("i can't find the words for today", settings, personaActive = true)
+            )
+            assertEquals(MessageHandling.TALK, classifier.sort("call me when you wake up", settings, personaActive = true))
+            assertEquals("${settings.routePolicy}", 0, factory.asked)
+        }
+
+        // A command: planned where the planner may be used, answered by her where it may not.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier(CountingFactory()).sort("call dad", splitRoutes, personaActive = true)
+        )
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier(CountingFactory()).sort("call dad", refusedMain, personaActive = true)
+        )
+
+        // One hosted model for everything, which reads the message anyway: it is asked.
+        val oneModel = CountingFactory()
+        IntentClassifier(oneModel).sort("how was your day", config(RoutePolicy.ANY), personaActive = true)
+        assertEquals(1, oneModel.asked)
+        // The stock chat, without her: the same.
+        val stock = CountingFactory()
+        IntentClassifier(stock).sort("how was your day", splitRoutes, personaActive = false)
+        assertEquals(1, stock.asked)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/PersonalDataResultsTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/PersonalDataResultsTest.kt
new file mode 100644
index 0000000..6429295
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PersonalDataResultsTest.kt
@@ -0,0 +1,290 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * A step result can be the text of his notifications, messages, clipboard or screen. The
+ * re-evaluation prompt lists every completed step, so on a route a host could read those
+ * results are replaced before the prompt is built.
+ */
+class PersonalDataResultsTest {
+
+    private val notifications = "Here are your recent notifications: Riya: the hive inspector comes on friday"
+
+    private fun step(
+        id: String,
+        order: Int,
+        action: String,
+        params: Map<String, String> = emptyMap(),
+        result: String? = null,
+        fallback: String = "",
+        status: StepStatus = StepStatus.COMPLETED
+    ) = PlanStep(
+        stepId = id,
+        order = order,
+        description = "step $id",
+        action = action,
+        params = params,
+        fallback = fallback,
+        status = status,
+        result = result
+    )
+
+    /** The plan's own spelling is already canonical in these fixtures. */
+    private val names: (PlanStep) -> Collection<String> = { listOf(it.action, it.fallback).filter(String::isNotBlank) }
+
+    private val plan = listOf(
+        step("s1", 1, "READ_NOTIFICATIONS", result = notifications),
+        step("s2", 2, "TOGGLE_DND", mapOf("state" to "on"), result = "Do Not Disturb is on."),
+        step("s3", 3, "DISPLAY_INFO", mapOf("message" to "You have: \$s1"), result = "You have: $notifications"),
+        step("s4", 4, "SEND_SMS", mapOf("contact" to "Riya", "message" to "\$\$s3.result"), result = "Message sent."),
+        step("s5", 5, "SET_ALARM", mapOf("time" to "07:00"), result = "Alarm set for 07:00.")
+    )
+
+    @Test
+    fun `a step that reads private data holds it, and so does every step that quotes one`() {
+        assertEquals(setOf("s1", "s3", "s4"), PersonalDataResults.stepIdsHolding(plan, names))
+    }
+
+    @Test
+    fun `plan order decides, not the order the steps are handed over in`() {
+        assertEquals(setOf("s1", "s3", "s4"), PersonalDataResults.stepIdsHolding(plan.reversed(), names))
+    }
+
+    @Test
+    fun `a fallback that reads private data counts, because it may have produced the result`() {
+        val steps = listOf(step("s1", 1, "OPEN_APP", mapOf("appName" to "Mail"), result = "Inbox: 3 unread", fallback = "READ_EMAILS"))
+        assertEquals(setOf("s1"), PersonalDataResults.stepIdsHolding(steps, names))
+    }
+
+    @Test
+    fun `the weather holds where he is only when the plan named no place`() {
+        val steps = listOf(
+            step("s1", 1, "GET_WEATHER", result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s2", 2, "GET_WEATHER", mapOf("location" to "current location"), result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s3", 3, "GET_WEATHER", mapOf("location" to "  "), result = "The current weather in Fernhill is Rain, +9°C."),
+            step("s4", 4, "GET_WEATHER", mapOf("location" to "Lisbon"), result = "The current weather in Lisbon is Sunny, +21°C.")
+        )
+
+        assertEquals(setOf("s1", "s2", "s3"), PersonalDataResults.stepIdsHolding(steps, names))
+        val shown = PersonalDataResults.heldBack(steps, PersonalDataResults.stepIdsHolding(steps, names))
+        assertFalse(shown.take(3).any { it.result!!.contains("Fernhill") })
+        assertEquals("The current weather in Lisbon is Sunny, +21°C.", shown[3].result)
+    }
+
+    @Test
+    fun `a plan that reads nothing private holds nothing back`() {
+        val steps = listOf(
+            step("s1", 1, "TOGGLE_FLASHLIGHT", result = "Flashlight turned on"),
+            step("s2", 2, "DISPLAY_INFO", mapOf("message" to "\$s1"), result = "Flashlight turned on")
+        )
+        assertTrue(PersonalDataResults.stepIdsHolding(steps, names).isEmpty())
+        assertEquals(steps, PersonalDataResults.heldBack(steps, emptySet()))
+    }
+
+    @Test
+    fun `the re-evaluation prompt gets a placeholder, never the text that was read`() {
+        val holding = PersonalDataResults.stepIdsHolding(plan, names)
+        val shown = PersonalDataResults.heldBack(plan, holding)
+        val prompt = Json.encodeToString(shown)
+
+        assertFalse(prompt, prompt.contains("Riya: the hive inspector"))
+        assertFalse(prompt, prompt.contains("hive"))
+        // What the planner needs to carry on is all still there.
+        assertEquals(plan.map { it.stepId }, shown.map { it.stepId })
+        assertEquals(plan.map { it.action }, shown.map { it.action })
+        assertEquals(plan.map { it.params }, shown.map { it.params })
+        assertTrue(shown.all { it.status == StepStatus.COMPLETED })
+        assertEquals("Do Not Disturb is on.", shown[1].result)
+        assertEquals("Alarm set for 07:00.", shown[4].result)
+        assertEquals(PersonalDataResults.placeholder(notifications), shown[0].result)
+        assertTrue(prompt, prompt.contains("kept on the phone"))
+        // The plan itself keeps the real results: later steps and the chat still use them.
+        assertEquals(notifications, plan[0].result)
+    }
+
+    @Test
+    fun `the placeholder says there was a result and how long, and nothing of what it said`() {
+        val placeholder = PersonalDataResults.placeholder(notifications)
+        assertTrue(placeholder.contains("${notifications.length} characters"))
+        assertTrue(placeholder.contains("kept on the phone"))
+        assertFalse(placeholder.contains("Riya"))
+        assertFalse(placeholder.contains('\n'))
+    }
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** Private mode is on by default: a plain hosted main model is one his details are held back from. */
+    private val hostedMain = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-plain-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1")
+    )
+    private val encryptedMain = hostedMain.copy(selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p"))
+    private val ownNetworkMain = LLMConfig(activeProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+
+    private val encode: (List<PlanStep>) -> String = { Json.encodeToString(it) }
+
+    @Test
+    fun `the re-evaluation input for a hosted main route has no result that was read`() {
+        val completed = plan.take(3)
+        val remaining = plan.drop(3).map { it.copy(status = StepStatus.PENDING, result = null) }
+
+        val input = ReEvalInputs.afterStep(hostedMain, "read my notifications and tell Riya", completed, emptyList(), remaining, names, encode)
+
+        assertFalse(input, input.contains("hive inspector"))
+        assertFalse(input, input.contains("Riya: "))
+        assertTrue(input, input.contains("kept on the phone"))
+        // What the model needs to carry on is still there.
+        assertTrue(input, input.contains("- Original goal: read my notifications and tell Riya"))
+        assertTrue(input, input.contains("Do Not Disturb is on."))
+        assertTrue(input, input.contains("- Remaining steps: ${encode(remaining)}"))
+        assertTrue(input, input.contains("- Failed steps: []"))
+    }
+
+    @Test
+    fun `on a private main route the re-evaluation input carries every result as it is`() {
+        val completed = plan.take(3)
+        for (config in listOf(encryptedMain, ownNetworkMain, hostedMain.copy(privateMode = false))) {
+            val input = ReEvalInputs.afterStep(config, "goal", completed, emptyList(), emptyList(), names, encode)
+            assertTrue(input, input.contains("- Completed steps: ${encode(completed)}"))
+            assertTrue(input, input.contains("hive inspector"))
+        }
+    }
+
+    @Test
+    fun `a quote is held back even when the step it quotes is in another list`() {
+        // The step that read is completed; the one that repeats it failed half way.
+        val completed = listOf(plan[0])
+        val failed = listOf(plan[2].copy(status = StepStatus.FAILED))
+
+        val input = ReEvalInputs.afterStep(hostedMain, "goal", completed, failed, emptyList(), names, encode)
+
+        assertFalse(input, input.contains("hive inspector"))
+    }
+
+    @Test
+    fun `the re-plan input after an unknown action holds the same results back`() {
+        val unknown = step("s6", 6, "TELEPORT", status = StepStatus.FAILED)
+        val completed = plan.take(3)
+
+        val hosted = ReEvalInputs.afterUnknownAction(hostedMain, unknown, completed, emptyList(), names, encode) { Json.encodeToString(it) }
+        assertFalse(hosted, hosted.contains("hive inspector"))
+        assertTrue(hosted, hosted.contains("kept on the phone"))
+        assertTrue(hosted, hosted.contains("TELEPORT"))
+
+        val private = ReEvalInputs.afterUnknownAction(encryptedMain, unknown, completed, emptyList(), names, encode) { Json.encodeToString(it) }
+        assertTrue(private, private.contains("- Completed steps: ${encode(completed)}"))
+    }
+
+    private val savedPick = SavedPickNotice.of("Rajan Kumar", "+9198*******")
+
+    @Test
+    fun `the notice of a saved pick is recognised wherever a result or an error carries it`() {
+        assertEquals("Using Rajan Kumar (+9198*******). ", savedPick)
+        assertTrue(SavedPickNotice.isIn(savedPick + "Call started."))
+        assertTrue(SavedPickNotice.isIn("Primary failed: ${savedPick}No signal. Fallback failed: nothing"))
+        // The name or the number may have parentheses of their own.
+        assertTrue(SavedPickNotice.isIn(SavedPickNotice.of("Riya (work)", "(555)*********") + "Message sent."))
+        assertTrue(SavedPickNotice.isIn(savedPick.trimEnd()))
+        assertFalse(SavedPickNotice.isIn("Call started."))
+        assertFalse(SavedPickNotice.isIn(null))
+
+        assertEquals(SavedPickNotice.WITHHELD + "Call started.", SavedPickNotice.withheld(savedPick + "Call started."))
+        assertEquals(
+            SavedPickNotice.WITHHELD + "Message sent.",
+            SavedPickNotice.withheld(SavedPickNotice.of("Riya (work)", "(555)*********") + "Message sent.")
+        )
+        assertEquals("Call started.", SavedPickNotice.withheld("Call started."))
+        assertFalse(SavedPickNotice.WITHHELD.contains("Rajan"))
+    }
+
+    @Test
+    fun `a readable host is told a saved pick was used and what the step did, not who it is`() {
+        val steps = listOf(
+            step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started."),
+            step("s2", 2, "SEND_SMS", mapOf("contact" to "mom", "message" to "on my way"), result = "Message sent."),
+            step("s3", 3, "SEND_WHATSAPP", mapOf("contact" to "dad", "message" to "late"), status = StepStatus.FAILED)
+                .copy(error = savedPick + "WhatsApp is not installed."),
+            // The same words from an action that looks nobody up are just its result.
+            step("s4", 4, "OPEN_APP", mapOf("appName" to "Maps"), result = "Using Maps (beta). Opened.")
+        )
+        assertEquals(setOf("s1", "s3"), PersonalDataResults.stepIdsNamingContact(steps, names))
+        assertTrue(PersonalDataResults.stepIdsHolding(steps, names).isEmpty())
+
+        val shown = PersonalDataResults.forPrompt(hostedMain, steps, canonicalNames = names)
+        val prompt = encode(shown)
+        assertFalse(prompt, prompt.contains("Rajan"))
+        assertFalse(prompt, prompt.contains("+9198"))
+        assertEquals(SavedPickNotice.WITHHELD + "Call started.", shown[0].result)
+        assertEquals("Message sent.", shown[1].result)
+        assertEquals(SavedPickNotice.WITHHELD + "WhatsApp is not installed.", shown[2].error)
+        assertEquals(steps[3], shown[3])
+        // On a private route nothing is taken out.
+        assertEquals(steps, PersonalDataResults.forPrompt(encryptedMain, steps, canonicalNames = names))
+    }
+
+    @Test
+    fun `a step that quotes a result naming a saved contact holds it too`() {
+        val steps = listOf(
+            step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started."),
+            step("s2", 2, "DISPLAY_INFO", mapOf("message" to "\$s1"), result = savedPick + "Call started.")
+        )
+        assertEquals(setOf("s2"), PersonalDataResults.stepIdsHolding(steps, names))
+        val prompt = encode(PersonalDataResults.forPrompt(hostedMain, steps, canonicalNames = names))
+        assertFalse(prompt, prompt.contains("Rajan"))
+    }
+
+    @Test
+    fun `the summary of a run that worked holds what its completed steps read or named`() {
+        assertTrue(PersonalDataResults.summaryHolds(plan, isSuccess = true, canonicalNames = names))
+        assertTrue(
+            PersonalDataResults.summaryHolds(
+                listOf(step("s1", 1, "MAKE_CALL", mapOf("contact" to "dad"), result = savedPick + "Call started.")),
+                isSuccess = true,
+                canonicalNames = names
+            )
+        )
+        val plain = listOf(
+            step("s1", 1, "TOGGLE_FLASHLIGHT", result = "Flashlight turned on"),
+            step("s2", 2, "MAKE_CALL", mapOf("contact" to "555 0100"), result = "Call started."),
+            // A step that read something and left no result adds nothing to the summary.
+            step("s3", 3, "GET_CLIPBOARD", result = " ")
+        )
+        assertFalse(PersonalDataResults.summaryHolds(plain, isSuccess = true, canonicalNames = names))
+    }
+
+    @Test
+    fun `the summary of a run that failed is the failed step's error, so only that can hold a name`() {
+        val failedCall = step("s2", 2, "MAKE_CALL", mapOf("contact" to "dad"), status = StepStatus.FAILED)
+        val steps = listOf(plan[0], failedCall.copy(error = "No signal."))
+        // The notifications were read, but a failure summary does not repeat results.
+        assertFalse(PersonalDataResults.summaryHolds(steps, isSuccess = false, canonicalNames = names))
+        assertTrue(
+            PersonalDataResults.summaryHolds(
+                listOf(plan[0], failedCall.copy(error = savedPick + "No signal.")),
+                isSuccess = false,
+                canonicalNames = names
+            )
+        )
+    }
+
+    @Test
+    fun `a step without a result is left as it is`() {
+        val steps = listOf(
+            step("s1", 1, "READ_MESSAGES", result = null, status = StepStatus.FAILED),
+            step("s2", 2, "GET_CLIPBOARD", result = "  ")
+        )
+        assertEquals(steps, PersonalDataResults.heldBack(steps, setOf("s1", "s2")))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt
new file mode 100644
index 0000000..b00d8b3
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PlanRecordTest.kt
@@ -0,0 +1,577 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStatus
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The record of a plan is built from its steps: what ran with what the handler said,
+ * what failed and why, what was only stopped and what never ran. Nothing the planner
+ * wrote about its own plan is told as a result.
+ */
+class PlanRecordTest {
+
+    private fun step(
+        id: String,
+        action: String,
+        params: Map<String, String> = emptyMap(),
+        status: StepStatus = StepStatus.PENDING,
+        result: String? = null,
+        error: String? = null,
+        description: String = "the planner's own words about this step"
+    ) = PlanStep(
+        stepId = id,
+        order = id.filter(Char::isDigit).toIntOrNull() ?: 1,
+        description = description,
+        action = action,
+        params = params,
+        status = status,
+        result = result,
+        error = error
+    )
+
+    private fun plan(vararg steps: PlanStep, goal: String = "Do what he asked, as the planner put it") = Plan(
+        planId = "p1",
+        goal = goal,
+        estimatedDuration = "",
+        estimatedSteps = steps.size,
+        steps = steps.toList(),
+        status = PlanStatus.RUNNING
+    )
+
+    private val canonical: (PlanStep) -> String = { it.action }
+
+    private val sms = step(
+        "s1", "SEND_SMS", mapOf("contact" to "Bob", "message" to "im late"),
+        status = StepStatus.COMPLETED, result = "Message sent to Bob!"
+    )
+    private val alarm = step("s2", "SET_ALARM", mapOf("time" to "07:00"))
+
+    // ── What ran ─────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a plan that worked is told in the handlers' own words, one step to a line`() {
+        val record = PlanRecord.of(
+            plan(sms, alarm.copy(status = StepStatus.COMPLETED, result = "Your alarm is set for 7:00 AM!")),
+            isSuccess = true,
+            canonicalName = canonical
+        )
+        assertEquals("Message sent to Bob!\nYour alarm is set for 7:00 AM!", record.text)
+        assertTrue(record.fromSteps)
+        assertFalse(record.stopped)
+        assertTrue(record.plainOutcome)
+        assertFalse(record.namesSteps)
+        assertNull(record.plannerWords)
+    }
+
+    @Test
+    fun `a single result is stored exactly as the handler wrote it`() {
+        val record = PlanRecord.of(plan(sms), isSuccess = true, canonicalName = canonical)
+        assertEquals("Message sent to Bob!", record.text)
+    }
+
+    @Test
+    fun `a step whose handler said nothing is named by its step line, not by the planner's goal`() {
+        val quiet = alarm.copy(status = StepStatus.COMPLETED, result = "Completed successfully.")
+        val record = PlanRecord.of(
+            plan(quiet, goal = "Send a message to everyone"),
+            isSuccess = true,
+            canonicalName = canonical
+        )
+        assertEquals("Done: set alarm.", record.text)
+        assertTrue(record.namesSteps)
+        assertFalse(record.text.contains("message", ignoreCase = true))
+        // Nothing, a bare word and raw data are no result either.
+        for (nothing in listOf(null, "", "ok", "Done.", "{\"displayed\":\"true\"}")) {
+            val text = PlanRecord.of(plan(quiet.copy(result = nothing)), true, canonical).text
+            assertEquals("result <$nothing>", "Done: set alarm.", text)
+        }
+    }
+
+    // ── What failed ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a sent message and an alarm that then failed are both told`() {
+        val record = PlanRecord.of(
+            plan(sms, alarm.copy(status = StepStatus.FAILED, error = "App 'Clock' is not installed.")),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Message sent to Bob!\nFailed: set alarm. App 'Clock' is not installed.", record.text)
+        assertTrue(record.fromSteps)
+        assertFalse(record.stopped)
+        // One part worked and one failed. "It failed" is wrong about the message, so this
+        // is not an outcome she is asked to put in her own words: it is spoken exactly.
+        assertFalse(record.plainOutcome)
+    }
+
+    @Test
+    fun `only a record that is all done or all failed has one plain outcome`() {
+        val done = sms
+        val failed = alarm.copy(status = StepStatus.FAILED, error = "App 'Clock' is not installed.")
+        val pending = step("s3", "OPEN_APP", mapOf("appName" to "Maps"))
+
+        // Nothing but steps that failed: "it failed" is true of all of it.
+        val allFailed = PlanRecord.of(
+            plan(done.copy(status = StepStatus.FAILED, result = null, error = "No SIM card."), failed),
+            isSuccess = false,
+            canonicalName = canonical
+        )
+        assertEquals("Failed: send SMS to Bob. No SIM card.\nFailed: set alarm. App 'Clock' is not installed.", allFailed.text)
+        assertTrue(allFailed.plainOutcome)
+
+        // A step that never ran is neither done nor failed, beside a failure as beside a result.
+        assertFalse(PlanRecord.of(plan(failed, pending), isSuccess = false, canonicalName = canonical).plainOutcome)
+        assertFalse(
+            PlanRecord.of(
+                plan(failed, pending.copy(status = StepStatus.FAILED, error = "Skipped: depends on failed step s2")),
+                isSuccess = false,
+                canonicalName = canonical
+            ).plainOutcome
+        )
+        // A step that was under way when the run ended may or may not have gone through.
+        assertFalse(
+            PlanRecord.of(plan(failed, pending.copy(status = StepStatus.RUNNING)), isSuccess = false, canonicalName = canonical)
+                .plainOutcome
+        )
+        // A run that only stopped, one that left a step with him and one that ran nothing have none.
+        assertFalse(PlanRecord.of(plan(done, pending), isSuccess = false, canonicalName = canonical).plainOutcome)
+        assertFalse(
+            PlanRecord.of(plan(failed), isSuccess = false, canonicalName = canonical, handedOver = { true }).plainOutcome
+        )
