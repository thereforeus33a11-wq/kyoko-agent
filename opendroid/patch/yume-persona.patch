+    /** Opens the screen: the view model is built and the text for the box is read. */
+    private fun openScreen() {
+        viewModel = PersonaPicturesViewModel(pictures, store, PersonaLibrary(context), engine, settings)
+        viewModel.loadUnderText()
+    }
+
+    /** Lets what a button started run to its end. The view model works on the main thread, which a test has to turn. */
+    private fun settle(what: String, done: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 10_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (done()) return
+            assertTrue("Timed out waiting for: $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    /** Presses a button and waits for the line it prints. */
+    private fun press(what: String, button: () -> Unit): String {
+        val before = viewModel.status
+        button()
+        settle(what) { viewModel.status != before }
+        return viewModel.status
+    }
+
+    private fun reply(text: String) = MockResponse.Builder()
+        .code(200)
+        .setHeader("Content-Type", "application/json")
+        .body("""{"choices":[{"message":{"content":"$text"}}],"usage":{"total_tokens":7}}""")
+        .build()
+
+    /** Puts pictures into the app's storage the way the store keeps them. Nothing here decodes one. */
+    private fun stored(vararg entries: PersonaPicture) {
+        pictureDirectory.mkdirs()
+        entries.forEach { File(pictureDirectory, it.file).writeBytes("picture ${it.id}".toByteArray()) }
+        File(pictureDirectory, "index.json").writeText(
+            PersonaPictureRules.encodeIndex(PersonaPictureRules.Index(pictures = entries.toList()))
+        )
+    }
+
+    private fun self(id: String, caption: String, by: CaptionBy) =
+        PersonaPicture(id = id, file = "$id.jpg", kind = Kind.SELF, caption = caption, captionBy = by)
+
+    private fun background(id: String) = PersonaPicture(id = id, file = "$id.jpg", kind = Kind.BACKGROUND)
+
+    private fun readThePicture(answer: String): String {
