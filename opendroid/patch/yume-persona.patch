+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.opendroid.ai.ui.theme.AccentCyan
+import com.opendroid.ai.ui.theme.BorderColor
+import com.opendroid.ai.ui.theme.DarkBackground
+import com.opendroid.ai.ui.theme.TextPrimary
+import com.opendroid.ai.ui.theme.TextSecondary
+import com.opendroid.ai.ui.viewmodel.ReferenceSheetsViewModel
+
+// ── "Make her reference sheets". Each sentence says what the code does, and a test holds them against it.
+
+internal const val REFERENCE_SHEETS_TITLE = "HER REFERENCE SHEETS"
+
+/** At the top: what a tap makes, from what, what is checked and what is kept. */
+internal const val REFERENCE_SHEETS_HINT =
+    "Reference sheets of her: front, back and side, each in a plain fitted base layer and in her outfit as her files have it. " +
+        "Each is made from one of her originals or masters, never from a picture a model made, on your Venice key. " +
+        "Every sheet goes through the age check before it is shown or kept, like any picture of her. " +
+        "A sheet is kept as derived, and is never a base for another picture until you approve it: then it is a master."
+
+/**
+ * "Make her reference sheets": what a tap would make and from which pictures, the price,
+ * Start or Stop, and each sheet as it comes back with Approve and Throw away.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ReferenceSheetsScreen(viewModel: ReferenceSheetsViewModel, onNavigateBack: () -> Unit) {
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(text = REFERENCE_SHEETS_TITLE, fontFamily = FontFamily.Monospace, fontWeight = FontWeight.Bold, color = TextPrimary, fontSize = 20.sp)
+                },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(imageVector = Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back", tint = TextPrimary)
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBackground)
+            )
+        },
+        containerColor = DarkBackground
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .padding(horizontal = 16.dp, vertical = 8.dp)
+                .verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            Text(text = REFERENCE_SHEETS_HINT, fontSize = 12.sp, color = TextSecondary)
+            when (val plan = viewModel.planned) {
+                is com.opendroid.ai.core.persona.ReferenceSheets.Planned.Nothing ->
+                    Text(text = plan.why, fontSize = 12.sp, color = AccentCyan)
+                is com.opendroid.ai.core.persona.ReferenceSheets.Planned.Sheets -> {
+                    Text(text = viewModel.fromLine(), fontSize = 11.sp, color = TextSecondary)
+                    com.opendroid.ai.core.persona.ReferenceSheets.missingLine(plan).takeIf { it.isNotEmpty() }?.let {
+                        Text(text = it, fontSize = 11.sp, color = TextSecondary)
+                    }
+                    Text(
+                        text = "This makes ${plan.sheets.size} sheets: about ${ReferenceSheetsViewModel.cents(viewModel.cost())} on your Venice key, and a fraction of a cent for each age check.",
+                        fontSize = 12.sp,
+                        color = TextPrimary
+                    )
+                }
+                null -> {}
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {
+                if (viewModel.running) {
+                    OutlinedButton(onClick = viewModel::stop) { Text("STOP") }
+                    CircularProgressIndicator(modifier = Modifier.padding(start = 4.dp), strokeWidth = 2.dp)
+                } else {
+                    Button(
+                        onClick = viewModel::start,
+                        enabled = viewModel.planned is com.opendroid.ai.core.persona.ReferenceSheets.Planned.Sheets
+                    ) { Text("MAKE REFERENCE SHEETS") }
+                }
+            }
+            if (viewModel.status.isNotEmpty()) Text(text = viewModel.status, fontSize = 12.sp, color = AccentCyan)
+            viewModel.rows.forEach { row -> SheetRow(row, viewModel) }
+        }
+    }
+}
+
+@Composable
+private fun SheetRow(row: ReferenceSheetsViewModel.Row, viewModel: ReferenceSheetsViewModel) {
+    val shape = RoundedCornerShape(10.dp)
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, shape)
+            .padding(8.dp),
+        horizontalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        val id = row.pictureId
+        val image by produceState<ImageBitmap?>(initialValue = null, key1 = id) {
+            value = id?.let { viewModel.thumbnail(it)?.asImageBitmap() }
+        }
+        Box(modifier = Modifier.size(96.dp).clip(RoundedCornerShape(6.dp)).border(1.dp, BorderColor, RoundedCornerShape(6.dp))) {
+            image?.let {
+                Image(bitmap = it, contentDescription = "Reference sheet: ${row.title}", contentScale = ContentScale.Fit, modifier = Modifier.fillMaxSize())
+            }
+        }
+        Column(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Text(text = row.title, fontSize = 13.sp, fontWeight = FontWeight.SemiBold, color = TextPrimary)
+            when {
+                !row.done -> Text(text = "waiting", fontSize = 11.sp, color = TextSecondary)
+                id == null -> Text(text = row.why.ifEmpty { "No picture came back." }, fontSize = 11.sp, color = TextSecondary)
+                row.approved -> Text(text = "Master · approved by you", fontSize = 11.sp, color = AccentCyan)
+                else -> Text(text = "Derived · waiting for your approval", fontSize = 11.sp, color = TextSecondary)
+            }
+            if (id != null) {
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    if (row.approved) {
+                        OutlinedButton(onClick = { viewModel.takeBack(id) }) { Text("Take back", color = TextPrimary, maxLines = 1) }
+                    } else {
+                        Button(onClick = { viewModel.approve(id) }) { Text("Approve", maxLines = 1) }
+                    }
+                    OutlinedButton(onClick = { viewModel.throwAway(id) }) { Text("Throw away", color = TextPrimary, maxLines = 1) }
+                }
+            }
+        }
+    }
+}
