+    // ── The live check ───────────────────────────────────────────────────────────────
+
+    private fun JsonElement?.obj(): JsonObject? = this?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun JsonObject.flag(vararg keys: String): Boolean? = keys.firstNotNullOfOrNull { key ->
+        get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isBoolean }?.asBoolean
+    }
+
+    private fun JsonObject.number(vararg keys: String): Int? = keys.firstNotNullOfOrNull { key ->
+        get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isNumber }?.asInt
+    }
+
+    private fun JsonObject.text(vararg keys: String): String? = keys.firstNotNullOfOrNull { key ->
+        get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+    }
+
+    /** Venice's list of text models by id, as the live check reads it; null when [json] is no such list. */
+    fun parse(json: String): Map<String, Listed>? {
+        val root = try {
+            JsonParser.parseString(json).obj()
+        } catch (e: Exception) {
+            null
+        } ?: return null
+        val data = root.get("data")?.takeIf { it.isJsonArray }?.asJsonArray ?: return null
+        val out = LinkedHashMap<String, Listed>()
+        for (element in data) {
+            val model = element.obj() ?: continue
+            val id = model.text("id")?.trim()?.lowercase()?.takeIf { MODEL_ID.matches(it) } ?: continue
+            val spec = model.get("model_spec").obj()
+            val capabilities = spec?.get("capabilities").obj() ?: model.get("capabilities").obj()
+            val privacy = (spec?.text("privacy") ?: model.text("privacy"))?.trim()?.lowercase()
+            val traits = (spec?.get("traits") ?: model.get("traits"))?.takeIf { it.isJsonArray }?.asJsonArray
+                ?.mapNotNull { it.takeIf { e -> e.isJsonPrimitive }?.asString?.lowercase() }.orEmpty()
+            val caps = Caps(
+                vision = capabilities?.flag("supportsVision") == true,
+                maxImages = capabilities?.number("maxImages") ?: if (capabilities?.flag("supportsVision") == true) 1 else 0,
+                audio = capabilities?.flag("supportsAudioInput") == true,
+                video = capabilities?.flag("supportsVideoInput") == true,
+                uncensored = traits.any { "uncensored" in it } || id.contains("uncensored")
+            )
+            out[id] = Listed(
+                private = when {
+                    privacy == null -> null
+                    privacy.startsWith("private") -> true
+                    else -> false
+                },
+                caps = caps,
+                e2ee = capabilities?.flag("supportsE2EE") == true,
+                tee = capabilities?.flag("supportsTeeAttestation") == true
+            )
+        }
+        return out
+    }
+
+    /** How one listed model is kept in the settings: a few words, nothing of anyone. */
+    fun encode(listed: Listed): String = buildList {
+        add(
+            when (listed.private) {
+                true -> "private"
+                false -> "anonymized"
+                null -> "unknown"
+            }
+        )
+        if (listed.caps.vision) add("vision")
+        if (listed.caps.maxImages > 0) add("img=${listed.caps.maxImages}")
+        if (listed.caps.audio) add("audio")
+        if (listed.caps.video) add("video")
+        if (listed.caps.uncensored) add("uncensored")
+        if (listed.e2ee) add("e2ee")
+        if (listed.tee) add("tee")
+    }.joinToString(";")
+
+    /** [encode] read back; null for what is not such a text. */
+    fun decode(text: String): Listed? {
+        val parts = text.split(';').map { it.trim() }.filter { it.isNotEmpty() }
+        val first = parts.firstOrNull() ?: return null
+        val private = when (first) {
+            "private" -> true
+            "anonymized" -> false
+            "unknown" -> null
+            else -> return null
+        }
+        val images = parts.firstOrNull { it.startsWith("img=") }?.removePrefix("img=")?.toIntOrNull() ?: 0
+        return Listed(
+            private = private,
+            caps = Caps(
+                vision = "vision" in parts,
+                maxImages = images,
+                audio = "audio" in parts,
+                video = "video" in parts,
+                uncensored = "uncensored" in parts
+            ),
+            e2ee = "e2ee" in parts,
+            tee = "tee" in parts
+        )
+    }
+
+    /** The settings with the live check's answer kept: every listed model by id, and when it was asked. */
+    fun withLive(config: LLMConfig, listing: Map<String, Listed>, atMillis: Long): LLMConfig =
+        config.copy(veniceTiers = listing.mapValues { encode(it.value) }, veniceTiersAt = atMillis)
+
+    /** What the live check found, in a line for his card. */
+    fun liveLine(config: LLMConfig, model: String): String {
+        val id = model.trim().lowercase()
+        if (config.veniceTiersAt <= 0L) return "Venice's list has not been checked on this phone yet; this build's copy of it decides."
+        val listed = live(config, id) ?: return "Venice's list, checked on this phone, does not name $id now."
+        val tier = when (listed.private) {
+            true -> "in its Private tier"
+            false -> "outside its Private tier"
+            null -> "without saying its tier"
+        }
+        val takes = buildList {
+            if (listed.caps.vision) add("pictures")
+            if (listed.caps.audio) add("sound")
+            if (listed.caps.video) add("video")
+        }
+        return "Venice's list, checked on this phone, has $id $tier" +
+            (if (takes.isEmpty()) ", text only." else ", taking " + takes.joinToString(" and ") + ".")
+    }
+}
