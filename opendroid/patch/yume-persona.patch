@@ -0,0 +1,169 @@
+package com.opendroid.ai.core.life.ears
+
+import java.io.BufferedInputStream
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.security.MessageDigest
+
+/**
+ * Puts a downloaded model in place, and says which ones are in place.
+ *
+ * Under the models' folder ([root], in the app's no-backup storage) each model has a
+ * folder of its own named by its id, with its files under the names the catalog gives
+ * them and a stamp written last. A folder without the right stamp, or with a file of the
+ * wrong size, is not a model: it is what a cut-off install left, and it is removed before
+ * the next one. Nothing is taken from a download until the download's own SHA-256 matches
+ * the pinned one; each file taken out of an archive is checked against its own pinned
+ * SHA-256 before the folder takes its name. Plain JVM code, so the same code that runs on
+ * the phone is tested and was run on the real downloads.
+ */
+object EarsModelInstaller {
+
+    /** Why an install did not happen. */
+    enum class Failure(val words: String) {
+        SIZE("the download is not the size it should be"),
+        HASH("the download failed its integrity check"),
+        ARCHIVE("the download could not be unpacked"),
+        MISSING("a file the ears need is not in the download"),
+        FILE_HASH("a file in the download failed its integrity check"),
+        STORAGE("the phone's storage could not take it"),
+        STOPPED("the install was called off"),
+    }
+
+    /** The folder [model] lives in under [root]. */
+    fun folder(root: File, model: EarsModels.Model): File = File(root, model.id)
+
+    /** The path of [name], one of [model]'s kept files, under [root]. */
+    fun file(root: File, model: EarsModels.Model, name: String): File = File(folder(root, model), name)
+
+    /** True when [model] is in place: its stamp is right and every file has its size. */
+    fun isInstalled(root: File, model: EarsModels.Model): Boolean {
+        val dir = folder(root, model)
+        val stamp = File(dir, STAMP)
+        if (!stamp.isFile) return false
+        val ok = runCatching { stamp.readText().trim() == stampFor(model) }.getOrDefault(false)
+        return ok && model.files.all { File(dir, it.name).let { f -> f.isFile && f.length() == it.size } }
+    }
+
+    /**
+     * Checks [download] (what was fetched from [EarsModels.Model.url]) and installs [model]
+     * from it. Null when it is in place; otherwise why not, and nothing of it is left.
+     * [keepGoing] is asked between chunks; false stops the install, leaving nothing.
+     */
+    fun install(root: File, model: EarsModels.Model, download: File, keepGoing: () -> Boolean = { true }): Failure? {
+        if (download.length() != model.size) return Failure.SIZE
+        val hash = try {
+            sha256(download, keepGoing)
+        } catch (e: IOException) {
+            return if (keepGoing()) Failure.STORAGE else Failure.STOPPED
+        }
+        if (!hash.equals(model.sha256, ignoreCase = true)) return Failure.HASH
+        val target = folder(root, model)
+        val draft = File(root, "${model.id}.part")
+        draft.deleteRecursively()
+        target.deleteRecursively()
+        if (!draft.mkdirs()) return Failure.STORAGE
+        try {
+            val failure = if (model.archiveDir == null) {
+                copyChecked(download, File(draft, model.files.single().name), model.files.single(), keepGoing)
+            } else {
+                unpack(model, download, draft, keepGoing)
+            }
+            if (failure != null) return failure
+            val stamp = File(draft, STAMP)
+            FileOutputStream(stamp).use { out ->
+                out.write(stampFor(model).toByteArray(Charsets.UTF_8))
+                out.fd.sync()
+            }
+            if (!draft.renameTo(target)) return Failure.STORAGE
+            return null
+        } catch (e: IOException) {
+            return if (keepGoing()) Failure.STORAGE else Failure.STOPPED
+        } finally {
+            if (draft.exists()) draft.deleteRecursively()
+        }
+    }
+
+    /** Removes [model] from [root]. True when nothing of it is left. */
+    fun remove(root: File, model: EarsModels.Model): Boolean {
+        folder(root, model).deleteRecursively()
+        File(root, "${model.id}.part").deleteRecursively()
+        return !folder(root, model).exists()
+    }
+
+    private fun unpack(model: EarsModels.Model, archive: File, into: File, keepGoing: () -> Boolean): Failure? {
+        val wanted = model.files.associateBy { "${model.archiveDir}/${it.name}" }
+        val found = HashSet<String>()
+        try {
+            Bzip2InputStream(BufferedInputStream(FileInputStream(archive), 1 shl 16)).use { bz ->
+                val tar = TarReader(bz)
+                while (true) {
+                    if (!keepGoing()) return Failure.STOPPED
+                    val entry = tar.next() ?: break
+                    val kept = wanted[entry.name.removePrefix("./")] ?: continue
+                    if (!entry.isFile || entry.size != kept.size) return Failure.FILE_HASH
+                    val out = File(into, kept.name)
+                    val failure = writeChecked(out, kept, keepGoing) { b, off, len -> tar.read(b, off, len) }
+                    if (failure != null) return failure
+                    found += kept.name
+                }
+            }
+        } catch (e: IOException) {
+            return Failure.ARCHIVE
+        }
+        return if (found.size == model.files.size) null else Failure.MISSING
+    }
+
+    private fun copyChecked(from: File, to: File, kept: EarsModels.Kept, keepGoing: () -> Boolean): Failure? =
+        FileInputStream(from).use { input -> writeChecked(to, kept, keepGoing) { b, off, len -> input.read(b, off, len) } }
+
+    private inline fun writeChecked(
+        out: File,
+        kept: EarsModels.Kept,
+        keepGoing: () -> Boolean,
+        read: (ByteArray, Int, Int) -> Int,
+    ): Failure? {
+        val digest = MessageDigest.getInstance("SHA-256")
+        val buffer = ByteArray(1 shl 16)
+        var total = 0L
+        FileOutputStream(out).use { stream ->
+            while (true) {
+                if (!keepGoing()) return Failure.STOPPED
+                val n = read(buffer, 0, buffer.size)
+                if (n < 0) break
+                stream.write(buffer, 0, n)
+                digest.update(buffer, 0, n)
+                total += n
+                if (total > kept.size) return Failure.FILE_HASH
+            }
+            stream.fd.sync()
+        }
+        if (total != kept.size) return Failure.FILE_HASH
+        return if (hex(digest.digest()).equals(kept.sha256, ignoreCase = true)) null else Failure.FILE_HASH
+    }
+
+    /** The SHA-256 of [file], in lowercase hex. */
+    fun sha256(file: File, keepGoing: () -> Boolean = { true }): String =
+        FileInputStream(file).use { sha256(it, keepGoing) }
+
+    fun sha256(input: InputStream, keepGoing: () -> Boolean = { true }): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+        val buffer = ByteArray(1 shl 16)
+        while (true) {
+            if (!keepGoing()) throw IOException("stopped")
+            val n = input.read(buffer)
+            if (n < 0) break
+            digest.update(buffer, 0, n)
+        }
+        return hex(digest.digest())
+    }
+
+    private fun hex(bytes: ByteArray): String = bytes.joinToString("") { "%02x".format(it.toInt() and 0xff) }
+
+    private fun stampFor(model: EarsModels.Model): String = "${model.id} ${model.sha256}"
+
+    private const val STAMP = "INSTALLED"
+}
