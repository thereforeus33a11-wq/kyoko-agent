+import java.io.ByteArrayOutputStream
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicBoolean
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.resume
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/** One frame through a camera of the phone, held in memory only. */
+fun interface Shutter {
+    /**
+     * One frame through [lens]. [keepGoing] is asked at every frame while the camera settles:
+     * false calls the look off, and no frame is taken. The camera is closed again before this
+     * returns, whatever came of it.
+     */
+    suspend fun take(lens: FoldState.Lens, keepGoing: () -> Boolean): Shot
+}
+
+/** What came of opening a camera for one frame. */
+sealed class Shot {
+    /**
+     * A frame, upright, as a JPEG in memory, and how it is lit ([light]). The caller zeroes
+     * [jpeg] once it is done with it. No file was written for it, and none will be.
+     */
+    class Taken(val jpeg: ByteArray, val light: CameraLook.Light) : Shot()
+
+    /** No frame, and why. */
+    data class Failed(val why: Fail) : Shot()
+
+    enum class Fail(val words: String) {
+        NOT_ALLOWED("the app may not use the camera"),
+        NO_CAMERA("the phone has no camera that faces that way"),
+        IN_USE("another app was using the camera"),
+        DISABLED("android did not let the app use the camera from where it ran: it needs his tap on Eyes and ears"),
+        TIMEOUT("the camera gave no picture in time"),
+        STOPPED("the look was called off before a picture was taken"),
+        ERROR("the camera failed")
+    }
+}
+
+/**
+ * Whether the app's service holds the camera type now (OWN_LIFE_PLAN phase 2). Android lets a
+ * service use the camera only where it was started, or promoted, while the app was in front;
+ * after a start from the background (a reboot, a restart by the system) it does not, until he
+ * taps "Eyes and ears" on its notification. Until then no camera look is offered, and the
+ * status card says "Camera: needs one tap". Held in memory: it is the service's state, not a
+ * setting.
+ */
+@Singleton
+class CameraArm @Inject constructor() {
+    private val state = MutableStateFlow(false)
+
+    /** True while the service holds the camera type. */
+    val held: StateFlow<Boolean> = state.asStateFlow()
+
+    /** What the service started or was promoted with: [yes] when its type includes the camera from the front. */
+    fun held(yes: Boolean) {
+        state.value = yes
+    }
+}
+
+/**
+ * Her camera, for her looks only: a single frame through the back or the front camera, in
+ * memory, never written anywhere (I6). It is the camera code of the phone action that takes a
+ * background photo, without its file: an [ImageReader] gives the JPEG to memory, after about a
+ * second of preview so that exposure settles, within [TIMEOUT_MILLIS]. The frame is turned
+ * upright and encoded again in memory; the bytes the camera gave are zeroed.
+ *
+ * Android shows its camera light for as long as the camera is open. The service holds the
+ * camera type only when it was started from the front ([CameraArm]); a camera Android refuses
+ * for that reason clears it.
+ *
+ * It also reads what a look needs to know about the phone at once ([phone]): the screen, the
+ * lock, a call, whether another app holds a camera, the battery and the heat; and whether
+ * something is close in front of the screen ([near]), as in a pocket or face down.
+ */
+@Singleton
+class HerCamera @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val arm: CameraArm
+) : Shutter {
+
+    private val manager: CameraManager? get() = context.getSystemService(Context.CAMERA_SERVICE) as? CameraManager
+
+    // The cameras another app holds now, by id, as Android says (CameraManager.AvailabilityCallback).
+    private val othersHold: MutableSet<String> = ConcurrentHashMap.newKeySet()
+    @Volatile private var ours: String? = null
+    private val watching = AtomicBoolean(false)
+
+    private val availability = object : CameraManager.AvailabilityCallback() {
+        override fun onCameraAvailable(cameraId: String) {
+            othersHold.remove(cameraId)
+        }
+
+        override fun onCameraUnavailable(cameraId: String) {
+            if (cameraId != ours) othersHold.add(cameraId)
+        }
+    }
+
+    /** Starts listening for other apps' use of the cameras; once is enough. */
+    fun watch() {
+        if (!watching.compareAndSet(false, true)) return
+        try {
+            manager?.registerAvailabilityCallback(availability, Handler(Looper.getMainLooper()))
+        } catch (e: Exception) {
+            watching.set(false)
+        }
+    }
+
+    /** The phone has a camera and the app may use it. */
+    fun ready(): Boolean = context.packageManager.hasSystemFeature(PackageManager.FEATURE_CAMERA_ANY) && permitted()
+
+    private fun permitted(): Boolean =
+        ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED
+
+    /** The phone as a look needs it, read now. */
+    fun phone(): CameraLook.Phone {
+        watch()
+        val power = context.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        val keyguard = context.getSystemService(Context.KEYGUARD_SERVICE) as? KeyguardManager
+        val battery = try {
+            context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        } catch (e: Exception) {
+            null
+        }
+        val level = battery?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: -1
+        val scale = battery?.getIntExtra(BatteryManager.EXTRA_SCALE, -1) ?: -1
+        val thermal = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) power?.currentThermalStatus ?: 0 else 0
+        return CameraLook.Phone(
+            screenOn = power?.isInteractive == true,
+            unlocked = keyguard != null && !keyguard.isKeyguardLocked,
+            inCall = inCall(),
+            cameraInUse = othersHold.isNotEmpty(),
+            batteryPercent = if (level >= 0 && scale > 0) level * 100 / scale else 100,
+            thermalStatus = thermal
+        )
+    }
+
+    // Ringing, on a call, or in a call of another app's (a voice or video chat).
+    private fun inCall(): Boolean {
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        if (audio != null && audio.mode != AudioManager.MODE_NORMAL && audio.mode != AudioManager.MODE_INVALID) return true
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.READ_PHONE_STATE) != PackageManager.PERMISSION_GRANTED) return false
+        return try {
+            @Suppress("DEPRECATION")
+            (context.getSystemService(Context.TELEPHONY_SERVICE) as? TelephonyManager)?.callState?.let { it != TelephonyManager.CALL_STATE_IDLE } == true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /** Whether something is close in front of the screen now, or null where it cannot be read. */
+    suspend fun near(): Boolean? {
+        val sensors = context.getSystemService(Context.SENSOR_SERVICE) as? SensorManager ?: return null
+        val proximity = sensors.getDefaultSensor(Sensor.TYPE_PROXIMITY) ?: return null
+        val value = withTimeoutOrNull(PROXIMITY_WAIT_MILLIS) {
+            suspendCancellableCoroutine<Float?> { going ->
+                val listener = object : SensorEventListener {
+                    override fun onSensorChanged(event: SensorEvent) {
+                        sensors.unregisterListener(this)
+                        if (going.isActive) going.resume(event.values.firstOrNull())
+                    }
+
+                    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) = Unit
+                }
+                going.invokeOnCancellation { sensors.unregisterListener(listener) }
+                if (!sensors.registerListener(listener, proximity, SensorManager.SENSOR_DELAY_NORMAL, Handler(Looper.getMainLooper()))) {
+                    if (going.isActive) going.resume(null)
+                }
+            }
+        } ?: return null
+        return value < proximity.maximumRange && value < NEAR_CENTIMETRES
+    }
+
+    /** What the camera holds while one frame is taken, closed when it is done. */
+    private class Parts {
+        @Volatile var camera: CameraDevice? = null
+        @Volatile var session: CameraCaptureSession? = null
+        @Volatile var preview: ImageReader? = null
+        @Volatile var still: ImageReader? = null
+
+        fun close() {
+            for (step in listOf<() -> Unit>({ session?.close() }, { camera?.close() }, { preview?.close() }, { still?.close() })) {
+                try {
+                    step()
+                } catch (e: Exception) {
+                    // Already closed.
+                }
+            }
+            session = null
+            camera = null
+            preview = null
+            still = null
+        }
+    }
+
+    private sealed class Raw {
+        class Jpeg(val bytes: ByteArray) : Raw()
+        data class Failed(val why: Shot.Fail) : Raw()
+    }
+
+    @SuppressLint("MissingPermission")
+    override suspend fun take(lens: FoldState.Lens, keepGoing: () -> Boolean): Shot {
+        if (!permitted()) return Shot.Failed(Shot.Fail.NOT_ALLOWED)
+        watch()
+        val manager = manager ?: return Shot.Failed(Shot.Fail.NO_CAMERA)
+        val id = try {
+            idFor(manager, lens)
+        } catch (e: Exception) {
+            null
+        } ?: return Shot.Failed(Shot.Fail.NO_CAMERA)
+        val characteristics = try {
+            manager.getCameraCharacteristics(id)
+        } catch (e: Exception) {
+            return Shot.Failed(Shot.Fail.ERROR)
+        }
+        val thread = HandlerThread("her-look").apply { start() }
+        val handler = Handler(thread.looper)
+        val parts = Parts()
+        ours = id
+        try {
+            val raw = withTimeoutOrNull(TIMEOUT_MILLIS) { capture(manager, id, characteristics, handler, parts, keepGoing) }
+                ?: return Shot.Failed(Shot.Fail.TIMEOUT)
+            parts.close()
+            return when (raw) {
+                is Raw.Failed -> {
+                    if (raw.why == Shot.Fail.DISABLED) arm.held(false)
+                    Shot.Failed(raw.why)
+                }
+                is Raw.Jpeg -> try {
+                    withContext(Dispatchers.Default) { upright(raw.bytes, rotation(characteristics)) }
+                } finally {
+                    raw.bytes.fill(0)
+                }
+            }
+        } finally {
+            parts.close()
+            thread.quitSafely()
+            ours = null
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    @SuppressLint("MissingPermission")
+    private suspend fun capture(
+        manager: CameraManager,
+        id: String,
+        characteristics: CameraCharacteristics,
+        handler: Handler,
+        parts: Parts,
+        keepGoing: () -> Boolean
+    ): Raw = suspendCancellableCoroutine { going ->
+        val done = AtomicBoolean(false)
+        fun finish(raw: Raw) {
+            if (done.compareAndSet(false, true) && going.isActive) {
+                going.resume(raw)
+            } else {
+                (raw as? Raw.Jpeg)?.bytes?.fill(0)
+            }
+        }
+        going.invokeOnCancellation {
+            done.set(true)
+            handler.post { parts.close() }
+        }
+        try {
+            val map = characteristics.get(CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP)
+            val stillSize = stillSize(map?.getOutputSizes(ImageFormat.JPEG).orEmpty().toList())
+            val previewSize = previewSize(map?.getOutputSizes(ImageFormat.YUV_420_888).orEmpty().toList())
+            if (stillSize == null || previewSize == null) {
+                finish(Raw.Failed(Shot.Fail.ERROR))
+                return@suspendCancellableCoroutine
+            }
+            val still = ImageReader.newInstance(stillSize.width, stillSize.height, ImageFormat.JPEG, 1).also { parts.still = it }
+            val preview = ImageReader.newInstance(previewSize.width, previewSize.height, ImageFormat.YUV_420_888, 2).also { parts.preview = it }
+            // The preview frames only let exposure settle: each is closed unread.
+            preview.setOnImageAvailableListener({ reader ->
+                try {
+                    reader.acquireLatestImage()?.close()
+                } catch (e: Exception) {
+                    // Closed meanwhile.
+                }
+            }, handler)
+            still.setOnImageAvailableListener({ reader ->
+                val image = try {
+                    reader.acquireLatestImage()
+                } catch (e: Exception) {
+                    null
+                }
+                if (image == null) {
+                    finish(Raw.Failed(Shot.Fail.ERROR))
+                } else {
+                    // Copied out and the image let go before anything else runs: the reader is closed right after.
+                    val bytes = try {
+                        val buffer = image.planes[0].buffer
+                        ByteArray(buffer.remaining()).also { buffer.get(it) }
+                    } catch (e: Exception) {
+                        null
+                    } finally {
+                        image.close()
+                    }
+                    finish(if (bytes != null) Raw.Jpeg(bytes) else Raw.Failed(Shot.Fail.ERROR))
+                }
+            }, handler)
+            manager.openCamera(id, object : CameraDevice.StateCallback() {
+                override fun onOpened(camera: CameraDevice) {
+                    parts.camera = camera
+                    if (done.get()) {
+                        parts.close()
+                        return
+                    }
+                    try {
+                        camera.createCaptureSession(listOf(preview.surface, still.surface), object : CameraCaptureSession.StateCallback() {
+                            override fun onConfigured(session: CameraCaptureSession) {
+                                parts.session = session
+                                if (done.get()) return
+                                settle(camera, session, preview, still, handler, keepGoing, done, ::finish)
+                            }
+
+                            override fun onConfigureFailed(session: CameraCaptureSession) {
+                                finish(Raw.Failed(Shot.Fail.ERROR))
+                            }
+                        }, handler)
+                    } catch (e: Exception) {
+                        finish(Raw.Failed(failOf(e)))
+                    }
+                }
+
+                override fun onDisconnected(camera: CameraDevice) {
+                    parts.camera = camera
+                    finish(Raw.Failed(Shot.Fail.IN_USE))
+                }
+
+                override fun onError(camera: CameraDevice, error: Int) {
+                    parts.camera = camera
+                    finish(
+                        Raw.Failed(
+                            when (error) {
+                                CameraDevice.StateCallback.ERROR_CAMERA_IN_USE, CameraDevice.StateCallback.ERROR_MAX_CAMERAS_IN_USE -> Shot.Fail.IN_USE
+                                CameraDevice.StateCallback.ERROR_CAMERA_DISABLED -> Shot.Fail.DISABLED
+                                else -> Shot.Fail.ERROR
+                            }
+                        )
+                    )
+                }
+            }, handler)
+        } catch (e: Exception) {
+            finish(Raw.Failed(failOf(e)))
+        }
+    }
+
+    // About a second of preview, or less once exposure has settled, then one still.
+    private fun settle(
+        camera: CameraDevice,
+        session: CameraCaptureSession,
+        preview: ImageReader,
+        still: ImageReader,
+        handler: Handler,
+        keepGoing: () -> Boolean,
+        done: AtomicBoolean,
+        finish: (Raw) -> Unit
+    ) {
+        try {
+            val previewRequest = camera.createCaptureRequest(CameraDevice.TEMPLATE_PREVIEW).apply {
+                addTarget(preview.surface)
+                set(CaptureRequest.CONTROL_MODE, CaptureRequest.CONTROL_MODE_AUTO)
+                set(CaptureRequest.CONTROL_AE_MODE, CaptureRequest.CONTROL_AE_MODE_ON)
+                set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
+            }.build()
+            val startedAt = SystemClock.elapsedRealtime()
+            val asked = AtomicBoolean(false)
+            session.setRepeatingRequest(previewRequest, object : CameraCaptureSession.CaptureCallback() {
+                override fun onCaptureCompleted(session: CameraCaptureSession, request: CaptureRequest, result: TotalCaptureResult) {
+                    if (done.get() || asked.get()) return
+                    if (!keepGoing()) {
+                        finish(Raw.Failed(Shot.Fail.STOPPED))
+                        return
+                    }
+                    val waited = SystemClock.elapsedRealtime() - startedAt
+                    if (!settled(result.get(CaptureResult.CONTROL_AE_STATE), waited)) return
+                    if (!asked.compareAndSet(false, true)) return
+                    try {
+                        session.stopRepeating()
+                        val stillRequest = camera.createCaptureRequest(CameraDevice.TEMPLATE_STILL_CAPTURE).apply {
+                            addTarget(still.surface)
+                            set(CaptureRequest.CONTROL_AE_MODE, CaptureRequest.CONTROL_AE_MODE_ON)
+                            set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
+                            // Turned upright in memory afterwards, so no orientation tag is relied on.
+                            set(CaptureRequest.JPEG_ORIENTATION, 0)
+                            set(CaptureRequest.JPEG_QUALITY, CAMERA_JPEG_QUALITY.toByte())
+                        }.build()
+                        session.capture(stillRequest, null, handler)
+                    } catch (e: Exception) {
+                        finish(Raw.Failed(failOf(e)))
+                    }
+                }
+            }, handler)
+        } catch (e: Exception) {
+            finish(Raw.Failed(failOf(e)))
+        }
+    }
+
+    private fun failOf(e: Exception): Shot.Fail = when {
+        e is SecurityException -> Shot.Fail.NOT_ALLOWED
+        e is CameraAccessException && e.reason == CameraAccessException.CAMERA_DISABLED -> Shot.Fail.DISABLED
+        e is CameraAccessException && (e.reason == CameraAccessException.CAMERA_IN_USE || e.reason == CameraAccessException.MAX_CAMERAS_IN_USE) ->
+            Shot.Fail.IN_USE
+        else -> Shot.Fail.ERROR
+    }
+
+    private fun idFor(manager: CameraManager, lens: FoldState.Lens): String? {
+        val facing = if (lens == FoldState.Lens.BACK) CameraCharacteristics.LENS_FACING_BACK else CameraCharacteristics.LENS_FACING_FRONT
+        return manager.cameraIdList.firstOrNull { manager.getCameraCharacteristics(it).get(CameraCharacteristics.LENS_FACING) == facing }
+    }
+
+    // How far the frame is turned to stand upright on the screen as it is turned now.
+    private fun rotation(characteristics: CameraCharacteristics): Int {
+        val sensor = characteristics.get(CameraCharacteristics.SENSOR_ORIENTATION) ?: 90
+        val display = try {
+            (context.getSystemService(Context.DISPLAY_SERVICE) as? DisplayManager)?.getDisplay(Display.DEFAULT_DISPLAY)?.rotation
+        } catch (e: Exception) {
+            null
+        } ?: Surface.ROTATION_0
+        val front = characteristics.get(CameraCharacteristics.LENS_FACING) == CameraCharacteristics.LENS_FACING_FRONT
+        return CameraLook.uprightDegrees(sensor, display * 90, front = front)
+    }
+
+    /** [raw] decoded, turned upright and encoded again in memory, with how it is lit. */
+    private fun upright(raw: ByteArray, degrees: Int): Shot {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(raw, 0, raw.size, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return Shot.Failed(Shot.Fail.ERROR)
+        val decoded = try {
+            BitmapFactory.decodeByteArray(
+                raw, 0, raw.size,
+                BitmapFactory.Options().apply { inSampleSize = EyesImage.sampleSize(bounds.outWidth, bounds.outHeight, MAX_FRAME_SIDE) }
+            )
+        } catch (e: OutOfMemoryError) {
+            null
+        } ?: return Shot.Failed(Shot.Fail.ERROR)
+        var turned: Bitmap? = null
+        return try {
+            turned = if (degrees % 360 == 0) decoded else Bitmap.createBitmap(
+                decoded, 0, 0, decoded.width, decoded.height, Matrix().apply { postRotate(degrees.toFloat()) }, true
+            )
+            val light = lightOf(turned)
+            val out = Zeroable()
+            try {
+                if (!turned.compress(Bitmap.CompressFormat.JPEG, CAMERA_JPEG_QUALITY, out)) return Shot.Failed(Shot.Fail.ERROR)
+                Shot.Taken(out.toByteArray(), light)
+            } finally {
+                out.wipe()
+            }
+        } catch (e: OutOfMemoryError) {
+            Shot.Failed(Shot.Fail.ERROR)
+        } catch (e: Exception) {
+            Log.w(TAG, "A frame of her look could not be made ready: ${e.javaClass.simpleName}")
+            Shot.Failed(Shot.Fail.ERROR)
+        } finally {
+            listOfNotNull(decoded, turned).distinct().forEach { if (!it.isRecycled) it.recycle() }
+        }
+    }
+
+    /** A stream in memory whose buffer is zeroed once it has been read. */
+    private class Zeroable : ByteArrayOutputStream() {
+        fun wipe() {
+            buf.fill(0)
+            reset()
+        }
+    }
+
+    companion object {
+        private const val TAG = "HerCamera"
+
+        /** The longest a look at one camera may take, from opening it to the frame. */
+        const val TIMEOUT_MILLIS = 8_000L
+
+        /** About this long of preview lets exposure settle. */
+        const val SETTLE_MILLIS = 1_000L
+
+        /** Never less preview than this, even where exposure says it has settled. */
+        const val MIN_SETTLE_MILLIS = 400L
+
+        /** The frame's long side before her eyes scale it down again. */
+        const val MAX_FRAME_SIDE = 2_048
+
+        const val CAMERA_JPEG_QUALITY = 90
+
+        private const val PROXIMITY_WAIT_MILLIS = 500L
+        private const val NEAR_CENTIMETRES = 5f
+
+        /** Whether exposure has settled for the still, after [waitedMillis] of preview. */
+        fun settled(aeState: Int?, waitedMillis: Long): Boolean {
+            if (waitedMillis >= SETTLE_MILLIS) return true
+            if (waitedMillis < MIN_SETTLE_MILLIS) return false
+            return aeState == null || aeState == CaptureResult.CONTROL_AE_STATE_CONVERGED ||
+                aeState == CaptureResult.CONTROL_AE_STATE_FLASH_REQUIRED || aeState == CaptureResult.CONTROL_AE_STATE_LOCKED
+        }
+
+        /** The still's size: the largest whose long side is at most [MAX_FRAME_SIDE], else the smallest there is. */
+        fun stillSize(sizes: List<Size>): Size? =
+            sizes.filter { max(it.width, it.height) <= MAX_FRAME_SIDE }.maxByOrNull { it.width.toLong() * it.height }
+                ?: sizes.minByOrNull { it.width.toLong() * it.height }
+
+        /** The preview's size: small, only for exposure: the smallest of at least 320 × 240, else the smallest there is. */
+        fun previewSize(sizes: List<Size>): Size? =
+            sizes.filter { it.width >= 320 && it.height >= 240 }.minByOrNull { it.width.toLong() * it.height }
+                ?: sizes.minByOrNull { it.width.toLong() * it.height }
+
+        /** How [bitmap] is lit, from a grid of its pixels. */
+        fun lightOf(bitmap: Bitmap): CameraLook.Light {
+            val across = minOf(LIGHT_GRID, bitmap.width)
+            val down = minOf(LIGHT_GRID, bitmap.height)
+            val lumas = IntArray(across * down)
+            var i = 0
+            for (y in 0 until down) {
+                val py = ((y + 0.5) * bitmap.height / down).roundToInt().coerceIn(0, bitmap.height - 1)
+                for (x in 0 until across) {
+                    val px = ((x + 0.5) * bitmap.width / across).roundToInt().coerceIn(0, bitmap.width - 1)
+                    lumas[i++] = CameraLook.luma(bitmap.getPixel(px, py))
+                }
+            }
+            return CameraLook.Light.of(lumas)
+        }
+
+        private const val LIGHT_GRID = 48
+    }
+}
