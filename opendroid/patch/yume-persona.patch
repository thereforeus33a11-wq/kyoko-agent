+            pictures = index.pictures.map {
+                if (it.id == id && it.caption != caption) it.copy(caption = caption, captionBy = by) else it
+            }
+        )
+    }
+
+    /**
+     * [text] as a caption is kept: trimmed, without empty lines, and no longer than
+     * [MAX_CAPTION_CHARS]. A longer text ends at its last whole word, not inside one.
+     */
+    fun fitCaption(text: String): String {
+        val tidy = text.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.joinToString("\n")
+        if (tidy.length <= MAX_CAPTION_CHARS) return tidy
+        val cut = tidy.take(MAX_CAPTION_CHARS)
+        // The next character tells whether the cut fell between two words anyway.
+        if (tidy[MAX_CAPTION_CHARS].isWhitespace()) return cut.trimEnd()
+        val lastGap = cut.indexOfLast { it.isWhitespace() }
+        return (if (lastGap > MAX_CAPTION_CHARS / 2) cut.take(lastGap) else cut).trimEnd()
+    }
+
+    /** The size a picture of [width] x [height] is stored at: its longer side at most [maxSide], its shape kept. */
+    fun scaledSize(width: Int, height: Int, maxSide: Int = MAX_SIDE): Pair<Int, Int> {
+        val longer = max(width, height)
+        if (width <= 0 || height <= 0 || longer <= maxSide) return width to height
+        val scale = maxSide.toDouble() / longer
+        return max(1, (width * scale).roundToInt()) to max(1, (height * scale).roundToInt())
+    }
+
+    /**
+     * By how much a picture can be shrunk while it is being decoded (a power of two)
+     * and still be at least [maxSide] on its longer side, so that a photo of many
+     * megapixels never has to be held in memory at full size.
+     */
+    fun sampleSize(width: Int, height: Int, maxSide: Int = MAX_SIDE): Int {
+        var sample = 1
+        while (max(width, height) / (sample * 2) >= maxSide) sample *= 2
+        return sample
+    }
+
+    /** Words in a message of his that are about how she looks. */
+    private val ABOUT_HER_LOOKS = Regex(
+        """\b(?:looks?|pictures?|pics?|photos?|selfies?|mirror|outfits?|wearing|hair|nails?|tan|body|face|model|render|yourself)\b""",
