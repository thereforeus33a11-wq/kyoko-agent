@@ -0,0 +1,30 @@
+package com.opendroid.ai.ui
+
+import android.app.Activity
+import android.os.Bundle
+import android.util.Log
+import com.opendroid.ai.core.service.OpenDroidService
+
+/**
+ * "Eyes and ears" on the service's notification: a transparent activity with nothing on it.
+ * Android lets the service hold the camera and the microphone only where it was started, or
+ * promoted, while the app was in front; after a reboot or a restart by the system it was
+ * not. A tap on the notification opens this, which is the app in front: the service is
+ * promoted again from here ([OpenDroidService.rearm]), and this goes at once.
+ */
+class EyesAndEarsActivity : Activity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        try {
+            OpenDroidService.rearm(this)
+        } catch (e: Exception) {
+            Log.w("EyesAndEars", "The service could not be promoted again: ${e.javaClass.simpleName}")
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        finish()
+    }
+}
