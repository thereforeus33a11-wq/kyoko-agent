+++ b/app/src/main/java/com/opendroid/ai/core/life/OutingKind.kt
@@ -0,0 +1,146 @@
+package com.opendroid.ai.core.life
+
+/**
+ * The grammar of a `go:` line: what she can go and do on her own. A closed grammar, read
+ * by code with no model call. She can read (Wikipedia, a page by its https link), go
+ * through the news from her feeds, and have one look through the phone's camera
+ * (`look [back | front | around]`, [Kind.LOOK]). A look is a moment line only, never a
+ * step verb: what she reads on an outing can therefore never reach the camera. Later
+ * phases add CHECK, SCROLL and WATCH. Anything else is [Parsed.NotRead]: it stays her
+ * thought, and her next moment says what the app reads.
+ */
+object OutingKind {
+
+    /** The mark of the line in a moment. */
+    const val MARK = "go:"
+
+    enum class Kind { READ, NEWS, LOOK }
+
+    /**
+     * Which way a camera look faces: [BACK] away from him (the default), [FRONT] toward him,
+     * [AROUND] one look each way his settings allow.
+     */
+    enum class LookAt { BACK, FRONT, AROUND }
+
+    /** Which news `news` asks for. */
+    enum class News { TOP, JAPAN, WORLD, TOPIC }
+
+    sealed class Parsed {
+        /** A reading outing: [words] to look up, or [url], an https link to open. */
+        data class Read(val words: String, val url: String?) : Parsed()
+
+        /** A news outing: [which] news, with [topic] for [News.TOPIC]. */
+        data class NewsOf(val which: News, val topic: String?) : Parsed()
+
+        /** One look through the phone's camera, facing [at]. */
+        data class Look(val at: LookAt) : Parsed()
+
+        /** A line the grammar does not read, with why. */
+        data class NotRead(val words: String, val why: Why) : Parsed()
+
+        val kind: Kind?
+            get() = when (this) {
+                is Read -> Kind.READ
+                is NewsOf -> Kind.NEWS
+                is Look -> Kind.LOOK
+                is NotRead -> null
+            }
+    }
+
+    enum class Why {
+        /** Nothing after the mark. */
+        EMPTY,
+
+        /** A verb the app does not do. */
+        UNKNOWN,
+
+        /** A link that is not https. */
+        NOT_HTTPS,
+
+        /** A kind the app can do but that is not on right now. */
+        NOT_ON
+    }
+
+    /** The longest go: line read. Longer words are cut. */
+    const val MAX_WORDS_CHARS = 200
+
+    private val READ_VERBS = Regex(
+        """^(?:read(?:\s+up)?|look\s+up|find\s+out|look\s+into)(?:\s+(?:about|on|up\s+on|into))?\b\s*(.*)$""",
+        RegexOption.IGNORE_CASE
+    )
+    private val NEWS = Regex("""^news\b\s*(?:(?:about|on|from|in)\s+)?(.*)$""", RegexOption.IGNORE_CASE)
+    /**
+     * A camera look: `look`, `look back`, `look front`, `look around`, also as `look through
+     * the back camera`, `look out` or `take a look around`. `look up`, `look into` and `look at
+     * <something>` are not looks: the first two read, the last names nothing a camera does.
+     */
+    private val LOOK = Regex(
+        """^(?:take\s+|have\s+)?(?:a\s+)?look(?:\s+(?:through|with|out\s+of)(?:\s+(?:the|your|my|his))?(?:\s+phone'?s?)?)?""" +
+            """(?:\s+(back|rear|front|selfie|around|out|outside))?(?:\s+(?:camera|cam|lens))?$""",
+        RegexOption.IGNORE_CASE
+    )
+    private val LINK = Regex("""(?i)\b([a-z][a-z0-9+.-]*)://\S+""")
+    private val STOP = Regex("""^(?:stop|end|done|enough|quit)\b[.!]*$""", RegexOption.IGNORE_CASE)
+
+    /**
+     * Reads what follows the mark of a `go:` line. [runnable] is what can run right now;
+     * a kind outside it is [Why.NOT_ON]. The words are kept as she wrote them, without
+     * quotation marks around them and without a full stop at the end.
+     */
+    fun parse(written: String, runnable: Set<Kind> = Kind.entries.toSet()): Parsed {
+        val words = clean(written)
+        if (words.isEmpty()) return Parsed.NotRead("", Why.EMPTY)
+        READ_VERBS.find(words)?.let { match ->
+            val what = clean(match.groupValues[1])
+            if (what.isEmpty()) return Parsed.NotRead(words, Why.EMPTY)
+            val parsed = readOf(what) ?: return Parsed.NotRead(words, Why.NOT_HTTPS)
+            return if (Kind.READ in runnable) parsed else Parsed.NotRead(words, Why.NOT_ON)
+        }
+        NEWS.find(words)?.let { match ->
+            val rest = clean(match.groupValues[1])
+            val parsed = when (rest.lowercase()) {
+                "" -> Parsed.NewsOf(News.TOP, null)
+                "japan", "jp", "日本" -> Parsed.NewsOf(News.JAPAN, null)
+                "world", "the world", "international", "世界" -> Parsed.NewsOf(News.WORLD, null)
+                else -> Parsed.NewsOf(News.TOPIC, rest)
+            }
+            return if (Kind.NEWS in runnable) parsed else Parsed.NotRead(words, Why.NOT_ON)
+        }
+        LOOK.matchEntire(words)?.let { match ->
+            val at = when (match.groupValues[1].lowercase()) {
+                "front", "selfie" -> LookAt.FRONT
+                "around" -> LookAt.AROUND
+                else -> LookAt.BACK
+            }
+            return if (Kind.LOOK in runnable) Parsed.Look(at) else Parsed.NotRead(words, Why.NOT_ON)
+        }
+        // A bare https link reads as reading it.
+        if (LINK.matchEntire(words) != null) {
+            val parsed = readOf(words) ?: return Parsed.NotRead(words, Why.NOT_HTTPS)
+            return if (Kind.READ in runnable) parsed else Parsed.NotRead(words, Why.NOT_ON)
+        }
+        return Parsed.NotRead(words, Why.UNKNOWN)
+    }
+
+    /** True for a `go:` that ends a running outing (`<< go: stop` in a reply of hers). */
+    fun isStop(written: String): Boolean = STOP.matches(clean(written))
+
+    /** Words with an https link among them read the link; any other link is not read. */
+    private fun readOf(what: String): Parsed.Read? {
+        val link = LINK.find(what) ?: return Parsed.Read(what, null)
+        val scheme = link.groupValues[1].lowercase()
+        if (scheme != "https") return null
+        val url = link.value.trimEnd('.', ',', ')', ']', '>', '"', '\'')
+        return Parsed.Read(what, url)
+    }
+
+    private fun clean(text: String): String {
+        var words = text.replace(Regex("""\s+"""), " ").trim()
+        val quotes = setOf('"' to '"', '“' to '”', '「' to '」', '\'' to '\'', '`' to '`')
+        for ((open, close) in quotes) {
+            if (words.length >= 2 && words.first() == open && words.last() == close) words = words.substring(1, words.length - 1).trim()
+        }
+        words = words.trimEnd('.', '!', '。', '！').trim()
+        return words.take(MAX_WORDS_CHARS).trim()
+    }
+}
