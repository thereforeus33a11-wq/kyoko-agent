+
+    /** The stock notification. */
+    val STOCK = Text("OpenDroid Active", "Listening for wake word 'OpenDroid'")
+
+    private const val PHRASES_ON_ONE_LINE = 3
+
+    /** The one line shown while the wake phrases cannot be heard without the network. */
+    const val WAKE_OFFLINE_UNAVAILABLE_LINE =
+        "Not listening for the wake phrases: this phone cannot turn speech into text offline in your language."
+
+    /**
+     * Before the settings have been read nothing is known about who talks or what is
+     * heard, so the notification carries the app's name and no line at all. Her wording
+     * would be wrong on a build that turns out to run as stock, and the stock line would
+     * claim listening under her name.
+     */
+    fun starting(appName: String): Text = Text(appName, "")
+
+    /**
+     * [herName] is her name when she is the one who talks, and null when the app runs as
+     * stock; it is handed in so that this file needs nothing from her own code.
+     * [listening] is whether the wake phrases are being heard right now, as the detector
+     * itself reports it, and [phrases] are the ones it matches against.
+     * [cannotHearOffline] is the detector saying why it hears nothing: the phone cannot
+     * turn speech into text offline and the online recogniser may not be used. The
+     * notification then says so, and how the offline language is got, whoever talks:
+     * stock used the online recogniser here, so its line about listening would be untrue.
+     */
+    fun of(herName: String?, listening: Boolean, phrases: List<String>, cannotHearOffline: Boolean = false): Text {
+        if (!listening && cannotHearOffline && phrases.isNotEmpty()) {
+            return Text(
+                herName ?: STOCK.title,
+                WAKE_OFFLINE_UNAVAILABLE_LINE,
+                "$WAKE_OFFLINE_UNAVAILABLE_LINE ${PreferredRecognizer.OFFLINE_REMEDY}"
+            )
+        }
+        if (herName == null) return STOCK
+        if (!listening || phrases.isEmpty()) return Text(herName, "The app is running.")
+        val quoted = phrases.map { "\"$it\"" }
+        val more = quoted.size - PHRASES_ON_ONE_LINE
+        val line = "Listening for " + quoted.take(PHRASES_ON_ONE_LINE).joinToString(", ") +
+            if (more > 0) " and $more more" else ""
+        return Text(herName, line, "Listening for the wake phrases " + quoted.joinToString(", ") + ".")
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt b/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt
new file mode 100644
index 0000000..cebf016
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/util/CleartextGuard.kt
@@ -0,0 +1,125 @@
+package com.opendroid.ai.core.util
+
+import com.opendroid.ai.core.llm.RouteClassifier
+import java.net.InetAddress
+import java.net.Proxy
+import java.net.UnknownServiceException
+import okhttp3.Connection
+import okhttp3.Dns
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.Response
+
+/**
+ * Refuses plain http to anything but the owner's own hardware, and refuses to write to a
+ * machine that is not his under an address that reads as his.
+ *
+ * The platform's network security policy permits cleartext in this build: a model on his
+ * own computer is usually plain http at a private address, and that policy can only name
+ * hosts, not address ranges. This puts the rule back in code for every request made with
+ * the app's shared HTTP client. Plain http goes out only to a loopback or private host,
+ * judged from the address as it is written (see [RouteClassifier.hostKind]); anything
+ * else must be https. So an endpoint typed without "https://", a model list fetched with
+ * an API key and a redirect from https to http are not sent in the clear to a public
+ * host.
+ *
+ * A name is not an address. "homeserver" or "pc.lan" reads as his own machine, and the
+ * route is labelled and judged as his own network, with nothing held back. On a network
+ * that is not his the same name can lead anywhere. So where such a name leads is looked
+ * at twice. When the name is looked up, only the addresses on this phone or a private
+ * network are kept for the connection ([HisAddressesOnly]). And once a connection is
+ * open, the machine it reached is looked at: for an address that reads as his, it has to
+ * be this phone or a private address itself ([RouteClassifier.addressKind]), whatever the
+ * scheme. If it is not, the request is refused before any of it is written
+ * ([AddressLedElsewhereException]).
+ *
+ * Installed twice on the client. As an application interceptor it refuses the address
+ * that was asked for before any connection is opened. As a network interceptor it sees
+ * each redirect as well, and the connection each request is about to be written to.
+ */
+object CleartextGuard : Interceptor {
+
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        if (!allows(request.url)) {
+            // The same kind of failure the platform's own cleartext policy raises. The
+            // address is left out: failure messages end up in logs.
+            throw UnknownServiceException("Plain http is only sent to this phone or a private address; this server needs https")
+        }
+        // Only there as a network interceptor: the connection is open, nothing is written yet.
+        val connection = chain.connection()
+        if (connection != null && readsAsHis(request.url) && !reachedHis(request.url, connection)) {
+            // Not kept for a later request either.
+            runCatching { connection.socket().close() }
+            throw AddressLedElsewhereException()
+        }
+        return chain.proceed(request)
+    }
+
+    /** True for https anywhere, and for http to a loopback or private host. */
+    fun allows(url: HttpUrl): Boolean = url.isHttps || readsAsHis(url)
+
+    /** True when the host of [url], as it is written, is this phone or a private address or name. */
+    private fun readsAsHis(url: HttpUrl): Boolean {
+        // An IPv6 address comes without its brackets here; the classifier reads it with them.
+        val host = if (':' in url.host) "[${url.host}]" else url.host
+        return RouteClassifier.hostKind(host) != RouteClassifier.HostKind.PUBLIC
+    }
+
+    private fun reachedHis(url: HttpUrl, connection: Connection): Boolean {
+        val route = connection.route()
+        // Through a proxy it is the proxy that looks a name up: where it leads cannot be seen from here.
+        if (route.proxy.type() != Proxy.Type.DIRECT && !isWrittenAddress(url.host)) return false
+        return staysHis(listOfNotNull(route.socketAddress.address, connection.socket().inetAddress))
+    }
+
+    /**
+     * True when every one of [peers], the addresses a connection says it is open to, is
+     * this phone or a private address. None at all is no proof, and counts as not his.
+     */
+    internal fun staysHis(peers: List<InetAddress>): Boolean =
+        peers.isNotEmpty() && peers.all { RouteClassifier.addressKind(it) != RouteClassifier.HostKind.PUBLIC }
+
+    private val IPV4 = Regex("""\d{1,3}(\.\d{1,3}){3}""")
+
+    /** True when [host] is an address written out, not a name that has to be looked up. */
+    private fun isWrittenAddress(host: String): Boolean = ':' in host || IPV4.matches(host)
+}
+
+/**
+ * Looks names up with [names] and, for a name that reads as the owner's own machine
+ * ("desktop.local", "pc.lan", a bare name), hands on only the addresses that are on this
+ * phone or private.
+ *
+ * A machine of his often has more than one address under its name: a private one, and
+ * a global IPv6 address from his internet provider beside it. A connection is opened to
+ * whichever comes first, and [CleartextGuard] then refuses one that reached the global
+ * address, with no second try at the private one. Choosing here means his machine is
+ * reached at its private address, and no connection at all is opened to an address that
+ * is not private under a name that reads as his.
+ *
+ * When such a name leads to no private address at all it is refused here, before a
+ * connection, with the same failure the guard raises after one. A name that does not
+ * read as his is handed on as it was looked up.
+ */
+class HisAddressesOnly(private val names: Dns = Dns.SYSTEM) : Dns {
+
+    override fun lookup(hostname: String): List<InetAddress> {
+        val found = names.lookup(hostname)
+        if (RouteClassifier.hostKind(hostname) == RouteClassifier.HostKind.PUBLIC) return found
+        val his = found.filter { RouteClassifier.addressKind(it) != RouteClassifier.HostKind.PUBLIC }
+        if (his.isEmpty()) throw AddressLedElsewhereException()
+        return his
+    }
+}
+
+/**
+ * The address reads as the owner's own (a private name, a private address behind a
+ * proxy), and where it led is neither this phone nor a private address: the name was
+ * looked up to no such address, or the machine a connection reached is at none. The
+ * request was not written to it. The address is left out of the message: failure
+ * messages end up in logs.
+ */
+class AddressLedElsewhereException : UnknownServiceException(
+    "The address reads as this phone or a private network, but it led to a machine on neither; the request was not sent to it"
+)
