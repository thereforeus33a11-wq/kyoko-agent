index 0000000..3fc2d5f
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/WakeWordDetectorHearingTest.kt
@@ -0,0 +1,346 @@
+package com.opendroid.ai.core.voice
+
+import android.content.Context
+import android.os.Bundle
+import android.os.Looper
+import android.speech.SpeechRecognizer
+import androidx.test.core.app.ApplicationProvider
+import java.util.concurrent.TimeUnit
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowSpeechRecognizer
+
+/**
+ * The detector itself says whether the wake phrases are being heard, and the permanent
+ * notification is worded from that. It is true only once a recogniser has listened, and
+ * false again when the detector is stopped, when the microphone is refused, and on a
+ * phone that has no recogniser: none of which shows in the settings.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class WakeWordDetectorHearingTest {
+
+    private val context: Context = ApplicationProvider.getApplicationContext()
+
+    // The recognisers the detector was handed, one per round, in order.
+    private val given = mutableListOf<SpeechRecognizer>()
+    private var phoneHasRecognizer = true
+
+    /** Stands in for the phone: hands out a recogniser, or none when the phone has none. */
+    private val phone: (Context, Boolean) -> PreferredRecognizer.Handle? = { ctx, _ ->
+        if (phoneHasRecognizer) {
+            PreferredRecognizer.Handle(SpeechRecognizer.createSpeechRecognizer(ctx).also { given += it }, onDevice = false)
+        } else {
+            null
+        }
+    }
+
+    // What the detector reported, in order.
+    private val told = mutableListOf<Boolean>()
+
+    private fun detector() = WakeWordDetector(context, phone).also { it.onHearingChanged = { hearing -> told += hearing } }
+
+    private fun idle() = shadowOf(Looper.getMainLooper()).idle()
+
+    /** A round has ended: the next one starts a second later. */
+    private fun nextRound() = shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+
+    private fun ready() = shadowOf(given.last()).triggerOnReadyForSpeech(Bundle())
+
+    private fun fails(error: Int) = shadowOf(given.last()).triggerOnError(error)
+
+    private fun heard(text: String) = Bundle().apply {
+        putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf(text))
+    }
+
+    @After
+    fun tearDown() {
+        ShadowSpeechRecognizer.reset()
+    }
+
+    @Test
+    fun `it hears only once a recogniser has listened, and stays so from one round to the next`() {
+        val detector = detector()
+        assertFalse(detector.isHearing)
+
+        detector.startListening { }
+        idle()
+        // Started, and nothing has listened yet.
+        assertFalse(detector.isHearing)
+        assertEquals(emptyList<Boolean>(), told)
+
+        ready()
+        assertTrue(detector.isHearing)
+        assertEquals(listOf(true), told)
+
+        // Silence ends the round. The loop goes on, and so does the hearing.
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        assertTrue(detector.isHearing)
+        nextRound()
+        assertEquals(2, given.size)
+        ready()
+        fails(SpeechRecognizer.ERROR_NO_MATCH)
+        nextRound()
+        assertTrue(detector.isHearing)
+        // Told once, not once a round.
+        assertEquals(listOf(true), told)
+        detector.destroy()
+    }
+
+    @Test
+    fun `a recogniser that reports silence without ever saying it was ready has listened all the same`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+
+        assertTrue(detector.isHearing)
+        detector.destroy()
+    }
+
+    @Test
+    fun `while the detector is stopped nothing is heard, and it says so at once`() {
+        val detector = detector()
+        var woken = 0
+        // What the service does when the phrase is heard: it stops the detector to take the command down.
+        detector.startListening {
+            woken++
+            detector.stopListening()
+        }
+        idle()
+        ready()
+        assertTrue(detector.isHearing)
+
+        shadowOf(given.last()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+
+        assertEquals(1, woken)
+        assertFalse(detector.isHearing)
+        assertEquals(listOf(true, false), told)
+
+        // The command is done and the detector is started again: heard again once a round listens.
+        detector.startListening { }
+        idle()
+        assertFalse(detector.isHearing)
+        ready()
+        assertTrue(detector.isHearing)
+        assertEquals(listOf(true, false, true), told)
+        detector.destroy()
+    }
+
+    @Test
+    fun `without the microphone nothing is heard, and it is once he grants it, with no setting touched`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+
+        // Every round ends at once: the recogniser may not use the microphone.
+        repeat(3) {
+            fails(SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS)
+            assertFalse(detector.isHearing)
+            nextRound()
+        }
+        assertEquals(emptyList<Boolean>(), told)
+
+        // He grants it on the permissions screen. The round that is running listens.
+        ready()
+        assertTrue(detector.isHearing)
+        assertEquals(listOf(true), told)
+        detector.destroy()
+    }
+
+    @Test
+    fun `on a phone with no recogniser nothing is ever heard`() {
+        phoneHasRecognizer = false
+        val detector = detector()
+
+        detector.startListening { }
+        idle()
+        repeat(3) { nextRound() }
+
+        assertTrue(given.isEmpty())
+        assertFalse(detector.isHearing)
+        assertEquals(emptyList<Boolean>(), told)
+        detector.destroy()
+    }
+
+    @Test
+    fun `one round that stumbles between good ones is not the room going unheard, two in a row are`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+        ready()
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        nextRound()
+
+        // The recogniser is busy once, on a restart.
+        fails(SpeechRecognizer.ERROR_RECOGNIZER_BUSY)
+        assertTrue(detector.isHearing)
+        nextRound()
+        ready()
+        assertTrue(detector.isHearing)
+        assertEquals(listOf(true), told)
+
+        // Two rounds in a row that never listened: now it is not hearing, and says so.
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        nextRound()
+        fails(SpeechRecognizer.ERROR_AUDIO)
+        nextRound()
+        assertTrue(detector.isHearing)
+        fails(SpeechRecognizer.ERROR_AUDIO)
+        assertFalse(detector.isHearing)
+        assertEquals(listOf(true, false), told)
+
+        // And it hears again as soon as a round listens.
+        nextRound()
+        ready()
+        assertTrue(detector.isHearing)
+        assertEquals(listOf(true, false, true), told)
+        detector.destroy()
+    }
+
+    @Test
+    fun `a speech service that opens the microphone and then says it cannot work offline is not hearing, and the reason stays`() {
+        // The detector is built without leave for the online recogniser, as the service
+        // builds it under every policy but "Any model".
+        val detector = detector()
+        detector.startListening { }
+        idle()
+
+        // Round one: the service reports ready, and then answers the offline request.
+        ready()
+        fails(SpeechRecognizer.ERROR_NETWORK)
+        assertTrue(detector.cannotHearOffline)
+        // One such round could be a stumble. The second in a row is the room going unheard.
+        nextRound()
+        ready()
+        fails(13)
+        assertFalse(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+        val settled = told.size
+
+        // From then on nothing changes, round after round: "ready" proves nothing while
+        // every round ends the same way, and the notification is not built again.
+        repeat(4) { round ->
+            nextRound()
+            ready()
+            assertFalse("round $round, ready", detector.isHearing)
+            assertTrue("round $round, ready", detector.cannotHearOffline)
+            fails(if (round % 2 == 0) SpeechRecognizer.ERROR_SERVER else 12)
+            assertFalse("round $round", detector.isHearing)
+            assertTrue("round $round", detector.cannotHearOffline)
+        }
+        assertEquals(settled, told.size)
+        // What the permanent notification is worded from: not listening, and why.
+        val shown = com.opendroid.ai.core.service.ServiceNotificationText.of(
+            herName = "Yume",
+            listening = detector.isHearing,
+            phrases = detector.phrases,
+            cannotHearOffline = detector.cannotHearOffline
+        )
+        assertEquals(com.opendroid.ai.core.service.ServiceNotificationText.WAKE_OFFLINE_UNAVAILABLE_LINE, shown.line)
+
+        // The offline language is downloaded. Ready still proves nothing; a round that
+        // listens to its end does, and the reason is gone with it.
+        nextRound()
+        ready()
+        assertFalse(detector.isHearing)
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        assertTrue(detector.isHearing)
+        assertFalse(detector.cannotHearOffline)
+        detector.destroy()
+    }
+
+    @Test
+    fun `one such answer between good rounds is a stumble, and the next round that listens takes the reason back`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+        ready()
+        fails(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        nextRound()
+
+        ready()
+        fails(SpeechRecognizer.ERROR_SERVER)
+        assertTrue(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+
+        nextRound()
+        ready()
+        // Not taken back by the microphone opening, only by a round that came to its end.
+        assertTrue(detector.cannotHearOffline)
+        fails(SpeechRecognizer.ERROR_NO_MATCH)
+        assertTrue(detector.isHearing)
+        assertFalse(detector.cannotHearOffline)
+
+        // Words coming back take it back as well.
+        nextRound()
+        ready()
+        fails(13)
+        assertTrue(detector.cannotHearOffline)
+        nextRound()
+        shadowOf(given.last()).triggerOnResults(heard("nothing like the phrase"))
+        assertTrue(detector.isHearing)
+        assertFalse(detector.cannotHearOffline)
+        detector.destroy()
+    }
+
+    @Test
+    fun `a round that handed over words has heard the room, whatever error ends it`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+
+        // Some speech services write the first words down on the phone and want the
+        // network for the rest. The wake phrase is matched on those first words.
+        repeat(3) { round ->
+            ready()
+            shadowOf(given.last()).triggerOnPartialResults(heard("nothing like the phrase"))
+            fails(SpeechRecognizer.ERROR_NETWORK)
+            assertTrue("round $round", detector.isHearing)
+            assertFalse("round $round", detector.cannotHearOffline)
+            nextRound()
+        }
+        // Told once that it hears, and nothing after that.
+        assertEquals(listOf(true), told)
+
+        // A partial result with no words in it says no more than "ready" does.
+        ready()
+        fails(13)
+        nextRound()
+        ready()
+        fails(13)
+        assertFalse(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+        nextRound()
+        shadowOf(given.last()).triggerOnPartialResults(heard(""))
+        assertFalse(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+        shadowOf(given.last()).triggerOnPartialResults(Bundle())
+        assertFalse(detector.isHearing)
+        assertTrue(detector.cannotHearOffline)
+        detector.destroy()
+    }
+
+    @Test
+    fun `a detector that is destroyed hears nothing and tells nobody any more`() {
+        val detector = detector()
+        detector.startListening { }
+        idle()
+        ready()
+        assertEquals(listOf(true), told)
+
+        detector.destroy()
+
+        assertFalse(detector.isHearing)
+        // The service it reported to is going away with it: no notification is posted after that.
+        assertEquals(listOf(true), told)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/WakeWordMatcherTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/WakeWordMatcherTest.kt
new file mode 100644
index 0000000..403e162
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/WakeWordMatcherTest.kt
@@ -0,0 +1,94 @@
+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class WakeWordMatcherTest {
+
+    @Test
+    fun `stock phrases still wake the app`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = false)
+        assertEquals(WakeWordMatcher.STOCK_PHRASES, phrases)
+        assertTrue(WakeWordMatcher.matches("hey OpenDroid what time is it", phrases))
+        assertTrue(WakeWordMatcher.matches("Open  Droid", phrases))
+        assertFalse(WakeWordMatcher.matches("open the door", phrases))
+    }
+
+    @Test
+    fun `persona phrases are added in front of the stock ones`() {
+        val phrases = WakeWordMatcher.resolve("  ", personaEnabled = true)
+        assertTrue(WakeWordMatcher.matches("Hey Yume", phrases))
+        assertTrue(WakeWordMatcher.matches("ok yumi", phrases))
+        assertTrue(WakeWordMatcher.matches("opendroid", phrases))
+    }
+
+    @Test
+    fun `the bare name inside ordinary speech does not wake it`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = true)
+        assertFalse(WakeWordMatcher.matches("you may want to sit down", phrases))
+        assertFalse(WakeWordMatcher.matches("it is between you and me", phrases))
+        // Someone else talking, or a message being read aloud, must not wake it either.
+        assertFalse(WakeWordMatcher.matches("hey, you may want to call me back", phrases))
+        assertFalse(WakeWordMatcher.matches("hey you me and sam should meet", phrases))
+        assertFalse(WakeWordMatcher.matches("hey u may be right", phrases))
+    }
+
+    @Test
+    fun `a phrase counts only where it stands as whole words`() {
+        val phrases = listOf("hey yume", "you may")
+        assertTrue(WakeWordMatcher.matches("hey yume", phrases))
+        assertTrue(WakeWordMatcher.matches("so, hey yume, lights", phrases))
+        assertTrue(WakeWordMatcher.matches("Hey Yume!", phrases))
+        // The same letters inside longer words are someone else's sentence.
+        assertFalse(WakeWordMatcher.matches("they yumeko called", phrases))
+        assertFalse(WakeWordMatcher.matches("hey yumeko", phrases))
+        assertFalse(WakeWordMatcher.matches("thank you maybe later", phrases))
+        assertTrue(WakeWordMatcher.matches("thank you. you may go", phrases))
+        // A later whole occurrence still counts after an earlier partial one.
+        assertTrue(WakeWordMatcher.matches("hey yumeko said hey yume", phrases))
+        assertFalse(WakeWordMatcher.matches("openDroidish", WakeWordMatcher.STOCK_PHRASES))
+        assertFalse(WakeWordMatcher.matches("reopendroid", WakeWordMatcher.STOCK_PHRASES))
+    }
+
+    @Test
+    fun `his own phrases are added to the built-in ones, never put in their place`() {
+        val phrases = WakeWordMatcher.resolve("Computer, hey  jarvis;\nok", personaEnabled = true)
+        assertEquals(WakeWordMatcher.PERSONA_PHRASES + WakeWordMatcher.STOCK_PHRASES + listOf("computer", "hey jarvis"), phrases)
+        assertTrue(WakeWordMatcher.matches("Hey Jarvis lights", phrases))
+        // Adding a spelling cannot leave the phone deaf to her name.
+        assertTrue(WakeWordMatcher.matches("hey yume", phrases))
+        assertTrue(WakeWordMatcher.matches("opendroid", phrases))
+
+        val stock = WakeWordMatcher.resolve("computer", personaEnabled = false)
+        assertEquals(WakeWordMatcher.STOCK_PHRASES + "computer", stock)
+        // One he enters that is already built in is not listed twice.
+        assertEquals(
+            WakeWordMatcher.PERSONA_PHRASES + WakeWordMatcher.STOCK_PHRASES,
+            WakeWordMatcher.resolve("Hey Yume, opendroid", personaEnabled = true)
+        )
+    }
+
+    @Test
+    fun `a phrase of his own needs two words or at least five letters`() {
+        assertEquals(
+            listOf("you may", "yumei", "hey yu", "computer"),
+            WakeWordMatcher.parse("yum, ok, you may, yume, yumei, hey yu, a b, computer, 12345, ,")
+                .filterNot { it == "a b" }
+        )
+        // Two words pass however short; one word needs five letters, and digits are not letters.
+        assertTrue(WakeWordMatcher.parse("a b").isNotEmpty())
+        assertTrue(WakeWordMatcher.parse("yume").isEmpty())
+        assertTrue(WakeWordMatcher.parse("12345").isEmpty())
+        assertEquals(5, WakeWordMatcher.MIN_SINGLE_WORD_LETTERS)
+        // "yum" can therefore never be heard in "yummy".
+        assertFalse(WakeWordMatcher.matches("that was yummy", WakeWordMatcher.resolve("yum", personaEnabled = true)))
+    }
+
+    @Test
+    fun `blank input never matches`() {
+        assertFalse(WakeWordMatcher.matches("", WakeWordMatcher.STOCK_PHRASES))
+        assertFalse(WakeWordMatcher.matches("hello", emptyList()))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/own/JapanesePhonemesTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/own/JapanesePhonemesTest.kt
new file mode 100644
index 0000000..5490c36
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/own/JapanesePhonemesTest.kt
@@ -0,0 +1,93 @@
+package com.opendroid.ai.core.voice.own
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The phone must give her voice exactly the phonemes it was trained on. These cases were
+ * made by Piper's own phonemize_japanese.py over pyopenjtalk 0.4.1, the same front end
+ * the phone runs (its labels are checked against pyopenjtalk's separately): the text,
+ * how it splits into sentences, each sentence's labels, and the phonemes Piper made.
+ */
+class JapanesePhonemesTest {
+
+    private val cases: List<JsonObject> by lazy {
+        val text = javaClass.classLoader!!.getResourceAsStream("own_voice/ja_phonemes.json")!!
+            .bufferedReader(Charsets.UTF_8).use { it.readText() }
+        Json.parseToJsonElement(text).jsonObject["cases"]!!.jsonArray.map { it.jsonObject }
+    }
+
+    private fun strings(o: JsonObject, key: String) = o[key]!!.jsonArray.map { it.jsonPrimitive.content }
+
+    @Test
+    fun `there are enough cases to mean something`() {
+        assertTrue(cases.size >= 40)
+    }
+
+    @Test
+    fun `sentences split as Piper splits them`() {
+        for (case in cases) {
+            val text = case["text"]!!.jsonPrimitive.content
+            assertEquals(text, strings(case, "sentences"), JapanesePhonemes.splitSentences(text))
+        }
+    }
+
+    @Test
+    fun `labels become the phonemes Piper made, sentence by sentence`() {
+        for (case in cases) {
+            val text = case["text"]!!.jsonPrimitive.content
+            val labels = case["labels"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            val expected = case["phonemes"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            val bySentence = strings(case, "sentences").zip(labels).toMap()
+            val got = JapanesePhonemes.phonemize(text) { bySentence[it] }
+            assertEquals(text, expected, got)
+        }
+    }
+
+    @Test
+    fun `every phoneme is one codepoint`() {
+        for (case in cases) {
+            val labels = case["labels"]!!.jsonArray.map { s -> s.jsonArray.map { it.jsonPrimitive.content } }
+            for (l in labels) {
+                for (p in JapanesePhonemes.ipa(JapanesePhonemes.phonesFromLabels(l))) {
+                    assertEquals(p, 1, p.codePointCount(0, p.length))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `a sentence with no labels is dropped, not spoken as nothing`() {
+        assertEquals(emptyList<List<String>>(), JapanesePhonemes.phonemize("。。") { null })
+    }
+
+    @Test
+    fun `a line her voice cannot read is not reported said, so another voice can say it`() {
+        val label = "xx^xx-sil+xx=xx/A:xx+xx+xx/F:xx_xx#xx_xx@xx_xx|xx_xx"
+        val kana = listOf(label, "xx^sil-a+sil=xx/A:0+1+1/F:1_1#0_xx@1_1|1_1", label)
+        // Open JTalk knows nothing in a sentence of another script, or refused one.
+        assertEquals(null, JapanesePhonemes.phonemizeAll("ねえ。привет。") { if ("ねえ" in it) kana else emptyList() })
+        assertEquals(null, JapanesePhonemes.phonemizeAll("ねえ。") { null })
+        // A sentence of marks alone that gives nothing is only dropped.
+        assertEquals(1, JapanesePhonemes.phonemizeAll("ねえ。、。") { if ("ねえ" in it) kana else emptyList() }?.size)
+        assertEquals(emptyList<List<String>>(), JapanesePhonemes.phonemizeAll("。。") { null })
+    }
+
+    @Test
+    fun `a long run of katakana reaches Open JTalk broken into pieces it can hold`() {
+        val run = "ッ".repeat(340) + "ズ"
+        val safe = OpenJTalk.withLongKanaRunsBroken(run)
+        assertEquals(run, safe.replace("、", ""))
+        assertTrue(safe.split("、").all { it.length <= OpenJTalk.MAX_KANA_RUN })
+        // Ordinary text is left as it is.
+        assertEquals("ねえ、スモーク。", OpenJTalk.withLongKanaRunsBroken("ねえ、スモーク。"))
+        val hundred = "ア".repeat(OpenJTalk.MAX_KANA_RUN)
+        assertEquals(hundred, OpenJTalk.withLongKanaRunsBroken(hundred))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/own/KanaTextTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/own/KanaTextTest.kt
new file mode 100644
index 0000000..8c550a2
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/own/KanaTextTest.kt
@@ -0,0 +1,148 @@
+package com.opendroid.ai.core.voice.own
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * Her typed line to Japanese her voice can read. The pronunciations below are the CMU
+ * dictionary's own entries for these words.
+ */
+class KanaTextTest {
+
+    private val cmu = mapOf(
+        "smoke" to "S M OW1 K", "cigarette" to "S IH2 G ER0 EH1 T", "whatever" to "W AH2 T EH1 V ER0",
+        "bitch" to "B IH1 CH", "money" to "M AH1 N IY0", "night" to "N AY1 T", "hot" to "HH AA1 T",
+        "car" to "K AA1 R", "cute" to "K Y UW1 T", "drink" to "D R IH1 NG K", "street" to "S T R IY1 T",
+        "camp" to "K AE1 M P", "cat" to "K AE1 T", "never" to "N EH1 V ER0", "go" to "G OW1",
+        "home" to "HH OW1 M", "baka" to "B AA1 K AH0", "ne" to "N IY1", "dame" to "D EY1 M",
+        "don't" to "D OW1 N T", "slow" to "S L OW1", "down" to "D AW1 N", "rate" to "R EY1 T",
+        "nails" to "N EY1 L Z", "careful" to "K EH1 R F AH0 L", "singer" to "S IH1 NG ER0",
+        "it's" to "IH1 T S", "that's" to "DH AE1 T S", "cats" to "K AE1 T S", "kids" to "K IH1 D Z",
+        "friends" to "F R EH1 N D Z", "knights" to "N AY1 T S", "kusa" to "K UW1 Z AH0",
+        "muri" to "M UH1 R IY0", "yoshi" to "Y OW1 SH IY0", "de" to "D IY1", "yo" to "Y OW1"
+    ).mapValues { it.value.split(' ') }
+
+    private val kana = KanaText { cmu[it] }
+
+    @Test
+    fun `english words take her accent`() {
+        assertEquals("スモーク", kana.word("smoke"))
+        assertEquals("シガレット", kana.word("cigarette"))
+        assertEquals("ビッチ", kana.word("bitch"))
+        assertEquals("マニー", kana.word("money"))
+        assertEquals("ナイト", kana.word("night"))
+        assertEquals("ホット", kana.word("hot"))
+        assertEquals("カー", kana.word("car"))
+        assertEquals("キュート", kana.word("cute"))
+        assertEquals("ドリンク", kana.word("drink"))
+        assertEquals("ストリート", kana.word("street"))
+        assertEquals("キャンプ", kana.word("camp"))
+        assertEquals("キャット", kana.word("cat"))
+        assertEquals("ネバー", kana.word("never"))
+        assertEquals("ゴー", kana.word("go"))
+        assertEquals("ホーム", kana.word("home"))
+        assertEquals("シンガー", kana.word("singer"))
+    }
+
+    @Test
+    fun `her japanese words read as japanese even where the english dictionary has them`() {
+        assertEquals("ばか", kana.word("baka"))
+        assertEquals("ね", kana.word("ne"))
+        assertEquals("だめ", kana.word("dame"))
+        assertEquals("ちっ", kana.word("tch"))
+        assertEquals("ねね", kana.word("nene"))
+    }
+
+    @Test
+    fun `romaji outside the dictionary becomes hiragana`() {
+        assertEquals("まじ", kana.word("maji"))
+        assertEquals("うるせえ", kana.word("urusee"))
+        assertEquals("やばい", kana.word("yabai"))
+        assertEquals("きって", kana.word("kitte"))
+        assertEquals("しゃっちょう", Romaji.toHiragana("shatchou"))
+        assertEquals("こんにちは", Romaji.toHiragana("konnichiha"))
+        assertEquals("せんぱい", Romaji.toHiragana("senpai"))
+        assertEquals("きゃー", Romaji.toHiragana("kya-"))
+    }
+
+    @Test
+    fun `strict romaji refuses what is not romaji`() {
+        assertNull(Romaji.toHiragana("gunnar"))
+        assertNull(Romaji.toHiragana("strzk"))
+    }
+
+    @Test
+    fun `a name in neither reads as japanese would read its letters`() {
+        assertEquals("グンナー", kana.word("gunnar"))
+    }
+
+    @Test
+    fun `set phrases and capitals`() {
+        assertEquals("オッケー", kana.word("ok"))
+        assertEquals("ディーエム", kana.word("DM"))
+    }
+
+    @Test
+    fun `a whole line keeps japanese, converts the rest, and turns punctuation japanese`() {
+        assertEquals("ゴー ホーム。まじ？", kana.convert("go home. maji?"))
+        assertEquals("ねえねえ、なに？スロー ダウン、", kana.convert("ねえねえ、なに？ slow down..."))
+    }
+
+    @Test
+    fun `apostrophes inside a word go to the dictionary as typed`() {
+        assertEquals("ドーント", kana.word("don't"))
+    }
+
+    @Test
+    fun `cmu dictionary lines parse, variants skipped`() {
+        assertEquals("smoke" to listOf("S", "M", "OW1", "K"), CmuDict.parseLine("smoke S M OW1 K"))
+        assertNull(CmuDict.parseLine("read(2) R EH1 D"))
+        assertEquals("abc" to listOf("EY1", "B"), CmuDict.parseLine("abc EY1 B # comment"))
+    }
+
+    @Test
+    fun `t s and d z at the end of a syllable are one sound`() {
+        assertEquals("イッツ", kana.word("it's"))
+        assertEquals("ザッツ", kana.word("that's"))
+        assertEquals("キャッツ", kana.word("cats"))
+        assertEquals("キッズ", kana.word("kids"))
+        assertEquals("フレンズ", kana.word("friends"))
+        assertEquals("ナイツ", kana.word("knights"))
+    }
+
+    @Test
+    fun `her japanese words that the english dictionary also lists read as japanese`() {
+        assertEquals("くさ", kana.word("kusa"))
+        assertEquals("むり", kana.word("muri"))
+        assertEquals("よし", kana.word("yoshi"))
+        assertEquals("で", kana.word("de"))
+        assertEquals("よ", kana.word("yo"))
+    }
+
+    @Test
+    fun `a decimal point and a thousands comma stay inside their number`() {
+        assertEquals("23.5", kana.convert("23.5"))
+        assertEquals("1,299", kana.convert("1,299"))
+        // Next to a word they are punctuation as before.
+        assertEquals("5。ゴー", kana.convert("5. go"))
+        assertEquals("ゴー、5", kana.convert("go, 5"))
+    }
+
+    @Test
+    fun `a curly apostrophe, an accent or full-width letters do not break a word`() {
+        assertEquals("ドーント", kana.convert("don\u2019t"))
+        assertEquals(kana.convert("cafe"), kana.convert("caf\u00e9"))
+        assertEquals(kana.convert("cafe"), kana.convert("cafe\u0301"))
+        assertEquals("オッケー", kana.convert("\uFF2F\uFF2B"))
+        // Kana keep their voiced marks.
+        assertEquals("がっこう、ゲーム", kana.convert("がっこう、ゲーム"))
+        assertEquals("が", kana.convert("か\u3099"))
+    }
+
+    @Test
+    fun `a letter held for ever is read as held`() {
+        assertEquals("んー", kana.word("mmmmm"))
+        assertEquals(kana.word("zzz"), kana.word("zzzzzzzzzzzz"))
+    }
+}
