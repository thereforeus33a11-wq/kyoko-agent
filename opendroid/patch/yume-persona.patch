+/**
+ * What the ElevenLabs key and voice are used for as things are set, worked out from the
+ * rule that decides it line by line ([speaksThroughElevenLabs]). [hers] is whether she is
+ * the one who talks: only then is there a line of hers to speak.
+ */
+internal fun elevenLabsUse(config: LLMConfig, hers: Boolean): String {
+    val everything = speaksThroughElevenLabs(config, personaLine = false)
+    val herLines = hers && speaksThroughElevenLabs(config, personaLine = true)
+    val ownVoice = "Not in use: the phone's own voice says everything."
+    return when {
+        config.elevenLabsApiKey.isEmpty() ->
+            "No key is set: the phone's own voice says everything, and nothing is sent to ElevenLabs."
+        everything ->
+            "In use for everything the phone says. Each line is sent to ElevenLabs as text, notifications " +
+                "that are read out, results and approval prompts included."
+        herLines ->
+            "In use for her own lines only, which are sent to ElevenLabs as text. What the phone itself says " +
+                "(notifications that are read out, results, approval prompts) is said by the phone's own " +
+                "voice, because \"keep my details on this phone\" is on."
+        config.routePolicy != RoutePolicy.ANY ->
+            "$ownVoice Every line an ElevenLabs voice speaks is sent to ElevenLabs, so the key is used only " +
+                "when \"Where a model may run\" under Privacy is \"$ROUTE_POLICY_ANY_LABEL\"."
+        hers ->
+            "$ownVoice While \"keep my details on this phone\" is on, ElevenLabs speaks only her own lines, and " +
+                "only when her replies come from a plain hosted model. They come from a private route, where " +
+                "she is given your details, so what she says stays on the phone as well."
+        else ->
+            "$ownVoice While \"keep my details on this phone\" is on, what the phone says can carry your " +
+                "details and is not sent to ElevenLabs."
+    }
+}
+
+/** The line under the ElevenLabs fields: what they are used for as things are set. */
+@Composable
+fun ElevenLabsUseLine(config: LLMConfig, presence: PersonaPresenceViewModel = hiltViewModel()) {
+    // Whether she is the one who talks: nothing is said until that is known.
+    val hers = presence.active.collectAsState().value ?: return
+    Text(
+        text = elevenLabsUse(config, hers),
+        fontSize = 10.sp,
+        color = if (speaksThroughElevenLabs(config, personaLine = hers)) AccentCyan else TextSecondary
+    )
+}
