+                    "${PersonaOwnTime.span(HerEars.HEARD_HIM_QUIET_MILLIS)} or more without it."
+            )
+        )
+        // Where his details are held back, only that it came sooner.
+        val held = PersonaOwnTime.momentBlock(facts.copy(thoughtsLeftOut = true, hostCanRead = true))
+        assertTrue(held.contains("the app woke you sooner than the time you named."))
+        assertFalse(held.contains("heard his voice"))
