+            number = 3, hisClock = "Tuesday 22:10", tokyoClock = "Wednesday 07:10", heLastWrote = "3 h ago",
+            lastMoment = "1 h ago", lastDid = PersonaOwnTime.Did.KEPT, lastHadCommand = false, moved = null,
+            movedAsked = "", thoughtsLeftOut = leftOut, hostCanRead = false, life = life
+        )
