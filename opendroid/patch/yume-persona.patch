diff --git a/app/src/test/java/com/opendroid/ai/core/persona/BrainChoiceTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/BrainChoiceTest.kt
new file mode 100644
index 0000000..1f7caca
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/BrainChoiceTest.kt
@@ -0,0 +1,217 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.agent.herRouteHoldsBack
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.llm.allows
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.ui.screens.SensesWording
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Which route each model of a try takes as her brain, by his trust in Venice's Private tier
+ * and his setting of where a model may run, and what "Use this one" leaves in the settings.
+ */
+class BrainChoiceTest {
+
+    private val venice = HerBrain.PROVIDER
+    private val seeing = VenicePrivateTier.SEEING_BRAIN
+    private val encrypted = "e2ee-kimi-k2-6"
+    private val hears = "xiaomi-mimo-v2-5"
+
+    /** His settings before any try: her brain on the encrypted DeepSeek, nothing of Venice's Private tier trusted. */
+    private val his = LLMConfig(
+        activeProvider = venice,
+        selectedModels = mapOf(venice to "e2ee-deepseek-v4-1-flash-1017-abliterated"),
+        customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+        apiKeys = mapOf(venice to "his-venice-key"),
+        routePolicy = RoutePolicy.ENCRYPTED,
+        privateMode = true,
+        personaChatExtraBody = """{"top_p":0.9}"""
+    )
+    private val trusted = his.copy(trustVenicePrivate = true)
+
+    @Test
+    fun `an encrypted model goes encrypted, and a Private-tier one only while that tier is trusted for her`() {
+        assertEquals(RoutePrivacy.ENCRYPTED, BrainChoice.route(his, encrypted))
+        assertNull(BrainChoice.whyNot(his, encrypted))
+        assertEquals(RoutePrivacy.PRIVATE_TIER, BrainChoice.route(trusted, seeing))
+        assertNull(BrainChoice.whyNot(trusted, seeing))
+        assertFalse(BrainChoice.holdsBack(trusted, seeing))
+
+        // Untrusted, the same model is hosted: his setting of private routes only refuses it, and says how to trust it.
+        assertEquals(RoutePrivacy.HOSTED, BrainChoice.route(his, seeing))
+        val why = BrainChoice.whyNot(his, seeing)!!
+        assertTrue(why, why.contains("\"${BrainChoice.TRUST_SWITCH}\" in Her own senses"))
+        assertEquals(SensesWording.TRUST_TITLE, BrainChoice.TRUST_SWITCH)
+
+        // Where he lets any route run, it is tried as a hosted model would be: his details held back in private mode.
+        val any = his.copy(routePolicy = RoutePolicy.ANY)
+        assertNull(BrainChoice.whyNot(any, seeing))
+        assertTrue(BrainChoice.holdsBack(any, seeing))
+        assertTrue(BrainChoice.routeWords(any, seeing).contains("your details held back"))
+
+        // Only his own hardware: Venice is never asked.
+        val own = his.copy(routePolicy = RoutePolicy.OWN_HARDWARE, trustVenicePrivate = true)
+        assertTrue(BrainChoice.whyNot(own, encrypted)!!.contains("only this phone and your own network"))
+        assertTrue(BrainChoice.whyNot(own, seeing)!!.contains("only this phone and your own network"))
+    }
+
+    @Test
+    fun `the rule is the gate's, a model is offered exactly when the gate would let her reply through`() {
+        for (config in listOf(his, trusted, his.copy(routePolicy = RoutePolicy.ANY), his.copy(routePolicy = RoutePolicy.OWN_HARDWARE))) {
+            for (model in BrainModels.ALL.map { it.id }) {
+                val asHers = BrainChoice.withBrain(config, model)
+                val endpoint = RouteClassifier.endpointOf(asHers, venice)
+                val gate = config.routePolicy.allows(RouteClassifier.classify(asHers, venice, model, endpoint))
+                assertEquals("$model under ${config.routePolicy}, trusted ${config.trustVenicePrivate}", gate, BrainChoice.whyNot(config, model) == null)
+                // What is held back from the prompt is decided as for her reply in the chat.
+                assertEquals(model, asHers.herRouteHoldsBack(), BrainChoice.holdsBack(config, model))
+            }
+        }
+    }
+
+    @Test
+    fun `nothing is tried without Venice set up, and nothing that is not hers to have`() {
+        val noAddress = trusted.copy(customEndpoints = emptyMap())
+        assertEquals(HerBrain.whyNotMove(noAddress), BrainChoice.whyNot(noAddress, seeing))
+        val noKey = trusted.copy(apiKeys = emptyMap())
+        assertTrue(BrainChoice.whyNot(noKey, encrypted)!!.contains("no Venice key"))
+        // An anonymized model is not hers to have, trusted or not.
+        assertTrue(BrainChoice.whyNot(trusted, "gemini-4-carbon")!!.contains("Private tier"))
+        assertTrue(BrainChoice.whyNot(trusted, "e2ee-nothing-like-it")!!.contains("does not know"))
+        // Venice's live list wins: a model it now lists outside the Private tier is not offered.
+        val moved = trusted.copy(veniceTiers = mapOf(seeing to "anonymized;vision;img=10"), veniceTiersAt = 1L)
+        assertFalse(BrainChoice.offered(moved, seeing))
+        assertTrue(BrainChoice.whyNot(moved, seeing)!!.contains("Private tier"))
+    }
+
+    @Test
+    fun `use this one moves her replies, notebook and own time to the model, thinking off, pictures to her where it sees`() {
+        val used = BrainChoice.use(trusted, seeing)
+        assertEquals(venice, used.personaChatProvider)
+        assertEquals(seeing, used.personaChatModel)
+        assertEquals(venice, used.personaChatModelProvider)
+        assertEquals(BrainModels.replyOptions(seeing), used.personaChatExtraBody)
+        assertTrue(used.personaChatExtraBody.contains("\"reasoning_effort\":\"none\""))
+        assertTrue(used.personaChatSeesImages)
+        assertFalse(used.personaChatHearsAudio)
+        // Her senses' own machinery then sends pictures to her model directly.
+        assertTrue(PersonaEngine.imagesReachChatModel(used))
+        // His trust, his policy and the planner stay as he set them.
+        assertEquals(trusted.trustVenicePrivate, used.trustVenicePrivate)
+        assertEquals(trusted.routePolicy, used.routePolicy)
+        assertEquals(trusted.activeProvider, used.activeProvider)
+        assertEquals(trusted.selectedModels, used.selectedModels)
+        // What she had before is kept for "Back to her brain before".
+        assertEquals(HerBrain.record(trusted), used.personaBrainBefore)
+
+        // Her reply, her moments and her notebook are all asked of that one model, with those options.
+        val reply = PersonaEngine.requestOfHers(PersonaEngine.replyRequest("her prompt", listOf(ChatMessage("1", "hi", ChatMessage.Sender.USER))), used)
+        assertEquals(seeing, reply.modelOverride)
+        assertEquals(used.personaChatExtraBody, reply.extraBodyOverride)
+        assertFalse(reply.thinkingOff)
+        assertEquals(PersonaEngine.CHAT_TEMPERATURE, reply.temperature)
+        val moment = PersonaEngine.requestOfHers(PersonaEngine.ownTimeRequest("her moment"), used)
+        assertEquals(seeing, moment.modelOverride)
+        assertEquals(used.personaChatExtraBody, moment.extraBodyOverride)
+        assertEquals(RoutePrivacy.PRIVATE_TIER, RouteClassifier.personaRoute(used))
+    }
+
+    @Test
+    fun `use this one sends no pictures or voice to a Private-tier model he has not trusted`() {
+        // He lets any route run, and has not trusted the Private tier: the model is hosted, readable by Venice.
+        val any = his.copy(routePolicy = RoutePolicy.ANY)
+        for (model in listOf(seeing, hears, "kimi-k3")) {
+            val used = BrainChoice.use(any, model)
+            assertEquals(model, used.personaChatModel)
+            assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(used))
+            assertFalse(model, used.personaChatSeesImages)
+            assertFalse(model, used.personaChatHearsAudio)
+            assertFalse(model, PersonaEngine.imagesReachChatModel(used))
+            assertFalse(used.trustVenicePrivate)
+        }
+        // His screen says why, and how to change it.
+        val line = com.opendroid.ai.ui.viewmodel.BrainTrialViewModel.sensesLine(any, seeing)
+        assertTrue(line, line.startsWith("text only while Venice's Private tier is not trusted for her"))
+        assertTrue(line, line.contains(BrainChoice.TRUST_SWITCH))
+        // Trusted, the same model sees, and MiMo hears.
+        assertTrue(BrainChoice.use(trusted.copy(routePolicy = RoutePolicy.ANY), seeing).personaChatSeesImages)
+        assertTrue(BrainChoice.use(trusted, hears).personaChatHearsAudio)
+    }
+
+    @Test
+    fun `a typed try is built from as many rows as her reply in the chat, his message among them`() {
+        val talk = (1..BrainTrial.HISTORY_ROWS).map { ChatMessage("r$it", "line $it", if (it % 2 == 0) ChatMessage.Sender.AGENT else ChatMessage.Sender.USER) }
+        val trial = BrainTrial(recentRows = { talk }, prompt = { _, _ -> error("not asked") }, send = { _, _ -> error("not sent") }, clock = { 5L })
+        val rows = (kotlinx.coroutines.runBlocking { trial.rows(BrainTrial.Ask.Typed("come over later?")) } as BrainTrial.Rows.Ready).rows
+        assertEquals(BrainTrial.HISTORY_ROWS, rows.size)
+        assertEquals("come over later?", rows.last().text)
+        assertEquals("line 2", rows.first().text)
+    }
+
+    @Test
+    fun `an encrypted model and its Private-tier twin are told apart by name`() {
+        assertEquals(BrainModels.of("e2ee-glm-5-3-p")!!.label + " (encrypted)", BrainModels.labelOf("e2ee-glm-5-3-p"))
+        val labels = BrainModels.ALL.map { BrainModels.labelOf(it.id) }
+        assertEquals(labels.size, labels.toSet().size)
+        assertEquals("some-new-model", BrainModels.labelOf("some-new-model"))
+    }
+
+    @Test
+    fun `an encrypted model gets no pictures and no sound, and the app's own switches for thinking`() {
+        val used = BrainChoice.use(his, encrypted)
+        assertEquals(encrypted, used.personaChatModel)
+        assertEquals("", used.personaChatExtraBody)
+        assertFalse(used.personaChatSeesImages)
+        assertFalse(used.personaChatHearsAudio)
+        assertFalse(PersonaEngine.imagesReachChatModel(used))
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.personaRoute(used))
+        assertTrue(PersonaEngine.requestOfHers(PersonaEngine.replyRequest("p", emptyList()), used).thinkingOff)
+    }
+
+    @Test
+    fun `a model that hears gets his voice as sound, and the live list decides what a model takes`() {
+        val used = BrainChoice.use(trusted, hears)
+        assertTrue(used.personaChatSeesImages)
+        assertTrue(used.personaChatHearsAudio)
+        val blind = trusted.copy(veniceTiers = mapOf(seeing to "private;uncensored"), veniceTiersAt = 1L)
+        assertFalse(BrainChoice.use(blind, seeing).personaChatSeesImages)
+    }
+
+    @Test
+    fun `a second choice keeps the first record, one tap goes back, and a refused choice changes nothing`() {
+        val first = BrainChoice.use(trusted, seeing)
+        val second = BrainChoice.use(first, hears)
+        assertEquals(first.personaBrainBefore, second.personaBrainBefore)
+        val back = HerBrain.moveBack(second)
+        assertEquals(trusted.personaChatProvider, back.personaChatProvider)
+        assertEquals(trusted.personaChatModel, back.personaChatModel)
+        assertEquals(trusted.personaChatSeesImages, back.personaChatSeesImages)
+        // His own options for her come back with her brain, and "Use this one" had replaced them only meanwhile.
+        assertEquals("""{"top_p":0.9}""", back.personaChatExtraBody)
+        assertEquals("", back.personaBrainBefore)
+        // A record the one tap made before options were kept gets his options as they stood.
+        val tappedBefore = trusted.copy(personaBrainBefore = listOf(venice, "e2ee-deepseek-v4-1-flash-1017-abliterated", venice, "false", "false").joinToString("\n"))
+        val afterOld = BrainChoice.use(tappedBefore, hears)
+        assertEquals("""{"top_p":0.9}""", HerBrain.read(afterOld.personaBrainBefore)!!.extraBody)
+        assertEquals("""{"top_p":0.9}""", HerBrain.moveBack(afterOld).personaChatExtraBody)
+        assertEquals("e2ee-deepseek-v4-1-flash-1017-abliterated", HerBrain.moveBack(afterOld).personaChatModel)
+        // Options typed over two lines come back whole.
+        val twoLines = trusted.copy(personaChatExtraBody = "{\n  \"top_p\": 0.9\n}")
+        assertEquals(twoLines.personaChatExtraBody, HerBrain.moveBack(BrainChoice.use(twoLines, seeing)).personaChatExtraBody)
+        assertSame(his, BrainChoice.use(his, seeing))
+        // A try asks with the settings "Use this one" would leave, never with his own typed options.
+        assertEquals(BrainModels.replyOptions(seeing), BrainChoice.withBrain(his, seeing).personaChatExtraBody)
+        assertEquals("", his.personaBrainBefore)
+        assertEquals("", BrainChoice.withBrain(his, seeing).personaBrainBefore)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/BrainModelsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/BrainModelsTest.kt
new file mode 100644
