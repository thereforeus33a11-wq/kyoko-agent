+    @Test
+    fun `when a remembered key is turned down and the enclave then fails its check, it is not said that nothing was sent`() {
+        val moods = Moods()
+        serveWith(moods)
+        assertEquals("ok", complete().content)
+
+        // The request goes out to the key proved a moment ago and is turned down. Asked
+        // again, the enclave does not check out.
+        moods.chatAnswer = turnedDown
+        moods.proofHolds = false
+        val failure = assertThrows(LLMException::class.java) { complete() }
+
+        assertEquals(LLMError.EncryptionCheckFailed, failure.error)
+        assertTrue("one attempt did leave the phone", failure.earlierAttemptSent)
+        assertFalse(failure.replyDiscarded)
+        assertFalse(failure.retryable)
+        assertEquals("the first request and the one that was turned down, nothing after the failed check", 2, moods.chats)
+
+        // Nothing is kept from any of it: the next request asks the enclave again.
+        moods.chatAnswer = null
+        moods.proofHolds = true
+        assertEquals("ok", complete().content)
+        assertEquals(3, attestationsAsked())
+    }
