+        val out = mutableListOf<String>()
+        out += done
+        out += handOffs
+        out += failed
+        // The same lines, less the hand-overs he was told when they happened.
+        val spoken = (done + failed).toMutableList()
+        if (stopped) tail += STOPPED_NOTHING_FAILED
+        interrupted.forEach { tail += "Interrupted: $it ($MAY_HAVE_RUN)." }
+        if (notRun.isNotEmpty()) tail += "Not run: ${notRun.joinToString(", ")}."
+        out += tail
+        spoken += tail
