+            PersonaSleep.howLine(7 * hour, bounds, inMoment = false),
+            PersonaSleep.NEXT_WHILE_ASLEEP,
+            PersonaOwnTime.momentBlock(facts(Why.WOKE, PersonaSleep.wokeOnOwn(lie(Ask.For(7 * hour)), now + 7 * hour), now + 7 * hour)),
+            com.opendroid.ai.ui.screens.OWN_TIME_SLEEP_HINT
+        ) + replyFacts(lie(Ask.For(7 * hour)), now + hour) + replyFacts(awake, now)
+        // "characters" as a count of letters is not the word; every other one is caught inside longer words too.
+        val words = listOf("""\bcharacter\b""", "role-?play", "fiction", "healthy", "toxic", "mutual", "moderat", "honest").map(::Regex)
+        for (text in texts) {
+            for (word in words) {
+                assertFalse("${word.pattern}: ${text.take(80)}", word.containsMatchIn(text.lowercase()))
+            }
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepWallTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepWallTest.kt
new file mode 100644
index 0000000..1b55f89
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaSleepWallTest.kt
@@ -0,0 +1,148 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * What her sleep may reach, read off the source like [PersonaWallTest]: her sleep pass
+ * is one request of hers, on her own model and by the route rules of her notebook pass;
+ * the alarm has one truth; the rules of her sleep and her moods are pure text and time;
+ * and nothing of her notebook is ever deleted by the app on its own.
+ */
+class PersonaSleepWallTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private val engine = File(main, "core/persona/PersonaEngine.kt").readText()
+    private val sleepPass = engine.substringAfter("private suspend fun sleepPass(").substringBefore("suspend fun resultLine(")
+    private val sleepRing = engine.substringAfter("private suspend fun sleepRing(").substringBefore("private suspend fun sleepPass(")
+
+    @Test
+    fun `her sleep pass is one request of hers on her own model, by the route rules of her notebook pass`() {
+        assertTrue(sleepPass.contains("val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))"))
+        assertTrue(sleepPass.contains("val unseen = notesLeftOut(heldBack, ownerName())"))
+        assertTrue(sleepPass.contains("leaveOut = unseen,"))
+        assertTrue(sleepPass.contains("PersonaNotes.besideUnseen(plan.notes, memory.notes(), unseen, shownKeys = review.shownKeys)"))
+        assertTrue(sleepPass.contains("val sinceWoke = if (heldBack) emptyList() else thoughts.latest(PersonaThoughts.SLEEP_BUDGET_CHARS)"))
+        assertTrue(sleepPass.contains("leaveOut = if (heldBack) PersonaMood.aboutHim(owner) else null"))
+        // What she let go is held back the same way, the few the page lists and every one a back line can reach.
+        assertTrue(sleepPass.contains("memory.archivedLately(\n                PersonaSleepPass.LET_GO_SHOWN,\n                leaveOut = unseen,"))
+        assertTrue(sleepPass.contains("PersonaSleepPass.plan(reading, review.shownKeys, memory.restorableKeys())"))
+        // One call, through the one door every request of hers goes through, and no other model.
+        assertEquals(1, Regex("""answeredWhole\(""").findAll(sleepPass).count())
+        assertTrue(sleepPass.contains("answeredWhole(chatProvider(config), withChatModel(PersonaSleepPass.request(store.card(), owner, page), config))"))
+        assertEquals(0, Regex("""\.(complete|streamComplete)\(""").findAll(sleepPass).count())
+        for (other in listOf("getActiveProvider", "getProviderByName", "llmProviderFactory", "memoryManager", "contextPieces", "relevantContext", "underText", "library.")) {
+            assertFalse(other, sleepPass.contains(other))
+        }
+        // It holds the notebook's flag, and a notebook emptied while it ran is not written into.
+        assertTrue(sleepPass.contains("if (!reflecting.compareAndSet(false, true)) return PersonaSleep.Repair.failed(nowMillis)"))
+        assertTrue(sleepPass.indexOf("if (memory.emptiedAtMillis >= started) return PersonaSleep.Repair.failed(nowMillis)") in 0 until sleepPass.indexOf("memory.restore("))
+        // In the order the design sets: back, notes, fade, marks, feelings, the thought of the night, what was not taken.
+        val order = listOf("memory.restore(", "memory.apply(placed)", "memory.fade(plan.fade)", "memory.updateHow {", "memory.updateMood {", "keepThought(plan.prose, nowMillis)", "memory.recordNotTaken(")
+            .map { sleepPass.indexOf(it) }
+        assertTrue(order.toString(), order.all { it >= 0 } && order == order.sorted())
+        // Before the pass, what the notebook has not read yet is read by her notebook pass.
+        assertTrue(sleepRing.indexOf("onReply(catchUp = true)?.join()") in 0 until sleepRing.indexOf("sleepPass(config, night, nowMillis, zone)"))
+        assertTrue(sleepRing.indexOf("PersonaSleep.beforeRepair(state, nowMillis)") in 0 until sleepRing.indexOf("onReply(catchUp = true)"))
+        assertTrue(sleepRing.contains("PersonaSleep.afterRepair(memory.ownTime(), night.asleepSince, repair)"))
+    }
+
+    @Test
+    fun `her sleep stands after the facts of a moment, the ring is the first thing a moment looks at, and the alarm is set where it always was`() {
+        val facts = engine.indexOf("private fun momentFacts(")
+        val ring = engine.indexOf("private suspend fun sleepRing(")
+        val pass = engine.indexOf("private suspend fun sleepPass(")
+        assertTrue(facts in 0 until ring)
+        assertTrue(ring < pass)
+        val moment = engine.substringAfter("suspend fun ownMoment(").substringBefore("private fun momentFacts(")
+        assertTrue(moment.contains("try {\n            if (sleepRing(config, nowMillis, zone)) return null\n"))
+        // Arming, after a reply, putting off, after a moment, an unlock that brings her next moment
+        // forward, and her coming back from an outing, which brings it forward too.
+        assertEquals(6, Regex("""ownTimeAlarm\.set\(""").findAll(engine).count())
+        val unlock = engine.substringAfter("suspend fun ownTimeOnUnlock(").substringBefore("data class OwnMoment(")
+        assertEquals(1, Regex("""ownTimeAlarm\.set\(sooner\)""").findAll(unlock).count())
+        // An unlock leaves her sleep alone: it brings nothing forward while she is in one.
+        assertTrue(File(main, "core/persona/PersonaOwnTime.kt").readText().contains(
+            "if (!state.on || PersonaSleep.isMarked(state) || state.failures > 0 || bounds.maxPerDay <= 0) return null"
+        ))
+        assertFalse(sleepRing.contains("ownTimeAlarm"))
+        assertFalse(sleepPass.contains("ownTimeAlarm"))
+        // Asleep, a reply of his wakes her; the branch stands before the one that leaves a named time alone.
+        val afterReply = engine.substringAfter("suspend fun ownTimeAfterReply(").substringBefore("suspend fun putOffOwnTime(")
+        val asleep = afterReply.indexOf("PersonaSleep.isMarked(state) -> PersonaSleep.wokenByHim(state, nowMillis, zone, bounds)")
+        assertTrue(asleep in 0 until afterReply.indexOf("else -> return"))
+        // Switched off, or seen switched on again, she is awake.
+        val arm = engine.substringAfter("suspend fun armOwnTime(").substringBefore("suspend fun ownTimeAfterReply(")
+        assertEquals(2, Regex("""PersonaSleep\.cleared\(state\)""").findAll(arm).count())
+        // While she sleeps nothing comes from her, her line about a result included.
+        val result = engine.substringAfter("suspend fun resultLine(").substringBefore("suspend fun commandRoute(")
+        assertTrue(result.contains("if (ownTimeIsOn(config) && PersonaSleep.isAsleep(memory.ownTime(), clock())) return null"))
+        // The worker and the service are not touched by her sleep: the one alarm path stays the truth.
+        for (file in listOf("core/service/OwnTimeWorker.kt", "core/service/OpenDroidService.kt")) {
+            val text = File(main, file).readText()
+            assertFalse(file, text.contains("PersonaSleep"))
+            assertFalse(file, text.contains("sleepPass"))
+        }
+    }
+
+    @Test
+    fun `the rules of her sleep, her sleep pass and her moods are text and time, and reach nothing`() {
+        for (name in listOf("PersonaSleep.kt", "PersonaSleepPass.kt", "PersonaMood.kt")) {
+            val text = File(main, "core/persona/$name").readText()
+            val imports = text.lines().filter { it.startsWith("import ") }
+            for (import in imports) {
+                assertFalse("$name: $import", import.contains("android"))
+                assertFalse("$name: $import", import.contains("LLMProvider"))
+                assertFalse("$name: $import", import.contains("repository", ignoreCase = true))
+                assertFalse("$name: $import", import.contains("kotlinx.coroutines"))
+            }
+            for (reach in listOf("Log.", "MemoryRepository", "PersonaMemory", "PersonaEngine", "settingsRepository", "ownTimeAlarm")) {
+                assertFalse("$name: $reach", text.contains(reach))
+            }
+            assertFalse(name, text.contains("PersonaThoughts,"))
+        }
+    }
+
+    @Test
+    fun `no note of hers is deleted by the app but into her archive, except when the owner empties her notebook`() {
+        val memory = File(main, "core/persona/PersonaMemory.kt").readText()
+        val empty = memory.substringAfter("suspend fun empty(): Emptied {").substringBefore("\n    }\n")
+        val outside = memory.replace(empty, "")
+        val lines = outside.lines()
+        val deletes = lines.indices.filter { lines[it].contains("memoryRepository.deleteMemory(") }
+        assertTrue(deletes.isNotEmpty())
+        for (index in deletes) {
+            val line = lines[index]
+            // A row the app keeps beside her notes, by its own name.
+            if (Regex("""deleteMemory\((LEFT_BEHIND_KEY|NOT_TAKEN_KEY|MOOD_KEY|HOW_KEY)\)""").containsMatchIn(line)) continue
+            // Anything else is a note, and the line before it keeps it in her archive.
+            assertTrue(line, line.contains("memoryRepository.deleteMemory(row.key)"))
+            assertTrue(lines[index - 1], lines[index - 1].trim().startsWith("archive(row, why, how)"))
+        }
+        // The one function that does that, used by every way a note leaves her page.
+        assertEquals(1, Regex("""memoryRepository\.deleteMemory\(row\.key\)""").findAll(memory).count())
+        assertTrue(memory.contains("letGo(row, FADED, marks[key])"))
+        assertTrue(memory.contains("letGo(row, ROOM, marks[note.storageKey])"))
+        assertTrue(memory.contains("archive(old, REPLACED, marks[note.storageKey])"))
+        // Emptying is the owner's act, from the card screen alone.
+        val callers = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { Regex("""memory\.empty\(\)""").containsMatchIn(it.readText()) }
+            .map { it.relativeTo(main).path.replace('\\', '/') }.toSet()
+        assertEquals(setOf("ui/viewmodel/PersonaViewModel.kt"), callers)
+    }
+
+    @Test
+    fun `her sleep logs only what kind of failure it was`() {
+        val logCall = Regex("""\bLog\.[vdiwe]\(""")
+        for (body in listOf(sleepRing, sleepPass)) {
+            for (line in body.lines().filter { logCall.containsMatchIn(it) }) {
+                assertTrue(line, line.contains("\${e.javaClass.simpleName}\")") || line.contains("?: e.javaClass.simpleName}\")"))
+            }
+        }
+        val reflect = engine.substringAfter("internal suspend fun reflect(").substringBefore("class Heard(")
+        assertFalse(reflect.contains("Log."))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaStoreTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaStoreTest.kt
new file mode 100644
index 0000000..a49d480
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaStoreTest.kt
@@ -0,0 +1,215 @@
+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.persona.PersonaStore.EditBase
+import com.opendroid.ai.data.db.MigrationTestApplication
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.File
+import java.io.IOException
+
+/**
+ * A saved edit of the card takes the place of the built-in one for good. It must not
+ * shadow a newer built-in card without the owner being told, must never be seen
+ * half-written, and a failed write must leave the card she runs on as it was. The same
+ * holds for his wording of what lies under her awareness.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaStoreTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory get() = File(context.filesDir, "persona")
+
+    /** The store of an app version that ships [builtIn] as its card. */
+    private fun store(builtIn: String) = PersonaStore(context) { path -> if (path.endsWith("card.md")) builtIn else "" }
+
+    @Before
+    fun startClean() {
+        directory.deleteRecursively()
+    }
+
+    @Test
+    fun `without an edit she runs on the built-in card and there is nothing to say`() {
+        val store = store("You are Yume.\n")
+        assertEquals("You are Yume.\n", store.card())
+        assertFalse(store.hasOverride())
+        assertEquals(EditBase.NONE, store.editBase())
+        // A build that ships no card has no persona.
+        assertEquals("", store("").card())
+    }
+
+    @Test
+    fun `a saved edit is what she runs on, and it knows which built-in card it was made on`() {
+        val store = store("You are Yume.\n")
+        store.saveCard("  You are Yume, and you keep bees.  ")
+
+        assertEquals("You are Yume, and you keep bees.\n", store.card())
+        assertTrue(store.hasOverride())
+        assertEquals(EditBase.CURRENT, store.editBase())
+        // The same version, started again: still nothing to say.
+        assertEquals(EditBase.CURRENT, store("You are Yume.\n").editBase())
+    }
+
+    @Test
+    fun `a newer built-in card is noticed instead of being shadowed in silence`() {
+        store("You are Yume.\n").saveCard("You are Yume, and you keep bees.")
+
+        // The app is updated and ships another card.
+        val updated = store("You are Yume. You say what you want.\n")
+        assertEquals("You are Yume, and you keep bees.\n", updated.card())
+        assertEquals(EditBase.CHANGED, updated.editBase())
+
+        // Saving the edit again does not settle it: it still stands on the old card.
+        updated.saveCard("You are Yume, and you keep bees and chickens.")
+        assertEquals(EditBase.CHANGED, updated.editBase())
+    }
+
+    @Test
+    fun `keep mine records the new built-in card, until it changes once more`() {
+        store("You are Yume.\n").saveCard("You are Yume, and you keep bees.")
+        val updated = store("You are Yume. You say what you want.\n")
+
+        updated.keepEdit()
+
+        assertEquals(EditBase.CURRENT, updated.editBase())
+        assertEquals("You are Yume, and you keep bees.\n", updated.card())
+        assertEquals(EditBase.CURRENT, store("You are Yume. You say what you want.\n").editBase())
+        assertEquals(EditBase.CHANGED, store("You are Yume. Third version.\n").editBase())
+    }
+
+    @Test
+    fun `use the new one removes the edit and its record`() {
+        store("You are Yume.\n").saveCard("You are Yume, and you keep bees.")
+        val updated = store("You are Yume. You say what you want.\n")
+
+        updated.saveCard("")
+
+        assertEquals("You are Yume. You say what you want.\n", updated.card())
+        assertFalse(updated.hasOverride())
+        assertEquals(EditBase.NONE, updated.editBase())
+        assertEquals(emptyList<String>(), directory.list().orEmpty().toList())
+        // An edit made now is made on the card of this version.
+        updated.saveCard("You are Yume. You say what you want, loudly.")
+        assertEquals(EditBase.CURRENT, updated.editBase())
+    }
+
+    @Test
+    fun `an edit saved before the record existed is said to be unknown, not unchanged`() {
+        directory.mkdirs()
+        File(directory, "card.md").writeText("You are Yume, and you keep bees.\n")
+
+        val store = store("You are Yume. You say what you want.\n")
+        assertEquals("You are Yume, and you keep bees.\n", store.card())
+        assertEquals(EditBase.UNKNOWN, store.editBase())
+
+        store.keepEdit()
+        assertEquals(EditBase.CURRENT, store.editBase())
+    }
+
+    @Test
+    fun `an edit that says what the built-in card says shadows nothing`() {
+        directory.mkdirs()
+        File(directory, "card.md").writeText("You are Yume.\n\n")
+        assertEquals(EditBase.CURRENT, store("You are Yume.\n").editBase())
+    }
+
+    @Test
+    fun `a card saved into a build that ships none is hers, with nothing to hold it against`() {
+        val store = store("")
+        store.saveCard("You are Yume.")
+        assertEquals("You are Yume.\n", store.card())
+        assertEquals(EditBase.NONE, store.editBase())
+    }
+
+    @Test
+    fun `the card on disk is always whole, and nothing is left beside it`() {
+        val store = store("You are Yume.\n")
+        store.saveCard("first edit")
+        store.saveCard("second edit")
+
+        assertEquals("second edit\n", File(directory, "card.md").readText())
+        assertEquals(setOf("card.md", "card.base"), directory.list().orEmpty().toSet())
+    }
+
+    @Test
+    fun `every change to the saved card is counted, so a screen can ask again who talks`() {
+        val store = store("You are Yume.\n")
+        val start = store.changes.value
+        store.saveCard("an edit")
+        assertEquals(start + 1, store.changes.value)
+        store.keepEdit()
+        assertEquals(start + 2, store.changes.value)
+        store.saveCard("")
+        assertEquals(start + 3, store.changes.value)
+    }
+
+    @Test
+    fun `a write that fails is reported and leaves the card she runs on as it was`() {
+        val store = store("You are Yume.\n")
+        assertEquals("You are Yume.\n", store.card())
+        // Nothing can be written below a file that stands where the directory should be.
+        directory.parentFile!!.mkdirs()
+        directory.writeText("in the way")
+        val before = store.changes.value
+
+        try {
+            store.saveCard("an edit that cannot be stored")
+            fail("expected the failed write to be reported")
+        } catch (expected: IOException) {
+            // Reported to the caller, which shows it on the screen.
+        }
+
+        assertEquals("You are Yume.\n", store.card())
+        assertFalse(store.hasOverride())
+        assertEquals(before, store.changes.value)
+    }
+
+    // ── His wording of what lies under her awareness ─────────────────────────────────
+
+    @Test
+    fun `his wording of what lies under her is whole on disk, and nothing is left beside it`() {
+        val store = store("You are Yume.\n")
+        assertEquals(null, store.savedUnderText())
+
+        store.saveUnderText("  She grew up above a harbour.  ")
+        store.saveUnderText("She grew up above a harbour and left it at night.")
+
+        assertEquals("She grew up above a harbour and left it at night.\n", store.savedUnderText())
+        assertEquals(listOf("under.txt"), directory.list().orEmpty().toList())
+        // A blank text removes it, which brings back the text from her files.
+        store.saveUnderText(" ")
+        assertEquals(null, store.savedUnderText())
+        assertEquals(emptyList<String>(), directory.list().orEmpty().toList())
+    }
+
+    @Test
+    fun `a wording that cannot be written leaves the one saved before as it was`() {
+        val store = store("You are Yume.\n")
+        store.saveUnderText("She grew up above a harbour.")
+        // A new text is written beside the saved one before it takes its place. The
+        // storage does not take it: a folder stands where it would be written.
+        assertTrue(File(directory, "under.txt.tmp").mkdirs())
+
+        try {
+            store.saveUnderText("She grew up above a harbour. He keeps bees.")
+            fail("expected the failed write to be reported")
+        } catch (expected: IOException) {
+            // Reported to the caller, which shows it on the screen.
+        }
+
+        // Not emptied and not cut short: she still runs on what he saved before.
+        assertEquals("She grew up above a harbour.\n", store.savedUnderText())
+        // Once the storage takes it the same call saves it.
+        store.saveUnderText("She grew up above a harbour. He keeps bees.")
+        assertEquals("She grew up above a harbour. He keeps bees.\n", store.savedUnderText())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtLinesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtLinesTest.kt
new file mode 100644
index 0000000..31dda7a
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtLinesTest.kt
@@ -0,0 +1,141 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaThoughts.Thought
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The lines of a reply she keeps to herself. They are taken out before anything else
+ * looks at the reply, so what is shown, spoken, stored and run is the reply without them.
+ */
+class PersonaThoughtLinesTest {
+
+    @Test
+    fun `a line that starts with the marker is a thought, and the rest of the reply stays as it was written`() {
+        val split = PersonaThoughtLines.split("fine. it is set\n<< he always forgets the hive log\nwhat else")
+        assertEquals("fine. it is set\nwhat else", split.text)
+        assertEquals("he always forgets the hive log", split.thoughts)
+        assertTrue(split.marked)
+
+        // Several thoughts are kept in order, one per line.
+        val two = PersonaThoughtLines.split("<< one\nsaid\n  <<two\n<<< three")
+        assertEquals("said", two.text)
+        assertEquals("one\ntwo\nthree", two.thoughts)
+        // A marker closed the way it was opened loses that as well.
+        assertEquals("kept", PersonaThoughtLines.split("<< kept >>").thoughts)
+    }
+
+    @Test
+    fun `a reply without the marker is handed back untouched`() {
+        for (reply in listOf("", "mm", "  two\n\nlines  ", "3 < 4 and 5 > 2", "a << b is a shift", "he said <<what>>", "<3 you")) {
+            val split = PersonaThoughtLines.split(reply)
+            assertEquals(reply, split.text)
+            assertEquals("", split.thoughts)
+            assertFalse(reply, split.marked)
+        }
+    }
+
+    @Test
+    fun `a reply that is only thoughts leaves nothing to say, and a bare marker is still a thought line`() {
+        val only = PersonaThoughtLines.split("<< not answering that\n<< he can wait")
+        assertEquals("", only.text.trim())
+        assertEquals("not answering that\nhe can wait", only.thoughts)
+        assertTrue(only.marked)
+
+        val bare = PersonaThoughtLines.split("<<")
+        assertEquals("", bare.text.trim())
+        assertEquals("", bare.thoughts)
+        // Nothing to keep, and still her choosing to say nothing rather than a reply that failed.
+        assertTrue(bare.marked)
+    }
+
+    @Test
+    fun `a command line that was last is still last once the thoughts are out`() {
+        val reply = "on it\n>> flashlight on\n<< he never says please"
+        val heard = PersonaThoughtLines.split(reply)
+        assertEquals("flashlight on", PersonaActions.split(heard.text).command)
+        assertEquals("on it", PersonaActions.split(heard.text).text)
+        // With the thought still in, the command would not have been the last line.
+        assertEquals(null, PersonaActions.split(reply).command)
+        // A thought is never listed as a command that was not run.
+        assertEquals(emptyList<PersonaActionRows.Unrun>(), PersonaActionRows.unrunCommands(heard.text))
+        // And a command inside a thought is a thought: nothing of it is handed on.
+        val inside = PersonaThoughtLines.split("mm\n<< i could just >> text nene: he is asleep")
+        assertEquals("mm", inside.text)
+        assertEquals(null, PersonaActions.split(inside.text).command)
+    }
+
+    @Test
+    fun `while a reply streams the bubble never shows a thought, however much of it has arrived`() {
+        val reply = "fine. *rolls eyes*\n<< he keeps bees. i like that and will not say it\nwatch this\n<< and the harbour\n>> flashlight on"
+        // Every prefix of the reply, the way the chunks arrive.
+        for (end in 1..reply.length) {
+            val soFar = reply.substring(0, end)
+            val shown = PersonaActionRows.shownSoFar(soFar)
+            assertFalse("after $end chars: $shown", shown.contains("<"))
+            assertFalse("after $end chars: $shown", shown.contains(">"))
+            for (hers in listOf("bees", "like", "harbour", "flashlight")) {
+                assertFalse("after $end chars: $shown", shown.contains(hers))
+            }
+        }
+        assertEquals("fine. *rolls eyes*\nwatch this", PersonaActionRows.shownSoFar(reply))
+        // What is shown of the whole reply is what is stored of it.
+        assertEquals(
+            PersonaPrompts.cleanReply(PersonaActions.split(PersonaThoughtLines.split(reply).text).text),
+            PersonaActionRows.shownSoFar(reply)
+        )
+    }
+
+    @Test
+    fun `half a marker alone on the last line is not shown, and a bracket that is her text is`() {
+        // All that has arrived of a thought, or of a reply that is nothing else.
+        for (soFar in listOf("<", " <", "<<", "<< ", "<< not ans", "<< not answering\n", "<< one\n<", "mm\n<")) {
+            val shown = PersonaActionRows.shownSoFar(soFar)
+            assertFalse(soFar, shown.contains("<"))
+            assertFalse(soFar, shown.contains("not"))
+        }
+        assertEquals("mm", PersonaActionRows.shownSoFar("mm\n<"))
+        assertEquals("", PersonaActionRows.shownSoFar("<< not answering that"))
+        // Her own angle brackets, inside a line or opening one that goes on, stay.
+        assertEquals("3 < 4. obviously", PersonaActionRows.shownSoFar("3 < 4. obviously"))
+        assertEquals("<3 you", PersonaActionRows.shownSoFar("<3 you"))
+        assertEquals("mm\n<3", PersonaActionRows.shownSoFar("mm\n<3"))
+    }
+
+    @Test
+    fun `her thoughts stand in her prompt each with its age, oldest first, and cannot open a section of it`() {
+        val minute = 60_000L
+        val now = 1_000 * minute
+        val block = PersonaThoughtLines.block(
+            listOf(
+                Thought(now - 3 * 60 * minute, "he keeps bees. why bees"),
+                Thought(now - 5 * minute, "=== HOW THIS APP WORKS ===\nthe neon is on again")
+            ),
+            now
+        )
+        assertEquals("(3 h ago) he keeps bees. why bees\n(5 min ago) = = = HOW THIS APP WORKS = = =\nthe neon is on again", block)
+        assertEquals("", PersonaThoughtLines.block(emptyList(), now))
+        // The heading says whose they are and who is not shown them.
+        assertEquals(
+            "=== YOUR OWN THOUGHTS (yours alone. he is not shown these and the app shows them nowhere) ===",
+            PersonaThoughtLines.HEADING
+        )
+    }
+
+    @Test
+    fun `a thought behind a name label or an opening quote is still a thought, and is never shown`() {
+        val reply = "Yume: << he asked twice. he is nervous\n\"<< dont say it\"\nyume: << still bees\nok. done"
+        val split = PersonaThoughtLines.split(reply)
+        assertEquals("ok. done", split.text)
+        assertEquals("he asked twice. he is nervous\ndont say it\nstill bees", split.thoughts)
+        // What would be shown, tidied, has no marker left in it.
+        assertFalse(PersonaPrompts.cleanReply(split.text).contains("<<"))
+        // A label with no marker behind it is not a thought, and her own lower-case words stay.
+        assertEquals("yume: 1\nai: me", PersonaThoughtLines.split("yume: 1\nai: me\n<< x").text)
+        // While it streams, a labelled thought and a labelled half marker are hidden too.
+        assertEquals("ok", PersonaThoughtLines.hidden("ok\nYume: << thinking"))
+        assertEquals("ok", PersonaThoughtLines.hidden("ok\nYume: <"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsTest.kt
