--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/Wikipedia.kt
@@ -0,0 +1,135 @@
+package com.opendroid.ai.core.life.reading
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import okhttp3.HttpUrl
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Wikipedia for her: a search, and the plain text of a page cut into parts. Japanese
+ * Wikipedia when her words hold kana or kanji, English otherwise. Everything goes through
+ * [HerFetcher], so the fetch rules hold; her words have passed the outgoing guard before
+ * they get here. These are calls to Wikipedia's own interface, at addresses the app builds,
+ * which Wikimedia's rules for API use allow: robots.txt, a crawler's rule that closes `/w/`
+ * to crawlers, is not asked for them.
+ */
+@Singleton
+class Wikipedia @Inject constructor(private val fetcher: HerFetcher) {
+
+    data class Hit(val title: String, val description: String, val excerpt: String, val lang: String, val thumbnail: String?) {
+        val url: String get() = pageUrl(lang, title)
+    }
+
+    data class Article(val title: String, val lang: String, val parts: List<String>, val image: String?) {
+        val url: String get() = pageUrl(lang, title)
+        val site: String get() = "$lang.wikipedia.org"
+    }
+
+    sealed class Result<out T> {
+        data class Found<T>(val value: T) : Result<T>()
+
+        /** Nothing found, or a page with no text. */
+        data object Empty : Result<Nothing>()
+
+        /** Not fetched, and why. */
+        data class Refused(val why: HerFetcher.Why) : Result<Nothing>()
+
+        /** Fetched, but not readable as Wikipedia's answer. */
+        data object Unreadable : Result<Nothing>()
+    }
+
+    suspend fun search(words: String): Result<List<Hit>> {
+        val lang = langOf(words)
+        return when (val fetched = fetcher.fetch(searchUrl(lang, words), robots = false)) {
+            is HerFetcher.Fetched.Refused -> Result.Refused(fetched.why)
+            is HerFetcher.Fetched.Page -> parseSearch(fetched.text(), lang)?.let { if (it.isEmpty()) Result.Empty else Result.Found(it) } ?: Result.Unreadable
+        }
+    }
+
+    suspend fun article(title: String, lang: String): Result<Article> =
+        when (val fetched = fetcher.fetch(articleUrl(lang, title), robots = false)) {
+            is HerFetcher.Fetched.Refused -> Result.Refused(fetched.why)
+            is HerFetcher.Fetched.Page -> parseArticle(fetched.text(), lang)?.let { if (it.parts.isEmpty()) Result.Empty else Result.Found(it) } ?: Result.Unreadable
+        }
+
+    companion object {
+        const val MAX_HITS = 8
+
+        private val JAPANESE = Regex("""[぀-ヿ㐀-鿿豈-﫿]""")
+
+        /** "ja" when [words] hold kana or kanji, else "en". */
+        fun langOf(words: String): String = if (JAPANESE.containsMatchIn(words)) "ja" else "en"
+
+        private fun base(lang: String) = HttpUrl.Builder().scheme("https").host("$lang.wikipedia.org")
+
+        fun searchUrl(lang: String, words: String): String = base(lang)
+            .addPathSegments("w/rest.php/v1/search/page")
+            .addQueryParameter("q", words.trim())
+            .addQueryParameter("limit", MAX_HITS.toString())
+            .build().toString()
+
+        fun articleUrl(lang: String, title: String): String = base(lang)
+            .addPathSegments("w/api.php")
+            .addQueryParameter("action", "query")
+            .addQueryParameter("prop", "extracts|pageimages")
+            .addQueryParameter("explaintext", "1")
+            .addQueryParameter("piprop", "thumbnail")
+            .addQueryParameter("pithumbsize", "640")
+            .addQueryParameter("redirects", "1")
+            .addQueryParameter("format", "json")
+            .addQueryParameter("formatversion", "2")
+            .addQueryParameter("titles", title.trim())
+            .build().toString()
+
+        fun pageUrl(lang: String, title: String): String = base(lang)
+            .addPathSegment("wiki")
+            .addPathSegment(title.trim().replace(' ', '_'))
+            .build().toString()
+
+        private fun JsonElement?.obj(): JsonObject? = this?.takeIf { it.isJsonObject }?.asJsonObject
+        private fun JsonObject.str(key: String): String? =
+            get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+
+        private val TAGS = Regex("""<[^>]+>""")
+
+        /** The hits of a REST search answer, or null when it is not one. */
+        fun parseSearch(json: String, lang: String): List<Hit>? {
+            val root = try {
+                JsonParser.parseString(json).obj()
+            } catch (e: Exception) {
+                null
+            } ?: return null
+            val pages = root.get("pages")?.takeIf { it.isJsonArray }?.asJsonArray ?: return null
+            return pages.mapNotNull { element ->
+                val page = element.obj() ?: return@mapNotNull null
+                val title = page.str("title")?.trim()?.takeIf { it.isNotEmpty() } ?: return@mapNotNull null
+                val thumb = page.get("thumbnail").obj()?.str("url")?.let { if (it.startsWith("//")) "https:$it" else it }
+                Hit(
+                    title = title,
+                    description = page.str("description").orEmpty().trim(),
+                    excerpt = TAGS.replace(page.str("excerpt").orEmpty(), "").replace("&quot;", "\"").replace("&amp;", "&").trim(),
+                    lang = lang,
+                    thumbnail = thumb?.takeIf { it.startsWith("https://") }
+                )
+            }.take(MAX_HITS)
+        }
+
+        /** The article of an extracts answer, cut into parts, or null when it is not one. */
+        fun parseArticle(json: String, lang: String): Article? {
+            val root = try {
+                JsonParser.parseString(json).obj()
+            } catch (e: Exception) {
+                null
+            } ?: return null
+            val pages = root.get("query").obj()?.get("pages")?.takeIf { it.isJsonArray }?.asJsonArray ?: return null
+            val page = pages.firstOrNull()?.obj() ?: return null
+            val title = page.str("title")?.trim().orEmpty()
+            if (page.has("missing") || title.isEmpty()) return Article(title, lang, emptyList(), null)
+            val text = page.str("extract").orEmpty().replace(Regex("""\n{3,}"""), "\n\n").trim()
+            val image = page.get("thumbnail").obj()?.str("source")?.takeIf { it.startsWith("https://") }
+            return Article(title, lang, Readable.parts(text), image)
+        }
+    }
+}
