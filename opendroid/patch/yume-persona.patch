+        assertEquals(listOf(FoldState.Lens.BACK), camera.takes)
+        assertEquals(listOf(Describe.Source.CAMERA), eyes.described)
+        // I6: the frame's bytes are zeroed once her eyes had them.
+        assertTrue(camera.frames.single().all { it == 0.toByte() })
+        // P2-3: her moment of looking, with the describer's words in the place of what is in front of her, and PK-1.
+        val text = mind.texts.single()
+        assertTrue(text.indexOf(OutingPrompt.HEADING) < text.indexOf(OutingPrompt.SAW_HEADING))
+        assertTrue(text, text.contains("you looked through the back camera at 14:02. the describer wrote: \"A messy desk with a pink lamp. DESC_SENTINEL.\" the picture is gone."))
+        // Her moment of looking is told as one: its request says so, not that she is out reading.
