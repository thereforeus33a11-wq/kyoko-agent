+        assertFalse(print.toString().contains(print.vector[0].toString()))
+    }
+
+    /** A measure of a steady voice at [hz] with [amp], as a take would have. */
+    private fun measure(hz: Double, amp: Double, millis: Int = 6_000): Acoustics.Measure {
+        var phase = 0.0
+        val x = FloatArray(millis * 16) {
+            phase += 2 * Math.PI * hz / 16_000
+            (amp * Math.sin(phase)).toFloat()
+        }
+        return Acoustics.measure(x)!!
+    }
+
+    @Test
+    fun `his three takes begin how he usually sounds, kept with his print`() {
+        val e = VoiceEnrolment("titanet-small-en")
+        val levels = ArrayList<Float>()
+        for ((i, hz) in listOf(110.0, 120.0, 130.0).withIndex()) {
+            val m = measure(hz, 0.05)
+            levels += m.levelDb
+            e.take(voice(0, seed = i + 1), 6_000, sentence[i], m)
+        }
+        val usual = e.result()!!.usual!!
+        assertTrue(usual.ready)
+        assertEquals(3, usual.learned)
+        assertEquals(levels.average().toFloat(), usual.levelDb, 0.01f)
+        assertEquals(Acoustics.semitones(120f), usual.pitchSemitones!!, 0.2f)
+        // His pace is what he read, in words of the sentences, over each take's speech.
+        val wpm = usual.wordsPerMinute("en")!!
+        val expected = sentence.map { HearingRules.words(it) * 60_000f / 6_000f }.average().toFloat()
+        assertEquals(expected, wpm, expected * 0.05f)
+        // Takes with no measures make a print with no usual; a restart forgets the measures.
+        val bare = VoiceEnrolment("m")
+        for (i in 0..2) bare.take(voice(0, seed = i + 1), 6_000, sentence[i])
+        assertNull(bare.result()!!.usual)
+        e.restart()
+        for (i in 0..2) e.take(voice(0, seed = i + 1), 6_000, sentence[i])
+        assertNull(e.result()!!.usual)
+    }
