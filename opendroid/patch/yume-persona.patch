diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLiveSpeechTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLiveSpeechTest.kt
new file mode 100644
index 0000000..fae1aa7
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLiveSpeechTest.kt
@@ -0,0 +1,149 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.voice.SpeechTextNormalizer
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Her reply spoken while she writes it, and never a line she keeps to herself or a command. */
+class PersonaLiveSpeechTest {
+
+    /** Streams [reply] in pieces of [step] characters; returns what was said early. */
+    private fun stream(reply: String, step: Int = 1): Pair<PersonaLiveSpeech, List<String>> {
+        val said = ArrayList<String>()
+        val live = PersonaLiveSpeech { said += it }
+        var i = 0
+        while (i < reply.length) {
+            i = minOf(reply.length, i + step)
+            live.onStreamed(reply.substring(0, i))
+        }
+        return live to said
+    }
+
+    @Test
+    fun `finished sentences are said while the rest is still coming`() {
+        val (live, said) = stream("hey. you there?\nwhatever")
+        assertEquals(listOf("hey.", "you there?"), said)
+        assertEquals("whatever", live.rest("hey. you there?\nwhatever"))
+    }
+
+    @Test
+    fun `a line she keeps to herself is never said, early or late`() {
+        val reply = "<< he is cute when he tries\nok fine. go"
+        val (live, said) = stream(reply)
+        assertTrue(said.none { "cute" in it })
+        assertEquals(listOf("ok fine."), said)
+        assertEquals("go", live.rest("ok fine. go"))
+    }
+
+    @Test
+    fun `a thought behind a name label or a quote is never said`() {
+        for (reply in listOf("Yume: << secret thing. really\nhi.", "\"<< secret thing. really\nhi.", "yume: \"<< secret thing.\nhi.")) {
+            val (_, said) = stream(reply)
+            assertTrue(reply, said.none { "secret" in it })
+        }
+    }
+
+    @Test
+    fun `a command line is never said`() {
+        val reply = "sure. watch this.\n>> flashlight on"
+        val (live, said) = stream(reply)
+        assertEquals(listOf("sure.", "watch this."), said)
+        assertNull(live.rest("sure. watch this."))
+    }
+
+    @Test
+    fun `half a marker holds the line back`() {
+        val said = ArrayList<String>()
+        val live = PersonaLiveSpeech { said += it }
+        live.onStreamed("<")
+        live.onStreamed("< not for him. at all. ")
+        assertTrue(said.isEmpty())
+    }
+
+    @Test
+    fun `a name label in front of said text is taken off`() {
+        val (_, said) = stream("Yume: hi there. ok")
+        assertEquals(listOf("hi there."), said)
+    }
+
+    @Test
+    fun `nothing more is said early once a reasoning tag shows up`() {
+        val (live, said) = stream("let me think. hmm </think> real answer. done")
+        assertEquals(listOf("let me think."), said)
+        assertFalse(said.any { "real answer" in it })
+        // The reply as it stands no longer begins with what was said: nothing more is said.
+        assertNull(live.rest("real answer. done"))
+    }
+
+    @Test
+    fun `a reply that changed at the end is not said again`() {
+        val (live, said) = stream("hello there. more")
+        assertEquals(listOf("hello there."), said)
+        assertNull(live.rest("something else entirely"))
+    }
+
+    @Test
+    fun `nothing said early means the whole reply is said at the end`() {
+        val (live, said) = stream("just one line no stop")
+        assertTrue(said.isEmpty())
+        assertFalse(live.spokeEarly)
+        assertEquals("just one line no stop", live.rest("just one line no stop"))
+    }
+
+    @Test
+    fun `japanese stops end a sentence without a space`() {
+        val (live, said) = stream("ねえ。なにしてんの")
+        assertEquals(listOf("ねえ。"), said)
+        assertEquals("なにしてんの", live.rest("ねえ。なにしてんの"))
+    }
+
+    @Test
+    fun `a decimal point does not end a sentence`() {
+        val (_, said) = stream("it took 3.5 hours")
+        assertTrue(said.isEmpty())
+    }
+
+    @Test
+    fun `the stretch after the last finished sentence waits for the end`() {
+        val (live, said) = stream("ok. so...")
+        assertEquals(listOf("ok."), said)
+        assertEquals("so...", live.rest("ok. so..."))
+    }
+
+    @Test
+    fun `chunks of any size say the same`() {
+        val reply = "hey. you there?\n<< ugh\nfine. whatever\n>> open spotify"
+        val one = stream(reply, 1).second
+        val big = stream(reply, 7).second
+        assertEquals(one.joinToString(" "), big.joinToString(" ").let { it })
+        assertTrue(one.none { "ugh" in it || "spotify" in it })
+    }
+
+    @Test
+    fun `a gesture in what is left at the end keeps its opening star, so it is not said`() {
+        val reply = "fine. *rolls eyes* whatever"
+        val (live, said) = stream(reply)
+        assertEquals(listOf("fine."), said)
+        val rest = live.rest(reply)
+        assertEquals("*rolls eyes* whatever", rest)
+        val spoken = SpeechTextNormalizer.normalize(rest!!, personaVoice = true)
+        assertFalse(spoken, "rolls" in spoken || "eyes" in spoken)
+        assertTrue(spoken, spoken.isNotBlank())
+    }
+
+    @Test
+    fun `a stop inside a gesture still open does not split the gesture`() {
+        val reply = "*leans back. stretches* hey. ok"
+        val (live, said) = stream(reply)
+        // The gesture goes whole, with the sentence it opens, and the voice drops it whole.
+        assertEquals(listOf("*leans back. stretches* hey."), said)
+        for (piece in said) {
+            val spoken = SpeechTextNormalizer.normalize(piece, personaVoice = true)
+            assertFalse(spoken, "leans" in spoken || "stretches" in spoken)
+        }
+        assertEquals("ok", live.rest(reply))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaLoopWiringTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLoopWiringTest.kt
new file mode 100644
index 0000000..6f38b44
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaLoopWiringTest.kt
@@ -0,0 +1,521 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * How the loop is wired while she is the one who talks: his talk stays hers, and what
+ * she starts never vanishes.
+ *
+ * The decisions themselves are pure functions with tests of their own
+ * (MessageShapeTest, PlanModificationTest, PersonaActionRowsTest, PlanReplyParsingTest).
+ * The loop that calls them needs a phone to run, so these tests read its source and
+ * fail when a call is dropped or moved to where it no longer holds.
+ */
+class PersonaLoopWiringTest {
+
+    private val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+
+    private fun function(name: String, next: String): String {
+        val body = loop.substringAfter(name, "")
+        assertTrue("$name not found", body.isNotEmpty())
+        assertTrue("$next not found after $name", body.contains(next))
+        return body.substringBefore(next)
+    }
+
+    private val processQueryLocked = function("private suspend fun processQueryLocked(", "private suspend fun notePersonaPlanLeftAtGate(")
+    private val notePersonaPlanLeftAtGate = function("private suspend fun notePersonaPlanLeftAtGate(", "private suspend fun savePersonaPlanLeftGateRow(")
+    private val savePersonaPlanLeftGateRow = function("private suspend fun savePersonaPlanLeftGateRow(", "private suspend fun routeWhilePersonaTalks(")
+    private val routeWhilePersonaTalks = function("private suspend fun routeWhilePersonaTalks(", "private suspend fun executeAliasDirect(")
+    private val executeSimpleQuery = function("private suspend fun executeSimpleQuery(", "private suspend fun savePersonaCommandNotRun(")
+    private val savePersonaCommandNotRun = function("private suspend fun savePersonaCommandNotRun(", "private suspend fun generatePlan(")
+    private val generatePlan = function("private suspend fun generatePlan(", "suspend fun personaOwnTime(")
+    private val runPersonaAction = function("private suspend fun runPersonaAction(", "private suspend fun savePersonaCommandRow(")
+    private val fallbackOrError = function("private suspend fun fallbackOrError(", "override fun approveProposedPlan(")
+    private val rejectProposedPlan = function("override fun rejectProposedPlan() {", "override fun forgetSession(")
+    private val executePlanLoop = function("private suspend fun executePlanLoop(", "private suspend fun endPersonaPlanNeeding(")
+    private val endPersonaPlanNeeding = function("private suspend fun endPersonaPlanNeeding(", "private suspend fun pauseForRetry(")
+    private val parkedForApproval = function("private suspend fun parkedForApproval(", "private suspend fun recordPersonaReinChange(")
+    private val recordPersonaReinChange = function("private suspend fun recordPersonaReinChange(", "private data class NeedsInputRetry(")
+    private val cancelCurrentTask = function("override fun cancelCurrentTask(record: Boolean) {", "private suspend fun resolveStaleProposedPlan(")
+
+    // ── Routing ──────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `with her on the message is sorted on the phone before any stock routing is reached`() {
+        val handOver = processQueryLocked.indexOf("if (persona.isActive(routeConfig)) {")
+        assertTrue(handOver >= 0)
+        val branch = processQueryLocked.substring(handOver).substringBefore("}")
+        assertTrue(branch.contains("routeWhilePersonaTalks(userMsg, query, context, sessionId, routeConfig, isMultiStep)"))
+        assertTrue(branch.contains("return"))
+        // Every stock shortcut and the stock sort stand after that return.
+        for (stock in listOf(
+            "AliasResolver.resolveContextual(", "AliasResolver.resolve(query)", "AliasResolver.isAlarmRequest(query)",
+            "AliasResolver.isTimerRequest(query)", "AliasResolver.isReadAndRememberRequest(query)",
+            "AliasResolver.isRecallMemoryRequest(query)", "intentClassifier.sort("
+        )) {
+            assertTrue(stock, processQueryLocked.indexOf(stock) > handOver)
+        }
+    }
+
+    @Test
+    fun `her routing never asks a model and never runs the stock shortcuts that take talk for a command`() {
+        val route = routeWhilePersonaTalks
+        assertTrue(route.contains("IntentClassifier.shapeWhilePersonaTalks("))
+        for (stock in listOf(
+            "intentClassifier.sort(", "requiresAction(", "getActiveProvider", "AliasResolver.resolve(",
+            "isRecallMemoryRequest", "isReadAndRememberRequest", "isAlarmRequest", "isTimerRequest"
+        )) {
+            assertFalse(stock, route.contains(stock))
+        }
+        // Talk and a screen question are hers; a command goes to the planner or, where
+        // the route policy refuses the planner, to her with the reason.
+        assertTrue(route.contains("MessageShape.Talk, MessageShape.ScreenTalk -> executeSimpleQuery(userMsg, sessionId, context)"))
+        assertTrue(route.contains("is MessageShape.Shortcut -> executeAliasDirect(shape.hint, query, context, sessionId)"))
+        assertTrue(route.contains("IntentClassifier.handling(config, personaActive = true, isCommand = true)"))
+        assertTrue(route.contains("MessageHandling.PLAN -> generatePlan(userMsg, context, sessionId)"))
+        assertTrue(route.contains("else -> executeSimpleQuery(userMsg, sessionId, context, plannerRefused = true)"))
+    }
+
+    @Test
+    fun `a screen question goes to her only with a screenshot her model is really given`() {
+        assertTrue(
+            routeWhilePersonaTalks.contains(
+                "screenshotReachesHer = userMsg.imageBase64 != null && persona.chatSeesImages(config)"
+            )
+        )
+    }
+
+    // ── The planner did not produce a plan ───────────────────────────────────────────
