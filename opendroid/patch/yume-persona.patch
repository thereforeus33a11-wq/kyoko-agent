+package com.opendroid.ai.core.persona
+
+import kotlin.math.ln
+
+/**
+ * Her own files, as text. The card is the part of her that goes into every reply; the
+ * library is everything else that is written about her, kept whole on the phone. For
+ * each reply the pages that fit what is being talked about are picked here, on the
+ * device, by plain word matching, and put next to the card. Nothing is asked of a model
+ * to choose them and nothing but the chosen pages leaves this object.
+ *
+ * Pure text handling, so that all of it can be tested on the JVM.
+ */
+object PersonaLibraryText {
+
+    /** One page: a `##` section of a file, or a part of one when the section is long. */
+    data class Page(
+        val file: String,
+        val heading: String,
+        val text: String,
+        val terms: Set<String>,
+        val headingTerms: Set<String>,
+        val keywords: Set<String>,
+        /** What the page is shown as: the index's name for it, or the heading without its bracket. */
+        val title: String? = null,
+        /** The heading of the section this page is a part of; the same for all its parts. */
+        val section: String = heading,
+        /** What the index puts in front of this page: the file's frame line, then the section's note. */
+        val frame: String? = null,
+        /** True for a page that holds facts about the owner himself, not about her. */
+        val aboutOwner: Boolean = false
+    ) {
+        /** What the page is called in her prompt: the file's topic and the heading. */
+        val label: String
+            get() = "${file.removePrefix(FILE_PREFIX).removePrefix("-").ifEmpty { "core" }}: ${title ?: heading}"
+
+        /** The page as it is put in front of her, with its frame line when it has one. */
+        val body: String get() = if (frame.isNullOrBlank()) text else "$frame\n$text"
+    }
+
+    /**
+     * What the optional index file says about the library. Every entry is about how a
+     * page is found or presented; none can add words to a page's own text.
+     */
+    data class Index(
+        /** Extra words per section: what the owner is likely to say when it matters. */
+        val keywords: Map<String, Set<String>> = emptyMap(),
+        /** Sections that stay on the shelf and are never put in front of her. */
+        val skippedSections: Set<String> = emptySet(),
+        /** Whole files that stay on the shelf. */
+        val skippedFiles: Set<String> = emptySet(),
+        /** file -> a line put in front of every page of that file. */
+        val frames: Map<String, String> = emptyMap(),
+        /** section -> the name shown for it instead of its heading. */
+        val titles: Map<String, String> = emptyMap(),
+        /** section -> a line put in front of that section's pages, after the file's frame. */
+        val notes: Map<String, String> = emptyMap(),
+        /** Sections that hold facts about the owner himself; held back where his details are. */
+        val aboutOwner: Set<String> = emptySet(),
+        /**
+         * Sections and whole files about what lies under her awareness. They are never
+         * pages she can look at; their text is what [underText] returns.
+         */
+        val underSections: Set<String> = emptySet(),
+        val underFiles: Set<String> = emptySet()
+    ) {
+        internal fun <T> forSection(map: Map<String, T>, file: String, heading: String): T? {
+            val key = indexKey(file, heading)
+            map[key]?.let { return it }
+            // An entry may name the start of a heading, so a long heading need not be repeated whole.
+            return map.entries
+                .filter { key.startsWith(it.key) && it.key.startsWith(file.trim().lowercase() + "|") && !it.key.endsWith("|") }
+                .maxByOrNull { it.key.length }?.value
+        }
+
+        internal fun skips(file: String, heading: String): Boolean =
+            file.trim().lowercase() in skippedFiles || file.trim().lowercase() in underFiles ||
+                forSection(skippedSections.associateWith { true }, file, heading) == true ||
+                isUnder(file, heading)
+
+        internal fun isUnder(file: String, heading: String): Boolean =
+            file.trim().lowercase() in underFiles ||
+                forSection(underSections.associateWith { true }, file, heading) == true
+    }
+
+    /** A piece of the talk to match pages against, and how much it counts. */
+    data class Cue(val text: String, val weight: Double)
+
+    /** Budget value that means: every page, in file order. */
+    const val EVERYTHING = -1
+
+    const val FILE_PREFIX = "kisaragi"
+
+    /** Stands for the owner's name in lower case, the way she types it. */
+    const val OWNER_LOWERCASE_PLACEHOLDER = "{{owner_lc}}"
+
+    private const val MAX_PAGE_CHARS = 2200
+    private const val MAX_PAGES = 6
+
+    /** A word found on more than this share of all pages says nothing about any one of them. */
+    private const val COMMON_SHARE = 0.22
+
+    /**
+     * Sections that are instructions about handling the files, not part of her. They are
+     * left on the shelf: in the app there is nobody for them to instruct.
+     */
+    private val SKIPPED_HEADINGS = listOf(
+        "before every reply",
+        "where the rest of her lives",
+        "where this connects"
+    )
+
+    /** Lines that only point at files on some other machine. */
+    private val DROPPED_LINE = Regex("""(/home/|attachments/|\.png`|\.jpg`|pass\d+ folder)""")
+
+    /**
+     * Words for what was done to her. It is buried too deep for her to know, so no
+     * sentence that uses one of them is ever put in front of her: the files were written
+     * by someone who knows, and she is not that someone.
+     */
+    private val BURIED = Regex("""(?i)bad ?plug|\bplug(?:ged|s)?\b|\bworms?\b|parasit|\binfect|\bimplant""")
+
+    /** Harmless ways the files date things by it, reworded so the sentence can stay. */
+    private val BURIED_REWORDINGS: List<Pair<Regex, String>> = listOf(
+        Regex("""(?i)\bafter the plug\b""") to "after she changed",
+        Regex("""(?i)\bplugged girls\b""") to "girls like her",
+        Regex("""(?i)\bplugged girl\b""") to "girl like her"
+    )
+
+    /** A bracketed pointer to another of the files, which means nothing on the phone. */
+    private val FILE_POINTER = Regex("""\s*\([^()]*\bkisaragi(?:-[a-z]+)?\b[^()]*\)""")
+
+    /** A file named in running text, and what that file is about, so the sentence still reads. */
+    private val FILE_NAME = Regex("""\bkisaragi-([a-z]+)\b""")
+    private val FILE_TOPICS = mapOf(
+        "voice" to "her voice", "life" to "her life", "mind" to "how she thinks", "mood" to "how she feels",
+        "taste" to "her taste", "now" to "her week", "street" to "her street", "look" to "her look",
+        "pics" to "her pictures", "gate" to "her ear for herself", "sound" to "how she sounds",
+        "switch" to "her two languages", "memory" to "her notebook", "all" to "her sheet", "plug" to "the ring"
+    )
+
+    private val SENTENCE_END = Regex("""(?<=[.!?])\s+""")
+    private val BULLET = Regex("""^(\s*[-*]\s+)""")
+
+    private val HEADING_2 = Regex("""^##\s+(.+?)\s*$""")
+    private val HEADING_1 = Regex("""^#\s+(.+?)\s*$""")
+    private val RULE = Regex("""^\s*-{3,}\s*$""")
+    private val WORD = Regex("""[a-z0-9]+""")
+
+    private val STOPWORDS: Set<String> = """
+        the and for are was were has have had not but with that this from her she hers his him he you your
+        yours they them their its into out about over under after before then than when what who whom why
+        how where which while will would could should can cant dont doesnt didnt isnt arent wont wasnt
+        one two any all some more most much many few own same other another each every both either neither
+        only just also very even still ever never always too off again here there now yet got get gets
+        say says said tell tells told ask asks asked like likes thing things way ways something anything
+        nothing someone anyone been being does did doing make makes made take takes took come comes came
+        want wants know knows think thinks see sees look looks yume kisaragi owner
+        hey hello yeah yes nope okay lol haha hmm well good really maybe guess going gonna today
+    """.trimIndent().split(Regex("""\s+""")).filter { it.isNotEmpty() }.toSet()
+
+    /** Lower-case words of [text] that can tell one page from another. */
+    fun terms(text: String): Set<String> {
+        val out = HashSet<String>()
+        for (match in WORD.findAll(text.lowercase())) {
+            val word = stem(match.value)
+            if (word.length >= 3 && word !in STOPWORDS && !word.all(Char::isDigit)) out += word
+        }
+        return out
+    }
+
+    /** Folds a plain plural onto its singular, so "nails" finds "nail". Nothing cleverer. */
+    private fun stem(word: String): String =
+        if (word.length > 4 && word.endsWith("s") && !word.endsWith("ss") && !word.endsWith("us")) {
+            word.dropLast(1)
+        } else {
+            word
+        }
+
+    /**
+     * A skill file with everything taken off that is addressed to a model rather than
+     * being about her: the front matter, the lock block under it, lines that point at
+     * files elsewhere, and the sections in [SKIPPED_HEADINGS].
+     */
+    fun clean(raw: String, keepBuried: Boolean = false): String {
+        val lines = raw.replace("\r\n", "\n").replace('\r', '\n').lines()
+        var index = 0
+        while (index < lines.size && lines[index].isBlank()) index++
+        if (index < lines.size && lines[index].trim() == "---") {
+            val close = (index + 1 until lines.size).firstOrNull { lines[it].trim() == "---" }
+            if (close != null) index = close + 1
+        }
+        val kept = ArrayList<String>(lines.size)
+        var beforeFirstHeading = true
+        var skipping = false
+        for (line in lines.drop(index)) {
+            val heading2 = HEADING_2.matchEntire(line)
+            if (heading2 != null) {
+                beforeFirstHeading = false
+                skipping = SKIPPED_HEADINGS.any { heading2.groupValues[1].lowercase().startsWith(it) }
+            } else if (HEADING_1.matches(line)) {
+                beforeFirstHeading = false
+                skipping = false
+            }
+            if (skipping) continue
+            // Above the first heading there is only the lock block and a line for a file router.
+            if (beforeFirstHeading) continue
+            if (RULE.matches(line)) continue
+            if (DROPPED_LINE.containsMatchIn(line)) continue
+            if (heading2 != null || HEADING_1.matches(line)) {
+                kept += line.trimEnd()
+                continue
+            }
+            val known = (if (keepBuried) withoutPointers(line) else withoutBuried(line)) ?: continue
+            kept += known.trimEnd()
+        }
+        return kept.joinToString("\n").replace(Regex("""\n{3,}"""), "\n\n").trim()
+    }
+
+    /**
+     * [line] without the sentences that use a [BURIED] word, or null when the line goes
+     * altogether. A line that opens on such a sentence is about the buried thing from
+     * start to finish (what follows would be an "it" with nothing to point at), so it
+     * goes whole; a later sentence is taken out alone.
+     */
+    /** [line] without bracketed pointers to other files and with inline file names turned into plain words. */
+    private fun withoutPointers(line: String): String =
+        FILE_NAME.replace(FILE_POINTER.replace(line, "")) { match -> FILE_TOPICS[match.groupValues[1]] ?: match.value }
+
+    private fun withoutBuried(line: String): String? {
+        var text = withoutPointers(line)
+        for ((pattern, replacement) in BURIED_REWORDINGS) text = pattern.replace(text, replacement)
+        if (!BURIED.containsMatchIn(text)) return text
+        val bullet = BULLET.find(text)?.value.orEmpty()
+        val sentences = text.removePrefix(bullet).trim().split(SENTENCE_END)
+        if (BURIED.containsMatchIn(sentences.first())) return null
+        return bullet + sentences.filterNot { BURIED.containsMatchIn(it) }.joinToString(" ")
+    }
+
+    /**
+     * Parses the optional index file. One entry per line, `#` starts a comment:
+     *
+     *     file | heading | word, word      extra words that point at that section
+     *     skip | file                      a whole file that stays on the shelf
+     *     skip | file | heading            one section that stays on the shelf
+     *     frame | file | text              a line put in front of every page of the file
+     *     title | file | heading | name    the name shown for a section
+     *     note | file | heading | text     a line put in front of that section's pages
+     *     about-him | file | heading       a section with facts about the owner himself
+     *     under | file                     a file about what lies under her awareness
+     *     under | file | heading           one such section
+     *
+     * The extra words are what the owner is likely to say when a section matters, which
+     * the section itself may never spell out. A skipped section is one that is about
+     * handling the files, or that holds what she does not know about herself.
+     */
+    fun parseIndex(text: String): Index {
+        val keywords = HashMap<String, Set<String>>()
+        val skippedSections = HashSet<String>()
+        val skippedFiles = HashSet<String>()
+        val frames = HashMap<String, String>()
+        val titles = HashMap<String, String>()
+        val notes = HashMap<String, String>()
+        val aboutOwner = HashSet<String>()
+        val underSections = HashSet<String>()
+        val underFiles = HashSet<String>()
+        for (line in text.lineSequence()) {
+            if (line.isBlank() || line.trimStart().startsWith("#")) continue
+            val parts = line.split("|").map { it.trim() }
+            when (parts[0].lowercase()) {
+                "skip" -> when (parts.size) {
+                    2 -> if (parts[1].isNotEmpty()) skippedFiles += parts[1].lowercase()
+                    3 -> if (parts[2].isNotEmpty()) skippedSections += indexKey(parts[1], parts[2])
+                }
+                "under" -> when (parts.size) {
+                    2 -> if (parts[1].isNotEmpty()) underFiles += parts[1].lowercase()
+                    3 -> if (parts[2].isNotEmpty()) underSections += indexKey(parts[1], parts[2])
+                }
+                "frame" -> if (parts.size >= 3 && parts[2].isNotEmpty()) {
+                    frames[parts[1].lowercase()] = parts.drop(2).joinToString(" | ")
+                }
+                "title" -> if (parts.size == 4 && parts[3].isNotEmpty()) titles[indexKey(parts[1], parts[2])] = parts[3]
+                "note" -> if (parts.size >= 4 && parts[3].isNotEmpty()) {
+                    notes[indexKey(parts[1], parts[2])] = parts.drop(3).joinToString(" | ")
+                }
+                "about-him" -> if (parts.size == 3 && parts[2].isNotEmpty()) aboutOwner += indexKey(parts[1], parts[2])
+                else -> if (parts.size == 3) {
+                    val words = parts[2].split(",").flatMap { terms(it) }.toSet()
+                    if (words.isNotEmpty()) keywords[indexKey(parts[0], parts[1])] = words
+                }
+            }
+        }
+        return Index(keywords, skippedSections, skippedFiles, frames, titles, notes, aboutOwner, underSections, underFiles)
+    }
+
+    private fun indexKey(file: String, heading: String): String =
+        file.trim().lowercase() + "|" + heading.trim().lowercase()
+
+    /**
+     * The text of [file] that is about what lies under her awareness, as the index marks
+     * it: the sections named there, or the whole file. Unlike a page it keeps the buried
+     * sentences, because this text is not offered to her as something she knows. It goes
+     * into her prompt under a heading that says exactly that (see [PersonaPrompts.UNDER_HEADING]).
+     */
+    fun underText(file: String, raw: String, index: Index): String {
+        val wholeFile = file.trim().lowercase() in index.underFiles
+        if (!wholeFile && index.underSections.none { it.startsWith(file.trim().lowercase() + "|") }) return ""
+        val out = ArrayList<String>()
+        var taking = false
+        var title = file
+        for (line in clean(raw, keepBuried = true).lines()) {
+            val heading1 = HEADING_1.matchEntire(line)
+            val heading2 = HEADING_2.matchEntire(line)
+            when {
+                heading1 != null -> {
+                    title = heading1.groupValues[1]
+                    taking = wholeFile || index.isUnder(file, title)
+                }
+                heading2 != null -> {
+                    taking = wholeFile || index.isUnder(file, heading2.groupValues[1])
+                    // A bracket after a heading is a note about the file, not part of it.
+                    if (taking) out += heading2.groupValues[1].substringBefore(" (").trim() + ":"
+                }
+                taking -> out += line
+            }
+        }
+        return out.joinToString("\n").replace(Regex("""\n{3,}"""), "\n\n").trim()
+    }
+
+    /** Splits one file into pages. [file] is its name without extension, e.g. `kisaragi-life`. */
+    fun pages(file: String, raw: String, index: Index = Index()): List<Page> {
+        if (file.trim().lowercase() in index.skippedFiles) return emptyList()
+        val body = clean(raw)
+        if (body.isBlank()) return emptyList()
+        var title = file
+        var heading: String? = null
+        val buffer = ArrayList<String>()
+        val out = ArrayList<Page>()
+
+        fun flush() {
+            val name = heading ?: title
+            if (index.skips(file, name)) {
+                buffer.clear()
+                return
+            }
+            val keywords = index.forSection(index.keywords, file, name).orEmpty()
+            // A bracket after a heading is a note about the file, not a name for the page.
+            val shownAs = index.forSection(index.titles, file, name) ?: name.substringBefore(" (").trim().ifEmpty { name }
+            val frame = listOfNotNull(
+                index.frames[file.trim().lowercase()],
+                index.forSection(index.notes, file, name)
+            ).joinToString("\n").ifEmpty { null }
+            val aboutOwner = index.forSection(index.aboutOwner.associateWith { true }, file, name) == true
+            val parts = splitLong(buffer)
+            parts.forEachIndexed { number, part ->
+                val text = part.joinToString("\n").trim()
+                if (text.length < 40) return@forEachIndexed
+                out += Page(
+                    file = file,
+                    heading = if (parts.size > 1 && number > 0) "$name (${number + 1})" else name,
+                    text = text,
+                    terms = terms(text),
+                    headingTerms = terms(name),
+                    keywords = keywords,
+                    title = if (parts.size > 1 && number > 0) "$shownAs (${number + 1})" else shownAs,
+                    section = name,
+                    aboutOwner = aboutOwner,
+                    frame = frame
+                )
+            }
+            buffer.clear()
+        }
+
+        for (line in body.lines()) {
+            val heading1 = HEADING_1.matchEntire(line)
+            val heading2 = HEADING_2.matchEntire(line)
+            when {
+                heading1 != null -> {
+                    flush()
+                    title = heading1.groupValues[1]
+                    heading = null
+                }
+                heading2 != null -> {
+                    flush()
+                    heading = heading2.groupValues[1]
+                }
+                else -> buffer += line
+            }
+        }
+        flush()
+        return out
+    }
+
+    /** Breaks a long section at line ends into parts of at most [MAX_PAGE_CHARS]. */
+    private fun splitLong(lines: List<String>): List<List<String>> {
+        val parts = ArrayList<List<String>>()
+        var current = ArrayList<String>()
+        var size = 0
+        for (line in lines) {
+            if (size > 0 && size + line.length + 1 > MAX_PAGE_CHARS) {
+                parts += current
+                current = ArrayList()
+                size = 0
+            }
+            current += line
+            size += line.length + 1
+        }
+        if (current.isNotEmpty()) parts += current
+        return parts
+    }
+
+    /** All pages of the library with what is needed to pick among them. */
+    class Shelf(val pages: List<Page>) {
+        /** How much a word in a page's text tells about that page; words found everywhere are absent. */
+        private val rarity: Map<String, Double>
+
+        init {
+            val counts = HashMap<String, Int>()
+            for (page in pages) for (term in page.terms) counts.merge(term, 1, Int::plus)
+            val total = pages.size.coerceAtLeast(1)
+            rarity = counts
+                .filterValues { it.toDouble() / total <= COMMON_SHARE || total < 12 }
+                .mapValues { ln(1.0 + total.toDouble() / it.value) }
+        }
+
+        val totalChars: Int get() = pages.sumOf { it.body.length }
+
+        /**
+         * The pages that fit [cues], best first, as many as fit into [budgetChars].
+         *
+         * A word of his can point at a page in three ways: it is one of the words listed
+         * for that page in the index, it is in the page's heading, or it is in the text
+         * and rare enough to mean something. A page is only picked when something the
+         * owner himself said points at it: her own last line can add weight to a page,
+         * never bring one in alone. Pages far behind the best match are left out, and
+         * with no match the answer is empty and she runs on the card. Without
+         * [withPagesAboutOwner] the pages that hold facts about him stay on the shelf:
+         * that is for a route his details are held back from.
+         */
+        fun select(cues: List<Cue>, budgetChars: Int, withPagesAboutOwner: Boolean = true): List<Page> {
+            val pages = if (withPagesAboutOwner) pages else pages.filterNot { it.aboutOwner }
+            if (pages.isEmpty() || budgetChars == 0) return emptyList()
+            if (budgetChars == EVERYTHING) return pages
+            val weightByTerm = HashMap<String, Double>()
+            for (cue in cues) {
+                for (term in terms(cue.text)) weightByTerm.merge(term, cue.weight, ::maxOf)
+            }
+            if (weightByTerm.none { it.value >= LEADING_WEIGHT }) return emptyList()
+            val scored = pages.mapNotNull { page ->
+                var score = 0.0
+                var led = false
+                for ((term, weight) in weightByTerm) {
+                    var gain = 0.0
+                    if (term in page.keywords) gain += KEYWORD_GAIN
+                    if (term in page.headingTerms) gain += HEADING_GAIN
+                    if (term in page.terms) gain += rarity[term] ?: 0.0
+                    if (gain > 0.0) {
+                        score += weight * gain
+                        if (weight >= LEADING_WEIGHT) led = true
+                    }
+                }
+                if (led && score >= MIN_SCORE) page to score else null
+            }.sortedByDescending { it.second }
+            val best = scored.firstOrNull()?.second ?: return emptyList()
+            val picked = ArrayList<Page>()
+            var left = budgetChars
+            for ((page, score) in scored) {
+                if (picked.size >= MAX_PAGES || score < best * TAIL_SHARE) break
+                // A long section comes in parts that share a heading; two of them say enough.
+                if (picked.count { it.file == page.file && it.section == page.section } >= PARTS_PER_SECTION) continue
+                val cost = page.body.length + page.label.length + 4
+                if (cost > left) continue
+                picked += page
+                left -= cost
+            }
+            return picked
+        }
+
+        private companion object {
+            const val LEADING_WEIGHT = 0.5
+            const val KEYWORD_GAIN = 5.0
+            const val HEADING_GAIN = 2.5
+            // A word of the text counts alone only when it is on a single page of the whole shelf.
+            const val MIN_SCORE = 4.5
+            const val TAIL_SHARE = 0.45
+            const val PARTS_PER_SECTION = 2
+        }
+    }
+
+    /** The pages as they are put into her prompt, with the owner's name filled in. */
+    fun render(pages: List<Page>, ownerName: String): String {
+        if (pages.isEmpty()) return ""
+        val name = ownerName.trim().ifEmpty { PersonaPrompts.OWNER_FALLBACK }
+        return pages.joinToString("\n\n") { page -> "[${page.label}]\n${page.body}" }
+            .replace(OWNER_LOWERCASE_PLACEHOLDER, name.lowercase())
+            .replace(PersonaPrompts.OWNER_PLACEHOLDER, name)
+            // A page must not be able to open one of the prompt's own sections.
+            .replace("===", "= = =")
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt
new file mode 100644
index 0000000..731fc64
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaMemory.kt
@@ -0,0 +1,82 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.MemoryRepository
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her notebook, stored as rows of the existing `memories` table under
+ * [PersonaNotes.KEY_PREFIX]. No schema change: the rows are ordinary long-term
+ * memories, so they show up in the Memory screen where the owner can read and
+ * delete them, and they are filtered out of the context the planner sees.
+ */
+@Singleton
+class PersonaMemory @Inject constructor(
+    private val memoryRepository: MemoryRepository
+) {
+    /** All notes, newest first. */
+    suspend fun notes(): List<PersonaNotes.Note> =
+        memoryRepository.getMemoriesByKeyPrefix(PersonaNotes.KEY_PREFIX)
+            // LIKE treats some characters as wildcards, so confirm the prefix for real.
+            .filter { it.key.startsWith(PersonaNotes.KEY_PREFIX) && it.type == MemoryType.SEMANTIC }
+            .sortedByDescending { it.timestamp }
+            .mapNotNull { PersonaNotes.fromStorage(it.key, it.value) }
+
+    /** Writes the starting notes once. A notebook the owner has emptied stays empty. */
+    suspend fun seedIfNeeded(seed: List<PersonaNotes.Note>) {
+        if (memoryRepository.getMemory(SEEDED_KEY) != null) return
+        if (notes().isEmpty()) {
+            // Oldest timestamps first so that anything learned later sorts above the seed.
+            val base = System.currentTimeMillis() - seed.size
+            seed.forEachIndexed { index, note ->
+                memoryRepository.saveMemory(
+                    Memory(note.storageKey, note.text, MemoryType.SEMANTIC, base + index)
+                )
+            }
+        }
+        memoryRepository.saveMemory(Memory(SEEDED_KEY, "1", MemoryType.SEMANTIC))
+    }
+
+    /** Stores [changes]: a note with a known key replaces the old one, a closed thread is removed. */
+    suspend fun apply(changes: List<PersonaNotes.Note>) {
+        for (note in changes) {
+            if (note.isClosedThread) {
+                memoryRepository.deleteMemory(note.storageKey)
+            } else {
+                memoryRepository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC))
+            }
+        }
+        prune()
+    }
+
+    /** When she last wrote unprompted, or 0. Stored so a restart does not make her write again. */
+    suspend fun lastCheckInAt(): Long =
+        memoryRepository.getMemory(CHECK_IN_KEY)?.value?.toLongOrNull() ?: 0L
+
+    suspend fun recordCheckIn(atMillis: Long) {
+        memoryRepository.saveMemory(Memory(CHECK_IN_KEY, atMillis.toString(), MemoryType.SEMANTIC))
+    }
+
+    /** Keeps the notebook bounded: past the cap the oldest threads and opinions go first. */
+    private suspend fun prune() {
+        val all = notes()
+        var excess = all.size - PersonaNotes.MAX_TOTAL_NOTES
+        if (excess <= 0) return
+        val oldestFirst = all.asReversed()
+        val expendable = oldestFirst.filter { it.kind == PersonaNotes.Kind.THREAD || it.kind == PersonaNotes.Kind.OPINION } +
+            oldestFirst.filter { it.kind == PersonaNotes.Kind.USER || it.kind == PersonaNotes.Kind.REL }
+        for (note in expendable) {
+            if (excess <= 0) break
+            memoryRepository.deleteMemory(note.storageKey)
+            excess--
+        }
+    }
+
+    private companion object {
+        /** Not a note (its kind is unknown to [PersonaNotes]); it only records that seeding ran. */
+        const val SEEDED_KEY = "${PersonaNotes.KEY_PREFIX}meta.seeded"
+        const val CHECK_IN_KEY = "${PersonaNotes.KEY_PREFIX}meta.lastcheckin"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt
new file mode 100644
index 0000000..e0bec98
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaNotes.kt
@@ -0,0 +1,177 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * The persona's own notebook: short plain-English notes she keeps between chats.
+ *
+ * A note is one line, `kind | key | text`. The same form is used for the seed file
+ * shipped with the app, for what the reflection call returns, and for display, so
+ * there is one parser and it is strict: a line that does not fit is dropped.
+ */
+object PersonaNotes {
+
+    /**
+     * Notes live in the existing `memories` table under this key prefix. The prefix is
+     * what keeps them out of the planner's "facts about user" context. No `_` or `%`:
+     * the DAO looks rows up with SQL LIKE, where those are wildcards.
+     */
+    const val KEY_PREFIX = "yume."
+
+    const val MAX_NOTE_CHARS = 200
+    private const val MAX_KEY_CHARS = 40
+    const val MAX_TOTAL_NOTES = 80
+
+    enum class Kind(val label: String) {
+        /** A lasting fact about the owner. */
+        USER("user"),
+        /** Where the two of them stand. */
+        REL("rel"),
+        /** An ongoing matter; the text ends with its status. */
+        THREAD("thread"),
+        /** A view she holds. */
+        OPINION("opinion"),
+        /** The owner corrected how she should talk or act. */
+        FIX("fix");
+
+        companion object {
+            fun fromLabel(label: String): Kind? = entries.firstOrNull { it.label == label.trim().lowercase() }
+        }
+    }
+
+    data class Note(val kind: Kind, val key: String, val text: String) {
+        val storageKey: String get() = "$KEY_PREFIX${kind.label}.$key"
+
+        /** A thread whose status says it is over; it is removed instead of stored. */
+        val isClosedThread: Boolean
+            get() = kind == Kind.THREAD && CLOSED_STATUS.containsMatchIn(text)
+
+        fun toLine(): String = "${kind.label} | $key | $text"
+    }
+
+    private val KEY_FORM = Regex("^[a-z0-9][a-z0-9-]{1,39}$")
+    private val CLOSED_STATUS = Regex("""\|\s*closed\s*$""", RegexOption.IGNORE_CASE)
+    private val CONTROL_CHARS = Regex("""[\u0000-\u001F\u007F]""")
+
+    /** Parses one `kind | key | text` line, or returns null when it does not fit the form. */
+    fun parseLine(line: String): Note? {
+        val cleaned = line.trim().removePrefix("-").removePrefix("*").trim()
+        if (cleaned.isEmpty() || cleaned.startsWith("#")) return null
+        val parts = cleaned.split("|", limit = 3)
+        if (parts.size != 3) return null
+        val kind = Kind.fromLabel(parts[0]) ?: return null
+        val key = parts[1].trim().lowercase().replace(' ', '-').replace('_', '-')
+        if (!KEY_FORM.matches(key)) return null
+        val text = CONTROL_CHARS.replace(parts[2], " ").replace(Regex("""\s+"""), " ").trim()
+        if (text.length < 3) return null
+        return Note(kind, key, text.take(MAX_NOTE_CHARS))
+    }
+
+    /** Parses a block of lines, keeping at most [limit] valid notes and the last one per key. */
+    fun parse(text: String, limit: Int = Int.MAX_VALUE): List<Note> {
+        val byKey = LinkedHashMap<String, Note>()
+        for (line in text.lineSequence()) {
+            val note = parseLine(line) ?: continue
+            byKey.remove(note.storageKey)
+            byKey[note.storageKey] = note
+            if (byKey.size >= limit) break
+        }
+        return byKey.values.toList()
+    }
+
+    /**
+     * [changes] that were written without sight of the notes of the [unseen] kinds, made
+     * safe to store next to [existing]. A change normally replaces the note with its key,
+     * which is how she updates one. A note she was not shown cannot be updated on purpose:
+     * a change that lands on its key by chance would wipe what she knew. Such a change is
+     * stored beside it instead, under that key with [BESIDE_SUFFIX], so nothing she wrote
+     * is lost and she can tidy the two herself when she next sees all of her notebook.
+     *
+     * The notebook must not fill up with what she already has. Every pass over the same
+     * talk tends to write the same thing again, so a change of an unseen kind that only
+     * repeats an existing note of that kind is dropped, and the beside-key is the same
+     * each time: a later pass replaces the note she wrote blind before, never adds a
+     * third. One hidden note therefore costs one extra note at most, however many passes
+     * run before she sees her whole notebook again.
+     */
+    fun besideUnseen(changes: List<Note>, existing: List<Note>, unseen: Set<Kind>): List<Note> {
+        if (unseen.isEmpty()) return changes
+        val existingKeys = existing.mapTo(HashSet()) { it.storageKey }
+        val placed = LinkedHashMap<String, Note>()
+        for (change in changes) {
+            if (change.kind !in unseen) {
+                placed[change.storageKey] = change
+                continue
+            }
+            if (existing.any { it.kind == change.kind && sameWords(it.text, change.text) }) continue
+            val note = if (change.storageKey in existingKeys) change.copy(key = besideKey(change.key)) else change
+            placed[note.storageKey] = note
+        }
+        return placed.values.toList()
+    }
+
+    /** Ends the key of a note that was written beside one she could not see. */
+    const val BESIDE_SUFFIX = "-unseen"
+
+    private fun besideKey(key: String): String =
+        if (key.endsWith(BESIDE_SUFFIX)) key else key.take(MAX_KEY_CHARS - BESIDE_SUFFIX.length) + BESIDE_SUFFIX
+
+    private fun sameWords(a: String, b: String): Boolean =
+        a.trim().replace(Regex("""\s+"""), " ").equals(b.trim().replace(Regex("""\s+"""), " "), ignoreCase = true)
+
+    /** Rebuilds a note from a stored row, or null when the row is not a persona note. */
+    fun fromStorage(storageKey: String, value: String): Note? {
+        if (!storageKey.startsWith(KEY_PREFIX)) return null
+        val rest = storageKey.removePrefix(KEY_PREFIX)
+        val kind = Kind.fromLabel(rest.substringBefore('.')) ?: return null
+        val key = rest.substringAfter('.', "")
+        if (key.isEmpty()) return null
+        return Note(kind, key, value)
+    }
+
+    /**
+     * The block that goes into the chat prompt, grouped by kind and capped at [maxChars].
+     * [notes] is expected newest first, so when the cap bites it is old notes that go.
+     * Notes of a kind in [leaveOut] are not rendered; they stay in the notebook untouched.
+     */
+    fun render(notes: List<Note>, maxChars: Int = 2400, leaveOut: Set<Kind> = emptySet()): String {
+        val shown = notes.filterNot { it.kind in leaveOut }
+        if (shown.isEmpty()) return ""
+        val order = listOf(Kind.FIX, Kind.REL, Kind.USER, Kind.THREAD, Kind.OPINION)
+        val headings = mapOf(
+            Kind.FIX to "He corrected you (this is how you do it now):",
+            Kind.REL to "Where you two stand:",
+            Kind.USER to "What you know about him:",
+            Kind.THREAD to "Still going on:",
+            Kind.OPINION to "What you think:"
+        )
+        var budget = maxChars
+        val kept = LinkedHashMap<Kind, MutableList<String>>()
+        // Corrections first so the cap never drops them, then everything else newest first.
+        val prioritised = shown.filter { it.kind == Kind.FIX } + shown.filterNot { it.kind == Kind.FIX }
+        for (note in prioritised) {
+            val line = "- ${note.text}"
+            if (line.length + 1 > budget) continue
+            budget -= line.length + 1
+            kept.getOrPut(note.kind) { mutableListOf() }.add(line)
+        }
+        return order.mapNotNull { kind ->
+            kept[kind]?.takeIf { it.isNotEmpty() }?.let { lines ->
+                headings.getValue(kind) + "\n" + lines.joinToString("\n")
+            }
+        }.joinToString("\n")
+    }
+
+    /**
+     * The same notes as plain `kind | key | text` lines, for the reflection call to read.
+     * Notes of a kind in [leaveOut] are not shown.
+     */
+    fun renderForReview(notes: List<Note>, maxChars: Int = 3000, leaveOut: Set<Kind> = emptySet()): String {
+        val sb = StringBuilder()
+        for (note in notes) {
+            if (note.kind in leaveOut) continue
+            val line = note.toLine()
+            if (sb.length + line.length + 1 > maxChars) break
+            sb.append(line).append('\n')
+        }
+        return sb.toString().trimEnd()
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt
new file mode 100644
index 0000000..84e3da4
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPhrasebook.kt
@@ -0,0 +1,195 @@
+package com.opendroid.ai.core.persona
+
+import java.util.concurrent.ConcurrentHashMap
+import kotlin.random.Random
+
+/**
+ * The fixed lines the app itself speaks (before a shortcut runs, when a plan has
+ * nothing to report, when it fails, when it asks for approval), written in the
+ * persona's voice.
+ *
+ * These are static on purpose: no model call, so they cost nothing and can never be
+ * reworded into something untrue. Every line says only what the stock line it
+ * replaces said: "starting", "done" or "failed".
+ * The approval prompt is the one line that carries facts, and it does not word them:
+ * the step count and the step lines are the app's own text, put in exactly as given.
+ * For a plan of hers whose words may be someone else's it says so, which is the app's
+ * own finding and the reason the plan is shown.
+ * Each key has several variants and never repeats the one it used last.
+ */
+class PersonaPhrasebook(private val random: Random = Random.Default) {
+
+    private val lastIndex = ConcurrentHashMap<String, Int>()
+
+    /** Spoken before an action starts. Names the thing; never claims it happened. */
+    fun preSpeech(action: String): String {
+        val options = PRE_SPEECH[action]
+        if (options != null) return pick("pre:$action", options)
+        val readable = action.lowercase().replace("_", " ")
+        return pick("pre:generic", GENERIC_PRE).replace("{action}", readable)
+    }
+
+    /** A plan finished and no step had anything to say for itself. */
+    fun goalDone(): String = pick("done", DONE)
+
+    /** A plan failed and no step left a message worth repeating. */
+    fun failure(): String = pick("failed", FAILED)
+
+    /** The user turned a proposed plan down. */
+    fun cancelled(): String = pick("cancelled", CANCELLED)
+
+    /** A contact name was needed and the reply did not contain one. */
+    fun missedContact(): String = pick("missed", MISSED_CONTACT)
+
+    /** The user picked [name] from a list of matching contacts. */
+    fun usingContact(name: String): String = pick("using", USING_CONTACT).replace("{name}", name)
+
+    /** Stands in for a reply that held nothing but a command of her own. */
+    fun ownAction(): String = pick("own", OWN_ACTION)
+
+    /** A command of her own came to nothing before any step ran. Says only that. */
+    fun ownActionFailed(): String = pick("ownFailed", OWN_ACTION_FAILED)
+
+    /**
+     * A plan of her own broke off after it had started. Says only what is known then:
+     * it stopped, and some of it may already have happened.
+     */
+    fun ownActionStopped(): String = pick("ownStopped", OWN_ACTION_STOPPED)
+
+    /**
+     * The spoken approval prompt for a plan, in her voice. [stepCount] and [stepLines]
+     * are built by the app from the steps that will run and are spoken word for word, in
+     * order; she adds nothing about what the plan does. Every variant names both answers,
+     * approve and cancel. [ownIdea] is true for a plan she started herself, and then the
+     * line says so.
+     *
+     * [wordsMayBeSomeoneElses] is true when the app found that the words of such a plan
+     * may not be hers (she was shown the screen, or the plan repeats text that came in
+     * from outside). Then the line does not vouch for the plan as her idea. It says that
+     * the words may be someone else's, which is the reason the plan is being shown.
+     */
+    fun approvalPrompt(
+        stepCount: String,
+        stepLines: List<String>,
+        ownIdea: Boolean,
+        wordsMayBeSomeoneElses: Boolean = false
+    ): String {
+        val template = when {
+            ownIdea && wordsMayBeSomeoneElses -> pick("approveBorrowed", APPROVAL_BORROWED)
+            ownIdea -> pick("approveOwn", APPROVAL_OWN)
+            else -> pick("approve", APPROVAL)
+        }
+        // The count goes in first, so a step line that happens to hold a placeholder stays as written.
+        return template.replace(COUNT, stepCount).replace(LINES, stepLines.joinToString(", "))
+    }
+
+    /** Spoken when the wake phrase is heard. Short, and never contains a wake phrase. */
+    fun wakeAck(): String = pick("wake", WAKE)
+
+    private fun pick(key: String, options: List<String>): String {
+        if (options.size == 1) return options[0]
+        val previous = lastIndex[key]
+        var index = random.nextInt(options.size)
+        if (index == previous) index = (index + 1) % options.size
+        lastIndex[key] = index
+        return options[index]
+    }
+
+    companion object {
+        internal val PRE_SPEECH: Map<String, List<String>> = mapOf(
+            "TOGGLE_FLASHLIGHT" to listOf("flashlight. ok", "mm. flashlight", "fine. light"),
+            "SET_ALARM" to listOf("alarm. ok", "mm. alarm", "fine. alarm"),
+            "SET_TIMER" to listOf("timer. ok", "mm. timer", "fine. timer"),
+            "TAKE_SCREENSHOT" to listOf("screenshot. ok", "mm. taking it", "fine. screenshot"),
+            "LOCK_SCREEN" to listOf("locking it", "ok. lock", "mm. locking"),
+            "TOGGLE_WIFI" to listOf("wifi. ok", "mm. wifi", "fine. wifi"),
+            "TOGGLE_BLUETOOTH" to listOf("bluetooth. ok", "mm. bluetooth", "fine. bluetooth"),
+            "TOGGLE_DND" to listOf("do not disturb. ok", "mm. quiet mode", "fine. do not disturb"),
+            "TOGGLE_HOTSPOT" to listOf("hotspot. ok", "mm. hotspot"),
+            "TOGGLE_MOBILE_DATA" to listOf("mobile data. ok", "mm. data"),
+            "SET_VOLUME" to listOf("volume. ok", "mm. volume", "fine. volume"),
+            "SET_BRIGHTNESS" to listOf("brightness. ok", "mm. brightness", "fine. brightness"),
+            "OPEN_APP" to listOf("opening it", "mm. opening", "fine. opening"),
+            "ANALYZE_SCREENSHOT" to listOf("show me your screen", "mm. looking", "ok. let me see"),
+            "READ_AND_REMEMBER_SCREEN" to listOf("reading your screen. keeping what matters", "mm. reading it", "ok. reading and saving"),
+            "READ_NOTES" to listOf("your notes. one sec", "mm. checking notes", "ok. notes"),
+            "RECALL_MEMORY" to listOf("checking what you saved", "mm. looking it up", "ok. checking"),
+            "ADD_NOTE" to listOf("note. ok", "mm. writing it down", "fine. note"),
+            "SET_RINGER_MODE" to listOf("ringer. ok", "mm. ringer"),
+            "PLAY_MUSIC" to listOf("music. ok", "mm. playing", "fine. music"),
+            "MAKE_CALL" to listOf("calling", "mm. calling", "ok. calling")
+        )
+
+        internal val GENERIC_PRE = listOf("ok. {action}", "mm. {action}", "fine. {action}")
+
+        internal val DONE = listOf("done", "there. done", "ok. done", "its done", "mm. done")
+
+        internal val FAILED = listOf(
+            "didnt work. try again",
+            "tch. that failed. try again",
+            "no. it didnt go through",
+            "that broke. say it again",
+            "muri. it failed"
+        )
+
+        internal val CANCELLED = listOf("ok. not doing it", "fine. dropped", "mm. cancelled")
+
+        internal val MISSED_CONTACT = listOf(
+            "didnt catch that. say the name again",
+            "hah? who. say the name",
+            "no name in that. try again"
+        )
+
+        internal val USING_CONTACT = listOf("ok. {name}", "mm. using {name}", "fine. {name}")
+
+        // None of these may read as yes, no or a command: the recogniser that opens next can
+        // hear the phone's own voice, and its transcript may answer a pending confirmation.
+        internal val WAKE = listOf("mm?", "what", "oi", "hah?", "say it")
+
+        internal val OWN_ACTION = listOf("watch", "hold on", "mm. one sec")
+
+        internal val OWN_ACTION_FAILED = listOf(
+            "tch. that one didnt go through",
+            "no. it didnt happen",
+            "muri. nothing happened"
+        )
+
+        // Steps may have run before it broke off, so none of these says that nothing happened.
+        internal val OWN_ACTION_STOPPED = listOf(
+            "tch. that stopped partway. some of it may have gone through",
+            "it broke off in the middle. check what already happened",
+            "muri. it stopped halfway. part of it may be done"
+        )
+
+        private const val COUNT = "{count}"
+        private const val LINES = "{lines}"
+
+        // Both answers are named in every variant: the recogniser that opens next listens for them.
+        internal val APPROVAL = listOf(
+            "{count}. {lines}. say approve or cancel",
+            "the plan is {count}. {lines}. approve or cancel",
+            "mm. {count}. {lines}. say approve. or cancel",
+            "{count} to run. {lines}. approve or cancel"
+        )
+
+        internal val APPROVAL_OWN = listOf(
+            "my idea. {count}. {lines}. approve or cancel",
+            "this one is mine. {count}. {lines}. say approve or cancel",
+            "i want to do this. {count}. {lines}. approve. or cancel"
+        )
+
+        // For a plan she started whose words the app could not take to be hers. No variant
+        // calls it her idea: he is being asked because it may not be.
+        internal val APPROVAL_BORROWED = listOf(
+            "look at this one first. the words in it may be somebody elses. {count}. {lines}. approve or cancel",
+            "i started this. but i was shown things, and the words may not be my own. {count}. {lines}. say approve or cancel",
+            "careful with this one. it may carry words that came from outside. {count}. {lines}. approve. or cancel"
+        )
+
+        /** Every line the phrasebook can produce, for tests that check their form. */
+        internal fun allLines(): List<String> =
+            PRE_SPEECH.values.flatten() + GENERIC_PRE + DONE + FAILED + CANCELLED +
+                MISSED_CONTACT + USING_CONTACT + WAKE + OWN_ACTION + OWN_ACTION_FAILED + OWN_ACTION_STOPPED +
+                APPROVAL + APPROVAL_OWN + APPROVAL_BORROWED
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PersonaPrompts.kt b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPrompts.kt
new file mode 100644
