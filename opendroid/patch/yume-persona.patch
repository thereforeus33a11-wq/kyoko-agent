+    // ── The engine around the one call ───────────────────────────────────────────────
+
+    private val ownMoment = engine.substringAfter("suspend fun ownMoment(").substringBefore("private fun momentFacts(")
+
+    @Test
+    fun `a moment is one request of her own, on her route and through the gate, with no retry`() {
+        // One call, to her own provider, marked as hers.
+        assertEquals(1, Regex("""answeredWhole\(""").findAll(ownMoment).count())
+        assertEquals(0, Regex("""\.(complete|streamComplete)\(""").findAll(ownMoment).count())
+        assertTrue(ownMoment.contains("answeredWhole(chatProvider(config), withChatModel(ownTimeRequest(systemPrompt), config))"))
+        // Asked once, either way the answer can be read whole.
+        val whole = engine.substringAfter("internal suspend fun answeredWhole(").substringBefore("internal fun ownTimeRequest(")
+        assertEquals(1, Regex("""provider\.complete\(request\)""").findAll(whole).count())
+        assertEquals(1, Regex("""provider\.streamComplete\(""").findAll(whole).count())
+        assertTrue(whole.indexOf("if (!provider.streamsLive) {") in 0 until whole.indexOf("provider.streamComplete("))
+        val request = engine.substringAfter("internal fun ownTimeRequest(").substringBefore("/** Her replies want more variety")
+        assertTrue(request.contains("retryPolicy = RetryPolicy.NONE"))
+        // The room of a reply: a model that thinks before it writes still gets to write.
+        assertTrue(request.contains("maxTokens = CHAT_MAX_TOKENS,"))
+        assertTrue(request.contains("text = PersonaOwnTime.TURN, sender = ChatMessage.Sender.USER"))
+        // Its system text is her chat prompt as for a reply, then the talk, then the block of the moment, last.
+        val prompt = ownMoment.substringAfter("val systemPrompt = chatSystemPrompt(").substringBefore("answeredWhole(")
+        assertTrue(prompt.contains("inOwnTime = true, nowMillis = nowMillis"))
+        assertTrue(prompt.indexOf("PersonaOwnTime.talkBlock(dialogue)") in 0 until prompt.indexOf("PersonaOwnTime.momentBlock("))
+        assertTrue(prompt.contains("PersonaOwnTime.momentBlock(\n                        momentFacts(\n                            config, before, recentMessages, nowMillis, zone, heldBack, ownPlanWaits,"))
+        assertTrue(prompt.trimEnd().endsWith("makesPictures = makesPictures\n                        )\n                    )"))
+        // The talk is held back the way a reply's is, and no image is ever sent.
