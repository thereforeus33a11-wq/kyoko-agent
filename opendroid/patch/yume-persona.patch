+        repeat(3) { u.learn(at(-30f, 120.0), 10, "en", null) }
+        val usualWpm = u.wordsPerMinute("en")!!
+        val m = at(-25f, 150.0)
+        // As many words in the same time would be his usual pace; 14 is faster.
+        val how = HowItSounded.judge(m, Tone.HAPPY, emptyList(), 14, "<|en|>", u)
+        assertEquals(5f, how.louderByDb!!, 0.5f)
+        assertEquals(Acoustics.semitones(150f) - Acoustics.semitones(120f), how.higherBySemitones!!, 0.4f)
+        assertEquals(1.4f, how.rateVsUsual!!, 0.05f)
+        assertEquals(usualWpm * 1.4f, how.wordsPerMinute!!, 1f)
+        val p = how.phrases()
+        assertTrue(p.toString(), p.contains("the phone guessed it sounded happy"))
+        assertTrue(p.toString(), p.contains("louder than he usually talks"))
+        assertTrue(p.toString(), p.contains("higher-pitched than usual"))
+        assertTrue(p.toString(), p.contains("faster than he usually talks"))
+        // Japanese has a usual of its own: none yet, so no pace against it.
+        assertNull(HowItSounded.judge(m, null, emptyList(), 14, "ja", u).rateVsUsual)
+    }
+
+    @Test
+    fun `nothing that stood out is no words, and a neutral tone is not mentioned`() {
+        val u = SoundUsual()
+        repeat(3) { u.learn(at(-30f, 120.0), 10, "en", null) }
+        val how = HowItSounded.judge(at(-30f, 120.0), Tone.NEUTRAL, emptyList(), 10, "en", u, pauseBeforeMillis = 900, afterHerMillis = 700)
+        // A steady tone is flat against nothing, but against his usual (as flat) it is as usual.
+        assertTrue(how.phrases().toString(), how.ordinary)
+    }
+
+    @Test
+    fun `a laugh, a pause before, the time after her line, and hesitation are told`() {
+        val m = Acoustics.measure(voiced(800, 140.0) + silence(500) + voiced(800, 140.0) + silence(400) + voiced(800, 140.0, toHz = 200.0))!!
+        val how = HowItSounded.judge(m, null, listOf(SoundEvent.LAUGHTER), 6, "en", null, pauseBeforeMillis = 3_200, afterHerMillis = 4_000)
+        val p = how.phrases()
+        assertEquals("laughing", p.first())
+        assertTrue(p.toString(), p.contains("with a couple of stops"))
+        assertTrue(p.toString(), p.contains("after a pause"))
+        assertTrue(p.toString(), p.contains("a moment after your line ended"))
+        // Said as a person in the room would notice it: a long wait is long, never so many seconds.
+        val later = HowItSounded.judge(m, null, emptyList(), 6, "en", null, pauseBeforeMillis = 9_000, afterHerMillis = 12_000).phrases()
+        assertTrue(later.toString(), later.contains("after a long pause"))
+        assertTrue(later.toString(), later.contains("a while after your line ended"))
+        assertFalse(later.joinToString().contains(" s "))
+        // What he said and how it sounded stay out of a log line.
+        assertFalse(how.toString().contains("laugh"))
+        assertFalse(m.toString().contains(m.levelDb.toString()))
+    }
+
+    @Test
+    fun `another voice is told only by the sounds named and a whisper or a shout`() {
+        val loud = Acoustics.measure(FloatArray(16_000) { if ((it / 40) % 2 == 0) 1f else -1f })!!
+        val other = HowItSounded.ofAnother(listOf(SoundEvent.LAUGHTER), loud)
+        assertEquals(listOf("laughing", "shouting"), other.phrases())
+        assertNull(other.tone)
+        assertNull(other.measure)
+        assertNull(other.wordsPerMinute)
+        val plain = HowItSounded.ofAnother(emptyList(), Acoustics.measure(voiced(1_500, 150.0))!!)
+        // Flat or not, how another voice moves is not hers to be told.
+        assertTrue(plain.ordinary)
+        assertTrue(HowItSounded.ofAnother(listOf(SoundEvent.MUSIC), null).phrases() == listOf("music in the background"))
+    }
+
+    @Test
+    fun `pace without a usual is only the plain extremes, and only with enough words`() {
+        assertNull(SoundUsual.wordsPerMinute(2, 5_000))
+        assertNull(SoundUsual.wordsPerMinute(10, 1_000))
+        assertEquals(120f, SoundUsual.wordsPerMinute(6, 3_000)!!, 0.01f)
+        val m = Acoustics.measure(voiced(2_000, 150.0, toHz = 220.0))!!
+        val fast = HowItSounded.judge(m, null, emptyList(), 9, "en", null)
+        assertTrue(fast.phrases().toString(), fast.phrases().contains("fast"))
+        val slow = HowItSounded.judge(m, null, emptyList(), 3, "en", null)
+        assertTrue(slow.phrases().toString(), slow.phrases().contains("slow"))
+    }
+
+    @Test
+    fun `semitones and back`() {
+        assertEquals(0f, Acoustics.semitones(100f), 1e-4f)
+        assertEquals(12f, Acoustics.semitones(200f), 1e-4f)
+        assertEquals(150f, Acoustics.hzOf(Acoustics.semitones(150f)), 1e-2f)
+        assertEquals((12 * ln(1.5) / ln(2.0)).toFloat(), Acoustics.semitones(150f), 1e-4f)
+        assertTrue(abs(Acoustics.levelDb(FloatArray(10) { 0.5f }) - (-6.02f)) < 0.05f)
+    }
+}
