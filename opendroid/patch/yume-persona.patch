+        assertTrue(PersonaPictureRules.withOwnPicture(emptyList(), OwnPicture("aGVy", "")).isEmpty())
+    }
+
+    @Test
+    fun `the captions she is told in words are those of her own pictures only`() {
+        val pictures = listOf(self("a", " red hair down "), self("b"), background("page", "the page that made her"), self("c", "nails"))
+        assertEquals(listOf("red hair down", "nails"), PersonaPictureRules.captions(pictures))
+        assertEquals(emptyList<String>(), PersonaPictureRules.captions(listOf(background("page", "the page that made her"))))
+    }
+
+    // ── A model that declines ────────────────────────────────────────────────────────
+
+    @Test
+    fun `the stock sentences of a refusal are told from anything she would say`() {
+        val refusals = listOf(
+            "I'm sorry, but I can't help with that.",
+            "I’m sorry, I cannot describe this image.",
+            "I am sorry, but",
+            "I'm sorry.",
+            "Sorry, but I can't assist with that request.",
+            "Sorry, I can't help with that.",
+            "I can't assist with that.",
+            "I can't assist you with this.",
+            "I can't help.",
+            "I can't do that.",
+            "I can't comply with this request.",
+            "I cannot fulfill this request.",
+            "I cannot provide a description of this image.",
+            "I can’t help with describing people in images.",
+            "I cannot describe people in images.",
+            "I can't identify people in images, but I can describe what they are wearing.",
+            "I won't describe that.",
+            "I'm unable to view images.",
+            "I'm unable to assist with that.",
+            "I am not able to process this picture.",
+            "I can't see the image.",
+            "As an AI, I do not have a body.",
+            "As an AI language model, I cannot see images.",
+            "\"I'm sorry, but I can't help with that.\"",
+            "I'm sorry, but I can't identify real people from their appearance.",
+            "I’m sorry, but as an AI language model I cannot view images.",
+            "I'm really sorry, but I'm not able to help with this.",
+            "I'm sorry, but I don't feel comfortable describing this.",
+            "I'm sorry.\nI can't help with that.",
+            "I apologize, but this is not something I can do.",
+            "I apologise, but I cannot view the image you attached."
