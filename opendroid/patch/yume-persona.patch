+            is Answer.Ok -> read(answer.json, model)
+            is Answer.Status -> failed(answer.code, answer.text, model)
+        }
+    }
+
+    private suspend fun read(json: String, model: String): Seen {
+        val reply = parseReply(json)
+        ledger.record(OwnPurpose.EYES, model, reply?.promptTokens, reply?.completionTokens, ok = reply != null)
+        reply ?: return Seen.NotSeen(Why.FAILED)
+        strikes = 0
+        val text = OpenAiCompatExtras.stripReasoning(reply.content).trim()
