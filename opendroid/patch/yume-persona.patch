+
+    @Test
+    fun `a line under her plain badge is taken for her line about a marked result only when everything says so`() {
+        val exact = "Alarm set for 7:30."
+        fun kept(line: String, exactRow: SessionMessage, after: Long): Boolean {
+            val rows = listOf(
+                his("set an alarm", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE), exactRow,
+                hers(line, exactRow.message.timestamp + after), his("ok", 5 * hour)
+            ).map { it.message }
+            return PersonaPrompts.shapeHistory(rows, holdBackPrivateResults = true).dialogue.any { it.text.contains(line) }
+        }
+        val marked = app(exact, 1_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE)
+
+        // Stored before her result lines had a badge: right behind the exact row, with its facts kept.
+        assertTrue(PersonaTruth.keepsFacts(exact, "7:30 it is", success = true))
+        assertFalse(kept("7:30 it is", marked, after = 3_000))
+        // The same words an hour later were not her line about that result.
+        assertTrue(kept("7:30 it is", marked, after = hour))
+        // A line that does not keep the facts of the row was never stored as one.
+        assertFalse(PersonaTruth.keepsFacts(exact, "eight. you are welcome", success = true))
+        assertTrue(kept("eight. you are welcome", marked, after = 3_000))
+        // Behind a row that is not the exact row of a result: another badge, or too long to have been put to her.
+        assertTrue(kept("7:30 it is", app(exact, 1_010, badge = PersonaPrompts.privateBadge(PersonaPrompts.PLANNER_BADGE)), after = 3_000))
+        val long = "Alarm set for 7:30. " + "It rings every day. ".repeat(20)
+        assertTrue(long.length > PersonaTruth.MAX_CHARS)
+        assertTrue(kept("7:30 it is", app(long, 1_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE), after = 3_000))
+        // Behind a row that may go anywhere nothing is held back at all.
