+
+    private fun json(body: String) =
+        MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(body).build()
+
+    @Test
+    fun `the reply is decrypted and nothing readable crosses the wire`() = runBlocking {
+        serve(listOf("you said your father ", "still owns it. ", "www"))
+
+        val response = provider.complete(newRequest())
+
+        assertEquals("you said your father still owns it. www", response.content)
+        assertEquals("e2ee-test-model", response.model)
+
+        val wire = chatBodies.single()
+        for (secret in listOf(secretSystem, secretEarlierUser, secretEarlierReply, secretUser, "jeep", "Yume")) {
+            assertFalse("\"$secret\" was sent in the clear", wire.contains(secret))
+        }
+    }
+
+    @Test
+    fun `only the enclave's key opens what was sent, and her earlier lines travel inside it`() = runBlocking {
+        serve(listOf("mm"))
+        provider.complete(newRequest())
+
+        val body = JsonParser.parseString(chatBodies.single()).asJsonObject
+        assertTrue(body.get("stream").asBoolean)
+        assertEquals("e2ee-test-model", body.get("model").asString)
+        val messages = body.getAsJsonArray("messages").map { it.asJsonObject }
+        assertEquals(listOf("system", "user"), messages.map { it.get("role").asString })
+        assertFalse("no assistant turn may be sent: the protocol would leave it unencrypted",
+            messages.any { it.get("role").asString == "assistant" })
+
+        val system = VeniceE2ee.decrypt(messages[0].get("content").asString, enclave.privateKey)
+        val user = VeniceE2ee.decrypt(messages[1].get("content").asString, enclave.privateKey)
+        assertTrue(system.startsWith(secretSystem))
+        assertTrue(system.contains("User: $secretEarlierUser"))
+        assertTrue(system.contains("You: $secretEarlierReply"))
+        assertEquals(secretUser, user)
+        assertFalse(body.has("response_format"))
+    }
+
+    @Test
+    fun `the request carries the keys the protocol asks for`() = runBlocking {
+        serve(listOf("ok"))
+        provider.complete(newRequest())
+
+        server.takeRequest() // attestation
+        val chat = server.takeRequest()
+        assertEquals("Bearer $apiKey", chat.headers["Authorization"])
+        assertEquals(enclave.publicKeyHex, chat.headers["X-Venice-TEE-Model-Pub-Key"])
+        assertEquals("ecdsa", chat.headers["X-Venice-TEE-Signing-Algo"])
+        assertEquals(130, chat.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty().length)
+    }
+
+    @Test
+    fun `an enclave that fails attestation gets nothing`() {
+        attestationVerified = false
+        serve(listOf("ok"))
+
+        assertThrows(Exception::class.java) { runBlocking { provider.complete(newRequest()) } }
+        assertTrue("no chat request may follow a failed attestation", chatBodies.isEmpty())
+    }
+
+    @Test
+    fun `an attestation for another request gets nothing`() {
+        echoNonce = false
+        serve(listOf("ok"))
+
+        assertThrows(Exception::class.java) { runBlocking { provider.complete(newRequest()) } }
+        assertTrue(chatBodies.isEmpty())
+    }
+
+    @Test
+    fun `extra options are sent but can never replace the encrypted messages`() = runBlocking {
+        serve(listOf("ok"))
+
+        provider.complete(
+            newRequest().copy(
+                extraBodyOverride = """{"reasoning_effort":"none","stream":false,"messages":[{"role":"user","content":"plain"}]}"""
+            )
+        )
+
+        val body = JsonParser.parseString(chatBodies.single()).asJsonObject
+        assertEquals("none", body.get("reasoning_effort").asString)
+        assertTrue(body.get("stream").asBoolean)
+        assertFalse(chatBodies.single().contains("plain"))
+    }
+
+    private fun newRequest() = LLMRequest(
+        systemPrompt = secretSystem,
+        messages = listOf(
+            ChatMessage("1", secretEarlierUser, ChatMessage.Sender.USER),
+            ChatMessage("2", secretEarlierReply, ChatMessage.Sender.AGENT),
+            ChatMessage("3", secretUser, ChatMessage.Sender.USER)
+        ),
+        model = "e2ee-test-model",
+        responseFormat = ResponseFormat.JSON,
+        providerConfig = ProviderRequestConfig(apiKey = apiKey, endpoint = server.url("/v1").toString())
+    )
+
+    private fun newSettingsRepository() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-e2ee-test").resolve("settings.preferences_pb").toFile()
+            }
+        ),
+        providerCredentialStore = EmptyProviderCredentialStore(),
+        runStartupMigration = false
+    )
+
+    private class EmptyProviderCredentialStore : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
