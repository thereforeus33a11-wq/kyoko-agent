+/**
+ * The card "HER OWN LIFE": his switch for her own life, his number of calls on her own,
+ * the length and steps of an outing, whether he is asked first, her reading, and her
+ * feeds. Shown only where she has a card.
+ */
+@Composable
+fun HerOwnLifeCard(
+    config: LLMConfig,
+    viewModel: SettingsViewModel,
+    presence: PersonaPresenceViewModel = hiltViewModel(),
+    feeds: OwnLifeViewModel = hiltViewModel()
+) {
+    val card by presence.card.collectAsState()
+    // Until the card has been looked for nothing is shown, and a build without one has no life of hers to set.
+    val cardState = card ?: return
+    if (!cardState.present) return
+    LaunchedEffect(Unit) { feeds.loadFollowed() }
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+            Text(
+                text = "HER OWN LIFE",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            SettingSwitchRow(
+                title = OWN_LIFE_TITLE,
+                description = OWN_LIFE_HINT,
+                checked = config.personaOwnLife,
+                onCheckedChange = viewModel::updatePersonaOwnLife
+            )
+            if (!config.personaOwnLife) return@Column
+            if (!config.personaCheckInsEnabled || config.personaOwnTimeMaxPerDay <= 0) {
+                Text(text = OWN_LIFE_NEEDS_OWN_TIME, fontSize = 11.sp, color = AccentCyan)
+            }
+            SettingChoiceRow(
+                label = "Model calls on her own in any 24 hours",
+                options = ownCallsChoices(config.personaOwnCallsPerDay),
+                selected = config.personaOwnCallsPerDay.coerceAtLeast(1),
+                onSelect = viewModel::updatePersonaOwnCallsPerDay
+            )
+            Text(text = OWN_LIFE_CALLS_HINT, fontSize = 10.sp, color = TextSecondary)
+            OutlinedTextField(
+                value = config.personaOwnTimeKey,
+                onValueChange = viewModel::updatePersonaOwnTimeKey,
+                label = { Text(OWN_TIME_KEY_LABEL, fontSize = 12.sp) },
+                singleLine = true,
+                visualTransformation = PasswordVisualTransformation(),
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password),
+                colors = fieldColors(),
+                modifier = Modifier.fillMaxWidth()
+            )
+            Text(text = OWN_TIME_KEY_HINT, fontSize = 10.sp, color = TextSecondary)
+            SettingChoiceRow(
+                label = "Longest outing",
+                options = outingMinutesChoices(config.personaOutingMaxMinutes),
+                selected = config.personaOutingMaxMinutes.coerceAtLeast(1),
+                onSelect = viewModel::updatePersonaOutingMaxMinutes
+            )
+            SettingChoiceRow(
+                label = "Most steps of one outing",
+                options = outingStepsChoices(config.personaOutingMaxSteps),
+                selected = config.personaOutingMaxSteps.coerceAtLeast(1),
+                onSelect = viewModel::updatePersonaOutingMaxSteps
+            )
+            SettingSwitchRow(
+                title = OUTINGS_ASK_TITLE,
+                description = OUTINGS_ASK_HINT,
+                checked = config.personaOutingsAsk,
+                onCheckedChange = viewModel::updatePersonaOutingsAsk
+            )
+            SettingSwitchRow(
+                title = LEND_TITLE,
+                description = LEND_HINT,
+                checked = config.personaLendScreen,
+                onCheckedChange = viewModel::updatePersonaLendScreen
+            )
+            SettingSwitchRow(
+                title = READS_TITLE,
+                description = READS_HINT,
+                checked = config.personaReads,
+                onCheckedChange = viewModel::updatePersonaReads
+            )
+            if (config.personaReads) {
+                SettingSwitchRow(
+                    title = SEARCH_TITLE,
+                    description = SEARCH_HINT,
+                    checked = config.personaSearch == com.opendroid.ai.data.models.PersonaSearch.VENICE,
+                    onCheckedChange = viewModel::updatePersonaVeniceSearch
+                )
+                HerFeedsList(config, viewModel, feeds)
+            }
+            HerEyesSettings(config, viewModel, feeds)
+            HerEarsSettings(config, viewModel)
+        }
+    }
+}
