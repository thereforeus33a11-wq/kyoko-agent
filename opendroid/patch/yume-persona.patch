+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersonaNotesTest {
+
+    @Test
+    fun `a well formed line becomes a note`() {
+        val note = PersonaNotes.parseLine("user | hive | he keeps 9 hives and talks about it too much")
+        assertEquals(Note(Kind.USER, "hive", "he keeps 9 hives and talks about it too much"), note)
+        assertEquals("yume.user.hive", note!!.storageKey)
+    }
+
+    @Test
+    fun `keys are normalised and bullets tolerated`() {
+        val note = PersonaNotes.parseLine("- Opinion | Bad Jokes | his jokes are bad and he knows")
+        assertEquals(Note(Kind.OPINION, "bad-jokes", "his jokes are bad and he knows"), note)
+    }
+
+    @Test
+    fun `lines that do not fit the form are dropped`() {
+        for (line in listOf(
+            "", "NONE", "# comment", "user | hive", "mood | x1 | something", "user | !! | text",
+            "user | a | too short key", "user | ok-key | hi", "just a sentence about him"
+        )) {
+            assertNull(line, PersonaNotes.parseLine(line))
+        }
+    }
+
+    @Test
+    fun `long text is cut and control characters removed`() {
+        val note = PersonaNotes.parseLine("rel | stage | " + "x".repeat(500) + "\u0007")!!
+        assertEquals(PersonaNotes.MAX_NOTE_CHARS, note.text.length)
+        assertFalse(note.text.contains('\u0007'))
+    }
+
+    @Test
+    fun `parse keeps the last note per key and honours the limit`() {
+        val text = """
+            user | bee | he keeps 9 hives
+            chatter that is not a note
+            user | bee | he sold the hive
+            thread | body | 3d model: rig still missing | open
+            opinion | hosts | hosts are scammers with good hair
+            fix | emoji | stop ending lines with an emoji
+        """.trimIndent()
+        val all = PersonaNotes.parse(text)
+        assertEquals(listOf("he sold the hive"), all.filter { it.key == "bee" }.map { it.text })
+        assertEquals(4, all.size)
+        assertEquals(2, PersonaNotes.parse(text, limit = 2).size)
+    }
+
+    @Test
+    fun `a closed thread is recognised`() {
+        assertTrue(PersonaNotes.parseLine("thread | body | rig finished | closed")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("thread | body | rig missing | open")!!.isClosedThread)
+        assertFalse(PersonaNotes.parseLine("user | door | he closed the shop | closed")!!.isClosedThread)
+    }
+
+    @Test
+    fun `storage round trip and foreign rows`() {
+        val note = Note(Kind.THREAD, "body", "rig missing | open")
+        assertEquals(note, PersonaNotes.fromStorage(note.storageKey, note.text))
+        assertNull(PersonaNotes.fromStorage("wife_name", "Sara"))
+        assertNull(PersonaNotes.fromStorage("yume.meta.seeded", "1"))
+        assertNull(PersonaNotes.fromStorage("yume.user.", "x"))
+    }
+
+    @Test
+    fun `render groups by kind with corrections first and respects the cap`() {
+        val notes = listOf(
+            Note(Kind.OPINION, "hosts", "hosts are scammers"),
+            Note(Kind.USER, "bee", "he keeps 9 hives"),
+            Note(Kind.FIX, "emoji", "no emoji at the end of every line"),
+            Note(Kind.THREAD, "body", "rig missing | open")
+        )
+        val block = PersonaNotes.render(notes)
+        assertTrue(block.indexOf("no emoji") < block.indexOf("he keeps 9 hives"))
+        assertTrue(block.indexOf("he keeps 9 hives") < block.indexOf("rig missing"))
+        assertTrue(block.indexOf("rig missing") < block.indexOf("hosts are scammers"))
+
+        val tight = PersonaNotes.render(notes, maxChars = 45)
+        assertTrue(tight, tight.contains("no emoji"))
+        assertFalse(tight, tight.contains("hosts are scammers"))
+        assertEquals("", PersonaNotes.render(emptyList()))
+    }
+
+    private val mixed = listOf(
+        Note(Kind.USER, "bees", "he keeps bees"),
+        Note(Kind.REL, "stage", "we are past the polite part"),
+        Note(Kind.USER, "tea", "he drinks oolong"),
+        Note(Kind.THREAD, "hive", "the second hive is not built | open"),
+        Note(Kind.FIX, "emoji", "no emoji at the end of every line"),
+        Note(Kind.OPINION, "hosts", "hosts are scammers")
+    )
+
+    @Test
+    fun `kinds that are left out are not rendered and everything else still is`() {
+        val all = PersonaNotes.render(mixed)
+        assertTrue(all.contains("What you know about him:"))
+        assertTrue(all.contains("- he keeps bees"))
+        assertEquals(all, PersonaNotes.render(mixed, leaveOut = emptySet()))
+
+        val withoutHim = PersonaNotes.render(mixed, leaveOut = setOf(Kind.USER))
+        assertFalse(withoutHim, withoutHim.contains("What you know about him"))
+        assertFalse(withoutHim, withoutHim.contains("bees"))
+        assertFalse(withoutHim, withoutHim.contains("oolong"))
+        for (kept in listOf("past the polite part", "second hive", "no emoji", "hosts are scammers")) {
+            assertTrue(kept, withoutHim.contains(kept))
+        }
+        assertEquals("", PersonaNotes.render(mixed.filter { it.kind == Kind.USER }, leaveOut = setOf(Kind.USER)))
+    }
+
+    @Test
+    fun `the notebook shown for review leaves the same kinds out`() {
+        val all = PersonaNotes.renderForReview(mixed)
+        assertTrue(all.contains("user | bees | he keeps bees"))
+        assertEquals(mixed.size, all.lines().size)
+
+        val withoutHim = PersonaNotes.renderForReview(mixed, leaveOut = setOf(Kind.USER))
+        assertFalse(withoutHim, withoutHim.contains("user |"))
+        assertFalse(withoutHim, withoutHim.contains("bees"))
+        assertEquals(4, withoutHim.lines().size)
+        assertTrue(withoutHim.contains("rel | stage | we are past the polite part"))
+        // A note that is left out does not use up the room of one that is shown.
+        val tight = PersonaNotes.renderForReview(mixed, maxChars = 50, leaveOut = setOf(Kind.USER))
+        assertEquals("rel | stage | we are past the polite part", tight)
+    }
+
+    @Test
+    fun `a note written without sight of the ones about him goes beside them, not over them`() {
+        val existing = listOf(
+            Note(Kind.USER, "bees", "he keeps bees and sells the honey at the market"),
+            Note(Kind.USER, "bees-2", "he lost a hive last winter"),
+            Note(Kind.REL, "stage", "we are past the polite part")
+        )
+        val changes = listOf(
+            Note(Kind.USER, "bees", "he is building a second hive"),
+            Note(Kind.USER, "tea", "he drinks oolong"),
+            Note(Kind.REL, "stage", "he asks before he assumes now")
+        )
+
+        val stored = PersonaNotes.besideUnseen(changes, existing, unseen = setOf(Kind.USER))
+
+        // The note she could not see keeps its key, so it is not replaced. Neither is
+        // "bees-2", which she may have written herself with all of her notebook in sight.
+        assertEquals(Note(Kind.USER, "bees-unseen", "he is building a second hive"), stored[0])
+        // A new key, and a kind she did see, are stored as she wrote them.
+        assertEquals(changes[1], stored[1])
+        assertEquals(changes[2], stored[2])
+        // With all of the notebook in front of her a change replaces the note, as it always has.
+        assertEquals(changes, PersonaNotes.besideUnseen(changes, existing, unseen = emptySet()))
+    }
+
+    @Test
+    fun `a moved note keeps a key that still parses, and the same words are not stored twice`() {
+        val longKey = "a".repeat(40)
+        val existing = listOf(
+            Note(Kind.USER, longKey, "he keeps bees"),
+            Note(Kind.USER, "tea", "he drinks oolong"),
+            Note(Kind.USER, "hives", "He has  two hives.")
+        )
+        val stored = PersonaNotes.besideUnseen(
+            listOf(
+                Note(Kind.USER, longKey, "he keeps two hives"),
+                // The same words as a note she has: under its own key, and under another one.
+                Note(Kind.USER, "tea", "he drinks oolong"),
+                Note(Kind.USER, "apiary", "he has two hives."),
+                // A kind she could see is never dropped for repeating something.
+                Note(Kind.OPINION, "tea", "he drinks oolong")
+            ),
+            existing,
+            unseen = setOf(Kind.USER)
+        )
+
+        assertEquals(2, stored.size)
+        assertEquals("a".repeat(33) + PersonaNotes.BESIDE_SUFFIX, stored[0].key)
+        assertEquals(stored[0], PersonaNotes.parseLine(stored[0].toLine()))
+        assertEquals(Note(Kind.OPINION, "tea", "he drinks oolong"), stored[1])
+    }
+
+    @Test
+    fun `pass after pass without sight of a note adds one note beside it, never a pile`() {
+        val notebook = LinkedHashMap<String, Note>()
+        fun store(changes: List<Note>) {
+            val existing = notebook.values.toList()
+            for (note in PersonaNotes.besideUnseen(changes, existing, unseen = setOf(Kind.USER))) {
+                notebook[note.storageKey] = note
+            }
+        }
+        notebook["seen"] = Note(Kind.USER, "tea", "he drinks tea")
+
+        // The same talk is still in the window, so the same line comes back each time.
+        repeat(3) { store(listOf(Note(Kind.USER, "tea", "he drinks oolong"))) }
+        assertEquals(
+            listOf(Note(Kind.USER, "tea", "he drinks tea"), Note(Kind.USER, "tea-unseen", "he drinks oolong")),
+            notebook.values.toList()
+        )
+
+        // A later pass that says something new replaces the note she wrote blind before.
+        repeat(2) { store(listOf(Note(Kind.USER, "tea", "he gave up oolong for mint"))) }
+        // And naming the beside-key itself does not start a chain of suffixes.
+        store(listOf(Note(Kind.USER, "tea-unseen", "he drinks mint tea now")))
+        assertEquals(
+            listOf(Note(Kind.USER, "tea", "he drinks tea"), Note(Kind.USER, "tea-unseen", "he drinks mint tea now")),
+            notebook.values.toList()
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaPhrasebookTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaPhrasebookTest.kt
