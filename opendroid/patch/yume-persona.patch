+/**
+ * The texts of the privacy card that speak of her. With [hers] false (the app runs as
+ * stock: no card, or the switch off) they speak of the app alone, since there is then
+ * no card, no notebook and no reply route of hers to speak of.
+ */
+internal object PrivacyWording {
+    fun mainRouteLabel(hers: Boolean): String = if (hers) "Your commands and plans" else "Commands, plans and replies"
+
+    fun plainHostedAllowed(hers: Boolean): String =
+        "A plain hosted model is allowed. Whoever hosts it can read what it is sent: the conversation" +
+            (if (hers) ", her card" else "") + " and, unless the switch below is on, your details."
+
+    fun privateModeHint(hers: Boolean): String = if (hers) {
+        "Your date of birth, where you are, the text of your notifications, what the phone read out to you and what she has noted about you are left out of anything sent to a model that can be read by its host. On a private route she sees all of it, because nobody else can."
+    } else {
+        "Your date of birth, where you are, the text of your notifications and what the phone read out to you are left out of anything sent to a model that can be read by its host. On a private route the model gets all of it, because nobody else can read it."
+    }
+
+    fun storedOnThisPhone(hers: Boolean): String =
+        (if (hers) {
+            "Everything she knows is stored on this phone only: the chat, her notebook, her files."
+        } else {
+            "The chat and what the app has stored about you are on this phone only."
+        }) + " Backups to the cloud are switched off for this app. An ElevenLabs voice sends every spoken line to ElevenLabs, so it is used only when plain hosted models are allowed; otherwise the phone's own voice speaks."
+}
