+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.persona.PersonaPicture.Origin
+import com.opendroid.ai.core.persona.PersonaPicture.Provenance
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * "Make her reference sheets": front, back and side in two looks, each made from one of her
+ * originals or masters, each age-checked before it is kept, kept as derived; nothing without
+ * an original or a master.
+ */
+class ReferenceSheetsTest {
+
+    private fun picture(id: String, view: String, origin: Origin = Origin.BUNDLED, provenance: Provenance = Provenance.ORIGINAL, caption: String = "reference picture: $view", made: Boolean = false) =
+        PersonaPicture(id = id, file = "$id.png", kind = PersonaPicture.Kind.SELF, caption = caption, made = made, origin = origin, provenance = provenance, view = view)
+
+    /** The round-7 renders as the list would bring them. */
+    private val renders = listOf(
+        picture("full_front", "full body, front"),
+        picture("full_back", "full body, back"),
+        picture("full_side_left", "full body, her left side (camera on her left)"),
+        picture("full_side_right", "full body, her right side (camera on her right)"),
+        picture("full_threequarter_front", "full body, front three-quarter from her right (45 deg)"),
+        picture("face_front", "face close-up, front"),
+        picture("face_threequarter", "face close-up, three-quarter from her right (35 deg)"),
+        picture("face_side", "face close-up, side (her right: lip ring and right ear hoop side)")
+    )
+
+    @Test
+    fun `without an original or a master of a side, nothing is made and he is told so`() {
+        val made = listOf(
+            picture("hers", "full body, front", origin = Origin.HER, provenance = Provenance.DERIVED, made = true),
+            picture("sheet", "full body, back", origin = Origin.SHEET, provenance = Provenance.DERIVED)
+        )
+        for (pictures in listOf(emptyList(), made, listOf(picture("face", "face close-up, front")))) {
+            val planned = ReferenceSheets.plan(pictures)
+            assertTrue(planned is ReferenceSheets.Planned.Nothing)
+            assertEquals(ReferenceSheets.NO_BASES_WHY, (planned as ReferenceSheets.Planned.Nothing).why)
+        }
+    }
+
+    @Test
+    fun `from her renders front, back and her right side, each in the base layer and in her outfit, with her face to match`() {
+        val planned = ReferenceSheets.plan(renders) as ReferenceSheets.Planned.Sheets
+        assertEquals(6, planned.sheets.size)
+        assertTrue(planned.missing.isEmpty())
+        assertEquals(
+            listOf(
+                "BASE_LAYER FRONT full_front", "BASE_LAYER BACK full_back", "BASE_LAYER SIDE full_side_right",
+                "OUTFIT FRONT full_front", "OUTFIT BACK full_back", "OUTFIT SIDE full_side_right"
+            ),
+            planned.sheets.map { "${it.look} ${it.side} ${it.source.id}" }
+        )
+        // The others for her face and look: the full front and the face front, never the sheet's own picture.
+        assertEquals(listOf("face_front", "face_threequarter"), planned.sheets[0].also.map { it.id })
+        assertEquals(listOf("full_front", "face_front"), planned.sheets[1].also.map { it.id })
+        assertEquals("reference sheet, plain fitted base layer, front view", planned.sheets[0].caption)
+        assertEquals("full body, her right side (camera on her right)", planned.sheets[2].view)
+        assertEquals(0.24, ReferenceSheets.cost(planned.sheets.size), 1e-9)
+        // A side she has no original or master of is not made, and said.
+        val noBack = ReferenceSheets.plan(renders.filterNot { it.id == "full_back" }) as ReferenceSheets.Planned.Sheets
+        assertEquals(4, noBack.sheets.size)
+        assertEquals(listOf(ReferenceSheets.Side.BACK), noBack.missing)
+        assertEquals("No sheet of her back: she has no original or master of that side.", ReferenceSheets.missingLine(noBack.missing))
+    }
+
+    @Test
+    fun `a derived picture is never what a sheet is made from, nor one it is matched to`() {
+        val derivedFront = picture("made_front", "full body, front", origin = Origin.HER, provenance = Provenance.DERIVED, made = true)
+        val derivedFace = picture("made_face", "face close-up, front", origin = Origin.SHEET, provenance = Provenance.DERIVED)
+        val his = picture("his", "", origin = Origin.ADDED, caption = "full body front plate")
+        val planned = ReferenceSheets.plan(listOf(derivedFront, derivedFace, his)) as ReferenceSheets.Planned.Sheets
+        assertTrue(planned.sheets.all { it.source.id == "his" && it.also.isEmpty() })
+        assertEquals(listOf(ReferenceSheets.Side.BACK, ReferenceSheets.Side.SIDE), planned.missing)
+        // The bundled one before his, and his before an approved sheet.
+        val approved = picture("approved", "full body, front", origin = Origin.SHEET, provenance = Provenance.MASTER)
+        assertEquals("his", (ReferenceSheets.plan(listOf(approved, his)) as ReferenceSheets.Planned.Sheets).sheets[0].source.id)
+        assertEquals("full_front", (ReferenceSheets.plan(listOf(approved, his) + renders) as ReferenceSheets.Planned.Sheets).sheets[0].source.id)
+    }
+
+    @Test
+    fun `each request is one edit of its original or master, guarded, in the look asked, and nothing else changed`() {
+        val sheets = (ReferenceSheets.plan(renders) as ReferenceSheets.Planned.Sheets).sheets
+        val base = ReferenceSheets.call(sheets[1], src("BACK"), refs("FRONT", "FACE", "MORE"), age = 20)
+        assertEquals(VeniceImages.Endpoint.MULTI_EDIT, base.endpoint)
+        assertEquals(PictureModels.MATCH.id, base.model)
+        val body = Json.parseToJsonElement(base.body).jsonObject
+        assertEquals(listOf("BACK", "FRONT", "FACE"), body["images"]!!.jsonArray.map { it.jsonPrimitive.content })
+        // Its own shape: no ratio is asked for.
+        assertNull(body["aspect_ratio"])
+        val prompt = body["prompt"]!!.jsonPrimitive.content
+        assertTrue(PictureGuard.guarded(prompt))
+        assertTrue(prompt.contains("20 years old"))
+        assertTrue(prompt.contains(PictureGuard.EDIT_LINE))
+        assertTrue(prompt.contains(PicturePrompts.BASE_LAYER_PROSE))
+        assertTrue(prompt.contains("images 2 to 3"))
+        assertTrue(prompt.contains("keep her facing away"))
+        assertTrue(prompt.contains("Keep everything else exactly as it is in image 1"))
+        assertTrue(prompt.length <= PictureModels.MATCH.promptLimit)
+        // Not nude: simple fitted clothing.
+        assertFalse(Regex("""(?i)\b(?:nude|naked|nothing at all)\b""").containsMatchIn(prompt))
+        val outfit = Json.parseToJsonElement(ReferenceSheets.call(sheets[3], src("FRONT"), emptyList()).body).jsonObject["prompt"]!!.jsonPrimitive.content
+        assertTrue(outfit.contains(PicturePrompts.outfitSheetProse()))
+        assertTrue(outfit.contains("white shirt tied high"))
+        assertFalse(outfit.contains("image 2"))
+        assertTrue(outfit.length <= PictureModels.MATCH.promptLimit)
+        // Never a school or anything younger in it.
+        for (text in listOf(prompt, outfit)) {
+            assertFalse(text, Regex("""(?i)school|uniform|sailor|younger|teen|child""").containsMatchIn(text.replace(PictureGuard.EDIT_LINE, "")))
+        }
+    }
+
+    @Test
+    fun `a picture captioned as the girl before, younger, at a school or with someone else is never what a sheet is made from`() {
+        val guarded = listOf(
+            picture("before", "", origin = Origin.ADDED, caption = "Satomi, before look, full body front"),
+            picture("younger", "", origin = Origin.ADDED, caption = "full body front, when I was 15"),
+            picture("withHim", "", origin = Origin.ADDED, caption = "me side by side with him, full body side"),
+            picture("school", "", origin = Origin.ADDED, caption = "full body back at school")
+        )
+        // Each would be read as a side of her, and each is an original.
+        assertEquals(listOf(ReferenceSheets.Side.FRONT, ReferenceSheets.Side.FRONT, ReferenceSheets.Side.SIDE, ReferenceSheets.Side.BACK), guarded.map { ReferenceSheets.sideOf(it) })
+        assertTrue(guarded.all { PictureSources.mayBeSource(it) })
+        // Alone they make nothing.
+        assertEquals(ReferenceSheets.NO_BASES_WHY, (ReferenceSheets.plan(guarded) as ReferenceSheets.Planned.Nothing).why)
+        // Added before his plate, none of them is taken before it, for the sheet or for her face.
+        val his = picture("his", "", origin = Origin.ADDED, caption = "full body front plate")
+        val planned = ReferenceSheets.plan(guarded + his) as ReferenceSheets.Planned.Sheets
+        assertTrue(planned.sheets.isNotEmpty())
+        assertTrue(planned.sheets.all { it.source.id == "his" && it.also.isEmpty() })
+        assertEquals(listOf(ReferenceSheets.Side.BACK, ReferenceSheets.Side.SIDE), planned.missing)
+        // Beside her renders too: no sheet's pictures are ever any of them.
+        val all = ReferenceSheets.plan(guarded + renders) as ReferenceSheets.Planned.Sheets
+        val used = all.sheets.flatMap { listOf(it.source) + it.also }.map { it.id }.toSet()
+        assertTrue(used.none { id -> guarded.any { it.id == id } })
+    }
+
+    @Test
+    fun `a sheet in her outfit is never made from a sheet in the plain base layer, and he is told which side is missing it`() {
+        val baseFront = picture("baseFront", "full body, front", origin = Origin.SHEET, provenance = Provenance.MASTER, caption = "reference sheet, plain fitted base layer, front view")
+            .copy(sheetLook = ReferenceSheets.Look.BASE_LAYER.name)
+        val back = picture("full_back", "full body, back")
+        val planned = ReferenceSheets.plan(listOf(baseFront, back)) as ReferenceSheets.Planned.Sheets
+        assertEquals(listOf("BASE_LAYER FRONT baseFront", "BASE_LAYER BACK full_back", "OUTFIT BACK full_back"), planned.sheets.map { "${it.look} ${it.side} ${it.source.id}" })
+        assertEquals(listOf(ReferenceSheets.Side.SIDE), planned.missing)
+        assertEquals(listOf(ReferenceSheets.Side.FRONT), planned.outfitMissing)
+        assertEquals(
+            "No sheet of her side: she has no original or master of that side. " +
+                "No sheet of her front in her outfit: her only original or master of that side is a sheet in the plain base layer.",
+            ReferenceSheets.missingLine(planned)
+        )
+        // With another front of hers, the outfit sheet is made from that.
+        val his = picture("his", "", origin = Origin.ADDED, caption = "full body front plate")
+        val both = ReferenceSheets.plan(listOf(baseFront, back, his)) as ReferenceSheets.Planned.Sheets
+        assertEquals("his", both.sheets.single { it.look == ReferenceSheets.Look.OUTFIT && it.side == ReferenceSheets.Side.FRONT }.source.id)
+        assertTrue(both.outfitMissing.isEmpty())
+    }
+
+    @Test
+    fun `a sheet in her outfit keeps the print, the toy and the tally from her own pictures, where they show`() {
+        val front = PicturePrompts.sheet(ReferenceSheets.Look.OUTFIT, ReferenceSheets.Side.FRONT, others = 2)
+        assertTrue(front.contains("Keep as in image 1 and images 2 to 3, where they show: the print across her bandeau"))
+        assertTrue(front.contains("the pink egg under the white band of her left thigh-high with its pink wire and controller"))
+        assertTrue(front.contains("the tally on the front of her right thigh"))
+        assertTrue(PicturePrompts.sheet(ReferenceSheets.Look.OUTFIT, ReferenceSheets.Side.SIDE, others = 0).contains("Keep as in image 1, where they show: the print"))
+        // From behind only a bit of the egg shows; the print and the tally are on her front.
+        val back = PicturePrompts.sheet(ReferenceSheets.Look.OUTFIT, ReferenceSheets.Side.BACK, others = 1)
+        assertTrue(back.contains("Keep the bit of the pink egg that shows on the inside of her left thigh as in image 1 and image 2."))
+        assertTrue(back.contains("Her face, the print and the tally are on her front and stay unseen."))
+        assertTrue(back.contains("keep her facing away"))
+        // The plain base layer has none of them.
+        val base = PicturePrompts.sheet(ReferenceSheets.Look.BASE_LAYER, ReferenceSheets.Side.FRONT, others = 2)
+        assertFalse(Regex("""(?i)\b(?:egg|tally|print)\b""").containsMatchIn(base))
+        // Every sheet's prompt fits what the edit model reads whole, so nothing at its end is cut.
+        for (look in ReferenceSheets.Look.entries) for (side in ReferenceSheets.Side.entries) for (others in 0..2) {
+            val prompt = PicturePrompts.sheet(look, side, others, age = 29)
+            assertTrue("$look $side $others: ${prompt.length}", prompt.length <= PictureModels.MATCH.promptLimit)
+        }
+    }
+
+    @Test
+    fun `of two sets that came with the app, the newer one is what a sheet is made from`() {
+        val older = renders.map { it.copy(id = "old_" + it.id, addedAt = 1L) }
+        val newer = renders.map { it.copy(id = "new_" + it.id, addedAt = 2L) }
+        val planned = ReferenceSheets.plan(older + newer) as ReferenceSheets.Planned.Sheets
+        assertTrue(planned.sheets.all { it.source.id.startsWith("new_") })
+        assertEquals("new_full_side_right", planned.sheets.single { it.look == ReferenceSheets.Look.OUTFIT && it.side == ReferenceSheets.Side.SIDE }.source.id)
+        // And the first she is matched to, for the match as for her face on a sheet.
+        assertEquals("new_full_front", PersonaSelfPictures.references(older + newer).first().id)
+        assertEquals("new_face_front", PersonaSelfPictures.references((older + newer).filter { "face" in it.id }).first().id)
+        // Pictures that did not come with the app keep the order they were added in, after those that did.
+        val his = listOf(picture("his1", "", origin = Origin.ADDED, caption = "full body front plate"), picture("his2", "", origin = Origin.ADDED, caption = "full body front plate"))
+        assertEquals(listOf("new_full_front", "old_full_front", "his1", "his2"), PersonaSelfPictures.references(his + older + newer, max = 4).map { it.id })
+    }
+
+    private fun png(mark: Int) = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), mark.toByte())
+
+    @Test
+    fun `each sheet is age-checked before it is kept, one that does not pass is thrown away unseen, and his act is never counted as hers`() = runBlocking {
+        val sheets = (ReferenceSheets.plan(renders) as ReferenceSheets.Planned.Sheets).sheets.take(3)
+        val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+        val notKept = CopyOnWriteArrayList<String>()
+        var n = 0
+        val maker = SelfPictureMaker(
+            send = { call -> sent += call; VeniceImages.Made.Picture(png(++n)) },
+            check = { image, counted ->
+                assertFalse("his act, never counted as hers", counted)
+                // The second sheet reads as a teen.
+                val answer = if (image[4] == 2.toByte()) "ages: teen" else "ages: adult"
+                MadePictureCheck.judge(HerEyes.Seen.Described("", KidGuard.ages(answer), seer = KidGuard.AGE_CHECK))
+            },
+            counts = object : SelfPictureMaker.Counts {
+                override fun kept() = Unit
+                override fun notKept(category: String) { notKept += category }
+            }
+        )
+        val kept = CopyOnWriteArrayList<String>()
+        val read = CopyOnWriteArrayList<String>()
+        val run = ReferenceSheetRun(
+            maker = maker,
+            // The side picture cannot be read.
+            source = { id -> read += id; if (id == "full_side_right") null else src("B64-$id") },
+            keep = { bytes, caption, view, look ->
+                kept += "$caption | $view | $look | ${bytes[4]}"
+                PersonaPictures.Added.Stored(
+                    PersonaPicture(id = "k${kept.size}", file = "k.png", kind = PersonaPicture.Kind.SELF, origin = Origin.SHEET, provenance = Provenance.DERIVED, caption = caption)
+                )
+            }
+        )
+        val entries = CopyOnWriteArrayList<ReferenceSheetRun.Entry>()
+        run.run(sheets, age = 19) { entries += it }
+
+        assertEquals(listOf("reference sheet, plain fitted base layer, front view | full body, front | BASE_LAYER | 1"), kept)
+        assertEquals(Provenance.DERIVED, entries[0].kept!!.provenance)
+        assertNull(entries[1].kept)
+        assertTrue(entries[1].why.startsWith("Not kept: the picture came out wrong: the age check read the woman drawn as a teen"))
+        assertEquals(listOf("kid:TEEN"), notKept)
+        assertEquals(ReferenceSheetRun.NOT_READ, entries[2].why)
+        // Two requests: the side was never sent, for want of its picture.
+        assertEquals(2, sent.size)
+        assertTrue(sent.all { it.endpoint == VeniceImages.Endpoint.MULTI_EDIT })
+        assertEquals("B64-full_front", Json.parseToJsonElement(sent[0].body).jsonObject["images"]!!.jsonArray.first().jsonPrimitive.content)
+        // Every picture a sheet works from is read as a source, never by any other door.
+        assertTrue(read.containsAll(listOf("full_front", "face_front", "full_back", "full_side_right")))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureLookTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureLookTest.kt
new file mode 100644
index 0000000..c6d57b0
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureLookTest.kt
@@ -0,0 +1,115 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her look as the prompts ask for it, against her files (kisaragi-pics, kisaragi-look): her red
+ * hair and her tan stay unless her own words give her another colour or pale skin, her default
+ * face is the crooked tongue-out grin, taking one thing off leaves the rest of her plate outfit,
+ * the match pass keeps the small things and the side she is seen from, and nothing in a prompt
+ * pushes her outfit toward a school uniform.
+ */
+class SelfPictureLookTest {
+
+    private fun tags(ask: String, now: String = "", view: PersonaSelfPictures.View? = null) =
+        PicturePrompts.generate(PictureModels.WAI, ask, lookNow = now, view = view)
+
+    private fun prose(ask: String, now: String = "", view: PersonaSelfPictures.View? = null) =
+        PicturePrompts.generate(PictureModels.KREA_TURBO, ask, lookNow = now, view = view)
+
+    @Test
+    fun `her red hair and her tan stay unless her own words change them`() {
+        for (now in listOf("my roots are showing", "hair is a mess", "bleached patches again", "hair up, blue nails", "skin oiled up", "under pale moonlight")) {
+            assertTrue(now, tags("on the roof", now).contains("red hair"))
+            assertTrue(now, tags("on the roof", now).contains("tan, tanned skin, shiny skin"))
+            assertTrue(now, prose("on the roof", now).contains("long vivid red hair"))
+            assertTrue(now, prose("on the roof", now).contains("a deep golden-brown salon tan"))
+        }
+        for (now in listOf("i dyed my hair black", "hair's pink now", "went blonde", "dyed it silver", "black hair this week")) {
+            assertFalse(now, tags("on the roof", now).contains("red hair"))
+        }
+        for (now in listOf("i'm pale, no salon this month", "my tan's fading", "lost my tan")) {
+            assertFalse(now, tags("on the roof", now).contains("tan, tanned skin"))
+        }
+    }
+
+    @Test
+    fun `her default face is the crooked tongue-out grin, unless her words name her face`() {
+        assertTrue(tags("on the roof").contains("crooked grin, tongue out"))
+        assertTrue(prose("on the roof").contains("a crooked grin, her tongue resting on her lower teeth with the barbell showing"))
+        for (ask in listOf("smiling at the camera", "asleep on the sofa", "eyes closed, in the bath", "blowing a kiss", "bored face")) {
+            assertFalse(ask, tags(ask).contains("crooked grin"))
+        }
+        // From behind no face is seen.
+        assertFalse(tags("", view = PersonaSelfPictures.View.BACK).contains("crooked grin"))
+        assertTrue(tags("", view = PersonaSelfPictures.View.FRONT).contains("crooked grin"))
+        // Her plate pose, where her words name none; never on a body reference.
+        assertTrue(tags("on the roof at night").contains("hand on hip, contrapposto, holding cigarette"))
+        assertFalse(tags("sitting on the curb").contains("hand on hip"))
+        assertFalse(tags("", view = PersonaSelfPictures.View.FRONT).contains("hand on hip"))
+        // Nothing child-coded about the brat look.
+        for (prompt in listOf(tags("on the roof"), prose("on the roof"))) {
+            assertFalse(prompt, Regex("""(?i)\b(?:fang|brat|mesugaki)\b""").containsMatchIn(prompt))
+        }
+    }
+
+    @Test
+    fun `taking one thing off leaves the rest of her plate outfit`() {
+        assertEquals(PicturePrompts.Outfit.Plate, PicturePrompts.outfitOf("on a rooftop, boots on the rail"))
+        assertEquals(PicturePrompts.Outfit.Less(setOf(PicturePrompts.Part.TOP, PicturePrompts.Part.BANDEAU)), PicturePrompts.outfitOf("topless on the bed"))
+        assertEquals(PicturePrompts.Outfit.Less(setOf(PicturePrompts.Part.BOOTS)), PicturePrompts.outfitOf("barefoot on the sofa"))
+        assertEquals(PicturePrompts.Outfit.Less(setOf(PicturePrompts.Part.TOP)), PicturePrompts.outfitOf("shirt off, smoking"))
+        assertEquals(PicturePrompts.Outfit.Less(setOf(PicturePrompts.Part.SKIRT, PicturePrompts.Part.HIPS)), PicturePrompts.outfitOf("bottomless on the bed"))
+        assertEquals(PicturePrompts.Outfit.Less(emptySet()), PicturePrompts.outfitOf("shirt open on the bed"))
+        // Something put on, or all of it off: her own words dress her.
+        for (ask in listOf("topless in a red hoodie", "naked on the bed", "in a bikini at the pool", "wearing the puffer coat", "boots only")) {
+            assertEquals(ask, PicturePrompts.Outfit.Own, PicturePrompts.outfitOf(ask))
+        }
+        val barefoot = prose("barefoot on the sofa")
+        assertTrue(barefoot.contains("a navy micro skirt") && barefoot.contains("glossy navy thigh-highs"))
+        assertFalse(barefoot.contains("platform boots"))
+        val bottomless = tags("bottomless on the bed")
+        assertTrue(bottomless.contains("white shirt") && bottomless.contains("navy thighhighs"))
+        assertFalse(bottomless.contains("navy microskirt") || bottomless.contains("highleg panties"))
+        // Matched to her pictures, the rest of the plate outfit comes over, less what she took off.
+        val match = SelfPicturePlans.newPicture(PictureModels.WAI, "topless on the bed", refs("R1"), match = true, seed = 1).match!!.invoke("NEW")
+        val prompt = kotlinx.serialization.json.Json.parseToJsonElement(match.body).let { (it as kotlinx.serialization.json.JsonObject)["prompt"].toString() }
+        assertTrue(prompt, prompt.contains("and the same outfit, with its print and marks where they show, except what she has taken off in image 1"))
+    }
+
+    @Test
+    fun `the match keeps her small things, her right-side lip stud, and the side she is seen from`() {
+        val front = PicturePrompts.match(2, true, PictureModels.Style.ANIME_TAGS)
+        assertTrue(front.contains("the same face, eyes, hair and ahoge, tan, liner, nails, choker, wrist cuffs and piercings"))
+        assertTrue(front.contains("the silver stud on the right side of her lower lip, her right"))
+        val back = PicturePrompts.match(2, false, PictureModels.Style.ANIME_TAGS, view = PersonaSelfPictures.View.BACK)
+        assertTrue(back.contains("She is seen from behind in image 1: keep her facing away."))
+        assertTrue(back.contains("stay unseen on her back and the backs of her thighs"))
+        assertTrue(PicturePrompts.match(1, false, PictureModels.Style.ANIME_TAGS, view = PersonaSelfPictures.View.LEFT).contains("same full profile"))
+        // A turnaround's match is told its side.
+        val plan = SelfPicturePlans.newPicture(PictureModels.WAI, "", refs("R1"), match = true, seed = 1, view = PersonaSelfPictures.View.BACK)
+        assertTrue(plan.match!!.invoke("NEW").body.contains("seen from behind in image 1"))
+    }
+
+    @Test
+    fun `nothing in a prompt pushes her outfit toward a school uniform, and the negative prompt keeps her tan and loose hair`() {
+        val negative = PicturePrompts.negative(PictureModels.Style.ANIME_TAGS).split(", ")
+        for (word in listOf("necktie", "neck ribbon", "blazer", "loafers", "kneehighs", "pale skin", "ponytail", "mesugaki")) {
+            assertTrue(word, word in negative)
+        }
+        assertFalse("pleated skirt" in negative)
+        // Her own words ask for it: then it is not in the way.
+        assertFalse("ponytail" in PicturePrompts.negative(PictureModels.Style.ANIME_TAGS, ask = "hair up in a ponytail").split(", "))
+        assertFalse("pale skin" in PicturePrompts.negative(PictureModels.Style.PHOTO, lookNow = "i'm pale, no salon this month").split(", "))
+        // The guard stays whole in every one.
+        assertTrue(PictureGuard.guardedNegative(PicturePrompts.negative(PictureModels.Style.PHOTO, "hair up in a ponytail", "pale")))
+        for (prompt in listOf(tags("on the roof"), prose("on the roof"))) {
+            assertFalse(prompt, Regex("""(?i)\bpleated\b|\bnecktie\b|\bblazer\b""").containsMatchIn(prompt))
+        }
+        assertTrue(prose("on the roof").contains("gyaru nightlife street fashion"))
+        assertTrue(tags("on the roof").contains("popped collar, sleeves rolled up"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureMakerTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureMakerTest.kt
new file mode 100644
index 0000000..881c2a6
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/SelfPictureMakerTest.kt
@@ -0,0 +1,241 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.actions.PersonaPictureActions
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.eyes.HerEyes
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * The content rule's last step: every picture made of her is age-checked before it is shown
+ * or kept, and one read as a child or a teen, or one the check could not read, is thrown away,
+ * never shown, never kept, its bytes zeroed, and counted by its category with nothing of its
+ * content logged.
+ */
+class SelfPictureMakerTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val now = 1_800_000_000_000L
+    private val log by lazy { HerLog({ File(folder.root, "her_log.json") }, { now }) }
+
+    /** A PNG as Venice would send one, by its first bytes. */
+    private fun png(mark: Int): ByteArray = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), 13, 10, 26, 10, mark.toByte())
+
+    private val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+    private val kept = CopyOnWriteArrayList<Pair<ByteArray, String>>()
+    private val checked = CopyOnWriteArrayList<ByteArray>()
+
+    /** The age check as the describer would answer [answer], read as the app reads it. */
+    private fun checker(answer: String?): MadePictureCheck.AgeCheck = MadePictureCheck.AgeCheck { image, _ ->
+        checked += image
+        val seen = answer?.let { HerEyes.Seen.Described(KidGuard.withoutAges(it), KidGuard.ages(it), seer = KidGuard.AGE_CHECK) }
+            ?: HerEyes.Seen.NotSeen(HerEyes.Why.NETWORK)
+        MadePictureCheck.combine(listOf(MadePictureCheck.judge(seen, now)))
+    }
+
+    private fun maker(answer: String?, replies: List<VeniceImages.Made>): SelfPictureMaker {
+        val queue = ArrayDeque(replies)
+        return SelfPictureMaker(
+            send = { call -> sent += call; queue.removeFirst() },
+            check = checker(answer),
+            counts = PersonaPictureActions.logCounts(log)
+        )
+    }
+
+    private val keep: suspend (ByteArray, String) -> PersonaPictures.Added = { bytes, caption ->
+        kept += bytes.copyOf() to caption
+        PersonaPictures.Added.Stored(PersonaPicture(id = "m1", file = "m1.jpg", kind = PersonaPicture.Kind.SELF, caption = caption, made = true))
+    }
+
+    private val caption = "SENTINEL_CAPTION on the rooftop"
+
+    private fun plan(match: Boolean = false) = SelfPicturePlans.newPicture(
+        PictureModels.WAI, "on the rooftop", if (match) refs("REF") else emptyList(), match = match, seed = 3
+    )
+
+    private fun day(): HerLog.Entry? = log.entries().singleOrNull { it.kind == HerLog.Kind.PICTURES_DAY }
+
+    @Test
+    fun `a picture read as a teen is thrown away unseen, never kept, zeroed and counted, and nothing of it is logged`() = runBlocking {
+        val picture = png(7)
+        val made = maker("looks: youthful face\nages: teen", listOf(VeniceImages.Made.Picture(picture))).make(plan(), caption, counted = false, keep = keep)
+        assertTrue(made is SelfPictureMaker.Outcome.NotKept)
+        assertTrue((made as SelfPictureMaker.Outcome.NotKept).why.startsWith("Not kept: the picture came out wrong: the age check read the woman drawn as a teen"))
+        assertTrue(kept.isEmpty())
+        // Its bytes are gone from memory too.
+        assertTrue(picture.all { it == 0.toByte() })
+        assertEquals(mapOf("kid:TEEN" to 1), day()!!.refusals)
+        assertNull(day()!!.counts[HerLog.PICTURES_KEPT])
+        // No caption, no prompt, no words of the check in the log.
+        val written = File(folder.root, "her_log.json").readText()
+        for (text in listOf("SENTINEL", "rooftop", "youthful", "teen face")) assertFalse(text, written.contains(text))
+        assertEquals("Pictures of her in 24 h: 0 kept, 1 thrown away unseen (age check: teen 1).", HerLog.picturesLine(log.entries(), now))
+        // Not told as a kid skip of her outings: it has its own line.
+        assertNull(HerLog.kidsLine(log.entries(), now))
+    }
+
+    @Test
+    fun `an answer that cannot be read, a child, a school uniform in its words, or no check at all, and it is never kept`() = runBlocking {
+        for ((answer, category) in listOf(
+            "a woman on a street" to "kid:UNCHECKED",
+            "ages: child" to "kid:CHILD",
+            "looks: a school uniform\nages: adult" to "kid:TEEN",
+            "ages: none" to "kid:UNCHECKED",
+            null to "kid:UNCHECKED"
+        )) {
+            kept.clear()
+            val made = maker(answer, listOf(VeniceImages.Made.Picture(png(1)))).make(plan(), caption, counted = false, keep = keep)
+            assertTrue("$answer", made is SelfPictureMaker.Outcome.NotKept)
+            assertTrue("$answer", kept.isEmpty())
+            assertTrue(day()!!.refusals.containsKey(category))
+        }
+        assertEquals(mapOf("kid:UNCHECKED" to 3, "kid:CHILD" to 1, "kid:TEEN" to 1), day()!!.refusals)
+        // A check that throws does not pass the picture either.
+        val throwing = SelfPictureMaker(
+            send = { VeniceImages.Made.Picture(png(2)) },
+            check = { _, _ -> throw IllegalStateException("x") },
+            counts = PersonaPictureActions.logCounts(log)
+        )
+        assertTrue(throwing.make(plan(), caption, false, keep) is SelfPictureMaker.Outcome.NotKept)
+        assertTrue(kept.isEmpty())
+    }
+
+    @Test
+    fun `a picture read as an adult is kept with her caption and counted as kept`() = runBlocking {
+        val picture = png(5)
+        val made = maker("looks: grown face, adult proportions\nages: adult", listOf(VeniceImages.Made.Picture(picture))).make(plan(), caption, counted = true, keep = keep)
+        assertTrue(made is SelfPictureMaker.Outcome.Kept)
+        assertEquals(caption, kept.single().second)
+        assertEquals(5.toByte(), kept.single().first.last())
+        // The age check saw the very picture that was kept.
+        assertEquals(1, checked.size)
+        // Zeroed once it was kept: the store has its own copy.
+        assertTrue(picture.all { it == 0.toByte() })
+        assertEquals(1, day()!!.counts[HerLog.PICTURES_KEPT])
+        assertEquals("Pictures of her in 24 h: 1 kept.", HerLog.picturesLine(log.entries(), now))
+    }
+
+    @Test
+    fun `the matched picture is the one checked and kept, and the new one stands where the match fails`() = runBlocking {
+        val first = png(1)
+        val matched = png(2)
+        val made = maker("ages: adult", listOf(VeniceImages.Made.Picture(first), VeniceImages.Made.Picture(matched))).make(plan(match = true), caption, false, keep)
+        assertTrue(made is SelfPictureMaker.Outcome.Kept)
+        assertEquals(listOf(VeniceImages.Endpoint.GENERATE, VeniceImages.Endpoint.MULTI_EDIT), sent.map { it.endpoint })
+        assertEquals(2.toByte(), kept.single().first.last())
+        assertTrue(first.all { it == 0.toByte() })
+
+        sent.clear(); kept.clear()
+        val fallback = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(3)), VeniceImages.Made.Failed("The image service is busy."))).make(plan(match = true), caption, false, keep)
+        assertTrue(fallback is SelfPictureMaker.Outcome.Kept)
+        assertEquals(3.toByte(), kept.single().first.last())
+        assertEquals("It was not matched to her own pictures: the image service is busy.", (fallback as SelfPictureMaker.Outcome.Kept).note)
+
+        // Venice flags the match: nothing is kept, the first picture is zeroed too.
+        kept.clear()
+        val again = png(4)
+        val flagged = maker("ages: adult", listOf(VeniceImages.Made.Picture(again), VeniceImages.Made.Blocked)).make(plan(match = true), caption, false, keep)
+        assertEquals(SelfPictureMaker.BLOCKED_WHY, (flagged as SelfPictureMaker.Outcome.NotKept).why)
+        assertTrue(kept.isEmpty())
+        assertTrue(again.all { it == 0.toByte() })
+        assertEquals(1, day()!!.refusals[SelfPictureMaker.BLOCKED])
+    }
+
+    @Test
+    fun `a drawn picture that is not passed is never sent on to the match with his pictures`() = runBlocking {
+        val first = png(1)
+        val made = maker("looks: childlike proportions\nages: adult", listOf(VeniceImages.Made.Picture(first), VeniceImages.Made.Picture(png(2))))
+            .make(plan(match = true), caption, false, keep)
+        assertTrue(made is SelfPictureMaker.Outcome.NotKept)
+        // Only the drawing went out: the match, with his pictures of her, never did.
+        assertEquals(listOf(VeniceImages.Endpoint.GENERATE), sent.map { it.endpoint })
+        assertEquals(1, checked.size)
+        assertTrue(first.all { it == 0.toByte() })
+        assertTrue(kept.isEmpty())
+        assertEquals(mapOf("kid:CHILD" to 1), day()!!.refusals)
+
+        // Passed, it is matched, and the matched picture is checked again before it is kept.
+        sent.clear(); checked.clear()
+        val passed = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(3)), VeniceImages.Made.Picture(png(4)))).make(plan(match = true), caption, false, keep)
+        assertTrue(passed is SelfPictureMaker.Outcome.Kept)
+        assertEquals(listOf(VeniceImages.Endpoint.GENERATE, VeniceImages.Endpoint.MULTI_EDIT), sent.map { it.endpoint })
+        assertEquals(2, checked.size)
+    }
+
+    @Test
+    fun `where she can see it, she looks at the kept picture first, and one she reads as younger is not kept`() = runBlocking {
+        val looked = CopyOnWriteArrayList<String>()
+        val dropped = CopyOnWriteArrayList<String>()
+        val seen = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(5)))).make(
+            plan(), caption, counted = false, keep = keep,
+            look = { picture -> looked += picture.id; "grin is right. nails came out pink tho" },
+            drop = { picture -> dropped += picture.id }
+        )
+        assertTrue(seen is SelfPictureMaker.Outcome.Kept)
+        seen as SelfPictureMaker.Outcome.Kept
+        assertTrue(seen.seenByHer)
+        assertEquals("grin is right. nails came out pink tho", seen.picture.caption)
+        assertEquals(PersonaPicture.CaptionBy.HER, seen.picture.captionBy)
+        assertEquals(listOf("m1"), looked.toList())
+        assertTrue(dropped.isEmpty())
+        assertEquals(1, day()!!.counts[HerLog.PICTURES_KEPT])
+        // Her words about it are what she is told she made, on one line, with the note for him after.
+        val line = PersonaSelfPictures.keptLine("m1", "grin is right.\nnails came out pink tho", "")
+        assertEquals("Made a new picture of her (picture m1): grin is right. nails came out pink tho", line)
+        assertEquals(listOf("grin is right. nails came out pink tho"), PersonaSelfPictures.madePictureCaptions(line))
+
+        // She reads herself in it as younger: it came out wrong, is taken out again and counted, never kept.
+        val young = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(6)))).make(
+            plan(), caption, counted = false, keep = keep,
+            look = { "lol i look like a kid in this one" },
+            drop = { picture -> dropped += picture.id }
+        )
+        assertEquals(SelfPictureMaker.SEEN_YOUNG_WHY, (young as SelfPictureMaker.Outcome.NotKept).why)
+        assertEquals(listOf("m1"), dropped.toList())
+        assertEquals(1, day()!!.counts[HerLog.PICTURES_KEPT])
+        assertEquals(1, day()!!.refusals["kid:UNCHECKED"])
+
+        // A look that fails costs the look, never the picture.
+        val failed = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(7)))).make(plan(), caption, false, keep, look = { throw IllegalStateException("x") })
+        assertEquals(caption, (failed as SelfPictureMaker.Outcome.Kept).picture.caption)
+        assertFalse(failed.seenByHer)
+    }
+
+    @Test
+    fun `the note that a picture was not matched is for him, and not what her line about it is held to`() {
+        val row = PersonaSelfPictures.keptLine("m9", "me on the roof", SelfPictureMaker.notMatched("The image service is busy."))
+        assertTrue(row.contains("It was not matched to her own pictures: the image service is busy."))
+        assertEquals("Made a new picture of her: me on the roof", PersonaSelfPictures.heardOf(row))
+        // The chat loop words her line from that.
+        val loop = File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        assertTrue(loop.contains("val heardText = com.opendroid.ai.core.persona.PersonaSelfPictures.heardOf(summaryText)"))
+    }
+
+    @Test
+    fun `a request that fails keeps nothing and counts nothing, and is said as it failed`() = runBlocking {
+        val made = maker("ages: adult", listOf(VeniceImages.Made.Failed("The Venice balance is too low to make a picture."))).make(plan(), caption, false, keep)
+        assertEquals("The Venice balance is too low to make a picture.", (made as SelfPictureMaker.Outcome.NotKept).why)
+        assertTrue(kept.isEmpty())
+        assertTrue(checked.isEmpty())
+        assertNull(day())
+        // Flagged by Venice on the first request: thrown away and counted, never checked or kept.
+        val flagged = maker("ages: adult", listOf(VeniceImages.Made.Blocked)).make(plan(), caption, false, keep)
+        assertTrue(flagged is SelfPictureMaker.Outcome.NotKept)
+        assertTrue(checked.isEmpty())
+        assertEquals(mapOf(SelfPictureMaker.BLOCKED to 1), day()!!.refusals)
+        // A store that cannot keep it says so.
+        val full = maker("ages: adult", listOf(VeniceImages.Made.Picture(png(9)))).make(plan(), caption, false, keep = { _, _ -> PersonaPictures.Added.Unreadable })
+        assertEquals("A picture came back but could not be kept on the phone.", (full as SelfPictureMaker.Outcome.NotKept).why)
+    }
+}
