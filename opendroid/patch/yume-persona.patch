+    @Test
+    fun `the bubble, the stopped partial and the failed partial all hold the cleaned view`() {
+        val chat = executeSimpleQuery
+        val stream = chat.substringAfter("stream.collect { chunk ->").substringBefore("} catch (streamError: CancellationException)")
+        assertTrue(stream.contains("PersonaActionRows.shownSoFar(currentReplyText)"))
+        assertTrue(stream.contains("if (personaOn && shownText.isBlank()) return@collect"))
+        assertTrue(stream.contains("conversationRepository.insertMessage(sessionId, replyMsg.copy(text = shownText))"))
+        // The raw text, command line and all, is never written to the chat.
+        assertFalse(chat.contains("replyMsg.copy(text = currentReplyText)"))
