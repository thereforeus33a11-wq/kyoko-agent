+            // to a request that carries none as well.
+            LLMError.ServerError, LLMError.MalformedResponse, LLMError.ProviderRefused, LLMError.Unknown,
+            // These get no second try at all.
+            LLMError.AuthMissing, LLMError.RateLimited, LLMError.Network, LLMError.PrivateRouteRequired,
+            LLMError.PromptTooLarge
