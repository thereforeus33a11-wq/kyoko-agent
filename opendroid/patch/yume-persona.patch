+                pictures = own,
+                hisMessage = hisMessage,
+                firstReply = firstReply,
+                imageAttached = imageAttached,
+                turn = pictures.turn()
+            ) ?: return null
+            val base64 = pictures.base64(choice.picture.id) ?: return null
+            if (choice.inTurn) pictures.turnTaken()
+            OwnPicture(base64, choice.picture.caption)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her picture was left out of a reply: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    /**
+     * [reply], the stream of a reply that carries her picture, with one second try.
+     *
+     * A model that does not read images, or a server that has no place for one, fails
+     * the whole request. When that happens before she has said anything, and the picture
+     * can be the reason ([PersonaPictureRules.mayBeThePicture]), [withoutPicture] is
+     * asked instead: the same reply with no picture on it and a prompt that claims none.
+     * A picture her model will not take costs her the picture, never the reply.
+     *
+     * When the second try does answer, and the first failure said that the request itself
+     * could not be taken ([PersonaPictureRules.saysThePictureWasNotTaken]), the model is
+     * remembered ([pictureRefused]), so that her later replies do not each begin with a
+     * request that fails. After any other failure nothing is remembered: a server that
+     * broke or a reply that came back empty says nothing about her picture, and she is
+     * sent one again next time. A failure of the second try is passed on as it is.
+     */
+    fun orWithoutPicture(config: LLMConfig, reply: Flow<String>, withoutPicture: suspend () -> Flow<String>): Flow<String> =
+        flow {
+            var said = false
+            emitAll(
+                reply.onEach { if (it.isNotEmpty()) said = true }.catch { failure ->
+                    if (said || failure !is LLMException || !PersonaPictureRules.mayBeThePicture(failure.error)) throw failure
+                    Log.w(TAG, "A reply with her picture failed (${failure.error.code}); asking again without it")
+                    val notTaken = PersonaPictureRules.saysThePictureWasNotTaken(failure.error)
+                    var answered = false
+                    emitAll(
+                        withoutPicture().onEach {
+                            if (notTaken && !answered && it.isNotEmpty()) {
+                                answered = true
+                                refusedPictures.value = chatModelKey(config)
+                            }
+                        }
+                    )
+                }
+            )
+        }
+
+    /**
+     * True while the model that writes her replies with [config] is known not to take a
+     * picture: a reply with her picture on it was turned down as a request and the same
+     * reply without it came through ([orWithoutPicture]). She is then told in words what
+     * is on her pictures.
+     * It ends with a restart of the app, with another model, and when a picture the
+     * owner sends by hand ([describeOwnPicture], [readBackgroundPicture]) is read after all.
+     */
+    fun pictureRefused(config: LLMConfig): Boolean = refusedPictures.value == chatModelKey(config)
+
+    /**
+     * Shows her one of her own pictures and hands back what she says is on it, which
+     * the caller keeps as the caption of that picture. One request on her own route
+     * with her card, no retry and a time limit, because the owner is waiting at a
+     * button. Nothing is saved here and nothing of it reaches the chat or her notebook.
+     *
+     * [PictureReading.Failed] when she is off, when her model cannot be sent a picture
+     * on its route (the encrypted exchange carries none, and she would then describe a
+     * picture she never saw), when the call fails or the route is refused, when the model
+     * declines, and when nothing comes back.
+     */
+    suspend fun describeOwnPicture(pictureBase64: String): PictureReading {
+        val config = settingsRepository.llmConfig.first()
+        // Her card is a file and his name is unlocked through the Keystore. The screen
+        // calls this from the main thread, so both are read off it.
+        val (card, owner) = withContext(Dispatchers.IO) {
+            if (isActive(config)) store.card() to ownerName() else null
+        } ?: return PictureReading.Failed(PictureReading.Reason.SHE_IS_OFF)
+        if (!chatSeesImages(config)) return PictureReading.Failed(PictureReading.Reason.NO_PICTURES_ON_THIS_ROUTE)
+        return describeOwnPictureFrom(card, owner, pictureBase64, callScope = scope) { request ->
+            // A line she keeps to herself is no part of the caption.
+            withoutThoughts(chatProvider(config).complete(withChatModel(request, config)))
+        }.also(::pictureWasRead)
+    }
+
+    /**
+     * Has the model on her route write down what the background picture says and shows,
+     * as plain notes in the third person. This is not her and not her voice: the request
+     * carries neither her card nor anything else of hers, and what comes back is for the
+     * owner to read, edit and save as the text under her awareness. It is not saved
+     * here, and never shown to her as a picture or in the chat.
+     */
+    suspend fun readBackgroundPicture(pictureBase64: String): PictureReading {
+        val config = settingsRepository.llmConfig.first()
+        if (!chatSeesImages(config)) return PictureReading.Failed(PictureReading.Reason.NO_PICTURES_ON_THIS_ROUTE)
+        return readBackgroundPictureFrom(pictureBase64, callScope = scope) { request ->
+            chatProvider(config).complete(withChatModel(request, config))
+        }.also(::pictureWasRead)
+    }
+
+    /** A picture the owner sent by hand came back read: her model takes pictures, whatever happened before. */
+    private fun pictureWasRead(reading: PictureReading) {
+        if (reading is PictureReading.Read) refusedPictures.value = null
+    }
+
+    /**
+     * Called after one of her replies is stored. Once enough of her replies are newer
+     * than her last notebook pass, the talk she has not read for it yet is read once
+     * more, off the reply path, and anything she wants to keep goes into her notebook.
+     *
+     * Whether a pass is due, and what it reads, is worked out from what is stored: the
+     * rows of every chat that are newer than the last pass that succeeded, and the rows
+     * kept from chats that were deleted since ([keepUnread]). A count kept in memory
+     * would start again at zero with every new process, and on a phone that closes the
+     * app between short visits she would never write anything down. Rows are read by
+     * time and not as the last few of one chat, so neither a run of phone commands nor a
+     * new chat puts what he said out of the pass's reach.
+     *
+     * The time is written only after a pass that succeeded, and it is the time of the
+     * newest row that pass was given ([PersonaNotebookTalk.Page.readUpTo]). A pass that
+     * failed is tried again with her next reply, and what did not fit on one page is on
+     * the next: nothing he told her is passed over without having been put to her.
+     *
+     * Failures are silent: a missed note is not worth an error card. The work is handed
+     * back as a job that ends when the look at the rows, and the pass if one was due, is
+     * over; null when an earlier one is still running and this call started nothing.
+     *
+     * With [catchUp] a pass is made over whatever is unread, however little: her sleep
+     * asks for it before she goes over herself, so that the last talk of her day is in
+     * her notebook by then.
+     */
+    fun onReply(catchUp: Boolean = false): Job? {
+        if (!reflecting.compareAndSet(false, true)) return null
+        // Her notebook pass is upkeep: counted among her own calls and shown, never his.
+        return scope.launch(ownLife.counted(OwnPurpose.NOTEBOOK)) {
+            try {
+                val unread = unreadRows(memory.lastReflectionAt())
+                if (PersonaNotebookTalk.isDue(unread) || (catchUp && unread.isNotEmpty())) {
+                    val page = PersonaNotebookTalk.page(unread)
+                    if (reflect(page)) {
+                        // The newest row the pass was given: what the page had no room
+                        // for, and a reply stored while it ran, still count next time.
+                        memory.recordReflection(page.readUpTo)
+                        memory.dropLeftBehind(page.readUpTo)
+                    }
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "Notebook reflection skipped: ${e.javaClass.simpleName}")
+            } finally {
+                reflecting.set(false)
+            }
+        }
+    }
+
+    /**
+     * Everything her notebook has not read yet, oldest first: the stored rows of every
+     * chat that are newer than [since], and the rows kept from deleted chats. One look
+     * reads a fixed number of stored rows. When it comes back full, more are waiting
+     * behind them, and a kept row that is newer than the last one read is left for the
+     * look that reaches it: the time of a pass must never move past a row nobody read.
+     */
+    private suspend fun unreadRows(since: Long): List<SessionMessage> {
+        val stored = memoryManager.episodicMemory.rowsSince(since, PersonaNotebookTalk.ROWS_PER_LOOK)
+        val horizon = if (stored.size >= PersonaNotebookTalk.ROWS_PER_LOOK) stored.last().message.timestamp else Long.MAX_VALUE
+        val kept = memory.leftBehind(since).filter { it.message.timestamp <= horizon }
+        return (kept + stored).distinctBy { it.message.id }.sortedBy { it.message.timestamp }
+    }
+
+    /**
+     * Keeps what her notebook has not read yet of a chat that is about to be deleted,
+     * or of what stood behind a message he edits and sends again: the rows of it that
+     * are newer than her last pass, as [PersonaNotebookTalk.toKeep] leaves them. He
+     * rewound the chat; what he told her in that part of it was still said. They are
+     * stored beside her notes until a pass has read them. With her switched off nothing
+     * is kept. At most [PersonaNotebookTalk.ROWS_PER_LOOK] rows are read here, the
+     * oldest unread ones.
+     */
+    private suspend fun keepUnread(leaving: LeavingMessages) = withContext(Dispatchers.IO) {
+        if (!isActive(settingsRepository.llmConfig.first())) return@withContext
+        val rows = leaving(memory.lastReflectionAt(), PersonaNotebookTalk.ROWS_PER_LOOK)
+        memory.keepLeftBehind(PersonaNotebookTalk.toKeep(rows))
+    }
+
+    /**
+     * One notebook pass over [page], a page of the talk she has not read for her
+     * notebook yet. True when the page is dealt with, whether or not she wrote anything;
+     * false when she is switched off. A call that fails throws.
+     *
+     * The pass is hers: its system prompt is her card and then the notebook's own text,
+     * so the one who decides what she keeps, and how she takes a correction, is her.
+     */
+    internal suspend fun reflect(page: PersonaNotebookTalk.Page): Boolean {
+        val config = settingsRepository.llmConfig.first()
+        if (!isActive(config)) return false
+        // Her notebook as this build has it, before she reads it: a pass can be the first thing a new build does.
+        seedOnce()
+        val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+        // Only what the two of them said. App rows can carry notification or screen text.
+        // A reply she wrote with his screen in front of her is labelled as read off the
+        // screen, so that it is not taken for something he told her, and her line about
+        // a result is not in it at all. Where a host could read this pass, the talk is
+        // held back the way her chat prompt holds it back: the name of a contact he
+        // tapped is his address book's, not his words.
+        val dialogue = PersonaNotebookTalk.dialogue(page, heldBack)
+        // A page with nothing of his and nothing of hers on it (a run of the app's rows)
+        // is read as it is: there is nothing to put to her. One with only her own lines
+        // on it (what she said or did in her own time) is hers to learn from.
+        if (dialogue.isEmpty()) return true
+        val unseen = notesLeftOut(heldBack, ownerName())
+        val now = clock()
+        // The page of her notebook is picked with the talk in hand: a note the talk
+        // touches is on it, so she can bring it up to date instead of writing beside it.
+        // The picking is done on the phone, from the rows as they are stored.
+        val notebook = PersonaNotes.review(
+            memory.notes(),
+            leaveOut = unseen,
+            recall = PersonaNotes.Recall.of(page.said, now),
+            times = PersonaNotes.Times(memory.writtenAt(), now),
+            // Her marks are listed apart on this page; a starting note in the words of her files says so.
+            origins = origins(withMarks = false)
+        )
+        // A line an earlier pass wrote and the notebook could not take was meant as a note,
+        // and can say as much about him as one. Where a host could read this pass, only
+        // the lines that read as a note that cannot be about him are repeated to her. The
+        // others she is told of by their number, and they wait on the phone.
+        val notTaken = memory.notTaken()
+        val repeated = PersonaNotes.quotable(notTaken, unseen)
+        val waiting = notTaken - repeated.toSet()
+        // How she feels, and her marks of how she knows the notes on her page, held back the way the page is.
+        val feelings = PersonaMood.pageLines(memory.mood(), now, leaveOut = if (heldBack) PersonaMood.aboutHim(ownerName()) else null)
+        val marks = PersonaSleepPass.howBlock(memory.how(), memory.notes().filter { it.storageKey in notebook.shownKeys })
+        val response = chatProvider(config).complete(
+            withChatModel(
+                reflectionRequest(store.card(), ownerName(), notebook.text, dialogue, notesAboutHimHeldBack = heldBack,
+                    today = PersonaNotebookTalk.day(now), earlier = earlierTalk(page, heldBack), notTaken = repeated,
+                    notTakenHeldBack = waiting.size, feelings = feelings, marks = marks),
+                config
+            )
+        )
+        // Her feel lines are hers apart from her notes: taken off first, and kept as how she feels.
+        val cutOff = FinishReason.isLength(response.finishReason)
+        val mood = PersonaMood.read(response.content, PersonaMood.PASS_LINES, cutOff)
+        val written = PersonaNotes.read(PersonaMood.withoutFeelings(response.content, cutOff = cutOff), limit = PersonaNotes.LINES_PER_PASS)
+            .let { if (cutOff) PersonaNotes.withoutBrokenLine(it, mood.rest) else it }
+        if (mood.felt.isNotEmpty()) memory.updateMood { PersonaMood.merge(it, mood.felt, now) }
+        // What she writes is saved on the phone whatever the route. A note written without
+        // sight of one she has goes beside it, never over it: that is so for the notes
+        // about him on a route that is not given them, and for a note the page had no
+        // room for (or one she was handed while the pass was being written).
+        if (written.notes.isNotEmpty()) {
+            val placed = PersonaNotes.besideUnseen(written.notes, memory.notes(), unseen, shownKeys = notebook.shownKeys)
+            memory.apply(placed)
+            // A mark she put behind a note is how she knows it, after the write that cleared the old one.
+            val marks = PersonaNotes.marksFor(placed, written.notes, written.marks)
+            if (marks.isNotEmpty()) memory.updateHow { it + marks }
+        }
+        // A line she meant as a note and the notebook could not take does not vanish
+        // without a word: her next pass is told. So is one the length limit broke off,
+        // which is not stored as if it were whole. What this pass was told in full is
+        // done with; what it could only be told the number of is kept for a pass that
+        // may read it, as far as there is room.
+        memory.recordNotTaken(written.notTaken + waiting)
+        return true
+    }
+
+    /** One notebook pass over [recentMessages], the rows of one chat, none of which she has read for it. */
+    internal suspend fun reflect(recentMessages: List<ChatMessage>): Boolean =
+        reflect(PersonaNotebookTalk.page(recentMessages.map { SessionMessage("", it) }))
+
+    /**
+     * A few turns from before [page] in the chat it begins in. She has read them in an
+     * earlier pass; they are shown again, apart from the talk, so that an answer is not
+     * read without what it answers.
+     */
+    private suspend fun earlierTalk(page: PersonaNotebookTalk.Page, heldBack: Boolean): List<ChatMessage> {
+        val chat = page.firstChat ?: return emptyList()
+        val before = memoryManager.episodicMemory.rowsUntil(chat, page.startsAt - 1, PersonaNotebookTalk.CONTEXT_ROWS)
+            .map { PersonaNotebookTalk.cut(it, PersonaNotebookTalk.CONTEXT_ROW_MAX_CHARS) }
+        return PersonaNotebookTalk.shaped(before, heldBack).takeLast(PersonaNotebookTalk.CONTEXT_TURNS)
+    }
+
+    /**
+     * A reply of hers as it is said: [text] is what is left once the lines she keeps to
+     * herself are taken out. [sleep] is the sleep one of those lines asks for
+     * ([PersonaSleep.askedIn]): what was read off the line, never the line itself.
+     */
+    class Heard(val text: String, val keptThoughts: Boolean, val sleep: PersonaSleep.Ask? = null)
+
+    /**
+     * Takes the lines she marked as thoughts ([PersonaThoughtLines]) out of [reply] and
+     * keeps them for her. Whoever reads a reply of hers calls this first and goes on
+     * with [Heard.text] alone, so a thought is never shown, spoken, stored in the chat
+     * or taken for a command. [Heard.keptThoughts] tells a reply that was nothing but
+     * thoughts, which is her choosing not to answer, from one in which nothing came.
+     */
+    suspend fun withoutThoughts(reply: String): Heard {
+        val split = PersonaThoughtLines.split(reply)
+        if (split.thoughts.isNotBlank()) keepThought(split.thoughts, System.currentTimeMillis())
+        // A << go: stop among them ends the outing she is on, as a << sleep: line puts her to sleep.
+        if (PersonaOwnTime.stopsOuting(split.thoughts)) ownLife.stopOuting()
+        return Heard(split.text, split.marked, PersonaSleep.askedIn(split.thoughts))
+    }
+
+    private suspend fun withoutThoughts(response: LLMResponse): LLMResponse =
+        response.copy(content = withoutThoughts(response.content).text)
+
+    /** Keeps a thought of hers. One that cannot be kept costs her that thought, never the reply it stood in. */
+    private suspend fun keepThought(text: String, atMillis: Long) {
+        try {
+            thoughts.keep(text, atMillis)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "A thought of hers was not kept: ${e.javaClass.simpleName}")
+        }
+    }
+
+    // ── Her own time ─────────────────────────────────────────────────────────────────
+
+    /**
+     * Whether she has time of her own with these settings: she is the one who talks, the
+     * owner's switch is on and his bound allows at least one moment a day.
+     */
+    fun ownTimeIsOn(config: LLMConfig): Boolean = isActive(config) && PersonaOwnTime.isOn(config)
+
+    /** Whether she has her own life on the phone: her own time is on and he switched her own life on. */
+    fun ownLifeIsOn(config: LLMConfig): Boolean = ownTimeIsOn(config) && config.personaOwnLife
+
+    /** Whether she is asleep now ([PersonaSleep.isAsleep]): while she is, nothing comes from her, no notification either. */
+    suspend fun isAsleepNow(): Boolean =
+        ownTimeIsOn(settingsRepository.llmConfig.first()) && PersonaSleep.isAsleep(memory.ownTime(), clock())
+
+    /**
+     * Sets the alarm for her next moment from what is stored, and takes it off when she
+     * has no time of her own. Called when the service starts and whenever the settings
+     * change: the stored time is the truth, so a moment whose time passed while the app
+     * was not running is rung for at once, and once.
+     *
+     * This is also where her own time is seen to have been switched on. The first moment
+     * then comes [PersonaOwnTime.FIRST_MOMENT_AFTER_MILLIS] later, provided [heHasTalked]
+     * to her already; in a chat he has not written in, it comes that long after her
+     * first reply ([ownTimeAfterReply]). After that the times are only ever hers.
+     *
+     * Her sleep is part of her own time: switched off, or seen switched on again, she is
+     * awake. A sleep pass she was owed stays owed.
+     */
+    suspend fun armOwnTime(nowMillis: Long = System.currentTimeMillis(), heHasTalked: suspend () -> Boolean) {
+        val config = settingsRepository.llmConfig.first()
+        val wake = ownTimeLock.withLock {
+            val state = memory.ownTime()
+            when {
+                !ownTimeIsOn(config) -> {
+                    if (state.on || PersonaSleep.isMarked(state)) memory.saveOwnTime(PersonaSleep.cleared(state).copy(on = false))
+                    null
+                }
+                // While she sleeps the alarm is for her sleep's own time, whatever left another there.
+                state.on && PersonaSleep.isMarked(state) && state.wake != PersonaSleep.alarm(state) -> {
+                    val healed = state.copy(wake = PersonaSleep.alarm(state))
+                    memory.saveOwnTime(healed)
+                    healed.wake
+                }
+                state.on -> state.wake
+                else -> {
+                    val first = if (heHasTalked()) {
+                        PersonaOwnTime.Wake.At(nowMillis + PersonaOwnTime.FIRST_MOMENT_AFTER_MILLIS)
+                    } else {
+                        PersonaOwnTime.Wake.Unset
+                    }
+                    memory.saveOwnTime(
+                        PersonaSleep.cleared(state).copy(
+                            on = true, wake = first, why = PersonaOwnTime.Why.FIRST, moved = null, movedAsked = "", failures = 0
+                        )
+                    )
+                    first
+                }
+            }
+        }
+        ownTimeAlarm.set((wake as? PersonaOwnTime.Wake.At)?.atMillis)
+    }
+
+    /**
+     * Called when a reply of hers to him is over, whether she said something or kept it
+     * to herself. Two things can follow from it. Her own time starts: with no time set
+     * yet, the first moment comes [PersonaOwnTime.FIRST_MOMENT_AFTER_MILLIS] after this
+     * reply. And "when he writes" has come true: he wrote, she was awake for her answer,
+     * and from here the gap she last chose applies again. A time she named is left as it is.
+     * A time an unlock brought forward for his silence is not: he wrote, so it gets back
+     * the time and the reason it had before ([PersonaOwnTime.setBack]).
+     *
+     * When she was asleep, his message has woken her: her next moment comes at the usual
+     * gap after this reply ([PersonaSleep.wokenByHim]). When the reply asks for a [sleep]
+     * (a `<< sleep:` line among her thoughts, read whole and not cut off), she lies down
+     * to it once the reply is over, from whichever of those states it leaves her in.
+     *
+     * Never fails the reply it follows.
+     */
+    suspend fun ownTimeAfterReply(
+        nowMillis: Long = System.currentTimeMillis(),
+        sleep: PersonaSleep.Ask? = null,
+        zone: TimeZone = TimeZone.getDefault()
+    ) {
+        try {
+            val config = settingsRepository.llmConfig.first()
+            if (!ownTimeIsOn(config)) return
+            val bounds = PersonaOwnTime.Bounds.of(config)
+            val wake = ownTimeLock.withLock {
+                val state = memory.ownTime()
+                val woken = when {
+                    !state.on || state.wake == PersonaOwnTime.Wake.Unset -> state.copy(
+                        on = true,
+                        wake = PersonaOwnTime.Wake.At(nowMillis + PersonaOwnTime.FIRST_MOMENT_AFTER_MILLIS),
+                        why = PersonaOwnTime.Why.FIRST
+                    )
+                    state.wake == PersonaOwnTime.Wake.WhenHeWrites -> {
+                        val planned = PersonaOwnTime.plan(
+                            wish = null,
+                            wishGiven = false,
+                            nowMillis = nowMillis,
+                            zone = zone,
+                            lastGapMillis = state.lastGapMillis,
+                            moments = state.momentsOfTheDay(nowMillis),
+                            bounds = bounds,
+                            after = PersonaOwnTime.Why.AFTER_HE_WROTE
+                        )
+                        state.copy(
+                            wake = planned.wake,
+                            why = planned.why,
+                            moved = planned.moved ?: state.moved,
+                            movedAsked = if (planned.moved != null) "" else state.movedAsked
+                        )
+                    }
+                    // She was asleep, and his message is what she answered: it woke her.
+                    PersonaSleep.isMarked(state) -> PersonaSleep.wokenByHim(state, nowMillis, zone, bounds)
+                    // An unlock had brought her next moment forward for his silence, and he wrote.
+                    state.why == PersonaOwnTime.Why.UNLOCKED -> PersonaOwnTime.setBack(state, nowMillis, bounds) ?: state
+                    sleep != null -> state
+                    else -> return
+                }
+                // A << sleep: line in the same reply puts her to sleep from where that leaves her.
+                val next = if (sleep != null) {
+                    PersonaSleep.lieDown(woken, sleep, PersonaSleep.written(sleep), nowMillis, zone, bounds, sleepJitter())
+                } else {
+                    woken
+                }
+                memory.saveOwnTime(next)
+                next.wake
+            }
+            ownTimeAlarm.set((wake as? PersonaOwnTime.Wake.At)?.atMillis)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her next moment was not set after a reply: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * Puts a moment that is due off by [PersonaOwnTime.PUT_OFF_MILLIS]: the owner is in
+     * the middle of something. It is not dropped and it does not count against the day.
+     */
+    suspend fun putOffOwnTime(nowMillis: Long = System.currentTimeMillis()) {
+        val later = nowMillis + PersonaOwnTime.PUT_OFF_MILLIS
+        ownTimeLock.withLock {
+            val state = memory.ownTime()
+            // A time kept from before her own time was switched off is not hers any more: there is nothing to put off.
+            if (!state.on) return
+            val due = (state.wake as? PersonaOwnTime.Wake.At)?.atMillis ?: return
+            if (due >= later) return
+            memory.saveOwnTime(state.copy(wake = PersonaOwnTime.Wake.At(later)))
+        }
+        ownTimeAlarm.set(later)
+    }
+
+    /**
+     * He unlocked the phone at [nowMillis]. When he has gone a long while without writing
+     * ([heLastWroteAt], null when no message of his is among the chat's recent rows), she
+     * is awake and her last moment is not recent, her next moment is brought forward to a
+     * few minutes from now ([PersonaOwnTime.broughtForward]): his least gap and the day's
+     * count still hold. The time it had is kept ([PersonaOwnTime.unlocked]), so that a
+     * message of his before then puts it back. Nothing is asked of the model here, and
+     * nothing is shown. While a moment of hers is being had, the stored time is that
+     * moment's and is left alone.
+     *
+     * Never fails the caller.
+     */
+    suspend fun ownTimeOnUnlock(heLastWroteAt: Long?, nowMillis: Long = System.currentTimeMillis()) {
+        try {
+            val config = settingsRepository.llmConfig.first()
+            if (!ownTimeIsOn(config) || inOwnMoment.get()) return
+            val bounds = PersonaOwnTime.Bounds.of(config)
+            val sooner = ownTimeLock.withLock {
+                val state = memory.ownTime()
+                val at = PersonaOwnTime.broughtForward(state, nowMillis, heLastWroteAt, bounds) ?: return
+                memory.saveOwnTime(PersonaOwnTime.unlocked(state, at))
+                at
+            }
+            ownTimeAlarm.set(sooner)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her next moment was not brought forward: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * What a moment of her own left for the caller to put somewhere: the line she wrote
+     * to him ([said], empty when she wrote none), the command she wants carried out and
+     * the command lines that are not ([PersonaActionRows.Unrun]). Her thoughts, her notes
+     * and the time of her next moment are not in it: those were put away here already.
+     */
+    data class OwnMoment(val said: String, val command: String?, val unrun: List<PersonaActionRows.Unrun>)
+
+    /**
+     * One moment of her own, or null when there is none to have: her own time is off, or
+     * has not been seen switched on since it was last off, no time is stored, the stored
+     * time has not come, the day's moments are used up, or the call failed.
+     *
+     * She gets one request, on her own route and through the same gate as every request
+     * of hers, with no retry. Its system text is her chat prompt as for a reply, then the
+     * recent talk as text and, last, the block that says what this is
+     * ([PersonaOwnTime.momentBlock]). It ends in one turn that nobody wrote and that says
+     * so ([PersonaOwnTime.TURN]): nothing in the request stands where a message of his would.
+     *
+     * What comes back is sorted by [PersonaOwnTime.parse]. An answer she ended with
+     * nothing in it is not a failed call: it is a moment she let pass, which counts and
+     * is followed by the usual gap. Her thoughts go to her own store and nowhere else.
+     * Her notes go into her notebook: she is shown her notes with their keys here, so a
+     * note under a key that was on her page replaces that note, which is how she changes
+     * her mind; one under a key that was not on it is kept beside the old one.
+     * The time she named becomes the stored time, inside the owner's bounds. The rest is
+     * handed back for the caller to show and to run.
+     *
+     * Before the call the stored time is moved a short wait ahead, so that an attempt
+     * that fails, or a process that dies while she writes, is tried again then and not
+     * at once, and does not count against the day. The wait grows when one attempt after
+     * another fails ([PersonaOwnTime.retryWaitMillis]). A failure is logged by its error
+     * code only and shown nowhere: the owner did nothing that could have failed.
+     *
+     * [ownPlanWaits] says a plan she started in an earlier moment still waits for his
+     * yes; she is told, because nothing else she starts is carried out until then.
+     *
+     * While she sleeps the alarm rings for her sleep and not for a moment ([sleepRing]):
+     * her sleep pass, or her waking, which is then the moment had here, or nothing. A
+     * `sleep:` line of hers puts her to sleep once this moment is over, in the place of
+     * the time she named after `next:`.
+     */
+    suspend fun ownMoment(
+        relevantContext: suspend () -> String,
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long = System.currentTimeMillis(),
+        zone: TimeZone = TimeZone.getDefault(),
+        ownPlanWaits: Boolean = false,
+        glance: suspend () -> List<Glance.Headline> = { emptyList() },
+        goes: suspend (PersonaOwnTime.Go) -> Unit = {}
+    ): OwnMoment? = withContext(ownLife.counted(OwnPurpose.MOMENT)) {
+        momentOfHers(relevantContext, recentMessages, nowMillis, zone, ownPlanWaits, glance, goes)
+    }
+
+    // The moment itself. [ownMoment] runs it as a call of hers ([OwnPurpose.MOMENT]), so the
+    // ledger of her own calls counts it; her sleep pass and her notebook pass in it are
+    // counted under their own purposes. While her own life is on, [glance] fetches the glance
+    // at her feeds, asked only once the moment is had, and [goes] is handed the go: line she
+    // wrote, once what is stored about her own time is saved: the outing runs in her own
+    // space, by itself.
+    private suspend fun momentOfHers(
+        relevantContext: suspend () -> String,
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        zone: TimeZone,
+        ownPlanWaits: Boolean,
+        glance: suspend () -> List<Glance.Headline>,
+        goes: suspend (PersonaOwnTime.Go) -> Unit
+    ): OwnMoment? {
+        val config = settingsRepository.llmConfig.first()
+        if (!ownTimeIsOn(config)) return null
+        if (!inOwnMoment.compareAndSet(false, true)) return null
+        try {
+            if (sleepRing(config, nowMillis, zone)) return null
+            val bounds = PersonaOwnTime.Bounds.of(config)
+            // Her own life as this moment is told it: what she can go and do, her wonders and her ledger.
+            val life = if (ownLifeIsOn(config)) ownLife.now(config, nowMillis) else null
+            val before = ownTimeLock.withLock {
+                val state = memory.ownTime()
+                // Her own time has not been seen switched on since it was last off: a time kept
+                // from before no longer holds. Setting the alarm ([armOwnTime]) is what sees the
+                // switch, and it sets her first moment from there.
+                if (!state.on) return null
+                val due = (state.wake as? PersonaOwnTime.Wake.At)?.atMillis ?: return null
+                // The alarm rang for a time that has been changed since: the stored time is the truth.
+                if (nowMillis < due - PersonaOwnTime.EARLY_SLACK_MILLIS) return null
+                val room = PersonaOwnTime.earliestWithRoom(state.momentsOfTheDay(nowMillis), bounds.maxPerDay)
+                if (room > nowMillis) {
+                    // The owner lowered the day's count after she named this time.
+                    memory.saveOwnTime(
+                        state.copy(
+                            wake = PersonaOwnTime.Wake.At(room),
+                            moved = PersonaOwnTime.Moved.DAY_USED_UP,
+                            movedAsked = ""
+                        )
+                    )
+                    return null
+                }
+                // His number of calls on her own is used up: the moment waits until one falls out of the 24 hours.
+                val callsBack = life?.takeIf { it.left == 0 }?.roomAgainAt
+                if (callsBack != null && callsBack > nowMillis) {
+                    memory.saveOwnTime(
+                        state.copy(
+                            wake = PersonaOwnTime.Wake.At(callsBack),
+                            moved = PersonaOwnTime.Moved.CALLS_USED_UP,
+                            movedAsked = ""
+                        )
+                    )
+                    return null
+                }
+                memory.saveOwnTime(
+                    state.copy(
+                        wake = PersonaOwnTime.Wake.At(nowMillis + PersonaOwnTime.retryWaitMillis(state.failures)),
+                        failures = state.failures + 1
+                    )
+                )
+                state
+            }
+            val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+            // The headlines on her feeds since she last looked: fetched with no model call, other people's words.
+            val glanced = if (life != null) glance() else emptyList()
+            // The notes her page for this moment showed, by storage key: a note line of hers under one of them replaces it.
+            var shownKeys: Set<String> = emptySet()
+            val answer = try {
+                // Hours can have passed since the app last wrote: only its lines from the last
+                // half hour are put in front of her, each with its age, and those written since
+                // her last moment when she wrote a command in it, so that she reads what became of it.
+                val shaped = PersonaPrompts.shapeHistory(
+                    recentMessages,
+                    holdBackPrivateResults = heldBack,
+                    nowMillis = nowMillis,
+                    activityMaxAgeMillis = PersonaOwnTime.appLineMaxAgeMillis(before, nowMillis)
+                )
+                // No image is ever sent with a moment of her own.
+                val dialogue = shaped.dialogue.map { it.copy(imageBase64 = null) }
+                // The pages of her files are picked from the recent talk and from what she last thought.
+                val lastThoughts = if (heldBack) "" else thoughts.latest().takeLast(2).joinToString("\n") { it.text }
+                val cues = libraryCues(dialogue) +
+                    listOfNotNull(lastThoughts.takeIf { it.isNotBlank() }?.let { PersonaLibraryText.Cue(it, THOUGHT_CUE_WEIGHT) })
+                // Her open threads are named by key at the end, as her page for this moment shows them.
+                val notebook = memory.notes()
+                // A picture of her can be made from here as from a reply: allowed, and with a picture to start from.
+                val makesPictures = PersonaSelfPictures.allowed(config) && PersonaSelfPictures.base(pictures.list(), null) != null
+                // Left to right: her page is made first, and that is what sets shownKeys for the threads.
+                val systemPrompt = chatSystemPrompt(
+                    config, relevantContext(), shaped.deviceActivity, screenshotAttached = false, cues = cues,
+                    inOwnTime = true, nowMillis = nowMillis, shownNotes = { shownKeys = it }
+                ) + "\n\n" + PersonaOwnTime.talkBlock(dialogue) + "\n\n" +
+                    PersonaOwnTime.momentBlock(
+                        momentFacts(
+                            config, before, recentMessages, nowMillis, zone, heldBack, ownPlanWaits,
+                            openThreads = PersonaOwnTime.openThreads(notebook, shownKeys),
+                            life = lifeFacts(life, before, glanced, nowMillis),
+                            makesPictures = makesPictures
+                        )
+                    )
+                answeredWhole(chatProvider(config), withChatModel(ownTimeRequest(systemPrompt), config))
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "A moment of her own did not come about: ${(e as? LLMException)?.error?.code ?: e.javaClass.simpleName}")
+                return null
+            }
+            // She comes back from meeting a kid on an outing or a look: what she keeps of this moment is checked (§1.4).
+            val metKid = life != null && before.lastOuting?.let { it.endedAt > before.lastAtMillis && it.metKid } == true
+            val moment = PersonaOwnTime.parse(answer.text, cutOff = answer.cutOff, life = life?.runnable, kid = metKid)
+            if (moment.kidLinesDropped > 0) ownLife.kidLinesDropped(moment.kidLinesDropped)
+            if (moment.thoughts.isNotEmpty()) keepThought(moment.thoughts, nowMillis)
+            // Her wonders go on her list; a go: line that does not count, or that the app cannot read, is logged as not started.
+            if (moment.wonders.isNotEmpty()) ownLife.wonder(moment.wonders, nowMillis)
+            repeat(moment.earlierGoes) { ownLife.notStarted(com.opendroid.ai.core.life.HerLog.NotStarted.SEVERAL) }
+            val notRead = moment.outing?.takeUnless { it.runs }
+            if (notRead != null) ownLife.notStarted(com.opendroid.ai.core.life.HerLog.NotStarted.NOT_READ)
+            if (moment.notes.isNotEmpty()) {
+                try {
+                    // The same notes her prompt for this moment left out: every one that can be about him.
+                    // A line under a key her page showed replaces that note; any other goes beside.
+                    val unseen = notesLeftOut(heldBack, ownerName())
+                    val placed = PersonaNotes.besideUnseen(moment.notes, memory.notes(), unseen, shownKeys = shownKeys)
+                    memory.apply(placed)
+                    // A mark she put behind a note is how she knows it, after the write that cleared the old one.
+                    val marks = PersonaNotes.marksFor(placed, moment.notes, moment.marks)
+                    if (marks.isNotEmpty()) memory.updateHow { it + marks }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    Log.w(TAG, "Notes from a moment of her own were not written: ${e.javaClass.simpleName}")
+                }
+            }
+            if (moment.feelings.isNotEmpty()) {
+                try {
+                    memory.updateMood { PersonaMood.merge(it, moment.feelings, nowMillis) }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    Log.w(TAG, "How she feels was not kept from a moment of her own: ${e.javaClass.simpleName}")
+                }
+            }
+            val wake = ownTimeLock.withLock {
+                val state = memory.ownTime()
+                // This moment counts from here on: it was a model call, whatever she made of it.
+                val moments = state.momentsOfTheDay(nowMillis) + nowMillis
+                val planned = PersonaOwnTime.plan(
+                    wish = moment.wish,
+                    wishGiven = moment.wishText != null,
+                    nowMillis = nowMillis,
+                    zone = zone,
+                    lastGapMillis = state.lastGapMillis,
+                    moments = moments,
+                    bounds = bounds
+                )
+                // Whether her own time is on is not decided here: he may have switched it off
+                // while she wrote, and what was seen then stays as it was seen.
+                val awake = state.copy(
+                    wake = planned.wake,
+                    why = planned.why,
+                    moments = moments,
+                    lastGapMillis = planned.chosenGapMillis ?: state.lastGapMillis,
+                    lastAtMillis = nowMillis,
+                    lastDid = moment.did,
+                    lastHadCommand = moment.command != null || moment.unrun.isNotEmpty(),
+                    moved = planned.moved,
+                    movedAsked = if (planned.moved != null) moment.wishText.orEmpty() else "",
+                    failures = 0,
+                    // What she was told about her last sleep has been said; a sleep: line the app could not read is told next.
+                    sleepMoved = if (moment.sleepNotRead) PersonaSleep.SleepMoved.NOT_READ else null,
+                    sleepAsked = if (moment.sleepNotRead) moment.sleepText.orEmpty() else "",
+                    // A go: line that did not start was told in this moment; one the app could not read now is told next.
+                    goMissed = notRead?.let {
+                        PersonaOwnTime.GoMissed(it.words, com.opendroid.ai.core.life.HerLog.NotStarted.NOT_READ.name)
+                    },
+                    // A line of hers about a kid that was not kept is told at her next moment (PK-2).
+                    kidNotKept = moment.kidLinesDropped
+                )
+                // A sleep: line wins over next:. Switched off meanwhile, there is no sleep to lie down to.
+                val asleep = moment.sleep?.takeIf { state.on }?.let { ask ->
+                    PersonaSleep.lieDown(awake, ask, moment.sleepText.orEmpty(), nowMillis, zone, bounds, sleepJitter())
+                }
+                // His message came while she wrote this, and her reply to it put her to sleep: that
+                // sleep stands, with its own time and what she is told of it. This moment only counts.
+                val slept = if (asleep == null && PersonaSleep.isMarked(state)) {
+                    state.copy(
+                        wake = PersonaSleep.alarm(state),
+                        moments = moments,
+                        lastGapMillis = planned.chosenGapMillis ?: state.lastGapMillis,
+                        lastAtMillis = nowMillis,
+                        lastDid = moment.did,
+                        lastHadCommand = moment.command != null || moment.unrun.isNotEmpty(),
+                        failures = 0
+                    )
+                } else {
+                    null
+                }
+                memory.saveOwnTime(asleep ?: slept ?: awake)
+                // Switched off meanwhile: nothing is rung for.
+                when {
+                    asleep != null -> asleep.wake.takeIf { state.on }
+                    slept != null -> slept.wake.takeIf { state.on }
+                    else -> planned.wake.takeIf { state.on }
+                }
+            }
+            ownTimeAlarm.set((wake as? PersonaOwnTime.Wake.At)?.atMillis)
+            // Her outing starts once all of that is stored: it runs in her own space, by itself.
+            moment.outing?.takeIf { it.runs }?.let { goes(it) }
+            return OwnMoment(moment.said, moment.command, moment.unrun)
+        } finally {
+            inOwnMoment.set(false)
+        }
+    }
+
+    /** The facts about one moment, read off the settings, what is stored and the chat. */
+    private fun momentFacts(
+        config: LLMConfig,
+        state: PersonaOwnTime.State,
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        zone: TimeZone,
+        heldBack: Boolean,
+        ownPlanWaits: Boolean,
+        openThreads: List<String> = emptyList(),
+        life: PersonaOwnTime.Life? = null,
+        makesPictures: Boolean = false
+    ): PersonaOwnTime.MomentFacts {
+        fun clock(timeZone: TimeZone): String =
+            SimpleDateFormat("EEEE HH:mm", Locale.ENGLISH).apply { this.timeZone = timeZone }.format(Date(nowMillis))
+        val heLastWroteAt = recentMessages.lastOrNull { it.sender == ChatMessage.Sender.USER }?.timestamp
+        return PersonaOwnTime.MomentFacts(
+            why = state.why,
+            actionsEnabled = config.personaActionsEnabled,
+            rein = config.personaRein,
+            notificationShowsWords = config.checkInShowsText,
+            bounds = PersonaOwnTime.Bounds.of(config),
+            number = state.momentsOfTheDay(nowMillis).size + 1,
+            hisClock = clock(zone),
+            tokyoClock = clock(TOKYO),
+            heLastWrote = heLastWroteAt?.let { PersonaPrompts.age(nowMillis - it) },
+            lastMoment = state.lastAtMillis.takeIf { it > 0 }?.let { PersonaPrompts.age(nowMillis - it) },
+            lastDid = state.lastDid,
+            lastHadCommand = state.lastHadCommand,
+            moved = state.moved,
+            movedAsked = state.movedAsked,
+            lastGapMillis = state.lastGapMillis,
+            ownPlanWaits = ownPlanWaits,
+            thoughtsLeftOut = heldBack,
+            hostCanRead = !RouteClassifier.personaRoute(config).isPrivate,
+            sleep = PersonaSleep.MomentSleepFacts(state, nowMillis),
+            openThreads = openThreads,
+            makesPictures = makesPictures,
+            broughtFrom = state.broughtFromWhy.takeIf { state.why == PersonaOwnTime.Why.UNLOCKED || state.why == PersonaOwnTime.Why.CAME_BACK },
+            life = life
+        )
+    }
+
+    /**
+     * What of her own life her moment is told, from [life] (read for this moment) and what
+     * is stored: her last outing when it ended after her last moment, and a go: line of
+     * hers that did not start. Null while her own life is off.
+     */
+    private fun lifeFacts(
+        life: OwnLifeLink.Now?,
+        state: PersonaOwnTime.State,
+        glance: List<Glance.Headline>,
+        nowMillis: Long
+    ): PersonaOwnTime.Life? = life?.let {
+        PersonaOwnTime.Life(
+            nowMillis = nowMillis,
+            runnable = it.runnable,
+            maxMinutes = it.maxMinutes,
+            maxSteps = it.maxSteps,
+            cap = it.cap,
+            left = it.left,
+            wonders = it.wonders,
+            glance = glance,
+            lastOuting = state.lastOuting?.takeIf { outing -> outing.endedAt > state.lastAtMillis },
+            goMissed = state.goMissed,
+            asks = it.asks,
+            camera = it.camera,
+            eyes = it.eyes,
+            paidSearch = it.paidSearch,
+            kidNotKept = state.kidNotKept
+        )
+    }
+
+    /**
+     * What the alarm rang for while she sleeps, decided under the lock of her own time
+     * ([PersonaSleep.ring]). True when the ring was for her sleep and is dealt with here,
+     * so no moment is had: her sleep pass, or nothing at all (a time that was changed).
+     * False when she is awake, and when this ring is her waking: the moment it was for is
+     * then had as any other, from what [PersonaSleep.wokeOnOwn] stored.
+     *
+     * Her pass is tried with the next try stored first ([PersonaSleep.beforeRepair]), so
+     * a process that dies in it costs her only that try. What her notebook has not read
+     * of the talk yet is read first, by her notebook pass, so that the last talk of her
+     * day is in it. What the pass came to is stored for the sleep it was made in
+     * ([PersonaSleep.afterRepair]). The alarm is not set here: the work that rang sets it
+     * again from what is stored once it is over.
+     */
+    private suspend fun sleepRing(config: LLMConfig, nowMillis: Long, zone: TimeZone): Boolean {
+        val night = ownTimeLock.withLock {
+            val state = memory.ownTime()
+            if (!state.on || !PersonaSleep.isMarked(state)) return false
+            when (PersonaSleep.ring(state, nowMillis)) {
+                PersonaSleep.Ring.REPAIR -> {
+                    memory.saveOwnTime(PersonaSleep.beforeRepair(state, nowMillis))
+                    state
+                }
+                PersonaSleep.Ring.WAKE -> {
+                    memory.saveOwnTime(PersonaSleep.wokeOnOwn(state, nowMillis))
+                    return false
+                }
+                PersonaSleep.Ring.NONE -> {
+                    // Nothing is due: a pass that can no longer come this sleep is owed, and the
+                    // alarm goes to the sleep's own time when something left another there.
+                    val settled = PersonaSleep.settled(state, nowMillis)
+                    if (settled != state) memory.saveOwnTime(settled)
+                    return true
+                }
+            }
+        }
+        val repair = try {
+            // What is unread goes into her notebook first. One pass at most: it reads one page.
+            onReply(catchUp = true)?.join()
+            // Counted among her own calls as upkeep, not as the moment it rang for.
+            withContext(ownLife.counted(OwnPurpose.SLEEP_PASS)) { sleepPass(config, night, nowMillis, zone) }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her sleep pass did not come about: ${e.javaClass.simpleName}")
+            PersonaSleep.Repair.failed(nowMillis)
+        }
+        ownTimeLock.withLock {
+            memory.saveOwnTime(PersonaSleep.afterRepair(memory.ownTime(), night.asleepSince, repair))
+        }
+        return true
+    }
+
+    /**
+     * Her sleep pass ([PersonaSleepPass]): one request on her own route, as her notebook
+     * pass is, with her card first. Its route is decided by the rules of her notebook
+     * pass: where a host could read it, every note that can be about him stays on the
+     * phone, and so do her thoughts and every feeling and let-go note that can be about
+     * him. It is given no talk, no line of the app's and nothing of his profile.
+     *
+     * What she writes is laid out by [PersonaSleepPass.plan] and written in this order:
+     * what she brings back, her notes (beside a note she was not shown, never over it;
+     * every text she writes over goes to her archive), what she lets go, her marks, how
+     * she feels, and the rest as one thought of hers from the night. A notebook the
+     * owner emptied while she slept is not written into.
+     *
+     * Never throws for a call that fails: it comes back as a pass that did not come
+     * about, logged by its error code alone, and the pass stays owed.
+     */
+    private suspend fun sleepPass(
+        config: LLMConfig,
+        state: PersonaOwnTime.State,
+        nowMillis: Long,
+        zone: TimeZone
+    ): PersonaSleep.Repair {
+        if (!isActive(config)) return PersonaSleep.Repair.failed(nowMillis)
+        // One pass over her notebook at a time: one that is busy costs this try.
+        if (!reflecting.compareAndSet(false, true)) return PersonaSleep.Repair.failed(nowMillis)
+        try {
+            // Her notebook as this build has it, before she goes over it: a new build can start in her sleep.
+            seedOnce()
+            val started = System.currentTimeMillis()
+            val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+            val owner = ownerName()
+            val unseen = notesLeftOut(heldBack, ownerName())
+            val notes = memory.notes()
+            // Who she is now first; what does not fit comes round night by night.
+            val review = PersonaNotes.review(
+                notes,
+                maxChars = PersonaSleepPass.NOTEBOOK_CHARS,
+                leaveOut = unseen,
+                recall = PersonaNotes.Recall(emptySet(), nowMillis / PersonaOwnTime.DAY_MILLIS),
+                times = PersonaNotes.Times(memory.writtenAt(), nowMillis),
+                allDated = true,
+                // Every note keeps its age here, and a starting note in the words of her files says so too.
+                origins = origins(withMarks = false)
+            )
+            val shown = notes.filter { it.storageKey in review.shownKeys }
+            // What she let go last, and a few older ones that come round night by night.
+            val letGo = memory.archivedLately(
+                PersonaSleepPass.LET_GO_SHOWN,
+                leaveOut = unseen,
+                newest = PersonaSleepPass.LET_GO_NEWEST,
+                turn = nowMillis / PersonaOwnTime.DAY_MILLIS
+            )
+            val feelings = PersonaMood.pageLines(memory.mood(), nowMillis, leaveOut = if (heldBack) PersonaMood.aboutHim(owner) else null)
+            val sinceWoke = if (heldBack) emptyList() else thoughts.latest(PersonaThoughts.SLEEP_BUDGET_CHARS).filter { it.atMillis > state.lastWokeAt }
+            val page = PersonaSleepPass.page(
+                tonight = PersonaSleepPass.tonight(nowMillis, state.asleepSince, state.sleepUntil, zone),
+                notebook = review.text,
+                notesHeldBack = heldBack,
+                lookAlike = PersonaSleepPass.lookAlike(shown),
+                marks = PersonaSleepPass.howBlock(memory.how(), shown),
+                feelings = feelings,
+                letGo = letGo.map { PersonaSleepPass.LetGo(it.note, it.archivedAt) },
+                thoughts = sinceWoke,
+                nowMillis = nowMillis
+            )
+            val answer = answeredWhole(chatProvider(config), withChatModel(PersonaSleepPass.request(store.card(), owner, page), config))
+            val reading = PersonaSleepPass.read(answer.text, answer.cutOff)
+            // He emptied her notebook while she slept: nothing is written back into it.
+            if (memory.emptiedAtMillis >= started) return PersonaSleep.Repair.failed(nowMillis)
+            // Any note she let go can come back into a free key, listed on her page tonight or not.
+            val plan = PersonaSleepPass.plan(reading, review.shownKeys, memory.restorableKeys())
+            var back = 0
+            for (key in plan.back) if (memory.restore(key)) back++
+            val placed = PersonaNotes.besideUnseen(plan.notes, memory.notes(), unseen, shownKeys = review.shownKeys)
+            val applied = if (placed.isEmpty()) PersonaMemory.Applied(0, 0) else memory.apply(placed)
+            val letGoNow = memory.fade(plan.fade)
+            val placedKeys = placed.mapTo(HashSet()) { it.storageKey }
+            // A how line of hers wins over a mark she put behind the same note in a bracket.
+            val marks = PersonaNotes.marksFor(placed, plan.notes, reading.noteMarks) +
+                plan.how.filterKeys { it in review.shownKeys || it in placedKeys }
+            if (marks.isNotEmpty()) memory.updateHow { it + marks }
+            if (plan.felt.isNotEmpty()) memory.updateMood { PersonaMood.merge(it, plan.felt, nowMillis) }
+            if (plan.prose.isNotBlank()) keepThought(plan.prose, nowMillis)
+            val notTaken = memory.notTaken()
+            memory.recordNotTaken(notTaken + reading.notTaken)
+            return PersonaSleep.Repair(
+                atMillis = nowMillis,
+                ok = true,
+                rewritten = applied.rewritten,
+                added = applied.added,
+                letGo = letGoNow,
+                back = back,
+                feelings = plan.felt.size,
+                marks = marks.size,
+                thoughtsKept = if (plan.prose.isNotBlank()) 1 else 0,
+                notTaken = reading.notTaken.size
+            )
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her sleep pass did not come about: ${(e as? LLMException)?.error?.code ?: e.javaClass.simpleName}")
+            return PersonaSleep.Repair.failed(nowMillis)
+        } finally {
+            reflecting.set(false)
+        }
+    }
+
+    /**
+     * What she says right after the phone did something: the app's [exact] result in her
+     * own words, or null when the exact text should be spoken as it is.
+     *
+     * One short call on her own route, with no retry and a few seconds at most, because
+     * the owner is waiting to hear what happened. Null when she or the setting is off,
+     * when the call fails for any reason (a route his privacy setting refuses included),
+     * and when her line does not keep every fact of the result ([PersonaTruth]). What the
+     * phone read out to him is one of the details private mode keeps from a plain hosted
+     * route, so there the call is not made at all. [ownIdea] tells her whether she
+     * started the action herself.
+     *
+     * The line is only ever text: nothing in it is run, and it is not a turn of the
+     * conversation, so it does not count towards her notebook.
+     */
+    suspend fun resultLine(config: LLMConfig, exact: String, success: Boolean, ownIdea: Boolean): String? {
+        if (!isActive(config) || !wordsResults(config)) return null
+        // While she sleeps nothing comes from her: the exact result is said as it is.
+        if (ownTimeIsOn(config) && PersonaSleep.isAsleep(memory.ownTime(), clock())) return null
+        return resultLineFrom(store.card(), ownerName(), exact, success, ownIdea, callScope = scope) { request ->
+            // A line she keeps to herself is not part of what she says about the result.
+            withoutThoughts(chatProvider(config).complete(withChatModel(request, config)))
+        }
+    }
+
+    /**
+     * Which model may read [command], a command she wrote herself, in order to plan it.
+     *
+     * She writes a command with her notes about him in front of her, and nothing but a
+     * sentence in her prompt keeps them out of it. The planner is the main model. Where
+     * private mode keeps his details from the main model's route, her free text must not
+     * carry them there unseen. See [commandRouteFor].
+     */
+    suspend fun commandRoute(config: LLMConfig, command: String): CommandRoute =
+        // The notes as she wrote them, without the headings her prompt puts over them.
+        commandRouteFor(config, command, memory.notes().joinToString("\n") { it.text })
+
+    /**
+     * [outsideText], the text a command of hers is held against to see whether its words
+     * may be someone else's, with what she noted of his screen added where [command]
+     * repeats it. A note that starts with "saw:" holds words off his screen, and it
+     * stands in her prompt long after the screenshot and the notification are gone. A
+     * number she repeats from it is as little her own as one she reads off a screen that
+     * is in front of her.
+     *
+     * Only that kind of thing is compared: a long number, an address, a handle, what
+     * points an action at somebody ([repeatsFromNote]). The plain words of those notes
+     * are not. They are her own wording of what she saw, and they stay and add up: held
+     * against them by the share of words they have in common, a command about an alarm
+     * would count as borrowed for good because she once noted his alarms. So a note is
+     * added only when the command repeats such a thing from it, and the check that
+     * follows then finds it there.
+     *
+     * Every such note she has is looked at, also one that was not on the page of this
+     * reply: a number that stands in one came off his screen by whatever way it got into
+     * her command, and her own earlier lines can carry it.
+     */
+    suspend fun withWhatSheSaw(outsideText: String, command: String): String {
+        val repeated = memory.notes().filter { it.isSeen && repeatsFromNote(command, it.text) }
+        return if (repeated.isEmpty()) outsideText else (listOf(outsideText) + repeated.map { it.text }).joinToString("\n")
+    }
+
+    /**
+     * What the library is asked with for one reply: his newest message counts in full,
+     * the one before it half, and her own last line a little, so a talk that stays on a
+     * subject keeps its pages while a bare "why" still finds them.
+     */
+    fun libraryCues(dialogue: List<ChatMessage>): List<PersonaLibraryText.Cue> {
+        val his = dialogue.filter { it.sender == ChatMessage.Sender.USER }.takeLast(2).reversed()
+        val hers = dialogue.lastOrNull { it.sender != ChatMessage.Sender.USER }
+        // The label on a command the app handled is the app's wording, not his.
+        fun said(message: ChatMessage) = message.text.replace(PersonaPrompts.HANDLED_COMMAND_LABEL, "")
+        return listOfNotNull(
+            his.getOrNull(0)?.let { PersonaLibraryText.Cue(said(it), 1.0) },
+            his.getOrNull(1)?.let { PersonaLibraryText.Cue(said(it), 0.5) },
+            hers?.let { PersonaLibraryText.Cue(it.text, 0.35) }
+        )
+    }
+
+    // ── Her outings ──────────────────────────────────────────────────────────────────
+
+    /**
+     * One step of an outing of hers, or null when there is none to have: her own life is
+     * off, or the call failed. [outing] is the outing's own text, its block and what is in
+     * front of her ([com.opendroid.ai.core.life.OutingPrompt]), and goes last.
+     *
+     * One request of hers, built like a moment ([ownMoment]): her chat prompt for her own
+     * time, without the pages of her files and without the talk, then the outing, and one
+     * turn nobody wrote. It runs as a call of hers ([OwnPurpose.OUTING_STEP]), so the ledger
+     * counts it. What comes back is sorted by [OutingStep.parse]: her reaction is kept as one
+     * thought, her notes go into her notebook marked read unless she marked them (beside a
+     * note her page did not show, never over it), her feel line is kept as how she feels and
+     * her wonder line goes on her list. The step is handed back for the host: her line to
+     * him, and what she does next. A >> line in it is counted there and never run.
+     */
+    suspend fun outingStep(outing: String, sayUsed: Boolean, nowMillis: Long = clock(), kid: Boolean = false, look: Boolean = false): OutingStep.Step? =
+        withContext(ownLife.counted(OwnPurpose.OUTING_STEP)) { stepOfHers(outing, sayUsed, nowMillis, kid, look) }
+
+    private suspend fun stepOfHers(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, look: Boolean): OutingStep.Step? {
+        val config = settingsRepository.llmConfig.first()
+        if (!ownLifeIsOn(config)) return null
+        val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+        // The notes her page for this step showed, by storage key: a note line of hers under one of them replaces it.
+        var shownKeys: Set<String> = emptySet()
+        val answer = try {
+            // No talk, no app lines of his phone and no pages of her files: what is in front of her is the page she is on.
+            val systemPrompt = chatSystemPrompt(
+                config, "", emptyList(), screenshotAttached = false, inOwnTime = true, nowMillis = nowMillis,
+                shownNotes = { shownKeys = it }, withLibrary = false, onOuting = true, onLook = look
+            ) + "\n\n" + outing
+            answeredWhole(chatProvider(config), withChatModel(outingRequest(systemPrompt, look), config))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "A step of her outing did not come about: ${(e as? LLMException)?.error?.code ?: e.javaClass.simpleName}")
+            return null
+        }
+        // With something marked as a kid's in front of her, a line that reads as sexual is not kept (KidGuard).
+        val step = OutingStep.parse(answer.text, cutOff = answer.cutOff, sayUsed = sayUsed, kid = kid)
+        if (step.thought.isNotEmpty()) keepThought(step.thought, nowMillis)
+        if (step.notes.isNotEmpty()) {
+            try {
+                val unseen = notesLeftOut(heldBack, ownerName())
+                val placed = PersonaNotes.besideUnseen(step.notes, memory.notes(), unseen, shownKeys = shownKeys)
