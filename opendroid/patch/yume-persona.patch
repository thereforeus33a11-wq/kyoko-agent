+package com.opendroid.ai.core.persona
+
+import android.util.Log
+import com.opendroid.ai.core.llm.LLMProvider
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.ProviderCatalog
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.holdsBackDetails
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.approvalSettings
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineExceptionHandler
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.UUID
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Everything the persona does, in one place, so that the rest of the app asks it a
+ * few narrow questions and never handles her text itself:
+ *
+ *  - is she on, and which provider writes her replies;
+ *  - the system prompt for one chat reply;
+ *  - the fixed lines the app speaks, in her voice ([phrasebook]);
+ *  - keeping her notebook up to date after a chat ([onReply]);
+ *  - an unprompted line when she has been left alone ([checkInLine]);
+ *  - what the phone just did, said in her words with the facts kept ([resultLine]);
+ *  - which model may read a command she wrote ([commandRoute]).
+ *
+ * Nothing here starts a device action. Every call it makes is plain text, and what
+ * comes back goes to the chat and to speech. When she wants something done on the
+ * phone she ends a reply with a command line ([PersonaActions]); the loop that runs
+ * the owner's commands takes it from there, through her rein and his approval setting.
+ */
+@Singleton
+class PersonaEngine @Inject constructor(
+    private val store: PersonaStore,
+    private val memory: PersonaMemory,
+    private val library: PersonaLibrary,
+    private val settingsRepository: SettingsRepository,
+    private val llmProviderFactory: LLMProviderFactory,
+    private val userProfileStore: UserProfileStore
+) {
+    val phrasebook = PersonaPhrasebook()
+
+    private val scope = CoroutineScope(
+        SupervisorJob() + Dispatchers.Default + CoroutineExceptionHandler { _, e ->
+            Log.w(TAG, "Persona background task failed: ${e.javaClass.simpleName}")
+        }
+    )
+    private val repliesSinceReflection = AtomicInteger(0)
+    private val reflecting = AtomicBoolean(false)
+    private val seeded = AtomicBoolean(false)
+
+    suspend fun isActive(): Boolean = isActive(settingsRepository.llmConfig.first())
+
+    /** On only when switched on and a card exists; a build without the card behaves like stock. */
+    fun isActive(config: LLMConfig): Boolean = config.personaEnabled && store.card().isNotBlank()
+
+    /** The provider that writes her replies: the one chosen for chat, else the active one. */
+    suspend fun chatProvider(config: LLMConfig): LLMProvider {
+        val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+        return if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) {
+            llmProviderFactory.getProviderByName(chosen)
+        } else {
+            llmProviderFactory.getActiveProvider()
+        }
+    }
+
+    /**
+     * Points [request] at the model chosen for her replies, when one is set. Used for
+     * her chat reply, her notebook reflection, her check-ins and her line about a
+     * result, and for planning a command of hers when that has to stay on her route
+     * ([commandRoute]). Nothing of the owner's own commands goes this way.
+     */
+    fun withChatModel(request: LLMRequest, config: LLMConfig): LLMRequest = request.copy(
+        modelOverride = config.personaChatModel.trim().ifEmpty { null },
+        extraBodyOverride = config.personaChatExtraBody.trim().ifEmpty { null }
+    )
+
+    /** Whether a screenshot may be attached to a chat request for this configuration. */
+    fun chatSeesImages(config: LLMConfig): Boolean = imagesReachChatModel(config)
+
+    suspend fun chatSystemPrompt(
+        config: LLMConfig,
+        relevantContext: String,
+        deviceActivity: List<String>,
+        screenshotAttached: Boolean,
+        ownActions: Boolean = config.personaActionsEnabled,
+        cues: List<PersonaLibraryText.Cue> = emptyList()
+    ): String {
+        seedOnce()
+        val owner = ownerName()
+        val route = RouteClassifier.personaRoute(config)
+        val heldBack = config.holdsBackDetails(route)
+        return PersonaPrompts.chatSystemPrompt(
+            card = store.card(),
+            ownerName = owner,
+            // The pages of her files that are about him follow the same rule as her notes about him.
+            library = library.excerpt(cues, config.personaLibraryChars, owner, withPagesAboutOwner = !heldBack),
+            autoModeLabel = config.approvalSettings().mode.name,
+            relevantContext = relevantContext,
+            // On a private route she has all of her notebook. Where a host could read
+            // the prompt, what she noted about him stays on the phone.
+            notes = PersonaNotes.render(memory.notes(), leaveOut = if (heldBack) NOTES_ABOUT_HIM else emptySet()),
+            deviceActivity = deviceActivity,
+            screenshotAttached = screenshotAttached,
+            ownActions = ownActions,
+            hostCanRead = !route.isPrivate,
+            notesAboutHimHeldBack = heldBack,
+            rein = config.personaRein
+        )
+    }
+
+    /**
+     * Called after one of her replies is stored. Every few replies the recent talk is
+     * read once more, off the reply path, and anything worth keeping goes into her
+     * notebook. Failures are silent: a missed note is not worth an error card.
+     */
+    fun onReply(recentMessages: suspend () -> List<ChatMessage>) {
+        if (repliesSinceReflection.incrementAndGet() < REPLIES_PER_REFLECTION) return
+        if (!reflecting.compareAndSet(false, true)) return
+        repliesSinceReflection.set(0)
+        scope.launch {
+            try {
+                reflect(recentMessages())
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "Notebook reflection skipped: ${e.javaClass.simpleName}")
+            } finally {
+                reflecting.set(false)
+            }
+        }
+    }
+
+    internal suspend fun reflect(recentMessages: List<ChatMessage>) {
+        val config = settingsRepository.llmConfig.first()
+        if (!isActive(config)) return
+        // Only what the two of them said. App rows can carry notification or screen text.
+        val dialogue = PersonaPrompts.shapeHistory(recentMessages).dialogue
+        if (dialogue.count { it.sender == ChatMessage.Sender.USER } < 2) return
+        val heldBack = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+        val unseen = if (heldBack) NOTES_ABOUT_HIM else emptySet()
+        val notebook = PersonaNotes.renderForReview(memory.notes(), leaveOut = unseen)
+        val response = chatProvider(config).complete(
+            withChatModel(
+              LLMRequest(
+                systemPrompt = PersonaPrompts.REFLECTION_SYSTEM_PROMPT,
+                messages = listOf(
+                    ChatMessage(
+                        id = UUID.randomUUID().toString(),
+                        text = PersonaPrompts.reflectionUserPrompt(notebook, dialogue, notesAboutHimHeldBack = heldBack),
+                        sender = ChatMessage.Sender.USER
+                    )
+                ),
+                temperature = 0.2f,
+                maxTokens = 240,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+              ),
+              config
+            )
+        )
+        val changes = PersonaNotes.parse(response.content, limit = MAX_CHANGES_PER_REFLECTION)
+        // What she writes is saved on the phone whatever the route. A note written without
+        // sight of the ones about him goes beside them, never over one of them.
+        if (changes.isNotEmpty()) memory.apply(PersonaNotes.besideUnseen(changes, memory.notes(), unseen))
+    }
+
+    /**
+     * One unprompted line, or null when it is not the moment, she has nothing to say or
+     * the call fails. The caller decides whether and where to show it; this never touches
+     * the chat. [hourOfDay] is the owner's local hour, 0-23.
+     */
+    suspend fun checkInLine(
+        relevantContext: suspend () -> String,
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        hourOfDay: Int
+    ): String? {
+        val config = settingsRepository.llmConfig.first()
+        if (!isActive(config) || !config.personaCheckInsEnabled) return null
+        val lastCheckIn = memory.lastCheckInAt()
+        if (!CheckInRule.isDue(recentMessages, nowMillis, hourOfDay, lastCheckIn)) return null
+        // Recorded before the call: a failed attempt must not be retried every few minutes.
+        memory.recordCheckIn(nowMillis)
+        val hoursQuiet = CheckInRule.hoursQuiet(recentMessages, nowMillis)
+        val context = relevantContext()
+        val shaped = PersonaPrompts.shapeHistory(
+            recentMessages,
+            holdBackPrivateResults = config.holdsBackDetails(RouteClassifier.personaRoute(config))
+        )
+        val nudge = ChatMessage(
+            id = UUID.randomUUID().toString(),
+            text = PersonaPrompts.checkInPrompt(hoursQuiet),
+            sender = ChatMessage.Sender.USER
+        )
+        // Images from earlier turns are never resent for an unprompted line.
+        val history = PersonaPrompts.shapeHistory(shaped.dialogue.map { it.copy(imageBase64 = null) } + nudge).dialogue
+        return try {
+            val response = chatProvider(config).complete(
+                withChatModel(
+                    LLMRequest(
+                        // An unprompted line never comes with an action: nobody is there to approve it.
+                        systemPrompt = chatSystemPrompt(
+                            config, context, shaped.deviceActivity, screenshotAttached = false, ownActions = false,
+                            cues = libraryCues(shaped.dialogue)
+                        ),
+                        messages = history,
+                        temperature = CHAT_TEMPERATURE,
+                        maxTokens = 160,
+                        responseFormat = ResponseFormat.TEXT,
+                        retryPolicy = RetryPolicy.NONE
+                    ),
+                    config
+                )
+            )
+            PersonaPrompts.cleanReply(PersonaActions.split(response.content).text)
+                .takeIf { line -> line.any { it.isLetterOrDigit() } }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    /**
+     * What she says right after the phone did something: the app's [exact] result in her
+     * own words, or null when the exact text should be spoken as it is.
+     *
+     * One short call on her own route, with no retry and a few seconds at most, because
+     * the owner is waiting to hear what happened. Null when she or the setting is off,
+     * when the call fails for any reason (a route his privacy setting refuses included),
+     * and when her line does not keep every fact of the result ([PersonaTruth]). What the
+     * phone read out to him is one of the details private mode keeps from a plain hosted
+     * route, so there the call is not made at all. [ownIdea] tells her whether she
+     * started the action herself.
+     *
+     * The line is only ever text: nothing in it is run, and it is not a turn of the
+     * conversation, so it does not count towards her notebook.
+     */
+    suspend fun resultLine(config: LLMConfig, exact: String, success: Boolean, ownIdea: Boolean): String? {
+        if (!isActive(config) || !wordsResults(config)) return null
+        return resultLineFrom(store.card(), ownerName(), exact, success, ownIdea, callScope = scope) { request ->
+            chatProvider(config).complete(withChatModel(request, config))
+        }
+    }
+
+    /**
+     * Which model may read [command], a command she wrote herself, in order to plan it.
+     *
+     * She writes a command with her notes about him in front of her, and nothing but a
+     * sentence in her prompt keeps them out of it. The planner is the main model. Where
+     * private mode keeps his details from the main model's route, her free text must not
+     * carry them there unseen. See [commandRouteFor].
+     */
+    suspend fun commandRoute(config: LLMConfig, command: String): CommandRoute =
+        // The notes as she wrote them, without the headings her prompt puts over them.
+        commandRouteFor(config, command, memory.notes().joinToString("\n") { it.text })
+
+    /**
+     * What the library is asked with for one reply: his newest message counts in full,
+     * the one before it half, and her own last line a little, so a talk that stays on a
+     * subject keeps its pages while a bare "why" still finds them.
+     */
+    fun libraryCues(dialogue: List<ChatMessage>): List<PersonaLibraryText.Cue> {
+        val his = dialogue.filter { it.sender == ChatMessage.Sender.USER }.takeLast(2).reversed()
+        val hers = dialogue.lastOrNull { it.sender != ChatMessage.Sender.USER }
+        // The label on a command the app handled is the app's wording, not his.
+        fun said(message: ChatMessage) = message.text.replace(PersonaPrompts.HANDLED_COMMAND_LABEL, "")
+        return listOfNotNull(
+            his.getOrNull(0)?.let { PersonaLibraryText.Cue(said(it), 1.0) },
+            his.getOrNull(1)?.let { PersonaLibraryText.Cue(said(it), 0.5) },
+            hers?.let { PersonaLibraryText.Cue(it.text, 0.35) }
+        )
+    }
+
+    private fun ownerName(): String =
+        (userProfileStore.read() as? ProfileStoreResult.Success)?.value?.name.orEmpty()
+
+    private suspend fun seedOnce() {
+        if (!seeded.compareAndSet(false, true)) return
+        try {
+            memory.seedIfNeeded(store.seedNotes())
+        } catch (e: CancellationException) {
+            seeded.set(false)
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Seed notes were not written: ${e.javaClass.simpleName}")
+        }
+    }
+
+    companion object {
+        private const val TAG = "PersonaEngine"
+        private const val REPLIES_PER_REFLECTION = 3
+        private const val MAX_CHANGES_PER_REFLECTION = 3
+
+        /** What she has noted about him: the notes that stay on the phone when a host could read the prompt. */
+        private val NOTES_ABOUT_HIM = setOf(PersonaNotes.Kind.USER)
+
+        /**
+         * Whether a screenshot attached to her chat request arrives at her model. The
+         * encrypted exchange carries text only, so there an image would be dropped on the
+         * way while her prompt still said she had one. Answering false makes the prompt
+         * say what is true: she cannot see his screen in that reply.
+         */
+        internal fun imagesReachChatModel(config: LLMConfig): Boolean =
+            config.personaChatSeesImages && RouteClassifier.personaRoute(config) != RoutePrivacy.ENCRYPTED
+
+        /** Her replies want more variety than the stock assistant's 0.5. */
+        const val CHAT_TEMPERATURE = 0.8f
+        // Room for a model that spends some of its allowance before it starts the reply.
+        const val CHAT_MAX_TOKENS = 600
+
+        /** How long the owner is kept waiting for her wording of a result before the exact text is spoken. */
+        const val RESULT_LINE_TIMEOUT_MILLIS = 8_000L
+        // Her voice, with less wandering than a chat reply: the line has to keep its facts.
+        private const val RESULT_TEMPERATURE = 0.6f
+        private const val RESULT_MAX_TOKENS = 200
+
+        /**
+         * Whether a result may be put to her at all with these settings: the owner wants
+         * her to say results, and her route is one that may see what the phone read out.
+         */
+        internal fun wordsResults(config: LLMConfig): Boolean =
+            config.personaSpeaksResults && !config.holdsBackDetails(RouteClassifier.personaRoute(config))
+
+        /**
+         * The part of [resultLine] that does not care which provider answers: builds the
+         * request, asks [complete] once and waits [timeoutMillis] at most, and hands back
+         * her line only when it keeps the facts of [exact]. A result that is empty or
+         * longer than [PersonaTruth.MAX_CHARS] is not put to her at all: a list of
+         * notifications or a page of notes is not something to say in one line.
+         *
+         * The call runs in [callScope], beside the wait and not inside it. A provider
+         * blocks on the network or on the model and cannot be interrupted, so a time
+         * limit wrapped around the call itself would only end when the call does. This
+         * way the owner hears the exact text as soon as the limit is up, and a call that
+         * is still running is left to finish with nobody waiting for its answer.
+         */
+        internal suspend fun resultLineFrom(
+            card: String,
+            ownerName: String,
+            exact: String,
+            success: Boolean,
+            ownIdea: Boolean,
+            timeoutMillis: Long = RESULT_LINE_TIMEOUT_MILLIS,
+            callScope: CoroutineScope,
+            complete: suspend (LLMRequest) -> LLMResponse
+        ): String? {
+            val result = exact.trim()
+            if (result.isEmpty() || result.length > PersonaTruth.MAX_CHARS) return null
+            val request = LLMRequest(
+                systemPrompt = PersonaPrompts.resultSystemPrompt(card, ownerName),
+                messages = listOf(
+                    ChatMessage(
+                        id = UUID.randomUUID().toString(),
+                        text = PersonaPrompts.resultPrompt(result, success, ownIdea),
+                        sender = ChatMessage.Sender.USER
+                    )
+                ),
+                temperature = RESULT_TEMPERATURE,
+                maxTokens = RESULT_MAX_TOKENS,
+                responseFormat = ResponseFormat.TEXT,
+                retryPolicy = RetryPolicy.NONE
+            )
+            val call = callScope.async(Dispatchers.IO) { complete(request) }
+            return try {
+                val response = withTimeoutOrNull(timeoutMillis) { call.await() } ?: return null
+                PersonaTruth.checkedLine(result, response.content, success)
+            } catch (e: CancellationException) {
+                // The owner stopped the task: that is passed on. Otherwise it was the call
+                // that was cut short (a time limit inside the provider), which is a failed
+                // call like any other.
+                currentCoroutineContext().ensureActive()
+                null
+            } catch (e: Exception) {
+                null
+            } finally {
+                call.cancel()
+            }
+        }
+
+        /**
+         * Where a command she wrote may be planned, from the two routes alone.
+         *
+         *  - [CommandRoute.MAIN]: the main model, as for a command of the owner's. This
+         *    is the answer whenever the main route may read his details anyway.
+         *  - [CommandRoute.HERS]: private mode keeps his details from the main route and
+         *    her own route is private. What she wrote where nobody else can read stays
+         *    there: her own model plans the command.
+         *  - [CommandRoute.KEPT]: neither route is private. Her prompt then held nothing
+         *    a hosted model may not read, except for her notes, which are compared here on
+         *    the phone: a command that repeats them ([PersonaActions.echoesOutsideText])
+         *    is not sent anywhere. It stays in the chat for the owner to give himself.
+         */
+        internal fun commandRouteFor(config: LLMConfig, command: String, notes: String): CommandRoute = when {
+            !config.holdsBackDetails(RouteClassifier.mainRoute(config)) -> CommandRoute.MAIN
+            RouteClassifier.personaRoute(config).isPrivate -> CommandRoute.HERS
+            PersonaActions.echoesOutsideText(command, notes) -> CommandRoute.KEPT
+            else -> CommandRoute.MAIN
+        }
+    }
+}
+
+/** Which model plans a command the persona wrote. See [PersonaEngine.commandRouteFor]. */
+enum class CommandRoute { MAIN, HERS, KEPT }
