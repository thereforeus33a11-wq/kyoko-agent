+        /**
+         * True when [query] contains a forced-action word at the START of a word.
+         *
+         * These words used to match anywhere, so "ring" fired inside "boring", "text" inside
+         * "context" and "call" inside "basically", and ordinary conversation was sent to the
+         * planner. A word start still catches every inflection ("calling", "texted",
+         * "screenshots") without matching the middle of an unrelated word.
+         */
+        internal fun isForcedAction(query: String): Boolean =
+            FORCED_ACTION_PATTERNS.any { startsAWord(query, it) }
+
+        private fun startsAWord(query: String, pattern: String): Boolean {
+            var from = 0
+            while (true) {
+                val index = query.indexOf(pattern, from, ignoreCase = true)
+                if (index < 0) return false
+                if (index == 0 || !isLatinWordChar(query[index - 1])) return true
+                from = index + 1
+            }
+        }
+
+        /**
+         * Only Latin letters and digits join onto a keyword. Scripts written without
+         * spaces put a keyword straight after their own characters ("打开wifi"), and that
+         * is still the start of the word.
+         */
+        private fun isLatinWordChar(c: Char): Boolean =
+            c.isDigit() || (c.isLetter() && Character.UnicodeScript.of(c.code) == Character.UnicodeScript.LATIN)
+
         private val CONDITIONAL_MARKER = Regex("""\b(if|unless|in case|when)\b""")
         private val WHEN_QUESTION = Regex("""^\s*when\s+(is|are|was|were|do|does|did|will|should|can)\b""")
 
diff --git a/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
new file mode 100644
index 0000000..ff05e80
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
@@ -0,0 +1,211 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * Which steps of a plan hold the owner's private data in their result, and how such a
+ * result is shown to a model whose host could read it.
+ *
+ * A step holds private data when its action reads some ([ActionSchema.readsPersonalData]),
+ * or when one of its parameters quotes the result of a step that does: "read my
+ * notifications, then show them" puts the notification text into the second step's result
+ * as well, although showing text reads nothing by itself. A step that reaches a contact
+ * through a saved pick names that contact in its result ([SavedPickNotice]); there only
+ * the name is private, not what the step did.
+ */
+internal object PersonalDataResults {
+
+    /**
+     * Ids of the steps in [steps] whose result holds private data. [canonicalNames] gives
+     * the dispatcher's names for a step's action and its fallback, either of which may have
+     * produced the result. [steps] is read in plan order, so a quote of an earlier step is
+     * seen after that step has been judged.
+     */
+    fun stepIdsHolding(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> {
+        val holding = LinkedHashSet<String>()
+        val quotable = LinkedHashSet<String>()
+        for (step in steps.sortedBy { it.order }) {
+            val reads = canonicalNames(step).any { name ->
+                ActionSchema.readsPersonalData(name) && !namesItsOwnPlace(name, step)
+            }
+            // The same "$stepId" form the executor substitutes. A longer id that starts the
+            // same way also matches, which only errs towards holding more back.
+            val quotes = quotable.any { id -> step.params.values.any { it.contains("$" + id) } }
+            if (reads || quotes) holding += step.stepId
+            // Quoting a step that names a saved contact repeats the name as well.
+            if (reads || quotes || namesSavedContact(step, canonicalNames)) quotable += step.stepId
+        }
+        return holding
+    }
+
+    /**
+     * Ids of the steps in [steps] whose result or error names the contact a saved pick
+     * stands for. Only the actions that resolve a contact can carry that notice.
+     */
+    fun stepIdsNamingContact(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> = steps.filter { namesSavedContact(it, canonicalNames) }.mapTo(LinkedHashSet()) { it.stepId }
+
+    private fun namesSavedContact(step: PlanStep, canonicalNames: (PlanStep) -> Collection<String>): Boolean =
+        (SavedPickNotice.isIn(step.result) || SavedPickNotice.isIn(step.error)) &&
+            canonicalNames(step).any(ActionSchema::resultNamesContact)
+
+    /**
+     * The weather action looks up where he is only when the plan names no place. With a
+     * place in the plan the result is the weather there, which tells the planner's own
+     * route nothing the plan did not already say: a planner his details are held back
+     * from was never told where he is, so the place is one he named himself. A planner
+     * that was told everything may have filled in his town; what its plans say is marked
+     * as a whole where it is stored (see [planRowStaysPrivate]). Mirrors how the action reads its
+     * `location` parameter.
+     */
+    private fun namesItsOwnPlace(canonicalName: String, step: PlanStep): Boolean {
+        if (canonicalName != "GET_WEATHER") return false
+        val place = step.params["location"]?.trim().orEmpty()
+        return place.isNotEmpty() && !place.equals("current location", ignoreCase = true)
+    }
+
+    /**
+     * [steps] as a readable host may see them: everything about a step stays (that it ran,
+     * what it was, whether it worked) except the text of a result in [holding], and the
+     * name and number of a saved contact in a step in [namingContact].
+     */
+    fun heldBack(
+        steps: List<PlanStep>,
+        holding: Set<String>,
+        namingContact: Set<String> = emptySet()
+    ): List<PlanStep> = steps.map { step ->
+        val result = step.result
+        when {
+            step.stepId in holding && !result.isNullOrBlank() -> step.copy(result = placeholder(result))
+            step.stepId in namingContact -> step.copy(
+                result = result?.let(SavedPickNotice::withheld),
+                error = step.error?.let(SavedPickNotice::withheld)
+            )
+            else -> step
+        }
+    }
+
+    /**
+     * [steps] of one plan as a prompt on the main route may carry them. A step result can
+     * be the text of his notifications, messages, clipboard or screen. On a private route
+     * the model reads it like everything else; on a hosted route with private mode on the
+     * text stays on the phone and the model is told only that the step ran and has a
+     * result. [plan] is every step of the plan, so that a quote of an earlier step is seen
+     * whichever of the lists the quoting step is in.
+     */
+    fun forPrompt(
+        config: LLMConfig,
+        steps: List<PlanStep>,
+        plan: List<PlanStep> = steps,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): List<PlanStep> {
+        if (!config.mainRouteHoldsBack()) return steps
+        return heldBack(steps, stepIdsHolding(plan, canonicalNames), stepIdsNamingContact(plan, canonicalNames))
+    }
+
+    /**
+     * True when the summary of a run repeats text that holds private data. A run that
+     * worked ([isSuccess]) is summed up from the results of its completed steps, one that
+     * failed from the error of a failed step.
+     */
+    fun summaryHolds(
+        steps: List<PlanStep>,
+        isSuccess: Boolean,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Boolean {
+        val naming = stepIdsNamingContact(steps, canonicalNames)
+        if (!isSuccess) return steps.any { it.status == StepStatus.FAILED && it.stepId in naming }
+        val holding = stepIdsHolding(steps, canonicalNames)
+        return steps.any {
+            it.status == StepStatus.COMPLETED && !it.result.isNullOrBlank() &&
+                (it.stepId in holding || it.stepId in naming)
+        }
+    }
+
+    /**
+     * Stands in for a result that stays on the phone. It still says that there was one and
+     * how long it is, which is enough to tell "nothing found" from a full answer, and that
+     * a later step can use it: the phone fills `$stepId` in itself.
+     */
+    fun placeholder(result: String): String =
+        "[kept on the phone: ${result.length} characters of the owner's private data. " +
+            "Later steps can still use this result by its step id.]"
+}
+
+/**
+ * The notice an action puts in front of its result when it reached a contact through a
+ * pick he saved earlier: the picker is skipped then, so the result has to say who was
+ * chosen. It names someone from his contacts and shows part of the number, which a model
+ * whose host could read the prompt is not given. The notice is written and recognised
+ * here, so that the two cannot drift apart.
+ */
+internal object SavedPickNotice {
+
+    /** The notice for a contact called [name] whose number is shown as [maskedNumber]. */
+    fun of(name: String, maskedNumber: String): String = "Using $name ($maskedNumber). "
+
+    /** What a readable host gets in its place: that a saved pick was used, not whose. */
+    const val WITHHELD = "Using a saved contact (the name stays on the phone). "
+
+    // Lazy up to the first ")." after an opening parenthesis: that is where the notice
+    // ends, whatever parentheses the name ("Riya (work)") or the number ("(555)***") has.
+    private val FORM = Regex("""Using .+? \(.*?\)\.(?: |$)""")
+
+    /** True when [text] carries the notice, at its start or after an "it failed" prefix. */
+    fun isIn(text: String?): Boolean = text != null && FORM.containsMatchIn(text)
+
+    /** [text] with the notice replaced by [WITHHELD]; everything else is left as it is. */
+    fun withheld(text: String): String = FORM.replace(text, Regex.escapeReplacement(WITHHELD))
+}
+
+/**
+ * The lists of steps the re-evaluation and re-plan prompts are built from, as text. Both
+ * prompts go to the main route, so completed and failed steps pass through
+ * [PersonalDataResults.forPrompt] first.
+ */
+internal object ReEvalInputs {
+
+    /** What the re-evaluation call reads after a step. */
+    fun afterStep(
+        config: LLMConfig,
+        originalGoal: String,
+        completedSteps: List<PlanStep>,
+        failedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String
+    ): String {
+        val plan = completedSteps + failedSteps + remainingSteps
+        return """
+            - Original goal: $originalGoal
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Failed steps: ${encode(PersonalDataResults.forPrompt(config, failedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+
+    /** What the re-plan call reads after a step named an action that does not exist. */
+    fun afterUnknownAction(
+        config: LLMConfig,
+        failedStep: PlanStep,
+        completedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String,
+        encodeStep: (PlanStep) -> String
+    ): String {
+        val plan = completedSteps + failedStep + remainingSteps
+        return """
+            - Failed step: ${encodeStep(failedStep)}
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/agent/PlanRecord.kt b/app/src/main/java/com/opendroid/ai/core/agent/PlanRecord.kt
new file mode 100644
index 0000000..ace0509
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/agent/PlanRecord.kt
@@ -0,0 +1,393 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.crash.CrashLogRedactor
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * What the phone did, what it is waiting for and what it never did, in the app's own
+ * plain words. Every text here is built from the steps of a plan as they stand: their
+ * status, what the handler itself reported, and the line [PlanApprovalSummary] gives a
+ * step. Nothing a model wrote about its own plan (a goal, a step description, a talk
+ * step, a reason) is told as a result.
+ *
+ * These texts are the record. They are stored in the chat as the app's rows, and they
+ * are the only thing a later prompt may take as proof that something happened.
+ */
+internal object PlanRecord {
+
+    /** Steps that only ask the owner something. Their record is the question and his answer. */
+    val ASKING_ACTIONS: Set<String> = setOf("CONFIRM_ACTION", "ASK_USER", "PROMPT_USER_SELECTION")
+
+    /** The record of a plan that had nothing to run but talk and questions. */
+    const val NOTHING_RAN = "Nothing was run on the phone."
+
+    /** Said when a plan ended early although no step of it failed. */
+    const val STOPPED_NOTHING_FAILED = "Stopped before the end. Nothing failed."
+
+    /** Said of a step that was under way when the plan was stopped: its outcome is not known. */
+    private const val MAY_HAVE_RUN = "it may or may not have gone through"
+
+    /** Said of a step that could not run because one it needed had failed. */
+    private const val NEEDED_A_FAILED_STEP = "it needed a step that failed"
+
+    private const val MAX_REASON_CHARS = 200
+
+    /** What the executor stores for a step whose handler reported nothing of its own. */
+    private val NO_OWN_RESULT: String by lazy { completedStepResult(ActionResult.Success()) }
+
+    /**
+     * The record of one run.
+     *
+     * [text] is what is stored and spoken. [fromSteps] is false only for [NOTHING_RAN].
+     * [namesSteps] says that a line was written from a step's line, which names who or
+     * what the step acts on. [stopped] says the run ended early with nothing failed: it
+     * neither worked nor failed. [plainOutcome] says the whole record is one thing:
+     * every line of it is a step that was done, or every line is a step that failed. A
+     * record that holds both, or a step that never ran, was interrupted or was left with
+     * the owner, is not: "it worked" and "it failed" are each wrong about a part of it.
+     * [plannerWords] is what the plan's talk steps said, kept apart because it is the
+     * planner's text and not a result.
+     */
+    data class Record(
+        val text: String,
+        val fromSteps: Boolean,
+        val namesSteps: Boolean,
+        val stopped: Boolean,
+        val plainOutcome: Boolean,
+        val plannerWords: String?
+    )
+
+    /**
+     * The record of [plan] after it ran. Completed steps come first, each with what its
+     * handler reported, or with its step line when the handler reported nothing. Then
+     * every failed step with a reason fit to show, then what never ran. A plan that ended
+     * early with no failed step says exactly that.
+     *
+     * [canonicalName] gives the name a step's action runs under. [handedOver] is true for
+     * a step that was left with the owner to finish (a draft waiting for his tap): it is
+     * neither done nor failed, and what he has to do is told in the handler's own words.
+     */
+    fun of(
+        plan: Plan,
+        isSuccess: Boolean,
+        canonicalName: (PlanStep) -> String,
+        handedOver: (PlanStep) -> Boolean = { false }
+    ): Record {
+        // Secrets a step was given are taken out of every result before it is repeated.
+        val steps = PlanPrivacy.redactPlan(plan).steps
+        val lines = PlanApprovalSummary.stepLines(plan)
+        val done = mutableListOf<String>()
+        val failed = mutableListOf<String>()
+        val interrupted = mutableListOf<String>()
+        val notRun = mutableListOf<String>()
+        val talk = mutableListOf<String>()
+        var namesSteps = false
+        var anyFailed = false
+        var anyHandedOver = false
+
+        steps.forEachIndexed { index, step ->
+            val canonical = canonicalName(step)
+            val quiet = isTalkAction(canonical) || canonical in ASKING_ACTIONS
+            val label = inSentence(lines.getOrElse(index) { step.action })
+            when (step.status) {
+                StepStatus.COMPLETED -> when {
+                    isTalkAction(canonical) -> talkWords(step.result)?.let { talk += it }
+                    canonical in ASKING_ACTIONS -> Unit
+                    else -> {
+                        val own = ownResult(step.result)
+                        if (own != null) {
+                            done += own
+                        } else {
+                            done += "Done: $label."
+                            namesSteps = true
+                        }
+                    }
+                }
+                StepStatus.FAILED -> {
+                    anyFailed = true
+                    when {
+                        handedOver(step) -> {
+                            anyHandedOver = true
+                            failed += step.error?.trim().orEmpty().ifEmpty { "Waiting for you: $label." }
+                        }
+                        isBlocked(step.error) -> if (!quiet) {
+                            notRun += "$label ($NEEDED_A_FAILED_STEP)"
+                            namesSteps = true
+                        }
+                        else -> {
+                            failed += "Failed: $label." + reason(step.error)?.let { " $it" }.orEmpty()
+                            namesSteps = true
+                        }
+                    }
+                }
+                StepStatus.RUNNING -> if (!quiet) {
+                    interrupted += label
+                    namesSteps = true
+                }
+                StepStatus.PENDING -> if (!quiet) {
+                    notRun += label
+                    namesSteps = true
+                }
+            }
+        }
+
+        val stopped = !isSuccess && !anyFailed
+        // One outcome for the whole run, and the one the caller was told: only steps that
+        // were done, or only steps that failed.
+        val plainOutcome = !stopped && !anyHandedOver && interrupted.isEmpty() && notRun.isEmpty() &&
+            if (isSuccess) done.isNotEmpty() && failed.isEmpty() else done.isEmpty() && failed.isNotEmpty()
+        val out = mutableListOf<String>()
+        out += done
+        out += failed
+        if (stopped) out += STOPPED_NOTHING_FAILED
+        interrupted.forEach { out += "Interrupted: $it ($MAY_HAVE_RUN)." }
+        if (notRun.isNotEmpty()) out += "Not run: ${notRun.joinToString(", ")}."
+
+        // What a talk step says is left out when it only repeats a result already listed.
+        val plannerWords = talk.filterNot { words -> done.any { it == words } }
+            .joinToString("\n").takeIf { it.isNotBlank() }
+        if (out.isEmpty()) {
+            return Record(
+                NOTHING_RAN,
+                fromSteps = false,
+                namesSteps = false,
+                stopped = false,
+                plainOutcome = false,
+                plannerWords = plannerWords
+            )
+        }
+        return Record(
+            out.joinToString("\n"),
+            fromSteps = true,
+            namesSteps = namesSteps,
+            stopped = stopped,
+            plainOutcome = plainOutcome,
+            plannerWords = plannerWords
+        )
+    }
+
+    /** The row left by a proposed plan the owner turned down. */
+    fun rejected(plan: Plan, canonicalName: (PlanStep) -> String): String = notApproved(plan, "rejected", canonicalName)
+
+    /** The row left by a proposed plan that was dropped before he answered, and [why]. */
+    fun dropped(plan: Plan, why: String, canonicalName: (PlanStep) -> String): String =
+        notApproved(plan, why, canonicalName)
+
+    /**
+     * A plan that waited for approval and did not get it. Usually nothing of it has run.
+     * A plan that was changed while it ran waits at the same gate with steps already
+     * done, and then the row has to say which.
+     */
+    private fun notApproved(plan: Plan, why: String, canonicalName: (PlanStep) -> String): String =
+        if (plan.steps.all { it.status == StepStatus.PENDING }) {
+            "Not run ($why): ${allSteps(plan)}"
+        } else {
+            stopped(plan, canonicalName, why)
+        }
+
+    /**
+     * The row left by a plan that was stopped while it ran: every step it had, then what
+     * had already run, what was under way and what never started. A step that was under
+     * way is not said to have run or not to have run, because that is not known.
+     * [why] says what stopped it, when that is known. [declinedStepId] is the step the
+     * owner said no to: whatever its status, it did not run. With [waitingForAnswer] the
+     * step under way was waiting for his answer and had not run either.
+     */
+    fun stopped(
+        plan: Plan,
+        canonicalName: (PlanStep) -> String,
+        why: String? = null,
+        declinedStepId: String? = null,
+        waitingForAnswer: Boolean = false
+    ): String {
+        val lines = PlanApprovalSummary.stepLines(plan)
+        val ran = mutableListOf<String>()
+        val failed = mutableListOf<String>()
+        val interrupted = mutableListOf<String>()
+        val notRun = mutableListOf<String>()
+        plan.steps.forEachIndexed { index, step ->
+            val canonical = canonicalName(step)
+            if (isTalkAction(canonical) || canonical in ASKING_ACTIONS) return@forEachIndexed
+            val label = lines.getOrElse(index) { step.action }
+            when {
+                step.stepId == declinedStepId -> notRun += label
+                step.status == StepStatus.COMPLETED -> ran += label
+                step.status == StepStatus.FAILED -> failed += label
+                step.status == StepStatus.RUNNING && !waitingForAnswer -> interrupted += label
+                else -> notRun += label
+            }
+        }
+        return buildList {
+            add("Stopped" + why?.let { " ($it)" }.orEmpty() + ": ${allSteps(plan)}")
+            add(if (ran.isEmpty()) "Nothing had run yet." else "Already ran: ${ran.joinToString(", ")}")
+            if (failed.isNotEmpty()) add("Failed: ${failed.joinToString(", ")}")
+            interrupted.forEach { add("Interrupted: $it ($MAY_HAVE_RUN)") }
+            if (notRun.isNotEmpty()) add("Not run: ${notRun.joinToString(", ")}")
+        }.joinToString("\n")
+    }
+
+    /**
+     * The trace of a plan that starts without an approval prompt: the steps that will run,
+     * read off the steps themselves, and after them what was asked for, labelled as that.
+     * The goal is the planner's wording of the request, so it is never told as what runs.
+     */
+    fun running(plan: Plan): String {
+        val asked = PlanPrivacy.redactPlan(plan).goal.replace(Regex("""\s+"""), " ").trim()
+        return buildString {
+            append("Running: ").append(PlanApprovalSummary.stepCount(plan))
+            PlanApprovalSummary.stepLines(plan).forEach { append("\n• ").append(it) }
+            if (asked.isNotEmpty()) append("\nAsked: ").append(asked)
+        }
+    }
+
+    /** What is spoken when such a plan starts: the steps, not the planner's goal. */
+    fun runningSpoken(plan: Plan): String = "Running: ${allSteps(plan)}"
+
+    /**
+     * The line under a confirmation question that says which step it guards: the first
+     * step after [confirmStepId] that has not run. Null when there is none, or when the
+     * step asking is not in [plan].
+     */
+    fun nextStepLine(plan: Plan, confirmStepId: String, canonicalName: (PlanStep) -> String): String? {
+        val index = plan.steps.indexOfFirst { it.stepId == confirmStepId }
+        if (index < 0) return null
+        val lines = PlanApprovalSummary.stepLines(plan)
+        val next = plan.steps.withIndex().drop(index + 1).firstOrNull { (_, step) ->
+            step.status == StepStatus.PENDING && !isTalkAction(canonicalName(step)) &&
+                canonicalName(step) !in ASKING_ACTIONS
+        } ?: return null
+        return "Next: ${lines[next.index]}"
+    }
+
+    /**
+     * The step of [plan] that is itself putting a question to the owner: the step
+     * [stepIdInHand], when its action is one of [ASKING_ACTIONS]. Null when the step in
+     * hand is something else. A macro runs steps of its own inside one step of the plan,
+     * and a question from in there belongs to none of the plan's steps: what the plan
+     * says comes after the macro is not what that question guards.
+     */
+    fun askingStep(plan: Plan?, stepIdInHand: String?, canonicalName: (PlanStep) -> String): PlanStep? =
+        plan?.steps?.firstOrNull { it.stepId == stepIdInHand }?.takeIf { canonicalName(it) in ASKING_ACTIONS }
+
+    /**
+     * True when the question the step [asking] puts to the owner may repeat his private
+     * data: the step quotes the result of a step that read some ("You got: $s1. Reply?"),
+     * or of one that names a saved contact. The phone fills such a quote in itself, so
+     * what the planner was told says nothing about what the question holds.
+     *
+     * With no [asking] step the question comes from where the plan cannot see (a macro's
+     * own steps, an action run outside any plan). What it quotes is then not known, and
+     * it is taken to hold some: the row is shown to him as it is either way, and only a
+     * prompt that a host could read gets a placeholder in its place.
+     */
+    fun questionMayHoldPersonalData(
+        plan: Plan?,
+        asking: PlanStep?,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Boolean {
+        if (plan == null || asking == null) return true
+        return asking.stepId in PersonalDataResults.stepIdsHolding(plan.steps, canonicalNames) ||
+            asking.stepId in PersonalDataResults.stepIdsNamingContact(plan.steps, canonicalNames)
+    }
+
+    /**
+     * True when the lines of [plan]'s steps say more than which actions they are: who a
+     * step goes to, a file, an amount. Validation writes numbers from his address book
+     * into a plan, so a row built from such lines holds his private data.
+     */
+    fun stepLinesNameDetails(plan: Plan): Boolean {
+        val bare = plan.copy(steps = plan.steps.map { it.copy(params = emptyMap()) })
+        return PlanApprovalSummary.stepLines(plan) != PlanApprovalSummary.stepLines(bare)
+    }
+
+    /** True when [plan] has a step that takes a secret, such as saving one in the secure store. */
+    fun takesASecret(plan: Plan): Boolean = PlanPrivacy.redactPlan(plan) !== plan
+
+    /**
+     * True when the owner's answer to the step [askStepId] of [plan] is a secret: a later
+     * step puts that answer into a parameter the plan store never keeps.
+     */
+    fun answerIsASecret(plan: Plan, askStepId: String): Boolean {
+        val reference = "$" + askStepId
+        return plan.steps.any { step ->
+            val shown = PlanPrivacy.redactParams(step.action, step.params)
+            step.params.any { (name, value) -> value.contains(reference) && shown[name] != value }
+        }
+    }
+
+    /**
+     * Why a step failed, fit to show and to speak, or null when the step's error says
+     * nothing a person can use. Guidance the handler wrote for him is kept whole. A
+     * sentence a handler wrote is kept. Text from inside the machine (an exception, a
+     * missing parameter, a stack frame) is replaced by the plain reason it stands for
+     * where one is known, and left out otherwise. Keys and tokens never pass.
+     */
+    fun reason(error: String?): String? {
+        val text = error?.let(CrashLogRedactor::redact)?.replace(Regex("""\s+"""), " ")?.trim().orEmpty()
+        if (text.isEmpty()) return null
+        BOTH_TRIES.matchEntire(text)?.let { tries ->
+            return reason(tries.groupValues[1]) ?: reason(tries.groupValues[2])
+        }
+        PLAIN_REASONS.firstOrNull { (pattern, _) -> pattern.containsMatchIn(text) }?.let { return it.second }
+        // An exception is never shown, even when its text happens to hold a word like "check".
+        if (FROM_THE_MACHINE.containsMatchIn(text)) return null
+        if (isUserFacingStepError(text)) return short(text)
+        if (TECHNICAL.containsMatchIn(text)) return null
+        return short(text)
+    }
+
+    private fun short(text: String): String =
+        if (text.length > MAX_REASON_CHARS) text.take(MAX_REASON_CHARS).trimEnd() + "…" else text
+
+    /** The error the plan loop writes when a step and its fallback both failed. */
+    private val BOTH_TRIES = Regex("""Primary failed: (.*)\. Fallback failed: (.*)""")
+
+    /**
+     * Machine text that stands for a reason a person can use. Only an error that names
+     * its cause is given one. A bare IOException is not: it is thrown for a full disk
+     * and a missing file as well as for a dead network, so it says "failed" and no more.
+     */
+    private val PLAIN_REASONS: List<Pair<Regex, String>> = listOf(
+        Regex("""SecurityException|Permission Denial""") to "A permission is missing.",
+        Regex("""ActivityNotFound""") to "No app on the phone can do that.",
+        Regex("""UnknownHost|Unable to resolve host|ConnectException|NoRouteToHost|Network is unreachable""") to
+            "There was no connection.",
+        Regex("""SocketTimeout""") to "The connection timed out.",
+        Regex("""is not registered in ActionDispatcher""") to "The phone has no such action."
+    )
+
+    /** Marks of an exception or a stack frame. */
+    private val FROM_THE_MACHINE = Regex(
+        """Exception|Throwable|\b(?:java|javax|kotlin|kotlinx|android|androidx|com|org)\.[a-z]+\.|\bat [\w$.]+\(|""" +
+            """null object reference|0x[0-9a-fA-F]{2,}"""
+    )
+
+    /** Softer marks of text that was not written for a person: a missing parameter, a status code, a placeholder. */
+    private val TECHNICAL = Regex(
+        """\bnull\b|\bparam(?:eter)?s?\b|\berrno\b|[{}\[\]]|\bHTTP \d{3}\b|\bCode \d{3}\b|""" +
+            """Unknown (?:execution )?error|Execution failed""",
+        RegexOption.IGNORE_CASE
+    )
+
+    private fun isBlocked(error: String?): Boolean = error?.startsWith("Skipped: depends on failed step") == true
+
+    /** A handler's own result, or null when it reported nothing a person could read. */
+    private fun ownResult(result: String?): String? =
+        result?.trim()?.takeIf { it.length > 5 && !it.startsWith("{") && it != NO_OWN_RESULT }
+
+    private fun allSteps(plan: Plan): String = PlanApprovalSummary.stepLines(plan).joinToString(", ")
+
+    /** What a talk step said, however short: a one-word answer is still the planner's answer. */
+    private fun talkWords(result: String?): String? =
+        result?.trim()?.takeIf { it.isNotEmpty() && !it.startsWith("{") && it != NO_OWN_RESULT }
+
+    /** A step line as it reads after a label: "Send SMS to Mom" becomes "send SMS to Mom". */
+    private fun inSentence(line: String): String {
+        val first = line.takeWhile { !it.isWhitespace() }
+        val acronym = first.length > 1 && first.all { it.isUpperCase() || it.isDigit() }
+        return if (acronym) line else line.replaceFirstChar { it.lowercase() }
+    }
+}
