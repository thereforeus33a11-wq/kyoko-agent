+        personaMemory.dropLeftBehind(2_000)
+        assertTrue(personaMemory.leftBehind(0).isEmpty())
+        // Nothing is left of them in the store.
+        assertTrue(memoryRepository.getMemoriesByKeyPrefix("yume.meta.left").isEmpty())
+        // Emptying her notebook is about her notes; dropping nothing is no error.
