+package com.opendroid.ai.ui.viewmodel
+
+import android.os.Looper
+import com.opendroid.ai.core.life.reading.HerFeeds
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * Her feeds in the own-life card: a YouTube channel found from the address he pastes,
+ * fetched once and only from YouTube; and her own feeds, which he can take off.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class OwnLifeViewModelTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val channel = "UCabcdefghijklmnopqrstuv"
+    private val fetched = CopyOnWriteArrayList<String>()
+    private var pageText: String? = """<html><head><link rel="canonical" href="https://www.youtube.com/channel/$channel">""" +
+        """<meta property="og:title" content="Gyaru TV &amp; friends"><title>Gyaru TV - YouTube</title></head></html>"""
+    private val page: suspend (String) -> String? = { url -> fetched += url; pageText }
+
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Test
+    fun `a channel is found from its handle page or its channel address, and only YouTube is fetched`() = runBlocking {
+        // An @handle address: the page is fetched once and the id and name read off it.
+        assertEquals(FoundChannel(channel, "Gyaru TV & friends"), findChannel("youtube.com/@gyarutv", page))
+        assertEquals(listOf("https://youtube.com/@gyarutv"), fetched.toList())
+        // A channel address holds the id itself; without a page it is still found, under a plain name.
+        pageText = null
+        assertEquals(FoundChannel(channel, "YouTube channel"), findChannel("https://www.youtube.com/channel/$channel", page))
+        // A handle whose page cannot be had, an address that is no YouTube address, and nothing at all: no channel, and no other site is fetched.
+        assertNull(findChannel("https://www.youtube.com/@gone", page))
+        val before = fetched.size
+        assertNull(findChannel("https://example.com/@gyarutv", page))
+        assertNull(findChannel("http://www.youtube.com/@plain", page))
+        assertNull(findChannel("   ", page))
+        assertEquals(before, fetched.size)
+        // The page title stands in when there is no og:title.
+        assertEquals("Gyaru TV", channelNameInPage("<title>Gyaru TV - YouTube</title>"))
+    }
+
+    @Test
+    fun `the model adds what it found through his settings, says so, and takes her own feed off`() {
+        val herFeeds = HerFeeds { File(folder.root, "her_feeds.json") }
+        herFeeds.follow("https://example.org/feed.xml", "Example")
+        val model = OwnLifeViewModel(herFeeds, page)
+        model.loadFollowed()
+        await("her feeds to be read") { model.followed.size == 1 }
+
+        val added = CopyOnWriteArrayList<FoundChannel>()
+        model.addChannel("youtube.com/@gyarutv") { added += it; true }
+        await("the channel to be found") { model.feedStatus.isNotEmpty() && !model.finding }
+        assertEquals(listOf(FoundChannel(channel, "Gyaru TV & friends")), added.toList())
+        assertEquals("\"Gyaru TV & friends\" is among her feeds now: she sees its new videos as headlines.", model.feedStatus)
+
+        pageText = null
+        model.addChannel("youtube.com/@gone") { error("nothing is added") }
+        await("the address to be refused") { model.feedStatus == OwnLifeViewModel.CHANNEL_NOT_FOUND }
+
+        model.unfollow(model.followed.single())
+        await("her feed to be taken off") { model.followed.isEmpty() }
+        assertEquals("\"Example\" is off her feeds.", model.feedStatus)
+        assertTrue(herFeeds.followed().isEmpty())
+    }
+}
