+package com.opendroid.ai.core.service
+
+import android.app.Notification
+import android.content.Context
+import androidx.core.app.NotificationCompat
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * A notification's text is handed to the lock screen and to every app with notification
+ * access. Unless the owner asked for her words there, none of them may be in it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class CheckInNotificationTest {
+
+    private val context: Context = ApplicationProvider.getApplicationContext()
+    private val line = "the bees swarmed again. you said you would move the hive"
+
+    private val name = "Yume"
+
+    private fun build(showText: Boolean) =
+        CheckInNotification.build(context, "persona_checkin_channel", name, line, showText, open = null)
+
+    @Test
+    fun `by default it only says that she wrote`() {
+        val notification = build(showText = false)
+
+        assertEquals("Yume wrote to you", notification.extras.getCharSequence(Notification.EXTRA_TITLE).toString())
+        assertNull(notification.extras.getCharSequence(Notification.EXTRA_TEXT))
+        assertNull(notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT))
+        assertNull(notification.tickerText)
+        assertNull(notification.publicVersion)
+        assertEquals(NotificationCompat.VISIBILITY_PRIVATE, notification.visibility)
+        // No field of any kind carries a word of her line.
+        for (key in notification.extras.keySet()) {
+            @Suppress("DEPRECATION")
+            val value = notification.extras.get(key)?.toString().orEmpty()
+            assertFalse("$key carries her line", value.contains("bees") || value.contains("hive"))
+        }
+    }
+
+    @Test
+    fun `her words are shown when the owner switched that on`() {
+        val notification = build(showText = true)
+
+        assertEquals(name, notification.extras.getCharSequence(Notification.EXTRA_TITLE).toString())
+        assertEquals(line, notification.extras.getCharSequence(Notification.EXTRA_TEXT).toString())
+        assertEquals(line, notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT).toString())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt b/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt
new file mode 100644
index 0000000..48cbeac
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt
@@ -0,0 +1,102 @@
+package com.opendroid.ai.core.util
+
+import com.opendroid.ai.di.AppModule
+import java.net.InetAddress
+import java.net.UnknownServiceException
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.Dns
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.Request
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The platform no longer blocks plain http, so the app's own HTTP client has to: only
+ * the owner's own hardware is spoken to without TLS.
+ */
+class CleartextGuardTest {
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+
+    // Every name resolves to this machine, so a "public" host can be asked for without
+    // leaving it. The guard judges the name as written, never what it resolves to.
+    private val everythingIsLocal = Dns { listOf(InetAddress.getByName("127.0.0.1")) }
+    private val client = AppModule.provideOkHttpClient().newBuilder().dns(everythingIsLocal).build()
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    @Test
+    fun `the guard is on the shared client, for requests and for redirects`() {
+        val shared = AppModule.provideOkHttpClient()
+        assertTrue(shared.interceptors.contains(CleartextGuard))
+        assertTrue(shared.networkInterceptors.contains(CleartextGuard))
+    }
+
+    @Test
+    fun `plain http is allowed to the phone itself and to private addresses only`() {
+        for (own in listOf(
+            "http://127.0.0.1:11434/v1", "http://localhost:8080", "http://10.0.2.2:11434", "http://192.168.1.50:11434/v1",
+            "http://172.16.0.9", "http://100.100.1.1:8080", "http://gaming-pc:1234/v1", "http://pc.lan/v1",
+            "http://nas.home.arpa", "http://box.tailnet-abc.ts.net", "http://[::1]:8080/v1", "http://[fd12:3456::1]:8080"
+        )) {
+            assertTrue(own, CleartextGuard.allows(own.toHttpUrl()))
+        }
+        for (public in listOf(
+            "http://api.venice.ai/api/v1", "http://example.com", "http://8.8.8.8", "http://172.32.0.1",
+            "http://192.169.1.1", "http://100.63.0.1", "http://[2001:db8::1]/v1", "http://api.openai.com/v1/models"
+        )) {
+            assertFalse(public, CleartextGuard.allows(public.toHttpUrl()))
+        }
+    }
+
+    @Test
+    fun `https is allowed anywhere`() {
+        assertTrue(CleartextGuard.allows("https://api.venice.ai/api/v1".toHttpUrl()))
+        assertTrue(CleartextGuard.allows("https://example.com".toHttpUrl()))
+    }
+
+    @Test
+    fun `the shared client reaches a local server over plain http`() {
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+
+        client.newCall(Request.Builder().url(server.url("/v1/models")).build()).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+    }
+
+    @Test
+    fun `the shared client refuses plain http to a public host before connecting`() {
+        val request = Request.Builder()
+            .url("http://api.example.com:${server.port}/v1/models")
+            .header("Authorization", "Bearer sk-test-0123456789abcdef")
+            .build()
+
+        val failure = assertThrows(UnknownServiceException::class.java) { client.newCall(request).execute() }
+
+        assertEquals("nothing may be sent, the key least of all", 0, server.requestCount)
+        assertFalse("the address stays out of the message", failure.message.orEmpty().contains("example"))
+    }
+
+    @Test
+    fun `a redirect to plain http on a public host is not followed`() {
+        server.enqueue(
+            MockResponse.Builder().code(302)
+                .setHeader("Location", "http://elsewhere.example.com:${server.port}/collect")
+                .build()
+        )
+        server.enqueue(MockResponse.Builder().code(200).body("should never be asked for").build())
+
+        assertThrows(UnknownServiceException::class.java) {
+            client.newCall(Request.Builder().url(server.url("/v1/models")).build()).execute()
+        }
+        assertEquals("only the first request was written", 1, server.requestCount)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/PreferredRecognizerTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/PreferredRecognizerTest.kt
new file mode 100644
index 0000000..a540f1c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/PreferredRecognizerTest.kt
@@ -0,0 +1,409 @@
+package com.opendroid.ai.core.voice
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Bundle
+import android.os.Looper
+import android.speech.RecognitionService
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import androidx.test.core.app.ApplicationProvider
+import java.util.concurrent.TimeUnit
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowSpeechRecognizer
+
+/**
+ * Speech is recognised on the phone itself where the phone can do it, the default
+ * recogniser is asked to work offline where it cannot, and when that cannot be had either
+ * voice input goes on as it did before there was a choice.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class PreferredRecognizerTest {
+
+    private val context: Context = ApplicationProvider.getApplicationContext()
+
+    // What each engine asked for (allowOnDevice) and what it was given, in order.
+    private val asked = mutableListOf<Boolean>()
+    private val given = mutableListOf<SpeechRecognizer>()
+
+    @After
+    fun tearDown() {
+        ShadowSpeechRecognizer.reset()
+    }
+
+    /** Stands in for the phone: hands out a recogniser and says whether it is the on-device one. */
+    private fun phone(hasOnDevice: Boolean): (Context, Boolean) -> PreferredRecognizer.Handle? = { ctx, allowOnDevice ->
+        asked += allowOnDevice
+        val recognizer = SpeechRecognizer.createSpeechRecognizer(ctx)
+        given += recognizer
+        PreferredRecognizer.Handle(recognizer, onDevice = allowOnDevice && hasOnDevice)
+    }
+
+    private fun installDefaultRecognitionService() {
+        val service = ComponentName("com.example.speech", "com.example.speech.Recognizer")
+        shadowOf(context.packageManager).addServiceIfNotPresent(service)
+        shadowOf(context.packageManager).addIntentFilterForService(service, IntentFilter(RecognitionService.SERVICE_INTERFACE))
+    }
+
+    private fun idle() = shadowOf(Looper.getMainLooper()).idle()
+
+    private fun heard(vararg text: String) = Bundle().apply {
+        putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf(*text))
+    }
+
+    // ── Which recogniser ─────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the on-device recogniser is used when the phone has one`() {
+        installDefaultRecognitionService()
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+
+        assertTrue(PreferredRecognizer.isOnDeviceAvailable(context))
+        val handle = PreferredRecognizer.create(context)
+        assertNotNull(handle)
+        assertTrue(handle!!.onDevice)
+    }
+
+    @Test
+    fun `without one the default recogniser is used, and none at all gives null`() {
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(false)
+        assertNull("no recognition service on the phone", PreferredRecognizer.create(context))
+
+        installDefaultRecognitionService()
+        val handle = PreferredRecognizer.create(context)
+        assertNotNull(handle)
+        assertFalse(handle!!.onDevice)
+    }
+
+    @Test
+    fun `the default recogniser is used when the on-device one is ruled out`() {
+        installDefaultRecognitionService()
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+
+        assertFalse(PreferredRecognizer.create(context, allowOnDevice = false)!!.onDevice)
+    }
+
+    @Test
+    @Config(sdk = [30])
+    fun `before Android 12 there is no on-device recogniser to ask for`() {
+        installDefaultRecognitionService()
+
+        assertFalse(PreferredRecognizer.isOnDeviceAvailable(context))
+        assertFalse(PreferredRecognizer.create(context)!!.onDevice)
+    }
+
+    @Test
+    fun `the offline request is the platform's own extra`() {
+        val intent = PreferredRecognizer.preferOffline(Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH))
+        assertTrue(intent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+    }
+
+    @Test
+    fun `only the two language errors count as a missing language`() {
+        assertTrue(PreferredRecognizer.isLanguageFailure(12))
+        assertTrue(PreferredRecognizer.isLanguageFailure(13))
+        for (other in listOf(
+            SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_NO_MATCH, SpeechRecognizer.ERROR_SPEECH_TIMEOUT,
+            SpeechRecognizer.ERROR_RECOGNIZER_BUSY, SpeechRecognizer.ERROR_SERVER, 0, 14
+        )) {
+            assertFalse("$other", PreferredRecognizer.isLanguageFailure(other))
+        }
+    }
+
+    // ── The order of choices ─────────────────────────────────────────────────────────
+
+    @Test
+    fun `the on-device recogniser is not asked for offline work and the default one is`() {
+        val choice = PreferredRecognizer.Choice()
+        assertTrue(choice.allowOnDevice)
+        assertFalse("it never leaves the phone, so there is nothing to ask", choice.asksOffline(onDevice = true))
+        assertTrue(choice.asksOffline(onDevice = false))
+    }
+
+    @Test
+    fun `each choice is given up once, in order, and only for the error that rules it out`() {
+        val choice = PreferredRecognizer.Choice()
+
+        // The on-device recogniser is kept through every error but a missing language.
+        for (error in listOf(SpeechRecognizer.ERROR_NO_MATCH, SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_SERVER)) {
+            assertFalse("$error", choice.onError(onDevice = true, error = error))
+        }
+        assertTrue(choice.allowOnDevice)
+        assertTrue(choice.onError(onDevice = true, error = 13))
+        assertFalse(choice.allowOnDevice)
+        assertTrue("the default recogniser is still asked to work offline", choice.asksOffline(onDevice = false))
+
+        // The default recogniser without the language on the phone: asked again without the request.
+        assertFalse(choice.onError(onDevice = false, error = SpeechRecognizer.ERROR_NO_MATCH))
+        assertTrue(choice.asksOffline(onDevice = false))
+        assertTrue(choice.onError(onDevice = false, error = 12))
+        assertFalse(choice.asksOffline(onDevice = false))
+
+        // Nothing is left to give up: the same error is now an ordinary one.
+        assertFalse(choice.onError(onDevice = false, error = 12))
+        assertFalse(choice.onError(onDevice = false, error = 13))
+    }
+
+    @Test
+    fun `a network or server error to an offline request is reported and ends the asking`() {
+        for (error in listOf(SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_NETWORK_TIMEOUT, SpeechRecognizer.ERROR_SERVER)) {
+            val choice = PreferredRecognizer.Choice()
+            assertFalse("$error is still reported, not swallowed", choice.onError(onDevice = false, error = error))
+            assertFalse("$error", choice.asksOffline(onDevice = false))
+            assertTrue("the on-device recogniser is not given up over it", choice.allowOnDevice)
+        }
+        for (error in listOf(
+            SpeechRecognizer.ERROR_NO_MATCH, SpeechRecognizer.ERROR_SPEECH_TIMEOUT, SpeechRecognizer.ERROR_AUDIO,
+            SpeechRecognizer.ERROR_CLIENT, SpeechRecognizer.ERROR_RECOGNIZER_BUSY, SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS
+        )) {
+            val choice = PreferredRecognizer.Choice()
+            assertFalse(choice.onError(onDevice = false, error = error))
+            assertTrue("$error says nothing about offline work", choice.asksOffline(onDevice = false))
+        }
+    }
+
+    // ── Voice input ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `voice input uses the on-device recogniser, which needs no asking`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = true))
+        val results = mutableListOf<String>()
+
+        engine.startListening(onResult = { results += it }, onError = { })
+        idle()
+
+        assertEquals(listOf(true), asked)
+        val intent = shadowOf(given.single()).lastRecognizerIntent
+        assertFalse(intent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        // What was asked for before is still asked for.
+        assertEquals(RecognizerIntent.LANGUAGE_MODEL_FREE_FORM, intent.getStringExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL))
+        assertTrue(intent.getBooleanExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false))
+        assertEquals(3, intent.getIntExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 0))
+
+        shadowOf(given.single()).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+    }
+
+    @Test
+    fun `without an on-device recogniser voice input asks the default one to work offline`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = false))
+        val results = mutableListOf<String>()
+
+        engine.startListening(onResult = { results += it }, onError = { })
+        idle()
+
+        val intent = shadowOf(given.single()).lastRecognizerIntent
+        assertTrue(intent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        assertEquals(3, intent.getIntExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 0))
+
+        shadowOf(given.single()).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+    }
+
+    @Test
+    fun `when the on-device recogniser lacks the language voice input goes on with the default one`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = true))
+        val results = mutableListOf<String>()
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { results += it }, onError = { errors += it })
+        idle()
+        shadowOf(given[0]).triggerOnError(13)
+        idle()
+
+        assertEquals("the second recogniser is the default one", listOf(true, false), asked)
+        assertTrue(shadowOf(given[0]).isDestroyed)
+        assertTrue("the switch is not reported as an error", errors.isEmpty())
+        assertTrue(shadowOf(given[1]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+
+        shadowOf(given[1]).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+    }
+
+    @Test
+    fun `when the default recogniser cannot work offline voice input goes on as it did before`() {
+        // A phone with no on-device recogniser and no speech pack for its language.
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = false))
+        val results = mutableListOf<String>()
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { results += it }, onError = { errors += it })
+        idle()
+        assertTrue(shadowOf(given[0]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        shadowOf(given[0]).triggerOnError(13)
+        idle()
+
+        assertTrue("giving up the offline request is not reported as an error", errors.isEmpty())
+        assertEquals(2, given.size)
+        val again = shadowOf(given[1]).lastRecognizerIntent
+        assertFalse("the second request does not ask for offline work", again.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertEquals(3, again.getIntExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 0))
+
+        shadowOf(given[1]).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+
+        // It stays that way for the next thing he says.
+        engine.startListening(onResult = { results += it }, onError = { errors += it })
+        idle()
+        assertFalse(shadowOf(given[1]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+
+        // With nothing left to give up, a missing language is an ordinary error.
+        shadowOf(given[1]).triggerOnError(13)
+        assertEquals(2, given.size)
+        assertEquals(listOf("Unknown error (13)"), errors)
+    }
+
+    @Test
+    fun `both steps are taken in turn on a phone whose own recogniser lacks the language and that has no speech pack`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = true))
+        val results = mutableListOf<String>()
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { results += it }, onError = { errors += it })
+        idle()
+        shadowOf(given[0]).triggerOnError(12)
+        idle()
+        shadowOf(given[1]).triggerOnError(13)
+        idle()
+
+        assertEquals(listOf(true, false, false), asked)
+        assertTrue(errors.isEmpty())
+        assertFalse(shadowOf(given[0]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertTrue(shadowOf(given[1]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        assertFalse(shadowOf(given[2]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+
+        shadowOf(given[2]).triggerOnResults(heard("open maps"))
+        assertEquals(listOf("open maps"), results)
+    }
+
+    @Test
+    fun `a network error to an offline request is reported, and the next request does not ask`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = false))
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        shadowOf(given.single()).triggerOnError(SpeechRecognizer.ERROR_NETWORK)
+
+        assertEquals(listOf("Network error"), errors)
+        assertEquals("the recogniser is kept", 1, given.size)
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        assertFalse(shadowOf(given.single()).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+    }
+
+    @Test
+    fun `any other error is reported as before and the recogniser is kept`() {
+        val engine = SpeechRecognitionEngine(context, phone(hasOnDevice = true))
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+        idle()
+        shadowOf(given.single()).triggerOnError(SpeechRecognizer.ERROR_NO_MATCH)
+
+        assertEquals(listOf("No speech match found"), errors)
+        assertEquals(1, given.size)
+    }
+
+    @Test
+    fun `a phone that cannot recognise speech still says so`() {
+        val engine = SpeechRecognitionEngine(context) { _, _ -> null }
+        val errors = mutableListOf<String>()
+
+        engine.startListening(onResult = { }, onError = { errors += it })
+
+        assertEquals(listOf("Speech recognition not available on this device"), errors)
+    }
+
+    // ── Wake word ────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the wake word listener uses the phone's own recogniser, which needs no asking`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = true))
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+
+        assertEquals(listOf(true), asked)
+        assertFalse(shadowOf(given.single()).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        assertTrue(shadowOf(given.single()).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false))
+
+        shadowOf(given.single()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+        detector.destroy()
+    }
+
+    @Test
+    fun `without an on-device recogniser the wake word listener asks the default one to work offline`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = false))
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+
+        assertTrue(shadowOf(given.single()).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+
+        shadowOf(given.single()).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+        detector.destroy()
+    }
+
+    @Test
+    fun `the wake word listener goes on with the default recogniser when the on-device one lacks the language`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = true))
+
+        detector.startListening { }
+        idle()
+        shadowOf(given[0]).triggerOnError(12)
+        // It restarts a second after an error.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+
+        assertEquals(listOf(true, false), asked)
+        assertTrue(shadowOf(given[1]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+
+        // Any other error restarts with the same choice.
+        shadowOf(given[1]).triggerOnError(SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        assertEquals(listOf(true, false, false), asked)
+        assertTrue(shadowOf(given[2]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        detector.destroy()
+    }
+
+    @Test
+    fun `the wake word listener keeps hearing on a phone whose default recogniser cannot work offline`() {
+        val detector = WakeWordDetector(context, phone(hasOnDevice = false))
+        var woken = 0
+
+        detector.startListening { woken++ }
+        idle()
+        assertTrue(shadowOf(given[0]).lastRecognizerIntent.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        shadowOf(given[0]).triggerOnError(13)
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+
+        // The next round asks the same recogniser without the offline request, and hears.
+        assertEquals(2, given.size)
+        assertFalse(shadowOf(given[1]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        shadowOf(given[1]).triggerOnResults(heard(WakeWordMatcher.STOCK_PHRASES.first()))
+        assertEquals(1, woken)
+
+        // And every round after it.
+        shadowOf(Looper.getMainLooper()).idleFor(1100, TimeUnit.MILLISECONDS)
+        assertFalse(shadowOf(given[2]).lastRecognizerIntent.hasExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE))
+        detector.destroy()
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/SpeechTextNormalizerTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/SpeechTextNormalizerTest.kt
new file mode 100644
