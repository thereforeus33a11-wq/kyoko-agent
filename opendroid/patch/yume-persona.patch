@@ -0,0 +1,265 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.repository.SessionMessage
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * Which chat rows her notebook pass reads, and when one is due.
+ *
+ * The pass reads by time, not by chat and not by a number of rows: everything that was
+ * written after the last pass, in whatever chat, oldest first. A page of it has a fixed
+ * room. What does not fit stays unread and is on the next page, so a long talk, a run of
+ * phone commands between two things he said, a change of chat or a pass that failed a
+ * few times costs her nothing he told her. The time that is kept after a pass is that of
+ * the newest row the page held, and never that of a row the pass did not get.
+ */
+internal object PersonaNotebookTalk {
+
+    /** How many stored rows one look at the chats reads. A look that comes back full means more are waiting. */
+    const val ROWS_PER_LOOK = 400
+
+    /**
+     * How many characters of talk one pass is given to read. With the few turns shown
+     * for context it comes to what a pass was given before pages: a small model that
+     * could take a pass then can take one now.
+     */
+    const val TALK_BUDGET_CHARS = 8_000
+
+    /**
+     * The longest one stored row may be on the page. A longer one is shortened and ends
+     * in [PersonaPrompts.CUT_MARK], so that it is never taken for the whole message.
+     */
+    const val ROW_MAX_CHARS = 3_000
+
+    // What a row costs beside its text: who said it, and the line break.
+    private const val ROW_OVERHEAD = 8
+
+    /**
+     * How many rows before the unread ones are read, how many turns of them are shown so
+     * that the talk makes sense, and how long each of those rows may be. She has read
+     * them before: they are there to be leaned on, not to be read again in full.
+     */
+    const val CONTEXT_ROWS = 12
+    const val CONTEXT_TURNS = 4
+    const val CONTEXT_ROW_MAX_CHARS = 400
+
+    /** Put in front of the first line of a chat other than the one the page began in. */
+    const val NEW_CHAT_LABEL = "(another chat from here on) "
+
+    /** Put in front of a command she gave the phone herself, where the pass reads it as a line of hers. */
+    const val DID_LABEL = "(what i did on the phone myself) "
+
+    /** Put in front of a picture she made of herself, where the pass reads it as a line of hers. */
+    const val MADE_LABEL = "(a picture i made of myself) "
+
+    /** Her own command as its row in the chat has it ([PersonaActions.commandRecord]). */
+    private val OWN_COMMAND = Regex("""^[^\n]{1,60}'s own command: "(.+)"$""")
+
+    /**
+     * [message] as a line of hers, when it is a row of the app's that says what she did
+     * herself: a command she gave the phone ([PersonaActions.COMMAND_BADGE]), or a
+     * picture she made of herself. Null for every other row. Only her own words go into
+     * it: her command as she wrote it, the caption she gave the picture. A command whose
+     * words may be someone else's has another badge and is not hers to learn from.
+     *
+     * With [commands] false only her pictures are: where a host could read the pass, a
+     * command of hers can name someone in his contacts, and it stays out.
+     */
+    internal fun asHerOwnAct(message: ChatMessage, commands: Boolean = true): ChatMessage? {
+        if (message.sender == ChatMessage.Sender.USER) return null
+        val text = if (message.modelBadge == PersonaActions.COMMAND_BADGE) {
+            if (!commands) return null
+            OWN_COMMAND.find(message.text.trim())?.groupValues?.get(1)?.trim()?.takeIf { it.isNotEmpty() }?.let { DID_LABEL + it }
+        } else {
+            PersonaSelfPictures.madePictureCaptions(message.text).takeIf { it.isNotEmpty() }?.joinToString("; ")?.let { MADE_LABEL + it }
+        } ?: return null
+        return message.copy(text = text, modelBadge = PersonaPrompts.BADGE)
+    }
+
+    /** Stands for the text of a row of the app's in what is kept of a deleted chat: its words are not kept. */
+    const val APP_ROW_STUB = "-"
+
+    /**
+     * True for a row the pass can read as talk: one of his, or one of hers that is not
+     * her line about a result. That line repeats what the phone read out or did, in her
+     * words, and none of it is something he told her.
+     */
+    fun isTalk(message: ChatMessage): Boolean =
+        message.text.isNotBlank() && (
+            message.sender == ChatMessage.Sender.USER ||
+                (PersonaPrompts.isHers(message) && !PersonaPrompts.isResultLine(message))
+            )
+
+    /** How many replies of hers [rows] hold, counted chat by chat. */
+    fun replies(rows: List<SessionMessage>): Int =
+        rows.groupBy({ it.sessionId }, { it.message }).values.sumOf { PersonaEngine.repliesSince(it, Long.MIN_VALUE) }
+
+    /**
+     * Whether a pass is due over [rows], everything that is unread: enough replies of
+     * hers are among them, or so many rows are waiting that one look could not hold more.
+     */
+    fun isDue(rows: List<SessionMessage>): Boolean =
+        replies(rows) >= PersonaEngine.REPLIES_PER_REFLECTION || rows.size >= ROWS_PER_LOOK
+
+    /**
+     * One page of unread rows. [rows] are in the order they were written; [readUpTo] is
+     * the time of the newest of them, which is what a pass over this page has read; and
+     * [more] says that unread rows are left for the next page.
+     */
+    class Page(val rows: List<SessionMessage>, val readUpTo: Long, val more: Boolean) {
+        /** The rows chat by chat, in the order each chat first appears. */
+        val chats: List<List<ChatMessage>>
+            get() = rows.groupBy({ it.sessionId }, { it.message }).values.toList()
+
+        /** What the two of them said on this page, row by row and as it was stored, without any label. */
+        val said: List<String> get() = rows.filter { isTalk(it.message) }.map { it.message.text }
+
+        /** The chat the page begins in, and the time of its first row. */
+        val firstChat: String? get() = rows.firstOrNull()?.sessionId
+        val startsAt: Long get() = rows.firstOrNull()?.message?.timestamp ?: 0L
+    }
+
+    /**
+     * [rows], which can be of several chats, with every line of hers about a marked
+     * result under the badge of such a line. One that was stored before those lines had
+     * a badge of their own carries her plain badge and is told by the exact row it stands
+     * behind in its chat ([PersonaPrompts.repeatsPrivateResult]). Given its badge it is
+     * no talk here either, and is held back with the row it repeats wherever that row
+     * is, also once the words of the app's rows are no longer kept.
+     */
+    fun withResultLinesMarked(rows: List<SessionMessage>): List<SessionMessage> {
+        val lastInChat = HashMap<String, ChatMessage>()
+        return rows.map { row ->
+            val before = lastInChat.put(row.sessionId, row.message)
+            val unbadged = row.message.modelBadge == PersonaPrompts.BADGE &&
+                PersonaPrompts.repeatsPrivateResult(row.message, before)
+            if (unbadged) {
+                row.copy(message = row.message.copy(modelBadge = PersonaPrompts.resultBadge(staysPrivate = true)))
+            } else {
+                row
+            }
+        }
+    }
+
+    /** [message] with at most [maxChars] characters of text, marked as cut when it had more. */
+    fun cut(message: ChatMessage, maxChars: Int = ROW_MAX_CHARS): ChatMessage =
+        if (message.text.length <= maxChars) {
+            message
+        } else {
+            message.copy(text = message.text.take(maxChars).trimEnd() + PersonaPrompts.CUT_MARK)
+        }
+
+    /**
+     * The first page of [rows], which are unread and in the order they were written.
+     *
+     * Rows are taken oldest first until the talk among them fills [maxChars]. Rows that
+     * are not talk (the app's own lines) cost nothing and go along, so the time of the
+     * page moves past them. At least one row of talk is always taken, however long, and
+     * rows written in the same millisecond as the last one taken go with it: the mark is
+     * a time, and a row that shares it would otherwise never be read.
+     *
+     * A line of hers about a marked result that was stored under her plain badge is on
+     * the page under the badge of such a line ([withResultLinesMarked]).
+     */
+    fun page(rows: List<SessionMessage>, maxChars: Int = TALK_BUDGET_CHARS): Page {
+        val taken = ArrayList<SessionMessage>()
+        var used = 0
+        var anyTalk = false
+        // Known for what it is before the page is cut, so that it goes along with the row it repeats.
+        for (row in withResultLinesMarked(rows)) {
+            val talk = isTalk(row.message)
+            val cost = if (talk) minOf(row.message.text.length, ROW_MAX_CHARS) + ROW_OVERHEAD else 0
+            val sameMoment = taken.isNotEmpty() && taken.last().message.timestamp == row.message.timestamp
+            if (talk && anyTalk && used + cost > maxChars && !sameMoment) break
+            taken += if (talk) row.copy(message = cut(row.message)) else row
+            used += cost
+            anyTalk = anyTalk || talk
+        }
+        return Page(taken, taken.lastOrNull()?.message?.timestamp ?: 0L, more = taken.size < rows.size)
+    }
+
+    /**
+     * The rows of one chat as her notebook pass reads them: what the two of them said,
+     * labelled the way [PersonaPrompts.shapeHistory] labels it for the notebook, with no
+     * limit on the number of rows (the page has set that already). With [heldBack] what
+     * a host may not read is held back as it is in her chat prompt.
+     *
+     * A chat prompt has to open with a turn of his, so that shaping drops what she said
+     * before he first speaks. Her notebook has no such need, and a page often begins
+     * with a line of hers: one from a moment of her own, or a reply the page before had no
+     * room for. Those lines are kept and stand first.
+     */
+    fun shaped(rows: List<ChatMessage>, heldBack: Boolean): List<ChatMessage> {
+        // Held back once, and here, where every row still stands behind the row it was
+        // stored behind. The shaping below is told not to do it a second time.
+        // What she did herself is read as a line of hers, before anything else looks at the rows.
+        val acts = rows.map { asHerOwnAct(it, commands = !heldBack) ?: it }
+        val held = if (heldBack) PersonaPrompts.withPrivateResultsHeldBack(acts) else acts
+        val firstOfHis = held.indexOfFirst { it.sender == ChatMessage.Sender.USER }.let { if (it < 0) held.size else it }
+        val talk = PersonaPrompts.shapeHistory(
+            held.drop(firstOfHis),
+            holdBackPrivateResults = false,
+            maxDialogueRows = Int.MAX_VALUE,
+            forNotebook = true
+        ).dialogue
+        val opening = held.take(firstOfHis).filter(::isTalk)
+        if (opening.isEmpty()) return talk
+        val said = opening.joinToString("\n") {
+            (if (PersonaPrompts.readOffScreen(it)) PersonaPrompts.SCREEN_REPLY_LABEL else "") + it.text.trim()
+        }
+        return listOf(opening.first().copy(text = said)) + talk
+    }
+
+    /** The day of [atMillis] on the owner's clock, as her notebook is told it. */
+    fun day(atMillis: Long, zone: TimeZone = TimeZone.getDefault()): String =
+        SimpleDateFormat("EEEE, MMMM d, yyyy", Locale.ENGLISH).apply { timeZone = zone }.format(Date(atMillis))
+
+    /** Put in front of the first line that was said on [day]. */
+    fun dayLabel(day: String): String = "(said on $day) "
+
+    /**
+     * The talk of [page] as one list of turns, chat after chat. The first turn of every
+     * day says which day it was said on, because a pass can read today what was said
+     * days ago and "tomorrow" in it is counted from then. A turn that opens another chat
+     * says so: the line before it was not what it answers.
+     */
+    fun dialogue(page: Page, heldBack: Boolean, zone: TimeZone = TimeZone.getDefault()): List<ChatMessage> {
+        val turns = ArrayList<ChatMessage>()
+        var lastDay: String? = null
+        page.chats.forEach { rows ->
+            shaped(rows, heldBack).forEachIndexed { turnIndex, turn ->
+                val day = day(turn.timestamp, zone)
+                // Only where a chat was read before it: the first chat with anything in it opens the talk.
+                val label = (if (turnIndex == 0 && turns.isNotEmpty()) NEW_CHAT_LABEL else "") +
+                    (if (day != lastDay) dayLabel(day) else "")
+                lastDay = day
+                turns += if (label.isEmpty()) turn else turn.copy(text = label + turn.text)
+            }
+        }
+        return turns
+    }
+
+    /**
+     * What is kept of [rows], unread rows that are being deleted with their chat or
+     * behind a message he edits, so that the next pass can still read them: his rows and
+     * hers as they are (a long one shortened), and of every other row only that it stood
+     * there, with its badge and without its words. The app's lines can quote
+     * notifications and screens; nothing of them is kept past the chat, and neither are
+     * the words of her line about a result, which repeats one of them. Empty when the
+     * rows hold no talk at all.
+     */
+    fun toKeep(rows: List<SessionMessage>): List<SessionMessage> {
+        // The words of the app's rows are about to go, and with them the only way to
+        // tell her line about one of them: it is told now, and kept under its badge.
+        val known = withResultLinesMarked(rows)
+        if (known.none { isTalk(it.message) }) return emptyList()
+        return known.map { row ->
+            val bare = row.message.copy(imageBase64 = null, contactPickerData = null)
+            row.copy(message = if (isTalk(bare)) cut(bare) else bare.copy(text = APP_ROW_STUB))
+        }
+    }
+}
