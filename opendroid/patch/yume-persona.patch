+package com.opendroid.ai.core.voice.own
+
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.cmu
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.english
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.fixture
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.table
+import com.opendroid.ai.core.voice.own.MixedPhonemesParityTest.Companion.tsv
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+
+/**
+ * Her English words as her bilingual voice says them, word by word: the port of the
+ * training side's en_phonemize.py against that file's own tests (en_words.tsv,
+ * en_numbers.tsv, both hand-checked against the table's rules) and against how the
+ * reference read every Latin word of her lines, at a sentence's end and inside it.
+ */
+class EnglishPhonemesTest {
+
+    @Test
+    fun `the hand-checked words read by the table's route`() {
+        for (row in tsv("own_voice/mixed/en_words.tsv")) {
+            val (word, route, source, want) = row
+            val r = english.read(word)
+            val got = if (r.route == Lang.EN) r.ipa else r.kana
+            assertEquals(word, listOf(route, source, want), listOf(r.route.code, r.source, got))
+        }
+    }
+
+    @Test
+    fun `every word of her lines reads as the reference read it`() {
+        val words = fixture["words"]!!.jsonObject
+        assertTrue(words.size > 2000)
+        val wrong = ArrayList<String>()
+        for ((word, rows) in words) {
+            for ((k, row) in rows.jsonArray.withIndex()) {
+                val want = row.jsonArray.map { it.jsonPrimitive.content }
+                val r = english.read(word, final = k == 1)
+                val got = listOf(r.route.code, r.source, if (r.route == Lang.EN) r.ipa else r.kana)
+                if (got != want) wrong += "$word (final=${k == 1}): want $want, got $got"
+            }
+        }
+        if (wrong.isNotEmpty()) fail("${wrong.size} readings differ:\n" + wrong.take(20).joinToString("\n"))
+    }
+
+    @Test
+    fun `numbers are spelled as the reference spells them`() {
+        for ((token, want) in tsv("own_voice/mixed/en_numbers.tsv").map { it[0] to it[1] }) {
+            assertEquals(token, want, english.spellNumber(token).joinToString(" "))
+        }
+        for ((token, want) in fixture["numbers"]!!.jsonObject) {
+            assertEquals(token, want.jsonPrimitive.content, english.spellNumber(token).joinToString(" "))
+        }
+    }
+
+    @Test
+    fun `a function word is strong only where it ends the sentence`() {
+        assertEquals("fɹˈʌm", english.read("from", final = true).ipa)
+        assertEquals("fɹʌm", english.read("from").ipa)
+        // Pronouns stay weak.
+        assertEquals("juː", english.read("you", final = true).ipa)
+    }
+
+    @Test
+    fun `plain latin as the reference makes it`() {
+        assertEquals("ok cafe don't", KanaText.plainLatin("ｏｋ café don’t"))
+        // Kana keep their voiced marks.
+        assertEquals("が", KanaText.plainLatin("が"))
+        assertEquals("Pokemon", KanaText.plainLatin("Pokémon"))
+    }
+
+    @Test
+    fun `romaji as the reference reads it`() {
+        assertEquals("きって", Romaji.toHiragana("kitte"))
+        assertEquals("しんじゅく", Romaji.toHiragana("shinjuku"))
+        assertNull(Romaji.toHiragana("crazy"))
+    }
+
+    @Test
+    fun `a held letter is cut back until the word is known`() {
+        assertEquals(WordReading(Lang.EN, "cmu", ipa = english.read("no").ipa), english.read("NOOOO"))
+        assertEquals("sˈoʊ", english.read("sooooo").ipa)
+        assertEquals(Lang.JA, english.read("mmmmm").route)
+    }
+
+    @Test
+    fun `every symbol the table can give is a token of her voice`() {
+        val tokens = BilingualVoice.tokenCodepoints(tsvText("own_voice/mixed/tokens.txt"))
+        val missing = table.symbols() - tokens
+        assertEquals("table symbols without a token: ${missing.map { "U+%04X".format(it) }}", emptySet<Int>(), missing)
+        // ASCII g is another id: the table writes U+0261.
+        assertFalse('g'.code in table.symbols())
+    }
+
+    @Test
+    fun `her Japanese words in the table are Japanese`() {
+        fun japanese(c: Char) = c.code in 0x3040..0x30FF || c.code in 0x4E00..0x9FFF
+        for ((w, kana) in table.jaWords) {
+            assertEquals(w, w.lowercase())
+            assertTrue("$w $kana", kana.isNotEmpty() && kana.all(::japanese))
+        }
+    }
+
+    @Test
+    fun `every ARPAbet entry of the table converts`() {
+        for (p in table.overrides.values) english.arpabetToIpa(p)
+        for (p in table.letters.values) english.arpabetToIpa(p)
+        for (p in table.timeWords.values) english.arpabetToIpa(p)
+    }
+
+    @Test
+    fun `an ARPAbet phone the table lacks is refused, not guessed`() {
+        try {
+            english.arpabetToIpa(listOf("HH", "XX1"))
+            fail("XX1 was read")
+        } catch (e: IllegalArgumentException) {
+            assertTrue(e.message!!.contains("XX1"))
+        }
+    }
+
+    @Test
+    fun `a number longer than the table spells is read digit by digit`() {
+        assertEquals(List(13) { "one" }, english.spellNumber("1111111111111"))
+        assertEquals(List(25) { "nine" }, english.spellNumber("9".repeat(25)))
+    }
+
+    @Test
+    fun `the CMU entries the fixture holds are the dictionary's lines`() {
+        // A sample of words every English line needs, as CmuDict reads them.
+        assertEquals(CmuDict.parseLine("hello HH AH0 L OW1")!!.second, cmu["hello"])
+        assertEquals(listOf("W", "AH2", "T", "EH1", "V", "ER0"), cmu["whatever"])
+    }
+
+    private fun tsvText(name: String): String =
+        javaClass.classLoader!!.getResourceAsStream(name)!!.use { it.readBytes().decodeToString() }
+}
