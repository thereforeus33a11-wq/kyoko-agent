diff --git a/app/src/test/java/com/opendroid/ai/core/llm/PlanningFallbackTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/PlanningFallbackTest.kt
new file mode 100644
index 0000000..2f57475
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/PlanningFallbackTest.kt
@@ -0,0 +1,198 @@
+package com.opendroid.ai.core.llm
+
+import android.content.ContextWrapper
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import com.opendroid.ai.actions.ActionDispatcher
+import com.opendroid.ai.core.agent.DeviceStateProvider
+import com.opendroid.ai.core.agent.IntentClassifier
+import com.opendroid.ai.core.agent.ReEvaluationEngine
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.llm.error.LLMException
+import com.opendroid.ai.core.llm.providers.CustomOpenAIProvider
+import com.opendroid.ai.core.llm.providers.OllamaProvider
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.db.dao.UnknownActionDao
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.di.AppModule
+import java.net.InetAddress
+import java.nio.file.Files
+import javax.inject.Provider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+/**
+ * The planner's answer after a step may be asked of the next configured planner when
+ * the first one's answer holds no plan. An answer that came back empty because the
+ * model spent its length limit before it wrote anything (a model that reasons first)
+ * is such an answer, the same as one that cannot be read.
+ */
+class PlanningFallbackTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    // Two model servers on this machine: the active planner and the fallback he configured.
+    private val ollama = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val compatible = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+
+    @After
+    fun tearDown() {
+        ollama.close()
+        compatible.close()
+    }
+
+    private fun ok(body: String) = MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(body).build()
+
+    // The limit went into reasoning: no content, and the reason says so.
+    private val spentOnReasoning = """{"message":{"role":"assistant","content":""},"done_reason":"length"}"""
+    private val plan = """{"choices":[{"message":{"content":"{\"speech\":\"going on\",\"decision\":\"CONTINUE\"}"},"finish_reason":"stop"}]}"""
+
+    private fun engine(fallbacks: List<String>): ReEvaluationEngine {
+        val settings = newSettingsRepository()
+        runBlocking {
+            settings.updateConfig {
+                it.copy(
+                    routePolicy = RoutePolicy.ANY,
+                    activeProvider = "Ollama",
+                    selectedModels = mapOf("Ollama" to "qwen3:8b", custom to "local-model"),
+                    ollamaUrl = "http://127.0.0.1:${ollama.port}",
+                    customEndpoints = mapOf(custom to "http://127.0.0.1:${compatible.port}/v1"),
+                    fallbackProviders = fallbacks
+                )
+            }
+        }
+        val client = AppModule.provideOkHttpClient()
+        val factory = LLMProviderFactory(
+            claudeProvider = unused("Claude"),
+            openAIProvider = unused("OpenAI"),
+            geminiProvider = unused("Gemini"),
+            mistralProvider = unused("Mistral"),
+            groqProvider = unused("Groq"),
+            ollamaProvider = Provider { OllamaProvider(client, settings) },
+            openRouterProvider = unused("OpenRouter"),
+            togetherAIProvider = unused("Together"),
+            cohereProvider = unused("Cohere"),
+            deepSeekProvider = unused("DeepSeek"),
+            copilotProvider = unused("Copilot"),
+            opencodeGoProvider = unused("Opencode-Go"),
+            customOpenAIProvider = Provider { CustomOpenAIProvider(client, settings) },
+            gemmaProvider = unused("Gemma"),
+            liteRTLMProvider = unused("LiteRT-LM"),
+            hybridOnDeviceProvider = unused("Hybrid"),
+            settingsRepository = settings,
+            onDeviceLatencyTracker = OnDeviceLatencyTracker(settings),
+            actionDispatcher = dagger.Lazy<ActionDispatcher> { throw AssertionError("unused") },
+            intentClassifier = dagger.Lazy<IntentClassifier> { throw AssertionError("unused") },
+            // Only used to rewrite planning prompts, which this test never sends.
+            deviceStateProvider = DeviceStateProvider(ContextWrapper(null))
+        )
+        return ReEvaluationEngine(
+            llmProviderFactory = factory,
+            // A plan without steps names no action to look up and stores none.
+            actionDispatcher = dagger.Lazy<ActionDispatcher> { throw AssertionError("unused") },
+            unknownActionDao = dagger.Lazy<UnknownActionDao> { throw AssertionError("unused") },
+            settingsRepository = settings
+        )
+    }
+
+    private fun evaluate(engine: ReEvaluationEngine) = runBlocking {
+        engine.evaluateStepResult(
+            originalGoal = "see whether the bees are fed",
+            completedSteps = emptyList(),
+            failedSteps = emptyList(),
+            remainingSteps = emptyList(),
+            planId = "plan-1"
+        )
+    }
+
+    @Test
+    fun `a plan that came back empty at the length limit is asked of the next planner`() {
+        ollama.enqueue(ok(spentOnReasoning))
+        compatible.enqueue(ok(plan))
+
+        val result = evaluate(engine(fallbacks = listOf(custom)))
+
+        assertEquals("CONTINUE", result.decision)
+        assertEquals("going on", result.speech)
+        assertEquals("the active planner was asked once", 1, ollama.requestCount)
+        assertEquals("and then the fallback he configured", 1, compatible.requestCount)
+    }
+
+    @Test
+    fun `with no other planner the limit is told as what it is`() {
+        ollama.enqueue(ok(spentOnReasoning))
+
+        val failure = assertThrows(LLMException::class.java) { evaluate(engine(fallbacks = emptyList())) }
+
+        assertEquals(LLMError.ReplyLimitReached, failure.error)
+        assertEquals(1, ollama.requestCount)
+        assertEquals(0, compatible.requestCount)
+    }
+
+    @Test
+    fun `the last planner's own empty answer is told as its own`() {
+        ollama.enqueue(ok(spentOnReasoning))
+        compatible.enqueue(ok("""{"choices":[{"message":{"content":null},"finish_reason":"length"}]}"""))
+
+        val failure = assertThrows(LLMException::class.java) { evaluate(engine(fallbacks = listOf(custom))) }
+
+        assertEquals(LLMError.ReplyLimitReached, failure.error)
+        assertEquals(custom, failure.provider)
+        assertEquals(1, ollama.requestCount)
+        assertEquals(1, compatible.requestCount)
+    }
+
+    private fun <T> unused(name: String): Provider<T> =
+        Provider { throw AssertionError("$name must not be built: it is not one of the planners") }
+
+    private fun newSettingsRepository() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-planning-fallback-test")
+                    .resolve("settings.preferences_pb")
+                    .toFile()
+            }
+        ),
+        providerCredentialStore = NoKeysCredentialStore(),
+        runStartupMigration = false
+    )
+
+    /** Both servers are on this machine and ask for no key. */
+    private class NoKeysCredentialStore : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
