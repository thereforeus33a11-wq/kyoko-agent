+package com.opendroid.ai.ui.viewmodel
+
+import android.app.Application
+import android.os.Looper
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.persona.PersonaLibrary
+import com.opendroid.ai.core.persona.PersonaMemory
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.core.persona.PersonaStore
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.repository.MemoryRepository
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.io.File
+
+/**
+ * The card screen's model: an edit that cannot be written is reported and not lost, a
+ * saved edit on an older built-in card is pointed out with its two choices, and her
+ * notebook can be copied whole and emptied only on purpose.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaViewModelTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory get() = File(context.filesDir, "persona")
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memory: PersonaMemory
+
+    private fun store(builtIn: String) = PersonaStore(context) { path -> if (path.endsWith("card.md")) builtIn else "" }
+
+    private fun viewModel(store: PersonaStore): PersonaViewModel =
+        PersonaViewModel(store, memory, PersonaLibrary(context)).also { model -> await("the card to load") { !model.isLoading } }
+
+    // The model reads and writes off the main thread and shows the result on the paused main looper.
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Before
+    fun setUp() {
+        directory.deleteRecursively()
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memory = PersonaMemory(
+            MemoryRepository(
+                memoryDao = database.memoryDao(),
+                taskHistoryDao = database.taskHistoryDao(),
+                macroDao = database.macroDao()
+            )
+        )
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `a save that cannot be written says so, keeps what he typed and does not leave the screen`() {
+        val model = viewModel(store("You are Yume.\n"))
+        model.onTextChange("You are Yume, and you keep bees.")
+        // Storage that cannot take the file: something stands where its directory should be.
+        directory.parentFile!!.mkdirs()
+        directory.writeText("in the way")
+        var left = false
+
+        model.save(then = { left = true })
+        await("the failed save to be reported") { model.cardError.isNotEmpty() }
+
+        assertTrue(model.cardError.contains("could not be saved"))
+        assertEquals("You are Yume, and you keep bees.", model.cardText)
+        assertTrue(model.hasUnsavedChanges)
+        assertFalse(model.usesSavedEdit)
+        assertFalse(left)
+    }
+
+    @Test
+    fun `a save that went through shows what is stored, and only then lets him leave`() {
+        val model = viewModel(store("You are Yume.\n"))
+        model.onTextChange("You are Yume, and you keep bees.")
+        var left = false
+
+        model.save(then = { left = true })
+        await("the save") { left }
+
+        assertEquals("You are Yume, and you keep bees.\n", model.cardText)
+        assertTrue(model.usesSavedEdit)
+        assertFalse(model.hasUnsavedChanges)
+        assertEquals("", model.cardError)
+        assertEquals(CardEditNotice.NONE, model.editNotice)
+    }
+
+    @Test
+    fun `an edit that stands on an older built-in card is pointed out, and keeping it settles the notice`() {
+        store("You are Yume.\n").saveCard("You are Yume, and you keep bees.")
+
+        val updated = store("You are Yume. You say what you want.\n")
+        val model = viewModel(updated)
+        assertEquals(CardEditNotice.BUILT_IN_CHANGED, model.editNotice)
+        assertEquals("You are Yume, and you keep bees.\n", model.cardText)
+
+        // He is in the middle of typing when he answers the notice: his typing stays.
+        model.onTextChange("You are Yume, and you keep bees and chickens.")
+        model.keepEdit()
+        await("the choice to be stored") { model.editNotice == CardEditNotice.NONE }
+        assertEquals("You are Yume, and you keep bees and chickens.", model.cardText)
+        assertTrue(model.hasUnsavedChanges)
+        assertTrue(model.usesSavedEdit)
+        // The next start does not ask again.
+        assertEquals(CardEditNotice.NONE, viewModel(store("You are Yume. You say what you want.\n")).editNotice)
+    }
+
+    @Test
+    fun `using the new built-in card removes the edit`() {
+        store("You are Yume.\n").saveCard("You are Yume, and you keep bees.")
+        val model = viewModel(store("You are Yume. You say what you want.\n"))
+
+        model.restoreBundled()
+        await("the edit to be removed") { !model.usesSavedEdit }
+
+        assertEquals("You are Yume. You say what you want.\n", model.cardText)
+        assertEquals(CardEditNotice.NONE, model.editNotice)
+        assertFalse(File(directory, "card.md").exists())
+    }
+
+    @Test
+    fun `her notebook is copied whole, in the form the hand-over field takes, and the screen says how it is moved`() {
+        runBlocking {
+            memory.apply(
+                listOf(
+                    Note(Kind.USER, "bees", "he keeps bees"),
+                    Note(Kind.ME, "soda", "melon soda is mine"),
+                    Note(Kind.THREAD, "tab", "street story: the tab is paid | closed")
+                )
+            )
+        }
+        val model = viewModel(store("You are Yume.\n"))
+        var copied: String? = null
+
+        model.copyNotebook { copied = it }
+        await("the notebook to be copied") { copied != null }
+
+        assertEquals(
+            "user | bees | he keeps bees\nme | soda | melon soda is mine\nthread | tab | street story: the tab is paid | closed",
+            copied
+        )
+        assertTrue(model.notesStatus.startsWith("Copied 3 notes."))
+        assertTrue(model.notesStatus.contains("that is how her notebook is moved"))
+        // What was copied is exactly what another install takes in.
+        assertEquals(3, PersonaNotes.parse(copied!!).size)
+    }
+
+    private val startingNotes = listOf(
+        Note(Kind.REL, "stage", "at ease, not romance"),
+        Note(Kind.THREAD, "boots", "street story: saving for the boots | open")
+    )
+
+    @Test
+    fun `a notebook that is moved says it has had its start, and is not given the starting notes again`() {
+        // The old phone: the starting notes were written long ago, and she closed one and wrote more.
+        runBlocking {
+            memory.seedIfNeeded(startingNotes)
+            memory.apply(
+                listOf(
+                    Note(Kind.THREAD, "boots", "street story: got the boots | closed"),
+                    Note(Kind.USER, "bees", "he keeps bees")
+                )
+            )
+        }
+        var copied: String? = null
+        val old = viewModel(store("You are Yume.\n"))
+        old.copyNotebook { copied = it }
+        await("the notebook to be copied") { copied != null }
+        assertEquals(PersonaNotes.STARTED_MARK, copied!!.lines().first())
+        assertEquals(3, PersonaNotes.parse(copied!!).size)
+        assertTrue(old.notesStatus.startsWith("Copied 3 notes."))
+
+        // The new phone: an empty notebook, and the copied lines are pasted and added.
+        database.close()
+        setUp()
+        val model = viewModel(store("You are Yume.\n"))
+        model.onNotesDraftChange(copied!!)
+        model.giveNotes()
+        await("the hand-over") { model.notesStatus.isNotEmpty() }
+        // The first line is no note and is not counted as one that did not fit.
+        assertEquals("Added 3. They are in her notebook now.", model.notesStatus)
+
+        // Her first reply there: the starting notes are not written in again.
+        runBlocking {
+            memory.seedIfNeeded(startingNotes + Note(Kind.OPINION, "hosts", "hosts are scammers with good hair"))
+            assertEquals(listOf("bees", "boots", "stage"), memory.notes().map { it.key })
+            assertEquals("street story: got the boots | closed", memory.notes().single { it.key == "boots" }.text)
+        }
+    }
+
+    @Test
+    fun `notes typed in by hand do not stop the starting notes from being written`() {
+        val model = viewModel(store("You are Yume.\n"))
+        model.onNotesDraftChange("user | bees | he keeps bees")
+        model.giveNotes()
+        await("the hand-over") { model.notesStatus.isNotEmpty() }
+
+        runBlocking {
+            assertFalse(memory.isStarted())
+            memory.seedIfNeeded(startingNotes)
+            assertEquals(setOf("bees", "boots", "stage"), memory.notes().map { it.key }.toSet())
+        }
+    }
+
+    @Test
+    fun `an empty notebook copies nothing and says so`() {
+        val model = viewModel(store("You are Yume.\n"))
+        var copied: String? = null
+        model.copyNotebook { copied = it }
+        await("the answer") { model.notesStatus.isNotEmpty() }
+        assertEquals(null, copied)
+        assertEquals("Her notebook is empty. Nothing was copied.", model.notesStatus)
+    }
+
+    @Test
+    fun `emptying her notebook deletes her notes and says how many`() {
+        runBlocking {
+            memory.seedIfNeeded(listOf(Note(Kind.REL, "stage", "at ease"), Note(Kind.USER, "bees", "he keeps bees")))
+        }
+        val model = viewModel(store("You are Yume.\n"))
+
+        model.emptyNotebook()
+        await("the notebook to be emptied") { model.notesStatus.isNotEmpty() }
+
+        assertTrue(model.notesStatus.contains("2 notes were deleted"))
+        assertTrue(model.notesStatus.contains("The starting notes are not written again"))
+        runBlocking {
+            assertTrue(memory.notes().isEmpty())
+            memory.seedIfNeeded(listOf(Note(Kind.REL, "stage", "at ease")))
+            assertTrue(memory.notes().isEmpty())
+        }
+    }
+
+    @Test
+    fun `a note about herself can be handed to her like any other`() {
+        val model = viewModel(store("You are Yume.\n"))
+        model.onNotesDraftChange("me | soda | melon soda is mine\nmood | x1 | not a kind she has")
+
+        model.giveNotes()
+        await("the hand-over") { model.notesStatus.isNotEmpty() }
+
+        assertEquals("Added 1 of 2 lines. The rest did not fit the form.", model.notesStatus)
+        runBlocking { assertEquals(listOf(Note(Kind.ME, "soda", "melon soda is mine")), memory.notes()) }
+    }
+}
