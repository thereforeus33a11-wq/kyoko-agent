+    // ── The marks ────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `of several go lines the last counts, the others stay thoughts where they stood`() {
+        val moment = PersonaOwnTime.parse("go: news\nhm\ngo: read about egg magazine\nwhatever", life = reads)
+        assertEquals("read about egg magazine", moment.outing?.words)
