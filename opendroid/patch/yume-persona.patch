+            assertEquals(OutingHost.Began.NotStarted(HerLog.NotStarted.HE_SAID_NO), host.notNow())
+            assertEquals(written to HerLog.NotStarted.HE_SAID_NO, mind.missed.last())
+            assertEquals(HerLog.NotStarted.HE_SAID_NO, entry().notStarted)
+            assertEquals(null, host.letHer())
+
+            // Asked again and left unanswered: once the wait is over it does not start.
+            assertEquals(OutingHost.Began.Asked, host.go(written, parsed))
+            askGate.complete(Unit)
+            withTimeout(5_000) { while (host.asking) delay(5) }
+            withTimeout(5_000) { while (mind.missed.size < 2) delay(5) }
+        }
+        assertEquals(written to HerLog.NotStarted.NOT_ANSWERED, mind.missed.last())
+        assertEquals(HerLog.NotStarted.NOT_ANSWERED, entry().notStarted)
+        assertEquals(2, room.askOvers)
+        assertEquals(null, runBlocking { host.letHer() })
+        assertTrue(mind.texts.isEmpty())
+        assertTrue(sources.searched.isEmpty())
+        // The log says why in its own words, and holds nothing of hers.
+        assertEquals("he was asked first and did not answer in time", HerLog.NotStarted.NOT_ANSWERED.words)
+    }
+
+    @Test
+    fun `Let her after she lay down, or with no room left in the ledger, starts nothing`() {
+        asking()
+        val host = host()
+        host.start(room)
+        val (written, parsed) = read()
+        runBlocking {
+            assertEquals(OutingHost.Began.Asked, host.go(written, parsed))
+            mind.asleepNow = true
+            assertEquals(OutingHost.Began.NotStarted(HerLog.NotStarted.ASLEEP), host.letHer())
+            mind.asleepNow = false
+
+            assertEquals(OutingHost.Began.Asked, host.go(written, parsed))
+            repeat(140) { ledger.record(OwnPurpose.MOMENT, "m", 1, 1, ok = true) }
+            assertEquals(OutingHost.Began.NotStarted(HerLog.NotStarted.BUDGET), host.letHer())
+        }
+        // He was asked twice, and neither yes started anything.
+        assertEquals(2, room.asked.size)
+        assertTrue(mind.texts.isEmpty())
+        assertEquals(listOf(HerLog.NotStarted.ASLEEP, HerLog.NotStarted.BUDGET), log.entries().mapNotNull { it.notStarted })
+    }
+
+    @Test
+    fun `a question past its 30 minutes by the clock on the wall is over, though its wait stopped while the phone slept`() {
+        asking()
+        val host = host()
+        host.start(room)
+        val (written, parsed) = read()
+        runBlocking {
+            assertEquals(OutingHost.Began.Asked, host.go(written, parsed))
+            // The phone slept: the wait has not run out, the notification is gone, and 31 minutes passed.
+            now.addAndGet(31 * minute)
+            // Let her on it now starts nothing: it was not answered in time.
+            assertEquals(OutingHost.Began.NotStarted(HerLog.NotStarted.NOT_ANSWERED), host.letHer())
+            assertFalse(host.asking)
+
+            // And a new go: is not held up by a question nobody can answer any more.
+            assertEquals(OutingHost.Began.Asked, host.go(written, parsed))
+            now.addAndGet(31 * minute)
+            assertEquals(OutingHost.Began.Asked, host.go("news japan", OutingKind.parse("news japan")))
+            assertTrue(host.asking)
+        }
+        assertEquals(listOf(HerLog.NotStarted.NOT_ANSWERED, HerLog.NotStarted.NOT_ANSWERED), log.entries().mapNotNull { it.notStarted })
+        assertEquals(listOf(written to HerLog.NotStarted.NOT_ANSWERED, written to HerLog.NotStarted.NOT_ANSWERED), mind.missed.toList())
+        assertEquals(3, room.asked.size)
+        assertTrue(mind.texts.isEmpty())
+    }
+
+    // ── Kid protection ──────────────────────────────────────────────────────────────
+
