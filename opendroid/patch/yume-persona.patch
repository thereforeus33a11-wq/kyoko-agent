+    private fun awaitSpokenLocally(expected: String? = null): String? {
+        val deadline = System.currentTimeMillis() + 5_000
+        var spoken: String? = null
+        while (System.currentTimeMillis() < deadline) {
+            shadowOf(Looper.getMainLooper()).idle()
+            spoken = shadowOf(ShadowTextToSpeech.getLastTextToSpeechInstance()).lastSpokenText
+            if (spoken != null && (expected == null || spoken == expected)) return spoken
+            Thread.sleep(10)
+        }
+        if (expected != null) throw AssertionError("expected the phone's own voice to say <$expected>, last said <$spoken>")
+        return null
+    }
