+/**
+ * Her prompt says whether a screenshot is attached. That line has to be true: the
+ * encrypted exchange carries no images, so there she is told she cannot see the screen.
+ */
+class PersonaEngineRouteTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    private val seesImages = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-vision-model"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatSeesImages = true
+    )
+
+    @Test
+    fun `a screenshot reaches a chat model that reads images on a route that carries them`() {
+        assertTrue(PersonaEngine.imagesReachChatModel(seesImages))
+        // A model on his own machine, spoken to through the OpenAI-compatible provider.
+        assertTrue(
+            PersonaEngine.imagesReachChatModel(seesImages.copy(customEndpoints = mapOf(custom to "http://192.168.1.20:11434/v1")))
+        )
+        assertTrue(
+            PersonaEngine.imagesReachChatModel(seesImages.copy(customEndpoints = mapOf(custom to "http://127.0.0.1:8080/v1")))
+        )
+    }
+
+    @Test
+    fun `a provider whose request has no place for an image gets none, however the switch is set`() {
+        // The Ollama provider writes an image the way Ollama's own interface takes one, so it carries them.
+        val ollama = seesImages.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+        assertTrue(PersonaEngine.imagesReachChatModel(ollama))
+        assertTrue(PersonaEngine.imagesReachChatModel(ollama.copy(personaChatProvider = "", activeProvider = "Ollama")))
+        assertTrue(PersonaEngine.carriesImages("Ollama"))
+
+        // The models that run inside the app are handed text only.
+        for (onDevice in listOf("On-Device AI", "Gemma 4 (On-device)", "LiteRT-LM (On-device)")) {
+            assertFalse(onDevice, PersonaEngine.imagesReachChatModel(seesImages.copy(personaChatProvider = onDevice)))
+            assertFalse(onDevice, PersonaEngine.imagesReachChatModel(seesImages.copy(activeProvider = onDevice)))
+            assertFalse(onDevice, PersonaEngine.carriesImages(onDevice))
+        }
+
+        // Her provider decides, not the main one: the main model may run inside the app while hers reads images.
+        assertTrue(
+            PersonaEngine.imagesReachChatModel(seesImages.copy(activeProvider = "On-Device AI", personaChatProvider = custom))
+        )
+        for (carries in listOf(custom, "OpenAI", "Anthropic Claude", "Google Gemini", "OpenRouter")) {
+            assertTrue(carries, PersonaEngine.carriesImages(carries))
+        }
+        assertEquals(custom, PersonaEngine.chatProviderOrMain(seesImages))
+        assertEquals("Ollama", PersonaEngine.chatProviderOrMain(ollama))
+        // Nothing set for her replies means the main provider.
+        assertEquals(custom, PersonaEngine.chatProviderOrMain(seesImages.copy(personaChatProvider = " ")))
+        // A name the app does not know is kept, as the reply itself keeps it: her replies
+        // never move to another provider because a name stopped matching.
+        assertEquals(
+            "No Such Provider",
+            PersonaEngine.chatProviderOrMain(seesImages.copy(personaChatProvider = "No Such Provider"))
+        )
+    }
+
+    @Test
+    fun `on the encrypted route no screenshot is attached, however the switch is set`() {
+        val encryptedReplies = seesImages.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertFalse(PersonaEngine.imagesReachChatModel(encryptedReplies))
+
+        val encryptedEverything = seesImages.copy(selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p"))
+        assertFalse(PersonaEngine.imagesReachChatModel(encryptedEverything))
+    }
+
+    @Test
+    fun `a model that was never said to read images gets none on any route`() {
