index 0000000..2c12574
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/phone/LendWatchTest.kt
@@ -0,0 +1,238 @@
+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.phone.LendWatch.Ending
+import com.opendroid.ai.core.life.phone.LendWatch.Signal
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * When his screen may be lent to her, and the watch that gives it back the instant he takes it:
+ * his touch, his screen locking, a call, a notification, another app; her own moves are not his.
+ * Times are a fake clock's.
+ */
+class LendWatchTest {
+
+    private val start = 1_800_000_000_000L
+    private val tiktok = HisApps.TIKTOK.packages
+    private val own = "com.opendroid.ai"
+    private val launcher = "com.sec.android.app.launcher"
+    private val keyboard = "com.samsung.android.honeyboard"
+
+    private fun phone(
+        screenOn: Boolean = true,
+        unlocked: Boolean = true,
+        inCall: Boolean = false,
+        sound: Boolean = false,
+        touched: Long = 0L,
+        hands: Boolean = true
+    ) = LendRules.Phone(screenOn, unlocked, inCall, sound, touched, hands)
+
+    private fun LendWatch.take(signal: Signal) = signal(signal, tiktok, own, listOf(launcher), listOf(keyboard))
+
+    @Test
+    fun `it never starts while the phone is locked, in a call, playing his sound, or in his hand`() {
+        assertNull(LendRules.mayStart(phone(), start))
+        assertEquals(LendRules.Refusal.LOCKED, LendRules.mayStart(phone(unlocked = false), start))
+        assertEquals(LendRules.Refusal.LOCKED, LendRules.mayStart(phone(screenOn = false), start))
+        assertEquals(LendRules.Refusal.CALL, LendRules.mayStart(phone(inCall = true), start))
+        assertEquals(LendRules.Refusal.HIS_SOUND, LendRules.mayStart(phone(sound = true), start))
+        assertEquals(LendRules.Refusal.NO_HANDS, LendRules.mayStart(phone(hands = false), start))
+        // In his hand: touched within the last minute.
+        assertEquals(LendRules.Refusal.IN_HIS_HAND, LendRules.mayStart(phone(touched = start - 30_000), start))
+        assertEquals(LendRules.Refusal.IN_HIS_HAND, LendRules.mayStart(phone(touched = start - 59_000), start))
+        assertNull(LendRules.mayStart(phone(touched = start - 61_000), start))
+        // His yes on the question is the hand-over: the touch that gave it does not count.
+        assertNull(LendRules.mayStart(phone(touched = start - 5_000), start, hisYesAt = start - 4_000))
+        assertEquals(LendRules.Refusal.IN_HIS_HAND, LendRules.mayStart(phone(touched = start - 5_000), start, hisYesAt = start - 5 * 60_000))
+        // His yes never opens a locked screen.
+        assertEquals(LendRules.Refusal.LOCKED, LendRules.mayStart(phone(unlocked = false), start, hisYesAt = start))
+        assertEquals(HerLog.NotStarted.IN_HIS_HAND, LendRules.Refusal.IN_HIS_HAND.notStarted)
+    }
+
+    @Test
+    fun `his touch on the screen ends it at once, her own touches do not`() {
+        val watch = LendWatch(start)
+        // Her finger goes down at 1 s: the touch the watcher feels then is hers.
+        watch.herPress(start + 1_000)
+        watch.herMove(start + 1_000, start + 1_300)
+        assertNull(watch.take(Signal.Touch(start + 1_000)))
+        assertNull(watch.take(Signal.Touch(start + 1_200)))
+        // What an app reports just after her move is hers: a tap opening a page.
+        assertNull(watch.take(Signal.Interaction(start + 2_500, tiktok.first())))
+        assertNull(watch.ending)
+        // Later, it is his.
+        assertEquals(Ending.TOUCHED, watch.take(Signal.Touch(start + 5_000)))
+        assertEquals(HerLog.EndedBy.TAKEOVER, watch.ending!!.endedBy)
+        // The first ending stays.
+        assertEquals(Ending.TOUCHED, watch.take(Signal.ScreenOff(start + 6_000)))
+    }
+
+    @Test
+    fun `a touch is hers only as her finger goes down, never in the grace of a back, a search or the app opening`() {
+        // A second after her tap went down, a touch is his, though what the app reports then is still hers.
+        val tap = LendWatch(start)
+        tap.herPress(start + 1_000)
+        tap.herMove(start + 1_000, start + 1_090)
+        assertNull(tap.take(Signal.Interaction(start + 2_000, tiktok.first())))
+        assertEquals(Ending.TOUCHED, tap.take(Signal.Touch(start + 2_000)))
+        // Her back makes no touch: his touch a second after it ends it, and so does his tap it brings.
+        val back = LendWatch(start)
+        back.herMove(start + 1_000, start + 1_400)
+        assertEquals(Ending.TOUCHED, back.take(Signal.Touch(start + 2_000)))
+        // Nor do her search words, nor the app opening: his touch while it opens is his.
+        val opening = LendWatch(start)
+        opening.herMove(start, start + PhoneSpace.OPEN_SETTLE_MILLIS)
+        assertEquals(Ending.TOUCHED, opening.take(Signal.Touch(start + 1_000)))
+        // Her swipe is hers where it starts; a touch half a second into it is his.
+        val swipe = LendWatch(start)
+        swipe.herPress(start + 1_000)
+        swipe.herMove(start + 1_000, start + 1_480)
+        assertNull(swipe.take(Signal.Touch(start + 1_000 + LendWatch.PRESS_TOUCH_MILLIS)))
+        assertEquals(Ending.TOUCHED, swipe.take(Signal.Touch(start + 1_500)))
+    }
+
+    @Test
+    fun `his scrolling is his hand on the phone, his clicks and windows too, nothing while it is lent`() {
+        val hand = HisHand()
+        hand.event(HisHand.Event.WINDOW, "com.twitter.android", start - 5 * 60_000)
+        // He reads his feed, scrolling, for a minute and a half without a tap.
+        for (t in 0..9) hand.event(HisHand.Event.SCROLL, "com.twitter.android", start - 90_000 + t * 6_000)
+        assertEquals(start - 36_000, hand.lastTouchedAt)
+        assertEquals(LendRules.Refusal.IN_HIS_HAND, LendRules.mayStart(phone(touched = hand.lastTouchedAt), start))
+        // A scroll 30 s ago refuses the start.
+        val reading = HisHand()
+        reading.event(HisHand.Event.SCROLL, "com.android.chrome", start - 30_000)
+        assertEquals(LendRules.Refusal.IN_HIS_HAND, LendRules.mayStart(phone(touched = reading.lastTouchedAt), start))
+        // A selection or a focus in the app in front counts; a scroll in a window behind it does not.
+        val front = HisHand()
+        front.event(HisHand.Event.WINDOW, "com.android.chrome", start - 5 * 60_000)
+        front.event(HisHand.Event.SCROLL, "com.example.widget", start - 10_000)
+        assertEquals(start - 5 * 60_000, front.lastTouchedAt)
+        front.event(HisHand.Event.FOCUSED, "com.android.chrome", start - 8_000)
+        assertEquals(start - 8_000, front.lastTouchedAt)
+        // While it is lent, her own moves make the same events: none of them is his hand.
+        val lent = HisHand()
+        lent.event(HisHand.Event.CLICK, tiktok.first(), start - 10_000, lent = true)
+        lent.event(HisHand.Event.SCROLL, tiktok.first(), start - 9_000, lent = true)
+        lent.event(HisHand.Event.WINDOW, tiktok.first(), start - 8_000, lent = true)
+        assertEquals(0L, lent.lastTouchedAt)
+        // The app in front is still followed.
+        assertEquals(tiktok.first(), lent.front)
+        // An unlock is his hand; an older event never moves it back.
+        lent.touched(start - 1_000)
+        lent.event(HisHand.Event.CLICK, "com.android.chrome", start - 2_000)
+        assertEquals(start - 1_000, lent.lastTouchedAt)
+        assertEquals(0L, HisHand().also { it.event(HisHand.Event.OTHER, "com.android.chrome", start) }.lastTouchedAt)
+    }
+
+    @Test
+    fun `his sound left at nothing by an outing broken off is put back, a volume he set meanwhile is his`() {
+        assertEquals(9, QuietMark.restore(9, 0))
+        assertNull(QuietMark.restore(9, 4))
+        assertNull(QuietMark.restore(null, 0))
+        assertNull(QuietMark.restore(0, 0))
+    }
+
+    @Test
+    fun `a picture is only ever of her app's window alone, never of the whole display, never under the shade`() {
+        assertEquals(FrameRoute.Route.Window(7), FrameRoute.of(34, 7, systemOver = false))
+        assertTrue(FrameRoute.of(33, 7, systemOver = false) is FrameRoute.Route.None)
+        assertTrue(FrameRoute.of(30, null, systemOver = false) is FrameRoute.Route.None)
+        assertTrue(FrameRoute.of(35, null, systemOver = false) is FrameRoute.Route.None)
+        assertTrue(FrameRoute.of(35, 7, systemOver = true) is FrameRoute.Route.None)
+        // No input gives a picture of anything but a window.
+        for (sdk in 26..40) for (id in listOf(null, 3)) for (over in listOf(true, false)) {
+            val route = FrameRoute.of(sdk, id, over)
+            assertTrue(route is FrameRoute.Route.None || route == FrameRoute.Route.Window(3) && sdk >= 34 && !over)
+        }
+    }
+
+    @Test
+    fun `a tap or a text of his in any app ends it, this app's own overlay does not`() {
+        val tap = LendWatch(start)
+        tap.herMove(start, start + 200)
+        assertEquals(Ending.TOUCHED, tap.take(Signal.Interaction(start + 1_800, tiktok.first())))
+        val own = LendWatch(start)
+        assertNull(own.take(Signal.Interaction(start + 10_000, this.own)))
+        val shade = LendWatch(start)
+        assertEquals(Ending.TOUCHED, shade.take(Signal.Interaction(start + 10_000, LendWatch.SYSTEM_UI)))
+    }
+
+    @Test
+    fun `locking, a call, a notification and another app end it, each as what it is`() {
+        assertEquals(Ending.LOCKED, LendWatch(start).take(Signal.ScreenOff(start + 1)))
+        assertEquals(HerLog.EndedBy.SCREEN_OFF, Ending.LOCKED.endedBy)
+        assertEquals(Ending.CALL, LendWatch(start).take(Signal.Call(start + 1)))
+        assertEquals(Ending.CALL, LendWatch(start).take(Signal.Front(start + 1, "com.samsung.android.incallui")))
+        assertEquals(Ending.NOTIFICATION, LendWatch(start).take(Signal.Front(start + 1, tiktok.first(), systemOver = true)))
+        assertEquals(HerLog.EndedBy.NOTIFICATION, Ending.NOTIFICATION.endedBy)
+        assertEquals(Ending.NEEDS_HIM, LendWatch(start).take(Signal.Front(start + 1, "com.android.vending")))
+        assertEquals(Ending.TOUCHED, LendWatch(start).take(Signal.Cut(start + 1)))
+        // Once her app is in front, home or another app in front without a move of hers is his doing.
+        fun arrived() = LendWatch(start).also { it.arrived() }
+        assertEquals(Ending.OTHER_APP, arrived().take(Signal.Front(start + 9_000, launcher)))
+        assertEquals(HerLog.EndedBy.TAKEOVER, Ending.OTHER_APP.endedBy)
+        assertEquals(Ending.OTHER_APP, arrived().take(Signal.Front(start + 9_000, "jp.naver.line.android")))
+        // Her app in front counts as her app having arrived.
+        val seen = LendWatch(start)
+        assertNull(seen.take(Signal.Front(start + 1_000, tiktok.first())))
+        assertEquals(Ending.OTHER_APP, seen.take(Signal.Front(start + 9_000, launcher)))
+        // Right after a move of hers, out of the app is where her move took her: she is done in it.
+        val left = arrived()
+        left.herMove(start + 8_000, start + 8_300)
+        assertEquals(Ending.LEFT_APP, left.take(Signal.Front(start + 9_000, launcher)))
+        assertEquals(HerLog.EndedBy.DONE, Ending.LEFT_APP.endedBy)
+    }
+
+    @Test
+    fun `while her app is still opening, the screen it opens over ends nothing, a call and a notification do`() {
+        val opening = LendWatch(start)
+        assertFalse(opening.arrived)
+        assertNull(opening.take(Signal.Front(start + 3_000, launcher)))
+        assertNull(opening.take(Signal.Front(start + 3_100, own)))
+        assertNull(opening.ending)
+        assertEquals(Ending.CALL, LendWatch(start).take(Signal.Front(start + 3_000, "com.samsung.android.incallui")))
+        assertEquals(Ending.NOTIFICATION, LendWatch(start).take(Signal.Front(start + 3_000, launcher, systemOver = true)))
+        assertEquals(Ending.TOUCHED, LendWatch(start).take(Signal.Touch(start + 3_000)))
+    }
+
+    @Test
+    fun `the app itself, the keyboard, the bars and what came before the lending do not end it`() {
+        val watch = LendWatch(start)
+        assertNull(watch.take(Signal.Front(start + 1, tiktok.first())))
+        assertNull(watch.take(Signal.Front(start + 1, "com.ss.android.ugc.trill")))
+        assertNull(watch.take(Signal.Front(start + 1, keyboard)))
+        assertNull(watch.take(Signal.Front(start + 1, LendWatch.SYSTEM_UI)))
+        assertNull(watch.take(Signal.Front(start + 1, own)))
+        // His tap on "Let her" came before.
+        assertNull(watch.take(Signal.Touch(start - 2_000)))
+        assertNull(watch.take(Signal.Interaction(start - 1_000, LendWatch.SYSTEM_UI)))
+        assertNull(watch.ending)
+    }
+
+    @Test
+    fun `the window in front and a system window over it are read off the windows`() {
+        val app = WindowSeen(WindowSeen.Type.APPLICATION, tiktok.first(), bounds = Box(0, 0, 1080, 2520), active = true)
+        val status = WindowSeen(WindowSeen.Type.SYSTEM, LendWatch.SYSTEM_UI, "StatusBar", Box(0, 0, 1080, 80))
+        val nav = WindowSeen(WindowSeen.Type.SYSTEM, LendWatch.SYSTEM_UI, "NavigationBar", Box(0, 2400, 1080, 2520))
+        val headsUp = WindowSeen(WindowSeen.Type.SYSTEM, LendWatch.SYSTEM_UI, "NotificationShade", Box(0, 0, 1080, 420))
+        val bar = WindowSeen(WindowSeen.Type.APPLICATION, own, bounds = Box(0, 0, 1080, 60))
+        assertEquals(tiktok.first() to false, Fronts.of(listOf(bar, status, app, nav), 1080, 2520, own))
+        assertEquals(tiktok.first() to true, Fronts.of(listOf(headsUp, app, nav), 1080, 2520, own))
+        assertEquals("" to false, Fronts.of(listOf(status, nav), 1080, 2520, own))
+    }
+
+    @Test
+    fun `a protected window comes out black and is known as one`() {
+        assertTrue(FrameCheck.hidden(IntArray(576) { 0 }))
+        assertTrue(FrameCheck.hidden(IntArray(576) { it % 3 }))
+        assertFalse(FrameCheck.hidden(IntArray(576) { (it * 37) % 256 }))
+        // A dark scene with something in it is a picture.
+        assertFalse(FrameCheck.hidden(IntArray(576) { if (it % 50 == 0) 200 else 2 }))
+        assertFalse(FrameCheck.hidden(IntArray(0)))
+    }
+}
