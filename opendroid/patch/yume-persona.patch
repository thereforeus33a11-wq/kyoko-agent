+     * when it is none. A phrase has [MIN_PHRASE_WORDS] words or more, or is one of the
+     * [SHORT_PHRASES], and none of its words counts one by one ([terms]): "how are you",
+     * "you and me", "us". An entry with a word that does count ("your mom") already points
+     * at its page through that word, and counting it whole as well would put it ahead of
+     * every page listed for the word alone.
+     */
+    fun phrase(entry: String): String? {
+        val run = wordRun(entry)
+        if (run.isEmpty() || terms(run).isNotEmpty()) return null
+        return run.takeIf { it.count { char -> char == ' ' } + 1 >= MIN_PHRASE_WORDS || it in SHORT_PHRASES }
+    }
+
