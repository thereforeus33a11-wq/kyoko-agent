+                Note(
+                    (if (his >= viewModel.maxSelfPictures) {
+                        "You have added ${viewModel.maxSelfPictures} pictures of her, which is as many as fit. Remove one to add another."
+                    } else {
+                        "$his of ${viewModel.maxSelfPictures} added by you."
