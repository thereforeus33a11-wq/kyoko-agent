+    @Test
+    fun `a verb she stressed inside her sentence is said, not taken for a gesture`() {
+        // It was said "he at my legs all night".
+        assertEquals("he stares at my legs all night", persona("he *stares* at my legs all night"))
+        assertEquals("she smiles and i hate it", persona("she *smiles* and i hate it"))
+        assertEquals("he looks at me like that", persona("he *looks at me* like that"))
+        // At the end of a line it is her sentence's verb when its subject stands before it.
+        assertEquals("and then he just laughs", persona("and then he just *laughs*"))
+        assertEquals("nobody ever nods. she never smiles", persona("nobody ever *nods*.\nshe never *smiles*"))
+        assertEquals("it purrs", persona("it *purrs*"))
+        // Three dots are a pause inside a sentence, not its end.
+        assertEquals("wait... stares at me?", persona("wait... *stares* at me?"))
+
+        // A stage direction stands apart from her sentence, and is still not said.
+        assertEquals("fine", persona("*sighs* fine"))
+        assertEquals("fine. whatever", persona("fine. *sighs* whatever"))
+        assertEquals("no way! you again", persona("no way! *rolls eyes* you again"))
+        assertEquals("whatever", persona("whatever *shrugs*"))
+        assertEquals("whatever.", persona("whatever *shrugs*."))
+        assertEquals("fine", persona("*sighs* *rolls eyes* fine"))
+        assertEquals("oi", persona("*leans back*\noi\n*smirks*"))
+    }
+
+    @Test
+    fun `a stage direction at the end of a line is not said because a tilde, a heart or an emoji follows it`() {
+        // Each of these was said with the gesture as a word of her sentence: "whatever shrugs".
+        assertEquals("whatever", persona("whatever *shrugs*~"))
+        assertEquals("ok", persona("ok *sighs* 😩"))
+        assertEquals("yeah right", persona("yeah right *smirks* ♡"))
+        assertEquals("fine", persona("fine *sighs* ~♡"))
+        assertEquals("no. you wish", persona("no *glares*~\nyou wish"))
+        // Two in a row at the end are both stage directions.
+        assertEquals("fine", persona("fine *sighs* *rolls eyes*"))
+        // The same at the start: what stands before the gesture is not something she says.
+        assertEquals("fine", persona("😩 *sighs* fine"))
+        assertEquals("oi! fine", persona("oi!~ *sighs* fine"))
+        // Words of hers behind it still make it a word she stressed.
+        assertEquals("he stares at me", persona("he *stares* at me~"))
+        assertEquals("she smiles and i hate it", persona("she *smiles* and i hate it ♡"))
+    }
+
+    @Test
+    fun `it and that are a verb's subject only where they can be one`() {
+        // What the verb before them was done to: the gesture behind it is a stage direction.
+        assertEquals("i knew it", persona("i knew it *grins*"))
+        assertEquals("stop that", persona("stop that *glares*"))
+        assertEquals("forget it", persona("forget it *shrugs*"))
+        assertEquals("i hate that", persona("i hate that *pouts*"))
+        assertEquals("not like that", persona("not like that *smirks*"))
+        assertEquals("is that it", persona("is that it *yawns*"))
+        // Opening their clause they are the subject, and the verb is hers.
+        assertEquals("it purrs", persona("it *purrs*"))
+        assertEquals("and then it just purrs", persona("and then it just *purrs*"))
+        assertEquals("when it purrs", persona("when it *purrs*"))
+        assertEquals("the cat, it purrs", persona("the cat, it *purrs*"))
+        assertEquals("wait... it purrs", persona("wait... it *purrs*"))
+        // "that" behind the noun it tells more about.
+        assertEquals("the cat that purrs", persona("the cat that *purrs*"))
+        assertEquals("some guy at the bar that stares", persona("some guy at the bar that *stares*"))
+        assertEquals("everyone that laughs", persona("everyone that *laughs*"))
+        // The other subjects are as before.
+        assertEquals("and then he just laughs", persona("and then he just *laughs*"))
+        assertEquals("the guy who stares", persona("the guy who *stares*"))
+    }
+
+    @Test
+    fun `swear words and sexual words are spoken as written`() {
+        for (text in listOf("fuck off", "you little shit", "thats so fucking hot", "sex, cock and pussy are words")) {
