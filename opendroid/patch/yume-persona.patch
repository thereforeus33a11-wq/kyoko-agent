+        assertTrue(state.guidance(), state.guidance().contains("Nothing left the phone"))
+        assertTrue(state.guidance(), state.guidance().contains("e2ee-"))
+        assertTrue(state.guidance(), state.guidance().contains("Custom OpenAI Compatible"))
+        assertSaysNothingOfARejection(state)
+        assertFalse(failure.retryable)
+    }
+
+    @Test
+    fun `an e2ee model id at another address is reported as not sent, with the address and the id as the remedy`() {
+        val failure = LLMErrorMapper.encryptedModelAtOtherAddress("Custom OpenAI Compatible", "e2ee-gemma-4-26b-a4b-uncensored-p")
+        val state = card(failure)
+
+        assertEquals(LLMError.EncryptedModelAtOtherAddress, state.category)
+        assertTrue(state.title(), state.title().startsWith("Not sent"))
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+        assertTrue(state.guidance(), state.guidance().startsWith("Nothing left the phone."))
+        assertTrue(state.guidance(), state.guidance().contains("https://api.venice.ai/api/v1"))
+        assertTrue(state.guidance(), state.guidance().contains("plain model id"))
+        // The policy is not what stopped it, so changing the policy is not suggested.
+        assertFalse(state.guidance(), state.guidance().contains("Where a model may run"))
+        assertSaysNothingOfARejection(state)
+        assertFalse(failure.retryable)
+    }
+
+    @Test
+    fun `a provider without an address is reported as not sent, with the address as the remedy`() {
+        val failure = LLMErrorMapper.addressMissing("Ollama", "llama3")
+        val state = card(failure)
+
+        assertEquals(LLMError.AddressMissing, state.category)
+        assertEquals("Not sent: Ollama has no address yet", state.title())
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+        assertTrue(state.guidance(), state.guidance().startsWith("Nothing left the phone."))
+        assertTrue(state.guidance(), state.guidance().contains("enter the address for Ollama"))
+        assertSaysNothingOfARejection(state)
+        assertFalse(failure.retryable)
+    }
+
+    @Test
+    fun `an address that led away from his own machine is reported as not sent, and not as a lost connection`() {
+        val failure = LLMErrorMapper.fromThrowable("Ollama", "llama3", com.opendroid.ai.core.util.AddressLedElsewhereException())
+        val state = card(failure)
+
+        assertEquals(LLMError.AddressLedElsewhere, state.category)
+        assertEquals("Not sent: the address for Ollama did not lead to your own machine", state.title())
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+        assertTrue(state.guidance(), state.guidance().contains("your message and the key were not sent to it"))
+        assertTrue(state.guidance(), state.guidance().contains("in numbers"))
+        // A connection was opened to find this out, so it is not said that nothing left the phone.
+        assertFalse(state.guidance(), state.guidance().contains("Nothing left the phone"))
+        assertFalse(state.title(), state.title().contains("reach"))
+        assertFalse(state.guidance(), state.guidance().contains("Check your connection"))
+        assertSaysNothingOfARejection(state)
+        assertFalse(failure.retryable)
+    }
+
+    @Test
+    fun `a key that belongs to another address is reported as not sent, and says which key is asked for`() {
