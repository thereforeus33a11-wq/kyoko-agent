+    /** The most of his apps the `go:` offer names. */
+    const val MAX_APPS_NAMED = 8
+
+    /** The `wonder:` mark in [momentBlock], while her own life is on. */
+    internal val WONDER_LINE =
+        "  wonder: <a question>     something you want to find out sometime. it goes on a list of yours (${Wonders.MAX} at most; " +
+            "the oldest falls off), shown in your moments until you let it go with wonder: <the same words> | gone, " +
+            "found out or not. ${Wonders.PER_MOMENT} at most per moment."
+
+    /** What the app reads after `go:` now, for her when a line of hers could not be read. */
+    internal fun goReads(runnable: Set<OutingKind.Kind>, frontToo: Boolean = true): String = listOfNotNull(
+        "read <words or a link>".takeIf { OutingKind.Kind.READ in runnable },
+        "news [japan | world | <a topic>]".takeIf { OutingKind.Kind.NEWS in runnable },
+        (if (frontToo) "look [back | front | around]" else "look back").takeIf { OutingKind.Kind.LOOK in runnable },
+        "scroll <app>, watch <app> [<what>], look <app>".takeIf { OutingKind.Kind.SCROLL in runnable }
+    ).joinToString(", ").ifEmpty { "nothing right now" }
+
+    /** Other people's words in a line of her prompt: they must not open a section of their own. */
+    private fun quoted(text: String): String = "\"" + text.replace("===", "= = =").replace("\"", "'") + "\""
+
+    /**
+     * The lines "about this moment" gets about her own life, each only while it is true:
+     * her open wonders, the glance at her feeds, her last outing when it ended after her
+     * last moment, and a go: line of hers that did not start.
+     */
+    internal fun lifeLines(life: Life, thoughtsLeftOut: Boolean): List<String> = buildList {
+        // Her wonders can be about him: where her thoughts are left out, so are they.
+        if (!thoughtsLeftOut) Wonders.momentLine(life.wonders, life.nowMillis)?.let { add(it.removePrefix("- ")) }
