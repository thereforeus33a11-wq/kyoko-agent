+
+    // ── Told in words whenever no picture is in front of her ─────────────────────────
+
+    @Test
+    fun `where her model reads images she is still told what is on her pictures in every reply that carries none`() {
+        stored(self("a", "black coat, fur collar"), background("page", "the page with the harbour story"), self("c", "nails, gold tips"))
+        val list = PersonaPrompts.PICTURES_HEADING + "\n- black coat, fur collar\n- nails, gold tips\n\n" +
+            PersonaPrompts.APP_FACTS_HEADING
+
+        // A later reply about something else: no picture goes with it, so the words do.
+        assertNull(pictureFor(config(), listOf(he("morning"), she("mm"), he("is that the fur collar one"))))
+        assertTrue(chatPrompt().contains(list))
+        // The same next to a screenshot of his screen.
