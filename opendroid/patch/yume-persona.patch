+        val hers = PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, PersonaEngine.CHAT_MAX_TOKENS), config)
+
+        assertTrue(hers.persona)
+        assertEquals("e2ee-test-model", hers.modelOverride)
+        assertEquals("{\"top_p\":0.9}", hers.extraBodyOverride)
+        assertEquals(1200, hers.maxTokens)
+
+        val plain = PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, 160), LLMConfig())
+        assertTrue("still hers with nothing set for her replies", plain.persona)
+        assertNull(plain.modelOverride)
+        assertNull(plain.extraBodyOverride)
+    }
+
+    @Test
+    fun `the options typed for her replies may set the sampling of a reply and of nothing else`() {
+        val config = LLMConfig(personaChatExtraBody = "{\"temperature\":1.1,\"max_tokens\":900}")
+        // Her chat reply and a moment of her own.
+        assertFalse(PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, PersonaEngine.CHAT_MAX_TOKENS), config).keepsOwnSampling)
+        assertFalse(PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, 160), config).keepsOwnSampling)
+        // Her notebook pass, her line about a result, a plan for a command of hers.
+        assertTrue(PersonaEngine.requestOfHers(request(0.2f, 240), config).keepsOwnSampling)
+        assertTrue(PersonaEngine.requestOfHers(request(0.6f, 200), config).keepsOwnSampling)
+        assertTrue(PersonaEngine.requestOfHers(request(0.1f, 1500), config).keepsOwnSampling)
+    }
+
+    @Test
+    fun `her reply and a moment of her own ask for her hidden thinking to be off, and nothing else does`() {
+        val plain = LLMConfig()
+        // Her chat reply and a moment of her own, with nothing typed for her.
+        assertTrue(PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, PersonaEngine.CHAT_MAX_TOKENS), plain).thinkingOff)
+        assertTrue(PersonaEngine.requestOfHers(PersonaEngine.ownTimeRequest("system text"), plain).thinkingOff)
+        // Her notebook pass, her sleep pass, her line about a result, a plan for a command of hers keep theirs.
+        for (other in listOf(request(0.2f, 240), request(PersonaSleepPass.TEMPERATURE, 900), request(0.6f, 200), request(0.1f, 1500))) {
+            assertFalse("${other.temperature}", PersonaEngine.requestOfHers(other, plain).thinkingOff)
+        }
+        // A request that is not hers, the planner's for his own command, never asks it.
+        assertFalse(request(0.1f, 1500).thinkingOff)
+        // Options he typed for her are hers to set: nothing is added to them, whatever they say.
+        val typed = LLMConfig(personaChatExtraBody = "{\"presence_penalty\":0.3}")
+        val hers = PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, PersonaEngine.CHAT_MAX_TOKENS), typed)
+        assertFalse(hers.thinkingOff)
+        assertEquals("{\"presence_penalty\":0.3}", hers.extraBodyOverride)
+        // Blank is nothing typed.
+        assertTrue(PersonaEngine.requestOfHers(request(PersonaEngine.CHAT_TEMPERATURE, 160), LLMConfig(personaChatExtraBody = "  ")).thinkingOff)
+    }
