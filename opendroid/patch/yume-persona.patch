+        assertTrue(PersonaActions.echoesOutsideText("message @quick_cash_bot on telegram: hi", notifications))
+
+        assertFalse(PersonaActions.echoesOutsideText("email sam@other.example.com: here", notifications))
+        assertFalse(PersonaActions.echoesOutsideText("open maps.example.com", notifications))
+        assertFalse(PersonaActions.echoesOutsideText("message @nene_k on telegram: hi", notifications))
+    }
+
+    @Test
