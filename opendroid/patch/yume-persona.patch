+    /** Whether the owner's settings give her time of her own at all. Whether she is on is asked elsewhere. */
+    fun isOn(config: LLMConfig): Boolean = config.personaCheckInsEnabled && Bounds.of(config).maxPerDay > 0
+
+    // ── What she asks for ────────────────────────────────────────────────────────────
+
+    /** When she wants her next moment, as she wrote it after `next:`. */
+    sealed class Wish {
+        /** So long from now. */
+        data class After(val millis: Long) : Wish()
+
+        /** The next time his clock shows this time. */
+        data class At(val hour: Int, val minute: Int) : Wish()
+
+        /** Not until he writes to her again: the wait ends with her reply to that message. */
+        object WhenHeWrites : Wish()
+    }
+
+    private val WHEN_HE_WRITES = Regex("""when he (?:next )?(?:writes|texts|messages)(?: me| to me)?(?: again| next)?""")
+    private val CLOCK = Regex("""(?:at )?(\d{1,2}):(\d{2})""")
+    private val TRAILING_BRACKETS = Regex("""\s*\([^)]*\)\s*$""")
+    private val SPAN_PART = Regex("""(\d{1,5})\s*(d|days?|h|hrs?|hours?|m|mins?|minutes?)""")
+    private val SPAN = Regex("""(?:in )?(?:${SPAN_PART.pattern}\s*(?:and\s+|,\s*)?)+""")
+    private val HOURS_THEN_BARE_MINUTES = Regex("""(?:in )?(\d{1,5})\s*h\s*(\d{1,2})""")
+
+    /**
+     * Reads what stands after `next:`. The forms are few on purpose: a span of time
+     * (20m, 3h, 1h30m, 2d, "45 min", "2 hours"), a time on his clock (02:30), or
+     * "when he writes". Anything else is not guessed at: null, and the default applies.
+     */
+    fun parseWish(text: String): Wish? {
+        // "02:30 (his clock)" is how her prompt writes the form: the brackets are not part of the time.
+        val wish = TRAILING_BRACKETS.replace(text.trim().lowercase(), "").trim('.', '`', '"', '\'', ' ')
+        if (wish.isEmpty()) return null
+        if (WHEN_HE_WRITES.matches(wish)) return Wish.WhenHeWrites
+        CLOCK.matchEntire(wish)?.let { clock ->
+            val hour = clock.groupValues[1].toInt()
+            val minute = clock.groupValues[2].toInt()
+            return if (hour in 0..23 && minute in 0..59) Wish.At(hour, minute) else null
+        }
+        HOURS_THEN_BARE_MINUTES.matchEntire(wish)?.let { span ->
+            val minutes = span.groupValues[2].toLong()
+            return if (minutes < 60) Wish.After(span.groupValues[1].toLong() * HOUR + minutes * MINUTE) else null
+        }
+        if (!SPAN.matches(wish)) return null
+        val millis = SPAN_PART.findAll(wish).sumOf { part ->
+            val count = part.groupValues[1].toLong()
+            when (part.groupValues[2].first()) {
+                'd' -> count * DAY_MILLIS
+                'h' -> count * HOUR
+                else -> count * MINUTE
+            }
+        }
+        return Wish.After(millis)
+    }
+
+    // ── What the app keeps ───────────────────────────────────────────────────────────
+
+    /** When she is woken next. */
+    sealed class Wake {
+        /** No time has been set yet: her own time has not started. */
+        object Unset : Wake()
