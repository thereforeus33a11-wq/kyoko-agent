+            ) + if (inOwnTime || !ownLifeIsOn(config)) {
+                emptyList()
+            } else {
+                // What she did on her own since he last talked to her, from the app's log, and what she is doing now.
+                ownLife.forReply(config, nowMillis)?.let { PersonaOwnTime.lifeReplyLines(it, nowMillis) }.orEmpty()
+            },
+            inOwnTime = inOwnTime,
+            onOuting = onOuting,
+            onLook = onLook,
+            // How she feels follows her notes about him: where those are held back, so is a feeling that can be about him.
+            feelings = PersonaMood.block(memory.mood(), nowMillis, leaveOut = if (heldBack) PersonaMood.aboutHim(owner) else null),
