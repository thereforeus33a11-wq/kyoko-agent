+                val his = selfPictures.count { !it.made }
+                val hers = selfPictures.size - his
+                OutlinedButton(
+                    onClick = { pickSelfPicture.launch(imagesOnly) },
+                    enabled = his < viewModel.maxSelfPictures && !viewModel.adding,
+                    modifier = Modifier.fillMaxWidth()
