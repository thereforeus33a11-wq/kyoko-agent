+
+        assertEquals(LLMError.KeyForOtherAddress, state.category)
+        assertEquals("Not sent: the key for Custom OpenAI Compatible belongs to another address", state.title())
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+        assertTrue(state.guidance(), state.guidance().startsWith("Nothing left the phone."))
+        assertTrue(state.guidance(), state.guidance().contains("enter the key for the address"))
+        assertSaysNothingOfARejection(state)
+        assertFalse(failure.retryable)
+    }
+
+    /** The provider never saw the request, and editing the message would change nothing. */
+    private fun assertSaysNothingOfARejection(state: ChatErrorUiState) {
+        assertFalse(state.title(), state.title().contains("rejected", ignoreCase = true))
+        assertFalse(state.guidance(), state.guidance().contains("Edit the message"))
+        assertTrue(state.guidance(), state.guidance().contains("Settings"))
+    }
+
+    @Test
+    fun `a request the provider did reject still says so and offers to edit the message`() {
+        val state = card(LLMErrorMapper.requestInvalid("OpenAI", "gpt-4o"))
+
+        assertEquals("Request rejected by OpenAI", state.title())
+        assertEquals(ChatErrorPrimaryAction.EDIT_MESSAGE, state.primaryAction())
+    }
+    private fun state(failure: com.opendroid.ai.core.llm.error.LLMException) =
+        ChatErrorUiState.fromException(sessionId = "session", requestId = "req", runId = "run", failure = failure)
+
+    @Test
+    fun `a refusal by the model's host says whose it was and leaves the retry to him`() {
+        val state = state(LLMErrorMapper.providerRefused("Custom OpenAI Compatible", "some-model"))
+        assertEquals(LLMError.ProviderRefused, state.category)
+        assertEquals("The model's host refused this", state.title())
+        assertEquals(
+            "This came from the model or its host, not from her. Try again, or use another model for her replies.",
+            state.guidance()
+        )
+        assertFalse("never retried by itself", state.retryable)
+        assertEquals(ChatErrorPrimaryAction.RETRY, state.primaryAction())
+    }
+
+    @Test
+    fun `a prompt of hers that does not fit says so and points at the model and the card`() {
+        val state = state(LLMErrorMapper.promptTooLarge("On-Device AI", "qwen-small"))
+        assertEquals(LLMError.PromptTooLarge, state.category)
+        assertEquals(
+            "Her card and notes do not fit this model's context. Use a model with a larger context, or a shorter card.",
+            state.guidance()
+        )
+        assertTrue(state.title(), state.title().startsWith("Not sent"))
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+    }
+
+    @Test
+    fun `a reply that ran out of length before any answer names the limit and where it is raised`() {
+        val state = state(LLMErrorMapper.replyLimitReached("Custom OpenAI Compatible", "some-reasoning-model"))
+        assertEquals(LLMError.ReplyLimitReached, state.category)
+        assertEquals("The model ran out of reply length before it answered", state.title())
+        assertFalse(state.title(), state.title().contains("unreadable"))
+        assertTrue(state.guidance(), state.guidance().contains("length limit"))
+        assertTrue(state.guidance(), state.guidance().contains("max_tokens"))
+        // The field is named as the screen names it.
+        assertTrue(state.guidance(), state.guidance().contains("\"Extra request options for her replies\""))
+        assertFalse("never retried by itself", state.retryable)
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+    }
+
+    @Test
+    fun `a model on the phone that fails is not said to be out of reach`() {
+        val failure = LLMErrorMapper.fromThrowable(
+            "On-Device AI", "gemma-4-on-device", java.io.IOException("Not enough memory to run the model.")
+        )
+        val state = state(failure)
+        assertEquals(LLMError.OnDeviceModelFailed, state.category)
+        assertEquals("The model on this phone could not answer", state.title())
+        assertFalse(state.title(), state.title().contains("reach"))
+        assertFalse(state.guidance(), state.guidance().contains("Check your connection"))
+        assertTrue(state.guidance(), state.guidance().contains("no connection is involved"))
+        assertTrue(state.guidance(), state.guidance().contains("nothing was sent anywhere"))
+        assertTrue(state.guidance(), state.guidance().contains("Settings"))
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+    }
+
+    @Test
+    fun `a failed encryption check is never shown as a lost connection, and says which side failed`() {
+        val notSent = state(LLMErrorMapper.encryptionCheckFailed("Custom OpenAI Compatible", "e2ee-test-model"))
+        assertEquals(LLMError.EncryptionCheckFailed, notSent.category)
+        assertEquals("The encrypted model could not be verified. Nothing was sent.", notSent.title())
+        assertFalse(notSent.replyDiscarded)
+
+        val discarded = state(
+            LLMErrorMapper.encryptionCheckFailed("Custom OpenAI Compatible", "e2ee-test-model", replyDiscarded = true)
+        )
+        assertEquals("The reply did not arrive encrypted and was thrown away.", discarded.title())
+        assertTrue(discarded.replyDiscarded)
+
+        // The enclave failed the check on a second asking, after a first attempt had gone
+        // out to the key proved earlier: "nothing was sent" would not be true.
+        val notSentAgain = state(
+            LLMErrorMapper.encryptionCheckFailed("Custom OpenAI Compatible", "e2ee-test-model", earlierAttemptSent = true)
+        )
+        assertEquals("The encrypted model could not be verified again. Nothing more was sent.", notSentAgain.title())
+        assertTrue(notSentAgain.earlierAttemptSent)
+        assertFalse(notSentAgain.title(), notSentAgain.title().contains("Nothing was sent"))
+        assertFalse(notSentAgain.guidance(), notSentAgain.guidance().contains("stayed here"))
+        // How often it had gone out is not claimed: an automatic retry may have sent it twice.
+        assertTrue(notSentAgain.guidance(), notSentAgain.guidance().contains("had already gone out, encrypted"))
+        assertTrue(notSentAgain.guidance(), notSentAgain.guidance().contains("no reply came of it"))
+        assertTrue(notSentAgain.guidance(), notSentAgain.guidance().contains("not sent again"))
+        assertFalse(notSentAgain.guidance(), notSentAgain.guidance().contains("once"))
+
+        for (failed in listOf(notSent, discarded, notSentAgain)) {
+            assertFalse(failed.retryable)
+            assertEquals("no blind retry of a failed check", ChatErrorPrimaryAction.NONE, failed.primaryAction())
+            assertFalse(failed.title(), failed.title().contains("reach"))
+            assertFalse(failed.guidance(), failed.guidance().contains("connection"))
+        }
+        assertEquals(3, setOf(notSent.guidance(), discarded.guidance(), notSentAgain.guidance()).size)
+    }
+
+    @Test
+    fun `a reply model typed for another provider says that nothing left the phone and what to change`() {
+        val state = state(LLMErrorMapper.replyModelForOtherProvider("Ollama", "venice-uncensored-1-2"))
+        assertEquals(LLMError.ReplyModelForOtherProvider, state.category)
+        assertTrue(state.title(), state.title().startsWith("Not sent"))
+        assertTrue(state.guidance(), state.guidance().startsWith("Nothing left the phone."))
+        assertTrue(state.guidance(), state.guidance().contains("Model for her replies"))
+        assertEquals(ChatErrorPrimaryAction.OPEN_SETTINGS, state.primaryAction())
+    }
+
+    @Test
+    fun `every error has a title and guidance of its own`() {
+        val all = listOf(
+            LLMErrorMapper.authMissing("OpenAI", "m"),
+            LLMErrorMapper.requestInvalid("OpenAI", "m"),
+            LLMErrorMapper.privateRouteRequired("OpenAI", "m"),
+            LLMErrorMapper.plainHttpRefused("OpenAI", "m"),
+            LLMErrorMapper.encryptedModelOnPlainProvider("OpenAI", "m"),
+            LLMErrorMapper.encryptedModelAtOtherAddress("OpenAI", "m"),
+            LLMErrorMapper.addressMissing("OpenAI", "m"),
+            LLMErrorMapper.providerRefused("OpenAI", "m"),
+            LLMErrorMapper.promptTooLarge("OpenAI", "m"),
+            LLMErrorMapper.encryptionCheckFailed("OpenAI", "m"),
+            LLMErrorMapper.replyModelForOtherProvider("OpenAI", "m"),
+            LLMErrorMapper.replyLimitReached("OpenAI", "m"),
+            LLMErrorMapper.keyForOtherAddress("OpenAI", "m"),
+            LLMErrorMapper.fromThrowable("OpenAI", "m", com.opendroid.ai.core.util.AddressLedElsewhereException()),
+            LLMErrorMapper.fromThrowable("On-Device AI", "m", java.io.IOException("out of memory")),
+            LLMErrorMapper.malformed("OpenAI", "m")
+        ).map(::state)
+        assertEquals(all.size, all.map { it.title() }.toSet().size)
+        assertEquals(all.size, all.map { it.guidance() }.toSet().size)
+        // What was refused on the phone never reads as the provider having rejected it.
+        val refusedOnPhone = setOf(
+            LLMError.PlainHttpRefused, LLMError.EncryptedModelOnPlainProvider, LLMError.EncryptedModelAtOtherAddress,
+            LLMError.AddressMissing, LLMError.ReplyModelForOtherProvider, LLMError.KeyForOtherAddress
+        )
+        for (onPhone in all.filter { it.category in refusedOnPhone }) {
+            assertTrue(onPhone.title(), onPhone.title().startsWith("Not sent"))
+            assertTrue(onPhone.guidance(), onPhone.guidance().startsWith("Nothing left the phone."))
+            assertFalse(onPhone.guidance(), onPhone.guidance().contains("Edit the message"))
+        }
+    }
 }
