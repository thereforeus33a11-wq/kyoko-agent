+                    unfocusedTextColor = TextPrimary
+                ),
+                modifier = Modifier.fillMaxWidth()
+            )
+            Text(
+                text = viewModel.notesStatus.ifEmpty {
+                    "Goes straight into her notebook on this phone and nowhere else. kind is user, rel, thread, opinion or fix. Written as she would write it: \"i\" is her, \"he\" is you."
