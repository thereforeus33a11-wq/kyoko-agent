+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * `look <n>` in her reading: the pictures in front of her and their numbers, the caps, kid
+ * protection before anything is fetched or sent, what a flagged picture marks and what is
+ * then withheld from her, an unchecked description, and the picture's bytes zeroed once
+ * the describer is done.
+ */
+class ReadingSpaceLookTest {
+
+    private val his = OutgoingGuard.His(name = "Ren Mizuno")
+
+    private inner class Sources : ReadingSpace.Sources {
+        val images = CopyOnWriteArrayList<String>()
+        val given = CopyOnWriteArrayList<ByteArray>()
+        var hits = listOf(
+            Wikipedia.Hit("Egg (magazine)", "Japanese magazine", "a gyaru magazine", "en", "https://upload.wikimedia.org/egg.jpg"),
+            Wikipedia.Hit("Gyaru", "Fashion subculture", "", "en", null),
+            Wikipedia.Hit("Shibuya 109", "Shopping mall", "", "en", "https://upload.wikimedia.org/109.jpg")
+        )
+        var items = listOf(
+            Feeds.Item("Shibuya opens a new arcade HEADLINE_SENTINEL", "https://news.example/a", "NHK", null, "https://news.example/a.jpg", ""),
+            Feeds.Item("Rain all week", "https://news.example/b", "NHK", null, null, ""),
+            Feeds.Item("中2のモデルがデビュー", "https://news.example/c", "Yahoo", null, "https://news.example/c.jpg", "")
+        )
+        var page = """<html><head><title>Egg</title><meta property="og:image" content="https://site.example/lead.jpg"></head>
+            <body><article><p>egg was a japanese fashion magazine for gyaru, founded in 1995 and read across Shibuya.</p></article></body></html>"""
+
+        override suspend fun search(words: String) = Wikipedia.Result.Found(hits)
+        override suspend fun article(title: String, lang: String): Wikipedia.Result<Wikipedia.Article> =
+            Wikipedia.Result.Found(Wikipedia.Article(title, lang, listOf("egg was a gyaru magazine."), "https://upload.wikimedia.org/egg-lead.jpg"))
+        override suspend fun fetch(url: String): HerFetcher.Fetched =
+            HerFetcher.Fetched.Page(url, url, "text/html; charset=utf-8", page.toByteArray(), false)
+        override suspend fun feed(feed: Feeds.Feed): Feeds.Read = Feeds.Read.Items(feed, items)
+        override fun follow(url: String, name: String) = HerFeeds.Followed.ADDED
+        override suspend fun image(url: String): HerFetcher.Fetched {
+            images += url
+            val bytes = ByteArray(32) { 9 }
+            given += bytes
+            return HerFetcher.Fetched.Page(url, url, "image/jpeg", bytes, false)
+        }
+    }
+
+    private class FakeEyes : Eyes {
+        val seen = ArrayDeque<HerEyes.Seen>()
+        val described = CopyOnWriteArrayList<Pair<ByteArray, Describe.Source>>()
+        override fun open(config: LLMConfig, nowMillis: Long) = true
+        override fun leftToday(config: LLMConfig, nowMillis: Long): Int = 60
+        override suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen {
+            described += image.copyOf() to source
+            return seen.removeFirstOrNull() ?: HerEyes.Seen.Described("A plain picture.", KidGuard.Ages.Read(emptySet()))
+        }
+    }
+
+    private val sources = Sources()
+    private val eyes = FakeEyes()
+
+    private fun space(looks: Int = 6, withEyes: Boolean = true) =
+        ReadingSpace(sources, his, limits = ReadingSpace.Limits(looks = looks), eyes = eyes.takeIf { withEyes })
+
+    private fun described(words: String, ages: String) = HerEyes.Seen.Described(words, KidGuard.ages(ages))
+
+    @Test
+    fun `a page's lead picture is picture 1, and a look puts the describer's words in front of her`() = runBlocking {
+        val space = space()
+        space.begin(OutingKind.Parsed.Read("https://site.example/egg", "https://site.example/egg"))
+        assertEquals(listOf("https://site.example/lead.jpg"), space.pictures.map { it.url })
+        assertNull(space.pictures.single().item)
+        // Shown as a picture she can look at only while she has eyes.
+        assertTrue(OutingPrompt.inFront(space.view, showPictures = true).contains("picture 1: the page's lead picture, not looked at."))
+        assertFalse(OutingPrompt.inFront(space.view).contains("picture 1"))
+
+        eyes.seen.addLast(described("A magazine cover with three women in bright makeup.", "ages: adult"))
+        val did = space.run(OutingStep.Verb.Look(1))
+        assertTrue(did.looked)
+        assertEquals("looked at picture 1: what the describer wrote is in front of you", did.line)
+        assertEquals(listOf(Describe.Source.PAGE_IMAGE), eyes.described.map { it.second })
+        assertEquals(listOf("https://site.example/lead.jpg"), sources.images.toList())
+        // The bytes reached the describer, and are zeroed once it is done.
+        assertTrue(eyes.described.single().first.all { it == 9.toByte() })
+        assertTrue(sources.given.single().all { it == 0.toByte() })
+        assertEquals(5, space.looksLeft)
+        val front = OutingPrompt.inFront(space.view)
+        assertTrue(front, front.contains("picture 1 (described for you by the app's describer; you do not see it, and it can be wrong): A magazine cover with three women in bright makeup."))
+        // A second look at the same picture costs nothing.
+        assertEquals("you looked at picture 1 already: what came of it is in front of you", space.run(OutingStep.Verb.Look(1)).line)
+        assertEquals(1, eyes.described.size)
+        assertEquals("there is no picture 2 in front of you", space.run(OutingStep.Verb.Look(2)).line)
+    }
+
+    @Test
+    fun `results and headlines number their pictures, and the outing's looks run out`() = runBlocking {
+        val space = space(looks = 2)
+        space.begin(OutingKind.Parsed.Read("egg magazine", null))
+        assertEquals(listOf(1, 3), space.pictures.map { it.item })
+        val list = OutingPrompt.inFront(space.view, showPictures = true)
+        assertTrue(list, list.contains("[1] Egg (magazine) · Japanese magazine · a gyaru magazine · picture 1"))
+        assertTrue(list.contains("[2] Gyaru · Fashion subculture\n"))
+        assertTrue(list.contains("[3] Shibuya 109 · Shopping mall · picture 2"))
+        space.run(OutingStep.Verb.Look(1))
+        space.run(OutingStep.Verb.Look(2))
+        assertEquals(listOf(Describe.Source.FEED_IMAGE, Describe.Source.FEED_IMAGE), eyes.described.map { it.second })
+        assertEquals("no looks are left on this outing, so nothing was looked at", space.run(OutingStep.Verb.Look(1)).line)
+        assertEquals(2, eyes.described.size)
+        // A wikipedia page opened from the list has its own lead picture.
+        space.run(OutingStep.Verb.Open(2))
+        assertEquals(listOf("https://upload.wikimedia.org/egg-lead.jpg"), space.pictures.map { it.url })
+    }
+
+    @Test
+    fun `without eyes nothing is looked at and no picture is offered`() = runBlocking {
+        val space = space(withEyes = false)
+        space.begin(OutingKind.Parsed.Read("https://site.example/egg", "https://site.example/egg"))
+        assertFalse(space.hasEyes)
+        assertEquals(0, space.looksLeft)
+        assertEquals("you have no eyes on this outing, so nothing was looked at", space.run(OutingStep.Verb.Look(1)).line)
+        assertTrue(sources.images.isEmpty())
+        assertEquals("you have no eyes on this outing, so nothing was looked at", space(looks = 0).run(OutingStep.Verb.Look(1)).line)
+    }
+
+    @Test
+    fun `a headline whose picture shows a teen becomes one kid line, its title and words withheld, and is not opened`() = runBlocking {
+        val space = space()
+        space.begin(OutingKind.Parsed.NewsOf(OutingKind.News.TOP, null))
+        assertEquals(listOf(1, 3), space.pictures.map { it.item })
+        eyes.seen.addLast(described("DESCRIPTION_SENTINEL two people at an arcade.", "ages: teen, adult"))
+        val did = space.run(OutingStep.Verb.Look(1))
+        assertEquals(KidGuard.Group.TEEN, did.kidSeen?.group)
+        assertTrue(did.looked)
+        assertEquals("looked at picture 1: the describer saw a kid, so the app marks [1] kid and does not show it", did.line)
+        assertNotNull(space.kidInFront)
+        val front = OutingPrompt.inFront(space.view, showPictures = true)
+        assertTrue(front, front.contains("[1] kid · NHK · skipped by the app (the describer saw a teen)"))
+        assertFalse(front.contains("HEADLINE_SENTINEL"))
+        assertFalse(front.contains("DESCRIPTION_SENTINEL"))
+        assertFalse(front.contains("picture 1"))
+        assertFalse(did.line.contains("DESCRIPTION_SENTINEL"))
+        // Not opened, and not looked at again.
+        val open = space.run(OutingStep.Verb.Open(1))
+        assertEquals("skipped: a kid (the describer saw a teen)", open.line)
+        assertEquals(KidGuard.Group.TEEN, open.kidSkipped?.group)
+        assertEquals(1, eyes.described.size)
+        // The other headlines stand as they were.
+        assertTrue(front.contains("[2] Rain all week · NHK"))
+    }
+
+    @Test
+    fun `a headline whose own words mark a kid is not looked at, and nothing is fetched or sent`() = runBlocking {
+        val space = space()
+        space.begin(OutingKind.Parsed.NewsOf(OutingKind.News.TOP, null))
+        val did = space.run(OutingStep.Verb.Look(2))
+        assertEquals("skipped: a kid (中2)", did.line)
+        assertEquals(KidGuard.Group.TEEN, did.kidSkipped?.group)
+        assertFalse(did.looked)
+        assertTrue(sources.images.isEmpty())
+        assertTrue(eyes.described.isEmpty())
+        assertEquals(6, space.looksLeft)
+        assertTrue(OutingPrompt.inFront(space.view).contains("[3] kid · Yahoo · skipped by the app (中2)"))
+    }
+
+    @Test
+    fun `a page marked a kid's is not looked at, and a page picture that shows a child marks the page and is shown as kid without its words`() = runBlocking {
+        sources.page = """<html><head><title>Hana, 中2 model</title><meta property="og:image" content="https://site.example/hana.jpg"></head><body><p>text</p></body></html>"""
+        val kidPage = space()
+        kidPage.begin(OutingKind.Parsed.Read("https://site.example/hana", "https://site.example/hana"))
+        assertEquals("skipped: a kid (中2)", kidPage.run(OutingStep.Verb.Look(1)).line)
+        assertTrue(sources.images.isEmpty())
+
+        sources.page = """<html><head><title>A park</title><meta property="og:image" content="https://site.example/park.jpg"><link rel="alternate" type="application/rss+xml" href="https://site.example/feed.xml"></head><body><p>A park in Setagaya with a playground and old trees.</p></body></html>"""
+        val space = space()
+        space.begin(OutingKind.Parsed.Read("https://site.example/park", "https://site.example/park"))
+        assertTrue(space.canFollow)
+        assertNull(space.kidInFront)
+        eyes.seen.addLast(described("A playground with a slide, and a woman on a bench.", "ages: child, adult"))
+        val did = space.run(OutingStep.Verb.Look(1))
+        assertEquals(KidGuard.Group.CHILD, did.kidSeen?.group)
+        assertEquals(KidGuard.Group.CHILD, space.kidInFront?.group)
+        assertFalse(space.canFollow)
+        val front = OutingPrompt.inFront(space.view)
+        // The mark and why only: the describer's words about a kid are withheld.
+        assertTrue(front, front.contains("picture 1: kid: the app marks this picture kid (the describer saw a child), so it does not show you the describer's words."))
+        assertFalse(front.contains("A playground with a slide"))
+        assertTrue(front.contains("kid: the app marks this page as by or about a child or a teen (the describer saw a child). it is not followed."))
+        assertEquals("skipped: a kid (the describer saw a child)", space.run(OutingStep.Verb.Follow(null)).line)
+    }
+
+    @Test
+    fun `a description without an ages line is unchecked, counted, and its words are not shown`() = runBlocking {
+        val space = space()
+        space.begin(OutingKind.Parsed.Read("https://site.example/egg", "https://site.example/egg"))
+        eyes.seen.addLast(HerEyes.Seen.Described("UNCHECKED_SENTINEL a woman by a window.", KidGuard.Ages.Unchecked))
+        val did = space.run(OutingStep.Verb.Look(1))
+        assertTrue(did.unchecked)
+        assertTrue(did.looked)
+        assertNull(did.kidSeen)
+        val front = OutingPrompt.inFront(space.view)
+        assertFalse(front.contains("UNCHECKED_SENTINEL"))
+        assertTrue(front, front.contains("picture 1: looked at, but the describer did not say whether anyone in it is a child or a teen, so the app does not show its words."))
+    }
+
+    @Test
+    fun `what her eyes could not do is said, and a look counts only where the picture went out`() = runBlocking {
+        val space = space()
+        space.begin(OutingKind.Parsed.Read("https://site.example/egg", "https://site.example/egg"))
+        eyes.seen.addLast(HerEyes.Seen.NotSeen(HerEyes.Why.TOO_SMALL))
+        val small = space.run(OutingStep.Verb.Look(1))
+        assertEquals("picture 1 was not described: the picture is too small to be worth a look", small.line)
+        assertFalse(small.looked)
+        assertEquals(HerEyes.Why.TOO_SMALL, small.notSeen)
+        assertEquals(6, space.looksLeft)
+        eyes.seen.addLast(HerEyes.Seen.NotSeen(HerEyes.Why.BALANCE))
+        val balance = space.run(OutingStep.Verb.Look(1))
+        assertEquals("picture 1 was not described: the venice balance is too low", balance.line)
+        assertTrue(balance.looked)
+        assertEquals(5, space.looksLeft)
+        // Both times the fetched bytes were zeroed.
+        assertTrue(sources.given.all { bytes -> bytes.all { it == 0.toByte() } })
+    }
+
+    @Test
+    fun `a picture's address that would carry his name is not fetched`() = runBlocking {
+        sources.page = """<html><head><title>x</title><meta property="og:image" content="https://cdn.example/renmizuno/avatar.jpg"></head><body><p>a page of text here for her to read.</p></body></html>"""
+        val space = space()
+        space.begin(OutingKind.Parsed.Read("https://site.example/x", "https://site.example/x"))
+        val did = space.run(OutingStep.Verb.Look(1))
+        assertEquals(OutgoingGuard.TOLD, did.line)
+        assertNotNull(did.refusal)
+        assertTrue(sources.images.isEmpty())
+        assertEquals(1, space.guardRefusals)
+    }
+
+    @Test
+    fun `look is read from her do line`() {
+        assertEquals(OutingStep.Verb.Look(2), OutingStep.verb("look 2"))
+        assertEquals(OutingStep.Verb.Look(2), OutingStep.verb("look [2]"))
+        assertEquals(OutingStep.Verb.Look(3), OutingStep.verb("look at picture 3"))
+        assertEquals(OutingStep.Verb.Look(3), OutingStep.verb("Look at 3."))
+        assertEquals(OutingStep.Verb.Look(1), OutingStep.verb("look picture #1"))
+        assertNull(OutingStep.verb("look"))
+        assertNull(OutingStep.verb("look 0"))
+        assertNull(OutingStep.verb("look at the cat"))
+        assertEquals(OutingStep.Next.Run(OutingStep.Verb.Look(1)), OutingStep.parse("<< cute\ndo: look 1").next)
+    }
+}
