+/** A macro's or a routine's run goes on the record of what the phone did, with every step inside it. */
+class ActionSequenceRecordTest {
+    private val context: Context = ContextWrapper(null)
+    private val recorded = mutableListOf<PhoneLogEntry>()
+    private val recorder = PhoneRecorder { recorded += it }
+
+    private fun executor(execute: suspend (String, Map<String, String>) -> ActionResult) =
+        ActionSequenceExecutor({ action, params, _ -> execute(action, params) }, { true }, recorder, clock = { 42L })
+
+    private fun step(id: String, order: Int, action: String, params: Map<String, String> = emptyMap()) =
+        PlanStep(stepId = id, order = order, description = "", action = action, params = params)
+
+    @Test
+    fun `a macro's run is one entry under its name, with each step and its words, and no results`() = runBlocking {
+        val result = executor { action, _ ->
+            if (action == "READ_NOTIFICATIONS") ActionResult.Success(mapOf("message" to "Mom: the party is at 8")) else ActionResult.Success()
+        }.execute(
+            listOf(
+                step("s1", 1, "READ_NOTIFICATIONS"),
+                step("s2", 2, "SEND_SMS", mapOf("contact" to "Aoi", "message" to "Mom wrote: \$s1"))
+            ),
+            context,
+            SequenceRun.macro("party news")
+        )
+        assertTrue(result.success)
+        val entry = recorded.single()
+        assertEquals(Starter.MACRO, entry.who)
+        assertEquals("party news", entry.why)
+        assertEquals(42L, entry.at)
+        assertEquals(null as LetThrough?, entry.letThrough)
+        assertEquals(listOf(StepEnd.DONE, StepEnd.DONE), entry.steps.map { it.end })
+        assertEquals(Outcome.DONE, entry.outcome)
+        assertEquals("Mom wrote: [the answer to step 1]", entry.steps[1].words.single().text)
+        assertFalse(Json.encodeToString(entry).contains("party is at 8"))
+    }
+
+    @Test
+    fun `a routine that stops at a step says what failed, what was left open and what never ran`() = runBlocking {
+        executor { action, _ ->
+            when (action) {
+                "SEND_EMAIL" -> ActionResult.UserActionRequired("Email draft opened. Review it and tap Send; sending was not verified.")
+                else -> ActionResult.Success()
+            }
+        }.execute(
+            listOf(
+                step("s1", 1, "TOGGLE_WIFI"),
+                step("s2", 2, "SEND_EMAIL", mapOf("to" to "a@b.c", "subject" to "hi", "body" to "hello")),
+                step("s3", 3, "SET_ALARM")
+            ),
+            context,
+            SequenceRun.routine("weekday morning")
+        )
+        val entry = recorded.single()
+        assertEquals(Starter.ROUTINE, entry.who)
+        assertEquals(listOf(StepEnd.DONE, StepEnd.LEFT_OPEN, StepEnd.NOT_RUN), entry.steps.map { it.end })
+        assertEquals(Outcome.PARTLY, entry.outcome)
+
+        recorded.clear()
+        executor { _, _ -> ActionResult.Failure("No clock app.") }
+            .execute(listOf(step("s1", 1, "SET_ALARM")), context, SequenceRun.routine("weekday morning"))
+        assertEquals(StepEnd.FAILED, recorded.single().steps.single().end)
+        assertEquals("No clock app.", recorded.single().steps.single().reason)
+    }
+
+    @Test
+    fun `a run that is stopped still goes on the record, with the step under way not called done`() {
+        try {
+            runBlocking {
+                executor { action, _ -> if (action == "SEND_SMS") throw CancellationException("stopped") else ActionResult.Success() }
+                    .execute(
+                        listOf(step("s1", 1, "TOGGLE_WIFI"), step("s2", 2, "SEND_SMS", mapOf("contact" to "Aoi", "message" to "hi"))),
+                        context,
+                        SequenceRun.macro("m")
+                    )
+            }
+        } catch (expected: CancellationException) {
+            // The run was stopped.
+        }
+        assertEquals(listOf(StepEnd.DONE, StepEnd.INTERRUPTED), recorded.single().steps.map { it.end })
+        assertEquals(Outcome.STOPPED, recorded.single().outcome)
+    }
+
+    @Test
+    fun `steps run without a name are not recorded here`() = runBlocking {
+        executor { _, _ -> ActionResult.Success() }.execute(listOf(step("s1", 1, "TOGGLE_WIFI")), context)
+        assertTrue(recorded.isEmpty())
+    }
+
+    @Test
+    fun `a run is dated by when it began and when it ended`() = runBlocking {
+        var now = 100L
+        ActionSequenceExecutor({ _, _, _ -> now += 50; ActionResult.Success() }, { true }, recorder, clock = { now })
+            .execute(listOf(step("s1", 1, "TOGGLE_WIFI"), step("s2", 2, "SET_ALARM")), context, SequenceRun.routine("morning"))
+        val entry = recorded.single()
+        assertEquals(100L, entry.at)
+        assertEquals(200L, entry.endedAt)
+    }
+
+    @Test
+    fun `a step whose fallback ran is recorded as the fallback`() = runBlocking {
+        val result = executor { action, _ ->
+            if (action == "SEND_WHATSAPP") ActionResult.Failure("WhatsApp is not installed.") else ActionResult.Success()
+        }.execute(
+            listOf(step("s1", 1, "SEND_WHATSAPP", mapOf("contact" to "Mom", "message" to "running late")).copy(fallback = "SEND_SMS")),
+            context,
+            SequenceRun.routine("leaving work")
+        )
+        assertTrue(result.success)
+        val sent = recorded.single().steps.single()
+        assertEquals("Send SMS to Mom", sent.line)
+        assertEquals("Messages", sent.app)
+        assertEquals("Send whatsapp", sent.insteadOf)
+        assertEquals("running late", sent.words.single().text)
+        assertEquals(StepEnd.DONE, sent.end)
+    }
+
+    @Test
+    fun `a run stopped while a fallback was under way names the fallback as the step under way`() {
+        try {
+            runBlocking {
+                executor { action, _ ->
+                    when (action) {
+                        "SEND_WHATSAPP" -> ActionResult.Failure("WhatsApp is not installed.")
+                        else -> throw CancellationException("stopped")
+                    }
+                }.execute(
+                    listOf(step("s1", 1, "SEND_WHATSAPP", mapOf("contact" to "Mom", "message" to "running late")).copy(fallback = "SEND_SMS")),
+                    context,
+                    SequenceRun.macro("m")
+                )
+            }
+        } catch (expected: CancellationException) {
+            // The run was stopped.
+        }
+        val step = recorded.single().steps.single()
+        assertEquals("Send SMS to Mom", step.line)
+        assertEquals("Send whatsapp", step.insteadOf)
+        assertEquals(StepEnd.INTERRUPTED, step.end)
+    }
+
+    @Test
+    fun `steps kept back before the run stand in their places on the record, as not run and why`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        executor { action, _ -> dispatched += action; ActionResult.Success() }.execute(
+            listOf(step("s2", 2, "TOGGLE_WIFI"), step("s4", 4, "SET_ALARM")),
+            context,
+            SequenceRun.macro(
+                "evening",
+                leftOut = listOf(
+                    SequenceRun.LeftOut(3, step("s3", 3, "SEND_SMS", mapOf("contact" to "56767", "message" to "STOP")), "56767 is an SMS short code, which only sends"),
+                    SequenceRun.LeftOut(1, step("s1", 1, "AUTO_REPLY_TOGGLE"), "auto-reply is off in this build"),
+                    // A place past the end is not lost: it comes last.
+                    SequenceRun.LeftOut(9, step("s9", 9, "OPEN_APP", mapOf("appName" to "Maps")), "it uses what a skipped step would have returned")
+                )
+            )
+        )
+        // The executor never saw them.
+        assertEquals(listOf("TOGGLE_WIFI", "SET_ALARM"), dispatched)
+        val entry = recorded.single()
+        assertEquals(
+            listOf(StepEnd.NOT_RUN, StepEnd.DONE, StepEnd.NOT_RUN, StepEnd.DONE, StepEnd.NOT_RUN),
+            entry.steps.map { it.end }
+        )
+        assertEquals(
+            listOf(
+                "auto-reply is off in this build", null, "56767 is an SMS short code, which only sends", null,
+                "it uses what a skipped step would have returned"
+            ),
+            entry.steps.map { it.reason }
+        )
+        assertEquals("Send SMS to 56767", entry.steps[2].line)
+        assertEquals(Outcome.PARTLY, entry.outcome)
+    }
+
+    @Test
+    fun `a macro none of whose steps ran is on the record as not run`() {
+        executor { _, _ -> error("must not dispatch") }.recordNothingRan(
+            SequenceRun.macro("bedtime", leftOut = listOf(SequenceRun.LeftOut(1, step("s1", 1, "AUTO_REPLY_TOGGLE"), "auto-reply is off in this build")))
+        )
+        val entry = recorded.single()
+        assertEquals(Starter.MACRO, entry.who)
+        assertEquals("bedtime", entry.why)
+        assertEquals(listOf(StepEnd.NOT_RUN), entry.steps.map { it.end })
+        assertEquals(Outcome.NOT_RUN, entry.outcome)
+        assertEquals(null as LetThrough?, entry.letThrough)
+
+        // Without a step kept back there is nothing to tell.
+        recorded.clear()
+        executor { _, _ -> error("must not dispatch") }.recordNothingRan(SequenceRun.macro("empty"))
+        assertTrue(recorded.isEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/AliasResolverWholeMessageTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/AliasResolverWholeMessageTest.kt
new file mode 100644
index 0000000..035d47c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/AliasResolverWholeMessageTest.kt
@@ -0,0 +1,171 @@
+package com.opendroid.ai.core.agent
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * [AliasResolver.resolveWhole]: an alias counts only when the message is nothing else.
+ * [AliasResolver.resolve], which also finds an alias inside a sentence, is left as it was.
+ */
+class AliasResolverWholeMessageTest {
+
+    private fun whole(input: String) = AliasResolver.resolveWhole(input)
+
+    @Test
+    fun `an alias from the table matches with or without please, an article or my`() {
+        assertEquals("TOGGLE_FLASHLIGHT", whole("flashlight")?.action)
+        assertEquals("TOGGLE_FLASHLIGHT", whole("Flashlight!")?.action)
+        assertEquals("on", whole("turn on the flashlight")?.baseParams?.get("state"))
+        assertEquals("off", whole("please turn off my flashlight")?.baseParams?.get("state"))
+        assertEquals("TAKE_SCREENSHOT", whole("take a screenshot please")?.action)
+        assertEquals("TAKE_SCREENSHOT", whole("screenshot now")?.action)
+        assertEquals("LOCK_SCREEN", whole("lock my phone")?.action)
+        assertEquals("OPEN_APP", whole("open the camera")?.action)
+        assertEquals("READ_NOTES", whole("show my notes")?.action)
+        assertEquals("CLEAR_CLIPBOARD", whole("clear the clipboard for me")?.action)
+    }
+
+    @Test
+    fun `an alias inside a sentence does not match, where the stock resolver finds it`() {
+        for (input in listOf(
+            "what do you see in me", "i left the wifi on at home", "remember this screen from last night",
+            "you could take a screenshot of that face", "that was a do not disturb kind of day",
+            "max volume is how i like you"
+        )) {
+            assertNull(input, whole(input))
+        }
+        // The stock resolver is unchanged and still looks inside the sentence.
+        assertEquals("TOGGLE_WIFI", AliasResolver.resolve("i left the wifi on at home")?.action)
+    }
+
+    @Test
+    fun `a word that is also ordinary talk has to stand alone`() {
+        assertEquals("LOCK_SCREEN", whole("sleep")?.action)
+        assertEquals("LOCK_SCREEN", whole("Sleep.")?.action)
+        assertNull(whole("sleep now"))
+        assertNull(whole("please sleep"))
+        assertNull(whole("the light"))
+        assertEquals("SET_VOLUME", whole("silent mode")?.action)
+        assertNull(whole("silent mode please"))
+
+        assertTrue(AliasResolver.isTalkWord("Sleep."))
+        assertTrue(AliasResolver.isTalkWord("silent mode"))
+        assertFalse(AliasResolver.isTalkWord("flashlight"))
+        assertFalse(AliasResolver.isTalkWord("sleep now"))
+    }
+
+    @Test
+    fun `a level is read only when the message is the level`() {
+        assertEquals(mapOf("level" to "30"), whole("set brightness to 30%")?.baseParams)
+        assertEquals(mapOf("level" to "60"), whole("brightness 60")?.baseParams)
+        assertEquals(mapOf("level" to "100"), whole("brightness 250")?.baseParams)
+        assertEquals(mapOf("level" to "50"), whole("set brightness")?.baseParams)
+        assertEquals(mapOf("type" to "media", "level" to "40"), whole("volume to 40")?.baseParams)
+        assertEquals(mapOf("type" to "media", "level" to "70"), whole("set the volume at 70 percent")?.baseParams)
+
+        for (input in listOf(
+            "the volume was at 40 when i left", "brightness 60 hurts my eyes", "i turned 30 and my brightness faded"
+        )) {
+            assertNull(input, whole(input))
+        }
+        // The stock resolver takes any sentence with the word and a number.
+        assertEquals("SET_BRIGHTNESS", AliasResolver.resolve("brightness 60 hurts my eyes")?.action)
+    }
+
+    @Test
+    fun `a switching verb or a state around one alias word is a command, with the state it names`() {
+        assertEquals(mapOf("state" to "toggle"), whole("toggle wifi")?.baseParams)
+        assertEquals(mapOf("state" to "on"), whole("switch on the torch")?.baseParams)
+        assertEquals(mapOf("state" to "off"), whole("switch off the torch")?.baseParams)
+        assertEquals(mapOf("state" to "off"), whole("turn bluetooth off")?.baseParams)
+        assertEquals(mapOf("state" to "on"), whole("tethering on")?.baseParams)
+        assertEquals(mapOf("state" to "on"), whole("turn on the light")?.baseParams)
+        // The device named after the word makes it an order as well.
+        assertEquals("SET_VOLUME", whole("mute the phone")?.action)
+        assertEquals("LOCK_SCREEN", whole("lock my device")?.action)
+        // No state to set: "on" runs the alias as it is.
+        assertEquals("OPEN_APP", whole("turn on camera")?.action)
+        // And "off" asks for the opposite of what the alias does, so it is no shortcut.
+        assertNull(whole("turn off mute"))
+        assertNull(whole("disable lock"))
+        assertNull(whole("turn off silent"))
+        // A word that is no alias is no command.
+        assertNull(whole("turn on the charm"))
+        assertNull(whole("enable it"))
+    }
+
+    @Test
+    fun `a question is not a shortcut, except a question about the screen`() {
+        for (input in listOf(
+            "what's the weather", "whats the weather?", "weather?", "who do i talk to most",
+            "what are my preferences", "what's in clipboard", "is the wifi on", "flashlight?"
+        )) {
+            assertNull(input, whole(input))
+        }
+        for (input in listOf("what's on my screen", "what's on my screen?", "what do you see", "what do you see?")) {
+            assertEquals(input, "ANALYZE_SCREENSHOT", whole(input)?.action)
+        }
+        // "do not disturb" opens like a question and is none.
+        assertEquals("TOGGLE_DND", whole("do not disturb")?.action)
+        // A polite request is a command, and its question mark belongs to the politeness.
+        assertEquals("TAKE_SCREENSHOT", whole("can you take a screenshot?")?.action)
+        assertNull(whole("can you verify silent mode is on?"))
+    }
+
+    @Test
+    fun `a youtube search spans the message`() {
+        assertEquals(
+            AliasResolver.ActionHint("PLAY_YOUTUBE", mapOf("query" to "lofi beats")),
+            whole("open youtube and search lofi beats")
+        )
+        assertEquals("cat videos", whole("search cat videos on youtube")?.baseParams?.get("query"))
+        assertNull(whole("youtube"))
+    }
+
+    @Test
+    fun `a fact dictated after remember this is not the screen shortcut`() {
+        assertEquals("READ_AND_REMEMBER_SCREEN", whole("remember this")?.action)
+        assertNull(whole("remember this: my locker code is 4512"))
+        assertNull(whole(""))
+        assertNull(whole("   "))
+        assertNull(whole("the"))
+    }
+
+    @Test
+    fun `a question about the screen is recognised with more words behind it`() {
+        for (input in listOf(
+            "read my screen", "Read the screen.", "read my screen and tell me what it says",
+            "read screen, what does the error mean", "what's on my screen right now", "whats on screen today",
+            "look at my screen and tell me who wrote", "describe my screen in detail please",
+            "analyze screen for me", "screenshot and analyze this page", "what do you see there"
+        )) {
+            assertTrue(input, AliasResolver.opensWithScreenQuestion(input))
+        }
+        // The phrase has to open the message, as whole words.
+        for (input in listOf(
+            "can't read my screen in this light", "i read screens all day", "read my screenplay",
+            "take a screenshot", "screenshot", "remember this screen", "what did you see", ""
+        )) {
+            assertFalse(input, AliasResolver.opensWithScreenQuestion(input))
+        }
+        // Whether more follows is all it adds: the whole-message matcher is as it was.
+        assertNull(whole("read my screen and tell me what it says"))
+        assertEquals("ANALYZE_SCREENSHOT", whole("read my screen")?.action)
+    }
+
+    @Test
+    fun `a follow-up phrase can be left to whoever he is talking to`() {
+        val last = "TOGGLE_FLASHLIGHT"
+        assertEquals("off", AliasResolver.resolveContextual("stop it", last, null)?.baseParams?.get("state"))
+        assertNull(AliasResolver.resolveContextual("stop it", last, null, AliasResolver.talkFollowUps))
+        assertNull(AliasResolver.resolveContextual("no, stop it please", last, null, AliasResolver.talkFollowUps))
+        assertNull(AliasResolver.resolveContextual("start it", last, null, AliasResolver.talkFollowUps))
+        assertEquals(
+            "off",
+            AliasResolver.resolveContextual("turn it off", last, null, AliasResolver.talkFollowUps)?.baseParams?.get("state")
+        )
+    }
+}
