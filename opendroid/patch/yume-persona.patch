+        // Through the engine her page is what decides: the keys it showed are handed back from it.
+        val engine = java.io.File("src/main/java/com/opendroid/ai/core/persona/PersonaEngine.kt").readText()
+        val moment = engine.substringAfter("suspend fun ownMoment(").substringBefore("private fun momentFacts(")
+        assertTrue(moment.contains("openThreads = PersonaOwnTime.openThreads(notebook, shownKeys),"))
+        assertTrue(moment.contains("shownNotes = { shownKeys = it }"))
