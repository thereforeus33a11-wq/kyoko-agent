@@ -0,0 +1,34 @@
+package com.opendroid.ai.core.service
+
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * The local MCP server runs any action or shell command for whoever holds its token,
+ * with no approval prompt. It is started only when the owner has switched it on.
+ */
+class McpServerSwitchTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    @Test
+    fun `the local MCP server is off unless he switches it on`() {
+        assertFalse(LLMConfig().mcpServerEnabled)
+        val service = File(main, "core/service/OpenDroidService.kt").readText()
+        // Started in one place only, and only for the setting.
+        assertEquals(1, Regex("""mcpServer\.start\(\)""").findAll(service).count())
+        val apply = service.substringAfter("private fun applyMcpServerSetting(enabled: Boolean) {").substringBefore("\n    }\n")
+        // Switched off, it is stopped; whatever is wanted last is what is applied.
+        assertTrue(apply.contains("if (mcpServerWanted) mcpServer.start() else mcpServer.stop()"))
+        assertTrue(service.contains("applyMcpServerSetting(config.mcpServerEnabled)"))
+        val onCreate = service.substringAfter("override fun onCreate() {").substringBefore("serviceScope.launch {")
+        assertFalse(onCreate.contains("mcpServer"))
+        // It never outlives the service.
+        val onDestroy = service.substringAfter("override fun onDestroy() {").substringBefore("\n    }\n")
+        assertTrue(onDestroy.contains("mcpServer.stop()"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/service/ServiceNotificationTextTest.kt b/app/src/test/java/com/opendroid/ai/core/service/ServiceNotificationTextTest.kt
new file mode 100644
