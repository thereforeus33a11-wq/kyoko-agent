+    /** The enclave did not check out: reported as that, and as nothing having been sent. */
+    private fun assertNotSent(failure: LLMException) {
+        assertEquals(LLMError.EncryptionCheckFailed, failure.error)
+        assertFalse("nothing was sent", failure.replyDiscarded)
+        assertFalse("a failed check is not tried again by itself", failure.retryable)
+    }
+
+    /** The reply was not private: reported as that, not as a lost connection or a bad answer. */
+    private fun assertDiscarded(failure: LLMException) {
+        assertEquals(LLMError.EncryptionCheckFailed, failure.error)
+        assertTrue("the reply was thrown away", failure.replyDiscarded)
+        assertFalse(failure.retryable)
+    }
