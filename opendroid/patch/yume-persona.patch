+/** Providers whose host moderates what its models write, whatever the app sends. */
+internal val MODERATING_HOSTS = setOf("Google Gemini", "OpenAI", "Anthropic Claude", "Mistral AI", "Cohere", "Copilot API")
+
+/** The provider that writes her replies with these settings: the one chosen for them, else the main one. */
+internal fun personaReplyProvider(config: LLMConfig): String {
+    val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+    return if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) chosen else ProviderCatalog.canonicalName(config.activeProvider)
+}
+
+/** What is said under the provider field when her replies would be written on a host that moderates; null otherwise. */
+internal fun moderationNotice(config: LLMConfig): String? {
+    val provider = personaReplyProvider(config)
+    if (provider !in MODERATING_HOSTS) return null
+    return "$provider moderates what its models write. It can refuse a reply of hers, cut it off or tone it " +
+        "down, and no setting in this app changes that. Choose another provider for her replies if you do not want it."
+}
