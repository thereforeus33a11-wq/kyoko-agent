+package com.opendroid.ai.core.llm.providers
+
+import java.io.IOException
+import java.math.BigInteger
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The encryption has to interoperate with code this project does not control, so it is
+ * checked against values produced outside it: public curve constants, an RFC 5869 test
+ * case, and messages encrypted by the reference algorithm from Venice's published guide.
+ */
+class VeniceE2eeTest {
+
+    private class Vector(val privateKey: String, val publicKey: String, val blob: String, val text: String)
+    private class Agreement(val a: String, val publicB: String, val shared: String)
+
+    // Encrypted by the reference Python from the provider's guide to the public key of each private key.
+    private val referenceMessages = listOf(
+        Vector("0101010101010101010101010101010101010101010101010101010101010101", "041b84c5567b126440995d3ed5aaba0565d71e1834604819ff9c17f5e9d5dd078f70beaf8f588b541507fed6a642c5ab42dfdf8120a7f639de5122d47a69a8e8d1", "0479fd18426db9a848c7ebcf58f75cea2e5702be2bc3ba3568a341d61e1563b86ee6572a37a294feaa5cd40c7e9d9bd7e59d15a335cedef6426e93f8d2fc1c6fe4c58c5b69918886942667cbde37ff08f2f634899fa6e4e3636bb2bee855c14ef7", "pong"),
+        Vector("0202020202020202020202020202020202020202020202020202020202020202", "044d4b6cd1361032ca9bd2aeb9d900aa4d45d9ead80ac9423374c451a7254d07662a3eada2d0fe208b6d257ceb0f064284662e857f57b66b54c198bd310ded36d0", "0445148723b0b1c52be0c0c77ddd79ef19b9b44e05c4f4f69ca9c4515773b4e469e7a62d521698f176ad29d495c3dea96d1d609086ea25c90d52238b58f7b810e61c741be31fd6d64bc3b5653604389346faa8f4136e101f0a177197a4d1a58d58943941a520deb3928c07176f50", "tch. dasai. fixed"),
+        Vector("0303030303030303030303030303030303030303030303030303030303030303", "04531fe6068134503d2723133227c867ac8fa6c83c537e9a44c3c5bdbdcb1fe3379e92c265e71e481ba82a84675a47ac705a200fcd524e92d93b0e7386f26a5458", "0484f4e3dede5ddcacb69ed854b69f509c5fe0db8ebbf8086ab0a2e8c9f257b6392b4a11bc116a6af64b053b67c8449df64ad9371ceda65cb7bdde632d90fe1716e5cd7b21aaab8db5e8ae84af403a468c291213b799818c2c74c2c6551beb9f5c8978606fcdd14a38756e58acb5e6e9f2021d6390", "oniisan~ ichiman ♡ www")
+    )
+
+    // a * (bG) computed by an independent secp256k1 implementation.
+    private val agreements = listOf(
+        Agreement("3", "045cbdf0646e5db4eaa398f365f2ea7a0e3d419b7e0330e39ce92bddedcac4f9bc6aebca40ba255960a3178d6d861a54dba813d0b813fde7b5a5082628087264da", "352bbf4a4cdd12564f93fa332ce333301d9ad40271f8107181340aef25be59d5"),
+        Agreement("1234567890abcdef", "040fd109be4a9e07d64737926c7e2d8d7afa63ec5991d126b8abe7919d3c62a7be6eac7732c97ce0145acd0545eb54a481b9b5a54598c03a1b97b3328b75abef4c", "31d81b1b68b98025811c7e773520130f1646661e83d54a0f607f7f04558de5f3"),
+        Agreement("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd036413f", "042f8bde4d1a07209355b4a7250a5c5128e88b84bddc619ab7cba8d569b240efe4d8ac222636e5e3d6d4dba9dda6c9c426f788271bab0d6840dca87d3aa6ac62d6", "a0434d9e47f3c86235477c7b1ae6ae5d3442d49b1943c2b752a68e2a47e247c7")
+    )
+
+    @Test
+    fun `the curve arithmetic matches published secp256k1 values`() {
+        assertEquals(VeniceE2ee.hex(Secp256k1.encode(Secp256k1.G)), VeniceE2ee.hex(Secp256k1.encode(Secp256k1.multiply(Secp256k1.G, BigInteger.ONE))))
+        val twoG = Secp256k1.multiply(Secp256k1.G, BigInteger.valueOf(2))
+        assertEquals("c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5", twoG.x!!.toString(16))
+        assertEquals("1ae168fea63dc339a3c58419466ceaeef7f632653266d0e1236431a950cfe52a", twoG.y!!.toString(16))
+        assertTrue(Secp256k1.multiply(Secp256k1.G, Secp256k1.N).isInfinity)
+    }
+
+    @Test
+    fun `key agreement matches an independent implementation`() {
+        for (agreement in agreements) {
+            val shared = Secp256k1.multiply(
+                Secp256k1.decode(VeniceE2ee.unhex(agreement.publicB)),
+                BigInteger(agreement.a, 16)
+            )
+            assertEquals(agreement.shared, VeniceE2ee.hex(Secp256k1.to32Bytes(shared.x!!)))
+        }
+    }
+
+    @Test
+    fun `a public key that is not on the curve is refused`() {
+        val offCurve = "04" + "11".repeat(64)
+        assertThrows(IOException::class.java) { Secp256k1.decode(VeniceE2ee.unhex(offCurve)) }
+        assertThrows(IOException::class.java) { VeniceE2ee.encrypt("hi", offCurve) }
+        assertThrows(IOException::class.java) { Secp256k1.decode(VeniceE2ee.unhex("02" + "11".repeat(32))) }
+    }
+
+    @Test
+    fun `key derivation matches RFC 5869 test case 3`() {
+        val okm = VeniceE2ee.hkdfSha256(ByteArray(22) { 0x0b }, ByteArray(0), 42)
+        assertEquals(
+            "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
+            VeniceE2ee.hex(okm)
+        )
+    }
+
+    @Test
+    fun `messages encrypted by the reference implementation are read correctly`() {
+        for (vector in referenceMessages) {
+            assertEquals(vector.text, VeniceE2ee.decrypt(vector.blob, BigInteger(vector.privateKey, 16)))
+        }
+    }
+
+    @Test
+    fun `the public key derived here is the one the reference derives`() {
+        for (vector in referenceMessages) {
+            val derived = Secp256k1.encode(Secp256k1.multiply(Secp256k1.G, BigInteger(vector.privateKey, 16)))
+            assertEquals(vector.publicKey, VeniceE2ee.hex(derived))
+        }
+    }
+
+    @Test
+    fun `what is encrypted here can only be read with the matching key`() {
+        val recipient = VeniceE2ee.generateKeyPair()
+        val stranger = VeniceE2ee.generateKeyPair()
+        val text = "he sold the hives. finally \u2661"
+
+        val sealed = VeniceE2ee.encrypt(text, recipient.publicKeyHex)
+
+        assertTrue(VeniceE2ee.looksEncrypted(sealed))
+        assertFalse(sealed.contains("hives"))
+        assertEquals(text, VeniceE2ee.decrypt(sealed, recipient.privateKey))
+        assertThrows(Exception::class.java) { VeniceE2ee.decrypt(sealed, stranger.privateKey) }
+        // A key given without the 04 prefix is the same key.
+        assertEquals(text, VeniceE2ee.decrypt(VeniceE2ee.encrypt(text, recipient.publicKeyHex.drop(2)), recipient.privateKey))
+    }
+
+    @Test
+    fun `a tampered message is rejected, not misread`() {
+        val keys = VeniceE2ee.generateKeyPair()
+        val sealed = VeniceE2ee.encrypt("ok", keys.publicKeyHex)
+        val last = sealed.last()
+        val tampered = sealed.dropLast(1) + (if (last == '0') '1' else '0')
+        assertThrows(Exception::class.java) { VeniceE2ee.decrypt(tampered, keys.privateKey) }
+        assertThrows(IOException::class.java) { VeniceE2ee.decrypt("abcd", keys.privateKey) }
+    }
+
+    @Test
+    fun `two encryptions of the same text never look alike`() {
+        val keys = VeniceE2ee.generateKeyPair()
+        assertFalse(VeniceE2ee.encrypt("same", keys.publicKeyHex) == VeniceE2ee.encrypt("same", keys.publicKeyHex))
+    }
+
+    @Test
+    fun `plain text is not mistaken for an encrypted message`() {
+        assertFalse(VeniceE2ee.looksEncrypted("mm. later"))
+        assertFalse(VeniceE2ee.looksEncrypted("deadbeef"))
+        assertFalse(VeniceE2ee.looksEncrypted(""))
+        assertTrue(VeniceE2ee.isE2eeModel("e2ee-some-model"))
+        assertFalse(VeniceE2ee.isE2eeModel("some-model-e2ee-"))
+    }
+
+    @Test
+    fun `the enclave's key is accepted only from an attestation that checks out`() {
+        val key = VeniceE2ee.generateKeyPair().publicKeyHex
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        assertEquals(64, nonce.length)
+        val quote = TestEnclave.hex(TestEnclave.quote(key, nonce))
+
+        assertEquals(key, VeniceE2ee.modelKeyFromAttestation(TestEnclave.attestation(model, nonce, key, quote), nonce, model))
+        assertEquals(
+            key,
+            VeniceE2ee.modelKeyFromAttestation(
+                TestEnclave.attestation(model, nonce, key, quote, keyField = "signing_public_key"), nonce, model
+            )
+        )
+        // The quote is served as base64 by some enclaves and in the newer layout by others.
+        assertEquals(
+            key,
+            VeniceE2ee.modelKeyFromAttestation(
+                TestEnclave.attestation(model, nonce, key, TestEnclave.base64(TestEnclave.quote(key, nonce, version = 5))), nonce, model
+            )
+        )
+        // A key served without its 04 prefix is the same key and binds the same way.
+        val bare = key.drop(2)
+        assertEquals(
+            bare,
+            VeniceE2ee.modelKeyFromAttestation(
+                TestEnclave.attestation(model, nonce, bare, TestEnclave.hex(TestEnclave.quote(bare, nonce))), nonce, model
+            )
+        )
+
+        val bad = mapOf(
+            "not verified" to TestEnclave.attestation(model, nonce, key, quote, verified = "false"),
+            "verified as text" to TestEnclave.attestation(model, nonce, key, quote, verified = "\"true\""),
+            "someone else's nonce" to TestEnclave.attestation(model, "someone-elses", key, quote),
+            "no nonce" to TestEnclave.attestation(model, null, key, quote),
+            "another model" to TestEnclave.attestation("e2ee-other-model", nonce, key, quote),
+            "no model" to TestEnclave.attestation(null, nonce, key, quote),
+            "no key" to TestEnclave.attestation(model, nonce, null, quote),
+            "a key off the curve" to TestEnclave.attestation(model, nonce, "04${"11".repeat(64)}", quote),
+            "no quote" to TestEnclave.attestation(model, nonce, key, null),
+            "an empty quote" to TestEnclave.attestation(model, nonce, key, ""),
+            "a quote that is not one" to TestEnclave.attestation(model, nonce, key, "abcd"),
+            "not json" to "not json",
+            "verified missing" to """{"nonce":"$nonce","model":"$model","signing_key":"$key","intel_quote":"$quote"}"""
+        )
+        for ((what, body) in bad) {
+            assertThrows(what, IOException::class.java) { VeniceE2ee.modelKeyFromAttestation(body, nonce, model) }
+        }
+    }
+
+    @Test
+    fun `a key served without its prefix is read by its length, even when it begins with 04`() {
+        // About one key in 256 has a first coordinate that itself starts with 04.
+        val keyPair = generateSequence(BigInteger.valueOf(7)) { it + BigInteger.ONE }
+            .map { VeniceE2ee.KeyPair(it, VeniceE2ee.hex(Secp256k1.encode(Secp256k1.multiply(Secp256k1.G, it)))) }
+            .first { it.publicKeyHex.startsWith("0404") }
+        val bare = keyPair.publicKeyHex.drop(2)
+        assertTrue(bare.startsWith("04"))
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+
+        val body = TestEnclave.attestation(model, nonce, bare, TestEnclave.hex(TestEnclave.quote(bare, nonce)))
+        assertEquals(bare, VeniceE2ee.modelKeyFromAttestation(body, nonce, model))
+        assertEquals("mm", VeniceE2ee.decrypt(VeniceE2ee.encrypt("mm", bare), keyPair.privateKey))
+    }
+
+    @Test
+    fun `a key the hardware quote does not carry is refused`() {
+        val enclaveKey = VeniceE2ee.generateKeyPair().publicKeyHex
+        val relayKey = VeniceE2ee.generateKeyPair().publicKeyHex
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        // The relay hands out its own key beside a quote that vouches for the enclave's.
+        val swapped = TestEnclave.attestation(model, nonce, relayKey, TestEnclave.hex(TestEnclave.quote(enclaveKey, nonce)))
+        val failure = assertThrows(IOException::class.java) { VeniceE2ee.modelKeyFromAttestation(swapped, nonce, model) }
+        assertEquals("The hardware quote is for another key", failure.message)
+    }
+
+    @Test
+    fun `a quote made for another request is refused`() {
+        val key = VeniceE2ee.generateKeyPair().publicKeyHex
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        // An old quote replayed under this request's nonce in the answer around it.
+        val replayed = TestEnclave.attestation(model, nonce, key, TestEnclave.hex(TestEnclave.quote(key, VeniceE2ee.newNonceHex())))
+        val failure = assertThrows(IOException::class.java) { VeniceE2ee.modelKeyFromAttestation(replayed, nonce, model) }
+        assertEquals("The hardware quote is for another request", failure.message)
+    }
+
+    @Test
+    fun `a quote that binds the nonce by its hash is accepted, as the reference client does`() {
+        val keyPair = VeniceE2ee.generateKeyPair()
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        val hashed = java.security.MessageDigest.getInstance("SHA-256").digest(VeniceE2ee.unhex(nonce))
+        val reportData = VeniceE2ee.ethereumAddress(VeniceE2ee.unhex(keyPair.publicKeyHex)) + ByteArray(12) + hashed
+        val body = TestEnclave.attestation(model, nonce, keyPair.publicKeyHex, TestEnclave.hex(TestEnclave.quoteWithReportData(reportData)))
+        assertEquals(keyPair.publicKeyHex, VeniceE2ee.modelKeyFromAttestation(body, nonce, model))
+    }
+
+    @Test
+    fun `an enclave in debug mode is refused even when everything else binds`() {
+        val key = VeniceE2ee.generateKeyPair().publicKeyHex
+        val nonce = VeniceE2ee.newNonceHex()
+        val model = "e2ee-test-model"
+        val debug = TestEnclave.attestation(model, nonce, key, TestEnclave.hex(TestEnclave.quote(key, nonce, debug = true)))
+        val failure = assertThrows(IOException::class.java) { VeniceE2ee.modelKeyFromAttestation(debug, nonce, model) }
+        assertEquals("The model's enclave runs in debug mode", failure.message)
+    }
+
+    @Test
+    fun `the encrypted path is pinned to one https host`() {
+        assertEquals(
+            "https://api.venice.ai/api/v1",
+            VeniceE2ee.pinnedBaseUrl("https://api.venice.ai/api/v1").toString()
+        )
+        assertEquals("api.venice.ai", VeniceE2ee.pinnedBaseUrl(" HTTPS://API.Venice.AI/api/v1 ")?.host)
+        for (elsewhere in listOf(
+            "http://api.venice.ai/api/v1",
+            "https://api.venice.ai.example.com/api/v1",
+            "https://example.com/api.venice.ai/api/v1",
+            "https://example.com/?x=api.venice.ai",
+            "https://api.venice.ai@example.com/api/v1",
+            "https://user:secret@api.venice.ai/api/v1",
+            "https://api.venice.ai.:443/api/v1",
+            "https://xn--api-venice-ai/api/v1",
+            "https://127.0.0.1:8080/v1",
+            "http://192.168.1.50:11434/v1",
+            "https://openrouter.ai/api/v1",
+            "ftp://api.venice.ai/",
+            "api.venice.ai/api/v1",
+            ""
+        )) {
+            assertEquals(elsewhere, null, VeniceE2ee.pinnedBaseUrl(elsewhere))
+        }
+    }
+
+    @Test
+    fun `a model id with options tacked on is not a plain id`() {
+        assertTrue(VeniceE2ee.isPlainModelId("e2ee-some-model"))
+        assertFalse(VeniceE2ee.isPlainModelId("e2ee-some-model:enable_e2ee=false"))
+        assertFalse(VeniceE2ee.isPlainModelId("e2ee-some-model:enable_web_search=on"))
+    }
+}
