+
+        assertEquals(listOf(false, false, true, true), mind.kids.toList())
+        val third = mind.texts[2]
+        assertTrue(third, third.contains("picture 1: kid: the app marks this picture kid (the describer saw a teen), so it does not show you the describer's words."))
+        assertFalse(third.contains("Two people at a station"))
+        assertTrue(third.contains("kid: the app marks this page as by or about a child or a teen (the describer saw a teen)."))
+        assertTrue(mind.texts[3].contains(KidGuard.NOT_KEPT))
+        assertTrue(mind.texts[3].contains("skipped: a kid (the describer saw a teen)"))
+        val e = entry()
+        assertEquals(2, e.refusals["kid:TEEN"])
+        assertEquals(1, e.refusals[KidGuard.LINE_DROPPED])
+        assertFalse(File(folder.root, "persona/her_log.json").readText().contains("DROPPED_SENTINEL"))
