+    private fun reply(vararg lines: String) {
+        synchronized(mind.replies) { lines.forEach { mind.replies.addLast(it) } }
+    }
+
+    private fun go(host: OutingHost, words: String = "look back"): OutingHost.Began = runBlocking {
+        host.go(words, OutingKind.parse(words)).also { withTimeout(10_000) { host.awaitEnd() } }
+    }
+
+    private fun entry(): HerLog.Entry = log.entries().last()
+
+    private fun logText(): String = File(folder.root, "persona/her_log.json").takeIf { it.isFile }?.readText().orEmpty()
