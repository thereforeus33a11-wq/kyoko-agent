+        assertFalse(space.canFollow)
+        val front = OutingPrompt.inFront(space.view)
+        // The mark and why only: the describer's words about a kid are withheld.
+        assertTrue(front, front.contains("picture 1: kid: the app marks this picture kid (the describer saw a child), so it does not show you the describer's words."))
+        assertFalse(front.contains("A playground with a slide"))
+        assertTrue(front.contains("kid: the app marks this page as by or about a child or a teen (the describer saw a child). it is not followed."))
+        assertEquals("skipped: a kid (the describer saw a child)", space.run(OutingStep.Verb.Follow(null)).line)
