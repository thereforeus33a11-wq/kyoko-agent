+    // ── A notebook that is longer than the page ──────────────────────────────────────
+
+    /** Sixty notes of 100 characters each, the oldest about him: three times what a page of 2,000 holds. */
+    private val long = (1..60).map { number ->
+        when {
+            number > 50 -> Note(Kind.USER, "him-$number", "he said thing number $number ".padEnd(97, 'x'))
+            number > 45 -> Note(Kind.THREAD, "done-$number", ("street story: tab $number ".padEnd(88, 'x') + " | closed"))
+            else -> Note(Kind.OPINION, "view-$number", "view number $number ".padEnd(97, 'x'))
+        }
+    }
+
+    private fun shownOf(block: String): List<Int> =
+        (1..60).filter { block.contains("thing number $it ") || block.contains("view number $it ") || block.contains("tab $it ") }
+
+    @Test
+    fun `picked by age alone the oldest notes never come back, with a recall every note has its turn`() {
+        // By age: the newest twenty, at any time.
+        assertEquals((1..20).toList(), shownOf(PersonaNotes.render(long, maxChars = 2000)))
+
+        // With a recall a quarter of the page is kept free: fifteen by age, five in turn.
+        val seen = HashSet<Int>()
+        val turns = 0L..9L
+        for (turn in turns) {
+            val block = PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), turn))
+            val shown = shownOf(block)
+            assertEquals((1..15).toList(), shown.take(15))
+            assertEquals(20, shown.size)
+            seen += shown
+            assertTrue(block, block.endsWith(
+                "(40 more notes of yours are not on this page: it has no room for all of them. A note that fits what is " +
+                    "being said is put on it first. The others take turns on it, except threads that are over.)"
+            ))
+        }
+        // The first thing he told her is on the very first turn, and after eight turns
+        // every note that stays in the notebook has been on the page.
+        assertTrue(PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 0)).contains("thing number 60 "))
+        assertEquals((1..45).toSet() + (51..60).toSet(), seen)
+        // Threads that are over wait for the talk to touch them: they are what may be taken out.
+        assertTrue((46..50).none { it in seen })
+        // The turns come round again, and a turn before the first is one too.
+        assertEquals(
+            PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 0)),
+            PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 8))
+        )
+        assertEquals(20, shownOf(PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), -3))).size)
+    }
