@@ -0,0 +1,84 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.OutingRules.Activity
+import com.opendroid.ai.core.life.OutingRules.AfterPause
+import com.opendroid.ai.core.life.OutingRules.Event
+import com.opendroid.ai.core.life.OutingRules.Rule
+import com.opendroid.ai.core.life.OutingRules.Snapshot
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The stop-rule matrix of OWN_LIFE_PLAN §1.1, row by row, and the times it holds by. */
+class OutingRulesTest {
+
+    private val minute = 60_000L
+
+    private fun row(event: Event) = Activity.entries.map { OutingRules.rule(event, it) }
+
+    @Test
+    fun `every row of the matrix`() {
+        // Columns: outing, camera look, ears, lent screen, own screen.
+        assertEquals(listOf(Rule.PAUSE, Rule.CANCEL, Rule.KEEP_LISTENING, Rule.END, Rule.PAUSE), row(Event.HIS_TALK))
+        assertEquals(listOf(Rule.END, Rule.CANCEL, Rule.NONE, Rule.END, Rule.END), row(Event.STOP))
+        assertEquals(listOf(Rule.NONE, Rule.NONE, Rule.NONE, Rule.END_AT_ONCE, Rule.CONTINUE), row(Event.HE_TOUCHES))
+        assertEquals(listOf(Rule.CONTINUE, Rule.ABORT, Rule.CONTINUE, Rule.END, Rule.PAUSE), row(Event.SCREEN_OFF))
+        assertEquals(listOf(Rule.CONTINUE, Rule.ABORT, Rule.PAUSE, Rule.END, Rule.END), row(Event.PHONE_CALL))
+        assertEquals(listOf(Rule.END, Rule.REFUSE, Rule.CLOSE_AND_CLEAR, Rule.END, Rule.END), row(Event.ASLEEP))
+        assertEquals(listOf(Rule.END_AT_NEXT_STEP, Rule.REFUSE, Rule.NONE, Rule.END, Rule.END), row(Event.CALLS_LOW))
+        assertEquals(listOf(Rule.END, Rule.REFUSE, Rule.PAUSE, Rule.END, Rule.END), row(Event.POWER_LOW))
+        assertEquals(listOf(Rule.END, Rule.CANCEL, Rule.CLOSE_AND_CLEAR, Rule.END, Rule.END_DESTROY_DISPLAY), row(Event.SWITCH_OFF))
+        assertEquals(listOf(Rule.NONE, Rule.NONE, Rule.NONE, Rule.END_NEEDS_HIM, Rule.END_NEEDS_HIM), row(Event.GATE_SCREEN))
+        assertEquals(listOf(Rule.END, Rule.NONE, Rule.NONE, Rule.END, Rule.END), row(Event.GUARD_REFUSALS))
+    }
+
+    @Test
+    fun `the strongest rule wins when several events hold`() {
+        assertEquals(Rule.END, OutingRules.decide(Activity.OUTING, setOf(Event.HIS_TALK, Event.STOP)))
+        assertEquals(Rule.PAUSE, OutingRules.decide(Activity.EARS, setOf(Event.HIS_TALK, Event.PHONE_CALL)))
+        assertEquals(Rule.CONTINUE, OutingRules.decide(Activity.OUTING, setOf(Event.SCREEN_OFF, Event.PHONE_CALL)))
+        assertEquals(Rule.NONE, OutingRules.decide(Activity.OUTING, emptySet()))
+    }
+
+    @Test
+    fun `a reading outing starts with the screen off but not while he talks, she sleeps or calls run low`() {
+        assertTrue(OutingRules.mayStart(Activity.OUTING, setOf(Event.SCREEN_OFF)))
+        assertFalse(OutingRules.mayStart(Activity.OUTING, setOf(Event.HIS_TALK)))
+        assertFalse(OutingRules.mayStart(Activity.OUTING, setOf(Event.ASLEEP)))
+        assertFalse(OutingRules.mayStart(Activity.OUTING, setOf(Event.CALLS_LOW)))
+        assertFalse(OutingRules.mayStart(Activity.CAMERA_LOOK, setOf(Event.SCREEN_OFF)))
+    }
+
+    @Test
+    fun `the phone's state becomes events, and an unreadable ledger counts as low`() {
+        val calm = Snapshot(callsLeft = 50)
+        assertEquals(emptySet<Event>(), calm.events())
+        assertTrue(Event.CALLS_LOW in Snapshot(callsLeft = null).events())
+        assertTrue(Event.CALLS_LOW in Snapshot(callsLeft = 9).events())
+        assertFalse(Event.CALLS_LOW in Snapshot(callsLeft = 10).events())
+        assertTrue(Event.POWER_LOW in Snapshot(callsLeft = 50, batteryPercent = 14, charging = false).events())
+        assertFalse(Event.POWER_LOW in Snapshot(callsLeft = 50, batteryPercent = 14, charging = true).events())
+        assertTrue(Event.POWER_LOW in Snapshot(callsLeft = 50, thermalStatus = OutingRules.THERMAL_SEVERE).events())
+        assertTrue(Event.GUARD_REFUSALS in Snapshot(callsLeft = 50, guardRefusals = 3).events())
+        assertFalse(Event.GUARD_REFUSALS in Snapshot(callsLeft = 50, guardRefusals = 2).events())
+        // The ears keep their own battery bound: they pause under 20 %, charging or not.
+        assertTrue(Event.POWER_LOW in Snapshot(callsLeft = 50, batteryPercent = 19, charging = true).earsEvents())
+        assertFalse(Event.POWER_LOW in Snapshot(callsLeft = 50, batteryPercent = 25, thermalStatus = 0).earsEvents())
+    }
+
+    @Test
+    fun `a paused outing goes on 3 minutes after the talk goes quiet and ends after 30 minutes paused`() {
+        val paused = 0L
+        assertEquals(AfterPause.WAIT, OutingRules.afterPause(paused, lastTalkMillis = 2 * minute, nowMillis = 4 * minute))
+        assertEquals(AfterPause.RESUME, OutingRules.afterPause(paused, lastTalkMillis = 2 * minute, nowMillis = 5 * minute))
+        assertEquals(AfterPause.WAIT, OutingRules.afterPause(paused, lastTalkMillis = 28 * minute, nowMillis = 29 * minute))
+        assertEquals(AfterPause.END, OutingRules.afterPause(paused, lastTalkMillis = 29 * minute, nowMillis = 30 * minute))
+    }
+
+    @Test
+    fun `her own screen ends two minutes after his went off`() {
+        assertFalse(OutingRules.ownScreenOffEnds(0, 119_999))
+        assertTrue(OutingRules.ownScreenOffEnds(0, 120_000))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/OutingStepTest.kt b/app/src/test/java/com/opendroid/ai/core/life/OutingStepTest.kt
new file mode 100644
index 0000000..5a4f9a0
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/OutingStepTest.kt
@@ -0,0 +1,163 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.OutingKind.News
+import com.opendroid.ai.core.life.OutingKind.Parsed
+import com.opendroid.ai.core.life.OutingKind.Why
+import com.opendroid.ai.core.life.OutingStep.Next
+import com.opendroid.ai.core.life.OutingStep.Verb
+import com.opendroid.ai.core.persona.PersonaNotes
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The grammar of a `go:` line, and what one step of an outing of hers comes to. */
+class OutingStepTest {
+
+    // ── go: ──────────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the go grammar reads reading and news and nothing else`() {
+        val table = listOf(
+            "read egg magazine" to Parsed.Read("egg magazine", null),
+            "read about the history of ganguro." to Parsed.Read("the history of ganguro", null),
+            "read up on 渋谷109" to Parsed.Read("渋谷109", null),
+            "look up kogal slang" to Parsed.Read("kogal slang", null),
+            "find out who started egg" to Parsed.Read("who started egg", null),
+            "\"read https://ja.wikipedia.org/wiki/Egg\"" to Parsed.Read("https://ja.wikipedia.org/wiki/Egg", "https://ja.wikipedia.org/wiki/Egg"),
+            "https://example.com/page" to Parsed.Read("https://example.com/page", "https://example.com/page"),
+            "Read this https://example.com/a." to Parsed.Read("this https://example.com/a", "https://example.com/a"),
+            "news" to Parsed.NewsOf(News.TOP, null),
+            "news japan" to Parsed.NewsOf(News.JAPAN, null),
+            "News World" to Parsed.NewsOf(News.WORLD, null),
+            "news about gyaru fashion" to Parsed.NewsOf(News.TOPIC, "gyaru fashion"),
+            "news 渋谷" to Parsed.NewsOf(News.TOPIC, "渋谷")
+        )
+        for ((written, expected) in table) assertEquals(written, expected, OutingKind.parse(written))
+    }
+
+    @Test
+    fun `what the grammar does not read stays a thought, with why`() {
+        // Phone time on his screen reads since he lends it to her (phase 5, without accounts of her own):
+        // `scroll tiktok` and `watch a video` are read now, and not read where his screen is not offered.
+        val reading = setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS)
+        assertEquals(Parsed.Phone(OutingKind.Kind.SCROLL, com.opendroid.ai.core.life.phone.HisApps.TIKTOK), OutingKind.parse("scroll tiktok"))
+        assertEquals(Parsed.NotRead("scroll tiktok", Why.NOT_ON), OutingKind.parse("scroll tiktok", runnable = reading))
+        assertEquals(Parsed.NotRead("scroll the fridge", Why.NOT_AN_APP), OutingKind.parse("scroll the fridge"))
+        // Phase 2 reads a camera look; it is not read where none is offered.
+        assertEquals(Parsed.Look(OutingKind.LookAt.BACK), OutingKind.parse("look back"))
+        assertEquals(Parsed.NotRead("look back", Why.NOT_ON), OutingKind.parse("look back", runnable = setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS)))
+        assertEquals(Parsed.Phone(OutingKind.Kind.WATCH, null, "a video"), OutingKind.parse("watch a video"))
+        assertEquals(Parsed.NotRead("watch a video", Why.NOT_ON), OutingKind.parse("watch a video", runnable = reading))
+        assertEquals(Parsed.NotRead("", Why.EMPTY), OutingKind.parse("  "))
+        assertEquals(Parsed.NotRead("read", Why.EMPTY), OutingKind.parse("read"))
+        assertEquals(Parsed.NotRead("read http://example.com", Why.NOT_HTTPS), OutingKind.parse("read http://example.com"))
+        assertEquals(Parsed.NotRead("reading list", Why.UNKNOWN), OutingKind.parse("reading list"))
+        assertEquals(Parsed.NotRead("news japan", Why.NOT_ON), OutingKind.parse("news japan", runnable = setOf(OutingKind.Kind.READ)))
+        assertTrue(OutingKind.isStop("stop"))
+        assertTrue(OutingKind.isStop("Stop."))
+        assertFalse(OutingKind.isStop("stop reading about egg"))
+    }
+
+    // ── A step ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the last do counts and the earlier ones are not run`() {
+        val step = OutingStep.parse("hm\ndo: open 1\ndo: search egg magazine 1999")
+        assertEquals(Next.Run(Verb.Search("egg magazine 1999")), step.next)
+        assertEquals(1, step.earlierDos)
+        assertEquals("hm", step.thought)
+    }
+
+    @Test
+    fun `no do line, or do done, means she is done`() {
+        assertEquals(Next.Finished(said = false), OutingStep.parse("boring page").next)
+        assertEquals(Next.Finished(said = false), OutingStep.parse("do: done").next)
+        assertEquals(Next.Finished(said = true), OutingStep.parse("say: egg is back\ndo: done").next)
+    }
+
+    @Test
+    fun `a do on the cut-off last line is not run`() {
+        val step = OutingStep.parse("ok this one\ndo: open 1\ndo: sea", cutOff = true)
+        assertEquals(Next.CutOff("sea"), step.next)
+        // A cut-off line that is no do: is kept as a thought.
+        val other = OutingStep.parse("do: open 2\nand then i thou", cutOff = true)
+        assertEquals(Next.Run(Verb.Open(2)), other.next)
+        assertTrue(other.thought.contains("and then i thou"))
+    }
+
+    @Test
+    fun `a do the app does not read is not run`() {
+        assertEquals(Next.NotRead("like 3"), OutingStep.parse("do: like 3").next)
+        assertEquals(Next.NotRead("open the second one"), OutingStep.parse("do: open the second one").next)
+    }
+
+    @Test
+    fun `the verbs read their arguments`() {
+        assertEquals(Verb.Open(3), OutingStep.verb("open 3"))
+        assertEquals(Verb.Open(3), OutingStep.verb("open [3]"))
+        assertEquals(Verb.More, OutingStep.verb("more"))
+        assertEquals(Verb.Back, OutingStep.verb("Back."))
+        assertEquals(Verb.Follow(null), OutingStep.verb("follow"))
+        assertEquals(Verb.Done, OutingStep.verb("done"))
+        assertEquals(Verb.Search("渋谷 ギャル"), OutingStep.verb("search 「渋谷 ギャル」"))
+        assertEquals(null, OutingStep.verb("open 0"))
+        assertEquals(null, OutingStep.verb("search"))
+        assertEquals(null, OutingStep.verb("more more"))
+    }
+
+    @Test
+    fun `say reaches him once in an outing`() {
+        val first = OutingStep.parse("say: oi egg had a reboot\nsay: in 2018")
+        assertEquals("oi egg had a reboot\nin 2018", first.said)
+        val later = OutingStep.parse("say: and another thing", sayUsed = true)
+        assertEquals("", later.said)
+        assertEquals("and another thing", later.thought)
+    }
+
+    @Test
+    fun `a command inside a step is never run`() {
+        val step = OutingStep.parse(">> open settings\ndo: more")
+        assertEquals(1, step.commandsNotRun)
+        assertEquals(Next.Run(Verb.More), step.next)
+        assertEquals("open settings", step.thought)
+    }
+
+    @Test
+    fun `notes, feelings and wonders work as in moments, within the step's bounds`() {
+        val step = OutingStep.parse(
+            """
+            note: opinion | egg-mag | egg was the gyaru bible
+            note: thread | ganguro | where ganguro started (unsure) | open
+            note: opinion | third | one note too many
+            feel: smug | strong
+            feel: bored | some
+            wonder: who started the ganguro look
+            wonder: a second one
+            """.trimIndent()
+        )
+        assertEquals(2, step.notes.size)
+        val (first, second) = step.notes
+        assertEquals(PersonaNotes.How.READ, step.marks[first.storageKey])
+        assertEquals(PersonaNotes.How.UNSURE, step.marks[second.storageKey])
+        assertEquals(1, step.feelings.size)
+        assertEquals(listOf(Wonders.Line.Add("who started the ganguro look")), step.wonders)
+        assertTrue(step.thought.contains("one note too many"))
+        assertTrue(step.thought.contains("bored"))
+        assertTrue(step.thought.contains("a second one"))
+    }
+
+    @Test
+    fun `her reaction is one kept thought of at most 300 characters`() {
+        val step = OutingStep.parse("<< " + "w".repeat(400) + "\ndo: back")
+        assertEquals(OutingStep.MAX_THOUGHT_CHARS, step.thought.length)
+        assertTrue(step.thought.endsWith("…"))
+        assertEquals(Next.Run(Verb.Back), step.next)
+    }
+
+    @Test
+    fun `a talk label in front of a mark does not unmark it`() {
+        assertEquals(Next.Run(Verb.Open(1)), OutingStep.parse("you: do: open 1").next)
+        assertEquals(listOf(Wonders.Line.Add("egg")), OutingStep.parse("yume: wonder: egg").wonders)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/OwnLedgerTest.kt b/app/src/test/java/com/opendroid/ai/core/life/OwnLedgerTest.kt
new file mode 100644
index 0000000..f978c2a
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/OwnLedgerTest.kt
@@ -0,0 +1,269 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.llm.LLMProvider
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.WrappedLLMProvider
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.llm.error.LLMException
+import com.opendroid.ai.core.llm.providers.ProviderResponseParser
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.async
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * Her own calls, counted: what the provider wrapper records under [OwnCall] and only
+ * there, the rolling 24 hours, the thresholds an outing and a step need, and a ledger that
+ * cannot be read failing closed.
+ */
+class OwnLedgerTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val hour = 60 * 60_000L
+    private val day = 24 * hour
+    private var now = 1_800_000_000_000L
+
+    private fun ledger(file: File = File(folder.root, "persona/own_ledger.json")) = OwnLedger({ file }, { now })
+
+    // ── Counting ─────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `limited calls count against the cap, upkeep and counters do not`() {
+        val ledger = ledger()
+        ledger.record(OwnPurpose.MOMENT, "e2ee-model", 100, 10, ok = true)
+        ledger.record(OwnPurpose.OUTING_STEP, "e2ee-model", 100, 10, ok = true)
+        ledger.record(OwnPurpose.SLEEP_PASS, "e2ee-model", 100, 10, ok = true)
+        ledger.record(OwnPurpose.NOTEBOOK, "e2ee-model", 100, 10, ok = true)
+        ledger.count(OwnPurpose.FETCH)
+        ledger.count(OwnPurpose.PAID_SEARCH)
+
+        assertEquals(148, ledger.left(150))
+        val summary = ledger.summary(150)!!
+        assertEquals(2, summary.used)
+        assertEquals(1, summary.byPurpose[OwnPurpose.SLEEP_PASS])
+        assertEquals(1, summary.byPurpose[OwnPurpose.FETCH])
+    }
+
+    @Test
+    fun `the window rolls over 24 hours`() {
+        val ledger = ledger()
+        ledger.record(OwnPurpose.MOMENT, "m", null, null, ok = true)
+        now += 23 * hour
+        ledger.record(OwnPurpose.MOMENT, "m", null, null, ok = true)
+        assertEquals(148, ledger.left(150))
+        now += 2 * hour
+        assertEquals(149, ledger.left(150))
+    }
+
+    @Test
+    fun `an outing needs 20 left and a step 10`() {
+        val ledger = ledger()
+        repeat(130) { ledger.record(OwnPurpose.OUTING_STEP, "m", null, null, ok = true) }
+        assertEquals(20, ledger.left(150))
+        assertTrue(ledger.canStart(OwnLedger.Start.OUTING, 150))
+        ledger.record(OwnPurpose.OUTING_STEP, "m", null, null, ok = true)
+        assertFalse(ledger.canStart(OwnLedger.Start.OUTING, 150))
+        assertTrue(ledger.canStart(OwnLedger.Start.STEP, 150))
+        repeat(9) { ledger.record(OwnPurpose.OUTING_STEP, "m", null, null, ok = true) }
+        assertEquals(10, ledger.left(150))
+        assertTrue(ledger.canStart(OwnLedger.Start.STEP, 150))
+        ledger.record(OwnPurpose.OUTING_STEP, "m", null, null, ok = true)
+        assertFalse(ledger.canStart(OwnLedger.Start.STEP, 150))
+        assertTrue(ledger.canStart(OwnLedger.Start.CALL, 150))
+    }
+
+    @Test
+    fun `with none left the next room is when the oldest counted call drops out`() {
+        val ledger = ledger()
+        val first = now
+        repeat(3) {
+            ledger.record(OwnPurpose.MOMENT, "m", null, null, ok = true)
+            now += hour
+        }
+        assertEquals(0, ledger.left(3))
+        assertEquals(first + day, ledger.roomAgainAt(3))
+        assertEquals(now, ledger.roomAgainAt(4))
+    }
+
+    @Test
+    fun `a ledger that cannot be read fails closed`() {
+        val file = File(folder.root, "persona/own_ledger.json")
+        file.parentFile!!.mkdirs()
+        file.writeText("{ not a ledger")
+        val ledger = ledger(file)
+        assertNull(ledger.left(150))
+        assertFalse(ledger.canStart(OwnLedger.Start.OUTING, 150))
+        assertFalse(ledger.canStart(OwnLedger.Start.STEP, 150))
+        assertNull(ledger.summary(150))
+        // A call recorded meanwhile is not written over the unread file.
+        ledger.record(OwnPurpose.MOMENT, "m", null, null, ok = true)
+        assertEquals("{ not a ledger", file.readText())
+    }
+
+    @Test
+    fun `the ledger survives a restart and prunes calls older than 30 days`() {
+        val file = File(folder.root, "persona/own_ledger.json")
+        ledger(file).record(OwnPurpose.MOMENT, "m", 1, 2, ok = true)
+        now += 31 * day
+        val later = ledger(file)
+        later.record(OwnPurpose.MOMENT, "m", 1, 2, ok = true)
+        assertEquals(1, later.calls()!!.size)
+        assertEquals(1, ledger(file).calls()!!.size)
+    }
+
+    @Test
+    fun `the status line holds counts and a price only`() {
+        val ledger = ledger()
+        repeat(16) { ledger.record(OwnPurpose.MOMENT, "e2ee-x", 14_000, 600, ok = true) }
+        repeat(19) { ledger.record(OwnPurpose.OUTING_STEP, "e2ee-x", 14_000, 600, ok = true) }
+        repeat(6) { ledger.record(OwnPurpose.OWN_COMMAND, "e2ee-x", 14_000, 600, ok = true) }
+        val line = ledger.summary(150)!!.statusLine()
+        assertEquals("Calls on her own: 41 of 150 in the last 24 h (moments 16, outings 19, commands 6). About $0.25.", line)
+    }
+
+    @Test
+    fun `prices follow the table, with typical sizes where tokens are unknown`() {
+        val known = OwnLedger.Call(now, OwnPurpose.MOMENT, "e2ee-model", 1_000_000, 0)
+        assertEquals(0.375, OwnPrices.usd(known), 1e-9)
+        val eyes = OwnLedger.Call(now, OwnPurpose.EYES, "google-gemma-4-31b-it", null, null)
+        assertTrue(OwnPrices.usd(eyes) < 0.001)
+        assertEquals(0.01, OwnPrices.usd(OwnLedger.Call(now, OwnPurpose.PAID_SEARCH)), 1e-9)
+        assertEquals(0.0, OwnPrices.usd(OwnLedger.Call(now, OwnPurpose.FETCH)), 1e-9)
+    }
+
+    // ── What the provider wrapper records ────────────────────────────────────────────
+
+    private val config = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = "OpenAI",
+        activeModel = "gpt-4o",
+        selectedModels = mapOf("OpenAI" to "gpt-4o"),
+        apiKeys = mapOf("OpenAI" to "test-key")
+    )
+
+    private class Fake(
+        private val fail: Boolean = false,
+        override val streamsLive: Boolean = false
+    ) : LLMProvider {
+        var calls = 0
+        override val name = "OpenAI"
+        override val availableModels = listOf("gpt-4o")
+        override suspend fun complete(request: LLMRequest): LLMResponse {
+            calls++
+            if (fail) throw LLMException(LLMError.ServerError, "OpenAI", request.model.orEmpty(), status = 400, requestSent = true)
+            return LLMResponse("a line", 120, request.model.orEmpty(), name, 1, promptTokens = 100, completionTokens = 20)
+        }
+
+        override fun streamComplete(request: LLMRequest): Flow<String> = flow {
+            calls++
+            emit("a ")
+            emit("line")
+        }
+
+        override suspend fun isAvailable() = true
+    }
+
+    private fun request() = LLMRequest(
+        systemPrompt = "system",
+        messages = listOf(ChatMessage(id = "1", text = "hi", sender = ChatMessage.Sender.USER)),
+        responseFormat = ResponseFormat.TEXT
+    )
+
+    @Test
+    fun `a call under OwnCall is recorded with its tokens and one without it is not`() = runBlocking {
+        val ledger = ledger()
+        val provider = WrappedLLMProvider(Fake(), { config })
+        provider.complete(request())
+        assertEquals(0, ledger.calls()!!.size)
+
+        withContext(ledger.call(OwnPurpose.MOMENT)) { provider.complete(request()) }
+        val calls = ledger.calls()!!
+        assertEquals(1, calls.size)
+        assertEquals(OwnPurpose.MOMENT, calls[0].purpose)
+        assertEquals("gpt-4o", calls[0].model)
+        assertEquals(100, calls[0].promptTokens)
+        assertEquals(20, calls[0].completionTokens)
+        assertTrue(calls[0].ok)
+    }
+
+    @Test
+    fun `calls made inside a job started under OwnCall are counted, as the planner and re-evaluations are`() = runBlocking {
+        val ledger = ledger()
+        val provider = WrappedLLMProvider(Fake(), { config })
+        withContext(ledger.call(OwnPurpose.OWN_COMMAND)) {
+            coroutineScope {
+                launch { provider.complete(request()) }
+                async { provider.complete(request()) }.await()
+            }
+        }
+        assertEquals(2, ledger.calls()!!.count { it.purpose == OwnPurpose.OWN_COMMAND })
+    }
+
+    @Test
+    fun `a failed call that left the phone is recorded as one that failed`() = runBlocking {
+        val ledger = ledger()
+        val provider = WrappedLLMProvider(Fake(fail = true), { config })
+        withContext(ledger.call(OwnPurpose.OUTING_STEP)) { runCatching { provider.complete(request()) } }
+        val calls = ledger.calls()!!
+        assertEquals(1, calls.size)
+        assertFalse(calls[0].ok)
+        assertEquals(149, ledger.left(150))
+    }
+
+    @Test
+    fun `a request refused before it is sent is not recorded`() = runBlocking {
+        val ledger = ledger()
+        val noKey = config.copy(apiKeys = emptyMap())
+        val provider = WrappedLLMProvider(Fake(), { noKey })
+        withContext(ledger.call(OwnPurpose.MOMENT)) { runCatching { provider.complete(request()) } }
+        assertEquals(0, ledger.calls()!!.size)
+    }
+
+    @Test
+    fun `a streamed call under OwnCall is recorded once`() = runBlocking {
+        val ledger = ledger()
+        val replayed = WrappedLLMProvider(Fake(), { config }, retryRuntime = com.opendroid.ai.core.llm.RetryRuntime(delayMillis = {}))
+        val live = WrappedLLMProvider(Fake(streamsLive = true), { config })
+        withContext(ledger.call(OwnPurpose.MOMENT)) {
+            assertEquals("a line", replayed.streamComplete(request()).toList().joinToString(""))
+            assertEquals("a line", live.streamComplete(request()).toList().joinToString(""))
+        }
+        val calls = ledger.calls()!!
+        assertEquals(2, calls.size)
+        assertEquals(100, calls[0].promptTokens)
+        assertNull(calls[1].promptTokens)
+    }
+
+    @Test
+    fun `the OpenAI-style parser fills prompt and completion tokens from usage`() {
+        val parsed = ProviderResponseParser.openAiChatCompletion(
+            """{"choices":[{"message":{"content":"hi"},"finish_reason":"stop"}],"usage":{"prompt_tokens":12,"completion_tokens":3,"total_tokens":15}}""",
+            "OpenAI", "gpt-4o"
+        )
+        assertEquals(12, parsed.promptTokens)
+        assertEquals(3, parsed.completionTokens)
+        assertEquals(15, parsed.tokensUsed)
+        val none = ProviderResponseParser.openAiChatCompletion("""{"choices":[{"message":{"content":"hi"}}]}""", "OpenAI", "gpt-4o")
+        assertNull(none.promptTokens)
+        assertNull(none.completionTokens)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/OwnLifeWallTest.kt b/app/src/test/java/com/opendroid/ai/core/life/OwnLifeWallTest.kt
