+package com.opendroid.ai.core.life.phone
+
+import kotlin.math.abs
+
+/**
+ * The look-only guard of her phone-time outings. She has no accounts of her own: the apps she
+ * visits are his, logged in as him, so whatever acts in them acts as him. She may open, scroll,
+ * tap into a post, a video, a profile or its comments, go back, switch tabs, search with her own
+ * words and watch. She may not like, follow, subscribe, comment, reply, post, message, share,
+ * save to his account, buy, gift, download, report, block, change his settings, or open his own
+ * inbox, notifications or profile. Every tap of hers is put to [tap] before it is made, and
+ * every text to [typing]: what is refused is never tapped, never typed, and she is told so.
+ *
+ * A control is known by what it says of itself (its text or its description), by what is inside
+ * it where it is a small button, and by its view id ("row_feed_button_like"), in the major apps
+ * and with a list for every app, in English and Japanese. The lists lean toward refusing: a
+ * false refusal costs her one tap, a false pass would act as him. A small button that says
+ * nothing at all is not tapped either: nothing can tell what it does.
+ *
+ * [gate] reads a whole screen for what is his to answer (a sign-in, a challenge, a payment, a
+ * permission, an install): such a screen ends her outing at once.
+ *
+ * Pure: it reads [ScreenNode]s and [Screen]s, and a test can run every case.
+ */
+object LookOnly {
+
+    /** What a refused tap or text would have been, in the words she is told. */
+    enum class Act(val words: String) {
+        LIKE("a like or a dislike"),
+        FOLLOW("a follow or an unfollow"),
+        SUBSCRIBE("a subscribe, a join or a reminder"),
+        COMMENT("writing a comment"),
+        REPLY("a reply"),
+        POST("a post, a repost or a quote"),
+        MESSAGE("his messages"),
+        SHARE("a share or a send"),
+        SAVE("a save, a bookmark or a playlist of his"),
+        BUY("buying something"),
+        GIFT("a gift, a tip or coins"),
+        DOWNLOAD("a download"),
+        VOTE("a vote or an award"),
+        CREATE("making something to post"),
+        SETTINGS("his settings or his account"),
+        ACCOUNT("a choice on his account: report, block, mute, hide or not interested"),
+        HIS_OWN("his own inbox, notifications or profile"),
+        GATE("a sign-in, a payment, a permission or an install"),
+        TYPING("typing anywhere but a search box"),
+        PASSWORD("a password field"),
+        UNLABELED("a button that says nothing, so the app cannot tell what it does")
+    }
+
+    sealed class Verdict {
+        data object Allowed : Verdict()
+        data class Refused(val act: Act) : Verdict()
+    }
+
+    /** What she is told of a refused tap: what it would have been, and why it is not made. */
+    fun told(act: Act): String =
+        "not tapped: that would be ${act.words}, on his account. you have no account of your own here, so you only look"
+
+    /**
+     * Whether a tap on [node] may be made, on [screen]. With [asTab] it is a tab she named: a
+     * feed tab such as "Following" or "Subscriptions" is a place to look where it is a real tab
+     * ([isTab]: the bottom bar, a tab widget, or a row of tabs with one selected), while his
+     * inbox, notifications and profile stay refused, and so does a view id that names an act.
+     *
+     * Each word the node has is read on its own (its text, its description, its hint): a "12K"
+     * that is the text of a button described as "like this video" is the like it is. A small
+     * button is read with what is inside it, and one whose words are only a count ("1.2K", "1万")
+     * says nothing of what it does.
+     */
+    fun tap(node: ScreenNode, screen: Screen, app: HisApps.App? = null, asTab: Boolean = false): Verdict {
+        if (node.password) return Verdict.Refused(Act.PASSWORD)
+        // A search box is a place to look from; any other field is for writing.
+        if (node.editable) return if (isSearchField(node)) Verdict.Allowed else Verdict.Refused(Act.TYPING)
+        val words = wordsOf(node)
+        val small = screen.share(node) < SMALL_SHARE
+        val inside = if (small) partsOf(node.inside) else emptyList()
+        if (hisOwn(node, screen, words + inside)) return Verdict.Refused(Act.HIS_OWN)
+        // A view id that names an act is never let through, a tab's neither.
+        actOfId(node.idName, app)?.let { return Verdict.Refused(it) }
+        val feed = asTab && isTab(node, screen)
+        // A big card is a post to open: a short word on it is its title, unless it is the word alone.
+        val big = screen.share(node) >= BIG_SHARE
+        for (word in words) {
+            if (feed && feedTab(word)) continue
+            actOfLabel(word, big = big)?.let { return Verdict.Refused(it) }
+        }
+        // A small button is what is inside it: the "Follow" text in a little box.
+        for (part in inside) {
+            if (feed && feedTab(part)) continue
+            actOfLabel(part)?.let { return Verdict.Refused(it) }
+        }
+        if (small && (words + inside).none { !isCount(it) } && !knownViewing(node.idName)) return Verdict.Refused(Act.UNLABELED)
+        return Verdict.Allowed
+    }
+
+    /** The words a node says of itself, each on its own: its text, its description, its hint. */
+    fun wordsOf(node: ScreenNode): List<String> =
+        listOf(node.text, node.desc, node.hint).map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+
+    /** What is inside a node, part by part. */
+    private fun partsOf(inside: String): List<String> = inside.split('\n', '·', '|').map { it.trim() }.filter { it.isNotEmpty() }
+
+    /** Words that are only a number or a count: "12K", "1.2万", "3,456". */
+    fun isCount(words: String): Boolean = COUNT.matches(normal(words))
+
+    /**
+     * Whether [node] is a real tab: one of the bottom bar's, a tab widget by its class, or one of
+     * a row of tabs at the top of the screen with one of them selected. A short button that sits
+     * near the top (a "Follow" pill under a post's toolbar) is none.
+     */
+    fun isTab(node: ScreenNode, screen: Screen): Boolean =
+        screen.tabs.any { it.bounds == node.bounds } || TAB_CLASS.containsMatchIn(node.className) || tabRow(screen).any { it.bounds == node.bounds }
+
+    /**
+     * The row of tabs at the top of [screen], left to right, or none: short-labelled tappables in
+     * its top [TOP_BAR] on one line, at least two, one of them selected or a tab widget by its class.
+     */
+    fun tabRow(screen: Screen): List<ScreenNode> {
+        val top = screen.tappable.filter {
+            it.bounds.bottom <= screen.height * TOP_BAR && !it.editable && normal(it.shownLabel).let { l -> l.isNotEmpty() && l.length <= TAB_CHARS }
+        }
+        val rows = top.groupBy { node -> top.first { abs(it.bounds.centerY - node.bounds.centerY) <= maxOf(it.bounds.height, node.bounds.height) / 2f }.bounds }
+        return rows.values
+            .filter { row -> row.size >= 2 && row.any { it.selected || TAB_CLASS.containsMatchIn(it.className) } }
+            .flatten()
+            .sortedBy { it.bounds.left }
+    }
+
+    /**
+     * What a press inside [target] must keep off, on [screen]: every other tappable node over it
+     * or inside it (its like row, its follow pill, its avatar). One that holds the whole target
+     * is the list or the card it is in, and is let be, unless the guard refuses it for an act: then
+     * it may be drawn over the target and take the press, and the target is refused. So is one
+     * with the very same bounds that the guard refuses: a press on it could land on either.
+     */
+    fun keepOff(target: ScreenNode, screen: Screen, app: HisApps.App? = null): KeepOff {
+        val boxes = ArrayList<Box>()
+        for (other in screen.tappable) {
+            if (other == target || !other.bounds.overlaps(target.bounds)) continue
+            if (other.bounds.contains(target.bounds)) {
+                val verdict = if (other.editable && target.editable) Verdict.Allowed else tap(other, screen, app)
+                (verdict as? Verdict.Refused)?.takeIf { it.act != Act.UNLABELED || other.bounds == target.bounds }?.let { return KeepOff.Refused(it.act) }
+                continue
+            }
+            boxes += other.bounds
+        }
+        return KeepOff.Boxes(boxes)
+    }
+
+    /** What a press inside a target keeps off, or why the target may not be pressed at all. */
+    sealed class KeepOff {
+        data class Boxes(val boxes: List<Box>) : KeepOff()
+        data class Refused(val act: Act) : KeepOff()
+    }
+
+    /** The tappable node a press at [x], [y] lands on, on [screen]: the smallest that holds the point, or null. */
+    fun under(x: Double, y: Double, screen: Screen): ScreenNode? =
+        screen.tappable.filter { it.bounds.contains(x, y) }.minByOrNull { it.bounds.area }
+
+    /** Whether text may be typed into [node]: only into a search box, never into a password field. */
+    fun typing(node: ScreenNode): Verdict = when {
+        node.password -> Verdict.Refused(Act.PASSWORD)
+        node.editable && isSearchField(node) -> Verdict.Allowed
+        else -> Verdict.Refused(Act.TYPING)
+    }
+
+    /** A field for search words: by its hint, its description, its view id or its class. */
+    fun isSearchField(node: ScreenNode): Boolean {
+        if (!node.editable || node.password) return false
+        val said = listOf(node.hint, node.desc, node.idName, node.className).joinToString(" ").lowercase()
+        // A field that holds words already is a search box by its id or class, not by what was typed.
+        return SEARCH.containsMatchIn(said) || node.className.contains("SearchView") || node.className.contains("SearchAutoComplete")
+    }
+
+    /** A button that opens the search: "Search", 検索, a magnifier by its description or its id. */
+    fun isSearchButton(node: ScreenNode): Boolean {
+        if (!node.clickable || node.editable) return false
+        val label = normal(node.label)
+        if (label.isNotEmpty() && label.length <= SHORT_CHARS && SEARCH_BUTTON.containsMatchIn(label)) return true
+        return label.isEmpty() && "search" in tokens(node.idName)
+    }
+
+    // ── Labels ──────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The act a label names, or null when it names none (or names viewing, such as comments).
+     * With [big] the label is a big card's: its own short words count only when there are at
+     * most two of them ("Like", "Follow 12K"), so a title such as "keep it cute" opens the post.
+     */
+    fun actOfLabel(label: String, big: Boolean = false): Act? {
+        val said = normal(label)
+        if (said.isEmpty()) return null
+        if (HEARTS.any { said.startsWith(it) }) return Act.LIKE
+        if (said == "+") return Act.CREATE
+        if (VIEWING.any { it.matches(said) }) return null
+        val words = said.split(' ').size
+        val short = said.length <= SHORT_CHARS && words <= (if (big) 2 else SHORT_WORDS)
+        for (rule in RULES) {
+            if ((short || rule.anyLength) && rule.pattern.containsMatchIn(said)) return rule.act
+        }
+        return null
+    }
+
+    /** The act a view id names ([idName], the part after ":id/"), or null. [app]'s own ids first. */
+    fun actOfId(idName: String, app: HisApps.App? = null): Act? {
+        if (idName.isBlank()) return null
+        val parts = tokens(idName)
+        // Opening comments is looking; writing one is not.
+        if (parts.any { it in COMMENT_TOKENS } && parts.none { it in WRITING_TOKENS }) return null
+        if (app != null && app.actIds.any { idName.equals(it, ignoreCase = true) }) {
+            return parts.firstNotNullOfOrNull { ID_ACTS[it] } ?: Act.ACCOUNT
+        }
+        return parts.firstNotNullOfOrNull { ID_ACTS[it] }
+    }
+
+    /** A view id that names something to look at: a thumbnail, a picture, a title, a card. */
+    private fun knownViewing(idName: String): Boolean = tokens(idName).any { it in VIEWING_TOKENS }
+
+    /** His own inbox, notifications or profile: by any of its words, in the bottom bar or the top of the screen for a tab's word. */
+    private fun hisOwn(node: ScreenNode, screen: Screen, words: List<String>): Boolean {
+        val said = (words.ifEmpty { partsOf(node.inside) }).map { normal(it) }.filter { it.isNotEmpty() }
+        if (said.isEmpty()) return false
+        if (said.any { it in HIS_OWN_ANYWHERE || it.substringBefore(',').trim() in HIS_OWN_ANYWHERE }) return true
+        val inBar = screen.inBottomBar(node) || node.bounds.bottom <= screen.height * TOP_BAR
+        return inBar && said.any { it in HIS_OWN_TABS || it.substringBefore(',').trim() in HIS_OWN_TABS }
+    }
+
+    /** A tab that is a feed to look at, though its word could act elsewhere ("Following" on TikTok): "Following" or "Following, tab 1 of 3". */
+    private fun feedTab(label: String): Boolean = normal(label).let { it in FEED_TABS || it.substringBefore(',').trim() in FEED_TABS }
+
+    // ── A whole screen ──────────────────────────────────────────────────────────────────
+
+    /** What a screen that is his to answer is. */
+    enum class Gate(val words: String) {
+        SIGN_IN("a sign-in or sign-up screen"),
+        CHALLENGE("a check that he is a person"),
+        PAYMENT("a payment screen"),
+        PERMISSION("a permission or settings screen"),
+        INSTALL("the store or an install screen"),
+
+        /** His messages: a chat with its box to write in, or his inbox. Nothing of it is shown to her. */
+        HIS_MESSAGES("his messages")
+    }
+
+    /** The screen is his to answer, and why, or null when it is a screen to look at. */
+    fun gate(screen: Screen): Gate? {
+        val front = screen.packageName
+        when (front) {
+            "com.android.vending", "com.google.android.packageinstaller", "com.android.packageinstaller" -> return Gate.INSTALL
+            "com.google.android.permissioncontroller", "com.android.permissioncontroller", "com.android.settings", "com.samsung.android.settings" ->
+                return Gate.PERMISSION
+        }
+        if (front in HisApps.GATE_PACKAGES) return if (PAY_PACKAGES.any { front.startsWith(it) }) Gate.PAYMENT else Gate.SIGN_IN
+        if (screen.nodes.any { it.password }) return Gate.SIGN_IN
+        // His messages: a box to write a message in, or a screen titled as his inbox.
+        if (screen.nodes.any { it.editable && !isSearchField(it) && MESSAGE_BOX.containsMatchIn(normal(listOf(it.hint, it.desc, it.idName).joinToString(" "))) }) {
+            return Gate.HIS_MESSAGES
+        }
+        if (screen.nodes.any { !it.clickable && it.bounds.bottom <= screen.height * TOP_BAR && normal(it.label) in INBOX_TITLES }) return Gate.HIS_MESSAGES
