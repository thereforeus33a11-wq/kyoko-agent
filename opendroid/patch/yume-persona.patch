+package com.opendroid.ai.core.life.eyes
+
+import android.Manifest
+import android.app.Application
+import android.app.KeyguardManager
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.media.AudioManager
+import android.os.Environment
+import android.os.PowerManager
+import android.util.Size
+import androidx.test.core.app.ApplicationProvider
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.models.LLMConfig
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.net.InetAddress
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Her camera on a phone as Robolectric gives one (OWN_LIFE_PLAN phase 2): what a look reads
+ * of the phone (the screen, the lock, a call), no camera opened without the permission, the
+ * sizes and the light of a frame, and a whole look through her eyes for real: one frame of
+ * the camera's, one request with the camera's instruction and nothing else (I5), the frame
+ * zeroed and nothing on disk anywhere the app or the phone keeps files (I6).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class HerCameraTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val now = AtomicLong(1_800_000_000_000L)
+    private val ledger by lazy { OwnLedger({ File(folder.root, "own_ledger.json") }, { now.get() }) }
+    private val log by lazy { HerLog({ File(folder.root, "her_log.json") }, { now.get() }) }
+    private val venice = "Custom OpenAI Compatible"
+    private val config = LLMConfig(
+        activeProvider = venice,
+        customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+        apiKeys = mapOf(venice to "his-venice-key"),
+        personaOwnLife = true,
+        personaEyes = true,
+        personaEyesConsentAt = 1L,
+        personaCameraLooks = true,
+        wakePhrases = "hey Ren SENTINEL_WAKE"
+    )
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    private fun camera() = HerCamera(context, CameraArm())
+
+    private fun files(): Map<String, Long> {
+        val roots = listOfNotNull(
+            context.filesDir, context.cacheDir, context.codeCacheDir, context.noBackupFilesDir, context.dataDir,
+            context.externalCacheDir, context.getExternalFilesDir(null), context.getExternalFilesDir(Environment.DIRECTORY_PICTURES),
+            Environment.getExternalStorageDirectory()
+        )
+        return roots.flatMap { root -> root.walkTopDown().filter { it.isFile }.map { it.path to it.length() }.toList() }.toMap()
+    }
+
+    private fun jpeg(width: Int, height: Int, paint: (Bitmap) -> Unit): ByteArray {
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        paint(bitmap)
+        val out = ByteArrayOutputStream()
+        bitmap.compress(Bitmap.CompressFormat.JPEG, 90, out)
+        bitmap.recycle()
+        return out.toByteArray()
+    }
+
+    @Test
+    fun `a look reads his screen, its lock and a call off the phone as it is now`() {
+        val camera = camera()
+        val power = shadowOf(context.getSystemService(Context.POWER_SERVICE) as PowerManager)
+        val keyguard = shadowOf(context.getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager)
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+        power.setIsInteractive(true)
+        keyguard.setKeyguardLocked(false)
+        audio.mode = AudioManager.MODE_NORMAL
+        val fine = camera.phone()
+        assertTrue(fine.screenOn)
+        assertTrue(fine.unlocked)
+        assertFalse(fine.inCall)
+        assertEquals(null, CameraLook.refusal(fine.copy(batteryPercent = 80), talking = false, callsLeft = 100, left = 6))
+
+        power.setIsInteractive(false)
+        assertEquals(CameraLook.Refusal.SCREEN_OFF, CameraLook.refusal(camera.phone().copy(batteryPercent = 80), false, 100, 6))
+        power.setIsInteractive(true)
+        keyguard.setKeyguardLocked(true)
+        assertEquals(CameraLook.Refusal.SCREEN_OFF, CameraLook.refusal(camera.phone().copy(batteryPercent = 80), false, 100, 6))
+        keyguard.setKeyguardLocked(false)
+        audio.mode = AudioManager.MODE_IN_CALL
+        assertEquals(CameraLook.Refusal.CALL, CameraLook.refusal(camera.phone().copy(batteryPercent = 80), false, 100, 6))
+        audio.mode = AudioManager.MODE_IN_COMMUNICATION
+        assertTrue(camera.phone().inCall)
+        audio.mode = AudioManager.MODE_NORMAL
+    }
+
+    @Test
+    fun `without the camera permission no camera is opened, and nothing is written`() = runBlocking {
+        shadowOf(context).denyPermissions(Manifest.permission.CAMERA)
+        val before = files()
+        val camera = camera()
+        assertFalse(camera.ready())
+        assertEquals(Shot.Failed(Shot.Fail.NOT_ALLOWED), camera.take(FoldState.Lens.BACK) { true })
+        assertEquals(before, files())
+    }
+
+    @Test
+    fun `the still and the preview take sizes the describer can use, and a black frame reads as dark`() {
+        val sizes = listOf(Size(4000, 3000), Size(1920, 1080), Size(1600, 1200), Size(640, 480), Size(320, 240), Size(176, 144))
+        assertEquals(Size(1920, 1080), HerCamera.stillSize(sizes))
+        assertEquals(Size(320, 240), HerCamera.previewSize(sizes))
+        assertEquals(Size(4000, 3000), HerCamera.stillSize(listOf(Size(4000, 3000))))
+        assertEquals(null, HerCamera.stillSize(emptyList()))
+
+        val black = Bitmap.createBitmap(200, 100, Bitmap.Config.ARGB_8888).apply { eraseColor(Color.rgb(3, 3, 3)) }
+        assertTrue(HerCamera.lightOf(black).dark)
+        val grey = Bitmap.createBitmap(200, 100, Bitmap.Config.ARGB_8888).apply { eraseColor(Color.rgb(128, 128, 128)) }
+        assertTrue(HerCamera.lightOf(grey).blank)
+        val room = Bitmap.createBitmap(200, 100, Bitmap.Config.ARGB_8888)
+        for (x in 0 until 200) for (y in 0 until 100) room.setPixel(x, y, Color.rgb((x * 255) / 199, (y * 255) / 99, 90))
+        val light = HerCamera.lightOf(room)
+        assertFalse(light.dark)
+        assertFalse(light.blank)
+    }
+
+    @Test
+    fun `I5 and I6 - a whole look sends one frame with the camera's instruction and nothing else, zeroes it, and writes nothing`() = runBlocking {
+        server.enqueue(
+            MockResponse.Builder().code(200).setHeader("Content-Type", "application/json")
+                .body("""{"choices":[{"message":{"content":"A desk by a window, a lamp and a mug.\nages: none"},"finish_reason":"stop"}],"usage":{"prompt_tokens":700,"completion_tokens":30}}""")
+                .build()
+        )
+        val eyes = HerEyes(
+            base = OkHttpClient(), settings = { config }, save = { }, ledger = ledger, clock = { now.get() },
+            chatUrl = server.url("/api/v1/chat/completions").toString(), listUrl = server.url("/api/v1/models").toString()
+        )
+        val frames = ArrayList<ByteArray>()
+        val shutter = Shutter { _, keepGoing ->
+            assertTrue(keepGoing())
+            val bytes = jpeg(1600, 1200) { b -> for (x in 0 until 1600 step 4) for (y in 0 until 1200 step 4) b.setPixel(x, y, Color.rgb(x % 255, y % 255, 120)) }
+            frames += bytes
+            Shot.Taken(bytes, CameraLook.Light(mean = 100, spread = 40))
+        }
+        val looks = HerLooks(
+            eyes = eyes, shutter = shutter,
+            phoneNow = { CameraLook.Phone(true, true, false, false, 80, 0) },
+            posture = { FoldState.Posture.NOT_FOLDABLE }, near = { false }, ready = { true }, armed = { true },
+            log = log, clock = { now.get() }
+        )
+        val before = files()
+        assertNotNull(looks.offer(config, now.get()))
+        val plan = looks.plan(config, OutingKind.LookAt.BACK) as CameraLook.Plan.Takes
+        val taken = ArrayList<String>()
+        val looked = looks.look(plan.uses, keepGoing = { true }) { taken += it }
+
+        assertEquals(listOf("back camera"), taken)
+        val result = looked.frames.single().result as CameraLook.Result.Described
+        assertEquals("A desk by a window, a lamp and a mug.", result.words)
+        assertEquals(null, result.kid)
+        assertTrue(CameraLook.shows(result))
+        val request = server.takeRequest(5, TimeUnit.SECONDS)!!
+        val text = request.body!!.utf8()
+        for (never in listOf("Ren", "SENTINEL_WAKE", "his-venice-key")) assertFalse(never, text.contains(never))
+        val body = JsonParser.parseString(text).asJsonObject
+        assertEquals(setOf("model", "messages", "temperature", "max_tokens", "venice_parameters"), body.keySet())
+        val messages = body.getAsJsonArray("messages")
+        assertEquals(2, messages.size())
+        assertEquals(Describe.CAMERA, messages[0].asJsonObject.get("content").asString)
+        assertEquals(2, messages[1].asJsonObject.getAsJsonArray("content").size())
+        // The frame went to her eyes only, and is zeroed; nothing is anywhere on the phone.
+        assertTrue(frames.single().all { it == 0.toByte() })
+        assertEquals(before, files())
+        assertEquals(1, ledger.calls()!!.count { it.purpose == OwnPurpose.EYES })
+        assertEquals(1, server.requestCount)
+    }
+}
