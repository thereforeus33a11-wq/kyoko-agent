+
+    @Test
+    fun `ordinary talk does not, and neither does a word that only contains one of them`() {
+        val notAbout = listOf(
+            "what are you doing",
+            "what are you up to tonight",
+            "who are you texting",
+            "what are you even talking about",
+            "morning",
+            "set an alarm for seven",
+            "the bees swarmed again",
+            "it is a standing order",
+            "tangent, but did you eat",
+            "that was a facepalm",
+            "remodel the kitchen",
+            "i overlooked it",
+            "hairline crack in the hive",
+            "nobody cares",
