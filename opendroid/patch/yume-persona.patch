+import okhttp3.OkHttpClient
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+/**
+ * The model list is fetched with the same key the chat uses. Plain http is for a machine
+ * of the owner's own: to any other address the request and the key would be readable on
+ * the way, so the list is not asked for at all. The chat gate applies the same rule.
+ */
+@RunWith(RobolectricTestRunner::class)
+class ModelFetcherPlainHttpTest {
+
+    private val custom = "Custom OpenAI Compatible"
+    private var requests = 0
+
+    /** Counts every request that would have left, and lets none leave. */
+    private val client = OkHttpClient.Builder()
+        .addInterceptor { chain ->
+            requests++
+            throw IOException("not sent in this test: ${chain.request().url.host}")
+        }
+        .build()
+
+    private fun fetch(provider: String, configure: (LLMConfig) -> LLMConfig): ModelFetchOutcome {
+        val settings = newSettingsRepository()
+        return runBlocking {
+            settings.updateConfig(configure)
+            ModelFetcher(client, settings).fetchModels(provider)
+        }
+    }
+
+    @Test
+    fun `a plain http address that is not his own is never asked for its models`() {
+        val outcomes = listOf(
+            fetch(custom) { it.copy(customEndpoints = it.customEndpoints + (custom to "http://api.venice.ai/api/v1")) },
+            // No scheme reads as http.
+            fetch(custom) { it.copy(customEndpoints = it.customEndpoints + (custom to "example.com/v1")) },
+            fetch("Ollama") { it.copy(ollamaUrl = "ollama.example.com:11434") },
+            fetch("Copilot API") { it.copy(copilotUrl = "http://copilot.example.com:4141") }
+        )
+
+        assertEquals(0, requests)
+        for (outcome in outcomes) {
+            assertTrue("$outcome", outcome is ModelFetchOutcome.NeedsCredentials)
+            val message = (outcome as ModelFetchOutcome.NeedsCredentials).message
+            assertTrue(message, message.contains("plain http"))
+            assertTrue(message, message.contains("https://"))
+        }
+    }
+
+    @Test
+    fun `https anywhere, and plain http to his own machine, are still asked`() {
+        fetch(custom) { it.copy(customEndpoints = it.customEndpoints + (custom to "https://api.venice.ai/api/v1")) }
+        fetch(custom) { it.copy(customEndpoints = it.customEndpoints + (custom to "http://192.168.1.20:8080/v1")) }
+        fetch("Ollama") { it.copy(ollamaUrl = "192.168.1.20:11434") }
+        fetch("Ollama") { it.copy(ollamaUrl = "http://127.0.0.1:11434") }
+        fetch("Copilot API") { it.copy(copilotUrl = "http://desktop.local:4141") }
+
+        assertEquals(5, requests)
+    }
+
+    private fun newSettingsRepository() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-model-fetch-http-test")
+                    .resolve("settings.preferences_pb")
+                    .toFile()
+            }
+        ),
+        providerCredentialStore = FixedKeyCredentialStore(mapOf(custom to "sk-test-0123456789abcdef")),
+        runStartupMigration = false
+    )
+
+    private class FixedKeyCredentialStore(
+        private val keys: Map<String, String>
+    ) : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(keys)
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
