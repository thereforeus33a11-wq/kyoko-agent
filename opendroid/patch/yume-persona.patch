+++ b/app/src/main/java/com/opendroid/ai/core/persona/HerBrain.kt
@@ -0,0 +1,151 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.replyProviderName
+
+/**
+ * The one tap that gives her her own eyes: her replies, her notebook and her own time move to
+ * a model of Venice's Private tier that sees ([VenicePrivateTier.SEEING_BRAIN], the same family
+ * as her encrypted brain), with that tier trusted for her and her model set to take pictures;
+ * and the one tap that moves her back. The planner and everything else on the main provider
+ * stay where they are, so the encrypted route stays there and is hers again with one tap.
+ *
+ * Pure: it only says what the settings become. What she had before is kept in
+ * [LLMConfig.personaBrainBefore] (her provider, her model, the provider that model was typed
+ * for, her two switches for pictures and sound, and his options for her replies), and nothing
+ * else. "Use this one" in "Try her brain" ([BrainChoice.use]) keeps the same record.
+ */
+object HerBrain {
+
+    /** The provider her brain goes through at Venice: the one that speaks to Venice, encrypted or not. */
+    const val PROVIDER = BuildDefaults.PROVIDER
+
+    /** What one tap moves her to, in his words on the button. */
+    const val MOVE_LABEL =
+        "Her own eyes: move her brain to ${VenicePrivateTier.SEEING_BRAIN} (same family, sees)"
+
+    /** What one tap moves her back to. */
+    const val BACK_LABEL = "Back to her brain before"
+
+    /** What happens when he taps, said under the button. */
+    const val MOVE_NOTE =
+        "Her replies, her notebook and her own time go to Venice's Private tier: Venice runs the model itself and keeps " +
+            "nothing, but it is not end to end encrypted, and Venice reads what it is sent to answer it. Nothing about " +
+            "you is held back from her there, and pictures meant for her go to her own model. The planner stays where " +
+            "it is. One tap moves her back."
+
+    /** Why the move cannot be made as things are set, or null when it can. */
+    fun whyNotMove(config: LLMConfig): String? {
+        val endpoint = RouteClassifier.endpointOf(config, PROVIDER)
+        return when {
+            RouteClassifier.hostOf(endpoint) != VenicePrivateTier.HOST || !endpoint.trim().startsWith("https://", ignoreCase = true) ->
+                "\"$PROVIDER\" is not pointed at ${BuildDefaults.ENDPOINT}, so there is no Venice to move her to. Set that address first."
+            VenicePrivateTier.keyOf(config) == null -> "There is no Venice key for \"$PROVIDER\" yet. Enter your Venice key first."
+            else -> null
+        }
+    }
+
+    /** Whether her brain is the seeing one now, as the move left it. */
+    fun moved(config: LLMConfig): Boolean =
+        config.replyProviderName() == PROVIDER &&
+            config.personaChatModel.trim().equals(VenicePrivateTier.SEEING_BRAIN, ignoreCase = true) &&
+            config.trustVenicePrivate && config.personaChatSeesImages
+
+    /**
+     * The settings with her brain moved to the seeing model: Venice's Private tier trusted for
+     * her, her model set to take pictures, and sound where the model takes it. What she had
+     * before is kept for [moveBack]; a second tap keeps the first record. Unchanged when
+     * [whyNotMove] has a reason.
+     */
+    fun move(config: LLMConfig): LLMConfig {
+        if (whyNotMove(config) != null) return config
+        val before = config.personaBrainBefore.ifBlank { record(config) }
+        val model = VenicePrivateTier.SEEING_BRAIN
+        return config.copy(
+            personaChatProvider = PROVIDER,
+            personaChatModel = model,
+            personaChatModelProvider = PROVIDER,
+            personaChatSeesImages = true,
+            personaChatHearsAudio = VenicePrivateTier.hears(model, config),
+            trustVenicePrivate = true,
+            personaBrainBefore = before
+        )
+    }
+
+    /**
+     * The settings with her brain back where it was before [move]: her provider, model and
+     * switches as they were. His trust in Venice's Private tier stays as he left it: that is
+     * a switch of its own. Unchanged when nothing was kept.
+     */
+    fun moveBack(config: LLMConfig): LLMConfig {
+        val kept = read(config.personaBrainBefore) ?: return config
+        return config.copy(
+            personaChatProvider = kept.provider,
+            personaChatModel = kept.model,
+            personaChatModelProvider = kept.modelProvider,
+            personaChatSeesImages = kept.seesImages,
+            personaChatHearsAudio = kept.hearsAudio,
+            // His options for her as they were, where they were kept ("Use this one" sets its own).
+            personaChatExtraBody = kept.extraBody ?: config.personaChatExtraBody,
+            personaBrainBefore = ""
+        )
+    }
+
+    /** What her brain was before the move, as kept. */
+    data class Kept(
+        val provider: String,
+        val model: String,
+        val modelProvider: String,
+        val seesImages: Boolean,
+        val hearsAudio: Boolean,
+        /** His options for her replies then; null in a record made before they were kept. */
+        val extraBody: String? = null
+    )
+
+    private const val SEP = "\n"
+
+    /** Her brain as it stands, in the form it is kept in. */
+    internal fun record(config: LLMConfig): String = listOf(
+        config.personaChatProvider,
+        config.personaChatModel,
+        config.personaChatModelProvider,
+        config.personaChatSeesImages.toString(),
+        config.personaChatHearsAudio.toString(),
+        // Last: options typed as JSON may hold a line break of their own.
+        config.personaChatExtraBody
+    ).joinToString(SEP)
+
+    /**
+     * [kept] with [extraBody] kept in it as his options for her then, where a record made
+     * before they were kept has none; otherwise as it is.
+     */
+    internal fun withOptionsKept(kept: String, extraBody: String): String {
+        val read = read(kept) ?: return kept
+        if (read.extraBody != null) return kept
+        return listOf(read.provider, read.model, read.modelProvider, read.seesImages.toString(), read.hearsAudio.toString(), extraBody)
+            .joinToString(SEP)
+    }
+
+    /** [record] read back; null for nothing kept. */
+    fun read(kept: String): Kept? {
+        if (kept.isBlank()) return null
+        val parts = kept.split(SEP, limit = 6)
+        if (parts.size < 4) return null
+        return Kept(parts[0], parts[1], parts[2], parts[3] == "true", parts.getOrNull(4) == "true", parts.getOrNull(5))
+    }
+
+    /** What his card says of her brain's route now: what she sees with, and what Venice can read. */
+    fun routeLine(config: LLMConfig): String {
+        val route = RouteClassifier.personaRoute(config)
+        val model = config.personaChatModel.trim().ifEmpty { "the main provider's model" }
+        return when (route) {
+            RoutePrivacy.ENCRYPTED -> "Her brain ($model) is end to end encrypted. That route carries text only, so pictures reach her through the describer."
+            RoutePrivacy.PRIVATE_TIER -> "Her brain ($model) is on Venice's Private tier, trusted for her: Venice reads what it is sent to answer it and keeps nothing."
+            else -> "Her brain ($model): ${route.label}."
+        }
+    }
+}
