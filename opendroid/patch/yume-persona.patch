+        val loop = File(mainSources, "core/agent/AgentLoop.kt").readText()
+        val summary = loop.substringAfter("private suspend fun speakAndSaveSummary(")
+            .substringBefore("private suspend fun speakAndSaveMessage(")
+        assertTrue(summary.contains("reportResult("))
+        assertTrue(summary.contains("persona.resultLine("))
+        // No notebook reflection and no command can follow from a result line.
+        assertFalse(summary.contains("persona.onReply"))
+        assertFalse(summary.contains("runPersonaAction"))
+        assertFalse(summary.contains("PersonaActions.split"))
+
+        val engine = File(mainSources, "core/persona/PersonaEngine.kt").readText()
+        val resultLine = engine.substringAfter("internal suspend fun resultLineFrom(").substringBefore("\n        }\n")
+        assertTrue(resultLine.contains("PersonaTruth.checkedLine(result, response.content, success)"))
