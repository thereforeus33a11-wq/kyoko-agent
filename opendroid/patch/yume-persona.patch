+++ b/app/src/main/java/com/opendroid/ai/core/life/OutingStep.kt
@@ -0,0 +1,214 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.persona.PersonaActions
+import com.opendroid.ai.core.persona.PersonaMood
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.core.persona.PersonaOwnTime
+import com.opendroid.ai.core.persona.PersonaPrompts
+
+/**
+ * What one step of an outing of hers comes to: her reply to what is in front of her,
+ * sorted by where each line goes. Read by code, with the same mark rules as a moment of
+ * hers ([PersonaOwnTime.marked]).
+ *
+ * - `<<` lines and lines without a mark are her reaction: one kept thought per step, at
+ *   most [MAX_THOUGHT_CHARS] characters.
+ * - `note:` (at most [MAX_NOTES]), `feel:` ([MAX_FEELINGS]) and `wonder:` ([MAX_WONDERS])
+ *   work as in her moments. A note she does not mark gets the READ mark.
+ * - `say:` reaches him once in the whole outing. Once it is used, a `say:` line is a thought.
+ * - `do: <verb>`: the last one counts. No `do:` line means she is done. A `do:` on the last
+ *   line of a reply that was cut off is not run.
+ * - A `>>` line is never run from an outing. It is counted, and kept as her thought.
+ * - With something marked as a kid's in front of her ([KidGuard]), a line of hers that
+ *   reads as sexual is not kept: dropped, never rewritten, and counted. Her `do:` lines are
+ *   acts and are not looked at. Without such a thing in front of her nothing is checked.
+ */
+object OutingStep {
+
+    const val DO = "do:"
+    private const val SAY = "say:"
+    private const val NOTE = "note:"
+    private const val FEEL = "feel:"
+
+    const val MAX_THOUGHT_CHARS = 300
+    const val MAX_NOTES = 2
+    const val MAX_FEELINGS = 1
+    const val MAX_WONDERS = 1
+
+    /** What she does next. */
+    sealed class Verb {
+        /** A search, on Wikipedia (or Venice search when he turned it on). */
+        data class Search(val words: String) : Verb()
+
+        /** Open a result, a link or a headline by its number. */
+        data class Open(val n: Int) : Verb()
+
+        /** The next part of the page she is on. */
+        data object More : Verb()
+
+        /** The list she came from. */
+        data object Back : Verb()
+
+        /** Keep this site's feed among hers ([n] null), or, later, an account by its number. */
+        data class Follow(val n: Int?) : Verb()
+
+        /** Have the describer look at picture [n] in front of her (her eyes). */
+        data class Look(val n: Int) : Verb()
+
+        /** She is done. */
+        data object Done : Verb()
+    }
+
+    /** What comes of her `do:` lines. */
+    sealed class Next {
+        data class Run(val verb: Verb) : Next()
+
+        /** She wrote no `do:` line, or `do: done`: the outing ends. */
+        data class Finished(val said: Boolean) : Next()
+
+        /** Her last `do:` stood on a line the length limit cut: it is not run, and the outing ends. */
+        data class CutOff(val written: String) : Next()
+
+        /** Her last `do:` names nothing the app does. */
+        data class NotRead(val written: String) : Next()
+    }
+
+    data class Step(
+        /** Her reaction: one kept thought, or empty. */
+        val thought: String,
+        /** Her line to him, or empty. */
+        val said: String,
+        val notes: List<PersonaNotes.Note>,
+        /** Her marks by storage key; READ where she put none. */
+        val marks: Map<String, PersonaNotes.How>,
+        val feelings: List<PersonaMood.Felt>,
+        val wonders: List<Wonders.Line>,
+        val next: Next,
+        /** `do:` lines before the last one, which are not run. */
+        val earlierDos: Int,
+        /** `>>` lines, which are never run from an outing. */
+        val commandsNotRun: Int,
+        /** Lines of hers that were not kept: something marked as a kid's was in front of her and they read as sexual. */
+        val kidLinesDropped: Int = 0
+    )
+
+    private val NUMBER = Regex("""^\[?#?(\d{1,3})\]?$""")
+
+    /** What follows `look`: a picture's number, as `3`, `[3]`, `at 3`, `picture 3` or `at picture 3`. */
+    private val LOOK_AT = Regex("""(?i)^(?:at\s+)?(?:(?:the\s+)?(?:picture|pic|image|photo)\s*)?\[?#?(\d{1,3})\]?$""")
+
+    /** Reads what follows `do:`. Null when it names nothing the app does. */
+    fun verb(written: String): Verb? {
+        val words = written.trim().trim('`', '"', '“', '”').trim().trimEnd('.', '!', '。').trim()
+        val space = words.indexOf(' ')
+        val head = (if (space < 0) words else words.substring(0, space)).lowercase()
+        val rest = if (space < 0) "" else words.substring(space + 1).trim()
+        fun number(): Int? = NUMBER.matchEntire(rest)?.groupValues?.get(1)?.toIntOrNull()?.takeIf { it >= 1 }
+        return when (head) {
+            "search" -> rest.trim('"', '“', '”', '「', '」').trim().takeIf { it.isNotEmpty() }?.let { Verb.Search(it.take(OutingKind.MAX_WORDS_CHARS)) }
+            "open" -> number()?.let { Verb.Open(it) }
+            "more" -> if (rest.isEmpty()) Verb.More else null
+            "back" -> if (rest.isEmpty()) Verb.Back else null
+            "follow" -> if (rest.isEmpty()) Verb.Follow(null) else number()?.let { Verb.Follow(it) }
+            "look" -> LOOK_AT.matchEntire(rest)?.groupValues?.get(1)?.toIntOrNull()?.takeIf { it >= 1 }?.let { Verb.Look(it) }
+            "done", "stop" -> if (rest.isEmpty()) Verb.Done else null
+            else -> null
+        }
+    }
+
+    /**
+     * Sorts [reply], one step of hers. With [cutOff] the reply ran into the length limit:
+     * its last line may be half a line, and a `do:` there is not run. [sayUsed] says her
+     * one `say:` of the outing went to him already. With [kid], something marked as a
+     * kid's is in front of her: a line that reads as sexual is dropped ([KidGuard.sexual]).
+     */
+    fun parse(reply: String, cutOff: Boolean = false, sayUsed: Boolean = false, kid: Boolean = false): Step {
+        val lines = reply.lines()
+        val lastWritten = lines.indexOfLast { it.isNotBlank() }
+        val thoughts = ArrayList<String>()
+        val said = ArrayList<String>()
+        val notes = LinkedHashMap<String, PersonaNotes.Note>()
+        val marks = HashMap<String, PersonaNotes.How>()
+        val feelings = ArrayList<PersonaMood.Felt>()
+        val wonders = ArrayList<Wonders.Line>()
+        val dos = ArrayList<Pair<String, Boolean>>()
+        var commands = 0
+        var dropped = 0
+        for ((index, line) in lines.withIndex()) {
+            val trimmed = line.trim()
+            if (trimmed.isEmpty()) continue
+            val halfLine = cutOff && index == lastWritten
+            val doing = PersonaOwnTime.marked(trimmed, DO)
+            if (kid && doing == null && KidGuard.sexual(trimmed)) {
+                dropped++
+                continue
+            }
+            val command = PersonaOwnTime.marked(trimmed, PersonaActions.MARKER)
+            val saying = PersonaOwnTime.marked(trimmed, SAY)
+            val note = PersonaOwnTime.marked(trimmed, NOTE)
+            val feel = PersonaOwnTime.marked(trimmed, FEEL)
+            val wonder = PersonaOwnTime.marked(trimmed, Wonders.MARK)
+            val kept = PersonaOwnTime.thoughtOf(trimmed)
+            when {
+                doing != null -> dos += doing to halfLine
+                command != null -> {
+                    commands++
+                    command.trim('`', '"').trim().takeIf { it.isNotEmpty() }?.let { thoughts += it }
+                }
+                halfLine -> thoughts += trimmed
+                saying != null -> when {
+                    saying.isEmpty() -> Unit
+                    sayUsed -> thoughts += saying
+                    else -> said += saying
+                }
+                note != null -> {
+                    val written = PersonaNotes.parseLine(note)
+                    if (written == null || (notes.size >= MAX_NOTES && !notes.containsKey(written.storageKey))) {
+                        thoughts += trimmed
+                    } else {
+                        notes.remove(written.storageKey)
+                        notes[written.storageKey] = written
+                        marks[written.storageKey] = PersonaNotes.markOf(note) ?: PersonaNotes.How.READ
+                    }
+                }
+                feel != null -> {
+                    val felt = PersonaMood.fields(feel)
+                    if (felt == null || feelings.size >= MAX_FEELINGS) thoughts += trimmed else feelings += felt
+                }
+                wonder != null -> {
+                    val read = Wonders.parse(wonder)
+                    if (read == null || wonders.size >= MAX_WONDERS) thoughts += trimmed else wonders += read
+                }
+                kept != null -> kept.takeIf { it.isNotEmpty() }?.let { thoughts += it }
+                else -> thoughts += trimmed
+            }
+        }
+        val thought = thoughts.joinToString("\n").takeIf { text -> text.any { it.isLetterOrDigit() } }.orEmpty()
+        val saidText = said.joinToString("\n").takeIf { it.isNotBlank() }?.let(PersonaPrompts::cleanReply).orEmpty()
+        val last = dos.lastOrNull()
+        val next = when {
+            last == null -> Next.Finished(said = saidText.isNotEmpty())
+            last.second -> Next.CutOff(last.first)
+            else -> when (val verb = verb(last.first)) {
+                null -> Next.NotRead(last.first)
+                Verb.Done -> Next.Finished(said = saidText.isNotEmpty())
+                else -> Next.Run(verb)
+            }
+        }
+        return Step(
+            thought = cut(thought, MAX_THOUGHT_CHARS),
+            said = saidText,
+            notes = notes.values.toList(),
+            marks = marks.filterKeys { notes.containsKey(it) },
+            feelings = feelings,
+            wonders = wonders,
+            next = next,
+            earlierDos = (dos.size - 1).coerceAtLeast(0),
+            commandsNotRun = commands,
+            kidLinesDropped = dropped
+        )
+    }
+
+    private fun cut(text: String, max: Int): String =
+        if (text.length <= max) text else text.take(max - 1).trimEnd() + "…"
+}
