+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class WakeWordMatcherTest {
+
+    @Test
+    fun `stock phrases still wake the app`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = false)
+        assertEquals(WakeWordMatcher.STOCK_PHRASES, phrases)
+        assertTrue(WakeWordMatcher.matches("hey OpenDroid what time is it", phrases))
+        assertTrue(WakeWordMatcher.matches("Open  Droid", phrases))
+        assertFalse(WakeWordMatcher.matches("open the door", phrases))
+    }
+
+    @Test
+    fun `persona phrases are added in front of the stock ones`() {
+        val phrases = WakeWordMatcher.resolve("  ", personaEnabled = true)
+        assertTrue(WakeWordMatcher.matches("Hey Yume", phrases))
+        assertTrue(WakeWordMatcher.matches("ok yumi", phrases))
+        assertTrue(WakeWordMatcher.matches("opendroid", phrases))
+    }
+
+    @Test
+    fun `the bare name inside ordinary speech does not wake it`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = true)
+        assertFalse(WakeWordMatcher.matches("you may want to sit down", phrases))
+        assertFalse(WakeWordMatcher.matches("it is between you and me", phrases))
+        // Someone else talking, or a message being read aloud, must not wake it either.
+        assertFalse(WakeWordMatcher.matches("hey, you may want to call me back", phrases))
+        assertFalse(WakeWordMatcher.matches("hey you me and sam should meet", phrases))
+        assertFalse(WakeWordMatcher.matches("hey u may be right", phrases))
+    }
+
+    @Test
+    fun `a user list replaces the defaults`() {
+        val phrases = WakeWordMatcher.resolve("Computer, hey  jarvis;\nok", personaEnabled = true)
+        assertEquals(listOf("computer", "hey jarvis"), phrases)
+        assertTrue(WakeWordMatcher.matches("Hey Jarvis lights", phrases))
+        assertFalse(WakeWordMatcher.matches("hey yume", phrases))
+    }
+
+    @Test
+    fun `blank input never matches`() {
+        assertFalse(WakeWordMatcher.matches("", WakeWordMatcher.STOCK_PHRASES))
+        assertFalse(WakeWordMatcher.matches("hello", emptyList()))
+    }
+}
