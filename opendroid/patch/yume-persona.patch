+@Singleton
+class PersonaMemory @Inject constructor(
+    private val memoryRepository: MemoryRepository
+) {
+    /** All notes, newest first. */
+    suspend fun notes(): List<PersonaNotes.Note> =
+        noteRows()
+            .filter { it.type == MemoryType.SEMANTIC }
+            .sortedByDescending { it.timestamp }
+            .mapNotNull { PersonaNotes.fromStorage(it.key, it.value) }
+
+    /** When each note was written, by its storage key. A note written again under its key counts from then. */
+    suspend fun writtenAt(): Map<String, Long> = noteRows().associate { it.key to it.timestamp }
+
+    /**
+     * Writes the starting notes once. A notebook the owner has emptied stays empty.
+     *
+     * The marker that says it was done is written last. A first reply that is cut short
+     * part-way through therefore leaves no marker, and the next call writes the starting
+     * notes that are still missing instead of leaving her with half of them. A key that
+     * is already there is not written over: it is either the same starting note or one
+     * she was handed in the meantime.
+     *
+     * A starting note is the oldest thing she has. It is stamped older than every note
+     * that is already there, so notes she was handed before her first reply keep their
+     * place above it: on the page, where the newest come first, and when threads and
+     * opinions have to make way, where the oldest go first.
+     */
+    suspend fun seedIfNeeded(seed: List<PersonaNotes.Note>) = writeLock.withLock {
+        if (isStarted()) return@withLock
+        val rows = noteRows()
+        val present = rows.mapTo(HashSet()) { it.key }
+        val base = (rows.minOfOrNull { it.timestamp } ?: System.currentTimeMillis()) - seed.size
+        seed.forEachIndexed { index, note ->
+            if (note.storageKey !in present) {
+                memoryRepository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC, base + index))
+            }
+        }
+        recordStartingKeys(seed.mapTo(HashSet()) { it.storageKey })
+        markStarted()
+    }
+
+    /**
+     * Gives the starting notes she never touched the wording this build has for them.
+     *
+     * A starting note is written once ([seedIfNeeded]). A phone that ran an older build
+     * keeps the wording that build had, also where her files have changed it since; and
+     * what her notebook says counts for more than her card. [earlier] are the wordings
+     * the starting notes had in older builds, any number for a key. A note of [current]
+     * whose stored text is, character for character, one of the earlier wordings of its
+     * key is one she never rewrote: it is given the current wording. Its old text goes to
+     * her archive the way a note written over does, with the mark she had given it, which
+     * leaves the key with it. The note keeps its time: it keeps its place in her notebook
+     * and its age, and is not new.
+     *
+     * Nothing else is touched: a note she changed, a key with no note under it (she let it
+     * go, or it was taken out: it is not written back), a notebook that has not had its
+     * start or was emptied, and keys the current starting notes no longer have (they stay
+     * as they are). Nothing of it counts as her writing: no note is new or newer by it,
+     * and nothing is moved off her page to make room.
+     *
+     * A starting note that is new in this build comes in as well: one under a key that no
+     * earlier build had, so none of [earlier] has it, and that this notebook was never
+     * given ([recordStartingKeys]), has no note under it now and nothing in her archive.
+     * It is written once, stamped older than every note she has, as a starting note is
+     * ([seedIfNeeded]), and its key is kept as given from then on: what she lets go of it
+     * later stays gone. Nothing new comes into a notebook he emptied, one that holds no
+     * note in the words of a starting note and none in her archive (emptied by an older
+     * build, whatever he handed her since), or one handed
+     * over from another phone: what she let go there is not in her archive here.
+     *
+     * It is done once for each version of the starting notes: a fingerprint of [current]
+     * and [earlier] is kept, and while it is the same nothing more is read. A notebook
+     * handed over from another phone ([handedOver]) is looked over again. Returns how many
+     * notes were given the current wording, and how many came in new.
+     */
+    suspend fun refreshStartingNotes(current: List<PersonaNotes.Note>, earlier: List<PersonaNotes.Note>): Int {
+        if (current.isEmpty() || earlier.isEmpty()) return 0
+        val version = seedVersion(current, earlier)
+        val lookedOver = memoryRepository.getMemory(SEED_VERSION_KEY)?.value
+        if (lookedOver == version) return 0
+        return writeLock.withLock {
+            if (!isStarted()) return@withLock 0
+            val wordings = earlier.groupBy({ it.storageKey }, { it.text })
+            val live = noteRows().associateBy { it.key }
+            val marks = how()
+            val refreshed = HashSet<String>()
+            // The last line under a key is the note, as when the starting notes are read.
+            val starting = current.associateBy { it.storageKey }.values
+            for (note in starting) {
+                val row = live[note.storageKey] ?: continue
+                if (row.value == note.text || row.value !in wordings[note.storageKey].orEmpty()) continue
+                archive(row, REPLACED, marks[note.storageKey])
+                memoryRepository.saveMemory(Memory(row.key, note.text, MemoryType.SEMANTIC, row.timestamp))
+                refreshed += row.key
+            }
+            // As when she writes over a note: the mark said how she knew the old text.
+            if (refreshed.any { it in marks }) updateHow { it - refreshed }
+            val added = addNewStartingNotes(starting.toList(), wordings, live, handedOverHere = lookedOver == HANDED_OVER)
+            memoryRepository.saveMemory(Memory(SEED_VERSION_KEY, version, MemoryType.SEMANTIC))
+            refreshed.size + added
+        }
+    }
+
+    /**
+     * Writes in the starting notes of [current] whose keys are new to this notebook (see
+     * [refreshStartingNotes]), and keeps every key of [current] as given. [earlier] are
+     * the wordings earlier builds had, by key, [live] the notes there are now. Called
+     * under the write lock. Returns how many came in.
+     */
+    private suspend fun addNewStartingNotes(
+        current: List<PersonaNotes.Note>,
+        earlier: Map<String, List<String>>,
+        live: Map<String, Memory>,
+        handedOverHere: Boolean
+    ): Int {
+        val earlierKeys = earlier.keys
+        val given = startingKeys()
+        val archiveRows = archiveRows()
+        val archived = archiveRows.mapTo(HashSet()) { PersonaNotes.KEY_PREFIX + it.key.removePrefix(ARCHIVE_PREFIX).substringBeforeLast('.', "") }
+        // Every wording a starting note has had, this build's and the earlier ones, by key.
+        val wordings = HashMap<String, MutableSet<String>>()
+        for (note in current) wordings.getOrPut(note.storageKey) { HashSet() } += note.text
+        for ((key, texts) in earlier) wordings.getOrPut(key) { HashSet() } += texts
+        // A notebook that never had its start here, or lost it: no note in the words of a
+        // starting note, now or in her archive. A note he handed her under a starting key,
+        // in his own words, is not one.
+        val hadItsStart = live.values.any { it.value in wordings[it.key].orEmpty() } ||
+            archiveRows.any { row -> readArchive(row)?.first?.note?.let { it.text in wordings[it.storageKey].orEmpty() } == true }
+        val emptied = memoryRepository.getMemory(EMPTIED_KEY)?.value == EMPTIED
