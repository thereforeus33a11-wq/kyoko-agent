@@ -0,0 +1,67 @@
+package com.opendroid.ai.core.life.ears
+
+import android.Manifest
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowSpeechRecognizer
+
+/**
+ * The engine order on a phone: without the models, Android's recogniser only when it is the
+ * one that stays on the phone; never the default recogniser merely asked to stay offline.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class EarsEnginesTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val models = EarsModelStore(context)
+    private val android = AndroidOnDeviceHearing(context)
+    private val engines = AndroidEarsEngines(context, SherpaHearing(context, models, VoicePrintStore(context)), models, android)
+    private val listener = object : HearingEngine.Listener {
+        override fun heard(heard: Heard) = Unit
+    }
+
+    @After
+    fun tearDown() {
+        android.close()
+        ShadowSpeechRecognizer.reset()
+    }
+
+    @Test
+    fun `without the on-device recogniser and without the models no engine starts`() {
+        shadowOf(context).grantPermissions(Manifest.permission.RECORD_AUDIO)
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(false)
+        val pick = engines.pick(LLMConfig(personaOpenMic = true)) { false }
+        assertTrue(pick is EarsEngines.Pick.None)
+        assertEquals(EarsEngines.NO_ENGINE, (pick as EarsEngines.Pick.None).why)
+        assertEquals(HearingEngine.Closed.NOT_ON_DEVICE, android.open(listener))
+        assertFalse(android.isOpen)
+    }
+
+    @Test
+    fun `with the on-device recogniser and no models it is the one`() {
+        shadowOf(context).grantPermissions(Manifest.permission.RECORD_AUDIO)
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+        val pick = engines.pick(LLMConfig(personaOpenMic = true)) { false }
+        assertTrue(pick is EarsEngines.Pick.Engine)
+        assertTrue((pick as EarsEngines.Pick.Engine).engine === android)
+    }
+
+    @Test
+    fun `without the microphone permission the fallback does not open`() {
+        shadowOf(context).denyPermissions(Manifest.permission.RECORD_AUDIO)
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+        assertEquals(HearingEngine.Closed.NO_PERMISSION, android.open(listener))
+    }
+}
