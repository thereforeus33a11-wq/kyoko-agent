+        // what a site or another app answered.
+        val failedOutside = step(
+            "s1", "SEND_SMS", params = mapOf("contact" to "+15550100", "message" to "hi"), status = StepStatus.FAILED
+        )
+        val before = listOf(failedOutside, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(failedOutside, pendingStep, added)
+            for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+                for (mode in listOf(AutoMode.OFF, AutoMode.AUTO)) {
+                    assertTrue("$rein $mode ${added.action}", ownPlanNeedsApproval(rein, mode, before, after))
+                }
+                assertFalse("$rein", ownPlanNeedsApproval(rein, AutoMode.YOLO, before, after))
+            }
+        }
+        // A step that failed on the phone brought nothing back from outside.
+        val failedOnPhone = step("s1", "OPEN_APP", params = mapOf("appName" to "Clock"), status = StepStatus.FAILED)
+        val onPhoneBefore = listOf(failedOnPhone, pendingStep)
+        assertFalse(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.EVERYTHING, AutoMode.OFF,
+                onPhoneBefore, listOf(failedOnPhone, pendingStep, addedSms)
+            )
+        )
+        assertFalse(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, AutoMode.OFF,
+                onPhoneBefore, listOf(failedOnPhone, pendingStep, addedAlarm)
+            )
+        )
+    }
+
+    @Test
+    fun `a plan whose words may be someone else's is never changed on her rein`() {
+        // Such a plan did not start on her rein. Whatever is added to it, his own setting decides.
+        val before = listOf(ranOnPhone, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(ranOnPhone, pendingStep, added)
+            for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+                for (mode in AutoMode.entries) {
+                    for (autoApproved in listOf(true, false)) {
+                        val stock = PlanModification.requiresApproval(
+                            mode, AutoMode.DEFAULT_GRANTS, before, planOf(after), autoApproved
+                        )
+                        assertEquals(
+                            "$rein $mode ${added.action} autoApproved=$autoApproved",
+                            stock,
+                            PlanModification.requiresApprovalForOwnPlan(
+                                rein, stock, before, planOf(after), autoApproved, ::staysOnPhone,
+                                wordsMayBeSomeoneElses = true
+                            )
+                        )
+                    }
+                }
+            }
+        }
+        // The case that showed it: he approved her plan by hand because its number came from
+        // a notification, the message failed, and the planner answered with another way to
+        // send it. No step had worked yet, and still neither rein lets the new step run.
+        val failedSms = step(
+            "s1", "SEND_SMS", params = mapOf("contact" to "5550107788", "message" to "the gate code is 4512"),
+            status = StepStatus.FAILED
+        )
+        val otherWay = step("x1", "SEND_WHATSAPP", params = mapOf("contact" to "5550107788", "message" to "the gate code is 4512"))
+        val note = step("x2", "ADD_NOTE", params = mapOf("content" to "the gate code is 4512"))
+        for ((rein, added) in listOf(
+            com.opendroid.ai.data.models.PersonaRein.EVERYTHING to otherWay,
+            com.opendroid.ai.data.models.PersonaRein.PHONE to note
+        )) {
+            val after = planOf(listOf(failedSms, added))
+            val stock = PlanModification.requiresApproval(AutoMode.OFF, AutoMode.DEFAULT_GRANTS, listOf(failedSms), after, false)
+            assertTrue(stock)
+            assertTrue(
+                "$rein",
+                PlanModification.requiresApprovalForOwnPlan(
+                    rein, stock, listOf(failedSms), after, false, ::staysOnPhone, wordsMayBeSomeoneElses = true
+                )
+            )
+        }
+    }
+
+    @Test
+    fun `a step whose action does not exist never ran, so it reached nowhere`() {
+        val exists: (String) -> Boolean = { it in setOf("SEND_SMS", "OPEN_APP", "SET_ALARM") }
+        val unknown = step("s1", "POST_TO_BOARD", status = StepStatus.FAILED)
+        assertTrue(stepStaysOnPhone(unknown, listOf("POST_TO_BOARD"), exists))
+        // The same name on a step that is still to run is not covered: nobody knows what it would do.
