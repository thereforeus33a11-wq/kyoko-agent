index 0000000..811b4e2
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaThoughtsWallTest.kt
@@ -0,0 +1,218 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.buildPlanningRequest
+import com.opendroid.ai.data.models.ChatMessage
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Her thoughts are hers alone. These read the source, like [PersonaWallTest], because
+ * what they guard is who can reach the store at all:
+ *
+ *  - the store is known to her own package and to the one screen model that can empty
+ *    it, which asks it how many there are and deletes them and never reads one;
+ *  - inside her package they are read for her own prompt, for a reply and for a moment
+ *    of her own, and for nothing else: not her notebook pass, not her line about a
+ *    result, not a look at a picture, not a plan;
+ *  - nothing that is shown, logged, copied or stored elsewhere is made from them.
+ */
+class PersonaThoughtsWallTest {
+
+    private val mainSources = File("src/main/java/com/opendroid/ai")
+
+    private fun relative(file: File) = file.relativeTo(mainSources).path.replace('\\', '/')
+
+    private fun kotlinSources() = mainSources.walkTopDown().filter { it.isFile && it.extension == "kt" }
+
+    private fun source(path: String) = File(mainSources, path).readText()
+
+    private fun outsideHerPackage(text: String): Set<String> = kotlinSources()
+        .filterNot { relative(it).startsWith("core/persona/") }
+        .filter { it.readText().contains(text) }
+        .map { relative(it) }
+        .toSet()
+
+    @Test
+    fun `outside her package only the model of the card screen knows the store, and it can only count and empty it`() {
+        assertEquals(setOf("ui/viewmodel/PersonaViewModel.kt"), outsideHerPackage("PersonaThoughts"))
+        // The marker rules and the block of her prompt are not used anywhere else either.
+        assertEquals(emptySet<String>(), outsideHerPackage("PersonaThoughtLines"))
+
+        val model = source("ui/viewmodel/PersonaViewModel.kt")
+        val calls = Regex("""[^.\w]thoughts\.(\w+)\(""").findAll(model).map { it.groupValues[1] }.toSet()
+        assertEquals(setOf("summary", "wipe"), calls)
+        // What it shows is a count and a date. Nothing of a thought is in the line it builds.
+        val line = model.substringAfter("internal fun thoughtsCountLine(").substringBefore("@HiltViewModel")
+        assertTrue(line.startsWith("count: Int, oldestAtMillis: Long?,"))
+        assertFalse(line.contains("Thought"))
+        assertFalse(model.contains(".latest("))
+        // The summary the store hands out holds those two numbers and nothing else.
+        val store = source("core/persona/PersonaThoughts.kt")
+        assertTrue(store.contains("data class Summary(val count: Int, val oldestAtMillis: Long?)"))
+    }
+
+    @Test
+    fun `inside her package the thoughts are read for her own prompt and for nothing else`() {
+        val persona = kotlinSources().filter { relative(it).startsWith("core/persona/") }.toList()
+        // The store is held by the engine alone.
+        val holders = persona.filter { it.name != "PersonaThoughts.kt" && it.readText().contains("PersonaThoughts,") }
+            .map { relative(it) }
+        assertEquals(listOf("core/persona/PersonaEngine.kt"), holders)
+
+        val engine = source("core/persona/PersonaEngine.kt")
+        // Read in three places: her prompt, the cue that picks the pages of her files for a moment of her own,
+        // and the page of her sleep.
+        assertEquals(3, Regex("""[^.\w]thoughts\.latest\(""").findAll(engine).count())
+        val prompt = engine.substringAfter("suspend fun chatSystemPrompt(").substringBefore("private suspend fun underText(")
+        // A moment of her own reads more of them than a reply does; held back, none at all.
+        assertTrue(
+            prompt.contains(
+                "val ownThoughts = if (heldBack) emptyList() else " +
+                    "thoughts.latest(if (inOwnTime) PersonaThoughts.OWN_TIME_BUDGET_CHARS else PersonaThoughts.PROMPT_BUDGET_CHARS)"
+            )
+        )
+        assertTrue(prompt.contains("thoughts = PersonaThoughtLines.block(ownThoughts, nowMillis),"))
+        val moment = engine.substringAfter("suspend fun ownMoment(").substringBefore("private fun momentFacts(")
+        assertTrue(moment.contains("val lastThoughts = if (heldBack) \"\" else thoughts.latest()"))
+        // Her sleep reads what she thought since she last woke, by the same rule: held back, none at all.
+        val sleep = engine.substringAfter("private suspend fun sleepPass(").substringBefore("suspend fun resultLine(")
+        assertTrue(
+            sleep.contains(
+                "val sinceWoke = if (heldBack) emptyList() else thoughts.latest(PersonaThoughts.SLEEP_BUDGET_CHARS)" +
+                    ".filter { it.atMillis > state.lastWokeAt }"
+            )
+        )
+        // The block is built once, and its heading is put on in one place.
+        assertEquals(1, Regex("""PersonaThoughtLines\.block\(""").findAll(engine).count())
+        val heading = persona.filter { it.readText().contains("PersonaThoughtLines.HEADING") }.map { relative(it) }
+        assertEquals(listOf("core/persona/PersonaPrompts.kt"), heading)
+        // Written in one place, and counted or emptied nowhere in here.
+        assertEquals(1, Regex("""[^.\w]thoughts\.keep\(""").findAll(engine).count())
+        assertFalse(engine.contains("thoughts.wipe("))
+        assertFalse(engine.contains("thoughts.summary("))
+    }
+
+    @Test
+    fun `her notebook pass, her line about a result, a look at a picture and a plan are built without them`() {
+        val engine = source("core/persona/PersonaEngine.kt")
+        val others = mapOf(
+            "the notebook pass" to engine.substringAfter("internal suspend fun reflect(").substringBefore("class Heard("),
+            "the notebook request" to engine.substringAfter("internal fun reflectionRequest(").substringBefore("private val TOKYO"),
+            "the line about a result" to engine.substringAfter("internal suspend fun resultLineFrom(").substringBefore("internal fun commandRouteFor("),
+            "the look at a picture" to engine.substringAfter("internal suspend fun describeOwnPictureFrom(").substringBefore("/** How much what she last thought counts"),
+            "where a command is planned" to engine.substringAfter("internal fun commandRouteFor(").substringBefore("enum class CommandRoute")
+        )
+        for ((what, body) in others) {
+            assertTrue(what, body.isNotBlank())
+            for (reach in listOf("thoughts.", "PersonaThoughtLines", "chatSystemPrompt(", "ownThoughts")) {
+                assertFalse("$what: $reach", body.contains(reach))
+            }
+        }
+        // The prompts of those requests carry no place for them.
+        val prompts = source("core/persona/PersonaPrompts.kt")
+        for (builder in listOf("fun resultSystemPrompt(", "fun resultPrompt(", "fun reflectionSystemPrompt(", "fun reflectionUserPrompt(", "fun stockHistory(")) {
+            val body = prompts.substringAfter(builder).substringBefore("\n    }\n")
+            assertFalse(builder, body.contains("thoughts"))
+            assertFalse(builder, body.contains("PersonaThoughtLines"))
+        }
+        // A plan for a command of hers is the stock planning request: it holds no block of hers at all.
+        val command = ChatMessage(id = "1", text = "flashlight on", sender = ChatMessage.Sender.USER)
+        val planning = buildPlanningRequest(command, "likes tea", isOnDevice = false, temperature = 0.1f, maxTokens = 1500, asTool = true)
+        assertFalse(planning.systemPrompt.contains("YOUR OWN THOUGHTS"))
+        assertFalse(planning.systemPrompt.contains("YOUR OWN TIME"))
+    }
+
+    @Test
+    fun `a line of a reply she keeps to herself is taken out by the engine before the loop reads on`() {
+        val engine = source("core/persona/PersonaEngine.kt")
+        val heard = engine.substringAfter("suspend fun withoutThoughts(reply: String): Heard {").substringBefore("\n    }\n")
+        assertTrue(heard.contains("val split = PersonaThoughtLines.split(reply)"))
+        assertTrue(heard.contains("if (split.thoughts.isNotBlank()) keepThought(split.thoughts, System.currentTimeMillis())"))
+        // What is handed back is the reply without them, whether there were any, and the sleep
+        // one of them asks for, read off the line: never what they said.
+        assertTrue(heard.contains("return Heard(split.text, split.marked, PersonaSleep.askedIn(split.thoughts))"))
+        assertTrue(engine.contains("class Heard(val text: String, val keptThoughts: Boolean, val sleep: PersonaSleep.Ask? = null)"))
+        // What the sleep is read as holds a length or a clock time, and no text at all.
+        val ask = source("core/persona/PersonaSleep.kt").substringAfter("sealed class Ask {").substringBefore("\n    }\n")
+        assertFalse(ask, ask.contains("String"))
+        // Her line about a result and what she says of a picture go through the same door.
+        assertEquals(2, Regex("""withoutThoughts\(chatProvider\(config\)\.complete\(withChatModel\(request, config\)\)\)""").findAll(engine).count())
+        val result = engine.substringAfter("suspend fun resultLine(").substringBefore("suspend fun commandRoute(")
+        assertTrue(result.contains("withoutThoughts(chatProvider(config).complete(withChatModel(request, config)))"))
+        val picture = engine.substringAfter("suspend fun describeOwnPicture(").substringBefore("suspend fun readBackgroundPicture(")
+        assertTrue(picture.contains("withoutThoughts(chatProvider(config).complete(withChatModel(request, config)))"))
+        // The page that is read into text for the owner is not hers and is left as it comes.
+        val background = engine.substringAfter("suspend fun readBackgroundPicture(").substringBefore("private fun pictureWasRead(")
+        assertFalse(background.contains("withoutThoughts"))
+    }
+
+    @Test
+    fun `no log line anywhere prints a thought or the reply it stood in`() {
+        // The same tripwire as for his personal values: the known names a thought travels under.
+        val thought = Regex(
+            """\$\{?[A-Za-z0-9_.?]*\b(thoughts?|ownThoughts|lastThoughts|sinceWoke|wholeReply|currentReplyText|replyText|saidText|shownText|feelings?|felt|words|answer|reading|prose|page|mood)\b(?!\??\.(length|size)\b)"""
+        )
+        val logCall = Regex("""\bLog\.[vdiwe]\(""")
+        val offending = kotlinSources().flatMap { file ->
+            val lines = file.readLines()
+            lines.indices.mapNotNull { index ->
+                if (!logCall.containsMatchIn(lines[index])) return@mapNotNull null
+                // A statement can run over a few lines, with the values on the later ones.
+                val statement = lines.subList(index, minOf(lines.size, index + 4)).joinToString(" ")
+                if (thought.containsMatchIn(statement.substringBefore(");"))) "${relative(file)}:${index + 1}" else null
+            }
+        }.toList()
+        assertEquals(emptyList<String>(), offending)
+        // The check sees the shapes it is there for.
+        assertTrue(thought.containsMatchIn("""Log.d(TAG, "kept: ${'$'}{moment.thoughts}")"""))
+        assertTrue(thought.containsMatchIn("""Log.d(TAG, "kept: ${'$'}thought")"""))
+        assertFalse(thought.containsMatchIn("""Log.d(TAG, "kept ${'$'}{moment.thoughts.length} chars")"""))
+        // In her own package a failure is logged by its kind or its error code and nothing else.
+        for (file in listOf(
+            "core/persona/PersonaThoughts.kt", "core/persona/PersonaOwnTime.kt", "core/persona/PersonaSleep.kt",
+            "core/persona/PersonaSleepPass.kt", "core/persona/PersonaMood.kt"
+        )) {
+            for (line in source(file).lines().filter { logCall.containsMatchIn(it) }) {
+                assertTrue(line, line.contains("\${e.javaClass.simpleName}\")"))
+            }
+        }
+    }
+
+    @Test
+    fun `nothing of a thought can ride out of the store in an error, a chat row or a notification`() {
+        val store = source("core/persona/PersonaThoughts.kt")
+        // Every error the store raises has fixed words.
+        val raised = Regex("""IOException\(([^)]*)\)""").findAll(store).map { it.groupValues[1] }.toList()
+        assertTrue(raised.isNotEmpty())
+        for (words in raised) assertTrue(words, Regex(""""[^"$]*"""").matches(words))
+        // It writes its one file and touches no table, no clipboard and no notification.
+        for (elsewhere in listOf("MemoryRepository", "ConversationRepository", "ClipboardManager", "Notification", "insertMessage")) {
+            assertFalse(elsewhere, store.contains(elsewhere))
+        }
+        // What a moment of hers hands to the loop has no field for a thought.
+        val engine = source("core/persona/PersonaEngine.kt")
+        assertTrue(engine.contains("data class OwnMoment(val said: String, val command: String?, val unrun: List<PersonaActionRows.Unrun>)"))
+        // The notifications of her own time are built from her line to him, or from nothing at all.
+        val notification = source("core/service/CheckInNotification.kt")
+        val wants = notification.substringAfter("fun buildWants(").substringBefore("\n    /** [name] is who wrote")
+        assertFalse(wants.contains("setContentText"))
+        assertFalse(wants.contains("BigTextStyle"))
+    }
+
+    @Test
+    fun `the Memory screen lists stored rows without her notebook, and her thoughts were never in that table`() {
+        val model = source("ui/viewmodel/MemoryViewModel.kt")
+        assertTrue(model.contains("val memoriesList: StateFlow<List<Memory>> = memoryRepository.listedMemories"))
+        assertFalse(model.contains("memoryRepository.allMemories"))
+        val repository = source("data/repository/MemoryRepository.kt")
+        assertTrue(repository.contains("val listedMemories: Flow<List<Memory>> = allMemories.map { rows -> rows.filterNot { isPersonaRow(it.key) } }"))
+        // No screen reads the whole table by itself.
+        val screens = kotlinSources().filter { relative(it).startsWith("ui/") }
+            .filter { it.readText().contains(".allMemories") }.map { relative(it) }.toList()
+        assertEquals(emptyList<String>(), screens)
+        assertFalse(source("core/persona/PersonaThoughts.kt").contains("memor", ignoreCase = true))
+    }
+}
