+
+    /** A notebook that is longer than its page: one old note about his work, and 120 newer views. */
+    private fun longNotebook() = runBlocking {
+        memory.apply(listOf(Note(Kind.USER, "work", "he does night shifts at the bakery and sleeps at 3am because of it")))
+        memory.apply((1..120).map { Note(Kind.OPINION, "view-$it", "view number $it ".padEnd(110, 'x')) })
+    }
+
+    @Test
+    fun `a pass does not write over an old note its page had no room for`() {
+        longNotebook()
+        val engine = engine()
+        // The notes without a place take turns on the page. This is a turn of others than the old one.
+        engine.clock = { PersonaNotes.TURN_MILLIS }
+        // The obvious slug for what he just said, and a note that was on the page.
+        answer("user | work | he was up late working again\nopinion | view-120 | the newest view, put another way")
+
+        engine.afterReply(talk)
+
+        val asked = asked()
+        assertFalse(asked, asked.contains("night shifts"))
+        assertTrue(asked, asked.contains("more notes of yours are not on this page: it has no room for all of them."))
+        val notes = runBlocking { memory.notes() }.associateBy { it.key }
+        // What she knew is still there, and what she wrote without sight of it stands beside it.
+        assertEquals("he does night shifts at the bakery and sleeps at 3am because of it", notes.getValue("work").text)
+        assertEquals("he was up late working again", notes.getValue("work-unseen").text)
+        // A note she was shown is replaced, as it always is.
+        assertEquals("the newest view, put another way", notes.getValue("view-120").text)
+        assertEquals(122, notes.size)
+    }
+
+    @Test
+    fun `an old note is on the page when its turn comes or the talk touches it, and is then brought up to date`() {
+        longNotebook()
