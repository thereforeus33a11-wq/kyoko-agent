--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PersonaPictureRules.kt
@@ -0,0 +1,413 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.intOrNull
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * One picture she has on the phone. A [Kind.SELF] picture shows her and can be put in
+ * front of her. The single [Kind.BACKGROUND] picture is what made her: it is kept for
+ * the owner to read into the text that lies under her awareness, and is never shown to
+ * her and never named to her.
+ */
+@Serializable
+data class PersonaPicture(
+    val id: String,
+    /** Name of the image file, next to the index. Never a path. */
+    val file: String,
+    val kind: Kind,
+    /** What is on it, the way she would say it. Empty until somebody wrote one. */
+    val caption: String = "",
+    val captionBy: CaptionBy = CaptionBy.OWNER,
+    val addedAt: Long = 0L,
+    /**
+     * True for a picture of herself that she made ([PersonaSelfPictures]), false for one
+     * the owner added. The ones she made have room of their own ([PersonaPictureRules.MAX_MADE]),
+     * so they never take the place of his.
+     */
+    val made: Boolean = false
+) {
+    @Serializable
+    enum class Kind { SELF, BACKGROUND }
+
+    /** Who wrote the caption: the owner typed it, or she said it when she was shown the picture. */
+    @Serializable
+    enum class CaptionBy { OWNER, HER }
+}
+
+/** A picture of herself as it goes with one chat request: the image and the caption kept with it. */
+class OwnPicture(val base64: String, val caption: String)
+
+/**
+ * Everything about her pictures that needs no phone: the index file, the limits, how
+ * large a stored picture is, when she is shown herself and which picture it is.
+ * [PersonaPictures] does the file work around it.
+ */
+object PersonaPictureRules {
+
+    /** How many pictures of herself she can have from him. */
+    const val MAX_SELF = 12
+
+    /** How many pictures of herself that she made are kept. A new one past that pushes out her oldest. */
+    const val MAX_MADE = 24
+
+    /** Put in front of the caption of a picture she made, where her pictures are listed for her. */
+    const val MADE_BY_HER = "made by me: "
+
+    /** The longer side of a stored picture, in pixels. Enough to see herself, small enough to send. */
+    const val MAX_SIDE = 1024
+
+    const val JPEG_QUALITY = 85
+
+    /** A caption is one or two short lines, whoever writes it. */
+    const val MAX_CAPTION_CHARS = 300
+
+    /**
+     * The index file: the pictures in the order they were added, and how often a picture
+     * was shown to her in turn, so that the next one is another one after a restart too.
+     */
+    @Serializable
+    data class Index(val turn: Int = 0, val pictures: List<PersonaPicture> = emptyList())
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private val FILE_NAME = Regex("""[A-Za-z0-9_-]{1,80}\.jpg""")
+
+    /** True for a name this store gives a picture file. An index entry with any other name is not followed. */
+    fun isPictureFileName(name: String): Boolean = FILE_NAME.matches(name)
+
+    fun encodeIndex(index: Index): String = json.encodeToString(Index.serializer(), index)
+
+    /**
+     * Reads the index file. Text that is not an index gives an empty one, and an entry
+     * that cannot be read, has no id, repeats an id or names a file outside the picture
+     * folder is skipped: a damaged file must cost a picture at most, never a crash.
+     */
+    fun parseIndex(text: String): Index {
+        val root = try {
+            json.parseToJsonElement(text) as? JsonObject
+        } catch (e: Exception) {
+            null
+        } ?: return Index()
+        val turn = (root["turn"] as? JsonPrimitive)?.intOrNull ?: 0
+        val seen = HashSet<String>()
+        val pictures = (root["pictures"] as? JsonArray).orEmpty().mapNotNull { entry ->
+            try {
+                json.decodeFromJsonElement(PersonaPicture.serializer(), entry)
+            } catch (e: Exception) {
+                null
+            }
+        }.filter { it.id.isNotBlank() && isPictureFileName(it.file) && seen.add(it.id) }
+        return withinLimits(Index(max(0, turn), pictures))
+    }
+
+    /** [index] with no more than the store may hold: the newest background picture and the first [MAX_SELF] of her. */
+    private fun withinLimits(index: Index): Index {
+        val background = index.pictures.lastOrNull { it.kind == PersonaPicture.Kind.BACKGROUND }
+        var selfLeft = MAX_SELF
+        // Of the ones she made, the newest are kept.
+        val madeKept = index.pictures.filter { it.kind == PersonaPicture.Kind.SELF && it.made }.takeLast(MAX_MADE).toSet()
+        return index.copy(
+            pictures = index.pictures.filter { picture ->
+                when {
+                    picture.kind == PersonaPicture.Kind.BACKGROUND -> picture === background
+                    picture.made -> picture in madeKept
+                    else -> selfLeft-- > 0
+                }
+            }
+        )
+    }
+
+    /** True when [kind] has room for one more of his. There is always room for a background picture: it takes the old one's place. */
+    fun hasRoomFor(index: Index, kind: PersonaPicture.Kind): Boolean =
+        kind == PersonaPicture.Kind.BACKGROUND ||
+            index.pictures.count { it.kind == PersonaPicture.Kind.SELF && !it.made } < MAX_SELF
+
+    /**
+     * [index] with [picture], one she made, added, and the pictures she made that it
+     * pushes out: the oldest of hers, past [MAX_MADE]. None of his is ever pushed out.
+     */
+    fun withMade(index: Index, picture: PersonaPicture): Pair<Index, List<PersonaPicture>> {
+        val hers = index.pictures.filter { it.made }
+        val out = hers.take(maxOf(0, hers.size + 1 - MAX_MADE)).toSet()
+        return index.copy(pictures = index.pictures.filterNot { it in out } + picture.copy(made = true)) to out.toList()
+    }
+
+    /**
+     * [index] with [picture] added, or null when she already has [MAX_SELF] pictures of
+     * herself. A background picture replaces the one that was there.
+     */
+    fun withAdded(index: Index, picture: PersonaPicture): Index? {
+        if (!hasRoomFor(index, picture.kind)) return null
+        val kept = if (picture.kind == PersonaPicture.Kind.BACKGROUND) {
+            index.pictures.filterNot { it.kind == PersonaPicture.Kind.BACKGROUND }
+        } else {
+            index.pictures
+        }
+        return index.copy(pictures = kept + picture)
+    }
+
+    fun withRemoved(index: Index, id: String): Index = index.copy(pictures = index.pictures.filterNot { it.id == id })
+
+    /**
+     * [index] with the caption of picture [id] set to [text], written by [by]. When
+     * [text] is, once tidied, the caption the picture has already, nothing changes and
+     * the caption stays whose it was: a space added to her words does not make them his.
+     */
+    fun withCaption(index: Index, id: String, text: String, by: PersonaPicture.CaptionBy): Index {
+        val caption = fitCaption(text)
+        return index.copy(
+            pictures = index.pictures.map {
+                if (it.id == id && it.caption != caption) it.copy(caption = caption, captionBy = by) else it
+            }
+        )
+    }
+
+    /**
+     * [text] as a caption is kept: trimmed, without empty lines, and no longer than
+     * [MAX_CAPTION_CHARS]. A longer text ends at its last whole word, not inside one.
+     */
+    fun fitCaption(text: String): String {
+        val tidy = text.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.joinToString("\n")
+        if (tidy.length <= MAX_CAPTION_CHARS) return tidy
+        val cut = tidy.take(MAX_CAPTION_CHARS)
+        // The next character tells whether the cut fell between two words anyway.
+        if (tidy[MAX_CAPTION_CHARS].isWhitespace()) return cut.trimEnd()
+        val lastGap = cut.indexOfLast { it.isWhitespace() }
+        return (if (lastGap > MAX_CAPTION_CHARS / 2) cut.take(lastGap) else cut).trimEnd()
+    }
+
+    /** The size a picture of [width] x [height] is stored at: its longer side at most [maxSide], its shape kept. */
+    fun scaledSize(width: Int, height: Int, maxSide: Int = MAX_SIDE): Pair<Int, Int> {
+        val longer = max(width, height)
+        if (width <= 0 || height <= 0 || longer <= maxSide) return width to height
+        val scale = maxSide.toDouble() / longer
+        return max(1, (width * scale).roundToInt()) to max(1, (height * scale).roundToInt())
+    }
+
+    /**
+     * By how much a picture can be shrunk while it is being decoded (a power of two)
+     * and still be at least [maxSide] on its longer side, so that a photo of many
+     * megapixels never has to be held in memory at full size.
+     */
+    fun sampleSize(width: Int, height: Int, maxSide: Int = MAX_SIDE): Int {
+        var sample = 1
+        while (max(width, height) / (sample * 2) >= maxSide) sample *= 2
+        return sample
+    }
+
+    /** Words in a message of his that are about how she looks. */
+    private val ABOUT_HER_LOOKS = Regex(
+        """\b(?:looks?|pictures?|pics?|photos?|selfies?|mirror|outfits?|wearing|hair|nails?|tan|body|face|model|render|yourself)\b""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /**
+     * "who are you" and "what are you" as a question about her, which is where the
+     * sentence stops. "what are you doing" and "who are you texting" go on, and are not.
+     */
+    private val ABOUT_WHAT_SHE_IS = Regex(
+        """\b(?:who|what)\s+are\s+you(?=\s*(?:(?:really|exactly|anyway|even)\s*)?(?:$|[?.!,;:]))""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** True when [message], something he wrote, is about how she looks or what she is. */
+    fun asksAboutHerself(message: String): Boolean =
+        ABOUT_HER_LOOKS.containsMatchIn(message) || ABOUT_WHAT_SHE_IS.containsMatchIn(message)
+
+    /** True when she has a picture of herself among [pictures]. The background picture is not one. */
+    fun hasOwnPicture(pictures: List<PersonaPicture>): Boolean = pictures.any { it.kind == PersonaPicture.Kind.SELF }
+
+    /** The picture picked for one reply. [inTurn] says it was simply the next one, not picked by its caption. */
+    class Choice(val picture: PersonaPicture, val inTurn: Boolean)
+
+    /**
+     * Which of [pictures] she is shown: the picture of herself whose caption shares the
+     * most words with [hisMessage], and when none shares any, the next one in turn.
+     * Null when she has no picture of herself. The background picture is never picked.
+     */
+    fun choose(pictures: List<PersonaPicture>, hisMessage: String, turn: Int): Choice? {
+        val self = pictures.filter { it.kind == PersonaPicture.Kind.SELF }
+        if (self.isEmpty()) return null
+        val said = PersonaLibraryText.terms(hisMessage)
+        var best: PersonaPicture? = null
+        var bestShared = 0
+        for (picture in self) {
+            val shared = PersonaLibraryText.terms(picture.caption).count { it in said }
+            if (shared > bestShared) {
+                best = picture
+                bestShared = shared
+            }
+        }
+        return if (best != null) Choice(best, inTurn = false) else Choice(self[Math.floorMod(turn, self.size)], inTurn = true)
+    }
+
+    /**
+     * How far back a chat is read to see whether she has replied in it, when the rows
+     * her prompt is built from hold no reply of hers. A chat longer than this that has
+     * none in all these rows counts as one she has not replied in.
+     */
+    const val CHAT_ROWS_LOOKED_BACK = 2000
+
+    /**
+     * True when [rows], stored rows of one chat in the order they were written, hold a
+     * reply of hers to something he said: a line of hers right after one of his. Her
+     * line about a result is not one. It follows the app's own row about that result,
+     * so a chat that began with a command still has her first reply ahead of it.
+     */
+    fun holdsReplyOfHers(rows: List<ChatMessage>): Boolean =
+        rows.zipWithNext().any { (before, row) ->
+            before.sender == ChatMessage.Sender.USER && PersonaPrompts.isHers(row)
+        }
+
+    /**
+     * The picture of herself that goes with one reply, or null.
+     *
+     * She is shown herself on her first reply in a chat ([firstReply]), and whenever
+     * [hisMessage], the one message she is answering, is about how she looks. A command
+     * he gave the phone before it is not part of that message. Never in a reply that
+     * carries an image already ([imageAttached]): that is a screenshot of his screen,
+     * and the two must not be mistaken for each other.
+     */
+    fun pictureFor(
+        pictures: List<PersonaPicture>,
+        hisMessage: String,
+        firstReply: Boolean,
+        imageAttached: Boolean,
+        turn: Int
+    ): Choice? {
+        if (imageAttached) return null
+        if (!firstReply && !asksAboutHerself(hisMessage)) return null
+        return choose(pictures, hisMessage, turn)
+    }
+
+    /**
+     * True when [error] is one that a picture on the request can be the reason for: the
+     * provider turned the request down, has no such model for it, broke on it, or sent
+     * back nothing that can be read. A reply that fails this way with her picture on it
+     * is asked for once more without the picture.
+     *
+     * A host that declines to answer is one of them: a filter can object to a picture
+     * where it would let her words through.
+     *
+     * A missing or wrong key, spent credit, a rate limit, a host that cannot be reached
+     * and anything refused on the phone (the route, a missing address, a prompt that
+     * does not fit, a failed check of the encrypted route) are not: the same request
+     * without the picture would fail the same way, so nothing is sent a second time.
+     */
+    fun mayBeThePicture(error: LLMError): Boolean = when (error) {
+        LLMError.RequestInvalid,
+        LLMError.ModelUnavailable,
+        LLMError.ServerError,
+        LLMError.MalformedResponse,
+        LLMError.ProviderRefused,
+        // A model on the phone that fails says no more than that, as "unknown" did before.
+        LLMError.OnDeviceModelFailed,
+        LLMError.Unknown -> true
+        LLMError.AuthMissing,
+        LLMError.AuthInvalid,
+        LLMError.QuotaExhausted,
+        LLMError.RateLimited,
+        LLMError.Network,
+        LLMError.SafeFallbackUnavailable,
+        LLMError.ProviderUnrecognized,
+        LLMError.PrivateRouteRequired,
+        LLMError.PlainHttpRefused,
+        LLMError.EncryptedModelOnPlainProvider,
+        LLMError.EncryptedModelAtOtherAddress,
+        LLMError.EncryptionCheckFailed,
+        LLMError.AddressMissing,
+        LLMError.KeyForOtherAddress,
+        LLMError.AddressLedElsewhere,
+        LLMError.PromptTooLarge,
+        LLMError.ReplyModelForOtherProvider,
+        LLMError.ReplyLimitReached -> false
+    }
+
+    /**
+     * True when [error] says that the request itself was one the provider could not take:
+     * it turned the request down as not valid, or has no such model for it. When a reply
+     * with her picture fails that way and the same reply without it comes through, the
+     * picture was what the model would not take, and the model is remembered for it
+     * ([PersonaEngine.pictureRefused]).
+     *
+     * The other failures that get the second try ([mayBeThePicture]) say nothing of the
+     * kind. A server breaks, a model answers with nothing and a host declines her words
+     * on requests that carry no picture too, and a second request is sampled afresh. So
+     * after one of those she is simply sent a picture again next time.
+     */
+    fun saysThePictureWasNotTaken(error: LLMError): Boolean =
+        error == LLMError.RequestInvalid || error == LLMError.ModelUnavailable
+
+    /**
+     * [dialogue] as it is sent when she is shown [picture]: the image rides on his first
+     * message, and his words are not touched. Unchanged when there is no picture, when
+     * he has no message in it, or when any message carries an image already.
+     */
+    fun withOwnPicture(dialogue: List<ChatMessage>, picture: OwnPicture?): List<ChatMessage> {
+        if (picture == null || dialogue.any { it.imageBase64 != null }) return dialogue
+        val first = dialogue.indexOfFirst { it.sender == ChatMessage.Sender.USER }
+        if (first < 0) return dialogue
+        return dialogue.mapIndexed { index, message ->
+            if (index == first) message.copy(imageBase64 = picture.base64) else message
+        }
+    }
+
+    /** The captions that tell her what is on her pictures when she cannot be shown them: her own pictures only. */
+    fun captions(pictures: List<PersonaPicture>): List<String> {
+        val self = pictures.filter { it.kind == PersonaPicture.Kind.SELF }.filter { it.caption.isNotBlank() }
+        // His first, then the ones she made, newest first: where the list runs out of room, it is hers that go.
+        return self.filterNot { it.made }.map { it.caption.trim() } +
+            self.filter { it.made }.reversed().map { MADE_BY_HER + it.caption.trim() }
+    }
+
+    /** "I can't", "I won't", "I am unable to", the way a model writes it: with the apostrophe. */
+    private const val CANNOT =
+        """(?:i (?:can['’]t|cannot|can not|won['’]t|will not|am (?:unable|not able) to)|i['’]m (?:unable|not able) to)"""
+
+    /** What a refusal is about when it names it: the picture, the request, the people on it. */
+    private const val REFUSED_THING =
+        """(?:(?:this|that|it)(?=\s*(?:[.!,;:]|$))|(?:(?:this|that|the|these|those|any|your|such|an?) )?""" +
+            """(?:images?|pictures?|photos?|photographs?|content|requests?|people|persons?|individuals?)\b)"""
+
+    /** What follows "I can't" in a refusal: helping with it, complying, describing or seeing the picture. */
+    private const val REFUSED_ACT =
+        """(?:(?:help|assist)(?: you)?(?: with\b| in\b|\s*(?:[.!]|$))|(?:comply|fulfil+)\b|""" +
+            """(?:do|continue|proceed)(?: with)? (?:that|this)(?=\s*(?:[.!,;:]|$))|""" +
+            """(?:describe|identify|recogni[sz]e|view|see|read|process|analy[sz]e|interpret|look at|comment on|discuss|engage with) """ +
+            REFUSED_THING + """|provide (?:(?:a|an|any) )?(?:descriptions?|details|information|captions?|analysis)\b)"""
+
+    private const val APOLOGY =
+        """(?:(?:i['’]m|i am) (?:(?:so|very|really|truly) )?sorry|sorry|i apologi[sz]e|my apologies|apologies)"""
+
+    /**
+     * The sentences a model opens with when it declines, as opposed to anything she
+     * would say. Only the whole stock forms count: an apology that stops there or goes
+     * on to "I can't", "I can't" followed by what a refusal is about ("help with",
+     * "describe this image", "view images"), and "As an AI, I cannot".
+     *
+     * The opening words alone are not enough. "I can't help staring", "I'm sorry for
+     * whoever stands next to me" and "sorry, but nobody else pulls off this coat" are
+     * hers, and a caption like any other.
+     */
+    private val STOCK_REFUSAL = Regex(
+        """^\W*(?:""" + APOLOGY + """(?:(?:[,.!]? but)?\W*$|[,.!]?\s+(?:but\s+)?(?:""" + CANNOT + """\b|as an ai\b|""" +
+            """i (?:do not|don['’]t) feel comfortable\b|(?:this|that) is(?: not|n['’]t) something i can\b))|""" +
+            CANNOT + """ """ + REFUSED_ACT + """|""" +
+            """as an ai\b[^.!?\n]{0,40}?,? i (?:can['’]t|cannot|can not|won['’]t|will not|do not|don['’]t|am (?:unable|not able))\b)""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** True when [reply] is a model declining to look, not a description of a picture. */
+    fun isStockRefusal(reply: String): Boolean = STOCK_REFUSAL.containsMatchIn(reply.trim())
+}
