+        private val REQUEST_OPENINGS = listOf("can you", "could you", "would you", "will you", "can u", "could u")
+
+        private val ARTICLE = Regex("""\b(?:the|a|an|my)\s+""")
+
+        /** The small words that lead on to who something is said to: "play with me", "search for you". */
+        private val TOWARDS = setOf("to", "with", "for", "at", "on", "about")
+
+        /**
+         * What follows a word when the sentence is about the thing and not an order to
+         * it: "music is too loud", "the wifi was down", "phone keeps dying". Words that
+         * are also names ("will", "may") are left out, so that "call will" is still a call.
+         */
+        private val SAYS_SOMETHING_ABOUT_IT = setOf(
+            "is", "isn't", "isnt", "are", "aren't", "arent", "was", "wasn't", "wasnt", "were", "weren't", "werent",
+            "has", "hasn't", "hasnt", "had", "does", "doesn't", "doesnt", "did", "didn't", "didnt",
+            "keeps", "kept", "seems", "seemed", "feels", "felt"
+        )
+
+        /** His message past any address, in lower case, and whether a "can you" stood in front of it. */
+        private data class Addressed(val said: String, val asked: Boolean)
+
+        private fun pastAddress(query: String, names: Collection<String>): Addressed {
+            val openings = (ADDRESS_WORDS + REQUEST_OPENINGS + names.map { it.trim().lowercase() })
+                .filter { it.isNotEmpty() }
+                .sortedByDescending { it.length }
+            var rest = query.trim().lowercase().replace('\u2019', '\'').trimStart { !it.isLetterOrDigit() }
+            var asked = false
+            while (true) {
+                val opening = openings.firstOrNull { rest == it || rest.startsWith("$it ") || rest.startsWith("$it,") }
+                    ?: break
+                if (opening in REQUEST_OPENINGS) asked = true
+                rest = rest.removePrefix(opening).trimStart { !it.isLetterOrDigit() }
+            }
+            return Addressed(rest, asked)
+        }
+
+        /**
+         * The forced-action word or phrase [said] opens with, and what follows it, or
+         * null. Articles and "my" after the first word are skipped over, so that "set an
+         * alarm" opens with "set alarm" and "read my screen" with "read screen". An
+         * article in front is not: "the flashlight died" is a sentence about a
+         * flashlight. The longest match wins: "take me to" before any shorter word.
+         */
+        private fun openingOrder(said: String): Pair<String, String>? {
+            val firstWordEnd = said.indexOf(' ')
+            val text = if (firstWordEnd < 0) {
+                said
+            } else {
+                said.substring(0, firstWordEnd + 1) + ARTICLE.replace(said.substring(firstWordEnd + 1), "")
+            }
+            val pattern = FORCED_ACTION_PATTERNS.filter { opensWith(text, it) }.maxByOrNull { it.length }
+                ?: return null
+            return pattern to text.substring(pattern.length)
+        }
+
+        /**
+         * True when what follows an opening order shows that it was no order: it is said
+         * to her or about himself ("flash me", "call you later", "play with me", "send it"),
+         * or it says something about the thing ("music is too loud").
+         */
+        private fun turnsIntoTalk(afterOrder: String): Boolean {
+            val words = WORD.findAll(afterOrder).map { it.value }.take(2).toList()
+            val first = words.getOrNull(0) ?: return false
+            if (first in NOT_A_CONTACT || first in SAYS_SOMETHING_ABOUT_IT) return true
+            val second = words.getOrNull(1) ?: return false
+            return first in TOWARDS && second in NOT_A_CONTACT
+        }
+
+        /**
+         * Openings that are an order for the app only as a whole message, where they are
+         * an alias ("remember this" saves what is on the screen). With more behind them
+         * they ask her to remember something, and remembering is hers to do.
+         */
+        private val HERS_TO_DO = setOf("remember this")
+
+        /**
+         * What his message is while the persona is the one who talks. Nothing is sent
+         * anywhere to find out: the words decide, here on the phone.
+         *
+         * With her on, a message is hers unless it is plainly for the phone, because she
+         * can hand a real command on herself and a sentence taken from her cannot be
+         * given back. So a message is [MessageShape.Talk] unless one of these holds:
+         *
+         *  - The whole message is an alias ([AliasResolver.resolveWhole]): "flashlight",
+         *    "turn on the wifi", "volume 40", "read my screen". An alias inside a sentence
+         *    does not count, a question is not a shortcut, and the shortcuts that answer
+         *    for the app's own memory ("what do you remember about ...") never fire: a
+         *    question is put to her, and she has a notebook of her own. A word that is
+         *    also ordinary talk ("sleep", "light", "loud") counts only quite alone, with
+         *    no address in front of it.
+         *  - It follows up on the last switch ("turn it off"), except for the phrases
+         *    that are said to a person ([AliasResolver.talkFollowUps]).
+         *  - After an optional address (one of [names], "hey", "oi", "ok", "please", "can
+         *    you" and the like, each with a comma or a space), it opens with one of the
+         *    forced-action words: "open spotify", "call mom", "set an alarm for 7". It
+         *    does not count when the next words turn it into talk ([turnsIntoTalk]), when
+         *    it asks her to remember something ([HERS_TO_DO]), or when it ends in a
+         *    question mark that no "can you" explains ("text him back?" asks her what
+         *    she thinks).
+         *
+         * A command that sets an alarm or a timer the app can read by itself becomes a
+         * shortcut, as it does without her. A question about the screen is
+         * [MessageShape.ScreenTalk] when [screenshotReachesHer]: a screenshot was taken for
+         * the message and the model that writes her replies is given pictures. That holds
+         * for the bare question and for one with more behind it ("read my screen and tell
+         * me what it says"), but not for a wish to save what is on the screen, which stays
+         * the app's own action. Otherwise the app's own reader runs: as a shortcut for the
+         * bare question, through the planner for a longer one.
+         *
+         * [multiStep] is the loop's finding that the message asks for several things. It
+         * is a count of action words, so it holds the follow-up on the last switch and the
+         * alarm and timer shortcuts back, which read only part of the message. It does not
+         * hold a whole-message alias back: a message that is an alias and nothing else is
+         * one action, however many action words it is made of ("turn on the flashlight"
+         * counts three). [lastAction] and [lastParams] are the last thing that ran in
+         * this chat.
+         */
+        internal fun shapeWhilePersonaTalks(
+            query: String,
+            names: Collection<String>,
+            multiStep: Boolean,
+            screenshotReachesHer: Boolean,
+            lastAction: String? = null,
+            lastParams: Map<String, String>? = null
+        ): MessageShape {
+            val (said, asked) = pastAddress(query, names)
+            if (said.isEmpty()) return MessageShape.Talk
+
+            if (!multiStep) {
+                AliasResolver.resolveContextual(said, lastAction, lastParams, AliasResolver.talkFollowUps)
+                    ?.let { return MessageShape.Shortcut(it) }
+            }
+            // Not behind [multiStep]: the whole message is the alias, so there is nothing
+            // else in it that a shortcut could drop.
+            val alias = AliasResolver.resolveWhole(query)
+                ?: AliasResolver.resolveWhole(said)?.takeUnless { AliasResolver.isTalkWord(said) }
+            if (alias != null) {
+                val asksAboutScreen = alias.action == "ANALYZE_SCREENSHOT"
+                return if (asksAboutScreen && screenshotReachesHer) MessageShape.ScreenTalk else MessageShape.Shortcut(alias)
+            }
+
+            val (order, rest) = openingOrder(said) ?: return MessageShape.Talk
+            // "read my screen for me and sum it up": after a question about the screen,
+            // "for me" says who it is read to. It does not turn the order into talk.
+            val screenQuestion = AliasResolver.opensWithScreenQuestion(said)
+            if (order in HERS_TO_DO || (turnsIntoTalk(rest) && !screenQuestion)) return MessageShape.Talk
+            if (said.trimEnd().endsWith("?") && !asked) return MessageShape.Talk
+
+            // "read my screen and tell me what it says" opens like an order, and is still
+            // the question about the screen. With a screenshot she can read, she looks.
+            if (screenshotReachesHer && screenQuestion && !AliasResolver.isReadAndRememberRequest(said)) {
+                return MessageShape.ScreenTalk
+            }
+
+            if (!multiStep) {
+                if (order == "set alarm") {
+                    AliasResolver.extractAlarmTime(said)?.let { time ->
+                        return MessageShape.Shortcut(
+                            AliasResolver.ActionHint("SET_ALARM", mapOf("time" to time, "label" to "Alarm"))
+                        )
+                    }
+                }
+                if (order == "set timer") {
+                    AliasResolver.extractTimerDuration(said)?.let { seconds ->
+                        return MessageShape.Shortcut(
+                            AliasResolver.ActionHint("SET_TIMER", mapOf("duration" to seconds.toString(), "label" to "Timer"))
+                        )
+                    }
+                }
+            }
+            return MessageShape.Command
+        }
+
+        private val LEAD_INS = listOf(
+            "please", "pls", "plz", "hey", "ok", "okay", "now", "just", "then", "and", "also", "go",
+            "can you", "could you", "would you", "will you", "can u", "could u",
+            "i want you to", "i need you to"
+        ).sortedByDescending { it.length }
+
+        private val VOCATIVE = Regex("""^[^\s,]{1,24},\s*""")
+        private val FIRST_WORD = Regex("""^[a-z]+""")
+        private val WORD = Regex("""[a-z']+""")
+
+        /** [query] in lower case from its first real word on, past a name and any lead-ins. */
+        private fun opening(query: String): String {
+            var rest = query.trim().lowercase().trimStart { !it.isLetterOrDigit() }
+            // "babe, lock the screen": one word and a comma in front is someone being addressed.
+            rest = VOCATIVE.replaceFirst(rest, "")
+            while (true) {
+                val leadIn = LEAD_INS.firstOrNull { rest == it || rest.startsWith("$it ") || rest.startsWith("$it,") }
+                    ?: break
+                rest = rest.removePrefix(leadIn).trimStart { !it.isLetterOrDigit() }
+            }
+            return rest
+        }
+
+        private fun opensWithActionKeyword(opening: String): Boolean {
+            val first = FIRST_WORD.find(opening)?.value ?: return false
+            return first in ACTION_KEYWORDS
+        }
+
+        /**
+         * True when [opening] starts with [pattern] as whole words. A longer word that
+         * only begins the same way is not the command ("texture", "playing along",
+         * "phone's dying"): a command is given in the bare form.
+         */
+        private fun opensWith(opening: String, pattern: String): Boolean {
+            if (!opening.startsWith(pattern)) return false
+            val next = opening.getOrNull(pattern.length) ?: return true
+            return !isLatinWordChar(next) && next != '\''
+        }
+
+        /** The opening words that reach out to a person. */
+        private val REACHING_OUT = setOf("call", "dial", "ring", "phone", "message", "text", "sms", "whatsapp", "send")
+
+        /** Who such a word is followed by when it is said to her, not about a contact. */
+        private val NOT_A_CONTACT = setOf("me", "us", "you", "u", "it", "myself", "yourself")
+
+        /**
+         * "call me when you wake up", "text me later", "send me a picture", "call it a
+         * day": the phone cannot call or message its own owner, and nobody in his
+         * contacts is called "you" or "it". That is him talking to her.
+         */
+        private fun isAddressedToHer(opening: String): Boolean {
+            val words = WORD.findAll(opening).map { it.value }.take(2).toList()
+            return words.size == 2 && words[0] in REACHING_OUT && words[1] in NOT_A_CONTACT
+        }
+
+        private val FORCED_ACTION_PATTERNS = listOf(
+            "weather", "search", "search for", "google", "look up", "find",
+            "call", "dial", "ring", "phone",
+            "message", "text", "sms", "whatsapp", "send",
+            "open", "launch",
+            "navigate", "directions", "take me to",
+            "play", "music", "youtube",
+            "set alarm", "set timer", "set reminder",
+            "screenshot", "flashlight", "torch", "flash",
+            "wifi", "bluetooth", "brightness", "volume", "dnd", "hotspot",
+            "news", "translate", "convert", "calculate",
+            "book uber", "book ola",
+            "read screen", "remember this", "save this", "save to notes", "read notes", "my notes",
+            "what did i save", "what did i remember",
+            "social media", "social performance", "create post", "draft post",
+            "social report", "create campaign", "social inbox",
+            // Commands whose keyword sits inside a longer word. Substring matching used to
+            // catch them; word-start matching needs them spelled out.
+            "redial", "rebook", "recalculate", "retranslate", "reconvert",
+            "speakerphone", "headphone", "microphone"
+        )
+
+        /**
+         * True when [query] contains a forced-action word at the START of a word.
+         *
+         * These words used to match anywhere, so "ring" fired inside "boring", "text" inside
+         * "context" and "call" inside "basically", and ordinary conversation was sent to the
+         * planner. A word start still catches every inflection ("calling", "texted",
+         * "screenshots") without matching the middle of an unrelated word.
+         */
+        internal fun isForcedAction(query: String): Boolean =
+            FORCED_ACTION_PATTERNS.any { startsAWord(query, it) }
+
+        private fun startsAWord(query: String, pattern: String): Boolean {
+            var from = 0
+            while (true) {
+                val index = query.indexOf(pattern, from, ignoreCase = true)
+                if (index < 0) return false
+                if (index == 0 || !isLatinWordChar(query[index - 1])) return true
+                from = index + 1
+            }
+        }
+
+        /**
+         * Only Latin letters and digits join onto a keyword. Scripts written without
+         * spaces put a keyword straight after their own characters ("打开wifi"), and that
+         * is still the start of the word.
+         */
+        private fun isLatinWordChar(c: Char): Boolean =
+            c.isDigit() || (c.isLetter() && Character.UnicodeScript.of(c.code) == Character.UnicodeScript.LATIN)
+
         private val CONDITIONAL_MARKER = Regex("""\b(if|unless|in case|when)\b""")
         private val WHEN_QUESTION = Regex("""^\s*when\s+(is|are|was|were|do|does|did|will|should|can)\b""")
 
diff --git a/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
new file mode 100644
index 0000000..ff05e80
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/agent/PersonalDataResults.kt
@@ -0,0 +1,211 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * Which steps of a plan hold the owner's private data in their result, and how such a
+ * result is shown to a model whose host could read it.
+ *
+ * A step holds private data when its action reads some ([ActionSchema.readsPersonalData]),
+ * or when one of its parameters quotes the result of a step that does: "read my
+ * notifications, then show them" puts the notification text into the second step's result
+ * as well, although showing text reads nothing by itself. A step that reaches a contact
+ * through a saved pick names that contact in its result ([SavedPickNotice]); there only
+ * the name is private, not what the step did.
+ */
+internal object PersonalDataResults {
+
+    /**
+     * Ids of the steps in [steps] whose result holds private data. [canonicalNames] gives
+     * the dispatcher's names for a step's action and its fallback, either of which may have
+     * produced the result. [steps] is read in plan order, so a quote of an earlier step is
+     * seen after that step has been judged.
+     */
+    fun stepIdsHolding(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> {
+        val holding = LinkedHashSet<String>()
+        val quotable = LinkedHashSet<String>()
+        for (step in steps.sortedBy { it.order }) {
+            val reads = canonicalNames(step).any { name ->
+                ActionSchema.readsPersonalData(name) && !namesItsOwnPlace(name, step)
+            }
+            // The same "$stepId" form the executor substitutes. A longer id that starts the
+            // same way also matches, which only errs towards holding more back.
+            val quotes = quotable.any { id -> step.params.values.any { it.contains("$" + id) } }
+            if (reads || quotes) holding += step.stepId
+            // Quoting a step that names a saved contact repeats the name as well.
+            if (reads || quotes || namesSavedContact(step, canonicalNames)) quotable += step.stepId
+        }
+        return holding
+    }
+
+    /**
+     * Ids of the steps in [steps] whose result or error names the contact a saved pick
+     * stands for. Only the actions that resolve a contact can carry that notice.
+     */
+    fun stepIdsNamingContact(
+        steps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Set<String> = steps.filter { namesSavedContact(it, canonicalNames) }.mapTo(LinkedHashSet()) { it.stepId }
+
+    private fun namesSavedContact(step: PlanStep, canonicalNames: (PlanStep) -> Collection<String>): Boolean =
+        (SavedPickNotice.isIn(step.result) || SavedPickNotice.isIn(step.error)) &&
+            canonicalNames(step).any(ActionSchema::resultNamesContact)
+
+    /**
+     * The weather action looks up where he is only when the plan names no place. With a
+     * place in the plan the result is the weather there, which tells the planner's own
+     * route nothing the plan did not already say: a planner his details are held back
+     * from was never told where he is, so the place is one he named himself. A planner
+     * that was told everything may have filled in his town; what its plans say is marked
+     * as a whole where it is stored (see [planRowStaysPrivate]). Mirrors how the action reads its
+     * `location` parameter.
+     */
+    private fun namesItsOwnPlace(canonicalName: String, step: PlanStep): Boolean {
+        if (canonicalName != "GET_WEATHER") return false
+        val place = step.params["location"]?.trim().orEmpty()
+        return place.isNotEmpty() && !place.equals("current location", ignoreCase = true)
+    }
+
+    /**
+     * [steps] as a readable host may see them: everything about a step stays (that it ran,
+     * what it was, whether it worked) except the text of a result in [holding], and the
+     * name and number of a saved contact in a step in [namingContact].
+     */
+    fun heldBack(
+        steps: List<PlanStep>,
+        holding: Set<String>,
+        namingContact: Set<String> = emptySet()
+    ): List<PlanStep> = steps.map { step ->
+        val result = step.result
+        when {
+            step.stepId in holding && !result.isNullOrBlank() -> step.copy(result = placeholder(result))
+            step.stepId in namingContact -> step.copy(
+                result = result?.let(SavedPickNotice::withheld),
+                error = step.error?.let(SavedPickNotice::withheld)
+            )
+            else -> step
+        }
+    }
+
+    /**
+     * [steps] of one plan as a prompt on the main route may carry them. A step result can
+     * be the text of his notifications, messages, clipboard or screen. On a private route
+     * the model reads it like everything else; on a hosted route with private mode on the
+     * text stays on the phone and the model is told only that the step ran and has a
+     * result. [plan] is every step of the plan, so that a quote of an earlier step is seen
+     * whichever of the lists the quoting step is in.
+     */
+    fun forPrompt(
+        config: LLMConfig,
+        steps: List<PlanStep>,
+        plan: List<PlanStep> = steps,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): List<PlanStep> {
+        if (!config.mainRouteHoldsBack()) return steps
+        return heldBack(steps, stepIdsHolding(plan, canonicalNames), stepIdsNamingContact(plan, canonicalNames))
+    }
+
+    /**
+     * True when the summary of a run repeats text that holds private data. A run that
+     * worked ([isSuccess]) is summed up from the results of its completed steps, one that
+     * failed from the error of a failed step.
+     */
+    fun summaryHolds(
+        steps: List<PlanStep>,
+        isSuccess: Boolean,
+        canonicalNames: (PlanStep) -> Collection<String>
+    ): Boolean {
+        val naming = stepIdsNamingContact(steps, canonicalNames)
+        if (!isSuccess) return steps.any { it.status == StepStatus.FAILED && it.stepId in naming }
+        val holding = stepIdsHolding(steps, canonicalNames)
+        return steps.any {
+            it.status == StepStatus.COMPLETED && !it.result.isNullOrBlank() &&
+                (it.stepId in holding || it.stepId in naming)
+        }
+    }
+
+    /**
+     * Stands in for a result that stays on the phone. It still says that there was one and
+     * how long it is, which is enough to tell "nothing found" from a full answer, and that
+     * a later step can use it: the phone fills `$stepId` in itself.
+     */
+    fun placeholder(result: String): String =
+        "[kept on the phone: ${result.length} characters of the owner's private data. " +
+            "Later steps can still use this result by its step id.]"
+}
+
+/**
+ * The notice an action puts in front of its result when it reached a contact through a
+ * pick he saved earlier: the picker is skipped then, so the result has to say who was
+ * chosen. It names someone from his contacts and shows part of the number, which a model
+ * whose host could read the prompt is not given. The notice is written and recognised
+ * here, so that the two cannot drift apart.
+ */
+internal object SavedPickNotice {
+
+    /** The notice for a contact called [name] whose number is shown as [maskedNumber]. */
+    fun of(name: String, maskedNumber: String): String = "Using $name ($maskedNumber). "
+
+    /** What a readable host gets in its place: that a saved pick was used, not whose. */
+    const val WITHHELD = "Using a saved contact (the name stays on the phone). "
+
+    // Lazy up to the first ")." after an opening parenthesis: that is where the notice
+    // ends, whatever parentheses the name ("Riya (work)") or the number ("(555)***") has.
+    private val FORM = Regex("""Using .+? \(.*?\)\.(?: |$)""")
+
+    /** True when [text] carries the notice, at its start or after an "it failed" prefix. */
+    fun isIn(text: String?): Boolean = text != null && FORM.containsMatchIn(text)
+
+    /** [text] with the notice replaced by [WITHHELD]; everything else is left as it is. */
+    fun withheld(text: String): String = FORM.replace(text, Regex.escapeReplacement(WITHHELD))
+}
+
+/**
+ * The lists of steps the re-evaluation and re-plan prompts are built from, as text. Both
+ * prompts go to the main route, so completed and failed steps pass through
+ * [PersonalDataResults.forPrompt] first.
+ */
+internal object ReEvalInputs {
+
+    /** What the re-evaluation call reads after a step. */
+    fun afterStep(
+        config: LLMConfig,
+        originalGoal: String,
+        completedSteps: List<PlanStep>,
+        failedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String
+    ): String {
+        val plan = completedSteps + failedSteps + remainingSteps
+        return """
+            - Original goal: $originalGoal
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Failed steps: ${encode(PersonalDataResults.forPrompt(config, failedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+
+    /** What the re-plan call reads after a step named an action that does not exist. */
+    fun afterUnknownAction(
+        config: LLMConfig,
+        failedStep: PlanStep,
+        completedSteps: List<PlanStep>,
+        remainingSteps: List<PlanStep>,
+        canonicalNames: (PlanStep) -> Collection<String>,
+        encode: (List<PlanStep>) -> String,
+        encodeStep: (PlanStep) -> String
+    ): String {
+        val plan = completedSteps + failedStep + remainingSteps
+        return """
+            - Failed step: ${encodeStep(failedStep)}
+            - Completed steps: ${encode(PersonalDataResults.forPrompt(config, completedSteps, plan, canonicalNames))}
+            - Remaining steps: ${encode(remainingSteps)}
+        """.trimIndent()
+    }
+}
