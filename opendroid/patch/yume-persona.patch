+/**
+ * New pictures of herself, made by her. She starts from a picture of herself that she
+ * already has and says what is to be different: a pose, a place, what she wears, how
+ * much of it. An image model then edits that picture, so the new one is still her face,
+ * her hair, her metal. The picture comes back to the phone and is kept with the others
+ * ([PersonaPictures.addMade]); she can see and name it like any picture of herself.
+ *
+ * What leaves the phone for it is the picture she starts from and the text built here:
+ * the look her picture file fixes (kisaragi-pics, "After-state prompt lock") and her
+ * own words about the change. Nothing of his goes into it: his name is taken out of
+ * her words before they are sent. The model it goes to is a private one of Venice's
+ * (no prompt or image kept), set in [LLMConfig.personaPictureModel].
+ *
+ * Everything but the request itself is a decision about text, and is here so it can
+ * be read and tested without a phone.
+ */
+object PersonaSelfPictures {
+
+    /** The host her pictures are made on. Its key is the one his Venice provider already holds. */
+    const val HOST = "api.venice.ai"
+
+    /** The endpoint that edits one picture from a prompt, and answers with the picture itself. */
+    const val EDIT_URL = "https://$HOST/api/v1/image/edit"
+
+    /** The edit model as this build ships it: private, uncensored, keeps a face from its source. */
+    const val DEFAULT_MODEL = "qwen-edit-uncensored"
+
+    /** What that model reads at most. The look and her words together are cut to fit. */
+    const val MAX_PROMPT_CHARS = 1500
+
+    /** Her own words about the change, at most. The rest of the prompt is her look. */
+    const val MAX_ASK_CHARS = 500
+
+    /** The heading of the section of her picture file that fixes how she looks. */
+    const val LOOK_HEADING = "After-state prompt lock"
+
+    /** Who she is, in the words every prompt opens with: a young adult woman of [age]. */
+    private fun adult(age: Int) =
+        "She is a young adult woman, ${maxOf(PersonaAge.AGE_IN_FILES, age)} years old, with a grown face and a grown body. "
+
+    private const val KEEP =
+        "Keep her face and features exactly as they are in the source picture: the same face, eyes and ahoge. " +
+            "Her hair, tan, metal and clothes stay as in the source picture unless her look now or the change says otherwise. "
+
+    /**
+     * Words that ask for the girl she was before, or for her younger than she is or
+     * childlike. Those are not made: the before girl is never put in a picture of this
+     * kind, and she is never drawn younger than the 19 she is. "Young" itself is no such
+     * word: she is a young woman, and a young-looking 19 is her.
+     */
+    private val NOT_MADE = Regex(
+        """(?i)\b(?:satomi|before (?:state|picture|look|girl|me)|the old me|old self|round glasses|glasses on|""" +
+            """sweater vest|navy vest|red bow|long (?:navy )?skirt|backpack|school ?girl|school uniform|""" +
+            """child|children|childlike|kid|kids|little girl|loli|lolita|underage|""" +
+            """younger|elementary|middle school)\b"""
+    )
+
+    /** Why [ask] is not made, or null when it may be. */
+    fun refusal(ask: String): String? {
+        if (ask.isBlank()) return "Nothing was said about what the picture should show."
+        return refusalOfWords(ask)
+    }
+
+    /** Why words that pick or describe a picture of her rule it out, or null. Blank words rule nothing out. */
+    fun refusalOfWords(words: String?): String? =
+        if (words != null && NOT_MADE.containsMatchIn(words)) {
+            "Not made: a picture of her is always of her now, never of the girl before and never younger or childlike."
+        } else {
+            null
+        }
+
+    /**
+     * Whether a picture may be made where [config] stands: switched on, with a Venice key,
+     * and not on a privacy setting that keeps everything on his own hardware. Asked by the
+     * action and by her prompt alike, so she is told she can only where she can.
+     */
+    fun allowed(config: LLMConfig): Boolean =
+        config.personaMakesPictures && config.routePolicy != com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE &&
+            veniceKey(config) != null
+
+    /** Why no picture may be made where [config] stands, or null when one may. */
+    fun notAllowed(config: LLMConfig): String? = when {
+        !config.personaMakesPictures -> "Making pictures of her is switched off in Settings, Persona."
+        config.routePolicy == com.opendroid.ai.data.models.RoutePolicy.OWN_HARDWARE ->
+            "Not made: the privacy setting keeps every model on your own hardware, and pictures are made on Venice."
+        veniceKey(config) == null -> "No Venice key is set, so no picture can be made."
+        else -> null
+    }
+
+    /** Words that make a note of hers about herself one about how she looks. */
+    private val LOOK_WORDS = Regex(
+        """(?i)\b(?:hair|dye[ds]?|dyed|bleach\w*|roots|fringe|bangs|ahoge|tan|tanned|skin|nails?|lashes|liner|make-?up|lipstick|gloss|""" +
+            """piercings?|pierced|hoops?|stud|barbell|tattoos?|ink|outfit|wear(?:s|ing)?|wore|skirt|shirt|bandeau|boots|heels|""" +
+            """choker|cuffs|stockings|thigh-?highs|colou?r|look|style|eyes|brows?)\b"""
+    )
+
+    /** The most of her own words about her look that go into a picture's prompt. */
+    const val MAX_LOOK_NOW_CHARS = 400
+
+    /**
+     * How she looks now in her own words: her notes about herself that are about her
+     * look, newest first, as many as fit. A note that speaks of him, a street story and
+     * a note about anything else stay out: only her look goes to the image model.
+     */
+    fun lookNow(notes: List<PersonaNotes.Note>, ownerName: String): String {
+        val lines = ArrayList<String>()
+        var used = 0
+        for (note in notes) {
+            if (note.kind != PersonaNotes.Kind.ME || note.isStreetStory || PersonaNotes.canBeAboutHim(note, ownerName)) continue
+            if (!LOOK_WORDS.containsMatchIn(note.text)) continue
+            val text = withoutHim(note.text, ownerName).trimEnd('.')
+            if (used + text.length + 2 > MAX_LOOK_NOW_CHARS) continue
+            lines += text
+            used += text.length + 2
+        }
+        return lines.joinToString("; ")
+    }
+
+    /**
+     * [ask] without his name, in any case: the whole name first, then every part of it of
+     * two letters or more, each on its own. Cut to [MAX_ASK_CHARS].
+     */
+    fun withoutHim(ask: String, ownerName: String): String {
+        var text = ask.replace(Regex("""\s+"""), " ").trim()
+        for (pattern in hisNamePatterns(ownerName)) text = pattern.replace(text, "him")
+        return if (text.length > MAX_ASK_CHARS) text.take(MAX_ASK_CHARS).trimEnd() else text
+    }
+
+    /**
+     * Whether [text] holds his name or a part of it, by the rule [withoutHim] takes them
+     * out by. The check on what leaves the phone from her own space uses it
+     * ([com.opendroid.ai.core.life.OutgoingGuard]).
+     */
+    fun holdsHisName(text: String, ownerName: String): Boolean =
+        hisNamePatterns(ownerName).any { it.containsMatchIn(text) }
+
+    /** His whole name, then every part of it of two letters or more, each as a whole word in any case. */
+    private fun hisNamePatterns(ownerName: String): List<Regex> {
+        val name = ownerName.trim()
+        val parts = listOf(name) + name.split(Regex("""[^\p{L}\p{N}]+""")).filter { it.length >= 2 }
+        return parts.filter { it.length >= 2 }.distinct().map { part ->
+            Regex("""(?i)(?<![\p{L}\p{N}])${Regex.escape(part)}(?![\p{L}\p{N}])""")
+        }
+    }
+
+    /** A run of digits as long as a phone number, a street number with a postcode, a date of birth. */
+    private val LONG_NUMBER = Regex("""\d[\d\s().-]{4,}\d""")
+
+    /** An address on the net. */
+    private val ADDRESS = Regex("""(?i)[\w.+-]+@[\w-]+\.\w|https?://|www\.""")
+
+    /**
+     * Why [words] would carry something of his to the image model, or null. They do when
+     * they repeat what her notes about him say ([hisNotes]: what she knows about him and
+     * where the two of them stand), or hold a long number or an address. Her words are
+     * then not sent at all: what is his never leaves the phone for a picture.
+     */
+    fun carriesHisDetails(words: String, hisNotes: String): String? = when {
+        LONG_NUMBER.containsMatchIn(words) || ADDRESS.containsMatchIn(words) ->
+            "Not made: what the picture should show holds a number or an address, and nothing like that goes out with a picture."
+        repeatsHisNotes(words, hisNotes) ->
+            "Not made: what the picture should show repeats what her notes say about you, and that stays on the phone."
+        else -> null
+    }
+
+    /**
+     * Whether [words] repeat what her notes about him say ([hisNotes]): a number, an
+     * address or a handle that stands there, or most of their words. Shared with the check
+     * on what leaves the phone from her own space ([com.opendroid.ai.core.life.OutgoingGuard]).
+     */
+    fun repeatsHisNotes(words: String, hisNotes: String): Boolean =
+        hisNotes.isNotBlank() && PersonaActions.echoesOutsideText(words, hisNotes)
+
+    /**
+     * The section of her picture file that fixes her look, from the file's raw text, or
+     * an empty text when the file has none.
+     */
+    fun look(picturesFile: String): String {
+        val lines = picturesFile.lines()
+        val start = lines.indexOfFirst { it.trim().removePrefix("##").trim().startsWith(LOOK_HEADING, ignoreCase = true) }
+        if (start < 0) return ""
+        return lines.drop(start + 1).takeWhile { !it.trimStart().startsWith("#") }
+            .joinToString(" ") { it.trim() }.replace(Regex("""\s+"""), " ").trim()
+    }
+
+    /**
+     * The prompt for the edit: who she is (an adult), what to keep, what to change, and
+     * her look as her picture file fixes it, cut to what the model reads. Her words come
+     * before the look, so a long look cannot push them out.
+     */
+    fun prompt(ask: String, look: String, age: Int = PersonaAge.AGE_IN_FILES, lookNow: String = ""): String {
+        val now = lookNow.trim().takeIf { it.isNotEmpty() }?.let { "Her look now, in her own words, which comes before anything below: $it. " }.orEmpty()
+        val head = adult(age) + KEEP + now + "Change: " + ask.trim().trimEnd('.') + ". "
+        val room = MAX_PROMPT_CHARS - head.length - LOOK_LABEL.length
+        val lookPart = if (look.isBlank() || room <= 40) "" else LOOK_LABEL + look.take(room).trimEnd()
+        return (head + lookPart).take(MAX_PROMPT_CHARS).trim()
+    }
+
+    private const val LOOK_LABEL = "Her look as she started, where her look now does not say otherwise: "
+
+    /**
+     * One side of her in a full-body reference: the views a turnaround is made of, so
+     * that clothes, hair, piercings and tattoos can be worked out on her body later.
+     */
+    enum class View(val word: String, val shot: String) {
+        FRONT("front", "seen straight from the front, facing the camera"),
+        BACK("back", "seen straight from behind, her back to the camera; what is only on her front (the tally on the front of her right thigh, her face) is not seen"),
+        LEFT("left side", "seen from her left side in full profile, facing to the left of the picture"),
+        RIGHT("right side", "seen from her right side in full profile, facing to the right of the picture")
+    }
+
+    /**
+     * The views asked for in [words] ("front, back", "left", "all sides", "turnaround"),
+     * in the order front, back, left, right. Empty when [words] ask for none, and then
+     * the picture is an ordinary one.
+     */
+    fun views(words: String?): List<View> {
+        val asked = words?.lowercase()?.trim().orEmpty()
+        if (asked.isEmpty()) return emptyList()
+        if (Regex("""\b(?:all|every|turn-?around|reference sheet|all sides|four)\b""").containsMatchIn(asked)) return View.entries.toList()
+        return View.entries.filter { view ->
+            when (view) {
+                View.FRONT -> Regex("""\bfront\b""").containsMatchIn(asked)
+                View.BACK -> Regex("""\b(?:back|behind|rear)\b""").containsMatchIn(asked)
+                View.LEFT -> Regex("""\bleft\b""").containsMatchIn(asked) || (Regex("""\bsides?\b""").containsMatchIn(asked) && !Regex("""\bright\b""").containsMatchIn(asked))
+                View.RIGHT -> Regex("""\bright\b""").containsMatchIn(asked) || (Regex("""\bsides?\b""").containsMatchIn(asked) && !Regex("""\bleft\b""").containsMatchIn(asked))
+            }
+        }
+    }
+
+    /** What a body reference shows when nothing else is asked: all of her, nothing in the way. */
+    const val BARE_REFERENCE =
+        "she wears nothing at all: no clothes, no shoes, no choker, no cuffs, nothing held, so her whole body can be seen as it is, to design clothes on later; her piercings stay where they are"
+
+    /**
+     * The prompt for one [view] of a full-body reference of her. [ask] is what she wants
+     * on it (what she wears, if anything); blank gives [BARE_REFERENCE]. The clothes in
+     * her look as she started are left off unless [ask] puts them on.
+     */
+    fun referencePrompt(view: View, ask: String, look: String, age: Int = PersonaAge.AGE_IN_FILES, lookNow: String = ""): String {
+        val wearing = ask.trim().trimEnd('.').ifEmpty { BARE_REFERENCE }
+        val shot = "Make a full-body character reference picture of her, ${view.shot}: standing straight in a relaxed neutral pose, " +
+            "arms a little away from her body, feet slightly apart, the whole body from the top of her head to her feet in the frame, " +
+            "plain light grey background, even soft studio light, nothing in front of her. Her proportions are her own: petite and slender, " +
+            "a grown woman's body. On it, $wearing. Any clothes in her look below are left off unless this says to put them on."
+        // Her own look notes are cut shorter here, so that the shot and what she wears always fit.
+        return prompt(shot, look, age, lookNow.take(REFERENCE_LOOK_NOW_CHARS))
+    }
+
+    private const val REFERENCE_LOOK_NOW_CHARS = 200
+
+    /** The caption a picture of one view is kept with. */
+    fun referenceCaption(view: View, ask: String): String =
+        "body reference, ${view.word} view" + ask.trim().trimEnd('.').takeIf { it.isNotEmpty() }?.let { ": $it" }.orEmpty()
+
+    /**
+     * The picture a new one starts from. [from] are her words about which one ("the one
+     * on the stairs"); the picture whose caption shares most words with them is taken.
+     * Without such words, or when none shares any, the first picture he added is taken:
+     * his pictures are her likeness, and a picture made from a made one drifts.
+     * Null when she has no picture of herself at all.
+     */
+    fun base(pictures: List<PersonaPicture>, from: String?): PersonaPicture? {
+        // A picture whose caption names the girl before, or her younger, is never started from.
+        val self = pictures.filter { it.kind == PersonaPicture.Kind.SELF && refusalOfWords(it.caption) == null }
+        if (self.isEmpty()) return null
+        val wanted = from?.let(PersonaLibraryText::terms).orEmpty()
+        if (wanted.isNotEmpty()) {
+            val best = self.maxByOrNull { picture -> PersonaLibraryText.terms(picture.caption).count { it in wanted } }
+            if (best != null && PersonaLibraryText.terms(best.caption).any { it in wanted }) return best
+        }
+        return self.firstOrNull { !it.made } ?: self.first()
+    }
+
+    /**
+     * The key his Venice provider holds: the key of the provider whose address is on
+     * [HOST]. Null when he has none there, and then no picture is made.
+     */
+    /**
+     * The key a picture of hers goes out with: in her own time ([ownTime], a call of hers
+     * under an [com.opendroid.ai.core.life.OwnCall]) her own-time key where he set one, so
+     * that its spending limit stands behind it; else his Venice provider's key ([veniceKey]).
+     * Either goes to [HOST] only.
+     */
+    fun keyFor(config: LLMConfig, ownTime: Boolean): String? =
+        (if (ownTime) config.personaOwnTimeKey.trim().takeIf { it.isNotEmpty() } else null) ?: veniceKey(config)
+
+    fun veniceKey(config: LLMConfig): String? =
+        config.customEndpoints.entries
+            .firstOrNull { (_, url) -> RouteClassifier.hostOf(url) == HOST }
+            ?.let { (provider, _) -> config.apiKeys[provider] }
+            ?.trim()
+            ?.takeIf { it.isNotEmpty() }
+
+    /** How the result of a picture she made opens. The id after it names the picture in her store. */
+    const val MADE_PREFIX = "Made a new picture of her (picture "
+
+    private val MADE_LINE = Regex(Regex.escape(MADE_PREFIX) + """([A-Za-z0-9-]{1,80})\): ?([^\n]*)""")
+
+    /** The ids of the pictures a row says she made, in the order it names them. */
+    fun madePictureIds(text: String?): List<String> =
+        text?.let { MADE_LINE.findAll(it).map { match -> match.groupValues[1] }.toList() }.orEmpty()
+
+    /** The captions of the pictures a row says she made: her own words about each. */
+    fun madePictureCaptions(text: String?): List<String> =
+        text?.let { MADE_LINE.findAll(it).map { match -> match.groupValues[2].trim() }.filter { c -> c.isNotEmpty() }.toList() }.orEmpty()
+
+    /** [text] as it is shown under those pictures: without the ids, which mean nothing to him. */
+    fun shownWithoutIds(text: String): String =
+        MADE_LINE.replace(text) { match -> "Made a new picture of her: " + match.groupValues[2] }
+
+    /** The caption a picture she made is kept with: her words about it. */
+    fun caption(ask: String): String = ask.replace(Regex("""\s+"""), " ").trim().trimEnd('.')
+
+    /** The JSON body of the edit request. */
+    fun body(model: String, imageBase64: String, prompt: String): String = buildJsonObject {
+        put("model", model.ifBlank { DEFAULT_MODEL })
+        put("image", imageBase64)
+        put("prompt", prompt)
+        // Unblurred: pictures of her can be explicit (kisaragi-pics), and the phone is his.
+        put("safe_mode", false)
+        put("output_format", "png")
+    }.toString()
+
+    /** What came of a request to make a picture. */
+    sealed class Made {
+        class Picture(val bytes: ByteArray) : Made()
+        class Failed(val why: String) : Made()
+    }
+
+    /**
+     * Sends the edit and waits for the picture. A cancel (he pressed Stop, or wrote
+     * something new) cancels the request itself. Never throws for a failed request.
+     */
+    suspend fun request(client: OkHttpClient, key: String, body: String): Made = withContext(Dispatchers.IO) {
+        val slow = client.newBuilder()
+            .readTimeout(150, TimeUnit.SECONDS)
+            .writeTimeout(60, TimeUnit.SECONDS)
+            .callTimeout(180, TimeUnit.SECONDS)
+            .build()
+        val request = Request.Builder()
+            .url(EDIT_URL)
+            .header("Authorization", "Bearer $key")
+            .post(body.toRequestBody("application/json".toMediaType()))
+            .build()
+        try {
+            slow.cancellable(request) { response ->
+                val type = response.header("Content-Type").orEmpty()
+                when {
+                    response.isSuccessful && type.startsWith("image/") ->
+                        response.body?.bytes()?.takeIf { it.isNotEmpty() }?.let { Made.Picture(it) }
+                            ?: Made.Failed("The image service sent back no picture.")
+                    response.isSuccessful -> Made.Failed("The image service did not send back a picture.")
+                    response.code == 401 || response.code == 403 -> Made.Failed("The image service did not take the Venice key.")
+                    response.code == 402 -> Made.Failed("The Venice balance is too low to make a picture.")
+                    response.code == 429 -> Made.Failed("The image service is busy. Try again in a minute.")
+                    else -> Made.Failed("The image service said no (${response.code}).")
+                }
+            }
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            throw e
+        } catch (e: java.net.SocketTimeoutException) {
+            Made.Failed("The image service took too long to answer. The picture may have been made and charged, but none came back.")
+        } catch (e: java.io.InterruptedIOException) {
+            Made.Failed("The image service took too long to answer. The picture may have been made and charged, but none came back.")
+        } catch (e: java.net.UnknownHostException) {
+            Made.Failed("The image service could not be reached.")
+        } catch (e: java.net.ConnectException) {
+            Made.Failed("The image service could not be reached.")
+        } catch (e: Exception) {
+            Made.Failed("The connection to the image service broke off. No picture came back.")
+        }
+    }
+}
