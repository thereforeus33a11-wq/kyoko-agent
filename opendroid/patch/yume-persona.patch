new file mode 100644
index 0000000..942ea4c
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/memory/MemoryManagerLeanContextTest.kt
@@ -0,0 +1,184 @@
+package com.opendroid.ai.core.memory
+
+import android.app.Application
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.agent.DeviceStateProvider
+import com.opendroid.ai.core.memory.graph.PersonalGrowthEngine
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.SensitiveMemoryStore
+import com.opendroid.ai.core.security.UserProfile
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.ConversationRepository
+import com.opendroid.ai.data.repository.MemoryRepository
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * Private mode: the context that goes out with a prompt leaves the owner's date of
+ * birth, location and notification-derived text on the phone. With it off, the context
+ * is exactly what it always was.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class MemoryManagerLeanContextTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memoryRepository: MemoryRepository
+    private lateinit var manager: MemoryManager
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        val conversationRepository = ConversationRepository(
+            database,
+            database.conversationDao(),
+            database.chatSessionDao()
+        )
+        val extractor = MemoryExtractor(memoryRepository)
+        val workingMemory = WorkingMemory(context, DeviceStateProvider(context))
+        val notificationIntelligence = NotificationIntelligence(database.notificationDao(), memoryRepository)
+        manager = MemoryManager(
+            workingMemory = workingMemory,
+            episodicMemory = EpisodicMemory(conversationRepository),
+            semanticMemory = SemanticMemory(memoryRepository, extractor),
+            proceduralMemory = ProceduralMemory(memoryRepository),
+            personalGrowthEngine = PersonalGrowthEngine(
+                memoryRepository = memoryRepository,
+                sensitiveMemoryStore = NoSensitiveMemory,
+                workingMemory = workingMemory,
+                notificationIntelligence = notificationIntelligence
+            ),
+            memoryExtractor = extractor,
+            conversationRepository = conversationRepository,
+            memoryRepository = memoryRepository,
+            notificationIntelligence = notificationIntelligence,
+            userProfileStore = NamedProfile,
+            context = context
+        )
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `lean context leaves date of birth and location on the phone`() = runBlocking {
+        memoryRepository.saveMemory(Memory("wife_name", "Sara", MemoryType.SEMANTIC))
+
+        val lean = manager.getRelevantContext("text my wife", lean = true)
+
+        assertTrue(lean, lean.contains("User Name: Sam"))
+        assertTrue(lean, lean.contains("wife_name: Sara"))
+        assertFalse(lean, lean.contains(DOB))
+        assertFalse(lean, lean.contains("Date of Birth"))
+        assertFalse(lean, lean.contains("Location="))
+        assertFalse(lean, lean.contains("Recent Notifications"))
+        assertFalse(lean, lean.contains("Learned Communication Patterns"))
+        assertTrue(lean, lean.contains("Battery="))
+    }
+
+    @Test
+    fun `lean context leaves where he lives, how to reach him, his notes and what was learned on the phone`() = runBlocking {
+        val stays = mapOf(
+            "user_location" to "Fernhill",
+            "home_address" to "12 Orchard Lane",
+            "office_address" to "4 Mill Road",
+            "user_phone" to "+15550100",
+            "work email" to "sam@example.org",
+            "screen_note_meeting_1700000000000" to "Topic: meeting\nRiya wrote: see you at nine",
+            "note_shopping_1700000000001" to "Title: shopping\nbeeswax and jars"
+        )
+        stays.forEach { (key, value) -> memoryRepository.saveMemory(Memory(key, value, MemoryType.SEMANTIC)) }
+        memoryRepository.saveMemory(Memory("wife_name", "Sara", MemoryType.SEMANTIC))
+        memoryRepository.saveMemory(Memory("hobby", "he keeps bees", MemoryType.SEMANTIC))
+        manager.personalGrowthEngine.recordExplicitMemory(label = "Favourite drink", summary = "oolong tea")
+
+        val full = manager.getRelevantContext("text my wife", lean = false)
+        val lean = manager.getRelevantContext("text my wife", lean = true)
+
+        // On a private route nothing is held back.
+        stays.forEach { (key, value) ->
+            assertTrue("$key missing from the full context", full.contains("$key: $value"))
+        }
+        assertTrue(full, full.contains("[Personal Knowledge Graph"))
+        assertTrue(full, full.contains("oolong tea"))
+
+        stays.forEach { (key, value) ->
+            assertFalse("$key left in the lean context", lean.contains(key))
+            assertFalse("$key left in the lean context", lean.contains(value))
+        }
+        assertFalse(lean, lean.contains("[Personal Knowledge Graph"))
+        assertFalse(lean, lean.contains("oolong tea"))
+        // What a plan needs to act on a plain request is still there.
+        assertTrue(lean, lean.contains("wife_name: Sara"))
+        assertTrue(lean, lean.contains("hobby: he keeps bees"))
+    }
+
+    @Test
+    fun `a fact's key decides whether it stays on the phone`() {
+        for (key in listOf(
+            "user_location", "home_address", "office_address", "user_phone", "Home Address", "my-email",
+            "phone", "city", "work_email", "birthday", "user_dob", "home", "gps_coordinates",
+            "screen_note_meeting_17", "note_shopping_17", "NOTE_todo_3"
+        )) {
+            assertTrue(key, factStaysOnThePhone(key))
+        }
+        for (key in listOf(
+            "user_name", "wife_name", "husband_name", "hobby", "favourite_food", "homework_day",
+            "smartphone_case", "notes_app", "keynote_date", "telegram_handle_style"
+        )) {
+            assertFalse(key, factStaysOnThePhone(key))
+        }
+    }
+
+    @Test
+    fun `the default context is unchanged`() = runBlocking {
+        val full = manager.getRelevantContext("text my wife")
+
+        assertTrue(full, full.contains("User Date of Birth (DOB): $DOB"))
+        assertTrue(full, full.contains("Location="))
+        assertEquals(full, manager.getRelevantContext("text my wife", lean = false))
+    }
+
+    private object NamedProfile : UserProfileStore {
+        override fun read(): ProfileStoreResult<UserProfile?> = ProfileStoreResult.Success(UserProfile("Sam", DOB))
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+
+    private companion object {
+        const val DOB = "1990-04-01"
+    }
+}
