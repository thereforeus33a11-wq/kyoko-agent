@@ -0,0 +1,566 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.intOrNull
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * One picture she has on the phone. A [Kind.SELF] picture shows her and can be put in
+ * front of her. The single [Kind.BACKGROUND] picture is what made her: it is kept for
+ * the owner to read into the text that lies under her awareness, and is never shown to
+ * her and never named to her.
+ */
+@Serializable
+data class PersonaPicture(
+    val id: String,
+    /** Name of the image file, next to the index. Never a path. */
+    val file: String,
+    val kind: Kind,
+    /** What is on it, the way she would say it. Empty until somebody wrote one. */
+    val caption: String = "",
