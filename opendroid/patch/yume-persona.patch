+        time.afterSearchTap = searchPage.copy(packageName = "com.google.android.youtube")
+        reply("do: watch 12", "do: done")
+        go(host(), "watch eurobeat edits")
+        assertEquals(listOf("com.google.android.youtube"), time.opened)
+        assertEquals(listOf("eurobeat edits"), time.searched)
+        assertEquals(HerLog.Kind.WATCH, entry().kind)
+        assertTrue(mind.texts.first().contains("you are in youtube"))
+    }
+
+    // ── Her eyes ────────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `she sees a fresh look at the screen each step, and a protected screen is said to be one`() {
+        time.frameNow = PhoneTime.Frame.Taken(ByteArray(64) { 7 })
+        eyes.seen.addLast(HerEyes.Seen.Shown("BASE64PICTURE", KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT))))
+        reply("do: scroll down", "do: done")
+        go(host(withEyes = true), "scroll tiktok")
+        assertEquals(listOf(Describe.Source.SCREEN, Describe.Source.SCREEN), eyes.described.toList())
+        // The picture rides on her step as it is, and its bytes are zeroed after.
+        assertEquals(listOf("BASE64PICTURE"), mind.pictures.first())
+        assertTrue(mind.texts.first().contains("you are looking at it yourself"))
+        assertTrue(eyes.bytes.all { bytes -> bytes.all { it == 0.toByte() } })
+        assertEquals(2, entry().counts[PhoneOuting.SCREENS_SEEN])
+
+        time.frameNow = PhoneTime.Frame.Hidden
+        mind.texts.clear()
+        eyes.described.clear()
+        reply("do: done")
+        go(host(withEyes = true), "scroll tiktok")
+        assertTrue(mind.texts.first().contains("tiktok hides its screen from pictures (a protected screen)"))
+        // No picture went to her eyes for a black screen.
+        assertTrue(eyes.described.isEmpty())
+        assertEquals(1, entry().counts[PhoneOuting.HIDDEN_SCREENS])
+    }
+
+    @Test
+    fun `a screen with a kid on it is not watched, and its words are withheld`() {
+        time.frameNow = PhoneTime.Frame.Taken(ByteArray(64) { 7 })
+        eyes.seen.addLast(HerEyes.Seen.Described("A girl in a school uniform. KID_SENTINEL", KidGuard.Ages.Read(setOf(KidGuard.Age.TEEN))))
+        reply("do: watch 20", "do: done")
+        go(host(withEyes = true), "scroll tiktok")
+        val first = mind.texts.first()
+        assertTrue(first.contains("kid: the app marks this screen kid"))
+        assertFalse(first.contains("KID_SENTINEL"))
+        assertFalse(first.contains("SCREEN_SENTINEL"))
+        assertTrue(first.contains(com.opendroid.ai.core.life.OutingPrompt.KIDS_LINE))
+        assertTrue(mind.texts[1].contains("skipped: a kid"))
+        val e = entry()
+        assertNull(e.counts[PhoneOuting.WATCHED_SECONDS])
+        assertTrue((e.refusals[HerLog.KID_PREFIX + "TEEN"] ?: 0) >= 1)
+        assertTrue(mind.backs.single().metKid)
+    }
+
+    @Test
+    fun `an app that never comes to the front is no outing, nothing of the screen it opened over is read, and the screen is given back`() {
+        time.screen = forYou.copy(packageName = "com.opendroid.ai")
+        reply("do: scroll down")
+        go(host(), "scroll tiktok")
+        assertEquals(HerLog.EndedBy.ERROR, entry().endedBy)
+        assertTrue(mind.texts.isEmpty())
+        assertTrue(time.touches.isEmpty())
+        // It was launched, and may still come up: the screen is given back to what he had, whatever is in front now.
+        // (Changed on purpose: it used to be left alone as "nothing was opened", though the app had been launched.)
+        assertEquals(listOf<PhoneTime.Before>(PhoneTime.Before.Home), time.gaveBack)
+        assertEquals(listOf(true), time.gaveBackHers)
+        val record = recorded.single()
+        assertEquals(Outcome.FAILED, record.outcome)
+        assertEquals(com.opendroid.ai.core.record.StepEnd.DONE, record.steps.first { it.line == "opened TikTok on his screen" }.end)
+        assertEquals(com.opendroid.ai.core.record.StepEnd.FAILED, record.steps.single { it.line == "TikTok did not come to the front" }.end)
+        assertTrue(record.steps.any { it.line == "gave the screen back: home" })
+    }
+
+    @Test
+    fun `his touch while her app is still opening ends it, and the app she launched is not left on his screen`() {
+        // TikTok cold-starts: what is in front is still home, and he touches the phone 3 s in.
+        time.screen = forYou.copy(packageName = "com.sec.android.app.launcher")
+        time.onRead = { time.emit(LendWatch.Signal.Touch(now.get())) }
+        reply("do: scroll down")
+        go(host(), "scroll tiktok")
+        assertEquals(listOf(tiktokPackage), time.opened)
+        assertEquals(HerLog.EndedBy.TAKEOVER, entry().endedBy)
+        assertTrue(mind.texts.isEmpty())
+        // Launched, so given back, as hers: what is in front may still be her app coming up.
+        assertEquals(listOf<PhoneTime.Before>(PhoneTime.Before.Home), time.gaveBack)
+        assertEquals(listOf(true), time.gaveBackHers)
+        val record = recorded.single()
+        assertEquals(com.opendroid.ai.core.record.StepEnd.DONE, record.steps.first { it.line == "opened TikTok on his screen" }.end)
+        assertTrue(record.steps.any { it.line == "gave the screen back: home" })
+        assertTrue(record.why!!.contains("he took the phone back"))
+    }
+
+    @Test
+    fun `a link of hers out of the app ends it as hers, and his screen is put back all the same`() {
+        reply("do: scroll down", "do: scroll down", "do: done")
+        // In her second step the app in front is Chrome, right after her own scroll: where her move took her.
+        mind.duringStep = { n -> if (n == 2) time.screen = forYou.copy(packageName = "com.android.chrome") }
+        go(host(), "scroll tiktok")
+        assertEquals(HerLog.EndedBy.DONE, entry().endedBy)
+        assertEquals(listOf(true), time.gaveBackHers)
+        // His own touch is his doing: then what is in front is not hers to take away.
+        synchronized(mind.replies) { mind.replies.clear() }
+        reply("do: scroll down", "do: scroll down", "do: done")
+        time.screen = forYou
+        mind.duringStep = { n -> if (n == 2) time.emit(LendWatch.Signal.Touch(now.get() + 30_000)) }
+        mind.texts.clear()
+        go(host(), "scroll tiktok")
+        assertEquals(HerLog.EndedBy.TAKEOVER, entry().endedBy)
+        assertEquals(listOf(true, false), time.gaveBackHers)
+    }
+
+    @Test
+    fun `what she started playing is paused before his sound is put back`() {
+        reply("do: watch 10", "do: done")
+        mind.duringStep = { n -> if (n == 1) time.musicPlaying = true }
+        go(host(), "scroll tiktok")
+        assertEquals(listOf("watch", "open", "give back", "pause", "sound back"), time.order.toList())
+        assertFalse(time.musicPlaying)
+        // With nothing playing, nothing is paused.
+        time.order.clear()
+        reply("do: done")
+        go(host(), "scroll tiktok")
+        assertEquals(listOf("watch", "open", "give back", "sound back"), time.order.toList())
+    }
+
+    @Test
+    fun `after his yes in the shade, the shade is closed before the watch starts and her app opens`() {
+        val host = host()
+        mind.config = mind.config.copy(personaOutingsAsk = true)
+        reply("do: done")
+        assertEquals(OutingHost.Began.Asked, runBlocking { host.go("scroll tiktok", OutingKind.parse("scroll tiktok")) })
+        assertEquals(OutingHost.Began.Started, runBlocking { host.letHer().also { withTimeout(10_000) { host.awaitEnd() } } })
+        assertEquals(listOf("shade", "watch", "open"), time.order.take(3))
+        // Without the question, the shade is not touched.
+        time.order.clear()
+        mind.config = mind.config.copy(personaOutingsAsk = false)
+        reply("do: done")
+        go(host, "scroll tiktok")
+        assertFalse(time.order.contains("shade"))
+    }
+
+    @Test
+    fun `his messages on the screen end it before she sees anything of them`() {
+        time.screen = Screen(tiktokPackage, 1080, 2520, listOf(ScreenNode(hint = "Message...", bounds = Box(0, 2300, 1080, 2400), editable = true)))
+        reply("do: scroll down")
+        go(host(withEyes = true), "scroll tiktok")
+        assertEquals(HerLog.EndedBy.NEEDS_HIM, entry().endedBy)
+        assertTrue(mind.texts.isEmpty())
+        assertTrue(eyes.described.isEmpty())
+        assertEquals(listOf<PhoneTime.Before>(PhoneTime.Before.Home), time.gaveBack)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWallTest.kt b/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWallTest.kt
new file mode 100644
index 0000000..2bb1cab
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWallTest.kt
@@ -0,0 +1,135 @@
+package com.opendroid.ai.core.life.phone
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * How her time on his screen is wired, read off the source like the other walls: it reaches no
+ * plan, no action and no route of his; every tap of hers is put to the look-only guard first and
+ * every text goes into a search box only, after the outgoing guard; her human motion moves only
+ * her outing's hands, never the planner's; her one line to him is the only way out; and what is
+ * kept of it is counts, labels she opened and her search words.
+ */
+class PhoneTimeWallTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private fun source(path: String) = File(main, path).readText()
+
+    /** Code without its comments, so that a word in a comment is not taken for a reach. */
+    private fun code(text: String) = text.replace(Regex("""/\*[\s\S]*?\*/"""), "").replace(Regex("""(?m)//.*$"""), "")
+
+    private val pure = listOf("LookOnly", "HumanMotion", "LendWatch", "PhoneVerb", "PhonePrompt", "ScreenSeen", "PhoneSpace", "HisApps", "PhoneTime")
+
+    @Test
+    fun `her time on his screen reaches no plan, no action, no route of his, and its decisions are pure`() {
+        for (name in pure + "PhoneOuting") {
+            val body = code(source("core/life/phone/$name.kt"))
+            for (reach in listOf(
+                "AgentLoop", "ActionDispatcher", "PlanManager", "processQuery", "ReEvaluationEngine", "executePlan", "storeMessage",
+                "logTaskExecution", "MemoryManager", "getActiveProvider", "llmProviderFactory", "LLMProvider", "CameraManager",
+                "AudioRecord", "NotificationListener", "conversationRepository", "PersonaActions", "Accessibility", "takeScreenshot"
+            )) {
+                assertFalse("$name reaches $reach", body.contains(reach))
+            }
+        }
+        // What decides is plain Kotlin: no Android type, so the tests run every case.
+        for (name in pure) assertFalse(name, code(source("core/life/phone/$name.kt")).contains("import android."))
+        // The host holds the door, not the phone.
+        val host = code(source("core/life/OutingHost.kt"))
+        assertFalse(host.contains("HisScreen()"))
+        assertTrue(host.contains("hisScreen: com.opendroid.ai.core.life.phone.HisScreen,"))
+        assertTrue(host.contains("if (parsed is OutingKind.Parsed.Phone) return onHisScreen(outing, parsed)"))
+    }
+
+    @Test
+    fun `every tap is put to the look-only guard first, and text goes only into a search box after the outgoing guard`() {
+        val space = code(source("core/life/phone/PhoneSpace.kt"))
+        // The hands are touched in one place only, after her press is marked on the watch.
+        assertEquals(1, Regex("""hands\.touch\(""").findAll(space).count())
+        val press = space.substringAfter("private suspend fun press(").substringBefore("private fun area(")
+        assertTrue(press.indexOf("watch.herPress(at)") in 0 until press.indexOf("return hands.touch(touch)"))
+        // Every tap goes through one door (changed on purpose: each verb used to play its own tap plan). There the screen is
+        // read again after the beat, the node put to the guard again, the press drawn off every other control inside it,
+        // and the point checked to land on it, all before the finger goes down.
+        val verbs = space.split("private suspend fun ").drop(1)
+        val door = verbs.single { it.startsWith("tapOn(") }
+        val steps = listOf(
+            "motion.lead(energy)", "hands.screen()", "LookOnly.tap(node, fresh, app, asTab)", "LookOnly.keepOff(node, fresh, app)",
+            "motion.press(area, node.bounds, energy, keepOff)", "LookOnly.under(", "if (!press(touch)) return Tapped.Cut"
+        ).map { door.indexOf(it) }
+        assertTrue("$steps", steps.all { it >= 0 } && steps == steps.sorted())
+        assertFalse(space.contains("motion.tap("))
+        // Each verb that taps asks the guard before it goes to the door.
+        for (verb in verbs.filter { it.contains("tapOn(") && !it.startsWith("tapOn(") }) {
+            val name = verb.substringBefore('(')
+            val guard = listOf(verb.indexOf("LookOnly.tap("), verb.indexOf("LookOnly.typing(")).filter { it >= 0 }.minOrNull() ?: -1
+            assertTrue("$name taps without the guard", guard >= 0 && guard < verb.indexOf("tapOn("))
+        }
+        // A search: the outgoing guard on her words, then the box checked to be a search box, then the words.
+        val search = verbs.single { it.startsWith("search(") }
+        val guard = search.indexOf("OutgoingGuard.check(words, his)")
+        val typing = search.indexOf("LookOnly.typing(field)")
+        val typed = search.indexOf("hands.search(field, words)")
+        assertTrue(guard in 0 until typing && typing < typed)
+        assertEquals(1, Regex("""hands\.search\(""").findAll(space).count())
+        // The guard reads every app's labels and the major apps' view ids.
+        val guardSource = code(source("core/life/phone/LookOnly.kt"))
+        // Each of a node's words on its own, and its view id before any tab is let through (changed on purpose: one label was read).
+        val tap = guardSource.substringAfter("fun tap(node: ScreenNode").substringBefore("fun wordsOf(")
+        assertTrue(tap.contains("val words = wordsOf(node)"))
+        assertTrue(tap.contains("actOfLabel(word, big = big)?.let { return Verdict.Refused(it) }"))
+        assertTrue(tap.indexOf("actOfId(node.idName, app)?.let { return Verdict.Refused(it) }") in 0 until tap.indexOf("val feed = asTab && isTab(node, screen)"))
+        assertTrue(guardSource.contains("listOf(node.text, node.desc, node.hint)"))
+        // A picture of his screen is of her app's window alone, never of the whole display.
+        val hands = code(source("accessibility/LentScreenHands.kt"))
+        assertFalse(hands.contains("takeScreenshot("))
+        assertTrue(hands.contains("takeScreenshotOfWindow(window, service.mainExecutor, callback)"))
+        assertTrue(hands.contains("FrameRoute.of(Build.VERSION.SDK_INT, windowId, systemOver)"))
+    }
+
+    @Test
+    fun `her human motion moves only her outing's hands, never the planner's or his commands`() {
+        val users = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { code(it.readText()).contains("HumanMotion") }
+            .map { it.relativeTo(main).path }
+            .toSet()
+        assertEquals(
+            setOf(
+                "core/life/phone/HumanMotion.kt", "core/life/phone/PhoneSpace.kt", "core/life/phone/PhoneOuting.kt",
+                "core/life/phone/HisScreen.kt", "core/life/phone/PhonePrompt.kt", "accessibility/LentScreenHands.kt"
+            ),
+            users
+        )
+        // The planner's own tap stays the plain tap it was.
+        val service = code(source("accessibility/OpenDroidAccessibilityService.kt"))
+        val click = service.substringAfter("fun clickCoordinates(").substringBefore("// --- Screen Text Extraction ---")
+        assertTrue(click.contains("GestureDescription.StrokeDescription(path, 0, 100)"))
+        // While his screen is lent, no habit of his is learned from what opens.
+        assertTrue(service.contains("if (!pkg.isNullOrBlank() && pkg != packageName && !hisScreen.lent) {"))
+    }
+
+    @Test
+    fun `her one line to him is the only way out, and what is kept is counts, labels and her search words`() {
+        val outing = code(source("core/life/phone/PhoneOuting.kt"))
+        assertEquals(1, Regex("""mind\.said\(""").findAll(outing).count())
+        assertTrue(outing.contains("if (step.said.isNotEmpty() && !sayUsed) {"))
+        // The log is written through its tally only.
+        for (call in Regex("""\blog\.(\w+)\(""").findAll(outing).map { it.groupValues[1] }) {
+            assertTrue(call, call in setOf("start", "update", "end", "phoneMinutes"))
+        }
+        // The record is built from counts, her search words and how it ended: never the screen, her thoughts or what she opened.
+        val record = outing.substringAfter("OutingEntries.PhoneTime(").substringBefore("back(came(")
+        for (never in listOf("labels", "screen", "thought", "seen", "reading", "step.")) assertFalse(never, record.contains(never))
+        // Each step is her own call, counted as one, with her library offered the app she is in.
+        val engine = code(source("core/persona/PersonaEngine.kt"))
+        assertTrue(engine.contains("): OutingStep.Step? = withContext(ownLife.counted(OwnPurpose.OUTING_STEP)) {\n        stepOfHers(outing, sayUsed, nowMillis, kid, look = false, pictures = pictures, cues = phoneCues(app))"))
+        val prompt = code(source("core/life/phone/PhonePrompt.kt"))
+        assertTrue(prompt.contains("append(\"you are in \$name: his \$name app, on his screen, which he lent you, logged in as him. \")"))
+        // A frame of his screen is in memory only, and its bytes are zeroed once looked at (I6).
+        assertTrue(outing.contains("frame.bytes.fill(0)"))
+        assertFalse(outing.contains("FileOutputStream") || outing.contains("writeBytes"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWordsTest.kt b/app/src/test/java/com/opendroid/ai/core/life/phone/PhoneTimeWordsTest.kt
new file mode 100644
