+            stored.personaOwnLife && stored.personaOwnCallsPerDay == 250 && stored.personaOutingMaxMinutes == 30 &&
+                stored.personaOutingMaxSteps == 4 && stored.personaOutingsAsk && !stored.personaReads &&
+                stored.personaReadFeedsRemoved == listOf(Feeds.YAHOO_ENTERTAINMENT.id) &&
+                stored.personaReadYouTube == mapOf(CHANNEL to "Gyaru TV")
+        }
+        // The host's own reading of them.
+        val stored = stored()
+        assertEquals(250, OwnLife.capOf(stored))
+        assertEquals(30, OwnLife.maxMinutes(stored))
