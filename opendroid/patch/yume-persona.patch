+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Color
+import android.net.Uri
+import android.util.Base64
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.persona.PersonaPicture.CaptionBy
+import com.opendroid.ai.core.persona.PersonaPicture.Kind
+import com.opendroid.ai.data.db.MigrationTestApplication
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import java.io.File
+
+/**
+ * Her pictures as they are kept on the phone: copied in scaled down as JPEG, at most
+ * twelve of her and one background picture, each with a caption, in the app's own
+ * files directory. A damaged index or a missing file costs that entry and nothing else.
+ *
+ * Runs with real bitmaps, so that what is asserted is what a phone would store.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class PersonaPicturesTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory = File(File(context.filesDir, "persona"), "pictures")
+    private val indexFile = File(directory, "index.json")
+    private val sources = File(context.cacheDir, "picked").apply { mkdirs() }
+    private var store = PersonaPictures(context)
+
+    @After
+    fun tearDown() {
+        File(context.filesDir, "persona").deleteRecursively()
+        sources.deleteRecursively()
+    }
+
+    /** A picture as the photo picker would hand it over: a file somewhere else, behind a Uri. */
+    private fun picked(
+        width: Int,
+        height: Int,
+        format: Bitmap.CompressFormat = Bitmap.CompressFormat.JPEG,
+        color: Int = Color.rgb(200, 30, 40),
+        name: String = "picked-${sources.listFiles().orEmpty().size}"
+    ): Uri {
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        bitmap.eraseColor(color)
+        val file = File(sources, name)
+        file.outputStream().use { bitmap.compress(format, 92, it) }
+        bitmap.recycle()
+        return Uri.fromFile(file)
+    }
+
+    private fun add(uri: Uri, kind: Kind = Kind.SELF): PersonaPicture = runBlocking {
+        val added = store.add(uri, kind)
+        assertTrue("expected a stored picture, got $added", added is PersonaPictures.Added.Stored)
+        (added as PersonaPictures.Added.Stored).picture
+    }
+
+    private fun list() = runBlocking { store.list() }
+
+    private fun storedFile(picture: PersonaPicture) = File(directory, picture.file)
+
+    private fun sizeOf(file: File): Pair<Int, Int> {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.path, bounds)
+        return bounds.outWidth to bounds.outHeight
+    }
+
+    private fun pictureFiles() = directory.listFiles().orEmpty().map { it.name }.filter { it != "index.json" }.sorted()
+
+    // ── Import ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a picture is copied in scaled down to 1024 on its longer side, as JPEG, and the original is left alone`() {
+        val uri = picked(2048, 1536)
+        val original = File(uri.path!!)
+        val originalBytes = original.readBytes()
+
+        val picture = add(uri)
+
+        val file = storedFile(picture)
+        assertTrue(file.isFile)
+        assertEquals(1024 to 768, sizeOf(file))
+        // JPEG, whatever the picture was before.
+        val head = file.readBytes().take(3).map { it.toInt() and 0xFF }
+        assertEquals(listOf(0xFF, 0xD8, 0xFF), head)
+        assertTrue(picture.file.endsWith(".jpg"))
+        assertTrue(file.length() < originalBytes.size)
+
+        // The original is not moved, changed or copied as it was.
+        assertArrayEquals(originalBytes, original.readBytes())
+        assertEquals(listOf(picture.file), pictureFiles())
+        // In the app's own files directory, which no other app can read and no backup includes.
+        assertTrue(file.canonicalPath.startsWith(context.filesDir.canonicalPath))
+    }
+
+    @Test
+    fun `a tall picture keeps its shape and a small one keeps its size`() {
+        assertEquals(512 to 1024, sizeOf(storedFile(add(picked(900, 1800)))))
+        assertEquals(300 to 200, sizeOf(storedFile(add(picked(300, 200)))))
+        assertEquals(1024 to 1024, sizeOf(storedFile(add(picked(1024, 1024)))))
+    }
+
+    @Test
+    fun `a transparent picture is stored on white, not on black`() {
+        val picture = add(picked(64, 64, format = Bitmap.CompressFormat.PNG, color = Color.TRANSPARENT))
+
+        val stored = BitmapFactory.decodeFile(storedFile(picture).path)
+        val pixel = stored.getPixel(32, 32)
+        assertTrue("red ${Color.red(pixel)}", Color.red(pixel) > 240)
+        assertTrue("green ${Color.green(pixel)}", Color.green(pixel) > 240)
+        assertTrue("blue ${Color.blue(pixel)}", Color.blue(pixel) > 240)
+    }
+
+    @Test
+    fun `the older decoder stores the same picture`() {
+        // Phones on Android 8 take this path; it has to shrink a large picture the same way.
+        val decoded = store.decodeAsStored(File(picked(2048, 1536).path!!).readBytes())
+        assertNotNull(decoded)
+        assertEquals(1024 to 768, decoded!!.width to decoded.height)
+        assertNull(store.decodeAsStored(File(notAPicture().path!!).readBytes()))
+        assertNull(store.decodeAsStored(ByteArray(0)))
+    }
+
+    @Test
+    fun `a photo taken with the phone held sideways is stored upright`() {
+        // 200 wide and 100 high as stored, with the camera's note that it has to be turned a quarter.
+        val uri = picked(200, 100)
+        android.media.ExifInterface(uri.path!!).apply {
+            setAttribute(android.media.ExifInterface.TAG_ORIENTATION, android.media.ExifInterface.ORIENTATION_ROTATE_90.toString())
+            saveAttributes()
+        }
+
+        assertEquals(100 to 200, sizeOf(storedFile(add(uri))))
+    }
+
+    private fun notAPicture(): Uri {
+        val file = File(sources, "notes.txt")
+        file.writeText("he keeps bees. this is not an image.")
+        return Uri.fromFile(file)
+    }
+
+    @Test
+    fun `a file that is not a picture is refused and leaves nothing behind`() {
+        val added = runBlocking { store.add(notAPicture(), Kind.SELF) }
+        assertEquals(PersonaPictures.Added.Unreadable, added)
+
+        val gone = runBlocking { store.add(Uri.fromFile(File(sources, "never-there.jpg")), Kind.BACKGROUND) }
+        assertEquals(PersonaPictures.Added.Unreadable, gone)
+
+        assertEquals(emptyList<PersonaPicture>(), list())
+        assertEquals(emptyList<String>(), pictureFiles())
+    }
+
+    // ── Limits ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `she has at most twelve pictures of herself`() {
+        val uri = picked(40, 30)
+        repeat(PersonaPictureRules.MAX_SELF) { add(uri) }
+
+        val thirteenth = runBlocking { store.add(uri, Kind.SELF) }
+
+        assertEquals(PersonaPictures.Added.Full, thirteenth)
+        assertEquals(12, list().size)
+        assertEquals(12, pictureFiles().size)
+        // The background picture still fits beside them.
+        add(uri, Kind.BACKGROUND)
+        assertEquals(13, list().size)
+    }
+
+    @Test
+    fun `there is exactly one background picture, and adding another replaces and deletes the first`() {
+        val self = add(picked(40, 30))
+        val first = add(picked(60, 40), Kind.BACKGROUND)
+        val second = add(picked(50, 80), Kind.BACKGROUND)
+
+        val pictures = list()
+        assertEquals(listOf(self.id, second.id), pictures.map { it.id })
+        assertEquals(1, pictures.count { it.kind == Kind.BACKGROUND })
+        assertFalse(storedFile(first).exists())
+        assertTrue(storedFile(second).isFile)
+        assertEquals(50 to 80, sizeOf(storedFile(second)))
+        assertEquals(listOf(self.file, second.file).sorted(), pictureFiles())
+    }
+
+    // ── Remove, caption, read ────────────────────────────────────────────────────────
+
+    @Test
+    fun `a removed picture is gone from the list and from the phone`() {
+        val kept = add(picked(40, 30))
+        val removed = add(picked(40, 30))
+
+        runBlocking { store.remove(removed.id) }
+
+        assertEquals(listOf(kept.id), list().map { it.id })
+        assertFalse(storedFile(removed).exists())
+        assertEquals(listOf(kept.file), pictureFiles())
+        // Removing what is not there changes nothing.
+        runBlocking { store.remove("not-there") }
+        assertEquals(listOf(kept.id), list().map { it.id })
+    }
+
+    @Test
+    fun `a caption is kept with who wrote it, across a restart`() {
+        val picture = add(picked(40, 30))
+        assertEquals("", picture.caption)
+
+        runBlocking { store.setCaption(picture.id, "  red hair down,\n gold hoops ", CaptionBy.HER) }
+        assertEquals("red hair down,\ngold hoops", list().single().caption)
+        assertEquals(CaptionBy.HER, list().single().captionBy)
+
+        store = PersonaPictures(context)
+        val afterRestart = list().single()
+        assertEquals("red hair down,\ngold hoops", afterRestart.caption)
+        assertEquals(CaptionBy.HER, afterRestart.captionBy)
+        assertEquals(picture.id, afterRestart.id)
+        assertEquals(picture.addedAt, afterRestart.addedAt)
+
+        runBlocking { store.setCaption(picture.id, "typed over it", CaptionBy.OWNER) }
+        assertEquals("typed over it", list().single().caption)
+        assertEquals(CaptionBy.OWNER, list().single().captionBy)
+    }
+
+    @Test
+    fun `a picture goes into a request as the stored JPEG in base64, without line breaks`() {
+        val picture = add(picked(2048, 1536))
+
+        val encoded = runBlocking { store.base64(picture.id) }!!
+
+        assertFalse(encoded.contains('\n'))
+        // The first bytes of a JPEG in base64.
+        assertTrue(encoded.startsWith("/9j/"))
+        assertArrayEquals(storedFile(picture).readBytes(), Base64.decode(encoded, Base64.NO_WRAP))
+        assertNull(runBlocking { store.base64("not-there") })
+    }
+
+    @Test
+    fun `the screen gets a bitmap and a smaller one for the list`() {
+        val picture = add(picked(2048, 1536))
+
+        val full = runBlocking { store.bitmap(picture.id) }!!
+        assertEquals(1024 to 768, full.width to full.height)
+        val small = runBlocking { store.thumbnail(picture.id) }!!
+        assertEquals(512 to 384, small.width to small.height)
+        assertNull(runBlocking { store.bitmap("not-there") })
+        assertNull(runBlocking { store.thumbnail("not-there") })
+    }
+
+    @Test
+    fun `the list the screen follows changes with every change`() {
+        assertEquals(emptyList<PersonaPicture>(), store.pictures.value)
+        val picture = add(picked(40, 30))
+        assertEquals(listOf(picture.id), store.pictures.value.map { it.id })
+        runBlocking { store.setCaption(picture.id, "nails", CaptionBy.OWNER) }
+        assertEquals("nails", store.pictures.value.single().caption)
+        runBlocking { store.remove(picture.id) }
+        assertEquals(emptyList<PersonaPicture>(), store.pictures.value)
+
+        // A second holder of the store reads what is on the phone when it first asks.
+        add(picked(40, 30))
+        val another = PersonaPictures(context)
+        assertEquals(emptyList<PersonaPicture>(), another.pictures.value)
+        runBlocking { another.list() }
+        assertEquals(1, another.pictures.value.size)
+    }
+
+    // ── Damage ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a broken index gives an empty list and does not crash, and the pictures it named are not deleted`() {
+        val lost = add(picked(40, 30))
+        indexFile.writeText("{\"pictures\": [ {\"id\": ")
+
+        store = PersonaPictures(context)
+        assertEquals(emptyList<PersonaPicture>(), list())
+        assertNull(runBlocking { store.base64(lost.id) })
+        assertEquals(0, runBlocking { store.turn() })
+        // The file is still on the phone, and the store says that one lies there unlisted.
+        assertTrue(storedFile(lost).isFile)
+        assertEquals(1, store.unlisted.value)
+
+        // The next picture is stored as usual, and what nobody asked to remove stays.
+        val next = add(picked(40, 30))
+        assertEquals(listOf(next.id), list().map { it.id })
+        assertEquals(listOf(next.id), PersonaPictureRules.parseIndex(indexFile.readText()).pictures.map { it.id })
+        assertEquals(listOf(lost.file, next.file).sorted(), pictureFiles())
+
+        // Neither a caption, nor a turn counted by a reply of hers, nor another picture
+        // coming and going deletes it.
+        val passing = add(picked(40, 30))
+        runBlocking {
+            store.setCaption(next.id, "nails", CaptionBy.OWNER)
+            store.turnTaken()
+            store.remove(passing.id)
+        }
+        add(picked(60, 40), Kind.BACKGROUND)
+        add(picked(50, 80), Kind.BACKGROUND)
+        assertTrue(storedFile(lost).isFile)
+        assertFalse(storedFile(passing).exists())
+        assertEquals(1, store.unlisted.value)
+    }
+
+    @Test
+    fun `an entry that cannot be read costs the entry in the list, not the picture file`() {
+        val kept = add(picked(40, 30))
+        val skipped = add(picked(40, 30))
+        // As a later build might have written it: a kind this one does not know.
+        val written = indexFile.readText()
+        val unknownKind = written.replace(
+            "\"id\":\"${skipped.id}\",\"file\":\"${skipped.file}\",\"kind\":\"SELF\"",
+            "\"id\":\"${skipped.id}\",\"file\":\"${skipped.file}\",\"kind\":\"PORTRAIT\""
+        )
+        assertFalse(written == unknownKind)
+        indexFile.writeText(unknownKind)
+
+        store = PersonaPictures(context)
+        assertEquals(listOf(kept.id), list().map { it.id })
+        // Her next first reply counts a turn, which writes the index. No action of his.
+        runBlocking { store.turnTaken() }
+
+        assertTrue(storedFile(skipped).isFile)
+        assertTrue(storedFile(kept).isFile)
+        assertEquals(1, store.unlisted.value)
+        // It is not shown to her and cannot be asked for: the list does not know it.
+        assertNull(runBlocking { store.base64(skipped.id) })
+    }
+
+    @Test
+    fun `files the list does not name are deleted when he says so, and only those`() {
+        val listed = add(picked(40, 30))
+        val page = add(picked(60, 40), Kind.BACKGROUND)
+        assertEquals(0, store.unlisted.value)
+        // Two picture files with no entry, and a file that is not a picture of this store's at all.
+        File(directory, "0b1c2d3e-aaaa-bbbb-cccc-0123456789ab.jpg").writeBytes(byteArrayOf(1))
+        File(directory, "left-behind.jpg").writeBytes(byteArrayOf(2))
+        File(directory, "notes.txt").writeText("he keeps bees")
+
+        store = PersonaPictures(context)
+        assertEquals(2, list().size)
+        assertEquals(2, store.unlisted.value)
+
+        runBlocking { store.removeUnlisted() }
+
+        assertEquals(0, store.unlisted.value)
+        assertEquals(listOf(listed.file, page.file, "notes.txt").sorted(), pictureFiles())
+        assertEquals(listOf(listed.id, page.id), list().map { it.id })
+        assertTrue(indexFile.isFile)
+        // With nothing unlisted it does nothing.
+        runBlocking { store.removeUnlisted() }
+        assertEquals(2, list().size)
+    }
+
+    @Test
+    fun `her words saved again with white space he added stay hers`() {
+        val picture = add(picked(40, 30))
+        runBlocking { store.setCaption(picture.id, "red hair down,\ngold hoops", CaptionBy.HER) }
+        val written = indexFile.readText()
+
+        runBlocking { store.setCaption(picture.id, " red hair down,\n\ngold hoops \n", CaptionBy.OWNER) }
+
+        assertEquals("red hair down,\ngold hoops", list().single().caption)
+        assertEquals(CaptionBy.HER, list().single().captionBy)
+        assertEquals(written, indexFile.readText())
+        // After a restart as well.
+        store = PersonaPictures(context)
+        assertEquals(CaptionBy.HER, list().single().captionBy)
+    }
+
+    @Test
+    fun `an entry whose file is missing is skipped, and the others are kept`() {
+        val kept = add(picked(40, 30))
+        val missing = add(picked(40, 30))
+        runBlocking { store.setCaption(kept.id, "still here", CaptionBy.OWNER) }
+
+        // Behind the store's back, while it is running: reading it gives nothing instead of failing.
+        assertTrue(storedFile(missing).delete())
+        assertNull(runBlocking { store.base64(missing.id) })
+        assertNull(runBlocking { store.bitmap(missing.id) })
+
+        // After a restart the entry is not listed at all.
+        store = PersonaPictures(context)
+        assertEquals(listOf(kept.id), list().map { it.id })
+        assertEquals("still here", list().single().caption)
+    }
+
+    @Test
+    fun `an index entry that points out of the picture folder is not followed`() {
+        val card = File(File(context.filesDir, "persona"), "card.md")
+        card.parentFile!!.mkdirs()
+        card.writeText("You are Yume.")
+        directory.mkdirs()
+        indexFile.writeText("""{"pictures": [{"id": "x", "file": "../card.md", "kind": "SELF"}]}""")
+
+        store = PersonaPictures(context)
+
+        assertEquals(emptyList<PersonaPicture>(), list())
