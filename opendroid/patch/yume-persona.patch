+        assertEquals(Acoustics.semitones(125f), u.pitchSemitones!!, 0.3f)
+        assertNotNull(u.wordsPerMinute("<|en|>"))
+        assertEquals(u.wordsPerMinute("en"), u.wordsPerMinute("<|en|>"))
+        assertNull(u.wordsPerMinute("ja"))
+        // A stretch 20 dB louder moves it by the step, of at most 8 dB.
+        u.learn(at(-8f, 125.0), 12, "en", null)
+        assertEquals(-28f + SoundUsual.STEP * SoundUsual.MAX_LEVEL_STEP_DB, u.levelDb, 0.01f)
+        // A shout, a whisper or a laugh teach nothing.
+        val before = u.levelDb to u.learned
+        val m = at(-8f, 125.0)
+        for (how in listOf(
+            HowItSounded(null, emptyList(), Manner.SHOUT, m, null, null, null, null, null, null, null),
+            HowItSounded(null, emptyList(), Manner.WHISPER, m, null, null, null, null, null, null, null),
+            HowItSounded(null, listOf(SoundEvent.LAUGHTER), Manner.ORDINARY, m, null, null, null, null, null, null, null),
+        )) u.learn(m, 12, "en", how)
+        assertEquals(before, u.levelDb to u.learned)
+        // Too short to tell teaches nothing either.
+        u.learn(Acoustics.measure(voiced(600, 125.0))!!, 2, "en", null)
+        assertEquals(before.second, u.learned)
+        // A copy learns on its own.
+        val c = u.copy()
+        c.learn(at(-20f, 125.0), 12, "en", null)
+        assertEquals(before.second, u.learned)
