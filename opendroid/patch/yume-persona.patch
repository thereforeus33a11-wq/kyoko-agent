+    fun `the background picture is read by a request without her card, and nothing is saved by it`() {
+        store.saveUnderText(under)
+        server.enqueue(reply("She is nineteen. She left the harbour town at night."))
+
+        val reading = runBlocking { engine.readBackgroundPicture("dGhlLXBhZ2Uh") }
+
+        assertEquals(PictureReading.Read("She is nineteen. She left the harbour town at night."), reading)
+        val body = sentBody()
+        assertTrue(body.contains("Write down what this page says and shows"))
+        assertTrue(body.contains("data:image/jpeg;base64,dGhlLXBhZ2Uh"))
+        // Not her: no card, no name of hers, and nothing that already lies under her awareness.
+        assertFalse(body.contains("You are Yume"))
+        assertFalse(body.contains("Yume"))
+        assertFalse(body.contains(underMark))
+        // What came back is for the owner to check. His saved text is what it was.
+        assertEquals(under, store.savedUnderText()!!.trim())
+    }
+
+    @Test
+    fun `the background picture is not sent where no picture can arrive`() {
+        configure { encrypted(it) }
+        assertEquals(
