+/**
+ * What her quick-settings tile shows: her name, and what she is doing on her own now. It
+ * is active while she is out on an outing, so a tap that stops it has something to stop.
+ */
+internal data class YumeTile(val label: String, val subtitle: String, val active: Boolean, val description: String) {
+    companion object {
+        const val LABEL = "Yume"
+
+        fun of(now: HerNow.Now, atMillis: Long): YumeTile = when (now) {
+            HerNow.Now.Nothing -> YumeTile(LABEL, "nothing now", active = false, description = "$LABEL is doing nothing on her own now.")
+            is HerNow.Now.Doing -> {
+                val minutes = ((atMillis - now.sinceMillis).coerceAtLeast(0) / 60_000L)
+                val subtitle = now.kind.word + (if (now.paused) ", waiting" else "") + " · $minutes min"
+                YumeTile(LABEL, subtitle, active = true, description = "$LABEL is $subtitle. Tap to stop her outing.")
+            }
+        }
+    }
+}
+
+/**
+ * Her "Yume" tile in quick settings. A tap stops the outing she is on, as Stop on the
+ * notification does; with none running it does nothing. A long-press opens the app on
+ * Settings (MainActivity takes the system's tile-preferences intent).
+ */
+@AndroidEntryPoint
+class YumeTileService : TileService() {
+
+    @Inject lateinit var outings: OutingHost
+
+    @Inject lateinit var herNow: HerNow
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+    private var watching: Job? = null
+
+    override fun onStartListening() {
+        super.onStartListening()
+        watching?.cancel()
+        watching = scope.launch { herNow.now.collect { show(it) } }
+    }
+
+    override fun onStopListening() {
+        watching?.cancel()
+        watching = null
+        super.onStopListening()
+    }
+
+    override fun onClick() {
+        super.onClick()
+        // He pressed stop: her outing ends, the same as Stop on the notification.
+        outings.stop(HerLog.EndedBy.STOP)
+        show(herNow.now.value)
+    }
+
+    override fun onDestroy() {
+        scope.cancel()
+        super.onDestroy()
+    }
+
+    private fun show(now: HerNow.Now) {
+        val tile = qsTile ?: return
+        val shown = YumeTile.of(now, System.currentTimeMillis())
+        tile.label = shown.label
+        tile.contentDescription = shown.description
+        tile.state = if (shown.active) Tile.STATE_ACTIVE else Tile.STATE_INACTIVE
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) tile.subtitle = shown.subtitle
+        tile.updateTile()
+    }
+}
