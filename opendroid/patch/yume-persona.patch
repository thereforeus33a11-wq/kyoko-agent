+
+    @Test
+    fun `only the message she is answering is read for what he is talking about`() {
+        stored(self("a", "black coat"))
+        val before = listOf(he("morning"), she("mm"), he("take a photo of the receipt"), app("Photo saved to the gallery"))
+
+        // His command to the phone said "photo". His message to her does not.
