+
+    // ── A payment address ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a payment address from a notification is an echo`() {
+        val bill = "• Messages — ELEC-BOARD: bill due. pay to elec.board@okaxis by friday (Nov 16, 3:45 PM)"
+        assertTrue(PersonaActions.echoesOutsideText("pay 500 to elec.board@okaxis", bill))
