+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import com.opendroid.ai.data.repository.SessionMessage
+import java.util.TimeZone
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What her notebook pass reads of the chats: everything that is unread, by time, in pages
+ * of a fixed room, so that nothing he told her is passed over. And what it does not
+ * read: her own line about a result, which is the phone's facts in her words.
+ */
+class PersonaNotebookTalkTest {
+
+    private var nextId = 0
+    private fun his(text: String, at: Long, chat: String = "chat-1", badge: String? = PersonaPrompts.OWNER_TALK_BADGE) =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.USER, timestamp = at, modelBadge = badge))
+    private fun hers(text: String, at: Long, chat: String = "chat-1", badge: String = PersonaPrompts.BADGE) =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, timestamp = at, modelBadge = badge))
+    private fun app(text: String, at: Long, chat: String = "chat-1", badge: String = "System") =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, timestamp = at, modelBadge = badge))
+
+    private val utc = TimeZone.getTimeZone("UTC")
+    private val day = 24 * 60 * 60_000L
+
+    // ── When a pass is due ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `replies are counted chat by chat, and a pass is due at three of them wherever they were said`() {
+        val rows = listOf(
+            his("the second hive is up", 1_000, "chat-1"), hers("finally", 1_010, "chat-1"),
+            his("flashlight on", 1_500, "chat-1", PersonaPrompts.OWNER_COMMAND_BADGE), app("Flashlight on.", 1_510, "chat-1"),
+            hers("light's on", 1_520, "chat-1", PersonaPrompts.RESULT_BADGE),
+            his("melon soda is too sweet", 2_000, "chat-2"), hers("it is mine", 2_010, "chat-2")
+        )
+        assertEquals(2, PersonaNotebookTalk.replies(rows))
+        assertFalse(PersonaNotebookTalk.isDue(rows))
+
+        val third = rows + listOf(his("fine", 3_000, "chat-3"), hers("mm", 3_010, "chat-3"))
+        assertEquals(3, PersonaNotebookTalk.replies(third))
+        assertTrue(PersonaNotebookTalk.isDue(third))
+        // A row of hers that opens a chat answers nothing in it, whatever was said last in another chat.
+        assertEquals(0, PersonaNotebookTalk.replies(listOf(his("hi", 1_000, "chat-1"), hers("the boots are still in the window", 2_000, "chat-2"))))
+        assertFalse(PersonaNotebookTalk.isDue(emptyList()))
+    }
+
+    @Test
+    fun `so many unread rows that one look is full make a pass due whatever the count of replies`() {
+        val commands = (1..PersonaNotebookTalk.ROWS_PER_LOOK).map { app("Flashlight on.", it.toLong()) }
+        assertEquals(0, PersonaNotebookTalk.replies(commands))
+        assertTrue(PersonaNotebookTalk.isDue(commands))
+        assertFalse(PersonaNotebookTalk.isDue(commands.dropLast(1)))
+    }
+
+    // ── A page ───────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a page takes rows oldest first until the talk fills its room, and says up to when it read`() {
+        val rows = listOf(
+            his("a".repeat(40), 1_000), hers("b".repeat(40), 1_010),
+            app("an app line costs nothing ".repeat(40), 1_020),
+            his("c".repeat(40), 2_000), hers("d".repeat(40), 2_010),
+            his("e".repeat(40), 3_000)
+        )
+        // Each row of talk costs its 40 characters and a little: room for three of them.
+        val page = PersonaNotebookTalk.page(rows, maxChars = 150)
+
+        assertEquals(rows.take(4), page.rows)
+        assertEquals(2_000L, page.readUpTo)
+        assertTrue(page.more)
+        assertEquals("chat-1", page.firstChat)
+        assertEquals(1_000L, page.startsAt)
+
+        // The next page begins with the first row this one did not take.
+        val next = PersonaNotebookTalk.page(rows.filter { it.message.timestamp > page.readUpTo }, maxChars = 150)
+        assertEquals(rows.drop(4), next.rows)
+        assertEquals(3_000L, next.readUpTo)
+        assertFalse(next.more)
+
+        val whole = PersonaNotebookTalk.page(rows)
+        assertEquals(rows, whole.rows)
+        assertFalse(whole.more)
+        val nothing = PersonaNotebookTalk.page(emptyList())
+        assertEquals(0L, nothing.readUpTo)
+        assertEquals(null, nothing.firstChat)
+    }
+
+    @Test
+    fun `a row that is longer than the page is still read, shortened and marked, and the app's rows behind it go along`() {
+        val long = "the whole story. " + "it went on ".repeat(500)
+        val rows = listOf(his(long, 1_000), app("Flashlight on.", 1_005), hers("long story", 1_010), his("anyway", 2_000))
+
+        val page = PersonaNotebookTalk.page(rows, maxChars = 100)
+
+        // One row of talk is always taken; the next one that does not fit ends the page.
+        assertEquals(2, page.rows.size)
+        assertEquals(1_005L, page.readUpTo)
+        val text = page.rows.first().message.text
+        assertTrue(text.length <= PersonaNotebookTalk.ROW_MAX_CHARS + PersonaPrompts.CUT_MARK.length)
+        assertTrue(text.length > PersonaNotebookTalk.ROW_MAX_CHARS - 10)
+        assertTrue(text.endsWith(PersonaPrompts.CUT_MARK))
+        assertTrue(text.startsWith("the whole story. it went on"))
+        // A short row is handed on as it is.
+        assertEquals(rows[3], PersonaNotebookTalk.page(rows.drop(3)).rows.single())
+    }
+
+    @Test
+    fun `rows written in the same millisecond as the last one taken go with it, so the mark never passes an unread row`() {
+        val rows = listOf(
+            his("a".repeat(60), 1_000), hers("b".repeat(60), 1_010),
+            his("c".repeat(60), 1_010), hers("d".repeat(60), 1_010),
+            his("e".repeat(60), 1_020)
+        )
+        val page = PersonaNotebookTalk.page(rows, maxChars = 140)
+
+        assertEquals(rows.take(4), page.rows)
+        assertEquals(1_010L, page.readUpTo)
+        assertEquals(listOf(rows[4]), rows.filter { it.message.timestamp > page.readUpTo })
+    }
+
+    // ── What the pass is shown of a page ─────────────────────────────────────────────
+
+    @Test
+    fun `the talk says on which day it was said and where another chat begins`() {
+        val rows = listOf(
+            his("my mom has surgery tomorrow", 10 * day + 1_000, "chat-1"), hers("which hospital", 10 * day + 1_010, "chat-1"),
+            his("the one by the river", 11 * day + 1_000, "chat-1"), hers("ok", 11 * day + 1_010, "chat-1"),
+            his("new chat, same day", 11 * day + 2_000, "chat-2"), hers("i can see that", 11 * day + 2_010, "chat-2")
+        )
+        val turns = PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(rows), heldBack = false, zone = utc)
+
+        assertEquals(
+            listOf(
+                "(said on Sunday, January 11, 1970) my mom has surgery tomorrow",
+                "which hospital",
+                "(said on Monday, January 12, 1970) the one by the river",
+                "ok",
+                PersonaNotebookTalk.NEW_CHAT_LABEL + "new chat, same day",
+                "i can see that"
+            ),
+            turns.map { it.text }
+        )
+        assertEquals(listOf(Sender.USER, Sender.AGENT, Sender.USER, Sender.AGENT, Sender.USER, Sender.AGENT), turns.map { it.sender })
+        assertEquals("Monday, January 12, 1970", PersonaNotebookTalk.day(11 * day + 1_000, utc))
+    }
+
+    @Test
+    fun `a page that begins with a line of hers keeps it, and a chat with no talk in it opens nothing`() {
+        // She wrote first, hours later, and he answered. The page before ended with her last reply.
+        val rows = listOf(
+            app("Battery is at 80%.", 500, "chat-0"),
+            hers("the boots are still in the window", 1_000, "chat-1"),
+            hers("eleven thousand yen to go", 1_005, "chat-1"),
+            his("which boots", 1_100, "chat-1"),
+            hers("the ones you will hear about until i have them", 1_110, "chat-1")
+        )
+        val turns = PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(rows), heldBack = false, zone = utc)
+
+        assertEquals(
+            listOf(
+                "(said on Thursday, January 1, 1970) the boots are still in the window\neleven thousand yen to go",
+                "which boots",
+                "the ones you will hear about until i have them"
+            ),
+            turns.map { it.text }
+        )
+        assertEquals(listOf(Sender.AGENT, Sender.USER, Sender.AGENT), turns.map { it.sender })
+        val transcript = PersonaPrompts.reflectionUserPrompt("", turns)
+        assertTrue(transcript, transcript.contains("i: (said on Thursday, January 1, 1970) the boots are still in the window / eleven thousand yen to go\nhe: which boots"))
+
+        // A reply she wrote with his screen in front of her says so there as well, and
+        // her line about a private result does not open a page a host could read.
+        val screen = listOf(
+            app("From Mom: dad is back in hospital", 900, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            hers("mom says dad is back in hospital", 910),
+            hers("bob is moving to osaka", 1_000, badge = PersonaPrompts.SCREEN_BADGE),
+            his("so he is", 1_100)
+        )
+        val held = PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(screen), heldBack = true, zone = utc)
+        assertEquals(
+            listOf("(said on Thursday, January 1, 1970) " + PersonaPrompts.SCREEN_REPLY_LABEL + "bob is moving to osaka", "so he is"),
+            held.map { it.text }
+        )
+    }
+
+    @Test
+    fun `her line about a result is not a row of talk, for the count, for the page's room and for the pass`() {
+        val exact = "From Mom: \"dad is back in hospital, call me\""
+        val rows = listOf(
+            his("read my last message", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app(exact, 1_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            hers("mom says dad is back in hospital, call me", 1_020, badge = PersonaPrompts.resultBadge(staysPrivate = true)),
+            his("i should call her", 2_000),
+            hers("then call her", 2_010)
+        )
+        assertTrue(PersonaPrompts.isHers(rows[2].message))
+        assertTrue(PersonaPrompts.isResultLine(rows[2].message))
+        assertFalse(PersonaNotebookTalk.isTalk(rows[2].message))
+        assertFalse(PersonaNotebookTalk.isTalk(rows[1].message))
+        assertTrue(PersonaNotebookTalk.isTalk(rows[0].message) && PersonaNotebookTalk.isTalk(rows[4].message))
+        assertEquals(1, PersonaNotebookTalk.replies(rows))
+
+        // On a private route too: what the message said is not something he told her.
+        val turns = PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(rows), heldBack = false, zone = utc)
+        val transcript = PersonaPrompts.reflectionUserPrompt("", turns)
+        assertFalse(transcript, transcript.contains("hospital"))
+        assertTrue(transcript, transcript.contains(PersonaPrompts.HANDLED_COMMAND_LABEL + "read my last message / i should call her"))
+        assertTrue(transcript, transcript.contains("i: then call her"))
+    }
+
+    // ── What is kept of a chat that is deleted ───────────────────────────────────────
+
+    @Test
+    fun `of a deleted chat his rows and hers are kept as they are, and of every other row only its place and badge`() {
+        val rows = listOf(
+            his("i keep bees by the way", 1_000),
+            hers("of course you do", 1_010),
+            his("read my notifications", 2_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("Riya: the hive inspector comes on friday", 2_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            hers("riya says the inspector comes on friday", 2_020, badge = PersonaPrompts.resultBadge(staysPrivate = true)),
+            his("Riya Fernhill", 2_500, badge = PersonaPrompts.OWNER_PICK_BADGE)
+        ).map { it.copy(message = it.message.copy(imageBase64 = "aGk=", contactPickerData = "{}")) }
+
+        val kept = PersonaNotebookTalk.toKeep(rows)
+
+        assertEquals(rows.map { it.message.id }, kept.map { it.message.id })
+        assertEquals(rows.map { it.message.modelBadge }, kept.map { it.message.modelBadge })
+        assertEquals(
+            listOf("i keep bees by the way", "of course you do", "read my notifications", "-", "-", "Riya Fernhill"),
+            kept.map { it.message.text }
+        )
+        assertTrue(kept.all { it.message.imageBase64 == null && it.message.contactPickerData == null })
+        // The name he tapped keeps its badge, so a pass on a route a host could read still holds it back.
+        val held = PersonaPrompts.reflectionUserPrompt("", PersonaNotebookTalk.dialogue(PersonaNotebookTalk.page(kept), heldBack = true, zone = utc))
+        assertFalse(held, held.contains("Fernhill"))
+        assertFalse(held, held.contains("inspector"))
+        assertTrue(held, held.contains("he: (said on Thursday, January 1, 1970) i keep bees by the way"))
+
+        // A chat with no talk in it leaves nothing.
+        assertTrue(PersonaNotebookTalk.toKeep(listOf(app("Battery is at 80%.", 1_000))).isEmpty())
+        assertTrue(PersonaNotebookTalk.toKeep(emptyList()).isEmpty())
+    }
+
+    // ── Her line about a result in her chat prompt ───────────────────────────────────
+
+    @Test
+    fun `her line about a private result goes where the exact row may go, and nowhere else`() {
+        val exact = "From Mom: \"dad is back in hospital, call me\""
+        fun rows(herBadge: String) = listOf(
+            his("read my last message", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app(exact, 1_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
+            hers("mom says dad is back in hospital, call me", 1_020, badge = herBadge),
+            his("ok", 2_000)
+        ).map { it.message }
+
+        // Stored now under her result badge, and before that under her plain one.
+        for (badge in listOf(PersonaPrompts.resultBadge(staysPrivate = true), PersonaPrompts.BADGE)) {
+            val held = PersonaPrompts.shapeHistory(rows(badge), holdBackPrivateResults = true)
+            val sent = held.dialogue.joinToString("\n") { it.text } + held.deviceActivity.joinToString("\n")
+            assertFalse(badge, sent.contains("hospital"))
+            assertEquals(listOf(PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER), held.deviceActivity)
+            // On a private route her line is replayed as she said it.
+            val open = PersonaPrompts.shapeHistory(rows(badge))
+            assertTrue(open.dialogue.any { it.text == "mom says dad is back in hospital, call me" })
+        }
+        // A result that may go anywhere: so may her line about it.
+        val plain = listOf(
+            his("flashlight on", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE).message,
+            app("Flashlight on.", 1_010).message,
+            hers("light's on", 1_020, badge = PersonaPrompts.resultBadge(staysPrivate = false)).message
+        )
+        assertTrue(PersonaPrompts.shapeHistory(plain, holdBackPrivateResults = true).dialogue.any { it.text == "light's on" })
+        // A reply of hers behind a row of his is never taken for one.
+        val reply = listOf(his("hi", 1_000).message, hers("mm", 1_010).message)
+        assertEquals(listOf("hi", "mm"), PersonaPrompts.shapeHistory(reply, holdBackPrivateResults = true).dialogue.map { it.text })
+
+        assertEquals("Yume (result)", PersonaPrompts.RESULT_BADGE)
+        assertEquals("Yume (result) (private)", PersonaPrompts.resultBadge(staysPrivate = true))
+        assertFalse(PersonaPrompts.isResultLine(hers("mm", 1).message))
+        assertFalse(PersonaPrompts.isResultLine(app("x", 1, badge = PersonaPrompts.RESULT_BADGE).message.copy(sender = Sender.USER)))
+        // It is hers: the stock chat is not handed it, and it is no row of the app's that shows him his data.
+        assertTrue(PersonaPrompts.stockHistory(rows(PersonaPrompts.resultBadge(true)), holdBack = false).none { it.text.contains("mom says") })
+        assertFalse(PersonaPrompts.isPrivateResult(rows(PersonaPrompts.resultBadge(true))[2]))
+    }
+
+    // ── A line of hers that only stands behind a marked row ──────────────────────────
+
+    private val hour = 60 * 60_000L
+
+    @Test
+    fun `a line she wrote unprompted behind a marked row stays in her own history on a route that holds it back`() {
+        // On such a route she words no result, so the marked row is the last row of his command.
+        val rows = listOf(
+            his("read my notifications", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("Riya: the hive inspector comes on friday at 9:30", 1_010, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
