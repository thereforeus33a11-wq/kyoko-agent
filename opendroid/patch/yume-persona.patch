+package com.opendroid.ai.core.life.ears
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** What she overheard: memory only, 20 min, 40 lines or 2,000 characters; shown once; cleared on sleep and switch-off. */
+class OverheardTest {
+
+    private var now = 1_800_000_000_000L
+    private val minute = 60_000L
+    private val heard = Overheard { now }
+
+    private fun line(text: String? = "where are my keys", at: Long = now, his: Boolean = true) = Overheard.Line(at, text, emptyList(), his)
+
+    @Test
+    fun `lines older than 20 minutes are let go of`() {
+        heard.add(line(at = now - 21 * minute))
+        heard.add(line(at = now - 19 * minute))
+        assertEquals(1, heard.size())
+        now += 2 * minute
+        assertEquals(0, heard.size())
+    }
+
+    @Test
+    fun `at most 40 lines and 2000 characters, the oldest going first`() {
+        repeat(45) { heard.add(line("line $it")) }
+        assertEquals(Overheard.MAX_LINES, heard.size())
+        val taken = heard.take()!!
+        assertEquals("line 5", taken.lines.first().text)
+        repeat(5) { heard.add(line("x".repeat(500))) }
+        assertEquals(4, heard.size())
+    }
+
+    @Test
+    fun `her next prompt is told once, and a prompt built again for the same turn gets the same`() {
+        heard.add(line("one"))
+        val first = heard.take()
+        assertNotNull(first)
+        assertEquals(listOf("one"), first!!.lines.map { it.text })
+        // The same turn's prompt built again (a second try without a picture): the same again, with anything new.
+        now += 30_000
+        heard.add(line("two"))
+        assertEquals(listOf("one", "two"), heard.take()!!.lines.map { it.text })
+        // Her next turn, later: nothing left.
+        now += Overheard.REBUILD_MILLIS + 1
+        assertNull(heard.take())
+    }
+
+    @Test
+    fun `what was only counted is told as an amount, and a little of it not at all`() {
+        heard.countOthers(2_000)
+        assertNull(heard.take())
+        now += Overheard.REBUILD_MILLIS + 1
+        heard.countOthers(5 * minute)
+        heard.countAnyone(40_000)
+        val taken = heard.take()!!
+        assertEquals(5 * minute, taken.othersMillis)
+        assertEquals(40_000L, taken.anyoneMillis)
+        assertTrue(taken.lines.isEmpty())
+    }
+
+    @Test
+    fun `sleep and the switch clear everything`() {
+        heard.add(line())
+        heard.countOthers(5 * minute)
+        heard.clear()
+        assertEquals(0, heard.size())
+        assertNull(heard.take())
+    }
+
+    @Test
+    fun `no word overheard is in a toString`() {
+        val secret = "SENTINEL-overheard"
+        heard.add(line(secret))
+        val taken = heard.take()!!
+        assertFalse(taken.toString().contains(secret))
+        assertFalse(taken.lines.single().toString().contains(secret))
+    }
+}
