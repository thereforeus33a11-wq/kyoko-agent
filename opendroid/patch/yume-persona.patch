+        // The forms she is shown are forms the app reads.
+        for (shown in listOf("20m", "3h", "1h30m", "2d", "02:30 (his clock)", "when he writes")) {
+            assertTrue(shown, block.contains(shown))
+            assertTrue(shown, PersonaOwnTime.parseWish(shown) != null)
+        }
+        // And every mark it names is one the parser sorts by.
+        val sorted = PersonaOwnTime.parse("say: a\nnote: me | mine | a note of mine\n>> flashlight on\nnext: 20m")
+        assertEquals("", sorted.thoughts)
