+/** Where a model may run, what each configured route is, and what is held back on a readable one. */
+@Composable
+fun PrivacyCard(config: LLMConfig, viewModel: SettingsViewModel) {
+    val mainRoute = RouteClassifier.mainRoute(config)
+    val herRoute = RouteClassifier.personaRoute(config)
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            Text(
+                text = "PRIVACY",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            SettingChoiceRow(
+                label = "Where a model may run",
+                options = ROUTE_POLICY_CHOICES,
+                selected = config.routePolicy,
+                onSelect = viewModel::updateRoutePolicy
+            )
+            RouteLine("Your commands and plans", mainRoute, config.routePolicy.allows(mainRoute))
+            RouteLine("Her replies and her notebook", herRoute, config.routePolicy.allows(herRoute))
+            Text(
+                text = when (config.routePolicy) {
+                    RoutePolicy.OWN_HARDWARE -> "Nothing you say is sent to any company. A model that is not on this phone or on your own network is refused before anything leaves."
+                    RoutePolicy.ENCRYPTED -> "A model at a company is used only end to end encrypted (a model id starting with e2ee-): the prompt is encrypted on this phone for a sealed enclave, and the company relaying it cannot read it. The machines that run the enclave still process it inside sealed hardware, so the only route where nothing leaves at all is your own hardware. A plain hosted model is refused before anything is sent."
+                    RoutePolicy.ANY -> "A plain hosted model is allowed. Whoever hosts it can read what it is sent: the conversation, her card and, unless the switch below is on, your details."
+                },
+                fontSize = 10.sp,
+                color = if (config.routePolicy == RoutePolicy.ANY) AccentCyan else TextSecondary
+            )
+            SettingSwitchRow(
+                title = "On a plain hosted model, keep my details on this phone",
+                description = "Your date of birth, where you are, the text of your notifications, what the phone read out to you and what she has noted about you are left out of anything sent to a model that can be read by its host. On a private route she sees all of it, because nobody else can.",
+                checked = config.privateMode,
+                onCheckedChange = viewModel::updatePrivateMode
+            )
+            Text(
+                text = "Everything she knows is stored on this phone only: the chat, her notebook, her files. Backups to the cloud are switched off for this app. An ElevenLabs voice sends every spoken line to ElevenLabs, so it is used only when plain hosted models are allowed; otherwise the phone's own voice speaks.",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+        }
+    }
+}
+
+@Composable
+private fun RouteLine(what: String, route: RoutePrivacy, allowed: Boolean) {
+    Text(
+        text = "$what: ${route.label}" + if (allowed) "" else " — refused by the setting above",
+        fontSize = 12.sp,
+        fontFamily = FontFamily.Monospace,
+        color = if (allowed && route.isPrivate) TextPrimary else AccentCyan
+    )
+}
