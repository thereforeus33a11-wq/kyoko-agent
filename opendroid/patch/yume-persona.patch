+        val voiceRow = stored(voice)
+        val bootsRow = stored(boots)
+        val archivedBefore = memory.archiveCount()
+
+        assertEquals(1, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(voiceRow, stored(voice))
+        assertEquals(bootsRow, stored(boots))
+        assertEquals(builder.text, stored(builder)!!.value)
+        assertEquals(archivedBefore + 1, memory.archiveCount())
+    }
