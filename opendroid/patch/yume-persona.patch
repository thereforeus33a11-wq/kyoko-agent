+/**
+ * Her brain on another model, as "Try her brain" tries it and "Use this one" sets it: the
+ * settings her replies would have on a model ([withBrain]), the route that takes
+ * ([route]), and why a model cannot be tried or chosen as things are set ([whyNot]).
+ *
+ * Her replies, her notebook and her own time all go to the one model set for her replies:
+ * there is no separate model for her own time, so one choice moves all three. The planner and
+ * everything else on the main provider stay where they are.
+ */
+object BrainChoice {
+
+    /** The words of his switch in Her own senses that trusts Venice's Private tier for her. */
+    const val TRUST_SWITCH = "Trust Venice's Private tier for her"
+
+    /**
+     * The settings with her brain on [model], as "Use this one" leaves them: her replies on
+     * Venice's provider with that model; reply options that ask it to answer without thinking
+     * first where Venice lets that be said ([BrainModels.replyOptions]); pictures to her own
+     * model where it sees and its route carries them, and his voice as sound where it hears,
+     * as her senses do ([BrainModels.senses]), and only while he trusts Venice's Private tier
+     * for her: on a hosted route his pictures and voice are not sent. His trust in Venice's
+     * Private tier and his setting of where a model may run are left as he set them.
+     */
+    fun withBrain(config: LLMConfig, model: String): LLMConfig {
+        val id = model.trim()
+        val senses = BrainModels.senses(id, config)
+        return config.copy(
+            personaChatProvider = HerBrain.PROVIDER,
+            personaChatModel = id,
+            personaChatModelProvider = HerBrain.PROVIDER,
+            personaChatExtraBody = BrainModels.replyOptions(id),
+            personaChatSeesImages = senses.sees,
+            personaChatHearsAudio = senses.hears
+        )
+    }
+
+    /**
+     * "Use this one": [withBrain], with what she had before kept, once, for "Back to her brain
+     * before" in Her own senses ([HerBrain.moveBack]). Unchanged when [whyNot] has a reason.
+     */
+    fun use(config: LLMConfig, model: String): LLMConfig {
+        if (whyNot(config, model) != null) return config
+        // A record from the one tap, made before his options were kept, gets them as they stand now.
+        val before = config.personaBrainBefore.ifBlank { HerBrain.record(config) }.let { HerBrain.withOptionsKept(it, config.personaChatExtraBody) }
+        return withBrain(config, model).copy(personaBrainBefore = before)
+    }
+
+    /** The route her replies would take on [model] as [config] stands: encrypted, the Private tier trusted, or hosted. */
+    fun route(config: LLMConfig, model: String): RoutePrivacy = RouteClassifier.personaRoute(withBrain(config, model))
+
+    /** Whether his details would be held back from her prompt on [model] (private mode on a hosted route). */
+    fun holdsBack(config: LLMConfig, model: String): Boolean = config.holdsBackDetails(route(config, model))
+
+    /** Whether [model] is one her brain can go to at all: an encrypted model this build knows, or one of Venice's Private tier. */
+    fun offered(config: LLMConfig, model: String): Boolean {
+        val id = model.trim().lowercase()
+        return if (BrainModels.encrypted(id)) BrainModels.of(id) != null else VenicePrivateTier.isPrivateTier(id, config)
+    }
+
+    /** Why [model] cannot be tried or chosen as [config] stands, in his words, or null when it can. */
+    fun whyNot(config: LLMConfig, model: String): String? {
+        HerBrain.whyNotMove(config)?.let { return it }
+        val id = model.trim().lowercase()
+        if (!offered(config, id)) {
+            return if (BrainModels.encrypted(id)) {
+                "This build does not know the encrypted model $id."
+            } else {
+                "Venice's list does not have $id in its Private tier now."
+            }
+        }
+        val route = route(config, id)
+        if (!config.routePolicy.allows(route)) {
+            return when {
+                config.routePolicy == RoutePolicy.OWN_HARDWARE ->
+                    "Your setting of where a model may run allows only this phone and your own network, and Venice is neither."
+                route == RoutePrivacy.HOSTED && !config.trustVenicePrivate ->
+                    "Venice's Private tier is not trusted for her, and your setting of where a model may run allows only private routes. " +
+                        "Switch on \"$TRUST_SWITCH\" in Her own senses to try it."
+                else -> "Your setting of where a model may run does not allow this route (${route.label})."
+            }
+        }
+        return null
+    }
+
+    /** The route in a few words for his screen, with what Venice can read on it. */
+    fun routeWords(config: LLMConfig, model: String): String = when (route(config, model)) {
+        RoutePrivacy.ENCRYPTED -> "end to end encrypted, text only"
+        RoutePrivacy.PRIVATE_TIER -> "Venice Private tier: read to answer, nothing kept"
+        RoutePrivacy.HOSTED -> "hosted, readable by Venice" + if (holdsBack(config, model)) ", your details held back" else ""
+        else -> route(config, model).label
+    }
+}
+
+/**
+ * "Try her brain": on his tap, her real reply prompt to the same words of his, sent to two to
+ * four models side by side, each through the route it would take as her brain ([BrainChoice]),
+ * with how long each took and what it cost.
+ *
+ * Her prompt for each is built the way a reply of hers to his talk is built, with the settings
+ * she would have on that model ([PersonaEngine.trialRequest]): her card, her files' pages, her
+ * notes, how she feels, her thoughts, what she did on her own and what she overheard, and the
+ * recent talk of the chat, then his message. No picture goes with a try, on any model, so each
+ * is asked the same.
+ *
+ * It is his act and leaves nothing behind: no row in the chat, nothing in her notebook, her
+ * thoughts, her mood, her log, her memory or her sleep pass; what she overheard is read and not
+ * used up; no call of it is counted in her ledger (none runs as a call of hers on her own); and
+ * the replies stay in memory, on his screen.
+ */
+class BrainTrial(
+    /** The newest rows of the chat he is in, read only, oldest first. */
+    private val recentRows: suspend () -> List<ChatMessage>,
+    /** Her reply request for these rows with these settings. */
+    private val prompt: suspend (LLMConfig, List<ChatMessage>) -> LLMRequest,
+    /** Sends one request through the provider as if these settings were saved. */
+    private val send: suspend (LLMConfig, LLMRequest) -> LLMResponse,
+    private val clock: () -> Long = System::currentTimeMillis
+) {
+
+    /** What she is asked to answer. */
+    sealed class Ask {
+        /** One message he types here, after the recent talk. It is not stored. */
+        data class Typed(val text: String) : Ask()
+
+        /** The last real exchange: the chat as it stood when his last message there came, without what answered it. */
+        data object LastExchange : Ask()
+    }
+
+    /** What one model came to. */
+    class Entry(val model: String, val millis: Long, val shown: Shown)
+
+    sealed class Shown {
+        /**
+         * Her reply as the chat would show it ([said]), the lines she would have kept to
+         * herself ([keptToHerself]) and the command she would have ended it with ([command],
+         * never run), with the tokens it took and what that cost.
+         */
+        class Reply(
+            val said: String,
+            val keptToHerself: String,
+            val command: String?,
+            val promptTokens: Int,
+            val replyTokens: Int,
+            /** True when the tokens are Venice's own count; false when they are estimated from the text. */
+            val counted: Boolean,
+            val usd: Double?,
+            val cutOff: Boolean
+        ) : Shown()
+
+        /** Asked, and no reply came: why, in plain words. */
+        class Failed(val why: String) : Shown()
+
+        /** Not asked, and why. */
+        class NotTried(val why: String) : Shown()
+    }
+
+    /** The rows a try answers, or why there are none. */
+    sealed class Rows {
+        class Ready(val rows: List<ChatMessage>) : Rows()
+        class None(val why: String) : Rows()
+    }
+
+    /** The rows [ask] puts in front of her: the recent talk, and his message last. */
+    suspend fun rows(ask: Ask): Rows {
+        val recent = recentRows()
+        return when (ask) {
+            is Ask.Typed -> {
+                val text = ask.text.trim()
+                if (text.isEmpty()) return Rows.None(NO_MESSAGE)
+                // As his message stands in the chat when her reply to it is built: talk, not yet anything else.
+                val his = ChatMessage(
+                    id = UUID.randomUUID().toString(),
+                    text = text,
+                    sender = ChatMessage.Sender.USER,
+                    timestamp = clock(),
+                    modelBadge = PersonaPrompts.OWNER_TALK_BADGE
+                )
+                // As many rows as her reply in the chat is built from, his message among them.
+                Rows.Ready(recent.takeLast(HISTORY_ROWS - 1) + his)
+            }
+            Ask.LastExchange -> {
+                val last = recent.indexOfLast { it.sender == ChatMessage.Sender.USER }
+                if (last < 0) Rows.None(NO_EXCHANGE) else Rows.Ready(recent.subList(0, last + 1).toList())
+            }
+        }
+    }
+
+    /**
+     * Asks each of [models] (at most [BrainModels.MAX_PER_TRY], each once) with [config] as he
+     * has it, all at once; [onEach] is told as each is done.
+     */
+    suspend fun run(config: LLMConfig, models: List<String>, ask: Ask, onEach: suspend (Entry) -> Unit) {
+        val chosen = models.map { it.trim() }.filter { it.isNotEmpty() }.distinct().take(BrainModels.MAX_PER_TRY)
+        val rows = when (val found = rows(ask)) {
+            is Rows.None -> {
+                chosen.forEach { onEach(Entry(it, 0, Shown.NotTried(found.why))) }
+                return
+            }
+            is Rows.Ready -> found.rows
+        }
+        coroutineScope {
+            for (model in chosen) {
+                launch { onEach(one(config, model, rows)) }
+            }
+        }
+    }
+
+    private suspend fun one(config: LLMConfig, model: String, rows: List<ChatMessage>): Entry {
+        BrainChoice.whyNot(config, model)?.let { return Entry(model, 0, Shown.NotTried(it)) }
+        val asIfHers = BrainChoice.withBrain(config, model)
+        val started = clock()
+        return try {
+            val request = prompt(asIfHers, rows)
+            val response = send(asIfHers, request)
+            Entry(model, clock() - started, reply(model, request, response))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: LLMException) {
+            Entry(model, clock() - started, Shown.Failed(failureWords(e)))
+        } catch (e: Exception) {
+            Entry(model, clock() - started, Shown.Failed("It failed on the phone (${e.javaClass.simpleName}), and nothing came back."))
+        }
+    }
+
+    companion object {
+        /** As many stored rows of the chat as her reply there is built from (the chat loop's own number). */
+        const val HISTORY_ROWS = 48
+
+        const val NO_MESSAGE = "Type a message for her first, or use the last real exchange."
+        const val NO_EXCHANGE = "There is no message of yours in the chat yet to answer again. Type one here instead."
+
+        /**
+         * Her reply as the chat would show it, from the whole answer: the lines she keeps to
+         * herself taken out first, then a command line at its end, then what is left cleaned the
+         * way a reply of hers is. Nothing of it is kept or run.
+         */
+        fun reply(model: String, request: LLMRequest, response: LLMResponse): Shown.Reply {
+            val split = PersonaThoughtLines.split(response.content)
+            val action = PersonaActions.split(split.text)
+            val counted = response.promptTokens != null && response.completionTokens != null
+            val promptTokens = response.promptTokens
+                ?: PromptBudget.estimateTokens(request.systemPrompt + request.messages.joinToString("\n") { it.text })
+            val replyTokens = response.completionTokens ?: PromptBudget.estimateTokens(response.content)
+            return Shown.Reply(
+                said = PersonaPrompts.cleanReply(action.text),
+                keptToHerself = split.thoughts,
+                command = action.command,
+                promptTokens = promptTokens,
+                replyTokens = replyTokens,
+                counted = counted,
+                usd = BrainModels.usd(model, promptTokens, replyTokens),
+                cutOff = FinishReason.isLength(response.finishReason)
+            )
+        }
+
+        /** Why a model gave no reply, in plain words: what it was, and whether anything was sent. */
+        fun failureWords(e: LLMException): String {
+            val status = e.status?.let { " (HTTP $it)" }.orEmpty()
+            return when (e.error) {
+                LLMError.ProviderRefused -> "It turned her reply down: the model or Venice refused to answer as her."
+                LLMError.PrivateRouteRequired -> "Not sent: your setting of where a model may run does not allow its route."
+                LLMError.AuthMissing, LLMError.AuthInvalid, LLMError.KeyForOtherAddress -> "Venice did not take your key$status."
+                LLMError.QuotaExhausted -> "Your Venice balance or limit is used up$status."
+                LLMError.RateLimited -> "Venice says too many requests just now$status. Try again in a minute."
+                LLMError.ModelUnavailable -> "Venice does not offer this model now$status."
+                LLMError.RequestInvalid -> "Venice would not take the request$status: the model may not take her reply options."
+                LLMError.Network -> "No connection to Venice: nothing came back."
+                LLMError.ServerError -> "Venice failed to answer$status."
+                LLMError.MalformedResponse -> "Its answer was empty or could not be read$status."
+                LLMError.ReplyLimitReached -> "It used all its room thinking and wrote no reply."
+                LLMError.PromptTooLarge -> "Her card and notes do not fit this model, and they are never cut to fit."
+                LLMError.EncryptionCheckFailed -> "The encryption check failed, so nothing of it is shown."
+                LLMError.PlainHttpRefused, LLMError.AddressMissing, LLMError.EncryptedModelAtOtherAddress ->
+                    "Not sent: Venice's address is not set right for this model."
+                else -> "It failed (${e.error.code}$status)."
+            }
+        }
+    }
+}
