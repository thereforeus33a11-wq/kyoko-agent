+package com.opendroid.ai.core.persona
+
+/**
+ * The persona's own notebook: short plain-English notes she keeps between chats.
+ *
+ * A note is one line, `kind | key | text`. The same form is used for the seed file
+ * shipped with the app, for what the reflection call returns, and for display, so
+ * there is one parser. It is strict about the form and not about the details: a key is
+ * made to fit, a note that is too long is shortened and says so, and a line that has no
+ * kind, key and text is not a note. What becomes of such a line is told to whoever
+ * wrote it ([read]).
+ */
+object PersonaNotes {
+
+    /**
+     * Notes live in the existing `memories` table under this key prefix. The prefix is
+     * what keeps them out of the planner's "facts about user" context. No `_` or `%`:
+     * the DAO looks rows up with SQL LIKE, where those are wildcards.
+     */
+    const val KEY_PREFIX = "yume."
+
+    /** How long she is told a note may be. */
+    const val MAX_NOTE_CHARS = 200
+
+    /**
+     * How long a note may really be before it is shortened. A model cannot count
+     * characters: a note that runs over what she is told is hers all the same and is
+     * kept whole, up to twice that length.
+     */
+    const val NOTE_CEILING_CHARS = 2 * MAX_NOTE_CHARS
+    private const val MAX_KEY_CHARS = 40
+
+    /**
+     * How many notes the notebook holds. Past it the oldest closed threads are taken out
+     * first, then the oldest open threads and opinions. What she noted about him, about
+     * the two of them, about herself and what he corrected is never taken out.
+     */
+    const val MAX_TOTAL_NOTES = 200
+
+    /**
+     * The room threads and opinions always have, however many of the notes that are never
+     * taken out she holds. Without it a notebook full of those would have no place left
+     * for a thread or an opinion at all: each new one would be taken out as it was written.
+     */
+    const val MIN_THREADS_AND_OPINIONS = 40
+
+    /** How many lines one notebook pass may write. Her notebook prompt says the same number. */
+    const val LINES_PER_PASS = 5
+
+    /**
+     * How many characters of notes go into one prompt. It counts the notes' own text, and
+     * her chat prompt and the notebook pass have the same room.
+     */
+    const val PROMPT_BUDGET_CHARS = 9000
+
+    /** How many closed threads her chat prompt shows, newest first. */
+    const val CLOSED_THREADS_SHOWN = 5
+
+    /** Opens a note about something she saw on his screen, as against something he told her. */
+    const val SEEN_PREFIX = "saw:"
+
+    /** Opens a note that is a story of her street life: hers, and by her notebook's own rule not about him. */
+    const val STREET_STORY_PREFIX = "street story:"
+
+    /**
+     * The share of the page that is kept free for notes the rest of it had no room for,
+     * once the notebook is longer than the page ([Recall]).
+     */
+    private const val RECALL_SHARE = 4
+
+    /** How long one turn of the notes that take turns on the page lasts. */
+    const val TURN_MILLIS = 5 * 60_000L
+
+    enum class Kind(val label: String) {
+        /** A lasting fact about the owner. */
+        USER("user"),
+        /** Where the two of them stand. */
+        REL("rel"),
+        /** Something she has settled about herself. */
+        ME("me"),
+        /** An ongoing matter; the text ends with its status. */
+        THREAD("thread"),
+        /** A view she holds. */
+        OPINION("opinion"),
+        /**
+         * A guessed detail about her that the owner corrected, or a line of hers he
+         * called fake. It is kept as an example, not as a rule she is held to.
+         */
+        FIX("fix");
+
+        companion object {
+            fun fromLabel(label: String): Kind? = entries.firstOrNull { it.label == label.trim().lowercase() }
+        }
+    }
+
+    /**
+     * How she knows what a note says, as she marks it herself in her sleep: he told her,
+     * she read it, she worked it out, she is not sure, or she lived it. A mark is hers
+     * and changes nothing by itself: it is shown to her beside the note, so that a guess
+     * does not harden into a fact and what she lived is known as lived.
+     */
+    enum class How(val label: String) {
+        TOLD("told"),
+        READ("read"),
+        INFERRED("inferred"),
+        UNSURE("unsure"),
+        LIVED("lived");
+
+        companion object {
+            fun fromLabel(label: String): How? = entries.firstOrNull { it.label == label.trim().trimEnd('.').trim().lowercase() }
+        }
+    }
+
+    data class Note(val kind: Kind, val key: String, val text: String) {
+        val storageKey: String get() = "$KEY_PREFIX${kind.label}.$key"
+
+        /** A thread whose status says it is over. It is kept, so that she remembers how it ended. */
+        val isClosedThread: Boolean
+            get() = kind == Kind.THREAD && CLOSED_STATUS.containsMatchIn(text)
+
+        /**
+         * Something she saw rather than something he said. Whatever kind such a note was
+         * given, it is shown under a heading of its own and never as a fact about him or
+         * as a correction of his.
+         */
+        val isSeen: Boolean
+            get() = text.trimStart().startsWith(SEEN_PREFIX, ignoreCase = true)
+
+        /** A story of her street life, whatever kind it was filed under. */
+        val isStreetStory: Boolean
+            get() = text.trimStart().startsWith(STREET_STORY_PREFIX, ignoreCase = true)
+
+        fun toLine(): String = "${kind.label} | $key | $text"
+    }
+
+    private val KEY_FORM = Regex("^[a-z0-9][a-z0-9-]{1,39}$")
+    private val NOT_KEY_CHARS = Regex("[^a-z0-9]+")
+    private val CLOSED_STATUS = Regex("""\|\s*closed\s*$""", RegexOption.IGNORE_CASE)
+    private val STATUS = Regex("""\s*\|\s*(open|stalled|closed)\s*$""", RegexOption.IGNORE_CASE)
+    private val CONTROL_CHARS = Regex("""[\u0000-\u001F\u007F]""")
+
+    // How old a note is, in each of the forms PersonaPrompts.age writes it.
+    private const val AGE_WORDS = """(?:just now|\d+ min ago|\d+ h ago|yesterday|\d+ days ago)"""
+    private const val STATUS_WORDS = """(?:open|stalled|closed)"""
+
+    /** What a page puts behind a starting note that still has the words her files gave it ([Origins]). */
+    const val FROM_FILES = "from your files"
+
+    // Her marks, in the words a page shows them.
+    private val HOW_WORDS = How.entries.joinToString("|", "(?:", ")") { it.label }
+
+    /**
+     * What a page puts in a bracket behind a note ([shownText]): how old it is, that it is
+     * a starting note in the words of her files, her mark of how she knows it, or more
+     * than one of them, as "(written 3 days ago, from your files)" or "(told)".
+     */
+    private val TAG_WORDS = """(?:written $AGE_WORDS|$FROM_FILES|$HOW_WORDS)(?:,\s*(?:$FROM_FILES|$HOW_WORDS))*"""
+
+    /**
+     * That bracket at the end of a line that comes back with it. It is taken off again:
+     * it is the notebook's, not part of the note. A mark in it is kept as her mark
+     * ([markIn]), since she can write one there herself. Only the notebook's own wording
+     * is taken for it. Words of hers that end a note in brackets, "(written on my arm)",
+     * are hers and stay.
+     */
+    private val WRITTEN_AGO = Regex("""\s*\($TAG_WORDS\)\s*$""")
+
+    /**
+     * The same where a status follows it. A page shows the bracket behind the status a
+     * thread has, "... | open (written 3 days ago)", and she closes a thread by ending it
+     * with its status, so the bracket can come back in the middle: "... | open (written 3
+     * days ago) | closed". It goes, and with it the status it stood behind: the one at
+     * the end is the status now.
+     */
+    private val WRITTEN_AGO_BEFORE_STATUS = Regex(
+        """(?:\s*\|\s*$STATUS_WORDS)?\s*\($TAG_WORDS\)(?=\s*\|\s*$STATUS_WORDS\s*$)""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** [text] without the bracket a page put behind it. */
+    private fun withoutAge(text: String): String =
+        WRITTEN_AGO.replace(WRITTEN_AGO_BEFORE_STATUS.replace(text, ""), "")
+
+    private val HOW_WORD = Regex("""\b$HOW_WORDS\b""", RegexOption.IGNORE_CASE)
+
+    /**
+     * Her mark in the bracket [withoutAge] takes off [text], or null when the bracket has
+     * none or there is no bracket: the last mark word in it. A mark she puts behind a
+     * line, "(unsure)", is how she knows it; it is taken off the text and kept as her mark.
+     */
+    private fun markIn(text: String): How? {
+        val bracket = WRITTEN_AGO_BEFORE_STATUS.find(text)?.value ?: WRITTEN_AGO.find(text)?.value ?: return null
+        return HOW_WORD.findAll(bracket).lastOrNull()?.let { How.fromLabel(it.value) }
+    }
+
+    /**
+     * [raw] as a key: lower case, with every run of other characters turned into one
+     * hyphen and no more than [MAX_KEY_CHARS] characters. A key she wrote with an
+     * apostrophe, a dot or a few letters too many is made to fit, not refused: the note
+     * under it is what matters. Null only when nothing that can be a key is left.
+     */
+    private fun fitKey(raw: String): String? {
+        val key = NOT_KEY_CHARS.replace(raw.trim().lowercase().replace("'", "").replace("\u2019", ""), "-")
+            .trim('-').take(MAX_KEY_CHARS).trimEnd('-')
+        return key.takeIf { KEY_FORM.matches(it) }
+    }
+
+    /**
+     * [text] within [NOTE_CEILING_CHARS]. A longer note is shortened and says so: it ends
+     * in the mark her prompt explains ([PersonaPrompts.CUT_MARK]), so that what is left is
+     * never taken for the whole. It is cut between two words where one is near, and the
+     * status a thread ends with is kept behind the mark: without it a thread she closed
+     * would stand among the open ones.
+     */
+    private fun fitText(kind: Kind, text: String): String {
+        if (text.length <= NOTE_CEILING_CHARS) return text
+        val status = if (kind == Kind.THREAD) STATUS.find(text)?.let { " | " + it.groupValues[1].lowercase() }.orEmpty() else ""
+        val body = if (status.isEmpty()) text else STATUS.replace(text, "")
+        val room = NOTE_CEILING_CHARS - PersonaPrompts.CUT_MARK.length - status.length
+        var kept = body.take(room)
+        val lastSpace = kept.lastIndexOf(' ')
+        if (body.length > room && !body[room].isWhitespace() && lastSpace > room - WORD_SPARED_CHARS) kept = kept.take(lastSpace)
+        return kept.trimEnd() + PersonaPrompts.CUT_MARK + status
+    }
+
+    // How far back a cut goes to end on a whole word.
+    private const val WORD_SPARED_CHARS = 40
+
+    /**
+     * One line read as a note, whether its text was longer than a note may be and was
+     * shortened for it, and the mark she put behind it in a bracket ([markIn]).
+     */
+    private class Parsed(val note: Note, val shortened: Boolean, val how: How?)
+
+    private fun parsed(line: String): Parsed? {
+        val cleaned = line.trim().removePrefix("-").removePrefix("*").trim()
+        if (cleaned.isEmpty() || cleaned.startsWith("#")) return null
+        val parts = cleaned.split("|", limit = 3)
+        if (parts.size != 3) return null
+        val kind = Kind.fromLabel(parts[0]) ?: return null
+        val key = fitKey(parts[1]) ?: return null
+        val flat = CONTROL_CHARS.replace(parts[2], " ").replace(Regex("""\s+"""), " ")
+        val text = withoutAge(flat).trim()
+        if (text.length < 3) return null
+        return Parsed(Note(kind, key, fitText(kind, text)), shortened = text.length > NOTE_CEILING_CHARS, how = markIn(flat))
+    }
+
+    /** Parses one `kind | key | text` line, or returns null when it does not fit the form. */
+    fun parseLine(line: String): Note? = parsed(line)?.note
+
+    /** The mark she put behind one note line in a bracket, "(unsure)", or null when there is none ([markIn]). */
+    fun markOf(line: String): How? = parsed(line)?.how
+
+    /**
+     * [marks], her marks by the storage key of the note she wrote them behind, moved to
+     * the keys [placed] stores those notes under: a note she wrote without sight of one
+     * she has goes beside it ([besideUnseen]), with its kind and its text unchanged.
+     */
+    fun marksFor(placed: List<Note>, written: List<Note>, marks: Map<String, How>): Map<String, How> {
+        if (marks.isEmpty()) return emptyMap()
+        val out = HashMap<String, How>()
+        for (note in placed) {
+            val from = written.firstOrNull { it.storageKey == note.storageKey && it.text == note.text }
+                ?: written.firstOrNull { it.kind == note.kind && it.text == note.text }
+                ?: continue
+            marks[from.storageKey]?.let { out[note.storageKey] = it }
+        }
+        return out
+    }
+
+    /**
+     * The storage key a line names by [kindLabel] and [rawKey], the way a note line names
+     * it: the key is made to fit as it would be for a note. Null when the kind is not one
+     * of the notebook's or nothing that can be a key is left.
+     */
+    fun refOf(kindLabel: String, rawKey: String): String? {
+        val kind = Kind.fromLabel(kindLabel) ?: return null
+        val key = fitKey(rawKey) ?: return null
+        return Note(kind, key, "").storageKey
+    }
+
+    /**
+     * What came of reading a block of lines: the [notes] that were taken, and
+     * [notTaken], the lines that were meant as notes and are not among them. A line is
+     * meant as a note when it has the bar of the form in it; anything else (a word of
+     * talk, NONE, a comment) is simply not a note. Such a line is not taken when it
+     * does not fit the form after all, or when it stands past the limit.
+     *
+     * [shortened] are the notes among [notes] that this reading had to shorten. A note
+     * that came in with the mark of an earlier cut and fits as it is, is not one of them:
+     * nothing was taken from it now.
+     *
+     * [marks] are the marks she put behind notes among [notes] in a bracket ([markOf]),
+     * by storage key.
+     */
+    class Reading(
+        val notes: List<Note>,
+        val notTaken: List<String>,
+        val shortened: List<Note> = emptyList(),
+        val marks: Map<String, How> = emptyMap()
+    )
+
+    /** Reads a block of lines, keeping at most [limit] valid notes and the last one per key. */
+    fun read(text: String, limit: Int = Int.MAX_VALUE): Reading {
+        val byKey = LinkedHashMap<String, Note>()
+        val notTaken = ArrayList<String>()
+        val shortened = HashSet<String>()
+        val marks = HashMap<String, How>()
+        for (line in text.lineSequence()) {
+            val candidate = parsed(line)
+            if (candidate == null || byKey.size >= limit) {
+                val meant = line.trim()
+                if (meant.contains('|') && !meant.startsWith("#")) notTaken += meant
+                continue
+            }
+            val key = candidate.note.storageKey
+            byKey.remove(key)
+            byKey[key] = candidate.note
+            // The last line under a key is the note; whether that one was shortened is what counts.
+            if (candidate.shortened) shortened += key else shortened -= key
+            val how = candidate.how
+            if (how != null) marks[key] = how else marks -= key
+        }
+        return Reading(byKey.values.toList(), notTaken, byKey.values.filter { it.storageKey in shortened }, marks)
+    }
+
+    /**
+     * Which of [lines], lines of a pass that the notebook could not take, may be repeated
+     * to her where [leftOut] keeps notes off the page (a host could read the prompt).
+     * Such a line was meant as a note and can say as much about him as one. It is
+     * repeated only when it reads as a note that [leftOut] does not cover. A line that
+     * does not read as a note at all cannot be put to that test, and is not repeated.
+     * With nothing held back every line is.
+     */
+    fun quotable(lines: List<String>, leftOut: ((Note) -> Boolean)?): List<String> =
+        if (leftOut == null) lines else lines.filter { line -> parseLine(line)?.let { !leftOut(it) } == true }
+
+    /** Parses a block of lines, keeping at most [limit] valid notes and the last one per key. */
+    fun parse(text: String, limit: Int = Int.MAX_VALUE): List<Note> = read(text, limit).notes
+
+    /**
+     * [reading] of [content] for a reply that stopped at the model's length limit. Its
+     * last line broke off wherever the limit fell, so what was read from it is half a
+     * note. It is not kept as if it were whole: it goes among the lines that were not
+     * taken, and she is told.
+     */
+    fun withoutBrokenLine(reading: Reading, content: String): Reading {
+        val last = content.trimEnd().lineSequence().lastOrNull()?.trim().orEmpty()
+        val broken = parseLine(last) ?: return reading
+        if (broken !in reading.notes) return reading
+        return Reading(reading.notes - broken, reading.notTaken + last, reading.shortened - broken, reading.marks - broken.storageKey)
+    }
+
+    // The words by which a note speaks of him or of the two of them. Her notebook writes
+    // "he" for him; "hes" is "he's" the way she drops an apostrophe.
+    private val HIM_WORDS = Regex(
+        """(?<![\p{L}\p{N}])(?:he|hes|him|his|himself|we|us|our|ours|ourselves)(?![\p{L}\p{N}])""",
+        RegexOption.IGNORE_CASE
+    )
+
+    /** True when [text] says "he" or "we" in one of their forms, or one of the words of [ownerName]. */
+    private fun speaksOfHim(text: String, ownerName: String): Boolean {
+        if (HIM_WORDS.containsMatchIn(text)) return true
+        return ownerName.split(Regex("""[^\p{L}\p{N}]+""")).filter { it.length >= 2 }.any { word ->
+            Regex("""(?<![\p{L}\p{N}])""" + Regex.escape(word) + """(?![\p{L}\p{N}])""", RegexOption.IGNORE_CASE)
+                .containsMatchIn(text)
+        }
+    }
+
+    /**
+     * True for a note that can be about the owner. These are the notes that stay on the
+     * phone when a prompt goes to a host that could read it:
+     *
+     *  - every note of the kinds that are about him or about the two of them by the
+     *    notebook's own rules (user, rel);
+     *  - every thread and opinion that is not a street story: a thread is "yours or
+     *    between you", and nothing in its text has to say which;
+     *  - any other note (about herself, a correction, a street story) that speaks of him:
+     *    "he" or "we" in any of their forms, or his name, in its text or its key;
+     *  - what she saw on his screen, whatever kind it was given.
+     *
+     * What is left is hers alone by kind and by wording. The test is made on the phone and
+     * errs towards holding back: a street story about some other "he" stays behind too.
+     */
+    fun canBeAboutHim(note: Note, ownerName: String = ""): Boolean = when {
+        note.isSeen -> true
+        note.kind == Kind.USER || note.kind == Kind.REL -> true
+        (note.kind == Kind.THREAD || note.kind == Kind.OPINION) && !note.isStreetStory -> true
+        else -> speaksOfHim(note.key.replace('-', ' ') + " " + note.text, ownerName)
+    }
+
+    /** [canBeAboutHim] for the owner called [ownerName], as the test a page is made with. */
+    fun aboutHim(ownerName: String): (Note) -> Boolean = { canBeAboutHim(it, ownerName) }
+
+    /**
+     * [changes] that were written without sight of some of her notes, made safe to store
+     * next to [existing]. A change normally replaces the note with its key, which is how
+     * she updates one. A note she was not shown cannot be updated on purpose: a change
+     * that lands on its key by chance would wipe what she knew. Such a change is stored
+     * beside it instead, under that key with [BESIDE_SUFFIX], so nothing she wrote is lost
+     * and she can tidy the notes herself when she next sees them together.
+     *
+     * A note can be out of her sight for two reasons. This pass was not given it at all:
+     * [leftOut] is the test the page was made with ([aboutHim] where a host could read
+     * the prompt), null when nothing was left out. Or the page had no room for it:
+     * [shownKeys] are the storage keys of the notes the pass was shown
+     * ([Review.shownKeys]), and an existing note that is not among them was not on the
+     * page. Null means the whole notebook was, apart from what [leftOut] covers.
+     *
+     * Nothing written under the key of a note she was not shown ever replaces a note,
+     * neither that one nor one that an earlier pass put beside it: the line gets the
+     * first key of that family that is still free (key-unseen, key-unseen-2, and so on).
+     * Her notebook prompt tells her exactly that. What keeps the notebook from filling
+     * up with what she already has is the wording: a line that only repeats a note she
+     * has of the same kind is not stored a second time.
+     */
+    fun besideUnseen(
+        changes: List<Note>,
+        existing: List<Note>,
+        leftOut: ((Note) -> Boolean)? = null,
+        shownKeys: Set<String>? = null
+    ): List<Note> {
+        val hidden = existing.filter { leftOut?.invoke(it) == true || (shownKeys != null && it.storageKey !in shownKeys) }
+        if (leftOut == null && hidden.isEmpty()) return changes
+        val taken = existing.mapTo(HashSet()) { it.storageKey }
+        val hiddenKeys = hidden.mapTo(HashSet()) { it.storageKey }
+        val placed = LinkedHashMap<String, Note>()
+        for (change in changes) {
+            val underHiddenKey = change.storageKey in hiddenKeys
+            // With all she has of it in sight a change is stored as she wrote it.
+            if (!underHiddenKey && leftOut?.invoke(change) != true) {
+                placed[change.storageKey] = change
+                continue
+            }
+            // Written blind. A line that says again what she already has is nothing new:
+            // a note she was not shown, or any note at all when the line would go beside one.
+            val known = if (underHiddenKey) existing else hidden
+            if (known.any { it.kind == change.kind && sameWords(it.text, change.text) }) continue
+            val note = if (underHiddenKey) change.copy(key = freeBesideKey(change, taken)) else change
+            placed[note.storageKey] = note
+            taken += note.storageKey
+        }
+        return placed.values.toList()
+    }
+
+    /** Ends the key of a note that was written beside one she could not see. A number follows it from the second on. */
+    const val BESIDE_SUFFIX = "-unseen"
+
+    private val BESIDE_FORM = Regex(Regex.escape(BESIDE_SUFFIX) + """(?:-\d+)?$""")
+
+    /** The first key beside [change]'s that no note of its kind has yet, among [taken] storage keys. */
+    private fun freeBesideKey(change: Note, taken: Set<String>): String {
+        val base = BESIDE_FORM.replace(change.key, "")
+        return generateSequence(1) { it + 1 }
+            .map { number ->
+                val suffix = if (number == 1) BESIDE_SUFFIX else "$BESIDE_SUFFIX-$number"
+                base.take(MAX_KEY_CHARS - suffix.length).trimEnd('-') + suffix
+            }
+            .first { change.copy(key = it).storageKey !in taken }
+    }
+
+    private fun sameWords(a: String, b: String): Boolean =
+        a.trim().replace(Regex("""\s+"""), " ").equals(b.trim().replace(Regex("""\s+"""), " "), ignoreCase = true)
+
+    /**
+     * First line of a copied notebook that has had its start. To [parse] it is a comment.
+     * Handed over with the notes, it tells the other install that the starting notes were
+     * written into this notebook once already ([carriesStartedMark]). Without it they
+     * would be written in again on the other phone: the day-one threads she has long
+     * closed, dropped or seen taken out would be back as open ones.
+     */
+    const val STARTED_MARK = "# her notebook, already started: the starting notes are not written into it again"
+
+    /**
+     * The whole notebook as `kind | key | text` lines, oldest first: the form [parse]
+     * reads, so the lines can be handed to her again on another phone. Oldest first
+     * because lines that are handed over count as newer the further down they stand.
+     * With [started] the first line is [STARTED_MARK].
+     */
+    fun export(notesNewestFirst: List<Note>, started: Boolean = false): String {
+        val lines = notesNewestFirst.asReversed().map { it.toLine() }
+        return (if (started && lines.isNotEmpty()) listOf(STARTED_MARK) + lines else lines).joinToString("\n")
+    }
+
+    /** True when [text], lines that are being handed to her, is a notebook copied after its start. */
+    fun carriesStartedMark(text: String): Boolean = text.lineSequence().any { it.trim() == STARTED_MARK }
+
+    /** Rebuilds a note from a stored row, or null when the row is not a persona note. */
+    fun fromStorage(storageKey: String, value: String): Note? {
+        if (!storageKey.startsWith(KEY_PREFIX)) return null
+        val rest = storageKey.removePrefix(KEY_PREFIX)
+        val kind = Kind.fromLabel(rest.substringBefore('.')) ?: return null
+        val key = rest.substringAfter('.', "")
+        if (key.isEmpty()) return null
+        return Note(kind, key, value)
+    }
+
+    /** The headings of her chat prompt, in the order they are shown. */
+    private enum class Section(val heading: String) {
+        FIX("What he corrected or called fake (the detail as it is now, or the line and what was off: examples, not a ban list):"),
+        REL("Where you two stand:"),
+        ME("Who you are now (your own call, newer than your files; you change it when you change):"),
+        USER("What you know about him:"),
+        SEEN("Things you saw (seen, not told):"),
+        THREAD("Still going on:"),
+        CLOSED("Over, and you remember how it went:"),
+        OPINION("What you think now:")
+    }
+
+    /** The sections whose notes a page shows with their age. */
+    private val DATED_SECTIONS = setOf(Section.THREAD, Section.SEEN, Section.ME, Section.OPINION)
+
+    /**
+     * Notes about who she is now: what she has settled about herself and what she thinks.
+     * A page she can change them on always has them first ([review], [renderKeyed]), so a
+     * view she changes is written over the old one and not beside it.
+     */
+    fun isPresentSelf(note: Note): Boolean = note.kind == Kind.ME || note.kind == Kind.OPINION
+
+    /** How much of a page her present-self notes may take before the rest of the notebook is picked. */
+    const val PRESENT_SELF_CHARS = 4000
+
+    private fun sectionOf(note: Note): Section = when {
+        note.isSeen -> Section.SEEN
+        note.isClosedThread -> Section.CLOSED
+        else -> when (note.kind) {
+            Kind.FIX -> Section.FIX
+            Kind.REL -> Section.REL
+            Kind.ME -> Section.ME
+            Kind.USER -> Section.USER
+            Kind.THREAD -> Section.THREAD
+            Kind.OPINION -> Section.OPINION
+        }
+    }
+
+    /** What one note costs of the budget: its text, the dash in front and the line break. */
+    private fun cost(note: Note): Int = note.text.length + 3
+
+    /**
+     * What brings a note back onto a page that had no room for it: the words of what is
+     * being said ([cues], as [PersonaLibraryText.terms] gives them), and whose turn it is
+     * ([turn], a number that goes up by one every [TURN_MILLIS]).
+     *
+     * The notes that are never taken out of the notebook grow without end and the page
+     * does not. Picked by age alone, the first things he told her would leave the page
+     * one day and never be read by her again. With this, a note the talk touches is put
+     * on the page whatever its age, and every other note that has no place comes round
+     * in its turn, so nothing she keeps is out of her sight for good.
+     */
+    class Recall(val cues: Set<String>, val turn: Long) {
+        companion object {
+            /** For a page made at [nowMillis] while [said] is being talked about. */
+            fun of(said: List<String>, nowMillis: Long): Recall =
+                Recall(said.flatMapTo(HashSet()) { PersonaLibraryText.terms(it) }, nowMillis / TURN_MILLIS)
+        }
+    }
+
+    /**
+     * When each note was written ([writtenAt], by storage key) and what time it is now.
+     * With it a page says how old an open thread and a thing she saw are: both say how
+     * something stood at a moment, and without the age "tomorrow" would stay tomorrow.
+     */
+    class Times(val writtenAt: Map<String, Long>, val nowMillis: Long)
+
+    /**
+     * Where her notes came from, as far as the phone knows it: the words her files give
+     * her starting notes ([starting], by storage key: this build's and every earlier
+     * wording), and her own marks of how she knows a note ([how]). A note that still has
+     * the words of her files is something her files told her, not something she lived or
+     * he said; a page says so beside it, so that she does not take a starting note for a
+     * memory. A note she rewrote is hers, whatever it says.
+     */
+    class Origins(val starting: Map<String, Set<String>>, val how: Map<String, How> = emptyMap()) {
+        /** True when [note] still has the words her files gave it. */
+        fun fromFiles(note: Note): Boolean = note.text in starting[note.storageKey].orEmpty()
+
+        companion object {
+            /** From her starting notes ([seed]), their earlier wordings ([earlier]) and her marks. */
+            fun of(seed: List<Note>, earlier: List<Note>, how: Map<String, How> = emptyMap()): Origins =
+                Origins((seed + earlier).groupBy({ it.storageKey }, { it.text }).mapValues { it.value.toSet() }, how)
+        }
+    }
+
+    /**
+     * [note] as a page shows it: its text, and behind it in one bracket what the page
+     * knows of it.
+     *
+     * Its age, where [times] is given and the note is one that dates. Who she is and what
+     * she thinks date too: she changes, and how old a view of hers is says how long she
+     * has held it. With [allDated] every note says how old it is: the page of her sleep,
+     * where she goes over all of them.
+     *
+     * With [origins], a starting note that still has the words of her files says
+     * "from your files" ([FROM_FILES]), whatever its kind. Its age is then left out, but
+     * with [allDated]: the day the app wrote it in says nothing about when it was true.
+     * With [withHow] her mark of how she knows the note is shown too: on a page that has
+     * no list of her marks of its own (her reply and a moment of hers).
+     */
+    private fun shownText(
+        note: Note,
+        times: Times?,
+        allDated: Boolean = false,
+        origins: Origins? = null,
+        withHow: Boolean = false
+    ): String {
+        val fromFiles = origins?.fromFiles(note) == true
+        val at = times?.writtenAt?.get(note.storageKey)
+        val tags = buildList {
+            if (times != null && at != null && (allDated || (sectionOf(note) in DATED_SECTIONS && !fromFiles))) {
+                add("written " + PersonaPrompts.age(times.nowMillis - at))
+            }
+            if (fromFiles) add(FROM_FILES)
+            if (withHow) origins?.how?.get(note.storageKey)?.let { add(it.label) }
+        }
+        return if (tags.isEmpty()) note.text else note.text + " (" + tags.joinToString(", ") + ")"
+    }
+
+    /**
+     * The notes that got a place, in the order they were given, and how many did not.
+     * [outOfRoom] says the page was too small for the notebook, and [recalls] that the
+     * notes without a place are brought back by [Recall].
+     */
+    private class Selection(val kept: List<Note>, val notShown: Int, val outOfRoom: Boolean, val recalls: Boolean)
+
+    /** Which notes got a place by age, what room is left, and whether a note went without one for lack of room. */
+    private class ByAge(val keep: BooleanArray, val left: Int, val outOfRoom: Boolean)
+
+    /**
+     * Which of [notes] (newest first) get a place within [maxChars], by age alone.
+     *
+     * What he corrected comes first, because a correction that does not stick has to be
+     * made twice, but it gets a third of the room at most: a dozen corrections must not
+     * push out everything else she knows. Then everything else, newest first. Corrections
+     * that did not fit into their third come after that, and closed threads last, at most
+     * [closedShown] of them: when room runs out it is how a street story ended that goes,
+     * before anything about him or about the two of them.
+     *
+     * Each of these stops at the first note that does not fit, and nothing after it is
+     * given a place, so a note that is not shown is always older than the ones of its
+     * group that are.
+     */
+    private fun byAge(notes: List<Note>, sections: List<Section>, maxChars: Int, closedShown: Int): ByAge {
+        val keep = BooleanArray(notes.size)
+        var left = maxChars
+        var full = false
+        fun place(index: Int): Boolean {
+            val needed = cost(notes[index])
+            if (full || needed > left) {
+                full = true
+                return false
+            }
+            left -= needed
+            keep[index] = true
+            return true
+        }
+
+        var forCorrections = maxChars / 3
+        for (index in notes.indices) {
+            if (sections[index] != Section.FIX) continue
+            val needed = cost(notes[index])
+            if (needed > forCorrections || !place(index)) break
+            forCorrections -= needed
+        }
+        for (index in notes.indices) {
+            if (sections[index] == Section.FIX || sections[index] == Section.CLOSED) continue
+            if (!place(index)) break
+        }
+        for (index in notes.indices) {
+            if (sections[index] != Section.FIX || keep[index]) continue
+            if (!place(index)) break
+        }
+        var closed = 0
+        for (index in notes.indices) {
+            if (sections[index] != Section.CLOSED) continue
+            if (closed >= closedShown || !place(index)) break
+            closed++
+        }
+        return ByAge(keep, left, full)
+    }
+
+    /**
+     * Which of [notes] (newest first) get a place within [maxChars].
+     *
+     * Without [recall] that is decided by age alone ([byAge]). With it, and a notebook
+     * that is longer than the page, a quarter of the page is kept free for the notes the
+     * rest had no room for. Those that fit what is being said come first, the best fit
+     * first. What is then left of the room goes to the others in turns: oldest first
+     * they are cut into groups that each fit the quarter, and each turn shows the next
+     * group. The groups depend on the notebook alone, not on what is being said, so the
+     * turns come round in the same order and no note is left out of them. Threads that
+     * are over do not take turns: they are the notes that may be taken out of the
+     * notebook, and one comes back only when the talk touches it.
+     */
+    private fun select(notes: List<Note>, maxChars: Int, closedShown: Int, recall: Recall? = null): Selection {
+        val sections = notes.map(::sectionOf)
+        val whole = byAge(notes, sections, maxChars, closedShown)
+        fun selection(keep: BooleanArray): Selection {
+            val kept = notes.filterIndexed { index, _ -> keep[index] }
+            return Selection(kept, notes.size - kept.size, whole.outOfRoom, recall != null)
+        }
+        if (recall == null || whole.keep.all { it }) return selection(whole.keep)
+
+        val share = maxChars / RECALL_SHARE
+        val placed = if (whole.outOfRoom) byAge(notes, sections, maxChars - share, closedShown) else whole
+        val keep = placed.keep
+        var left = placed.left + if (whole.outOfRoom) share else 0
+        fun place(index: Int) {
+            val needed = cost(notes[index])
+            if (keep[index] || needed > left) return
+            keep[index] = true
+            left -= needed
+        }
+
+        // Whose turn it is, worked out before the talk puts anything on the page.
+        val inTurn: List<Int> = if (whole.outOfRoom) {
+            val groups = ArrayList<MutableList<Int>>()
+            var used = 0
+            for (index in notes.indices.reversed()) {
+                if (keep[index] || sections[index] == Section.CLOSED) continue
+                val needed = cost(notes[index])
+                if (groups.isEmpty() || used + needed > share) {
+                    groups += ArrayList<Int>()
+                    used = 0
+                }
+                groups.last() += index
+                used += needed
+            }
+            if (groups.isEmpty()) emptyList() else groups[Math.floorMod(recall.turn, groups.size.toLong()).toInt()]
+        } else {
+            emptyList()
+        }
+
+        // What the talk touches, the best fit first and the newer of two equal fits first.
+        notes.indices.filterNot { keep[it] }
+            .map { index ->
+                val words = PersonaLibraryText.terms(notes[index].key.replace('-', ' ') + " " + notes[index].text)
+                index to words.count { it in recall.cues }
+            }
+            .filter { it.second > 0 }
+            .sortedWith(compareByDescending<Pair<Int, Int>> { it.second }.thenBy { it.first })
+            .forEach { place(it.first) }
+        inTurn.forEach(::place)
+        return selection(keep)
+    }
+
+    /** The one line that says some of her notes are not on the page, or null when all of them are. */
+    private fun notShownLine(selection: Selection): String? {
+        val count = selection.notShown
+        val notes = if (count == 1) "1 more note of yours is" else "$count more notes of yours are"
+        return when {
+            count <= 0 -> null
+            // Picked by age alone: what is missing is older than what is there.
+            !selection.recalls -> if (count == 1) "(1 older note of yours is not shown here)" else "($count older notes of yours are not shown here)"
+            selection.outOfRoom ->
+                "($notes not on this page: it has no room for all of them. A note that fits what is being said " +
+                    "is put on it first. The others take turns on it, except threads that are over.)"
+            // Room was not the reason: only the newest few threads that are over are shown.
+            else ->
+                "($notes not on this page: threads that are over, older than the ones shown. " +
+                    "One is put back on it when what is being said fits it.)"
+        }
+    }
+
+    /**
+     * The block that goes into the chat prompt, grouped under headings. [notes] is
+     * expected newest first. At most [maxChars] characters of notes are shown (see
+     * [select] for which ones), and when some did not fit the block ends with a line that
+     * says how many and what brings them back, so that she never takes a part of her
+     * notebook for all of it. A note [leaveOut] covers is not rendered; it stays in the
+     * notebook untouched ([aboutHim] is the test where a host could read the prompt).
+     * With [origins] a note says where it came from, and her mark of how she knows it
+     * ([shownText]).
+     */
+    fun render(
+        notes: List<Note>,
+        maxChars: Int = PROMPT_BUDGET_CHARS,
+        leaveOut: ((Note) -> Boolean)? = null,
+        recall: Recall? = null,
+        times: Times? = null,
+        origins: Origins? = null
+    ): String {
+        val shown = if (leaveOut == null) notes else notes.filterNot(leaveOut)
+        if (shown.isEmpty()) return ""
+        val selection = select(shown, maxChars, CLOSED_THREADS_SHOWN, recall)
+        val bySection = selection.kept.groupBy(::sectionOf)
+        val blocks = Section.entries.mapNotNull { section ->
+            bySection[section]?.let { group ->
+                section.heading + "\n" + group.joinToString("\n") { "- ${shownText(it, times, origins = origins, withHow = true)}" }
+            }
+        }
+        return (blocks + listOfNotNull(notShownLine(selection))).joinToString("\n")
+    }
+
+    /**
+     * What a notebook pass is given to read: [text], and the storage keys of the notes
+     * that are in it. A note that is not among [shownKeys] was not on the page, so a line
+     * the pass writes under its key was written without sight of it ([besideUnseen]).
+     */
+    class Review(val text: String, val shownKeys: Set<String>)
+
+    /**
+     * The same notes as plain `kind | key | text` lines, for the notebook pass to read,
+     * closed threads included. It has the same room as [render] and is picked the same
+     * way, with [recall] made from the talk the pass reads: a note that talk touches is
+     * on the page, so she can bring it up to date instead of writing beside it. It ends
+     * with the same line when some did not fit. A note [leaveOut] covers is not shown.
+     * With [allDated] every note on it says how old it is, not only those that date.
+     * With [origins] a starting note in the words of her files says so; her marks are
+     * not shown beside the notes here, because the passes that read this page list them
+     * apart.
+     */
+    fun review(
+        notes: List<Note>,
+        maxChars: Int = PROMPT_BUDGET_CHARS,
+        leaveOut: ((Note) -> Boolean)? = null,
+        recall: Recall? = null,
+        times: Times? = null,
+        allDated: Boolean = false,
+        origins: Origins? = null
+    ): Review {
+        val shown = if (leaveOut == null) notes else notes.filterNot(leaveOut)
+        if (shown.isEmpty()) return Review("", emptySet())
+        // Who she is now comes first, newest first, so that she can always change it.
+        val self = presentSelfFirst(shown, maxChars)
+        val selection = select(shown - self.toSet(), maxChars - self.sumOf(::cost), closedShown = Int.MAX_VALUE, recall = recall)
+        val kept = self + selection.kept
+        val lines = kept.map { "${it.kind.label} | ${it.key} | ${shownText(it, times, allDated, origins)}" }
+        return Review(
+            text = (lines + listOfNotNull(notShownLine(selection))).joinToString("\n"),
+            shownKeys = kept.mapTo(HashSet()) { it.storageKey }
+        )
+    }
+
+    /**
+     * Her present-self notes, newest first, as many as fit into [PRESENT_SELF_CHARS], and
+     * never more than the page itself has room for ([maxChars]).
+     */
+    private fun presentSelfFirst(notes: List<Note>, maxChars: Int): List<Note> {
+        var left = minOf(PRESENT_SELF_CHARS, maxChars)
+        return notes.filter(::isPresentSelf).filter { note ->
+            val needed = cost(note)
+            (needed <= left).also { if (it) left -= needed }
+        }
+    }
+
+    /**
+     * [render] with each note's kind and key in front, for a moment of her own: a `note:`
+     * line under a key shown here replaces that note, which is how she changes her mind
+     * there. Her present-self notes come first, as on the notebook's own page. The keys
+     * it shows are given back, so a line under any other key goes beside ([besideUnseen]).
+     * With [origins] a note says where it came from and how she knows it, as in [render].
+     */
+    fun renderKeyed(
+        notes: List<Note>,
+        maxChars: Int = PROMPT_BUDGET_CHARS,
+        leaveOut: ((Note) -> Boolean)? = null,
+        recall: Recall? = null,
+        times: Times? = null,
+        origins: Origins? = null
+    ): Review {
+        val shown = if (leaveOut == null) notes else notes.filterNot(leaveOut)
+        if (shown.isEmpty()) return Review("", emptySet())
+        val self = presentSelfFirst(shown, maxChars)
+        val selection = select(shown - self.toSet(), maxChars - self.sumOf(::cost), CLOSED_THREADS_SHOWN, recall)
+        val kept = self + selection.kept
+        val bySection = kept.groupBy(::sectionOf)
+        val blocks = Section.entries.mapNotNull { section ->
+            bySection[section]?.let { group ->
+                section.heading + "\n" + group.joinToString("\n") {
+                    "- ${it.kind.label} | ${it.key} | ${shownText(it, times, origins = origins, withHow = true)}"
+                }
+            }
+        }
+        return Review(
+            text = (blocks + listOfNotNull(notShownLine(selection))).joinToString("\n"),
+            shownKeys = kept.mapTo(HashSet()) { it.storageKey }
+        )
+    }
+
+    /** The text of [review] alone. */
+    fun renderForReview(notes: List<Note>, maxChars: Int = PROMPT_BUDGET_CHARS, leaveOut: ((Note) -> Boolean)? = null): String =
+        review(notes, maxChars, leaveOut).text
+}
