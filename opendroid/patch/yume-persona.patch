+            memoryRepository.saveMemory(Memory("yume.meta.archive.opinion.view-$it.$it", "{\"t\":\"view $it\",\"w\":$it,\"a\":$it,\"why\":\"faded\"}", MemoryType.SEMANTIC, it.toLong()))
+        }
+
+        assertEquals(listOf(Note(Kind.ME, "soda", "melon soda is mine")), personaMemory.notes())
+        assertEquals(setOf("yume.me.soda"), personaMemory.writtenAt().keys)
+        assertEquals(1000, personaMemory.archiveCount())
+        assertEquals(10, personaMemory.archivedLately(10).size)
+        assertEquals("view 1000", personaMemory.archivedLately(1).single().note.text)
+    }
+
+    @Test
+    fun `how she feels and her marks are changed one change at a time, and a mark of a note she no longer has is dropped`() = runBlocking {
+        personaMemory.apply(listOf(Note(Kind.ME, "hair", "red"), Note(Kind.USER, "bees", "he keeps bees")))
+        kotlinx.coroutines.coroutineScope {
+            (1..20).map { index ->
+                launch(kotlinx.coroutines.Dispatchers.Default) {
+                    personaMemory.updateMood { it + PersonaMood.Feeling("feeling $index", 2, 1_000, PersonaMood.Speed.DAYS) }
+                }
+            }.joinAll()
+        }
+        assertEquals(20, personaMemory.mood().size)
+
+        personaMemory.updateHow { mapOf("yume.me.hair" to PersonaNotes.How.LIVED, "yume.user.bees" to PersonaNotes.How.TOLD) }
+        personaMemory.fade(listOf("yume.user.bees"))
+        personaMemory.updateHow { it + ("yume.me.hair" to PersonaNotes.How.UNSURE) }
+        assertEquals(mapOf("yume.me.hair" to PersonaNotes.How.UNSURE), personaMemory.how())
+        // A mark for a key that has no note is never kept.
+        personaMemory.updateHow { it + ("yume.me.nothing" to PersonaNotes.How.TOLD) }
+        assertEquals(setOf("yume.me.hair"), personaMemory.how().keys)
+        // None of it is a note, or listed, or copied out.
+        assertEquals(setOf("hair", "bees").minus("bees"), personaMemory.notes().map { it.key }.toSet())
+        assertTrue(memoryRepository.listedMemories.first().none { it.key.startsWith(PersonaNotes.KEY_PREFIX) })
+        assertFalse(PersonaNotes.export(personaMemory.notes(), started = true).contains("feeling"))
+    }
+
+    /** The stored profile; none unless a test sets one. */
+    private var profile: UserProfile? = null
+
+    private val profileStore = object : UserProfileStore {
+        override fun read(): ProfileStoreResult<UserProfile?> = ProfileStoreResult.Success(profile)
+        override fun write(profile: UserProfile): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun migrateLegacyProfile(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+        override fun resetForReentry(): ProfileStoreResult<Unit> = ProfileStoreResult.Success(Unit)
+    }
+
+    private object NoSensitiveMemory : SensitiveMemoryStore {
+        override fun read(key: String): String? = null
+        override fun write(key: String, value: String): Boolean = true
+        override fun remove(key: String): Boolean = false
+        override fun listKeys(): Set<String> = emptySet()
+        override fun getAllDecrypted(): Map<String, String> = emptyMap()
+        override fun clearAll(): Boolean = true
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaMoodTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaMoodTest.kt
new file mode 100644
index 0000000..8f526a9
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaMoodTest.kt
@@ -0,0 +1,169 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaMood.Feeling
+import com.opendroid.ai.core.persona.PersonaMood.Felt
+import com.opendroid.ai.core.persona.PersonaMood.Speed
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * How she feels, carried over: the feel lines she writes, how each feeling fades at the
+ * pace she gave it, and how her prompt says it, in words and never as a number.
+ */
+class PersonaMoodTest {
+
+    private val minute = 60_000L
+    private val hour = 60 * minute
+    private val day = 24 * hour
+    private val now = 1_800_000_000_000L
+
+    @Test
+    fun `a feel line is her words, how strong and how fast it fades, with some and days when left out`() {
+        assertEquals(Felt("pissed at him", PersonaMood.STRONG, Speed.HOURS), PersonaMood.parse("feel | pissed at him | strong | hours"))
+        assertEquals(Felt("restless"), PersonaMood.parse("feel: restless"))
+        assertEquals(Felt("restless", PersonaMood.SOME, Speed.DAYS), PersonaMood.parse("feel: restless"))
+        // Either order, singular or plural, any case, behind a list dash.
+        assertEquals(Felt("bored stiff", PersonaMood.FAINT, Speed.WEEKS), PersonaMood.parse("- Feel | Bored  Stiff | week | faint."))
+        assertEquals(Felt("smug", PersonaMood.STRONG, Speed.DAYS), PersonaMood.parse("feel: smug | strong"))
+        assertEquals(Felt("fond of the rain", PersonaMood.SOME, Speed.WEEKS), PersonaMood.parse("feel | fond of the rain | weeks"))
+        assertEquals(Felt("pissed at him", gone = true), PersonaMood.parse("feel | pissed at him | gone"))
+        assertEquals(Felt("x".repeat(40)), PersonaMood.parse("feel: " + "x".repeat(40)))
+    }
+
+    @Test
+    fun `a line without that form is no feeling`() {
+        for (line in listOf(
+            "feel |  | strong", "feel | x | very", "feel | x | strong | strong", "feel | x | hours | days",
+            "feel | " + "x".repeat(41), "feel | x === y | strong", "feel | x | gone | days", "feeling | x",
+            "me | feel | x", "feel | x | strong | hours | more", "feel: ...", "i feel | restless", "feel"
+        )) {
+            assertNull(line, PersonaMood.parse(line))
+        }
+    }
+
+    @Test
+    fun `feel lines are taken off before notes are read, and what is not taken stays where the notebook tells her of it`() {
+        val text = "me | rain | i like rain\nfeel | restless\nfeel: smug | strong\nfeel | bored | some\nfeel | sad | gone\nfeel | odd | very\nNONE"
+        val read = PersonaMood.read(text, limit = 3)
+        assertEquals(listOf(Felt("restless"), Felt("smug", PersonaMood.STRONG), Felt("bored")), read.felt)
+        assertEquals("me | rain | i like rain\nfeel | sad | gone\nfeel | odd | very\nNONE", read.rest)
+        assertEquals(read.rest, PersonaMood.withoutFeelings(text))
+        // The notebook does not take what is left as a note, and says so.
+        val notes = PersonaNotes.read(read.rest, limit = PersonaNotes.LINES_PER_PASS)
+        assertEquals(listOf("rain"), notes.notes.map { it.key })
+        assertEquals(listOf("feel | sad | gone", "feel | odd | very"), notes.notTaken)
+        // A last line the length limit broke off is not acted on.
+        val cut = PersonaMood.read("feel | restless\nfeel | pissed at him | str", limit = 3, cutOff = true)
+        assertEquals(listOf(Felt("restless")), cut.felt)
+        assertEquals("feel | pissed at him | str", cut.rest)
+    }
+
+    private fun word(strength: Int, speed: Speed, age: Long): String? =
+        PersonaMood.word(PersonaMood.level(Feeling("x", strength, now - age, speed), now))
+
+    @Test
+    fun `a fast feeling is strong for an hour or so and gone after a night, a slow one lasts weeks`() {
+        // Hours: anger she feels fast and drops fast.
+        assertEquals("strong", word(PersonaMood.STRONG, Speed.HOURS, 0))
+        assertEquals("strong", word(PersonaMood.STRONG, Speed.HOURS, hour))
+        assertEquals("some", word(PersonaMood.STRONG, Speed.HOURS, 3 * hour))
+        assertEquals("faint", word(PersonaMood.STRONG, Speed.HOURS, 8 * hour))
+        assertNull(word(PersonaMood.STRONG, Speed.HOURS, 11 * hour))
+        // Days.
+        assertEquals("some", word(PersonaMood.STRONG, Speed.DAYS, day))
+        assertEquals("faint", word(PersonaMood.SOME, Speed.DAYS, 3 * day))
+        assertNull(word(PersonaMood.SOME, Speed.DAYS, 5 * day))
+        // Weeks: fondness is still some after two weeks and gone after about five.
+        assertEquals("some", word(PersonaMood.STRONG, Speed.WEEKS, 14 * day))
+        assertEquals("faint", word(PersonaMood.STRONG, Speed.WEEKS, 30 * day))
+        assertNull(word(PersonaMood.STRONG, Speed.WEEKS, 40 * day))
+        assertEquals(4 * hour, Speed.HOURS.halfLifeMillis)
+        assertEquals(2 * day, Speed.DAYS.halfLifeMillis)
+        assertEquals(14 * day, Speed.WEEKS.halfLifeMillis)
+        // A time in the future (a clock that was set back) is no older than now.
+        assertEquals("strong", word(PersonaMood.STRONG, Speed.HOURS, -hour))
+    }
+
+    @Test
+    fun `the same words replace a feeling with a new time, gone lets it go, and the strongest eight are kept`() {
+        val old = listOf(
+            Feeling("pissed at him", PersonaMood.STRONG, now - 9 * hour, Speed.HOURS),
+            Feeling("restless", PersonaMood.SOME, now - hour, Speed.DAYS),
+            Feeling("over it", PersonaMood.FAINT, now - 10 * day, Speed.DAYS)
+        )
+        val merged = PersonaMood.merge(old, listOf(Felt("pissed at him", PersonaMood.SOME, Speed.HOURS), Felt("restless", gone = true)), now)
+        assertEquals(listOf(Feeling("pissed at him", PersonaMood.SOME, now, Speed.HOURS)), merged)
+        // Faded below faint: dropped at the next write.
+        assertTrue(PersonaMood.merge(old.takeLast(1), emptyList(), now).isEmpty())
+
+        val many = (1..10).map { Felt("feeling $it", if (it <= 3) PersonaMood.STRONG else PersonaMood.FAINT) }
+        val kept = PersonaMood.merge(emptyList(), many, now)
+        assertEquals(PersonaMood.MAX_KEPT, kept.size)
+        assertEquals(8, PersonaMood.MAX_KEPT)
+        assertTrue(kept.take(3).all { it.strength == PersonaMood.STRONG })
+    }
+
+    @Test
+    fun `her prompt says each feeling in words, how strong it is now and how fast it fades`() {
+        val feelings = listOf(
+            Feeling("pissed at him", PersonaMood.STRONG, now - 5 * hour, Speed.HOURS),
+            Feeling("fond of the rain", PersonaMood.STRONG, now - day, Speed.WEEKS),
+            Feeling("restless", PersonaMood.SOME, now, Speed.DAYS)
+        )
+        val block = PersonaMood.block(feelings, now)
+        assertEquals(
+            listOf(
+                PersonaMood.HEADING,
+                "- fond of the rain: strong yesterday, strong now (fades over weeks)",
+                "- restless: some just now, some now (fades over days)",
+                "- pissed at him: strong 5 h ago, faint now (fades within hours)",
+                PersonaMood.WHERE_SET
+            ),
+            block.lines()
+        )
+        assertTrue(PersonaMood.HEADING.startsWith("=== HOW YOU FEEL (carried over from before, from your own feel lines."))
+        assertTrue(PersonaMood.HEADING.endsWith("how it shows, if it shows, is yours) ==="))
+        assertEquals("you set them with a feel line in a moment of your own, your notebook pass or your sleep.", PersonaMood.WHERE_SET)
+        // No scale, meter or number for how strong.
+        for (never in listOf("/10", "level", "score", "%")) assertFalse(never, block.contains(never))
+        // Nothing kept, nothing said.
+        assertEquals("", PersonaMood.block(emptyList(), now))
+        assertEquals("", PersonaMood.block(listOf(Feeling("gone by now", PersonaMood.FAINT, now - 30 * day, Speed.HOURS)), now))
+    }
+
+    @Test
+    fun `where a host could read the prompt a feeling that can be about him stays on the phone, and she is told how many`() {
+        val feelings = listOf(
+            Feeling("pissed at him", PersonaMood.STRONG, now, Speed.HOURS),
+            Feeling("missing us", PersonaMood.SOME, now, Speed.WEEKS),
+            Feeling("sam is a pain", PersonaMood.SOME, now, Speed.DAYS),
+            Feeling("restless", PersonaMood.SOME, now, Speed.DAYS)
+        )
+        val block = PersonaMood.block(feelings, now, leaveOut = PersonaMood.aboutHim("Sam"))
+        assertTrue(block, block.contains("- restless: some just now"))
+        for (held in listOf("pissed", "missing", "pain")) assertFalse(held, block.contains(held))
+        assertTrue(block, block.contains("(3 more are not shown: they can be about him, and this goes through a hosted service that can read what it is sent. they are still on the phone.)"))
+        val page = PersonaMood.pageLines(feelings.take(1), now, leaveOut = PersonaMood.aboutHim("Sam"))
+        assertEquals(listOf(PersonaMood.heldBackLine(1)), page)
+        assertTrue(PersonaMood.heldBackLine(1)!!.startsWith("(1 more is not shown: it can be about him"))
+    }
+
+    @Test
+    fun `what is stored comes back as it was, and what cannot be read is no feeling`() {
+        val feelings = listOf(
+            Feeling("pissed at him", PersonaMood.STRONG, now, Speed.HOURS),
+            Feeling("fond of the rain", PersonaMood.FAINT, now - day, Speed.WEEKS)
+        )
+        assertEquals(feelings, PersonaMood.decode(PersonaMood.encode(feelings)))
+        for (broken in listOf(null, "", "{", "[{\"w\":1}]", "not json")) assertTrue("$broken", PersonaMood.decode(broken).isEmpty())
+        // An entry this build cannot read is left out; the others stay.
+        val mixed = """[{"w":"restless","s":2,"a":$now,"v":"DAYS"},{"w":"odd","s":2,"a":$now,"v":"MONTHS"},{"w":"x === y","s":2,"a":$now,"v":"DAYS"},{"w":"loud","s":9,"a":$now,"v":"HOURS"}]"""
+        assertEquals(
+            listOf(Feeling("restless", 2, now, Speed.DAYS), Feeling("loud", PersonaMood.STRONG, now, Speed.HOURS)),
+            PersonaMood.decode(mixed)
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt
new file mode 100644
