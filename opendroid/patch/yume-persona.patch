+    private val JSON = Json { ignoreUnknownKeys = true }
+    private const val WAKE_WHEN_HE_WRITES = "writes"
+    private const val WAKE_AT = "at"
+
+    /** [state] as the one line of text that is stored. */
+    fun encode(state: State): String = JSON.encodeToString(
+        Record.serializer(),
+        Record(
+            on = state.on,
+            wake = when (state.wake) {
+                is Wake.At -> WAKE_AT
+                Wake.WhenHeWrites -> WAKE_WHEN_HE_WRITES
+                Wake.Unset -> ""
+            },
+            wakeAt = (state.wake as? Wake.At)?.atMillis ?: 0,
+            why = state.why.name,
+            moments = state.moments,
+            gap = state.lastGapMillis,
+            lastAt = state.lastAtMillis,
+            lastDid = state.lastDid?.name.orEmpty(),
+            lastCommand = state.lastHadCommand,
+            moved = state.moved?.name.orEmpty(),
+            movedAsked = state.movedAsked,
+            failures = state.failures,
+            asleepSince = state.asleepSince,
+            sleepUntil = state.sleepUntil,
+            sleepMeant = state.sleepMeantMillis,
+            sleepAsked = state.sleepAsked,
+            sleepMoved = state.sleepMoved?.name.orEmpty(),
+            repairDueAt = state.repairDueAt,
+            repairTries = state.repairTries,
+            repairOwed = state.repairOwed,
+            repairMissed = state.repairMissed,
+            lastRepairOkAt = state.lastRepairOkAt,
+            lastRepair = state.lastRepair?.let(::record),
+            lastWokeAt = state.lastWokeAt,
+            wokeBy = state.wokeBy?.name.orEmpty(),
+            lastSlept = state.lastSleptMillis,
+            lastMeant = state.lastMeantMillis,
+            sleepSpan = state.lastSleepSpanMillis,
+            fromAt = state.broughtFromAt,
+            fromWhy = state.broughtFromWhy?.name.orEmpty(),
+            outing = state.lastOuting?.let {
+                OutingRecord(
+                    it.kind, it.words, it.startedAt, it.endedAt, it.minutes, it.steps, it.opened, it.searches,
+                    it.titles, it.ended, it.said, it.looked, it.camera, it.unseen, it.untoldDrops, it.metKid
+                )
+            },
+            goMissed = state.goMissed?.words.orEmpty(),
+            goMissedWhy = state.goMissed?.why.orEmpty(),
+            kidNotKept = state.kidNotKept
+        )
+    )
+
+    /** The state a stored line stands for. A line that is missing or cannot be read is the state of a fresh start. */
+    fun decode(stored: String?): State {
+        val record = try {
+            JSON.decodeFromString(Record.serializer(), stored?.takeIf { it.isNotBlank() } ?: return State())
+        } catch (e: Exception) {
+            return State()
+        }
+        return State(
+            on = record.on,
+            wake = when (record.wake) {
+                WAKE_AT -> Wake.At(record.wakeAt)
+                WAKE_WHEN_HE_WRITES -> Wake.WhenHeWrites
+                else -> Wake.Unset
+            },
+            why = Why.entries.firstOrNull { it.name == record.why } ?: Why.FIRST,
+            moments = record.moments.sorted(),
+            lastGapMillis = record.gap.coerceAtLeast(0),
+            lastAtMillis = record.lastAt,
+            lastDid = Did.entries.firstOrNull { it.name == record.lastDid },
+            lastHadCommand = record.lastCommand,
+            moved = Moved.entries.firstOrNull { it.name == record.moved },
+            movedAsked = record.movedAsked,
+            failures = record.failures.coerceAtLeast(0),
+            asleepSince = record.asleepSince.coerceAtLeast(0),
+            sleepUntil = record.sleepUntil.coerceAtLeast(0),
+            sleepMeantMillis = record.sleepMeant.coerceAtLeast(0),
+            sleepAsked = record.sleepAsked,
+            sleepMoved = PersonaSleep.SleepMoved.entries.firstOrNull { it.name == record.sleepMoved },
+            repairDueAt = record.repairDueAt.coerceAtLeast(0),
+            repairTries = record.repairTries.coerceAtLeast(0),
+            repairOwed = record.repairOwed,
+            repairMissed = record.repairMissed.coerceAtLeast(0),
+            lastRepairOkAt = record.lastRepairOkAt.coerceAtLeast(0),
+            lastRepair = record.lastRepair?.let(::repair),
+            lastWokeAt = record.lastWokeAt.coerceAtLeast(0),
+            wokeBy = PersonaSleep.WokeBy.entries.firstOrNull { it.name == record.wokeBy },
+            lastSleptMillis = record.lastSlept.coerceAtLeast(0),
+            lastMeantMillis = record.lastMeant.coerceAtLeast(0),
+            lastSleepSpanMillis = record.sleepSpan.coerceAtLeast(0),
+            broughtFromAt = record.fromAt.coerceAtLeast(0),
+            broughtFromWhy = Why.entries.firstOrNull { it.name == record.fromWhy },
+            lastOuting = record.outing?.takeIf { it.endedAt > 0 }?.let {
+                LastOuting(
+                    kind = it.kind, words = it.words, startedAt = it.startedAt, endedAt = it.endedAt,
+                    minutes = it.minutes.coerceAtLeast(0), steps = it.steps.coerceAtLeast(0),
+                    opened = it.opened.coerceAtLeast(0), searches = it.searches.coerceAtLeast(0),
+                    titles = it.titles.take(MAX_OUTING_TITLES), ended = it.ended, said = it.said,
+                    looked = it.looked.coerceAtLeast(0), camera = it.camera, unseen = it.unseen,
+                    untoldDrops = it.untoldDrops.coerceAtLeast(0), metKid = it.metKid
+                )
+            },
+            goMissed = record.goMissedWhy.takeIf { it.isNotBlank() }?.let { GoMissed(record.goMissed, it) },
+            kidNotKept = record.kidNotKept.coerceAtLeast(0)
+        )
+    }
+
+    // ── When she is woken next ───────────────────────────────────────────────────────
+
+    /** What a wish comes to: the time to store, why, the gap she chose if she chose one, and whether it was moved. */
+    data class Planned(val wake: Wake, val why: Why, val chosenGapMillis: Long?, val moved: Moved?)
+
+    /** The gap that applies when she names no time: the last one she chose, else an hour, inside the owner's bounds. */
+    fun defaultGapMillis(lastGapMillis: Long, bounds: Bounds): Long =
+        (lastGapMillis.takeIf { it > 0 } ?: DEFAULT_GAP_MILLIS).coerceIn(bounds.minGapMillis, MAX_WISH_MILLIS)
+
+    /** The next time after [nowMillis] at which a clock in [zone] shows [hour]:[minute]. */
+    fun nextClockTime(nowMillis: Long, zone: TimeZone, hour: Int, minute: Int): Long {
+        val clock = Calendar.getInstance(zone).apply {
+            timeInMillis = nowMillis
+            set(Calendar.HOUR_OF_DAY, hour)
+            set(Calendar.MINUTE, minute)
+            set(Calendar.SECOND, 0)
+            set(Calendar.MILLISECOND, 0)
+        }
+        if (clock.timeInMillis <= nowMillis) clock.add(Calendar.DAY_OF_YEAR, 1)
+        return clock.timeInMillis
+    }
+
+    /**
+     * The earliest time at which one more moment fits into the day: with [maxPerDay]
+     * moments already inside the 24 hours before it, that is when the oldest of them
+     * falls out. 0 when there is room now.
+     */
+    fun earliestWithRoom(moments: List<Long>, maxPerDay: Int): Long {
+        if (maxPerDay <= 0) return Long.MAX_VALUE
+        val sorted = moments.sorted()
+        return if (sorted.size >= maxPerDay) sorted[sorted.size - maxPerDay] + DAY_MILLIS else 0L
+    }
+
+    /**
+     * Turns what she asked for into the time that is stored.
+     *
+     * [wish] is what [parseWish] read, and [wishGiven] says whether she wrote a `next:`
+     * line at all: a line that could not be read gets the default and she is told so.
+     * A span or a clock time is kept inside the owner's bounds: not sooner than the
+     * least time between two moments, not further off than [MAX_WISH_MILLIS], and not
+     * before the day has room for one more ([moments] are the times of her moments so
+     * far, this one included). "When he writes" stores no time at all.
+     *
+     * [after] is the reason given when no time was named: the default, or the default
+     * that follows her answer to the message she had waited for.
+     */
+    fun plan(
+        wish: Wish?,
+        wishGiven: Boolean,
+        nowMillis: Long,
+        zone: TimeZone,
+        lastGapMillis: Long,
+        moments: List<Long>,
+        bounds: Bounds,
+        after: Why = Why.DEFAULT
+    ): Planned {
+        if (wish == Wish.WhenHeWrites) return Planned(Wake.WhenHeWrites, Why.ASKED, null, null)
+        var moved: Moved? = null
+        var chosenGap: Long? = null
+        var why = Why.ASKED
+        var at = when (wish) {
+            is Wish.After -> {
+                val gap = wish.millis.coerceIn(bounds.minGapMillis, MAX_WISH_MILLIS)
+                if (gap > wish.millis) moved = Moved.TOO_SOON
+                if (gap < wish.millis) moved = Moved.TOO_FAR
+                chosenGap = gap
+                nowMillis + gap
+            }
+            is Wish.At -> {
+                val clock = nextClockTime(nowMillis, zone, wish.hour, wish.minute)
+                val soonest = nowMillis + bounds.minGapMillis
+                if (clock < soonest) moved = Moved.TOO_SOON
+                maxOf(clock, soonest).also { chosenGap = it - nowMillis }
+            }
+            else -> {
+                if (wishGiven) moved = Moved.NOT_READ
+                why = after
+                nowMillis + defaultGapMillis(lastGapMillis, bounds)
+            }
+        }
+        val room = earliestWithRoom(moments, bounds.maxPerDay)
+        if (room > at) {
+            at = room
+            moved = Moved.DAY_USED_UP
+        }
+        return Planned(Wake.At(at), why, chosenGap, moved)
+    }
+
+    /** How long he has to have gone without writing for an unlock to bring her next moment forward. */
+    const val UNLOCK_QUIET_MILLIS = 2 * HOUR
+
+    /** A moment of hers this recent keeps an unlock from bringing the next one forward. */
+    const val UNLOCK_AFTER_MOMENT_MILLIS = 30 * MINUTE
+
+    /** How soon after the unlock the moment is brought to, at the earliest. */
+    const val UNLOCK_SOON_MILLIS = 3 * MINUTE
+
+    /**
+     * The sooner time her next moment is brought to when he unlocks the phone at
+     * [nowMillis], or null when it stays as it is. [heLastWroteAt] is when he last wrote
+     * in the chat, null when no message of his is among its recent rows.
+     *
+     * It is brought forward only when he has gone [UNLOCK_QUIET_MILLIS] or more without
+     * writing, she is awake (not in a sleep), a time is stored for her next moment, her
+     * last moment was [UNLOCK_AFTER_MOMENT_MILLIS] or longer ago, and no attempt has
+     * failed since (the wait after a failure grows on purpose, [retryWaitMillis]). "When
+     * he writes" is her wish to wait for him and is left alone, and so is the moment of
+     * her waking ([Why.WOKE], [Why.WOKEN]): that one tells her what her sleep pass came
+     * to. The new time is [UNLOCK_SOON_MILLIS] from now, never closer to her last moment
+     * than his least gap, and never before the day has room for one more; it is used only
+     * when that is sooner than the stored time.
+     */
+    fun broughtForward(state: State, nowMillis: Long, heLastWroteAt: Long?, bounds: Bounds): Long? {
+        if (!state.on || PersonaSleep.isMarked(state) || state.failures > 0 || bounds.maxPerDay <= 0) return null
+        if (state.why == Why.WOKE || state.why == Why.WOKEN) return null
+        val due = (state.wake as? Wake.At)?.atMillis ?: return null
+        if (heLastWroteAt != null && nowMillis - heLastWroteAt < UNLOCK_QUIET_MILLIS) return null
+        if (state.lastAtMillis > 0 && nowMillis - state.lastAtMillis < UNLOCK_AFTER_MOMENT_MILLIS) return null
+        val sooner = maxOf(
+            nowMillis + UNLOCK_SOON_MILLIS,
+            if (state.lastAtMillis > 0) state.lastAtMillis + bounds.minGapMillis else 0L,
+            earliestWithRoom(state.momentsOfTheDay(nowMillis), bounds.maxPerDay)
+        )
+        return sooner.takeIf { it < due }
+    }
+
+    /**
+     * [state] with her next moment brought forward to [atMillis] by an unlock
+     * ([broughtForward]). The time and the reason it had are kept beside it; when it was
+     * brought forward already, the ones from before the first unlock stay.
+     */
+    fun unlocked(state: State, atMillis: Long): State {
+        val keeps = state.why == Why.UNLOCKED && state.broughtFromAt > 0
+        return state.copy(
+            wake = Wake.At(atMillis),
+            why = Why.UNLOCKED,
+            broughtFromAt = if (keeps) state.broughtFromAt else (state.wake as? Wake.At)?.atMillis ?: 0L,
+            broughtFromWhy = if (keeps) state.broughtFromWhy else state.why
+        )
+    }
+
+    /**
+     * [state] after a message of his at [nowMillis], when an unlock had brought her next
+     * moment forward, or null when none had. The moment was brought forward for his
+     * silence, and he wrote: it gets back the time and the reason it had before the
+     * unlock. Without them it comes the usual gap after now.
+     */
+    fun setBack(state: State, nowMillis: Long, bounds: Bounds): State? {
+        if (state.why != Why.UNLOCKED || state.wake !is Wake.At) return null
+        val back = state.broughtFromWhy
+        val (at, why) = if (state.broughtFromAt > 0 && back != null && back != Why.UNLOCKED) {
+            maxOf(state.broughtFromAt, nowMillis) to back
+        } else {
+            nowMillis + defaultGapMillis(state.lastGapMillis, bounds) to Why.DEFAULT
+        }
+        return state.copy(wake = Wake.At(at), why = why, broughtFromAt = 0, broughtFromWhy = null)
+    }
+
+    /** How soon after she comes back from an outing her next moment comes, at the earliest. */
+    const val CAME_BACK_AFTER_MILLIS = MINUTE
+
+    /**
+     * The sooner time her next moment is brought to when she comes back from an outing at
+     * [nowMillis], or null when it stays as it is: [CAME_BACK_AFTER_MILLIS] from now,
+     * never closer to her last moment than his least gap, and never before the day has
+     * room for one more ([earliestWithRoom]). It is used only when that is sooner than the
+     * time already set; "when he writes" sets none, so it is sooner than that. Nothing is
+     * brought forward while she sleeps, before her own time has been seen on, or with no
+     * moment allowed in a day.
+     */
+    fun cameBackAt(state: State, nowMillis: Long, bounds: Bounds): Long? {
+        if (!state.on || PersonaSleep.isMarked(state) || bounds.maxPerDay <= 0) return null
+        val sooner = maxOf(
+            nowMillis + CAME_BACK_AFTER_MILLIS,
+            if (state.lastAtMillis > 0) state.lastAtMillis + bounds.minGapMillis else 0L,
+            earliestWithRoom(state.momentsOfTheDay(nowMillis), bounds.maxPerDay)
+        )
+        return when (val wake = state.wake) {
+            is Wake.At -> sooner.takeIf { it < wake.atMillis }
+            Wake.WhenHeWrites -> sooner
+            Wake.Unset -> null
+        }
+    }
+
+    /**
+     * [state] once she is back from [outing] at [nowMillis]: the outing is kept for her
+     * next moment, and that moment is brought forward ([cameBackAt]) when it can be. The
+     * time and the reason it had are kept beside it, as for an unlock. A look through the
+     * camera had its own moment of looking at once, so her next moment keeps its time.
+     */
+    fun cameBack(state: State, outing: LastOuting, nowMillis: Long, bounds: Bounds): State {
+        val kept = state.copy(lastOuting = outing)
+        if (outing.isLook) return kept
+        val at = cameBackAt(state, nowMillis, bounds) ?: return kept
+        return kept.copy(
+            wake = Wake.At(at),
+            why = Why.CAME_BACK,
+            broughtFromAt = (state.wake as? Wake.At)?.atMillis ?: 0L,
+            // "When he writes" is the time she named too, for what she is told.
+            broughtFromWhy = if (state.wake == Wake.WhenHeWrites) Why.ASKED else state.why
+        )
+    }
+
+    /** True when the lines she kept to herself in a reply ([thoughts], without their marker) hold `go: stop`: her outing ends. */
+    fun stopsOuting(thoughts: String): Boolean =
+        thoughts.lines().any { line -> marked(line, OutingKind.MARK)?.let(OutingKind::isStop) == true }
+
+    // ── What a moment of hers comes to ───────────────────────────────────────────────
+
+    private const val SAY = "say:"
+    private const val NOTE = "note:"
+    private const val NEXT = "next:"
+    private const val SLEEP = PersonaSleep.MARK
+    private const val FEEL = "feel:"
+    private const val GO = OutingKind.MARK
+    private const val WONDER = Wonders.MARK
+    private const val MAX_ASKED_CHARS = 40
