+        assertTrue(source("ui/screens/SettingsScreen.kt").contains("onNavigateToPersonaPictures, onNavigateToPictureModels, onTryBrain = onNavigateToBrainTrial, onMakeReferenceSheets = onNavigateToReferenceSheets) }"))
