--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/reading/ReadableTest.kt
@@ -0,0 +1,126 @@
+package com.opendroid.ai.core.life.reading
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.nio.charset.Charset
+
+/** Readable text out of three kinds of page, and the charsets Japanese sites still use. */
+class ReadableTest {
+
+    private val sjis = Charset.forName("Shift_JIS")
+    private val eucJp = Charset.forName("EUC-JP")
+
+    private val japaneseArticle = """
+        <html><head>
+        <meta http-equiv="Content-Type" content="text/html; charset=Shift_JIS">
+        <title>egg (雑誌) - ギャル雑誌の歴史</title>
+        <link rel="alternate" type="application/rss+xml" href="/rss.xml">
+        <meta property="og:image" content="https://example.jp/egg.jpg">
+        </head><body>
+        <div id="header"><a href="/">トップ</a> <a href="/news">ニュース</a> <a href="/login">ログイン</a></div>
+        <div class="article_body">
+        <h1>egg (雑誌)</h1>
+        <p>『egg』は、1995年に創刊された日本のギャル向けファッション雑誌である。渋谷を中心としたギャル文化を牽引した。</p>
+        <p>2014年に一度休刊したが、2018年にウェブメディアとして復活し、2019年には紙の雑誌も復刊した。</p>
+        <p>誌面では読者モデルが多く起用され、ガングロやヤマンバなどの流行を生んだ。</p>
+        </div>
+        <div class="sidebar"><h3>人気記事</h3><ul><li><a href="/a">ランキング記事その一、とても人気です</a></li></ul></div>
+        <div id="footer">Copyright example.jp</div>
+        </body></html>
+    """.trimIndent()
+
+    @Test
+    fun `a Japanese article in Shift_JIS - its text without the menus`() {
+        val bytes = japaneseArticle.toByteArray(sjis)
+        val html = Readable.decode(bytes, "text/html")
+        val page = Readable.page(html, "https://example.jp/egg")
+        assertEquals("egg (雑誌) - ギャル雑誌の歴史", page.title)
+        assertTrue(page.text.contains("1995年に創刊された日本のギャル向けファッション雑誌"))
+        assertTrue(page.text.contains("ガングロやヤマンバ"))
+        assertFalse(page.text.contains("ログイン"))
+        assertFalse(page.text.contains("ランキング記事"))
+        assertFalse(page.text.contains("Copyright"))
+        assertEquals(listOf("https://example.jp/rss.xml"), page.feeds)
+        assertEquals("https://example.jp/egg.jpg", page.image)
+    }
+
+    @Test
+    fun `an English article - paragraphs in order, links kept`() {
+        val html = """
+            <html><head><title>Ganguro - Example Encyclopedia</title></head><body>
+            <article>
+            <h1>Ganguro</h1>
+            <p>Ganguro is a fashion trend among young Japanese women that peaked in popularity around 2000.</p>
+            <p>It is characterised by a deep tan, bleached hair and white concealer, and it grew out of the
+            <a href="https://example.org/wiki/Gyaru">gyaru</a> subculture in Shibuya.</p>
+            <p>Magazines such as egg spread the look, and street snaps made its stars famous.</p>
+            </article>
+            </body></html>
+        """.trimIndent()
+        val page = Readable.page(html, "https://example.org/wiki/Ganguro")
+        val paragraphs = page.text.split("\n\n")
+        assertTrue(paragraphs.indexOfFirst { it.startsWith("Ganguro is a fashion") } < paragraphs.indexOfFirst { it.startsWith("Magazines such as egg") })
+        assertTrue(page.text.contains("grew out of the gyaru subculture in Shibuya."))
+        assertEquals(Readable.Link("gyaru", "https://example.org/wiki/Gyaru"), page.links.first())
+        assertEquals("example.org", page.links.first().domain)
+    }
+
+    @Test
+    fun `a page with heavy navigation - the article wins over menus, sidebars and footers`() {
+        val menu = (1..60).joinToString("") { "<li><a href=\"https://news.example.com/section/$it\">Section number $it of the site</a></li>" }
+        val related = (1..15).joinToString("") { "<li><a href=\"https://news.example.com/r/$it\">Related story number $it, with a long headline here</a></li>" }
+        val html = """
+            <html><head><title>Story</title></head><body>
+            <nav><ul>$menu</ul></nav>
+            <div class="top-menu"><ul>$menu</ul></div>
+            <div class="layout">
+              <div class="col-main">
+                <div class="story-content">
+                  <p>The 109 building in Shibuya reopened its eighth floor on Saturday, with a pop-up store run by former gyaru models.</p>
+                  <p>Queues formed before the doors opened, and the store sold out of its first run of platform boots by noon, staff said.</p>
+                  <p>Organisers said the event would return in spring, with more shops from the original era of the building.</p>
+                </div>
+              </div>
+              <div class="col-side"><div class="related"><ul>$related</ul></div></div>
+            </div>
+            <div class="cookie-consent"><p>We use cookies to improve your experience on this site, please accept them.</p></div>
+            <footer><p>About us, contact, careers, terms of use, privacy policy and more links.</p></footer>
+            </body></html>
+        """.trimIndent()
+        val page = Readable.page(html, "https://news.example.com/story")
+        assertTrue(page.text.startsWith("The 109 building in Shibuya"))
+        assertTrue(page.text.contains("platform boots by noon"))
+        assertFalse(page.text.contains("Section number"))
+        assertFalse(page.text.contains("Related story"))
+        assertFalse(page.text.contains("cookies"))
+        assertFalse(page.text.contains("careers"))
+    }
+
+    @Test
+    fun `charsets - a byte order mark, the header, the meta, and Shift_JIS and EUC-JP told apart undeclared`() {
+        val text = "渋谷のギャル文化は、九十年代に花開いた。ガングロとヤマンバが街を歩いた。"
+        assertEquals(text, Readable.decode(byteArrayOf(0xEF.toByte(), 0xBB.toByte(), 0xBF.toByte()) + text.toByteArray(Charsets.UTF_8)))
+        assertEquals(text, Readable.decode(text.toByteArray(eucJp), "text/html; charset=EUC-JP"))
+        assertEquals(text, Readable.decode(text.toByteArray(sjis), "text/html; charset=x-sjis"))
+        assertEquals(text, Readable.decode(text.toByteArray(Charsets.UTF_8)))
+        assertEquals(text, Readable.decode(text.toByteArray(sjis)))
+        assertEquals(text, Readable.decode(text.toByteArray(eucJp)))
+        val xml = "<?xml version=\"1.0\" encoding=\"EUC-JP\"?><rss><title>$text</title></rss>"
+        assertTrue(Readable.decode(xml.toByteArray(eucJp), "application/xml").contains(text))
+        assertEquals("café", Readable.decode("café".toByteArray(Charsets.ISO_8859_1), "text/html; charset=iso-8859-1"))
+    }
+
+    @Test
+    fun `a long text is cut into parts at paragraph ends`() {
+        val paragraph = "a".repeat(2_500)
+        val parts = Readable.parts(List(5) { paragraph }.joinToString("\n\n"))
+        assertEquals(3, parts.size)
+        assertTrue(parts.all { it.length <= Readable.PART_CHARS })
+        assertEquals(listOf("short"), Readable.parts("short"))
+        assertEquals(emptyList<String>(), Readable.parts("  "))
+        val unbroken = Readable.parts("b".repeat(13_000))
+        assertEquals(3, unbroken.size)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/reading/ReadingSpaceLookTest.kt b/app/src/test/java/com/opendroid/ai/core/life/reading/ReadingSpaceLookTest.kt
