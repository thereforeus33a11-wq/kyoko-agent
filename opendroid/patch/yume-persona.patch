+package com.opendroid.ai.core.voice
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class WakeReplyGateTest {
+
+    @Test
+    fun `the microphone opens once, when the wake reply itself has ended`() {
+        val gate = WakeReplyGate()
+        gate.armFor("wake-1")
+
+        assertFalse("another line ending opens nothing", gate.onUtteranceDone("her-reply"))
+        assertTrue(gate.onUtteranceDone("wake-1"))
+        assertFalse("only once", gate.onUtteranceDone("wake-1"))
+        assertFalse("and the deadline finds nothing left to open", gate.onDeadline())
+    }
+
+    @Test
+    fun `the deadline opens it when no ending was reported, and then the late ending opens nothing`() {
+        val gate = WakeReplyGate()
+        gate.armFor("wake-1")
+
+        assertTrue(gate.onDeadline())
+        assertFalse(gate.onDeadline())
+        assertFalse("a clip that ends late must not open a second microphone", gate.onUtteranceDone("wake-1"))
+    }
+
+    @Test
+    fun `a gate that was disarmed or never armed stays shut`() {
+        val gate = WakeReplyGate()
+        assertFalse(gate.onDeadline())
+        assertFalse(gate.onUtteranceDone("wake-1"))
+
+        assertFalse("nothing was awaited", gate.disarm())
+
+        gate.armFor("wake-1")
+        assertTrue("a wake reply was still awaited when the gate was shut", gate.disarm())
+        assertFalse(gate.disarm())
+        assertFalse(gate.onUtteranceDone("wake-1"))
+        assertFalse(gate.onDeadline())
+
+        // A reply that already opened the microphone is not awaited any more.
+        gate.armFor("wake-1")
+        assertTrue(gate.onUtteranceDone("wake-1"))
+        assertFalse(gate.disarm())
+
+        // A second wake phrase replaces the first reply: only the newer one counts.
+        gate.armFor("wake-1")
+        gate.armFor("wake-2")
+        assertFalse(gate.onUtteranceDone("wake-1"))
+        assertTrue(gate.onUtteranceDone("wake-2"))
+    }
+
+    @Test
+    fun `a transcript that is only the phone's own wake reply is recognised as that`() {
+        val hers = listOf("mm?", "what", "oi", "hah?", "say it")
+        for (heard in listOf("what", "What", "what?", "Say it.", "say it", "oi", " OI! ", "mm", "hah")) {
+            assertTrue(heard, WakeReplyGate.isEchoOf(heard, hers))
+        }
+        assertTrue(WakeReplyGate.isEchoOf("opendroid online", listOf("OpenDroid online.")))
+    }
+
+    @Test
+    fun `anything he added makes the transcript his`() {
+        val hers = listOf("mm?", "what", "oi", "hah?", "say it")
+        for (heard in listOf(
+            "what time is it",
+            "say it again louder",
+            "what flashlight on",
+            "oi open the camera",
+            "flashlight on",
+            "so what",
+            "",
+            "   ",
+            "?"
+        )) {
+            assertFalse(heard, WakeReplyGate.isEchoOf(heard, hers))
+        }
+        assertFalse(WakeReplyGate.isEchoOf("what", emptyList()))
+    }
+}
