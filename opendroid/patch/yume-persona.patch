+                text = "Leave both empty to use one model for everything. Fill in a model id to have a second model, on the same provider and key, write only her replies; its options are laid over the provider's for those replies. $E2EE_MODEL_HINT",
+                fontSize = 10.sp,
+                color = TextSecondary
+            )
+            // Shown once something is typed: what of it is really sent.
+            if (config.personaChatExtraBody.isNotBlank()) {
+                Text(text = replyOptionsNote(config), fontSize = 10.sp, color = AccentCyan)
+            }
+
+            // Off, "read my screen" still works and goes to the main model, which is the
+            // same model when no other is set for her replies: the line says where it goes.
+            SettingSwitchRow(
+                title = "Her model can see screenshots",
+                description = "Off: no image goes into a reply of hers, neither a screenshot of your screen nor a picture of her. \"Read my screen\" is then answered by the app's own screen reader, which sends the screenshot, or the text on the screen, to the main model.$OWN_CHAT_NOT_READ",
+                checked = config.personaChatSeesImages,
+                onCheckedChange = viewModel::updatePersonaChatSeesImages
+            )
+            screenshotSwitchNote(config)?.let { note ->
+                Text(text = note, fontSize = 11.sp, color = AccentCyan)
+            }
+            SettingSwitchRow(
+                title = "Let her use the phone herself",
+                description = "A reply of hers can end in a command of her own: open an app, play something, set an alarm, change a setting, write to someone, look something up. It is her act, started by her.",
+                checked = config.personaActionsEnabled,
+                onCheckedChange = viewModel::updatePersonaActions
+            )
+            SettingSwitchRow(
+                title = "She can make pictures of herself",
+                description = MAKES_PICTURES_SWITCH_TEXT,
+                checked = config.personaMakesPictures,
+                onCheckedChange = viewModel::updatePersonaMakesPictures
+            )
+            SettingSwitchRow(
+                title = OWN_VOICE_TITLE,
+                description = OWN_VOICE_TEXT,
+                checked = config.personaOwnVoice,
+                onCheckedChange = viewModel::updatePersonaOwnVoice
+            )
+            if (config.personaActionsEnabled) {
+                SettingChoiceRow(
+                    label = "What she starts herself",
+                    options = REIN_CHOICES,
+                    selected = config.personaRein,
+                    onSelect = viewModel::updatePersonaRein
+                )
+                Text(
+                    text = reinHint(config.personaRein),
+                    fontSize = 10.sp,
+                    color = if (config.personaRein == PersonaRein.EVERYTHING) AccentCyan else TextSecondary
+                )
+            }
+            SettingSwitchRow(
+                title = "She tells you what came of it",
+                description = "After a plan has run she says the outcome in her own words. The exact result from the phone stays in the chat beside it, and if her line leaves out or changes a fact, the exact result is spoken instead. Costs one model call per plan.",
+                checked = config.personaSpeaksResults,
+                onCheckedChange = viewModel::updatePersonaSpeaksResults
+            )
+            SettingSwitchRow(
+                title = OWN_TIME_TITLE,
+                description = OWN_TIME_HINT,
+                checked = config.personaCheckInsEnabled,
+                onCheckedChange = viewModel::updatePersonaCheckIns
+            )
+            if (config.personaCheckInsEnabled) {
+                // When she is awake is hers to say. These two are his: every moment is a call on his key.
+                SettingChoiceRow(
+                    label = "Least time between two of her moments",
+                    options = ownTimeGapChoices(config.personaOwnTimeMinGapMinutes),
+                    selected = config.personaOwnTimeMinGapMinutes.coerceAtLeast(1),
+                    onSelect = viewModel::updatePersonaOwnTimeMinGap
+                )
+                SettingChoiceRow(
+                    label = "Most moments of hers in 24 hours",
+                    options = ownTimeCountChoices(config.personaOwnTimeMaxPerDay),
+                    selected = config.personaOwnTimeMaxPerDay.coerceAtLeast(0),
+                    onSelect = viewModel::updatePersonaOwnTimeMaxPerDay
+                )
+                Text(text = ownTimeBoundsLine(config.personaOwnTimeMaxPerDay), fontSize = 10.sp, color = TextSecondary)
+                Text(
+                    text = ownTimeActsLine(config.personaActionsEnabled, config.personaRein),
