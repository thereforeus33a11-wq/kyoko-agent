+class PersonaWallTest {
+
+    private val mainSources = File("src/main/java/com/opendroid/ai")
+
+    private fun relative(file: File) = file.relativeTo(mainSources).path.replace('\\', '/')
+
+    private fun kotlinSources() = mainSources.walkTopDown().filter { it.isFile && it.extension == "kt" }
+
+    @Test
+    fun `only the chat loop, the voice service, the memory filters, the card editor and the presence model touch the persona package`() {
+        val allowed = setOf(
+            "core/agent/AgentLoop.kt", // her chat prompt, her fixed lines, her command and her rein
+            "core/service/OpenDroidService.kt", // wake reply, check-ins, the approval prompt and her name on the notification
+            "data/repository/MemoryRepository.kt", // leaves her notes OUT of every by-type read
+            "data/db/dao/MemoryDao.kt", // leaves her notes OUT of the wipe of a memory category
+            "core/memory/MemoryManager.kt", // leaves her notes OUT of memory search
+            "ui/viewmodel/PersonaViewModel.kt", // the owner reads and edits her card and hands her notes
+            "ui/viewmodel/PersonaPicturesViewModel.kt", // the owner keeps her pictures, beside the card editor
+            "ui/viewmodel/PersonaPresenceViewModel.kt" // tells the screens whether she is the one who talks
+        )
+        val users = kotlinSources()
+            .filterNot { relative(it).startsWith("core/persona/") }
+            .filter { it.readText().contains("core.persona.") }
+            .map { relative(it) }
+            .toSet()
+
+        assertEquals(allowed, users)
+    }
+
+    @Test
+    fun `the screens ask one place whether she talks, and none of them reads the switch alone`() {
+        // The switch says nothing about whether a card exists. A screen that went by it
+        // would show her name over the stock assistant in a build without a card.
+        val screens = kotlinSources().filter { relative(it).startsWith("ui/screens/") }.toList()
+        assertTrue(screens.size > 10)
+        val bySwitch = screens.filter { it.readText().contains("personaEnabled") }.map { relative(it) }
+        // The settings card shows and sets the switch itself; that is all it uses it for.
+        assertEquals(listOf("ui/screens/PersonaSettingsCards.kt"), bySwitch)
+        val settings = File(mainSources, "ui/screens/PersonaSettingsCards.kt").readText()
+        assertEquals(1, Regex("personaEnabled").findAll(settings).count())
+        assertTrue(settings.contains("checked = config.personaEnabled"))
+
+        // The one answer is the engine's, and the presence model only passes it on.
+        val presence = File(mainSources, "ui/viewmodel/PersonaPresenceViewModel.kt").readText()
+        assertTrue(presence.contains("persona.active"))
+        assertFalse(presence.contains("personaEnabled"))
+        val engine = File(mainSources, "core/persona/PersonaEngine.kt").readText()
+        assertTrue(engine.contains("fun isActive(config: LLMConfig): Boolean = config.personaEnabled && store.card().isNotBlank()"))
+        assertTrue(engine.contains("combine(settingsRepository.llmConfig, store.changes) { config, _ -> isActive(config) }"))
+        for (screen in listOf("ui/screens/ChatScreen.kt", "ui/screens/OnboardingScreen.kt", "ui/screens/PersonaSettingsCards.kt")) {
+            assertTrue(screen, File(mainSources, screen).readText().contains("presence.active.collectAsState()"))
+        }
+    }
+
+    @Test
+    fun `her notebook pass is written by her, on her card, and is due from what is stored`() {
+        val engine = File(mainSources, "core/persona/PersonaEngine.kt").readText()
+        val reflect = engine.substringAfter("internal suspend fun reflect(").substringBefore("suspend fun checkInLine(")
+        assertTrue(reflect.contains("reflectionRequest(store.card(), ownerName(), notebook.text, dialogue, notesAboutHimHeldBack = heldBack)"))
+        // What she writes is held against the notes that were on the page she was given:
+        // a note that was not on it is never replaced by this pass.
+        assertTrue(reflect.contains("val notebook = PersonaNotes.review(memory.notes(), leaveOut = unseen)"))
+        assertTrue(reflect.contains("PersonaNotes.besideUnseen(changes, memory.notes(), unseen, shownKeys = notebook.shownKeys)"))
+        assertTrue(engine.contains("systemPrompt = PersonaPrompts.reflectionSystemPrompt(card, ownerName),"))
+        assertFalse(engine.contains("systemPrompt = PersonaPrompts.REFLECTION_SYSTEM_PROMPT"))
+        assertTrue(reflect.contains("PersonaNotes.parse(response.content, limit = PersonaNotes.LINES_PER_PASS)"))
+
+        val onReply = engine.substringAfter("fun onReply(").substringBefore("internal suspend fun reflect(")
+        // No count that dies with the process, and the time is written only after a pass that was made.
+        assertFalse(engine.contains("AtomicInteger"))
+        assertTrue(onReply.contains("repliesSince(recent, memory.lastReflectionAt()) >= REPLIES_PER_REFLECTION && reflect(recent)"))
+        assertTrue(onReply.indexOf("reflect(recent)") < onReply.indexOf("memory.recordReflection("))
+        assertEquals(1, Regex("""recordReflection\(""").findAll(engine).count())
+    }
+
+    @Test
+    fun `the block about him in her prompt is built from her route's own pieces, not from the stock text`() {
+        val engine = File(mainSources, "core/persona/PersonaEngine.kt").readText()
+        val prompt = engine.substringAfter("suspend fun chatSystemPrompt(").substringBefore("fun onReply(")
+        assertTrue(prompt.contains("val heldBack = config.holdsBackDetails(route)"))
+        assertTrue(prompt.contains("relevantContext = aboutHimBlock(memoryManager.contextPieces(lean = heldBack), relevantContext)"))
+        // The stock text is not passed through to her prompt any more.
+        assertFalse(prompt.contains("relevantContext = relevantContext,"))
+    }
+
+    @Test
+    fun `prompt builders for plans, re-evaluation, auto-replies and social text never mention her`() {
+        val decisionSources = kotlinSources().filter { file ->
+            val path = relative(file)
+            path.startsWith("core/llm/") || path.startsWith("social/") ||
+                path in setOf(
+                    "core/agent/AutoReplyGenerator.kt",
+                    "core/agent/AutoReplyEngine.kt",
+                    "core/agent/ReEvaluationEngine.kt",
+                    "core/agent/IntentClassifier.kt",
+                    "core/agent/VisionEngine.kt",
+                    "core/agent/PlanApprovalSummary.kt"
+                )
+        }.toList()
+        assertTrue("expected to scan prompt sources", decisionSources.size > 20)
+
+        val offenders = decisionSources.filter { file ->
+            val text = file.readText()
+            text.contains("PersonaPrompts") || text.contains("PersonaEngine") ||
+                text.contains("PersonaPhrasebook") || text.contains("Yume")
+        }.map { relative(it) }
+
+        assertEquals(emptyList<String>(), offenders)
+    }
+
+    @Test
+    fun `the stock prompt builders carry no persona marker`() {
+        val user = ChatMessage(id = "1", text = "text sam i am late", sender = ChatMessage.Sender.USER)
+        val cloud = buildPlanningRequest(user, "likes tea", isOnDevice = false, temperature = 0.1f, maxTokens = 1500)
+        val onDevice = buildPlanningRequest(user, "likes tea", isOnDevice = true, temperature = 0.1f, maxTokens = 512)
+        val main = SystemPrompts.buildMainPrompt(emptyList(), "likes tea", "now", "Battery 80")
+        val prompts = listOf(
+            cloud.systemPrompt, onDevice.systemPrompt, main, ReEvalPrompts.RE_EVAL_SYSTEM_PROMPT,
+            PlanningPrompts.MERGE_SYSTEM_PROMPT, PlanningPrompts.CRITIC_SYSTEM_PROMPT,
+            AutoReplyPrompts.buildWhatsAppReplyPrompt("Jo", "Sam", "hi", "", null),
+            AutoReplyPrompts.buildSmsReplyPrompt("Jo", "Sam", "hi", "", null),
+            AutoReplyPrompts.buildEmailReplyPrompt("Jo", "Sam", "subject", "hi", null)
+        )
+        for (prompt in prompts) {
+            assertFalse(prompt.take(80), prompt.contains(PersonaPrompts.APP_FACTS_HEADING))
+            assertFalse(prompt.take(80), prompt.contains(PersonaPrompts.RESULT_FACTS_HEADING))
+            assertFalse(prompt.take(80), prompt.contains("Yume"))
+            assertFalse(prompt.take(80), prompt.contains(PersonaPrompts.OWNER_PLACEHOLDER))
+        }
+    }
+
+    @Test
+    fun `a command of hers reaches the planner exactly as the same words from him would`() {
+        // The split hands over the bare command: no marker, no card, nothing of her reply.
+        val command = PersonaActions.split("fine. telling her\n>> text nene: where are you").command!!
+        assertEquals("text nene: where are you", command)
