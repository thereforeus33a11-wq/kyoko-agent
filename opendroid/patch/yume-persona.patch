+        assertEquals(3, chatBodies.size)
+        assertFalse(chatBodies[2].contains("disable_thinking"))
+        // Encrypted every time: nothing of what was said went out readable.
+        for (sent in chatBodies) {
+            for (secret in listOf(secretSystem, secretUser, secretEarlierUser, secretEarlierReply)) assertFalse(sent.contains(secret))
+            assertTrue(JsonParser.parseString(sent).asJsonObject.getAsJsonObject("venice_parameters").get("enable_e2ee").asBoolean)
+        }
