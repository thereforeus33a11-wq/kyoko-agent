+        // as something she said. The spoken copy skips it instead.
+        assertEquals("*rolls eyes* oi. you again", PersonaPrompts.cleanReply("*rolls eyes* oi. you again"))
+        assertEquals("*sighs* fine *rolls her eyes*", PersonaPrompts.cleanReply("*sighs* fine *rolls her eyes*"))
