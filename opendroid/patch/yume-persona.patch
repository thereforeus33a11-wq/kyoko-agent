+
+    @Test
+    fun `at most three redirects`() = runBlocking {
+        serve { request ->
+            val hop = request.target!!.removePrefix("/hop").toIntOrNull() ?: 0
+            if (hop >= 10) html("<p>end</p>") else MockResponse.Builder().code(302).addHeader("Location", "/hop${hop + 1}").build()
