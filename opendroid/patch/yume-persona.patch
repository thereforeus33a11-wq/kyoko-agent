+package com.opendroid.ai.core.voice
+
+/**
+ * Turns text as it is shown in chat into text a speech engine can read aloud.
+ *
+ * Only the copy handed to [TextToSpeechEngine] is changed. Chat bubbles, stored
+ * messages, step results and anything sent to a model keep the original text.
+ *
+ * The base pass is safe for any text (it removes markup, emoji and links). The
+ * persona pass adds the habits of a character who types lowercase with no
+ * apostrophes, laughs with "www" and mixes in romaji Japanese. It is for lines she
+ * wrote and for nothing else: the caller says whose line it is, so the app's own
+ * text and other people's words (a message read aloud, a step result, the approval
+ * prompt) only ever get the base pass.
+ */
+object SpeechTextNormalizer {
+
+    /** Words the persona types without an apostrophe that a speech engine misreads. */
+    private val CONTRACTIONS = mapOf(
+        "dont" to "don't", "cant" to "can't", "wont" to "won't", "im" to "I'm", "ive" to "I've",
+        "youre" to "you're", "youve" to "you've", "thats" to "that's", "whats" to "what's",
+        "isnt" to "isn't", "arent" to "aren't", "wasnt" to "wasn't", "werent" to "weren't",
+        "doesnt" to "doesn't", "didnt" to "didn't", "couldnt" to "couldn't",
+        "shouldnt" to "shouldn't", "wouldnt" to "wouldn't", "havent" to "haven't",
+        "hasnt" to "hasn't", "theyre" to "they're", "theres" to "there's", "heres" to "here's",
+        "hes" to "he's", "shes" to "she's", "aint" to "ain't"
+    )
+
+    /**
+     * Sounds and romaji that an English voice spells out or reads as an abbreviation.
+     * Deliberately short: a respelling that is wrong sounds worse than the raw word.
+     */
+    val DEFAULT_LEXICON: Map<String, String> = mapOf(
+        "tch" to "tsk",
+        "pfft" to "pff",
+        "ii" to "ee",
+        "ne" to "neh",
+        "oniisan" to "oh nee san",
+        "tl;dr" to "too long"
+    )
+
+    private val CODE_FENCE = Regex("```[a-zA-Z0-9]*")
+    private val URL = Regex("""(?i)\b(?:https?://|www\.)\S+""")
+    // Markers count only at a word edge: "12*5*2", "john_doe@x.com" and "tax_return.pdf" are not markup.
+    private val BOLD_OR_ITALIC =
+        Regex("""(?<![\p{L}\p{N}*_])(\*\*|__|\*|_)(?=\S)(.+?)(?<=\S)\1(?![\p{L}\p{N}*_])""")
+    private val LINE_BULLET = Regex("""(?m)^\s*(?:[•·▪◦]|[-*+](?=\s))\s*""")
+    private val LINE_HEADING = Regex("""(?m)^\s*#{1,6}\s+""")
+    private val LAUGH = Regex("""(?i)(?<![a-z0-9])w{3,}(?![a-z0-9])""")
+    private val HUM = Regex("""(?i)(?<![a-z0-9])fu{2,}n(?![a-z0-9])""")
+    // "mm" as a reply is a hum. After a number ("5 mm") it is a unit and is left alone.
+    private val MM = Regex("""(?<![A-Za-z0-9])(?<!\d )m{2,}(?![A-Za-z0-9])""")
+    private val LONG_RUN = Regex("""([a-z])\1{2,}""")
+    private val ALL_LOWERCASE = Regex("""[a-z;']+""")
+    private val TILDES = Regex("[~〜～]+")
+    // A whole word only: never a piece of an accented word, a code or an address.
+    private val WORD = Regex("""(?<![\p{L}\p{N}'@._-])[A-Za-z][A-Za-z;']*(?![\p{L}\p{N}@_-])(?!\.\p{L})""")
+    private val SPACES = Regex("""[ \t ]+""")
+    private val LINE_BREAKS = Regex("""\s*\n+\s*""")
+    private val DOUBLE_STOP = Regex("""([.!?])\s*\.(?!\.)""")
+    private val SPACE_BEFORE_PUNCT = Regex("""\s+([.,!?])""")
+
+    fun normalize(
+        text: String,
+        personaVoice: Boolean = false,
+        lexicon: Map<String, String> = DEFAULT_LEXICON
+    ): String {
+        var out = text
+        out = CODE_FENCE.replace(out, " ")
+        out = out.replace("`", "")
+        out = URL.replace(out, "a link")
+        out = BOLD_OR_ITALIC.replace(out) { it.groupValues[2] }
+        out = LINE_BULLET.replace(out, "")
+        out = LINE_HEADING.replace(out, "")
+        out = stripSymbols(out)
+
+        if (personaVoice) {
+            out = TILDES.replace(out, "")
+            out = LAUGH.replace(out, "haha")
+            out = HUM.replace(out, "hmm")
+            out = MM.replace(out, "mhm")
+            // Only all-lowercase words are hers; capitalised text ("I'm", "NE") is left alone.
+            out = WORD.replace(out) { match ->
+                val word = match.value
+                lexicon[word] ?: CONTRACTIONS[word]
+                    ?: if (ALL_LOWERCASE.matches(word)) LONG_RUN.replace(word) { it.groupValues[1] } else word
+            }
+        }
+
+        out = LINE_BREAKS.replace(out.trim()) { ". " }
+        out = SPACES.replace(out, " ")
+        out = SPACE_BEFORE_PUNCT.replace(out) { it.groupValues[1] }
+        // Joining lines can leave "!." or "..": keep the first mark only.
+        repeat(2) { out = DOUBLE_STOP.replace(out) { it.groupValues[1] } }
+        out = out.trim()
+        // A reply that is only punctuation ("." is how the persona shrugs) has nothing to say aloud.
+        return if (out.any { it.isLetterOrDigit() }) out else ""
+    }
+
+    /** Drops emoji, pictographs, hearts, arrows and the joiners that glue emoji together. */
+    private fun stripSymbols(text: String): String {
+        val sb = StringBuilder(text.length)
+        var i = 0
+        while (i < text.length) {
+            val cp = text.codePointAt(i)
+            val len = Character.charCount(cp)
+            if (!isSymbolToDrop(cp)) sb.appendCodePoint(cp)
+            i += len
+        }
+        return sb.toString()
+    }
+
+    private fun isSymbolToDrop(cp: Int): Boolean = when {
+        cp == 0x200D || cp == 0xFE0F || cp == 0xFE0E || cp == 0x20E3 -> true
+        cp in 0x1F000..0x1FAFF -> true // emoji, pictographs, transport, supplemental symbols
+        cp in 0x2600..0x27BF -> true // misc symbols and dingbats, including the hearts
+        cp in 0x2190..0x21FF -> true // arrows
+        cp in 0x2B00..0x2BFF -> true // stars and more arrows
+        cp in 0x1F1E6..0x1F1FF -> true // flags
+        cp in 0xE0020..0xE007F -> true // tag characters
+        else -> false
+    }
+}
