+        assertEquals(Parsed.Look(LookAt.AROUND), OutingKind.parse("look around", all))
+        assertEquals(Parsed.Look(LookAt.AROUND), OutingKind.parse("take a look around", all))
+        assertEquals(OutingKind.Kind.LOOK, OutingKind.parse("look back", all).kind)
