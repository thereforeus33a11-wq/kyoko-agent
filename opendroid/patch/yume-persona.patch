+                top.contains("a route your privacy setting refuses") -> Unit
+                reason.contains("end to end encrypted") -> assertTrue(top, top.contains("end to end encrypted"))
+                reason.contains("is off") -> assertTrue(top, top.contains("\"Her model can see screenshots\" in Settings is off"))
