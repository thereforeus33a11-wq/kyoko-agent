+        val state = com.opendroid.ai.core.persona.PersonaOwnTime.State(lastOuting = outing)
+        assertEquals(2, com.opendroid.ai.core.persona.PersonaOwnTime.decode(com.opendroid.ai.core.persona.PersonaOwnTime.encode(state)).lastOuting?.looked)
+    }
+
+    @Test
+    fun `the status line says how many pictures and what they cost, and why the app stopped her eyes`() {
+        val summary = OwnLedger.summaryOf(
+            List(9) { OwnLedger.Call(1_000L, OwnPurpose.EYES, "google-gemma-4-31b-it", 1_000, 100) } +
+                OwnLedger.Call(1_000L, OwnPurpose.MOMENT, "e2ee-her-model", 14_000, 600),
+            150, 2_000L
+        )
+        assertEquals("Eyes: 9 pictures in 24 h, of 60. About $0.00.", eyesStatusLine(LLMConfig(personaEyes = true), summary))
+        assertNull(eyesStatusLine(LLMConfig(), OwnLedger.summaryOf(emptyList(), 150, 2_000L)))
+        assertEquals("Eyes: 9 pictures in 24 h, of 40. About $0.00.", eyesStatusLine(LLMConfig(personaEyesPerDay = 40), summary))
+        assertEquals("Eyes: stopped. ${HerEyes.KEY_OFF_WHY}", eyesStatusLine(LLMConfig(personaEyesStoppedWhy = HerEyes.KEY_OFF_WHY), summary))
+        assertEquals((9 * (1_000 * 0.15 + 100 * 0.60)) / 1_000_000.0, summary.eyesUsd, 1e-12)
+        assertTrue(summary.statusLine().contains("eyes 9"))
+    }
+}
