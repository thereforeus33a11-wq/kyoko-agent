+        assertTrue(file.isFile)
+        assertArrayEquals(originalBytes, file.readBytes())
+        assertEquals(2048 to 1536, sizeOf(file))
+        assertTrue(picture.file.endsWith(".jpg"))
+        assertEquals(PersonaPicture.Provenance.ORIGINAL, picture.provenance)
+        assertEquals(PersonaPicture.Origin.ADDED, picture.origin)
+        assertTrue(picture.asGiven)
+        assertEquals(java.security.MessageDigest.getInstance("SHA-256").digest(originalBytes).joinToString("") { "%02x".format(it) }, picture.sha256)
+        // What it is, across a restart.
+        store = PersonaPictures(context)
+        val again = list().single()
+        assertEquals(PersonaPicture.Provenance.ORIGINAL, again.provenance)
+        assertTrue(again.asGiven)
+
+        // The original is not moved or changed.
+        assertArrayEquals(originalBytes, original.readBytes())
+        assertEquals(listOf(picture.file), pictureFiles())
+        // In the app's own files directory, which no other app can read and no backup includes.
+        assertTrue(file.canonicalPath.startsWith(context.filesDir.canonicalPath))
+    }
+
+    @Test
+    fun `a PNG of her stays a PNG, the same bytes, whatever its size`() {
