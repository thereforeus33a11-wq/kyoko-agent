+package com.opendroid.ai.core.voice.own
+
+/**
+ * Her line, English, Japanese or both mixed, to the phonemes her bilingual voice reads:
+ * one list of single-codepoint phonemes per sentence. English goes through
+ * en_ipa_table.json ([EnglishPhonemes]); Japanese (kana, kanji, her romaji words) goes to
+ * Open JTalk and [JapanesePhonemes], exactly as her Japanese always has.
+ *
+ * A line-for-line port of the training side's mix_phonemize.py (MixedPhonemizer), the
+ * code her voice's training lines were read with, so the phone gives the voice the
+ * phonemes it learned from, byte for byte (MixedPhonemesParityTest holds it to the
+ * reference's golden set and to every line she was trained on). The rules it applies,
+ * how a line is cut into sentences and segments and how they are joined, are written in
+ * the table's "segmentation" and "boundaries" sections.
+ *
+ * A pure Japanese sentence (no Latin word, no English number) is handed to Open JTalk
+ * whole, as Piper does, so her Japanese stays what her earlier voice learned.
+ *
+ * Indices are UTF-16 positions; every rule looks at characters of the Basic Multilingual
+ * Plane only, so a character outside it (an emoji) simply stays inside its Japanese run,
+ * as one codepoint does in the reference.
+ */
+class MixedPhonemes(private val table: EnglishTable, val english: EnglishPhonemes) {
+
+    enum class Kind { WORD, NUM, SPACE, PUNCT, JA }
+
+    /** One piece of a sentence: [text] at [start] until [end]. */
+    class Tok(var kind: Kind, val text: String, val start: Int, val end: Int, var route: Lang? = null) {
+        var reading: WordReading? = null
+        /** What an English word token is read as: its text, or the word for & + @ =. */
+        var word: String = ""
+        override fun toString() = "${kind.name.lowercase()}:${route?.code ?: ""}:$text"
+    }
+
+    /** A run of tokens read in one language. */
+    class Segment(val route: Lang, val toks: MutableList<Tok>)
+
+    /**
+     * One sentence, cut: its [segments], whether a clause mark stands before each of them
+     * ([pauses], the first unused), its [terminal] mark, the characters after its last
+     * word ([trailing]), and whether it is pure Japanese ([verbatim]).
+     */
+    class SentencePlan(
+        val text: String,
+        val toks: List<Tok>,
+        val segments: List<Segment>,
+        val pauses: List<Boolean>,
+        val terminal: String,
+        val trailing: String,
+        val verbatim: Boolean,
+    )
+
+    private val clause: Set<String> = table.clausePunct + "..."
+
+    // -- sentences ---------------------------------------------------------------------------
+
+    /** [text] cut into sentences, each keeping its own final marks (Piper's split plus an English "."). */
+    fun splitSentences(text: String): List<String> {
+        val out = ArrayList<String>()
+        var start = 0
+        for (m in SENT_END.findAll(text)) {
+            if (m.value.startsWith(".") && !m.value.startsWith("..")) {
+                val word = trailingWord(text.substring(start, m.range.first))
+                if (word != null && word.lowercase() in table.abbreviations) continue
+            }
+            if (piperDecimal(text, m)) continue
+            val s = pyStrip(text.substring(start, m.range.last + 1))
+            if (s.isNotEmpty()) out += s
+            start = m.range.last + 1
+        }
+        val tail = pyStrip(text.substring(start))
+        if (tail.isNotEmpty()) out += tail
+        return out
+    }
+
+    /**
+     * The word that ends [s], as Python's re.search(r"([A-Za-z][A-Za-z.]*)$", s) finds it
+     * ($ also matches before one final newline): "Mr" of "hi Mr", "e.g" of "see e.g".
+     */
+    private fun trailingWord(s: String): String? {
+        val end = if (s.endsWith('\n')) s.length - 1 else s.length
+        var begin = end
+        while (begin > 0 && (isLatin(s[begin - 1]) || s[begin - 1] == '.')) begin--
+        while (begin < end && !isLatin(s[begin])) begin++
+        return if (begin < end) s.substring(begin, end) else null
+    }
+
+    private fun piperDecimal(text: String, m: MatchResult): Boolean {
+        if (m.value != ".") return false
+        val before = text.getOrNull(m.range.first - 1)
+        val after = text.getOrNull(m.range.last + 1)
+        return before != null && after != null && before.isDigit() && after.isDigit()
+    }
+
+    // -- tokens ------------------------------------------------------------------------------
+
+    /** One sentence to its tokens: Latin words, numbers, spaces, punctuation and Japanese runs. */
+    fun tokenize(s: String): List<Tok> {
+        val toks = ArrayList<Tok>()
+        val n = s.length
+        var i = 0
+        val number = NUMBER.toPattern().matcher(s).useTransparentBounds(true)
+        while (i < n) {
+            val c = s[i]
+            if (isLatin(c)) {
+                var j = i + 1
+                while (j < n && (isLatin(s[j]) || (s[j] == '\'' && j + 1 < n && isLatin(s[j + 1])))) j++
+                toks += Tok(Kind.WORD, s.substring(i, j), i, j)
+                i = j
+                continue
+            }
+            if (isDigit(c) || (c in CURRENCY && i + 1 < n && isDigit(s[i + 1]))) {
+                number.region(i, n)
+                if (number.lookingAt()) {
+                    toks += Tok(Kind.NUM, number.group(), i, number.end())
+                    i = number.end()
+                    continue
+                }
+            }
+            if (isSpace(c)) {
+                var j = i
+                while (j < n && isSpace(s[j])) j++
+                toks += Tok(Kind.SPACE, s.substring(i, j), i, j)
+                i = j
+                continue
+            }
+            if (c == '-' && i > 0 && isLatin(s[i - 1]) && i + 1 < n && isLatin(s[i + 1])) {
+                // A hyphen inside a word (t-shirt, kimo-ossan) is only a word break.
+                toks += Tok(Kind.SPACE, "-", i, i + 1)
+                i++
+                continue
+            }
+            if (s.startsWith("..", i)) {
+                var j = i
+                while (j < n && s[j] == '.') j++
+                toks += Tok(Kind.PUNCT, "...", i, j)
+                i = j
+                continue
+            }
+            if (c in EN_PUNCT) {
+                toks += Tok(Kind.PUNCT, c.toString(), i, i + 1)
+                i++
+                continue
+            }
+            var j = i
+            while (j < n && !(isLatin(s[j]) || isDigit(s[j]) || isSpace(s[j]) || s[j] in EN_PUNCT)) j++
+            var runStart = i
+            var runEnd = j
+            val lead = ArrayList<Tok>()
+            while (runStart < runEnd && s[runStart] in table.jaEdgePunct) {
+                lead += Tok(Kind.PUNCT, s[runStart].toString(), runStart, runStart + 1)
+                runStart++
+            }
+            val trail = ArrayList<Tok>()
+            while (runEnd > runStart && s[runEnd - 1] in table.jaEdgePunct) {
+                trail.add(0, Tok(Kind.PUNCT, s[runEnd - 1].toString(), runEnd - 1, runEnd))
+                runEnd--
+            }
+            toks += lead
+            if (runEnd > runStart) toks += Tok(Kind.JA, s.substring(runStart, runEnd), runStart, runEnd, Lang.JA)
+            toks += trail
+            i = j
+        }
+        return toks
+    }
+
+    private fun isSpace(c: Char) = c.code in table.spaceCodepoints
+
+    private fun punctKind(tok: Tok, prev: Tok?): String {
+        val t = tok.text
+        if (t == "." && prev != null && prev.kind == Kind.WORD && prev.text.lowercase() in table.abbreviations) return "dropped"
+        if (t in table.symbolWords) return "symbol"
+        if (t in table.terminalPunct) return "terminal"
+        if (t in clause) return "clause"
+        return "dropped"
+    }
+
+    private fun pausing(tok: Tok, prev: Tok?): Boolean = punctKind(tok, prev).let { it == "clause" || it == "terminal" }
+
+    // -- plan --------------------------------------------------------------------------------
+
+    /** [text] cut into sentences, tokens routed to English or Japanese, and segments. */
+    fun plan(text: String): List<SentencePlan> {
+        val plain = KanaText.plainLatin(text)
+        val sentences = splitSentences(plain).map { it to tokenize(it) }
+        for ((_, toks) in sentences) {
+            for (t in toks) {
+                if (t.kind == Kind.WORD) {
+                    t.word = t.text
+                    val r = english.read(t.text)
+                    t.reading = r
+                    t.route = r.route
+                }
+            }
+            // A symbol next to an English word (&, +, @, =) is said as an English word.
+            for ((k, t) in toks.withIndex()) {
+                if (t.kind == Kind.PUNCT && t.text in table.symbolWords && betweenEnglish(toks, k)) {
+                    t.kind = Kind.WORD
+                    t.route = Lang.EN
+                    t.word = table.symbolWords.getValue(t.text)
+                    t.reading = english.read(t.word)
+                }
+            }
+        }
+        val lineWords = sentences.flatMap { (_, toks) -> toks.filter { it.kind == Kind.WORD || it.kind == Kind.JA } }
+        for ((_, toks) in sentences) {
+            val words = toks.filter { it.kind == Kind.WORD || it.kind == Kind.JA }
+            for (t in toks) {
+                if (t.kind != Kind.NUM) continue
+                val after = words.firstOrNull { it.start >= t.end }
+                val before = words.lastOrNull { it.end <= t.start }
+                t.route = when {
+                    ORDINAL_END.containsMatchIn(t.text) || t.text.take(1) in ALWAYS_ENGLISH_SIGNS -> Lang.EN
+                    after != null -> after.route
+                    before != null -> before.route
+                    else -> lineWords.firstOrNull()?.route ?: Lang.JA
+                }
+            }
+            // am / pm right after an English number is said as letters (7am, 7 pm).
+            for ((k, t) in toks.withIndex()) {
+                if (t.kind == Kind.WORD && t.text.lowercase() in table.timeWords && k > 0) {
+                    var j = k - 1
+                    while (j >= 0 && toks[j].kind == Kind.SPACE) j--
+                    if (j >= 0 && toks[j].kind == Kind.NUM && toks[j].route == Lang.EN) {
+                        t.route = Lang.EN
+                        t.reading = WordReading(
+                            Lang.EN, "time", ipa = english.arpabetToIpa(table.timeWords.getValue(t.text.lowercase()))
+                        )
+                    }
+                }
+            }
+        }
+        return sentences.map { (s, toks) -> planSentence(s, toks) }
+    }
+
+    private fun isContent(t: Tok) = t.kind == Kind.WORD || t.kind == Kind.JA || t.kind == Kind.NUM
+
+    private fun betweenEnglish(toks: List<Tok>, k: Int): Boolean {
+        val prev = toks.subList(0, k).lastOrNull { isContent(it) }
+        val next = toks.subList(k + 1, toks.size).firstOrNull { isContent(it) }
+        return (prev != null && prev.kind == Kind.WORD && prev.route == Lang.EN) ||
+            (next != null && next.kind == Kind.WORD && next.route == Lang.EN)
+    }
+
+    private fun planSentence(s: String, toks: List<Tok>): SentencePlan {
+        val content = toks.indices.filter { isContent(toks[it]) }
+        val segments = ArrayList<Segment>()
+        val pauses = ArrayList<Boolean>()
+        for ((idx, k) in content.withIndex()) {
+            val t = toks[k]
+            val route = t.route ?: Lang.JA
+            if (segments.isNotEmpty() && segments.last().route == route) {
+                segments.last().toks += toks.subList(content[idx - 1] + 1, k + 1)
+                continue
+            }
+            if (segments.isNotEmpty()) {
+                val prevK = content[idx - 1]
+                pauses += (prevK + 1 until k).any { j -> toks[j].kind == Kind.PUNCT && pausing(toks[j], toks[j - 1]) }
+            } else {
+                pauses += false
+            }
+            segments += Segment(route, mutableListOf(t))
+        }
+        val trailingToks = if (content.isNotEmpty()) toks.subList(content.last() + 1, toks.size) else toks
+        val trailing = if (content.isNotEmpty()) s.substring(toks[content.last()].end) else s
+        val marks = trailingToks.filter { it.kind == Kind.PUNCT }.map { it.text }
+        val mapped = marks.mapNotNull { table.terminalPunct[it] }
+        val terminal = when {
+            "?" in mapped -> "?"
+            "!" in mapped -> "!"
+            else -> table.sentenceEndDefault
+        }
+        val verbatim = toks.filter { isContent(it) }.all { it.route == Lang.JA } && toks.none { it.kind == Kind.WORD }
+        return SentencePlan(s, toks, segments, pauses, terminal, trailing, verbatim)
+    }
+
+    // -- phonemes ----------------------------------------------------------------------------
+
+    /** An English segment's IPA: words joined by a space, a clause mark as ", ". */
+    private fun englishSegment(seg: Segment, endsSentence: Boolean): String {
+        val parts = ArrayList<String>()
+        val content = seg.toks.filter { it.kind == Kind.WORD || it.kind == Kind.NUM }
+        // A function word is said strong only where it ends the sentence (where you from?).
+        val last = if (content.isNotEmpty() && endsSentence) content.last() else null
+        var prev: Tok? = null
+        for (t in seg.toks) {
+            when (t.kind) {
+                Kind.WORD -> {
+                    val r = t.reading
+                    val ipa = if (r != null && r.source == "time") r.ipa else english.read(t.word, final = t === last).ipa
+                    if (ipa.isNotEmpty()) parts += ipa
+                }
+                Kind.NUM -> {
+                    val words = english.spellNumber(t.text)
+                    for ((k, w) in words.withIndex()) {
+                        val ipa = english.read(w, final = t === last && k == words.size - 1).ipa
+                        if (ipa.isNotEmpty()) parts += ipa
+                    }
+                }
+                Kind.PUNCT -> {
+                    if (pausing(t, prev) && parts.isNotEmpty() && parts.last() != table.clauseMark) parts += table.clauseMark
+                }
+                else -> Unit
+            }
+            prev = t
+        }
+        val out = StringBuilder()
+        for ((k, p) in parts.withIndex()) {
+            if (p == table.clauseMark) {
+                if (k < parts.size - 1) out.append(table.clauseMark).append(table.afterClause)
+                continue
+            }
+            if (out.isNotEmpty() && !out.endsWith(table.afterClause) && !out.endsWith(table.wordSeparator)) {
+                out.append(table.wordSeparator)
+            }
+            out.append(p)
+        }
+        return out.toString()
+    }
+
+    /**
+     * A Japanese segment's text for Open JTalk: the sentence's own characters, her romaji
+     * words as their kana and the spaces beside those words gone; the last segment also
+     * takes the sentence's trailing marks.
+     */
+    fun japaneseText(plan: SentencePlan, seg: Segment, last: Boolean): String {
+        val out = StringBuilder()
+        val toks = seg.toks
+        for ((k, t) in toks.withIndex()) {
+            when (t.kind) {
+                Kind.WORD -> out.append(t.reading?.kana ?: "")
+                Kind.SPACE -> {
+                    val prevWord = k > 0 && toks[k - 1].kind == Kind.WORD
+                    val nextWord = k + 1 < toks.size && toks[k + 1].kind == Kind.WORD
+                    if (!(prevWord || nextWord)) out.append(t.text)
+                }
+                else -> out.append(plan.text, t.start, t.end)
+            }
+        }
+        if (last) out.append(plan.trailing)
+        return out.toString()
+    }
+
+    private fun japanesePhonemes(text: String, labelsOf: (String) -> List<String>?): List<String> =
+        JapanesePhonemes.phonemize(text, labelsOf).flatten()
+
+    /**
+     * [text] (already through the speech normalizer) to one list of single-codepoint
+     * phonemes per sentence, with Open JTalk's labels from [labelsOf]. Null when a piece
+     * that has letters or digits gives nothing (Open JTalk refused it, or another script),
+     * so that another voice says the line, as [JapanesePhonemes.phonemizeAll] does.
+     */
+    fun phonemize(text: String, labelsOf: (String) -> List<String>?): List<List<String>>? {
+        val out = ArrayList<List<String>>()
+        for (plan in plan(text)) {
+            if (plan.verbatim) {
+                val ph = japanesePhonemes(plan.text, labelsOf)
+                if (ph.isNotEmpty()) out += ph
+                else if (pyHasAlnum(plan.text)) return null
+                continue
+            }
+            val phones = ArrayList<String>()
+            for ((k, seg) in plan.segments.withIndex()) {
+                val last = k == plan.segments.size - 1
+                if (k > 0) phones += codepoints(if (plan.pauses[k]) table.clauseMark + table.afterClause else table.switchMark)
+                if (seg.route == Lang.EN) {
+                    phones += codepoints(englishSegment(seg, last))
+                } else {
+                    val jt = japaneseText(plan, seg, last)
+                    var ph = japanesePhonemes(jt, labelsOf)
+                    if (ph.isEmpty()) {
+                        if (pyHasAlnum(jt)) return null
+                        continue
+                    }
+                    // Open JTalk ends every piece; only the sentence's last piece keeps it.
+                    if (!last && (ph.last() == "." || ph.last() == "?")) ph = ph.dropLast(1)
+                    phones += ph
+                }
+            }
+            if (plan.segments.isNotEmpty() && plan.segments.last().route == Lang.EN) phones += plan.terminal
+            // A switch that ended up next to nothing (an empty piece) leaves no stray space.
+            while (phones.isNotEmpty() && (phones[0] == " " || phones[0] == ",")) phones.removeAt(0)
+            if (phones.isNotEmpty()) out += phones
+        }
+        return out
+    }
+
+    companion object {
+        // Python's \s (str.isspace): ASCII whitespace with the four separators U+001C-U+001F,
+        // and the Unicode spaces.
+        private const val PY_SPACE = "\\t\\n\\x0B\\f\\r\\x1C-\\x20\\x85\\xA0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000"
+        private const val CLOSERS = "」』）】〉》”’\"')\\]"
+
+        // Piper's _SENTENCE_END_PATTERN, plus an ASCII "." that ends a sentence: followed by
+        // optional closers and then whitespace or the end, and not part of "..".
+        private val SENT_END = Regex(
+            "(?:[。．！？!?]+|(?<!\\.)\\.(?!\\.)(?=[$CLOSERS]*(?:[$PY_SPACE]|\\z)))[$CLOSERS$PY_SPACE]*"
+        )
+        private val NUMBER = Regex("[¥￥\$€]?[0-9０-９]+(?:[,.:][0-9０-９]+)*(?:(?:st|nd|rd|th)(?![A-Za-z]))?%?")
+        private val ORDINAL_END = Regex("(?:st|nd|rd|th)%?\\z")
+        private const val CURRENCY = "¥￥\$€"
+        private const val ALWAYS_ENGLISH_SIGNS = "\$€"
+        private val EN_PUNCT: Set<Char> = ("!\"#\$%&'()*+,-./:;<=>?@[\\]^_`{|}~" + "…‥—–―“”‘’").toSet()
+
+        private fun isLatin(c: Char) = c in 'a'..'z' || c in 'A'..'Z'
+        private fun isDigit(c: Char) = c in '0'..'9' || c in '０'..'９'
+
+        /** Python's str.isspace() for one character. */
+        internal fun pyIsSpace(c: Char): Boolean = when (c.code) {
+            in 0x09..0x0D, in 0x1C..0x20, 0x85, 0xA0, 0x1680, in 0x2000..0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000 -> true
+            else -> false
+        }
+
+        /** Python's str.strip(). */
+        internal fun pyStrip(s: String): String = s.trim { pyIsSpace(it) }
+
+        /** Python's any(c.isalnum() for c in s): a letter or a number of any script. */
+        internal fun pyHasAlnum(s: String): Boolean = s.codePoints().anyMatch { cp ->
+            Character.isLetter(cp) || when (Character.getType(cp).toByte()) {
+                Character.DECIMAL_DIGIT_NUMBER, Character.LETTER_NUMBER, Character.OTHER_NUMBER -> true
+                else -> false
+            }
+        }
+
+        /** A string as one string per codepoint, the way the voice takes its phonemes. */
+        internal fun codepoints(s: String): List<String> {
+            val out = ArrayList<String>(s.length)
+            var i = 0
+            while (i < s.length) {
+                val cp = s.codePointAt(i)
+                out += String(Character.toChars(cp))
+                i += Character.charCount(cp)
+            }
+            return out
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/own/OpenJTalk.kt b/app/src/main/java/com/opendroid/ai/core/voice/own/OpenJTalk.kt
new file mode 100644
index 0000000..c06dd4a
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/own/OpenJTalk.kt
@@ -0,0 +1,66 @@
+package com.opendroid.ai.core.voice.own
+
+import java.io.Closeable
+
+/**
+ * Open JTalk's text front end on the phone (libyumejtalk.so): Japanese text in,
+ * full-context labels out, from the dictionary in [dictionaryDir]. The same steps and
+ * the same dictionary that made her voice's training labels, so the phone reads her
+ * text the way the voice learned it. Runs offline; nothing leaves the phone.
+ */
+class OpenJTalk private constructor(private var handle: Long) : Closeable {
+
+    /** The labels for one sentence, or null if Open JTalk could not read it. */
+    @Synchronized
+    fun labels(sentence: String): List<String>? {
+        check(handle != 0L) { "closed" }
+        val safe = withLongKanaRunsBroken(sentence)
+        if (safe.toByteArray(Charsets.UTF_8).size > MAX_SENTENCE_BYTES) return null
+        return nativeLabels(handle, safe)?.toList()
+    }
+
+    @Synchronized
+    override fun close() {
+        if (handle != 0L) nativeClose(handle)
+        handle = 0L
+    }
+
+    companion object {
+        /** The native side refuses longer input; sentences are split before this. */
+        const val MAX_SENTENCE_BYTES = 4096
+
+        /** The longest run of katakana handed to Open JTalk without a break. */
+        const val MAX_KANA_RUN = 100
+
+        private val LONG_KANA_RUN = Regex("[ァ-ヺーｦ-ﾟ]{${MAX_KANA_RUN + 1},}")
+
+        /**
+         * [sentence] with every katakana run longer than [MAX_KANA_RUN] broken by a 、.
+         * Open JTalk chains such a run (zzzz…, ッッッ…) back into one word and copies it
+         * into a 1024-byte buffer of its own, which aborts the whole app. A 、 ends the
+         * chain, and 100 kana are at most 300 bytes.
+         */
+        fun withLongKanaRunsBroken(sentence: String): String =
+            LONG_KANA_RUN.replace(sentence) { run -> run.value.chunked(MAX_KANA_RUN).joinToString("、") }
+
+        @Volatile private var loaded = false
+
+        /** Loads the dictionary, or returns null if it cannot be read. */
+        fun open(dictionaryDir: String): OpenJTalk? {
+            if (!loaded) {
+                synchronized(this) {
+                    if (!loaded) {
+                        System.loadLibrary("yumejtalk")
+                        loaded = true
+                    }
+                }
+            }
+            val handle = nativeOpen(dictionaryDir)
+            return if (handle == 0L) null else OpenJTalk(handle)
+        }
+
+        @JvmStatic private external fun nativeOpen(dicDir: String): Long
+        @JvmStatic private external fun nativeLabels(handle: Long, text: String): Array<String>?
+        @JvmStatic private external fun nativeClose(handle: Long)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/voice/own/OwnVoice.kt b/app/src/main/java/com/opendroid/ai/core/voice/own/OwnVoice.kt
