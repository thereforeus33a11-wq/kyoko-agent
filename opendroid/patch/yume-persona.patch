+
+    @Test
+    fun `her eyes - an unchecked description and a look her eyes could not make are counted by category`() {
+        val eyes = HostEyes()
+        hostEyes = eyes
+        sources.articleImage = "https://upload.wikimedia.org/egg.jpg"
+        mind.config = LLMConfig(personaOwnLife = true, personaEyes = true)
+        eyes.seen.addLast(HerEyes.Seen.NotSeen(HerEyes.Why.BALANCE))
+        eyes.seen.addLast(HerEyes.Seen.Described("UNCHECKED_SENTINEL a woman.", KidGuard.Ages.Unchecked))
+        val host = host()
+        host.start(room)
+        reply("do: open 1", "do: look 1", "do: look 1", "do: done")
+        started(host)
+        val e = entry()
+        assertEquals(1, e.refusals[OutingHost.EYES_PREFIX + "BALANCE"])
