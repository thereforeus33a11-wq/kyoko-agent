+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CheckInRuleTest {
+
+    private val hour = 60L * 60 * 1000
+    private val now = 1_000 * hour
+
+    private fun owner(hoursAgo: Long) =
+        ChatMessage(id = "o$hoursAgo", text = "hi", sender = Sender.USER, timestamp = now - hoursAgo * hour)
+    private fun yume(hoursAgo: Long) =
+        ChatMessage(id = "y$hoursAgo", text = "mm", sender = Sender.AGENT, modelBadge = PersonaPrompts.BADGE, timestamp = now - hoursAgo * hour)
+
+    private fun due(messages: List<ChatMessage>, hourOfDay: Int = 15, lastCheckInHoursAgo: Long? = null) =
+        CheckInRule.isDue(messages, now, hourOfDay, lastCheckInHoursAgo?.let { now - it * hour } ?: 0L)
+
+    @Test
+    fun `a long silence after a real exchange is due`() {
+        assertTrue(due(listOf(owner(5), yume(5))))
+        assertEquals(5, CheckInRule.hoursQuiet(listOf(owner(5), yume(5)), now))
+    }
+
+    @Test
+    fun `she never opens an empty chat or one he has not written in`() {
+        assertFalse(due(emptyList()))
+        assertFalse(due(listOf(yume(9))))
+    }
+
+    @Test
+    fun `not while the talk is still warm`() {
+        assertFalse(due(listOf(owner(1), yume(1))))
+    }
+
+    @Test
+    fun `not at night`() {
+        assertFalse(due(listOf(owner(5), yume(5)), hourOfDay = 3))
+        assertFalse(due(listOf(owner(5), yume(5)), hourOfDay = 23))
+        assertTrue(due(listOf(owner(5), yume(5)), hourOfDay = 9))
+    }
+
+    @Test
+    fun `one unprompted line per silence, and a long gap between them`() {
+        // She wrote first 8 hours ago and he never answered: stay quiet.
+        assertFalse(due(listOf(owner(20), yume(20), yume(8)), lastCheckInHoursAgo = 8))
+        // He answered since, but her last one was only 4 hours ago.
+        assertFalse(due(listOf(owner(3), yume(3)), lastCheckInHoursAgo = 4))
+        // He answered since and enough time has passed.
+        assertTrue(due(listOf(owner(4), yume(4)), lastCheckInHoursAgo = 9))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaActionsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaActionsTest.kt
new file mode 100644
