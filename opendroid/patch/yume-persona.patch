+            "\"'(I am terribly sorry!   --   but   as an AI" + " ".repeat(20) + "x".repeat(20) +
+                ", I will not be able to assist you with describing $thing"
+        )
+        for (form in longest) {
+            assertTrue(form, AssistantRefusal.opens(form))
+            // The start of the next sentence is looked at behind it, and has to be in hand too.
+            val withNext = "$form......\"')      x"
+            assertFalse(withNext, AssistantRefusal.opens(withNext))
+            assertTrue(form, withNext.length <= AssistantRefusal.HOLD_CHARS)
