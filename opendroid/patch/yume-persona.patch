+            val forHer = withoutWriter(line)
+            if (forHer.isBlank() && line.isNotBlank()) continue
+            val known = (if (keepBuried) withoutPointers(forHer) else withoutBuried(forHer)) ?: continue
+            kept += known.trimEnd()
