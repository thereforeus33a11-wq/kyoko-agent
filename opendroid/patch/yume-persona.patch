+    @Test
+    fun `a test that was refused on the phone is not called a failed connection`() {
+        val refused = connectionStatusLabel(failed(LLMError.PrivateRouteRequired))
+        assertEquals(
+            "Not sent: \"Where a model may run\" under Privacy refuses the route of the model selected for this provider. " +
+                "The key and the network were not tried.",
+            refused
+        )
+        // That refusal is raised before a request is built.
+        assertTrue(source("core/llm/LLMProviderFactory.kt").contains("throw LLMErrorMapper.privateRouteRequired(provider, model)"))
+
+        for (error in listOf(
+            LLMError.PrivateRouteRequired, LLMError.PlainHttpRefused, LLMError.EncryptedModelOnPlainProvider,
+            LLMError.EncryptedModelAtOtherAddress, LLMError.AddressMissing
+        )) {
+            assertTrue(error.code, connectionStatusLabel(failed(error)).startsWith("Not sent: "))
+        }
+        // Every failure is named for what it was; none is a bare "Connection failed".
+        for (error in everyFailure) {
+            val label = connectionStatusLabel(failed(error))
+            assertNotEquals(error.code, "Connection failed", label)
+            assertTrue(error.code, label.isNotBlank())
+        }
+        assertEquals("Encryption check failed", connectionStatusLabel(failed(LLMError.EncryptionCheckFailed)))
+        assertEquals("Model unavailable", connectionStatusLabel(failed(LLMError.ModelUnavailable)))
+    }
