+    }
+
+    @Test
+    fun `a row of very many lines is marked as cut at its end`() {
+        val many = (1..12).joinToString("\n") { "line $it" }
+        val line = PersonaPrompts.shapeHistory(listOf(app(many))).deviceActivity.single()
+        assertTrue(line, line.startsWith("line 1 / line 2"))
