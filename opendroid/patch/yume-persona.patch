+        assertTrue(stopped.contains("PersonaPrompts.replyBadge(sawScreen, stopped = true)"))
+        // A command in a stopped reply never runs: the stop is passed on before anything else.
+        assertFalse(stopped.contains("runPersonaAction"))
+        assertTrue(chat.indexOf("throw streamError") < chat.indexOf("runPersonaAction("))
+
+        val failed = chat.substringAfter("} catch (streamError: LLMException) {").substringBefore("publishChatError(")
+        assertTrue(failed.contains("if (inserted && shownText.isNotBlank()) {"))
+        assertTrue(failed.contains("replyMsg.copy(text = shownText)"))
+        assertTrue(failed.contains(keepsThoughts))
+        assertFalse(failed.replace(keepsThoughts, "").contains("currentReplyText"))
