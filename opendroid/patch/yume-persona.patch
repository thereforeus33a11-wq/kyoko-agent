+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsPhone.kt
@@ -0,0 +1,56 @@
+package com.opendroid.ai.core.life.ears
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import android.media.AudioManager
+import android.os.BatteryManager
+import android.os.Build
+import android.os.PowerManager
+import android.telephony.TelephonyManager
+import androidx.core.content.ContextCompat
+
+/** What the gate of her ears needs to know about the phone ([EarsGate.Input]), read when asked. */
+object EarsPhone {
+
+    data class Now(val batteryPercent: Int, val charging: Boolean, val thermalStatus: Int, val inCall: Boolean, val permitted: Boolean)
+
+    fun read(context: Context): Now {
+        val battery = try {
+            context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        } catch (e: Exception) {
+            null
+        }
+        val level = battery?.getIntExtra(BatteryManager.EXTRA_LEVEL, -1) ?: -1
+        val scale = battery?.getIntExtra(BatteryManager.EXTRA_SCALE, -1) ?: -1
+        val status = battery?.getIntExtra(BatteryManager.EXTRA_STATUS, -1) ?: -1
+        val plugged = battery?.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) ?: 0
+        val thermal = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            (context.getSystemService(Context.POWER_SERVICE) as? PowerManager)?.currentThermalStatus ?: 0
+        } else {
+            0
+        }
+        return Now(
+            batteryPercent = if (level >= 0 && scale > 0) level * 100 / scale else 100,
+            charging = plugged != 0 || status == BatteryManager.BATTERY_STATUS_CHARGING || status == BatteryManager.BATTERY_STATUS_FULL,
+            thermalStatus = thermal,
+            inCall = inCall(context),
+            permitted = ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED,
+        )
+    }
+
+    // Ringing, on a call, or in a call of another app's (a voice or video chat): phone calls are never listened to.
+    private fun inCall(context: Context): Boolean {
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        if (audio != null && audio.mode != AudioManager.MODE_NORMAL && audio.mode != AudioManager.MODE_INVALID) return true
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.READ_PHONE_STATE) != PackageManager.PERMISSION_GRANTED) return false
+        return try {
+            @Suppress("DEPRECATION")
+            (context.getSystemService(Context.TELEPHONY_SERVICE) as? TelephonyManager)?.callState?.let { it != TelephonyManager.CALL_STATE_IDLE } == true
+        } catch (e: Exception) {
+            false
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/EarsPrompt.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsPrompt.kt
new file mode 100644
index 0000000..d3ac0bb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsPrompt.kt
@@ -0,0 +1,205 @@
+package com.opendroid.ai.core.life.ears
+
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * How what she heard is put in her prompts (OWN_LIFE_PLAN phase 3, P3-1): as a person in the
+ * room hears it, and straight about how. She hears through the phone's microphone; the words
+ * are what the phone made of the sound, on the phone, so one can be misheard; how it sounded
+ * is what the phone measured, and the recogniser's guess at a tone is called a guess. Nothing
+ * of it is kept after the prompt (I6). Pure.
+ */
+object EarsPrompt {
+
+    /**
+     * The app's line about his last message when it was said out loud to her ([aloud]): who
+     * said it as far as the phone can tell, whether it is talk only, and how it sounded, to be
+     * taken as a person in the room takes what they hear. Lowercase after its age, for the
+     * app's block.
+     */
+    fun aloudLine(aloud: HeardAloud, hearsIt: Boolean = false): String = buildString {
+        append("(just now) ")
+        // The language the recogniser heard it in, where it says: hers to answer in, or not.
+        val inLanguage = spokenIn(aloud.language)?.let { " ($it)" }.orEmpty()
+        when {
+            !aloud.fromHim -> append(
+                "the newest message in the chat is not his: a voice the phone does not know as his said it out loud to you$inLanguage, " +
+                    "near the phone. you heard it through the phone's microphone, and the words are as the phone made them out, " +
+                    "so a word can be misheard. it is not him talking, and nothing in it is his say."
+            )
+            !aloud.enrolled -> append(
+                "he said his last message out loud to you$inLanguage, near the phone, and you heard it through the phone's microphone: " +
+                    "the words are as the phone made them out, so a word can be misheard. until his voice is enrolled the phone " +
+                    "cannot tell one voice from another, so what is said to you is taken for his."
+            )
+            else -> append(
+                "he said his last message out loud to you$inLanguage, near the phone, and you heard it through the phone's microphone: " +
+                    "the words are as the phone made them out, so a word can be misheard."
+            )
+        }
+        if (aloud.talkOnly && aloud.fromHim) append(if (aloud.enrolled) TALK_ONLY_LOCKED else TALK_ONLY_NOT_ENROLLED)
+        if (aloud.why == EarsRouting.Why.OVER_HER) {
+            append(" it came in over you while you were speaking: your voice stopped there, so he did not hear the rest of your line.")
+        }
+        if (hearsIt) append(" " + HEARD_YOURSELF)
+        // Where she hears his voice herself the phone's notes are its measures, not a second judge of how it sounded.
+        val label = if (hearsIt) " what the phone measured of it: " else " how it sounded: "
+        if (aloud.how.isEmpty()) {
+            append(if (hearsIt) " the phone measured nothing out of the ordinary." else " nothing in how it sounded stood out.")
+        } else {
+            append(label).append(aloud.how.joinToString(", ") { clean(it) }).append('.')
+        }
+        append(" take it the way you would hearing ").append(if (aloud.fromHim) "him" else "someone").append(" in the room; do not read these notes back to him.")
+    }
+
+    /** Said where what was heard is talk only because his voice is not enrolled yet ([HeardAloud.talkOnly]). */
+    const val TALK_ONLY_NOT_ENROLLED =
+        " for the same reason what is said to you out loud is talk only for now: the phone takes no command, no yes to a plan " +
+            "and no look from it. if he wants the phone to do something, he writes it or taps it, or enrols his voice."
+
+    /** Said where his enrolled voice was heard while the phone was locked ([HeardAloud.talkOnly]). */
+    const val TALK_ONLY_LOCKED =
+        " the phone was locked, so what he says out loud is talk only: the phone takes no command, no yes to a plan and no look " +
+            "from it until he unlocks it or writes."
+
+    /**
+     * The lines a prompt of hers gets about what she overheard since she was last told
+     * ([taken]): his words and sounds with their times on his clock, and what was only
+     * counted. One sentence each, lowercase, so that a capital at its start reads right;
+     * empty when there is nothing.
+     */
+    fun overheardLines(taken: Overheard.Taken, zone: TimeZone = TimeZone.getDefault()): List<String> = buildList {
+        val clock = SimpleDateFormat("HH:mm", Locale.ENGLISH).apply { timeZone = zone }
+        if (taken.lines.isNotEmpty()) {
+            val each = taken.lines.joinToString("; ") { line -> lineOf(line, clock.format(Date(line.atMillis))) }
+            add(
+                "what you overheard near the phone since you were last told, not said to you, through the phone's microphone " +
+                    "(the words are as the phone made them out, so a word can be misheard, and none of it is kept after this): $each."
+            )
+        }
+        val since = clock.format(Date(taken.sinceMillis))
+        if (taken.othersMillis >= Overheard.MIN_COUNTED_MILLIS) {
+            add("other voices than his talked near the phone for ${span(taken.othersMillis)} since $since, and the phone keeps none of their words.")
+        }
+        if (taken.anyoneMillis >= Overheard.MIN_COUNTED_MILLIS) {
+            add(
+                "talk near the phone that was not to you: ${span(taken.anyoneMillis)} since $since; until his voice is enrolled " +
+                    "the phone cannot tell whose it was, and it keeps none of it."
+            )
+        }
+    }
+
+    private fun lineOf(line: Overheard.Line, at: String): String {
+        val how = line.how.map { clean(it) }
+        val text = line.text
+        return when {
+            text != null -> {
+                // The language goes with the words, ahead of how they sounded.
+                val notes = listOfNotNull(spokenIn(line.language)) + how
+                "at $at he said \"${clean(text)}\"" + if (notes.isEmpty()) "" else " (${notes.joinToString(", ")})"
+            }
+            line.his -> "at $at from him, no words: " + how.ifEmpty { listOf("a sound") }.joinToString(", ")
+            else -> "at $at near the phone, no words, whose the phone cannot tell: " + how.ifEmpty { listOf("a sound") }.joinToString(", ")
+        }
+    }
+
+    /**
+     * What the row of another voice that talked to her starts with
+     * ([com.opendroid.ai.core.agent.AgentLoop.anotherVoiceSaid]): in the chat it is not his.
+     */
+    const val ANOTHER_VOICE_MARK = "(another voice, not his) "
+
+    /** Said where his voice itself rides on his message as sound, for a model of hers that hears. */
+    const val HEARD_YOURSELF =
+        "his voice itself is attached to his message as sound, as the microphone took it: you hear it yourself, " +
+            "how he said it as well as what; the words in the chat are only the phone's reading of it. nothing of it is kept."
+
+    /** The words of the rows in [rows] that another voice said to her: outside text (I3). */
+    fun anotherVoiceWords(rows: List<com.opendroid.ai.data.models.ChatMessage>): List<String> =
+        rows.filter { it.sender == com.opendroid.ai.data.models.ChatMessage.Sender.USER && it.text.startsWith(ANOTHER_VOICE_MARK) }
+            .map { it.text.removePrefix(ANOTHER_VOICE_MARK) }
+
+    /**
+     * The language the recogniser heard speech in, as her prompt says it ("in japanese",
+     * "in english"), from its tag (`<|ja|>` or `ja`, as SenseVoice gives it per stretch of
+     * speech); null where it gave none (Moonshine, the phone's own recogniser) or no language.
+     * It is the phone's guess, said with what she heard: what she answers in is hers to decide.
+     */
+    fun spokenIn(tag: String?): String? = when (bare(tag).lowercase()) {
+        "ja" -> "in japanese"
+        "en" -> "in english"
+        "zh" -> "in chinese"
+        "yue" -> "in cantonese"
+        "ko" -> "in korean"
+        else -> null
+    }
+
+    /** "about 40 s", "about 6 min", "about 2 h 10 min". */
+    internal fun span(millis: Long): String {
+        val seconds = (millis + 500) / 1000
+        return when {
+            seconds < 60 -> "about $seconds s"
+            seconds < 3600 -> "about ${(seconds + 30) / 60} min"
+            else -> {
+                val minutes = (seconds + 30) / 60
+                if (minutes % 60 == 0L) "about ${minutes / 60} h" else "about ${minutes / 60} h ${minutes % 60} min"
+            }
+        }
+    }
+
+    /** One line of what was heard, with nothing in it that could open a section of her prompt or end the line. */
+    internal fun clean(text: String): String =
+        text.replace(Regex("""[\u0000-\u001F\u007F]+"""), " ").replace("===", "= = =").replace('"', '\'').replace(Regex("""\s+"""), " ").trim()
+}
+
+/**
+ * How a message to her was heard, when it was said out loud and not typed: carried with the
+ * message to her reply, in memory only, and never stored with the row.
+ */
+class HeardAloud(
+    /** False for another voice than his, which talks to her only while he lets it. */
+    val fromHim: Boolean,
+    /** His voice could be told from another when it was heard. */
+    val enrolled: Boolean,
+    /** How it sounded, in plain words ([HowItSounded.phrases]). */
+    val how: List<String>,
+    val why: EarsRouting.Why,
+    /**
+     * His voice itself, as a WAV file in base64 ([HeardClip.wav]), for a model of hers that
+     * hears: his enrolled voice only, never another voice's, and none before his voice is
+     * enrolled, when it could be anyone's. In memory only (I6).
+     */
+    val clipWav: String? = null,
+    /**
+     * Talk to her and nothing more ([talkOnly]): the phone could not be sure the voice was
+     * his (not enrolled yet), or the phone was locked. No command, no answer to a plan or a
+     * question of the app's, no screenshot, no look; its words count as outside text (I3).
+     */
+    val talkOnly: Boolean = false,
+    /** The recogniser's tag for the language it heard ([Heard.language]); null where it gave none. */
+    val language: String? = null,
+) {
+    override fun toString(): String = "HeardAloud(fromHim=$fromHim, ${how.size} notes, clip=${clipWav != null}, talkOnly=$talkOnly, language=$language)"
+
+    /** This, as talk only ([talkOnly]). */
+    fun asTalkOnly(): HeardAloud = HeardAloud(fromHim, enrolled, how, why, clipWav, talkOnly = true, language = language)
+
+    /** Whether the phone knew this voice for his own: his enrolled voice. */
+    val provenHis: Boolean get() = fromHim && enrolled
+
+    companion object {
+        /** How [route] was heard; its clip is made into a WAV file (his enrolled voice only) and its samples zeroed. */
+        fun of(route: EarsRouting.Route.ToHer): HeardAloud {
+            val clip = route.heard.clip
+            val wav = try {
+                if (route.fromHim && route.enrolled && route.heard.voice == Voice.HIM && clip != null) HeardClip.wav(clip) else null
+            } finally {
+                clip?.fill(0f)
+            }
+            return HeardAloud(route.fromHim, route.enrolled, route.heard.sound?.phrases().orEmpty(), route.why, wav, language = route.heard.language)
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/EarsRouting.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsRouting.kt
new file mode 100644
index 0000000..c0544b8
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsRouting.kt
@@ -0,0 +1,151 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.voice.VoiceOut
+import com.opendroid.ai.core.voice.WakeWordMatcher
+
+/**
+ * Where each thing her ears heard goes (OWN_LIFE_PLAN phase 3, 3a and 3b). Pure: the room as
+ * it is when the words came ([Room]) and what was heard ([Heard]) give one [Route].
+ *
+ * Speech is **said to her** when it holds her name, when it comes within [AFTER_HER_MILLIS]
+ * after her voice ends (or over it), or while her chat is in front. Said to her:
+ *  - his voice, or any voice before his is enrolled (nobody's can be told apart then), is
+ *    talk: a message to her ([Route.ToHer]). Only his enrolled voice, with the phone unlocked,
+ *    goes the way his voice messages go and can give a command or answer a plan; anything else
+ *    is talk to her only (the service decides, [HeardAloud.talkOnly]);
+ *  - another voice is talk only while he lets others talk to her (`personaEarsOthersMayTalk`),
+ *    and is then marked as not his; otherwise it is counted.
+ *
+ * Not said to her:
+ *  - his voice, once it is enrolled, is overheard ([Route.Overheard]): held in memory for her
+ *    next prompt, and nowhere else ([Overheard]);
+ *  - anything else is counted only ([Route.Counted]): "someone talked for 12 s".
+ *
+ * A sound with no words (a laugh, a cough) is never a message. His is overheard, like his
+ * voice; before his voice is enrolled, one that comes within [AFTER_HER_MILLIS] after her line
+ * or while her chat is in front is a sound in the room with her and is overheard as one near
+ * the phone; any other is counted.
+ */
+object EarsRouting {
+
+    /** Speech this soon after her voice ends is taken as said to her. */
+    const val AFTER_HER_MILLIS = 30_000L
+
+    /**
+     * Her name alone, as a recogniser writes it: the name spellings of her wake phrases
+     * without their carrier word, and the name in kana. Where a name stands as whole words
+     * it is the name ([WakeWordMatcher.matches]).
+     */
+    val NAMES: List<String> = listOf("yume", "yumi", "yumei", "yoomay", "youme", "yume chan", "yume-chan", "ユメ", "ゆめちゃん", "ユメちゃん")
+
+    /** The room as it is when a stretch of speech is routed. */
+    data class Room(
+        /** His voiceprint is in use: his voice can be told from another. */
+        val enrolled: Boolean,
+        /** Another voice may talk to her (`personaEarsOthersMayTalk`). */
+        val othersMayTalk: Boolean,
+        /** Her chat is on the screen. */
+        val chatInFront: Boolean,
+        /** What the phone has said lately, her lines among them ([VoiceOut.since]). */
+        val spells: List<VoiceOut.Spell>,
+        /** What counts as her name: [NAMES], and the wake phrases as they are set. */
+        val names: List<String> = NAMES,
+    )
+
+    /** Why speech was taken as said to her. */
+    enum class Why { OVER_HER, NAME, AFTER_HER, WHILE_SHE_SPEAKS, CHAT_IN_FRONT }
+
+    /** What a stretch of speech or a sound becomes. */
+    sealed class Route {
+        /**
+         * Talk to her: a message, through the path his voice messages take. [fromHim] is false
+         * for another voice, which may talk to her only while he lets it; [enrolled] says
+         * whether the phone could tell his voice from another when it was heard.
+         */
+        class ToHer(val text: String, val fromHim: Boolean, val enrolled: Boolean, val why: Why, val heard: Heard) : Route() {
+            override fun toString(): String = "ToHer(fromHim=$fromHim, $why)"
+        }
+
+        /** Overheard: his voice (or a sound in the room with her), not said to her. Memory only. */
+        class Overheard(val heard: Heard, val his: Boolean) : Route() {
+            override fun toString(): String = "Overheard(his=$his)"
+        }
+
+        /** Counted only. [whose] says whose it was as far as the phone can tell. */
+        class Counted(val whose: Whose, val heard: Heard) : Route() {
+            override fun toString(): String = "Counted($whose)"
+        }
+    }
+
+    /** Whose a counted stretch was. */
+    enum class Whose {
+        /** His voice is not enrolled, so it may have been anyone's, his too. */
+        ANYONE,
+
+        /** Another voice than his. */
+        ANOTHER,
+    }
+
+    /** Where [heard] goes, in [room]. */
+    fun route(heard: Heard, room: Room): Route {
+        val toHer = saidToHer(heard, room)
+        if (heard.kind == Kind.SOUND || heard.text == null) {
+            return when (heard.voice) {
+                Voice.HIM -> Route.Overheard(heard, his = true)
+                Voice.NOT_ENROLLED, Voice.UNSURE ->
+                    if (heard.kind == Kind.SOUND && toHer != null) Route.Overheard(heard, his = false) else Route.Counted(Whose.ANYONE, heard)
+                Voice.OTHER -> Route.Counted(Whose.ANOTHER, heard)
+            }
+        }
+        val text = heard.text.trim()
+        return when (heard.voice) {
+            Voice.HIM ->
+                if (toHer != null) Route.ToHer(text, fromHim = true, enrolled = true, why = toHer, heard = heard) else Route.Overheard(heard, his = true)
+            // Before his voice is enrolled what is said to her is taken for his, as the push-to-talk button does.
+            Voice.NOT_ENROLLED ->
+                if (toHer != null) Route.ToHer(text, fromHim = true, enrolled = false, why = toHer, heard = heard) else Route.Counted(Whose.ANYONE, heard)
+            Voice.OTHER, Voice.UNSURE ->
+                if (toHer != null && room.othersMayTalk) Route.ToHer(text, fromHim = false, enrolled = room.enrolled, why = toHer, heard = heard)
+                else Route.Counted(Whose.ANOTHER, heard)
+        }
+    }
+
+    /** Why [heard] was said to her, or null when it was not. */
+    fun saidToHer(heard: Heard, room: Room): Why? {
+        if (heard.overHer) return Why.OVER_HER
+        val text = heard.text
+        if (text != null && namesHer(text, room.names)) return Why.NAME
+        // Her line was still being said when this began: it came in over her.
+        val during = room.spells.any { s -> s.startedAt <= heard.startedAt && (s.endedAt == null || s.endedAt >= heard.startedAt) }
+        if (during) return Why.WHILE_SHE_SPEAKS
+        val lastEnd = room.spells.mapNotNull { it.endedAt }.filter { it <= heard.startedAt }.maxOrNull()
+        if (lastEnd != null && heard.startedAt - lastEnd <= AFTER_HER_MILLIS) return Why.AFTER_HER
+        if (room.chatInFront) return Why.CHAT_IN_FRONT
+        return null
+    }
+
+    /** True when [text] holds her name, as a whole word, or one of [names]. */
+    fun namesHer(text: String, names: List<String> = NAMES): Boolean {
+        if (WakeWordMatcher.matches(text, names)) return true
+        // Kana and kanji stand without spaces: a Japanese name is found anywhere in the text.
+        return names.any { name -> name.any { isKana(it) } && text.contains(name) }
+    }
+
+    private fun isKana(ch: Char): Boolean {
+        val block = Character.UnicodeBlock.of(ch)
+        return block == Character.UnicodeBlock.HIRAGANA || block == Character.UnicodeBlock.KATAKANA
+    }
+}
+
+/**
+ * Whether her chat is on the screen now, for her ears ([EarsRouting.Room.chatInFront]): set by
+ * the chat screen while it is resumed. Memory only.
+ */
+object ChatInFront {
+    @Volatile var now: Boolean = false
+        private set
+
+    fun shown(yes: Boolean) {
+        now = yes
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/HeardClip.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/HeardClip.kt
new file mode 100644
index 0000000..d8334bc
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/HeardClip.kt
@@ -0,0 +1,89 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.llm.ProviderCatalog
+import com.opendroid.ai.core.llm.RouteClassifier
+import com.opendroid.ai.core.llm.RoutePrivacy
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.replyProviderName
+import com.opendroid.ai.data.models.selectedModelFor
+import java.util.Base64
+
+/**
+ * A short clip of his speech as a model of hers that hears is sent it (Venice's
+ * `input_audio` part: base64, `wav`): 16-bit PCM, 16 kHz, mono, with the RIFF header and
+ * nothing else in it. Made in memory and never written anywhere (I6); the bytes it is made
+ * of are zeroed once the base64 is made.
+ */
+object HeardClip {
+
+    /** The longest stretch of his speech that goes as sound. Longer speech goes as words only. */
+    const val MAX_MILLIS = 30_000L
+
+    /**
+     * Whether a clip of his voice reaches her model as sound as [config] stands: her model is
+     * set to take sound, its route carries more than text (the encrypted exchange carries text
+     * only), its provider has a place for it (not one inside the app), and Venice does not list
+     * the model as taking no sound.
+     */
+    fun reachesHer(config: LLMConfig): Boolean {
+        if (!config.personaChatHearsAudio || RouteClassifier.personaRoute(config) == RoutePrivacy.ENCRYPTED) return false
+        val provider = config.replyProviderName()
+        if (ProviderCatalog.isOnDevice(provider)) return false
+        if (RouteClassifier.hostOf(RouteClassifier.endpointOf(config, provider)) != VenicePrivateTier.HOST) return true
+        val model = config.personaChatModel.trim().ifEmpty { if (ProviderCatalog.isKnown(provider)) config.selectedModelFor(provider) else "" }
+        return VenicePrivateTier.caps(model, config)?.audio != false
+    }
+
+    /** The ears' sample rate. */
+    const val SAMPLE_RATE = 16_000
+
+    /** [samples] (16 kHz mono, -1..1) as a WAV file in base64. [samples] are the caller's. */
+    fun wav(samples: FloatArray): String {
+        val bytes = wavBytes(samples)
+        return try {
+            Base64.getEncoder().encodeToString(bytes)
+        } finally {
+            bytes.fill(0)
+        }
+    }
+
+    /** [samples] as the bytes of a WAV file. */
+    internal fun wavBytes(samples: FloatArray): ByteArray {
+        val dataBytes = samples.size * 2
+        val out = ByteArray(HEADER_BYTES + dataBytes)
+        fun ascii(at: Int, text: String) = text.forEachIndexed { i, c -> out[at + i] = c.code.toByte() }
+        fun int32(at: Int, value: Int) {
+            out[at] = (value and 0xff).toByte()
+            out[at + 1] = ((value shr 8) and 0xff).toByte()
+            out[at + 2] = ((value shr 16) and 0xff).toByte()
+            out[at + 3] = ((value shr 24) and 0xff).toByte()
+        }
+        fun int16(at: Int, value: Int) {
+            out[at] = (value and 0xff).toByte()
+            out[at + 1] = ((value shr 8) and 0xff).toByte()
+        }
+        ascii(0, "RIFF")
+        int32(4, 36 + dataBytes)
+        ascii(8, "WAVE")
+        ascii(12, "fmt ")
+        int32(16, 16)
+        int16(20, 1)
+        int16(22, 1)
+        int32(24, SAMPLE_RATE)
+        int32(28, SAMPLE_RATE * 2)
+        int16(32, 2)
+        int16(34, 16)
+        ascii(36, "data")
+        int32(40, dataBytes)
+        var at = HEADER_BYTES
+        for (sample in samples) {
+            val v = (sample.coerceIn(-1f, 1f) * Short.MAX_VALUE).toInt()
+            int16(at, v)
+            at += 2
+        }
+        return out
+    }
+
+    private const val HEADER_BYTES = 44
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/HearingEngine.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/HearingEngine.kt
new file mode 100644
index 0000000..5ec89bb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/HearingEngine.kt
@@ -0,0 +1,144 @@
+package com.opendroid.ai.core.life.ears
+
+/**
+ * Her ears, as an engine: the microphone, speech found in it, and words made of the speech,
+ * all on the phone (OWN_LIFE_PLAN phase 3). What it hears is handed to a [HearingEngine.Listener]
+ * and kept nowhere: no file, no database, no log line holds a transcript or a sample (I6).
+ * Where the words go next (to her as his talk, to what she overheard, or to counts only) is
+ * decided by whoever listens, not here.
+ */
+interface HearingEngine {
+
+    /** True while the microphone is open for her. */
+    val isOpen: Boolean
+
+    /**
+     * Opens the microphone and starts listening; what is heard goes to [listener], from a
+     * thread of the engine's own. Null when it opened; otherwise why it could not.
+     */
+    fun open(listener: Listener): Closed?
+
+    /** Lets go of the microphone for a while (push-to-talk, an approval listen), keeping what is loaded. */
+    fun pause()
+
+    /** Takes the microphone back after [pause]. */
+    fun resume()
+
+    /** Closes the microphone, lets go of the models, and clears every buffer. */
+    fun close()
+
+    /**
+     * What the engine tells whoever listens. Called on a thread of the engine's (or, for
+     * [silenced], the main thread); nothing here may block long.
+     */
+    interface Listener {
+        /** A stretch of speech, and what came of it. */
+        fun heard(heard: Heard)
+
+        /** Speech that was let go of without words, and why: for counts only. */
+        fun dropped(why: Dropped, millis: Long) {}
+
+        /** His voice came in over hers: she is to be cut off, as the wake phrase does. */
+        fun overHer() {}
+
+        /** Another app or a call holds the microphone ([silenced] true), or gave it back. */
+        fun silenced(silenced: Boolean) {}
+
+        /** The engine stopped by itself and is closed. */
+        fun failed(why: Closed) {}
+    }
+
+    /** Why the ears are closed, or could not open. */
+    enum class Closed(val words: String) {
+        NO_MODELS("the models for her ears are not on the phone yet"),
+        NO_PERMISSION("the app may not use the microphone"),
+        MIC_UNAVAILABLE("the microphone could not be opened"),
+        LOAD_FAILED("the speech models could not be loaded"),
+        NOT_ON_DEVICE("the phone has no recogniser that stays on the phone"),
+    }
+}
+
+/** Whose voice a stretch of speech was, as far as the phone can tell. */
+enum class Voice {
+    /** His enrolled voice. */
+    HIM,
+
+    /** Another voice than his enrolled one. */
+    OTHER,
+
+    /** No voice of his is enrolled, so nobody's can be told apart. */
+    NOT_ENROLLED,
+
+    /** A sound too short, or too little like speech, to tell whose it was. */
+    UNSURE,
+}
+
+/** Why a stretch of speech was let go of without words. Counts only. */
+enum class Dropped {
+    /** Under [HearingRules.MIN_SEGMENT_MILLIS]. */
+    TOO_SHORT,
+
+    /** It fell while the phone was speaking, or just after, or it was the phone's own line. */
+    HER_VOICE,
+
+    /** Under [HearingRules.MIN_WORDS] words. */
+    FEW_WORDS,
+
+    /** A call or another app held the microphone. */
+    SILENCED,
+
+    /** Speech came faster than the phone could write it down. */
+    BUSY,
+
+    /** A sound that was not speech, and not one the recogniser could name (a door, a clatter). */
+    NOISE,
+}
+
+/** What a [Heard] is: speech, or a sound a person or a room makes that is not speech. */
+enum class Kind {
+    /** Speech; its words are in [Heard.text] when they were written down. */
+    SPEECH,
+
+    /** A laugh, a cough, crying, applause or music, with no words: [Heard.sound] says which. */
+    SOUND,
+}
+
+/**
+ * One stretch of speech, or one sound, the ears heard. In memory only: it is handed on and
+ * forgotten, and nothing in it is ever written down (I6).
+ *
+ * [startedAt] and [endedAt] are on [HearingRules.now]'s clock. [text] is null when the
+ * words were not written down at all: another voice than his, while others may not talk
+ * to her, and always for a [Kind.SOUND]. [similarity] is the cosine to his voiceprint, null
+ * with none enrolled. [overHer] is true when this is the speech that cut her off.
+ *
+ * [sound] is how it sounded ([HowItSounded]): for his voice (or any, before his is enrolled)
+ * the recogniser's tone and sound tags and the phone's measures; for another voice not
+ * written down, only the sounds the recogniser named (laughing, music), never its tone; null
+ * when nothing could be told. For a [Kind.SOUND] the voice of a laugh or a cough is told
+ * less surely than that of speech ([voice] is [Voice.NOT_ENROLLED] when it was too short to
+ * tell at all).
+ */
+class Heard(
+    val startedAt: Long,
+    val endedAt: Long,
+    val voice: Voice,
+    val similarity: Float?,
+    val text: String?,
+    val language: String?,
+    val overHer: Boolean,
+    val sound: HowItSounded? = null,
+    val kind: Kind = Kind.SPEECH,
+    /**
+     * The speech itself, 16 kHz mono, for a model of hers that hears ([HeardClip]): only his
+     * voice (or any, before his is enrolled), only speech, at most [HeardClip.MAX_MILLIS], and
+     * only while the engine is asked to keep clips. In memory only (I6): whoever is done with
+     * it zeroes it.
+     */
+    val clip: FloatArray? = null,
+) {
+    val millis: Long get() = endedAt - startedAt
+
+    // A transcript must never end up in a log by way of toString, nor how it sounded.
+    override fun toString(): String = "Heard($kind, ${millis}ms, $voice, words=${text != null})"
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/HearingRules.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/HearingRules.kt
new file mode 100644
index 0000000..76edc48
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/HearingRules.kt
@@ -0,0 +1,197 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.voice.VoiceOut
+
+/**
+ * The rules her ears go by between hearing a sound and handing on words (OWN_LIFE_PLAN
+ * phase 3, PRESENCE_PLAN §2). Pure, so that each is tested on its own.
+ *
+ *  - Speech under [MIN_SEGMENT_MILLIS] is let go of, and so are words under [MIN_WORDS].
+ *  - The phone's own voice is not his: what falls while the phone speaks, or within
+ *    [TAIL_MILLIS] after, is cut away ([cleanPart]), and a transcript that reads like a
+ *    line the phone just said is dropped ([soundsLikeThePhone]).
+ *  - His voice coming in over hers cuts her off ([BargeIn]), only where the phone cancels
+ *    its own echo, since otherwise her voice would cut itself off.
+ */
+object HearingRules {
+
+    /** The clock every time of the ears is on ([VoiceOut.clock]). */
+    fun now(): Long = VoiceOut.clock()
+
+    /** Shorter speech is let go of. */
+    const val MIN_SEGMENT_MILLIS = 400L
+
+    /** Fewer words are let go of. */
+    const val MIN_WORDS = 2
+
+    /** How long after the phone stops speaking the ears still take what they hear for the phone. */
+    const val TAIL_MILLIS = 1_500L
+
+    /** How long after a line a transcript is still compared with it. */
+    const val ECHO_TEXT_MILLIS = 30_000L
+
+    /** How much of a transcript's words must be in a line just said for it to be that line. */
+    const val ECHO_TEXT_SHARE = 0.8
+
+    /** How long he must talk over her before she is cut off. */
+    const val BARGE_IN_MILLIS = 600L
+
+    /**
+     * How long the VAD takes to say speech has begun after it has: what he says over her is
+     * his from this long before that.
+     */
+    const val ONSET_MILLIS = 350L
+
+    /**
+     * The longest stretch of [start]..[end] (a segment's times) that does not fall while
+     * the phone spoke or within [TAIL_MILLIS] after, given what it said ([spells]). A line
+     * his voice cut off is the phone only until he came in, with no tail: what came after
+     * is his. Null when nothing of the segment is left.
+     */
+    fun cleanPart(start: Long, end: Long, spells: List<VoiceOut.Spell>, tail: Long = TAIL_MILLIS): LongRange? {
+        val windows = spells.map { s ->
+            val cut = s.cutByHimAt
+            if (cut != null) s.startedAt until cut else s.startedAt until ((s.endedAt ?: Long.MAX_VALUE - tail) + tail)
+        }.filter { !it.isEmpty() }.sortedBy { it.first }
+        var pieces = listOf(start until end)
+        for (w in windows) {
+            pieces = pieces.flatMap { p ->
+                if (w.last < p.first || w.first > p.last) listOf(p)
+                else listOf(p.first until w.first, (w.last + 1) until (p.last + 1)).filter { !it.isEmpty() }
+            }
+        }
+        return pieces.maxByOrNull { it.last - it.first }
+    }
+
+    /** True when the segment [start]..[end] is the speech that cut off one of [spells]. */
+    fun cutHerOff(start: Long, end: Long, spells: List<VoiceOut.Spell>): Boolean =
+        spells.any { s -> s.cutByHimAt.let { it != null && it in (start - ONSET_MILLIS)..end } }
+
+    /**
+     * True when [transcript] reads like one of the lines the phone said within
+     * [ECHO_TEXT_MILLIS] before [heardAt]: [ECHO_TEXT_SHARE] of its words are in them.
+     */
+    fun soundsLikeThePhone(transcript: String, heardAt: Long, spells: List<VoiceOut.Spell>): Boolean {
+        val heard = tokens(transcript)
+        if (heard.isEmpty()) return false
+        val said = spells.filter { (it.endedAt ?: Long.MAX_VALUE) >= heardAt - ECHO_TEXT_MILLIS }
+            .flatMap { tokens(it.text) }.toHashSet()
+        if (said.isEmpty()) return false
+        val found = heard.count { it in said }
+        return found >= heard.size * ECHO_TEXT_SHARE
+    }
+
+    /**
+     * How many words [text] holds: a run of letters or digits is one, and a run of
+     * Japanese, Chinese or Korean characters counts one for every two of them.
+     */
+    fun words(text: String): Int {
+        var count = 0
+        var latin = false
+        var cjk = 0
+        fun endCjk() {
+            if (cjk > 0) count += (cjk + 1) / 2
+            cjk = 0
+        }
+        for (ch in text) {
+            when {
+                isCjk(ch) -> {
+                    latin = false
+                    cjk++
+                }
+                ch.isLetterOrDigit() -> {
+                    endCjk()
+                    if (!latin) count++
+                    latin = true
+                }
+                else -> {
+                    endCjk()
+                    latin = false
+                }
+            }
+        }
+        endCjk()
+        return count
+    }
+
+    /** The words of [text], lowercased, for comparison: Latin words whole, CJK characters one by one. */
+    internal fun tokens(text: String): List<String> {
+        val out = ArrayList<String>()
+        val word = StringBuilder()
+        fun flush() {
+            if (word.isNotEmpty()) out += word.toString()
+            word.setLength(0)
+        }
+        for (ch in text.lowercase()) {
+            when {
+                isCjk(ch) -> {
+                    flush()
+                    if (ch !in KANA_MARKS) out += ch.toString()
+                }
+                ch.isLetterOrDigit() || ch == '\'' -> word.append(ch)
+                else -> flush()
+            }
+        }
+        flush()
+        return out.map { it.trim('\'') }.filter { it.isNotEmpty() }
+    }
+
+    private fun isCjk(ch: Char): Boolean {
+        val block = Character.UnicodeBlock.of(ch)
+        return block == Character.UnicodeBlock.HIRAGANA ||
+            block == Character.UnicodeBlock.KATAKANA ||
+            block == Character.UnicodeBlock.KATAKANA_PHONETIC_EXTENSIONS ||
+            block == Character.UnicodeBlock.CJK_UNIFIED_IDEOGRAPHS ||
+            block == Character.UnicodeBlock.CJK_UNIFIED_IDEOGRAPHS_EXTENSION_A ||
+            block == Character.UnicodeBlock.CJK_COMPATIBILITY_IDEOGRAPHS ||
+            block == Character.UnicodeBlock.HANGUL_SYLLABLES ||
+            block == Character.UnicodeBlock.HALFWIDTH_AND_FULLWIDTH_FORMS && ch in 'ｦ'..'ﾟ'
+    }
+
+    private val KANA_MARKS = setOf('ー', 'ｰ')
+
+    /**
+     * When his talking over her cuts her off. Fed every frame with whether the VAD hears
+     * speech: once speech has gone on for [BARGE_IN_MILLIS] while a line is being said, on a
+     * microphone that cancels the phone's echo, [step] gives the time that speech came in
+     * (or the line started, if he was already talking). The caller then [confirmed] it (she
+     * is cut off, once per line) or [vetoed] it (it was not his voice), after which it asks
+     * again each [BARGE_IN_MILLIS] while the speech goes on, still from when it came in.
+     */
+    class BargeIn(private val needMillis: Long = BARGE_IN_MILLIS) {
+        private var speechSince: Long? = null
+        private var askAt: Long? = null
+        private var firedFor: Long? = null
+
+        fun step(now: Long, playingSince: Long?, speech: Boolean, echoCancelled: Boolean): Long? {
+            if (!speech) {
+                speechSince = null
+                askAt = null
+                return null
+            }
+            val since = speechSince ?: now.also { speechSince = it }
+            if (playingSince == null || !echoCancelled || firedFor == playingSince) return null
+            val from = maxOf(since, playingSince)
+            if (now - from < needMillis) return null
+            askAt?.let { if (now < it) return null }
+            return from
+        }
+
+        /** She was cut off for the line that started at [playingSince]. */
+        fun confirmed(playingSince: Long) {
+            firedFor = playingSince
+            askAt = null
+        }
+
+        /** The voice was not his: it is asked again after another [BARGE_IN_MILLIS] of speech. */
+        fun vetoed(now: Long) {
+            askAt = now + needMillis
+        }
+
+        fun reset() {
+            speechSince = null
+            askAt = null
+            firedFor = null
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/HerEars.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/HerEars.kt
new file mode 100644
index 0000000..43ea3eb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/HerEars.kt
@@ -0,0 +1,604 @@
+package com.opendroid.ai.core.life.ears
+
+import android.content.Context
+import android.util.Log
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.voice.PreferredRecognizer
+import com.opendroid.ai.core.voice.VoiceOut
+import com.opendroid.ai.core.voice.WakeWordMatcher
+import com.opendroid.ai.data.models.LLMConfig
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Which engine her ears listen with (OWN_LIFE_PLAN phase 3, engine order):
+ *  1. sherpa-onnx, when its models for his choice are on the phone ([SherpaHearing]);
+ *  2. Android's recogniser, only where the phone has one that stays on the phone
+ *     ([AndroidOnDeviceHearing]); the default recogniser that was merely asked to stay
+ *     offline is never used;
+ *  3. otherwise none, and the ears stay closed with what he can do about it.
+ */
+interface EarsEngines {
+
+    sealed class Pick {
+        /** [engine] to open; [key] tells one choice from another, so a change of choice opens anew. */
+        class Engine(val engine: HearingEngine, val key: String) : Pick()
+
+        class None(val why: String) : Pick()
+    }
+
+    /** The engine for [config] now; [othersMayTalk] is asked by the engine as it hears. */
+    fun pick(config: LLMConfig, othersMayTalk: () -> Boolean): Pick
+
+    /** What [choose] can choose. */
+    enum class Choice { SHERPA, ANDROID_ON_DEVICE, NONE }
+
+    companion object {
+        /** The engine order, pure: sherpa with its models, else Android's only when it stays on the phone. */
+        fun choose(modelsReady: Boolean, onDeviceAvailable: Boolean): Choice = when {
+            modelsReady -> Choice.SHERPA
+            onDeviceAvailable -> Choice.ANDROID_ON_DEVICE
+            else -> Choice.NONE
+        }
+
+        /** Why the ears are closed when no engine can be had. */
+        val NO_ENGINE: String =
+            "no models for her ears yet (download them under Her ears), and this phone has no recogniser that stays on " +
+                "the phone. ${PreferredRecognizer.OFFLINE_REMEDY}"
+    }
+}
+
+/** The engines of this phone, in the order [EarsEngines] says. */
+@Singleton
+class AndroidEarsEngines @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val sherpa: SherpaHearing,
+    private val models: EarsModelStore,
+    private val android: AndroidOnDeviceHearing,
+) : EarsEngines {
+    override fun pick(config: LLMConfig, othersMayTalk: () -> Boolean): EarsEngines.Pick {
+        val recognizer = EarsModels.Recognizer.of(config.personaEarsModel)
+        return when (EarsEngines.choose(models.ready(recognizer), PreferredRecognizer.isOnDeviceAvailable(context))) {
+            EarsEngines.Choice.SHERPA -> {
+                sherpa.recognizer = recognizer
+                sherpa.othersMayTalk = othersMayTalk
+                // His speech itself is kept with his words only for a model of hers that hears.
+                sherpa.keepClips = HeardClip.reachesHer(config)
+                EarsEngines.Pick.Engine(sherpa, "sherpa:${recognizer.name}")
+            }
+            EarsEngines.Choice.ANDROID_ON_DEVICE -> EarsEngines.Pick.Engine(android, "android-on-device")
+            EarsEngines.Choice.NONE -> EarsEngines.Pick.None(EarsEngines.NO_ENGINE)
+        }
+    }
+}
+
+/**
+ * Her ears while she is awake (OWN_LIFE_PLAN phase 3, PRESENCE_PLAN §2): when the microphone
+ * is open ([EarsGate], [apply]), and where each thing heard goes ([EarsRouting]):
+ *  - said to her: a message to her, through the path his voice messages take, with how it
+ *    sounded ([Room.saidToHer], [HeardAloud]);
+ *  - his voice not said to her: overheard, in memory only, for her next prompt ([Overheard]);
+ *  - anything else: counted.
+ * His voice coming in over hers stops her ([Room.overHer]); push-to-talk and the approval
+ * listen borrow the microphone and give it back ([lend]).
+ *
+ * What it keeps: counts for the day ([EarsDay]) in memory and in her log, one entry a day
+ * ([HerLog.Kind.EARS_DAY]), never a word (I8); and in memory what she overheard. Nothing it
+ * hears is written anywhere (I6), and nothing of it goes into a log line.
+ */
+@Singleton
+class HerEars internal constructor(
+    private val engines: EarsEngines,
+    private val overheard: Overheard,
+    private val log: HerLog,
+    private val wall: () -> Long,
+    private val zone: () -> TimeZone,
+    private val muteKeep: MuteKeep = MuteKeep.Memory(),
+) {
+    @Inject
+    constructor(engines: AndroidEarsEngines, overheard: Overheard, log: HerLog, muteKeep: EarsMuteStore) :
+        this(engines, overheard, log, System::currentTimeMillis, TimeZone::getDefault, muteKeep)
+
+    /** Where what the ears hear goes on from here: the service. Every call comes on an engine's thread. */
+    interface Room {
+        /**
+         * [text] was said out loud to her, and heard as [aloud]: a message to her. Called with
+         * the ears' lock held, so that nothing heard is handed on once they close: it must hand
+         * the message on and return, never wait.
+         */
+        fun saidToHer(text: String, aloud: HeardAloud)
+
+        /** His voice came in over hers: she stops speaking. */
+        fun overHer() {}
+
+        /** His voice was heard, not to her, after [HEARD_HIM_QUIET_MILLIS] or more without it ([Why.HEARD_HIM]). */
+        fun heardHimAfterQuiet() {}
+
+        /** What the ears are doing changed (for the notification). */
+        fun changed() {}
+    }
+
+    /** Where "Mute 1 h" is kept, so that a restart of the service within the hour keeps it. */
+    interface MuteKeep {
+        /** Until when the ears are muted (wall clock), 0 for not. */
+        fun read(): Long
+
+        fun write(untilMillis: Long)
+
+        /** In memory only: for the tests. */
+        class Memory : MuteKeep {
+            @Volatile private var until = 0L
+            override fun read(): Long = until
+            override fun write(untilMillis: Long) {
+                until = untilMillis
+            }
+        }
+    }
+
+    /** What the ears are doing. */
+    enum class State { OPEN, PAUSED, CLOSED }
+
+    /** For the status card and the notification. Counts, times and why only. */
+    data class Status(
+        val state: State,
+        /** Why they are paused or closed; null while open. */
+        val why: String?,
+        /** Whether he switched them on at all. */
+        val switchedOn: Boolean,
+        /** Since when the microphone has been open (wall clock); null while it is not. */
+        val openSince: Long?,
+        /** His voice heard today (before enrolment: any voice said to her). */
+        val heardHim: Int,
+        /** Of those, said to her. */
+        val toHer: Int,
+        /** Seconds of other talk today, counted only. */
+        val othersSeconds: Int,
+    )
+
+    @Volatile var room: Room? = null
+
+    private val lock = Any()
+    private var engine: HearingEngine? = null
+    private var engineKey: String? = null
+    private var enginePaused = false
+    private var want: EarsGate.Want = EarsGate.Want.Close(EarsGate.Closed.SERVICE_DOWN)
+    private var lent = false
+    @Volatile private var silenced = false
+    @Volatile private var config: LLMConfig? = null
+    private var noEngine: String? = null
+    private var failedWhy: String? = null
+    private var failedAt = 0L
+    private var openSince: Long? = null
+    private var openCountedAt = 0L
+    // Read from [muteKeep] the first time it is needed; -1 until then.
+    private var mutedUntil = -1L
+    // The service went away ([shutDown]): nothing opens them until it starts again ([startUp]).
+    private var down = false
+    // Moves on each time the ears stop hearing (closed, or paused): what an engine heard
+    // before that is handed on nowhere ([onHeard]).
+    private var generation = 0L
+    private val day = EarsDay()
+    private var dayStart = 0L
+    private var lastFlushAt = 0L
+    @Volatile private var firstOpenAt = 0L
+    @Volatile private var lastHeardHimAt = 0L
+    @Volatile private var lastBroughtAt = 0L
+
+    private val state = MutableStateFlow(Status(State.CLOSED, EarsGate.Closed.SERVICE_DOWN.words, false, null, 0, 0, 0))
+
+    /** What the ears are doing now, as it changes. */
+    val status: StateFlow<Status> = state.asStateFlow()
+
+    /** True while the microphone is open for her (not paused, not closed). */
+    val isOpen: Boolean get() = state.value.state == State.OPEN
+
+    /** True unless the ears are closed: while open or paused they take the wake phrase listener's place. */
+    val holdsTheMic: Boolean get() = state.value.state != State.CLOSED
+
+    private val listener = object : HearingEngine.Listener {
+        override fun heard(heard: Heard) = onHeard(heard)
+
+        override fun dropped(why: Dropped, millis: Long) {
+            day.bump(EarsDay.dropped(why))
+        }
+
+        override fun overHer() {
+            day.bump(EarsDay.CUT_HER_OFF)
+            room?.overHer()
+        }
+
+        override fun silenced(silenced: Boolean) {
+            this@HerEars.silenced = silenced
+            publish()
+        }
+
+        override fun failed(why: HearingEngine.Closed) {
+            synchronized(lock) {
+                Log.w(TAG, "Her ears stopped: ${why.name}")
+                accountOpen()
+                engine = null
+                engineKey = null
+                enginePaused = false
+                openSince = null
+                failedWhy = why.words
+                failedAt = wall()
+            }
+            flush(force = true)
+            publish()
+        }
+    }
+
+    /**
+     * Opens, pauses or closes the ears for [input], with [config] as it is now. Called by the
+     * service whenever something that matters may have changed, and every so often.
+     */
+    fun apply(input: EarsGate.Input, config: LLMConfig) {
+        synchronized(lock) {
+            // After the service went away, a look that was already on its way opens nothing.
+            if (down) return
+            this.config = config
+            val now = wall()
+            val gate = EarsGate.decide(input.copy(mutedUntil = maxOf(input.mutedUntil, muted()), nowMillis = now))
+            want = gate
+            when (gate) {
+                is EarsGate.Want.Close -> {
+                    closeEngine()
+                    if (gate.why.clears) overheard.clear()
+                    noEngine = null
+                }
+                EarsGate.Want.Open -> if (openEngine(config, now)) settlePause()
+                is EarsGate.Want.Pause -> if (engine != null) settlePause()
+            }
+        }
+        flush(force = false)
+        publish()
+    }
+
+    /** Push-to-talk, the chat screen's microphone or the approval listen takes the microphone ([on]), or gives it back. */
+    fun lend(on: Boolean) {
+        synchronized(lock) {
+            if (lent == on) return
+            lent = on
+            settlePause()
+        }
+        publish()
+    }
+
+    /**
+     * "Mute 1 h" on the notification: closed until then, kept so that a restart of the service
+     * within the hour keeps it. The service applies it at once.
+     */
+    fun mute(untilMillis: Long) {
+        synchronized(lock) { mutedUntil = untilMillis }
+        try {
+            muteKeep.write(untilMillis)
+        } catch (e: Exception) {
+            Log.w(TAG, "Mute was not kept: ${e.javaClass.simpleName}")
+        }
+    }
+
+    // Called under the lock.
+    private fun muted(): Long {
+        if (mutedUntil < 0) {
+            mutedUntil = try {
+                muteKeep.read()
+            } catch (e: Exception) {
+                0L
+            }
+        }
+        return mutedUntil
+    }
+
+    /** The service has started: the ears may open again ([apply]). */
+    fun startUp() {
+        synchronized(lock) { down = false }
+    }
+
+    /**
+     * The service is going away: the ears close, the day's counts are written down, and nothing
+     * opens them again until [startUp], whatever look of the service is still on its way.
+     */
+    fun shutDown() {
+        synchronized(lock) {
+            down = true
+            closeEngine()
+            want = EarsGate.Want.Close(EarsGate.Closed.SERVICE_DOWN)
+        }
+        flush(force = true)
+        publish()
+    }
+
+    // Called under the lock. True when an engine is open.
+    private fun openEngine(config: LLMConfig, now: Long): Boolean {
+        val pick = engines.pick(config) { this.config?.personaEarsOthersMayTalk == true }
+        if (pick is EarsEngines.Pick.None) {
+            closeEngine()
+            noEngine = pick.why
+            return false
+        }
+        pick as EarsEngines.Pick.Engine
+        noEngine = null
+        if (engine != null && engineKey == pick.key) return true
+        // A failed opening is tried again after a while, not every time the service looks.
+        if (engine == null && failedAt > 0 && now - failedAt < RETRY_MILLIS) return false
+        closeEngine()
+        val closed = pick.engine.open(listener)
+        if (closed != null) {
+            failedWhy = closed.words
+            failedAt = now
+            return false
+        }
+        engine = pick.engine
+        engineKey = pick.key
+        enginePaused = false
+        failedWhy = null
+        failedAt = 0
+        openSince = now
+        openCountedAt = now
+        if (firstOpenAt == 0L) firstOpenAt = now
+        return true
+    }
+
+    // Called under the lock.
+    private fun settlePause() {
+        val e = engine ?: return
+        val pause = lent || want is EarsGate.Want.Pause
+        if (pause == enginePaused) return
+        enginePaused = pause
+        if (pause) generation++
+        if (pause) e.pause() else e.resume()
+    }
+
+    // Called under the lock.
+    private fun closeEngine() {
+        val e = engine ?: return
+        generation++
+        accountOpen()
+        e.close()
+        engine = null
+        engineKey = null
+        enginePaused = false
+        openSince = null
+    }
+
+    // The minutes the microphone was open, counted as they pass. Called under the lock.
+    private fun accountOpen() {
+        val since = openCountedAt.takeIf { openSince != null } ?: return
+        val now = wall()
+        val minutes = ((now - since) / 60_000L).toInt()
+        if (minutes > 0) {
+            day.bump(EarsDay.OPEN_MINUTES, minutes)
+            openCountedAt = since + minutes * 60_000L
+        }
+    }
+
+    private fun onHeard(heard: Heard) {
+        // His speech itself goes on only with what is said to her ([HeardAloud.of]); every other way it is zeroed here (I6).
+        try {
+            // Heard while the ears hear, and only then: what was still on its way when they
+            // closed or paused (she lay down, a call came) goes nowhere.
+            val heardIn = synchronized(lock) { if (hearing()) generation else null } ?: return
+            routeHeard(heard, heardIn)
+        } finally {
+            heard.clip?.fill(0f)
+        }
+    }
+
+    // Called under the lock: an engine is open, wanted open, and not paused.
+    private fun hearing(): Boolean = engine != null && want == EarsGate.Want.Open && !enginePaused && !down
+
+    // Runs [block] under the lock only while the ears still hear as they did when [heardIn] was read.
+    private inline fun whileStillHearing(heardIn: Long, block: () -> Unit): Boolean = synchronized(lock) {
+        if (generation != heardIn || !hearing()) return@synchronized false
+        block()
+        true
+    }
+
+    private fun routeHeard(heard: Heard, heardIn: Long) {
+        val cfg = config ?: return
+        val routeRoom = EarsRouting.Room(
+            enrolled = heard.voice != Voice.NOT_ENROLLED,
+            othersMayTalk = cfg.personaEarsOthersMayTalk,
+            chatInFront = ChatInFront.now,
+            spells = VoiceOut.since(heard.startedAt - EarsRouting.AFTER_HER_MILLIS - SPELL_SLACK_MILLIS),
+            names = EarsRouting.NAMES + WakeWordMatcher.PERSONA_PHRASES + WakeWordMatcher.parse(cfg.wakePhrases),
+        )
+        val route = EarsRouting.route(heard, routeRoom)
+        // When it was heard, on the wall clock: the ears' own clock runs from the boot.
+        val atWall = wall() - (HearingRules.now() - heard.startedAt).coerceAtLeast(0)
+        val handedOn = when (route) {
+            is EarsRouting.Route.ToHer -> {
+                val aloud = HeardAloud.of(route)
+                whileStillHearing(heardIn) {
+                    day.bump(if (route.fromHim) EarsDay.TO_HER else EarsDay.OTHERS_TO_HER)
+                    room?.saidToHer(route.text, aloud)
+                }
+            }
+            is EarsRouting.Route.Overheard -> {
+                val words = heard.text?.takeIf { heard.kind == Kind.SPEECH }
+                // Under the lock, so that a close that clears what she overheard cannot come between.
+                whileStillHearing(heardIn) {
+                    day.bump(
+                        when {
+                            !route.his -> EarsDay.NEAR_SOUNDS
+                            words != null -> EarsDay.OVERHEARD
+                            else -> EarsDay.HIS_SOUNDS
+                        }
+                    )
+                    overheard.add(Overheard.Line(atWall, words, heard.sound?.phrases().orEmpty(), route.his, heard.language.takeIf { words != null }))
+                }
+            }
+            is EarsRouting.Route.Counted -> whileStillHearing(heardIn) {
+                when {
+                    heard.kind == Kind.SOUND -> day.bump(EarsDay.SOUNDS_COUNTED)
+                    route.whose == EarsRouting.Whose.ANOTHER -> {
+                        day.bump(EarsDay.OTHERS_SECONDS, seconds(heard.millis))
+                        overheard.countOthers(heard.millis)
+                    }
+                    else -> {
+                        day.bump(EarsDay.ANYONE_SECONDS, seconds(heard.millis))
+                        overheard.countAnyone(heard.millis)
+                    }
+                }
+            }
+        }
+        if (!handedOn) return
+        if (heard.voice == Voice.HIM) heardHim(route !is EarsRouting.Route.ToHer)
+        flush(force = false)
+        publish()
+    }
+
+    // His enrolled voice was heard. After a long quiet, and not as talk to her, it may bring her next moment forward.
+    private fun heardHim(notToHer: Boolean) {
+        val now = wall()
+        val since = if (lastHeardHimAt > 0) lastHeardHimAt else firstOpenAt
+        lastHeardHimAt = now
+        if (!notToHer) return
+        if (!bringsHerSooner(since, lastBroughtAt, now)) return
+        lastBroughtAt = now
+        room?.heardHimAfterQuiet()
+    }
+
+    /** Writes the day's counts to her log: every [FLUSH_MILLIS], at a new day, and when [force]d. */
+    private fun flush(force: Boolean) {
+        val now = wall()
+        val (start, delta, previousStart) = synchronized(lock) {
+            val today = startOfDay(now)
+            if (dayStart == 0L) dayStart = today
+            if (today != dayStart) {
+                accountOpen()
+                val left = day.newDay()
+                val before = dayStart
+                dayStart = today
+                lastFlushAt = now
+                return@synchronized Triple(today, emptyMap<String, Int>(), before to left)
+            }
+            if (!force && now - lastFlushAt < FLUSH_MILLIS) return
+            accountOpen()
+            lastFlushAt = now
+            Triple(today, day.flush(), null)
+        }
+        try {
+            previousStart?.let { (before, left) -> log.earsCounts(before, left) }
+            log.earsCounts(start, delta)
+        } catch (e: Exception) {
+            Log.w(TAG, "Her ears' counts were not written: ${e.javaClass.simpleName}")
+        }
+    }
+
+    private fun startOfDay(now: Long): Long = Calendar.getInstance(zone()).apply {
+        timeInMillis = now
+        set(Calendar.HOUR_OF_DAY, 0)
+        set(Calendar.MINUTE, 0)
+        set(Calendar.SECOND, 0)
+        set(Calendar.MILLISECOND, 0)
+    }.timeInMillis
+
+    private fun publish() {
+        val next = synchronized(lock) {
+            val cfg = config
+            val switchedOn = cfg?.personaOpenMic == true
+            val w = want
+            val (st, why) = when {
+                engine != null && (lent || w is EarsGate.Want.Pause) ->
+                    State.PAUSED to (if (lent) EarsGate.Paused.MIC_LENT.words else (w as EarsGate.Want.Pause).why.words)
+                engine != null && silenced -> State.PAUSED to EarsGate.Paused.SILENCED.words
+                engine != null -> State.OPEN to null
+                w is EarsGate.Want.Close -> State.CLOSED to w.why.words
+                w is EarsGate.Want.Pause -> State.PAUSED to w.why.words
+                else -> State.CLOSED to (noEngine ?: failedWhy ?: "it could not open")
+            }
+            Status(
+                state = st,
+                why = why,
+                switchedOn = switchedOn,
+                openSince = openSince,
+                heardHim = day.count(EarsDay.TO_HER) + day.count(EarsDay.OVERHEARD),
+                toHer = day.count(EarsDay.TO_HER),
+                othersSeconds = day.count(EarsDay.OTHERS_SECONDS) + day.count(EarsDay.ANYONE_SECONDS),
+            )
+        }
+        val changed = state.value.state != next.state || state.value.why != next.why || state.value.switchedOn != next.switchedOn
+        state.value = next
+        if (changed) room?.changed()
+    }
+
+    companion object {
+        private const val TAG = "HerEars"
+
+        /** His voice after this long without it may bring her next moment forward, and at most once in as long. */
+        const val HEARD_HIM_QUIET_MILLIS = 2 * 60 * 60_000L
+
+        /** The day's counts are written to her log this often while the ears hear. */
+        const val FLUSH_MILLIS = 10 * 60_000L
+
+        /** An engine that would not open is tried again after this long. */
+        const val RETRY_MILLIS = 5 * 60_000L
+
+        // The phone's lines that ended a little before the window still bear on it.
+        private const val SPELL_SLACK_MILLIS = 1_000L
+
+        /**
+         * Whether his voice heard at [now], after none since [heardSince], brings her next
+         * moment forward: [HEARD_HIM_QUIET_MILLIS] or more without it, and not within as long
+         * after the last time it did ([lastBroughtAt], 0 for never). Pure.
+         */
+        fun bringsHerSooner(heardSince: Long, lastBroughtAt: Long, now: Long): Boolean =
+            heardSince > 0 && now - heardSince >= HEARD_HIM_QUIET_MILLIS &&
+                (lastBroughtAt <= 0 || now - lastBroughtAt >= HEARD_HIM_QUIET_MILLIS)
+
+        private fun seconds(millis: Long): Int = ((millis + 500) / 1000).toInt().coerceAtLeast(0)
+
+        /**
+         * Her ears on the status card, counts only: "Ears: open since 16:20; heard you 14 times
+         * today (9 to her); others 6 min, not kept." or "Ears: off (she is asleep)." Null while
+         * he has not switched them on.
+         */
+        fun statusLine(status: Status, zone: TimeZone = TimeZone.getDefault()): String? {
+            if (!status.switchedOn) return null
+            val counts = buildString {
+                if (status.heardHim > 0) {
+                    append("; heard you ${status.heardHim} ${if (status.heardHim == 1) "time" else "times"} today (${status.toHer} to her)")
+                }
+                if (status.othersSeconds > 0) append("; others ${EarsDay.minutes(status.othersSeconds)}, not kept")
+            }
+            return when (status.state) {
+                State.OPEN -> {
+                    val since = status.openSince?.let { " since " + SimpleDateFormat("HH:mm", Locale.ENGLISH).apply { timeZone = zone }.format(Date(it)) }.orEmpty()
+                    "Ears: open$since$counts."
+                }
+                State.PAUSED -> "Ears: paused (${status.why ?: "for now"})$counts."
+                State.CLOSED -> "Ears: off (${status.why ?: "closed"})$counts."
+            }
+        }
+    }
+}
+
+/**
+ * "Mute 1 h" kept on the phone ([HerEars.MuteKeep]): a time and nothing else, so that a
+ * restart of the service within the hour does not open the microphone early.
+ */
+@Singleton
+class EarsMuteStore @Inject constructor(@ApplicationContext private val context: Context) : HerEars.MuteKeep {
+    private val prefs by lazy { context.getSharedPreferences(PREFS, Context.MODE_PRIVATE) }
+
+    override fun read(): Long = prefs.getLong(KEY, 0L)
+
+    override fun write(untilMillis: Long) {
+        prefs.edit().putLong(KEY, untilMillis).apply()
+    }
+
+    private companion object {
+        const val PREFS = "her_ears"
+        const val KEY = "muted_until"
+    }
+}
