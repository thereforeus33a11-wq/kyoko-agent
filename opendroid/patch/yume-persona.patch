+
+        assertEquals(4, memory.refreshStartingNotes(thisBuild + bees + hives + walks, earlier + hivesOld))
+
+        // An older wording that is not listed is left; the one that is, is refreshed; the same one is the same.
+        assertEquals("he keeps bees", stored(bees)!!.value)
+        assertEquals(hives.text, stored(hives)!!.value)
+        assertEquals(walks.text, stored(walks)!!.value)
+        assertEquals(1, archived(hives).size)
+        assertTrue(archived(bees).isEmpty())
+        assertTrue(archived(walks).isEmpty())
+    }
+
+    @Test
+    fun `keys the starting notes no longer have are left as they are`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+
+        assertEquals(2, memory.refreshStartingNotes(listOf(builder, voice), earlier))
+
+        assertEquals(oldBoots.text, stored(boots)!!.value)
+        assertEquals(miku.text, stored(miku)!!.value)
+        assertEquals(4, memory.notes().size)
+    }
+
+    // ── A starting note that is new in a later build ─────────────────────────────────
+
+    /** A starting note no earlier build had. */
+    private val rig = Note(Kind.THREAD, "rig", "the rig is the next thing on my model | open")
+    private val nextBuild = thisBuild + rig
+
+    /** What an older build left on a phone: its starting notes and the marker, nothing about which keys it gave. */
+    private suspend fun startedByAnOlderBuild(notes: List<Note> = olderBuild) {
+        notes.forEachIndexed { index, note -> repository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC, 1_000L + index)) }
+        memory.markStarted()
+    }
+
+    @Test
+    fun `a starting note new in this build comes into a notebook an older build started, older than every note of hers`() = runBlocking {
+        startedByAnOlderBuild()
+        memory.apply(listOf(Note(Kind.ME, "soda", "melon soda is mine")))
+        val before = memory.writtenAt()
+
+        assertEquals("three new wordings and one new note", 4, memory.refreshStartingNotes(nextBuild, earlier))
+
+        assertEquals(rig.text, stored(rig)!!.value)
+        // Stamped like a starting note: older than all she has, so it is last on her page and nothing is newer by it.
+        assertEquals("rig", memory.notes().last().key)
+        assertTrue(stored(rig)!!.timestamp < before.values.min())
+        assertEquals(before, memory.writtenAt() - rig.storageKey)
+        // It is not something she let go, and nothing of hers went to make room for it.
+        assertTrue(memory.restorableKeys().isEmpty())
+        assertEquals(6, memory.notes().size)
+    }
+
+    @Test
+    fun `a new starting note comes in once, and what she lets go of it stays gone in every later build`() = runBlocking {
+        startedByAnOlderBuild()
+        assertEquals(4, memory.refreshStartingNotes(nextBuild, earlier))
+        memory.fade(listOf(rig.storageKey))
+
+        // A later build, with other wordings, and the app started again.
+        val later = earlier + voice
+        assertEquals(0, PersonaMemory(repository).refreshStartingNotes(nextBuild, later))
+        assertEquals(null, stored(rig))
+        // Kept as given even where her archive no longer had it.
+        for (row in archived(rig)) repository.deleteMemory(row.key)
+        assertEquals(0, memory.refreshStartingNotes(nextBuild, later + oldestVoice.copy(text = "an older text still")))
+        assertEquals(null, stored(rig))
+    }
+
+    @Test
+    fun `a fresh install has every starting note from its start, and its first look adds none twice`() = runBlocking {
+        memory.seedIfNeeded(nextBuild)
+        val writtenAt = memory.writtenAt()
+
+        assertEquals(0, memory.refreshStartingNotes(nextBuild, earlier))
+
+        assertEquals(writtenAt, memory.writtenAt())
+        assertEquals(nextBuild.map { it.text }.toSet(), memory.notes().map { it.text }.toSet())
+    }
+
+    @Test
+    fun `no new starting note comes into a notebook he emptied, now or by an older build, or into one handed over`() = runBlocking {
+        // Emptied here; he hands her a note under a starting key afterwards.
+        memory.seedIfNeeded(olderBuild)
+        memory.empty()
+        memory.apply(listOf(builder))
+        assertEquals(0, memory.refreshStartingNotes(nextBuild, earlier))
+        assertEquals(null, stored(rig))
+
+        // Emptied by an older build, which kept no mark of it: no starting note left, none in her archive.
+        anotherPhone()
+        startedByAnOlderBuild(emptyList())
+        memory.apply(listOf(Note(Kind.ME, "soda", "melon soda is mine")))
+        assertEquals(0, memory.refreshStartingNotes(nextBuild, earlier))
+        assertEquals(listOf("soda"), memory.notes().map { it.key })
+
+        // The same, after he handed her a note under a starting key in his own words: that is not a starting note.
+        anotherPhone()
+        startedByAnOlderBuild(emptyList())
+        memory.apply(listOf(builder.copy(text = "he built my files and my model before this app, in his own words")))
+        assertEquals(0, memory.refreshStartingNotes(nextBuild, earlier))
+        assertEquals(null, stored(rig))
+        assertEquals(listOf("builder"), memory.notes().map { it.key })
+
+        // Handed over from another phone, where she may have let it go: not on that look.
+        anotherPhone()
+        memory.markStarted()
+        memory.apply(listOf(oldBuilder, oldVoice))
+        memory.handedOver()
+        assertEquals(2, memory.refreshStartingNotes(nextBuild, earlier))
+        assertEquals(null, stored(rig))
+        assertEquals(setOf("builder", "own-voice"), memory.notes().map { it.key }.toSet())
+        // A build after that brings one more: that one comes in, and the one from the hand-over does not.
+        val later = Note(Kind.REL, "later", "a note a later build starts me with")
+        assertEquals(1, memory.refreshStartingNotes(nextBuild + later, earlier + voice))
+        assertEquals(later.text, stored(later)!!.value)
+        assertEquals(null, stored(rig))
+    }
+
+    @Test
+    fun `with the files this build ships, a phone holding any earlier wording of a starting note it still has gets the current one`() = runBlocking {
+        val assets = java.io.File("src/main/assets")
+        val shipped = PersonaStore(context) { path -> java.io.File(assets, path).takeIf { it.isFile }?.readText().orEmpty() }
+        val current = shipped.seedNotes().associateBy { it.storageKey }
+        val previous = shipped.previousSeedNotes()
+        // A build made without her files has nothing to look at.
+        if (current.isEmpty() || previous.isEmpty()) return@runBlocking
+        val lines = java.io.File(assets, "persona/seed_notes.previous.txt").readLines()
+            .filter { it.isNotBlank() && !it.trim().startsWith("#") }
+        assertEquals("every line of the file is a note", lines.size, previous.size)
+
+        for (old in previous.filter { it.storageKey in current }) {
+            anotherPhone()
+            memory.seedIfNeeded(listOf(old))
+            memory.refreshStartingNotes(current.values.toList(), previous)
+            assertEquals(old.toLine(), current.getValue(old.storageKey).text, stored(old)!!.value)
+        }
+    }
+
+    private fun earlierText(row: Memory): String = Regex("\"t\":\"([^\"]*)\"").find(row.value)!!.groupValues[1]
+}
