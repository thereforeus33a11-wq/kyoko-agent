+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(base))
+
+        val encryptedReplies = base.copy(personaChatModel = "e2ee-gemma-4-26b-a4b-uncensored-p")
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.mainRoute(encryptedReplies))
+        assertEquals(RoutePrivacy.ENCRYPTED, RouteClassifier.personaRoute(encryptedReplies))
+
+        val localReplies = base.copy(personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434")
+        assertEquals(RoutePrivacy.OWN_NETWORK, RouteClassifier.personaRoute(localReplies))
+
+        val unknownProvider = base.copy(personaChatProvider = "Some Removed Provider")
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(unknownProvider))
+    }
+
+    @Test
+    fun `private means everything but plain hosted`() {
+        assertTrue(RoutePrivacy.ON_DEVICE.isPrivate)
+        assertTrue(RoutePrivacy.OWN_NETWORK.isPrivate)
+        assertTrue(RoutePrivacy.ENCRYPTED.isPrivate)
+        assertFalse(RoutePrivacy.HOSTED.isPrivate)
+    }
+
+    @Test
+    fun `each policy allows its routes and nothing less private`() {
+        val allowed = mapOf(
+            RoutePolicy.OWN_HARDWARE to setOf(RoutePrivacy.ON_DEVICE, RoutePrivacy.OWN_NETWORK),
+            RoutePolicy.ENCRYPTED to setOf(RoutePrivacy.ON_DEVICE, RoutePrivacy.OWN_NETWORK, RoutePrivacy.ENCRYPTED),
+            RoutePolicy.ANY to RoutePrivacy.entries.toSet()
+        )
+        for ((policy, routes) in allowed) {
+            for (route in RoutePrivacy.entries) {
+                assertEquals("$policy / $route", route in routes, policy.allows(route))
+            }
+        }
+    }
+
+    @Test
+    fun `the routes are ordered from the most private to the least`() {
+        val order = listOf(RoutePrivacy.ON_DEVICE, RoutePrivacy.OWN_NETWORK, RoutePrivacy.ENCRYPTED, RoutePrivacy.HOSTED)
+        assertEquals(order, RoutePrivacy.entries.toList())
+        for ((i, route) in order.withIndex()) {
+            for ((j, other) in order.withIndex()) {
+                assertEquals("$route / $other", i <= j, route.isAtLeastAsPrivateAs(other))
+            }
+        }
+    }
+
+    @Test
+    fun `http, and no scheme at all, is cleartext`() {
+        for (endpoint in listOf(
+            "http://192.168.1.20:11434", "HTTP://example.com/v1", "192.168.1.20:11434", "example.com/v1",
+            "  http://localhost:8080  "
+        )) {
+            assertTrue(endpoint, RouteClassifier.isCleartext(endpoint))
+        }
+        for (endpoint in listOf("https://api.venice.ai/api/v1", "HTTPS://example.com", "", "   ")) {
+            assertFalse(endpoint, RouteClassifier.isCleartext(endpoint))
+        }
+    }
+
+    @Test
+    fun `cleartext stays his only on this phone or his own network`() {
+        for (endpoint in listOf(
+            "http://127.0.0.1:8080/v1", "http://localhost:11434", "192.168.1.20:11434", "http://desktop.local:11434",
+            "http://100.101.102.103:11434", "gaming-pc:1234"
+        )) {
+            assertTrue(endpoint, RouteClassifier.cleartextStaysHis(endpoint))
+        }
+        for (endpoint in listOf(
+            "http://api.venice.ai/api/v1", "example.com/v1", "http://8.8.8.8", "http://192.168.1.1.nip.io",
+            // Text OkHttp and this check could read differently is taken for a public host.
+            "http://192.168.1.20 .example.com", "http://192.168.1.20@example.com/v1"
+        )) {
+            assertFalse(endpoint, RouteClassifier.cleartextStaysHis(endpoint))
+        }
+    }
+
+    @Test
+    fun `details are held back only on a plain hosted route with private mode on`() {
+        val on = LLMConfig(privateMode = true)
+        val off = LLMConfig(privateMode = false)
+        assertTrue(on.holdsBackDetails(RoutePrivacy.HOSTED))
+        assertFalse(off.holdsBackDetails(RoutePrivacy.HOSTED))
+        for (route in listOf(RoutePrivacy.ON_DEVICE, RoutePrivacy.OWN_NETWORK, RoutePrivacy.ENCRYPTED)) {
+            assertFalse(on.holdsBackDetails(route))
+        }
+    }
+}
