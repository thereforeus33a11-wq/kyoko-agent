+// ── "Try her brain". Each sentence says what the code does, and a test holds them against it.
+
+internal const val BRAIN_TRIAL_TITLE = "TRY HER BRAIN"
+
+/** Over the choices: what a try sends, where, what it costs and what it leaves behind. */
+internal const val BRAIN_TRIAL_HINT =
+    "Her real reply prompt, built the way her reply in the chat is (her card, her files, her notes, how she feels, the " +
+        "recent talk of your chat, then your message), goes to each model you tick, all at once, so you can read her " +
+        "replies side by side. Each goes the way it would as her brain: an e2ee model end to end encrypted, a Private-tier " +
+        "model to Venice readable to answer and nothing kept, only while you trust that tier for her. It is your act, on " +
+        "your Venice key, at the price shown, and leaves nothing behind: nothing is written to the chat, her notebook, her " +
+        "thoughts, her mood, her log, her memory or her sleep pass, what she overheard is not used up, and none of it is " +
+        "counted as a call of hers. No picture goes with a try, so every model is asked the same. The replies stay on " +
+        "this screen and are gone when you leave."
+
+/** Over the message field. */
+internal const val BRAIN_TRIAL_MESSAGE_HINT =
+    "Your message is put after the recent talk of the chat you are in, as if you had just sent it. It is not stored."
+
+/** Under the switch that asks the last real exchange again. */
+internal const val BRAIN_TRIAL_LAST_HINT =
+    "Asks again what your last message in that chat was answered with: the talk up to it, without her reply to it."
+
+/** Under the choices. */
+internal const val BRAIN_TRIAL_CHOOSE_HINT =
+    "Tick ${BrainModels.MIN_PER_TRY} to ${BrainModels.MAX_PER_TRY}. The shortlist is from public tests of writing, " +
+        "willingness and roleplay, none of them a test of her: her own replies are the test that counts."
+
+/** What "Use this one" does, under the results. */
+internal const val BRAIN_TRIAL_USE_HINT =
+    "Use this one: her replies, her notebook and her own time go to that model from now on, with reply options that ask " +
+        "it to answer without thinking first where Venice lets that be said; where it sees, pictures meant for her go to " +
+        "it directly, after the age check. The planner stays where it is, and \"Back to her brain before\" in Her own " +
+        "senses moves her back."
+
+/**
+ * "Try her brain": his message or the last real exchange, the models to tick with their route,
+ * senses, thinking and price, the price of the try, Ask or Stop, and her replies side by side
+ * as they come back, each with how long it took, its tokens, what it cost and a tap to make
+ * that model hers.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun BrainTrialScreen(viewModel: BrainTrialViewModel, onNavigateBack: () -> Unit) {
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(text = BRAIN_TRIAL_TITLE, fontFamily = FontFamily.Monospace, fontWeight = FontWeight.Bold, color = TextPrimary, fontSize = 20.sp)
+                },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(imageVector = Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back", tint = TextPrimary)
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBackground)
+            )
+        },
+        containerColor = DarkBackground
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .padding(horizontal = 16.dp, vertical = 8.dp)
+                .verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            Text(text = BRAIN_TRIAL_HINT, fontSize = 12.sp, color = TextSecondary)
+            if (viewModel.now.isNotEmpty()) Text(text = viewModel.now, fontSize = 11.sp, color = AccentCyan)
+
+            Text(text = "YOUR MESSAGE", fontSize = 11.sp, fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace, color = AccentCyan)
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Column(modifier = Modifier.weight(1f).padding(end = 12.dp)) {
+                    Text(text = "Ask the last real exchange again", fontSize = 14.sp, fontWeight = FontWeight.SemiBold, color = TextPrimary)
+                    Text(text = BRAIN_TRIAL_LAST_HINT, fontSize = 10.sp, color = TextSecondary)
+                }
+                Switch(checked = viewModel.useLast, onCheckedChange = viewModel::updateUseLast, enabled = !viewModel.running)
+            }
+            if (!viewModel.useLast) {
+                OutlinedTextField(
+                    value = viewModel.message,
+                    onValueChange = viewModel::updateMessage,
+                    label = { Text("Your message to her", fontSize = 12.sp) },
+                    enabled = !viewModel.running,
+                    minLines = 2,
+                    maxLines = 6,
+                    colors = fieldColors(),
+                    modifier = Modifier.fillMaxWidth()
+                )
+                Text(text = BRAIN_TRIAL_MESSAGE_HINT, fontSize = 10.sp, color = TextSecondary)
+            }
+
+            Text(text = "SHORTLIST", fontSize = 11.sp, fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace, color = AccentCyan)
+            viewModel.choices.filter { it.shortlisted }.forEach { ChoiceRow(it, viewModel) }
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(text = "Every other model she can be tried on", fontSize = 13.sp, color = TextPrimary, modifier = Modifier.weight(1f))
+                Switch(checked = viewModel.showAll, onCheckedChange = viewModel::updateShowAll)
+            }
+            if (viewModel.showAll) viewModel.choices.filterNot { it.shortlisted }.forEach { ChoiceRow(it, viewModel) }
+            Text(text = BRAIN_TRIAL_CHOOSE_HINT, fontSize = 10.sp, color = TextSecondary)
+
+            Text(
+                text = "This try: about ${BrainModels.cents(viewModel.cost())} on your Venice key, for a typical reply of hers " +
+                    "(${BrainModels.TYPICAL_PROMPT_TOKENS} tokens in, ${BrainModels.TYPICAL_REPLY_TOKENS} out) on each.",
+                fontSize = 12.sp,
+                color = TextPrimary
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {
+                if (viewModel.running) {
+                    OutlinedButton(onClick = viewModel::stop) { Text("STOP") }
+                    CircularProgressIndicator(modifier = Modifier.padding(start = 4.dp), strokeWidth = 2.dp)
+                } else {
+                    Button(onClick = viewModel::start) { Text("ASK THEM") }
+                }
+            }
+            if (viewModel.status.isNotEmpty()) Text(text = viewModel.status, fontSize = 12.sp, color = AccentCyan)
+            // Side by side, two to a row.
+            viewModel.rows.chunked(2).forEach { pair ->
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    pair.forEach { row -> ReplyTile(row, viewModel, Modifier.weight(1f)) }
+                    if (pair.size == 1) Box(modifier = Modifier.weight(1f))
+                }
+            }
+            if (viewModel.rows.isNotEmpty()) Text(text = BRAIN_TRIAL_USE_HINT, fontSize = 10.sp, color = TextSecondary)
+        }
+    }
+}
+
+@Composable
+private fun ChoiceRow(choice: BrainTrialViewModel.Choice, viewModel: BrainTrialViewModel) {
+    Row(
+        modifier = Modifier.fillMaxWidth().clickable(enabled = !viewModel.running) { viewModel.toggle(choice.id) },
+        verticalAlignment = Alignment.Top
+    ) {
+        Checkbox(
+            checked = choice.id in viewModel.chosen,
+            onCheckedChange = { viewModel.toggle(choice.id) },
+            enabled = !viewModel.running && (choice.whyNot == null || choice.id in viewModel.chosen)
+        )
+        Column(modifier = Modifier.weight(1f).padding(top = 4.dp)) {
+            val price = choice.typicalUsd?.let { " · about ${BrainModels.cents(it)} a reply" }.orEmpty()
+            val now = if (choice.current) " · now" else ""
+            Text(text = choice.label + price + now, fontSize = 13.sp, color = TextPrimary)
+            Text(text = "${choice.route}; ${choice.senses}; ${choice.thinking}.", fontSize = 10.sp, color = TextSecondary)
+            if (choice.note.isNotEmpty()) Text(text = choice.note, fontSize = 10.sp, color = TextSecondary)
+            choice.whyNot?.let { Text(text = it, fontSize = 10.sp, color = AccentCyan) }
+        }
+    }
+}
+
+@Composable
+private fun ReplyTile(row: BrainTrialViewModel.Row, viewModel: BrainTrialViewModel, modifier: Modifier) {
+    Column(
+        modifier = modifier
+            .border(1.dp, BorderColor, RoundedCornerShape(10.dp))
+            .padding(8.dp),
+        verticalArrangement = Arrangement.spacedBy(4.dp)
+    ) {
+        Text(text = row.choice.label, fontSize = 12.sp, fontWeight = FontWeight.SemiBold, color = TextPrimary)
+        Text(text = row.choice.route, fontSize = 10.sp, color = TextSecondary)
+        Text(text = row.choice.senses, fontSize = 10.sp, color = TextSecondary)
+        when (val shown = row.shown) {
+            null -> Text(text = "waiting", fontSize = 11.sp, color = TextSecondary)
+            is BrainTrial.Shown.Reply -> {
+                Text(text = shown.said.ifBlank { "(nothing said)" }, fontSize = 13.sp, color = TextPrimary)
+                if (shown.keptToHerself.isNotBlank()) {
+                    Text(text = "Kept to herself: ${shown.keptToHerself}", fontSize = 11.sp, fontStyle = FontStyle.Italic, color = TextSecondary)
+                }
+                shown.command?.let { Text(text = "Would end with \">> $it\" (not run)", fontSize = 11.sp, color = TextSecondary) }
+                if (shown.cutOff) Text(text = "Cut off at the length limit.", fontSize = 10.sp, color = AccentCyan)
+                val tokens = "${shown.promptTokens} in, ${shown.replyTokens} out" + if (shown.counted) " (Venice's count)" else " (estimated)"
+                val cost = shown.usd?.let { " · ${BrainModels.cents(it)}" }.orEmpty()
+                Text(text = seconds(row.millis) + " · " + tokens + cost, fontSize = 10.sp, color = TextSecondary)
+                if (row.choice.current) {
+                    Text(text = "Her brain now", fontSize = 11.sp, color = AccentCyan)
+                } else {
+                    TextButton(onClick = { viewModel.use(row.choice.id) }, enabled = !viewModel.running && row.choice.whyNot == null) {
+                        Text("USE THIS ONE", fontSize = 11.sp)
+                    }
+                }
+            }
+            is BrainTrial.Shown.Failed -> {
+                Text(text = shown.why, fontSize = 11.sp, color = AccentCyan)
+                Text(text = seconds(row.millis), fontSize = 10.sp, color = TextSecondary)
+            }
+            is BrainTrial.Shown.NotTried -> Text(text = "Not asked: ${shown.why}", fontSize = 11.sp, color = AccentCyan)
+        }
+    }
+}
+
+@Composable
+private fun fieldColors() = OutlinedTextFieldDefaults.colors(
+    focusedBorderColor = AccentCyan,
+    unfocusedBorderColor = BorderColor,
+    focusedTextColor = TextPrimary,
+    unfocusedTextColor = TextPrimary
+)
+
+private fun seconds(millis: Long?): String = String.format(Locale.US, "%.1f s", (millis ?: 0L) / 1000.0)
