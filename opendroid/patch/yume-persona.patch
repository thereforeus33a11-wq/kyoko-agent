@@ -0,0 +1,141 @@
+package com.opendroid.ai.core.agent
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * A screenshot shows whatever is open on his phone. It is taken only when his message
+ * asks for the screen to be looked at, or points at it with "this" and nothing else to
+ * point to. It is never taken because a word such as "showing" or "screen" happens to
+ * occur in talk, because he says something about his screen, or because he asks about
+ * what was just said ("what does that mean").
+ */
+class ScreenContextTest {
+
+    private val asksToLook = listOf(
+        "read my screen",
+        "Read my screen.",
+        "look at this screen",
+        "can you look at my screen for a sec",
+        "what is on my screen",
+        "what's on my screen?",
+        "whats on the screen",
+        "what’s on my screen",
+        "can you see my screen",
+        "check my screen",
+        "describe the screen",
+        "translate what is on my screen",
+        "read my screen and remember this",
+        "what am i looking at",
+        "hey what am I looking at here",
+        "read this",
+        "read this out",
+        "please read this for me",
+        "remember this",
+        "ok remember this",
+        "what is this",
+        "what's this?",
+        "whats this",
+        "what does this say",
+        "summarize this page",
+        "explain this message to me",
+        "what is this app",
+        // The request can come after a word to her or in a later clause.
+        "tell me what's on my screen",
+        "i'm stuck. read my screen",
+        "wait, look at my screen",
+        "yume, read my screen please",
+        "hey yume can you read my screen",
+        "take a look at my screen",
+        "what do you see on my screen",
+        "do you see my screen",
+        "could you check the display",
+        "what is shown on the display",
+        "read my screen: what does it say",
+        "please translate this page for me",
+        "what's this app?"
+    )
+
+    private val isJustTalk = listOf(
+        "stop showing off",
+        "what am i to you",
+        "remember this: i hate mushrooms",
+        "need sunscreen",
+        "you are not showing me anything new",
+        "i was looking at boots all day",
+        "what is this supposed to mean, you said you were busy",
+        "remember this next time you call me slow",
+        "read this: the hive needs a new queen",
+        "translate this message: hola amigo",
+        "i hate this app",
+        "the film was displayed in black and white",
+        "put it in my notes",
+        "save the meeting for tuesday",
+        "that is important information for later",
+        "check the screen time settings",
+        "i broke my screen protector",
+        "what do you see in me",
+        "screenshot",
+        "",
+        "   ",
+        // A follow-up to what was just said points at the talk, not at the screen.
+        "what does that mean",
+        "so what does it mean",
+        "what's that",
+        "what is that?",
+        "explain that",
+        "ok explain that please",
+        "remember that",
+        "save that",
+        "describe that",
+        "summarize it",
+        "what does it say",
+        "look at that",
+        // So does a bare request with nothing in it that names the screen.
+        "what do you see",
+        "explain this",
+        "translate this",
+        "save this",
+        "what does this mean",
+        "what is this message supposed to mean",
+        // Saying something about the screen asks nobody to look at it.
+        "i can't see the screen in this sun",
+        "i dropped it and now i can barely see my screen",
+        "i'll check the screen brightness later",
+        "check the screen brightness",
+        "did you see the display they had at the store",
+        "i can't read my screen without my glasses",
+        "i wanted to read the screen but it was too dark",
+        "stop looking at my screen",
+        "she never looks at the screen when she types",
+        "the cat sat on my screen again",
+        "what's on the screen door",
+        // Nor does talk about an app or a message.
+        "what is wrong with this app",
+        "why does everyone hate this app so much"
+    )
+
+    @Test
+    fun `a message that asks for the screen to be looked at takes a screenshot`() {
+        for (message in asksToLook) {
+            assertTrue("should capture: <$message>", ScreenContext.isAskedFor(message))
+        }
+    }
+
+    @Test
+    fun `talk takes none, whether it holds such a word, is about the screen or asks about what was said`() {
+        for (message in isJustTalk) {
+            assertFalse("should not capture: <$message>", ScreenContext.isAskedFor(message))
+        }
+    }
+
+    @Test
+    fun `an answer to a question the app asked never takes one`() {
+        val loop = java.io.File("src/main/java/com/opendroid/ai/core/agent/AgentLoop.kt").readText()
+        assertTrue(loop.contains("if (!isAnsweringPendingQuestion && ScreenContext.isAskedFor(query)) {"))
+        // The old list of words is gone, not merely unused.
+        assertFalse(loop.contains("screenPhrases"))
+        assertFalse(loop.contains("\"showing\""))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/LLMProviderFactoryRouteTest.kt
