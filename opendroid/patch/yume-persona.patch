+    private fun asked(): String = server.takeRequest().body?.utf8().orEmpty()
+
+    // ── The notebook pass ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a pass that is due is asked as her, and what she writes is in her notebook afterwards`() {
+        val engine = engine()
