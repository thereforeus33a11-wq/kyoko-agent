+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.security.MessageDigest
+
+/**
+ * Her originals and masters as the store keeps them: the pictures that come with the app put
+ * in once and never set back, reference sheets kept as they came and derived until he approves
+ * them, and a derived picture that the store will never hand out as a source.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class PersonaPicturesMastersTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val directory = File(File(context.filesDir, "persona"), "pictures")
+
+    @After
+    fun tearDown() {
+        File(context.filesDir, "persona").deleteRecursively()
+        File(context.cacheDir, "picked").deleteRecursively()
+    }
+
+    private fun png(width: Int, height: Int, color: Int = Color.rgb(214, 214, 214)): ByteArray {
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        bitmap.eraseColor(color)
+        return ByteArrayOutputStream().use { out -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, out); out.toByteArray() }
+    }
+
+    private fun sha(bytes: ByteArray) = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+    /** A build's assets, as a test hands them over. */
+    private class Bundled(var manifest: String?, val files: MutableMap<String, ByteArray> = HashMap()) : PersonaPictures.Bundle {
+        var opened = 0
+        override fun manifest(): String? = manifest
+        override fun open(file: String): ByteArray? {
+            opened++
+            return files[file]?.copyOf()
+        }
+    }
+
+    private val front = png(60, 90)
+    private val back = png(60, 90, Color.rgb(200, 200, 200))
+    private val face = png(70, 90, Color.rgb(190, 190, 190))
+
+    private fun manifest(vararg entries: Triple<String, String, ByteArray>, views: Map<String, String> = emptyMap()) =
+        """{"version":1,"files":[""" + entries.joinToString(",") { (file, kind, bytes) ->
+            """{"file":"$file","kind":"$kind","view":"${views[file] ?: "full body, front"}","sha256":"${sha(bytes)}","note":"3D model round 7 render; 2026-11-19"}"""
+        } + "]}"
+
+    private fun bundle() = Bundled(
+        manifest(
+            Triple("full_front.png", "ORIGINAL", front),
+            Triple("full_back.png", "MASTER", back),
+            Triple("face_front.png", "ORIGINAL", face),
+            views = mapOf("full_back.png" to "full body, back", "face_front.png" to "face close-up, front")
+        ),
+        mutableMapOf("full_front.png" to front, "full_back.png" to back, "face_front.png" to face)
+    )
+
+    private fun list(store: PersonaPictures) = runBlocking { store.list() }
+
+    @Test
+    fun `the pictures that come with the app are put in on the first start, as given, with their provenance, and only once`() {
+        val bundle = bundle()
+        val first = list(PersonaPictures(context, bundle))
+
+        assertEquals(listOf("reference picture: full body, front", "reference picture: full body, back", "reference picture: face close-up, front"), first.map { it.caption })
+        assertEquals(listOf(Provenance.ORIGINAL, Provenance.MASTER, Provenance.ORIGINAL), first.map { it.provenance })
+        assertTrue(first.all { it.origin == Origin.BUNDLED && it.asGiven && it.note == "3D model round 7 render; 2026-11-19" })
+        assertEquals("full body, back", first[1].view)
+        // Byte for byte, as PNGs.
+        assertArrayEquals(front, File(directory, first[0].file).readBytes())
+        assertArrayEquals(back, File(directory, first[1].file).readBytes())
+        assertTrue(first.all { it.file.endsWith(".png") })
+
+        // A later start, or a later build with the same pictures, puts in nothing more.
+        val opened = bundle.opened
+        val again = list(PersonaPictures(context, bundle))
+        assertEquals(first.map { it.id }, again.map { it.id })
+        assertEquals(opened, bundle.opened)
+        assertEquals(3, directory.listFiles()!!.count { it.name.endsWith(".png") })
+    }
+
+    @Test
+    fun `one he removed stays removed, and what he changed is never set back by a later start`() {
+        val bundle = bundle()
+        var store = PersonaPictures(context, bundle)
+        val (frontPicture, backPicture) = list(store)
+        runBlocking {
+            store.remove(frontPicture.id)
+            // He takes the bundled master out of the bases.
+            assertTrue(store.setProvenance(backPicture.id, Provenance.DERIVED))
+        }
+        // A later build lists the back as an original now: what he decided stands.
+        bundle.manifest = manifest(
+            Triple("full_front.png", "ORIGINAL", front),
+            Triple("full_back.png", "ORIGINAL", back),
+            Triple("face_front.png", "ORIGINAL", face)
+        )
+        store = PersonaPictures(context, bundle)
+        val after = list(store)
+        assertFalse(after.any { it.sha256 == sha(front) })
+        assertEquals(Provenance.DERIVED, after.single { it.id == backPicture.id }.provenance)
+        assertNull(runBlocking { store.source(backPicture.id) })
+    }
+
+    @Test
+    fun `an empty list, no list, and bytes that do not match the list put nothing in`() {
+        assertTrue(list(PersonaPictures(context, Bundled(null))).isEmpty())
+        assertTrue(list(PersonaPictures(context, Bundled("""{"version":1,"files":[]}"""))).isEmpty())
+        // The list names a hash the bytes do not have: left out, and tried again by a later build.
+        val wrong = Bundled(manifest(Triple("full_front.png", "ORIGINAL", front)), mutableMapOf("full_front.png" to back))
+        assertTrue(list(PersonaPictures(context, wrong)).isEmpty())
+        val fixed = Bundled(manifest(Triple("full_front.png", "ORIGINAL", front)), mutableMapOf("full_front.png" to front))
+        assertEquals(1, list(PersonaPictures(context, fixed)).size)
+        // The app's own assets carry no list in this build: nothing comes in.
+        File(context.filesDir, "persona").deleteRecursively()
+        assertTrue(list(PersonaPictures(context)).isEmpty())
+    }
+
+    @Test
+    fun `a later build with a new set retires the earlier one, so the new set is what she is matched to and sheets are made from`() {
+        val setA = bundle()
+        val first = list(PersonaPictures(context, setA))
+        val frontA = first.first()
+        // The next build brings re-rendered pictures, with new hashes, and no longer the earlier ones.
+        val frontB = png(60, 90, Color.rgb(215, 215, 215))
+        val backB = png(60, 90, Color.rgb(201, 201, 201))
+        val faceB = png(70, 90, Color.rgb(191, 191, 191))
+        val setB = Bundled(
+            manifest(
+                Triple("full_front.png", "ORIGINAL", frontB),
+                Triple("full_back.png", "ORIGINAL", backB),
+                Triple("face_front.png", "ORIGINAL", faceB),
+                views = mapOf("full_back.png" to "full body, back", "face_front.png" to "face close-up, front")
+            ),
+            mutableMapOf("full_front.png" to frontB, "full_back.png" to backB, "face_front.png" to faceB)
+        )
+        val store = PersonaPictures(context, setB)
+        val after = list(store)
+        assertEquals(6, after.size)
+        val earlier = after.filter { it.sha256 in setOf(sha(front), sha(back), sha(face)) }
+        assertTrue(earlier.all { it.provenance == Provenance.DERIVED && PictureSources.line(it) == PictureSources.RETIRED_LINE })
+        // Never a source again, though the files stay for him to look at or remove.
+        assertNull(runBlocking { store.source(frontA.id) })
+        assertTrue(earlier.all { File(directory, it.file).isFile })
+        val newer = after.filter { it.sha256 in setOf(sha(frontB), sha(backB), sha(faceB)) }
+        assertEquals(listOf(sha(frontB), sha(faceB)), PersonaSelfPictures.references(after).map { it.sha256 })
+        val sheets = (ReferenceSheets.plan(after) as ReferenceSheets.Planned.Sheets).sheets
+        assertTrue(sheets.all { sheet -> newer.any { it.id == sheet.source.id } })
+        // A later start of the same build changes nothing more.
+        assertEquals(after, list(PersonaPictures(context, setB)))
+    }
+
+    @Test
+    fun `what goes to an image model of a photo he added carries none of its metadata, and his file keeps it`() {
