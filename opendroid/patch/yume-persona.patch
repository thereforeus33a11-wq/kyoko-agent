+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.Wonders
+import com.opendroid.ai.core.life.reading.Glance
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaRein
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * Her own time: moments in which she is awake although nobody wrote to her.
+ *
+ * A model only runs while a request is being answered, so this is what "her own time"
+ * can truthfully mean: each time she is awake she says when she wants to be awake next
+ * ([Wish]), the app keeps that time ([State]) and wakes her then with one request of her
+ * own, and what she does with the moment is hers to decide ([Moment]). Nothing is asked
+ * of her in it. The app is only the clock.
+ *
+ * The owner sets two bounds ([Bounds]), because every moment is a model call on his
+ * key: how close two moments may be and how many there may be in a day. She is told
+ * both numbers, and told when a wish of hers was moved to fit them.
+ *
+ * Everything in this file is a decision about text and time. Asking the model, keeping
+ * her thoughts and waking the phone are done elsewhere.
+ */
+object PersonaOwnTime {
+
+    private const val MINUTE = 60_000L
+    private const val HOUR = 60 * MINUTE
+    const val DAY_MILLIS = 24 * HOUR
+
+    /** How long after her own time is switched on, or after her first reply, the first moment comes. */
+    const val FIRST_MOMENT_AFTER_MILLIS = 20 * MINUTE
+
+    /** The gap to her next moment when she has never named one. */
+    const val DEFAULT_GAP_MILLIS = HOUR
+
+    /** How far ahead a wish may reach. */
+    const val MAX_WISH_MILLIS = 7 * DAY_MILLIS
+
+    /** After an attempt that failed (no network yet, a refusal by the host) the moment is tried again this much later. */
+    const val RETRY_AFTER_FAILURE_MILLIS = 15 * MINUTE
+
+    /** The longest wait between two attempts when one after another fails. */
+    const val MAX_RETRY_WAIT_MILLIS = 6 * HOUR
+
+    /**
+     * How long after a failed attempt the moment is tried again, with [failures] attempts
+     * having failed in a row before it. The first wait is the short one. Each further
+     * failure doubles it, up to [MAX_RETRY_WAIT_MILLIS]: an attempt that reaches the
+     * model is a call on the owner's key whether it fails or not, and attempts do not
+     * count against the day, so a model that fails every time must not be asked every
+     * quarter of an hour for ever.
+     */
+    fun retryWaitMillis(failures: Int): Long =
+        (RETRY_AFTER_FAILURE_MILLIS shl failures.coerceIn(0, 10)).coerceAtMost(MAX_RETRY_WAIT_MILLIS)
+
+    /** When the owner is in the middle of something, the moment is put off by this much. */
+    const val PUT_OFF_MILLIS = 5 * MINUTE
+
+    /** An app line older than this is not put in front of her in a moment of her own. See [appLineMaxAgeMillis]. */
+    const val MAX_APP_LINE_AGE_MILLIS = 30 * MINUTE
+
+    /**
+     * How old one of the app's lines may be and still be put in front of her in a moment
+     * of her own. Hours can lie between two moments, so as a rule only the last half hour
+     * is. When she wrote a command in her last moment the lines reach back to that
+     * moment: the rows that say what became of the command were written right after it,
+     * and without them she could not know whether it ran, or use what it read.
+     */
+    fun appLineMaxAgeMillis(state: State, nowMillis: Long): Long =
+        if (state.lastHadCommand && state.lastAtMillis > 0) {
+            maxOf(MAX_APP_LINE_AGE_MILLIS, nowMillis - state.lastAtMillis)
+        } else {
+            MAX_APP_LINE_AGE_MILLIS
+        }
+
+    /** The scheduled work may ring this much before the stored time and still count as on time. */
+    const val EARLY_SLACK_MILLIS = 30_000L
+
+    // ── The owner's bounds ───────────────────────────────────────────────────────────
+
+    /**
+     * The owner's two settings: the least time between two moments, and the most
+     * moments in any 24 hours. With [maxPerDay] at zero she has no time of her own.
+     */
+    data class Bounds(val minGapMillis: Long, val maxPerDay: Int) {
+        companion object {
+            fun of(config: LLMConfig): Bounds = Bounds(
+                minGapMillis = config.personaOwnTimeMinGapMinutes.toLong().coerceIn(1, MAX_WISH_MILLIS / MINUTE) * MINUTE,
+                maxPerDay = config.personaOwnTimeMaxPerDay.coerceAtLeast(0)
+            )
+        }
+    }
+
+    /** Whether the owner's settings give her time of her own at all. Whether she is on is asked elsewhere. */
+    fun isOn(config: LLMConfig): Boolean = config.personaCheckInsEnabled && Bounds.of(config).maxPerDay > 0
+
+    // ── What she asks for ────────────────────────────────────────────────────────────
+
+    /** When she wants her next moment, as she wrote it after `next:`. */
+    sealed class Wish {
+        /** So long from now. */
+        data class After(val millis: Long) : Wish()
+
+        /** The next time his clock shows this time. */
+        data class At(val hour: Int, val minute: Int) : Wish()
+
+        /** Not until he writes to her again: the wait ends with her reply to that message. */
+        object WhenHeWrites : Wish()
+    }
+
+    private val WHEN_HE_WRITES = Regex("""when he (?:next )?(?:writes|texts|messages)(?: me| to me)?(?: again| next)?""")
+    private val CLOCK = Regex("""(?:at )?(\d{1,2}):(\d{2})""")
+    private val TRAILING_BRACKETS = Regex("""\s*\([^)]*\)\s*$""")
+    private val SPAN_PART = Regex("""(\d{1,5})\s*(d|days?|h|hrs?|hours?|m|mins?|minutes?)""")
+    private val SPAN = Regex("""(?:in )?(?:${SPAN_PART.pattern}\s*(?:and\s+|,\s*)?)+""")
+    private val HOURS_THEN_BARE_MINUTES = Regex("""(?:in )?(\d{1,5})\s*h\s*(\d{1,2})""")
+
+    /**
+     * Reads what stands after `next:`. The forms are few on purpose: a span of time
+     * (20m, 3h, 1h30m, 2d, "45 min", "2 hours"), a time on his clock (02:30), or
+     * "when he writes". Anything else is not guessed at: null, and the default applies.
+     */
+    fun parseWish(text: String): Wish? {
+        // "02:30 (his clock)" is how her prompt writes the form: the brackets are not part of the time.
+        val wish = TRAILING_BRACKETS.replace(text.trim().lowercase(), "").trim('.', '`', '"', '\'', ' ')
+        if (wish.isEmpty()) return null
+        if (WHEN_HE_WRITES.matches(wish)) return Wish.WhenHeWrites
+        CLOCK.matchEntire(wish)?.let { clock ->
+            val hour = clock.groupValues[1].toInt()
+            val minute = clock.groupValues[2].toInt()
+            return if (hour in 0..23 && minute in 0..59) Wish.At(hour, minute) else null
+        }
+        HOURS_THEN_BARE_MINUTES.matchEntire(wish)?.let { span ->
+            val minutes = span.groupValues[2].toLong()
+            return if (minutes < 60) Wish.After(span.groupValues[1].toLong() * HOUR + minutes * MINUTE) else null
+        }
+        if (!SPAN.matches(wish)) return null
+        val millis = SPAN_PART.findAll(wish).sumOf { part ->
+            val count = part.groupValues[1].toLong()
+            when (part.groupValues[2].first()) {
+                'd' -> count * DAY_MILLIS
+                'h' -> count * HOUR
+                else -> count * MINUTE
+            }
+        }
+        return Wish.After(millis)
+    }
+
+    // ── What the app keeps ───────────────────────────────────────────────────────────
+
+    /** When she is woken next. */
+    sealed class Wake {
+        /** No time has been set yet: her own time has not started. */
+        object Unset : Wake()
+
+        /** She asked not to be woken until he writes. */
+        object WhenHeWrites : Wake()
+
+        data class At(val atMillis: Long) : Wake()
+    }
+
+    /** Why the stored time is what it is. Her next moment opens with it. */
+    enum class Why {
+        /** The first moment after her own time was switched on. */
+        FIRST,
+
+        /** She named the time. */
+        ASKED,
+
+        /** She named none, so the default applied. */
+        DEFAULT,
+
+        /** She had asked to be woken when he writes; he wrote, she answered, and the default applied from there. */
+        AFTER_HE_WROTE,
+
+        /** She woke up on her own from a sleep, at the time she named: this moment is her waking. */
+        WOKE,
+
+        /** A message of his woke her from a sleep, and the default gap applied from her reply to it. */
+        WOKEN,
+
+        /** He unlocked the phone after a long while without writing, so the time she named was brought forward ([broughtForward]). */
+        UNLOCKED,
+
+        /** She came back from an outing of hers, so her next moment was brought forward ([cameBackAt]). */
+        CAME_BACK
+    }
+
+    /** What she did with a moment. */
+    enum class Did {
+        /** She wrote a line to him. */
+        SAID,
+
+        /** She thought, or kept a note, and said nothing to him. */
+        KEPT,
+
+        /** She let it pass. */
+        PASSED
+    }
+
+    /** In what way a wish of hers was moved before it became the stored time. */
+    enum class Moved {
+        /** Sooner than the least time between two moments. */
+        TOO_SOON,
+
+        /** Further off than a wish may reach. */
+        TOO_FAR,
+
+        /** The day's moments were used up at the time she asked for. */
+        DAY_USED_UP,
+
+        /** What she wrote after `next:` could not be read, so the default applied. */
+        NOT_READ,
+
+        /** His number of calls on her own was used up at the time she asked for (her own life's ledger). */
+        CALLS_USED_UP
+    }
+
+    /**
+     * What she did on her last outing, as the app wrote it when it ended: the kind, her
+     * own `go:` words, when it ran, how long she was at it, counts, the titles of up to
+     * [MAX_OUTING_TITLES] things she opened (other people's words), how it ended
+     * ([HerLog.EndedBy] by name) and whether her one `say:` went to him. Nothing she
+     * thought, noted or felt on it: those went where their marks say.
+     */
+    data class LastOuting(
+        val kind: String,
+        val words: String,
+        val startedAt: Long,
+        val endedAt: Long,
+        val minutes: Int,
+        val steps: Int,
+        val opened: Int,
+        val searches: Int,
+        val titles: List<String>,
+        val ended: String,
+        val said: Boolean,
+        /** Pictures the describer looked at for her on it (her eyes). */
+        val looked: Int = 0,
+        /** For a look through the camera: which camera ("back camera"). Empty for an outing that was no look. */
+        val camera: String = "",
+        /** For a look that came to nothing she was shown: why, in the app's own words (never the describer's). */
+        val unseen: String = "",
+        /** Lines of hers about a kid that were not kept in its last step, told in the moment after it (PK-2). */
+        val untoldDrops: Int = 0,
+        /** Something marked as a kid's was in front of her on it: her lines in the moment after it are checked (§1.4). */
+        val metKid: Boolean = false
+    ) {
+        /** A look through the camera rather than an outing to read. */
+        val isLook: Boolean get() = kind == OutingKind.Kind.LOOK.name.lowercase()
+    }
+
+    /** A `go:` line of hers that did not start, with why ([HerLog.NotStarted] by name): she is told at her next moment. */
+    data class GoMissed(val words: String, val why: String)
+
+    /** The most titles of an outing kept for the moment after it. */
+    const val MAX_OUTING_TITLES = 5
+
+    /**
+     * Everything the app keeps about her own time. [on] says the app has seen it
+     * switched on, so that it can tell the moment it is switched on again. [moments] are
+     * the times of her moments in the last day, oldest first. [lastGapMillis] is the
+     * last gap she chose herself, 0 when she has chosen none. [moved] with [movedAsked]
+     * is what she is told at her next moment about a wish that was moved. [failures]
+     * counts the attempts at the moment that is due which failed one after another.
+     *
+     * The rest is her sleep ([PersonaSleep]). [asleepSince] is 0 while she is awake;
+     * otherwise it is when she lay down, which also tells one sleep from the next. She
+     * means to wake at [sleepUntil], [sleepMeantMillis] after she lay down as the app
+     * took what she asked for ([sleepAsked], moved as [sleepMoved] says). A sleep pass is
+     * due at [repairDueAt] (0 for none), has been tried [repairTries] times in this
+     * sleep, and is [repairOwed] when one did not come about. [repairMissed] counts the
+     * sleeps in a row whose pass was tried and did not come about. [lastRepairOkAt] is when
+     * the last pass came about, and [lastRepair] what the last one came to, in counts.
+     * [lastWokeAt], [wokeBy], [lastSleptMillis] and [lastMeantMillis] are about her last
+     * waking, and [lastSleepSpanMillis] is her usual length. While she sleeps [wake] is
+     * the sooner of her pass and her waking, so the alarm has one time to go by.
+     * When an unlock brought her next moment forward ([Why.UNLOCKED]), [broughtFromAt]
+     * and [broughtFromWhy] are the time and the reason it had before ([unlocked]): a
+     * message of his before then puts them back ([setBack]).
+     */
+    data class State(
+        val on: Boolean = false,
+        val wake: Wake = Wake.Unset,
+        val why: Why = Why.FIRST,
+        val moments: List<Long> = emptyList(),
+        val lastGapMillis: Long = 0,
+        val lastAtMillis: Long = 0,
+        val lastDid: Did? = null,
+        val lastHadCommand: Boolean = false,
+        val moved: Moved? = null,
+        val movedAsked: String = "",
+        val failures: Int = 0,
+        val asleepSince: Long = 0,
+        val sleepUntil: Long = 0,
+        val sleepMeantMillis: Long = 0,
+        val sleepAsked: String = "",
+        val sleepMoved: PersonaSleep.SleepMoved? = null,
+        val repairDueAt: Long = 0,
+        val repairTries: Int = 0,
+        val repairOwed: Boolean = false,
+        val repairMissed: Int = 0,
+        val lastRepairOkAt: Long = 0,
+        val lastRepair: PersonaSleep.Repair? = null,
+        val lastWokeAt: Long = 0,
+        val wokeBy: PersonaSleep.WokeBy? = null,
+        val lastSleptMillis: Long = 0,
+        val lastMeantMillis: Long = 0,
+        val lastSleepSpanMillis: Long = 0,
+        val broughtFromAt: Long = 0,
+        val broughtFromWhy: Why? = null,
+        /** Her last outing ([LastOuting]), told in the first moment after it. */
+        val lastOuting: LastOuting? = null,
+        /** A `go:` of hers that did not start ([GoMissed]), told at her next moment. */
+        val goMissed: GoMissed? = null,
+        /** Lines of hers about a kid not kept in her last moment, told at her next one (PK-2). */
+        val kidNotKept: Int = 0
+    ) {
+        /** Her moments that still count at [nowMillis]: those of the 24 hours before it. */
+        fun momentsOfTheDay(nowMillis: Long): List<Long> = moments.filter { it > nowMillis - DAY_MILLIS && it <= nowMillis }
+    }
+
+    @Serializable
+    private data class Record(
+        val on: Boolean = false,
+        val wake: String = "",
+        val wakeAt: Long = 0,
+        val why: String = "",
+        val moments: List<Long> = emptyList(),
+        val gap: Long = 0,
+        val lastAt: Long = 0,
+        val lastDid: String = "",
+        val lastCommand: Boolean = false,
+        val moved: String = "",
+        val movedAsked: String = "",
+        val failures: Int = 0,
+        val asleepSince: Long = 0,
+        val sleepUntil: Long = 0,
+        val sleepMeant: Long = 0,
+        val sleepAsked: String = "",
+        val sleepMoved: String = "",
+        val repairDueAt: Long = 0,
