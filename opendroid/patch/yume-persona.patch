@@ -0,0 +1,80 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.eyes.CameraArm
+import com.opendroid.ai.core.life.eyes.HerCamera
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * What the status card is told about her own life, read in one go: his settings, the
+ * ledger's counts for the last 24 hours, what she is doing now, the log's entries and how
+ * many wonders she has open. Counts, times and places only: the text of her wonders is
+ * read to count them and goes no further.
+ */
+@Singleton
+class OwnLifeStatus internal constructor(
+    private val config: suspend () -> LLMConfig,
+    private val ledger: OwnLedger,
+    private val log: HerLog,
+    private val herNow: HerNow,
+    private val wonders: Wonders,
+    /** Whether the service holds the camera type now, for her camera looks. */
+    private val cameraHeld: () -> Boolean = { false },
+    /** Whether the phone has a camera the app may use. */
+    private val cameraReady: () -> Boolean = { false },
+    /** What her ears are doing now; null where she has none. */
+    private val ears: () -> com.opendroid.ai.core.life.ears.HerEars.Status? = { null }
+) {
+    @Inject
+    constructor(
+        settings: SettingsRepository,
+        ledger: OwnLedger,
+        log: HerLog,
+        herNow: HerNow,
+        wonders: Wonders,
+        arm: CameraArm,
+        camera: HerCamera,
+        ears: com.opendroid.ai.core.life.ears.HerEars
+    ) : this({ settings.llmConfig.first() }, ledger, log, herNow, wonders, { arm.held.value }, camera::ready, { ears.status.value })
+
+    data class Snapshot(
+        val config: LLMConfig,
+        /** The ledger's counts for the last 24 hours under his cap, or null when it cannot be read. */
+        val summary: OwnLedger.Summary?,
+        val now: HerNow.Now,
+        val entries: List<HerLog.Entry>,
+        /** How many wonders she has open, or null when her list cannot be read. */
+        val openWonders: Int?,
+        /** The service holds the camera type: a look can be had once she asks for one. */
+        val cameraHeld: Boolean = false,
+        /** The phone has a camera and the app may use it. */
+        val cameraReady: Boolean = true,
+        /** What her ears are doing now, in counts and why; null where she has none. */
+        val ears: com.opendroid.ai.core.life.ears.HerEars.Status? = null
+    )
+
+    suspend fun read(nowMillis: Long): Snapshot {
+        val settings = config()
+        return withContext(Dispatchers.IO) {
+            Snapshot(
+                config = settings,
+                summary = ledger.summary(OwnLife.capOf(settings), nowMillis),
+                now = herNow.now.value,
+                entries = log.entries(),
+                openWonders = try {
+                    wonders.count()
+                } catch (e: Exception) {
+                    null
+                },
+                cameraHeld = cameraHeld(),
+                cameraReady = cameraReady(),
+                ears = ears()
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/Wonders.kt b/app/src/main/java/com/opendroid/ai/core/life/Wonders.kt
new file mode 100644
index 0000000..2f1449a
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/Wonders.kt
@@ -0,0 +1,219 @@
+package com.opendroid.ai.core.life
+
+import android.content.Context
+import android.util.Log
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.core.security.AndroidKeyStoreAeadCipher
+import com.opendroid.ai.core.security.SecretAeadCipher
+import com.opendroid.ai.core.security.SecretEnvelope
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her curiosity: the questions she wrote down with `wonder:` and has not looked into yet.
+ * At most [MAX] are kept; past that the oldest falls off. She closes one with
+ * `wonder: <the same words> | gone`. Her moments show the list with how old each is, so
+ * there is always something for her to be curious about without anyone prompting her.
+ *
+ * They are hers, like her thoughts: one file in the app's own storage, sealed with a key
+ * that stays in the phone's Keystore. No log line, screen or notification carries what
+ * they say; the status card is told how many there are. A file that cannot be opened now
+ * reads as empty and is not written over until it opens again.
+ */
+@Singleton
+class Wonders internal constructor(
+    private val directory: () -> File,
+    private val cipher: SecretAeadCipher
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(
+        { File(context.filesDir, DIRECTORY) },
+        AndroidKeyStoreAeadCipher(KEY_ALIAS)
+    )
+
+    /** One question of hers, and when she wrote it. */
+    data class Wonder(val text: String, val atMillis: Long)
+
+    /** A `wonder:` line, read: a question to add, or one she lets go. */
+    sealed class Line {
+        abstract val text: String
+
+        data class Add(override val text: String) : Line()
+
+        data class Gone(override val text: String) : Line()
+    }
+
+    private val lock = Mutex()
+    private var held: List<Wonder>? = null
+
+    private val file: File get() = File(directory(), FILE)
+
+    /** Her open wonders, oldest first. Empty when the file cannot be opened now. */
+    suspend fun open(): List<Wonder> = work { read().orEmpty() }
+
+    /** How many are open. Nothing of what they say. */
+    suspend fun count(): Int = open().size
+
+    /**
+     * Applies her `wonder:` lines, in order: an [Line.Add] adds the question (one she
+     * has already is not added twice, it keeps its age), a [Line.Gone] closes the open
+     * one with the same words. Returns false when the file could not be read or written.
+     */
+    suspend fun apply(lines: List<Line>, atMillis: Long = System.currentTimeMillis()): Boolean = work {
+        val current = read() ?: return@work false
+        var all = current
+        for (line in lines) {
+            all = when (line) {
+                is Line.Add -> if (all.any { same(it.text, line.text) }) all else (all + Wonder(line.text, atMillis)).takeLast(MAX)
+                is Line.Gone -> {
+                    val match = closest(all, line.text)
+                    if (match == null) all else all - match
+                }
+            }
+        }
+        if (all == current) return@work true
+        if (!write(all)) return@work false
+        held = all
+        true
+    }
+
+    /** Deletes them all. */
+    suspend fun wipe() = work {
+        held = emptyList()
+        if (file.exists() && !file.delete()) throw IOException("Her wonders could not be removed")
+    }
+
+    private suspend fun <T> work(block: () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }
+
+    private fun read(): List<Wonder>? {
+        held?.let { return it }
+        val target = file
+        return try {
+            val read = if (!target.isFile) emptyList() else {
+                val envelope = SecretEnvelope.decode(target.readText().trim()) ?: throw IOException("Not a sealed file")
+                val plain = cipher.decrypt(envelope.iv, envelope.ciphertext, AAD)
+                JSON.decodeFromString(ListSerializer(Entry.serializer()), String(plain, Charsets.UTF_8)).map { Wonder(it.text, it.at) }
+            }
+            held = read
+            read
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her wonders could not be read this time: ${e.javaClass.simpleName}")
+            null
+        }
+    }
+
+    private fun write(all: List<Wonder>): Boolean = try {
+        val target = file
+        val folder = target.parentFile ?: throw IOException("No directory")
+        if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+        val plain = JSON.encodeToString(ListSerializer(Entry.serializer()), all.map { Entry(it.atMillis, it.text) })
+        val sealed = SecretEnvelope.encode(cipher.encrypt(plain.toByteArray(Charsets.UTF_8), AAD))
+        val draft = File(folder, "$FILE.tmp")
+        try {
+            FileOutputStream(draft).use { out ->
+                out.write(sealed.toByteArray(Charsets.UTF_8))
+                out.fd.sync()
+            }
+            if (!draft.renameTo(target)) throw IOException("The file could not be put in place")
+        } finally {
+            draft.delete()
+        }
+        true
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        Log.w(TAG, "Her wonders could not be written: ${e.javaClass.simpleName}")
+        false
+    }
+
+    @Serializable
+    private data class Entry(val at: Long, val text: String)
+
+    companion object {
+        private const val TAG = "Wonders"
+        private const val DIRECTORY = "persona"
+        private const val FILE = "wonders.sealed"
+        private const val KEY_ALIAS = "opendroid.persona_wonders.aes_gcm.v1"
+        private val AAD = "persona-wonders".toByteArray(Charsets.UTF_8)
+        private val JSON = Json { ignoreUnknownKeys = true }
+
+        /** The mark of the line. */
+        const val MARK = "wonder:"
+
+        /** How many open wonders are kept. Past it the oldest falls off. */
+        const val MAX = 12
+
+        /** How many `wonder:` lines a moment may write. */
+        const val PER_MOMENT = 2
+
+        /** The longest question kept. */
+        const val MAX_CHARS = 200
+
+        private const val GONE = "gone"
+        private val CONTROL = Regex("""[\u0000-\u001F\u007F]""")
+
+        /**
+         * Reads what follows the mark: `<a question>` or `<the same words> | gone`. Null
+         * when there is no question in it.
+         */
+        fun parse(rest: String): Line? {
+            val flat = CONTROL.replace(rest, " ").replace(Regex("""\s+"""), " ").trim()
+            val bar = flat.lastIndexOf('|')
+            if (bar >= 0 && flat.substring(bar + 1).trim().trimEnd('.').equals(GONE, ignoreCase = true)) {
+                val words = text(flat.substring(0, bar)) ?: return null
+                return Line.Gone(words)
+            }
+            return text(flat)?.let { Line.Add(it) }
+        }
+
+        private fun text(raw: String): String? {
+            val words = raw.replace("===", "= = =").trim().trim('"', '“', '”', '「', '」').trim()
+            if (words.none { it.isLetterOrDigit() }) return null
+            return if (words.length <= MAX_CHARS) words else words.take(MAX_CHARS - 1).trimEnd() + "…"
+        }
+
+        private fun normal(text: String): String =
+            text.lowercase().replace(Regex("""[^\p{L}\p{N}]+"""), " ").trim()
+
+        private fun same(a: String, b: String): Boolean = normal(a) == normal(b)
+
+        /**
+         * The open wonder she means by [words]: the one with the same words, else the one
+         * that shares most of its words with them, at least four in five of the shorter's.
+         */
+        internal fun closest(open: List<Wonder>, words: String): Wonder? {
+            open.firstOrNull { same(it.text, words) }?.let { return it }
+            val asked = normal(words).split(' ').filter { it.isNotEmpty() }.toSet()
+            if (asked.isEmpty()) return null
+            return open.map { wonder ->
+                val have = normal(wonder.text).split(' ').filter { it.isNotEmpty() }.toSet()
+                val shared = (asked intersect have).size
+                wonder to shared * 100 / minOf(asked.size, have.size).coerceAtLeast(1)
+            }.filter { it.second >= 80 }.maxByOrNull { it.second }?.first
+        }
+
+        /**
+         * The line of "about this moment" that lists them, or null when there are none:
+         * things you wondered about, still on your list: "…" (yesterday), "…" (5 h ago).
+         */
+        fun momentLine(open: List<Wonder>, nowMillis: Long): String? {
+            if (open.isEmpty()) return null
+            return "- things you wondered about, still on your list: " +
+                open.joinToString(", ") { "\"${it.text}\" (${PersonaPrompts.age(nowMillis - it.atMillis)})" } + "."
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/AndroidOnDeviceHearing.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/AndroidOnDeviceHearing.kt
new file mode 100644
index 0000000..632eec8
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/AndroidOnDeviceHearing.kt
@@ -0,0 +1,217 @@
+package com.opendroid.ai.core.life.ears
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.RecognitionListener
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import android.util.Log
+import androidx.core.content.ContextCompat
+import com.opendroid.ai.core.voice.PreferredRecognizer
+import com.opendroid.ai.core.voice.VoiceOut
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.util.Locale
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her ears' fallback (OWN_LIFE_PLAN phase 3, engine order 2): Android's own recogniser, only
+ * the one that is guaranteed to stay on the phone ([PreferredRecognizer.create] gives it, as
+ * [PreferredRecognizer.Handle.onDevice], on Android 12 and later). The default recogniser, which may send the room to its maker's
+ * servers, is never used here, not even when asked to work offline.
+ *
+ * It listens in rounds, one after the other, while she is awake. It cannot tell one voice
+ * from another, so everything it hears is [Voice.NOT_ENROLLED]; it cannot cut her own voice
+ * out of the sound, so it does not listen while the phone speaks, nor for
+ * [HearingRules.TAIL_MILLIS] after, and a transcript that reads like a line the phone just
+ * said is dropped. Talking over her does not cut her off with it. What it hears goes to the
+ * listener and nowhere else (I6).
+ */
+@Singleton
+class AndroidOnDeviceHearing @Inject constructor(
+    @ApplicationContext private val context: Context,
+) : HearingEngine {
+
+    private val main = Handler(Looper.getMainLooper())
+    @Volatile private var listener: HearingEngine.Listener? = null
+    @Volatile private var recognizer: SpeechRecognizer? = null
+    @Volatile private var paused = false
+    @Volatile private var listening = false
+    @Volatile private var open = false
+    private var round = 0
+    private var startedAt = 0L
+    private var speechAt: Long? = null
+    private var endedAt: Long? = null
+
+    override val isOpen: Boolean get() = open
+
+    override fun open(listener: HearingEngine.Listener): HearingEngine.Closed? {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            return HearingEngine.Closed.NO_PERMISSION
+        }
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S || !PreferredRecognizer.isOnDeviceAvailable(context)) {
+            return HearingEngine.Closed.NOT_ON_DEVICE
+        }
+        this.listener = listener
+        if (open) return null
+        open = true
+        paused = false
+        main.post { next(0) }
+        return null
+    }
+
+    override fun pause() {
+        paused = true
+        main.post { stopRound() }
+    }
+
+    override fun resume() {
+        paused = false
+        main.post { next(0) }
+    }
+
+    override fun close() {
+        open = false
+        paused = false
+        main.post {
+            stopRound()
+            recognizer?.destroy()
+            recognizer = null
+        }
+    }
+
+    // On the main thread, like every call of the recogniser.
+    private fun next(delay: Long) {
+        main.removeCallbacks(start)
+        if (open && !paused) main.postDelayed(start, delay)
+    }
+
+    private val start = Runnable { startRound() }
+
+    private fun startRound() {
+        if (!open || paused || listening) return
+        // While the phone speaks, and just after, it would hear her: it waits.
+        val playing = VoiceOut.playingSince() != null
+        val lastEnd = VoiceOut.since(HearingRules.now() - HearingRules.TAIL_MILLIS).mapNotNull { it.endedAt }.maxOrNull()
+        if (playing || (lastEnd != null && HearingRules.now() - lastEnd < HearingRules.TAIL_MILLIS)) {
+            next(WAIT_FOR_HER_MILLIS)
+            return
+        }
+        val r = recognizer ?: run {
+            // Only the recogniser that stays on the phone: the default one, whose maker may get
+            // the sound of the room, is let go of unused.
+            val handle = try {
+                PreferredRecognizer.create(context, allowOnDevice = true)
+            } catch (e: Exception) {
+                null
+            }
+            if (handle == null || !handle.onDevice) {
+                handle?.recognizer?.destroy()
+                fail(HearingEngine.Closed.NOT_ON_DEVICE)
+                return
+            }
+            recognizer = handle.recognizer
+            handle.recognizer
+        }
+        val mine = ++round
+        listening = true
+        startedAt = HearingRules.now()
+        speechAt = null
+        endedAt = null
+        r.setRecognitionListener(object : RecognitionListener {
+            override fun onReadyForSpeech(params: Bundle?) = Unit
+            override fun onBeginningOfSpeech() {
+                if (mine == round) speechAt = HearingRules.now()
+            }
+
+            override fun onRmsChanged(rmsdB: Float) = Unit
+            override fun onBufferReceived(buffer: ByteArray?) = Unit
+            override fun onEndOfSpeech() {
+                if (mine == round) endedAt = HearingRules.now()
+            }
+
+            override fun onPartialResults(partialResults: Bundle?) = Unit
+            override fun onEvent(eventType: Int, params: Bundle?) = Unit
+
+            override fun onError(error: Int) {
+                if (mine != round) return
+                listening = false
+                when {
+                    PreferredRecognizer.isLanguageFailure(error) -> fail(HearingEngine.Closed.NOT_ON_DEVICE)
+                    error == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> fail(HearingEngine.Closed.NO_PERMISSION)
+                    error == SpeechRecognizer.ERROR_RECOGNIZER_BUSY || error == SpeechRecognizer.ERROR_CLIENT -> next(BUSY_WAIT_MILLIS)
+                    else -> next(ROUND_GAP_MILLIS)
+                }
+            }
+
+            override fun onResults(results: Bundle?) {
+                if (mine != round) return
+                listening = false
+                // Closed or paused since this round began: what it heard goes nowhere.
+                if (!open || paused) return
+                val text = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull()
+                val from = speechAt ?: startedAt
+                val to = endedAt ?: HearingRules.now()
+                if (!text.isNullOrBlank()) handOn(text, from, to)
+                next(ROUND_GAP_MILLIS)
+            }
+        })
+        try {
+            r.startListening(intent())
+        } catch (e: Exception) {
+            listening = false
+            next(BUSY_WAIT_MILLIS)
+        }
+    }
+
+    private fun handOn(text: String, from: Long, to: Long) {
+        if (!open || paused) return
+        val l = listener ?: return
+        val spells = VoiceOut.since(from - HearingRules.ECHO_TEXT_MILLIS)
+        when {
+            to - from < HearingRules.MIN_SEGMENT_MILLIS -> l.dropped(Dropped.TOO_SHORT, to - from)
+            // The phone began to speak while this round listened: what it heard may be her.
+            HearingRules.cleanPart(from, to, spells) == null -> l.dropped(Dropped.HER_VOICE, to - from)
+            HearingRules.soundsLikeThePhone(text, to, spells) -> l.dropped(Dropped.HER_VOICE, to - from)
+            HearingRules.words(text) < HearingRules.MIN_WORDS -> l.dropped(Dropped.FEW_WORDS, to - from)
+            else -> l.heard(Heard(from, to, Voice.NOT_ENROLLED, null, text.trim(), null, overHer = false))
+        }
+    }
+
+    private fun intent(): Intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+        putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+        putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.getDefault())
+        putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false)
+        PreferredRecognizer.unmasked(this)
+    }
+
+    private fun stopRound() {
+        main.removeCallbacks(start)
+        round++
+        listening = false
+        runCatching { recognizer?.cancel() }
+    }
+
+    private fun fail(why: HearingEngine.Closed) {
+        Log.w(TAG, "Her ears' on-device recogniser stopped: ${why.name}")
+        val l = listener
+        open = false
+        stopRound()
+        recognizer?.destroy()
+        recognizer = null
+        l?.failed(why)
+    }
+
+    private companion object {
+        const val TAG = "HerEarsOnDevice"
+        const val ROUND_GAP_MILLIS = 150L
+        const val BUSY_WAIT_MILLIS = 2_000L
+        const val WAIT_FOR_HER_MILLIS = 300L
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/Bzip2.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/Bzip2.kt
new file mode 100644
index 0000000..ffd79a8
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/Bzip2.kt
@@ -0,0 +1,399 @@
+package com.opendroid.ai.core.life.ears
+
+import java.io.IOException
+import java.io.InputStream
+
+/**
+ * Reads a bzip2 stream: the format sherpa-onnx publishes its recognisers in (`.tar.bz2`).
+ * Android has no bzip2 of its own, and a library for one archive format is more than this
+ * needs, so the decoder is here: the format as bzip2 1.0.8 writes it (Huffman-coded
+ * move-to-front symbols over a Burrows-Wheeler block, then the run-length step), with
+ * every block's CRC and the stream's CRC checked. Concatenated streams are read one after
+ * the other, as `bzip2 -d` does. A damaged or foreign stream fails with an [IOException];
+ * nothing half-read is handed on as good.
+ *
+ * What it reads was checked against its pinned SHA-256 before it got here, and each file
+ * taken out of it is checked again after ([EarsModelInstaller]); the CRCs are a third look.
+ */
+class Bzip2InputStream(source: InputStream) : InputStream() {
+
+    private val bits = BitReader(source)
+
+    // The block now being read out.
+    private var blockSize100k = 0
+    private var tt = IntArray(0)
+    private var nblock = 0
+    private var used = 0
+    private var tPos = 0
+    private var blockCrcWanted = 0
+    private var crc = Crc()
+    private var combinedCrc = 0
+    private var streamCrcWanted = 0
+
+    // The last step, undone byte by byte: four equal bytes are followed by a count of more.
+    private var lastByte = -1
+    private var runLength = 0
+    private var repeats = 0
+
+    private var inBlock = false
+    private var finished = false
+
+    init {
+        if (!startStream(first = true)) throw IOException("Not a bzip2 stream")
+    }
+
+    override fun read(): Int {
+        val one = ByteArray(1)
+        val n = read(one, 0, 1)
+        return if (n <= 0) -1 else one[0].toInt() and 0xff
+    }
+
+    override fun read(b: ByteArray, off: Int, len: Int): Int {
+        if (off < 0 || len < 0 || off + len > b.size) throw IndexOutOfBoundsException()
+        if (len == 0) return 0
+        var n = 0
+        while (n < len) {
+            val c = nextByte()
+            if (c < 0) break
+            b[off + n] = c.toByte()
+            n++
+        }
+        return if (n == 0) -1 else n
+    }
+
+    override fun close() {
+        tt = IntArray(0)
+        bits.close()
+    }
+
+    /** The next byte out, or -1 at the end of the last stream. */
+    private fun nextByte(): Int {
+        while (true) {
+            if (finished) return -1
+            if (!inBlock) {
+                if (!startBlock()) continue
+            }
+            if (repeats > 0) {
+                repeats--
+                crc.update(lastByte)
+                return lastByte
+            }
+            if (used == nblock) {
+                endBlock()
+                continue
+            }
+            val c = nextFromBlock()
+            if (runLength == 4) {
+                runLength = 0
+                repeats = c
+                continue
+            }
+            if (c == lastByte) runLength++ else {
+                lastByte = c
+                runLength = 1
+            }
+            crc.update(c)
+            return c
+        }
+    }
+
+    private fun nextFromBlock(): Int {
+        tPos = tt[tPos]
+        val c = tPos and 0xff
+        tPos = tPos ushr 8
+        used++
+        return c
+    }
+
+    private fun endBlock() {
+        if (crc.value() != blockCrcWanted) throw IOException("bzip2 block CRC does not match")
+        combinedCrc = ((combinedCrc shl 1) or (combinedCrc ushr 31)) xor blockCrcWanted
+        inBlock = false
+    }
+
+    /** Reads "BZh" and the block size. False at a clean end of input after a stream. */
+    private fun startStream(first: Boolean): Boolean {
+        val b = bits.byteOrEnd()
+        if (b < 0) {
+            if (first) throw IOException("Empty bzip2 input")
+            return false
+        }
+        if (b != 'B'.code || bits.bits(8) != 'Z'.code || bits.bits(8) != 'h'.code) {
+            if (first) throw IOException("Not a bzip2 stream")
+            // Bytes after the last stream that do not start another one: bzip2 ignores them
+            // with a warning; here they are an error, since nothing should follow.
+            throw IOException("Trailing garbage after bzip2 stream")
+        }
+        val level = bits.bits(8) - '0'.code
+        if (level !in 1..9) throw IOException("Bad bzip2 block size")
+        blockSize100k = level
+        if (tt.size < level * 100_000) tt = IntArray(level * 100_000)
+        combinedCrc = 0
+        return true
+    }
+
+    /** Starts the next block. False when the stream ended there (and another may follow). */
+    private fun startBlock(): Boolean {
+        val magicHi = bits.bits(24)
+        val magicLo = bits.bits(24)
+        when {
+            magicHi == 0x314159 && magicLo == 0x265359 -> Unit
+            magicHi == 0x177245 && magicLo == 0x385090 -> {
+                streamCrcWanted = bits.bits(32)
+                if (streamCrcWanted != combinedCrc) throw IOException("bzip2 stream CRC does not match")
+                bits.alignToByte()
+                if (!startStream(first = false)) finished = true
+                return false
+            }
+            else -> throw IOException("Bad bzip2 block header")
+        }
+        blockCrcWanted = bits.bits(32)
+        if (bits.bit()) throw IOException("Randomised bzip2 blocks are not supported")
+        val origPtr = bits.bits(24)
+        readBlock(origPtr)
+        crc = Crc()
+        lastByte = -1
+        runLength = 0
+        repeats = 0
+        inBlock = true
+        return true
+    }
+
+    private fun readBlock(origPtr: Int) {
+        // Which byte values occur.
+        val inUse16 = bits.bits(16)
+        val seqToUnseq = IntArray(256)
+        var nInUse = 0
+        for (i in 0 until 16) {
+            if (inUse16 and (0x8000 ushr i) != 0) {
+                val word = bits.bits(16)
+                for (j in 0 until 16) {
+                    if (word and (0x8000 ushr j) != 0) seqToUnseq[nInUse++] = i * 16 + j
+                }
+            }
+        }
+        if (nInUse == 0) throw IOException("bzip2 block uses no bytes")
+        val alphaSize = nInUse + 2
+
+        val nGroups = bits.bits(3)
+        if (nGroups !in 2..MAX_GROUPS) throw IOException("Bad bzip2 table count")
+        val nSelectors = bits.bits(15)
+        if (nSelectors < 1) throw IOException("Bad bzip2 selector count")
+        val selectorMtf = IntArray(minOf(nSelectors, MAX_SELECTORS))
+        for (i in 0 until nSelectors) {
+            var j = 0
+            while (bits.bit()) {
+                j++
+                if (j >= nGroups) throw IOException("Bad bzip2 selector")
+            }
+            // bzip2 1.0.8 reads selectors past its maximum and drops them.
+            if (i < MAX_SELECTORS) selectorMtf[i] = j
+        }
+        val selectors = IntArray(selectorMtf.size)
+        val pos = IntArray(nGroups) { it }
+        for (i in selectorMtf.indices) {
+            var v = selectorMtf[i]
+            val tmp = pos[v]
+            while (v > 0) {
+                pos[v] = pos[v - 1]
+                v--
+            }
+            pos[0] = tmp
+            selectors[i] = tmp
+        }
+
+        // The code lengths of each table, as deltas.
+        val tables = Array(nGroups) {
+            val lengths = IntArray(alphaSize)
+            var curr = bits.bits(5)
+            for (s in 0 until alphaSize) {
+                while (true) {
+                    if (curr < 1 || curr > MAX_CODE_LEN) throw IOException("Bad bzip2 code length")
+                    if (!bits.bit()) break
+                    curr += if (bits.bit()) -1 else 1
+                }
+                lengths[s] = curr
+            }
+            Huffman(lengths)
+        }
+
+        // Move-to-front symbols, with the zero runs spelt in RUNA and RUNB.
+        val eob = nInUse + 1
+        val limit = blockSize100k * 100_000
+        val unzftab = IntArray(256)
+        val yy = IntArray(256) { it }
+        var count = 0
+        var groupNo = -1
+        var groupPos = 0
+        var table = tables[0]
+
+        fun symbol(): Int {
+            if (groupPos == 0) {
+                groupNo++
+                if (groupNo >= selectors.size) throw IOException("bzip2 selectors ran out")
+                groupPos = GROUP_SIZE
+                table = tables[selectors[groupNo]]
+            }
+            groupPos--
+            return table.decode(bits)
+        }
+
+        var next = symbol()
+        while (next != eob) {
+            if (next == RUNA || next == RUNB) {
+                var es = -1
+                var n = 1
+                do {
+                    if (n >= 2 * 1024 * 1024) throw IOException("bzip2 run too long")
+                    es += if (next == RUNA) n else 2 * n
+                    n *= 2
+                    next = symbol()
+                } while (next == RUNA || next == RUNB)
+                es++
+                val uc = seqToUnseq[yy[0]]
+                if (count + es > limit) throw IOException("bzip2 block too long")
+                unzftab[uc] += es
+                repeat(es) { tt[count++] = uc }
+                continue
+            }
+            if (count >= limit) throw IOException("bzip2 block too long")
+            val nn = next - 1
+            if (nn !in 0 until nInUse) throw IOException("Bad bzip2 symbol")
+            val uc = yy[nn]
+            System.arraycopy(yy, 0, yy, 1, nn)
+            yy[0] = uc
+            val byte = seqToUnseq[uc]
+            unzftab[byte]++
+            tt[count++] = byte
+            next = symbol()
+        }
+        if (origPtr !in 0 until count) throw IOException("Bad bzip2 origin pointer")
+
+        // The Burrows-Wheeler step undone: each entry gets the index of the next.
+        val cftab = IntArray(257)
+        for (i in 1..256) cftab[i] = cftab[i - 1] + unzftab[i - 1]
+        for (i in 0 until count) {
+            val uc = tt[i] and 0xff
+            tt[cftab[uc]] = tt[cftab[uc]] or (i shl 8)
+            cftab[uc]++
+        }
+        nblock = count
+        used = 0
+        tPos = tt[origPtr] ushr 8
+    }
+
+    /** One Huffman table, decoded the way bzip2 builds its tables (limit, base, perm). */
+    private class Huffman(lengths: IntArray) {
+        private val minLen = lengths.min()
+        private val maxLen = lengths.max()
+        private val limit = IntArray(MAX_CODE_LEN + 2)
+        private val base = IntArray(MAX_CODE_LEN + 2)
+        private val perm = IntArray(lengths.size)
+
+        init {
+            var pp = 0
+            for (i in minLen..maxLen) for (j in lengths.indices) if (lengths[j] == i) perm[pp++] = j
+            for (len in lengths) base[len + 1]++
+            for (i in 1 until base.size) base[i] += base[i - 1]
+            var vec = 0
+            for (i in minLen..maxLen) {
+                vec += base[i + 1] - base[i]
+                limit[i] = vec - 1
+                vec = vec shl 1
+            }
+            for (i in minLen + 1..maxLen) base[i] = ((limit[i - 1] + 1) shl 1) - base[i]
+        }
+
+        fun decode(bits: BitReader): Int {
+            var n = minLen
+            var v = bits.bits(n)
+            while (true) {
+                if (n > maxLen) throw IOException("Bad bzip2 code")
+                if (v <= limit[n]) break
+                n++
+                v = (v shl 1) or (if (bits.bit()) 1 else 0)
+            }
+            val at = v - base[n]
+            if (at < 0 || at >= perm.size) throw IOException("Bad bzip2 code")
+            return perm[at]
+        }
+    }
+
+    /** Bits, most significant first. */
+    private class BitReader(private val source: InputStream) {
+        private val buffer = ByteArray(1 shl 16)
+        private var pos = 0
+        private var end = 0
+        private var acc = 0L
+        private var count = 0
+
+        private fun rawByte(): Int {
+            if (pos == end) {
+                end = source.read(buffer, 0, buffer.size)
+                pos = 0
+                if (end <= 0) {
+                    end = 0
+                    return -1
+                }
+            }
+            return buffer[pos++].toInt() and 0xff
+        }
+
+        fun bits(n: Int): Int {
+            while (count < n) {
+                val b = rawByte()
+                if (b < 0) throw IOException("bzip2 stream ends early")
+                acc = (acc shl 8) or b.toLong()
+                count += 8
+            }
+            count -= n
+            val v = (acc ushr count) and ((1L shl n) - 1)
+            acc = acc and ((1L shl count) - 1)
+            return v.toInt()
+        }
+
+        fun bit(): Boolean = bits(1) == 1
+
+        fun alignToByte() {
+            count -= count % 8
+            acc = acc and ((1L shl count) - 1)
+        }
+
+        /** A whole byte when aligned, or -1 at a clean end of input. */
+        fun byteOrEnd(): Int {
+            if (count >= 8) return bits(8)
+            check(count == 0)
+            return rawByte()
+        }
+
+        fun close() = source.close()
+    }
+
+    /** bzip2's CRC-32: the polynomial 0x04C11DB7, most significant bit first. */
+    private class Crc {
+        private var c = -1
+
+        fun update(byte: Int) {
+            c = (c shl 8) xor TABLE[((c ushr 24) xor byte) and 0xff]
+        }
+
+        fun value(): Int = c.inv()
+
+        companion object {
+            val TABLE = IntArray(256) { i ->
+                var r = i shl 24
+                repeat(8) { r = if (r and Int.MIN_VALUE != 0) (r shl 1) xor 0x04C11DB7 else r shl 1 }
+                r
+            }
+        }
+    }
+
+    private companion object {
+        const val RUNA = 0
+        const val RUNB = 1
+        const val GROUP_SIZE = 50
+        const val MAX_GROUPS = 6
+        const val MAX_SELECTORS = 18002
+        const val MAX_CODE_LEN = 20
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/EarsDownload.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsDownload.kt
new file mode 100644
index 0000000..7f55bf9
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsDownload.kt
@@ -0,0 +1,114 @@
+package com.opendroid.ai.core.life.ears
+
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+
+/**
+ * Fetches one model file from its pinned URL into [partial], picking up where an earlier
+ * try stopped (a Range request). Nothing is sent but the GET of a fixed public URL: no
+ * cookie, no Referer, nothing about him, and a plain User-Agent. A server that sends more
+ * than the pinned size is cut off. What arrives is not trusted until
+ * [EarsModelInstaller.install] has checked its SHA-256.
+ */
+class EarsDownload(
+    client: OkHttpClient,
+    /** Only https, at every hop. Off only in tests against a local server. */
+    private val httpsOnly: Boolean = true,
+) {
+
+    // Redirects (GitHub sends release files from another host) are followed, but never from
+    // https down to http.
+    private val http = client.newBuilder()
+        .followRedirects(true)
+        .followSslRedirects(false)
+        .cookieJar(okhttp3.CookieJar.NO_COOKIES)
+        .connectTimeout(30, TimeUnit.SECONDS)
+        .readTimeout(60, TimeUnit.SECONDS)
+        .build()
+
+    /** How a fetch ended. */
+    sealed class Outcome {
+        /** [partial] holds the whole file (its size matches; its hash is checked next). */
+        data object Done : Outcome()
+
+        /** Stopped by [keepGoing], or the connection dropped: what came is kept for the next try. */
+        data object Interrupted : Outcome()
+
+        /** The server answered with something that is not the file. */
+        data class Refused(val code: Int) : Outcome()
+    }
+
+    /**
+     * Fetches [model] into [partial]. [progress] is told the bytes on the disk so far.
+     * Throws nothing for network trouble: that is [Outcome.Interrupted].
+     */
+    fun fetch(model: EarsModels.Model, partial: File, keepGoing: () -> Boolean, progress: (Long) -> Unit): Outcome =
+        fetch(model.url, model.size, partial, keepGoing, progress)
+
+    fun fetch(url: String, size: Long, partial: File, keepGoing: () -> Boolean, progress: (Long) -> Unit): Outcome {
+        if (partial.length() > size) partial.delete()
+        if (partial.length() == size) return Outcome.Done
+        val from = partial.length()
+        val request = Request.Builder()
+            .url(url)
+            .header("User-Agent", USER_AGENT)
+            .apply { if (from > 0) header("Range", "bytes=$from-") }
+            .build()
+        try {
+            http.newCall(request).execute().use { response ->
+                val append = from > 0 && response.code == 206 &&
+                    response.header("Content-Range")?.startsWith("bytes $from-") == true
+                if (httpsOnly && (!request.url.isHttps || !response.request.url.isHttps)) return Outcome.Refused(NOT_HTTPS)
+                if (!response.isSuccessful) return Outcome.Refused(response.code)
+                if (!append) partial.delete()
+                var have = if (append) from else 0L
+                FileOutputStream(partial, append).use { out ->
+                    val input = response.body.byteStream()
+                    val buffer = ByteArray(1 shl 16)
+                    var lastTold = 0L
+                    while (true) {
+                        if (!keepGoing()) {
+                            out.fd.sync()
+                            return Outcome.Interrupted
+                        }
+                        val n = input.read(buffer)
+                        if (n < 0) break
+                        if (have + n > size) {
+                            // More than the pinned file: not it.
+                            out.close()
+                            partial.delete()
+                            return Outcome.Refused(TOO_LONG)
+                        }
+                        out.write(buffer, 0, n)
+                        have += n
+                        if (have - lastTold >= PROGRESS_STEP) {
+                            progress(have)
+                            lastTold = have
+                        }
+                    }
+                    out.fd.sync()
+                }
+                progress(have)
+                return if (have == size) Outcome.Done else Outcome.Interrupted
+            }
+        } catch (e: IOException) {
+            return Outcome.Interrupted
+        }
+    }
+
+    companion object {
+        /** No name of the app's owner, no device: a reader of public files. */
+        const val USER_AGENT = "YumeEars/1.0 (model download)"
+        private const val PROGRESS_STEP = 1L shl 20
+
+        /** [Outcome.Refused.code] for a hop that was not https. */
+        const val NOT_HTTPS = -1
+
+        /** [Outcome.Refused.code] for a body longer than the pinned file. */
+        const val TOO_LONG = -2
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/EarsGate.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsGate.kt
new file mode 100644
index 0000000..0c334e9
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsGate.kt
@@ -0,0 +1,180 @@
+package com.opendroid.ai.core.life.ears
+
+import com.opendroid.ai.core.life.OutingRules
+
+/**
+ * When her ears are open (OWN_LIFE_PLAN phase 3, §1.1). Pure: the phone's state goes in, and
+ * what the ears are to do comes out.
+ *
+ * Open only while all of these hold: her own life on and `personaOpenMic` on; she is awake
+ * (I9); the app may use the microphone; the service holds the microphone type (after a start
+ * from the background it waits for his tap on Eyes and ears); not muted from the
+ * notification; and, with `personaOpenMicOnlyCharging`, the phone charging. They close, and
+ * let go of the models, when one of these stops holding; when she lies down to sleep or her
+ * ears are switched off, what they overheard is cleared with them.
+ *
+ * Paused (the microphone let go of, the models kept) during a phone call, with the battery
+ * under [OutingRules.EARS_BATTERY_PERCENT] and not charging, and with the phone too hot
+ * ([OutingRules.THERMAL_SEVERE] or worse).
+ */
+object EarsGate {
+
+    /** The phone's state, as the service reads it. */
+    data class Input(
+        /** Her own life is on (her own time with it) and he switched her ears on. */
+        val switchedOn: Boolean,
+        val awake: Boolean,
+        /** The app may use the microphone (RECORD_AUDIO). */
+        val permitted: Boolean,
+        /** The service holds the microphone type now. */
+        val micHeld: Boolean,
+        /** Muted from the notification until then (wall clock); 0 for not muted. */
+        val mutedUntil: Long = 0L,
+        val nowMillis: Long = 0L,
+        /** Only while charging (`personaOpenMicOnlyCharging`). */
+        val onlyCharging: Boolean = false,
+        val charging: Boolean = true,
+        val batteryPercent: Int = 100,
+        val thermalStatus: Int = 0,
+        /** A phone call is ringing or going on, or another app's call holds the audio. */
+        val inCall: Boolean = false,
+    )
+
+    /** Why the ears are closed. */
+    enum class Closed(val words: String, val clears: Boolean = false) {
+        SWITCHED_OFF("switched off", clears = true),
+        ASLEEP("she is asleep", clears = true),
+        NO_PERMISSION("the app may not use the microphone"),
+        NEEDS_TAP("needs one tap (Eyes and ears, on the app's notification)"),
+        MUTED("muted from the notification"),
+        NOT_CHARGING("only while charging, and the phone is not"),
+        SERVICE_DOWN("the app is not running"),
+    }
+
+    /** Why the ears are paused: the microphone let go of for a while. */
+    enum class Paused(val words: String) {
+        CALL("a phone call"),
+        BATTERY("the battery is under ${OutingRules.EARS_BATTERY_PERCENT}%"),
+        HOT("the phone is too hot"),
+        MIC_LENT("you are talking to the phone with the button"),
+        SILENCED("another app or a call has the microphone"),
+    }
+
+    /** What the ears are to do. */
+    sealed class Want {
+        data object Open : Want()
+
+        data class Pause(val why: Paused) : Want()
+
+        data class Close(val why: Closed) : Want()
+    }
+
+    /** What [input] asks of the ears, the strongest reason first. */
+    fun decide(input: Input): Want = when {
+        !input.switchedOn -> Want.Close(Closed.SWITCHED_OFF)
+        !input.awake -> Want.Close(Closed.ASLEEP)
+        !input.permitted -> Want.Close(Closed.NO_PERMISSION)
+        !input.micHeld -> Want.Close(Closed.NEEDS_TAP)
+        input.mutedUntil > input.nowMillis -> Want.Close(Closed.MUTED)
+        input.onlyCharging && !input.charging -> Want.Close(Closed.NOT_CHARGING)
+        input.inCall -> Want.Pause(Paused.CALL)
+        OutingRules.earsPowerLow(input.batteryPercent) && !input.charging -> Want.Pause(Paused.BATTERY)
+        input.thermalStatus >= OutingRules.THERMAL_SEVERE -> Want.Pause(Paused.HOT)
+        else -> Want.Open
+    }
+
+    /** How long "Mute 1 h" on the notification keeps them closed. */
+    const val MUTE_MILLIS = 60 * 60_000L
+}
+
+/**
+ * What her ears did in one day, in counts only (I8): kept in memory and added to the day's
+ * [com.opendroid.ai.core.life.HerLog.Kind.EARS_DAY] entry from time to time. No word, no
+ * name, no sound of anything heard: only how many and how long.
+ */
+class EarsDay {
+    private val counts = LinkedHashMap<String, Int>()
+    private val sinceFlush = LinkedHashMap<String, Int>()
+
+    @Synchronized
+    fun bump(key: String, by: Int = 1) {
+        if (by <= 0) return
+        counts[key] = (counts[key] ?: 0) + by
+        sinceFlush[key] = (sinceFlush[key] ?: 0) + by
+    }
+
+    @Synchronized
+    fun count(key: String): Int = counts[key] ?: 0
+
+    /** What was counted since the last call, for the log; empty when nothing was. */
+    @Synchronized
+    fun flush(): Map<String, Int> {
+        val out = LinkedHashMap(sinceFlush)
+        sinceFlush.clear()
+        return out
+    }
+
+    /** A new day: the counts start over (what was not flushed is handed back first). */
+    @Synchronized
+    fun newDay(): Map<String, Int> {
+        val out = LinkedHashMap(sinceFlush)
+        sinceFlush.clear()
+        counts.clear()
+        return out
+    }
+
+    companion object {
+        /** His voice said to her: a message to her. Before his voice is enrolled, any voice said to her. */
+        const val TO_HER = "said to her"
+
+        /** His voice not said to her, overheard. */
+        const val OVERHEARD = "overheard"
+
+        /** His laughs, coughs and the like. */
+        const val HIS_SOUNDS = "his sounds"
+
+        /** A sound near the phone, right after her line, whose voice could not be told. */
+        const val NEAR_SOUNDS = "sounds near her"
+
+        /** Another voice that talked to her, while he lets others talk to her. */
+        const val OTHERS_TO_HER = "others to her"
+
+        /** Seconds of other voices than his, counted only. */
+        const val OTHERS_SECONDS = "others, seconds"
+
+        /** Seconds of talk not to her before his voice was enrolled, counted only. */
+        const val ANYONE_SECONDS = "talk not to her, seconds"
+
+        /** Sounds counted only (another voice's, or nobody's). */
+        const val SOUNDS_COUNTED = "sounds counted"
+
+        /** He came in over her and she was cut off. */
+        const val CUT_HER_OFF = "cut her off"
+
+        /** Minutes the microphone was open. */
+        const val OPEN_MINUTES = "minutes open"
+
+        /** What was let go of, by why ([Dropped]). */
+        fun dropped(why: Dropped): String = "dropped: " + why.name.lowercase().replace('_', ' ')
+
+        /**
+         * A day of her ears in a few words, for "Her day": "14 said to her, 3 overheard, his
+         * sounds 2, others 6 min, 380 minutes open". Counts only.
+         */
+        fun text(counts: Map<String, Int>): String = buildList {
+            fun n(key: String) = counts[key] ?: 0
+            if (n(TO_HER) > 0) add("${n(TO_HER)} said to her")
+            if (n(OVERHEARD) > 0) add("${n(OVERHEARD)} overheard")
+            if (n(HIS_SOUNDS) > 0) add("his sounds ${n(HIS_SOUNDS)}")
+            if (n(NEAR_SOUNDS) > 0) add("sounds near her ${n(NEAR_SOUNDS)}")
+            if (n(OTHERS_TO_HER) > 0) add("others to her ${n(OTHERS_TO_HER)}")
+            if (n(OTHERS_SECONDS) > 0) add("others ${minutes(n(OTHERS_SECONDS))}, not kept")
+            if (n(ANYONE_SECONDS) > 0) add("talk not to her ${minutes(n(ANYONE_SECONDS))}, not kept")
+            if (n(CUT_HER_OFF) > 0) add("cut her off ${n(CUT_HER_OFF)}")
+            if (n(OPEN_MINUTES) > 0) add("${n(OPEN_MINUTES)} minutes open")
+        }.joinToString(", ")
+
+        /** Seconds as "40 s" or "6 min". */
+        fun minutes(seconds: Int): String = if (seconds < 60) "$seconds s" else "${(seconds + 30) / 60} min"
+    }
+}
