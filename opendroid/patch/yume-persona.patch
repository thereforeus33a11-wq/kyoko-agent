+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.HerNow
+import com.opendroid.ai.core.life.OutingHost
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingRules
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.reading.Feeds
+import com.opendroid.ai.core.persona.PersonaOwnTime
+import com.opendroid.ai.data.models.OwnLifeBounds
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * What the screens, the tile and the notifications say about her own life is what the
+ * code does: the card's sentences are held against the rules they name, the tile and the
+ * long-press are declared where Android looks for them, and the question that asks him
+ * first carries nothing of hers.
+ */
+class OwnLifeWordingTest {
+
+    private fun source(path: String) = File("src/main/java/com/opendroid/ai/$path").readText()
+    private val manifest by lazy { File("src/main/AndroidManifest.xml").readText() }
+
+    // ── The card "HER OWN LIFE" ──────────────────────────────────────────────────────
+
+    @Test
+    fun `the switch says what an outing is, what ends it and what reaches him, by the host's own rules`() {
+        val hint = OWN_LIFE_HINT
+        // What she can go and do in this build: reading, and the news from her feeds.
+        assertTrue(hint.contains("she reads Wikipedia, a page by its link, or the news from her feeds"))
+        // A look through the camera is its own switch, with its own words under her eyes (CAMERA_HINT).
+        assertEquals(setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS, OutingKind.Kind.LOOK), OutingKind.Kind.entries.toSet())
+        // What ends it: the host's own reasons, and Stop on both the notification and the tile.
+        assertTrue(hint.contains("you press Stop (on the notification or her Yume tile in quick settings)"))
+        assertTrue(source("core/service/OpenDroidService.kt").contains("outings.stop(com.opendroid.ai.core.life.HerLog.EndedBy.STOP)"))
+        assertTrue(source("ui/tile/YumeTileService.kt").contains("outings.stop(HerLog.EndedBy.STOP)"))
+        // His talk pauses it, and it goes on 3 minutes after the talk went quiet.
+        assertTrue(hint.contains("goes on about 3 minutes after the talk goes quiet"))
+        assertEquals(3 * 60_000L, OutingRules.RESUME_AFTER_QUIET_MILLIS)
+        // Nothing runs unless her own time is on.
+        assertTrue(hint.endsWith("Nothing of this runs unless her own time is on."))
+        assertTrue(source("core/persona/PersonaEngine.kt").contains("fun ownLifeIsOn(config: LLMConfig): Boolean = ownTimeIsOn(config) && config.personaOwnLife"))
+        // One line per outing reaches the chat.
+        assertTrue(hint.contains("Only one line to you per outing reaches the chat."))
+        // The card warns when her own time is off, and says so in the words of the switch.
+        assertTrue(source("ui/screens/PersonaSettingsCards.kt").contains("Text(text = OWN_LIFE_NEEDS_OWN_TIME"))
+    }
+
+    @Test
+    fun `the calls hint says what counts and the thresholds the ledger holds`() {
+        assertTrue(OWN_LIFE_CALLS_HINT.contains("An outing starts only while 20 are left and takes a step only while 10 are left"))
+        assertEquals(20, OwnLedger.Start.OUTING.needsLeft)
+        assertEquals(10, OwnLedger.Start.STEP.needsLeft)
+        assertTrue(OWN_LIFE_CALLS_HINT.contains("Her sleep pass and her notebook are counted and priced but not held against it."))
+        assertEquals(com.opendroid.ai.core.life.OwnPurpose.Counted.SHOWN, com.opendroid.ai.core.life.OwnPurpose.SLEEP_PASS.counted)
+        assertEquals(com.opendroid.ai.core.life.OwnPurpose.Counted.SHOWN, com.opendroid.ai.core.life.OwnPurpose.NOTEBOOK.counted)
+        // His choices, and a saved number that is none of them is shown as it is.
+        assertEquals(listOf(50, 100, 150, 200, 250, 300), ownCallsChoices(150).map { it.first })
+        assertTrue(ownCallsChoices(175).any { it.first == 175 })
+        assertEquals("15 minutes", outingMinutesChoices(15).first { it.first == 15 }.second)
+        assertEquals("12 steps", outingStepsChoices(12).first { it.first == 12 }.second)
+        assertTrue(OwnLifeBounds.OUTING_MINUTES_STEPS.contains(OwnLifeBounds.DEFAULT_OUTING_MINUTES))
+        assertTrue(OwnLifeBounds.OUTING_STEPS_STEPS.contains(OwnLifeBounds.DEFAULT_OUTING_STEPS))
+    }
+
+    @Test
+    fun `asking first is one notification per outing that waits 30 minutes and holds nothing of hers`() {
+        assertTrue(OUTINGS_ASK_HINT.contains("Unanswered after 30 minutes, it does not start."))
+        assertEquals(30 * 60_000L, OutingHost.ASK_WAITS_MILLIS)
+        assertTrue(OUTINGS_ASK_HINT.contains("one per outing and none per step; her words are not in it"))
+        val asked = com.opendroid.ai.core.service.CheckInNotification.outingAskText("Yume", HerLog.Kind.READ.word, 15, 30)
+        assertEquals(
+            "Yume wants to go off and read up on something for up to 15 min, in her own space and not on your phone. It waits 30 min for your answer.",
+            asked
+        )
+        assertEquals(
+            "Yume wants to go off and read the news from her feeds for up to 15 min, in her own space and not on your phone. It waits 30 min for your answer.",
+            com.opendroid.ai.core.service.CheckInNotification.outingAskText("Yume", HerLog.Kind.NEWS.word, 15, 30)
+        )
+        // The host hands the question its kind and length only: her words never reach the room.
+        val host = source("core/life/OutingHost.kt")
+        assertTrue(host.contains("room?.ask(logKind(kind), OwnLife.maxMinutes(config), nowMillis, camera)"))
+        assertTrue(host.contains("suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String)"))
+        // Let her and Not now are the service's own actions.
+        val service = source("core/service/OpenDroidService.kt")
+        assertTrue(service.contains("serviceScope.launch(Dispatchers.Default) { outings.letHer() }"))
+        assertTrue(service.contains("serviceScope.launch(Dispatchers.Default) { outings.notNow() }"))
+
+        // She is told, in her moment, that he is asked first and what comes of it.
+        val life = PersonaOwnTime.Life(
+            nowMillis = 0L, runnable = setOf(OutingKind.Kind.READ), maxMinutes = 15, maxSteps = 12, cap = 150, left = 100, asks = true
+        )
+        val go = PersonaOwnTime.goLine(life)!!
+        assertTrue(go, go.contains("his settings ask him first: he gets a notification that you want to go off (not your words), and it starts once he lets you."))
+        assertTrue(go, go.contains("if he says not now, or does not answer within 30 minutes, it does not start, and you are told at your next moment."))
+        assertFalse(go, go.contains("it starts right after this moment"))
+        assertTrue(PersonaOwnTime.goLine(life.copy(asks = false))!!.contains("it starts right after this moment"))
+        assertEquals(30, PersonaOwnTime.OUTING_ASK_WAITS_MINUTES)
+        for ((why, ending) in listOf(
+            HerLog.NotStarted.HE_SAID_NO to "his settings ask him first, and he said not now.",
+            HerLog.NotStarted.NOT_ANSWERED to "his settings ask him first, and he did not answer within 30 minutes.",
+            HerLog.NotStarted.WAITING to "another go: of yours was still waiting for his yes."
+        )) {
+            val line = PersonaOwnTime.goMissedLine(PersonaOwnTime.GoMissed("read about trains", why.name), life.runnable)
+            assertEquals("your last go: line did not start: \"read about trains\". $ending", line)
+        }
+    }
+
+    @Test
+    fun `reading and her feeds are worded as the fetcher and her feeds work`() {
+        assertTrue(READS_HINT.contains("fetched by the app over https only, with no cookies and with nothing about you in the request"))
+        assertTrue(READS_HINT.contains("A page she opens honours its site's robots.txt; Wikipedia's own interface and her feeds are read the way a feed reader reads them."))
+        val fetcher = source("core/life/reading/HerFetcher.kt")
+        assertTrue(fetcher.contains(".cookieJar(CookieJar.NO_COOKIES)"))
+        assertTrue(fetcher.contains("if (robots && !robotsAllow(current)) return@withContext Fetched.Refused(Why.ROBOTS)"))
+        // Only Wikipedia's interface and her feeds are read without it; a page she opens never is.
+        assertTrue(source("core/life/reading/Wikipedia.kt").contains("fetcher.fetch(searchUrl(lang, words), robots = false)"))
+        assertTrue(source("core/life/reading/Feeds.kt").contains("fetcher.fetch(feed.url, robots = false)"))
+        assertFalse(source("core/life/reading/ReadingSpace.kt").contains("robots = false"))
+        assertFalse(source("core/life/OutingHost.kt").contains("robots = false"))
+        assertTrue(FEEDS_HINT.contains("follow a site's own feed herself on an outing (12 at most)"))
+        assertEquals(12, Feeds.MAX_FOLLOWED)
+        // Reading off leaves nothing to go out to.
+        assertTrue(READS_HINT.contains("Off: she has nothing to go out to in this build."))
+        assertTrue(com.opendroid.ai.core.life.OwnLife.runnable(com.opendroid.ai.data.models.LLMConfig(personaOwnLife = true, personaReads = false)).isEmpty())
+    }
+
+    @Test
+    fun `the card stands in Settings below hers, and only where she has a card`() {
+        val settings = source("ui/screens/SettingsScreen.kt")
+        val persona = settings.indexOf("item { PersonaSettingsCard(")
+        val life = settings.indexOf("item { HerOwnLifeCard(config, viewModel) }")
+        assertTrue(persona in 0 until life)
+        val cards = source("ui/screens/PersonaSettingsCards.kt")
+        val card = cards.substringAfter("fun HerOwnLifeCard(").substringBefore("private fun HerFeedsList(")
+        assertTrue(card.contains("val cardState = card ?: return"))
+        assertTrue(card.contains("if (!cardState.present) return"))
+        // Every switch and choice goes through the settings model, which saves it.
+        for (setter in listOf(
+            "viewModel::updatePersonaOwnLife", "viewModel::updatePersonaOwnCallsPerDay", "viewModel::updatePersonaOutingMaxMinutes",
+            "viewModel::updatePersonaOutingMaxSteps", "viewModel::updatePersonaOutingsAsk", "viewModel::updatePersonaReads"
+        )) {
+            assertTrue(setter, card.contains(setter))
+        }
+        // Her feeds: remove and give back, his channels, hers, and the address field.
+        val feeds = cards.substringAfter("private fun HerFeedsList(").substringBefore("private fun FeedRow(")
+        assertTrue(feeds.contains("viewModel.updatePersonaReadFeedRemoved(feed.id, removed = !removed)"))
+        assertTrue(feeds.contains("viewModel.removePersonaYouTubeChannel(id)"))
+        assertTrue(feeds.contains("feeds.unfollow(feed)"))
+        assertTrue(feeds.contains("viewModel.addPersonaYouTubeChannel(found.id, found.name)"))
+    }
+
+    // ── "Her day", the tile, the manifest ────────────────────────────────────────────
+
+    @Test
+    fun `her day is reached from her card screen and goes back by its own name`() {
+        val navigation = source("ui/Navigation.kt")
+        assertTrue(navigation.contains("onOpenHerDay = { navController.navigate(OpenDroidRoutes.HER_DAY) }"))
+        assertTrue(navigation.contains("onNavigateBack = { navController.leave(OpenDroidRoutes.HER_DAY) }"))
+        assertTrue(OWN_LIFE_STATUS_HINT.contains("\"Her day\" lists what she did, entry by entry."))
+    }
+
+    @Test
+    fun `the tile shows what she does now, a tap stops it, and the long-press opens Settings`() {
+        val nothing = com.opendroid.ai.ui.tile.YumeTile.of(HerNow.Now.Nothing, 0L)
+        assertEquals("Yume", nothing.label)
+        assertFalse(nothing.active)
+        assertEquals("nothing now", nothing.subtitle)
+        val reading = com.opendroid.ai.ui.tile.YumeTile.of(HerNow.Now.Doing(HerLog.Kind.READ, "ja.wikipedia.org", 0L), 3 * 60_000L)
+        assertTrue(reading.active)
+        assertEquals("reading · 3 min", reading.subtitle)
+        assertEquals("Yume is reading · 3 min. Tap to stop her outing.", reading.description)
+        val paused = com.opendroid.ai.ui.tile.YumeTile.of(HerNow.Now.Doing(HerLog.Kind.NEWS, "", 0L, paused = true), 60_000L)
+        assertEquals("news, waiting · 1 min", paused.subtitle)
+        // Where she is is not on the tile, which shows on the lock screen's quick settings.
+        assertFalse(reading.subtitle.contains("wikipedia"))
+
+        // Declared as Android looks for it: bound only by the system, with its icon and label.
+        val tile = manifest.substringAfter("android:name=\".ui.tile.YumeTileService\"").substringBefore("</service>")
+        assertTrue(tile.contains("android:permission=\"android.permission.BIND_QUICK_SETTINGS_TILE\""))
+        assertTrue(tile.contains("<action android:name=\"android.service.quicksettings.action.QS_TILE\" />"))
+        assertTrue(tile.contains("android:icon=\"@drawable/ic_yume_tile\""))
+        assertTrue(File("src/main/res/drawable/ic_yume_tile.xml").isFile)
+        // The long-press: the app's own activity takes the tile's preferences intent, and opens on Settings.
+        val activity = manifest.substringAfter("android:name=\".MainActivity\"").substringBefore("</activity>")
+        assertTrue(activity.contains("android.service.quicksettings.action.QS_TILE_PREFERENCES"))
+        val main = source("MainActivity.kt")
+        assertTrue(main.contains("intent?.action == android.service.quicksettings.TileService.ACTION_QS_TILE_PREFERENCES"))
+        assertTrue(main.contains("OpenDroidNavigation(startOnSettings = openedFromTile)"))
+        assertTrue(source("ui/Navigation.kt").contains("if (startOnSettings && !startTabTaken) currentTab = Screen.Settings"))
+    }
+
+    @Test
+    fun `her screenshots work, because the accessibility service declares that it takes them`() {
+        val config = File("src/main/res/xml/accessibility_service_config.xml").readText()
+        assertTrue(config.contains("android:canTakeScreenshot=\"true\""))
+        // The path that asks for one: the service's own takeScreenshot, on the default display.
+        val service = source("accessibility/OpenDroidAccessibilityService.kt")
+        assertTrue(service.contains("takeScreenshot(\n                    android.view.Display.DEFAULT_DISPLAY,"))
+        // The buffer is let go on every path.
+        assertTrue(service.contains("} finally {\n                                hardwareBuffer.close()"))
+        assertNull(Regex("""canTakeScreenshot="false"""").find(config))
+    }
