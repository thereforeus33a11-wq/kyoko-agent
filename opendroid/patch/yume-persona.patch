+++ b/app/src/test/java/com/opendroid/ai/ui/viewmodel/HerDayViewModelTest.kt
@@ -0,0 +1,152 @@
+package com.opendroid.ai.ui.viewmodel
+
+import android.os.Looper
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingHost
+import com.opendroid.ai.core.life.OutingStep
+import com.opendroid.ai.core.life.Wonders
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.io.File
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * "Her day": the log of what she did on her own, by day, newest first, in its own words;
+ * nothing of what she thought, noted or felt can be in a line, because the log never
+ * holds it; and Clear deletes what is done and keeps an outing that still runs.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35])
+class HerDayViewModelTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val utc: TimeZone = TimeZone.getTimeZone("UTC")
+    private val minute = 60_000L
+
+    /** 2026-11-18 21:40:00 UTC. */
+    private val evening = Calendar.getInstance(utc).apply {
+        clear()
+        set(2026, Calendar.NOVEMBER, 18, 21, 40, 0)
+    }.timeInMillis
+    private val clock = AtomicLong(evening)
+    private val log by lazy { HerLog({ File(folder.root, "her_log.json") }, { clock.get() }) }
+
+    private fun await(what: String, condition: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 5_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            assertTrue("Timed out waiting for $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    /** An outing that read about egg magazine, and in which she thought, noted, felt, wondered and said things. */
+    private fun anOuting(sentinel: String) {
+        val id = log.start(HerLog.Kind.READ, "")
+        val tally = HerLog.Tally()
+        tally.searched("egg magazine")
+        tally.opened("egg (雑誌)", "ja.wikipedia.org")
+        val reply = "<< $sentinel thought\nnote: user | $sentinel | $sentinel note\nfeel: $sentinel feel\n" +
+            "wonder: $sentinel wonder\nsay: $sentinel said\n>> $sentinel command\ndo: done"
+        repeat(4) {
+            tally.called()
+            tally.step(OutingStep.parse(reply, sayUsed = it > 0))
+        }
+        clock.addAndGet(7 * minute)
+        log.end(id, HerLog.EndedBy.DONE, tally)
+    }
+
+    @Test
+    fun `a day is told in lines of times, where, titles, her search words, counts and calls, and nothing she wrote`() {
+        anOuting("SENTINEL")
+        val line = herDayLine(log.entries().single(), utc, Locale.ENGLISH)
+        assertTrue(line, line.startsWith("21:40–21:47 reading · ja.wikipedia.org · search 'egg magazine', 'egg (雑誌)' · 1 search, 1 page opened, 4 steps, "))
+        assertTrue(line, line.endsWith(" · 4 >> lines not run · 4 calls · she was done"))
+        // Her one line to him of the outing, counted; what she thought, noted, felt and wondered, counted.
+        for (count in listOf("4 steps with a thought of hers", "4 feel lines", "4 wonders", "1 line to you")) {
+            assertTrue("$count in $line", line.contains(count))
+        }
+        assertFalse(line, line.contains("SENTINEL"))
+        // Refusals by category, never what was refused.
+        assertEquals(
+            "2 not sent (his name), 1 not fetched (robots), 1 >> line not run",
+            refusalsText(mapOf("guard:HIS_NAME" to 2, "fetch:ROBOTS" to 1, HerLog.Tally.COMMAND_NOT_RUN to 1))
+        )
+    }
+
+    @Test
+    fun `days are headed today, yesterday or their date, newest first, with what did not start and her commands`() {
+        clock.set(evening - 26 * 60 * minute)
+        log.notStarted(HerLog.NotStarted.BUDGET, "reading")
+        clock.set(evening - 50 * 60 * minute)
+        log.command(">> open spotify", "a plan was made", 3)
+        clock.set(evening)
+        anOuting("x")
+        clock.set(evening + 9 * minute)
+        val running = log.start(HerLog.Kind.NEWS, "news.yahoo.co.jp")
+
+        val days = herDayGroups(log.entries(), clock.get(), utc, Locale.ENGLISH)
+        assertEquals(listOf("Today", "Yesterday", "Mon 16 Nov 2026"), days.map { it.heading })
+        assertEquals("21:49–now news · news.yahoo.co.jp · 0 calls · still running", days[0].lines[0])
+        assertTrue(days[0].lines[1].startsWith("21:40–21:47 reading"))
+        assertEquals(listOf("19:40 a go: of hers did not start (reading): calls on her own ran low"), days[1].lines)
+        assertEquals(listOf("19:40 a command of hers on the phone: '>> open spotify' · a plan was made · 3 calls"), days[2].lines)
+        log.end(running, HerLog.EndedBy.STOP)
+        assertEquals(
+            "21:49 news · news.yahoo.co.jp · 0 calls · he pressed stop",
+            herDayGroups(log.entries(), clock.get(), utc, Locale.ENGLISH)[0].lines[0]
+        )
+    }
+
+    @Test
+    fun `the screen's model shows the log as it changes, and Clear keeps only an outing still running`() {
+        val model = HerDayViewModel(log, { clock.get() }, { utc })
+        await("the log to be read") { model.days != null }
+        assertEquals(emptyList<HerDayGroup>(), model.days)
+
+        anOuting("x")
+        await("the outing to show") { model.days.orEmpty().isNotEmpty() }
+        val running = log.start(HerLog.Kind.NEWS, "news.yahoo.co.jp")
+        await("the running outing to show") { model.days!!.single().lines.size == 2 }
+
+        model.clear()
+        await("the log to be cleared") { model.status.isNotEmpty() && model.days!!.single().lines.size == 1 }
+        assertEquals(HerDayViewModel.HER_DAY_CLEARED, model.status)
+        assertTrue(model.days!!.single().lines.single().contains("still running"))
+        // It is still written down when it ends.
+        clock.addAndGet(3 * minute)
+        log.end(running, HerLog.EndedBy.DONE)
+        assertEquals(HerLog.EndedBy.DONE, log.entries().single().endedBy)
+    }
+
+    @Test
+    fun `the words of her day hold against what the code keeps`() {
+        // Clear says it keeps the count of her calls: the ledger is a file of its own, which Clear does not touch.
+        val herLog = File("src/main/java/com/opendroid/ai/core/life/HerLog.kt").readText()
+        assertTrue(herLog.contains("change { all -> all.filter { it.endedBy == EndedBy.RUNNING } }"))
+        assertFalse(herLog.contains("OwnLedger"))
+        assertEquals(90 * 24 * 60 * 60_000L, HerLog.KEEP_MILLIS)
+        assertTrue(com.opendroid.ai.ui.screens.HER_DAY_HINT.contains("Entries older than 90 days go by themselves."))
+        assertTrue(com.opendroid.ai.ui.screens.HER_DAY_HINT.contains("What she thought, noted or felt is never in it."))
+        assertTrue(com.opendroid.ai.ui.screens.HER_DAY_CLEAR_CONFIRM.contains("except an outing still running"))
+        // Her wonders are a store of their own, out of the log.
+        assertNull(Wonders::class.java.declaredFields.firstOrNull { it.type == HerLog::class.java })
+        // The count words name the host's own key for feeds she followed.
+        assertEquals("1 feed followed", countsText(mapOf(OutingHost.FEEDS_FOLLOWED to 1)))
+    }
+}
