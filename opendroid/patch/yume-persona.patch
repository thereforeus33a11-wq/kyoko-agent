+++ b/app/src/test/java/com/opendroid/ai/ui/viewmodel/SettingsViewModelOwnLifeTest.kt
@@ -0,0 +1,260 @@
+package com.opendroid.ai.ui.viewmodel
+
+import android.content.Context
+import android.os.Looper
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import androidx.work.Configuration
+import androidx.work.WorkManager
+import com.opendroid.ai.core.life.OwnLife
+import com.opendroid.ai.core.life.reading.Feeds
+import com.opendroid.ai.core.life.reading.HerFeeds
+import com.opendroid.ai.core.llm.ModelDownloadTestApplication
+import com.opendroid.ai.core.llm.ModelFetcher
+import com.opendroid.ai.core.llm.OnDeviceEngineReleaser
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.core.settings.AppSettingsStore
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.OwnLifeBounds
+import com.opendroid.ai.data.repository.ModelRepository
+import com.opendroid.ai.data.repository.SettingsRepository
+import java.io.File
+import java.nio.file.Files
+import java.time.Duration
+import java.util.concurrent.Executors
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * His settings for her own life, set through the real settings model against a real
+ * DataStore: the defaults as shipped, every setter saved and read back after a restart,
+ * and her feeds as the host of her outings reads them from those settings.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = ModelDownloadTestApplication::class)
+class SettingsViewModelOwnLifeTest {
+
+    private lateinit var context: Context
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var settings: SettingsRepository
+
+    @Before
+    fun setup() {
+        context = ApplicationProvider.getApplicationContext()
+        if (!WorkManager.isInitialized()) {
+            WorkManager.initialize(
+                context,
+                Configuration.Builder().setTaskExecutor(Executors.newSingleThreadExecutor()).build()
+            )
+        }
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        settings = SettingsRepository(
+            dataStore = PreferenceDataStoreFactory.create(
+                scope = CoroutineScope(SupervisorJob() + Dispatchers.IO),
+                produceFile = {
+                    Files.createTempDirectory("opendroid-own-life-vm-test")
+                        .resolve("settings.preferences_pb")
+                        .toFile()
+                }
+            ),
+            providerCredentialStore = EmptyProviderCredentialStore(),
+            runStartupMigration = false
+        )
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `her own life ships off, with 150 calls a day, 15 minutes, 12 steps, no asking and reading on`() {
+        val shipped = LLMConfig()
+        assertFalse(shipped.personaOwnLife)
+        assertEquals(150, shipped.personaOwnCallsPerDay)
+        assertEquals(15, shipped.personaOutingMaxMinutes)
+        assertEquals(12, shipped.personaOutingMaxSteps)
+        assertFalse(shipped.personaOutingsAsk)
+        assertTrue(shipped.personaReads)
+        assertTrue(shipped.personaReadFeedsRemoved.isEmpty())
+        assertTrue(shipped.personaReadYouTube.isEmpty())
+        // This build's fresh start leaves it off too: he switches it on himself.
+        assertFalse(com.opendroid.ai.data.models.BuildDefaults.fresh().personaOwnLife)
+        // His choices of calls a day run from 50 to 300.
+        assertEquals(50, OwnLifeBounds.CALLS_PER_DAY_STEPS.first())
+        assertEquals(300, OwnLifeBounds.CALLS_PER_DAY_STEPS.last())
+        assertTrue(OwnLifeBounds.DEFAULT_CALLS_PER_DAY in OwnLifeBounds.CALLS_PER_DAY_STEPS)
+        // A setting saved before these fields existed reads as shipped.
+        val old = Json { ignoreUnknownKeys = true }.decodeFromString(LLMConfig.serializer(), """{"personaCheckInsEnabled":true}""")
+        assertFalse(old.personaOwnLife)
+        assertEquals(150, old.personaOwnCallsPerDay)
+        assertTrue(old.personaReads)
+    }
+
+    @Test
+    fun `every setting of her own life is saved and read back as he set it`() {
+        val viewModel = viewModel()
+        pumpUntil("the settings to load") { viewModel.llmConfig.value == stored() }
+
+        viewModel.updatePersonaOwnLife(true)
+        viewModel.updatePersonaOwnCallsPerDay(250)
+        viewModel.updatePersonaOutingMaxMinutes(30)
+        viewModel.updatePersonaOutingMaxSteps(4)
+        viewModel.updatePersonaOutingsAsk(true)
+        viewModel.updatePersonaReads(false)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.YAHOO_ENTERTAINMENT.id, removed = true)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.GOOGLE_NEWS_WORLD.id, removed = true)
+        viewModel.updatePersonaReadFeedRemoved(Feeds.GOOGLE_NEWS_WORLD.id, removed = false)
+        assertTrue(viewModel.addPersonaYouTubeChannel(CHANNEL, "Gyaru TV"))
+
+        pumpUntil("every edit saved") {
+            val stored = stored()
+            stored.personaOwnLife && stored.personaOwnCallsPerDay == 250 && stored.personaOutingMaxMinutes == 30 &&
+                stored.personaOutingMaxSteps == 4 && stored.personaOutingsAsk && !stored.personaReads &&
+                stored.personaReadFeedsRemoved == listOf(Feeds.YAHOO_ENTERTAINMENT.id) &&
+                stored.personaReadYouTube == mapOf(CHANNEL to "Gyaru TV")
+        }
+        // The host's own reading of them.
+        val stored = stored()
+        assertEquals(250, OwnLife.capOf(stored))
+        assertEquals(30, OwnLife.maxMinutes(stored))
+        assertEquals(4, OwnLife.maxSteps(stored))
+        // Reading off: there is nothing she can go out to.
+        assertTrue(OwnLife.runnable(stored).isEmpty())
+
+        viewModel.removePersonaYouTubeChannel(CHANNEL)
+        viewModel.updatePersonaReads(true)
+        pumpUntil("the channel taken off") { stored().personaReadYouTube.isEmpty() && stored().personaReads }
+        assertEquals(2, OwnLife.runnable(stored()).size)
+    }
+
+    @Test
+    fun `a channel id that is no channel id, or one past the most there can be, is not added`() {
+        val viewModel = viewModel()
+        pumpUntil("the settings to load") { viewModel.llmConfig.value == stored() }
+        assertFalse(viewModel.addPersonaYouTubeChannel("not-a-channel", "x"))
+        repeat(OwnLifeBounds.MAX_YOUTUBE_CHANNELS) { i ->
+            assertTrue(viewModel.addPersonaYouTubeChannel(channel(i), "channel $i"))
+        }
+        assertFalse(viewModel.addPersonaYouTubeChannel(channel(99), "one too many"))
+        // The same channel again only renames it.
+        assertTrue(viewModel.addPersonaYouTubeChannel(channel(0), "renamed"))
+        pumpUntil("the channels saved, the first renamed") {
+            stored().personaReadYouTube.size == OwnLifeBounds.MAX_YOUTUBE_CHANNELS && stored().personaReadYouTube[channel(0)] == "renamed"
+        }
+        assertFalse(channel(99) in stored().personaReadYouTube)
+    }
+
+    @Test
+    fun `her feeds are the defaults he did not take away, then his YouTube channels, then the feeds she follows`() {
+        val folder = Files.createTempDirectory("her-feeds").toFile()
+        val herFeeds = HerFeeds { File(folder, "her_feeds.json") }
+        assertEquals(HerFeeds.Followed.ADDED, herFeeds.follow("https://example.org/feed.xml", "Example"))
+
+        val config = LLMConfig(
+            personaReadFeedsRemoved = listOf(Feeds.YAHOO_TOP.id),
+            personaReadYouTube = mapOf(CHANNEL to "Gyaru TV")
+        )
+        val all = herFeeds.all(config)
+        assertEquals(
+            listOf(Feeds.YAHOO_ENTERTAINMENT.id, Feeds.GOOGLE_NEWS_JAPAN.id, Feeds.GOOGLE_NEWS_WORLD.id, "yt-$CHANNEL"),
+            all.take(4).map { it.id }
+        )
+        assertEquals("https://www.youtube.com/feeds/videos.xml?channel_id=$CHANNEL", all[3].url)
+        assertEquals("Gyaru TV", all[3].name)
+        assertEquals("https://example.org/feed.xml", all.last().url)
+
+        // He takes her own feed off: it is gone from her feeds, and taking it again changes nothing.
+        assertTrue(herFeeds.unfollow("https://example.org/feed.xml"))
+        assertTrue(herFeeds.followed().isEmpty())
+        assertTrue(herFeeds.unfollow("https://example.org/feed.xml"))
+        assertEquals(4, herFeeds.all(config).size)
+        // The host of her outings reads her feeds from his settings through this.
+        val host = File("src/main/java/com/opendroid/ai/core/life/OutingHost.kt").readText()
+        assertTrue(host.contains("herFeeds = { config -> followed.all(config) }"))
+    }
+
+    private fun channel(i: Int) = "UC" + i.toString().padStart(22, 'a')
+
+    private fun viewModel() = SettingsViewModel(
+        context = context,
+        settingsRepository = settings,
+        notificationDao = database.notificationDao(),
+        llmProviderFactory = { error("no provider calls in this test") },
+        modelFetcher = { ModelFetcher(OkHttpClient(), settings) },
+        modelRepository = ModelRepository(context, database.modelDao(), settings, OnDeviceEngineReleaser { }),
+        okHttpClient = OkHttpClient(),
+        providerCredentialStore = EmptyProviderCredentialStore(),
+        appSettingsStore = NoOpAppSettingsStore()
+    )
+
+    private fun stored(): LLMConfig = runBlocking { settings.llmConfig.first() }
+
+    private fun pumpUntil(what: String, condition: () -> Boolean) {
+        repeat(150) {
+            shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(100))
+            if (condition()) return
+            Thread.sleep(20)
+        }
+        throw AssertionError("Timed out waiting for: $what; stored = ${stored()}")
+    }
+
+    private class NoOpAppSettingsStore : AppSettingsStore {
+        override fun isOnboardingCompleted(): Boolean = true
+        override fun setOnboardingCompleted(completed: Boolean): Boolean = true
+        override fun huggingFaceLastVerified(): String? = null
+        override fun setHuggingFaceLastVerified(value: String?): Boolean = true
+        override fun migrateLegacySettings(): Boolean = true
+    }
+
+    private class EmptyProviderCredentialStore : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+
+    private companion object {
+        const val CHANNEL = "UCabcdefghijklmnopqrstuv"
+    }
+}
