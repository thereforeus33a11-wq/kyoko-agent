+     * could not be read, or the whole index could not) is not deleted here: an ordinary
+     * change, or a reply of hers that counts a turn, must never cost a picture nobody
+     * asked to remove. Such a file stays and is counted in [unlisted].
+     */
+    private fun save(index: PersonaPictureRules.Index) {
+        val named = index.pictures.map { it.file }.toSet()
+        val dropped = loaded?.pictures.orEmpty().map { it.file }.filterNot { it in named }
+        // What the app works with changes first: a phone that cannot write just now
+        // must not cost her a reply, and the next change writes the whole index again.
+        loaded = index
+        current.value = index.pictures
+        val draft = File(directory, "$INDEX_FILE.tmp")
+        try {
+            directory.mkdirs()
+            // Written beside the index and moved over it, so a write that is cut short leaves the old one.
+            draft.writeText(PersonaPictureRules.encodeIndex(index))
+            if (!draft.renameTo(indexFile)) {
