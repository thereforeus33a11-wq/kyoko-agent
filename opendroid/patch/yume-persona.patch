+package com.opendroid.ai.core.persona
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.io.File
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Where the character card comes from: a text file bundled with the app, or the
+ * owner's edited copy when one has been saved from the Persona screen.
+ *
+ * The card is read once and kept in memory; it is a few kilobytes of text that is
+ * needed on every chat reply.
+ */
+@Singleton
+class PersonaStore @Inject constructor(
+    @ApplicationContext private val context: Context
+) {
+    @Volatile private var cachedCard: String? = null
+
+    private val overrideFile: File
+        get() = File(File(context.filesDir, DIRECTORY), CARD_FILE)
+
+    /** The card in use: the owner's saved copy if there is one, otherwise the bundled one. */
+    fun card(): String {
+        cachedCard?.let { return it }
+        val loaded = readOverride() ?: bundledCard()
+        cachedCard = loaded
+        return loaded
+    }
+
+    /** The card as shipped, ignoring any saved edit. Empty when the build has none. */
+    fun bundledCard(): String = readAsset("$DIRECTORY/$CARD_FILE")
+
+    fun hasOverride(): Boolean = overrideFile.isFile
+
+    /** Saves the owner's edited card. A blank text removes the edit and restores the bundled card. */
+    fun saveCard(text: String) {
+        val file = overrideFile
+        if (text.isBlank()) {
+            file.delete()
+        } else {
+            file.parentFile?.mkdirs()
+            file.writeText(text.trim() + "\n")
+        }
+        cachedCard = null
+    }
+
+    /** The notes she starts with, from the bundled seed file. */
+    fun seedNotes(): List<PersonaNotes.Note> = PersonaNotes.parse(readAsset("$DIRECTORY/$SEED_FILE"))
+
+    private fun readOverride(): String? = try {
+        overrideFile.takeIf { it.isFile }?.readText()?.takeIf { it.isNotBlank() }
+    } catch (e: Exception) {
+        Log.w(TAG, "Saved persona card could not be read; using the bundled one.")
+        null
+    }
+
+    private fun readAsset(path: String): String = try {
+        context.assets.open(path).bufferedReader().use { it.readText() }
+    } catch (e: Exception) {
+        // A build without persona assets simply has no persona.
+        ""
+    }
+
+    private companion object {
+        const val TAG = "PersonaStore"
+        const val DIRECTORY = "persona"
+        const val CARD_FILE = "card.md"
+        const val SEED_FILE = "seed_notes.txt"
+    }
+}
