+        assertFalse(PersonaActions.echoesOutsideText("text kenji: stop bothering him with stupid bots", notifications))
+        assertFalse(PersonaActions.echoesOutsideText("play some eurobeat and turn the volume up", notifications))
+    }
+
+    @Test
+    fun `a short command never counts as an echo by its words alone`() {
