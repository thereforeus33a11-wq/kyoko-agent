+package com.opendroid.ai.core.persona
+
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * How old she is today. Her files were written when she was 19 and say so; she was
+ * born on 19 August 2007 (kisaragi-before, kisaragi-life), and she gets older like
+ * anyone. Her prompt and the pictures she makes go by this, not by the number in a
+ * file. She is never younger than this.
+ */
+object PersonaAge {
+    const val BIRTH_YEAR = 2007
+    const val BIRTH_MONTH = 8
+    const val BIRTH_DAY = 19
+
+    /** The age her files were written at, and the least she is ever said or drawn to be. */
+    const val AGE_IN_FILES = 19
+
+    /** Her age on [nowMillis], on [zone]'s calendar: never below [AGE_IN_FILES]. */
+    fun on(nowMillis: Long, zone: TimeZone = TimeZone.getDefault()): Int {
+        val now = Calendar.getInstance(zone).apply { timeInMillis = nowMillis }
+        val year = now.get(Calendar.YEAR)
+        val month = now.get(Calendar.MONTH) + 1
+        val day = now.get(Calendar.DAY_OF_MONTH)
+        val hadBirthday = month > BIRTH_MONTH || (month == BIRTH_MONTH && day >= BIRTH_DAY)
+        return maxOf(AGE_IN_FILES, year - BIRTH_YEAR - if (hadBirthday) 0 else 1)
+    }
+
+    /** The line of her prompt that says it. */
+    fun line(age: Int): String =
+        "You are $age today (born 19 august 2007). Your files say 19 because that is when they were written: you get older like anyone, and you are never younger than you are."
+}
