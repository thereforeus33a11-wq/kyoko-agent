+/** Pitch and rate for the phone's own voice, and the ElevenLabs model. */
+@Composable
+fun SpeechTuningFields(config: LLMConfig, viewModel: SettingsViewModel) {
+    OutlinedTextField(
+        value = config.elevenLabsModelId,
+        onValueChange = viewModel::updateElevenLabsModelId,
+        label = { Text("ElevenLabs Model ID (optional)", fontSize = 12.sp) },
+        singleLine = true,
+        colors = fieldColors(),
+        modifier = Modifier.fillMaxWidth()
+    )
+    SpeechSlider(
+        label = "Phone voice pitch",
+        value = config.ttsPitch,
+        onChange = { viewModel.updateSpeechTuning(it, config.ttsSpeechRate) }
+    )
+    SpeechSlider(
+        label = "Phone voice speed",
+        value = config.ttsSpeechRate,
+        onChange = { viewModel.updateSpeechTuning(config.ttsPitch, it) }
+    )
+    Text(
+        text = "Pitch and speed apply to the phone's own voice. 1.0 is the engine default; lower is deeper and slower.",
+        fontSize = 10.sp,
+        color = TextSecondary
+    )
+}
+
+@Composable
+private fun SpeechSlider(label: String, value: Float, onChange: (Float) -> Unit) {
+    val shown = SpeechTuning.clamp(value)
+    Column {
+        Text(
+            text = "$label: ${"%.2f".format(java.util.Locale.US, shown)}",
+            fontSize = 12.sp,
+            color = TextPrimary
+        )
+        Slider(
+            value = shown,
+            onValueChange = onChange,
+            valueRange = SpeechTuning.MIN..SpeechTuning.MAX,
+            colors = SliderDefaults.colors(thumbColor = AccentCyan, activeTrackColor = AccentCyan)
+        )
+    }
+}
