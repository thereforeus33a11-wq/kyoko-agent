+        assertEquals(3_010L, lastPass())
+    }
+
+    @Test
+    fun `no pass is made until three of her replies are newer than the last one`() {
+        val engine = engine()
+
+        engine.afterReply(talk.take(4))
+        assertEquals(0, server.requestCount)
+        assertEquals(0L, lastPass())
+
+        // The same three replies after a pass that read them: nothing is due.
+        runBlocking { memory.recordReflection(3_010) }
+        engine.afterReply(talk)
+        assertEquals(0, server.requestCount)
+        assertEquals(3_010L, lastPass())
+    }
+
+    @Test
+    fun `her lines about results do not make a pass due`() {
+        val engine = engine()
+        // Two commands of his, each with the app's row and her line about it, then one remark.
+        val rows = listOf(
+            his("flashlight on", 1_000), app("Flashlight on.", 1_010), hers("light's on", 1_020),
+            his("set an alarm for seven", 2_000), app("Alarm set for 7:00.", 2_010), hers("seven it is", 2_020),
+            his("i still say melon soda is too sweet", 3_000), hers("it is mine and i do not share", 3_010)
+        )
+
+        engine.afterReply(rows)
+
+        assertEquals(0, server.requestCount)
+        assertEquals(0L, lastPass())
+    }
+
+    @Test
+    fun `a pass that fails writes no time, so her next reply tries again`() {
+        val engine = engine()
+        failure()
+
+        engine.afterReply(talk)
+        assertEquals(1, server.requestCount)
+        assertEquals(0L, lastPass())
+        assertTrue(runBlocking { memory.notes() }.isEmpty())
+
+        answer("NONE")
+        engine.afterReply(talk)
+        assertEquals(2, server.requestCount)
+        // She kept nothing, and the pass still counts as made.
+        assertEquals(3_010L, lastPass())
+        assertTrue(runBlocking { memory.notes() }.isEmpty())
+    }
+
+    @Test
+    fun `a reply that comes while a pass is being written starts no second one`() {
+        val engine = engine()
+        val rowsWanted = java.util.concurrent.CountDownLatch(1)
+        val goOn = java.util.concurrent.CountDownLatch(1)
+        answer("NONE")
+
+        val first = engine.onReply {
+            rowsWanted.countDown()
+            goOn.await()
+            talk
+        }
+        assertTrue(rowsWanted.await(10, java.util.concurrent.TimeUnit.SECONDS))
+        // The first is still at work: this one starts nothing and says so.
+        assertNull(engine.onReply { talk })
+        goOn.countDown()
+        runBlocking { first!!.join() }
+
+        assertEquals(1, server.requestCount)
+        assertEquals(3_010L, lastPass())
+    }
+
+    @Test
+    fun `a thread she closes in a pass is still in her notebook, and in her next prompt as over`() {
+        runBlocking { memory.apply(listOf(Note(Kind.THREAD, "hive", "the second hive is not built | open"))) }
+        val engine = engine()
+        answer("thread | hive | the second hive is up and the bees moved in | closed")
+
+        engine.afterReply(talk)
+
+        assertEquals(listOf("the second hive is up and the bees moved in | closed"), runBlocking { memory.notes() }.map { it.text })
+        val prompt = runBlocking { engine.chatSystemPrompt(config(), "", emptyList(), screenshotAttached = false) }
+        assertTrue(prompt.contains("Over, and you remember how it went:\n- the second hive is up and the bees moved in | closed"))
+        assertFalse(prompt.contains("Still going on:"))
+    }
+
+    @Test
+    fun `a pass does not write over an old note its page had no room for`() {
+        runBlocking {
+            memory.apply(listOf(Note(Kind.USER, "work", "he does night shifts at the bakery and sleeps at 3am because of it")))
+            // Enough newer notes that the oldest ones are neither in her prompt nor on the pass's page.
+            memory.apply((1..120).map { Note(Kind.OPINION, "view-$it", "view number $it ".padEnd(110, 'x')) })
+        }
+        val engine = engine()
+        // The obvious slug for what he just said, and a note that was on the page.
+        answer("user | work | he was up late working again\nopinion | view-120 | the newest view, put another way")
+
+        engine.afterReply(talk)
