--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookPassTest.kt
@@ -0,0 +1,126 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her notebook pass: it is due from what is stored, not from a count that is lost when
+ * the app is closed, and it is written by her, with her card in front of it.
+ */
+class PersonaNotebookPassTest {
+
+    private var nextId = 0
+    private fun row(sender: Sender, badge: String?, at: Long, text: String = "line") =
+        ChatMessage(id = "m${nextId++}", text = text, sender = sender, timestamp = at, modelBadge = badge)
+
+    @Test
+    fun `a pass is due once three of her replies are newer than the last one`() {
+        val rows = listOf(
+            row(Sender.USER, null, 100),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110),
+            row(Sender.AGENT, "System", 120),
+            row(Sender.USER, null, 200),
+            row(Sender.AGENT, PersonaPrompts.STOPPED_BADGE, 210),
+            row(Sender.USER, null, 300),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 310)
+        )
+        // Counted from the stored rows, so a process that starts afresh still knows: three of hers.
+        assertEquals(3, PersonaEngine.repliesSince(rows, 0))
+        assertEquals(3, PersonaEngine.REPLIES_PER_REFLECTION)
+        // Only replies newer than the last pass count, and the app's rows and his never do.
+        assertEquals(2, PersonaEngine.repliesSince(rows, 110))
+        assertEquals(1, PersonaEngine.repliesSince(rows, 210))
+        assertEquals(0, PersonaEngine.repliesSince(rows, 310))
+        assertEquals(0, PersonaEngine.repliesSince(emptyList(), 0))
+    }
+
+    @Test
+    fun `her line about a result and a line she wrote unprompted are not replies`() {
+        val rows = listOf(
+            // Two commands of his: the app's exact row, then her line about it.
+            row(Sender.USER, null, 100, "flashlight on"),
+            row(Sender.AGENT, "System", 110, "Flashlight on."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 120, "light's on"),
+            row(Sender.USER, null, 200, "set an alarm for seven"),
+            row(Sender.AGENT, "System", 210, "Alarm set for 7:00."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 220, "seven it is"),
+            // Hours later she writes first.
+            row(Sender.AGENT, PersonaPrompts.BADGE, 9_000, "the boots are still in the window"),
+            // And then he says one thing to her.
+            row(Sender.USER, null, 9_100, "which boots"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 9_110, "the ones you will hear about until i have them")
+        )
+        // Four rows carry her badge, and one of them answers him.
+        assertEquals(4, rows.count { PersonaPrompts.isHers(it) })
+        assertEquals(1, PersonaEngine.repliesSince(rows, 0))
+        assertTrue(PersonaEngine.repliesSince(rows, 0) < PersonaEngine.REPLIES_PER_REFLECTION)
+
+        // A reply that ends in a command of her own is one reply, whatever the app and she say after it.
+        val ownCommand = listOf(
+            row(Sender.USER, null, 100, "it is dark in here"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110, "then let there be light"),
+            row(Sender.AGENT, PersonaActions.REIN_BADGE, 120, "Running on Yume's own command, without asking: 1 step"),
+            row(Sender.AGENT, "System", 130, "Flashlight on."),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 140, "there")
+        )
+        assertEquals(1, PersonaEngine.repliesSince(ownCommand, 0))
+    }
+
+    @Test
+    fun `two short visits on different days add up to a pass`() {
+        // Two replies before the app was closed, two after it was opened again: no count
+        // kept in memory would have reached three.
+        val yesterday = listOf(
+            row(Sender.USER, null, 1_000), row(Sender.AGENT, PersonaPrompts.BADGE, 1_010),
+            row(Sender.USER, null, 1_100), row(Sender.AGENT, PersonaPrompts.BADGE, 1_110)
+        )
+        val today = listOf(
+            row(Sender.USER, null, 90_000), row(Sender.AGENT, PersonaPrompts.BADGE, 90_010),
+            row(Sender.USER, null, 90_100), row(Sender.AGENT, PersonaPrompts.BADGE, 90_110)
+        )
+        assertTrue(PersonaEngine.repliesSince(yesterday, 0) < PersonaEngine.REPLIES_PER_REFLECTION)
+        assertTrue(PersonaEngine.repliesSince(yesterday + today, 0) >= PersonaEngine.REPLIES_PER_REFLECTION)
+        // After a pass over all of it nothing is due until she has said more.
+        val read = (yesterday + today).maxOf { it.timestamp }
+        assertEquals(0, PersonaEngine.repliesSince(yesterday + today, read))
+    }
+
+    @Test
+    fun `the pass is asked as her, once, with room for the lines it may write`() {
+        val dialogue = listOf(
+            row(Sender.USER, null, 100, "the second hive is up"),
+            row(Sender.AGENT, PersonaPrompts.BADGE, 110, "finally")
+        )
+        val request = PersonaEngine.reflectionRequest(
+            card = "You are Yume. {{owner}} built you.",
+            ownerName = "Sam",
+            notebook = "rel | stage | past the polite part",
+            dialogue = dialogue,
+            notesAboutHimHeldBack = false
+        )
+
+        // Her card comes first: the one who decides what she keeps is her.
+        assertTrue(request.systemPrompt.startsWith("You are Yume. Sam built you.\n\n"))
+        assertTrue(request.systemPrompt.endsWith(PersonaPrompts.REFLECTION_SYSTEM_PROMPT))
+        val asked = request.messages.single()
+        assertEquals(Sender.USER, asked.sender)
+        assertTrue(asked.text.contains("rel | stage | past the polite part"))
+        assertTrue(asked.text.contains("he: the second hive is up"))
+        assertTrue(asked.text.contains("i: finally"))
+        assertFalse(asked.text.contains("Not shown"))
+        assertEquals(ResponseFormat.TEXT, request.responseFormat)
+        assertEquals(RetryPolicy.NONE, request.retryPolicy)
+        // Five lines of the longest note are some 1,200 characters; this leaves room for them.
+        val longest = PersonaNotes.LINES_PER_PASS * (PersonaNotes.MAX_NOTE_CHARS + 50)
+        assertTrue(request.maxTokens * 3 >= longest)
+
+        val heldBack = PersonaEngine.reflectionRequest("You are Yume.", "Sam", "", dialogue, notesAboutHimHeldBack = true)
+        assertTrue(heldBack.messages.single().text.contains("Not shown: what you have noted about him, and what you saw on his screen."))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookTalkTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookTalkTest.kt
new file mode 100644
index 0000000..42dd9c2
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaNotebookTalkTest.kt
@@ -0,0 +1,615 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.ChatMessage.Sender
+import com.opendroid.ai.data.repository.SessionMessage
+import java.util.TimeZone
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What her notebook pass reads of the chats: everything that is unread, by time, in pages
+ * of a fixed room, so that nothing he told her is passed over. And what it does not
+ * read: her own line about a result, which is the phone's facts in her words.
+ */
+class PersonaNotebookTalkTest {
+
+    private var nextId = 0
+    private fun his(text: String, at: Long, chat: String = "chat-1", badge: String? = PersonaPrompts.OWNER_TALK_BADGE) =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.USER, timestamp = at, modelBadge = badge))
+    private fun hers(text: String, at: Long, chat: String = "chat-1", badge: String = PersonaPrompts.BADGE) =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, timestamp = at, modelBadge = badge))
+    private fun app(text: String, at: Long, chat: String = "chat-1", badge: String = "System") =
+        SessionMessage(chat, ChatMessage(id = "m${nextId++}", text = text, sender = Sender.AGENT, timestamp = at, modelBadge = badge))
+
+    private val utc = TimeZone.getTimeZone("UTC")
+    private val day = 24 * 60 * 60_000L
+
+    // ── When a pass is due ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `replies are counted chat by chat, and a pass is due at three of them wherever they were said`() {
+        val rows = listOf(
+            his("the second hive is up", 1_000, "chat-1"), hers("finally", 1_010, "chat-1"),
+            his("flashlight on", 1_500, "chat-1", PersonaPrompts.OWNER_COMMAND_BADGE), app("Flashlight on.", 1_510, "chat-1"),
+            hers("light's on", 1_520, "chat-1", PersonaPrompts.RESULT_BADGE),
+            his("melon soda is too sweet", 2_000, "chat-2"), hers("it is mine", 2_010, "chat-2")
+        )
+        assertEquals(2, PersonaNotebookTalk.replies(rows))
+        assertFalse(PersonaNotebookTalk.isDue(rows))
+
+        val third = rows + listOf(his("fine", 3_000, "chat-3"), hers("mm", 3_010, "chat-3"))
+        assertEquals(3, PersonaNotebookTalk.replies(third))
+        assertTrue(PersonaNotebookTalk.isDue(third))
+        // A row of hers that opens a chat answers nothing in it, whatever was said last in another chat.
+        assertEquals(0, PersonaNotebookTalk.replies(listOf(his("hi", 1_000, "chat-1"), hers("the boots are still in the window", 2_000, "chat-2"))))
+        assertFalse(PersonaNotebookTalk.isDue(emptyList()))
+    }
+
+    @Test
+    fun `so many unread rows that one look is full make a pass due whatever the count of replies`() {
