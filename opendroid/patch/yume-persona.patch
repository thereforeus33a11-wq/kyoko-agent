index 0000000..b934a66
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/ui/screens/CameraWordingTest.kt
@@ -0,0 +1,133 @@
+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.OutingHost
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.life.eyes.CameraLook
+import com.opendroid.ai.core.life.eyes.HerCamera
+import com.opendroid.ai.core.service.CheckInNotification
+import com.opendroid.ai.data.models.CameraBounds
+import com.opendroid.ai.data.models.CameraWhich
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.ui.viewmodel.CAMERA_NEEDS_TAP
+import com.opendroid.ai.ui.viewmodel.CAMERA_READY
+import com.opendroid.ai.ui.viewmodel.cameraStatusLine
+import com.opendroid.ai.ui.viewmodel.eyesStatusLine
+import com.opendroid.ai.ui.viewmodel.herDayLine
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * What the card says about her camera looks is what the code does (OWN_LIFE_PLAN phase 2): the
+ * defaults, when a look runs and what calls it off, what goes out and what is kept, the status
+ * lines, and "Her day", which says which camera and when, and never what was seen.
+ */
+class CameraWordingTest {
+
+    private fun source(path: String) = File("src/main/java/com/opendroid/ai/$path").readText()
+
+    @Test
+    fun `the defaults are his plan's - off, back only, six a day, and he is told each time`() {
+        val config = LLMConfig()
+        assertFalse(config.personaCameraLooks)
+        assertEquals(CameraWhich.BACK_ONLY, config.personaCameraWhich)
+        assertEquals(6, config.personaCameraPerDay)
+        assertTrue(config.personaCameraTellMe)
+        assertTrue(6 in CameraBounds.PER_DAY_STEPS)
+        assertEquals(listOf(CameraWhich.BACK_ONLY, CameraWhich.FRONT_AND_BACK), CAMERA_WHICH_CHOICES.map { it.first })
+    }
+
+    @Test
+    fun `the switch says when a look runs, what calls it off, what goes out and what is kept, by the code's own rules`() {
+        assertTrue(CAMERA_HINT.contains("Only while your screen is on and unlocked, so you see Android's camera light"))
+        assertTrue(CAMERA_HINT.contains("not during a call, not while you are writing to her, and not with the battery under 20%"))
+        assertEquals(20, CameraLook.BATTERY_PERCENT)
+        assertTrue(CAMERA_HINT.contains("When you write to her, a call comes in or the screen goes off, the look is called off."))
+        assertTrue(CAMERA_HINT.contains("it is never stored"))
+        assertTrue(CAMERA_HINT.contains("A frame too dark to see anything is not sent."))
+        assertTrue(CAMERA_HINT.contains("A frame with a child or a teen in it is not described to her."))
+        assertTrue(CAMERA_HINT.contains("After the phone restarts, the camera waits until you tap Eyes and ears on the app's notification."))
+        assertEquals(com.opendroid.ai.core.service.OpenDroidService.EYES_AND_EARS, "Eyes and ears")
+        assertTrue(CAMERA_TELL_HINT.contains("gone after a minute"))
+        assertTrue(CAMERA_TELL_HINT.contains("Nothing of what was seen is in it."))
+        assertEquals(8_000L, HerCamera.TIMEOUT_MILLIS)
+        // The camera settings sit under her eyes and need them: a look is a picture for her eyes.
+        val card = source("ui/screens/PersonaSettingsCards.kt")
+        assertTrue(card.indexOf("if (!config.personaEyes) return") < card.indexOf("HerCameraSettings(config, viewModel)"))
+        assertEquals(
+            "Yume wants one look through the phone's camera, while your screen is on. It waits 30 min for your answer.",
+            CheckInNotification.outingAskText("Yume", HerLog.Kind.LOOK.word, 15, 30)
+        )
+        // He is told which camera, and that one which faces him does.
+        val back = com.opendroid.ai.core.life.eyes.FoldState.Pick.Use(
+            com.opendroid.ai.core.life.eyes.FoldState.Side.BACK, com.opendroid.ai.core.life.eyes.FoldState.Lens.BACK, "back camera"
+        )
+        val front = com.opendroid.ai.core.life.eyes.FoldState.Pick.Use(
+            com.opendroid.ai.core.life.eyes.FoldState.Side.FRONT, com.opendroid.ai.core.life.eyes.FoldState.Lens.FRONT, "front camera"
+        )
+        val outer = com.opendroid.ai.core.life.eyes.FoldState.pick(
+            com.opendroid.ai.core.life.eyes.FoldState.Posture.FOLDED, com.opendroid.ai.core.life.eyes.FoldState.Side.FRONT, frontAllowed = true
+        ) as com.opendroid.ai.core.life.eyes.FoldState.Pick.Use
+        fun asked(vararg uses: com.opendroid.ai.core.life.eyes.FoldState.Pick.Use) =
+            CheckInNotification.outingAskText("Yume", HerLog.Kind.LOOK.word, 15, 30, CameraLook.askWords(uses.toList()))
+        assertEquals("Yume wants one look through the back camera, while your screen is on. It waits 30 min for your answer.", asked(back))
+        assertEquals(
+            "Yume wants one look through the front camera, which faces you, while your screen is on. It waits 30 min for your answer.",
+            asked(front)
+        )
+        assertEquals(
+            "Yume wants one look through the back camera and then the front camera, which faces you (one picture each), " +
+                "while your screen is on. It waits 30 min for your answer.",
+            asked(back, front)
+        )
+        assertTrue(asked(outer).contains("the outer camera, which faces you while the phone is folded"))
+    }
+
+    @Test
+    fun `the status card says whether the camera is ready, and counts camera pictures among her eyes`() {
+        assertNull(cameraStatusLine(LLMConfig(), held = true))
+        assertEquals(CAMERA_READY, cameraStatusLine(LLMConfig(personaCameraLooks = true), held = true))
+        assertEquals(CAMERA_NEEDS_TAP, cameraStatusLine(LLMConfig(personaCameraLooks = true), held = false))
+        assertTrue(CAMERA_NEEDS_TAP.startsWith("Camera: needs one tap"))
+        assertEquals(com.opendroid.ai.ui.viewmodel.CAMERA_NOT_ALLOWED, cameraStatusLine(LLMConfig(personaCameraLooks = true), held = true, ready = false))
+        val calls = List(9) { OwnLedger.Call(1_000L + it, OwnPurpose.EYES, "google-gemma-4-31b-it", 900, 90) }
+        val summary = OwnLedger.summaryOf(calls, 150, 2_000L)
+        val line = eyesStatusLine(LLMConfig(personaEyes = true), summary, camera = 1)!!
+        assertTrue(line, line.startsWith("Eyes: 9 pictures (camera 1) in 24 h, of 60. About $"))
+        assertFalse(eyesStatusLine(LLMConfig(personaEyes = true), summary)!!.contains("camera"))
+        val entries = listOf(
+            HerLog.Entry("a", 1_000L, 1_500L, HerLog.Kind.LOOK, counts = mapOf(OutingHost.PICTURES_LOOKED to 1, CameraLook.CAMERA_LOOKS to 1)),
+            HerLog.Entry("b", 1_200L, 1_700L, HerLog.Kind.READ, counts = mapOf(OutingHost.PICTURES_LOOKED to 3))
+        )
+        assertEquals(1, CameraLook.describedToday(entries, 2_000L, OutingHost.PICTURES_LOOKED))
+    }
+
+    @Test
+    fun `her day says which camera and when, the counts, and never what was seen`() {
+        val utc = TimeZone.getTimeZone("UTC")
+        val at = 1_800_000_000_000L
+        val look = HerLog.Entry(
+            "l", at, at + 30_000L, HerLog.Kind.LOOK, where = "back camera",
+            counts = mapOf(CameraLook.CAMERA_LOOKS to 1, OutingHost.PICTURES_LOOKED to 1, HerLog.Tally.STEPS to 1),
+            calls = 2, endedBy = HerLog.EndedBy.DONE, refusals = mapOf("kid:TEEN" to 1)
+        )
+        assertEquals(
+            "08:00 looked through the back camera · 1 picture looked at, 1 step · 1 skipped as a kid's (teen) · 2 calls · she was done",
+            herDayLine(look, utc, Locale.ENGLISH)
+        )
+        val dark = look.copy(counts = mapOf(CameraLook.CAMERA_LOOKS to 1, CameraLook.TOO_DARK to 1), calls = 0, refusals = mapOf(CameraLook.CAMERA_PREFIX + "IN_USE" to 1))
+        assertEquals(
+            "08:00 looked through the back camera · 1 frame too dark to describe · 1 no picture (in use) · 0 calls · she was done",
+            herDayLine(dark, utc, Locale.ENGLISH)
+        )
+        val refused = HerLog.Entry("n", at, at, HerLog.Kind.NOT_STARTED, where = "looking", endedBy = HerLog.EndedBy.DONE, notStarted = HerLog.NotStarted.SCREEN_OFF)
+        assertEquals("08:00 a go: of hers did not start (looking): a camera look: his screen was off or locked", herDayLine(refused, utc, Locale.ENGLISH))
+    }
+}
