+++ b/app/src/test/java/com/opendroid/ai/core/life/OutgoingGuardTest.kt
@@ -0,0 +1,193 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.OutgoingGuard.Contact
+import com.opendroid.ai.core.life.OutgoingGuard.His
+import com.opendroid.ai.core.life.OutgoingGuard.Refusal
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * What leaves the phone from her space keeps his details home: identifiers are refused,
+ * topics go. Placeholder details only.
+ */
+class OutgoingGuardTest {
+
+    private val his = His(
+        name = "Ren Mizuno",
+        profileFields = listOf("1994-03-07"),
+        noteKeys = listOf("sister-aiko", "job"),
+        notesText = "he works night shifts at a bike shop in koenji, call him on 080 5555 0199",
+        contacts = listOf(
+            Contact("Taro Yamada", listOf("+81 90-1111-2222")),
+            Contact("山田花子", listOf("03-3333-4444")),
+            Contact("Mom", listOf("090 7777 8888"))
+        )
+    )
+
+    private fun check(text: String) = OutgoingGuard.check(text, his)
+
+    @Test
+    fun `his name and its parts are refused, in any case`() {
+        assertEquals(Refusal.HIS_NAME, check("Ren Mizuno"))
+        assertEquals(Refusal.HIS_NAME, check("ren"))
+        assertEquals(Refusal.HIS_NAME, check("who is mizuno"))
+        assertNull(check("rental cars in tokyo"))
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.check("水野さんのこと", His(name = "水野 蓮")))
+    }
+
+    @Test
+    fun `his profile fields are refused, his date of birth in any form`() {
+        assertEquals(Refusal.HIS_PROFILE, check("born 1994-03-07"))
+        assertEquals(Refusal.HIS_PROFILE, check("what happened on march 7, 1994"))
+        assertEquals(Refusal.HIS_PROFILE, check("1994年3月7日"))
+        assertNull(check("what happened in 1994"))
+    }
+
+    @Test
+    fun `a contact's full name and number are refused, a first name alone is a word`() {
+        assertEquals(Refusal.CONTACT, check("taro yamada"))
+        assertEquals(Refusal.CONTACT, check("山田花子 ブログ"))
+        assertEquals(Refusal.CONTACT, check("09011112222"))
+        assertEquals(Refusal.CONTACT, check("03 3333 4444 who"))
+        assertNull(check("mom jeans 2024"))
+    }
+
+    @Test
+    fun `what her notes say about him and their keys are refused`() {
+        assertEquals(Refusal.HIS_NOTES, check("sister aiko"))
+        assertEquals(Refusal.HIS_NOTES, check("bike shop koenji night shifts"))
+        assertEquals(Refusal.HIS_NOTES, check("080 5555 0199"))
+        assertNull(check("job interview tips"))
+    }
+
+    @Test
+    fun `identifiers of anyone are refused - mail, phone, address, plate`() {
+        val nobody = His(name = "")
+        fun of(text: String) = OutgoingGuard.check(text, nobody)
+        assertEquals(Refusal.EMAIL, of("someone@example.com"))
+        assertEquals(Refusal.PHONE, of("call 555-010-7788"))
+        assertEquals(Refusal.PHONE, of("+1 (555) 010 7788"))
+        assertEquals(Refusal.PHONE, of("090-1234-5678"))
+        assertEquals(Refusal.ADDRESS, of("221 baker street"))
+        assertEquals(Refusal.ADDRESS, of("100 Main St, Springfield"))
+        assertEquals(Refusal.ADDRESS, of("〒150-0042"))
+        assertEquals(Refusal.ADDRESS, of("渋谷区神南1-2-3"))
+        assertEquals(Refusal.ADDRESS, of("宇田川町3丁目"))
+        assertEquals(Refusal.PLATE, of("品川 300 あ 12-34"))
+        assertEquals(Refusal.PLATE, of("license plate 7XYZ123"))
+    }
+
+    @Test
+    fun `topics pass - a car model and its price, places, years, street fashion`() {
+        val nobody = His(name = "")
+        for (topic in listOf(
+            "toyota gr86 price",
+            "gr86 2024 price ¥3,500,000",
+            "gr86 price 3500000 yen",
+            "egg magazine 1999",
+            "shibuya 109 shops",
+            "top 10 tokyo street snaps",
+            "5 best street foods in osaka",
+            "license plate design ideas",
+            "isbn 9784063842760",
+            "2024-11-18 earthquake",
+            "渋谷区 カフェ",
+            "1番人気 コスメ",
+            "PS5 2TB price"
+        )) {
+            assertNull(topic, OutgoingGuard.check(topic, nobody))
+            assertNull(topic, OutgoingGuard.check(topic, his))
+        }
+    }
+
+    @Test
+    fun `the query string of a URL is checked, decoded`() {
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.checkUrl("https://example.com/search?q=Ren%20Mizuno", his))
+        assertEquals(Refusal.PHONE, OutgoingGuard.checkUrl("https://example.com/s?tel=090-1234-5678", his))
+        assertNull(OutgoingGuard.checkUrl("https://ja.wikipedia.org/wiki/Egg?action=view", his))
+        assertNull(OutgoingGuard.checkUrl("https://example.com/page", his))
+    }
+
+    @Test
+    fun `the host and the path of a link are checked too, his name run together, apart or with digits`() {
+        for (url in listOf(
+            "https://www.facebook.com/ren.mizuno",
+            "https://x.com/renmizuno",
+            "https://x.com/MizunoRen_",
+            "https://renmizuno.com/",
+            "https://ren-mizuno.jp/about",
+            "https://example.com/u/mizuno1994",
+            "https://en.wikipedia.org/wiki/Ren_Mizuno",
+            "https://example.com/%E3%83%9F%E3%82%BA%E3%83%8E"
+        )) {
+            assertEquals(url, Refusal.HIS_NAME, OutgoingGuard.checkUrl(url, his))
+            // A link on a page is held against what is his just the same.
+            assertEquals(url, Refusal.HIS_NAME, OutgoingGuard.checkUrl(url, his, typed = false))
+        }
+        assertEquals(Refusal.HIS_PROFILE, OutgoingGuard.checkUrl("https://example.com/1994-03-07/day", his))
+        // Ordinary paths pass: ids, dates and addresses of the site itself are not his.
+        for (url in listOf(
+            "https://www.nikkei.com/article/DGXZQOUA123456789/",
+            "https://en.wikipedia.org/wiki/221B_Baker_Street",
+            "https://news.yahoo.co.jp/articles/0a1b2c3d4e5f",
+            "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
+            "https://en.wikipedia.org/wiki/Rental_car"
+        )) {
+            assertNull(url, OutgoingGuard.checkUrl(url, his))
+        }
+    }
+
+    @Test
+    fun `a link from a page is held only against what is his, so its ids and odd characters pass`() {
+        // Typed by her, the query is checked for anyone's identifiers; from a page, only for his.
+        assertEquals(Refusal.PHONE, OutgoingGuard.checkUrl("https://example.com/item?id=1234567890", his))
+        assertNull(OutgoingGuard.checkUrl("https://example.com/item?id=1234567890", his, typed = false))
+        assertNull(OutgoingGuard.checkUrl("https://example.com/v?t=1731900000", his, typed = false))
+        // A space or a bar in a query is read, not refused as unreadable.
+        assertNull(OutgoingGuard.checkUrl("https://example.com/s?q=a b|c", his, typed = false))
+        assertNull(OutgoingGuard.checkUrl("https://example.com/s?q=egg|magazine", his))
+        // His details stay home whichever way the link came.
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.checkUrl("https://example.com/u?name=ren", his, typed = false))
+        assertEquals(Refusal.CONTACT, OutgoingGuard.checkUrl("https://example.com/c?tel=09011112222", his, typed = false))
+        assertEquals(Refusal.UNCHECKED, OutgoingGuard.checkUrl("not a link", his))
+    }
+
+    @Test
+    fun `his name in kana is refused, as a word of its own, and a Japanese name by its parts`() {
+        assertEquals(Refusal.HIS_NAME, check("レン ミズノ"))
+        assertEquals(Refusal.HIS_NAME, check("ミズノ 年収"))
+        assertEquals(Refusal.HIS_NAME, check("みずのさん"))
+        assertEquals(Refusal.HIS_NAME, check("れんくんの好きなもの"))
+        assertEquals(Refusal.HIS_NAME, check("ren1994"))
+        // Inside a longer word it is a word, not his name.
+        assertNull(check("レンタカー 料金"))
+        assertNull(check("れんらく 方法"))
+        // A Japanese name written without a space, by either part.
+        val japanese = His(name = "水野蓮")
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.check("水野 ブログ", japanese))
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.checkUrl("https://ja.wikipedia.org/wiki/水野", japanese))
+        assertEquals(Refusal.HIS_NAME, OutgoingGuard.checkUrl("https://水野.example.jp/", japanese))
+        assertNull(OutgoingGuard.check("渋谷 カフェ", japanese))
+    }
+
+    @Test
+    fun `romaji is written in kana as it sounds`() {
+        assertEquals(listOf("れん", "レン"), Kana.of("Ren"))
+        assertEquals(listOf("みずの", "ミズノ"), Kana.of("Mizuno"))
+        assertEquals(listOf("ゆうき", "ユウキ", "ユーキ"), Kana.of("Yūki"))
+        assertEquals(listOf("おおの", "オオノ", "オーノ"), Kana.of("Ohno"))
+        assertEquals(listOf("しんいち", "シンイチ"), Kana.of("Shin'ichi"))
+        assertEquals(listOf("いっせい", "イッセイ"), Kana.of("Issei"))
+        assertEquals(listOf("りさ", "リサ"), Kana.of("Lisa"))
+        assertEquals(emptyList<String>(), Kana.of("Xavier"))
+    }
+
+    @Test
+    fun `nothing passes when what is his could not be read`() {
+        assertEquals(Refusal.UNCHECKED, OutgoingGuard.check("egg magazine", His.UNREADABLE))
+        assertEquals(Refusal.UNCHECKED, OutgoingGuard.checkUrl("https://example.com/", His.UNREADABLE))
+        assertEquals("not sent: it would carry something about him", OutgoingGuard.TOLD)
+        assertEquals("His(<withheld>)", his.toString())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/OutingHostLookTest.kt b/app/src/test/java/com/opendroid/ai/core/life/OutingHostLookTest.kt
