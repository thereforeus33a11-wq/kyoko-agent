+            override suspend fun complete(request: com.opendroid.ai.core.llm.LLMRequest) = throw AssertionError("asked twice")
+            override fun streamComplete(request: com.opendroid.ai.core.llm.LLMRequest) = kotlinx.coroutines.flow.flow {
+                emit("thinking\n")
+                emit(">> text nene: where are")
