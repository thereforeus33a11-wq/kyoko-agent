+        why = why, actionsEnabled = actions, rein = rein, notificationShowsWords = showsWords, bounds = bounds,
+        number = number, hisClock = "Tuesday 22:10", tokyoClock = "Wednesday 07:10", heLastWrote = heLastWrote,
+        lastMoment = lastMoment, lastDid = lastDid, lastHadCommand = lastHadCommand, moved = moved,
+        movedAsked = asked, thoughtsLeftOut = leftOut, hostCanRead = hostCanRead
