+    /** "your last go: line could not be read: ..." or why it did not start. */
+    internal fun goMissedLine(missed: GoMissed, runnable: Set<OutingKind.Kind>, frontToo: Boolean = true): String {
+        val words = quoted(missed.words)
+        val why = HerLog.NotStarted.entries.firstOrNull { it.name == missed.why }
+        // A look has bounds of its own: fewer calls, and more battery.
+        val look = OutingKind.parse(missed.words).kind == OutingKind.Kind.LOOK
+        return when (why) {
+            HerLog.NotStarted.NOT_READ, null -> "your last go: line could not be read: $words. the app reads: ${goReads(runnable, frontToo)}."
+            HerLog.NotStarted.BUSY -> "your last go: line did not start: $words. another outing of yours was still running."
+            HerLog.NotStarted.BUDGET -> if (look) {
+                "your last go: line did not start: $words. fewer than ${com.opendroid.ai.core.life.eyes.CameraLook.CALLS_NEEDED} of his calls on your own were left."
+            } else {
+                "your last go: line did not start: $words. fewer than $OUTING_NEEDS_LEFT of his calls on your own were left."
+            }
+            HerLog.NotStarted.ASLEEP -> "your last go: line did not start: $words. you were asleep."
+            HerLog.NotStarted.SERVICE_DOWN ->
+                "your last go: line did not start: $words. your space was not awake: the app was not running on the phone. it is again once he opens the app."
+            HerLog.NotStarted.NO_SPACE -> "your last go: line did not start: $words. that space of yours is not set up."
+            HerLog.NotStarted.POWER -> if (look) {
+                "your last go: line did not start: $words. the phone's battery was under ${com.opendroid.ai.core.life.eyes.CameraLook.BATTERY_PERCENT}% or it was too hot."
+            } else {
+                "your last go: line did not start: $words. the phone's battery was low or it was too hot."
+            }
+            HerLog.NotStarted.SEVERAL -> "your last go: line did not start: $words. a later go: in the same moment counted."
+            HerLog.NotStarted.WAITING -> "your last go: line did not start: $words. another go: of yours was still waiting for his yes."
+            HerLog.NotStarted.HE_SAID_NO -> "your last go: line did not start: $words. his settings ask him first, and he said not now."
+            HerLog.NotStarted.NOT_ANSWERED ->
+                "your last go: line did not start: $words. his settings ask him first, and he did not answer within $OUTING_ASK_WAITS_MINUTES minutes."
+            HerLog.NotStarted.SCREEN_OFF ->
+                "your last go: line did not start: $words. his screen was off or locked: a look happens only while his screen is on, so he can see the camera light."
+            HerLog.NotStarted.CALL -> "your last go: line did not start: $words. a phone call was going on."
+            HerLog.NotStarted.TALKING -> "your last go: line did not start: $words. he was talking to you just then."
+            HerLog.NotStarted.LOOKS_USED_UP -> "your last go: line did not start: $words. his settings allow no more looks through the camera today."
+            HerLog.NotStarted.CAMERA_BUSY -> "your last go: line did not start: $words. another app was using the camera."
+            HerLog.NotStarted.FRONT_OFF -> "your last go: line did not start: $words. his settings let you look through the back camera only."
+            HerLog.NotStarted.FOLDED ->
+                "your last go: line did not start: $words. the phone was folded: its inner camera is shut inside the fold and the outer one faces him, so no camera faced away from him."
+            HerLog.NotStarted.FOLD_UNKNOWN ->
+                "your last go: line did not start: $words. the app could not tell how the phone was folded, so it could not tell which way a camera faced."
+        }
