+    /** [jpeg] with an EXIF segment put in right after its start, holding [sentinel]. */
+    private fun withExif(jpeg: ByteArray, sentinel: String): ByteArray {
+        val payload = "Exif\u0000\u0000".toByteArray(Charsets.ISO_8859_1) + "MM\u0000*GPS $sentinel".toByteArray(Charsets.ISO_8859_1)
+        val length = payload.size + 2
+        val segment = byteArrayOf(0xff.toByte(), 0xe1.toByte(), (length shr 8).toByte(), (length and 0xff).toByte()) + payload
+        return jpeg.copyOfRange(0, 2) + segment + jpeg.copyOfRange(2, jpeg.size)
+    }
