+    fun unfollow(feed: Feeds.Feed) {
+        viewModelScope.launch {
+            val gone = withContext(Dispatchers.IO) { herFeeds.unfollow(feed.url) }
+            followed = withContext(Dispatchers.IO) { herFeeds.followed() }
+            feedStatus = if (gone) "\"${feed.name}\" is off her feeds." else "Her feeds could not be changed just now."
+        }
+    }
+
+    /**
+     * Finds the channel [address] names and hands it to [add] (which puts it into his
+     * settings and says whether it went in); the status says what came of it.
+     */
+    fun addChannel(address: String, add: (FoundChannel) -> Boolean) {
+        if (finding) return
+        finding = true
+        viewModelScope.launch {
+            val found = try {
+                findChannel(address, page)
+            } catch (e: Exception) {
+                null
+            }
+            feedStatus = when {
+                found == null -> CHANNEL_NOT_FOUND
+                add(found) -> "\"${found.name}\" is among her feeds now: she sees its new videos as headlines."
+                else -> "That channel could not be added: the list holds ${com.opendroid.ai.data.models.OwnLifeBounds.MAX_YOUTUBE_CHANNELS} at most."
+            }
+            finding = false
+        }
+    }
+
+    companion object {
+        /** What he is told about a model he chose for her eyes. */
+        fun eyesVerdictText(id: String, verdict: EyesModels.Verdict): String = when (verdict) {
+            is EyesModels.Verdict.Accepted ->
+                if (verdict.listed) {
