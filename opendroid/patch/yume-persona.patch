+/** Providers whose model id the user may type by hand (endpoint-specific and variant ids). */
+private val HAND_TYPED_MODEL_PROVIDERS = setOf("Custom OpenAI Compatible", "OpenRouter")
+
+/** What a refresh of the provider's model list does with the model that is selected. */
+internal enum class ModelAfterRefresh {
+    /** The list has it. */
+    KEEP,
+
+    /** The list does not have it. It stays selected and the owner is told. */
+    KEEP_UNLISTED,
+
+    /** The list does not have it and the provider's recommended model takes its place. */
+    REPLACE
+}
+
+/**
+ * Decides what happens to [model], the id selected for [provider], when the provider's
+ * list has been fetched and holds [listed].
+ *
+ * On a provider where the id is typed by hand nothing is ever selected for the owner.
+ * Hosted OpenAI-compatible endpoints accept ids their `/models` list never shows (options
+ * written into the id, routing variants, aliases), and they retire and rename ids. Putting
+ * the first listed model in the place of one that is missing silently changes which model
+ * answers: an uncensored one becomes whatever sorts first, an encrypted one becomes a
+ * plain one. So a missing id stays where it is, requests to it fail openly until he
+ * chooses, and a notice says so. That holds for the untouched seed id too.
+ *
+ * An id that starts with e2ee- is never replaced on any provider: whatever took its place
+ * would be sent the same words unencrypted.
+ *
+ * Every other provider keeps the stock behaviour: its list is the catalogue, and an id it
+ * does not serve is replaced.
+ */
+internal fun modelAfterRefresh(provider: String, model: String, listed: List<String>): ModelAfterRefresh {
+    if (model.isNotBlank() && model in listed) return ModelAfterRefresh.KEEP
+    val canonical = ProviderCatalog.canonicalName(provider)
+    val neverChosenForHim = canonical in HAND_TYPED_MODEL_PROVIDERS ||
+        model.trim().startsWith("e2ee-", ignoreCase = true)
+    return if (neverChosenForHim) ModelAfterRefresh.KEEP_UNLISTED else ModelAfterRefresh.REPLACE
+}
+
+/** The notice for a model that stays selected although the provider's list does not have it. */
+internal fun unlistedModelNotice(provider: String, model: String): String {
+    val canonical = ProviderCatalog.canonicalName(provider)
+    val untouched = model.isBlank() ||
+        (ProviderCatalog.isKnown(canonical) && model.trim() == ProviderCatalog.defaultModel(canonical))
+    return if (untouched) {
+        "No model is chosen for $provider yet. Type a model id or pick one from the list."
+    } else {
+        "\"$model\" is not in this provider's model list: it was typed by hand, or the provider no longer lists it. " +
+            "It is kept and nothing is chosen in its place. If requests fail, choose another model."
+    }
+}
+
+/** The provider that writes her replies under [config]: the one chosen for them, else the main one. */
+internal fun personaChatModelProviderFor(config: LLMConfig): String =
+    ProviderCatalog.canonicalName(config.personaChatProvider.trim().ifEmpty { config.activeProvider })
