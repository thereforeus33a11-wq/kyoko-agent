+            if (!provider.streamsLive) {
+                val response = provider.complete(request)
+                return Answer(response.content, FinishReason.isLength(response.finishReason))
+            }
+            val outcome = ReplyOutcome()
+            val text = StringBuilder()
+            provider.streamComplete(request.copy(outcome = outcome)).collect { text.append(it) }
+            return Answer(outcome.withoutReasoning ?: text.toString(), outcome.cutOff)
+        }
