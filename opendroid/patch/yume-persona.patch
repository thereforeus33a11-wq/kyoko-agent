+                PlanApprovalSummary.OutgoingText(1, "body", "Forty jars by Friday."),
+                PlanApprovalSummary.OutgoingText(1, "attachments", "/sdcard/Download/order.pdf"),
+                PlanApprovalSummary.OutgoingText(1, "cc", "sam@example.com"),
+                PlanApprovalSummary.OutgoingText(2, "items", "two pizzas"),
