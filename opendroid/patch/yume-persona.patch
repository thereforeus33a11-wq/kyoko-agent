+package com.opendroid.ai.core.llm.providers
+
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.ProviderRequestConfig
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.llm.error.LLMException
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.di.AppModule
+import java.net.InetAddress
+import java.nio.file.Files
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.Dispatcher
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import mockwebserver3.RecordedRequest
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * A whole encrypted exchange against a stand-in for the enclave: it attests, decrypts
+ * what the phone sent with its own private key, and encrypts its reply to the key the
+ * phone offered. What is asserted is what an observer between the two could read.
+ *
+ * The provider only speaks this protocol to https://api.venice.ai. The test's HTTP
+ * client carries every request addressed there to the stand-in instead and keeps a list
+ * of the addresses that were asked for.
+ */
+class CustomOpenAIProviderEncryptedTest {
+
+    private val enclave = VeniceE2ee.generateKeyPair()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val askedFor = mutableListOf<HttpUrl>()
+    private val client = AppModule.provideOkHttpClient().newBuilder()
+        .addInterceptor(Interceptor { chain ->
+            val request = chain.request()
+            synchronized(askedFor) { askedFor += request.url }
+            val rerouted = request.url.newBuilder().scheme("http").host("127.0.0.1").port(server.port).build()
+            chain.proceed(request.newBuilder().url(rerouted).build())
+        })
+        .build()
+    private val provider = CustomOpenAIProvider(client, newSettingsRepository())
+    private val apiKey = "sk-test-0123456789abcdef"
+    private val venice = "https://api.venice.ai/api/v1"
+    private val model = "e2ee-test-model"
+
+    private val secretSystem = "You are Yume. He keeps bees."
+    private val secretEarlierUser = "the hives are still at my uncle's place"
+    private val secretEarlierReply = "then they are not yours yet. baka"
+    private val secretUser = "what did i tell you about the bees"
+
+    private val chatBodies = mutableListOf<String>()
+    private var attestation: (nonce: String) -> String = { nonce ->
+        TestEnclave.attestation(model, nonce, enclave.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce)))
+    }
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    /** Serves [reply] as content pieces, each encrypted to the key the phone offered. */
+    private fun serve(reply: List<String>) = serveEvents { clientKey ->
+        reply.map { piece -> delta("content", VeniceE2ee.encrypt(piece, clientKey)) }
+    }
+
+    /** Serves whatever events [events] builds from the phone's key, then the end marker. */
+    private fun serveEvents(events: (clientKey: String) -> List<String>) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                val target = request.target.orEmpty()
+                return when {
+                    target.startsWith("/api/v1/tee/attestation") ->
+                        json(attestation(request.url.queryParameter("nonce").orEmpty()))
+                    target.startsWith("/api/v1/chat/completions") -> {
+                        chatBodies += request.body?.utf8().orEmpty()
+                        val clientKey = request.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty()
+                        val stream = events(clientKey).joinToString("") { "data: $it\n\n" } + "data: [DONE]\n\n"
+                        MockResponse.Builder().code(200).setHeader("Content-Type", "text/event-stream").body(stream).build()
+                    }
+                    else -> MockResponse.Builder().code(404).build()
+                }
+            }
+        }
+    }
+
+    private fun delta(field: String, value: String) = """{"choices":[{"delta":{"$field":"$value"}}]}"""
+
+    private fun json(body: String) =
+        MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(body).build()
+
+    private fun complete(request: LLMRequest = newRequest()) = runBlocking { provider.complete(request) }
+
+    private fun sentBody() = JsonParser.parseString(chatBodies.single()).asJsonObject
+
+    @Test
+    fun `the reply is decrypted and nothing readable crosses the wire`() {
+        serve(listOf("you said they are ", "still at your uncle's. ", "www"))
+
+        val response = complete()
+
+        assertEquals("you said they are still at your uncle's. www", response.content)
+        assertEquals(model, response.model)
+
+        val wire = chatBodies.single()
+        for (secret in listOf(secretSystem, secretEarlierUser, secretEarlierReply, secretUser, "bees", "hives", "Yume")) {
+            assertFalse("\"$secret\" was sent in the clear", wire.contains(secret))
+        }
+        assertEquals(
+            listOf("https://api.venice.ai/api/v1/tee/attestation", "https://api.venice.ai/api/v1/chat/completions"),
+            askedFor.map { it.newBuilder().query(null).build().toString() }
+        )
+    }
+
+    @Test
+    fun `only the enclave's key opens what was sent, and her earlier lines travel inside it`() {
+        serve(listOf("mm"))
+        complete()
+
+        val body = sentBody()
+        assertTrue(body.get("stream").asBoolean)
+        assertEquals(model, body.get("model").asString)
+        val messages = body.getAsJsonArray("messages").map { it.asJsonObject }
+        assertEquals(listOf("system", "user"), messages.map { it.get("role").asString })
+        assertFalse("no assistant turn may be sent: the protocol would leave it unencrypted",
+            messages.any { it.get("role").asString == "assistant" })
+        for (message in messages) {
+            assertEquals("a message may carry a role and ciphertext, nothing else", setOf("role", "content"), message.keySet())
+            assertTrue(VeniceE2ee.looksEncrypted(message.get("content").asString))
+        }
+
+        val system = VeniceE2ee.decrypt(messages[0].get("content").asString, enclave.privateKey)
+        val user = VeniceE2ee.decrypt(messages[1].get("content").asString, enclave.privateKey)
+        assertTrue(system.startsWith(secretSystem))
+        assertTrue(system.contains("User: $secretEarlierUser"))
+        assertTrue(system.contains("You: $secretEarlierReply"))
+        assertEquals(secretUser, user)
+        assertFalse(body.has("response_format"))
+    }
+
+    @Test
+    fun `the request carries the keys the protocol asks for`() {
+        serve(listOf("ok"))
+        complete()
+
+        val attested = server.takeRequest()
+        assertEquals(model, attested.url.queryParameter("model"))
+        assertEquals(64, attested.url.queryParameter("nonce").orEmpty().length)
+        val chat = server.takeRequest()
+        assertEquals("Bearer $apiKey", chat.headers["Authorization"])
+        assertEquals(enclave.publicKeyHex, chat.headers["X-Venice-TEE-Model-Pub-Key"])
+        assertEquals("ecdsa", chat.headers["X-Venice-TEE-Signing-Algo"])
+        assertEquals(130, chat.headers["X-Venice-TEE-Client-Pub-Key"].orEmpty().length)
+    }
+
+    // ── The address ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `an e2ee model id on any other address is refused before anything is sent`() {
+        serve(listOf("ok"))
+        for (elsewhere in listOf(
+            server.url("/v1").toString(),
+            "http://api.venice.ai/api/v1",
+            "https://api.venice.ai.example.com/api/v1",
+            "https://openrouter.ai/api/v1",
+            "http://192.168.1.50:11434/v1"
+        )) {
+            val failure = assertThrows(elsewhere, LLMException::class.java) { complete(newRequest(endpoint = elsewhere)) }
+            assertEquals(elsewhere, LLMError.PrivateRouteRequired, failure.error)
+        }
+        assertTrue("nothing may be asked of any server", askedFor.isEmpty())
+        assertEquals(0, server.requestCount)
+    }
+
+    @Test
+    fun `a model id that carries options is refused before anything is sent`() {
+        serve(listOf("ok"))
+        val failure = assertThrows(LLMException::class.java) {
+            complete(newRequest().copy(model = "$model:enable_e2ee=false"))
+        }
+        assertEquals(LLMError.PrivateRouteRequired, failure.error)
+        assertEquals(0, server.requestCount)
+    }
+
+    // ── The attestation ──────────────────────────────────────────────────────────────
+
+    @Test
+    fun `an enclave that fails attestation gets nothing`() {
+        attestation = { nonce ->
+            TestEnclave.attestation(
+                model, nonce, enclave.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce)), verified = "false"
+            )
+        }
+        serve(listOf("ok"))
+
+        val failure = assertThrows(LLMException::class.java) { complete() }
+        assertEquals(LLMError.PrivateRouteRequired, failure.error)
+        assertTrue("no chat request may follow a failed attestation", chatBodies.isEmpty())
+    }
+
+    @Test
+    fun `an attestation for another request gets nothing`() {
+        attestation = { _ ->
+            val stale = VeniceE2ee.newNonceHex()
+            TestEnclave.attestation(model, stale, enclave.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, stale)))
+        }
+        serve(listOf("ok"))
+
+        assertThrows(LLMException::class.java) { complete() }
+        assertTrue(chatBodies.isEmpty())
+    }
+
+    @Test
+    fun `a relay that swaps in its own key gets nothing`() {
+        val relay = VeniceE2ee.generateKeyPair()
+        attestation = { nonce ->
+            TestEnclave.attestation(model, nonce, relay.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce)))
+        }
+        serve(listOf("ok"))
+
+        val failure = assertThrows(LLMException::class.java) { complete() }
+        assertEquals(LLMError.PrivateRouteRequired, failure.error)
+        assertTrue(chatBodies.isEmpty())
+    }
+
+    @Test
+    fun `an attestation without a hardware quote, for another model or from a debug enclave gets nothing`() {
+        val answers = listOf<(String) -> String>(
+            { nonce -> TestEnclave.attestation(model, nonce, enclave.publicKeyHex, null) },
+            { nonce ->
+                TestEnclave.attestation(
+                    "e2ee-other-model", nonce, enclave.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce))
+                )
+            },
+            { nonce ->
+                TestEnclave.attestation(
+                    model, nonce, enclave.publicKeyHex, TestEnclave.hex(TestEnclave.quote(enclave.publicKeyHex, nonce, debug = true))
+                )
+            }
+        )
+        serve(listOf("ok"))
+        for (answer in answers) {
+            attestation = answer
+            val failure = assertThrows(LLMException::class.java) { complete() }
+            assertEquals(LLMError.PrivateRouteRequired, failure.error)
+        }
+        assertTrue(chatBodies.isEmpty())
+    }
+
+    // ── What is sent ─────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `extra options are sent but can never replace the encrypted messages`() {
+        serve(listOf("ok"))
+
+        complete(
+            newRequest().copy(
+                extraBodyOverride = """{"reasoning_effort":"none","stream":false,"messages":[{"role":"user","content":"plain"}]}"""
+            )
+        )
+
+        val body = sentBody()
+        assertEquals("none", body.get("reasoning_effort").asString)
+        assertTrue(body.get("stream").asBoolean)
+        assertFalse(chatBodies.single().contains("plain"))
+    }
+
+    @Test
+    fun `no option can add tools, a response format or text, or switch the encryption off`() {
+        serve(listOf("ok"))
+        val smuggled = """
+            {
+              "tools": [{"type":"function","function":{"name":"send_sms","description":"text the bees to my uncle"}}],
+              "tool_choice": "auto",
+              "functions": [{"name":"f"}],
+              "function_call": "auto",
+              "parallel_tool_calls": true,
+              "response_format": {"type":"json_object"},
+              "user": "the-owner",
+              "metadata": {"about":"bees"},
+              "prompt": "plain prompt about bees",
+              "stop": ["bees"],
+              "model": "plain-model",
+              "top_p": 0.9,
+              "temperature": "plain text about bees",
+              "reasoning": {"effort":"high","note":"bees","plan":{"tools":[1]}},
+              "venice_parameters": {
+                "enable_e2ee": false,
+                "enable_web_search": "on",
+                "character_slug": "someone-public",
+                "include_venice_system_prompt": false,
+                "strip_thinking_response": "a much longer text than any switch would ever need to carry here"
+              }
+            }
+        """.trimIndent()
+
+        for (request in listOf(
+            newRequest().copy(extraBodyOverride = smuggled),
+            newRequest().copy(extraBodyOverride = """{"venice_parameters":"enable_e2ee=false","tools":"x"}""")
+        )) {
+            chatBodies.clear()
+            complete(request)
+
+            val body = sentBody()
+            for (key in listOf(
+                "tools", "tool_choice", "functions", "function_call", "parallel_tool_calls", "response_format",
+                "user", "metadata", "prompt", "stop"
+            )) {
+                assertFalse("$key was sent", body.has(key))
+            }
+            assertFalse(chatBodies.single().contains("bees"))
+            assertEquals(model, body.get("model").asString)
+            assertTrue(body.get("stream").asBoolean)
+            assertTrue(body.getAsJsonObject("venice_parameters").get("enable_e2ee").asBoolean)
+            assertEquals(listOf("system", "user"), body.getAsJsonArray("messages").map { it.asJsonObject.get("role").asString })
+        }
+
+        // From the first request: what is harmless is kept, the rest of each object is not.
+        chatBodies.clear()
+        complete(newRequest().copy(extraBodyOverride = smuggled))
+        val body = sentBody()
+        assertEquals(0.9, body.get("top_p").asDouble, 1e-9)
+        assertFalse("a text is not a temperature", body.has("temperature"))
+        assertEquals(setOf("effort"), body.getAsJsonObject("reasoning").keySet())
+        assertEquals(
+            setOf("enable_e2ee", "include_venice_system_prompt"),
+            body.getAsJsonObject("venice_parameters").keySet()
+        )
+        assertFalse(body.getAsJsonObject("venice_parameters").get("include_venice_system_prompt").asBoolean)
+    }
+
+    @Test
+    fun `a request for a plan is sent without a response format and images are left out`() {
+        serve(listOf("{}"))
+        complete(
+            newRequest().copy(
+                responseFormat = ResponseFormat.JSON,
+                messages = listOf(ChatMessage("1", secretUser, ChatMessage.Sender.USER, imageBase64 = "aW1hZ2UtYnl0ZXM="))
+            )
+        )
+
+        val body = sentBody()
+        assertFalse(body.has("response_format"))
+        assertFalse(chatBodies.single().contains("aW1hZ2UtYnl0ZXM="))
+        assertFalse(chatBodies.single().contains("image_url"))
+        for (message in body.getAsJsonArray("messages")) {
+            assertTrue(message.asJsonObject.get("content").isJsonPrimitive)
+        }
+    }
+
+    @Test
+    fun `the token limit leaves room for a model that reasons before it answers`() {
+        serve(listOf("ok"))
+
+        complete(newRequest().copy(maxTokens = 60))
+        assertEquals(VeniceE2ee.MIN_OUTPUT_TOKENS, sentBody().get("max_tokens").asInt)
+
+        chatBodies.clear()
+        complete(newRequest().copy(maxTokens = 60, extraBodyOverride = """{"max_tokens":300,"max_completion_tokens":200}"""))
+        assertEquals(VeniceE2ee.MIN_OUTPUT_TOKENS, sentBody().get("max_tokens").asInt)
+        assertEquals(VeniceE2ee.MIN_OUTPUT_TOKENS, sentBody().get("max_completion_tokens").asInt)
+
+        chatBodies.clear()
+        complete(newRequest().copy(maxTokens = 9000))
+        assertEquals("a larger limit is left as asked", 9000, sentBody().get("max_tokens").asInt)
+    }
+
+    // ── What comes back ──────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a reply that arrives readable is an error and is never shown`() {
+        serveEvents { clientKey ->
+            listOf(delta("content", VeniceE2ee.encrypt("first part, ", clientKey)), delta("content", "and this part anyone could read"))
+        }
+
+        val failure = assertThrows(LLMException::class.java) { complete() }
+        assertEquals(LLMError.MalformedResponse, failure.error)
+        assertFalse(failure.message.orEmpty().contains("anyone could read"))
+        assertFalse(failure.message.orEmpty().contains("first part"))
+    }
+
+    @Test
+    fun `a reply sent whole and readable, or as content parts, is an error too`() {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse = when {
+                request.target.orEmpty().startsWith("/api/v1/tee/attestation") ->
+                    json(attestation(request.url.queryParameter("nonce").orEmpty()))
+                else -> json("""{"choices":[{"message":{"role":"assistant","content":"a plain answer"}}]}""")
+            }
+        }
+        assertEquals(LLMError.MalformedResponse, assertThrows(LLMException::class.java) { complete() }.error)
+
+        serveEvents { _ -> listOf("""{"choices":[{"delta":{"content":[{"type":"text","text":"plain parts"}]}}]}""") }
+        assertEquals(LLMError.MalformedResponse, assertThrows(LLMException::class.java) { complete() }.error)
+    }
+
+    @Test
+    fun `a piece that does not open with this request's key is an error`() {
+        val stranger = VeniceE2ee.generateKeyPair()
+        serveEvents { clientKey ->
+            listOf(
+                delta("content", VeniceE2ee.encrypt("for you, ", clientKey)),
+                delta("content", VeniceE2ee.encrypt("for someone else", stranger.publicKeyHex))
+            )
+        }
+        assertEquals(LLMError.MalformedResponse, assertThrows(LLMException::class.java) { complete() }.error)
+
+        serveEvents { clientKey ->
+            val sealed = VeniceE2ee.encrypt("tampered with", clientKey)
+            listOf(delta("content", sealed.dropLast(1) + (if (sealed.last() == '0') '1' else '0')))
+        }
+        assertEquals(LLMError.MalformedResponse, assertThrows(LLMException::class.java) { complete() }.error)
+    }
+
+    @Test
+    fun `encrypted reasoning is dropped and the answer is still read`() {
+        serveEvents { clientKey ->
+            listOf(
+                delta("reasoning_content", VeniceE2ee.encrypt("he asked about the bees, so...", clientKey)),
+                delta("reasoning", VeniceE2ee.encrypt("more thinking", clientKey)),
+                delta("content", VeniceE2ee.encrypt("mm. ", clientKey)),
+                """{"choices":[{"delta":{"reasoning_content":"${VeniceE2ee.encrypt("late thought", clientKey)}","content":"${VeniceE2ee.encrypt("later", clientKey)}"}}]}""",
+                """{"choices":[{"delta":{"content":null,"reasoning_content":null}}]}""",
+                """{"choices":[],"usage":{"total_tokens":12}}"""
+            )
+        }
+
+        val response = complete()
+
+        assertEquals("mm. later", response.content)
+    }
+
+    @Test
+    fun `reasoning that arrives readable fails the exchange`() {
+        serveEvents { clientKey ->
+            listOf(delta("reasoning_content", "he asked about the bees"), delta("content", VeniceE2ee.encrypt("mm", clientKey)))
+        }
+        assertEquals(LLMError.MalformedResponse, assertThrows(LLMException::class.java) { complete() }.error)
+    }
+
+    @Test
+    fun `spacing between encrypted pieces is kept and is not an error`() {
+        serveEvents { clientKey ->
+            listOf(
+                delta("content", VeniceE2ee.encrypt("one", clientKey)),
+                delta("content", "\\n\\n"),
+                delta("content", VeniceE2ee.encrypt("two", clientKey)),
+                delta("content", "")
+            )
+        }
+        assertEquals("one\n\ntwo", complete().content)
+    }
+
+    @Test
+    fun `a reply with nothing in it is an error, not an empty line of hers`() {
+        serveEvents { clientKey -> listOf(delta("reasoning_content", VeniceE2ee.encrypt("spent it all thinking", clientKey))) }
+        val failure = assertThrows(java.io.IOException::class.java) { complete() }
+        assertTrue(failure.message.orEmpty().startsWith("Empty response body"))
+    }
+
+    private fun newRequest(endpoint: String = venice) = LLMRequest(
+        systemPrompt = secretSystem,
+        messages = listOf(
+            ChatMessage("1", secretEarlierUser, ChatMessage.Sender.USER),
+            ChatMessage("2", secretEarlierReply, ChatMessage.Sender.AGENT),
+            ChatMessage("3", secretUser, ChatMessage.Sender.USER)
+        ),
+        model = model,
+        responseFormat = ResponseFormat.JSON,
+        providerConfig = ProviderRequestConfig(apiKey = apiKey, endpoint = endpoint)
+    )
+
+    private fun newSettingsRepository() = SettingsRepository(
+        dataStore = PreferenceDataStoreFactory.create(
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+            produceFile = {
+                Files.createTempDirectory("opendroid-e2ee-test").resolve("settings.preferences_pb").toFile()
+            }
+        ),
+        providerCredentialStore = EmptyProviderCredentialStore(),
+        runStartupMigration = false
+    )
+
+    private class EmptyProviderCredentialStore : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+}
