+                if (ProviderCatalog.isKnown(provider)) config.selectedModelFor(provider) else ""
+            }
+            return com.opendroid.ai.core.llm.VenicePrivateTier.caps(model, config)?.maxImages?.takeIf { it > 0 } ?: Int.MAX_VALUE
