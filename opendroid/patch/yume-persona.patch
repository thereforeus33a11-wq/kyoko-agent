+package com.opendroid.ai.di
+
+import android.content.Context
+import android.util.Log
+import com.opendroid.ai.core.persona.OwnTimeAlarm
+import com.opendroid.ai.core.service.OwnTimeWorker
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.android.qualifiers.ApplicationContext
+import dagger.hilt.components.SingletonComponent
+import javax.inject.Singleton
+
+/**
+ * Hands the persona the one thing it cannot do itself: wake the phone at the time she
+ * named for her next moment. The alarm is scheduled work ([OwnTimeWorker]).
+ */
+@Module
+@InstallIn(SingletonComponent::class)
+object OwnTimeModule {
+
+    @Provides
+    @Singleton
+    fun provideOwnTimeAlarm(@ApplicationContext context: Context): OwnTimeAlarm = OwnTimeAlarm { atMillis ->
+        try {
+            OwnTimeWorker.arm(context, atMillis)
+        } catch (e: Exception) {
+            // The stored time is still the truth: the alarm is set from it again when the service next starts.
+            Log.w("OwnTimeModule", "The alarm for her next moment was not set: ${e.javaClass.simpleName}")
+        }
+    }
+}
