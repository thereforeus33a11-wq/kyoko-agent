+    // ── Races ────────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `woken while her pass runs, what she wrote is kept and the alarm he set is left as it is`() {
+        runBlocking { memory.apply(listOf(Note(Kind.ME, "hair", "i dyed my hair black"))) }
+        save(asleep())
+        val woke = now + 25 * minute
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                runBlocking { engine.ownTimeAfterReply(nowMillis = woke, zone = utc) }
+                return response("me | hair | back to red")
+            }
+        }
+
+        assertNull(moment(at = now + 20 * minute))
+
+        assertEquals("back to red", notes().getValue("hair").text)
+        val after = state()
+        assertEquals(0L, after.asleepSince)
+        assertEquals(PersonaSleep.WokeBy.HIM, after.wokeBy)
+        assertEquals(Wake.At(woke + PersonaOwnTime.defaultGapMillis(0, bounds)), after.wake)
+        assertTrue(after.lastRepair!!.ok)
+        assertFalse(after.repairOwed)
+    }
+
+    @Test
+    fun `a reply that puts her to sleep while a moment of hers is being written keeps its sleep, its time and what she is told of it`() {
+        save(State(on = true, wake = Wake.At(now - 1_000), why = Why.ASKED))
+        val replied = now + minute
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                // His message came while she wrote, and her reply to it had << sleep: 20h.
+                runBlocking { engine.ownTimeAfterReply(nowMillis = replied, sleep = Ask.For(20 * hour), zone = utc) }
+                return response("next: 20m")
+            }
+        }
+
+        assertNotNull(moment(at = now))
+
+        val lying = state()
+        assertEquals(replied, lying.asleepSince)
+        assertEquals(replied + 16 * hour, lying.sleepUntil)
+        assertEquals(PersonaSleep.SleepMoved.LONG, lying.sleepMoved)
+        assertEquals(replied + 20 * minute, lying.repairDueAt)
+        // The alarm is for her sleep, not for the next: of the moment that was being written.
+        assertEquals(Wake.At(replied + 20 * minute), lying.wake)
+        assertEquals(replied + 20 * minute, alarms.last())
+        // The moment counts all the same.
+        assertEquals(now, lying.lastAtMillis)
+        assertTrue(now in lying.moments)
+        assertTrue(runBlocking { engine.isAsleepNow() })
+
+        // Whatever leaves another time in the alarm while she sleeps, setting it puts her sleep's own time back.
+        save(lying.copy(wake = Wake.WhenHeWrites))
+        runBlocking { engine.armOwnTime(nowMillis = now + 2 * minute) { true } }
+        assertEquals(Wake.At(replied + 20 * minute), state().wake)
+        assertEquals(replied + 20 * minute, alarms.last())
+        // And a ring for a time that is not hers settles it the same way, with no request.
+        save(lying.copy(wake = Wake.At(now + 5 * minute)))
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse = response("NONE")
+        }
+        val asked = server.requestCount
+        assertNull(moment(at = now + 5 * minute))
+        assertEquals(asked, server.requestCount)
+        assertEquals(Wake.At(replied + 20 * minute), state().wake)
+    }
+
+    @Test
+    fun `woken while her pass runs and lying down again in that reply, she does not have the same pass twice`() {
+        runBlocking { memory.apply(listOf(Note(Kind.ME, "hair", "i dyed my hair black"))) }
+        save(asleep())
+        val woke = now + 25 * minute
+        var replied = false
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                if (!replied) {
+                    replied = true
+                    runBlocking { engine.ownTimeAfterReply(nowMillis = woke, sleep = Ask.For(6 * hour), zone = utc) }
+                }
+                return response("me | hair | back to red")
+            }
+        }
+
+        assertNull(moment(at = now + 20 * minute))
+
+        assertEquals(1, server.requestCount)
+        assertEquals("back to red", notes().getValue("hair").text)
+        val after = state()
+        assertEquals(woke, after.asleepSince)
+        assertEquals(0L, after.repairDueAt)
+        assertEquals(Wake.At(woke + 6 * hour), after.wake)
+        assertTrue(after.lastRepair!!.ok)
+        assertFalse(after.repairOwed)
+        // Twenty minutes into the new sleep nothing is due, and nothing is asked.
+        assertNull(moment(at = woke + 20 * minute))
+        assertEquals(1, server.requestCount)
+    }
+
+    @Test
+    fun `a ring that comes past the time she meant to wake is her waking, and the pass it missed is owed`() {
+        save(asleep())
+        answer("morning")
+
+        assertNotNull(moment(at = now + 8 * hour))
+
+        assertEquals(1, server.requestCount)
+        val woke = messages(server.takeRequest(5, TimeUnit.SECONDS))[0].second
+        assertTrue(woke.contains(PersonaOwnTime.HEADING))
+        assertFalse(woke.endsWith(PersonaSleepPass.SLEEP_SYSTEM_PROMPT))
+        assertEquals(0L, state().asleepSince)
+        assertTrue(state().repairOwed)
+        assertEquals(0, state().repairMissed)
+    }
+
+    @Test
+    fun `a notebook he empties while she sleeps is not written into`() {
+        runBlocking { memory.apply(listOf(Note(Kind.ME, "hair", "i dyed my hair black"))) }
+        save(asleep())
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                runBlocking { memory.empty() }
+                return response("me | hair | back to red\nfeel | restless\ni dreamt of the ferry")
+            }
+        }
+
+        assertNull(moment(at = now + 20 * minute))
+
+        assertTrue(notes().isEmpty())
+        assertTrue(runBlocking { memory.mood() }.isEmpty())
+        assertTrue(kept().none { it.text.contains("ferry") })
+        assertFalse(state().lastRepair!!.ok)
+        assertTrue(state().repairOwed)
+    }
+
+    @Test
+    fun `when the day has no room left she wakes without a word, and her waking moment later says how long ago that was`() {
+        configure { ownNetwork(it).copy(personaOwnTimeMaxPerDay = 1) }
+        save(asleep().copy(repairDueAt = 0, wake = Wake.At(now + 7 * hour)))
+
+        assertNull(moment(at = now + 7 * hour))
+
+        assertEquals(0, server.requestCount)
+        val woke = state()
+        assertEquals(0L, woke.asleepSince)
+        assertEquals(Why.WOKE, woke.why)
+        assertEquals(Wake.At(now + 24 * hour), woke.wake)
+        assertEquals(PersonaOwnTime.Moved.DAY_USED_UP, woke.moved)
+        answer(".")
+        assertNotNull(moment(at = now + 24 * hour))
+        val block = messages(server.takeRequest())[0].second.substringAfter(PersonaOwnTime.HEADING)
+        assertTrue(block, block.contains("you woke up on your own 17 h ago, after 7 h of sleep (you meant 7 h)."))
+    }
+
+    @Test
+    fun `with her own time switched off she is awake, and switched on again she is not asleep`() {
+        save(asleep())
+        configure { ownNetwork(it).copy(personaCheckInsEnabled = false) }
+        runBlocking { engine.armOwnTime(nowMillis = now + hour) { true } }
+        val off = state()
+        assertFalse(off.on)
+        assertEquals(0L, off.asleepSince)
+        assertEquals(0L, off.repairDueAt)
+        assertTrue(off.repairOwed)
+        assertNull(alarms.last())
+
+        configure { ownNetwork(it) }
+        runBlocking { engine.armOwnTime(nowMillis = now + 2 * hour) { true } }
+        assertEquals(0L, state().asleepSince)
+        assertEquals(Wake.At(now + 2 * hour + 20 * minute), state().wake)
+        assertTrue(state().repairOwed)
+    }
+
+    // ── Her route ────────────────────────────────────────────────────────────────────
+
+    /** A model at a public address, whose host can read what it is sent, answered by a server of this test. */
+    private fun withHostedModel(policy: RoutePolicy, test: (MockWebServer) -> Unit) {
+        val name = "models.example.com"
+        val certificate = HeldCertificate.Builder().addSubjectAlternativeName(name).build()
+        val hosted = MockWebServer().also {
+            it.useHttps(HandshakeCertificates.Builder().heldCertificate(certificate).build().sslSocketFactory())
+            it.start(InetAddress.getByName("127.0.0.1"), 0)
+        }
+        try {
+            val trusting = HandshakeCertificates.Builder().addTrustedCertificate(certificate.certificate).build()
+            engine = engine(
+                client = AppModule.provideOkHttpClient().newBuilder()
+                    .dns(Dns { listOf(InetAddress.getByName("127.0.0.1")) })
+                    .proxy(java.net.Proxy.NO_PROXY)
+                    .sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager)
+                    .build()
+            )
+            configure { ownNetwork(it).copy(routePolicy = policy, privateMode = true, customEndpoints = mapOf(custom to "https://$name:${hosted.port}/v1")) }
+            assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(config()))
+            test(hosted)
+        } finally {
+            hosted.close()
+        }
+    }
+
+    @Test
+    fun `on a route a host could read her sleep is sent nothing that can be about him, not even his name`() = withHostedModel(RoutePolicy.ANY) { hosted ->
+        runBlocking {
+            memory.apply(
+                listOf(
+                    Note(Kind.USER, "bees", "he keeps bees"),
+                    Note(Kind.OPINION, "boss", "his boss is using him"),
+                    Note(Kind.ME, "sam", "sam snores"),
+                    Note(Kind.ME, "arcade", "the old arcade closed"),
+                    Note(Kind.ME, "soda", "melon soda is mine")
+                )
+            )
+            memory.fade(listOf("yume.opinion.boss", "yume.me.arcade"))
+            thoughts.keep("he keeps bees. i like that and will not say it", atMillis = now - hour)
+            memory.updateMood {
+                listOf(
+                    PersonaMood.Feeling("pissed at him", PersonaMood.STRONG, now, PersonaMood.Speed.HOURS),
+                    PersonaMood.Feeling("restless", PersonaMood.SOME, now, PersonaMood.Speed.DAYS)
+                )
+            }
+        }
+        save(asleep())
+        answer("me | soda | melon soda is still mine\nme | bees | he keeps bees", from = hosted)
+
+        assertNull(moment(at = now + 20 * minute))
+
+        assertEquals(0, server.requestCount)
+        val page = messages(hosted.takeRequest(10, TimeUnit.SECONDS))[1].second
+        assertTrue(page, page.contains("me | soda | melon soda is mine"))
+        assertTrue(page, page.contains("- restless: some"))
+        assertTrue(page, page.contains("- me | arcade | the old arcade closed (let go "))
+        assertTrue(page, page.contains(PersonaPrompts.NOTES_NOT_SHOWN))
+        for (detail in listOf("bees", "boss", "snores", "pissed", "will not say", "YOUR THOUGHTS")) {
+            assertFalse(detail, page.contains(detail))
+        }
+        assertFalse(page, Regex("""\bsam\b""", RegexOption.IGNORE_CASE).containsMatchIn(page))
+        // What she writes is kept on the phone, and a note under a key she was not shown goes beside it.
+        assertEquals("melon soda is still mine", notes().getValue("soda").text)
+        assertEquals("he keeps bees", notes().getValue("bees").text)
+    }
+
+    @Test
+    fun `where his settings allow only his own hardware nothing reaches a hosted model, and the pass stays owed after three tries`() =
+        withHostedModel(RoutePolicy.OWN_HARDWARE) { hosted ->
+            save(asleep())
+
+            for (at in listOf(now + 20 * minute, now + 35 * minute, now + 65 * minute)) {
+                assertEquals(Wake.At(at), state().wake)
+                assertNull(moment(at = at))
+            }
+
+            assertEquals(0, hosted.requestCount)
+            assertEquals(0, server.requestCount)
+            val owed = state()
+            assertTrue(owed.repairOwed)
+            assertEquals(0L, owed.repairDueAt)
+            assertEquals(3, owed.repairTries)
+            assertFalse(owed.lastRepair!!.ok)
+            assertEquals(Wake.At(now + 7 * hour), owed.wake)
+            assertNull(moment(at = now + 2 * hour))
+            // Her next sleep owes it, however short it is.
+            val next = PersonaSleep.lieDown(PersonaSleep.wokeOnOwn(owed, now + 7 * hour), Ask.For(hour), "1h", now + 8 * hour, utc, bounds, 0)
+            assertEquals(now + 8 * hour + 20 * minute, next.repairDueAt)
+        }
+
+    // ── How she feels ────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a feel line of her notebook pass is kept as how she feels, shows in her next prompt and fades by itself`() {
+        val rows = listOf(
+            he("the second hive is up", 1_000), she("finally", 1_010),
+            he("i still say melon soda is too sweet", 2_000), she("it is mine and i do not share", 2_010),
+            he("fine", 3_000), she("mm", 3_010)
+        )
+        answer("me | soda | melon soda is mine\nfeel | pissed at him | strong | hours")
+
+        assertTrue(runBlocking { engine.reflect(rows) })
+
+        assertEquals(listOf(PersonaMood.Feeling("pissed at him", PersonaMood.STRONG, now, PersonaMood.Speed.HOURS)), runBlocking { memory.mood() })
+        assertTrue(runBlocking { memory.notTaken() }.isEmpty())
+        assertEquals(setOf("soda"), notes().keys)
+        val pass = messages(server.takeRequest())
+        assertTrue(pass[0].second.contains("- feel: besides your notes you can write up to 3 lines about how you feel now"))
+        val prompt = chatPrompt(now + 10 * minute)
+        assertTrue(prompt, prompt.contains(PersonaMood.HEADING + "\n- pissed at him: strong 10 min ago, strong now (fades within hours)\n" + PersonaMood.WHERE_SET))
+        // After her notes and before the app's lines.
+        assertTrue(prompt.indexOf("=== YOUR OWN NOTES") < prompt.indexOf(PersonaMood.HEADING))
+        assertTrue(prompt.indexOf(PersonaMood.HEADING) < prompt.indexOf("=== WHAT THE APP WROTE IN THIS CHAT LATELY"))
+        // Her next notebook pass is told how she feels.
+        answer("NONE")
+        assertTrue(runBlocking { engine.reflect(rows.map { it.copy(id = it.id + "-2") }) })
+        assertTrue(messages(server.takeRequest())[1].second.contains("HOW YOU FEEL NOW (from your own feel lines; each fades at its own pace unless you feel it again):\n- pissed at him: strong just now, strong now (fades within hours)"))
+        // Thirteen hours on it has faded away.
+        assertFalse(chatPrompt(now + 13 * hour).contains(PersonaMood.HEADING))
+    }
+
+    @Test
+    fun `a feel line in a moment of her own is kept, past the few it takes a thought`() {
+        save(State(on = true, wake = Wake.At(now - 1_000), why = Why.ASKED))
+        answer("feel: smug | strong | days\nfeel: restless\nfeel: bored\nfeel: odd")
+        assertNotNull(moment(at = now))
+        assertEquals(setOf("smug", "restless", "bored"), runBlocking { memory.mood() }.map { it.words }.toSet())
+        assertEquals("feel: odd", kept().last().text)
+    }
+}
