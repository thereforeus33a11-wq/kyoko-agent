+    /** Everything the block about a moment of hers is written from. All of it is read off the settings and what is stored. */
+    data class MomentFacts(
+        val why: Why,
+        val actionsEnabled: Boolean,
+        val rein: PersonaRein,
+        val notificationShowsWords: Boolean,
+        val bounds: Bounds,
+        /** Which of the day's moments this one is, counted from one. */
+        val number: Int,
+        val hisClock: String,
+        val tokyoClock: String,
+        /**
+         * How long ago he last wrote in this chat, or null when he has not. Said only where
+         * his details are not held back ([thoughtsLeftOut] false).
+         */
+        val heLastWrote: String?,
+        /** How long ago her last moment was, with what she did with it; null when this is her first. */
+        val lastMoment: String?,
+        val lastDid: Did?,
+        val lastHadCommand: Boolean,
+        val moved: Moved?,
+        val movedAsked: String,
+        /** The last gap she chose herself, 0 when she has chosen none. The usual gap is worked out from it. */
+        val lastGapMillis: Long = 0,
+        /** A plan she started in an earlier moment still waits in the chat for his yes. */
+        val ownPlanWaits: Boolean = false,
+        /**
+         * His details are held back on this route because a host could read the text
+         * ([com.opendroid.ai.core.llm.holdsBackDetails]), and her thoughts with them.
+         */
+        val thoughtsLeftOut: Boolean,
+        /** This text goes through a hosted service that can read what it is sent. */
+        val hostCanRead: Boolean,
+        /** Her sleep: how long she has been awake, or what her waking came from and what her sleep pass came to. */
+        val sleep: PersonaSleep.MomentSleepFacts? = null,
+        /** The keys of her threads that are still going on, as her page shows them ([openThreads]). */
+        val openThreads: List<String> = emptyList(),
+        /** A picture of herself can be made from here ([PICTURE_LINE]). */
+        val makesPictures: Boolean = false,
+        /** For a moment an unlock brought forward ([Why.UNLOCKED]): the reason the time it replaced had. */
+        val broughtFrom: Why? = null,
+        /** Her own life, while it is on ([Life]); null while it is off. */
+        val life: Life? = null
+    )
+
+    private fun because(
+        why: Why,
+        sleep: PersonaSleep.MomentSleepFacts?,
+        heldBack: Boolean,
+        broughtFrom: Why? = null,
+        cameBackFrom: String? = null
+    ): String = sleep?.because(why) ?: when (why) {
+        Why.FIRST -> "the app woke you because your own time was switched on: this is the first moment since then."
+        Why.ASKED -> "the app woke you because this is when you asked to be woken."
+        Why.AFTER_HE_WROTE ->
+            "you had asked to be woken when he writes. he wrote, you were awake for your answer, and this moment " +
+                "came after that at the usual gap."
+        Why.DEFAULT -> "you named no time for this one, so the app woke you after the usual gap."
+        Why.WOKE -> "you woke up on your own from a sleep: this moment is your waking."
+        Why.WOKEN -> "his message woke you from a sleep; this moment came the usual gap after it."
+        // That he picked the phone up is about him: where his details are held back it is not said.
+        Why.UNLOCKED -> {
+            // Only a time she asked for is one she named; any other was set by the app.
+            val replaced = if (broughtFrom == Why.ASKED) "the time you named" else "the time set for it"
+            if (heldBack) {
+                "the app woke you sooner than $replaced."
+            } else {
+                "the app woke you sooner than $replaced: he unlocked his phone after " +
+                    "${span(UNLOCK_QUIET_MILLIS)} or more without writing to you."
+            }
+        }
+        Why.CAME_BACK -> {
+            val replaced = if (broughtFrom == Why.ASKED) "the time you named" else "the time set for it"
+            if (cameBackFrom.isNullOrBlank()) {
+                "the app woke you sooner than $replaced: you came back from an outing of yours."
+            } else {
+                "the app woke you sooner than $replaced: you came back from ${quoted(cameBackFrom)}."
+            }
+        }
+    }
