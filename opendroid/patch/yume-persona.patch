+    @Test
+    fun `what she wrote is put away by kind, and only her line and her command are handed back`() {
+        val after = ownMoment.substringAfter("val moment = PersonaOwnTime.parse(")
+        // Read as a moment's reply, with what of her own life can run (null while it is off), and
+        // with the kept-line check where she comes back from meeting a kid on an outing or a look (§1.4).
+        assertTrue(after.startsWith("answer.text, cutOff = answer.cutOff, life = life?.runnable, kid = metKid)"))
