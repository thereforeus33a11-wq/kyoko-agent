+        assertFalse(did.looked)
+        assertTrue(sources.images.isEmpty())
+        assertTrue(eyes.described.isEmpty())
+        assertEquals(6, space.looksLeft)
+        assertTrue(OutingPrompt.inFront(space.view).contains("[3] kid · Yahoo · skipped by the app (中2)"))
+    }
+
+    @Test
+    fun `a page marked a kid's is not looked at, and a page picture that shows a child marks the page and is shown as kid without its words`() = runBlocking {
+        sources.page = """<html><head><title>Hana, 中2 model</title><meta property="og:image" content="https://site.example/hana.jpg"></head><body><p>text</p></body></html>"""
+        val kidPage = space()
+        kidPage.begin(OutingKind.Parsed.Read("https://site.example/hana", "https://site.example/hana"))
