+++ b/app/src/test/java/com/opendroid/ai/core/life/reading/VeniceSearchTest.kt
@@ -0,0 +1,186 @@
+package com.opendroid.ai.core.life.reading
+
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutgoingGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingPrompt
+import com.opendroid.ai.core.life.OutingStep
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaSearch
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.withOwnTimeKey
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.net.InetAddress
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * Venice web search (OWN_LIFE_PLAN phase 2), his switch: only her words go, in Venice's
+ * documented request; one PAID_SEARCH in her ledger for each that left the phone; nothing
+ * when it is off, on his own hardware or without a key; and in her reading space the web's
+ * results stand after Wikipedia's, a kid's result is one line, and one opens by the fetch rules.
+ */
+class VeniceSearchTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val ledger by lazy { OwnLedger({ File(folder.root, "own_ledger.json") }, { 1_800_000_000_000L }) }
+    private val venice = "Custom OpenAI Compatible"
+    private val settings = AtomicReference(
+        LLMConfig(
+            activeProvider = venice,
+            customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+            apiKeys = mapOf(venice to "his-venice-key"),
+            personaOwnLife = true,
+            personaSearch = PersonaSearch.VENICE,
+            wakePhrases = "hey Ren SENTINEL_WAKE"
+        )
+    )
+
+    private fun search() = VeniceSearch(OkHttpClient(), { settings.get() }, ledger, server.url("/api/v1/augment/search").toString())
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    private fun ok(body: String) = MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(body).build()
+
+    private val results = """{"query":"gyaru","results":[
+        {"title":"Gyaru fashion now","url":"https://mag.example/gyaru","content":"What gyaru wear in 2026.","date":"2026-10-01"},
+        {"title":"Not https","url":"http://plain.example/x","content":"left out","date":""},
+        {"title":"Shibuya 109 guide","url":"https://www.guide.example/109","content":"Floors and shops.\nOpen daily.","date":""}
+    ]}"""
+
+    private fun paid() = ledger.calls()!!.count { it.purpose == OwnPurpose.PAID_SEARCH }
+
+    @Test
+    fun `her words only go out, in Venice's request, with her eyes' key, and one paid search is counted`() = runBlocking {
+        server.enqueue(ok(results))
+        val found = search().search("gyaru") as VeniceSearch.Result.Found
+        assertEquals(listOf("Gyaru fashion now", "Shibuya 109 guide"), found.hits.map { it.title })
+        assertEquals("guide.example", found.hits[1].site)
+        assertEquals("Floors and shops. Open daily.", found.hits[1].snippet)
+        val request = server.takeRequest(5, TimeUnit.SECONDS)!!
+        assertEquals("POST", request.method)
+        assertEquals("Bearer his-venice-key", request.headers["Authorization"])
+        val body = JsonParser.parseString(request.body!!.utf8()).asJsonObject
+        assertEquals(setOf("query", "limit", "search_provider"), body.keySet())
+        assertEquals("gyaru", body.get("query").asString)
+        assertEquals("brave", body.get("search_provider").asString)
+        assertFalse(request.body!!.utf8().contains("SENTINEL_WAKE"))
+        assertEquals(1, paid())
+
+        // Her own-time key goes first where he set one.
+        settings.set(settings.get().withOwnTimeKey("her-own-key"))
+        server.enqueue(ok(results))
+        search().search("gyaru")
+        assertEquals("Bearer her-own-key", server.takeRequest(5, TimeUnit.SECONDS)!!.headers["Authorization"])
+        assertEquals(2, paid())
+    }
+
+    @Test
+    fun `off, on his own hardware or without a key nothing is sent and nothing is counted`() = runBlocking {
+        val on = settings.get()
+        for (off in listOf(
+            on.copy(personaSearch = PersonaSearch.WIKIPEDIA_ONLY),
+            on.copy(routePolicy = RoutePolicy.OWN_HARDWARE),
+            on.copy(apiKeys = emptyMap())
+        )) {
+            settings.set(off)
+            assertFalse(VeniceSearch.on(off))
+            assertEquals(VeniceSearch.Result.Off, search().search("gyaru"))
+        }
+        assertEquals(0, server.requestCount)
+        assertEquals(0, paid())
+        assertFalse(VeniceSearch.on(LLMConfig()))
+    }
+
+    @Test
+    fun `an error from Venice is a failed search that was sent, and an answer it cannot read shows nothing`() = runBlocking {
+        server.enqueue(MockResponse.Builder().code(402).body("""{"error":"INSUFFICIENT_BALANCE"}""").build())
+        assertEquals(VeniceSearch.Result.Failed("the venice balance is too low", sent = true), search().search("gyaru"))
+        server.enqueue(ok("""{"not":"results"}"""))
+        assertEquals(VeniceSearch.Result.Failed("venice's answer could not be read", sent = true), search().search("gyaru"))
+        server.enqueue(ok("""{"query":"x","results":[]}"""))
+        assertEquals(VeniceSearch.Result.Empty, search().search("x"))
+        assertEquals(3, paid())
+        assertNull(VeniceSearch.parse("no json"))
+    }
+
+    // ── In her reading space ────────────────────────────────────────────────────────
+
+    private inner class Sources : ReadingSpace.Sources {
+        val webSearched = CopyOnWriteArrayList<String>()
+        val fetched = CopyOnWriteArrayList<String>()
+        var web: VeniceSearch.Result = VeniceSearch.Result.Found(
+            listOf(
+                VeniceSearch.Hit("Gyaru fashion now", "https://mag.example/gyaru", "What gyaru wear in 2026."),
+                VeniceSearch.Hit("KID_SENTINEL a JK's diary", "https://diary.example/me", "i'm 15 and love gyaru")
+            )
+        )
+        override suspend fun search(words: String) =
+            Wikipedia.Result.Found(listOf(Wikipedia.Hit("Gyaru", "Fashion subculture", "", "en", null)))
+        override suspend fun article(title: String, lang: String): Wikipedia.Result<Wikipedia.Article> = Wikipedia.Result.Empty
+        override suspend fun fetch(url: String): HerFetcher.Fetched {
+            fetched += url
+            return HerFetcher.Fetched.Page(url, url, "text/html", "<html><head><title>Gyaru now</title></head><body><p>text</p></body></html>".toByteArray(), false)
+        }
+        override suspend fun feed(feed: Feeds.Feed): Feeds.Read = Feeds.Read.Items(feed, emptyList())
+        override fun follow(url: String, name: String) = HerFeeds.Followed.ADDED
+        override suspend fun webSearch(words: String): VeniceSearch.Result {
+            webSearched += words
+            return web
+        }
+    }
+
+    @Test
+    fun `with it on, a search lists the web after wikipedia, a kid's result is one line, and one opens by the fetch rules`() = runBlocking {
+        val sources = Sources()
+        val his = OutgoingGuard.His(name = "Ren Mizuno")
+        val space = ReadingSpace(sources, his, limits = ReadingSpace.Limits(webSearch = true))
+        assertTrue(space.webSearch)
+        val did = space.begin(OutingKind.Parsed.Read("gyaru now", null))
+        assertEquals("searched wikipedia for \"gyaru now\": 1 results; and venice search: 2 results", did.line)
+        assertEquals("gyaru now", did.searched)
+        val front = OutingPrompt.inFront(space.view)
+        assertTrue(front, front.contains("[1] Gyaru · Fashion subculture"))
+        assertTrue(front.contains("venice search · gyaru now · 2 results"))
+        assertTrue(front.contains("[2] Gyaru fashion now · mag.example · What gyaru wear in 2026."))
+        // A kid's result: one line, its words withheld, never opened (§1.4).
+        assertTrue(front.contains("[3] kid · diary.example · skipped by the app"))
+        assertFalse(front.contains("KID_SENTINEL"))
+        assertEquals(KidGuard.Group.TEEN, space.kidInFront?.group)
+        assertTrue(space.run(OutingStep.Verb.Open(3)).line.startsWith("skipped: a kid"))
+        assertTrue(sources.fetched.isEmpty())
+        val opened = space.run(OutingStep.Verb.Open(2))
+        assertEquals(listOf("https://mag.example/gyaru"), sources.fetched)
+        assertEquals("Gyaru now" to "mag.example", opened.opened)
+
+        // Words that carry something of his go nowhere: not to wikipedia, not to venice.
+        space.run(OutingStep.Verb.Search("Ren Mizuno's school"))
+        assertEquals(listOf("gyaru now"), sources.webSearched)
+
+        // Off: wikipedia only, as before.
+        val plain = ReadingSpace(Sources(), his)
+        assertEquals("searched wikipedia for \"gyaru\": 1 results", plain.begin(OutingKind.Parsed.Read("gyaru", null)).line)
+    }
+}
