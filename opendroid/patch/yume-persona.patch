+        assertEquals(
+            listOf(
+                "Send email to riya@example.com (cc sam@example.com)",
+                "Split bill (people Sam, Riya)",
+                "Send whatsapp group to Beekeepers"
+            ),
+            lines
+        )
+    }
+
+    @Test
+    fun `a name or a place counts as text only on an action that declares it`() {
+        val found = texts(
+            step("s1", 1, "OPEN_APP", mapOf("appName" to "Spotify", "name" to "Spotify")),
+            step("s2", 2, "SET_ALARM", mapOf("time" to "7:00", "label" to "bees", "title" to "bees")),
+            step("s3", 3, "TOGGLE_WIFI", mapOf("state" to "on", "description" to "turn the wifi on")),
+            step("s4", 4, "CREATE_TASK", mapOf("title" to "order jars", "description" to "forty")),
+            step("s5", 5, "SEND_SMS", mapOf("contact" to "+19005550100", "message" to "hi", "name" to "Sam"))
+        )
+        assertEquals(listOf(PlanApprovalSummary.OutgoingText(5, "message", "hi")), found)
