@@ -0,0 +1,480 @@
+package com.opendroid.ai.core.persona
+
+import android.app.Application
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.persona.PersonaNotes.Kind
+import com.opendroid.ai.core.persona.PersonaNotes.Note
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.db.dao.MemoryDao
+import com.opendroid.ai.data.db.entities.MemoryEntity
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.MemoryRepository
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.io.IOException
+
+/**
+ * A phone that ran an older build keeps that build's wording of a starting note: a
+ * starting note is written once. Where her files have changed it since, the note she
+ * never rewrote is given the wording of this build, and nothing else of her notebook is
+ * touched: what she wrote is hers, what she let go stays gone, and an emptied notebook
+ * stays empty.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaSeedRefreshTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var dao: CountedDao
+    private lateinit var repository: MemoryRepository
+    private lateinit var memory: PersonaMemory
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        dao = CountedDao(database.memoryDao())
+        repository = MemoryRepository(memoryDao = dao, taskHistoryDao = database.taskHistoryDao(), macroDao = database.macroDao())
+        memory = PersonaMemory(repository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    /** Another phone: a notebook of its own. */
+    private fun anotherPhone() {
+        database.close()
+        setUp()
+    }
+
+    /** Counts how often her notebook is read by prefix and how often a row is written or deleted. */
+    private class CountedDao(private val dao: MemoryDao) : MemoryDao by dao {
+        var prefixReads = 0
+        var writes = 0
+
+        override suspend fun getMemoriesByKeyPrefix(prefix: String): List<MemoryEntity> {
+            prefixReads++
+            return dao.getMemoriesByKeyPrefix(prefix)
+        }
+
+        override suspend fun insertOrUpdateMemory(memory: MemoryEntity) {
+            writes++
+            dao.insertOrUpdateMemory(memory)
+        }
+
+        override suspend fun deleteMemory(key: String) {
+            writes++
+            dao.deleteMemory(key)
+        }
+    }
+
+    // Two earlier wordings of one starting note, and the one this build has.
+    private val oldestVoice = Note(
+        Kind.THREAD, "own-voice",
+        "she wants her own synthesized voice: low for her size, slow, a little raspy, with a grin in it; it does not exist yet | open"
+    )
+    private val oldVoice = Note(
+        Kind.THREAD, "own-voice",
+        "i want my own synthesized voice: low for my size, slow, a little raspy, with a grin in it; it does not exist yet | open"
+    )
+    private val voice = Note(
+        Kind.THREAD, "own-voice",
+        "my own voice speaks my lines on the phone now, made there from my words. only a first build; i want it finished | open"
+    )
+    private val oldBoots = Note(Kind.THREAD, "boots", "street story: left boot lost a gold buckle; i am 13,000 short | open")
+    private val boots = Note(Kind.THREAD, "boots", "street story: left boot lost a gold buckle; i have 11,000 yen toward the pair | open")
+    private val oldBuilder = Note(Kind.USER, "builder", "he has been around about two months, building her and poking at her model")
+    private val builder = Note(Kind.USER, "builder", "he has been around about two months, building me and poking at my model")
+    private val miku = Note(Kind.OPINION, "miku", "a singing girl who never gets tired is a little funny")
+
+    /** What an older build wrote as her starting notes. */
+    private val olderBuild = listOf(oldBuilder, miku, oldBoots, oldVoice)
+
+    /** The starting notes of this build, and the file of their earlier wordings, comments and all. */
+    private val thisBuild = listOf(builder, miku, boots, voice)
+    private val previousFile = """
+        # Earlier wordings of her starting notes, from older builds.
+        ${oldestVoice.toLine()}
+        ${oldBoots.toLine()}
+        ${oldBuilder.toLine()}
+        ${oldVoice.toLine()}
+    """.trimIndent()
+    private val earlier = PersonaStore(context) { path -> if (path == "persona/seed_notes.previous.txt") previousFile else "" }.previousSeedNotes()
+
+    private suspend fun stored(note: Note): Memory? = repository.getMemory(note.storageKey)
+
+    private suspend fun archived(note: Note): List<Memory> {
+        val prefix = PersonaMemory.ARCHIVE_PREFIX + note.storageKey.removePrefix(PersonaNotes.KEY_PREFIX) + "."
+        return repository.getMemoriesByKeyPrefix(prefix).filter { it.key.startsWith(prefix) }
+    }
+
+    @Test
+    fun `the file of earlier wordings keeps every wording of a key, and comments are no notes`() {
+        assertEquals(listOf(oldestVoice, oldBoots, oldBuilder, oldVoice), earlier)
+    }
+
+    @Test
+    fun `a starting note she never rewrote is given this build's wording, keeps its place and age, and its old text goes to her archive`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        // A note of her own, newer than every starting note, and a mark she gave the old wording.
+        memory.apply(listOf(Note(Kind.ME, "soda", "melon soda is mine")))
+        memory.updateHow { mapOf(oldVoice.storageKey to PersonaNotes.How.LIVED, miku.storageKey to PersonaNotes.How.LIVED) }
+        val writtenAt = memory.writtenAt()
+        val order = memory.notes().map { it.key }
+
+        assertEquals(3, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(voice.text, stored(voice)!!.value)
+        assertEquals(boots.text, stored(boots)!!.value)
+        assertEquals(builder.text, stored(builder)!!.value)
+        // Its place and its age: nothing of it is new.
+        assertEquals(order, memory.notes().map { it.key })
+        assertEquals(writtenAt, memory.writtenAt())
+        // The old text is in her archive, the way a note written over is, with her mark.
+        val kept = archived(voice).single()
+        assertEquals("yume.meta.archive.thread.own-voice.${writtenAt.getValue(voice.storageKey)}", kept.key)
+        assertTrue(kept.value, kept.value.contains("\"t\":\"${oldVoice.text}\""))
+        assertTrue(kept.value, kept.value.contains("\"why\":\"replaced\""))
+        assertTrue(kept.value, kept.value.contains("\"how\":\"LIVED\""))
+        assertEquals(3, memory.archiveCount())
+        // The mark said how she knew the old text, and went with it; the note that did not change keeps its own.
+        assertEquals(mapOf(miku.storageKey to PersonaNotes.How.LIVED), memory.how())
+        // It is not something she let go, and nothing is there to bring back.
+        assertTrue(memory.archivedLately(10).isEmpty())
+        assertTrue(memory.restorableKeys().isEmpty())
+        assertEquals(5, memory.notes().size)
+    }
+
+    @Test
+    fun `a starting note she rewrote is hers and is left as she wrote it`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        memory.apply(listOf(Note(Kind.THREAD, "own-voice", "he got me a voice on the phone. a first build | open")))
+        // A status she changed is a change of hers too.
+        memory.apply(listOf(oldBoots.copy(text = oldBoots.text.replace("| open", "| stalled"))))
+        val voiceRow = stored(voice)
+        val bootsRow = stored(boots)
+        val archivedBefore = memory.archiveCount()
+
+        assertEquals(1, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(voiceRow, stored(voice))
+        assertEquals(bootsRow, stored(boots))
+        assertEquals(builder.text, stored(builder)!!.value)
+        assertEquals(archivedBefore + 1, memory.archiveCount())
+    }
+
+    @Test
+    fun `a starting note that is not in her notebook is not written back`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        // She let one go, and one is gone some other way.
+        memory.fade(listOf(oldVoice.storageKey))
+        repository.deleteMemory(oldBoots.storageKey)
+
+        assertEquals(1, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(setOf("builder", "miku"), memory.notes().map { it.key }.toSet())
+        // What she let go is in her archive as she let it go.
+        assertEquals(setOf(oldVoice.storageKey), memory.restorableKeys())
+        assertEquals(oldVoice.text, memory.archivedLately(10).single().note.text)
+    }
+
+    @Test
+    fun `an emptied notebook stays empty`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        memory.empty()
+
+        assertEquals(0, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertTrue(memory.notes().isEmpty())
+        assertEquals(0, memory.archiveCount())
+        assertTrue(memory.isStarted())
+    }
+
+    @Test
+    fun `a notebook that has not had its start is not looked over until it has`() = runBlocking {
+        // What a first reply of an older build that was cut short leaves: a row, no marker.
+        repository.saveMemory(Memory(oldVoice.storageKey, oldVoice.text, MemoryType.SEMANTIC, 1_000))
+
+        assertEquals(0, memory.refreshStartingNotes(thisBuild, earlier))
+        assertEquals(oldVoice.text, stored(voice)!!.value)
+
+        // Its start: the row that is there is not written over by seeding, and the refresh after it does it.
+        memory.seedIfNeeded(thisBuild)
+        assertEquals(1, memory.refreshStartingNotes(thisBuild, earlier))
+        assertEquals(voice.text, stored(voice)!!.value)
+        assertEquals(1_000L, stored(voice)!!.timestamp)
+    }
+
+    @Test
+    fun `it runs once for each version of the starting notes, and a later start reads and writes nothing`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        assertEquals(3, memory.refreshStartingNotes(thisBuild, earlier))
+        val reads = dao.prefixReads
+        val writes = dao.writes
+
+        assertEquals(0, memory.refreshStartingNotes(thisBuild, earlier))
+        // The app started again.
+        assertEquals(0, PersonaMemory(repository).refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(reads, dao.prefixReads)
+        assertEquals(writes, dao.writes)
+        // What it keeps is no note of hers, and is not copied out with them.
+        assertEquals(4, memory.notes().size)
+        assertFalse(PersonaNotes.export(memory.notes(), started = true).contains("seedversion"))
+
+        // A later build changes the note again: this build's wording is one of its earlier ones.
+        val nextVoice = voice.copy(text = "my own voice is on the phone and it gets better | open")
+        assertEquals(1, memory.refreshStartingNotes(listOf(builder, miku, boots, nextVoice), earlier + voice))
+        assertEquals(nextVoice.text, stored(voice)!!.value)
+        // Both earlier texts are in her archive: the one written at the same time does not take the other's row.
+        assertEquals(setOf(oldVoice.text, voice.text), archived(voice).map { row -> earlierText(row) }.toSet())
+    }
+
+    @Test
+    fun `a refreshed note she lets go comes back with the wording it had last, and both texts stay in her archive`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        memory.refreshStartingNotes(thisBuild, earlier)
+
+        memory.fade(listOf(voice.storageKey))
+        assertEquals(setOf(oldVoice.text, voice.text), archived(voice).map { row -> earlierText(row) }.toSet())
+
+        assertTrue(memory.restore(voice.storageKey))
+        assertEquals(voice.text, stored(voice)!!.value)
+    }
+
+    @Test
+    fun `a refreshed note she lets go after the clock was set back comes back as she let it go`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        memory.refreshStartingNotes(thisBuild, earlier)
+        // The look-over ran while the phone's clock was a year ahead; it has been set right since.
+        val replaced = archived(voice).single()
+        val ahead = replaced.value.replace(Regex("\"a\":\\d+"), "\"a\":${System.currentTimeMillis() + 365L * 24 * 60 * 60_000}")
+        assertFalse(ahead == replaced.value)
+        repository.saveMemory(replaced.copy(value = ahead))
+
+        memory.fade(listOf(voice.storageKey))
+        assertEquals(voice.text, memory.archivedLately(10).single().note.text)
+
+        assertTrue(memory.restore(voice.storageKey))
+        assertEquals(voice.text, stored(voice)!!.value)
+    }
+
+    @Test
+    fun `a wording a later build goes back to, let go, comes back as that wording and not the one between`() = runBlocking {
+        memory.seedIfNeeded(listOf(oldVoice))
+        assertEquals(1, memory.refreshStartingNotes(listOf(voice), listOf(oldVoice)))
+        // The build after that goes back to the old wording.
+        assertEquals(1, memory.refreshStartingNotes(listOf(oldVoice), listOf(voice)))
+        assertEquals(oldVoice.text, stored(voice)!!.value)
+
+        memory.fade(listOf(voice.storageKey))
+        // Each time a text left her page it was kept in a row of its own, in that order.
+        assertEquals(3, archived(voice).size)
+
+        assertTrue(memory.restore(voice.storageKey))
+        assertEquals(oldVoice.text, stored(voice)!!.value)
+    }
+
+    @Test
+    fun `each earlier wording of a key is refreshed, and only a wording that is listed word for word`() = runBlocking {
+        // A phone whose starting notes were this one note alone. Of this build's others only
+        // miku was in no earlier build, and it comes in new; the rest are not written back.
+        for (old in listOf(oldestVoice, oldVoice)) {
+            anotherPhone()
+            memory.seedIfNeeded(listOf(old))
+            assertEquals(old.text, 2, memory.refreshStartingNotes(thisBuild, earlier))
+            assertEquals(voice.text, stored(voice)!!.value)
+            assertEquals(setOf("own-voice", "miku"), memory.notes().map { it.key }.toSet())
+        }
+        // Close to an earlier wording is not one of them. A notebook with no note in the words of
+        // a starting note, here or in her archive, is not taken for one that had its start: no new one comes in.
+        anotherPhone()
+        val close = oldVoice.copy(text = oldVoice.text.replace("it does not exist yet", "it does not exist yet, not really"))
+        memory.seedIfNeeded(listOf(close))
+        assertEquals(0, memory.refreshStartingNotes(thisBuild, earlier))
+        assertEquals(close.text, stored(voice)!!.value)
+        assertEquals(null, stored(miku))
+    }
+
+    @Test
+    fun `a build without the file of earlier wordings, or with one that cannot be read, refreshes nothing`() = runBlocking {
+        val seedFile = thisBuild.joinToString("\n") { it.toLine() }
+        val without = PersonaStore(context) { path -> if (path == "persona/seed_notes.txt") seedFile else "" }
+        val unreadable = PersonaStore(context) { path ->
+            if (path == "persona/seed_notes.previous.txt") throw IOException("cannot be read") else seedFile
+        }
+        assertEquals(thisBuild, without.seedNotes())
+        assertTrue(without.previousSeedNotes().isEmpty())
+        assertTrue(unreadable.previousSeedNotes().isEmpty())
+        memory.seedIfNeeded(olderBuild)
+
+        assertEquals(0, memory.refreshStartingNotes(without.seedNotes(), without.previousSeedNotes()))
+
+        assertEquals(olderBuild.map { it.text }.toSet(), memory.notes().map { it.text }.toSet())
+        assertEquals(0, memory.archiveCount())
+    }
+
+    @Test
+    fun `private notes after the public ones are touched only where their exact earlier wording is listed`() = runBlocking {
+        // A build with his notes baked in: they come after the public starting notes.
