+    )
+
+    /** A plain hosted model whose provider can read what it is sent, with private mode on. */
+    private fun hosted(config: LLMConfig) = ownNetwork(config).copy(
+        customEndpoints = mapOf(custom to "https://api.example.com/v1"),
+        privateMode = true
+    )
+
+    private fun configure(change: (LLMConfig) -> LLMConfig): LLMConfig = runBlocking {
+        settings.updateConfig(change)
