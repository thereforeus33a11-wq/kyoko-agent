+            LLMConfig(activeProvider = "On-Device AI", personaChatSeesImages = true),
+            LLMConfig()
+        )
+        for (config in configs) {
+            val reason = why(config)
+            // The buttons hang on the same question the engine asks before it attaches a picture.
+            assertEquals(config.toString(), !PersonaEngine.imagesReachChatModel(config), reason != null)
+            if (reason == null) continue
+            val top = says(config)
+            when {
