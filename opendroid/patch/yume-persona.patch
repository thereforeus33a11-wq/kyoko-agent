+
+    private val BLOCKS = setOf(
+        "p", "div", "section", "article", "main", "li", "ul", "ol", "dl", "dt", "dd", "pre", "blockquote",
+        "h1", "h2", "h3", "h4", "h5", "h6", "table", "tr", "td", "th", "figcaption", "br", "hr"
