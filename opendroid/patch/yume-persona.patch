+                } else {
+                    "Saved: Venice's list could not be asked just now, and $id is on this build's list of Private-tier vision models."
+                }
+            is EyesModels.Verdict.Refused -> "Not saved: ${verdict.why}"
+        }
+
+        const val CHANNEL_NOT_FOUND =
+            "No channel was found at that address. Paste the address of a channel's page: youtube.com/@name, or one with /channel/UC… in it."
+    }
+}
