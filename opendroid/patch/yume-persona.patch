+package com.opendroid.ai.ui.viewmodel
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.persona.SelfPictureMaker
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.util.Locale
+import java.util.TimeZone
+import java.util.concurrent.atomic.AtomicLong
+
+/** Pictures of her in "Her day" and on the status card: one entry a day, counts only, by category. */
+class PictureCountsTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val clock = AtomicLong(1_800_000_000_000L)
+    private val log by lazy { HerLog({ File(folder.root, "her_log.json") }, { clock.get() }) }
+
+    @Test
+    fun `a day of her pictures is one entry of counts, told by category and never by content`() {
+        log.picture(kept = true)
+        clock.addAndGet(60_000)
+        log.picture(kept = false, category = "kid:TEEN")
+        log.picture(kept = true)
+        log.picture(kept = false, category = SelfPictureMaker.BLOCKED)
+        log.picture(kept = false, category = "kid:UNCHECKED")
+        val entry = log.entries().single()
+        assertEquals(HerLog.Kind.PICTURES_DAY, entry.kind)
+        assertEquals(mapOf(HerLog.PICTURES_KEPT to 2), entry.counts)
+        assertEquals(mapOf("kid:TEEN" to 1, SelfPictureMaker.BLOCKED to 1, "kid:UNCHECKED" to 1), entry.refusals)
+        val line = herDayLine(entry, TimeZone.getTimeZone("UTC"), Locale.ENGLISH)
+        assertTrue(line, line.contains(" her pictures · 2 kept · 1 thrown away unseen (age check: teen), 1 thrown away unseen (flagged by Venice), 1 thrown away unseen (age check could not tell)"))
+        assertEquals(
+            "Pictures of her in 24 h: 2 kept, 3 thrown away unseen (age check: teen 1, flagged by Venice 1, age check could not tell 1).",
+            HerLog.picturesLine(log.entries(), clock.get())
+        )
+        // A day later the status card says nothing of them.
+        assertNull(HerLog.picturesLine(log.entries(), clock.get() + 25 * 60 * 60_000L))
+        assertNull(HerLog.kidsLine(log.entries(), clock.get()))
+        // The status card carries the line.
+        val card = File("src/main/java/com/opendroid/ai/ui/viewmodel/PersonaViewModel.kt").readText()
+        assertTrue(card.contains("HerLog.picturesLine(snapshot.entries, nowMillis)?.let(::add)"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/ui/viewmodel/PictureModelsViewModelTest.kt b/app/src/test/java/com/opendroid/ai/ui/viewmodel/PictureModelsViewModelTest.kt
