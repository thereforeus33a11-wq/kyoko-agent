+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.LLMConfig
+import java.util.Locale
+
+/**
+ * The Venice image models her pictures can be made with: Private tier only (Venice keeps
+ * neither the prompt nor the picture), with what each costs and how each is asked.
+ *
+ * Two kinds:
+ * - [Kind.GENERATE]: draws a whole new picture from words (`POST /image/generate`). This is
+ *   how a new scene, pose or view of her is made; an edit model asked to re-pose a picture
+ *   melts hands and turns shirts backwards.
+ * - [Kind.EDIT]: changes one picture of her a little (`POST /image/edit`), and matches a new
+ *   picture to her own pictures afterwards (`POST /image/multi-edit`).
+ *
+ * Figures are Venice's list of 2026-11-18 (prices in US dollars per picture at 1K). What a
+ * model is sent follows Venice's API reference: models sized in pixels get width, height,
+ * steps and a guidance scale; models sized by ratio get an aspect ratio and a resolution and
+ * never width and height, which some of them refuse.
+ */
+object PictureModels {
+
+    enum class Kind { GENERATE, EDIT }
+
+    /** How a model wants its prompt written. */
+    enum class Style {
+        /** An anime model trained on Danbooru tags (Illustrious): comma-separated tags. */
+        ANIME_TAGS,
+
+        /** A photographic model: plain sentences, and "photograph" in them. */
+        PHOTO,
+
+        /** A general model asked in plain sentences to draw her as a 2D anime illustration. */
+        ANIME_PROSE
+    }
+
+    /** How a model is sized: by width and height in pixels, or by an aspect ratio and a resolution tier. */
+    enum class Sizing { PIXELS, RATIO }
+
+    data class Model(
+        val id: String,
+        val label: String,
+        val kind: Kind,
+        /** US dollars per picture, at 1K where the price goes by resolution. */
+        val price: Double,
+        val style: Style,
+        val sizing: Sizing,
+        /** The most characters of prompt it reads. */
+        val promptLimit: Int,
+        /** Steps sent (pixel-sized models only), within the model's own maximum. */
+        val steps: Int? = null,
+        /** Guidance scale sent (pixel-sized SDXL models only). */
+        val cfg: Double? = null,
+        /** Whether it has resolution tiers ("1K", "2K"); a ratio-sized model without them gets only the ratio. */
+        val resolutions: Boolean = false,
+        /** Whether Venice marks it uncensored: one that is not may blur or refuse a picture of her that shows more. */
+        val uncensored: Boolean = true,
+        /**
+         * Whether it honours a negative prompt by how it works (SDXL with real guidance). The
+         * guard's negative prompt is sent to every generate model all the same; on the others
+         * the adult words in the prompt and the age check afterwards carry the rule.
+         */
+        val honoursNegative: Boolean = false,
+        /** One line for him about what it is good at. */
+        val note: String = ""
+    )
+
+    val WAI = Model(
+        id = "wai-Illustrious", label = "Anime (WAI Illustrious)", kind = Kind.GENERATE, price = 0.01,
+        style = Style.ANIME_TAGS, sizing = Sizing.PIXELS, promptLimit = 1500, steps = 28, cfg = 5.5,
+        honoursNegative = true, note = "2D anime like her pictures, uncensored, follows tags and the negative prompt"
+    )
+
+    val LUSTIFY_V8 = Model(
+        id = "lustify-v8", label = "Photo (Lustify v8)", kind = Kind.GENERATE, price = 0.01,
+        style = Style.PHOTO, sizing = Sizing.PIXELS, promptLimit = 1500, steps = 30, cfg = 5.0,
+        honoursNegative = true, note = "photographic, the most uncensored, follows the negative prompt"
+    )
+
+    val LUSTIFY_SDXL = Model(
+        id = "lustify-sdxl", label = "Photo (Lustify SDXL)", kind = Kind.GENERATE, price = 0.01,
+        style = Style.PHOTO, sizing = Sizing.PIXELS, promptLimit = 1500, steps = 25, cfg = 5.0,
+        honoursNegative = true, note = "photographic, the older Lustify"
+    )
+
+    val CHROMA = Model(
+        id = "chroma", label = "Chroma", kind = Kind.GENERATE, price = 0.01,
+        style = Style.ANIME_PROSE, sizing = Sizing.PIXELS, promptLimit = 7500, steps = 10,
+        note = "general and uncensored, reads whole sentences"
+    )
+
+    val KREA_TURBO = Model(
+        id = "krea-2-turbo", label = "Krea 2 Turbo", kind = Kind.GENERATE, price = 0.04,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 5000, resolutions = true,
+        note = "general and uncensored, sharp detail, likely ignores the negative prompt"
+    )
+
+    val Z_IMAGE = Model(
+        id = "z-image-turbo", label = "Z-Image Turbo", kind = Kind.GENERATE, price = 0.01,
+        style = Style.ANIME_PROSE, sizing = Sizing.PIXELS, promptLimit = 7500, steps = 8, uncensored = false,
+        note = "fast and general; not marked uncensored"
+    )
+
+    val GROK = Model(
+        id = "grok-imagine-image", label = "Grok Imagine", kind = Kind.GENERATE, price = 0.03,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 7500, resolutions = true, uncensored = false,
+        note = "general; not marked uncensored"
+    )
+
+    val HUNYUAN = Model(
+        id = "hunyuan-image-v3", label = "Hunyuan Image 3", kind = Kind.GENERATE, price = 0.09,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 3000, uncensored = false,
+        note = "general, good with text in the picture; not marked uncensored"
+    )
+
+    val QWEN_EDIT = Model(
+        id = "qwen-edit-uncensored", label = "Qwen Edit (uncensored)", kind = Kind.EDIT, price = 0.04,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 1500,
+        note = "keeps her face from the picture it starts from; takes up to 3 pictures at once"
+    )
+
+    val FIRERED_EDIT = Model(
+        id = "firered-image-edit", label = "FireRed Edit", kind = Kind.EDIT, price = 0.04,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 1500, uncensored = false,
+        note = "Venice's default edit model; not marked uncensored"
+    )
+
+    val GROK_EDIT = Model(
+        id = "grok-imagine-edit", label = "Grok Imagine Edit", kind = Kind.EDIT, price = 0.03,
+        style = Style.ANIME_PROSE, sizing = Sizing.RATIO, promptLimit = 1500, resolutions = true, uncensored = false,
+        note = "not marked uncensored"
+    )
+
+    /** Every model here, generate models first, in the order they are offered. */
+    val ALL: List<Model> = listOf(WAI, LUSTIFY_V8, LUSTIFY_SDXL, CHROMA, KREA_TURBO, Z_IMAGE, GROK, HUNYUAN, QWEN_EDIT, FIRERED_EDIT, GROK_EDIT)
+
+    /** The model a new picture of her is drawn with when he chose none: anime like her plates, uncensored, a cent. */
+    val DEFAULT_GENERATE: Model = WAI
+
+    /** The model a small change to one of her pictures is made with, and the one that matches a new picture to hers. */
+    val DEFAULT_EDIT: Model = QWEN_EDIT
+
+    /** The model that matches a new picture to her own pictures (multi-edit takes up to 3 pictures). */
+    val MATCH: Model = QWEN_EDIT
+
+    /** How many pictures [MATCH] takes at once: the new one and two of hers. */
+    const val MATCH_IMAGES = 3
+
+    /** The model with [id], in any case, or null when it is none of these. */
+    fun of(id: String?): Model? {
+        val wanted = id?.trim()?.lowercase(Locale.ROOT)?.takeIf { it.isNotEmpty() } ?: return null
+        return ALL.firstOrNull { it.id.lowercase(Locale.ROOT) == wanted }
+    }
+
+    val GENERATE: List<Model> get() = ALL.filter { it.kind == Kind.GENERATE }
+    val EDIT: List<Model> get() = ALL.filter { it.kind == Kind.EDIT }
+
+    /**
+     * The model a new picture of her is drawn with as [config] stands: his choice where it is
+     * a generate model here, else [DEFAULT_GENERATE]. An id saved before this list existed
+     * (an edit model, or one Venice has since dropped) falls back to the default rather than
+     * being sent to an endpoint that would turn it down.
+     */
+    fun generateModelOf(config: LLMConfig): Model =
+        of(config.personaPictureModel)?.takeIf { it.kind == Kind.GENERATE } ?: DEFAULT_GENERATE
+
+    /** The model a small change to one of her pictures is made with as [config] stands. */
+    fun editModelOf(config: LLMConfig): Model =
+        of(config.personaPictureEditModel)?.takeIf { it.kind == Kind.EDIT } ?: DEFAULT_EDIT
+
+    /** A price in words: "1¢", "4¢", "9¢". */
+    fun cents(dollars: Double): String {
+        val cents = dollars * 100
+        val rounded = Math.round(cents * 10) / 10.0
+        return if (rounded == Math.floor(rounded)) "${rounded.toLong()}¢" else "$rounded¢"
+    }
+
+    /** A model as a choice in his settings: "Anime (WAI Illustrious) · 1¢ a picture (default)". */
+    fun choiceLabel(model: Model, default: Model): String = buildString {
+        append(model.label).append(" · ").append(cents(model.price)).append(" a picture")
+        if (!model.uncensored) append(" · not marked uncensored")
+        if (model == default) append(" (default)")
+    }
+
+    /**
+     * What one new picture costs with [generate] and, where [match] is on, the pass that matches
+     * it to her own pictures ([MATCH]); an age check on top is a fraction of a cent.
+     */
+    fun pictureCost(generate: Model, match: Boolean): Double = generate.price + if (match) MATCH.price else 0.0
+}
