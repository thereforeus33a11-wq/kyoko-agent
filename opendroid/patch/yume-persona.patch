+        assertTrue(sources.imageBytes.single().all { it == 0.toByte() })
+        // The verb is offered with the outing's looks, and the kids line is in every step that can show people.
+        val first = mind.texts[0]
+        assertTrue(first, first.contains("      look <n>         a describer that is not you looks at picture <n> and you get its words. 6 left on this outing."))
+        assertTrue(first.contains(OutingPrompt.KIDS_LINE))
+        assertTrue(mind.texts[1], mind.texts[1].contains("picture 1: the page's lead picture, not looked at."))
+        val third = mind.texts[2]
+        assertTrue(third, third.contains("picture 1 (described for you by the app's describer; you do not see it, and it can be wrong): DESCRIPTION_SENTINEL a magazine cover"))
+        assertTrue(third.contains("2. looked at picture 1: what the describer wrote is in front of you. you thought: \"cute\""))
+        assertTrue(third.contains("5 left on this outing."))
+        // Three steps and one look: four calls of hers, as the ledger has them.
+        val e = entry()
