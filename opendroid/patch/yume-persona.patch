+        assertEquals("", filter.take("rry, but I cannot"))
+        assertEquals("", filter.take(" help with that."))
+        assertNull("the refusal is seen before a word of it went out", filter.finish())
+
+        // The same opening words going somewhere else are hers, and arrive whole.
+        assertEquals(
+            "I'm sorry, but I cannot with you today" to false,
+            run(true, "I'm ", "so", "rry, but I cannot", " with you today")
+        )
+        assertEquals(
