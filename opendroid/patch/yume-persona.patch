+     * Deliberately short, like the lexicon.
+     */
+    private val SINGLE_LETTER_WORDS = setOf(
+        "no", "so", "go", "oh", "yo", "yes", "stop", "please", "wow", "love", "sorry", "nope",
+        "wait", "what", "but", "hey", "me", "he", "she", "we", "be", "lol", "bro", "cute", "done"
+    )
+
+    /**
+     * The everyday words that are spelt with a doubled o or e. A stretched o or e is cut
+     * to two only where that gives one of these, and to one everywhere else: far more
+     * words are spelt with the single vowel, and doubling it there says another word
+     * ("hooot" would be said "hoot", "leeegs" "leegs").
+     */
+    private val DOUBLED_VOWEL_WORDS = setOf(
+        // oo
+        "good", "goodbye", "goodnight", "goodness", "cool", "cooler", "coolest", "too", "soon", "sooner",
+        "food", "mood", "moody", "room", "rooms", "bedroom", "bathroom", "boo", "woo", "woohoo", "zoo",
+        "look", "looks", "looking", "looked", "book", "books", "took", "cook", "cookie", "cookies", "hook",
+        "shook", "foot", "fool", "foolish", "pool", "school", "tool", "poor", "door", "doors", "floor",
+        "moon", "noon", "afternoon", "spoon", "zoom", "boom", "doom", "bloom", "choose", "loose", "goose",
+        "smooth", "tooth", "boot", "boots", "shoot", "root", "roof", "proof", "goofy", "blood", "bloody",
+        "flood", "wood", "woods", "stood", "understood", "hood", "oops", "whoops", "ooh", "oof", "boob",
+        "boobs", "booty", "noodle", "noodles", "poop", "loop", "scoop", "cartoon", "balloon", "tattoo",
+        "shampoo", "snooze", "booze", "mushroom",
+        // ee
+        "see", "sees", "seen", "seeing", "been", "feel", "feels", "feeling", "feelings", "need", "needs",
+        "needed", "needy", "sweet", "sweetie", "sweetheart", "sweeter", "deep", "deeper", "free", "freedom",
+        "sleep", "sleepy", "sleeping", "asleep", "keep", "keeps", "keeping", "week", "weeks", "weekend",
+        "meet", "meeting", "green", "queen", "screen", "street", "feet", "teeth", "speed", "weed", "seed",
+        "seem", "seems", "seek", "peek", "cheek", "cheeks", "geek", "geez", "jeez", "sheesh", "eek", "tree",
+        "trees", "three", "knee", "knees", "bee", "bees", "fee", "wee", "whee", "coffee", "agree", "agreed",
+        "degree", "cheese", "cheesy", "cheer", "cheers", "beer", "deer", "queer", "career", "sheep", "creep",
+        "creepy", "weep", "steep", "sweep", "beep", "heel", "heels", "wheel", "steel", "peel", "feed",
+        "greed", "greedy", "bleed", "indeed", "speech", "beef", "teen", "teens", "between", "keen", "sheet",
+        "sheets", "greet", "tweet", "breeze", "freeze", "sneeze", "squeeze", "sleeve"
+    )
+
+    // Three dots or more are a pause she typed. Held under a mark while the stops around
+    // them are tidied, and put back as three dots.
+    private val ELLIPSIS = Regex("""\.{3,}|\u2026""")
+    private const val PAUSE = '\uE000'
+    private val STOP_AFTER_PAUSE = Regex("$PAUSE\\s*\\.")
+
+    /**
+     * A span in single or double asterisks standing at a word edge, the way emphasis and
+     * stage directions are typed. An asterisk inside a word or between digits ("f*ck",
+     * "2*3*4") is not one.
+     */
+    val STARRED_SPAN = Regex("""(?<![\p{L}\p{N}*])(\*\*|\*)(?=\S)([^*\n]+?)(?<=\S)\1(?![\p{L}\p{N}*])""")
+
+    /** Verbs that, alone in asterisks, can only be a stage direction. */
+    private val GESTURE_ALONE = setOf(
+        "smirks", "sighs", "laughs", "shrugs", "grins", "winks", "yawns", "snorts", "scoffs", "giggles",
+        "pouts", "blinks", "groans", "chuckles", "snickers", "nods", "pauses", "stares", "glares", "smiles",
+        "frowns", "huffs", "gasps", "squints", "purrs", "exhales"
+    )
+
+    /** Verbs that open a stage direction of several words ("rolls eyes", "leans back"). */
+    private val GESTURE_OPENING = GESTURE_ALONE + setOf(
+        "rolls", "flips", "tilts", "crosses", "taps", "clicks", "pops", "twirls", "checks", "looks", "glances",
+        "raises", "narrows", "licks", "bites", "sticks", "tosses", "leans", "waves", "hums", "whispers",
+        "mutters", "stretches", "flicks", "adjusts", "inspects", "examines", "snaps", "claps", "shakes"
+    )
+
+    /**
+     * True only for the inside of a starred span that opens with a third-person gesture
+     * verb ("rolls eyes", "shrugs"). Anything else in asterisks is taken to be emphasis:
+     * its words are something she said.
+     */
+    fun isGesture(inner: String): Boolean {
+        val words = inner.trim().lowercase().split(Regex("""\s+"""))
+        val first = words.first().trim { !it.isLetter() }
+        return if (words.size == 1) first in GESTURE_ALONE else first in GESTURE_OPENING
+    }
+
+    /** Who a third-person verb belongs to when it follows one of these: then it is her sentence's own verb. */
+    private val SUBJECTS = setOf(
+        "he", "she", "it", "who", "that", "everyone", "everybody", "someone", "somebody", "nobody",
+        "anyone", "anybody", "whoever"
+    )
+
+    /** Words that stand between a subject and its verb: "he just *laughs*". */
+    private val BETWEEN_SUBJECT_AND_VERB = setOf(
+        "just", "always", "never", "ever", "only", "still", "really", "even", "then", "also", "kinda", "sorta",
+        "literally", "actually", "basically", "simply", "totally", "probably", "almost", "barely", "hardly",
+        "sometimes", "usually", "often", "now", "already", "suddenly", "honestly", "seriously", "fucking"
+    )
+
+    /**
+     * "it" and "that" are as often what the verb before them is done to ("i knew it",
+     * "stop that") as they are a subject. They count as the subject of a starred verb
+     * only where they can be one: see [followsItsSubject].
+     */
+    private val SUBJECT_OR_OBJECT = setOf("it", "that")
+
+    /** Words that begin a clause, so that an "it" right behind one is its subject: "and it *purrs*". */
+    private val OPENS_A_CLAUSE = setOf(
+        "and", "but", "or", "so", "when", "whenever", "while", "if", "because", "cause", "cuz", "though",
+        "unless", "once"
+    )
+
+    /** Words that bring in the noun a "that" tells more about: "the cat that *purrs*". */
+    private val INTRODUCES_A_NOUN = setOf(
+        "the", "a", "an", "this", "that", "every", "each", "some", "any", "one", "another", "my", "your",
+        "his", "our", "their", "someone", "somebody", "anyone", "anybody", "everyone", "everybody", "nobody",
+        "something", "anything", "everything", "nothing"
+    )
+
+    // A word, or a mark that ends a clause.
+    private val WORD_OR_BREAK = Regex("""[\p{L}']+|[,;:.!?\u2026\u2014\u2013]""")
+
+    /**
+     * [text] without the stage directions she typed in asterisks. A gesture verb in
+     * asterisks is a stage direction only where it stands apart from her sentence: at the
+     * start of a line or of a sentence ("*sighs* fine"), or at the end of a line
+     * ("whatever *shrugs*"). With words of hers on both sides it is a word she stressed,
+     * and so it is behind its own subject ("he just *laughs*"): those are said. Leaving
+     * one of them out would drop a word from her sentence: "he *stares* at me" would be
+     * said "he at me".
+     *
+     * Where a line or a sentence starts and ends is judged by what is said. A tilde, a
+     * heart, an emoji, a quote or a bracket is not: "whatever *shrugs*~" ends in the
+     * gesture as much as "whatever *shrugs*" does.
+     */
+    private fun withoutStageDirections(text: String): String {
+        val out = StringBuilder(text.length)
