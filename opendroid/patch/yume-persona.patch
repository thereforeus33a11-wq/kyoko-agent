@@ -0,0 +1,259 @@
+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.eyes.CameraLook
+import com.opendroid.ai.core.life.eyes.HerLooks
+import com.opendroid.ai.core.life.eyes.Looks
+import com.opendroid.ai.data.models.LLMConfig
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+import java.util.concurrent.atomic.AtomicInteger
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.CoroutineContext
+import kotlin.coroutines.EmptyCoroutineContext
+
+/**
+ * What her engine asks of her own life, in one narrow door, so that her package does not
+ * hold the ledger, the log or the host itself: the mark that counts a call of hers, what
+ * her moment is told, her wonders, a `go:` that did not start, what a reply of hers is
+ * told about what she did on her own, and her own `<< go: stop`.
+ *
+ * [NONE] is no own life at all: nothing is counted and nothing is told. It is what a test
+ * or a build without it gets; the app binds [OwnLife].
+ */
+interface OwnLifeLink {
+
+    /** The context a call of hers for [purpose] runs in so that it is counted; empty where nothing counts. */
+    fun counted(purpose: OwnPurpose): CoroutineContext
+
+    /** Her own life as her moment is told it now, or null while it is off. */
+    suspend fun now(config: LLMConfig, nowMillis: Long): Now?
+
+    /** Puts her `wonder:` lines on her list (or takes one off). */
+    suspend fun wonder(lines: List<Wonders.Line>, atMillis: Long)
+
+    /** A `go:` of hers that did not start, logged by why. */
+    fun notStarted(why: HerLog.NotStarted, where: String = "")
+
+    /** What a reply of hers is told about her own life, or null while it is off. */
+    fun forReply(config: LLMConfig, nowMillis: Long): ForReply?
+
+    /** Her `<< go: stop` in a reply: the outing she is on ends. */
+    fun stopOuting()
+
+    /** Lines of hers about a kid not kept in the moment after an outing or a look that met one: counted with it (§1.4). */
+    fun kidLinesDropped(count: Int) = Unit
+
+    /** Her own life as it stands for one moment of hers. */
+    data class Now(
+        /** What she can go and do: the kinds that can run now. */
+        val runnable: Set<OutingKind.Kind>,
+        val maxMinutes: Int,
+        val maxSteps: Int,
+        /** His cap of calls on her own in any 24 hours. */
+        val cap: Int,
+        /** How many are left now, or null when the ledger cannot be read. */
+        val left: Int?,
+        /** When one is free again, where none is left. */
+        val roomAgainAt: Long?,
+        /** Her open wonders, oldest first. */
+        val wonders: List<Wonders.Wonder>,
+        /** Each outing waits for his yes first ([LLMConfig.personaOutingsAsk]). */
+        val asks: Boolean = false,
+        /** A look through the camera as it is offered now ([Kind.LOOK] is runnable), or null when it is not. */
+        val camera: CameraLook.Offer? = null,
+        /** Her eyes are switched on, with his consent: pictures can be described for her, each a call of hers. */
+        val eyes: Boolean = false,
+        /** A search of hers goes to Venice web search too ([com.opendroid.ai.core.life.reading.VeniceSearch.on]). */
+        val paidSearch: Boolean = false
+    )
+
+    /** What a reply of hers is told: what she did on her own since he last talked to her, and what she is doing now. */
+    data class ForReply(
+        /** Outings that ended since he last talked to her, oldest first. */
+        val done: List<HerLog.Entry>,
+        /** What she is doing now, in the words of her own prompt; null when nothing. */
+        val doing: String?,
+        /** A look through the camera as her moments are offered it now, or null when they are not. */
+        val camera: CameraLook.Offer? = null
+    )
+
+    companion object {
+        /** No own life: nothing is counted, nothing is told. */
+        val NONE: OwnLifeLink = object : OwnLifeLink {
+            override fun counted(purpose: OwnPurpose): CoroutineContext = EmptyCoroutineContext
+            override suspend fun now(config: LLMConfig, nowMillis: Long): Now? = null
+            override suspend fun wonder(lines: List<Wonders.Line>, atMillis: Long) = Unit
+            override fun notStarted(why: HerLog.NotStarted, where: String) = Unit
+            override fun forReply(config: LLMConfig, nowMillis: Long): ForReply? = null
+            override fun stopOuting() = Unit
+        }
+    }
+}
+
+/**
+ * Her own life as the app holds it: the ledger of her calls, the log of what she did,
+ * what she is doing now and her wonders, read for her engine ([OwnLifeLink]); and when
+ * he last talked to her, which the loop sets and the host of her outings reads.
+ *
+ * Her own life is on when he switched it on ([LLMConfig.personaOwnLife]); the rest of
+ * her own time must be on for it to matter, which her engine asks itself.
+ */
+@Singleton
+class OwnLife internal constructor(
+    private val ledger: OwnLedger,
+    private val log: HerLog,
+    private val herNow: HerNow,
+    private val wonders: Wonders,
+    /** Her camera looks, which a moment of hers is offered where they can be had; null where she has none. */
+    private val looks: Looks?
+) : OwnLifeLink {
+
+    @Inject
+    constructor(ledger: OwnLedger, log: HerLog, herNow: HerNow, wonders: Wonders, looks: HerLooks) :
+        this(ledger, log, herNow, wonders, looks as Looks)
+
+    /** Without camera looks: what a test of her outings gets. */
+    constructor(ledger: OwnLedger, log: HerLog, herNow: HerNow, wonders: Wonders) : this(ledger, log, herNow, wonders, null as Looks?)
+
+    // ── His talk ─────────────────────────────────────────────────────────────────────
+
+    private val activityAt = MutableStateFlow(0L)
+    private val going = AtomicInteger(0)
+    @Volatile private var talkBegan = 0L
+    @Volatile private var talkBefore = 0L
+
+    /** When he last wrote, gave a command or talked to her, or when the task that followed it ended. */
+    val hisActivityAt: StateFlow<Long> = activityAt.asStateFlow()
+
+    /** He wrote, gave a command or talked to her at [atMillis]: what he started is going on. */
+    fun heTalks(atMillis: Long) {
+        talkBefore = talkBegan
+        talkBegan = atMillis
+        going.incrementAndGet()
+        activityAt.value = atMillis
+    }
+
+    /** What he started is over at [atMillis]: the talk goes quiet from here. */
+    fun heTalked(atMillis: Long) {
+        going.updateAndGet { (it - 1).coerceAtLeast(0) }
+        activityAt.value = maxOf(activityAt.value, atMillis)
+    }
+
+    /** True while something he started is still going on. */
+    fun talkGoingOn(): Boolean = going.get() > 0
+
+    // ── Her own stop ─────────────────────────────────────────────────────────────────
+
+    private val stops = MutableSharedFlow<Unit>(extraBufferCapacity = 4)
+
+    /** Her own `<< go: stop`, for the host of her outings. */
+    val stopsAsked: SharedFlow<Unit> = stops.asSharedFlow()
+
+    override fun stopOuting() {
+        stops.tryEmit(Unit)
+    }
+
+    // ── For her engine ───────────────────────────────────────────────────────────────
+
+    override fun counted(purpose: OwnPurpose): CoroutineContext = ledger.call(purpose)
+
+    override suspend fun now(config: LLMConfig, nowMillis: Long): OwnLifeLink.Now? {
+        if (!config.personaOwnLife) return null
+        val cap = capOf(config)
+        // A look is offered where his switch is on, her eyes are open and the service holds the camera.
+        val camera = if (config.personaOwnLife) looks?.offer(config, nowMillis) else null
+        return OwnLifeLink.Now(
+            runnable = runnable(config, looking = camera != null),
+            maxMinutes = maxMinutes(config),
+            maxSteps = maxSteps(config),
+            cap = cap,
+            left = ledger.left(cap, nowMillis),
+            roomAgainAt = ledger.roomAgainAt(cap, nowMillis),
+            wonders = wonders.open(),
+            asks = config.personaOutingsAsk,
+            camera = camera,
+            eyes = config.personaEyes && config.personaEyesConsentAt > 0L,
+            paidSearch = com.opendroid.ai.core.life.reading.VeniceSearch.on(config)
+        )
+    }
+
+    override suspend fun wonder(lines: List<Wonders.Line>, atMillis: Long) {
+        if (lines.isNotEmpty()) wonders.apply(lines, atMillis)
+    }
+
+    override fun notStarted(why: HerLog.NotStarted, where: String) {
+        log.notStarted(why, where)
+    }
+
+    override fun kidLinesDropped(count: Int) {
+        log.droppedAfter(count)
+    }
+
+    override fun forReply(config: LLMConfig, nowMillis: Long): OwnLifeLink.ForReply? {
+        if (!config.personaOwnLife) return null
+        // Since he last talked to her: his message before the one this reply answers.
+        val since = maxOf(talkBefore, nowMillis - REPLY_LOOKS_BACK_MILLIS)
+        val done = log.entries()
+            .filter { it.kind in OUTINGS && it.endedBy != HerLog.EndedBy.RUNNING && (it.endedAt ?: 0L) > since }
+            .takeLast(REPLY_OUTINGS)
+        // A look of hers is called off when he writes: it does not wait for him as an outing does.
+        val looking = (herNow.now.value as? HerNow.Now.Doing)?.kind == HerLog.Kind.LOOK
+        return OwnLifeLink.ForReply(done, herNow.inHerWords().takeUnless { looking }, camera = looks?.offer(config, nowMillis))
+    }
+
+    /**
+     * The titles she opened on her outings lately, from her log: other people's words, which
+     * her moments and her replies are told of. A `>>` of hers is held against them like any
+     * outside text, so a command that echoes a title is never run on her rein (I3). Empty
+     * while her own life is off. Her search words and her own commands are not in it.
+     */
+    fun outsideText(config: LLMConfig, nowMillis: Long = System.currentTimeMillis()): String {
+        if (!config.personaOwnLife) return ""
+        return log.entries()
+            .filter { it.kind in OUTINGS && maxOf(it.startedAt, it.endedAt ?: 0L) > nowMillis - OUTSIDE_LOOKS_BACK_MILLIS }
+            .flatMap { entry -> entry.what.filterNot { it.startsWith(HerLog.Tally.SEARCHED_PREFIX) } }
+            .distinct()
+            .joinToString("\n")
+    }
+
+    companion object {
+        /** How far back the titles of her outings count as outside text: longer than any of her prompts tells of them. */
+        const val OUTSIDE_LOOKS_BACK_MILLIS = 48 * 60 * 60_000L
+
+        /** A reply is told of her outings of the last day at most, however long he was away. */
+        const val REPLY_LOOKS_BACK_MILLIS = 24 * 60 * 60_000L
+
+        /** The most outings a reply is told of. */
+        const val REPLY_OUTINGS = 5
+
+        private val OUTINGS = setOf(HerLog.Kind.READ, HerLog.Kind.NEWS, HerLog.Kind.LOOK)
+
+        /** His cap of calls on her own, inside the bounds the settings offer. */
+        fun capOf(config: LLMConfig): Int = config.personaOwnCallsPerDay.coerceIn(1, 1_000)
+
+        fun maxMinutes(config: LLMConfig): Int = config.personaOutingMaxMinutes.coerceIn(1, 120)
+
+        fun maxSteps(config: LLMConfig): Int = config.personaOutingMaxSteps.coerceIn(1, 50)
+
+        /**
+         * What she can go and do with these settings: reading while he lets her read, and a look
+         * through the camera where one is offered now ([looking]: his switch on, her eyes open,
+         * the service holding the camera).
+         */
+        fun runnable(config: LLMConfig, looking: Boolean = false): Set<OutingKind.Kind> {
+            if (!config.personaOwnLife) return emptySet()
+            return buildSet {
+                if (config.personaReads) {
+                    add(OutingKind.Kind.READ)
+                    add(OutingKind.Kind.NEWS)
+                }
+                if (looking && config.personaCameraLooks) add(OutingKind.Kind.LOOK)
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/OwnLifeStatus.kt b/app/src/main/java/com/opendroid/ai/core/life/OwnLifeStatus.kt
