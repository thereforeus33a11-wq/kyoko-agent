+    val cardState = card ?: return
+    if (!cardState.present) return
+    LaunchedEffect(Unit) { feeds.loadFollowed() }
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .border(1.dp, BorderColor, RoundedCornerShape(12.dp)),
+        colors = CardDefaults.cardColors(containerColor = CardBackground)
+    ) {
+        Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+            Text(
+                text = "HER OWN LIFE",
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                fontFamily = FontFamily.Monospace,
+                color = AccentCyan
+            )
+            SettingSwitchRow(
+                title = OWN_LIFE_TITLE,
+                description = OWN_LIFE_HINT,
+                checked = config.personaOwnLife,
+                onCheckedChange = viewModel::updatePersonaOwnLife
+            )
+            if (!config.personaOwnLife) return@Column
+            if (!config.personaCheckInsEnabled || config.personaOwnTimeMaxPerDay <= 0) {
+                Text(text = OWN_LIFE_NEEDS_OWN_TIME, fontSize = 11.sp, color = AccentCyan)
+            }
+            SettingChoiceRow(
