+    @Test
+    fun `his voice brings nothing sooner while her ears are off or soon after he wrote`() {
+        val before = State(on = true, wake = Wake.At(now + 3 * hour), why = Why.ASKED, lastAtMillis = now - hour, moments = listOf(now - hour))
+        runBlocking { memory.saveOwnTime(before) }
+        configure { it.copy(personaOwnLife = true, personaOpenMic = false) }
+        runBlocking { engine.ownTimeOnHearingHim(heLastWroteAt = null, nowMillis = now) }
+        assertEquals(before, runBlocking { memory.ownTime() })
+        configure { it.copy(personaOwnLife = true, personaOpenMic = true) }
+        runBlocking { engine.ownTimeOnHearingHim(heLastWroteAt = now - 30 * minute, nowMillis = now) }
+        assertEquals(before, runBlocking { memory.ownTime() })
+    }
+
+    private fun answer(text: String) {
+        val content = "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\""
+        server.enqueue(
+            MockResponse.Builder().code(200).setHeader("Content-Type", "application/json")
+                .body("""{"choices":[{"message":{"content":$content},"finish_reason":"stop"}],"usage":{"prompt_tokens":100,"completion_tokens":10}}""")
+                .build()
+        )
+    }
+
+    private fun sentSystem(): String {
+        val body = JsonParser.parseString(server.takeRequest().body?.utf8().orEmpty()).asJsonObject
+        return body.getAsJsonArray("messages").first().asJsonObject.get("content").asString
+    }
+}
