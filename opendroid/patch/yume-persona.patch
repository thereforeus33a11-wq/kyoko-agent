+        assertEquals(Wake.At(now + 50 * minute), plan(Wish.At(8, 0), zone = tokyo).wake)
+        assertEquals(now + 50 * minute, PersonaOwnTime.nextClockTime(now, tokyo, 8, 0))
+        // The gap of a clock time is remembered like any other.
+        assertEquals(50 * minute, plan(Wish.At(23, 0)).chosenGapMillis)
+    }
