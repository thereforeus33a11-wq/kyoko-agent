+/**
+ * Where the owner keeps her pictures: the ones that show how she looks, each with its
+ * caption, and the one background picture with the text that lies under her awareness.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PersonaPicturesScreen(viewModel: PersonaPicturesViewModel, onNavigateBack: () -> Unit) {
+    val selfPictures by viewModel.selfPictures.collectAsState()
+    val background by viewModel.background.collectAsState()
+    val modelSeesPictures by viewModel.modelSeesPictures.collectAsState()
+    val sheIsOn by viewModel.sheIsOn.collectAsState()
+    val whereAPictureGoes by viewModel.whereAPictureGoes.collectAsState()
+    val underEnabled by viewModel.underEnabled.collectAsState()
+    val unlistedFiles by viewModel.unlistedFiles.collectAsState()
+
+    // The system photo picker hands over the one picture he picks. It needs no storage permission.
+    val imagesOnly = PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)
+    val pickSelfPicture = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
+        if (uri != null) viewModel.addSelfPicture(uri)
+    }
+    val pickBackgroundPicture = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
+        if (uri != null) viewModel.setBackgroundPicture(uri)
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(
+                        text = "HER PICTURES",
+                        fontFamily = FontFamily.Monospace,
+                        fontWeight = FontWeight.Bold,
+                        color = TextPrimary,
+                        fontSize = 20.sp
+                    )
+                },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(imageVector = Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back", tint = TextPrimary)
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBackground)
+            )
+        },
+        containerColor = DarkBackground
+    ) { padding ->
+        LaunchedEffect(Unit) { viewModel.loadUnderText() }
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding)
+                .imePadding()
+        ) {
+            Column(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 8.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                Note(
+                    "Her pictures are kept on this phone only, in the app's own storage. They are not in the gallery, " +
+                        "no other app can read them and they are not in any backup. A picture is copied in, scaled down, " +
+                        "when you add it; your original stays where it was and is not touched."
+                )
+                if (whereAPictureGoes.isNotEmpty()) Note(whereAPictureGoes)
+                if (unlistedFiles > 0) {
+                    // Left by a list that could not be read or written in full. The app deletes
+                    // a picture only when he removes it, so these wait for him.
+                    Note(
+                        "$unlistedFiles picture ${if (unlistedFiles == 1) "file" else "files"} in the app's storage " +
+                            "${if (unlistedFiles == 1) "is" else "are"} not in the lists below: the list of her " +
+                            "pictures does not name ${if (unlistedFiles == 1) "it" else "them"}, because it could not " +
+                            "be read or written in full. Kept as ${if (unlistedFiles == 1) "it is" else "they are"}, " +
+                            "never shown to her and sent nowhere. The app does not delete a picture by itself."
+                    )
+                    OutlinedButton(onClick = viewModel::deleteUnlistedFiles, modifier = Modifier.fillMaxWidth()) {
+                        Text(if (unlistedFiles == 1) "Delete that file" else "Delete those files", color = TextPrimary)
+                    }
+                }
+
+                SectionTitle("HOW SHE LOOKS")
+                Note(
+                    "Pictures of her. Where her model reads images she is shown one on her first reply in a chat and " +
+                        "whenever you talk about how she looks, so that she knows herself by sight. In every other " +
+                        "reply she is told in words what is on them. Those words are the captions: under each picture " +
+                        "stands what is on it, the way she would say it."
+                )
+                selfPictures.forEach { picture ->
+                    SelfPictureCard(
+                        picture = picture,
+                        viewModel = viewModel,
+                        canLook = modelSeesPictures && sheIsOn,
+                        looking = viewModel.lookingAt == picture.id
+                    )
+                }
+                OutlinedButton(
+                    onClick = { pickSelfPicture.launch(imagesOnly) },
