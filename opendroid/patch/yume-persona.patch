+// The badges a message of his is stored under when it answers a question the app asked:
+// a plain answer, a secret, a contact he tapped. Asked of the function that stamps them.
+private val OWNER_ANSWER_BADGES = setOf(
+    ownerRowBadge(answersPendingQuestion = true, secret = false, tapped = false),
+    ownerRowBadge(answersPendingQuestion = true, secret = true, tapped = false),
+    ownerRowBadge(answersPendingQuestion = true, secret = false, tapped = true)
+)
+
+private fun ChatMessage.isOwnersAnswer(): Boolean =
+    sender == ChatMessage.Sender.USER && modelBadge in OWNER_ANSWER_BADGES
+
+/**
+ * True when the row [messageId] in [rows] is an answer of his to a question a plan asked
+ * and nothing after it could have started another task: no message of his that is not
+ * an answer, and no command of hers, which she can give without his writing first. The
+ * plan in flight is then the one that asked, and its command and its trace stand before
+ * that answer.
+ */
+internal fun answersThePlanInFlight(rows: List<ChatMessage>, messageId: String): Boolean {
+    val at = rows.indexOfFirst { it.id == messageId }
+    if (at < 0 || !rows[at].isOwnersAnswer()) return false
+    return rows.drop(at + 1).none {
+        (it.sender == ChatMessage.Sender.USER && !it.isOwnersAnswer()) || isHerCommandRow(it.modelBadge)
+    }
+}
+
+/** How an edit stops the task in flight, by what becomes of the rows of that task's plan. */
+internal enum class EditStop {
+    /** Its rows stand after the edited message and are rewound with it: stopped at once, and no row about it. */
+    WITHOUT_A_ROW,
+
+    /** It is in another chat, which the edit does not touch: stopped at once, with the row that says so. */
+    WITH_A_ROW,
+
+    /**
+     * Its command and its trace stay in the chat that is rewound, before the edited
+     * message: stopped only once the rewind is over, so that its row is not rewound too.
+     */
+    AFTER_THE_REWIND
+}
+
+/**
+ * How the edit of the row [messageId] stops the task in flight. The plan it stops gets no
+ * row when its rows stand after the edited message: they are rewound with it, and a row
+ * written behind the rewind would be about nothing the chat still shows. It gets one when
+ * they stay: the task is pinned to another chat ([taskSessionId] is not
+ * [currentSessionId]), or the edited message is his answer to a question the plan asked
+ * ([answersThePlanInFlight] over [rows], the rows of the chat on screen). Without the
+ * row that chat would show a plan that started and nothing after it.
+ */
+internal fun editStop(
+    taskSessionId: String?,
+    currentSessionId: String?,
+    rows: List<ChatMessage>,
+    messageId: String
+): EditStop = when {
+    taskSessionId != null && taskSessionId != currentSessionId -> EditStop.WITH_A_ROW
+    answersThePlanInFlight(rows, messageId) -> EditStop.AFTER_THE_REWIND
+    else -> EditStop.WITHOUT_A_ROW
+}
