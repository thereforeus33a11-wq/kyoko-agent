--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PersonaActionsTest.kt
@@ -0,0 +1,642 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.data.models.PersonaRein
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class PersonaActionsTest {
+
+    // ── Her command line ─────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a last line after the marker is her command and is not part of what she says`() {
+        val split = PersonaActions.split("boring. fixing that\n>> play eurobeat on youtube")
+        assertEquals("boring. fixing that", split.text)
+        assertEquals("play eurobeat on youtube", split.command)
+    }
+
+    @Test
+    fun `a reply without a marker is all talk`() {
+        val split = PersonaActions.split("mm. later")
+        assertEquals("mm. later", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `a reply that is only a command has no words`() {
+        val split = PersonaActions.split(">> flashlight on\n")
+        assertEquals("", split.text)
+        assertEquals("flashlight on", split.command)
+    }
+
+    @Test
+    fun `a marker that is not the last line is removed and never run`() {
+        val split = PersonaActions.split(">> open the camera\nactually no. too dark")
+        assertEquals("actually no. too dark", split.text)
+        assertNull(split.command)
+
+        // One command per reply: of two marker lines only the last one counts.
+        val two = PersonaActions.split("watch\n>> flashlight on\n>> open the camera")
+        assertEquals("watch", two.text)
+        assertEquals("open the camera", two.command)
+    }
+
+    @Test
+    fun `a marker inside a line is just text`() {
+        val split = PersonaActions.split("he typed >> like a hacker. kimo")
+        assertEquals("he typed >> like a hacker. kimo", split.text)
+        assertNull(split.command)
+    }
+
+    @Test
+    fun `commands that are empty, symbols only or far too long are ignored`() {
+        assertNull(PersonaActions.split("ok\n>>").command)
+        assertNull(PersonaActions.split("ok\n>> ??").command)
+        assertNull(PersonaActions.split("ok\n>> " + "a".repeat(501)).command)
+        assertEquals("ok", PersonaActions.split("ok\n>> ??").text)
+    }
+
+    @Test
+    fun `a message to someone fits in a command`() {
+        val message = "text nene: " + "the keys are under the blue pot by the back door. ".repeat(8).trim()
+        assertTrue(message.length in 300..500)
+        assertEquals(message, PersonaActions.split("fine. telling her\n>> $message").command)
+        assertEquals("a".repeat(500), PersonaActions.split(">> " + "a".repeat(500)).command)
+    }
+
+    @Test
+    fun `quoting around the command is stripped`() {
+        assertEquals("set a timer for ten minutes", PersonaActions.split("fine\n>> `set a timer for ten minutes`").command)
+    }
+
+    @Test
+    fun `her command may ask for anything, the split does not look at what it says`() {
+        for (command in listOf(
+            "text nene: where are you",
+            "call the dentist",
+            "search the web for cheap flights to osaka",
+            "post good morning on telegram",
+            "delete the file notes.txt"
+        )) {
+            assertEquals(command, PersonaActions.split("mm\n>> $command").command)
+        }
+    }
+
+    // ── What stays on the phone ──────────────────────────────────────────────────────
+
+    @Test
+    fun `every action that stays on the phone exists and none of them is barred from auto approval`() {
+        val schema = ActionSchema.ALL_ACTIONS.associateBy { it.name }
+        val handlerSources = File("src/main/java/com/opendroid/ai/actions").walkTopDown()
+            .filter { it.isFile && it.extension == "kt" }
+            .joinToString("\n") { it.readText() }
+        for (name in PersonaActions.STAYS_ON_PHONE) {
+            val definition = schema[name]
+            val hasHandler = handlerSources.contains("name: String = \"$name\"") ||
+                handlerSources.contains("name = \"$name\"")
+            assertTrue("$name is not a real action", definition != null || hasHandler)
+            assertFalse("$name can never be auto-approved, so it does not run unasked", definition?.neverAutoApprove == true)
+        }
+    }
+
+    @Test
+    fun `nothing that reaches another person, a site, his money or his data stays on the phone`() {
+        val leavesThePhoneOrReadsHim = listOf(
+            // words to another person
