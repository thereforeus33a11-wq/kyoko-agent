+        herNow = herNow,
+        life = life,
+        headlines = { _, _ -> Glance.Look(emptyList(), null) },
+        herFeeds = { Feeds.DEFAULTS },
+        phone = { OutingHost.Power(80, charging = false, thermalStatus = 0) },
+        clock = { now.get() },
+        wait = { millis ->
+            now.addAndGet(millis)
+            delay(1)
+        },
+        scope = scope,
+        // A question waits until the test answers it.
+        askWait = { askGate.await() },
+        eyes = if (withEyes) eyes else null,
