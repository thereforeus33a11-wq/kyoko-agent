+package com.opendroid.ai.core.life.eyes
+
+import android.app.Application
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Color
+import android.os.Environment
+import androidx.test.core.app.ApplicationProvider
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.withOwnTimeKey
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.net.InetAddress
+import java.util.Base64
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicLong
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * Her eyes against a Venice that answers as a test tells it, with real bitmaps: the
+ * picture made ready in memory (scaled down, JPEG again, its metadata gone), one request
+ * with one picture and one instruction and nothing of his, the ledger's EYES row, what each
+ * answer of Venice's comes to, and that nothing is written to disk on the way (I6).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class HerEyesCallTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val now = AtomicLong(1_800_000_000_000L)
+    private val ledger by lazy { OwnLedger({ File(folder.root, "own_ledger.json") }, { now.get() }) }
+
+    private val venice = "Custom OpenAI Compatible"
+
+    /** A setting with things of his and hers in it that must never reach the describer. */
+    private val settings = AtomicReference(
+        LLMConfig(
+            activeProvider = venice,
+            customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+            apiKeys = mapOf(venice to "his-venice-key"),
+            personaOwnLife = true,
+            personaEyes = true,
+            personaEyesConsentAt = 1L,
+            wakePhrases = "hey Ren SENTINEL_WAKE",
+            personaChatExtraBody = """{"note":"SENTINEL_EXTRA"}""",
+            personaPictureModel = "SENTINEL_PICTURE_MODEL",
+            elevenLabsVoiceId = "SENTINEL_VOICE"
+        )
+    )
+
+    private fun eyes() = HerEyes(
+        base = OkHttpClient(),
+        settings = { settings.get() },
+        save = { update -> settings.set(update(settings.get())) },
+        ledger = ledger,
+        clock = { now.get() },
+        chatUrl = server.url("/api/v1/chat/completions").toString(),
+        listUrl = server.url("/api/v1/models").toString()
+    )
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    private fun picture(width: Int, height: Int, format: Bitmap.CompressFormat = Bitmap.CompressFormat.JPEG): ByteArray {
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        bitmap.eraseColor(Color.rgb(230, 120, 40))
+        val out = ByteArrayOutputStream()
+        bitmap.compress(format, 90, out)
+        bitmap.recycle()
+        return out.toByteArray()
+    }
+
+    /** [jpeg] with an EXIF segment put in right after its start, holding [sentinel]. */
+    private fun withExif(jpeg: ByteArray, sentinel: String): ByteArray {
+        val payload = "Exif\u0000\u0000".toByteArray(Charsets.ISO_8859_1) + "MM\u0000*GPS $sentinel".toByteArray(Charsets.ISO_8859_1)
+        val length = payload.size + 2
+        val segment = byteArrayOf(0xff.toByte(), 0xe1.toByte(), (length shr 8).toByte(), (length and 0xff).toByte()) + payload
+        return jpeg.copyOfRange(0, 2) + segment + jpeg.copyOfRange(2, jpeg.size)
+    }
+
+    private fun answer(text: String, finish: String = "stop") = MockResponse.Builder()
+        .code(200)
+        .setHeader("Content-Type", "application/json")
+        .body(
+            """{"choices":[{"message":{"content":${com.google.gson.Gson().toJson(text)}},"finish_reason":"$finish"}],"usage":{"prompt_tokens":812,"completion_tokens":44}}"""
+        )
+        .build()
+
+    private fun status(code: Int, body: String = """{"error":"no"}""") =
+        MockResponse.Builder().code(code).setHeader("Content-Type", "application/json").body(body).build()
+
+    /** Every file under the app's own and shared storage, with its size, to see that nothing was written. */
+    private fun files(): Map<String, Long> {
+        val roots = listOfNotNull(
+            context.filesDir, context.cacheDir, context.codeCacheDir, context.noBackupFilesDir, context.dataDir,
+            context.externalCacheDir, context.getExternalFilesDir(null), context.getExternalFilesDir(Environment.DIRECTORY_PICTURES),
+            Environment.getExternalStorageDirectory()
+        )
+        return roots.flatMap { root -> root.walkTopDown().filter { it.isFile }.map { it.path to it.length() }.toList() }.toMap()
+    }
+
+    @Test
+    fun `I5 and I6 - one picture, scaled down and without its metadata, one instruction, nothing of his, and nothing on disk`() = runBlocking {
+        server.enqueue(answer("A sunset over Tokyo Bay from a high window, orange light on the water.\nages: none"))
+        val before = files()
+        val original = withExif(picture(2000, 1000), "SENTINEL_EXIF")
+        val given = original.copyOf()
+
+        val seen = eyes().describe(given, Describe.Source.PAGE_IMAGE)
+
+        assertEquals(
+            HerEyes.Seen.Described("A sunset over Tokyo Bay from a high window, orange light on the water.", KidGuard.Ages.Read(emptySet())),
+            seen
+        )
+        val request = server.takeRequest(5, TimeUnit.SECONDS)!!
+        assertEquals("POST", request.method)
+        assertEquals("/api/v1/chat/completions", request.url.encodedPath)
+        assertEquals("Bearer his-venice-key", request.headers["Authorization"])
+        val text = request.body!!.utf8()
+        // Nothing of his or hers: not his wake phrases, not her chat options, no other setting, no key.
+        for (never in listOf("Ren", "SENTINEL_WAKE", "SENTINEL_EXTRA", "SENTINEL_PICTURE_MODEL", "SENTINEL_VOICE", "his-venice-key", "SENTINEL_EXIF")) {
+            assertFalse(never, text.contains(never))
+        }
+        val body = JsonParser.parseString(text).asJsonObject
+        assertEquals(setOf("model", "messages", "temperature", "max_tokens", "venice_parameters"), body.keySet())
+        val messages = body.getAsJsonArray("messages")
+        assertEquals(2, messages.size())
+        assertEquals(Describe.PAGE_IMAGE, messages[0].asJsonObject.get("content").asString)
+        val parts = messages[1].asJsonObject.getAsJsonArray("content")
+        assertEquals(2, parts.size())
+        assertEquals(Describe.TURN, parts[0].asJsonObject.get("text").asString)
+        val data = parts[1].asJsonObject.getAsJsonObject("image_url").get("url").asString
+        // The picture as sent: a JPEG, at most 1024 on its long side, its shape kept, without the EXIF it came with.
+        val sentPicture = Base64.getDecoder().decode(data.removePrefix("data:image/jpeg;base64,"))
+        assertEquals(EyesImage.Kind.JPEG, EyesImage.kindOf(sentPicture))
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(sentPicture, 0, sentPicture.size, bounds)
+        assertEquals(1024, bounds.outWidth)
+        assertEquals(512, bounds.outHeight)
+        assertFalse(String(sentPicture, Charsets.ISO_8859_1).contains("SENTINEL_EXIF"))
+        // The bytes it was given are the caller's: untouched here, for the caller to zero.
+        assertTrue(given.contentEquals(original))
+        // One call of hers, with Venice's own counts.
+        val calls = ledger.calls()!!
+        assertEquals(1, calls.size)
+        assertEquals(OwnPurpose.EYES, calls[0].purpose)
+        assertEquals("google-gemma-4-31b-it", calls[0].model)
+        assertEquals(812, calls[0].promptTokens)
+        assertEquals(44, calls[0].completionTokens)
+        // I6: no file was written anywhere the app or the phone keeps files (her ledger lives elsewhere in this test).
+        assertEquals(before, files())
+        assertFalse(File(folder.root, "own_ledger.json").readText().contains("base64"))
+    }
+
+    @Test
+    fun `her own-time key goes with her eyes where he set one`() = runBlocking {
+        settings.set(settings.get().withOwnTimeKey("her-own-key"))
+        server.enqueue(answer("A cat on a wall.\nages: none"))
+        eyes().describe(picture(300, 200), Describe.Source.FEED_IMAGE)
+        assertEquals("Bearer her-own-key", server.takeRequest(5, TimeUnit.SECONDS)!!.headers["Authorization"])
+    }
+
+    @Test
+    fun `a picture under 64 pixels, an SVG and something that is no picture are skipped before anything is sent`() = runBlocking {
+        val eyes = eyes()
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.TOO_SMALL), eyes.describe(picture(63, 400), Describe.Source.PAGE_IMAGE))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.TOO_SMALL), eyes.describe(picture(64, 63, Bitmap.CompressFormat.PNG), Describe.Source.PAGE_IMAGE))
+        val svg = """<?xml version="1.0"?><svg xmlns="http://www.w3.org/2000/svg" width="500" height="500"><rect width="500" height="500"/></svg>"""
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.NOT_A_PICTURE), eyes.describe(svg.toByteArray(), Describe.Source.PAGE_IMAGE))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.NOT_A_PICTURE), eyes.describe(ByteArray(500) { 7 }, Describe.Source.PAGE_IMAGE))
+        assertEquals(0, server.requestCount)
+        assertEquals(0, ledger.calls()!!.size)
+        // 64 by 64 is enough, and a picture already small keeps its size.
+        server.enqueue(answer("A small icon of a heart.\nages: none"))
+        assertTrue(eyes.describe(picture(64, 64, Bitmap.CompressFormat.PNG), Describe.Source.PAGE_IMAGE) is HerEyes.Seen.Described)
+        assertEquals(1, server.requestCount)
+    }
+
+    @Test
+    fun `the downscale keeps the shape and brings the long side to 1024 at most`() {
+        assertEquals(1024 to 512, EyesImage.target(2000, 1000))
+        assertEquals(576 to 1024, EyesImage.target(1080, 1920))
+        assertEquals(800 to 600, EyesImage.target(800, 600))
+        assertEquals(1024 to 1024, EyesImage.target(4096, 4096))
+        assertTrue(EyesImage.tooSmall(63, 1000))
+        assertFalse(EyesImage.tooSmall(64, 64))
+        val prepared = EyesImage.prepare(picture(3000, 600, Bitmap.CompressFormat.PNG)) as EyesImage.Prepared.Jpeg
+        assertEquals(1024, prepared.width)
+        assertEquals(205, prepared.height)
+        assertEquals(EyesImage.Kind.JPEG, EyesImage.kindOf(prepared.bytes))
+    }
+
+    @Test
+    fun `401 and 403 switch her eyes off and tell him why`() = runBlocking {
+        server.enqueue(status(401))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.KEY_REFUSED), eyes().describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertFalse(settings.get().personaEyes)
+        assertEquals(HerEyes.KEY_OFF_WHY, settings.get().personaEyesStoppedWhy)
+        // Counted as a call of hers that failed: it left the phone.
+        assertEquals(listOf(false), ledger.calls()!!.map { it.ok })
+        // Shut now: nothing more is sent.
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.OFF), eyes().describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals(1, server.requestCount)
+    }
+
+    @Test
+    fun `402 is the balance, 429 rests her eyes ten minutes, and a stock refusal is the describer declining`() = runBlocking {
+        val eyes = eyes()
+        server.enqueue(status(402))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.BALANCE), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals("the venice balance is too low", HerEyes.Why.BALANCE.words)
+        server.enqueue(status(429))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.BUSY), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.RESTING), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals(2, server.requestCount)
+        now.addAndGet(HerEyes.BACK_OFF_MILLIS)
+        server.enqueue(answer("I'm sorry, but I can't help with that."))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.DECLINED), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals("the describer would not describe it", HerEyes.Why.DECLINED.words)
+        assertEquals(3, server.requestCount)
+        assertTrue(settings.get().personaEyes)
+    }
+
+    @Test
+    fun `five unsupported answers in a row stop her eyes until he saves their settings again`() = runBlocking {
+        val eyes = eyes()
+        // A success in between starts the count again.
+        repeat(4) { server.enqueue(status(400, """{"error":"Image input is not supported for this model"}""")) }
+        server.enqueue(answer("A dog.\nages: none"))
+        repeat(5) { server.enqueue(status(400, """{"error":"Image input is not supported for this model"}""")) }
+        repeat(5) { eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE) }
+        assertEquals("", settings.get().personaEyesStoppedWhy)
+        repeat(4) { assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.UNSUPPORTED), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE)) }
+        assertEquals("", settings.get().personaEyesStoppedWhy)
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.UNSUPPORTED), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals(HerEyes.STRUCK_OUT_WHY, settings.get().personaEyesStoppedWhy)
+        // Still switched on, but stopped: nothing more goes to Venice.
+        assertTrue(settings.get().personaEyes)
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.STOPPED), eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE))
+        assertEquals(10, server.requestCount)
+        // Saving the settings of her eyes again clears the stop.
+        settings.set(settings.get().copy(personaEyesStoppedWhy = ""))
+        server.enqueue(answer("A dog again.\nages: none"))
+        assertTrue(eyes.describe(picture(200, 200), Describe.Source.PAGE_IMAGE) is HerEyes.Seen.Described)
+    }
+
+    @Test
+    fun `the model check asks Venice's list and falls back on the allowlist`() = runBlocking {
+        server.enqueue(
+            MockResponse.Builder().code(200).setHeader("Content-Type", "application/json").body(
+                """{"data":[{"id":"qwen3-vl-235b-a22b","model_spec":{"privacy":"private","capabilities":{"supportsVision":true}}},""" +
+                    """{"id":"mistral-small-3-2-24b-instruct","model_spec":{"privacy":"anonymized","capabilities":{"supportsVision":true}}}]}"""
+            ).build()
+        )
+        assertEquals(EyesModels.Verdict.Accepted(listed = true), eyes().checkModel(settings.get(), "qwen3-vl-235b-a22b"))
+        assertEquals("Bearer his-venice-key", server.takeRequest(5, TimeUnit.SECONDS)!!.headers["Authorization"])
+        server.enqueue(status(500))
+        assertEquals(EyesModels.Verdict.Accepted(listed = false), eyes().checkModel(settings.get(), "google-gemma-4-31b-it"))
+        // An Anonymized-tier id is refused without asking anyone.
+        val before = server.requestCount
+        assertTrue(eyes().checkModel(settings.get(), "claude-sonnet-45") is EyesModels.Verdict.Refused)
+        assertEquals(before, server.requestCount)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesRequestTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesRequestTest.kt
