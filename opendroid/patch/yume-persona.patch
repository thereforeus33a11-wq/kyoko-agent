+    /** A measure of a steady voice at [level] dB and [hz]. */
+    private fun at(level: Float, hz: Double): Acoustics.Measure {
+        // The sound's RMS is 0.4629 of its amplitude (three harmonics, over 1.75).
+        val amp = 10.0.pow(level / 20.0) / 0.46291
+        return Acoustics.measure(voiced(3_000, hz, amp))!!
+    }
