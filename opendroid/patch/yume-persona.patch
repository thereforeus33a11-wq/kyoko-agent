+/**
+ * What her eyes are to the code that asks them to look: whether they are open now, and a
+ * look at one picture's bytes. Her reading space is given this and nothing more: it has no
+ * camera, no screen and no model of its own.
+ */
+interface Eyes {
+
+    /** Whether a picture can be described now, as [config] stands: the reason none can is [HerEyes.gate]'s. */
+    fun open(config: LLMConfig, nowMillis: Long = System.currentTimeMillis()): Boolean
+
+    /** How many pictures may still be described today under [config], or null when the ledger cannot be read. */
+    fun leftToday(config: LLMConfig, nowMillis: Long = System.currentTimeMillis()): Int?
+
+    /**
+     * One picture described: [image] are its bytes as fetched or taken, and [source] says
+     * what it is. [image] is the caller's, and the caller zeroes it once this returns. Where
+     * her brain sees ([ownEyes]) the answer can be the picture itself, shown to her after the
+     * age check ([HerEyes.Seen.Shown]).
+     */
+    suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen
+
+    /** Whether she looks with her own eyes as [config] stands: a picture goes to her own model, not to the describer. */
+    fun ownEyes(config: LLMConfig): Boolean = false
+}
+
+/**
+ * Her eyes: a describer that is not her, on a Venice Private-tier vision model, which turns
+ * one picture into words for her. Its words go into her encrypted prompts; she never sees
+ * a picture, and the describer never writes as her.
+ *
+ * A request ([body]) holds exactly one picture and one neutral instruction (I5): a system
+ * message that is one of [Describe]'s constants, and a user turn of [Describe.TURN] and the
+ * picture as a `data:image/jpeg` URL. Nothing of hers or his goes with it: not her card, not
+ * her notes, not his name, not a setting but the model id. Venice's own system prompt is
+ * left out (`include_venice_system_prompt` false) and thinking is off.
+ *
+ * The picture is made ready in memory ([EyesImage]): decoded, scaled down to 1024 pixels on
+ * its long side, encoded again as JPEG, which drops its metadata. Under 64 × 64 pixels, an
+ * SVG and anything that is no picture are skipped before anything is sent. The bytes of the
+ * JPEG and of the request are zeroed once the call is over, and nothing is ever written to
+ * disk (I6): the client here has no cache and no cookie jar.
+ *
+ * It looks only where [gate] lets it: his switch is on and he took the consent sheet, his
+ * privacy setting is not OWN_HARDWARE, there is a Venice key (her own-time key, else his
+ * Venice provider's), the model is no Anonymized-tier one, there are looks left today
+ * ([LLMConfig.personaEyesPerDay]) and calls on her own left in the ledger. It is an
+ * explicit, switched exception to his ENCRYPTED setting, as her pictures of herself are.
+ *
+ * Each request that leaves the phone is written in her ledger as [OwnPurpose.EYES], at the
+ * call site, with Venice's token counts where it gives them; a failed one as failed.
+ *
+ * What Venice answers:
+ * - 401 or 403: her eyes are switched off and he is told on the card ([LLMConfig.personaEyesStoppedWhy]);
+ * - 402: the Venice balance is too low;
+ * - 429: her eyes rest [BACK_OFF_MILLIS];
+ * - a stock refusal: "the describer would not describe it";
+ * - [STRIKES] "unsupported" answers in a row: her eyes stop until he saves their settings
+ *   again, so that Venice's count of errors is spared.
+ */
+@Singleton
+class HerEyes internal constructor(
+    base: OkHttpClient,
+    private val settings: suspend () -> LLMConfig,
+    private val save: suspend ((LLMConfig) -> LLMConfig) -> Unit,
+    private val ledger: OwnLedger,
+    private val clock: () -> Long,
+    private val chatUrl: String = CHAT_URL,
+    private val listUrl: String = EyesModels.LIST_URL,
+    private val prepare: (ByteArray) -> EyesImage.Prepared = EyesImage::prepare
+) : Eyes {
+
+    @Inject
+    constructor(client: OkHttpClient, settings: SettingsRepository, ledger: OwnLedger) : this(
+        base = client,
+        settings = { settings.llmConfig.first() },
+        save = { update -> settings.updateConfig(update) },
+        ledger = ledger,
+        clock = System::currentTimeMillis
+    )
+
+    /** What came of a look. */
+    sealed class Seen {
+        /**
+         * The describer's [words] about the picture, without its `ages:` line, and what that
+         * line says ([ages]). [cutOff]: the words ran into the length limit.
+         */
+        data class Described(
+            val words: String,
+            val ages: KidGuard.Ages,
+            val cutOff: Boolean = false,
+            /** Who looked: the describer, or the age check run on her own model ([HerSight]). */
+            val seer: String = KidGuard.DESCRIBER
+        ) : Seen()
+
+        /**
+         * The picture goes to her own model as it is ([HerSight]): her brain sees, and the
+         * age check found no child and no teen in it ([ages]). [jpegBase64] is the picture made
+         * ready ([EyesImage]), in memory only, for the one request that carries it.
+         */
+        class Shown(val jpegBase64: String, val ages: KidGuard.Ages.Read) : Seen() {
+            // The picture must never reach a log by way of toString.
+            override fun toString(): String = "Shown(${jpegBase64.length} chars)"
+        }
+
+        /** Nothing was described, and why. */
+        data class NotSeen(val why: Why) : Seen()
+    }
+
+    /**
+     * Why nothing was described, in words for her. [sent]: the request left the phone, so it
+     * is a call of hers in the ledger and a look used on an outing.
+     */
+    enum class Why(val words: String, val sent: Boolean = false) {
+        OFF("your eyes are switched off in his settings"),
+        OWN_HARDWARE("his privacy setting keeps everything on his own hardware, so no picture goes out"),
+        NO_KEY("there is no venice key for your eyes"),
+        MODEL_REFUSED("the model set for your eyes is not a private-tier vision model"),
+        STOPPED("your eyes are stopped until he looks at their settings"),
+        RESTING("venice was busy, so your eyes rest a few minutes"),
+        DAY_USED_UP("you have no looks left today"),
+        CALLS_LOW("his calls on your own are running low"),
+        TOO_SMALL("the picture is too small to be worth a look"),
+        NOT_A_PICTURE("it is not a picture the describer can take"),
+        TOO_LARGE("the picture is too large to take"),
+        UNREADABLE("the picture could not be read"),
+        KEY_REFUSED("venice did not take the key, so your eyes are switched off and he is told", sent = true),
+        BALANCE("the venice balance is too low", sent = true),
+        BUSY("venice is busy, so your eyes rest 10 minutes", sent = true),
+        DECLINED("the describer would not describe it", sent = true),
+        UNSUPPORTED("the describer's model could not take this picture", sent = true),
+        EMPTY("the describer sent back no words", sent = true),
+        TIMEOUT("the describer took too long", sent = true),
+        NETWORK("venice could not be reached"),
+        LOST("the connection to venice broke off after the picture went out", sent = true),
+        FAILED("the describer answered with an error", sent = true),
+        AGE_CHECK_FAILED("the age check on your own model failed, so the app does not show you the picture", sent = true),
+        TOO_MANY("your model takes fewer pictures at a time than this look took, so this one was left off")
+    }
+
+    private val client: OkHttpClient = base.newBuilder()
+        .cache(null)
+        .cookieJar(CookieJar.NO_COOKIES)
+        // The picture goes to one address and nowhere else.
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .readTimeout(READ_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+        .writeTimeout(WRITE_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+        .callTimeout(CALL_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+        .build()
+
+    @Volatile private var restingUntil = 0L
+    @Volatile private var strikes = 0
+
+    /**
+     * Why no picture can be described now, as [config] stands, or null when one can. With
+     * [brainSees] the picture goes to her own model, not to the describer ([HerSight]): what
+     * only the describer needs (its key, its model, its being stopped) does not count. With
+     * [forHim] it is his act (he asked her to look): his calls are never counted (I10), so her
+     * looks of the day and her calls on her own do not count either.
+     */
+    fun gate(
+        config: LLMConfig,
+        nowMillis: Long = clock(),
+        needs: OwnLedger.Start = OwnLedger.Start.STEP,
+        brainSees: Boolean = false,
+        forHim: Boolean = false
+    ): Why? = when {
+        !config.personaEyes || config.personaEyesConsentAt <= 0L -> Why.OFF
+        config.routePolicy == RoutePolicy.OWN_HARDWARE -> Why.OWN_HARDWARE
+        !brainSees && config.personaEyesStoppedWhy.isNotBlank() -> Why.STOPPED
+        !brainSees && keyFor(config) == null -> Why.NO_KEY
+        !brainSees && !modelAllowed(modelOf(config)) -> Why.MODEL_REFUSED
+        !brainSees && nowMillis < restingUntil -> Why.RESTING
+        !forHim && (leftToday(config, nowMillis) ?: 0) <= 0 -> Why.DAY_USED_UP
+        !forHim && !ledger.canStart(needs, OwnLife.capOf(config), nowMillis) -> Why.CALLS_LOW
+        else -> null
+    }
+
+    override fun open(config: LLMConfig, nowMillis: Long): Boolean = gate(config, nowMillis) == null
+
+    override fun leftToday(config: LLMConfig, nowMillis: Long): Int? {
+        val calls = ledger.calls() ?: return null
+        val used = calls.count { it.purpose == OwnPurpose.EYES && it.at > nowMillis - OwnLedger.WINDOW_MILLIS && it.at <= nowMillis }
+        return (perDay(config) - used).coerceAtLeast(0)
+    }
+
+    override suspend fun describe(image: ByteArray, source: Describe.Source): Seen = describe(image, source, OwnLedger.Start.STEP)
+
+    /**
+     * [describe], with [needs] as what must be left in the ledger for the call to go out.
+     * With [forHim] it is his act: nothing of it is written in her ledger (I10).
+     */
+    suspend fun describe(image: ByteArray, source: Describe.Source, needs: OwnLedger.Start, forHim: Boolean = false): Seen {
+        val config = settings()
+        val now = clock()
+        gate(config, now, needs, forHim = forHim)?.let { return Seen.NotSeen(it) }
+        val key = keyFor(config) ?: return Seen.NotSeen(Why.NO_KEY)
+        val model = modelOf(config)
+        val jpeg = when (val prepared = withContext(Dispatchers.Default) { prepare(image) }) {
+            is EyesImage.Prepared.Skipped -> return Seen.NotSeen(whyOf(prepared.why))
+            is EyesImage.Prepared.Jpeg -> prepared.bytes
+        }
+        val body = try {
+            body(model, source, jpeg)
+        } finally {
+            jpeg.fill(0)
+        }
+        return try {
+            send(key, model, body, counted = !forHim)
+        } finally {
+            body.fill(0)
+        }
+    }
+
+    /** What one request came to, before it is told as a [Seen]. */
+    private sealed class Answer {
+        class Ok(val json: String) : Answer()
+        class Status(val code: Int, val text: String) : Answer()
+    }
+
+    private suspend fun send(key: String, model: String, body: ByteArray, counted: Boolean): Seen {
+        // A call of hers is written in her ledger; a look he asked for is not (I10).
+        fun record(promptTokens: Int?, completionTokens: Int?, ok: Boolean) {
+            if (counted) ledger.record(OwnPurpose.EYES, model, promptTokens, completionTokens, ok)
+        }
+        val request = request(key, body)
+        val answer = try {
+            withContext(Dispatchers.IO) {
+                client.cancellable(request) { response ->
+                    val text = response.body.string().take(MAX_ANSWER_CHARS)
+                    if (response.isSuccessful) Answer.Ok(text) else Answer.Status(response.code, text)
+                }
+            }
+        } catch (e: CancellationException) {
+            // Stopped while it was out: it may have reached Venice, and counts as a call that failed.
+            record(null, null, ok = false)
+            throw e
+        } catch (e: UnknownHostException) {
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: ConnectException) {
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: javax.net.ssl.SSLHandshakeException) {
+            // No secure connection came about: nothing of the request went out.
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: InterruptedIOException) {
+            record(null, null, ok = false)
+            return Seen.NotSeen(Why.TIMEOUT)
+        } catch (e: IOException) {
+            // Broken off once it was on its way: it may have reached Venice, so it is a call
+            // of hers and a look used, as the ledger has it.
+            record(null, null, ok = false)
+            return Seen.NotSeen(Why.LOST)
+        }
+        return when (answer) {
+            is Answer.Ok -> read(answer.json, ::record)
+            is Answer.Status -> failed(answer.code, answer.text, ::record)
+        }
+    }
+
+    /** The one request her eyes send: [body] to Venice's chat completions, on [key], and nowhere else. */
+    private fun request(key: String, body: ByteArray): Request = Request.Builder()
+        .url(chatUrl)
+        .header("Authorization", "Bearer $key")
+        .header("Accept", "application/json")
+        .post(body.toRequestBody(JSON_TYPE))
+        .build()
+
+    private suspend fun read(json: String, record: (Int?, Int?, Boolean) -> Unit): Seen {
+        val reply = parseReply(json)
+        record(reply?.promptTokens, reply?.completionTokens, reply != null)
+        reply ?: return Seen.NotSeen(Why.FAILED)
+        strikes = 0
+        val text = OpenAiCompatExtras.stripReasoning(reply.content).trim()
+        return when {
+            text.isEmpty() -> Seen.NotSeen(Why.EMPTY)
+            PersonaPictureRules.isStockRefusal(text) -> Seen.NotSeen(Why.DECLINED)
+            else -> seen(text, reply.cutOff)
+        }
+    }
+
+    private suspend fun failed(code: Int, text: String, record: (Int?, Int?, Boolean) -> Unit): Seen {
+        record(null, null, false)
+        return when {
+            code == 401 || code == 403 -> {
+                strikes = 0
+                stop(KEY_OFF_WHY, switchOff = true)
+                Seen.NotSeen(Why.KEY_REFUSED)
+            }
+            code == 402 -> Seen.NotSeen(Why.BALANCE)
+            code == 429 -> {
+                restingUntil = clock() + BACK_OFF_MILLIS
+                Seen.NotSeen(Why.BUSY)
+            }
+            unsupported(code, text) -> {
+                strikes++
+                if (strikes >= STRIKES) {
+                    strikes = 0
+                    stop(STRUCK_OUT_WHY, switchOff = false)
+                }
+                Seen.NotSeen(Why.UNSUPPORTED)
+            }
+            PersonaPictureRules.isStockRefusal(errorMessage(text)) -> Seen.NotSeen(Why.DECLINED)
+            else -> Seen.NotSeen(Why.FAILED)
+        }
+    }
+
+    /** Her eyes stop, and he is told why on the card; with [switchOff] his switch goes off too. Never fails the caller. */
+    private suspend fun stop(why: String, switchOff: Boolean) {
+        try {
+            save { current -> current.copy(personaEyes = if (switchOff) false else current.personaEyes, personaEyesStoppedWhy = why) }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "Her eyes could not be stopped in the settings: ${e.javaClass.simpleName}")
+        }
+    }
+
+    /**
+     * The age check of a picture of her that was just made, before it is shown or kept
+     * ([com.opendroid.ai.core.persona.MadePictureCheck]): the describer's model is sent the
+     * picture and [Describe.MADE_CHECK], nothing else ([checkBody]). It is part of making the
+     * picture, which he switched on and whose switch says so, so neither her eyes' switch nor
+     * her looks of the day hold it back; his privacy setting, a Venice key and a Private-tier
+     * model do. The key is the one the picture was made with ([PersonaSelfPictures.keyFor]).
+     * With [counted] it is a call of hers ([OwnPurpose.PICTURE]). What it gets back never
+     * stops her eyes or counts against them.
+     */
+    suspend fun checkMade(image: ByteArray, counted: Boolean): Seen {
+        val config = settings()
+        if (config.routePolicy == RoutePolicy.OWN_HARDWARE) return Seen.NotSeen(Why.OWN_HARDWARE)
+        val key = PersonaSelfPictures.keyFor(config, ownTime = counted) ?: return Seen.NotSeen(Why.NO_KEY)
+        val model = modelOf(config)
+        if (!modelAllowed(model)) return Seen.NotSeen(Why.MODEL_REFUSED)
+        val jpeg = when (val prepared = withContext(Dispatchers.Default) { prepare(image) }) {
+            is EyesImage.Prepared.Skipped -> return Seen.NotSeen(whyOf(prepared.why))
+            is EyesImage.Prepared.Jpeg -> prepared.bytes
+        }
+        val body = try {
+            checkBody(model, jpeg)
+        } finally {
+            jpeg.fill(0)
+        }
+        return try {
+            sendCheck(key, model, body, counted)
+        } finally {
+            body.fill(0)
+        }
+    }
+
+    private suspend fun sendCheck(key: String, model: String, body: ByteArray, counted: Boolean): Seen {
+        fun record(promptTokens: Int?, completionTokens: Int?, ok: Boolean) {
+            if (counted) ledger.record(OwnPurpose.PICTURE, model, promptTokens, completionTokens, ok)
+        }
+        val request = request(key, body)
+        val answer = try {
+            withContext(Dispatchers.IO) {
+                client.cancellable(request) { response ->
+                    val text = response.body.string().take(MAX_ANSWER_CHARS)
+                    if (response.isSuccessful) Answer.Ok(text) else Answer.Status(response.code, text)
+                }
+            }
+        } catch (e: CancellationException) {
+            record(null, null, ok = false)
+            throw e
+        } catch (e: UnknownHostException) {
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: ConnectException) {
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: javax.net.ssl.SSLHandshakeException) {
+            return Seen.NotSeen(Why.NETWORK)
+        } catch (e: InterruptedIOException) {
+            record(null, null, ok = false)
+            return Seen.NotSeen(Why.TIMEOUT)
+        } catch (e: IOException) {
+            record(null, null, ok = false)
+            return Seen.NotSeen(Why.LOST)
+        }
+        return when (answer) {
+            is Answer.Status -> {
+                record(null, null, ok = false)
+                when (answer.code) {
+                    401, 403 -> Seen.NotSeen(Why.KEY_REFUSED)
+                    402 -> Seen.NotSeen(Why.BALANCE)
+                    429 -> Seen.NotSeen(Why.BUSY)
+                    else -> if (unsupported(answer.code, answer.text)) Seen.NotSeen(Why.UNSUPPORTED) else Seen.NotSeen(Why.FAILED)
+                }
+            }
+            is Answer.Ok -> {
+                val reply = parseReply(answer.json)
+                record(reply?.promptTokens, reply?.completionTokens, reply != null)
+                val text = reply?.let { OpenAiCompatExtras.stripReasoning(it.content).trim() }
+                when {
+                    text == null -> Seen.NotSeen(Why.FAILED)
+                    text.isEmpty() -> Seen.NotSeen(Why.EMPTY)
+                    PersonaPictureRules.isStockRefusal(text) -> Seen.NotSeen(Why.DECLINED)
+                    else -> seen(text, reply.cutOff)
+                }
+            }
+        }
+    }
+
+    /**
+     * The check made when he saves a model for her eyes: Venice's list of models, fetched
+     * with the key her eyes use, or the allowlist when it cannot be had ([EyesModels.judge]).
+     */
+    suspend fun checkModel(config: LLMConfig, id: String): EyesModels.Verdict {
+        if (id.isBlank() || EyesModels.anonymized(id)) return EyesModels.judge(id, null)
+        val key = keyFor(config)
+        val listing = if (key == null || config.routePolicy == RoutePolicy.OWN_HARDWARE) {
+            null
+        } else {
+            try {
+                withContext(Dispatchers.IO) {
+                    client.cancellable(
+                        Request.Builder().url(listUrl).header("Authorization", "Bearer $key").header("Accept", "application/json").get().build()
+                    ) { response -> if (response.isSuccessful) response.body.string().take(MAX_LIST_CHARS) else null }
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                null
+            }
+        }
+        return EyesModels.judge(id, listing)
+    }
+
+    companion object {
+        private const val TAG = "HerEyes"
+
+        /** The host her eyes are on. */
+        const val HOST = PersonaSelfPictures.HOST
+
+        /** Venice's chat completions, where a picture is described. */
+        const val CHAT_URL = "https://$HOST/api/v1/chat/completions"
+
+        const val TEMPERATURE = 0.2
+        const val MAX_TOKENS = 350
+
+        /** Room for the two lines of the made-picture check ([Describe.MADE_CHECK]), and a little more. */
+        const val CHECK_MAX_TOKENS = 120
+
+        /** How long her eyes rest after Venice said it was busy (429). */
+        const val BACK_OFF_MILLIS = 10 * 60_000L
+
+        /** "Unsupported" answers in a row after which her eyes stop until he saves their settings again. */
+        const val STRIKES = 5
+
+        /** What he is told when Venice refused the key. */
+        const val KEY_OFF_WHY =
+            "Venice did not take the key her eyes used (it answered 401 or 403), so her eyes were switched off. Check the key, then switch them on again."
+
+        /** What he is told when the model kept refusing pictures. */
+        const val STRUCK_OUT_WHY =
+            "Venice answered five times in a row that the model for her eyes cannot take a picture, so her eyes stopped. Choose a model, or save these settings again, to start them."
+
+        private const val READ_TIMEOUT_SECONDS = 60L
+        private const val WRITE_TIMEOUT_SECONDS = 30L
+        private const val CALL_TIMEOUT_SECONDS = 90L
+        private const val MAX_ANSWER_CHARS = 64_000
+        private const val MAX_LIST_CHARS = 2_000_000
+
+        private val JSON_TYPE = "application/json".toMediaType()
+
+        /** What the picture's place in [body] is written as before its bytes are put in: no base64 holds it. */
+        private const val PLACE = "@@PICTURE@@"
+        private const val DATA_PREFIX = "data:image/jpeg;base64,"
+
+        /** Why a picture that could not be made ready was not looked at. */
+        fun whyOf(skip: EyesImage.Skip): Why = when (skip) {
+            EyesImage.Skip.TOO_SMALL -> Why.TOO_SMALL
+            EyesImage.Skip.NOT_A_PICTURE -> Why.NOT_A_PICTURE
+            EyesImage.Skip.TOO_LARGE -> Why.TOO_LARGE
+            EyesImage.Skip.UNREADABLE -> Why.UNREADABLE
+        }
+
+        /** The model his settings name for her eyes, or the build's own when none. */
+        fun modelOf(config: LLMConfig): String = config.personaEyesModel.trim().lowercase().ifEmpty { EyesModels.DEFAULT }
+
+        /** Whether [model] may be her eyes at all: no Anonymized-tier id. */
+        fun modelAllowed(model: String): Boolean = model.isNotBlank() && !EyesModels.anonymized(model)
+
+        /** How many pictures a day his settings allow. */
+        fun perDay(config: LLMConfig): Int = config.personaEyesPerDay.coerceIn(0, EyesBounds.MAX_PER_DAY)
+
+        /** How many pictures one outing may have described. */
+        fun perOuting(config: LLMConfig): Int = config.personaEyesPerOuting.coerceIn(0, EyesBounds.MAX_PER_OUTING)
+
+        /** The key her eyes go with: her own-time key where he set one, else his Venice provider's. Null when neither. */
+        fun keyFor(config: LLMConfig): String? = PersonaSelfPictures.keyFor(config, ownTime = true)
+
+        /**
+         * The request for one picture ([jpeg], already made ready) of [source], as the bytes
+         * that are sent: the model, one system message that is [Describe.instruction], one
+         * user message of [Describe.TURN] and the picture, the sampling, and Venice's own
+         * system prompt and thinking off. Nothing else. The picture's base64 is written into
+         * the returned bytes only, never into a string, so that it can be zeroed.
+         */
+        fun body(model: String, source: Describe.Source, jpeg: ByteArray): ByteArray =
+            bodyWith(model, Describe.instruction(source), Describe.TURN, TEMPERATURE, MAX_TOKENS, jpeg)
+
+        /**
+         * The age check of a picture just made of her ([checkMade]): the same request as
+         * [body], with [Describe.MADE_CHECK] and [Describe.MADE_CHECK_TURN], at temperature 0.
+         */
+        fun checkBody(model: String, jpeg: ByteArray): ByteArray =
+            bodyWith(model, Describe.MADE_CHECK, Describe.MADE_CHECK_TURN, 0.0, CHECK_MAX_TOKENS, jpeg)
+
+        private fun bodyWith(model: String, instruction: String, turn: String, temperature: Double, maxTokens: Int, jpeg: ByteArray): ByteArray {
+            val json = buildJsonObject {
+                put("model", model)
+                putJsonArray("messages") {
+                    addJsonObject {
+                        put("role", "system")
+                        put("content", instruction)
+                    }
+                    addJsonObject {
+                        put("role", "user")
+                        putJsonArray("content") {
+                            addJsonObject {
+                                put("type", "text")
+                                put("text", turn)
+                            }
+                            addJsonObject {
+                                put("type", "image_url")
+                                putJsonObject("image_url") { put("url", DATA_PREFIX + PLACE) }
+                            }
+                        }
+                    }
+                }
+                put("temperature", temperature)
+                put("max_tokens", maxTokens)
+                putJsonObject("venice_parameters") {
+                    put("include_venice_system_prompt", false)
+                    put("disable_thinking", true)
+                }
+            }.toString()
+            val at = json.indexOf(PLACE)
+            val head = json.substring(0, at).toByteArray(Charsets.UTF_8)
+            val tail = json.substring(at + PLACE.length).toByteArray(Charsets.UTF_8)
+            val encoded = Base64.getEncoder().encode(jpeg)
+            return try {
+                ByteArray(head.size + encoded.size + tail.size).also { out ->
+                    System.arraycopy(head, 0, out, 0, head.size)
+                    System.arraycopy(encoded, 0, out, head.size, encoded.size)
+                    System.arraycopy(tail, 0, out, head.size + encoded.size, tail.size)
+                }
+            } finally {
+                encoded.fill(0)
+            }
+        }
+
+        /** One answer of the describer, as far as the code reads it. */
+        internal data class Reply(val content: String, val cutOff: Boolean, val promptTokens: Int?, val completionTokens: Int?)
+
+        private fun JsonElement?.obj(): JsonObject? = this?.takeIf { it.isJsonObject }?.asJsonObject
+        private fun JsonObject.int(key: String): Int? =
+            get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isNumber }?.asInt
+
+        /** The describer's answer in [json] (an OpenAI-style chat completion), or null when it is none. */
+        internal fun parseReply(json: String): Reply? {
+            val root = try {
+                JsonParser.parseString(json).obj()
+            } catch (e: Exception) {
+                null
+            } ?: return null
+            val choice = root.get("choices")?.takeIf { it.isJsonArray }?.asJsonArray?.firstOrNull()?.obj() ?: return null
+            val message = choice.get("message").obj() ?: return null
+            val content = message.get("content")
+            val text = when {
+                content == null || content.isJsonNull -> ""
+                content.isJsonPrimitive -> content.asString
+                content.isJsonArray -> content.asJsonArray.mapNotNull { part ->
+                    part.obj()?.takeIf { it.get("type")?.asString == "text" }?.get("text")?.takeIf { it.isJsonPrimitive }?.asString
+                }.joinToString("\n")
+                else -> ""
+            }
+            val finish = choice.get("finish_reason")?.takeIf { it.isJsonPrimitive }?.asString.orEmpty()
+            val usage = root.get("usage").obj()
+            return Reply(text, finish.equals("length", ignoreCase = true), usage?.int("prompt_tokens"), usage?.int("completion_tokens"))
+        }
+
+        /** The describer's words as she gets them: without its `ages:` line, which the code reads. */
+        internal fun seen(text: String, cutOff: Boolean): Seen {
+            val words = KidGuard.withoutAges(text).replace(Regex("""[ \t]+"""), " ").trim()
+            return Seen.Described(words.take(MAX_WORDS_CHARS), KidGuard.ages(text), cutOff)
+        }
+
+        /** The most of the describer's words she is shown. */
+        const val MAX_WORDS_CHARS = 1_600
+
+        private val UNSUPPORTED = Regex("""(?i)unsupported|not supported|does not support|doesn't support|no vision|image input""")
+
+        /** Whether an error answer says the model cannot take what was sent. */
+        internal fun unsupported(code: Int, text: String): Boolean = code in setOf(400, 415, 422) && UNSUPPORTED.containsMatchIn(text)
+
+        private fun errorMessage(text: String): String = try {
+            JsonParser.parseString(text).obj()?.let { root ->
+                (root.get("error")?.let { if (it.isJsonObject) it.asJsonObject.get("message") else it })?.takeIf { it.isJsonPrimitive }?.asString
+            }.orEmpty()
+        } catch (e: Exception) {
+            ""
+        }
+    }
+}
