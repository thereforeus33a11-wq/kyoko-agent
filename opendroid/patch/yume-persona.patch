@@ -0,0 +1,114 @@
+package com.opendroid.ai.core.life.phone
+
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingStep
+import com.opendroid.ai.core.life.phone.PhoneVerb.Pace
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/**
+ * The closed set of what she can do on his screen, read from her `do:` line by code, and the
+ * `go:` lines that start time on his screen.
+ */
+class PhoneVerbTest {
+
+    @Test
+    fun `the verbs she can write on his screen are read, with her pace word`() {
+        val table = listOf(
+            "scroll down" to PhoneVerb.Scroll(down = true),
+            "scroll" to PhoneVerb.Scroll(down = true),
+            "scroll up" to PhoneVerb.Scroll(down = false),
+            "scroll down a bit" to PhoneVerb.Scroll(down = true, bit = true),
+            "scroll down quick" to PhoneVerb.Scroll(down = true, pace = Pace.QUICK),
+            "scroll up a little slowly" to PhoneVerb.Scroll(down = false, bit = true, pace = Pace.SLOW),
+            "next" to PhoneVerb.Scroll(down = true),
+            "more" to PhoneVerb.Scroll(down = true),
+            "swipe up" to PhoneVerb.Scroll(down = true),
+            "swipe" to PhoneVerb.Scroll(down = true),
+            "swipe down" to PhoneVerb.Scroll(down = false),
+            "open 3" to PhoneVerb.Open(n = 3),
+            "open [3]" to PhoneVerb.Open(n = 3),
+            "tap 2" to PhoneVerb.Open(n = 2),
+            "open 3 quick" to PhoneVerb.Open(n = 3, pace = Pace.QUICK),
+            "open the cat video" to PhoneVerb.Open(words = "the cat video"),
+            "open \"nene_gal profile\"" to PhoneVerb.Open(words = "nene_gal profile"),
+            "back" to PhoneVerb.Back(),
+            "go back" to PhoneVerb.Back(),
+            "back slow" to PhoneVerb.Back(Pace.SLOW),
+            "tab following" to PhoneVerb.Tab("following"),
+            "tab For You" to PhoneVerb.Tab("For You"),
+            "tab home tab" to PhoneVerb.Tab("home"),
+            "search gyaru makeup 2026" to PhoneVerb.Search("gyaru makeup 2026"),
+            "search \"渋谷 ネイル\"" to PhoneVerb.Search("渋谷 ネイル"),
+            "watch" to PhoneVerb.Watch(PhoneVerb.WATCH_DEFAULT_SECONDS),
+            "watch 20" to PhoneVerb.Watch(20),
+            "watch 20s" to PhoneVerb.Watch(20),
+            "watch it for 15 seconds" to PhoneVerb.Watch(15),
+            "watch 2 min" to PhoneVerb.Watch(PhoneVerb.WATCH_MAX_SECONDS),
+            "watch 1" to PhoneVerb.Watch(PhoneVerb.WATCH_MIN_SECONDS),
+            "stay 10" to PhoneVerb.Watch(10),
+            "done" to PhoneVerb.Done,
+            "Done." to PhoneVerb.Done
+        )
+        for ((written, expected) in table) assertEquals(written, expected, PhoneVerb.parse(written))
+    }
+
+    @Test
+    fun `an act on his account is read as refused, and what is no verb is not read`() {
+        val refused = listOf(
+            "like" to LookOnly.Act.LIKE, "like it" to LookOnly.Act.LIKE, "follow her" to LookOnly.Act.FOLLOW,
+            "subscribe" to LookOnly.Act.SUBSCRIBE, "comment omg so cute" to LookOnly.Act.COMMENT, "reply lol" to LookOnly.Act.REPLY,
+            "repost" to LookOnly.Act.POST, "dm her" to LookOnly.Act.MESSAGE, "share" to LookOnly.Act.SHARE,
+            "save" to LookOnly.Act.SAVE, "buy it" to LookOnly.Act.BUY, "gift" to LookOnly.Act.GIFT, "type hello" to LookOnly.Act.TYPING
+        )
+        for ((written, act) in refused) assertEquals(written, PhoneVerb.Refused(act), PhoneVerb.parse(written))
+        for (nothing in listOf("", "dance", "scroll sideways", "open", "tab", "search", "watch forever", "back to tiktok")) {
+            assertNull(nothing, PhoneVerb.parse(nothing))
+        }
+    }
+
+    @Test
+    fun `her step is read by the reading grammar and then here`() {
+        fun of(reply: String, cutOff: Boolean = false) = PhoneVerb.of(OutingStep.parse(reply, cutOff = cutOff).next)
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Scroll(down = true, pace = Pace.QUICK)), of("lol\ndo: scroll down quick"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Open(n = 2)), of("do: open 2"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Open(words = "the cat video")), of("do: open the cat video"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Open(n = 3)), of("do: look 3"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Search("cat videos")), of("do: search cat videos"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Back()), of("do: back"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Scroll(down = true)), of("do: more"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Refused(LookOnly.Act.FOLLOW)), of("do: follow"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Refused(LookOnly.Act.LIKE)), of("do: like"))
+        assertEquals(PhoneVerb.Reading.Verb(PhoneVerb.Watch(12)), of("do: watch 12"))
+        assertEquals(PhoneVerb.Reading.Finished, of("do: done"))
+        assertEquals(PhoneVerb.Reading.Finished, of("boring. dasai"))
+        assertEquals(PhoneVerb.Reading.CutOff, of("ok\ndo: scro", cutOff = true))
+        assertEquals(PhoneVerb.Reading.Unread("dance"), of("do: dance"))
+    }
+
+    @Test
+    fun `go lines that borrow his screen name one of his apps`() {
+        val table = listOf(
+            "scroll tiktok" to OutingKind.Parsed.Phone(OutingKind.Kind.SCROLL, HisApps.TIKTOK),
+            "scroll through insta" to OutingKind.Parsed.Phone(OutingKind.Kind.SCROLL, HisApps.INSTAGRAM),
+            "doomscroll ツイッター" to OutingKind.Parsed.Phone(OutingKind.Kind.SCROLL, HisApps.X),
+            "watch youtube" to OutingKind.Parsed.Phone(OutingKind.Kind.WATCH, HisApps.YOUTUBE),
+            "watch youtube gyaru makeup" to OutingKind.Parsed.Phone(OutingKind.Kind.WATCH, HisApps.YOUTUBE, "gyaru makeup"),
+            "watch stray cat videos on tiktok" to OutingKind.Parsed.Phone(OutingKind.Kind.WATCH, HisApps.TIKTOK, "stray cat videos"),
+            "watch eurobeat edits" to OutingKind.Parsed.Phone(OutingKind.Kind.WATCH, null, "eurobeat edits"),
+            "look at instagram" to OutingKind.Parsed.Phone(OutingKind.Kind.BROWSE, HisApps.INSTAGRAM),
+            "look pinterest" to OutingKind.Parsed.Phone(OutingKind.Kind.BROWSE, HisApps.PINTEREST),
+            "take a look around reddit" to OutingKind.Parsed.Phone(OutingKind.Kind.BROWSE, HisApps.REDDIT)
+        )
+        for ((written, expected) in table) assertEquals(written, expected, OutingKind.parse(written))
+        // The camera keeps its own words; reading keeps look up and look into.
+        assertEquals(OutingKind.Parsed.Look(OutingKind.LookAt.BACK), OutingKind.parse("look back"))
+        assertEquals(OutingKind.Parsed.Look(OutingKind.LookAt.AROUND), OutingKind.parse("look around"))
+        assertEquals(OutingKind.Parsed.Read("kogal slang", null), OutingKind.parse("look up kogal slang"))
+        assertEquals(OutingKind.Parsed.NotRead("look at the sky", OutingKind.Why.UNKNOWN), OutingKind.parse("look at the sky"))
+        assertEquals(OutingKind.Parsed.NotRead("scroll line", OutingKind.Why.NOT_AN_APP), OutingKind.parse("scroll line"))
+        assertEquals(HisApps.TIKTOK, HisApps.byPackage("com.ss.android.ugc.trill"))
+        assertNull(HisApps.byPackage("jp.naver.line.android"))
+    }
+}
