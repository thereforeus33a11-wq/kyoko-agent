@@ -0,0 +1,92 @@
+package com.opendroid.ai.ui.viewmodel
+
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What a refresh of the provider's model list may do to the model that is selected. On
+ * the providers where the id is typed by hand it may do nothing at all: an id the list
+ * does not have stays, and no other model is ever put in its place.
+ */
+class HandTypedModelTest {
+
+    private val listed = listOf("vendor/alpha", "vendor/beta")
+
+    @Test
+    fun `a listed model is kept on every provider`() {
+        for (provider in listOf("Custom OpenAI Compatible", "OpenRouter", "OpenAI", "Anthropic Claude")) {
+            assertEquals(provider, ModelAfterRefresh.KEEP, modelAfterRefresh(provider, "vendor/alpha", listed))
+        }
+    }
+
+    @Test
+    fun `a typed id on a free-form provider is kept even when the list lacks it`() {
+        assertEquals(
+            ModelAfterRefresh.KEEP_UNLISTED,
+            modelAfterRefresh("Custom OpenAI Compatible", "some-model:disable_thinking=true", listed)
+        )
+        assertEquals(ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh("OpenRouter", "vendor/model:nitro", listed))
+    }
+
+    @Test
+    fun `an id the provider has stopped listing is kept, and nothing is chosen in its place`() {
+        // It was in the list at the last fetch and is gone now: retired or renamed. Taking
+        // the first listed model instead would change which model answers without a word.
+        for (provider in listOf("Custom OpenAI Compatible", "OpenRouter")) {
+            assertEquals(provider, ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh(provider, "vendor/retired", listed))
+        }
+    }
+
+    @Test
+    fun `the untouched seed and a blank id are not replaced by a listed model either`() {
+        assertEquals(ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh("Custom OpenAI Compatible", "custom-model", listed))
+        assertEquals(ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh("OpenRouter", "openrouter/auto", listed))
+        assertEquals(ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh("Custom OpenAI Compatible", "  ", listed))
+        assertEquals(ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh("Custom OpenAI Compatible", "", listed))
+    }
+
+    @Test
+    fun `an encrypted model id is never replaced, whatever the provider`() {
+        for (provider in listOf("Custom OpenAI Compatible", "OpenRouter", "OpenAI", "Together AI")) {
+            assertEquals(
+                provider,
+                ModelAfterRefresh.KEEP_UNLISTED,
+                modelAfterRefresh(provider, "e2ee-gemma-4-26b-a4b-uncensored-p", listed)
+            )
+            assertEquals(provider, ModelAfterRefresh.KEEP_UNLISTED, modelAfterRefresh(provider, " E2EE-other ", listed))
+        }
+    }
+
+    @Test
+    fun `providers with a fixed catalogue keep the stock behaviour`() {
+        assertEquals(ModelAfterRefresh.REPLACE, modelAfterRefresh("OpenAI", "made-up-model", listed))
+        assertEquals(ModelAfterRefresh.REPLACE, modelAfterRefresh("Anthropic Claude", "claude-made-up", listed))
+        assertEquals(ModelAfterRefresh.REPLACE, modelAfterRefresh("Google Gemini", "", listed))
+    }
+
+    @Test
+    fun `the notice says which case it is`() {
+        val typed = unlistedModelNotice("Custom OpenAI Compatible", "vendor/retired")
+        assertTrue(typed, typed.contains("\"vendor/retired\""))
+        assertTrue(typed, typed.contains("nothing is chosen in its place"))
+
+        for (untouched in listOf("custom-model", "", "  ")) {
+            val notice = unlistedModelNotice("Custom OpenAI Compatible", untouched)
+            assertTrue(notice, notice.startsWith("No model is chosen for Custom OpenAI Compatible yet"))
+            assertFalse(notice, notice.contains("kept"))
+        }
+    }
+
+    @Test
+    fun `the model for her replies is recorded for the provider that writes them`() {
+        // No provider chosen for her replies: they go to the main one.
+        assertEquals("OpenRouter", personaChatModelProviderFor(LLMConfig(activeProvider = "OpenRouter")))
+        assertEquals(
+            "Custom OpenAI Compatible",
+            personaChatModelProviderFor(LLMConfig(activeProvider = "OpenRouter", personaChatProvider = " Custom OpenAI Compatible "))
+        )
+    }
+}
