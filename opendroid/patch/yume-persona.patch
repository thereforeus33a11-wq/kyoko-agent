+        assertFalse(PersonaActions.echoesOutsideText("send signed form", notifications))
+        assertFalse(PersonaActions.echoesOutsideText("flashlight on", "flashlight on"))
+        assertFalse(PersonaActions.echoesOutsideText("call kenji", notifications))
+    }
+
+    @Test
+    fun `sixty percent of the words is where an echo starts`() {
