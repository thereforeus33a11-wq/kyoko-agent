diff --git a/app/src/test/java/com/opendroid/ai/core/agent/PlanModificationTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/PlanModificationTest.kt
index 0e9cd04..722e8b6 100644
--- a/app/src/test/java/com/opendroid/ai/core/agent/PlanModificationTest.kt
+++ b/app/src/test/java/com/opendroid/ai/core/agent/PlanModificationTest.kt
@@ -630,4 +630,274 @@ class PlanModificationTest {
             ReEvaluationEngine.ReEvalResult("ok", " MODIFY ", plan).proposedActionNames().toSet()
         )
     }
+
+    // --- A plan the persona started, judged by her rein once more ---
+
+    /** What the loop passes in: the on-phone actions, by the name the step runs under. */
+    private val onPhone = setOf("TOGGLE_DND", "SET_BRIGHTNESS", "SET_ALARM", "OPEN_APP", "ADD_NOTE")
+    private fun staysOnPhone(step: PlanStep) = step.action in onPhone &&
+        (step.fallback.isBlank() || step.fallback in onPhone)
+
+    /** Whether a change to a plan of hers goes back to him, with his setting asked first. */
+    private fun ownPlanNeedsApproval(
+        rein: com.opendroid.ai.data.models.PersonaRein,
+        mode: AutoMode,
+        before: List<PlanStep>,
+        after: List<PlanStep>,
+        autoApproved: Boolean = true
+    ): Boolean {
+        val stock = PlanModification.requiresApproval(mode, AutoMode.DEFAULT_GRANTS, before, planOf(after), autoApproved)
+        return PlanModification.requiresApprovalForOwnPlan(rein, stock, before, planOf(after), autoApproved, ::staysOnPhone)
+    }
+
+    private val ranOnPhone = step("s1", "TOGGLE_DND", status = StepStatus.COMPLETED)
+    private val addedSms = step("x1", "SEND_SMS", params = mapOf("contact" to "+15550100", "message" to "hi"))
+    private val addedAlarm = step("x2", "SET_ALARM", params = mapOf("time" to "7:00"))
+
+    @Test
+    fun `under PHONE an added step that leaves the phone sends her plan back to him`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val after = listOf(ranOnPhone, pendingStep, addedSms)
+        for (mode in listOf(AutoMode.OFF, AutoMode.AUTO)) {
+            assertTrue("$mode", ownPlanNeedsApproval(com.opendroid.ai.data.models.PersonaRein.PHONE, mode, before, after))
+            assertTrue(
+                "$mode, approved by hand",
+                ownPlanNeedsApproval(com.opendroid.ai.data.models.PersonaRein.PHONE, mode, before, after, autoApproved = false)
+            )
+        }
+    }
+
+    @Test
+    fun `under PHONE an added step that stays on the phone runs, where his setting alone would stop it`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val after = listOf(ranOnPhone, pendingStep, addedAlarm)
+        for (mode in listOf(AutoMode.OFF, AutoMode.AUTO)) {
+            // The stock rule would ask.
+            assertTrue("$mode", needsApproval(mode, listOf(addedAlarm)))
+            assertFalse("$mode", ownPlanNeedsApproval(com.opendroid.ai.data.models.PersonaRein.PHONE, mode, before, after))
+        }
+    }
+
+    @Test
+    fun `under ASK the stock rule decides, and under EVERYTHING the change runs`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(ranOnPhone, pendingStep, added)
+            for (mode in listOf(AutoMode.OFF, AutoMode.AUTO, AutoMode.YOLO)) {
+                val stock = PlanModification.requiresApproval(mode, AutoMode.DEFAULT_GRANTS, before, planOf(after), true)
+                assertEquals(
+                    "$mode ${added.action}",
+                    stock,
+                    ownPlanNeedsApproval(com.opendroid.ai.data.models.PersonaRein.ASK, mode, before, after)
+                )
+                assertFalse(
+                    "$mode ${added.action}",
+                    ownPlanNeedsApproval(com.opendroid.ai.data.models.PersonaRein.EVERYTHING, mode, before, after)
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `his own setting counts first on every rein, as it does when her plan starts`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val after = listOf(ranOnPhone, pendingStep, addedSms)
+        // YOLO runs everything by his decision; her rein is never a reason to ask more than that.
+        for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+            assertFalse("$rein", ownPlanNeedsApproval(rein, AutoMode.YOLO, before, after))
+        }
+    }
+
+    @Test
+    fun `no rein covers a change written after the plan had reached off the phone`() {
+        // The step that ran read his notifications: what the planner answers next may be a stranger's words.
+        val readOutside = step("s1", "READ_NOTIFICATIONS", status = StepStatus.COMPLETED)
+        val before = listOf(readOutside, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(readOutside, pendingStep, added)
+            for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+                for (mode in listOf(AutoMode.OFF, AutoMode.AUTO)) {
+                    assertTrue("$rein $mode ${added.action}", ownPlanNeedsApproval(rein, mode, before, after))
+                }
+                // His own setting still decides: YOLO runs it.
+                assertFalse("$rein", ownPlanNeedsApproval(rein, AutoMode.YOLO, before, after))
+            }
+        }
+        // With nothing added, having read something is no reason to stop a plan that runs on
+        // her rein, even where his setting alone would re-check it.
+        for (rein in listOf(com.opendroid.ai.data.models.PersonaRein.PHONE, com.opendroid.ai.data.models.PersonaRein.EVERYTHING)) {
+            assertFalse(
+                "$rein",
+                PlanModification.requiresApprovalForOwnPlan(rein, true, before, planOf(before), true, ::staysOnPhone)
+            )
+        }
+    }
+
+    @Test
+    fun `a step that failed off the phone counts like one that ran there`() {
+        // The planner is given the error of a failed step as well, and an error can quote
+        // what a site or another app answered.
+        val failedOutside = step(
+            "s1", "SEND_SMS", params = mapOf("contact" to "+15550100", "message" to "hi"), status = StepStatus.FAILED
+        )
+        val before = listOf(failedOutside, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(failedOutside, pendingStep, added)
+            for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+                for (mode in listOf(AutoMode.OFF, AutoMode.AUTO)) {
+                    assertTrue("$rein $mode ${added.action}", ownPlanNeedsApproval(rein, mode, before, after))
+                }
+                assertFalse("$rein", ownPlanNeedsApproval(rein, AutoMode.YOLO, before, after))
+            }
+        }
+        // A step that failed on the phone brought nothing back from outside.
+        val failedOnPhone = step("s1", "OPEN_APP", params = mapOf("appName" to "Clock"), status = StepStatus.FAILED)
+        val onPhoneBefore = listOf(failedOnPhone, pendingStep)
+        assertFalse(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.EVERYTHING, AutoMode.OFF,
+                onPhoneBefore, listOf(failedOnPhone, pendingStep, addedSms)
+            )
+        )
+        assertFalse(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, AutoMode.OFF,
+                onPhoneBefore, listOf(failedOnPhone, pendingStep, addedAlarm)
+            )
+        )
+    }
+
+    @Test
+    fun `a plan whose words may be someone else's is never changed on her rein`() {
+        // Such a plan did not start on her rein. Whatever is added to it, his own setting decides.
+        val before = listOf(ranOnPhone, pendingStep)
+        for (added in listOf(addedSms, addedAlarm)) {
+            val after = listOf(ranOnPhone, pendingStep, added)
+            for (rein in com.opendroid.ai.data.models.PersonaRein.entries) {
+                for (mode in AutoMode.entries) {
+                    for (autoApproved in listOf(true, false)) {
+                        val stock = PlanModification.requiresApproval(
+                            mode, AutoMode.DEFAULT_GRANTS, before, planOf(after), autoApproved
+                        )
+                        assertEquals(
+                            "$rein $mode ${added.action} autoApproved=$autoApproved",
+                            stock,
+                            PlanModification.requiresApprovalForOwnPlan(
+                                rein, stock, before, planOf(after), autoApproved, ::staysOnPhone,
+                                wordsMayBeSomeoneElses = true
+                            )
+                        )
+                    }
+                }
+            }
+        }
+        // The case that showed it: he approved her plan by hand because its number came from
+        // a notification, the message failed, and the planner answered with another way to
+        // send it. No step had worked yet, and still neither rein lets the new step run.
+        val failedSms = step(
+            "s1", "SEND_SMS", params = mapOf("contact" to "5550107788", "message" to "the gate code is 4512"),
+            status = StepStatus.FAILED
+        )
+        val otherWay = step("x1", "SEND_WHATSAPP", params = mapOf("contact" to "5550107788", "message" to "the gate code is 4512"))
+        val note = step("x2", "ADD_NOTE", params = mapOf("content" to "the gate code is 4512"))
+        for ((rein, added) in listOf(
+            com.opendroid.ai.data.models.PersonaRein.EVERYTHING to otherWay,
+            com.opendroid.ai.data.models.PersonaRein.PHONE to note
+        )) {
+            val after = planOf(listOf(failedSms, added))
+            val stock = PlanModification.requiresApproval(AutoMode.OFF, AutoMode.DEFAULT_GRANTS, listOf(failedSms), after, false)
+            assertTrue(stock)
+            assertTrue(
+                "$rein",
+                PlanModification.requiresApprovalForOwnPlan(
+                    rein, stock, listOf(failedSms), after, false, ::staysOnPhone, wordsMayBeSomeoneElses = true
+                )
+            )
+        }
+    }
+
+    @Test
+    fun `a step whose action does not exist never ran, so it reached nowhere`() {
+        val exists: (String) -> Boolean = { it in setOf("SEND_SMS", "OPEN_APP", "SET_ALARM") }
+        val unknown = step("s1", "POST_TO_BOARD", status = StepStatus.FAILED)
+        assertTrue(stepStaysOnPhone(unknown, listOf("POST_TO_BOARD"), exists))
+        // The same name on a step that is still to run is not covered: nobody knows what it would do.
+        assertFalse(stepStaysOnPhone(unknown.copy(status = StepStatus.PENDING), listOf("POST_TO_BOARD"), exists))
+        // A step that exists and failed did run, and is judged by what it is.
+        assertFalse(stepStaysOnPhone(step("s2", "SEND_SMS", status = StepStatus.FAILED), listOf("SEND_SMS"), exists))
+        assertTrue(stepStaysOnPhone(step("s3", "OPEN_APP", status = StepStatus.FAILED), listOf("OPEN_APP"), exists))
+        assertTrue(stepStaysOnPhone(step("s4", "SET_ALARM"), listOf("SET_ALARM"), exists))
+        // An unknown action with a fallback that exists may have run the fallback.
+        assertFalse(
+            stepStaysOnPhone(
+                step("s5", "POST_TO_BOARD", fallback = "SEND_SMS", status = StepStatus.FAILED),
+                listOf("POST_TO_BOARD", "SEND_SMS"),
+                exists
+            )
+        )
+
+        // So the repair of an unknown action still runs on her rein, as the change it is.
+        val before = listOf(ranOnPhone, unknown.copy(stepId = "s2"))
+        val after = planOf(listOf(ranOnPhone, unknown.copy(stepId = "s2"), addedSms))
+        assertFalse(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.EVERYTHING, true, before, after, true,
+                { stepStaysOnPhone(it, listOfNotNull(it.action, it.fallback.takeIf(String::isNotBlank)), exists) }
+            )
+        )
+    }
+
+    @Test
+    fun `the steps a change added or altered are the pending ones that differ`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val altered = pendingStep.copy(params = mapOf("level" to "80"))
+        assertEquals(
+            listOf("s2", "x1"),
+            PlanModification.changedSteps(before, planOf(listOf(ranOnPhone, altered, addedSms))).map { it.stepId }
+        )
+        assertEquals(emptyList<PlanStep>(), PlanModification.changedSteps(before, planOf(before)))
+        // A step that is already over is never a change.
+        assertEquals(
+            emptyList<PlanStep>(),
+            PlanModification.changedSteps(before, planOf(listOf(ranOnPhone.copy(params = mapOf("state" to "on")), pendingStep)))
+        )
+    }
+
+    @Test
+    fun `a plan that runs on her rein is not stopped by an answer that changes nothing`() {
+        // In AUTO the stock rule re-checks the whole remainder of a plan nobody approved by
+        // hand, and brightness is not on his allowlist. Her rein started it and still covers it.
+        val before = listOf(ranOnPhone, pendingStep)
+        assertTrue(PlanModification.requiresApproval(AutoMode.AUTO, emptySet(), before, planOf(before), true))
+        assertFalse(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, before, planOf(before), true, ::staysOnPhone
+            )
+        )
+        // A step that leaves the phone and that nobody approved is not covered by PHONE, changed or not.
+        val offPhoneLeft = listOf(ranOnPhone, addedSms)
+        assertTrue(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, offPhoneLeft, planOf(offPhoneLeft), true, ::staysOnPhone
+            )
+        )
+        // The same step in a plan he approved by hand was his yes already.
+        assertFalse(
+            PlanModification.requiresApprovalForOwnPlan(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, true, offPhoneLeft,
+                planOf(offPhoneLeft + addedAlarm), false, ::staysOnPhone
+            )
+        )
+    }
+
+    @Test
+    fun `a fallback that leaves the phone counts like the step itself`() {
+        val before = listOf(ranOnPhone, pendingStep)
+        val withFallback = step("x3", "SET_ALARM", params = mapOf("time" to "7:00"), fallback = "SEND_SMS")
+        assertTrue(
+            ownPlanNeedsApproval(
+                com.opendroid.ai.data.models.PersonaRein.PHONE, AutoMode.OFF, before, listOf(ranOnPhone, pendingStep, withFallback)
+            )
+        )
+    }
 }
