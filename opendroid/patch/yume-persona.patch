+package com.opendroid.ai.ui.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.opendroid.ai.core.life.eyes.SightProbe
+import com.opendroid.ai.core.life.eyes.SightProber
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.llm.providers.cancellable
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import okhttp3.CookieJar
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import javax.inject.Inject
+
+/**
+ * Her own senses on the settings card ("HER OWN SENSES"): the one tap that moves her brain to
+ * a model of Venice's Private tier that sees, and back; his trust in that tier for her; the
+ * live check of Venice's list of models; the probes of whether her model sees ([SightProbe]);
+ * and whether her model hears his voice itself. Every change is his tap.
+ */
+@HiltViewModel
+class SensesViewModel @Inject constructor(
+    private val settings: SettingsRepository,
+    private val prober: SightProber,
+    private val client: OkHttpClient
+) : ViewModel() {
+
+    /** What came of the last thing he did here, in a line; empty when nothing. */
+    var notice by mutableStateOf("")
+        private set
+
+    /** True while a check or a probe is out. */
+    var busy by mutableStateOf(false)
+        private set
+
+    /** The one tap: her brain moves to the model that sees ([HerBrain.move]). */
+    fun moveBrain() = change { config ->
+        HerBrain.whyNotMove(config)?.let { why ->
+            notice = why
+            return@change config
+        }
+        notice = "Her brain is ${VenicePrivateTier.SEEING_BRAIN} now. Probe her eyes once to see that it takes pictures."
+        HerBrain.move(config)
+    }
+
+    /** The other tap: her brain goes back to what it was before the move ([HerBrain.moveBack]). */
+    fun moveBack() = change { config ->
+        notice = "Her brain is back where it was before."
+        HerBrain.moveBack(config)
+    }
+
+    /** His trust in Venice's Private tier for her. */
+    fun trust(on: Boolean) = change { it.copy(trustVenicePrivate = on) }
+
+    /** Whether his voice itself goes to her model as sound, where it hears. */
+    fun hears(on: Boolean) = change { it.copy(personaChatHearsAudio = on) }
+
+    /** Whether her model is sent pictures at all. */
+    fun sees(on: Boolean) = change { it.copy(personaChatSeesImages = on) }
+
+    private fun change(update: (LLMConfig) -> LLMConfig) {
+        viewModelScope.launch {
+            try {
+                settings.updateConfig(update)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                notice = "That could not be saved just now."
+            }
+        }
+    }
+
+    /**
+     * The live check: Venice's own list of text models, asked with his Venice key, read for
+     * which models are of the Private tier and what they take ([VenicePrivateTier.parse]), and kept.
+     */
+    fun checkList() {
+        if (busy) return
+        busy = true
+        viewModelScope.launch {
+            try {
+                val config = settings.llmConfig.first()
+                val key = VenicePrivateTier.keyOf(config)
+                notice = when {
+                    config.routePolicy == RoutePolicy.OWN_HARDWARE -> "Your privacy setting keeps everything on your own hardware, so Venice is not asked."
+                    key == null -> "\"${BuildDefaults.PROVIDER}\" is not pointed at ${BuildDefaults.ENDPOINT} with a Venice key, so Venice's list cannot be asked for."
+                    else -> {
+                        val body = withContext(Dispatchers.IO) {
+                            client.newBuilder().cache(null).cookieJar(CookieJar.NO_COOKIES).followRedirects(false).build().cancellable(
+                                Request.Builder().url(VenicePrivateTier.LIST_URL).header("Authorization", "Bearer $key")
+                                    .header("Accept", "application/json").get().build()
+                            ) { response -> if (response.isSuccessful) response.body.string().take(4_000_000) else null }
+                        }
+                        val listing = body?.let(VenicePrivateTier::parse)
+                        if (listing == null) {
+                            "Venice's list could not be read just now; this build's copy of it still decides."
+                        } else {
+                            settings.updateConfig { VenicePrivateTier.withLive(it, listing, System.currentTimeMillis()) }
+                            val private = listing.count { it.value.private == true }
+                            "Venice lists ${listing.size} text models, $private of them in its Private tier."
+                        }
+                    }
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                notice = "Venice could not be reached just now; this build's copy of its list still decides."
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    /** The probe of her model: one test picture on her route ([SightProber.probeBrain]). */
+    fun probeBrain() = probe {
+        val record = prober.probeBrain()
+        "Her model " + record.result.words + "."
+    }
+
+    /** The probe of whether a picture can go to an encrypted model ([SightProber.probeEncrypted]). */
+    fun probeEncrypted() = probe {
+        val (e2ee, tee) = prober.probeEncrypted()
+        "End to end encrypted, a picture " + e2ee.result.words + ". " +
+            (tee?.let { "In TEE-only mode (readable by Venice) ${it.model} " + it.result.words + "." } ?: "TEE-only mode was not asked: no Venice key on a provider pointed at Venice, or your privacy setting does not let a request reach Venice readable.")
+    }
+
+    private fun probe(run: suspend () -> String) {
+        if (busy) return
+        busy = true
+        viewModelScope.launch {
+            try {
+                notice = run()
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                notice = "The probe could not be made just now."
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    companion object {
+        /** What the probes found, for the card. */
+        fun probeLines(config: LLMConfig): List<String> = SightProbe.lines(config)
+    }
+}
