+        assertTrue(social.contains("putOnRecord(com.opendroid.ai.core.record.RunEntries.SocialSend.POST"))
+        assertTrue(social.contains("com.opendroid.ai.core.record.RunEntries.SocialSend.INBOX_REPLY"))
+        assertTrue(social.contains("putOnRecord(com.opendroid.ai.core.record.RunEntries.SocialSend.COMMENT_REPLY"))
+    }
+
+    @Test
+    fun `a plan goes on the record dated by when it ended`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        val put = loop.substringAfter("private fun putPlanOnRecord(").substringBefore("\n    }\n")
+        assertTrue(put.contains("endedAtMillis = System.currentTimeMillis()"))
+    }
+
+    @Test
+    fun `a plan that breaks off with an error still goes on the record`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        val put = loop.substringAfter("private fun putPlanOnRecord(").substringBefore("\n    }\n")
+        assertTrue(put.contains("planStarts.recorded(plan.planId)"))
+        // A run that breaks off with an error goes on the record, unless it is on it already; a cancel is his Stop.
+        val run = loop.substringAfter("private suspend fun executePlanLoop(").substringBefore("private suspend fun runPlanSteps(")
+        val caught = run.substringAfter("} catch (e: Exception) {")
+        assertTrue(run.indexOf("} catch (e: CancellationException) {") in 0 until run.indexOf("} catch (e: Exception) {"))
+        assertTrue(caught.contains("if (planStarts.timesRecorded(plan.planId) == recordedBefore) {"))
+        assertTrue(caught.contains("planManager.currentPlan.value?.takeIf { it.planId == plan.planId } ?: plan"))
+        assertTrue(caught.contains("PlanEntries.Ending.Stopped()"))
+        assertTrue(caught.contains("throw e"))
+    }
+
+    @Test
+    fun `a plan goes on the record as it ran`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        val put = loop.substringAfter("private fun putPlanOnRecord(").substringBefore("\n    }\n")
+        assertTrue(put.contains("ranAs = { step -> planStarts.asRun(plan.planId, step.stepId) }"))
+        // How each step really ran: noted afresh, then what he gave, then a fallback in its place.
+        val steps = loop.substringAfter("private suspend fun runPlanSteps(").substringBefore("private suspend fun pauseForRetry(")
+        val fresh = steps.indexOf("planStarts.stepStarted(currentPlanState.planId, stepToExecute.stepId)")
+        val given = steps.indexOf("planStarts.valuesGiven(currentPlanState.planId, stepToExecute.stepId, stepToExecute.action, given)")
+        val fallback = steps.indexOf("planStarts.fallbackRan(currentPlanState.planId, stepToExecute.stepId, stepToExecute.fallback)")
+        assertTrue(fresh in 0 until given)
+        assertTrue(given < fallback)
+        // What he gave: the value he typed, or the name of the contact he picked.
+        val asked = loop.substringAfter("private suspend fun resolveNeedsInput(").substringBefore("\n    }\n")
+        assertTrue(asked.contains("given = given + retry.given"))
+        assertTrue(asked.contains("gave(given)"))
+        val typed = loop.substringAfter("private suspend fun handleNeedsInput(").substringBefore("\n    }\n")
+        assertTrue(typed.contains("given = mapOf(paramKey to answer)"))
+        val picked = loop.substringAfter("private suspend fun handleContactPicker(").substringBefore("\n    }\n")
+        assertTrue(picked.contains("given = mapOf(\"contact\" to (selectedContact[\"name\"]?.takeIf { it.isNotBlank() } ?: phone))"))
+    }
+
+    @Test
+    fun `the record holds a plan as the words pass left it, never as the planning tool wrote it`() {
+        val loop = source("core/agent/AgentLoop.kt")
+        // The pass writes her words into the stored plan and drops what it left out; the plan
+        // that goes on, and so the plan the record reads when it ends, is that stored one.
+        val pass = loop.substringAfter("private suspend fun withOwnWords(").substringBefore("private suspend fun saveWordsRow(")
+        assertTrue(pass.contains("planManager.rewriteSteps(plan.planId, PlanStatus.PROPOSED, context) { live -> pass.applyTo(live) }"))
+        assertTrue(pass.contains("return stored"))
+        // Neither pass puts a plan on the record itself: one it withdrew whole ran nothing, and
+        // as it was written it still holds the planning tool's words.
+        assertFalse(pass.contains("putPlanOnRecord("))
+        // The plans of his command and hers that go on are the ones the pass gave back.
+        val his = loop.substringAfter("private suspend fun generatePlan(").substringBefore("suspend fun personaOwnTime(")
+        assertTrue(his.contains("executePlanLoop(validated, context, sessionId, autoApproved = true)"))
+        assertTrue(his.contains("proposePlan(validated, sessionId)"))
+        val hers = loop.substringAfter("private suspend fun runPersonaAction(").substringBefore("private suspend fun recordPersonaReinTrace(")
+        assertTrue(hers.contains("planStarts.started(\n                validated.planId,"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PictureMetadataTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PictureMetadataTest.kt
new file mode 100644
index 0000000..141e412
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PictureMetadataTest.kt
@@ -0,0 +1,170 @@
+package com.opendroid.ai.core.persona
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.awt.image.BufferedImage
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.util.zip.CRC32
+import javax.imageio.ImageIO
+
+/**
+ * What goes to an image model of a picture kept as given: its own pixels, byte for byte,
+ * without what the file says about itself (where a photo was taken, what made a render).
+ */
+class PictureMetadataTest {
+
+    private fun image(width: Int = 24, height: Int = 36): BufferedImage {
+        val image = BufferedImage(width, height, BufferedImage.TYPE_INT_RGB)
+        for (x in 0 until width) for (y in 0 until height) image.setRGB(x, y, (x * 9 shl 16) or (y * 7 shl 8) or 0x40)
+        return image
+    }
+
+    private fun encoded(format: String): ByteArray = ByteArrayOutputStream().use { out ->
+        assertTrue(ImageIO.write(image(), format, out))
+        out.toByteArray()
+    }
+
+    private fun pixels(bytes: ByteArray): IntArray {
+        val image = ImageIO.read(ByteArrayInputStream(bytes))!!
+        return image.getRGB(0, 0, image.width, image.height, null, 0, image.width)
+    }
+
+    private fun contains(bytes: ByteArray, text: String): Boolean = String(bytes, Charsets.ISO_8859_1).contains(text)
+
+    /** A JPEG segment: its marker, its length, [payload]. */
+    private fun segment(marker: Int, payload: ByteArray): ByteArray {
+        val length = payload.size + 2
+        return byteArrayOf(0xFF.toByte(), marker.toByte(), (length shr 8).toByte(), length.toByte()) + payload
+    }
+
+    private val secret = "GPS 35.6895N 139.6917E Pixel 9 Pro /home/owner/photos"
+
+    @Test
+    fun `a JPEG goes without its EXIF, XMP, IPTC, comments and what is packed behind it, its pixels the same`() {
+        val plain = encoded("jpg")
+        val exif = segment(0xE1, "Exif\u0000\u0000MM\u0000*$secret".toByteArray(Charsets.ISO_8859_1))
+        val xmp = segment(0xE1, "http://ns.adobe.com/xap/1.0/\u0000<x:xmpmeta>$secret</x:xmpmeta>".toByteArray(Charsets.ISO_8859_1))
+        val iptc = segment(0xED, "Photoshop 3.0\u0000$secret".toByteArray(Charsets.ISO_8859_1))
+        val mpf = segment(0xE2, "MPF\u0000$secret".toByteArray(Charsets.ISO_8859_1))
+        val comment = segment(0xFE, secret.toByteArray(Charsets.ISO_8859_1))
+        val profile = segment(0xE2, "ICC_PROFILE\u0000\u0001\u0001colour".toByteArray(Charsets.ISO_8859_1))
+        // A phone packs a motion clip or a second picture behind the end of the first.
+        val behind = "ftypmp42$secret".toByteArray(Charsets.ISO_8859_1)
+        val photo = plain.copyOfRange(0, 2) + exif + xmp + iptc + mpf + profile + comment + plain.copyOfRange(2, plain.size) + behind
+        assertTrue(contains(photo, secret))
+
+        val sent = PictureMetadata.stripped(photo)!!
+        assertFalse(contains(sent, secret))
+        assertFalse(contains(sent, "Exif"))
+        assertFalse(contains(sent, "Photoshop"))
+        // The colour profile stays: it is how the picture's colours are shown.
+        assertTrue(contains(sent, "ICC_PROFILE"))
+        // The picture itself, as it was: byte for byte once the profile is taken out again, so the same pixels.
+        val picture = sent.copyOfRange(0, 2) + sent.copyOfRange(2 + profile.size, sent.size)
+        assertArrayEquals(plain, picture)
+        assertArrayEquals(pixels(plain), pixels(picture))
+        // Already without any: the same bytes.
+        assertArrayEquals(plain, PictureMetadata.stripped(plain))
+    }
+
+    @Test
+    fun `a JPEG that cannot be read through to its end is not sent as it is`() {
+        val plain = encoded("jpg")
+        assertNull(PictureMetadata.stripped(plain.copyOfRange(0, plain.size - 2)))
+        assertNull(PictureMetadata.stripped(plain.copyOfRange(0, 40)))
+        // A segment that says it is longer than the file.
+        assertNull(PictureMetadata.stripped(plain.copyOfRange(0, 2) + byteArrayOf(0xFF.toByte(), 0xE1.toByte(), 0x7F, 0x7F, 1, 2, 3)))
+        assertNull(PictureMetadata.stripped(byteArrayOf(1, 2, 3)))
+        assertNull(PictureMetadata.stripped(ByteArray(0)))
+    }
+
+    /** A PNG chunk of [type] holding [data], with its CRC. */
+    private fun chunk(type: String, data: ByteArray): ByteArray {
+        val crc = CRC32().apply { update(type.toByteArray(Charsets.ISO_8859_1)); update(data) }.value
+        val length = data.size
+        return byteArrayOf((length shr 24).toByte(), (length shr 16).toByte(), (length shr 8).toByte(), length.toByte()) +
+            type.toByteArray(Charsets.ISO_8859_1) + data +
+            byteArrayOf((crc shr 24).toByte(), (crc shr 16).toByte(), (crc shr 8).toByte(), crc.toByte())
+    }
+
+    /** The chunk types of a PNG, in order. */
+    private fun chunks(png: ByteArray): List<String> {
+        val types = ArrayList<String>()
+        var i = 8
+        while (i + 8 <= png.size) {
+            val length = ((png[i].toInt() and 0xFF) shl 24) or ((png[i + 1].toInt() and 0xFF) shl 16) or ((png[i + 2].toInt() and 0xFF) shl 8) or (png[i + 3].toInt() and 0xFF)
+            types += String(png, i + 4, 4, Charsets.ISO_8859_1)
+            i += 12 + length
+        }
+        return types
+    }
+
+    @Test
+    fun `a PNG goes without its text, EXIF, time and private chunks, its pixels and colour chunks the same`() {
+        val plain = encoded("png")
+        val ihdrEnd = 8 + 25
+        val render = plain.copyOfRange(0, ihdrEnd) +
+            chunk("sRGB", byteArrayOf(0)) +
+            chunk("tEXt", "Software\u0000Blender $secret".toByteArray(Charsets.ISO_8859_1)) +
+            chunk("iTXt", "prompt\u0000\u0000\u0000\u0000$secret".toByteArray(Charsets.ISO_8859_1)) +
+            chunk("zTXt", "workflow\u0000\u0000xx".toByteArray(Charsets.ISO_8859_1)) +
+            chunk("eXIf", "MM\u0000*$secret".toByteArray(Charsets.ISO_8859_1)) +
+            chunk("tIME", byteArrayOf(7, 0xEA.toByte(), 11, 19, 6, 36, 0)) +
+            chunk("prVt", secret.toByteArray(Charsets.ISO_8859_1)) +
+            plain.copyOfRange(ihdrEnd, plain.size) +
+            "behind the end $secret".toByteArray(Charsets.ISO_8859_1)
+        assertTrue(contains(render, secret))
+
+        val sent = PictureMetadata.stripped(render)!!
+        assertFalse(contains(sent, secret))
+        assertEquals(listOf("IHDR", "sRGB") + chunks(plain).drop(1), chunks(sent))
+        assertArrayEquals(pixels(plain), pixels(sent))
+        // Already without any: the same bytes.
+        assertArrayEquals(plain, PictureMetadata.stripped(plain))
+        // Cut short, or a chunk longer than the file: not sent as it is.
+        assertNull(PictureMetadata.stripped(plain.copyOfRange(0, plain.size - 12)))
+        assertNull(PictureMetadata.stripped(plain.copyOfRange(0, 8) + byteArrayOf(0x7F, 0, 0, 0) + "IHDR".toByteArray()))
+    }
+
+    /** A WebP chunk of [type] holding [data], padded to an even length. */
+    private fun riffChunk(type: String, data: ByteArray): ByteArray {
+        val size = data.size
+        val padded = if (size % 2 == 1) data + byteArrayOf(0) else data
+        return type.toByteArray(Charsets.ISO_8859_1) + byteArrayOf(size.toByte(), (size shr 8).toByte(), (size shr 16).toByte(), (size shr 24).toByte()) + padded
+    }
+
+    private fun riff(vararg chunks: ByteArray): ByteArray {
+        val body = "WEBP".toByteArray(Charsets.ISO_8859_1) + chunks.fold(ByteArray(0)) { all, c -> all + c }
+        val size = body.size
+        return "RIFF".toByteArray(Charsets.ISO_8859_1) + byteArrayOf(size.toByte(), (size shr 8).toByte(), (size shr 16).toByte(), (size shr 24).toByte()) + body
+    }
+
+    @Test
+    fun `a WebP goes without its EXIF and XMP, and its header no longer says it has them`() {
+        // Extended header: colour profile (0x20), EXIF (0x08) and XMP (0x04); a 24 by 36 canvas.
+        val header = byteArrayOf(0x2C, 0, 0, 0, 23, 0, 0, 35, 0, 0)
+        val picture = byteArrayOf(0x2F, 1, 2, 3, 4, 5, 6)
+        val photo = riff(
+            riffChunk("VP8X", header),
+            riffChunk("ICCP", "colour".toByteArray()),
+            riffChunk("VP8L", picture),
+            riffChunk("EXIF", "MM\u0000*$secret".toByteArray(Charsets.ISO_8859_1)),
+            riffChunk("XMP ", "<x:xmpmeta>$secret</x:xmpmeta>".toByteArray(Charsets.ISO_8859_1))
+        )
+        val sent = PictureMetadata.stripped(photo)!!
+        assertFalse(contains(sent, secret))
+        val expected = riff(riffChunk("VP8X", byteArrayOf(0x20, 0, 0, 0, 23, 0, 0, 35, 0, 0)), riffChunk("ICCP", "colour".toByteArray()), riffChunk("VP8L", picture))
+        assertArrayEquals(expected, sent)
+        // A simple WebP without any is sent as it is; one with no picture in it is not.
+        val simple = riff(riffChunk("VP8 ", byteArrayOf(1, 2, 3, 4)))
+        assertArrayEquals(simple, PictureMetadata.stripped(simple))
+        assertNull(PictureMetadata.stripped(riff(riffChunk("EXIF", byteArrayOf(1, 2)))))
+        assertNotNull(PictureMetadata.stripped(riff(riffChunk("VP8L", picture), riffChunk("EXIF", byteArrayOf(1)))))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PictureSourcesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PictureSourcesTest.kt
new file mode 100644
index 0000000..cc0b506
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PictureSourcesTest.kt
@@ -0,0 +1,223 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.persona.PersonaPicture.Kind
+import com.opendroid.ai.core.persona.PersonaPicture.Origin
+import com.opendroid.ai.core.persona.PersonaPicture.Provenance
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * The rule of her masters: only an original or a master of her is ever sent to an image model
+ * to work from, never a picture a model made. Each way a picture could get there is held here:
+ * what is picked, what can be made into a source at all, what the requests take, and which
+ * code may send a picture to an image model to work from.
+ */
+class PictureSourcesTest {
+
+    private fun picture(
+        id: String,
+        caption: String = "",
+        origin: Origin = Origin.ADDED,
+        provenance: Provenance = Provenance.ORIGINAL,
+        made: Boolean = false,
+        view: String = "",
+        kind: Kind = Kind.SELF,
+        sheetLook: String = ""
+    ) = PersonaPicture(
+        id = id, file = "$id.png", kind = kind, caption = caption, made = made, origin = origin, provenance = provenance,
+        view = view, sheetLook = sheetLook
+    )
+
+    /** Every kind of picture of her a model made, by every way it can come. */
+    private val derived = listOf(
+        picture("hers", "full body front plate", origin = Origin.HER, provenance = Provenance.DERIVED, made = true),
+        picture("sheet", "reference sheet, her outfit, front view", origin = Origin.SHEET, provenance = Provenance.DERIVED, view = "full body, front"),
+        picture("marked", "full body front plate", origin = Origin.ADDED, provenance = Provenance.DERIVED),
+        picture("untrusted", "reference picture: full body, front", origin = Origin.BUNDLED, provenance = Provenance.DERIVED, view = "full body, front")
+    )
+
+    @Test
+    fun `a derived picture is never a source, whatever it is and wherever it came from`() {
+        for (picture in derived) {
+            assertFalse(picture.id, PictureSources.mayBeSource(picture))
+            assertNull(picture.id, SourceImage.of(picture, "BYTES"))
+        }
+        assertTrue(PictureSources.sources(derived).isEmpty())
+        // Originals and masters are, from him, from the app, or approved.
+        assertTrue(PictureSources.mayBeSource(picture("his")))
+        assertTrue(PictureSources.mayBeSource(picture("render", origin = Origin.BUNDLED)))
+        assertTrue(PictureSources.mayBeSource(picture("approved", origin = Origin.SHEET, provenance = Provenance.MASTER)))
+        assertNotNull(SourceImage.of(picture("his"), "BYTES"))
+        // The background picture is not a picture of her, and no picture without bytes is a source.
+        assertFalse(PictureSources.mayBeSource(picture("page", kind = Kind.BACKGROUND)))
+        assertNull(SourceImage.of(picture("his"), ""))
+    }
+
+    @Test
+    fun `a picture she made is derived from the start, and an entry from before the masters gets its provenance from who made it`() {
+        assertEquals(Provenance.DERIVED, PersonaPicture(id = "m", file = "m.jpg", kind = Kind.SELF, made = true).provenance)
+        assertEquals(Origin.HER, PersonaPicture(id = "m", file = "m.jpg", kind = Kind.SELF, made = true).origin)
+        val old = PersonaPictureRules.parseIndex(
+            """{"pictures":[{"id":"a","file":"a.jpg","kind":"SELF","made":false},{"id":"b","file":"b.jpg","kind":"SELF","made":true}]}"""
+        ).pictures
+        assertEquals(listOf(Provenance.ORIGINAL, Provenance.DERIVED), old.map { it.provenance })
+        assertEquals(listOf(Origin.ADDED, Origin.HER), old.map { it.origin })
+        assertEquals(listOf(false, false), old.map { it.asGiven })
+        // Kept with each picture, and read back as it was written.
+        val written = Index(derived + picture("his") + picture("render", origin = Origin.BUNDLED, provenance = Provenance.MASTER, view = "full body, back"))
+        assertEquals(written.pictures, PersonaPictureRules.parseIndex(PersonaPictureRules.encodeIndex(written)).pictures)
+    }
+
+    private fun Index(pictures: List<PersonaPicture>) = PersonaPictureRules.Index(pictures = pictures)
+
+    @Test
+    fun `nothing a model made is ever picked to match to or to start from, even where its caption would rank it first`() {
+        val face = picture("face", "face close-up")
+        val stairs = picture("stairs", "me on the stairs")
+        val all = derived + stairs + face
+        assertEquals(listOf("face", "stairs"), PersonaSelfPictures.references(all).map { it.id })
+        assertEquals("stairs", PersonaSelfPictures.editStart(all)?.id)
+        assertTrue(PersonaSelfPictures.references(derived).isEmpty())
+        assertNull(PersonaSelfPictures.editStart(derived))
+        // A master is a base; an original is started from before it.
+        val master = picture("master", "reference sheet, her outfit, front view", origin = Origin.SHEET, provenance = Provenance.MASTER, view = "full body, front")
+        assertEquals("master", PersonaSelfPictures.editStart(derived + master)?.id)
+        assertEquals("stairs", PersonaSelfPictures.editStart(derived + master + stairs)?.id)
+        // A full-body front first, a face next, a back or side view last.
+        val back = picture("back", "reference picture: full body, back", origin = Origin.BUNDLED, view = "full body, back")
+        val front = picture("front", "reference picture: full body, front", origin = Origin.BUNDLED, view = "full body, front")
+        val faceFront = picture("faceFront", "reference picture: face close-up, front", origin = Origin.BUNDLED, view = "face close-up, front")
+        assertEquals(listOf("front", "faceFront"), PersonaSelfPictures.references(listOf(back, faceFront, front)).map { it.id })
+        // A sheet in the plain base layer is never matched to: the match carries her outfit over.
+        val baseLayer = picture(
+            "base", "reference sheet, plain fitted base layer, front view", origin = Origin.SHEET, provenance = Provenance.MASTER,
+            view = "full body, front", sheetLook = ReferenceSheets.Look.BASE_LAYER.name
+        )
+        assertEquals(listOf("faceFront"), PersonaSelfPictures.references(listOf(baseLayer, faceFront)).map { it.id })
+    }
+
+    @Test
+    fun `an original or a master captioned as the girl before, younger, at a school or with someone else is never a base`() {
+        val guarded = listOf(
+            picture("before", "Satomi, before look, full body front"),
+            picture("younger", "full body front, when I was 15"),
+            picture("withHim", "me side by side with him, full body side"),
+            picture("school", "full body back at school", origin = Origin.SHEET, provenance = Provenance.MASTER)
+        )
+        val stairs = picture("stairs", "me on the stairs")
+        assertEquals(listOf("stairs"), PersonaSelfPictures.bases(guarded + stairs).map { it.id })
+        assertTrue(PersonaSelfPictures.bases(guarded).isEmpty())
+        assertTrue(PersonaSelfPictures.references(guarded).isEmpty())
+        assertNull(PersonaSelfPictures.editStart(guarded))
+        // And never one a model made, whatever its caption.
+        assertTrue(PersonaSelfPictures.bases(derived).isEmpty())
+    }
+
+    @Test
+    fun `what he can change about a picture, and nothing else`() {
+        val his = picture("his")
+        assertEquals(Provenance.DERIVED, PictureSources.changed(his, Provenance.DERIVED)?.provenance)
+        assertNull(PictureSources.changed(his, Provenance.MASTER))
+        assertEquals(Provenance.ORIGINAL, PictureSources.changed(his.copy(provenance = Provenance.DERIVED), Provenance.ORIGINAL)?.provenance)
+        val sheet = derived[1]
+        assertEquals(Provenance.MASTER, PictureSources.changed(sheet, Provenance.MASTER)?.provenance)
+        assertNull(PictureSources.changed(sheet, Provenance.ORIGINAL))
+        assertEquals(Provenance.DERIVED, PictureSources.changed(sheet.copy(provenance = Provenance.MASTER), Provenance.DERIVED)?.provenance)
+        val render = picture("render", origin = Origin.BUNDLED)
+        assertEquals(Provenance.DERIVED, PictureSources.changed(render, Provenance.DERIVED)?.provenance)
+        assertEquals(Provenance.MASTER, PictureSources.changed(render.copy(provenance = Provenance.DERIVED), Provenance.MASTER)?.provenance)
+        // A picture she made stays derived: it is never approved into a base.
+        for (to in Provenance.entries) assertNull(to.name, PictureSources.changed(derived[0], to))
+        // Nothing but the provenance changes, and the change is marked as his, so the app never sets it back.
+        assertEquals(sheet.copy(provenance = Provenance.MASTER, provenanceByOwner = true), PictureSources.changed(sheet, Provenance.MASTER))
+        // Through the index too, by id, and not for an id that is not there.
+        val index = Index(listOf(sheet, his))
+        assertEquals(Provenance.MASTER, PersonaPictureRules.withProvenance(index, "sheet", Provenance.MASTER)!!.pictures.first().provenance)
+        assertNull(PersonaPictureRules.withProvenance(index, "nobody", Provenance.MASTER))
+        assertNull(PersonaPictureRules.withProvenance(index, "hers", Provenance.MASTER))
+    }
+
+    @Test
+    fun `where her pictures are listed each says what it is, and offers the one change he can make`() {
+        assertEquals("Original · kept as you gave it", PictureSources.line(picture("his").copy(asGiven = true)))
+        assertEquals("Original · stored smaller (added before this build)", PictureSources.line(picture("his")))
+        assertEquals("Original · came with the app", PictureSources.line(picture("r", origin = Origin.BUNDLED)))
+        assertEquals("Master · came with the app", PictureSources.line(picture("r", origin = Origin.BUNDLED, provenance = Provenance.MASTER)))
+        assertEquals("Derived · you took it out of the bases", PictureSources.line(PictureSources.changed(picture("r", origin = Origin.BUNDLED), Provenance.DERIVED)!!))
+        assertEquals(PictureSources.RETIRED_LINE, PictureSources.line(picture("r", origin = Origin.BUNDLED, provenance = Provenance.DERIVED)))
+        assertEquals("Master · approved by you", PictureSources.line(PictureSources.changed(picture("r", origin = Origin.BUNDLED, provenance = Provenance.DERIVED), Provenance.MASTER)!!))
+        assertEquals("Master · approved by you", PictureSources.line(picture("s", origin = Origin.SHEET, provenance = Provenance.MASTER)))
+        assertEquals("Derived · she made it", PictureSources.line(derived[0]))
+        assertEquals("Derived · reference sheet, waiting for your approval", PictureSources.line(derived[1]))
+        assertEquals(PictureSources.Choice(PictureSources.APPROVE, Provenance.MASTER), PictureSources.choice(derived[1]))
+        assertEquals(PictureSources.Choice(PictureSources.MADE_BY_A_MODEL, Provenance.DERIVED), PictureSources.choice(picture("his")))
+        assertEquals(PictureSources.Choice(PictureSources.IS_ORIGINAL, Provenance.ORIGINAL), PictureSources.choice(derived[2]))
+        assertNull(PictureSources.choice(derived[0]))
+        // Every offered change is one he can make.
+        for (p in derived + picture("his") + picture("r", origin = Origin.BUNDLED, provenance = Provenance.MASTER)) {
+            PictureSources.choice(p)?.let { assertNotNull(p.id, PictureSources.changed(p, it.to)) }
+        }
+    }
+
+    @Test
+    fun `the requests that send her pictures to work from take only sources, and a match without any says so`() {
+        val plan = SelfPicturePlans.newPicture(PictureModels.WAI, "on a rooftop at night", refs("R1", "R2"), match = true, seed = 5)
+        val matched = Json.parseToJsonElement(plan.match!!.invoke("NEW").body).jsonObject
+        assertEquals(listOf("NEW", "R1", "R2"), matched["images"]!!.jsonArray.map { it.jsonPrimitive.content })
+        // With the match on and no original or master, it is drawn from words and kept with a plain note.
+        val alone = SelfPicturePlans.newPicture(PictureModels.WAI, "on a rooftop at night", emptyList(), match = true, seed = 5)
+        assertNull(alone.match)
+        assertEquals("It was not matched to her own pictures: she has no original or master picture to match it to.", alone.note)
+        assertTrue(alone.note.startsWith(SelfPictureMaker.NOT_MATCHED_PREFIX))
+        assertEquals("", SelfPicturePlans.newPicture(PictureModels.WAI, "x", emptyList(), match = false, seed = 5).note)
+        val change = SelfPicturePlans.change(PictureModels.QWEN_EDIT, src("HIS"), "red nails")
+        assertEquals("HIS", Json.parseToJsonElement(change.first.body).jsonObject["image"]!!.jsonPrimitive.content)
+    }
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    @Test
+    fun `only the requests that take sources send a picture of her to an image model to work from`() {
+        // The only calls of the edit endpoints, which take pictures to work from.
+        val callers = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { Regex("""VeniceImages\.(?:edit|multiEdit)\(""").containsMatchIn(it.readText()) }
+            .map { it.relativeTo(main).path.replace('\\', '/') }
+            .toSet()
+        assertEquals(setOf("core/persona/SelfPicturePlans.kt", "core/persona/ReferenceSheets.kt"), callers)
+        // And there, the pictures they send are sources: only the new picture of a match is not.
+        val plans = File(main, "core/persona/SelfPicturePlans.kt").readText()
+        assertTrue(plans.contains("references: List<SourceImage>,"))
+        assertTrue(plans.contains("source: SourceImage,"))
+        assertTrue(plans.contains("fun trial(model: PictureModels.Model, references: List<SourceImage>, source: SourceImage?,"))
+        assertTrue(plans.contains("VeniceImages.multiEdit(PictureModels.MATCH, listOf(made) + theirs, matchPrompt, shape.ratio)"))
+        assertTrue(plans.contains("val theirs = references.take(PictureModels.MATCH_IMAGES - 1).map { it.base64 }"))
+        val sheets = File(main, "core/persona/ReferenceSheets.kt").readText()
+        assertTrue(sheets.contains("fun call(sheet: Sheet, source: SourceImage, also: List<SourceImage>, age: Int = PersonaAge.AGE_IN_FILES): VeniceImages.Call {"))
+        // A source is made in one place in the app: the store, from the picture as it holds it now.
+        val makers = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { it.readText().contains("SourceImage.of(") }
+            .map { it.relativeTo(main).path.replace('\\', '/') }
+            .toSet()
+        assertEquals(setOf("core/persona/PersonaPictures.kt"), makers)
+        val store = File(main, "core/persona/PersonaPictures.kt").readText()
+        assertTrue(store.contains("val (picture, file) = lock.withLock { entryOf(id) }?.takeIf { (picture, _) -> PictureSources.mayBeSource(picture) }"))
+        // Her action, the try and the sheets read their pictures to work from there and nowhere else.
+        val actions = File(main, "actions/PersonaPictureActions.kt").readText()
+        assertTrue(actions.contains("PersonaSelfPictures.references(all).mapNotNull { pictures.source(it.id) }"))
+        assertTrue(actions.contains("val source = pictures.source(named.id) ?: return ActionResult("))
+        assertTrue(actions.contains("if (!com.opendroid.ai.core.persona.PictureSources.mayBeSource(named)) {"))
+        assertTrue(actions.contains("return ActionResult(false, null, PersonaSelfPictures.NOT_A_BASE_WHY)"))
+        val trial = File(main, "ui/viewmodel/PictureModelsViewModel.kt").readText()
+        assertTrue(trial.contains("source = { id -> pictures.source(id) },"))
+        assertTrue(trial.contains("val start = PersonaSelfPictures.editStart(all)?.let { source(it.id) }"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/PictureTrialTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/PictureTrialTest.kt
new file mode 100644
index 0000000..f4be27d
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/PictureTrialTest.kt
@@ -0,0 +1,109 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.eyes.HerEyes
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * "Try picture models": one test picture per chosen model, the same scene and seed for each,
+ * each through the age check like any picture of her; one that does not pass is not shown
+ * and is counted; the pictures stay in memory and nothing is kept; each is priced.
+ */
+class PictureTrialTest {
+
+    private fun png(mark: Int) = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), mark.toByte())
+
+    private class Counted : SelfPictureMaker.Counts {
+        val kept = CopyOnWriteArrayList<String>()
+        val notKept = CopyOnWriteArrayList<String>()
+        override fun kept() { kept += "kept" }
+        override fun notKept(category: String) { notKept += category }
+    }
+
+    @Test
+    fun `each chosen model makes one test picture, same scene and seed, age-checked, priced, and nothing kept`() = runBlocking {
+        val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+        val counts = Counted()
+        // The anime model's picture reads as a teen; the rest as adults; krea fails.
+        val maker = SelfPictureMaker(
+            send = { call ->
+                sent += call
+                when (call.model) {
+                    PictureModels.KREA_TURBO.id -> VeniceImages.Made.Failed("The image service is busy. Try again in a minute.")
+                    PictureModels.WAI.id -> VeniceImages.Made.Picture(png(1))
+                    else -> VeniceImages.Made.Picture(png(2))
+                }
+            },
+            check = { image, counted ->
+                assertTrue("a try is his act, never counted as hers", !counted)
+                val answer = if (image[4] == 1.toByte()) "ages: teen" else "ages: adult"
+                MadePictureCheck.judge(HerEyes.Seen.Described("", KidGuard.ages(answer), seer = KidGuard.AGE_CHECK))
+            },
+            counts = counts
+        )
+        val entries = CopyOnWriteArrayList<PictureTrial.Entry>()
+        val chosen = listOf(PictureModels.WAI, PictureModels.LUSTIFY_V8, PictureModels.KREA_TURBO, PictureModels.QWEN_EDIT, PictureModels.WAI)
+        PictureTrial(maker).run(chosen, references = emptyList(), source = src("HER_PICTURE"), match = false, seed = 4242) { entries += it }
+
+        // Each model once, in order.
+        assertEquals(listOf("wai-Illustrious", "lustify-v8", "krea-2-turbo", "qwen-edit-uncensored"), entries.map { it.model.id })
+        assertEquals(listOf("wai-Illustrious", "lustify-v8", "krea-2-turbo", "qwen-edit-uncensored"), sent.map { it.model })
+        // The same seed and scene for every generate model; the edit model starts from her picture.
+        for (call in sent.filter { it.endpoint == VeniceImages.Endpoint.GENERATE }) {
+            val body = Json.parseToJsonElement(call.body).jsonObject
+            assertEquals(4242, body["seed"]!!.jsonPrimitive.int)
+            assertTrue(body["prompt"]!!.jsonPrimitive.content.contains(PicturePrompts.TRIAL_SCENE))
+            assertTrue(PictureGuard.guardedNegative(body["negative_prompt"]!!.jsonPrimitive.content))
+        }
+        val edit = sent.single { it.endpoint == VeniceImages.Endpoint.EDIT }
+        assertEquals("HER_PICTURE", Json.parseToJsonElement(edit.body).jsonObject["image"]!!.jsonPrimitive.content)
+
+        // Read as a teen: not shown, said as thrown away, counted.
+        val wai = entries[0].shown as PictureTrial.Shown.NotShown
+        assertTrue(wai.thrownAway)
+        assertTrue(wai.why.startsWith("Not kept: the picture came out wrong: the age check read the woman drawn as a teen"))
+        assertEquals(listOf("kid:TEEN"), counts.notKept)
+        // Passed: shown from memory.
+        assertTrue(entries[1].shown is PictureTrial.Shown.Picture)
+        assertTrue(entries[3].shown is PictureTrial.Shown.Picture)
+        // A failed request: said as it failed, nothing thrown away.
+        val krea = entries[2].shown as PictureTrial.Shown.NotShown
+        assertEquals("The image service is busy. Try again in a minute.", krea.why)
+        assertTrue(!krea.thrownAway)
+        // Nothing is ever kept by a try.
+        assertTrue(counts.kept.isEmpty())
+        // Priced as each model is.
+        assertEquals(listOf(0.01, 0.01, 0.04, 0.04), entries.map { it.cost })
+        assertEquals(0.10, PictureTrial.cost(chosen, match = false, hasReferences = false), 1e-9)
+        // Matched to her pictures: 4 cents more for each generate model, none for the edit model.
+        assertEquals(0.22, PictureTrial.cost(chosen, match = true, hasReferences = true), 1e-9)
+        assertEquals(0.10, PictureTrial.cost(chosen, match = true, hasReferences = false), 1e-9)
+    }
+
+    @Test
+    fun `with the match on, a test picture is age-checked, matched to his pictures, and checked again, and an edit model without a picture is said as such`() = runBlocking {
+        val sent = CopyOnWriteArrayList<VeniceImages.Call>()
+        val checked = CopyOnWriteArrayList<Byte>()
+        val maker = SelfPictureMaker(
+            send = { call -> sent += call; VeniceImages.Made.Picture(png(if (call.endpoint == VeniceImages.Endpoint.MULTI_EDIT) 9 else 1)) },
+            check = { image, _ -> checked += image[4]; MadePictureCheck.Verdict.Adult },
+            counts = Counted()
+        )
+        val entries = CopyOnWriteArrayList<PictureTrial.Entry>()
+        PictureTrial(maker).run(listOf(PictureModels.WAI, PictureModels.QWEN_EDIT), refs("R1", "R2"), source = null, match = true, seed = 1) { entries += it }
+        assertEquals(listOf(VeniceImages.Endpoint.GENERATE, VeniceImages.Endpoint.MULTI_EDIT), sent.map { it.endpoint })
+        // The drawn picture is checked before it is sent on with his pictures; the matched one is checked and shown.
+        assertEquals(listOf(1.toByte(), 9.toByte()), checked)
+        assertEquals(9.toByte(), (entries[0].shown as PictureTrial.Shown.Picture).bytes[4])
+        assertEquals(0.05, entries[0].cost, 1e-9)
+        assertEquals(PictureTrial.NO_SOURCE, (entries[1].shown as PictureTrial.Shown.NotShown).why)
+    }
+}
