+/** How a stretch of speech sounded: the phone's measures, the recogniser's tags, his usual, and the words for her. */
+class HowItSoundedTest {
+
+    private val rate = 16_000
+
+    /** A voice-like sound: a pitch [hz] (it may glide to [toHz]) with its first harmonics, at [amp]. */
+    private fun voiced(millis: Int, hz: Double, amp: Double = 0.1, toHz: Double = hz): FloatArray {
+        val n = millis * rate / 1000
+        var phase = 0.0
+        return FloatArray(n) { i ->
+            // A glide even in semitones, so its percentiles are easy to know.
+            val f = hz * (toHz / hz).pow(i.toDouble() / n)
+            phase += 2 * PI * f / rate
+            (amp * (sin(phase) + 0.5 * sin(2 * phase) + 0.25 * sin(3 * phase)) / 1.75).toFloat()
+        }
+    }
+
+    private fun noise(millis: Int, amp: Double, seed: Long = 1): FloatArray {
+        val r = Random(seed)
+        return FloatArray(millis * rate / 1000) { (r.nextGaussian() * amp).toFloat() }
+    }
+
+    private fun silence(millis: Int) = noise(millis, 0.0001, seed = 9)
+
+    @Test
+    fun `a steady voice has its pitch, is all voiced, has no pauses, and is flat`() {
+        val m = Acoustics.measure(voiced(2_000, 150.0))!!
+        assertEquals(150f, m.pitchHz!!, 3f)
+        assertEquals(Acoustics.semitones(150f), m.pitchSemitones!!, 0.2f)
+        assertTrue(m.voicedShare > 0.9f)
+        assertTrue(m.pitchSpread!! < 0.5f)
+        assertEquals(0, m.pauses)
+        assertTrue("level ${m.levelDb}", m.levelDb in -28f..-25f)
+        assertEquals(0f, m.clippedShare)
+        assertEquals(Manner.ORDINARY, Manner.of(m, null, null, null))
+        val how = HowItSounded.judge(m, null, emptyList(), 0, "en", null)
+        assertEquals(listOf("flat"), how.phrases())
+    }
+
+    @Test
+    fun `a glide of an octave moves about ten semitones from its 10th to its 90th percentile`() {
+        val m = Acoustics.measure(voiced(2_000, 120.0, toHz = 240.0))!!
+        assertEquals(9.6f, m.pitchSpread!!, 1.2f)
+        assertEquals(Acoustics.semitones(170f), m.pitchSemitones!!, 1f)
+    }
+
+    @Test
+    fun `a whisper is hardly voiced at all`() {
+        val m = Acoustics.measure(silence(200) + noise(1_500, 0.03) + silence(200))!!
+        assertTrue("voiced ${m.voicedShare}", m.voicedShare < Manner.WHISPER_VOICED_SHARE)
+        assertEquals(Manner.WHISPER, Manner.of(m, null, null, null))
+        // Even against his usual, a whisper is a whisper.
+        assertEquals(Manner.WHISPER, Manner.of(m, 12f, 5f, 5f))
+        assertEquals("whispering", HowItSounded.judge(m, null, emptyList(), 0, null, null).phrases().first())
+    }
+
+    @Test
+    fun `pauses inside the speech are found and taken off the time words had`() {
+        val m = Acoustics.measure(voiced(800, 140.0) + silence(500) + voiced(800, 140.0) + silence(400) + voiced(800, 140.0))!!
