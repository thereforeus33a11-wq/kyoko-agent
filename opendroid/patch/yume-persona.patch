+package com.opendroid.ai.core.life.ears
+
+import kotlin.math.abs
+import kotlin.math.ln
+import kotlin.math.log10
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sqrt
+
+/**
+ * How a stretch of speech sounded, besides its words: so that she gets how he said a thing,
+ * not only what. Two sources, each named for what it is:
+ *
+ *  - the recogniser's own tags (SenseVoice only): its guess at the tone ([tone]: happy, sad,
+ *    angry...) and the sound it heard ([sounds]: laughter, crying, a cough, music...);
+ *  - the phone's own measures of the sound ([Acoustics]): how loud, how high and how varied
+ *    the voice was, how much of it was voiced at all (a whisper is not), how fast the words
+ *    came, and where he stopped. Measured against [SoundUsual], his usual, where there is one.
+ *
+ * Pure, and in memory only like the rest of what the ears hear (I6). [phrases] puts it in a
+ * few plain words; nothing here names a feeling from the measures: that is hers to make of
+ * them.
+ */
+class HowItSounded(
+    /** The recogniser's guess at the tone; null when it gave none (or Moonshine, which has none). */
+    val tone: Tone?,
+    /** Sounds the recogniser heard besides speech, or that were the whole of it. */
+    val sounds: List<SoundEvent>,
+    /** How the voice was used. */
+    val manner: Manner,
+    /** The phone's measures; null when nothing was measured (a voice not his, not written down). */
+    val measure: Acoustics.Measure?,
+    /** Loudness against his usual, in dB; null without a usual. */
+    val louderByDb: Float?,
+    /** Pitch against his usual, in semitones; null without a usual or a pitch. */
+    val higherBySemitones: Float?,
+    /** How much his pitch moved (semitones, 10th to 90th percentile) against his usual; null without. */
+    val livelierBySemitones: Float?,
+    /** Words a minute, pauses inside included (a speaking rate); null when too few to tell. */
+    val wordsPerMinute: Float?,
+    /** [wordsPerMinute] over his usual in the same language; null without. */
+    val rateVsUsual: Float?,
+    /** Silence between his last stretch of speech and this one, when it was a pause in his talk. */
+    val pauseBeforeMillis: Long?,
+    /** How long after the phone's last line ended this began, when within [HowItSounded.AFTER_HER_MILLIS]. */
+    val afterHerMillis: Long?,
+) {
+    /**
+     * What stood out, in a few plain words each, most telling first; empty when nothing did.
+     * The tone is marked as the phone's guess, since it is one. Pauses and stops are said the
+     * way a person in the room would notice them, not in seconds.
+     */
+    fun phrases(): List<String> {
+        val out = ArrayList<String>()
+        for (s in sounds) out += s.words
+        when (manner) {
+            Manner.WHISPER -> out += "whispering"
+            Manner.SHOUT -> out += "shouting"
+            Manner.RAISED -> out += "a raised voice"
+            Manner.SOFT -> out += "quietly"
+            Manner.ORDINARY -> Unit
+        }
+        tone?.takeIf { it != Tone.NEUTRAL }?.let { out += "the phone guessed it sounded ${it.words}" }
+        louderByDb?.let { d ->
+            if (manner == Manner.ORDINARY && d >= LOUDER_DB) out += "louder than he usually talks"
+            if (manner == Manner.ORDINARY && d <= -QUIETER_DB) out += "quieter than he usually talks"
+        }
+        higherBySemitones?.let { d ->
+            if (d >= HIGHER_ST) out += "higher-pitched than usual"
+            if (d <= -LOWER_ST) out += "lower-pitched than usual"
+        }
+        val m = measure
+        val lively = livelierBySemitones
+        if (lively != null) {
+            if (lively >= LIVELIER_ST) out += "more up-and-down than usual"
+            if (lively <= -FLATTER_ST) out += "flatter than usual"
+        } else if (m?.pitchSpread != null && m.voicedMillis >= MIN_PITCH_MILLIS && m.pitchSpread < FLAT_ST) {
+            out += "flat"
+        }
+        rateVsUsual?.let { r ->
+            if (r >= FAST_RATIO) out += "faster than he usually talks"
+            if (r <= SLOW_RATIO) out += "slower than he usually talks"
+        } ?: wordsPerMinute?.let { w ->
+            if (w >= FAST_WPM) out += "fast"
+            if (w <= SLOW_WPM) out += "slow"
+        }
+        if (m != null && m.pauses >= HESITANT_PAUSES) out += if (m.pauses == HESITANT_PAUSES) "with a couple of stops" else "with several stops"
+        pauseBeforeMillis?.let { if (it >= LONG_PAUSE_MILLIS) out += if (it >= VERY_LONG_PAUSE_MILLIS) "after a long pause" else "after a pause" }
+        afterHerMillis?.let { if (it >= LONG_PAUSE_MILLIS) out += if (it >= VERY_LONG_PAUSE_MILLIS) "a while after your line ended" else "a moment after your line ended" }
+        return out
+    }
+
+    /** True when nothing stood out. */
+    val ordinary: Boolean get() = phrases().isEmpty()
+
+    // What was heard must not end up in a log by way of toString; the tags are kept out too.
+    override fun toString(): String = "HowItSounded(${phrases().size} notes)"
+
+    companion object {
+        const val AFTER_HER_MILLIS = 30_000L
+        const val LONG_PAUSE_MILLIS = 2_000L
+        const val VERY_LONG_PAUSE_MILLIS = 5_000L
+        const val LOUDER_DB = 4f
+        const val QUIETER_DB = 5f
+        const val HIGHER_ST = 2.5f
+        const val LOWER_ST = 2f
+        const val LIVELIER_ST = 3f
+        const val FLATTER_ST = 2.5f
+        const val FLAT_ST = 2.5f
+        const val FAST_RATIO = 1.25f
+        const val SLOW_RATIO = 0.75f
+        const val FAST_WPM = 220f
+        const val SLOW_WPM = 100f
+        const val HESITANT_PAUSES = 2
+        const val MIN_PITCH_MILLIS = 600L
+
+        /**
+         * How another voice than his sounded, as far as she is told it: the sounds the
+         * recogniser named (laughing, music) and a whisper or a shout, which anyone in the room
+         * would hear; never its tone, its words or the phone's measures of it.
+         */
+        fun ofAnother(sounds: List<SoundEvent>, measure: Acoustics.Measure?): HowItSounded {
+            val manner = measure?.let { Manner.of(it, null, null, null).breathyWith(sounds) }?.takeIf { it == Manner.WHISPER || it == Manner.SHOUT } ?: Manner.ORDINARY
+            return HowItSounded(null, sounds, manner, null, null, null, null, null, null, null, null)
+        }
+
+        /**
+         * What [measure] and the recogniser's tags say, against [usual] where it is [SoundUsual.ready]
+         * (his usual, only for his voice). [words] is how many words were written down, [language]
+         * the recogniser's language tag. [pauseBeforeMillis] and [afterHerMillis] are passed on as
+         * they are.
+         */
+        fun judge(
+            measure: Acoustics.Measure?,
+            tone: Tone?,
+            sounds: List<SoundEvent>,
+            words: Int,
+            language: String?,
+            usual: SoundUsual?,
+            pauseBeforeMillis: Long? = null,
+            afterHerMillis: Long? = null,
+        ): HowItSounded {
+            if (measure == null) {
+                return HowItSounded(tone, sounds, Manner.ORDINARY, null, null, null, null, null, null, pauseBeforeMillis, afterHerMillis)
+            }
+            val u = usual?.takeIf { it.ready }
+            val louder = u?.let { measure.levelDb - it.levelDb }
+            val pitched = measure.voicedMillis >= MIN_PITCH_MILLIS
+            val usualPitch = u?.pitchSemitones
+            val usualSpread = u?.pitchSpread
+            val higher = if (pitched && measure.pitchSemitones != null && usualPitch != null) measure.pitchSemitones - usualPitch else null
+            val livelier = if (pitched && measure.pitchSpread != null && usualSpread != null) measure.pitchSpread - usualSpread else null
+            val brighter = u?.brightnessDb?.let { b -> measure.brightnessDb?.let { it - b } }
+            val wpm = SoundUsual.wordsPerMinute(words, measure.spanMillis)
+            val rate = wpm?.let { w -> u?.wordsPerMinute(language)?.let { w / it } }
+            val manner = Manner.of(measure, louder, higher, brighter).breathyWith(sounds)
+            return HowItSounded(tone, sounds, manner, measure, louder, higher, livelier, wpm, rate, pauseBeforeMillis, afterHerMillis)
+        }
+    }
+}
+
+/** How the voice was used, as far as the measures tell. */
+enum class Manner {
+    WHISPER, SOFT, ORDINARY, RAISED, SHOUT;
+
+    /** A laugh, crying or a cough is breathy without being a whisper: with one of those it is not called one. */
+    fun breathyWith(sounds: List<SoundEvent>): Manner = if (this == WHISPER && sounds.any { it.vocal }) ORDINARY else this
+
+    companion object {
+        /** Most of a whisper is not voiced at all. */
+        const val WHISPER_VOICED_SHARE = 0.2f
+        const val WHISPER_MIN_MILLIS = 400L
+
+        /** Against his usual: louder by this much is shouting, or by [SHOUT_WITH_PITCH_DB] with a higher, brighter voice. */
+        const val SHOUT_DB = 10f
+        const val SHOUT_WITH_PITCH_DB = 6f
+        const val SHOUT_PITCH_ST = 3f
+        const val SHOUT_BRIGHTER_DB = 2f
+        const val RAISED_DB = 6f
+        const val RAISED_PITCH_ST = 4f
+        const val RAISED_BRIGHTER_DB = 3f
+        const val SOFT_DB = -8f
+
+        /**
+         * Without a usual, only what needs none: this loud, and clipping the microphone this
+         * often, is shouting at any distance a phone hears from. A recording made loud is not.
+         */
+        const val SHOUT_ABSOLUTE_DB = -10f
+        const val CLIPPED_SHARE = 0.05f
+
+        /** [louder], [higher] and [brighter] are against his usual (null without one). */
+        fun of(m: Acoustics.Measure, louder: Float?, higher: Float?, brighter: Float?): Manner {
+            if (m.activeMillis >= WHISPER_MIN_MILLIS && m.voicedShare < WHISPER_VOICED_SHARE) return WHISPER
+            if (louder == null) {
+                return if (m.levelDb >= SHOUT_ABSOLUTE_DB && m.clippedShare >= CLIPPED_SHARE) SHOUT else ORDINARY
+            }
+            val up = higher ?: 0f
+            val bright = brighter ?: 0f
+            return when {
+                louder >= SHOUT_DB -> SHOUT
+                louder >= SHOUT_WITH_PITCH_DB && up >= SHOUT_PITCH_ST && bright >= SHOUT_BRIGHTER_DB -> SHOUT
+                louder >= RAISED_DB -> RAISED
+                up >= RAISED_PITCH_ST && bright >= RAISED_BRIGHTER_DB && louder >= 0f -> RAISED
+                louder <= SOFT_DB -> SOFT
+                else -> ORDINARY
+            }
+        }
+    }
+}
+
+/** The recogniser's guess at the tone of a stretch of speech (SenseVoice's emotion tag). */
+enum class Tone(val words: String) {
+    NEUTRAL("neutral"),
+    HAPPY("happy"),
+    SAD("sad"),
+    ANGRY("angry"),
+    FEARFUL("afraid"),
+    DISGUSTED("disgusted"),
+    SURPRISED("surprised");
+
+    companion object {
+        /** A tag as the recogniser gives it (`<|HAPPY|>`); null for none, unknown or "other". */
+        fun of(tag: String?): Tone? = when (bare(tag)) {
+            "NEUTRAL" -> NEUTRAL
+            "HAPPY" -> HAPPY
+            "SAD" -> SAD
+            "ANGRY" -> ANGRY
+            "FEARFUL" -> FEARFUL
+            "DISGUSTED" -> DISGUSTED
+            "SURPRISED" -> SURPRISED
+            else -> null
+        }
+    }
+}
+
+/** A sound the recogniser heard besides speech (SenseVoice's event tag). */
+enum class SoundEvent(val words: String, val tag: String) {
+    LAUGHTER("laughing", "Laughter"),
+    CRYING("crying", "Cry"),
+    COUGH("a cough", "Cough"),
+    SNEEZE("a sneeze", "Sneeze"),
+    APPLAUSE("applause", "Applause"),
+    MUSIC("music in the background", "BGM"),
+    SINGING("singing", "Sing");
+
+    /** True for a sound a person makes, which may be his. */
+    val vocal: Boolean get() = this == LAUGHTER || this == CRYING || this == COUGH || this == SNEEZE || this == SINGING
+
+    companion object {
+        /** A tag as the recogniser gives it (`<|Laughter|>`); null for speech, a breath, noise or unknown. */
+        fun of(tag: String?): SoundEvent? {
+            val t = bare(tag)
+            return entries.firstOrNull { it.tag.equals(t, ignoreCase = true) }
+        }
+    }
+}
+
+/** `<|HAPPY|>` to `HAPPY`. */
+internal fun bare(tag: String?): String = tag.orEmpty().trim().removePrefix("<|").removeSuffix("|>").trim()
+
+/**
+ * The phone's own measures of a stretch of sound, from its samples: no model, nothing kept.
+ * The sound is looked at in 40 ms frames every 20 ms; pitch by YIN on the sound at 8 kHz.
+ */
+object Acoustics {
+
+    /** What was measured. Times in milliseconds; levels in dB against full scale. */
+    class Measure(
+        /** The level of the frames that held sound (an active-speech level). */
+        val levelDb: Float,
+        /** The loudest sample. */
+        val peakDb: Float,
+        /** The share of frames at the top of the sample range: shouting into the phone. */
+        val clippedShare: Float,
+        /** How much of the sound held something (frames near the loudest). */
+        val activeMillis: Long,
+        /** How much of [activeMillis] was voiced (had a pitch). */
+        val voicedMillis: Long,
+        /** [voicedMillis] over [activeMillis]: speech is mostly voiced, a whisper hardly at all. */
+        val voicedShare: Float,
+        /** The median pitch of the voiced frames, in Hz; null without enough of them. */
+        val pitchHz: Float?,
+        /** [pitchHz] in semitones above 100 Hz. */
+        val pitchSemitones: Float?,
+        /** How much the pitch moved: semitones from its 10th to its 90th percentile. */
+        val pitchSpread: Float?,
+        /** The high-frequency share of the sound (vocal effort), in dB; null without active frames. */
+        val brightnessDb: Float?,
+        /** Silences of [MIN_PAUSE_MILLIS] or more inside the sound. */
+        val pauses: Int,
+        val longestPauseMillis: Long,
+        /** From the first frame with sound to the last, without the pauses: the time words had. */
+        val speechMillis: Long,
+        /** From the first frame with sound to the last, pauses and all: what a pace is reckoned over. */
+        val spanMillis: Long = speechMillis,
+    ) {
+        override fun toString(): String = "Measure(${activeMillis}ms active)"
+    }
+
+    const val FRAME = 640
+    const val HOP = 320
+    const val FRAME_MILLIS = 20L
+
+    /** Frames this far under the loudest are not sound. */
+    const val ACTIVE_RANGE_DB = 25f
+
+    /** Frames this far under the loudest are silence. */
+    const val SILENCE_RANGE_DB = 30f
+
+    /** Nothing quieter than this is ever sound. */
+    const val FLOOR_DB = -65f
+
+    const val MIN_PAUSE_MILLIS = 300L
+    const val CLIP = 0.98f
+
+    private const val MIN_TAU = 16 // 500 Hz at 8 kHz
+    private const val MAX_TAU = 133 // 60 Hz at 8 kHz
+    private const val YIN_THRESHOLD = 0.2f
+    private const val YIN_VOICED = 0.35f
+    private const val MIN_VOICED_FRAMES = 5
+
+    /** Measures [samples] (16 kHz mono, -1..1). Null when the sound is shorter than one frame. */
+    fun measure(samples: FloatArray, sampleRate: Int = SherpaPipeline.SAMPLE_RATE): Measure? {
+        require(sampleRate == SherpaPipeline.SAMPLE_RATE) { "16 kHz only" }
+        if (samples.size < FRAME) return null
+        val frames = (samples.size - FRAME) / HOP + 1
+        val db = FloatArray(frames)
+        val bright = FloatArray(frames)
+        var clipped = 0
+        var peak = 0f
+        for (f in 0 until frames) {
+            val from = f * HOP
+            var power = 0.0
+            var diff = 0.0
+            var clip = false
+            var prev = if (from > 0) samples[from - 1] else samples[from]
+            for (i in from until from + FRAME) {
+                val x = samples[i]
+                power += x.toDouble() * x
+                val d = x - prev
+                diff += d.toDouble() * d
+                prev = x
+                val a = abs(x)
+                if (a > peak) peak = a
+                if (a >= CLIP) clip = true
+            }
+            if (clip) clipped++
+            db[f] = (10 * log10(power / FRAME + 1e-12)).toFloat()
+            bright[f] = if (power > 0) (10 * log10(diff / power + 1e-12)).toFloat() else -120f
+        }
+        val top = percentile(db, 0.95f)
+        val activeAt = max(top - ACTIVE_RANGE_DB, FLOOR_DB)
+        val silentAt = max(top - SILENCE_RANGE_DB, FLOOR_DB)
+        val active = BooleanArray(frames) { db[it] >= activeAt }
+        val activeCount = active.count { it }
+        if (activeCount == 0) {
+            return Measure(top, dbOf(peak), 0f, 0, 0, 0f, null, null, null, null, 0, 0, 0, 0)
+        }
+
+        // Level and brightness over the frames with sound.
+        var power = 0.0
+        var brightSum = 0.0
+        for (f in 0 until frames) if (active[f]) {
+            power += Math.pow(10.0, db[f] / 10.0)
+            brightSum += bright[f]
+        }
+        val level = (10 * log10(power / activeCount)).toFloat()
+
+        // Pauses: runs of silent frames between frames with sound.
+        val first = active.indexOfFirst { it }
+        val last = active.indexOfLast { it }
+        var pauses = 0
+        var longest = 0L
+        var pauseTotal = 0L
+        var run = 0
+        for (f in first..last) {
+            if (db[f] < silentAt) {
+                run++
+            } else {
+                if (run > 0) {
+                    // A run of n silent frames is about n hops of silence.
+                    val ms = run * FRAME_MILLIS
+                    if (ms >= MIN_PAUSE_MILLIS) {
+                        pauses++
+                        pauseTotal += ms
+                        if (ms > longest) longest = ms
+                    }
+                }
+                run = 0
+            }
+        }
+        val span = (last - first + 1) * FRAME_MILLIS + (FRAME - HOP) * 1000L / sampleRate
+        val speech = max(0L, span - pauseTotal)
+
+        // Pitch: YIN on each frame with sound, at 8 kHz.
+        val low = downsample(samples)
+        val pitches = ArrayList<Float>(activeCount)
+        var voiced = 0
+        val half = FRAME / 2
+        val d = FloatArray(MAX_TAU + 1)
+        for (f in 0 until frames) {
+            if (!active[f]) continue
+            val from = f * HOP / 2
+            if (from + half > low.size) continue
+            val hz = yin(low, from, half, d) ?: continue
+            voiced++
+            pitches += hz
+        }
+        val voicedShare = voiced.toFloat() / activeCount
+        val (pitch, st, spread) = if (pitches.size >= MIN_VOICED_FRAMES) {
+            val sts = FloatArray(pitches.size) { semitones(pitches[it]) }
+            val med = percentile(sts, 0.5f)
+            Triple(hzOf(med), med, percentile(sts, 0.9f) - percentile(sts, 0.1f))
+        } else Triple(null, null, null)
+
+        return Measure(
+            levelDb = level,
+            peakDb = dbOf(peak),
+            clippedShare = clipped.toFloat() / frames,
+            activeMillis = activeCount * FRAME_MILLIS,
+            voicedMillis = voiced * FRAME_MILLIS,
+            voicedShare = voicedShare,
+            pitchHz = pitch,
+            pitchSemitones = st,
+            pitchSpread = spread,
+            brightnessDb = (brightSum / activeCount).toFloat(),
+            pauses = pauses,
+            longestPauseMillis = longest,
+            speechMillis = speech,
+            spanMillis = span,
+        )
+    }
+
+    /** [hz] as semitones above 100 Hz. */
+    fun semitones(hz: Float): Float = (12 * ln(hz / 100.0) / ln(2.0)).toFloat()
+
+    fun hzOf(semitones: Float): Float = (100 * Math.pow(2.0, semitones / 12.0)).toFloat()
+
+    /** The level of [samples] in dB against full scale, for a whole buffer (the sound gate's frames). */
+    fun levelDb(samples: FloatArray, from: Int = 0, to: Int = samples.size): Float {
+        if (to <= from) return -120f
+        var p = 0.0
+        for (i in from until to) p += samples[i].toDouble() * samples[i]
+        return (10 * log10(p / (to - from) + 1e-12)).toFloat()
+    }
+
+    private fun dbOf(amplitude: Float): Float = (20 * log10(amplitude.toDouble() + 1e-9)).toFloat()
+
+    /** 16 kHz to 8 kHz, through a small low-pass. */
+    private fun downsample(x: FloatArray): FloatArray {
+        val n = x.size / 2
+        return FloatArray(n) { i ->
+            val c = 2 * i
+            val a = if (c > 0) x[c - 1] else x[c]
+            val b = if (c + 1 < x.size) x[c + 1] else x[c]
+            (a + 2 * x[c] + b) / 4f
+        }
+    }
+
+    /**
+     * The pitch of [n] samples of [x] from [from] (8 kHz), by YIN (de Cheveigné and Kawahara,
+     * 2002): the first dip of the cumulative mean normalised difference under
+     * [YIN_THRESHOLD], else its lowest point, voiced when that is under [YIN_VOICED]. [d] is
+     * scratch space. Null for an unvoiced frame.
+     */
+    private fun yin(x: FloatArray, from: Int, n: Int, d: FloatArray): Float? {
+        val w = n - MAX_TAU
+        if (w <= 0) return null
+        var energy = 0.0
+        for (j in 0 until w) energy += x[from + j].toDouble() * x[from + j]
+        if (energy < 1e-9) return null
+        d[0] = 1f
+        var running = 0.0
+        for (tau in 1..MAX_TAU) {
+            var s = 0.0
+            for (j in 0 until w) {
+                val diff = x[from + j] - x[from + j + tau]
+                s += diff.toDouble() * diff
+            }
+            running += s
+            d[tau] = if (running > 0) (s * tau / running).toFloat() else 1f
+        }
+        var best = -1
+        var tau = MIN_TAU
+        while (tau <= MAX_TAU) {
+            if (d[tau] < YIN_THRESHOLD) {
+                while (tau + 1 <= MAX_TAU && d[tau + 1] < d[tau]) tau++
+                best = tau
+                break
+            }
+            tau++
+        }
+        if (best < 0) {
+            best = MIN_TAU
+            for (t in MIN_TAU..MAX_TAU) if (d[t] < d[best]) best = t
+        }
+        if (d[best] >= YIN_VOICED) return null
+        // A parabola through the dip and its neighbours.
+        val exact = if (best in (MIN_TAU + 1) until MAX_TAU) {
+            val a = d[best - 1]
+            val b = d[best]
+            val c = d[best + 1]
+            val den = a - 2 * b + c
+            if (den > 0) best + 0.5f * (a - c) / den else best.toFloat()
+        } else best.toFloat()
+        return 8000f / exact
+    }
+
+    /** The [q] quantile of [v] (0..1), by sorting a copy. */
+    internal fun percentile(v: FloatArray, q: Float): Float {
+        if (v.isEmpty()) return 0f
+        val s = v.copyOf()
+        s.sort()
+        val at = (q * (s.size - 1)).coerceIn(0f, (s.size - 1).toFloat())
+        val lo = at.toInt()
+        val hi = min(lo + 1, s.size - 1)
+        return s[lo] + (s[hi] - s[lo]) * (at - lo)
+    }
+
+    internal fun percentile(v: List<Float>, q: Float): Float = percentile(v.toFloatArray(), q)
+
+    internal fun rms(v: FloatArray): Float {
+        var p = 0.0
+        for (x in v) p += x.toDouble() * x
+        return sqrt(p / max(1, v.size)).toFloat()
+    }
+}
+
+/**
+ * His usual, as the phone hears it: his level, pitch, how much it moves, the brightness of his
+ * voice, and how fast he talks in each language he speaks. First made from his enrolment, then
+ * moved a little by each ordinary stretch of his voice; never by a whisper, a shout, a laugh or
+ * a stretch too short to tell. A few numbers, kept sealed with his voiceprint and nowhere else.
+ */
+class SoundUsual(
+    levelDb: Float? = null,
+    pitchSemitones: Float? = null,
+    pitchSpread: Float? = null,
+    brightnessDb: Float? = null,
+    rates: Map<String, Float> = emptyMap(),
+    learned: Int = 0,
+) {
+    var levelDb: Float = levelDb ?: 0f
+        private set
+    var pitchSemitones: Float? = pitchSemitones
+        private set
+    var pitchSpread: Float? = pitchSpread
+        private set
+    var brightnessDb: Float? = brightnessDb
+        private set
+
+    /** How many stretches of his voice it was made of. */
+    var learned: Int = if (levelDb == null) 0 else learned
+        private set
+
+    private val rates = HashMap(rates)
+
+    /** True once it is made of enough to measure against. */
+    val ready: Boolean get() = learned >= READY
+
+    /** His usual words a minute in [language] (a recogniser's tag such as `<|en|>` or `en`); null when not known. */
+    fun wordsPerMinute(language: String?): Float? = rates[languageKey(language)]
+
+    /** The rates by language, for keeping. */
+    fun rates(): Map<String, Float> = HashMap(rates)
+
+    /**
+     * Learns from one stretch of his voice that sounded [how]. Only ordinary speech of
+     * [MIN_LEARN_MILLIS] or more teaches anything, and each step moves the usual by at most a
+     * share of the way, so that one odd stretch cannot.
+     */
+    fun learn(m: Acoustics.Measure, words: Int, language: String?, how: HowItSounded?) {
+        if (m.speechMillis < MIN_LEARN_MILLIS || m.activeMillis < MIN_LEARN_MILLIS) return
+        if (how != null && (how.manner == Manner.WHISPER || how.manner == Manner.SHOUT || how.sounds.isNotEmpty())) return
+        val first = learned == 0
+        val k = if (learned < READY) 1f / (learned + 1) else STEP
+        levelDb = if (first) m.levelDb else levelDb + k * (m.levelDb - levelDb).coerceIn(-MAX_LEVEL_STEP_DB, MAX_LEVEL_STEP_DB)
+        if (m.pitchSemitones != null && m.voicedMillis >= HowItSounded.MIN_PITCH_MILLIS) {
+            val p = pitchSemitones
+            pitchSemitones = if (p == null) m.pitchSemitones else p + k * (m.pitchSemitones - p).coerceIn(-MAX_PITCH_STEP_ST, MAX_PITCH_STEP_ST)
+            val s = pitchSpread
+            if (m.pitchSpread != null) pitchSpread = if (s == null) m.pitchSpread else s + k * (m.pitchSpread - s)
+        }
+        m.brightnessDb?.let { b ->
+            val o = brightnessDb
+            brightnessDb = if (o == null) b else o + k * (b - o).coerceIn(-MAX_LEVEL_STEP_DB, MAX_LEVEL_STEP_DB)
+        }
+        wordsPerMinute(words, m.spanMillis)?.let { w ->
+            val key = languageKey(language)
+            val o = rates[key]
+            rates[key] = if (o == null) w else o + k * (w.coerceIn(o / MAX_RATE_STEP, o * MAX_RATE_STEP) - o)
+        }
+        learned++
+    }
+
+    /** A copy to learn on, so that what was kept changes only when it is kept again. */
+    fun copy(): SoundUsual = SoundUsual(
+        levelDb.takeIf { learned > 0 }, pitchSemitones, pitchSpread, brightnessDb, rates, learned,
+    )
+
+    override fun toString(): String = "SoundUsual(learned=$learned)"
+
+    companion object {
+        /** Made of this many stretches (his three enrolment takes count), it is measured against. */
+        const val READY = 3
+
+        /** How far each stretch past [READY] moves the usual. */
+        const val STEP = 0.08f
+        const val MAX_LEVEL_STEP_DB = 8f
+        const val MAX_PITCH_STEP_ST = 4f
+        const val MAX_RATE_STEP = 1.6f
+        const val MIN_LEARN_MILLIS = 1_000L
+
+        /** A rate needs this many words in this much speech. */
+        const val MIN_RATE_WORDS = 3
+        const val MIN_RATE_MILLIS = 1_200L
+
+        /** Words a minute over [millis], or null when too little to tell. */
+        fun wordsPerMinute(words: Int, millis: Long): Float? =
+            if (words < MIN_RATE_WORDS || millis < MIN_RATE_MILLIS) null else words * 60_000f / millis
+
+        /** `<|en|>`, `en` or null to `en` or `any`. */
+        fun languageKey(language: String?): String = bare(language).lowercase().ifEmpty { "any" }
+
+        /** The usual made of his enrolment takes, as measured, with what he read in each. */
+        fun fromTakes(takes: List<Pair<Acoustics.Measure, Int>>, language: String = "en"): SoundUsual? {
+            if (takes.isEmpty()) return null
+            val u = SoundUsual()
+            for ((m, words) in takes) u.learn(m, words, language, null)
+            return u.takeIf { it.learned > 0 }
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/Overheard.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/Overheard.kt
new file mode 100644
index 0000000..dd66bdc
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/Overheard.kt
@@ -0,0 +1,155 @@
+package com.opendroid.ai.core.life.ears
+
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * What her ears overheard and were not told to her, for her next prompt (OWN_LIFE_PLAN
+ * phase 3b): his voice not said to her, his laughs and coughs, and before his voice is
+ * enrolled a sound near the phone that came right after her line. A ring in memory only
+ * (I6): at most [KEEP_MILLIS] old, [MAX_LINES] lines and [MAX_CHARS] characters of his
+ * words, the oldest let go first. Beside the lines, what was only counted since she last
+ * heard of it: how long other voices talked near the phone, and before enrolment how long
+ * anyone did, with no words.
+ *
+ * Her next prompt takes it once ([take]); a prompt built again for the same turn within
+ * [REBUILD_MILLIS] (a second try without a picture) is given the same again. It is cleared
+ * when she lies down to sleep and when her ears are switched off ([clear]).
+ */
+@Singleton
+class Overheard internal constructor(
+    /** The wall clock, by which lines are shown and grow old. */
+    private val clock: () -> Long,
+) {
+    @Inject
+    constructor() : this(System::currentTimeMillis)
+
+    /**
+     * One thing overheard. [text] is his words as the phone made them out, null for a sound
+     * (a laugh: [how] says which). [his] is false for a sound near the phone whose voice could
+     * not be told (his is not enrolled). [atMillis] is on the wall clock. [language] is the
+     * recogniser's tag for the language of the words ([Heard.language]), null without words.
+     */
+    class Line(val atMillis: Long, val text: String?, val how: List<String>, val his: Boolean, val language: String? = null) {
+        // Words overheard must never end up in a log by way of toString.
+        override fun toString(): String = "Overheard.Line(words=${text != null}, ${how.size} notes)"
+    }
+
+    /** What her prompt is told: the lines, oldest first, and what was counted since [sinceMillis]. */
+    class Taken(
+        val lines: List<Line>,
+        /** How long other voices than his talked near the phone, in milliseconds. */
+        val othersMillis: Long,
+        /** How long anyone talked near the phone, not to her, before his voice was enrolled. */
+        val anyoneMillis: Long,
+        /** Since when the counts run: the last time she was told, or when the ears opened. */
+        val sinceMillis: Long,
+    ) {
+        val isEmpty: Boolean get() = lines.isEmpty() && othersMillis < MIN_COUNTED_MILLIS && anyoneMillis < MIN_COUNTED_MILLIS
+
+        override fun toString(): String = "Overheard.Taken(${lines.size} lines)"
+    }
+
+    private val lock = Any()
+    private val lines = ArrayList<Line>()
+    private var othersMillis = 0L
+    private var anyoneMillis = 0L
+    private var since = 0L
+    private var shown: Taken? = null
+    private var shownAt = 0L
+
+    /** Keeps [line], and lets the oldest go past the bounds. */
+    fun add(line: Line) = synchronized(lock) {
+        if (since == 0L) since = line.atMillis
+        lines += line
+        prune(clock())
+    }
+
+    /** Another voice talked near the phone for [millis] and was counted only. */
+    fun countOthers(millis: Long) = synchronized(lock) {
+        if (since == 0L) since = clock()
+        othersMillis += millis.coerceAtLeast(0)
+    }
+
+    /** Someone talked near the phone, not to her, before his voice was enrolled, for [millis]. */
+    fun countAnyone(millis: Long) = synchronized(lock) {
+        if (since == 0L) since = clock()
+        anyoneMillis += millis.coerceAtLeast(0)
+    }
+
+    /**
+     * What her next prompt is told, once; null when there is nothing. A prompt built again
+     * within [REBUILD_MILLIS] gets the same, with anything heard since.
+     */
+    fun take(): Taken? = synchronized(lock) {
+        val now = clock()
+        prune(now)
+        val again = shown?.takeIf { now - shownAt <= REBUILD_MILLIS }
+        val fresh = Taken(lines.toList(), othersMillis, anyoneMillis, if (since == 0L) now else since)
+        val out = if (again == null) fresh else Taken(again.lines + fresh.lines, again.othersMillis + fresh.othersMillis, again.anyoneMillis + fresh.anyoneMillis, again.sinceMillis)
+        lines.clear()
+        othersMillis = 0
+        anyoneMillis = 0
+        since = now
+        if (out.isEmpty) {
+            shown = null
+            return null
+        }
+        shown = out
+        if (again == null) shownAt = now
+        out
+    }
+
+    /**
+     * What [take] would hand her next prompt now, without taking it: nothing is cleared and the
+     * time of what was last shown does not move. For a try of her brain on his tap, which must
+     * not use up what her next real prompt is told.
+     */
+    fun peek(): Taken? = synchronized(lock) {
+        val now = clock()
+        prune(now)
+        val again = shown?.takeIf { now - shownAt <= REBUILD_MILLIS }
+        val fresh = Taken(lines.toList(), othersMillis, anyoneMillis, if (since == 0L) now else since)
+        val out = if (again == null) fresh else Taken(again.lines + fresh.lines, again.othersMillis + fresh.othersMillis, again.anyoneMillis + fresh.anyoneMillis, again.sinceMillis)
+        out.takeUnless { it.isEmpty }
+    }
+
+    /** How many lines are held now, for a test or the status card. */
+    fun size(): Int = synchronized(lock) {
+        prune(clock())
+        lines.size
+    }
+
+    /** Forgets everything: she lay down to sleep, or her ears were switched off. */
+    fun clear() = synchronized(lock) {
+        lines.clear()
+        othersMillis = 0
+        anyoneMillis = 0
+        since = 0
+        shown = null
+        shownAt = 0
+    }
+
+    private fun prune(now: Long) {
+        lines.removeAll { now - it.atMillis > KEEP_MILLIS }
+        while (lines.size > MAX_LINES) lines.removeAt(0)
+        while (lines.sumOf { it.text?.length ?: 0 } > MAX_CHARS && lines.isNotEmpty()) lines.removeAt(0)
+    }
+
+    companion object {
+        /** A line older than this is let go of. */
+        const val KEEP_MILLIS = 20 * 60_000L
+
+        /** At most this many lines are held. */
+        const val MAX_LINES = 40
+
+        /** At most this many characters of his words are held. */
+        const val MAX_CHARS = 2_000
+
+        /** A prompt built again this soon for the same turn is told the same. */
+        const val REBUILD_MILLIS = 90_000L
+
+        /** Talk counted for less than this is not worth telling her. */
+        const val MIN_COUNTED_MILLIS = 3_000L
+    }
+}
