+/** Where the download of her ears' models stands, in a line. */
+internal fun earsModelLine(status: com.opendroid.ai.core.life.ears.EarsModelStore.Status?): String {
+    if (status == null) return "Looking at the models on the phone."
+    val mb = { bytes: Long -> (bytes + 500_000) / 1_000_000 }
+    return when {
+        status.ready -> "The models are on the phone. Speech is turned into words here, and nowhere else."
+        status.downloading -> "Downloading: ${mb(status.doneBytes)} of ${mb(status.totalBytes)} MB."
+        status.waiting -> "Waiting for Wi-Fi (or for free space) to download ${mb(status.totalBytes)} MB."
+        status.failed != null -> "The download stopped: ${status.failed}"
+        else -> "Not on the phone yet: ${mb(status.totalBytes)} MB, over Wi-Fi only, from the speech models' own release page."
+    }
+}
