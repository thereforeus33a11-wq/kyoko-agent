+        /** Lines of hers about a kid not kept in her last moment, told at her next one (PK-2). */
+        val kidNotKept: Int = 0
+    ) {
+        /** Her moments that still count at [nowMillis]: those of the 24 hours before it. */
+        fun momentsOfTheDay(nowMillis: Long): List<Long> = moments.filter { it > nowMillis - DAY_MILLIS && it <= nowMillis }
+    }
+
+    @Serializable
+    private data class Record(
+        val on: Boolean = false,
+        val wake: String = "",
+        val wakeAt: Long = 0,
+        val why: String = "",
+        val moments: List<Long> = emptyList(),
+        val gap: Long = 0,
+        val lastAt: Long = 0,
+        val lastDid: String = "",
+        val lastCommand: Boolean = false,
+        val moved: String = "",
+        val movedAsked: String = "",
+        val failures: Int = 0,
+        val asleepSince: Long = 0,
+        val sleepUntil: Long = 0,
+        val sleepMeant: Long = 0,
+        val sleepAsked: String = "",
+        val sleepMoved: String = "",
+        val repairDueAt: Long = 0,
+        val repairTries: Int = 0,
+        val repairOwed: Boolean = false,
+        val repairMissed: Int = 0,
+        val lastRepairOkAt: Long = 0,
+        val lastRepair: RepairRecord? = null,
+        val lastWokeAt: Long = 0,
+        val wokeBy: String = "",
+        val lastSlept: Long = 0,
+        val lastMeant: Long = 0,
+        val sleepSpan: Long = 0,
+        val fromAt: Long = 0,
+        val fromWhy: String = "",
+        val outing: OutingRecord? = null,
+        val goMissed: String = "",
+        val goMissedWhy: String = "",
+        val kidNotKept: Int = 0
+    )
+
+    /** Her last outing as it is stored: her go: words, times, counts and titles, never a word she thought there. */
+    @Serializable
+    private data class OutingRecord(
+        val kind: String = "",
+        val words: String = "",
+        val startedAt: Long = 0,
+        val endedAt: Long = 0,
+        val minutes: Int = 0,
+        val steps: Int = 0,
+        val opened: Int = 0,
+        val searches: Int = 0,
+        val titles: List<String> = emptyList(),
+        val ended: String = "",
+        val said: Boolean = false,
+        val looked: Int = 0,
+        val camera: String = "",
+        val unseen: String = "",
+        val untoldDrops: Int = 0,
+        val metKid: Boolean = false,
+        val app: String = "",
+        val scrolls: Int = 0,
+        val refused: Int = 0,
+        val watchedSeconds: Int = 0,
+        val screenBack: String = ""
+    )
+
+    /** What one sleep pass came to, as it is stored: counts only, never a word of what she wrote. */
+    @Serializable
+    private data class RepairRecord(
+        val at: Long = 0,
+        val ok: Boolean = false,
+        val rewritten: Int = 0,
+        val added: Int = 0,
+        val letGo: Int = 0,
+        val back: Int = 0,
+        val feelings: Int = 0,
+        val marks: Int = 0,
+        val thoughtsKept: Int = 0,
+        val notTaken: Int = 0,
+        val skipped: String = ""
+    )
+
+    private fun record(repair: PersonaSleep.Repair) = RepairRecord(
+        at = repair.atMillis, ok = repair.ok, rewritten = repair.rewritten, added = repair.added, letGo = repair.letGo,
+        back = repair.back, feelings = repair.feelings, marks = repair.marks, thoughtsKept = repair.thoughtsKept,
+        notTaken = repair.notTaken, skipped = repair.skipped?.name.orEmpty()
+    )
+
+    private fun repair(record: RepairRecord) = PersonaSleep.Repair(
+        atMillis = record.at, ok = record.ok, rewritten = record.rewritten.coerceAtLeast(0), added = record.added.coerceAtLeast(0),
+        letGo = record.letGo.coerceAtLeast(0), back = record.back.coerceAtLeast(0), feelings = record.feelings.coerceAtLeast(0),
+        marks = record.marks.coerceAtLeast(0), thoughtsKept = record.thoughtsKept.coerceAtLeast(0),
+        notTaken = record.notTaken.coerceAtLeast(0),
+        skipped = PersonaSleep.Skipped.entries.firstOrNull { it.name == record.skipped }
+    )
+
+    private val JSON = Json { ignoreUnknownKeys = true }
+    private const val WAKE_WHEN_HE_WRITES = "writes"
+    private const val WAKE_AT = "at"
+
+    /** [state] as the one line of text that is stored. */
+    fun encode(state: State): String = JSON.encodeToString(
+        Record.serializer(),
+        Record(
+            on = state.on,
+            wake = when (state.wake) {
+                is Wake.At -> WAKE_AT
+                Wake.WhenHeWrites -> WAKE_WHEN_HE_WRITES
+                Wake.Unset -> ""
+            },
+            wakeAt = (state.wake as? Wake.At)?.atMillis ?: 0,
+            why = state.why.name,
+            moments = state.moments,
+            gap = state.lastGapMillis,
+            lastAt = state.lastAtMillis,
+            lastDid = state.lastDid?.name.orEmpty(),
+            lastCommand = state.lastHadCommand,
+            moved = state.moved?.name.orEmpty(),
+            movedAsked = state.movedAsked,
+            failures = state.failures,
+            asleepSince = state.asleepSince,
+            sleepUntil = state.sleepUntil,
+            sleepMeant = state.sleepMeantMillis,
+            sleepAsked = state.sleepAsked,
+            sleepMoved = state.sleepMoved?.name.orEmpty(),
+            repairDueAt = state.repairDueAt,
+            repairTries = state.repairTries,
+            repairOwed = state.repairOwed,
+            repairMissed = state.repairMissed,
+            lastRepairOkAt = state.lastRepairOkAt,
+            lastRepair = state.lastRepair?.let(::record),
+            lastWokeAt = state.lastWokeAt,
+            wokeBy = state.wokeBy?.name.orEmpty(),
+            lastSlept = state.lastSleptMillis,
+            lastMeant = state.lastMeantMillis,
+            sleepSpan = state.lastSleepSpanMillis,
+            fromAt = state.broughtFromAt,
+            fromWhy = state.broughtFromWhy?.name.orEmpty(),
+            outing = state.lastOuting?.let {
+                OutingRecord(
+                    it.kind, it.words, it.startedAt, it.endedAt, it.minutes, it.steps, it.opened, it.searches,
+                    it.titles, it.ended, it.said, it.looked, it.camera, it.unseen, it.untoldDrops, it.metKid,
