+     * for every provider, the local ones included.
+     */
+    fun stripReasoning(content: String): String {
+        val rest = dropOrphanedReasoning(content)
+        if (!rest.trimStart().startsWith("<")) return rest
+        // Inline reasoning always comes first. Only leading blocks go; a tag further in is
+        // part of the answer (plan text, XML, a sentence about the tag) and is left alone.
+        var answer = rest
+        while (true) {
+            val block = LEADING_REASONING_BLOCK.find(answer) ?: break
+            answer = answer.substring(block.range.last + 1)
+        }
+        if (answer.length == rest.length) {
+            // An opening tag that never closed, with the reasoning starting right behind it
+            // or on the next line: the reply was cut off while still reasoning and holds no
+            // answer. ("<think> is the tag for ..." is a sentence, and is kept.)
+            return UNCLOSED_REASONING.replace(rest, "")
+        }
+        return UNCLOSED_REASONING.replace(answer, "").trimStart()
+    }
+
+    /**
+     * A server whose chat template writes the opening tag itself returns the reasoning, a
+     * closing tag with no opening one before it, and then the answer. Everything up to
+     * and including that closing tag is reasoning and goes. A closing tag that has its
+     * opening tag in front of it is left to [stripReasoning].
+     *
+     * A template sets that tag hard against the answer, or ends or begins a line with it.
+     * A closing tag in the middle of a line that goes on the way a sentence does, with a
+     * space or a punctuation mark and more words, is somebody writing about the tag
+     * ("thats the </think> thing it leaks"), and what stands in front of it is the reply
+     * itself. That is left alone.
+     */
+    private fun dropOrphanedReasoning(content: String): String {
+        val first = REASONING_TAG.find(content) ?: return content
+        val isClosing = first.groupValues[1].isNotEmpty()
+        if (!isClosing) return content
+        val sameLineBefore = content.substring(0, first.range.first).substringAfterLast('\n')
+        val sameLineAfter = content.substring(first.range.last + 1).substringBefore('\n')
+        val inASentence = sameLineBefore.isNotBlank() && sameLineAfter.isNotBlank() &&
+            (sameLineAfter.first().isWhitespace() || sameLineAfter.first() in SENTENCE_MARKS)
+        return if (inASentence) content else content.substring(first.range.last + 1).trimStart()
+    }
+
+    /** What can follow a word inside a sentence, where an answer never starts. */
+    private const val SENTENCE_MARKS = ",.;:!?)'\""
+
+    /** True when [baseUrl] is an address at Venice: the host is venice.ai or ends in .venice.ai. */
+    fun isVeniceHost(baseUrl: String?): Boolean {
+        val host = baseUrl?.trim()?.toHttpUrlOrNull()?.host ?: return false
+        return host == "venice.ai" || host.endsWith(".venice.ai")
+    }
+
+    /**
+     * What this build puts into every request to [baseUrl] before the owner has typed
+     * anything. Venice adds a system prompt of its own in front of the one it is sent
+     * unless a request says not to: a second voice telling the model how to behave. The
+     * owner can still switch it back on in the provider's options.
+     */
+    private fun appDefaults(baseUrl: String?): JsonObject? {
+        if (!isVeniceHost(baseUrl)) return null
+        return JsonObject().apply {
+            add("venice_parameters", JsonObject().apply { addProperty("include_venice_system_prompt", false) })
+        }
+    }
+
+    /**
+     * What a call in her own voice puts in at [baseUrl] when the owner typed no options of
+     * hers ([com.opendroid.ai.core.llm.LLMRequest.thinkingOff]): Venice is asked to have
+     * the model answer without thinking in secret first, and to send back no thinking.
+     * A model that thinks before every answer otherwise works through every rule of her
+     * card before it writes a word, and what is left is the shortest, flattest line that
+     * breaks none of them. Only these two switches: both are plain true or false and say
+     * nothing about anyone. Null anywhere but at Venice, where they mean nothing.
+     */
+    fun thinkingOffDefaults(baseUrl: String?): JsonObject? {
+        if (!isVeniceHost(baseUrl)) return null
+        return JsonObject().apply {
+            add("venice_parameters", JsonObject().apply {
+                addProperty("disable_thinking", true)
+                addProperty("strip_thinking_response", true)
+            })
+        }
+    }
+
+    /**
+     * Adds extra request options to [body], from three places laid over each other:
+     * this build's defaults for [baseUrl], then the options stored for the provider
+     * ([providerJson]), then the ones given for this request ([requestJson]). A later
+     * layer wins key by key, and where both hold a JSON object under the same key (as
+     * under `venice_parameters`) the entries add up instead of the object being replaced.
+     *
+     * Anything that is not a JSON object is ignored, so a typo in one field costs only
+     * that field: a per-request line that does not parse leaves the provider's options in
+     * force. The same holds one level down: where a layer below holds a JSON object under
+     * a key, a later value under that key that is not an object (`null`, a word, a list)
+     * is ignored and does not take the object's entries out with it, and neither does a
+     * `null` written for one entry inside the object. Otherwise a slip under
+     * `venice_parameters` would silently bring back the host's own system prompt, which
+     * is switched off by an entry there, in so many words, when that is wanted.
+     * The request's own options may set the temperature and the token limit unless
+     * [requestKeepsOwnSampling] says the caller chose those on purpose. The token limit
+     * counts under either of its names, and whichever name is given last is the one sent.
+     *
+     * With [thinkingOff] the switches of [thinkingOffDefaults] go in right above this
+     * build's defaults: under everything the owner typed, so that what he set for the
+     * provider, or for her, wins entry by entry.
+     */
+    fun mergeExtraBody(
+        body: MutableMap<String, Any>,
+        providerJson: String?,
+        requestJson: String? = null,
+        baseUrl: String? = null,
+        requestKeepsOwnSampling: Boolean = false,
+        thinkingOff: Boolean = false
+    ) {
+        appDefaults(baseUrl)?.let { layer(body, it, skip = emptySet()) }
+        if (thinkingOff) thinkingOffDefaults(baseUrl)?.let { layer(body, it, skip = emptySet()) }
+        parseObject(providerJson)?.let { layer(body, it, skip = RESERVED_KEYS + PROVIDER_LEVEL_RESERVED_KEYS) }
+        parseObject(requestJson)?.let {
+            layer(body, it, skip = if (requestKeepsOwnSampling) RESERVED_KEYS + PROVIDER_LEVEL_RESERVED_KEYS else RESERVED_KEYS)
+        }
+    }
+
+    private fun layer(body: MutableMap<String, Any>, extra: JsonObject, skip: Set<String>) {
+        for ((key, value) in extra.entrySet()) {
+            if (key in skip) continue
+            // A plain value where an object already stands is a slip, not a setting.
+            val existing = body[key]
+            if (!value.isJsonObject && (existing is JsonObject || existing is Map<*, *>)) continue
+            // One limit under two names: naming it one way takes the other way out.
+            if (key in TOKEN_LIMIT_KEYS) body.keys.removeAll(TOKEN_LIMIT_KEYS - key)
+            body[key] = mergedOneLevel(existing, value)
+        }
+    }
+
+    /**
+     * [added] over [existing]: two JSON objects are joined entry by entry, anything else
+     * is replaced. An entry of [added] that is `null` is left out of the join. A null is
+     * never written into the request, so laid over an entry it would only take that
+     * entry away: the layer below stands instead.
+     */
+    internal fun mergedOneLevel(existing: Any?, added: JsonElement): Any {
+        if (!added.isJsonObject) return added
+        val base = when (existing) {
+            is JsonObject -> existing
+            is Map<*, *> -> GSON.toJsonTree(existing).takeIf { it.isJsonObject }?.asJsonObject
+            else -> null
+        } ?: return added
+        return base.deepCopy().apply {
+            for ((name, entry) in added.asJsonObject.entrySet()) {
+                if (!entry.isJsonNull) add(name, entry)
+            }
+        }
+    }
+
+    /** True when [extraJson] is blank or a JSON object, for the Settings field's error state. */
+    fun isValidExtraBody(extraJson: String?): Boolean =
+        extraJson.isNullOrBlank() || parseObject(extraJson) != null
+
+    internal fun parseObject(json: String?): JsonObject? {
+        if (json.isNullOrBlank()) return null
+        return try {
+            JsonParser.parseString(json).takeIf { it.isJsonObject }?.asJsonObject
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    /**
+     * The shared client's 15-second read limit is short for a hosted model that answers
+     * in one piece. Connect keeps the shared limit; read and write follow the setting.
+     * newBuilder() shares the connection pool.
+     */
+    fun httpClientFor(client: OkHttpClient, config: LLMConfig): OkHttpClient {
+        val seconds = config.resolvedCloudTimeoutSeconds().toLong()
+        return client.newBuilder()
+            .readTimeout(seconds, TimeUnit.SECONDS)
+            .writeTimeout(seconds, TimeUnit.SECONDS)
+            // The read limit starts again with every piece that arrives, so a reply that
+            // is streamed in a trickle would never run into it. This bounds the whole call.
+            .callTimeout(seconds * WHOLE_CALL_FACTOR, TimeUnit.SECONDS)
+            .build()
+    }
+
+    private const val WHOLE_CALL_FACTOR = 5L
+}
+
+/** Adds the key to this request. A server on the owner's own machine may want none: then no header is sent. */
+internal fun Request.Builder.bearer(apiKey: String): Request.Builder =
+    if (apiKey.isBlank()) this else header("Authorization", "Bearer $apiKey")
+
+/**
+ * Sends [request] and hands the response to [read], so that cancelling the coroutine ends
+ * the call at once.
+ *
+ * OkHttp's blocking `execute()` knows nothing of coroutines. After Stop, or when the owner
+ * sends a new message, it went on waiting for the model for as long as the timeout allows,
+ * and the chat stayed locked behind it. Here cancelling cancels the call itself, which
+ * also breaks off a body that is still being read (a streamed reply included). [read]
+ * runs on OkHttp's own thread and may block; the response is closed when it returns.
+ */
+internal suspend fun <T> OkHttpClient.cancellable(request: Request, read: (Response) -> T): T {
+    val call = newCall(request)
+    return suspendCancellableCoroutine { continuation ->
+        continuation.invokeOnCancellation { call.cancel() }
+        call.enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                // After a cancellation this is the cancelled call reporting in: nobody waits for it.
+                continuation.resumeWithException(e)
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                val result = try {
+                    response.use(read)
+                } catch (failure: Throwable) {
+                    continuation.resumeWithException(failure)
+                    return
+                }
+                continuation.resume(result)
+            }
+        })
+    }
+}
