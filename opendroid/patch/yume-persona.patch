+/**
+ * How her own time is wired into the app: what is stored and where, in which order the
+ * engine does things around the one call, and what the loop does with what comes back.
+ * The order and the callers are read off the source, like [PersonaWallTest] does.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaOwnTimeWiringTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memoryRepository: MemoryRepository
+    private lateinit var personaMemory: PersonaMemory
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memoryRepository = MemoryRepository(
+            memoryDao = database.memoryDao(),
+            taskHistoryDao = database.taskHistoryDao(),
+            macroDao = database.macroDao()
+        )
+        personaMemory = PersonaMemory(memoryRepository)
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private val engine = File(main, "core/persona/PersonaEngine.kt").readText()
+    private val loop = File(main, "core/agent/AgentLoop.kt").readText()
+
+    // ── What is stored ───────────────────────────────────────────────────────────────
+
+    @Test
+    fun `the time of her next moment is stored, so it still holds after the app was closed`() = runBlocking {
+        assertEquals(State(), personaMemory.ownTime())
+
+        val state = State(
+            on = true, wake = Wake.At(1_700_000_900_000), why = PersonaOwnTime.Why.ASKED,
+            moments = listOf(1_700_000_000_000), lastGapMillis = 900_000, lastAtMillis = 1_700_000_000_000,
+            lastDid = PersonaOwnTime.Did.KEPT
+        )
+        personaMemory.saveOwnTime(state)
+
+        // Another reader over the same table, as after a restart.
+        assertEquals(state, PersonaMemory(memoryRepository).ownTime())
+        personaMemory.saveOwnTime(state.copy(wake = Wake.WhenHeWrites))
+        assertEquals(Wake.WhenHeWrites, PersonaMemory(memoryRepository).ownTime().wake)
+    }
+
+    @Test
+    fun `what is stored about her own time is not a note of hers and never reaches a prompt as a fact`() = runBlocking {
+        personaMemory.saveOwnTime(State(on = true, wake = Wake.At(1_700_000_900_000), movedAsked = "in a bit"))
+
+        assertTrue(personaMemory.notes().isEmpty())
+        val facts = memoryRepository.getValidMemoriesByType(MemoryType.SEMANTIC)
+        assertTrue(facts.toString(), facts.none { it.value.contains("1700000900000") || it.value.contains("in a bit") })
+        // Emptying her notebook leaves it alone: the time she named is not a note.
+        personaMemory.empty()
+        assertEquals(Wake.At(1_700_000_900_000), personaMemory.ownTime().wake)
+    }
+
+    // ── The engine around the one call ───────────────────────────────────────────────
+
+    private val ownMoment = engine.substringAfter("suspend fun ownMoment(").substringBefore("private fun momentFacts(")
+
+    @Test
+    fun `a moment is one request of her own, on her route and through the gate, with no retry`() {
+        // One call, to her own provider, marked as hers.
+        assertEquals(1, Regex("""answeredWhole\(""").findAll(ownMoment).count())
+        assertEquals(0, Regex("""\.(complete|streamComplete)\(""").findAll(ownMoment).count())
+        assertTrue(ownMoment.contains("answeredWhole(chatProvider(config), withChatModel(ownTimeRequest(systemPrompt), config))"))
+        // Asked once, either way the answer can be read whole.
+        val whole = engine.substringAfter("internal suspend fun answeredWhole(").substringBefore("internal fun ownTimeRequest(")
+        assertEquals(1, Regex("""provider\.complete\(request\)""").findAll(whole).count())
+        assertEquals(1, Regex("""provider\.streamComplete\(""").findAll(whole).count())
+        assertTrue(whole.indexOf("if (!provider.streamsLive) {") in 0 until whole.indexOf("provider.streamComplete("))
+        val request = engine.substringAfter("internal fun ownTimeRequest(").substringBefore("/** Her replies want more variety")
+        assertTrue(request.contains("retryPolicy = RetryPolicy.NONE"))
+        // The room of a reply: a model that thinks before it writes still gets to write.
+        assertTrue(request.contains("maxTokens = CHAT_MAX_TOKENS,"))
+        assertTrue(request.contains("text = PersonaOwnTime.TURN, sender = ChatMessage.Sender.USER"))
+        // Its system text is her chat prompt as for a reply, then the talk, then the block of the moment, last.
+        val prompt = ownMoment.substringAfter("val systemPrompt = chatSystemPrompt(").substringBefore("answeredWhole(")
+        assertTrue(prompt.contains("inOwnTime = true, nowMillis = nowMillis"))
+        assertTrue(prompt.indexOf("PersonaOwnTime.talkBlock(dialogue)") in 0 until prompt.indexOf("PersonaOwnTime.momentBlock("))
+        assertTrue(prompt.contains("PersonaOwnTime.momentBlock(\n                        momentFacts(\n                            config, before, recentMessages, nowMillis, zone, heldBack, ownPlanWaits,"))
+        assertTrue(prompt.trimEnd().endsWith("makesPictures = makesPictures\n                        )\n                    )"))
+        // The talk is held back the way a reply's is, and no image is ever sent.
+        assertTrue(ownMoment.contains("holdBackPrivateResults = heldBack"))
+        // The app's lines reach back half an hour, or to her last moment when she wrote a command in it.
+        assertTrue(ownMoment.contains("activityMaxAgeMillis = PersonaOwnTime.appLineMaxAgeMillis(before, nowMillis)"))
+        // The request says that it is a moment of her own, and nothing else in her engine does.
+        assertTrue(request.contains("ownMoment = true"))
+        assertEquals(1, Regex("""ownMoment = true""").findAll(engine).count())
+        assertTrue(ownMoment.contains("shaped.dialogue.map { it.copy(imageBase64 = null) }"))
+    }
+
+    @Test
+    fun `the short wait is stored before the call, and the moment counts only once it was answered`() {
+        val wait = ownMoment.indexOf("wake = PersonaOwnTime.Wake.At(nowMillis + PersonaOwnTime.retryWaitMillis(state.failures)),")
+        val call = ownMoment.indexOf("answeredWhole(chatProvider(config)")
+        val counted = ownMoment.indexOf("val moments = state.momentsOfTheDay(nowMillis) + nowMillis")
+        assertTrue(wait >= 0)
+        assertTrue(call > wait)
+        assertTrue(counted > call)
+        assertEquals(15 * 60_000L, PersonaOwnTime.RETRY_AFTER_FAILURE_MILLIS)
+        assertEquals(PersonaOwnTime.RETRY_AFTER_FAILURE_MILLIS, PersonaOwnTime.retryWaitMillis(0))
+        // The attempt is counted before the call and the count is cleared only by an answer.
+        assertTrue(ownMoment.indexOf("failures = state.failures + 1") in wait until call)
+        assertTrue(ownMoment.indexOf("failures = 0") > counted)
+        // A failure stores nothing more, is logged by its error code only and is shown nowhere.
+        val failure = ownMoment.substringAfter("} catch (e: Exception) {").substringBefore("val moment = PersonaOwnTime.parse(")
+        assertTrue(failure.contains("(e as? LLMException)?.error?.code ?: e.javaClass.simpleName"))
+        assertTrue(failure.contains("return null"))
+        assertFalse(failure.contains("saveOwnTime"))
+        assertFalse(failure.contains("e.message"))
+        assertFalse(failure.contains("localizedMessage"))
+        // It is not due before its time, and a time she did not name is never due.
+        assertTrue(ownMoment.contains("val due = (state.wake as? PersonaOwnTime.Wake.At)?.atMillis ?: return null"))
+        assertTrue(ownMoment.contains("if (nowMillis < due - PersonaOwnTime.EARLY_SLACK_MILLIS) return null"))
+        // With her own time off nothing is read at all.
+        assertTrue(ownMoment.indexOf("if (!ownTimeIsOn(config)) return null") in 0 until ownMoment.indexOf("memory.ownTime()"))
+        // A time kept from before it was switched off is never due: seeing the switch is left to the alarm.
+        assertTrue(ownMoment.indexOf("if (!state.on) return null") in 0 until ownMoment.indexOf("val due = (state.wake as?"))
+        // And a moment never switches her own time on by itself: what was seen stays as it was seen.
+        assertFalse(ownMoment.contains("on = true"))
+        assertTrue(ownMoment.contains("planned.wake.takeIf { state.on }"))
+    }
