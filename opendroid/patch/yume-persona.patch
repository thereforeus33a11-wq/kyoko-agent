     }
+
+    private val custom = "Custom OpenAI Compatible"
+    private val fallbacks = listOf("On-Device AI", "Ollama", custom, "OpenAI")
+
+    /** Ollama on his own network, an encrypted model on the compatible provider, OpenAI hosted. */
+    private fun routes(active: String, policy: RoutePolicy = RoutePolicy.ANY) = LLMConfig(
+        routePolicy = policy,
+        activeProvider = active,
+        selectedModels = mapOf(custom to "e2ee-gemma-4-26b-a4b-uncensored-p", "OpenAI" to "gpt-4o"),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        ollamaUrl = "http://192.168.1.20:11434"
+    )
+
+    @Test
+    fun `a fallback is kept only if its route is at least as private as the active one`() {
+        fun kept(active: String) =
+            ProviderSelectionPolicy.keepingRoutePrivate(routes(active), fallbacks.filter { it != active })
+
+        // A plan that started on the phone stays on the phone.
+        assertEquals(emptyList<String>(), kept("On-Device AI"))
+        assertEquals(listOf("On-Device AI"), kept("Ollama"))
+        assertEquals(listOf("On-Device AI", "Ollama"), kept(custom))
+        // Only a request that a host could already read may go to another host.
+        assertEquals(listOf("On-Device AI", "Ollama", custom), kept("OpenAI"))
+        assertEquals(
+            listOf("OpenRouter"),
+            ProviderSelectionPolicy.keepingRoutePrivate(routes("OpenAI"), listOf("OpenRouter"))
+        )
+    }
+
+    @Test
+    fun `a fallback on a route the policy refuses is dropped whatever the active route is`() {
+        assertEquals(
+            listOf("On-Device AI", "Ollama", custom),
+            ProviderSelectionPolicy.keepingRoutePrivate(
+                routes("OpenAI", RoutePolicy.ENCRYPTED), listOf("On-Device AI", "Ollama", custom, "OpenRouter")
+            )
+        )
+        assertEquals(
+            listOf("On-Device AI", "Ollama"),
+            ProviderSelectionPolicy.keepingRoutePrivate(
+                routes("OpenAI", RoutePolicy.OWN_HARDWARE), listOf("On-Device AI", "Ollama", custom, "OpenRouter")
+            )
+        )
+    }
+
+    @Test
+    fun `the same provider is judged by where it is set up to run`() {
