+++ b/app/src/main/java/com/opendroid/ai/core/agent/MacroWords.kt
@@ -0,0 +1,112 @@
+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.actions.MacroRun
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * The words a RUN_MACRO step sends, known before he is asked (plan rule 7).
+ *
+ * A RUN_MACRO step names a macro and nothing else. The words go out from the steps the
+ * macro stores, which were saved earlier: by CREATE_MACRO, from a plan in his history, by
+ * hand, or before this build, when a tool's words were stored as they stood. So that a
+ * macro is never let through by its name alone, the loop reads the stored steps of every
+ * macro a plan runs before the card ([Saved]), and here they are read the way the macro
+ * will run them while she is on ([MacroRun.sort]: a step to a sender that only sends is
+ * gone, an address that only sends is taken off).
+ *
+ * Two things follow from that, both only while she is on. The card lists every word those
+ * steps send ([PlanApprovalSummary.outgoingTexts]), each under the plan's step and its
+ * place in the macro. And a plan that runs a macro whose steps send words is put to him on
+ * the card ([needsHisYes]): words saved in a macro are nobody's in this moment, so neither
+ * his approval setting nor her rein sends them before he has seen them.
+ *
+ * A macro made by an earlier step of the same plan is read from that step, since the one
+ * saved under its name is not the one that will run. Macros run from inside a macro are
+ * read too, a few deep ([MAX_DEPTH]); past that, or where one could not be read at all,
+ * a macro counts as one that sends words. Everything here is pure: steps in, answers out.
+ */
+object MacroWords {
+
+    /**
+     * The stored steps of the macros a plan runs, by name, as the loop read them from his
+     * saved macros. A macro that will not run (missing, switched off while she is on, or
+     * with no steps that can be read) has none. [unread] names a macro the loop could not
+     * look up at all.
+     */
+    data class Saved(val steps: Map<String, List<PlanStep>> = emptyMap(), val unread: Set<String> = emptySet()) {
+        companion object {
+            /** Nothing read: with her off, or for a plan that runs no macro. */
+            val NONE = Saved()
+        }
+    }
+
+    /** How many macros deep the steps are read: a plan's macro, a macro it runs, and one more. */
+    const val MAX_DEPTH = 3
+
+    private const val RUN_MACRO = "RUN_MACRO"
+    private const val CREATE_MACRO = "CREATE_MACRO"
+
+    /** What one RUN_MACRO step runs: the macro's own steps in its order, and those of them that run, as they run. */
+    internal class Run(val ordered: List<PlanStep>, val sorted: MacroRun.Sorted)
+
+    /** The name of the macro [step] runs, as the dispatcher resolves it, or null for any other step. */
+    fun macroName(step: PlanStep): String? {
+        val (action, params) = PlanApprovalSummary.resolved(step.action, step.params)
+        return if (action == RUN_MACRO) params["macroName"]?.trim()?.takeIf(String::isNotEmpty) else null
+    }
+
+    /**
+     * The names of the macros [steps] run, and of those that the macros a CREATE_MACRO
+     * among them stores would run: what the loop looks up in his saved macros.
+     */
+    fun namesRun(steps: List<PlanStep>, depth: Int = 0): Set<String> =
+        steps.flatMap { step ->
+            listOfNotNull(macroName(step)) +
+                (if (depth < MAX_DEPTH) PlanWords.stored(step)?.let { namesRun(it.steps, depth + 1) }.orEmpty() else emptySet())
+        }.toSet()
+
+    /**
+     * What [step], one of [steps], runs when it is a RUN_MACRO: the steps of a CREATE_MACRO
+     * of that name earlier in [steps], or else those [saved] holds under the name, sorted the
+     * way the macro will run them while she is on. Null for a step that runs no macro, and
+     * for a macro that will not run.
+     */
+    internal fun stepsOf(step: PlanStep, steps: List<PlanStep>, saved: Saved): Run? {
+        val name = macroName(step) ?: return null
+        val stored = madeEarlier(name, step, steps) ?: saved.steps[name] ?: return null
+        return Run(stored.sortedWith(compareBy<PlanStep> { it.order }), MacroRun.sort(stored, herOn = true))
+    }
+
+    /**
+     * Whether a pending step of [steps] (one of [only], when given) runs a macro whose steps
+     * send words: a message, a mail, a post, text typed into another app, an invitation, a
+     * payment note or a compose link ([PlanWords.of]), in it or in a macro it runs. While
+     * she is on, such a plan is put to him on the card first.
+     */
+    fun needsHisYes(steps: List<PlanStep>, saved: Saved, only: Set<String>? = null): Boolean =
+        steps.any { step ->
+            step.status == StepStatus.PENDING && (only == null || step.stepId in only) && sendsWords(step, steps, saved, depth = 0)
+        }
+
+    private fun sendsWords(step: PlanStep, steps: List<PlanStep>, saved: Saved, depth: Int): Boolean {
+        val name = macroName(step) ?: return false
+        // What could not be read, or lies deeper than was read, may send anything.
+        if (depth >= MAX_DEPTH || (name in saved.unread && madeEarlier(name, step, steps) == null)) return true
+        val run = stepsOf(step, steps, saved) ?: return false
+        return run.sorted.toRun.any { inner ->
+            PlanWords.of(inner, run.ordered, PlanWords.Sources(emptyList())) != null ||
+                sendsWords(inner, run.ordered, saved, depth + 1)
+        }
+    }
+
+    /** The steps the last CREATE_MACRO named [name] before [step] in [steps] stores, or null when there is none. */
+    private fun madeEarlier(name: String, step: PlanStep, steps: List<PlanStep>): List<PlanStep>? {
+        val at = steps.indexOf(step).takeIf { it >= 0 } ?: return null
+        return steps.take(at).lastOrNull { earlier ->
+            PlanApprovalSummary.resolved(earlier.action, earlier.params).let { (action, params) ->
+                action == CREATE_MACRO && params["name"]?.trim() == name
+            }
+        }?.let { PlanWords.stored(it)?.steps }
+    }
+}
