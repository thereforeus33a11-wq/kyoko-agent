+            }.exceptionOrNull()
+            assertSame(failure.toString(), failure, thrown)
+            assertEquals(failure.toString(), 0, secondTries)
+        }
+        assertFalse(engine.pictureRefused(config()))
+    }
+
+    @Test
+    fun `a reply that broke off after she had begun is not asked for again`() {
+        var secondTries = 0
+        val heard = mutableListOf<String>()
+        val failure = rejected()
+
+        val thrown = runCatching {
+            runBlocking {
+                engine.orWithoutPicture(config(), flow { emit("mm. "); throw failure }) {
+                    secondTries++
+                    flowOf("again")
+                }.collect { heard += it }
+            }
+        }.exceptionOrNull()
+
+        assertSame(failure, thrown)
+        assertEquals(listOf("mm. "), heard)
+        assertEquals(0, secondTries)
+        assertFalse(engine.pictureRefused(config()))
+    }
+
+    @Test
+    fun `when the second try fails too its failure is passed on and nothing is remembered`() {
+        val second = LLMException(LLMError.ServerError, custom, "her-vision-model", status = 503, retryable = true)
+
+        val thrown = runCatching {
+            runBlocking { engine.orWithoutPicture(config(), failing(rejected())) { failing(second) }.toList() }
+        }.exceptionOrNull()
+
+        assertSame(second, thrown)
+        // It was not the picture, or not only: she is sent one again next time.
+        assertFalse(engine.pictureRefused(config()))
+    }
+
+    @Test
+    fun `a reply that comes through with her picture is passed on untouched`() {
+        var secondTries = 0
+
+        val said = runBlocking {
+            engine.orWithoutPicture(config(), flowOf("thats ", "me")) {
+                secondTries++
+                flowOf("no")
+            }.toList()
+        }
+
+        assertEquals(listOf("thats ", "me"), said)
+        assertEquals(0, secondTries)
+        assertFalse(engine.pictureRefused(config()))
+    }
+
+    @Test
+    fun `a failure of the app's own while it stores her words is not taken for the model's`() {
+        var secondTries = 0
+        val storing = LLMErrorMapper.requestInvalid(custom, "her-vision-model")
+
+        // An empty first piece, so that she has not yet said anything when the failure comes:
+        // only where it came from tells it apart from a model turning the picture down.
+        val thrown = runCatching {
+            runBlocking {
+                engine.orWithoutPicture(config(), flowOf("", "mm")) {
+                    secondTries++
+                    flowOf("again")
+                }.collect { throw storing }
+            }
+        }.exceptionOrNull()
+
+        assertSame(storing, thrown)
+        assertEquals(0, secondTries)
+    }
+
+    @Test
+    fun `the model her replies go to is told apart by provider, model and address`() {
+        val base = config()
+        val key = PersonaEngine.chatModelKey(base)
+        assertTrue(key.contains(custom))
+        assertTrue(key.contains("her-vision-model"))
+        assertTrue(key.contains(endpoint))
+        // Settings that do not change where her replies go do not change it.
+        assertEquals(key, PersonaEngine.chatModelKey(base.copy(privateMode = true, personaLibraryChars = 4000)))
+        assertEquals(key, PersonaEngine.chatModelKey(base.copy(personaChatModel = "  ")))
+        for (other in listOf(
+            base.copy(personaChatModel = "another-model"),
+            base.copy(selectedModels = mapOf(custom to "another-model")),
+            base.copy(customEndpoints = mapOf(custom to "https://api.example.com/v1")),
+            base.copy(personaChatProvider = "OpenAI")
+        )) {
+            assertFalse(key == PersonaEngine.chatModelKey(other))
+        }
+    }
+
+    // ── Off the main thread ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `a look started from the screen reads his name off the main thread`() {
+        server.enqueue(reply("red hair down. gold hoops"))
+        val readsBefore = profile.readCount
+        // Robolectric runs a test on the main thread, which is where the screen calls from.
+        assertSame(android.os.Looper.getMainLooper(), android.os.Looper.myLooper())
+
+        val reading = runBlocking { engine.describeOwnPicture("aGVyLXBpY3R1cmVz") }
