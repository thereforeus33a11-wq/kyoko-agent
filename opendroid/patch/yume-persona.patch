+package com.opendroid.ai.core.life.reading
+
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.life.reading.HerFetcher.Fetched
+import com.opendroid.ai.core.life.reading.HerFetcher.Why
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.Dispatcher
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import mockwebserver3.RecordedRequest
+import okhttp3.Dns
+import okhttp3.OkHttpClient
+import okhttp3.tls.HandshakeCertificates
+import okhttp3.tls.HeldCertificate
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.net.InetAddress
+import java.net.UnknownHostException
+import java.nio.charset.Charset
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.TimeUnit
+
+/**
+ * The fetch guard: where a fetch may go (the SSRF table), what it sends, what it takes,
+ * robots.txt, and the pace per host. The sites are a TLS MockWebServer on loopback, which
+ * the test lets through by name only; the guard itself stays on for every other address.
+ */
+class HerFetcherTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val authority = HeldCertificate.Builder().certificateAuthority(0).build()
+    private val serverCertificate = HeldCertificate.Builder()
+        .commonName("site.test")
+        .addSubjectAlternativeName("site.test")
+        .addSubjectAlternativeName("other.test")
+        .addSubjectAlternativeName("private.test")
+        .signedBy(authority)
+        .build()
+    private val server = MockWebServer().also {
+        it.useHttps(HandshakeCertificates.Builder().heldCertificate(serverCertificate).build().sslSocketFactory())
+        it.start(InetAddress.getByName("127.0.0.1"), 0)
+    }
+    private val trusting = HandshakeCertificates.Builder().addTrustedCertificate(authority.certificate).build()
+    private val base = OkHttpClient.Builder().sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager).build()
+
+    private val loopback = InetAddress.getByName("127.0.0.1")
+
+    /** site.test and other.test are the test server; private.test is a home router. */
+    private val dns = Dns { host ->
+        when (host) {
+            "site.test", "other.test" -> listOf(InetAddress.getByAddress(host, loopback.address))
+            "private.test" -> listOf(InetAddress.getByAddress(host, byteArrayOf(192.toByte(), 168.toByte(), 1, 1)))
+            "mixed.test" -> listOf(InetAddress.getByAddress(host, byteArrayOf(93, 184.toByte(), 216.toByte(), 34)), InetAddress.getByAddress(host, byteArrayOf(10, 0, 0, 1)))
+            else -> throw UnknownHostException(host)
+        }
+    }
+
+    private var now = 1_000_000L
+    private val waits = CopyOnWriteArrayList<Long>()
+    private val ledger = OwnLedger({ File(folder.root, "ledger.json") }, { now })
+
+    private fun fetcher(limits: HerFetcher.Limits = HerFetcher.Limits(perHostMillis = 0)) = HerFetcher(
+        base = base,
+        systemDns = dns,
+        // The test server is on loopback: let it through by its names, and nothing else.
+        addressAllowed = { address -> (address.hostName in setOf("site.test", "other.test") && address.isLoopbackAddress) || PublicAddress.isPublic(address) },
+        limits = limits,
+        clock = { now },
+        pause = { waits += it; now += it },
+        ledger = ledger
+    )
+
+    private fun url(path: String, host: String = "site.test") = "https://$host:${server.port}$path"
+
+    private val requests = CopyOnWriteArrayList<RecordedRequest>()
+
+    private fun serve(robots: String? = "User-agent: *\nAllow: /\n", route: (RecordedRequest) -> MockResponse) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                requests += request
+                if (request.target == "/robots.txt") {
+                    return if (robots == null) MockResponse.Builder().code(404).build()
+                    else MockResponse.Builder().code(200).addHeader("Content-Type", "text/plain").body(robots).build()
+                }
+                return route(request)
+            }
+        }
+    }
+
+    private fun html(body: String, type: String = "text/html; charset=utf-8") =
+        MockResponse.Builder().code(200).addHeader("Content-Type", type).body(body).build()
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    // ── Where a fetch may go ─────────────────────────────────────────────────────────
+
+    private fun v4(vararg parts: Int) = InetAddress.getByAddress(parts.map { it.toByte() }.toByteArray())
+    private fun v6(text: String) = InetAddress.getByName(text)
+
+    @Test
+    fun `the SSRF table - only public addresses`() {
+        val refused = listOf(
+            v4(127, 0, 0, 1), v4(0, 0, 0, 0), v4(10, 1, 2, 3), v4(172, 16, 0, 1), v4(172, 31, 255, 255), v4(192, 168, 0, 1),
+            v4(169, 254, 169, 254), v4(100, 64, 0, 1), v4(100, 127, 255, 254), v4(192, 0, 0, 1), v4(192, 0, 2, 1),
+            v4(198, 18, 0, 1), v4(198, 51, 100, 7), v4(203, 0, 113, 9), v4(224, 0, 0, 1), v4(255, 255, 255, 255),
+            v6("::1"), v6("::"), v6("fe80::1"), v6("fc00::1"), v6("fd12:3456::1"), v6("fec0::1"), v6("ff02::1"),
+            v6("::ffff:127.0.0.1"), v6("::ffff:10.0.0.1"), v6("64:ff9b::a00:1"), v6("2002:a00:1::"), v6("2001:0:4136:e378::1"),
+            v6("2001:db8::1")
+        )
+        for (address in refused) assertFalse(address.hostAddress, PublicAddress.isPublic(address))
+        val public = listOf(v4(93, 184, 216, 34), v4(8, 8, 8, 8), v4(100, 63, 0, 1), v4(100, 128, 0, 1), v4(172, 32, 0, 1), v6("2606:4700::1111"), v6("::ffff:8.8.8.8"), v6("2002:808:808::"))
+        for (address in public) assertTrue(address.hostAddress, PublicAddress.isPublic(address))
+    }
+
+    @Test
+    fun `names that are literals or local are refused before any lookup`() {
+        val table = mapOf(
+            "10.0.0.1" to Why.IP_LITERAL, "127.1" to Why.IP_LITERAL, "2130706433" to Why.IP_LITERAL, "0x7f.0.0.1" to Why.IP_LITERAL,
+            "[::1]" to Why.IP_LITERAL, "fe80::1" to Why.IP_LITERAL,
+            "localhost" to Why.LOCAL_NAME, "router" to Why.LOCAL_NAME, "printer.local" to Why.LOCAL_NAME,
+            "abc.onion" to Why.LOCAL_NAME, "nas.home.arpa" to Why.LOCAL_NAME, "dev.localhost" to Why.LOCAL_NAME
+        )
+        for ((host, why) in table) assertEquals(host, why, HerFetcher.hostRefusal(host))
+        assertNull(HerFetcher.hostRefusal("ja.wikipedia.org"))
+        assertNull(HerFetcher.hostRefusal("123.example.com"))
+    }
+
+    @Test
+    fun `only https, and never to a private or unknown address`() = runBlocking {
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.NOT_HTTPS), fetcher.fetch("http://site.test/"))
+        assertEquals(Fetched.Refused(Why.IP_LITERAL), fetcher.fetch("https://192.168.1.1/admin"))
+        assertEquals(Fetched.Refused(Why.IP_LITERAL), fetcher.fetch("https://[::1]/"))
+        assertEquals(Fetched.Refused(Why.LOCAL_NAME), fetcher.fetch("https://printer.local/"))
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch(url("/", host = "private.test")))
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch("https://mixed.test/"))
+        assertEquals(Fetched.Refused(Why.NO_ADDRESS), fetcher.fetch("https://nowhere.test/"))
+        assertEquals(Fetched.Refused(Why.BAD_URL), fetcher.fetch("not a url"))
+        assertEquals(0, server.requestCount)
+    }
+
+    @Test
+    fun `each redirect is checked again - a redirect to a private address is refused`() = runBlocking {
+        serve { request ->
+            when (request.target) {
+                "/to-private" -> MockResponse.Builder().code(302).addHeader("Location", url("/admin", host = "private.test")).build()
+                "/to-literal" -> MockResponse.Builder().code(301).addHeader("Location", "https://10.0.0.1/").build()
+                "/to-http" -> MockResponse.Builder().code(302).addHeader("Location", "http://site.test:${server.port}/").build()
+                "/to-other" -> MockResponse.Builder().code(307).addHeader("Location", url("/page", host = "other.test")).build()
+                "/page" -> html("<p>arrived</p>")
+                else -> MockResponse.Builder().code(404).build()
+            }
+        }
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch(url("/to-private")))
+        assertEquals(Fetched.Refused(Why.IP_LITERAL), fetcher.fetch(url("/to-literal")))
+        assertEquals(Fetched.Refused(Why.NOT_HTTPS), fetcher.fetch(url("/to-http")))
+        val page = fetcher.fetch(url("/to-other")) as Fetched.Page
+        assertEquals("other.test", page.host)
+        assertTrue(page.text().contains("arrived"))
+        assertTrue(requests.none { it.url.host == "private.test" })
+    }
+
+    @Test
+    fun `at most three redirects`() = runBlocking {
+        serve { request ->
+            val hop = request.target!!.removePrefix("/hop").toIntOrNull() ?: 0
+            if (hop >= 10) html("<p>end</p>") else MockResponse.Builder().code(302).addHeader("Location", "/hop${hop + 1}").build()
+        }
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.TOO_MANY_REDIRECTS), fetcher.fetch(url("/hop0")))
+        assertTrue(fetcher.fetch(url("/hop7")) is Fetched.Page)
+    }
+
+    // ── What a fetch sends and takes ─────────────────────────────────────────────────
+
+    @Test
+    fun `no cookies, no referer, no language and a generic user agent`() = runBlocking {
+        serve { html("<p>hi</p>").newBuilder().addHeader("Set-Cookie", "session=abc; Path=/").build() }
+        val fetcher = fetcher()
+        fetcher.fetch(url("/a"))
+        fetcher.fetch(url("/b"))
+        val pages = requests.filter { it.target != "/robots.txt" }
+        assertEquals(2, pages.size)
+        for (request in pages) {
+            assertNull(request.headers["Cookie"])
+            assertNull(request.headers["Referer"])
+            assertNull(request.headers["Accept-Language"])
+            assertNull(request.headers["Authorization"])
+            assertEquals(HerFetcher.USER_AGENT, request.headers["User-Agent"])
+        }
+        assertEquals("YumeReader/1.0 (personal reader)", HerFetcher.USER_AGENT)
+    }
+
+    @Test
+    fun `only html, xml or json is taken`() = runBlocking {
+        serve { request ->
+            when (request.target) {
+                "/image" -> MockResponse.Builder().code(200).addHeader("Content-Type", "image/png").body("PNG").build()
+                "/feed" -> html("<rss></rss>", "application/rss+xml")
+                "/json" -> html("{}", "application/json")
+                "/plain" -> html("hello", "text/plain")
+                "/missing" -> MockResponse.Builder().code(404).build()
+                else -> html("<p>x</p>")
+            }
+        }
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.WRONG_TYPE, 200), fetcher.fetch(url("/image")))
+        assertEquals(Fetched.Refused(Why.WRONG_TYPE, 200), fetcher.fetch(url("/plain")))
+        assertTrue(fetcher.fetch(url("/feed")) is Fetched.Page)
+        assertTrue(fetcher.fetch(url("/json")) is Fetched.Page)
+        assertEquals(Fetched.Refused(Why.HTTP_ERROR, 404), fetcher.fetch(url("/missing")))
+    }
+
+    @Test
+    fun `a page is cut at the size limit and a slow one times out`() = runBlocking {
+        serve { request ->
+            when (request.target) {
+                "/big" -> html("<p>" + "a".repeat(5_000) + "</p>")
+                else -> html("<p>slow</p>").newBuilder().headersDelay(3, TimeUnit.SECONDS).build()
+            }
+        }
+        val fetcher = fetcher(HerFetcher.Limits(perHostMillis = 0, maxBytes = 1_000, timeoutMillis = 1_000))
+        val big = fetcher.fetch(url("/big")) as Fetched.Page
+        assertEquals(1_000, big.bytes.size)
+        assertTrue(big.truncated)
+        assertEquals(Fetched.Refused(Why.TIMEOUT), fetcher.fetch(url("/slow")))
+    }
+
+    @Test
+    fun `a fetch is cancelled at once when the outing ends`() = runBlocking {
+        serve { request ->
+            if (request.target == "/slow") html("<p>slow</p>").newBuilder().headersDelay(10, TimeUnit.SECONDS).build() else html("<p>x</p>")
+        }
+        val fetcher = fetcher()
+        fetcher.fetch(url("/warm"))
+        val started = System.nanoTime()
+        val job = launch(Dispatchers.Default) { fetcher.fetch(url("/slow")) }
+        delay(300)
+        job.cancelAndJoin()
+        val tookMillis = (System.nanoTime() - started) / 1_000_000
+        assertTrue("took $tookMillis ms", tookMillis < 5_000)
+    }
+
+    @Test
+    fun `every fetch that left the phone is counted in her ledger`() = runBlocking {
+        serve { html("<p>x</p>") }
+        val fetcher = fetcher()
+        fetcher.fetch(url("/one"))
+        fetcher.fetch("http://site.test/")
+        // robots.txt and the page.
+        assertEquals(2, ledger.calls()!!.count { it.purpose == OwnPurpose.FETCH })
+    }
+
+    // ── robots.txt and pace ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `robots txt is honoured, for her token before the star group, and cached`() = runBlocking {
+        serve(robots = "User-agent: *\nDisallow: /private\n\nUser-agent: YumeReader\nDisallow: /no-yume\nAllow: /no-yume/ok\n") { html("<p>x</p>") }
+        val fetcher = fetcher()
+        assertTrue(fetcher.fetch(url("/private/page")) is Fetched.Page)
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher.fetch(url("/no-yume/page")))
+        assertTrue(fetcher.fetch(url("/no-yume/ok/page")) is Fetched.Page)
+        assertEquals(1, requests.count { it.target == "/robots.txt" })
+    }
+
+    @Test
+    fun `a missing robots txt allows all and an unreachable one allows none`() = runBlocking {
+        serve(robots = null) { html("<p>x</p>") }
+        assertTrue(fetcher().fetch(url("/page")) is Fetched.Page)
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse =
+                if (request.target == "/robots.txt") MockResponse.Builder().code(503).build() else html("<p>x</p>")
+        }
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher().fetch(url("/page")))
+    }
+
+    @Test
+    fun `robots rules - longest match wins, allow wins a tie, star and dollar`() {
+        val rules = Robots.parse(
+            """
+            # comment
+            User-agent: otherbot
+            Disallow: /
+
+            User-agent: *
+            Disallow: /search
+            Allow: /search/about
+            Disallow: /*.pdf$
+            Disallow: /tmp/
+            Allow: /tmp/
+            """.trimIndent(),
+            HerFetcher.AGENT_TOKEN
+        )
+        assertFalse(rules.allows("/search?q=egg"))
+        assertTrue(rules.allows("/search/about"))
+        assertFalse(rules.allows("/files/a.pdf"))
+        assertTrue(rules.allows("/files/a.pdf?x=1"))
+        assertTrue(rules.allows("/tmp/x"))
+        assertTrue(rules.allows("/"))
+        assertTrue(Robots.parse("User-agent: *\nDisallow:\n", "yumereader").allows("/anything"))
+        assertFalse(Robots.parse("User-agent: yumereader\nUser-agent: other\nDisallow: /\n", "yumereader").allows("/x"))
+    }
+
+    @Test
+    fun `her group is the one that names her token, not one whose name stands inside hers, nor an empty name`() {
+        val text = "User-agent:\nDisallow: /\n\nUser-agent: reader\nDisallow: /\n\nUser-agent: *\nDisallow: /closed\n"
+        val rules = Robots.parse(text, HerFetcher.AGENT_TOKEN)
+        assertTrue(rules.allows("/open"))
+        assertFalse(rules.allows("/closed"))
+        assertFalse(Robots.parse("User-agent: YumeReader/1.0\nDisallow: /\n", HerFetcher.AGENT_TOKEN).allows("/x"))
+    }
+
+    /** Wikimedia's robots.txt, the part under `User-agent: *` that decides her reading (long-standing). */
+    private val wikimediaRobots = """
+        User-agent: *
+        Allow: /w/api.php?action=mobileview&
+        Allow: /w/load.php?
+        Allow: /api/rest_v1/?doc
+        Disallow: /w/
+        Disallow: /api/
+        Disallow: /trap/
+        Disallow: /wiki/Special:
+    """.trimIndent()
+
+    @Test
+    fun `Wikipedia's interface is read without robots txt, which closes it to crawlers, and a page by link still honours it`() = runBlocking {
+        serve(robots = wikimediaRobots) { request ->
+            if (request.target.orEmpty().startsWith("/w/")) html("{\"pages\":[]}", "application/json") else html("<p>x</p>")
+        }
+        val fetcher = fetcher()
+        val search = url("/w/rest.php/v1/search/page?q=egg&limit=8")
+        val extract = url("/w/api.php?action=query&prop=extracts&format=json&titles=Egg")
+        // As a crawler would read it, both are closed.
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher.fetch(search))
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher.fetch(extract))
+        // The app's own calls to the interface are fetched, with every other rule kept.
+        assertTrue(fetcher.fetch(search, robots = false) is Fetched.Page)
+        assertTrue(fetcher.fetch(extract, robots = false) is Fetched.Page)
+        assertEquals(Fetched.Refused(Why.PRIVATE_ADDRESS), fetcher.fetch("https://private.test/w/api.php", robots = false))
+        // An article page by its link is open to readers, and a special page is not.
+        assertTrue(fetcher.fetch(url("/wiki/Egg_(magazine)")) is Fetched.Page)
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher.fetch(url("/wiki/Special:Random")))
+    }
+
+    @Test
+    fun `a feed is read the way a feed reader reads it, though robots txt closes it to crawlers`() = runBlocking {
+        // YouTube's robots.txt closes its channel feeds to crawlers.
+        serve(robots = "User-agent: *\nDisallow: /feeds/videos.xml\n") {
+            html("<?xml version=\"1.0\"?><feed xmlns=\"http://www.w3.org/2005/Atom\"><title>t</title></feed>", "application/atom+xml")
+        }
+        val feed = url("/feeds/videos.xml?channel_id=UCxxxxxxxxxxxxxxxxxxxxxx")
+        val fetcher = fetcher()
+        assertEquals(Fetched.Refused(Why.ROBOTS), fetcher.fetch(feed))
+        assertTrue(fetcher.fetch(feed, robots = false) is Fetched.Page)
+    }
+
+    // ── Charsets ─────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `a Shift_JIS page declared in its meta is read as Japanese`() = runBlocking {
+        val sjis = Charset.forName("Shift_JIS")
+        val body = "<html><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=Shift_JIS\"><title>ギャル</title></head><body><p>渋谷のギャル文化について。</p></body></html>"
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse =
+                if (request.target == "/robots.txt") MockResponse.Builder().code(404).build()
+                else MockResponse.Builder().code(200).addHeader("Content-Type", "text/html").body(okio.Buffer().write(body.toByteArray(sjis))).build()
+        }
+        val page = fetcher().fetch(url("/sjis")) as Fetched.Page
+        assertTrue(page.text().contains("渋谷のギャル文化について。"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/reading/ReadableTest.kt b/app/src/test/java/com/opendroid/ai/core/life/reading/ReadableTest.kt
