+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/EarsModels.kt
@@ -0,0 +1,137 @@
+package com.opendroid.ai.core.life.ears
+
+/**
+ * The models her ears run on, as the official sherpa-onnx releases publish them
+ * (github.com/k2-fsa/sherpa-onnx/releases). Never bundled with the app: each is fetched
+ * over Wi-Fi when he taps to get it, checked against the SHA-256 pinned here (and, for an
+ * archive, each file taken out of it against its own), and kept in the app's no-backup
+ * storage until he deletes it. The hashes were taken from downloads of these exact URLs
+ * on 2026-11-18, and the files were run through this app's own code before they were
+ * pinned (VAD, both recognisers and the speaker model, on recorded English and Japanese).
+ *
+ *  - Silero VAD (MIT): tells speech from the rest, all the time the ears are open.
+ *  - SenseVoice-small, int8 (FunASR model licence): English, Japanese, Chinese, Korean,
+ *    Cantonese. The default, since he speaks English with some Japanese words.
+ *  - Moonshine base, English, quantized (MIT): the lighter, English-only choice.
+ *  - TitaNet-small from NVIDIA NeMo (CC-BY-4.0): a voiceprint per segment, so that only
+ *    his voice is kept once it is enrolled. Of the five English speaker models sherpa-onnx
+ *    publishes, it kept voices apart best on the recordings it was tried on, short ones
+ *    included, and is the quickest; both CAM++ models scored other speakers as high as
+ *    the same one. On acted feelings (RAVDESS) every model tried was weaker against voices of
+ *    the same sex: TitaNet-small about 27% equal error, TitaNet-large 25%, WeSpeaker
+ *    ResNet34 41%, 3D-Speaker ERes2NetV2 18% at six times the cost; the threshold is tuned
+ *    on the phone.
+ *
+ * SenseVoice also gives a tone and a sound tag for each stretch ([HowItSounded]): the sound
+ * tag named three of six recorded laughs and a cough; the tone tag is mostly "unknown" on
+ * English (one of 40 acted clips in the int8 model, the same in the full-size one), so how
+ * a thing was said rests mostly on the phone's own measures ([Acoustics]).
+ */
+object EarsModels {
+
+    /** What a model is for. */
+    enum class Part { VAD, RECOGNIZER, SPEAKER }
+
+    /** A file the app keeps: where it sits in the model's folder, its size and its SHA-256. */
+    data class Kept(val name: String, val size: Long, val sha256: String)
+
+    /**
+     * One download. [archiveDir] is the folder inside a `.tar.bz2` that holds [files];
+     * null for a download that is itself the one file kept.
+     */
+    data class Model(
+        val id: String,
+        val part: Part,
+        val url: String,
+        val size: Long,
+        val sha256: String,
+        val archiveDir: String?,
+        val files: List<Kept>,
+        val licence: String,
+    ) {
+        /** The bytes it takes on the phone once installed. */
+        val installedBytes: Long get() = files.sumOf { it.size }
+    }
+
+    val SILERO_VAD = Model(
+        id = "silero-vad",
+        part = Part.VAD,
+        url = "$RELEASES/asr-models/silero_vad.onnx",
+        size = 643_854,
+        sha256 = "9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6",
+        archiveDir = null,
+        files = listOf(Kept("silero_vad.onnx", 643_854, "9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6")),
+        licence = "MIT",
+    )
+
+    val SENSE_VOICE = Model(
+        id = "sense-voice-small-int8-2024-07-17",
+        part = Part.RECOGNIZER,
+        url = "$RELEASES/asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17.tar.bz2",
+        size = 163_002_883,
+        sha256 = "7d1efa2138a65b0b488df37f8b89e3d91a60676e416f515b952358d83dfd347e",
+        archiveDir = "sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17",
+        files = listOf(
+            Kept("model.int8.onnx", 239_233_841, "c71f0ce00bec95b07744e116345e33d8cbbe08cef896382cf907bf4b51a2cd51"),
+            Kept("tokens.txt", 315_894, "f449eb28dc567533d7fa59be34e2abca8784f771850c78a47fb731a31429a1dc"),
+        ),
+        licence = "FunASR model licence",
+    )
+
+    val MOONSHINE = Model(
+        id = "moonshine-base-en-quantized-2026-02-27",
+        part = Part.RECOGNIZER,
+        url = "$RELEASES/asr-models/sherpa-onnx-moonshine-base-en-quantized-2026-02-27.tar.bz2",
+        size = 111_266_225,
+        sha256 = "43232c1d13013d37317163baec3135bd771a186a4356f28c889bab453bb0e891",
+        archiveDir = "sherpa-onnx-moonshine-base-en-quantized-2026-02-27",
+        files = listOf(
+            Kept("encoder_model.ort", 31_326_816, "7c66495948d0d08ec1af454cd4b5514862ae6511e94712a60e6d83eaec8dc8cf"),
+            Kept("decoder_model_merged.ort", 109_424_400, "d9d7b333af34bc552580576ddcf248a1c6c839e0d3b43b09afb9376ed009899d"),
+            Kept("tokens.txt", 549_350, "2870d843e14c1e187bf1913a521562a63b53933814bd7f2145120468f494a049"),
+        ),
+        licence = "MIT",
+    )
+
+    val SPEAKER = Model(
+        id = "titanet-small-en",
+        part = Part.SPEAKER,
+        url = "$RELEASES/speaker-recongition-models/nemo_en_titanet_small.onnx",
+        size = 40_257_283,
+        sha256 = "ad4a1802485d8b34c722d2a9d04249662f2ece5d28a7a039063ca22f515a789e",
+        archiveDir = null,
+        files = listOf(
+            Kept("nemo_en_titanet_small.onnx", 40_257_283, "ad4a1802485d8b34c722d2a9d04249662f2ece5d28a7a039063ca22f515a789e"),
+        ),
+        licence = "CC-BY-4.0 (NVIDIA NeMo)",
+    )
+
+    /** Which recogniser turns his words into text (`personaEarsModel`). */
+    enum class Recognizer(val model: Model, val label: String) {
+        SENSE_VOICE(EarsModels.SENSE_VOICE, "SenseVoice-small (English and Japanese)"),
+        MOONSHINE(EarsModels.MOONSHINE, "Moonshine base (English only, lighter)");
+
+        companion object {
+            /** A stored name back to a choice; anything unknown is the default. */
+            fun of(name: String?): Recognizer = entries.firstOrNull { it.name == name } ?: SENSE_VOICE
+        }
+    }
+
+    /** Everything the ears need with [recognizer]: the VAD, the recogniser and the speaker model. */
+    fun needed(recognizer: Recognizer): List<Model> = listOf(SILERO_VAD, recognizer.model, SPEAKER)
+
+    /** Every model the app knows, so that a delete leaves none behind. */
+    val ALL: List<Model> = listOf(SILERO_VAD, SENSE_VOICE, MOONSHINE, SPEAKER)
+
+    /** What a download of [models] fetches, in bytes. */
+    fun downloadBytes(models: List<Model>): Long = models.sumOf { it.size }
+
+    /**
+     * The free space a download of [model] needs at its peak: the download itself while
+     * its files are taken out of it, plus a margin.
+     */
+    fun peakBytes(model: Model): Long = model.size + (if (model.archiveDir != null) model.installedBytes else 0L) + MARGIN
+
+    private const val RELEASES = "https://github.com/k2-fsa/sherpa-onnx/releases/download"
+    private const val MARGIN = 32L * 1024 * 1024
+}
