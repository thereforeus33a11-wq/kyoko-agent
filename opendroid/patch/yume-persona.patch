+        }
+    }
+
+    /** The captions that tell her what is on her pictures when she cannot be shown them: her own pictures only. */
+    fun captions(pictures: List<PersonaPicture>): List<String> =
+        pictures.filter { it.kind == PersonaPicture.Kind.SELF }.map { it.caption.trim() }.filter { it.isNotEmpty() }
+
+    /** "I can't", "I won't", "I am unable to", the way a model writes it: with the apostrophe. */
+    private const val CANNOT =
+        """(?:i (?:can['’]t|cannot|can not|won['’]t|will not|am (?:unable|not able) to)|i['’]m (?:unable|not able) to)"""
+
+    /** What a refusal is about when it names it: the picture, the request, the people on it. */
+    private const val REFUSED_THING =
+        """(?:(?:this|that|it)(?=\s*(?:[.!,;:]|$))|(?:(?:this|that|the|these|those|any|your|such|an?) )?""" +
