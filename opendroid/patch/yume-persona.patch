+import org.junit.Test
+
+/**
+ * Venice's Private tier, trusted for her at his order: which models are of it (this build's
+ * copy of Venice's catalog, and the live check on the phone, which wins), what each takes
+ * besides text, and the route a call to one takes: private only while he trusts it, never
+ * for an encrypted id, another host, plain http or another provider.
+ */
+class VenicePrivateTierTest {
+
+    private val custom = "Custom OpenAI Compatible"
+    private val venice = "https://api.venice.ai/api/v1"
+
+    private fun config(trust: Boolean, model: String = VenicePrivateTier.SEEING_BRAIN, endpoint: String = venice) = LLMConfig(
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "e2ee-deepseek-v4-1-flash-1017-abliterated"),
+        customEndpoints = mapOf(custom to endpoint),
+        personaChatProvider = custom,
+        personaChatModel = model,
+        personaChatModelProvider = custom,
+        trustVenicePrivate = trust
+    )
+
+    @Test
+    fun `the built-in list is Venice's Private tier as its catalog lists it, with what each model takes`() {
+        assertEquals(63, VenicePrivateTier.BUILT_IN.size)
+        val seeing = VenicePrivateTier.BUILT_IN.getValue("deepseek-v4-1-flash-1017-uncensored")
+        assertTrue(seeing.vision)
+        assertEquals(10, seeing.maxImages)
+        assertTrue(seeing.uncensored)
+        assertFalse(seeing.audio)
+        for (hearing in listOf("xiaomi-mimo-v2-5", "xiaomi-mimo-v2-6-flash")) {
+            assertTrue(hearing, VenicePrivateTier.BUILT_IN.getValue(hearing).audio)
+        }
+        for (seer in listOf("qwen-3-8-27b", "venice-uncensored-1-2", "gemma-4-uncensored", "kimi-k3", "grok-4-7")) {
+            assertTrue(seer, VenicePrivateTier.BUILT_IN.getValue(seer).vision)
+        }
+        assertFalse(VenicePrivateTier.BUILT_IN.getValue("deepseek-v4-flash").vision)
+        // Nothing encrypted and nothing of the Anonymized tier is in it.
+        assertTrue(VenicePrivateTier.BUILT_IN.keys.none { it.startsWith("e2ee-") || it.startsWith("claude-") || it.startsWith("gemini-") })
+        assertTrue(VenicePrivateTier.E2EE_SEEING.all { it.startsWith("e2ee-") })
+    }
+
+    @Test
+    fun `an encrypted id is never of the tier, and an id the build does not know is not until Venice lists it`() {
+        val plain = LLMConfig()
+        assertTrue(VenicePrivateTier.isPrivateTier(VenicePrivateTier.SEEING_BRAIN, plain))
+        assertFalse(VenicePrivateTier.isPrivateTier("e2ee-deepseek-v4-1-flash-1017-abliterated", plain))
+        assertFalse(VenicePrivateTier.isPrivateTier("claude-opus-5-5", plain))
+        assertFalse(VenicePrivateTier.isPrivateTier("brand-new-model", plain))
+        assertFalse(VenicePrivateTier.isPrivateTier("", plain))
+        assertFalse(VenicePrivateTier.isPrivateTier("not a model id", plain))
+    }
+
+    private val listing = """
+        {"data":[
+          {"id":"brand-new-model","model_spec":{"privacy":"private","capabilities":{"supportsVision":true,"maxImages":4,"supportsAudioInput":true}}},
+          {"id":"deepseek-v4-1-flash-1017-uncensored","model_spec":{"privacy":"anonymized","capabilities":{"supportsVision":true}}},
+          {"id":"e2ee-qwen3-8-27b","model_spec":{"privacy":"private","capabilities":{"supportsVision":true,"supportsE2EE":true,"supportsTeeAttestation":true}}},
+          {"id":"odd", "model_spec":{}},
+          "not a model"
+        ]}
+    """.trimIndent()
+
+    @Test
+    fun `the live check wins where it names a model, and is kept as a few words`() {
+        val parsed = VenicePrivateTier.parse(listing)!!
+        assertEquals(setOf("brand-new-model", "deepseek-v4-1-flash-1017-uncensored", "e2ee-qwen3-8-27b", "odd"), parsed.keys)
+        val checked = VenicePrivateTier.withLive(LLMConfig(), parsed, 42L)
+        assertEquals(42L, checked.veniceTiersAt)
+        // A new model Venice lists as private is taken, with what it takes.
+        assertTrue(VenicePrivateTier.isPrivateTier("brand-new-model", checked))
+        assertTrue(VenicePrivateTier.hears("brand-new-model", checked))
+        assertEquals(4, VenicePrivateTier.caps("brand-new-model", checked)?.maxImages)
+        // A model Venice lists outside the tier now is not, whatever the build's copy says.
+        assertFalse(VenicePrivateTier.isPrivateTier("deepseek-v4-1-flash-1017-uncensored", checked))
+        // A listed model that says nothing of its tier: the build's copy decides.
+        assertFalse(VenicePrivateTier.isPrivateTier("odd", checked))
+        // Encrypted stays encrypted.
+        assertFalse(VenicePrivateTier.isPrivateTier("e2ee-qwen3-8-27b", checked))
+        assertEquals("private;vision;img=4;audio", checked.veniceTiers["brand-new-model"])
+        for (encoded in checked.veniceTiers.values) assertEquals(encoded, VenicePrivateTier.encode(VenicePrivateTier.decode(encoded)!!))
+        assertNull(VenicePrivateTier.parse("not json"))
+        assertNull(VenicePrivateTier.parse("""{"object":"list"}"""))
+        assertTrue(VenicePrivateTier.liveLine(checked, "brand-new-model").contains("in its Private tier, taking pictures and sound."))
+        assertTrue(VenicePrivateTier.liveLine(LLMConfig(), "x").contains("has not been checked on this phone yet"))
+    }
+
+    @Test
+    fun `a call to a Private-tier model is private only while he trusts the tier`() {
+        assertEquals(RoutePrivacy.HOSTED, RouteClassifier.personaRoute(config(trust = false)))
