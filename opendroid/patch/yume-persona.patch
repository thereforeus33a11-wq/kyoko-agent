+    /** One line per caption, as many whole captions as fit into [MAX_PICTURE_LIST_CHARS]. */
+    private fun pictureList(captions: List<String>): String {
+        val lines = ArrayList<String>()
+        var used = 0
+        for (caption in captions) {
+            val said = caption.replace(Regex("""\s+"""), " ").trim()
+            if (said.isEmpty()) continue
+            // Counted as it is stored, with its dash and its line break: what keeps a
+            // caption from opening a section must not be what pushes the last one out.
+            val cost = said.length + 3
+            if (used + cost > MAX_PICTURE_LIST_CHARS) continue
+            lines += "- " + captionOnOneLine(said)
+            used += cost
+        }
+        return lines.joinToString("\n")
+    }
