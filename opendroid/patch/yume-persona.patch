+                    }
+                )
+
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalArrangement = Arrangement.SpaceBetween,
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    Column(modifier = Modifier.weight(1f).padding(end = 12.dp)) {
+                        Text(
+                            text = "Keep this under her awareness in every reply",
+                            fontSize = 15.sp,
+                            fontWeight = FontWeight.SemiBold,
+                            color = TextPrimary
+                        )
+                        Text(
+                            text = "Off: the text below is kept but left out of her prompt.",
+                            fontSize = 12.sp,
+                            color = TextSecondary
+                        )
+                    }
+                    Switch(
+                        checked = underEnabled,
+                        onCheckedChange = viewModel::setUnderEnabled,
+                        colors = SwitchDefaults.colors(
+                            checkedThumbColor = TextPrimary,
+                            checkedTrackColor = TextPrimary.copy(alpha = 0.5f)
+                        )
+                    )
+                }
+                Text(
+                    text = when {
+                        viewModel.underHasUnsavedChanges -> "Your wording · ${viewModel.underText.length} characters · not saved"
+                        viewModel.underIsOwnWording -> "Your saved wording · ${viewModel.underText.length} characters"
+                        viewModel.underText.isBlank() -> "Her files have no such text in this build, and you have saved none"
+                        else -> "The text from her files · ${viewModel.underText.length} characters · press Edit to start from it"
+                    },
+                    fontSize = 11.sp,
+                    fontFamily = FontFamily.Monospace,
+                    color = if (viewModel.underHasUnsavedChanges) AccentCyan else TextSecondary
+                )
+                OutlinedTextField(
