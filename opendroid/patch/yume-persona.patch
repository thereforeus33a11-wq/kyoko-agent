+        )
+        assertEquals(PersonaPrompts.HANDLED_COMMAND_LABEL + "call mom", command.dialogue.single().text)
+        assertEquals(
+            listOf(withdrawn.text, PersonaPrompts.STARTED_LABEL + "calling. ok", "Calling Mom."),
+            command.deviceActivity
+        )
+
+        // He just talked to her. The row does not turn his talk into a command.
+        val talk = PersonaPrompts.shapeHistory(listOf(owner("what are you up to"), withdrawn, yume("nothing. you")))
+        assertEquals(listOf("what are you up to", "nothing. you"), talk.dialogue.map { it.text })
+        // Nor while her reply to it is still to be written.
+        val pending = PersonaPrompts.shapeHistory(listOf(owner("what are you up to"), withdrawn))
+        assertEquals("what are you up to", pending.dialogue.single().text)
+        assertEquals(listOf(withdrawn.text), pending.deviceActivity)
+
+        // She answered with nothing but a command, after the row: still said to her.
+        val ownCommand = PersonaPrompts.shapeHistory(
+            listOf(
+                owner("its so dark in here"),
+                withdrawn,
+                app("Yume's own command: \"flashlight on\"", badge = PersonaActions.COMMAND_BADGE)
+            )
+        )
+        assertEquals("its so dark in here", ownCommand.dialogue.single().text)
+
+        // The same holds for a row that is marked as one only a private route may be given.
+        val marked = withdrawn.copy(modelBadge = PersonaPrompts.appRowBadge(true, base = PersonaActionRows.PLAN_BADGE))
+        for (holdBack in listOf(false, true)) {
+            val shaped = PersonaPrompts.shapeHistory(listOf(owner("call mom"), marked, app("Calling Mom.")), holdBack)
+            assertEquals(PersonaPrompts.HANDLED_COMMAND_LABEL + "call mom", shaped.dialogue.single().text)
+            assertEquals(
+                if (holdBack) PersonaPrompts.PRIVATE_RESULT_PLACEHOLDER else withdrawn.text,
+                shaped.deviceActivity.first()
+            )
+        }
+    }
