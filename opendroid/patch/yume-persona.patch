+        )
+    }
+
+    @Test
+    fun `a plan of hers that he turns down leaves a row saying so`() {
+        val reject = rejectProposedPlan
+        // The plan is read with its steps: one that is shown a second time has steps behind it.
+        assertTrue(reject.contains("val shown = (_agentState.value as? AgentState.PlanProposed)?.plan ?: return"))
+        assertTrue(reject.contains("val rejected = livePlan(shown)"))
+        // Read before the gate is cleared, written in the chat the plan was shown in.
+        assertTrue(reject.indexOf("val sessionId = _proposedPlanSessionId.value") < reject.indexOf("_proposedPlanSessionId.value = null"))
+        assertTrue(reject.indexOf("as? AgentState.PlanProposed") < reject.indexOf("_agentState.value = AgentState.Idle"))
+        // Her plan gets the row under her plan's badge; a plan of his the record built from its steps. Never both.
+        val hers = reject.substringAfter("if (isPersonaPlan(rejected.planId)) {").substringBefore("} else {")
+        assertTrue(hers.contains("savePersonaPlanLeftGateRow("))
+        assertTrue(hers.contains("PersonaActionRows.LeftGate.TURNED_DOWN"))
+        assertFalse(hers.contains("savePlanRow("))
+        val his = reject.substringAfter("} else {")
+        assertTrue(his.contains("savePlanRow(PlanRecord.rejected(rejected, ::canonicalNameOf), rejected, rowSession)"))
+        assertFalse(his.contains("savePersonaPlanLeftGateRow("))
+    }
+
+    @Test
+    fun `a plan of hers that was stopped at the gate leaves its row at once, unless the chat is being emptied`() {
+        val stop = cancelCurrentTask
+        // Read before the gate is cleared.
+        assertTrue(stop.indexOf("val proposed = (_agentState.value as? AgentState.PlanProposed)?.plan") < stop.indexOf("_proposedPlanSessionId.value = null"))
+        assertTrue(stop.indexOf("val proposedSessionId = _proposedPlanSessionId.value") < stop.indexOf("_proposedPlanSessionId.value = null"))
+        // The stop is also how a chat is cleared, deleted or rewound: then nothing is written.
+        val atGate = stop.substringAfter("if (proposed != null) {").substringBefore("jobToCancel?.cancel() ?: return")
+        val recorded = atGate.substringAfter("if (record) {")
+        assertTrue(recorded.isNotEmpty())
+        assertFalse(atGate.substringBefore("if (record) {").contains("savePersonaPlanLeftGateRow("))
+        assertFalse(atGate.substringBefore("if (record) {").contains("savePlanRow("))
+        // Her plan gets the row under her plan's badge; a plan of his the record built from its steps.
+        val hers = recorded.substringAfter("if (isPersonaPlan(dropped.planId)) {").substringBefore("} else {")
+        assertTrue(hers.contains("savePersonaPlanLeftGateRow("))
+        assertTrue(hers.contains("PersonaActionRows.LeftGate.STOPPED"))
+        assertFalse(hers.contains("savePlanRow("))
+        assertTrue(recorded.substringAfter("} else {").contains("PlanRecord.dropped(dropped, \"stopped before it was approved\", ::canonicalNameOf)"))
+        // Nothing is kept in memory for a later message to write: a row that waits there
+        // is lost with the process.
+        assertFalse(loop.contains("personaPlanStoppedAtGate"))
+
+        // A message that takes the place of her waiting plan writes her plan's row as well.
+        val replaced = function("private suspend fun resolveStaleProposedPlan(", "private fun abandonWaitingTask(")
+        assertEquals(2, Regex("""PersonaActionRows\.LeftGate\.LEFT_WAITING""").findAll(replaced).count())
+        // With her on the app does not say "I" about a plan dropped from another chat.
+        assertTrue(replaced.indexOf("if (persona.isActive()) {") < replaced.indexOf("I cancelled the plan I proposed here"))
+    }
+
+    @Test
+    fun `a command line that is taken out of her reply without running leaves its rows`() {
+        val chat = executeSimpleQuery
+        // Read from the reply with any reasoning taken off, like everything else at its end.
+        assertTrue(chat.contains("PersonaActionRows.unrunCommands(replyText)"))
+        val rows = chat.substringAfter("unrun.forEach { line ->").substringBefore("val command = ownAction?.command")
+        assertTrue(rows.contains("savePersonaCommandNotRun(line.command, reason, sessionId)"))
+        // With her own actions switched off, that is the reason given.
+        assertTrue(rows.contains("if (chatConfig.personaActionsEnabled) {"))
+        assertTrue(rows.contains("PersonaActionRows.NotRun.ACTIONS_OFF"))
+        // After her reply is stored, and never in a reply that was stopped or failed.
+        assertTrue(chat.indexOf("unrun.forEach { line ->") > chat.indexOf("memoryManager.storeMessage(finalReplyMsg, sessionId)"))
+        assertTrue(chat.indexOf("unrun.forEach { line ->") > chat.indexOf("throw streamError"))
+        // A reply that held only such lines says nothing and plans nothing: the state is given back.
+        val only = chat.substringAfter("} else if (onlyCommand && command == null) {").substringBefore("} catch (e: CancellationException)")
+        assertTrue(only.contains("_agentState.value = AgentState.Idle"))
+    }
+
+    @Test
+    fun `a plan of his that broke off after it started is not reported to her as nothing done`() {
+        val plan = generatePlan
+        assertTrue(plan.contains("var planStarted = false"))
+        // Set only once the plan is on its way to run: after the trace, before the first step.
+        val started = plan.indexOf("planStarted = true")
+        assertTrue(started > plan.indexOf("recordAutoApprovedTrace(validated, approval.mode, sessionId)"))
+        assertTrue(started < plan.indexOf("executePlanLoop(validated, context, sessionId, autoApproved = true)"))
+        assertEquals(1, Regex("""planStarted = true""").findAll(plan).count())
+        val failed = plan.substringAfterLast("} catch (e: Exception) {")
+        assertTrue(failed.contains("plannerNote = if (planStarted) null else plannerNoteFor(e),"))
+        assertTrue(failed.contains("planBrokeOff = planStarted"))
+        assertTrue(fallbackOrError.contains("planBrokeOff: Boolean = false"))
+        // Her prompt then gets the line that says so, in place of the planner's note.
+        val line = executeSimpleQuery.substringAfter("deviceActivity = shaped.deviceActivity +").substringBefore("screenshotAttached = ")
+        assertTrue(line.contains("if (planBrokeOff) {"))
+        assertTrue(line.indexOf("PersonaPrompts.PLAN_BROKE_OFF_LINE") < line.indexOf("PersonaPrompts.plannerLine("))
+    }
+
+    @Test
+    fun `rows about what became of her plan are not replayed to the stock assistant`() {
+        val stock = executeSimpleQuery.substringAfter("// Off is stock:").substringBefore("systemPrompt = ")
+        assertTrue(stock.contains("PersonaActions.isCommandRow(it.modelBadge)"))
+        assertTrue(stock.contains("PersonaActionRows.isPlanRow(it.modelBadge)"))
+    }
