+package com.opendroid.ai.core.persona
+
+import android.content.Context
+import android.util.Log
+import com.opendroid.ai.core.security.AndroidKeyStoreAeadCipher
+import com.opendroid.ai.core.security.SecretAeadCipher
+import com.opendroid.ai.core.security.SecretEnvelope
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her own thoughts: what she writes in a moment of her own without marking it for
+ * anyone, and the lines of a reply she marks as kept to herself
+ * ([PersonaThoughtLines.MARKER]).
+ *
+ * They are hers alone. This store is the only place they are kept, and it has one
+ * reader: her own prompt, for a reply of hers and for a moment of her own, and the page
+ * of her sleep, where she goes over what she thought since she last woke. All three
+ * follow the same rule: on a route that holds his details back none of them is sent,
+ * because a thought can be about him. No screen
+ * lists them, no chat row holds them, no notification and no log line carries them,
+ * and they are not part of her notebook, so copying the notebook out does not take
+ * them along. The owner can delete them ([wipe]) and can be told how many there are
+ * and since when ([summary]); nothing in the app shows him what they say.
+ *
+ * They are kept in one file in the app's own storage, encrypted with a key that stays
+ * in the phone's Keystore, so the file by itself says nothing. What that does not
+ * promise: someone who can run code as this app on an unlocked phone can ask the
+ * Keystore to open it, like any other file the app encrypts.
+ *
+ * The store is bounded: it keeps her latest thoughts up to [MAX_CHARS] characters and
+ * the oldest fall away. Her prompt tells her so, so nothing disappears behind her back.
+ *
+ * All file work happens off the main thread and under one lock. A file that cannot be
+ * read right now (the Keystore did not answer, the file is damaged, the key is gone)
+ * reads as empty for the time being and is never written over. The next thought she
+ * keeps moves it aside under a name of its own and starts a new file, and what was
+ * moved aside is hers again as soon as it can be read. Only a file that can never be
+ * opened again costs her the thoughts in it, and nothing else.
+ */
+@Singleton
+class PersonaThoughts internal constructor(
+    private val directory: () -> File,
+    private val cipher: SecretAeadCipher
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(
+        { File(context.filesDir, DIRECTORY) },
+        AndroidKeyStoreAeadCipher(KEY_ALIAS)
+    )
+
+    /** One thing she thought, and when. */
+    data class Thought(val atMillis: Long, val text: String)
+
+    /** All the owner is ever told about them: how many there are and when the oldest was kept. */
+    data class Summary(val count: Int, val oldestAtMillis: Long?)
+
+    private val lock = Mutex()
+
+    // What the file holds, once it has been read. Kept so that a prompt does not open
+    // the file with the Keystore every time; it is the same text her prompt is built
+    // from. Null until then, and null again after a read that failed: an answer of
+    // "nothing" is only kept when the file really holds nothing.
+    private var held: List<Thought>? = null
+
+    // Thoughts she kept that are not in the file yet, because it could not be written
+    // when she kept them. They are hers until the app is closed and go into the file
+    // with the next thought that can be written.
+    private var unwritten: List<Thought> = emptyList()
+
+    private val file: File get() = File(directory(), FILE)
+
+    /**
+     * Keeps [text] as one thought of hers, written at [atMillis]. Text without a letter
+     * or a digit in it is no thought and is not kept. A thought that cannot be written
+     * to the file is still hers until the app is closed.
+     */
+    suspend fun keep(text: String, atMillis: Long = System.currentTimeMillis()) {
+        val thought = text.trim()
+        if (thought.none { it.isLetterOrDigit() }) return
+        work {
+            unwritten = unwritten + Thought(atMillis, thought)
+            store(openedAside())
+        }
+    }
+
+    /**
+     * Her latest thoughts for her own prompt, oldest first, as many whole ones as fit
+     * into [maxChars] counted from the newest back. The newest is always among them: one
+     * that is longer than the room by itself is shortened and marked as shortened.
+     */
+    suspend fun latest(maxChars: Int = PROMPT_BUDGET_CHARS): List<Thought> = work {
+        val all = read()
+        val kept = ArrayList<Thought>()
+        var used = 0
+        for (thought in all.asReversed()) {
+            if (kept.isEmpty() && thought.text.length > maxChars) {
+                kept += thought.copy(text = thought.text.take(maxChars).trimEnd() + PersonaPrompts.CUT_MARK)
+                break
+            }
+            if (used + thought.text.length > maxChars) break
+            kept += thought
+            used += thought.text.length
+        }
+        kept.asReversed().toList()
+    }
+
+    /** How many thoughts are kept and since when. Nothing of what they say. */
+    suspend fun summary(): Summary = work {
+        val all = read()
+        Summary(all.size, all.minOfOrNull { it.atMillis })
+    }
+
+    /**
+     * Deletes every thought of hers and returns how many could be counted. A file that
+     * could not be read is deleted too, and so is every file that was moved aside
+     * unread. Only the owner's own action on the card screen calls this.
+     */
+    suspend fun wipe(): Int = work {
+        val count = read().size
+        held = emptyList()
+        unwritten = emptyList()
+        val left = (setAside() + file).filter { it.exists() && !it.delete() }
+        if (left.isNotEmpty()) throw IOException("The thoughts could not be removed")
+        count
+    }
+
+    private suspend fun <T> work(block: () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }
+
+    /** Keeps the newest thoughts whose text fits into [MAX_CHARS]. The newest one always stays. */
+    private fun bounded(all: List<Thought>): List<Thought> {
+        var total = all.sumOf { it.text.length }
+        var first = 0
+        while (total > MAX_CHARS && first < all.lastIndex) {
+            total -= all[first].text.length
+            first++
+        }
+        return if (first == 0) all else all.subList(first, all.size).toList()
+    }
+
+    /**
+     * Everything of hers that can be read now, oldest first: what the file holds and
+     * what is not written yet. A file that cannot be opened adds nothing this time and
+     * is tried again with the next call.
+     */
+    private fun read(): List<Thought> {
+        if (held == null) {
+            val fromFile = open(file)
+            if (fromFile != null) {
+                held = fromFile
