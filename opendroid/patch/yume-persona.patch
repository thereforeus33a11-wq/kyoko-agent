+    @Test
+    fun `on the encrypted route a thought that begins like a line of his costs her nothing she wrote after it`() {
+        // The request says what it is. Its one turn is the app's and no talk is folded in
+        // front of it, so it carries none of the transcript's marks.
+        val request = PersonaEngine.requestOfHers(PersonaEngine.ownTimeRequest("system text"), LLMConfig())
+        assertTrue(request.persona)
+        assertTrue(request.ownMoment)
+        val folded = VeniceE2eeMessages.fold(request.systemPrompt, request.messages, persona = request.persona)
+        assertFalse(folded.marked)
+
+        val written = "he: asleep, probably.\nme: bored.\nsay: you up?\n>> flashlight on\nnext: 2h"
+        val unfolded = VeniceE2eeMessages.unfold(written, folded.marked)
+        // Nothing is taken off and nothing is cut.
+        assertEquals(written, unfolded.text)
+        assertFalse(unfolded.endedAtHisMark)
+        val moment = PersonaOwnTime.parse(unfolded.text)
+        assertEquals("he: asleep, probably.\nme: bored.", moment.thoughts)
+        assertEquals("you up?", moment.said)
+        assertEquals("flashlight on", moment.command)
+        assertEquals(Wish.After(2 * hour), moment.wish)
