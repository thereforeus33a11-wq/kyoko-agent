+        mind = EngineMind(engine, settings),
+        sources = object : ReadingSpace.Sources {
+            override suspend fun search(words: String) = wikipedia.search(words)
+            override suspend fun article(title: String, lang: String) = wikipedia.article(title, lang)
+            override suspend fun fetch(url: String) = fetcher.fetch(url)
+            override suspend fun feed(feed: Feeds.Feed) = feeds.read(feed)
