+        assertTrue(PersonaPrompts.MADE_PICTURE_LINE.contains("half right is wrong"))
+        assertEquals(picture, requests.single().messages.single().imageBase64)
+        // The action asks for it only where her brain sees the picture on its route, and keeps what she says as its caption.
+        val actions = java.io.File("src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt").readText()
+        assertTrue(actions.contains("if (!her.chatSeesImages(config) || her.pictureRefused(config)) return null"))
+        assertTrue(actions.contains("her.readMadePicture(it)"))
