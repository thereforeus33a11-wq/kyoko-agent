+    @Test
+    fun `his usual starts as the mean of his takes and then moves only a little, never for a shout`() {
+        val u = SoundUsual()
+        assertFalse(u.ready)
+        for ((level, hz) in listOf(-30f to 120.0, -28f to 125.0, -26f to 130.0)) {
+            u.learn(at(level, hz), 12, "en", null)
+        }
+        assertTrue(u.ready)
