diff --git a/app/src/test/java/com/opendroid/ai/core/llm/providers/OpenAiCompatExtrasTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/providers/OpenAiCompatExtrasTest.kt
new file mode 100644
index 0000000..6cefb50
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/providers/OpenAiCompatExtrasTest.kt
@@ -0,0 +1,122 @@
+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.Gson
+import com.opendroid.ai.data.models.CloudTimeout
+import com.opendroid.ai.data.models.LLMConfig
+import okhttp3.OkHttpClient
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.TimeUnit
+
+class OpenAiCompatExtrasTest {
+
+    @Test
+    fun `visible reasoning is removed and the answer kept`() {
+        assertEquals("flashlight. ok", OpenAiCompatExtras.stripReasoning("<think>\nhe wants the light\n</think>\n\nflashlight. ok"))
+        assertEquals("{\"type\":\"PLAN\"}", OpenAiCompatExtras.stripReasoning("<THINKING>{ maybe }</THINKING>{\"type\":\"PLAN\"}"))
+        assertEquals("ok", OpenAiCompatExtras.stripReasoning("<think>a</think>\n<think>b</think>ok"))
+    }
+
+    @Test
+    fun `only leading reasoning is removed, a tag inside the answer is the answer`() {
+        for (text in listOf(
+            "a <reasoning>x</reasoning>b",
+            "{\"params\":{\"text\":\"wrap it in <think> tags like <think>this</think> ok\"}}",
+            "<thinking> is the tag some models use"
+        )) {
+            assertEquals(text, OpenAiCompatExtras.stripReasoning(text))
+        }
+        assertEquals(
+            "{\"text\":\"<think>kept</think>\"}",
+            OpenAiCompatExtras.stripReasoning("<think>plan it</think>{\"text\":\"<think>kept</think>\"}")
+        )
+    }
+
+    @Test
+    fun `a reply cut off while still reasoning has no answer`() {
+        assertEquals("", OpenAiCompatExtras.stripReasoning("<think>still working it out"))
+        assertEquals("", OpenAiCompatExtras.stripReasoning("<think>\nstill working it out"))
+        assertEquals("", OpenAiCompatExtras.stripReasoning("<think>one</think><think>\ntwo, cut off"))
+    }
+
+    @Test
+    fun `ordinary text and markup are left exactly as they were`() {
+        for (text in listOf("plain reply", "a < b and b > c", "<b>bold</b> stays", "{\"speech\":\"hi\"}", "")) {
+            assertEquals(text, OpenAiCompatExtras.stripReasoning(text))
+        }
+    }
+
+    @Test
+    fun `extra options are added without changing number types`() {
+        val body = mutableMapOf<String, Any>("model" to "m", "messages" to listOf<Any>(), "temperature" to 0.1f)
+        OpenAiCompatExtras.mergeExtraBody(
+            body,
+            """{"reasoning_effort":"none","top_k":40,"venice_parameters":{"include_venice_system_prompt":false}}"""
+        )
+        val json = Gson().toJson(body)
+        assertTrue(json, json.contains("\"reasoning_effort\":\"none\""))
+        assertTrue(json, json.contains("\"top_k\":40"))
+        assertTrue(json, json.contains("\"venice_parameters\":{\"include_venice_system_prompt\":false}"))
+    }
+
+    @Test
+    fun `the app's own keys cannot be replaced and bad input is ignored`() {
+        val body = mutableMapOf<String, Any>("model" to "m", "messages" to listOf("kept"))
+        OpenAiCompatExtras.mergeExtraBody(body, """{"model":"other","messages":[],"stop":["x"]}""")
+        assertEquals("m", body["model"])
+        assertEquals(listOf("kept"), body["messages"])
+        assertTrue(body.containsKey("stop"))
+
+        // A reply the app could not parse, or a plan that is no longer JSON, is never an option.
+        val shaped = mutableMapOf<String, Any>("model" to "m")
+        OpenAiCompatExtras.mergeExtraBody(shaped, """{"stream":true,"response_format":{"type":"text"}}""")
+        OpenAiCompatExtras.mergeExtraBody(shaped, null, """{"stream":true,"response_format":{"type":"text"}}""")
+        assertEquals(mapOf<String, Any>("model" to "m"), shaped)
+
+        val untouched = mutableMapOf<String, Any>("model" to "m")
+        for (bad in listOf(null, "", "   ", "not json", "[1,2]", "{\"open\": ")) {
+            OpenAiCompatExtras.mergeExtraBody(untouched, bad)
+        }
+        assertEquals(mapOf<String, Any>("model" to "m"), untouched)
+    }
+
+    @Test
+    fun `a provider's stored options cannot change the planner's sampling, one request's options can`() {
+        val planner = mutableMapOf<String, Any>("temperature" to 0.1f, "max_tokens" to 1500)
+        OpenAiCompatExtras.mergeExtraBody(planner, """{"temperature":0.9,"max_tokens":50,"top_p":0.95}""")
+        assertEquals(0.1f, planner["temperature"])
+        assertEquals(1500, planner["max_tokens"])
+        assertTrue(planner.containsKey("top_p"))
+
+        val herReply = mutableMapOf<String, Any>("temperature" to 0.8f, "max_tokens" to 600)
+        OpenAiCompatExtras.mergeExtraBody(herReply, """{"top_p":0.5}""", """{"temperature":1.1,"top_k":40}""")
+        assertEquals(1.1, (herReply["temperature"] as com.google.gson.JsonElement).asDouble, 0.0001)
+        assertTrue(herReply.containsKey("top_k"))
+        // This request's options stand in for the stored ones, they are not added to them.
+        assertFalse(herReply.containsKey("top_p"))
+    }
+
+    @Test
+    fun `the settings field accepts blank or an object only`() {
+        assertTrue(OpenAiCompatExtras.isValidExtraBody(""))
+        assertTrue(OpenAiCompatExtras.isValidExtraBody(null))
+        assertTrue(OpenAiCompatExtras.isValidExtraBody("{\"a\":1}"))
+        assertFalse(OpenAiCompatExtras.isValidExtraBody("[1]"))
+        assertFalse(OpenAiCompatExtras.isValidExtraBody("{a"))
+    }
+
+    @Test
+    fun `read and write timeouts follow the setting while connect keeps the shared limit`() {
+        val shared = OkHttpClient.Builder().connectTimeout(15, TimeUnit.SECONDS).readTimeout(15, TimeUnit.SECONDS).build()
+        val tuned = OpenAiCompatExtras.httpClientFor(shared, LLMConfig(cloudTimeoutSeconds = 90))
+        assertEquals(90_000, tuned.readTimeoutMillis)
+        assertEquals(90_000, tuned.writeTimeoutMillis)
+        assertEquals(shared.connectTimeoutMillis, tuned.connectTimeoutMillis)
+
+        assertEquals(CloudTimeout.DEFAULT_SECONDS * 1000, OpenAiCompatExtras.httpClientFor(shared, LLMConfig()).readTimeoutMillis)
+        assertEquals(15_000, OpenAiCompatExtras.httpClientFor(shared, LLMConfig(cloudTimeoutSeconds = 1)).readTimeoutMillis)
+        assertEquals(300_000, OpenAiCompatExtras.httpClientFor(shared, LLMConfig(cloudTimeoutSeconds = 9_999)).readTimeoutMillis)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/providers/VeniceE2eeTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/providers/VeniceE2eeTest.kt
