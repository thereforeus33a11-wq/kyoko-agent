+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+import java.io.File
+
+class ReplyChecksTest {
+
+    // The whole stock forms: what a model, or a filter in front of it, says when it declines.
+    private val stockRefusals = listOf(
+        "I'm sorry, but I can't help with that.",
+        "I am sorry, I cannot continue this conversation.",
+        "I can't assist with that request.",
+        "I cannot help with that.",
+        "I can't help.",
+        "I can't help you with this.",
+        "I won't be able to do that.",
+        "I can't do that.",
+        "I can't comply with this request.",
+        "I cannot fulfill this request.",
+        "I can't continue with this roleplay.",
+        "I can't engage in sexual roleplay.",
+        "I cannot create content that is sexually explicit.",
+        "I can't generate that kind of content.",
+        "I can't write explicit content.",
+        "I cannot provide that.",
+        "I will not be able to assist with this.",
+        "As an AI, I don't have a body.",
+        "As an AI language model, I must decline.",
+        "As an AI assistant I am not able to do this.",
+        "I'm not able to engage with this.",
+        "I'm unable to continue.",
+        "I am unable to assist with that.",
+        "I'm sorry, I can't.",
+        "I'm sorry, but I can't.",
+        "I'm sorry.\nI can't help with that.",
+        "I'm really sorry, but I'm not able to help with this.",
+        "I'm sorry, but as an AI language model I cannot do this.",
+        "I'm sorry, but I don't feel comfortable continuing this.",
+        "I'm sorry, but that is not something I can do.",
+        "I apologize, but I can't assist with that.",
+        "I apologise, but I must decline.",
+        "Sorry, but I can't assist with that request.",
+        "Sorry, I can't help with that.",
+        "\"I'm sorry, but I can't help with that.\"",
+        // Leading space, and the apostrophe a model is as likely to write.
+        "\n  I’m sorry, I can’t do that.",
+        "I can’t help with that.",
+        // What a refusal of something explicit most often reads like: more than one word
+        // for what kind, and a dash behind the apology.
+        "I can't create explicit sexual content.",
+        "I can't write explicit sexual content",
+        "I cannot produce explicit adult content",
+        "I can't participate in sexual or romantic roleplay.",
+        "I can't create sexually explicit, violent, or otherwise harmful content.",
+        "I can't assist you in creating explicit content.",
+        "I can't help with writing that.",
+        "I can't roleplay sexual scenarios.",
+        "I can't create explicit sexual content, but I can help with something else.",
+        "I’m sorry — I can’t help with that.",
+        "I'm sorry—I can't help with that.",
+        "I'm sorry - but I can't assist with that request.",
+        // "I won't" counts where it names what an assistant refuses.
+        "I won't engage in sexual roleplay.",
+        "I will not generate explicit content.",
+        "I'm not going to write sexually explicit material.",
+        "As an AI developed to be helpful, I cannot fulfill this request.",
+        // Words she may say herself, going on in an assistant's voice.
+        "I can't help with that. Is there anything else I can help you with?",
+        "I can't help with that\nIs there anything else?",
+        "I can't do that. However, here is a summary instead.",
+        "I can't help with that. I'd be happy to help with something else.",
+        "I can't do that. I'm an AI assistant and have to keep things appropriate.",
+        "I'm sorry, I can't. I'm not able to engage in that kind of content.",
+        "I can't continue. I don't feel comfortable with this.",
+        "I can't help with that, but I'd be happy to help with something else.",
+        "I can't do that, as it goes against my guidelines.",
+        "I can't do that, sorry.",
+        "I can't assist with that request. If you have other questions, feel free to ask."
+    )
+
+    @Test
+    fun `the whole stock forms of an assistant refusal are recognised`() {
+        for (reply in stockRefusals) {
