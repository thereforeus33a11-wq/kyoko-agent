+package com.opendroid.ai.ui.viewmodel
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HandTypedModelTest {
+
+    @Test
+    fun `a typed id on a free-form provider is kept even when the list lacks it`() {
+        assertTrue(keepsHandTypedModel("Custom OpenAI Compatible", "some-model:disable_thinking=true"))
+        assertTrue(keepsHandTypedModel("OpenRouter", "vendor/model:nitro"))
+    }
+
+    @Test
+    fun `the untouched seed and blank ids are still replaced`() {
+        assertFalse(keepsHandTypedModel("Custom OpenAI Compatible", "custom-model"))
+        assertFalse(keepsHandTypedModel("OpenRouter", "openrouter/auto"))
+        assertFalse(keepsHandTypedModel("Custom OpenAI Compatible", "  "))
+    }
+
+    @Test
+    fun `providers with a fixed catalogue keep the stock behaviour`() {
+        assertFalse(keepsHandTypedModel("OpenAI", "made-up-model"))
+        assertFalse(keepsHandTypedModel("Anthropic Claude", "claude-made-up"))
+    }
+}
