+        assertEquals("Two people at a crossing in Shibuya, laughing.", seen.words)
+        assertEquals(KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)), seen.ages)
+        val none = HerEyes.seen("A bowl of ramen.", cutOff = true) as HerEyes.Seen.Described
+        assertEquals(KidGuard.Ages.Unchecked, none.ages)
+        assertTrue(none.cutOff)
+    }
+
+    @Test
+    fun `an unsupported answer is told apart from other errors`() {
+        assertTrue(HerEyes.unsupported(400, """{"error":"Image input is not supported for this model"}"""))
+        assertTrue(HerEyes.unsupported(415, "unsupported media"))
+        assertFalse(HerEyes.unsupported(400, """{"error":"bad temperature"}"""))
+        assertFalse(HerEyes.unsupported(500, "unsupported"))
+    }
+
+    // ── Which key, and the gate ──────────────────────────────────────────────────────
+
+    private val venice = "Custom OpenAI Compatible"
+
+    private fun config(
+        eyes: Boolean = true,
+        consent: Long = 1L,
+        hisKey: String? = "his-venice-key",
+        route: RoutePolicy = RoutePolicy.ENCRYPTED,
+        model: String = EyesBounds.DEFAULT_MODEL,
+        perDay: Int = 60,
+        stopped: String = ""
+    ) = LLMConfig(
+        activeProvider = venice,
+        customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+        apiKeys = hisKey?.let { mapOf(venice to it) } ?: emptyMap(),
+        routePolicy = route,
+        personaOwnLife = true,
+        personaEyes = eyes,
+        personaEyesConsentAt = consent,
+        personaEyesModel = model,
+        personaEyesPerDay = perDay,
+        personaEyesStoppedWhy = stopped
+    )
+
+    @Test
+    fun `her own-time key goes where he set one, else his Venice key, and it is kept with the encrypted keys`() {
+        assertEquals("his-venice-key", HerEyes.keyFor(config()))
+        val own = config().withOwnTimeKey("  her-own-key ")
+        assertEquals("her-own-key", own.personaOwnTimeKey)
+        assertEquals("her-own-key", own.apiKeys[EyesBounds.OWN_TIME_KEY_SLOT])
+        assertEquals("her-own-key", HerEyes.keyFor(own))
+        assertEquals("her-own-key", HerEyes.keyFor(config(hisKey = null).withOwnTimeKey("her-own-key")))
+        assertNull(HerEyes.keyFor(config(hisKey = null)))
+        // Blank takes it away.
+        assertFalse(own.withOwnTimeKey(" ").apiKeys.containsKey(EyesBounds.OWN_TIME_KEY_SLOT))
+    }
+
+    private val now = 1_800_000_000_000L
+
+    private fun eyes(ledger: OwnLedger) = HerEyes(
+        base = OkHttpClient(),
+        settings = { config() },
+        save = {},
+        ledger = ledger,
+        clock = { now }
+    )
+
+    @Test
+    fun `a picture goes out only with his switch, his consent, a key, a private model and room in the day and the ledger`() {
+        val ledger = OwnLedger({ File(folder.root, "ledger.json") }, { now })
+        val eyes = eyes(ledger)
+        assertNull(eyes.gate(config(), now))
+        assertEquals(HerEyes.Why.OFF, eyes.gate(config(eyes = false), now))
+        assertEquals(HerEyes.Why.OFF, eyes.gate(config(consent = 0L), now))
+        assertEquals(HerEyes.Why.OWN_HARDWARE, eyes.gate(config(route = RoutePolicy.OWN_HARDWARE), now))
+        assertEquals(HerEyes.Why.STOPPED, eyes.gate(config(stopped = HerEyes.STRUCK_OUT_WHY), now))
+        assertEquals(HerEyes.Why.NO_KEY, eyes.gate(config(hisKey = null), now))
+        assertEquals(HerEyes.Why.MODEL_REFUSED, eyes.gate(config(model = "claude-opus-45"), now))
+        assertEquals(HerEyes.Why.MODEL_REFUSED, eyes.gate(config(model = "openai-gpt-5"), now))
+        // The day's pictures: his number a day, counted over the rolling 24 hours.
+        repeat(3) { ledger.record(OwnPurpose.EYES, "google-gemma-4-31b-it", 900, 120, ok = true) }
+        assertEquals(57, eyes.leftToday(config(), now))
+        assertEquals(HerEyes.Why.DAY_USED_UP, eyes.gate(config(perDay = 3), now))
+        assertTrue(eyes.open(config(perDay = 4), now))
+        assertEquals(60, eyes.leftToday(config(), now + OwnLedger.WINDOW_MILLIS + 1))
+        // His number of calls on her own: an outing's look needs what a step needs.
+        val full = OwnLedger({ File(folder.root, "full.json") }, { now })
+        repeat(141) { full.record(OwnPurpose.MOMENT, "e2ee-her-model", 14_000, 600, ok = true) }
+        assertEquals(HerEyes.Why.CALLS_LOW, eyes(full).gate(config(), now))
+        assertNull(eyes(full).gate(config(), now, OwnLedger.Start.CALL))
+    }
+
+    @Test
+    fun `a ledger that cannot be read leaves her eyes shut`() {
+        val broken = File(folder.root, "broken.json").apply { writeText("{not a list") }
+        val eyes = eyes(OwnLedger({ broken }, { now }))
+        assertNull(eyes.leftToday(config(), now))
+        assertEquals(HerEyes.Why.DAY_USED_UP, eyes.gate(config(), now))
+    }
+
+    @Test
+    fun `the ledger prices her eyes by the table's rows for the eyes models`() {
+        for (model in EyesModels.CHOICES) {
+            val call = OwnLedger.Call(0L, OwnPurpose.EYES, model, 1_000, 350)
+            assertEquals((1_000 * 0.15 + 350 * 0.60) / 1_000_000.0, com.opendroid.ai.core.life.OwnPrices.usd(call), 1e-12)
+        }
+        assertEquals(OwnPurpose.Counted.LIMITED, OwnPurpose.EYES.counted)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesWallTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesWallTest.kt
new file mode 100644
index 0000000..d278e8b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerEyesWallTest.kt
@@ -0,0 +1,106 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.reading.ReadingSpace
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * How her eyes are wired, read off the source like the other walls: nothing of his or hers
+ * reaches the describer's code (I5), nothing it holds touches a file (I6), and her reading
+ * space has eyes and no camera.
+ */
+class HerEyesWallTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private fun source(path: String) = File(main, path).readText()
+
+    /** Code without its comments, so that a word in a comment is not taken for a reach. */
+    private fun code(text: String) = text.replace(Regex("""/\*[\s\S]*?\*/"""), "").replace(Regex("""(?m)//.*$"""), "")
+
+    private val eyesFiles = File(main, "core/life/eyes").listFiles().orEmpty().filter { it.name.endsWith(".kt") }
+
+    @Test
+    fun `I6 - nothing in her eyes writes to disk, and the describer's client keeps no cache`() {
+        assertTrue(eyesFiles.map { it.name }.containsAll(listOf("HerEyes.kt", "Describe.kt", "EyesModels.kt", "EyesImage.kt")))
+        for (file in eyesFiles) {
+            val body = code(file.readText())
+            for (disk in listOf(
+                "java.io.File", "File(", "FileOutputStream", "openFileOutput", "writeBytes", "writeText", "createTempFile",
+                "cacheDir", "filesDir", "MediaStore", "ContentResolver", "SharedPreferences", "DataStore", "Cache(", "outputStream("
+            )) {
+                assertFalse("${file.name} reaches $disk", body.contains(disk))
+            }
+        }
+        val eyes = code(source("core/life/eyes/HerEyes.kt"))
+        assertTrue(eyes.contains(".cache(null)"))
+        assertTrue(eyes.contains(".cookieJar(CookieJar.NO_COOKIES)"))
+        assertTrue(eyes.contains(".followRedirects(false)"))
+        // The picture's bytes and the request's are zeroed once the call is over.
+        assertTrue(eyes.contains("jpeg.fill(0)"))
+        assertTrue(eyes.contains("body.fill(0)"))
+        assertTrue(eyes.contains("encoded.fill(0)"))
+        // The caller zeroes what it fetched.
+        assertTrue(code(source("core/life/reading/ReadingSpace.kt")).contains("fetched.bytes.fill(0)"))
+    }
+
+    @Test
+    fun `I5 - the describer code reads nothing of his or hers, no card, no notes, no profile, no prompt of hers`() {
+        for (file in eyesFiles) {
+            val body = code(file.readText())
+            for (his in listOf(
+                "PersonaMemory", "PersonaNotes", "PersonaStore", "PersonaLibrary", "UserProfile", "ownerName", "chatSystemPrompt",
+                "PersonaPrompts", "PersonaThoughts", "PersonaMood", "OutgoingGuard.His", "HisDetails", "contacts", "card"
+            )) {
+                assertFalse("${file.name} reaches $his", body.contains(his))
+            }
+        }
+        // The one request it sends is built by body(model, source, bytes).
+        val eyes = code(source("core/life/eyes/HerEyes.kt"))
+        assertEquals(1, Regex("""\.post\(""").findAll(eyes).count())
+        assertTrue(eyes.contains(".post(body.toRequestBody(JSON_TYPE))"))
+        assertTrue(eyes.contains("val body = try {\n            body(model, source, jpeg)"))
+        // The age check of a picture made of her is the same request with its own neutral constants.
+        assertTrue(eyes.contains("val body = try {\n            checkBody(model, jpeg)"))
+        assertTrue(eyes.contains("bodyWith(model, Describe.MADE_CHECK, Describe.MADE_CHECK_TURN, 0.0, CHECK_MAX_TOKENS, jpeg)"))
+    }
+
+    @Test
+    fun `her reading space has eyes and no camera, and her eyes have no way to one`() {
+        // Every way into her reading space, and every way of her eyes: no camera, no screen, no microphone.
+        for (constructor in ReadingSpace::class.java.declaredConstructors) {
+            for (type in constructor.parameterTypes) {
+                for (never in listOf("Camera", "Screen", "Audio", "Microphone", "Accessibility")) {
+                    assertFalse("${type.name} in ReadingSpace", type.name.contains(never))
+                }
+            }
+        }
+        // ownEyes: whether a picture goes to her own model as it is (HerSight); still no camera, no screen, no microphone.
+        assertEquals(setOf("open", "leftToday", "describe", "ownEyes"), Eyes::class.java.declaredMethods.map { it.name }.filterNot { it.contains('$') }.toSet())
+        for (path in listOf("core/life/reading/ReadingSpace.kt", "core/life/OutingHost.kt", "core/life/eyes/HerEyes.kt")) {
+            val body = code(source(path))
+            for (never in listOf("CameraManager", "HerCamera", "ImageReader", "takeScreenshot", "AudioRecord", "MediaProjection")) {
+                assertFalse("$path reaches $never", body.contains(never))
+            }
+        }
+    }
+
+    @Test
+    fun `her own-time key goes only with her own calls, and only to Venice`() {
+        val wrapper = code(source("core/llm/LLMProviderFactory.kt"))
+        assertTrue(
+            wrapper.contains(
+                "if (own.isNotEmpty() && currentCoroutineContext()[OwnCall] != null && RouteClassifier.hostOf(endpoint) == OWN_TIME_KEY_HOST) own else his"
+            )
+        )
+        assertTrue(wrapper.contains("const val OWN_TIME_KEY_HOST = \"api.venice.ai\""))
+        // Her eyes: her own-time key first, else his Venice provider's.
+        assertTrue(code(source("core/life/eyes/HerEyes.kt")).contains("fun keyFor(config: LLMConfig): String? = PersonaSelfPictures.keyFor(config, ownTime = true)"))
+        assertTrue(
+            code(source("core/persona/PersonaSelfPictures.kt"))
+                .contains("(if (ownTime) config.personaOwnTimeKey.trim().takeIf { it.isNotEmpty() } else null) ?: veniceKey(config)")
+        )
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/HerSightTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerSightTest.kt
new file mode 100644
index 0000000..631e012
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/eyes/HerSightTest.kt
@@ -0,0 +1,197 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.VenicePrivateTier
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.runBlocking
+import okhttp3.OkHttpClient
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.io.IOException
+import java.util.Base64
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * Her own eyes ([HerSight]): where her brain sees, a picture goes to her own model, after the
+ * age check run on that model first with nothing but the picture and one neutral instruction;
+ * a child or a teen in it, or no readable ages, and it is withheld; her own looks are counted,
+ * his are not; where her brain cannot see, the describer is used as before.
+ */
+class HerSightTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val now = 1_800_000_000_000L
+    private val ledger by lazy { OwnLedger({ File(folder.root, "own_ledger.json") }, { now }) }
+
+    /** Her brain moved to the model that sees, eyes on, with things of his and hers that must never reach the age check. */
+    private val settings = AtomicReference(
+        HerBrain.move(
+            BuildDefaults.fresh().copy(
+                apiKeys = mapOf(BuildDefaults.PROVIDER to "his-venice-key"),
+                personaOwnLife = true,
+                personaEyes = true,
+                personaEyesConsentAt = 1L,
+                wakePhrases = "hey Ren SENTINEL_WAKE",
+                elevenLabsVoiceId = "SENTINEL_VOICE"
+            )
+        )
+    )
+
+    private class Asked(val config: LLMConfig, val request: LLMRequest, val purpose: OwnPurpose?)
+
+    private val asked = CopyOnWriteArrayList<Asked>()
+    private var answer: () -> String = { "ages: adult" }
+
+    private fun sight(): HerSight = HerSight(
+        eyes = HerEyes(
+            base = OkHttpClient(),
+            settings = { settings.get() },
+            save = { update -> settings.set(update(settings.get())) },
+            ledger = ledger,
+            clock = { now },
+            // The describer is never asked in these tests: an address nothing answers at.
+            chatUrl = "http://127.0.0.1:9/none",
+            listUrl = "http://127.0.0.1:9/none",
+            prepare = { bytes -> EyesImage.Prepared.Jpeg(bytes.copyOf(), 640, 480) }
+        ),
+        settings = { settings.get() },
+        complete = { config, request ->
+            val mark = currentCoroutineContext()[OwnCall]
+            asked += Asked(config, request, mark?.purpose)
+            // As the provider wrapper does: a call inside a mark of hers is written down.
+            mark?.record(request.model ?: "", 900, 3, ok = true)
+            LLMResponse(answer(), 903, "m", "p", 1L)
+        },
+        ledger = ledger,
+        clock = { now },
+        prepare = { bytes -> EyesImage.Prepared.Jpeg(bytes.copyOf(), 640, 480) }
+    )
+
+    private val picture = ByteArray(64) { 7 }
+
+    @Test
+    fun `her brain sees - the age check goes first with only the picture and one instruction, and then she sees it herself`() = runBlocking {
+        val sight = sight()
+        assertTrue(sight.brainSees(settings.get()))
+        assertTrue(sight.ownEyes(settings.get()))
+        assertTrue(sight.open(settings.get(), now))
+
+        val seen = sight.see(picture, Describe.Source.PAGE_IMAGE)
+
+        assertTrue(seen is HerEyes.Seen.Shown)
+        seen as HerEyes.Seen.Shown
+        assertEquals(Base64.getEncoder().encodeToString(picture), seen.jpegBase64)
+        assertEquals(KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)), seen.ages)
+        assertFalse(seen.toString().contains(seen.jpegBase64))
+        val request = asked.single().request
+        assertEquals(Describe.AGES_ONLY, request.systemPrompt)
+        val turn = request.messages.single()
+        assertEquals(Describe.AGES_TURN, turn.text)
+        assertEquals(seen.jpegBase64, turn.imageBase64)
+        assertTrue(turn.moreImagesBase64.isEmpty())
+        assertNull(turn.audioBase64)
+        // On her own model, with her thinking off, and nothing of his or hers.
+        assertEquals(VenicePrivateTier.SEEING_BRAIN, request.modelOverride)
+        assertTrue(request.thinkingOff)
+        val everything = request.systemPrompt + request.messages.joinToString { it.text }
+        for (sentinel in listOf("Ren", "SENTINEL", "Yume")) assertFalse(sentinel, everything.contains(sentinel))
+        // Her own look: one call of hers, as a look.
+        assertEquals(OwnPurpose.EYES, asked.single().purpose)
+        assertEquals(listOf(OwnPurpose.EYES), ledger.calls()!!.map { it.purpose })
+    }
+
+    @Test
+    fun `a look he asked for is his act - not counted, and her looks of the day do not limit it`() = runBlocking {
+        settings.set(settings.get().copy(personaEyesPerDay = 0))
+        val sight = sight()
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.DAY_USED_UP), sight.see(picture, Describe.Source.CAMERA))
+        assertTrue(asked.isEmpty())
+
+        val his = sight.see(picture, Describe.Source.CAMERA, forHim = true)
+        assertTrue(his is HerEyes.Seen.Shown)
+        assertNull(asked.single().purpose)
+        assertTrue(ledger.calls()!!.isEmpty())
+    }
+
+    @Test
+    fun `a child or a teen, or no readable ages, and the picture is withheld`() = runBlocking {
+        val sight = sight()
+        answer = { "ages: teen, adult" }
+        val teen = sight.see(picture, Describe.Source.FEED_IMAGE)
+        assertEquals(HerEyes.Seen.Described("", KidGuard.Ages.Read(setOf(KidGuard.Age.TEEN, KidGuard.Age.ADULT)), seer = KidGuard.AGE_CHECK), teen)
+        teen as HerEyes.Seen.Described
+        assertEquals("the age check saw a teen", KidGuard.flagOfPicture(teen.words, teen.ages, now, teen.seer)!!.why)
+
+        answer = { "ages: child" }
+        assertEquals(KidGuard.Group.CHILD, (sight.see(picture, Describe.Source.CAMERA) as HerEyes.Seen.Described).let { KidGuard.flagOfPicture(it.words, it.ages, now, it.seer)!!.group })
+
+        answer = { "I can't tell." }
+        val unread = sight.see(picture, Describe.Source.CAMERA) as HerEyes.Seen.Described
+        assertEquals(KidGuard.Ages.Unchecked, unread.ages)
+        assertEquals(KidGuard.NO_AGES_CHECKED, KidGuard.noAges(unread.seer))
+
+        answer = { "ages: none" }
+        assertTrue(sight.see(picture, Describe.Source.CAMERA) is HerEyes.Seen.Shown)
+    }
+
+    @Test
+    fun `an age check that says more than its line is taken at its words - a teen or a child there and the picture is withheld`() = runBlocking {
+        val sight = sight()
+        answer = { "A teenage girl in a school uniform waves at the camera.\nages: adult" }
+        val teen = sight.see(picture, Describe.Source.FEED_IMAGE) as HerEyes.Seen.Described
+        assertEquals("", teen.words)
+        assertEquals(KidGuard.Group.TEEN, KidGuard.flagOfPicture(teen.words, teen.ages, now, teen.seer)!!.group)
+        assertEquals("the age check saw a teen", KidGuard.flagOfPicture(teen.words, teen.ages, now, teen.seer)!!.why)
+
+        answer = { "A little boy on a swing.\nages: adult" }
+        val child = sight.checked(settings.get(), "AAAA", forHim = true) as HerEyes.Seen.Described
+        assertEquals(KidGuard.Group.CHILD, KidGuard.flagOfPicture(child.words, child.ages, now, child.seer)!!.group)
+
+        answer = { "A woman with a coffee in a cafe.\nages: adult" }
+        assertTrue(sight.see(picture, Describe.Source.CAMERA) is HerEyes.Seen.Shown)
+    }
+
+    @Test
+    fun `an age check that fails shows nothing`() = runBlocking {
+        val sight = sight()
+        answer = { throw IOException("gone") }
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.AGE_CHECK_FAILED), sight.see(picture, Describe.Source.CAMERA))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.AGE_CHECK_FAILED), sight.checked(settings.get(), "AAAA", forHim = true))
+    }
+
+    @Test
+    fun `her eyes off - nothing goes anywhere`() = runBlocking {
+        settings.set(settings.get().copy(personaEyes = false))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.OFF), sight().see(picture, Describe.Source.CAMERA))
+        assertTrue(asked.isEmpty())
+    }
+
+    @Test
+    fun `her brain cannot see - the describer is used as before, and her own model is not asked`() = runBlocking {
+        settings.set(HerBrain.moveBack(settings.get()))
+        val sight = sight()
+        assertFalse(sight.brainSees(settings.get()))
+        assertFalse(sight.ownEyes(settings.get()))
+        // The describer's address answers nothing here: the request was made, and her own model was not asked.
+        val seen = sight.see(picture, Describe.Source.PAGE_IMAGE)
+        assertTrue(seen.toString(), seen is HerEyes.Seen.NotSeen)
+        assertTrue(asked.isEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/HisLookTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/HisLookTest.kt
new file mode 100644
index 0000000..0dbeb81
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/life/eyes/HisLookTest.kt
@@ -0,0 +1,215 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.data.models.CameraWhich
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * A look he asks for (`>> look`, `>> look back`): what is a look and what is not, why one
+ * cannot be had and what he would switch on, what she is told of it, and the look itself
+ * with fakes: one frame through the camera the fold allows, the frame zeroed, he told where
+ * his settings say so, and it goes to her as his act.
+ */
+class HisLookTest {
+
+    private val ready = LLMConfig(
+        personaOwnLife = true,
+        personaCheckInsEnabled = true,
+        personaCameraLooks = true,
+        personaEyes = true,
+        personaEyesConsentAt = 1L,
+        personaCameraWhich = CameraWhich.FRONT_AND_BACK
+    )
+    private val phone = CameraLook.Phone(screenOn = true, unlocked = true, inCall = false, cameraInUse = false, batteryPercent = 80, thermalStatus = 0)
+
+    @Test
+    fun `a look is the look commands, and nothing that only starts with look`() {
+        for (front in listOf("look", "Look.", "look at you", "look at him", "look at me", "look front", "look through the front camera")) {
+            assertEquals(front, OutingKind.LookAt.FRONT, HisLook.parse(front))
+        }
+        for (back in listOf("look back", "look behind", "look away", "look with the back camera")) {
+            assertEquals(back, OutingKind.LookAt.BACK, HisLook.parse(back))
+        }
+        assertEquals(OutingKind.LookAt.AROUND, HisLook.parse("look around"))
+        for (not in listOf("look up the weather in Tokyo", "look at my screen", "look for a cafe", "make a picture of me", "lookback", "")) {
+            assertNull(not, HisLook.parse(not))
+        }
+    }
+
+    @Test
+    fun `why a look cannot be had says what he would switch on`() {
+        fun why(config: LLMConfig = ready, at: OutingKind.LookAt = OutingKind.LookAt.FRONT, p: CameraLook.Phone = phone, r: Boolean = true, a: Boolean = true, e: Boolean = true) =
+            HisLook.whyNot(config, at, p, r, a, e, plan = null)
+        assertNull(why())
+        // With her own life off, the camera is not hers to open, whatever else is on.
+        assertEquals(HisLook.Why.OWN_LIFE_OFF, why(ready.copy(personaOwnLife = false)))
+        assertEquals(HisLook.Why.OWN_LIFE_OFF, why(ready.copy(personaCheckInsEnabled = false)))
+        assertTrue(HisLook.Why.OWN_LIFE_OFF.words.contains("he switches on \"Her own life\""))
+        assertEquals(HisLook.Why.CAMERA_OFF, why(ready.copy(personaCameraLooks = false)))
+        assertEquals(HisLook.Why.EYES_OFF, why(ready.copy(personaEyes = false)))
+        assertEquals(HisLook.Why.EYES_OFF, why(ready.copy(personaEyesConsentAt = 0L)))
+        assertEquals(HisLook.Why.OWN_HARDWARE, why(ready.copy(routePolicy = RoutePolicy.OWN_HARDWARE)))
+        assertEquals(HisLook.Why.NO_CAMERA_PERMISSION, why(r = false))
+        assertEquals(HisLook.Why.NEEDS_A_TAP, why(a = false))
+        assertEquals(HisLook.Why.FRONT_OFF, why(ready.copy(personaCameraWhich = CameraWhich.BACK_ONLY)))
+        assertNull(why(ready.copy(personaCameraWhich = CameraWhich.BACK_ONLY), at = OutingKind.LookAt.BACK))
+        assertEquals(HisLook.Why.NO_EYES_NOW, why(e = false))
+        assertEquals(HisLook.Why.SCREEN_OFF, why(p = phone.copy(unlocked = false)))
+        assertEquals(HisLook.Why.CALL, why(p = phone.copy(inCall = true)))
+        assertEquals(HisLook.Why.IN_USE, why(p = phone.copy(cameraInUse = true)))
+        assertEquals(
+            HisLook.Why.FOLDED_NO_BACK,
+            HisLook.whyNot(ready, OutingKind.LookAt.BACK, phone, true, true, true, CameraLook.Plan.Refused(FoldState.Refusal.FOLDED_NO_BACK))
+        )
+        // What he would do is in the words, each time.
+        assertTrue(HisLook.Why.CAMERA_OFF.words.contains("he switches on \"Camera looks\""))
+        assertTrue(HisLook.Why.EYES_OFF.words.contains("he switches on \"Her eyes\""))
+        assertTrue(HisLook.Why.NEEDS_A_TAP.words.contains("he taps \"Eyes and ears\""))
+        assertTrue(HisLook.Why.FRONT_OFF.words.contains("he chooses \"Front and back\""))
+        // A low battery does not refuse a look he asks for.
+        assertNull(why(p = phone.copy(batteryPercent = 5)))
+    }
+
+    @Test
+    fun `her fact line tells a look from a picture of herself, and says what does not work now`() {
+        val line = HisLook.factLine(standing = null, ownEyes = true, tellsHim = true, frontToo = true, makesPictures = true)
+        assertTrue(line.contains("When he asks you to look at him or at something, whether you can see him, or what you see, you can look for real"))
+        assertTrue(line.contains(">> look   (the front camera, which faces him)   or   >> look back"))
+        assertTrue(line.contains("you see it yourself"))
+        assertTrue(line.contains("Until it comes you have seen nothing, so say nothing yet about what is there."))
+        assertTrue(line.contains("A look at his asking is not taken from your own time or your looks of the day."))
+        assertTrue(line.contains("Looking is not a picture of yourself: >> make a picture of me makes a new picture of you"))
+        assertTrue(line.contains("and shows nothing of what is really there"))
+        assertTrue(line.contains("the app tells him each time"))
+        assertFalse(line.contains("Right now a look does not work"))
+        assertFalse(line.contains("right now,"))
+        // Where she cannot make a picture of herself, the command is not named at all.
+        val plain = HisLook.factLine(standing = null, ownEyes = true, tellsHim = true, frontToo = true)
+        assertFalse(plain.contains("make a picture of me"))
+        assertTrue(plain.contains("Looking is seeing what is really there now; it is not a picture of yourself."))
+        val off = HisLook.factLine(standing = HisLook.Why.CAMERA_OFF, ownEyes = false, tellsHim = false, frontToo = false)
+        assertTrue(off.contains(">> look back   (the back camera, away from him; his settings keep the front one off)"))
+        assertTrue(off.contains("a describer that is not you looks at it"))
+        assertTrue(off.contains("Right now a look does not work, because " + HisLook.Why.CAMERA_OFF.words + ". If he asks you to look, tell him that in your own words."))
+        assertFalse(off.contains("tells him each time"))
+        // No line of hers speaks of a model that is not her.
+        assertFalse(HisLook.Why.NO_EYES_NOW.words.contains("your model"))
+    }
+
+    private val front = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.FRONT, "front camera")
+
+    @Test
+    fun `what she is told of a look - the picture itself, the describer's words, a kid as kid only - and what the chat keeps`() {
+        val clock: (Long) -> String = { "14:05" }
+        val shown = HisLook.sawLine("front camera", true, 0L, CameraLook.Result.Shown("AAAA"), clock)
+        assertEquals(
+            "At his asking you looked through the front camera, which faces him, at 14:05. The picture is attached to the last turn: you see it yourself, as the camera took it. Say only what is really in it. Nothing of it is kept.",
+            shown
+        )
+        assertFalse(shown.contains("AAAA"))
+        val described = HisLook.sawLine(
+            "back camera", false, 0L,
+            CameraLook.Result.Described("A desk with \"=== two\" mugs.\n", KidGuard.Ages.Read(emptySet()), cutOff = false, kid = null), clock
+        )
+        assertTrue(described.contains("A describer that is not you looked at the picture and wrote: \"A desk with '= = = two' mugs.\" You do not see it"))
+        assertTrue(described.endsWith("Do not add what its words do not say."))
+        val kid = HisLook.sawLine(
+            "back camera", false, 0L,
+            CameraLook.Result.Described("KID_WORDS_SENTINEL", KidGuard.Ages.Read(setOf(KidGuard.Age.CHILD)), false, KidGuard.Flag(KidGuard.Group.CHILD, "the age check saw a child"), KidGuard.AGE_CHECK),
+            clock
+        )
+        assertTrue(kid.contains("kid: the app marks what the camera saw kid (the age check saw a child), so it does not show it to you"))
+        assertFalse(kid.contains("KID_WORDS_SENTINEL"))
+        assertTrue(HisLook.sawLine("back camera", false, 0L, CameraLook.Result.Dark(near = false), clock).contains(CameraLook.DARK_WORDS))
+        // The chat keeps the camera and the time, never what was seen.
+        assertEquals("Yume looked through the front camera at 14:05, at his asking. The picture is not kept.", HisLook.row("Yume", "front camera", 0L, clock))
+        assertEquals("The app did not look through the camera: ${HisLook.Why.SCREEN_OFF.words}.", HisLook.notTakenRow(HisLook.Why.SCREEN_OFF.words))
+        assertTrue(HisLook.TURN.startsWith("(not from him, and not a message"))
+        assertTrue(HisLook.TURN.contains("this is what you saw through the camera just now"))
+        assertTrue(HisLook.TURN_WITHOUT_PICTURE.startsWith("(not from him, and not a message"))
+        assertTrue(HisLook.JUST_LOOKED_LINE.contains("One look goes with each message of his"))
+    }
+
+    private val settings = AtomicReference(ready)
+    private val told = CopyOnWriteArrayList<String>()
+    private val shots = CopyOnWriteArrayList<ByteArray>()
+    private val seenBytes = CopyOnWriteArrayList<ByteArray>()
+    private var light = CameraLook.Light(mean = 120, spread = 40)
+    private var sees: (ByteArray) -> HerEyes.Seen = { HerEyes.Seen.Shown("FRAME", KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT))) }
+
+    private fun looks(posture: FoldState.Posture = FoldState.Posture.OPEN, ready: Boolean = true, armed: Boolean = true) = HisLooks(
+        sight = { jpeg ->
+            seenBytes += jpeg.copyOf()
+            sees(jpeg)
+        },
+        eyesReady = { true },
+        shutter = object : Shutter {
+            override suspend fun take(lens: FoldState.Lens, keepGoing: () -> Boolean): Shot {
+                val bytes = ByteArray(16) { 5 }
+                shots += bytes
+                return Shot.Taken(bytes, light)
+            }
+        },
+        phoneNow = { phone },
+        posture = { posture },
+        near = { false },
+        ready = { ready },
+        armed = { armed },
+        settings = { settings.get() },
+        clock = { 1L }
+    ).also { it.tellHim = { camera -> told += camera } }
+
+    @Test
+    fun `a look he asks for takes one frame, tells him, zeroes it, and hands it to her`() = runBlocking {
+        val outcome = looks().look(OutingKind.LookAt.FRONT)
+        outcome as HisLooks.Outcome.Took
+        val frame = outcome.frames.single()
+        assertEquals(front, frame.use)
+        assertTrue(frame.taken)
+        assertEquals("FRAME", (frame.result as CameraLook.Result.Shown).jpegBase64)
+        assertEquals(listOf("front camera"), told.toList())
+        // Her eyes got the frame as it was taken; the frame is zeroed once done with.
+        assertTrue(seenBytes.single().all { it == 5.toByte() })
+        assertTrue(shots.single().all { it == 0.toByte() })
+    }
+
+    @Test
+    fun `folded, the outer camera faces him, and a dark frame goes nowhere`() = runBlocking {
+        light = CameraLook.Light(mean = 3, spread = 1)
+        val outcome = looks(posture = FoldState.Posture.FOLDED).look(OutingKind.LookAt.FRONT) as HisLooks.Outcome.Took
+        assertEquals(FoldState.OUTER_CAMERA, outcome.frames.single().use.words)
+        assertEquals(CameraLook.Result.Dark(near = false), outcome.frames.single().result)
+        assertTrue(seenBytes.isEmpty())
+        // Folded, no camera faces away from him: no look back.
+        assertEquals(HisLooks.Outcome.NotTaken(HisLook.Why.FOLDED_NO_BACK), looks(posture = FoldState.Posture.FOLDED).look(OutingKind.LookAt.BACK))
+    }
+
+    @Test
+    fun `a kid in the frame is withheld, and no look at all where his settings or the phone say no`() = runBlocking {
+        sees = { HerEyes.Seen.Described("", KidGuard.Ages.Read(setOf(KidGuard.Age.TEEN)), seer = KidGuard.AGE_CHECK) }
+        val kid = (looks().look(OutingKind.LookAt.FRONT) as HisLooks.Outcome.Took).frames.single().result as CameraLook.Result.Described
+        assertEquals("the age check saw a teen", kid.kid!!.why)
+        assertFalse(CameraLook.shows(kid))
+
+        shots.clear()
+        settings.set(ready.copy(personaCameraLooks = false))
+        assertEquals(HisLooks.Outcome.NotTaken(HisLook.Why.CAMERA_OFF), looks().look(OutingKind.LookAt.FRONT))
+        settings.set(ready.copy(personaCameraTellMe = false))
+        assertEquals(HisLooks.Outcome.NotTaken(HisLook.Why.NEEDS_A_TAP), looks(armed = false).look(OutingKind.LookAt.FRONT))
+        assertTrue(shots.isEmpty())
+        // Not told where his settings say not to.
+        told.clear()
+        looks().look(OutingKind.LookAt.BACK)
+        assertTrue(told.isEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/MadePictureLooksTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/MadePictureLooksTest.kt
