+package com.opendroid.ai.core.llm
+
+import com.opendroid.ai.core.llm.providers.VeniceE2ee
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.selectedModelFor
+import java.net.URI
+
+/**
+ * Who can read what is sent to a model, judged from the configuration alone.
+ *
+ * The owner's rule is that what he tells her stays with her. A prompt has to go to
+ * whichever model writes the answer, so the rule comes down to where that model runs:
+ *
+ *  - [ON_DEVICE]: on this phone. Nothing leaves it.
+ *  - [OWN_NETWORK]: on a machine at a private address (his PC, a home server, a private
+ *    tunnel). It leaves the phone and stays his.
+ *  - [ENCRYPTED]: at a company, but encrypted on this phone to a key that exists only
+ *    inside a sealed enclave. The company carries text it cannot read.
+ *  - [HOSTED]: at a company, readable by it.
+ */
+enum class RoutePrivacy {
+    ON_DEVICE, OWN_NETWORK, ENCRYPTED, HOSTED;
+
+    /** True when nobody but the owner's own hardware, or a sealed enclave, can read the prompt. */
+    val isPrivate: Boolean get() = this != HOSTED
+
+    /**
+     * The routes are declared from the most private to the least, so a request may be
+     * handed from [other] to this one without more people being able to read it.
+     */
+    fun isAtLeastAsPrivateAs(other: RoutePrivacy): Boolean = ordinal <= other.ordinal
+
+    val label: String
+        get() = when (this) {
+            ON_DEVICE -> "on this phone"
+            OWN_NETWORK -> "on your own network"
+            ENCRYPTED -> "end to end encrypted"
+            HOSTED -> "hosted, readable by the provider"
+        }
+}
+
+/** Whether a call on [route] may be made at all. */
+fun RoutePolicy.allows(route: RoutePrivacy): Boolean = when (this) {
+    RoutePolicy.OWN_HARDWARE -> route == RoutePrivacy.ON_DEVICE || route == RoutePrivacy.OWN_NETWORK
+    RoutePolicy.ENCRYPTED -> route.isPrivate
+    RoutePolicy.ANY -> true
+}
+
+/**
+ * Whether the owner's own details (date of birth, where he is, notification text, what
+ * she has noted about him, what the phone read out to him) are left out of a prompt on
+ * [route]. On a private route nothing is held back: she may look at everything, because
+ * nobody else can. On a plain hosted route private mode keeps those details on the phone.
+ */
+fun LLMConfig.holdsBackDetails(route: RoutePrivacy): Boolean = privateMode && !route.isPrivate
+
+object RouteClassifier {
+
+    /**
+     * Providers whose endpoint the owner types in and whose model then runs at that
+     * address, so it may be his own hardware. "Copilot API" is not one of them: what
+     * runs at its address is a relay to a company's hosted models, wherever it listens.
+     */
+    private val OWN_ENDPOINT_PROVIDERS = setOf("Ollama", "Custom OpenAI Compatible")
+
+    /** The one host the encrypted exchange is spoken with; the provider refuses any other. */
+    private const val ENCRYPTED_HOST = "api.venice.ai"
+
+    /** Ollama serves models tagged this way from its own servers, whatever address the app talks to. */
+    private val OLLAMA_CLOUD_TAG = Regex("""(?i)[:\-]cloud$""")
+
+    /** The route a request to [provider] with [model] at [endpoint] takes. */
+    fun classify(provider: String, model: String, endpoint: String): RoutePrivacy {
+        val name = ProviderCatalog.canonicalName(provider)
+        if (ProviderCatalog.isOnDevice(name)) return RoutePrivacy.ON_DEVICE
+        // Gemini Nano is served by the phone's own AI Core, not by Google's API.
+        if (name == "Google Gemini" && model.trim() == "gemini-nano") return RoutePrivacy.ON_DEVICE
+        val relayedToACompany = name == "Ollama" && OLLAMA_CLOUD_TAG.containsMatchIn(model.trim())
+        if (name in OWN_ENDPOINT_PROVIDERS && !relayedToACompany) {
+            when (hostKind(endpoint)) {
+                HostKind.LOOPBACK -> return RoutePrivacy.ON_DEVICE
+                HostKind.PRIVATE -> return RoutePrivacy.OWN_NETWORK
+                HostKind.PUBLIC -> Unit
+            }
+        }
+        // The encrypted exchange exists only in the OpenAI-compatible provider, and only
+        // with the one host whose enclaves it knows how to check.
+        if (name == "Custom OpenAI Compatible" && VeniceE2ee.isE2eeModel(model) && hostOf(endpoint) == ENCRYPTED_HOST &&
+            endpoint.trim().startsWith("https://", ignoreCase = true)
+        ) {
+            return RoutePrivacy.ENCRYPTED
+        }
+        return RoutePrivacy.HOSTED
+    }
+
+    /** The route [provider] takes as configured, with [modelOverride] in place of its selected model. */
+    fun classify(config: LLMConfig, provider: String, modelOverride: String? = null): RoutePrivacy {
+        val name = ProviderCatalog.canonicalName(provider)
+        val model = modelOverride?.trim()?.takeIf { it.isNotEmpty() }
+            ?: if (ProviderCatalog.isKnown(name)) config.selectedModelFor(name) else ""
+        return classify(name, model, endpointOf(config, name))
+    }
+
+    /** The route the planner and everything else on the main provider takes. */
+    fun mainRoute(config: LLMConfig): RoutePrivacy = classify(config, config.activeProvider)
+
+    /** The route her own replies, her notebook and her unprompted lines take. */
+    fun personaRoute(config: LLMConfig): RoutePrivacy {
+        val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+        val provider = if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) chosen else config.activeProvider
+        return classify(config, provider, config.personaChatModel)
+    }
+
+    fun endpointOf(config: LLMConfig, provider: String): String = when (ProviderCatalog.canonicalName(provider)) {
+        "Copilot API" -> config.copilotUrl.trim()
+        "Ollama" -> config.ollamaUrl.trim()
+        else -> config.customEndpoints[ProviderCatalog.canonicalName(provider)].orEmpty().trim()
+    }
+
+    /**
+     * True when a request to [endpoint] would travel without TLS: it says http://, or it
+     * names no scheme at all, which the providers read as http. Anyone on the way can read
+     * such a request, so it is only for a machine of the owner's own ([cleartextStaysHis]).
+     */
+    internal fun isCleartext(endpoint: String): Boolean {
+        val trimmed = endpoint.trim()
+        if (trimmed.isEmpty()) return false
+        return if ("://" in trimmed) trimmed.startsWith("http://", ignoreCase = true) else true
+    }
+
+    /** Whether an unencrypted request to [endpoint] stays on this phone or on his own network. */
+    internal fun cleartextStaysHis(endpoint: String): Boolean = hostKind(endpoint) != HostKind.PUBLIC
+
+    internal enum class HostKind { LOOPBACK, PRIVATE, PUBLIC }
+
+    /**
+     * Sorts the host of [endpoint] by its literal form only. A name is never looked up:
+     * an answer from DNS could be anything, and the point of this check is to be certain.
+     * So a public-looking name that happens to resolve to a private address counts as
+     * public, which errs on the side of not sending.
+     */
+    /** The host of [endpoint] in lower case, or null when it has none that can be read. */
+    internal fun hostOf(endpoint: String): String? {
+        val trimmed = endpoint.trim()
+        if (trimmed.isEmpty()) return null
+        return try {
+            URI(if ("://" in trimmed) trimmed else "http://$trimmed").host
+        } catch (e: Exception) {
+            null
+        }?.lowercase()?.removeSurrounding("[", "]")?.trimEnd('.')
+    }
+
+    internal fun hostKind(endpoint: String): HostKind {
+        val host = hostOf(endpoint) ?: return HostKind.PUBLIC
+        if (host == "localhost" || host.endsWith(".localhost")) return HostKind.LOOPBACK
+        if (':' in host) return ipv6Kind(host)
+        val octets = host.split('.')
+        if (octets.size == 4 && octets.all { part -> part.isNotEmpty() && part.length <= 3 && part.all(Char::isDigit) }) {
+            val (a, b) = octets.map { it.toInt() }
+            if (octets.any { it.toInt() > 255 }) return HostKind.PUBLIC
+            return when {
+                a == 127 -> HostKind.LOOPBACK
+                a == 10 -> HostKind.PRIVATE
+                a == 172 && b in 16..31 -> HostKind.PRIVATE
+                a == 192 && b == 168 -> HostKind.PRIVATE
+                a == 169 && b == 254 -> HostKind.PRIVATE
+                // Carrier-grade NAT space, which private tunnels such as Tailscale use.
+                a == 100 && b in 64..127 -> HostKind.PRIVATE
+                else -> HostKind.PUBLIC
+            }
+        }
+        // All digits and dots but not four octets: not an address anyone should trust.
+        if (host.all { it.isDigit() || it == '.' }) return HostKind.PUBLIC
+        return if (PRIVATE_SUFFIXES.any { host.endsWith(it) } || '.' !in host) HostKind.PRIVATE else HostKind.PUBLIC
+    }
+
+    private fun ipv6Kind(host: String): HostKind {
+        val address = host.substringBefore('%')
+        return when {
+            address == "::1" -> HostKind.LOOPBACK
+            address.startsWith("fc") || address.startsWith("fd") -> HostKind.PRIVATE
+            address.startsWith("fe8") || address.startsWith("fe9") ||
+                address.startsWith("fea") || address.startsWith("feb") -> HostKind.PRIVATE
+            else -> HostKind.PUBLIC
+        }
+    }
+
+    /**
+     * Name endings that only exist on a private network: mDNS, the usual home-router
+     * domains, and a Tailscale tailnet. A bare single-label name is private too, since
+     * nothing on the public internet answers to one.
+     */
+    private val PRIVATE_SUFFIXES = listOf(".local", ".lan", ".home", ".home.arpa", ".internal", ".ts.net")
+}
