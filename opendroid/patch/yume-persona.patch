diff --git a/app/src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt b/app/src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt
new file mode 100644
index 0000000..c70c0b0
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt
@@ -0,0 +1,204 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import com.opendroid.ai.actions.base.Action
+import com.opendroid.ai.actions.base.ActionResult
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.persona.MadePictureAgeCheck
+import com.opendroid.ai.core.persona.PersonaPictures
+import com.opendroid.ai.core.persona.PersonaSelfPictures
+import com.opendroid.ai.core.persona.PictureModels
+import com.opendroid.ai.core.persona.SelfPictureMaker
+import com.opendroid.ai.core.persona.SelfPicturePlans
+import com.opendroid.ai.core.persona.VeniceImages
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.UserProfileStore
+import com.opendroid.ai.data.repository.SettingsRepository
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnPurpose
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.first
+import okhttp3.OkHttpClient
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The phone action by which she makes a new picture of herself ([PersonaSelfPictures]):
+ * a new one drawn in her look and matched to her pictures, a small change to one she names,
+ * or the sides of a full-body reference. Every picture is age-checked before it is shown or
+ * kept ([SelfPictureMaker], [MadePictureAgeCheck]); where her brain sees, she looks at it
+ * before she says anything of it, and what she says is its caption.
+ *
+ * What an image model is given of her own pictures to work from (the match, the picture a
+ * change starts from) is only ever an original or a master, as the store holds it now
+ * ([PersonaPictures.source], [com.opendroid.ai.core.persona.PictureSources]). A change to a
+ * picture a model made is not made, and she is told why.
+ */
+@Singleton
+class PersonaPictureActions @Inject constructor(
+    private val pictures: PersonaPictures,
+    private val memory: com.opendroid.ai.core.persona.PersonaMemory,
+    private val store: com.opendroid.ai.core.persona.PersonaStore,
+    private val settingsRepository: SettingsRepository,
+    private val userProfileStore: UserProfileStore,
+    private val client: OkHttpClient,
+    private val ageCheck: MadePictureAgeCheck,
+    private val log: HerLog,
+    // Lazy: her engine is what runs this action's commands.
+    private val engine: dagger.Lazy<com.opendroid.ai.core.persona.PersonaEngine>
+) {
+    fun getActions(): List<Action> = listOf(MakeSelfPictureAction())
+
+    private inner class MakeSelfPictureAction : Action {
+        override val name: String = NAME
+
+        override suspend fun execute(params: Map<String, String>, context: Context): ActionResult {
+            val config = settingsRepository.llmConfig.first()
+            // A picture of her, made only while she is the one who talks (PersonaEngine.isActive).
+            if (!config.personaEnabled || store.card().isBlank()) {
+                return ActionResult(false, null, "She is switched off, so no picture of her is made.")
+            }
+            PersonaSelfPictures.notAllowed(config)?.let { return ActionResult(false, null, it) }
+            // In her own time her own-time key goes first, where he set one: her own life's limit stands behind it.
+            val own = currentCoroutineContext()[OwnCall]
+            val key = PersonaSelfPictures.keyFor(config, ownTime = currentCoroutineContext()[OwnCall] != null)
+                ?: return ActionResult(false, null, "No Venice key is set, so no picture can be made.")
+            val ask = params["description"].orEmpty().trim()
+            // A full-body reference of one or more sides ("views"), or one ordinary picture.
+            val views = PersonaSelfPictures.views(params["views"])
+            if (views.isEmpty() || ask.isNotEmpty()) PersonaSelfPictures.refusal(ask)?.let { return ActionResult(false, null, it) }
+            // The words that pick the picture to start from are held to the same rule.
+            PersonaSelfPictures.refusalOfWords(params["from"])?.let { return ActionResult(false, null, it) }
+            val notes = memory.notes()
+            val owner = (userProfileStore.read() as? ProfileStoreResult.Success)?.value?.name.orEmpty()
+            // What her notes know of him: her words must not carry any of it out.
+            val hisNotes = notes.filter {
+                it.kind == com.opendroid.ai.core.persona.PersonaNotes.Kind.USER ||
+                    it.kind == com.opendroid.ai.core.persona.PersonaNotes.Kind.REL
+            }.joinToString("\n") { it.text }
+            PersonaSelfPictures.carriesHisDetails(ask, hisNotes)?.let { return ActionResult(false, null, it) }
+            val all = pictures.list()
+            if (PersonaSelfPictures.base(all, null) == null) {
+                return ActionResult(false, null, "She has no picture of herself yet to start from. Add one in Settings, Persona.")
+            }
+            val words = PersonaSelfPictures.withoutHim(ask, owner)
+            val age = com.opendroid.ai.core.persona.PersonaAge.on(System.currentTimeMillis())
+            // How she looks now, as she has noted it herself: newer than her files.
+            val lookNow = PersonaSelfPictures.lookNow(notes, owner)
+            val maker = maker(key, own)
+            val counted = own != null
+            val keep: suspend (ByteArray, String) -> PersonaPictures.Added = { bytes, caption -> pictures.addMade(bytes, caption) }
+            // Where her brain sees, she looks at the kept picture before she says anything of it.
+            val look = lookOf(config)
+            val drop: suspend (com.opendroid.ai.core.persona.PersonaPicture) -> Unit = { picture -> pictures.remove(picture.id) }
+
+            // A small change to the one picture she names: an edit of that picture.
+            val named = if (views.isEmpty()) PersonaSelfPictures.named(all, params["from"]) else null
+            if (named != null) {
+                // Only an original or a master is ever started from: a change to a made picture drifts.
+                if (!com.opendroid.ai.core.persona.PictureSources.mayBeSource(named)) {
+                    return ActionResult(false, null, PersonaSelfPictures.NOT_A_BASE_WHY)
+                }
+                val source = pictures.source(named.id) ?: return ActionResult(false, null, "The picture to start from could not be read.")
+                val plan = SelfPicturePlans.change(PictureModels.editModelOf(config), source, words, age, lookNow)
+                // Kept as what it is: the picture it was made from, and the change.
+                return outcome(maker.make(plan, PersonaSelfPictures.changeCaption(named.caption, words), counted, keep, look, drop))
+            }
+
+            // Anything else is drawn new, and matched to her originals and masters where he left that on.
+            val model = PictureModels.generateModelOf(config)
+            val references = if (config.personaPictureMatch) {
+                PersonaSelfPictures.references(all).mapNotNull { pictures.source(it.id) }
+            } else {
+                emptyList()
+            }
+            val seed = SelfPicturePlans.seed()
+            if (views.isEmpty()) {
+                val plan = SelfPicturePlans.newPicture(model, words, references, config.personaPictureMatch, seed, age, lookNow)
+                return outcome(maker.make(plan, PersonaSelfPictures.caption(words), counted, keep, look, drop))
+            }
+            // One picture per side, one after the other, the same seed for each, each kept as it
+            // comes: a side that fails is said as such, and the ones that were made stay made.
+            val lines = views.map { view ->
+                val plan = SelfPicturePlans.newPicture(model, words, references, config.personaPictureMatch, seed, age, lookNow, view)
+                when (val made = maker.make(plan, PersonaSelfPictures.referenceCaption(view, words), counted, keep, look, drop)) {
+                    is SelfPictureMaker.Outcome.Kept -> keptLine(made)
+                    is SelfPictureMaker.Outcome.NotKept -> "Not made: the ${view.word} view. ${made.why}"
+                }
+            }
+            val anyMade = lines.any { it.startsWith(MADE_PREFIX) }
+            return if (anyMade) ActionResult(true, lines.joinToString("\n"), null) else ActionResult(false, null, lines.joinToString("\n"))
+        }
+    }
+
+    /**
+     * How she looks at a picture of herself that was just kept, where her brain sees it on its
+     * route: her words about it, then kept as its caption; null where she cannot see it or said
+     * nothing. A body reference keeps the side it shows at the start of its caption, her words after.
+     */
+    private fun lookOf(config: com.opendroid.ai.data.models.LLMConfig): (suspend (com.opendroid.ai.core.persona.PersonaPicture) -> String?)? {
+        val her = engine.get()
+        if (!her.chatSeesImages(config) || her.pictureRefused(config)) return null
+        return { picture ->
+            val base64 = pictures.base64(picture.id)
+            val reading = base64?.let { her.readMadePicture(it) } as? com.opendroid.ai.core.persona.PictureReading.Read
+            reading?.text?.takeIf { it.isNotBlank() }?.let { words ->
+                // A body reference keeps the side it shows in its caption, so that it can still be named.
+                val caption = if (picture.caption.startsWith(PersonaSelfPictures.REFERENCE_CAPTION_START)) {
+                    com.opendroid.ai.core.persona.PersonaPictureRules.fitCaption(picture.caption.trimEnd('.') + ". " + words)
+                } else {
+                    words
+                }
+                pictures.setCaption(picture.id, caption, com.opendroid.ai.core.persona.PersonaPicture.CaptionBy.HER)
+                caption
+            }
+        }
+    }
+
+    /**
+     * The maker for one action: requests on [key], each a call of hers in her own time
+     * ([OwnPurpose.PICTURE], written down at this call site since it does not go through her
+     * model), the age check, and her log's picture counts.
+     */
+    private fun maker(key: String, own: OwnCall?): SelfPictureMaker = SelfPictureMaker(
+        send = { call ->
+            val made = try {
+                VeniceImages.send(client, key, call)
+            } catch (e: kotlinx.coroutines.CancellationException) {
+                own?.recordAs(OwnPurpose.PICTURE, call.model, ok = false)
+                throw e
+            }
+            // A request that never reached Venice was no call.
+            if (made !is VeniceImages.Made.Failed || made.sent) own?.recordAs(OwnPurpose.PICTURE, call.model, ok = made !is VeniceImages.Made.Failed)
+            made
+        },
+        check = ageCheck,
+        counts = logCounts(log)
+    )
+
+    private fun outcome(made: SelfPictureMaker.Outcome): ActionResult = when (made) {
+        is SelfPictureMaker.Outcome.Kept -> ActionResult(true, keptLine(made), null)
+        is SelfPictureMaker.Outcome.NotKept -> ActionResult(false, null, made.why)
+    }
+
+    private fun keptLine(made: SelfPictureMaker.Outcome.Kept): String =
+        PersonaSelfPictures.keptLine(made.picture.id, made.picture.caption, made.note)
+
+    companion object {
+        const val NAME = "MAKE_SELF_PICTURE"
+
+        /** See [PersonaSelfPictures.MADE_PREFIX]. */
+        const val MADE_PREFIX = PersonaSelfPictures.MADE_PREFIX
+
+        fun madePictureIds(text: String?): List<String> = PersonaSelfPictures.madePictureIds(text)
+
+        fun shownWithoutIds(text: String): String = PersonaSelfPictures.shownWithoutIds(text)
+
+        /** Her log's picture counts as the maker counts: kept, or thrown away by category. Counts only. */
+        fun logCounts(log: HerLog): SelfPictureMaker.Counts = object : SelfPictureMaker.Counts {
+            override fun kept() = log.picture(kept = true)
+            override fun notKept(category: String) = log.picture(kept = false, category = category)
+        }
+    }
+}
