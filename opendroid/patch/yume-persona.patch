+        assertEquals("who's that and where's my drink", persona("whos that and wheres my drink"))
+        assertEquals("you should've called, it'll be late", persona("you shouldve called, itll be late"))
+        assertEquals("we've met. he hadn't", persona("weve met. he hadnt"))
+    }
+
+    @Test
+    fun `a gesture in asterisks is not said aloud, an emphasised word is`() {
+        assertEquals("oi. you again", persona("*rolls eyes* oi. you again"))
+        assertEquals("fine", persona("*sighs* fine *rolls her eyes*"))
+        assertEquals("whatever. you wish", persona("whatever *shrugs*\n*leans back* you wish"))
+        assertEquals("", persona("*shrugs*"))
+        assertEquals("it did not go through", persona("it did *not* go through"))
+        assertEquals("never", persona("**never**"))
+        // Swearing with a star in it and sums are read as they stand.
+        assertEquals("f*ck this sh*t", persona("f*ck this sh*t"))
+        assertEquals("its 2*3*4", persona("its 2*3*4"))
+        // Text that is not hers keeps its words: the base pass has no notion of gestures.
+        assertEquals("shrugs", plain("*shrugs*"))
+        assertEquals("Reminder: rolls out on Monday", plain("Reminder: *rolls out on Monday*"))
+    }
+
+    @Test
+    fun `a verb she stressed inside her sentence is said, not taken for a gesture`() {
