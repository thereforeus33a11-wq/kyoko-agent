+/**
+ * Her bilingual voice must be given, on the phone, exactly the phonemes it was trained on.
+ * Its training lines were read by voice/scripts/pod/mix_phonemize.py; this holds the
+ * phone's port ([MixedPhonemes], [EnglishPhonemes]) to that code, byte for byte:
+ *
+ * - every line of the reference's golden set (golden_mixed.tsv, 615 texts made by
+ *   tests/make_golden.py to touch every row of the table, every reading path, both switch
+ *   directions and the normalization cases), compared as the codepoints the reference
+ *   wrote, including the one line it cannot read (NULL);
+ * - every line she is trained on (lang_lines/out/lines_lang.tsv, about 3,300), every line
+ *   of the hand-checked fixtures mixed.tsv and en_words.tsv, and every line the unit tests
+ *   beside this one read (mixed/fixture_lines.tsv lists them all), compared with the
+ *   reference's phonemes;
+ * - the hand-checked phonemes of mixed.tsv.
+ *
+ * The Japanese pieces need Open JTalk, which is native code. As in JapanesePhonemesTest,
+ * its labels were made by pyopenjtalk 0.4.1 (the same front end and dictionary the phone
+ * runs) while the reference read each line, and are looked up here by the very text the
+ * port hands Open JTalk; a piece the port cut differently finds no labels and fails the
+ * line. So every fixture line is covered, its Japanese parts included. Likewise the CMU
+ * dictionary is the subset the reference found while reading them.
+ *
+ * mixed_parity.json is made by the training side's own tool (needs pyopenjtalk 0.4.1,
+ * Piper's phonemize_japanese.py at piper1-gpl 46c3c71, and the pinned cmudict.dict):
+ *
+ *     cd voice/scripts/pod
+ *     { cat lang_lines/out/lines_lang.tsv; tail -n +2 <app>/app/src/test/resources/own_voice/mixed/fixture_lines.tsv; } > /tmp/lines.tsv
+ *     CMUDICT=<cmudict.dict> PIPER_SRC=<piper1-gpl>/src python tests/make_phone_fixture.py \
+ *         <app>/app/src/test/resources/own_voice/mixed_parity.json --lines /tmp/lines.tsv
+ *
+ * and kept as plain JSON so the app patch stays text. The tool writes gzip instead when
+ * the name ends in .gz (as the training side's README writes it): either is read, but only
+ * one of the two may be here. With both, every test here fails and names them, since a
+ * freshly made one beside an old one would otherwise go unread. Re-make it, and copy
+ * en_ipa_table.json and tests/fixtures/ beside it, whenever the table, her lines or the
+ * reference change; a new table also moves [BilingualVoice.VERIFIED_TABLE_SHA256].
+ * With POD_DIR=<voice/scripts/pod> set, the fixture is also checked against her training
+ * lines and table as they are there now.
+ */
+class MixedPhonemesParityTest {
+
+    @Test
+    fun `the fixture was made from this table and the pinned CMU dictionary`() {
+        assertEquals("en_ipa_table.json is not the table mixed_parity.json was made from", table.sha256, string(fixture, "table_sha256"))
+        assertEquals("cmudict.dict is not the one the table names", table.cmudictSha256, string(fixture, "cmudict_sha256"))
+    }
+
+    @Test
+    fun `the phone reads English only with the table checked here`() {
+        // The pin is what lets a bilingual voice read English as English on the phone; a
+        // re-made fixture from another table fails here until the pin is moved with it.
+        assertEquals(
+            "BilingualVoice.VERIFIED_TABLE_SHA256 is not the table these tests hold the port to",
+            BilingualVoice.VERIFIED_TABLE_SHA256, table.sha256,
+        )
+    }
+
+    @Test
+    fun `only one parity fixture is read, and two are refused`() {
+        val plain = """{"cases":[]}""".encodeToByteArray()
+        val inside = """{"cases":[1]}""".encodeToByteArray()
+        val zipped = ByteArrayOutputStream().also { o -> GZIPOutputStream(o).use { it.write(inside) } }.toByteArray()
+        fun files(vararg present: Pair<String, ByteArray>): (String) -> InputStream? =
+            { name -> present.toMap()[name]?.let(::ByteArrayInputStream) }
+        assertArrayEquals(plain, readFixture(files(PARITY_JSON to plain)))
+        assertArrayEquals(inside, readFixture(files(PARITY_GZ to zipped)))
+        val both = runCatching { readFixture(files(PARITY_JSON to plain, PARITY_GZ to zipped)) }.exceptionOrNull()
+        assertTrue(both is IllegalStateException)
+        assertTrue(both!!.message!!.contains(PARITY_JSON) && both.message!!.contains(PARITY_GZ))
+        assertTrue(runCatching { readFixture(files()) }.exceptionOrNull() is IllegalStateException)
+    }
+
+    @Test
+    fun `the fixture holds her training lines and table as they are now, when the training side is here`() {
+        // POD_DIR=<kyoko-agent>/voice/scripts/pod checks against the training side itself.
+        val pod = System.getenv("POD_DIR")?.let(::File)
+        assumeTrue(pod != null && File(pod, "lang_lines/out/lines_lang.tsv").exists())
+        val rows = File(pod, "lang_lines/out/lines_lang.tsv").readText().split('\n').filter { it.isNotEmpty() }
+        val col = rows.first().split('\t').indexOf("text")
+        val now = rows.drop(1).map { it.split('\t')[col] }.filter { it.isNotEmpty() }.toSet()
+        val inFixture = cases.map { string(it, "text") }.toSet()
+        val trainedInFixture = cases.map { string(it, "source") to string(it, "text") }
+            .filter { (source, _) -> source.startsWith("lines:") && !source.startsWith("lines:fixture:") }
+            .map { it.second }.toSet()
+        val remake = "re-make mixed_parity.json (see this test's KDoc)"
+        assertEquals("her lines not in the fixture: $remake", emptySet<String>(), now - inFixture)
+        assertEquals("lines in the fixture she is no longer trained on: $remake", emptySet<String>(), trainedInFixture - now)
+        assertEquals("the training side's table is not the one checked here: $remake",
+            table.sha256, EnglishTable.sha256Hex(File(pod, "en_ipa_table.json").readBytes()))
+    }
+
+    @Test
+    fun `the golden set gives the reference's codepoints, line for line`() {
+        val rows = tsv("own_voice/mixed/golden_mixed.tsv")
+        assertEquals(615, rows.size)
+        val wrong = ArrayList<String>()
+        for ((text, want) in rows.map { it[0] to it[1] }) {
+            val got = encode(mixed.phonemize(text, labelsOf))
+            if (got != want) wrong += "$text\n  want $want\n  got  $got"
+        }
+        if (wrong.isNotEmpty()) fail("${wrong.size} of ${rows.size} golden lines differ:\n" + wrong.take(20).joinToString("\n"))
+    }
+
+    @Test
+    fun `the golden set copied here is the one the fixture was made from`() {
+        val golden = tsv("own_voice/mixed/golden_mixed.tsv").map { it[0] }
+        val inFixture = cases.filter { string(it, "source") == "golden" }.map { string(it, "text") }
+        assertEquals(golden, inFixture)
+    }
+
+    @Test
+    fun `every line she is trained on gives the reference's phonemes`() {
+        val lines = cases.filter { string(it, "source").startsWith("lines:") && !string(it, "source").startsWith("lines:fixture:") }
+        assertTrue("her training lines are missing from the fixture", lines.size >= 3000)
+        assertMatches(lines)
+    }
+
+    @Test
+    fun `every hand-checked fixture line, and every line these tests read, gives the reference's phonemes`() {
+        // A text already among the golden set or her lines is in the fixture once, under that source.
+        val byText = cases.associateBy { string(it, "text") }
+        val texts = tsv("own_voice/mixed/mixed.tsv").map { it[0] } + tsv("own_voice/mixed/en_words.tsv").map { it[0] } +
+            tsv("own_voice/mixed/fixture_lines.tsv").drop(1).map { it[5] }
+        val lines = texts.distinct().map { byText[it] ?: throw AssertionError("not in mixed_parity.json: $it") }
+        assertTrue(lines.size >= 130)
+        assertMatches(lines)
+    }
+
+    @Test
+    fun `the hand-checked mixed lines read as written`() {
+        for (row in tsv("own_voice/mixed/mixed.tsv")) {
+            val got = mixed.phonemize(row[0], labelsOf)
+            assertEquals(row[0], row[1], got?.joinToString(" / ") { it.joinToString("") })
+        }
+    }
+
+    @Test
+    fun `every phoneme is one codepoint`() {
+        for (case in cases) {
+            val got = mixed.phonemize(string(case, "text"), labelsOf) ?: continue
+            for (s in got) for (p in s) assertEquals(p, 1, p.codePointCount(0, p.length))
+        }
+    }
+
+    private fun assertMatches(lines: List<JsonObject>) {
+        val wrong = ArrayList<String>()
+        for (case in lines) {
+            val text = string(case, "text")
+            val want = case["phonemes"]!!.let { if (it is JsonNull) null else it.jsonArray.map { s -> s.jsonPrimitive.content } }
+            val got = mixed.phonemize(text, labelsOf)?.map { it.joinToString("") }
+            if (got != want) wrong += "$text\n  want $want\n  got  $got"
+        }
+        if (wrong.isNotEmpty()) fail("${wrong.size} of ${lines.size} lines differ:\n" + wrong.take(20).joinToString("\n"))
+    }
+
+    companion object {
+        private fun resource(name: String): ByteArray =
+            MixedPhonemesParityTest::class.java.classLoader!!.getResourceAsStream(name)!!.use { it.readBytes() }
+
+        const val PARITY_JSON = "own_voice/mixed_parity.json"
+        const val PARITY_GZ = "own_voice/mixed_parity.json.gz"
+
+        /**
+         * The parity fixture's JSON bytes from whichever one of [PARITY_JSON] and [PARITY_GZ]
+         * [open] finds. Both at once is refused, naming them: one of them is stale (most
+         * likely the plain one, if the .gz was just made as the training side's README says),
+         * and quietly preferring either could leave a re-made fixture unread.
+         */
+        fun readFixture(open: (String) -> InputStream?): ByteArray {
+            val plain = open(PARITY_JSON)?.use { it.readBytes() }
+            val zipped = open(PARITY_GZ)?.use { GZIPInputStream(it).readBytes() }
+            check(plain == null || zipped == null) {
+                "both $PARITY_JSON and $PARITY_GZ are in the test resources: keep only the one just made " +
+                    "by make_phone_fixture.py and delete the other, which is stale"
+            }
+            return plain ?: zipped ?: error("neither $PARITY_JSON nor $PARITY_GZ is in the test resources")
+        }
+
+        val fixture: JsonObject by lazy {
+            val loader = MixedPhonemesParityTest::class.java.classLoader!!
+            Json.parseToJsonElement(readFixture { loader.getResourceAsStream(it) }.decodeToString()).jsonObject
+        }
+
+        val table: EnglishTable by lazy { EnglishTable.parse(resource("own_voice/en_ipa_table.json")) }
+
+        /** The CMU entries the reference found; a word it did not find is absent here too. */
+        val cmu: Map<String, List<String>> by lazy {
+            fixture["cmu"]!!.jsonObject.mapValues { (_, v) -> v.jsonPrimitive.content.split(' ') }
+        }
+
+        /** Open JTalk's labels for every piece the reference handed it, by that piece. */
+        val labels: Map<String, List<String>> by lazy {
+            fixture["labels"]!!.jsonObject.mapValues { (_, v) -> v.jsonArray.map { it.jsonPrimitive.content } }
+        }
+
+        val cases: List<JsonObject> by lazy { fixture["cases"]!!.jsonArray.map { it.jsonObject } }
+
+        val english: EnglishPhonemes by lazy { EnglishPhonemes(table) { cmu[it] } }
+        val mixed: MixedPhonemes by lazy { MixedPhonemes(table, english) }
+
+        /** Open JTalk, as the reference ran it: the labels of a piece it was handed, or none. */
+        val labelsOf: (String) -> List<String>? = { sentence -> labels[sentence] }
+
+        fun string(o: JsonObject, key: String): String = o[key]!!.jsonPrimitive.content
+
+        /** A test resource's TSV rows, comments and blank lines skipped. */
+        fun tsv(name: String): List<List<String>> =
+            resource(name).decodeToString().split('\n')
+                .filter { it.isNotEmpty() && !it.startsWith("#") }
+                .map { it.split('\t') }
+
+        /** The reference's golden encoding: hex codepoints, sentences separated by " / ", NULL for unreadable. */
+        fun encode(sentences: List<List<String>>?): String =
+            sentences?.joinToString(" / ") { s -> s.joinToString(" ") { "%04x".format(it.codePointAt(0)) } } ?: "NULL"
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/own/MixedSegmentationTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/own/MixedSegmentationTest.kt
