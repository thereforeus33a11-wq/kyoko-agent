+        HerLog.EndedBy.TAKEOVER -> "he took his phone back"
+        HerLog.EndedBy.SCREEN_OFF -> "his screen went off or locked"
+        HerLog.EndedBy.CALL -> "a call came in"
+        HerLog.EndedBy.NOTIFICATION -> "a notification came up on his screen"
+        HerLog.EndedBy.NEEDS_HIM -> "a sign-in, payment or permission screen came up, which is his to answer"
