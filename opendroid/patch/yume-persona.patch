+++ b/app/src/test/java/com/opendroid/ai/core/service/NothingAnswersMessagesTest.kt
@@ -0,0 +1,173 @@
+package com.opendroid.ai.core.service
+
+import android.app.Application
+import android.app.Notification
+import android.app.PendingIntent
+import android.content.Intent
+import android.os.Looper
+import android.os.Process
+import android.service.notification.StatusBarNotification
+import android.telephony.SmsManager
+import androidx.core.app.NotificationCompat
+import androidx.core.app.Person
+import androidx.core.app.RemoteInput
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.memory.NotificationIntelligence
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.repository.MemoryRepository
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * Auto-reply has no writer in this build: nothing answers a message for him. A message
+ * that comes in is kept in the notification history and nothing else happens: no reply
+ * through the notification, no SMS, no email draft, whoever sent it. No code reads the
+ * auto-reply switches an earlier build saved, so they cannot change that either.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class NothingAnswersMessagesTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var listener: OpenDroidNotificationListener
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        // Built and given a context, never bound: binding it needs the whole app.
+        listener = Robolectric.buildService(OpenDroidNotificationListener::class.java).get()
+        listener.notificationDao = database.notificationDao()
+        listener.notificationIntelligence = NotificationIntelligence(
+            database.notificationDao(),
+            MemoryRepository(database.memoryDao(), database.taskHistoryDao(), database.macroDao())
+        )
+    }
+
+    @After
+    fun tearDown() {
+        listener.onDestroy()
+        database.close()
+    }
+
+    @Test
+    fun `a message that could be answered is kept, and nothing answers it`() {
+        // A WhatsApp message, an SMS and a Gmail notification from a no-reply sender, each
+        // with a reply action the old auto-reply would have filled in and fired.
+        listener.onNotificationPosted(messageFrom("com.whatsapp", "Aoi", "are you coming?"))
+        listener.onNotificationPosted(messageFrom("com.google.android.apps.messaging", "+15551234567", "call me"))
+        listener.onNotificationPosted(
+            messageFrom("com.google.android.gm", "Tumblr", "Someone liked your post", "no-reply@tumblr.com")
+        )
+
+        savedRows(3)
+        // Long enough for a reply with no delay to have gone out, had anything scheduled one.
+        repeat(15) {
+            shadowOf(Looper.getMainLooper()).idle()
+            Thread.sleep(20)
+        }
+        val saved = savedRows(3)
+
+        assertEquals(setOf("com.whatsapp", "com.google.android.apps.messaging", "com.google.android.gm"), saved.map { it.packageName }.toSet())
+        assertTrue(saved.none { it.isAutoReplied || it.autoReplyText != null })
+        // No reply action was fired, no compose screen was opened and no SMS went out.
+        assertTrue(shadowOf(context).broadcastIntents.none { it.action == REPLY_ACTION })
+        assertNull(shadowOf(context).nextStartedActivity)
+        val sms = shadowOf(context.getSystemService(SmsManager::class.java))
+        assertNull(sms.lastSentTextMessageParams)
+        assertNull(sms.lastSentMultipartTextMessageParams)
+    }
+
+    @Test
+    fun `the listener holds nothing that could answer a message`() {
+        // Only the history and its patterns: no engine, no dispatcher, no settings.
+        val injected = OpenDroidNotificationListener::class.java.declaredFields
+            .filter { it.isAnnotationPresent(javax.inject.Inject::class.java) || it.name.endsWith("Dao") || it.name.endsWith("Intelligence") }
+            .map { it.type.simpleName }
+            .toSet()
+        assertEquals(setOf("NotificationDao", "NotificationIntelligence"), injected)
+        val source = File(main, "core/service/OpenDroidNotificationListener.kt").readText()
+        assertFalse(source.contains("AutoReply"))
+        assertFalse(source.contains("SettingsRepository"))
+    }
+
+    @Test
+    fun `no code answers a message or reads the saved auto-reply switches`() {
+        val sources = main.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+        assertTrue(sources.size > 100)
+        fun users(text: String) = sources.filter { it.readText().contains(text) }.map { it.relativeTo(main).path.replace('\\', '/') }
+
+        // The writer and its sender are gone: the stock prompt that wrote "on behalf of" him,
+        // the inline reply filled into another app's notification, and the "Re:" email draft.
+        assertEquals(emptyList<String>(), users("auto-replying on behalf of"))
+        assertEquals(emptyList<String>(), users("RemoteInput.addResultsToIntent"))
+        assertEquals(emptyList<String>(), users("\"Re: "))
+        for (gone in listOf("AutoReplyPrompts.kt", "AutoReplyGenerator.kt", "AutoReplyEngine.kt", "ReplyDispatcher.kt")) {
+            assertTrue(gone, sources.none { it.name == gone })
+        }
+        // What an earlier build saved is only read where it is stored and turned off once.
+        assertEquals(listOf("data/repository/SettingsRepository.kt"), users("autoReplyConfig"))
+        assertEquals(emptyList<String>(), users("updateAutoReplyConfig"))
+    }
+
+    /** The saved rows once there are [count] of them; the listener saves on its own thread. */
+    private fun savedRows(count: Int): List<com.opendroid.ai.data.db.entities.NotificationEntity> {
+        val until = System.currentTimeMillis() + WAIT_MS
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            val rows = runBlocking(Dispatchers.IO) { database.notificationDao().getRecentNotifications() }
+            if (rows.size >= count || System.currentTimeMillis() > until) return rows
+            Thread.sleep(20)
+        }
+    }
+
+    private fun messageFrom(packageName: String, from: String, text: String, address: String? = null): StatusBarNotification {
+        val me = Person.Builder().setName("Me").build()
+        val sender = Person.Builder().setName(from).build()
+        val style = NotificationCompat.MessagingStyle(me).addMessage(text, 1_000L, sender)
+        val reply = PendingIntent.getBroadcast(context, 0, Intent(REPLY_ACTION), PendingIntent.FLAG_MUTABLE)
+        val notification = NotificationCompat.Builder(context, "messages")
+            .setSmallIcon(android.R.drawable.ic_dialog_info)
+            .setContentTitle(from)
+            .setContentText(text)
+            .setCategory(if (address != null) Notification.CATEGORY_EMAIL else Notification.CATEGORY_MESSAGE)
+            .setStyle(style)
+            .addAction(
+                NotificationCompat.Action.Builder(0, "Reply", reply)
+                    .addRemoteInput(RemoteInput.Builder("text").build())
+                    .build()
+            )
+            .build()
+        address?.let { notification.extras.putCharSequence(Notification.EXTRA_INFO_TEXT, it) }
+        // Posted now: the history keeps 30 days and drops anything older as it is saved.
+        @Suppress("DEPRECATION")
+        return StatusBarNotification(
+            packageName, packageName, 1, from, 10_123, 0, 0,
+            notification, Process.myUserHandle(), System.currentTimeMillis()
+        )
+    }
+
+    private companion object {
+        const val REPLY_ACTION = "com.example.REPLY"
+        const val WAIT_MS = 5_000L
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/service/OwnTimeWorkerTest.kt b/app/src/test/java/com/opendroid/ai/core/service/OwnTimeWorkerTest.kt
new file mode 100644
index 0000000..c1ddc6a
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/service/OwnTimeWorkerTest.kt
@@ -0,0 +1,195 @@
+package com.opendroid.ai.core.service
+
+import com.opendroid.ai.core.agent.waitWithoutCancelling
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * The alarm for her own time: one piece of scheduled work that runs once, at the time
+ * she named, and is set again from what is stored. Nothing repeats by itself.
+ */
+class OwnTimeWorkerTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private val worker = File(main, "core/service/OwnTimeWorker.kt").readText()
+    private val service = File(main, "core/service/OpenDroidService.kt").readText()
+
+    @Test
+    fun `her moment is woken by work that runs once at her time, and nothing checks on a schedule any more`() {
+        // No repeating work anywhere in the app's own sources looks whether it is time for her.
+        val repeating = main.walkTopDown().filter { it.isFile && it.extension == "kt" }
+            .filter { it.readText().contains("PeriodicWorkRequestBuilder<") }
+            .map { it.name }.toList()
+        assertEquals(emptyList<String>(), repeating.filter { it.contains("OwnTime") || it.contains("CheckIn") || it.contains("Persona") })
+        assertFalse(File(main, "core/service/CheckInWorker.kt").exists())
+        assertFalse(worker.contains("Periodic"))
+
+        val arm = worker.substringAfter("fun arm(").substringBefore("\n        }\n")
+        assertTrue(arm.contains("OneTimeWorkRequestBuilder<OwnTimeWorker>()"))
+        assertTrue(arm.contains(".setInitialDelay(delayMillis(atMillis, nowMillis, notBefore), TimeUnit.MILLISECONDS)"))
+        // One alarm under one name, put in the place of whatever was set before; null takes it off.
+        assertTrue(arm.contains("workManager.enqueueUniqueWork(WORK_NAME, ExistingWorkPolicy.REPLACE, request)"))
+        assertTrue(arm.contains("workManager.cancelUniqueWork(WORK_NAME)"))
+        // No network is asked for (her model may run on the phone), and no exact alarm or new permission.
+        for (never in listOf("Constraints", "setRequiredNetworkType", "AlarmManager", "setExact", "setExpedited")) {
+            assertFalse(never, worker.contains(never))
+        }
+        // It asks the system for nothing the app did not already have: the build's own diff leaves the manifest alone.
+        assertFalse(File("src/main/AndroidManifest.xml").readText().contains("OwnTimeWorker"))
+        // The old repeating check ran under the same name, so the first alarm replaces it.
+        assertEquals("opendroid_persona_check_in", OwnTimeWorker.WORK_NAME)
+    }
+
+    @Test
+    fun `a time that has passed is due at once, and a time ahead is waited for`() {
+        assertEquals(0L, OwnTimeWorker.delayMillis(atMillis = 1_000, nowMillis = 5_000))
+        assertEquals(0L, OwnTimeWorker.delayMillis(atMillis = 5_000, nowMillis = 5_000))
+        assertEquals(20 * 60_000L, OwnTimeWorker.delayMillis(atMillis = 5_000 + 20 * 60_000L, nowMillis = 5_000))
+    }
+
+    @Test
+    fun `after a run the work never runs again at once, whatever time is stored`() {
+        // A stored time that stays in the past would otherwise set the alarm to now, run after run.
+        assertEquals(60_000L, OwnTimeWorker.delayMillis(atMillis = 1_000, nowMillis = 5_000, earliest = 65_000))
+        // A time later than the pause is not touched by it.
+        assertEquals(600_000L, OwnTimeWorker.delayMillis(atMillis = 605_000, nowMillis = 5_000, earliest = 65_000))
+        assertEquals(60_000L, OwnTimeWorker.AFTER_RUN_MILLIS)
+        assertEquals(15 * 60_000L, OwnTimeWorker.AFTER_FAILURE_MILLIS)
+
+        val work = worker.substringAfter("override suspend fun doWork(): Result {").substringBefore("companion object {")
+        // The pause is set when the run ends, before the alarm is set again, and is the long one after an error.
+        val pause = work.indexOf("notBefore = System.currentTimeMillis() + if (failed) AFTER_FAILURE_MILLIS else AFTER_RUN_MILLIS")
+        assertTrue(pause >= 0)
+        assertTrue(pause < work.indexOf("entryPoint().agentLoop().armOwnTime()"))
+        assertTrue(work.substringAfter("} catch (e: Exception) {").startsWith("\n            failed = true"))
+        // The switch in Settings is his own doing and does not wait for it.
+        val look = worker.substringAfter("fun lookNow(context: Context) {").substringBefore("arm(context, System.currentTimeMillis())")
+        assertTrue(look.contains("notBefore = 0L"))
+    }
+
+    @Test
+    fun `the work lets her have the moment, shows what she marked for him, and sets the alarm again when it is over`() {
+        val work = worker.substringAfter("override suspend fun doWork(): Result {").substringBefore("companion object {")
+        val moment = work.indexOf("entryPoint.agentLoop().personaOwnTime(applicationContext)")
+        val waits = work.indexOf("entryPoint.agentLoop().awaitCheckInAction(ACTION_WAIT_MILLIS)")
+        val shown = work.indexOf("OpenDroidService.showCheckInNotification(applicationContext, line, showText, commandMark)")
+        val plan = work.indexOf("OpenDroidService.showOwnTimePlanNotification(applicationContext)")
+        val armed = work.indexOf("entryPoint().agentLoop().armOwnTime()")
+        assertTrue(moment >= 0)
+        // Her line is shown once the command she wrote with it has run its course, with what the
+        // loop knows of that command by then, so that her line is not all he reads about it.
+        assertTrue(waits > moment)
+        assertTrue(shown > waits)
+        assertTrue(work.indexOf("val commandMark = entryPoint.agentLoop().ownTimeCommandMark()") in waits until shown)
+        // It is shown whatever ended the wait: a line she wrote is not lost with a wait that was cut short.
+        assertTrue(work.substring(waits, shown).contains("} finally {"))
+        assertTrue(plan > shown)
+        assertTrue(armed > plan)
+        // The notification follows the owner's choice about showing her words, read before the wait.
+        assertTrue(work.indexOf("llmConfig.first().checkInShowsText") in moment until waits)
+        // A plan of hers is announced by a notification only when one waits for his yes, and never while she sleeps.
+        assertTrue(work.contains("if (entryPoint.agentLoop().ownTimePlanAwaitsYes() && !entryPoint.agentLoop().personaAsleep()) {"))
+        // The alarm is set again whatever became of the moment: after the block that can fail.
+        assertTrue(armed > work.lastIndexOf("} finally {"))
+        // Setting the alarm replaces the scheduled work, so while a moment is being had it does nothing.
+        assertTrue(work.indexOf("inMoment.set(true)") in 0 until moment)
+        // It is the first thing the work does.
+        assertTrue(work.trimStart().startsWith("// Before anything else: from here on the alarm must not be set by anyone but this work.\n        inMoment.set(true)"))
+        assertTrue(work.indexOf("inMoment.set(false)") in waits until armed)
+        assertTrue(worker.substringAfter("fun arm(").startsWith("context: Context, atMillis: Long?, nowMillis: Long = System.currentTimeMillis()) {\n            if (inMoment.get()) return"))
+        // Inside the time the system allows scheduled work.
+        assertTrue(OwnTimeWorker.ACTION_WAIT_MILLIS in 60_000L..9 * 60_000L)
+        // A failure is logged by its kind only.
+        for (line in worker.lines().filter { it.contains("Log.") }) assertTrue(line, line.contains("\${e.javaClass.simpleName}\")"))
+        // The worker stays outside her package, like every caller but the loop and the service.
+        assertFalse(worker.contains("core.persona."))
+    }
+
+    @Test
+    fun `the persona is handed the alarm, and the service sets it from what is stored when it starts`() {
+        val module = File(main, "di/OwnTimeModule.kt").readText()
+        assertTrue(module.contains("fun provideOwnTimeAlarm(@ApplicationContext context: Context): OwnTimeAlarm = OwnTimeAlarm { atMillis ->"))
+        assertTrue(module.contains("OwnTimeWorker.arm(context, atMillis)"))
+        // The service has no timer of its own: it asks for the alarm to be set and nothing else.
+        assertFalse(service.contains("delay("))
+        assertFalse(service.contains("personaOwnTime("))
+        assertTrue(service.contains("applyOwnTimeSchedule(persona.ownTimeIsOn(config))"))
+        val apply = service.substringAfter("private fun applyOwnTimeSchedule(").substringBefore("// Only Speaking resets to Idle")
+        assertTrue(apply.contains("if (ownTimeWanted == wanted) return"))
+        assertTrue(apply.contains("agentLoop.armOwnTime()"))
+
+        val loop = File(main, "core/agent/AgentLoop.kt").readText()
+        val arm = loop.substringAfter("suspend fun armOwnTime() {").substringBefore("\n    }\n")
+        // Whether he has talked to her is asked of the chat.
+        assertTrue(arm.contains("persona.armOwnTime {"))
+        assertTrue(arm.contains("any { it.sender == ChatMessage.Sender.USER }"))
+        // Asked without making a chat: a phone he has never written on stays as it is.
+        assertTrue(arm.contains("conversationRepository.currentSessionId.first() ?: return@armOwnTime false"))
+        assertFalse(arm.contains("ensureCurrentSessionId"))
+    }
+
+    @Test
+    fun `switching her own time in Settings sets the alarm right away, with or without the voice service`() {
+        // The work is run once, now: it reads what is stored and sets the alarm when it ends, or takes it off.
+        val look = worker.substringAfter("fun lookNow(context: Context) {").substringBefore("\n        }\n")
+        assertTrue(look.contains("arm(context, System.currentTimeMillis())"))
+        assertTrue(look.contains("} catch (e: Exception) {"))
+        val model = File(main, "ui/viewmodel/SettingsViewModel.kt").readText()
+        for (switch in listOf("fun updatePersonaCheckIns(", "fun updatePersonaOwnTimeMaxPerDay(")) {
+            val body = model.substringAfter(switch).substringBefore("\n    }\n")
+            // After the setting is saved, so the work reads the new one.
+            assertTrue(switch, body.indexOf("configSaver.save(") in 0 until body.indexOf("com.opendroid.ai.core.service.OwnTimeWorker.lookNow(context)"))
+        }
+        // The service is not the only thing that sets the alarm: every change of the stored time does.
+        val engine = File(main, "core/persona/PersonaEngine.kt").readText()
+        assertEquals(7, Regex("""ownTimeAlarm\.set\(""").findAll(engine).count())
+        for (changes in listOf(
+            "suspend fun armOwnTime(", "suspend fun ownTimeAfterReply(", "suspend fun putOffOwnTime(", "suspend fun ownTimeOnUnlock(",
+            "suspend fun ownTimeOnHearingHim(", "suspend fun ownMoment(", "suspend fun outingCameBack("
+        )) {
+            val next = engine.substringAfter(changes).substringBefore("\n    /**")
+            assertTrue(changes, next.contains("ownTimeAlarm.set("))
+        }
+    }
+
+    @Test
+    fun `the work stays until a command she wrote has run, and never stops it`() {
+        val loop = File(main, "core/agent/AgentLoop.kt").readText()
+        val action = loop.substringAfter("private fun startCheckInAction(").substringBefore("private suspend fun runPersonaAction(")
+        assertTrue(action.contains("checkInAction = job"))
+        val await = loop.substringAfter("suspend fun awaitCheckInAction(").substringBefore("private fun startCheckInAction(")
+        assertTrue(await.contains("waitWithoutCancelling(checkInAction, timeoutMillis)"))
+        assertFalse(await.contains(".cancel()"))
+    }
+
+    @Test
+    fun `waiting for a job ends with the job or with the time, and leaves the job running`() = runBlocking {
+        assertTrue(waitWithoutCancelling(null, timeoutMillis = 5_000))
+
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        try {
+            val quick = scope.launch { delay(20) }
+            assertTrue(waitWithoutCancelling(quick, timeoutMillis = 5_000))
+            assertTrue(quick.isCompleted)
+
+            // A command that waits for his answer does not end by itself.
+            val endless = scope.launch { awaitCancellation() }
+            assertFalse(waitWithoutCancelling(endless, timeoutMillis = 50))
+            assertTrue(endless.isActive)
+            assertFalse(endless.isCancelled)
+        } finally {
+            scope.cancel()
+        }
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/service/ServiceNotificationTextTest.kt b/app/src/test/java/com/opendroid/ai/core/service/ServiceNotificationTextTest.kt
new file mode 100644
index 0000000..2a365d3
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/service/ServiceNotificationTextTest.kt
@@ -0,0 +1,142 @@
+package com.opendroid.ai.core.service
+
+import com.opendroid.ai.core.voice.WakeWordMatcher
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The permanent notification carries her name when she is the one who talks, and then
+ * it says only what is true: which wake phrases are listened for while they are, and
+ * otherwise that the app is running. A build that runs as stock keeps the stock text.
+ */
+class ServiceNotificationTextTest {
+
+    @Test
+    fun `a build that runs as stock keeps the stock notification word for word`() {
+        val stock = ServiceNotificationText.of(herName = null, listening = true, phrases = WakeWordMatcher.STOCK_PHRASES)
+        assertEquals("OpenDroid Active", stock.title)
+        assertEquals("Listening for wake word 'OpenDroid'", stock.line)
+        assertEquals(stock, ServiceNotificationText.of(herName = null, listening = false, phrases = emptyList()))
+    }
+
+    @Test
+    fun `with her on it is titled with her name and names the phrases that are really listened for`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = true)
+        val text = ServiceNotificationText.of(herName = "Yume", listening = true, phrases = phrases)
+
+        assertEquals("Yume", text.title)
+        assertEquals("Listening for \"hey yume\", \"hey yumi\", \"hey yumei\" and ${phrases.size - 3} more", text.line)
+        // Opened, the notification names every one of them.
+        for (phrase in phrases) assertTrue(phrase, text.full.contains("\"$phrase\""))
+        assertFalse(text.title.contains("OpenDroid"))
+        assertFalse(text.line.contains("OpenDroid"))
+    }
+
+    @Test
+    fun `the owner's own phrases are named along with the built-in ones they are added to`() {
+        val heard = WakeWordMatcher.resolve("oi kisaragi, wake up", personaEnabled = true)
+        val text = ServiceNotificationText.of(herName = "Yume", listening = true, phrases = heard)
+        // His phrases never take a built-in one away, so both are listened for and both are named.
+        assertTrue(text.full.contains("\"oi kisaragi\""))
+        assertTrue(text.full.contains("\"wake up\""))
+        assertTrue(text.full.contains("\"hey yume\""))
+        assertTrue(text.line, text.line.endsWith(" and ${heard.size - 3} more"))
+    }
+
+    @Test
+    fun `when nothing is listened for it says only that the app is running`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = true)
+        // The floating button is on, a command is being taken down, the microphone is
+        // not granted or the phone has no recogniser: the detector says it hears nothing.
+        val idle = ServiceNotificationText.of(herName = "Yume", listening = false, phrases = phrases)
+        assertEquals("Yume", idle.title)
+        assertEquals("The app is running.", idle.line)
+        assertEquals(idle.line, idle.full)
+        assertFalse(idle.full.contains("hey yume"))
+        // No phrases means there is nothing it could be listening for.
+        assertEquals("The app is running.", ServiceNotificationText.of("Yume", listening = true, phrases = emptyList()).line)
+    }
+
+    @Test
+    fun `the service words it from what the detector hears, and builds it again when that or her card changes`() {
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        val build = service.substringAfter("private fun createNotification(): Notification {")
+            .substringBefore("private fun refreshNotification()")
+        // Not worked out from the settings and the permission as they stood at some earlier moment.
+        assertTrue(build.contains("listening = detector?.isHearing == true"))
+        assertFalse(build.contains("RECORD_AUDIO"))
+        assertFalse(build.contains("showFloatingButton"))
+        // Built again whenever the detector starts or stops hearing: a command being taken
+        // down, the microphone granted later, a phone with no recogniser.
+        assertTrue(service.contains("wakeWordDetector.onHearingChanged = { refreshNotification() }"))
+        // And whenever a card is saved or removed, which touches no setting.
+        assertTrue(service.contains("settingsRepository.llmConfig.combine(persona.active) { config, _ -> config }.collectLatest { config ->"))
+    }
+
+    @Test
+    fun `before the settings are read it carries the app's name and claims nothing`() {
+        val text = ServiceNotificationText.starting("OpenDroid")
+        assertEquals("OpenDroid", text.title)
+        // No line at all: neither her wording on a build that will run as stock, nor
+        // the stock line about listening under her name.
+        assertEquals("", text.line)
+        assertEquals("", text.full)
+    }
+
+    @Test
+    fun `a build that runs as stock says so too when the wake word cannot be heard offline`() {
+        // Stock went on to the online recogniser here and this build does not. Left as
+        // "Listening for wake word 'OpenDroid'", the notification would claim a listening
+        // that is not happening, and nothing else would tell him why saying it does nothing.
+        val phrases = WakeWordMatcher.STOCK_PHRASES
+        val text = ServiceNotificationText.of(herName = null, listening = false, phrases = phrases, cannotHearOffline = true)
+
+        assertEquals("OpenDroid Active", text.title)
+        assertEquals(ServiceNotificationText.WAKE_OFFLINE_UNAVAILABLE_LINE, text.line)
+        assertTrue(text.full.startsWith(text.line))
+        assertTrue(text.full.endsWith(com.opendroid.ai.core.voice.PreferredRecognizer.OFFLINE_REMEDY))
+        assertFalse(text.full.contains("Listening for"))
+
+        // In every other case the stock notification stands word for word: while a round
+        // listens, and while nothing is listened for and no such reason was reported.
+        assertEquals(
+            ServiceNotificationText.STOCK,
+            ServiceNotificationText.of(herName = null, listening = true, phrases = phrases, cannotHearOffline = true)
+        )
+        assertEquals(
+            ServiceNotificationText.STOCK,
+            ServiceNotificationText.of(herName = null, listening = false, phrases = phrases, cannotHearOffline = false)
+        )
+        assertEquals(
+            ServiceNotificationText.STOCK,
+            ServiceNotificationText.of(herName = null, listening = false, phrases = emptyList(), cannotHearOffline = true)
+        )
+    }
+
+    @Test
+    fun `when the wake phrases go unheard because the phone cannot hear offline it says so and how to change that`() {
+        val phrases = WakeWordMatcher.resolve("", personaEnabled = true)
+        val text = ServiceNotificationText.of(herName = "Yume", listening = false, phrases = phrases, cannotHearOffline = true)
+
+        assertEquals("Yume", text.title)
+        assertEquals(
+            "Not listening for the wake phrases: this phone cannot turn speech into text offline in your language.",
+            text.line
+        )
+        // Opened, it says how the offline language is got and why the online recogniser is not used.
+        assertTrue(text.full.startsWith(text.line))
+        assertTrue(text.full.endsWith(com.opendroid.ai.core.voice.PreferredRecognizer.OFFLINE_REMEDY))
+        assertFalse(text.full.contains("Listening for"))
+
+        // Once a round has listened again the reason is gone, whatever was reported before.
+        val heard = ServiceNotificationText.of(herName = "Yume", listening = true, phrases = phrases, cannotHearOffline = true)
+        assertTrue(heard.line.startsWith("Listening for \"hey yume\""))
+        // With nothing to listen for there is nothing that goes unheard.
+        assertEquals("The app is running.", ServiceNotificationText.of("Yume", false, emptyList(), cannotHearOffline = true).line)
+        // The service hands over what the detector says.
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        assertTrue(service.contains("cannotHearOffline = detector?.cannotHearOffline == true"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt b/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt
new file mode 100644
index 0000000..6f37e74
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/util/CleartextGuardTest.kt
@@ -0,0 +1,296 @@
+package com.opendroid.ai.core.util
+
+import com.opendroid.ai.di.AppModule
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.net.Socket
+import java.net.SocketAddress
+import java.net.UnknownServiceException
+import javax.net.SocketFactory
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.Dns
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.tls.HandshakeCertificates
+import okhttp3.tls.HeldCertificate
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The platform no longer blocks plain http, so the app's own HTTP client has to: only
+ * the owner's own hardware is spoken to without TLS.
+ */
+class CleartextGuardTest {
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+
+    // Every name resolves to this machine, so a "public" host can be asked for without
+    // leaving it. Whether plain http may be tried at all is judged from the name as written.
+    private val everythingIsLocal = Dns { listOf(InetAddress.getByName("127.0.0.1")) }
+
+    // No proxy unless a test sets one: the machine the tests run on may have its own.
+    // The lookups are the tests' own, behind the same choice of addresses the app makes.
+    private val client = AppModule.provideOkHttpClient().newBuilder()
+        .dns(HisAddressesOnly(everythingIsLocal)).proxy(Proxy.NO_PROXY).build()
+
+    // A network that is not his: every name is answered with an address out on the
+    // internet (one reserved for documentation). The sockets still end at the test server,
+    // so what is asserted is what a machine at that address would have been sent.
+    private val elsewhere = InetAddress.getByName("203.0.113.7")
+    private val everythingIsElsewhere = Dns { listOf(elsewhere) }
+    private var socketsOpened = 0
+    private val landsOnTheTestServer = object : SocketFactory() {
+        override fun createSocket(): Socket = object : Socket() {
+            override fun connect(endpoint: SocketAddress?, timeout: Int) {
+                socketsOpened++
+                super.connect(InetSocketAddress(InetAddress.getByName("127.0.0.1"), server.port), timeout)
+            }
+        }
+        override fun createSocket(host: String?, port: Int): Socket = throw UnsupportedOperationException()
+        override fun createSocket(host: String?, port: Int, localHost: InetAddress?, localPort: Int): Socket =
+            throw UnsupportedOperationException()
+        override fun createSocket(host: InetAddress?, port: Int): Socket = throw UnsupportedOperationException()
+        override fun createSocket(address: InetAddress?, port: Int, localAddress: InetAddress?, localPort: Int): Socket =
+            throw UnsupportedOperationException()
+    }
+    private val onAnotherNetwork = AppModule.provideOkHttpClient().newBuilder()
+        .dns(HisAddressesOnly(everythingIsElsewhere)).socketFactory(landsOnTheTestServer).proxy(Proxy.NO_PROXY).build()
+
+    // The same network with the app's check of the looked-up addresses taken out, so that
+    // a connection is opened and the check made on the connection is the one that answers.
+    private val onAnotherNetworkUnchecked = onAnotherNetwork.newBuilder().dns(everythingIsElsewhere).build()
+
+    @After
+    fun tearDown() {
+        server.close()
+    }
+
+    @Test
+    fun `the guard is on the shared client, for requests and for redirects`() {
+        val shared = AppModule.provideOkHttpClient()
+        assertTrue(shared.interceptors.contains(CleartextGuard))
+        assertTrue(shared.networkInterceptors.contains(CleartextGuard))
+        assertTrue("names are looked up through the choice of his addresses", shared.dns is HisAddressesOnly)
+    }
+
+    @Test
+    fun `plain http is allowed to the phone itself and to private addresses only`() {
+        for (own in listOf(
+            "http://127.0.0.1:11434/v1", "http://localhost:8080", "http://10.0.2.2:11434", "http://192.168.1.50:11434/v1",
+            "http://172.16.0.9", "http://100.100.1.1:8080", "http://gaming-pc:1234/v1", "http://pc.lan/v1",
+            "http://nas.home.arpa", "http://box.tailnet-abc.ts.net", "http://[::1]:8080/v1", "http://[fd12:3456::1]:8080"
+        )) {
+            assertTrue(own, CleartextGuard.allows(own.toHttpUrl()))
+        }
+        for (public in listOf(
+            "http://api.venice.ai/api/v1", "http://example.com", "http://8.8.8.8", "http://172.32.0.1",
+            "http://192.169.1.1", "http://100.63.0.1", "http://[2001:db8::1]/v1", "http://api.openai.com/v1/models"
+        )) {
+            assertFalse(public, CleartextGuard.allows(public.toHttpUrl()))
+        }
+    }
+
+    @Test
+    fun `https is allowed anywhere`() {
+        assertTrue(CleartextGuard.allows("https://api.venice.ai/api/v1".toHttpUrl()))
+        assertTrue(CleartextGuard.allows("https://example.com".toHttpUrl()))
+    }
+
+    @Test
+    fun `the shared client reaches a local server over plain http`() {
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+
+        client.newCall(Request.Builder().url(server.url("/v1/models")).build()).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+    }
+
+    @Test
+    fun `the shared client refuses plain http to a public host before connecting`() {
+        val request = Request.Builder()
+            .url("http://api.example.com:${server.port}/v1/models")
+            .header("Authorization", "Bearer sk-test-0123456789abcdef")
+            .build()
+
+        val failure = assertThrows(UnknownServiceException::class.java) { client.newCall(request).execute() }
+
+        assertEquals("nothing may be sent, the key least of all", 0, server.requestCount)
+        assertFalse("the address stays out of the message", failure.message.orEmpty().contains("example"))
+    }
+
+    @Test
+    fun `a redirect to plain http on a public host is not followed`() {
+        server.enqueue(
+            MockResponse.Builder().code(302)
+                .setHeader("Location", "http://elsewhere.example.com:${server.port}/collect")
+                .build()
+        )
+        server.enqueue(MockResponse.Builder().code(200).body("should never be asked for").build())
+
+        assertThrows(UnknownServiceException::class.java) {
+            client.newCall(Request.Builder().url(server.url("/v1/models")).build()).execute()
+        }
+        assertEquals("only the first request was written", 1, server.requestCount)
+    }
+
+    // ── A name is not an address ─────────────────────────────────────────────────────
+
+    private fun keyed(url: String) = Request.Builder()
+        .url(url)
+        .header("Authorization", "Bearer sk-test-0123456789abcdef")
+        .post("his date of birth, her notes about him".toRequestBody())
+        .build()
+
+    @Test
+    fun `a private name that leads to a private machine is spoken to`() {
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+
+        client.newCall(keyed("http://homeserver.lan:${server.port}/v1/chat/completions")).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+        assertEquals(1, server.requestCount)
+    }
+
+    @Test
+    fun `a private name that leads somewhere else is refused before anything is written`() {
+        for (name in listOf("homeserver", "mypc.lan", "desktop.local", "box.tailnet-abc.ts.net", "nas.home.arpa", "localhost")) {
+            val failure = assertThrows(AddressLedElsewhereException::class.java) {
+                onAnotherNetwork.newCall(keyed("http://$name:${server.port}/v1/chat/completions")).execute()
+            }
+            assertFalse("the address stays out of the message", failure.message.orEmpty().contains(name))
+        }
+        assertEquals("no request line, no key, no body", 0, server.requestCount)
+        assertEquals("and no connection to a machine that is not his", 0, socketsOpened)
+    }
+
+    @Test
+    fun `a connection that reached another machine under a private name is closed unwritten`() {
+        // The second line: where the lookup was not the app's to choose from, the machine
+        // the connection reached is looked at before anything is written to it.
+        for (name in listOf("homeserver", "desktop.local", "localhost")) {
+            assertThrows(AddressLedElsewhereException::class.java) {
+                onAnotherNetworkUnchecked.newCall(keyed("http://$name:${server.port}/v1/chat/completions")).execute()
+            }
+        }
+        assertEquals("a connection was opened each time", 3, socketsOpened)
+        assertEquals("no request line, no key, no body", 0, server.requestCount)
+    }
+
+    @Test
+    fun `his machine is reached at its private address when its name has a public one too`() {
+        // At home: the name of his computer is answered with the global IPv6 address his
+        // internet provider gave it, and with its private address. The public one comes first.
+        val global = InetAddress.getByName("2001:db8:1:2::20")
+        val private = InetAddress.getByName("192.168.1.20")
+        val bothAddresses = Dns { listOf(global, private, elsewhere) }
+        assertEquals(listOf(private), HisAddressesOnly(bothAddresses).lookup("desktop.local"))
+        assertEquals(listOf(private), HisAddressesOnly(bothAddresses).lookup("gaming-pc"))
+
+        val atHome = AppModule.provideOkHttpClient().newBuilder()
+            .dns(HisAddressesOnly(bothAddresses)).socketFactory(landsOnTheTestServer).proxy(Proxy.NO_PROXY).build()
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+
+        atHome.newCall(keyed("http://desktop.local:${server.port}/api/chat")).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+        assertEquals(1, server.requestCount)
+        assertEquals("one connection, to the private address", 1, socketsOpened)
+    }
+
+    @Test
+    fun `only names that read as his are chosen for, and one with no private address is refused`() {
+        val global = InetAddress.getByName("2001:db8:1:2::20")
+        val mixed = Dns { listOf(global, InetAddress.getByName("10.0.0.5"), InetAddress.getByName("fd12:3456::1"), elsewhere) }
+
+        // A public name is handed on as it was looked up, private addresses and all.
+        assertEquals(4, HisAddressesOnly(mixed).lookup("api.example.com").size)
+        assertEquals(
+            listOf("10.0.0.5", "fd12:3456:0:0:0:0:0:1"),
+            HisAddressesOnly(mixed).lookup("nas.home.arpa").map { it.hostAddress }
+        )
+        assertEquals(listOf(InetAddress.getByName("127.0.0.1")), HisAddressesOnly(everythingIsLocal).lookup("localhost"))
+        for (name in listOf("homeserver", "pc.lan", "localhost")) {
+            assertThrows(AddressLedElsewhereException::class.java) { HisAddressesOnly(Dns { listOf(global, elsewhere) }).lookup(name) }
+        }
+        // A name that cannot be looked up fails as it always did.
+        assertThrows(java.net.UnknownHostException::class.java) {
+            HisAddressesOnly(Dns { throw java.net.UnknownHostException("no such name") }).lookup("homeserver")
+        }
+    }
+
+    @Test
+    fun `the same holds over https, where the name still reads as his own network`() {
+        val certificate = HeldCertificate.Builder().addSubjectAlternativeName("homeserver.lan").build()
+        server.useHttps(HandshakeCertificates.Builder().heldCertificate(certificate).build().sslSocketFactory())
+        val trusting = HandshakeCertificates.Builder().addTrustedCertificate(certificate.certificate).build()
+        fun secure(base: okhttp3.OkHttpClient) = base.newBuilder()
+            .sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager).build()
+
+        assertThrows(AddressLedElsewhereException::class.java) {
+            secure(onAnotherNetwork).newCall(keyed("https://homeserver.lan:${server.port}/v1/chat/completions")).execute()
+        }
+        assertEquals(0, server.requestCount)
+
+        // At home the name leads to his machine, and the request goes through.
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+        secure(client).newCall(keyed("https://homeserver.lan:${server.port}/v1/chat/completions")).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+    }
+
+    @Test
+    fun `a public name over https is not held to this, wherever it leads`() {
+        val certificate = HeldCertificate.Builder().addSubjectAlternativeName("api.example.com").build()
+        server.useHttps(HandshakeCertificates.Builder().heldCertificate(certificate).build().sslSocketFactory())
+        val trusting = HandshakeCertificates.Builder().addTrustedCertificate(certificate.certificate).build()
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+
+        onAnotherNetwork.newBuilder().sslSocketFactory(trusting.sslSocketFactory(), trusting.trustManager).build()
+            .newCall(keyed("https://api.example.com:${server.port}/v1/chat/completions")).execute().use { response ->
+                assertEquals("ok", response.body.string())
+            }
+    }
+
+    @Test
+    fun `a proxy set on the phone does not get what was meant for his own machine`() {
+        // A proxy out on the internet, asked for a private address written in numbers.
+        val throughAPublicProxy = onAnotherNetwork.newBuilder()
+            .proxy(Proxy(Proxy.Type.HTTP, InetSocketAddress(elsewhere, server.port))).build()
+        assertThrows(AddressLedElsewhereException::class.java) {
+            throughAPublicProxy.newCall(keyed("http://192.168.1.20:11434/v1/chat/completions")).execute()
+        }
+        // A proxy on this machine, asked for a name: it is the proxy that would look the name up.
+        val throughALocalProxy = client.newBuilder()
+            .proxy(Proxy(Proxy.Type.HTTP, InetSocketAddress(InetAddress.getByName("127.0.0.1"), server.port))).build()
+        assertThrows(AddressLedElsewhereException::class.java) {
+            throughALocalProxy.newCall(keyed("http://homeserver.lan/v1/chat/completions")).execute()
+        }
+        assertEquals(0, server.requestCount)
+
+        // The same proxy asked for a private address in numbers is a machine of his on his network.
+        server.enqueue(MockResponse.Builder().code(200).body("ok").build())
+        throughALocalProxy.newCall(keyed("http://192.168.1.20:11434/v1/chat/completions")).execute().use { response ->
+            assertEquals("ok", response.body.string())
+        }
+    }
+
+    @Test
+    fun `only an address on this phone or a private one counts as his, and none at all does not`() {
+        fun address(text: String) = InetAddress.getByName(text)
+        for (his in listOf("127.0.0.1", "10.0.2.2", "192.168.1.20", "172.16.0.9", "172.31.255.1", "169.254.1.1", "100.100.1.1", "::1", "fd12:3456::1", "fe80::1")) {
+            assertTrue(his, CleartextGuard.staysHis(listOf(address(his))))
+        }
+        for (other in listOf("203.0.113.7", "8.8.8.8", "172.32.0.1", "192.169.1.1", "100.63.0.1", "100.128.0.1", "2001:db8::1", "0.0.0.0")) {
+            assertFalse(other, CleartextGuard.staysHis(listOf(address(other))))
+        }
+        assertFalse("one of two is not enough", CleartextGuard.staysHis(listOf(address("192.168.1.20"), address("203.0.113.7"))))
+        assertFalse("nothing known is nothing proved", CleartextGuard.staysHis(emptyList()))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/ListenForTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/ListenForTest.kt
new file mode 100644
index 0000000..2bfc1b4
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/voice/ListenForTest.kt
@@ -0,0 +1,147 @@
+package com.opendroid.ai.core.voice
+
+import com.opendroid.ai.core.agent.AgentState
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStatus
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * While a plan waits for his answer, a microphone that opens listens for that answer,
+ * however it was opened. Opened for a new request instead, as the floating button used
+ * to do, his "approve" arrived as a chat message and withdrew the plan it was meant to run.
+ */
+class ListenForTest {
+
+    private fun proposed(id: String) = AgentState.PlanProposed(
+        Plan(
+            planId = id,
+            goal = "tell the beekeeper the hives are ready",
+            estimatedDuration = "1m",
+            estimatedSteps = 0,
+            steps = emptyList(),
+            status = PlanStatus.PROPOSED
+        )
+    )
+
+    @Test
+    fun `while a plan waits, his answer to that plan is what is listened for`() {
+        assertEquals(ListenFor.Answer("p1"), ListenFor.whileIn(proposed("p1")))
+        assertEquals(ListenFor.Answer("p2"), ListenFor.whileIn(proposed("p2")))
+    }
+
+    @Test
+    fun `in every other state it is a new request`() {
+        for (state in listOf(
+            AgentState.Idle,
+            AgentState.Listening,
+            AgentState.Thinking,
+            AgentState.ExecutingPlan("Open the hive log"),
+            AgentState.Speaking("the second hive is up"),
+            AgentState.Error("boom")
+        )) {
+            assertEquals(state.toString(), ListenFor.Request, ListenFor.whileIn(state))
+        }
+    }
+
+    @Test
+    fun `the floating button and the wake phrase open the microphone the same way`() {
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+
+        // One function decides, from the state the loop is in at that moment.
+        val open = service.substringAfter("private fun openMicrophoneForHim() {").substringBefore("\n    }\n")
+        assertTrue(open.contains("val state = agentLoop.agentState.value"))
+        assertTrue(open.contains("ListenFor.whileIn(state)"))
+        assertTrue(open.contains("startListeningForApproval(listenFor.planId, otherwiseARequest = true)"))
+        assertTrue(open.contains("ListenFor.Request -> startListeningForQuery()"))
+
+        // The wake reply's end and a tap on the button both go through it.
+        assertTrue(service.contains("openMicrophone = { openMicrophoneForHim() },"))
+        val tap = service.substringAfter("if (intent?.action == ACTION_TRIGGER_RECORD) {").substringBefore("return START_STICKY")
+        assertTrue(tap.contains("openMicrophoneForHim()"))
+        assertFalse("a tap must not listen for a request over a waiting plan", tap.contains("startListeningForQuery()"))
+        // The prompt that is being said ends in "approve or cancel": it is cut off before
+        // the microphone opens, or the phone would answer itself.
+        assertTrue(tap.indexOf("textToSpeechEngine.stop()") in 0 until tap.indexOf("openMicrophoneForHim()"))
+        assertTrue(tap.indexOf("approvalListenGate.disarm()") in 0 until tap.indexOf("openMicrophoneForHim()"))
+
+        // Nothing else starts a listen for a request.
+        assertEquals(2, Regex("startListeningForQuery\\(\\)").findAll(service).count())
+    }
+
+    @Test
+    fun `the listen for his answer never puts Listening in the place of the proposal`() {
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        val approval = service.substringAfter("private fun startListeningForApproval(")
+            .substringBefore("override fun onStartCommand(")
+        assertFalse(approval.contains("setAgentState("))
+        // A yes runs the plan that was waiting, a no drops it, anything else is a new request.
+        assertTrue(approval.contains("VoiceApprovalIntent.APPROVE -> agentLoop.approveProposedPlan(this, planId)"))
+        assertTrue(approval.contains("VoiceApprovalIntent.REJECT -> agentLoop.rejectProposedPlan()"))
+        assertTrue(approval.contains("if (otherwiseARequest && !isOwnWakeReply(utterance)) agentLoop.processQuery(utterance, this)"))
+        // What the spoken prompts end on is understood as it is said.
+        assertEquals(VoiceApprovalIntent.APPROVE, VoiceApprovalParser.parse("approve"))
+        assertEquals(VoiceApprovalIntent.REJECT, VoiceApprovalParser.parse("cancel"))
+    }
+
+    @Test
+    fun `the floating button shows listening while the microphone is open for his answer`() {
+        // The listen for his answer leaves the proposal as the loop's state. By that
+        // state alone the button looked the same before and after he tapped it.
+        assertEquals(AgentState.Listening, ListenFor.shownOnButton(proposed("p1"), microphoneOpen = true))
+        assertEquals(proposed("p1"), ListenFor.shownOnButton(proposed("p1"), microphoneOpen = false))
+        // Every other state is shown as it is: a listen for a request sets Listening itself.
+        for (state in listOf(
+            AgentState.Idle,
+            AgentState.Listening,
+            AgentState.Thinking,
+            AgentState.ExecutingPlan("Open the hive log"),
+            AgentState.Speaking("the second hive is up"),
+            AgentState.Error("boom")
+        )) {
+            assertEquals(state.toString(), state, ListenFor.shownOnButton(state, microphoneOpen = true))
+            assertEquals(state.toString(), state, ListenFor.shownOnButton(state, microphoneOpen = false))
+        }
+
+        // The button is drawn from that, when it is put up and whenever either part changes.
+        val button = java.io.File("src/main/java/com/opendroid/ai/accessibility/OpenDroidAccessibilityService.kt").readText()
+        assertTrue(button.contains(".combine(OpenMicrophones.open) { state, open -> ListenFor.shownOnButton(state, open) }"))
+        assertTrue(button.contains("view.updateState(ListenFor.shownOnButton(agentLoop.agentState.value, OpenMicrophones.open.value))"))
+        assertFalse(button.contains("updateState(agentLoop.agentState.value)"))
+        // And the listen for his answer does open a microphone that is counted.
+        val engine = java.io.File("src/main/java/com/opendroid/ai/core/voice/SpeechRecognitionEngine.kt").readText()
+        assertTrue(engine.contains("OpenMicrophones.opened(this)"))
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        val approval = service.substringAfter("private fun startListeningForApproval(")
+            .substringBefore("override fun onStartCommand(")
+        assertTrue(approval.contains("speechRecognitionEngine.startListening("))
+    }
+
+    @Test
+    fun `in the listen he opened himself a request with a no in it is handed on, not taken for his answer`() {
+        // "stop the music" said into the floating button while a plan waits used to turn
+        // the plan down and drop the request.
+        for (request in listOf("stop the music", "cancel my seven o'clock alarm", "tell Sam there is no need to come")) {
+            assertEquals(request, VoiceApprovalIntent.NONE, VoiceApprovalParser.parseAnswerOrRequest(request))
+        }
+        // His answer, said the way the prompt asks for it, is still his answer.
+        assertEquals(VoiceApprovalIntent.APPROVE, VoiceApprovalParser.parseAnswerOrRequest("approve"))
+        assertEquals(VoiceApprovalIntent.REJECT, VoiceApprovalParser.parseAnswerOrRequest("cancel"))
+        assertEquals(VoiceApprovalIntent.REJECT, VoiceApprovalParser.parseAnswerOrRequest("no"))
+
+        val service = java.io.File("src/main/java/com/opendroid/ai/core/service/OpenDroidService.kt").readText()
+        val approval = service.substringAfter("private fun startListeningForApproval(")
+            .substringBefore("override fun onStartCommand(")
+        // The stricter rule is for that listen only; the one-shot listen after the spoken
+        // prompt, where what comes back is an answer, keeps the lenient one.
+        val heard = approval.substringAfter("val heard = if (otherwiseARequest) {").substringBefore("when (heard) {")
+        assertTrue(heard.substringBefore("} else {").contains("VoiceApprovalParser.parseAnswerOrRequest(utterance)"))
+        assertTrue(heard.substringAfter("} else {").contains("VoiceApprovalParser.parse(utterance)"))
+        assertEquals(1, Regex("""VoiceApprovalParser\.parse\(utterance\)""").findAll(service).count())
+        // What it calls neither a yes nor a no goes on as a request, in the branch that hands requests on.
+        val none = approval.substringAfter("VoiceApprovalIntent.NONE ->").substringBefore("}")
+        assertTrue(none.contains("if (otherwiseARequest && !isOwnWakeReply(utterance)) agentLoop.processQuery(utterance, this)"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/voice/OpenMicrophonesTest.kt b/app/src/test/java/com/opendroid/ai/core/voice/OpenMicrophonesTest.kt
