+            "read screen", "remember this", "save this", "save to notes", "read notes", "my notes",
+            "what did i save", "what did i remember",
+            "social media", "social performance", "create post", "draft post",
+            "social report", "create campaign", "social inbox",
+            // Commands whose keyword sits inside a longer word. Substring matching used to
+            // catch them; word-start matching needs them spelled out.
+            "redial", "rebook", "recalculate", "retranslate", "reconvert",
+            "speakerphone", "headphone", "microphone"
