+    private fun ownPictureLine(caption: String): String {
+        val kept = captionOnOneLine(caption)
+        val captionPart = when {
+            kept.isEmpty() -> ""
+            kept.last().isLetterOrDigit() -> "Its caption: $kept. "
+            else -> "Its caption: $kept "
+        }
+        return "- A picture of you is attached to the first message below: your own picture, kept on this phone. " +
+            captionPart + "It is you, not his screen."
+    }
