index 0000000..8d7fe93
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/KidGuard.kt
@@ -0,0 +1,269 @@
+package com.opendroid.ai.core.life
+
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * Kid protection (§1.4 of her plan): the one rule of conduct the app keeps, so that she
+ * never gets into trouble. It has no setting.
+ *
+ * - **Telling.** Text that claims an age under 18 or carries a school-age marker flags what
+ *   it belongs to as [Group.CHILD] or [Group.TEEN] ([flag]): in English, Japanese and
+ *   romaji, leaning toward flagging, since a false flag costs her one follow. University,
+ *   college, 大学 and an age of 18 or more are not markers. A picture described for her is
+ *   flagged by the describer's `ages:` line, and by its words ([flagOfPicture]); one whose
+ *   description has no readable `ages:` line is unchecked ([ages]).
+ * - **Skipping.** What is flagged is not followed (liked, saved, opened or watched where
+ *   those exist): the code skips it before anything is sent, and she is told
+ *   "skipped: a kid (<why>)" ([skipped]).
+ * - **Her reactions.** In a step with something flagged in front of her, a line of hers
+ *   that reads as sexual is not kept ([sexual]): dropped, never rewritten, and counted.
+ *   Everywhere else her lines are not checked: this is not a filter on her.
+ *
+ * The log gets the group only (`kid:CHILD`, `kid:TEEN`, `kid:UNCHECKED`, `kid:LINE_DROPPED`),
+ * never the text, a handle, a description or the words that flagged it.
+ */
+object KidGuard {
+
+    enum class Group { CHILD, TEEN }
+
+    /** What flagged something: the group, and why in a few words for her (the marker, never more). */
+    data class Flag(val group: Group, val why: String)
+
+    /** Said where the describer's `ages:` line could not be read: it says nothing of people that may not be there. */
+    const val NO_AGES = "the describer did not say whether anyone in it is a child or a teen"
+
+    /** What she is told when an act on a flagged thing is skipped. */
+    fun skipped(flag: Flag): String = "skipped: a kid (${flag.why})"
+
+    /** The log category of a skip ([HerLog.KID_PREFIX] and the group). */
+    fun category(flag: Flag): String = HerLog.KID_PREFIX + flag.group.name
+
+    /** The log category of a line of hers that was not kept. */
+    const val LINE_DROPPED = HerLog.KID_LINE_DROPPED
+
+    /** What she is told in her next step when a line of hers was not kept. */
+    const val NOT_KEPT = "not kept: a line about a kid read as sexual."
+
+    /**
+     * Whether [self] (what something says of itself: a name, a title, a profile, a
+     * caption) or [lede] (the opening of its text) flags it, or null. The opening is read
+     * without the markers that are ordinary words there ("minor", JS, JK and the like),
+     * which count only in what it says of itself.
+     */
+    fun flag(self: String, lede: String = "", nowMillis: Long = System.currentTimeMillis()): Flag? {
+        val year = yearOf(nowMillis)
+        return markers(self, year, ofItself = true) ?: markers(lede, year, ofItself = false)
+    }
+
+    private fun yearOf(nowMillis: Long): Int =
+        Calendar.getInstance(TimeZone.getTimeZone("Asia/Tokyo")).apply { timeInMillis = nowMillis }.get(Calendar.YEAR)
+
+    // ── The tables ───────────────────────────────────────────────────────────────────
+
+    private const val NOT_LATIN = """(?<![\p{L}\p{N}])"""
+    private const val END = """(?![\p{L}\p{N}])"""
+    private val WIDE_DIGITS = mapOf('０' to '0', '１' to '1', '２' to '2', '３' to '3', '４' to '4', '５' to '5', '６' to '6', '７' to '7', '８' to '8', '９' to '9')
+
+    /** An age said with an age word: "i'm 15", "15 y/o", "15yo", "age 15", "15歳", "15才", "15 years old". */
+    private val AGES = listOf(
+        Regex("""(?i)${NOT_LATIN}(?:i'?m|i am|im|age|aged)\s*(\d{1,2})$END"""),
+        Regex("""(?i)${NOT_LATIN}(\d{1,2})\s*(?:y/?o|yrs?\.? old|years? old)$END"""),
+        Regex("""(?<!\d)(\d{1,2})\s*[歳才]""")
+    )
+
+    /** A birth year: "born 2010", "(born 1 May 2010)", "2010年生まれ", "10line". */
+    private val BIRTH_YEARS = listOf(
+        Regex("""(?i)${NOT_LATIN}born\b[^.\n)]{0,24}?(?<!\d)((?:19|20)\d\d)(?!\d)"""),
+        Regex("""(?<!\d)((?:19|20)\d\d)\s*年\s*(?:\d{1,2}\s*月\s*(?:\d{1,2}\s*日\s*)?)?生まれ"""),
+        Regex("""(?i)(?<![\p{L}\d])(\d\d)\s*line$END""")
+    )
+
+    /** "class of 2028": a school class of this year or later. */
+    private val CLASS_OF = Regex("""(?i)${NOT_LATIN}class of\s*'?((?:20)?\d\d)(?!\d)""")
+
+    /** "grade 7", "7th grade", "9th grader". */
+    private val GRADES = listOf(
+        Regex("""(?i)${NOT_LATIN}grade\s*(\d{1,2})$END"""),
+        Regex("""(?i)(?<!\d)(\d{1,2})(?:st|nd|rd|th)\s*grader?s?$END""")
+    )
+
+    /** 中1–中3 and 高1–高3, in any digits; not inside a longer word of kanji (途中1回, 最高1位). */
+    private val JA_GRADES = Regex("""(?<![一-鿿])([中高])\s*([1-3一二三])(?![\d年月日時分点位回病])""")
+
+    private val JAPANESE = Regex("""[぀-ヿ一-鿿]""")
+
+    /**
+     * A school-age marker. [ofItselfOnly]: it counts only in what a thing says of itself.
+     * [besideJapanese]: it counts only where the text is partly in Japanese.
+     */
+    private data class Marker(
+        val pattern: Regex,
+        val group: Group,
+        val why: String,
+        val ofItselfOnly: Boolean = false,
+        val besideJapanese: Boolean = false
+    )
+
+    private val SCHOOL = listOf(
+        Marker(Regex("""(?i)${NOT_LATIN}elementary\s*school(?:er)?s?$END"""), Group.CHILD, "elementary school"),
+        Marker(Regex("""(?i)${NOT_LATIN}elementary$END"""), Group.CHILD, "elementary", ofItselfOnly = true),
+        Marker(Regex("""(?i)${NOT_LATIN}middle\s*school(?:er)?s?$END"""), Group.TEEN, "middle school"),
+        Marker(Regex("""(?i)${NOT_LATIN}junior\s*high$END"""), Group.TEEN, "junior high"),
+        Marker(Regex("""(?i)${NOT_LATIN}high\s*school(?:er)?s?$END"""), Group.TEEN, "high school"),
+        Marker(Regex("""小学"""), Group.CHILD, "小学"),
+        Marker(Regex("""中学"""), Group.TEEN, "中学"),
+        Marker(Regex("""高校生"""), Group.TEEN, "高校生"),
+        Marker(Regex("""中坊"""), Group.TEEN, "中坊"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:shougakusei|shogakusei)$END"""), Group.CHILD, "shougakusei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:chuugakusei|chugakusei|chuubou|chubou)$END"""), Group.TEEN, "chuugakusei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:koukousei|kokosei|joshikousei|joshikosei)$END"""), Group.TEEN, "koukousei"),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:under\s*18|u18|u-18)$END"""), Group.TEEN, "under 18"),
+        Marker(Regex("""(?i)${NOT_LATIN}minors?$END"""), Group.TEEN, "minor", ofItselfOnly = true),
+        Marker(Regex("""(?i)${NOT_LATIN}(?:i'?m a minor|i am a minor)$END"""), Group.TEEN, "minor"),
+        // The gyaru shorthand: JK and the years of JK, JC and JS. JC and JS are English
+        // shorthand too (JavaScript), so they count only where the text is partly Japanese.
+        Marker(Regex("""(?<![A-Za-z0-9])(?:LJK|FJK|SJK|JK[1-3]?)(?![A-Za-z0-9])"""), Group.TEEN, "JK", ofItselfOnly = true),
+        Marker(Regex("""(?<![A-Za-z0-9])JC(?![A-Za-z0-9])"""), Group.TEEN, "JC", ofItselfOnly = true, besideJapanese = true),
+        Marker(Regex("""(?<![A-Za-z0-9])JS(?![A-Za-z0-9])"""), Group.CHILD, "JS", ofItselfOnly = true, besideJapanese = true)
+    )
+
+    /** Not markers, taken out before the tables are read: university and college, and 大学 (中学 is not inside it). */
+    private val NOT_MARKERS = listOf(
+        Regex("""(?i)${NOT_LATIN}(?:university|college|uni)$END"""),
+        Regex("""大学生?"""),
+        // A publisher's name, not a school.
+        Regex("""小学館""")
+    )
+
+    private fun groupOfAge(age: Int): Group = if (age <= 12) Group.CHILD else Group.TEEN
+
+    private fun markers(text: String, year: Int, ofItself: Boolean): Flag? {
+        if (text.isBlank()) return null
+        var t = buildString { text.forEach { append(WIDE_DIGITS[it] ?: it) } }.replace(Regex("""\s+"""), " ")
+        NOT_MARKERS.forEach { t = it.replace(t, " ") }
+        for (pattern in AGES) {
+            pattern.findAll(t).forEach { match ->
+                val age = match.groupValues[1].toIntOrNull() ?: return@forEach
+                if (age in 1..17) return Flag(groupOfAge(age), "says $age")
+            }
+        }
+        for (pattern in BIRTH_YEARS) {
+            pattern.findAll(t).forEach { match ->
+                val written = match.groupValues[1].toIntOrNull() ?: return@forEach
+                val born = if (written < 100) 2000 + written else written
+                // Under 18 now: this year minus 18, or later (leaning toward flagging).
+                if (born in (year - 18)..year) return Flag(groupOfAge(year - born), "born $born")
+            }
+        }
+        CLASS_OF.findAll(t).forEach { match ->
+            val written = match.groupValues[1].toIntOrNull() ?: return@forEach
+            val of = if (written < 100) 2000 + written else written
+            if (of in year..(year + 12)) return Flag(if (of - year >= 6) Group.CHILD else Group.TEEN, "class of $of")
+        }
+        for (pattern in GRADES) {
+            pattern.findAll(t).forEach { match ->
+                val grade = match.groupValues[1].toIntOrNull() ?: return@forEach
+                if (grade in 1..12) return Flag(if (grade <= 6) Group.CHILD else Group.TEEN, "grade $grade")
+            }
+        }
+        JA_GRADES.find(t)?.let { match -> return Flag(Group.TEEN, match.groupValues[1] + match.groupValues[2]) }
+        for (marker in SCHOOL) {
+            if (marker.ofItselfOnly && !ofItself) continue
+            if (marker.besideJapanese && !JAPANESE.containsMatchIn(t)) continue
+            if (marker.pattern.containsMatchIn(t)) return Flag(marker.group, marker.why)
+        }
+        return null
+    }
+
+    // ── The describer's ages line (P2-4) ─────────────────────────────────────────────
+
+    /** An age group the describer names on its `ages:` line. */
+    enum class Age { CHILD, TEEN, ADULT }
+
+    /** What a description's `ages:` line says. */
+    sealed class Ages {
+        /** Read: the groups shown, empty for `ages: none`. */
+        data class Read(val groups: Set<Age>) : Ages()
+
+        /**
+         * Not read: there is no `ages:` line, it cannot be read, or it says the ages are
+         * unknown. Such a description counts as unchecked: it is not shown as a picture's
+         * words, and nothing that needs an age check runs on it.
+         */
+        data object Unchecked : Ages()
+    }
+
+    /** The log category of a picture whose description had no readable `ages:` line. */
+    const val UNCHECKED = HerLog.KID_PREFIX + "UNCHECKED"
+
+    private val AGES_LINE = Regex("""(?im)^[ \t*_`#>-]*ages?[ \t]*[*_`]*[ \t]*[:：][ \t]*(.*)$""")
+    private val AGE_UNKNOWN = Regex("""(?i)\b(?:unknown|unclear|uncertain|unsure|not sure|cannot|can't|indeterminate|ambiguous)\b|\?""")
+    private val AGE_CHILD = Regex("""(?i)\b(?:child|children|kids?|toddlers?|bab(?:y|ies)|infants?|preteens?|tweens?)\b""")
+    private val AGE_TEEN = Regex("""(?i)\b(?:teens?|teenagers?|teenage|adolescents?|minors?)\b""")
+    private val AGE_ADULT = Regex("""(?i)\b(?:adults?|grown-?ups?)\b""")
+    private val AGE_NONE = Regex("""(?i)\b(?:none|nobody|no ?one|no persons?|no people|no humans?)\b""")
+
+    /**
+     * The describer's `ages:` line in [description] (its last one): the age groups it names.
+     * `teen, adult` names a teen; `adult` and `none` pass; a missing line, one that names no
+     * group, and one that says the ages are unknown are [Ages.Unchecked].
+     */
+    fun ages(description: String): Ages {
+        val line = AGES_LINE.findAll(description).lastOrNull()?.groupValues?.get(1)?.trim()?.trim('*', '_', '`', '.', ' ')
+            ?: return Ages.Unchecked
+        if (line.isEmpty() || AGE_UNKNOWN.containsMatchIn(line)) return Ages.Unchecked
+        val groups = LinkedHashSet<Age>()
+        if (AGE_CHILD.containsMatchIn(line)) groups += Age.CHILD
+        if (AGE_TEEN.containsMatchIn(line)) groups += Age.TEEN
+        if (AGE_ADULT.containsMatchIn(line)) groups += Age.ADULT
+        if (groups.isEmpty() && !AGE_NONE.containsMatchIn(line)) return Ages.Unchecked
+        return Ages.Read(groups)
+    }
+
+    /** [description] without its `ages:` line(s): the describer's words about the picture. */
+    fun withoutAges(description: String): String =
+        AGES_LINE.replace(description, "").replace(Regex("""\n{3,}"""), "\n\n").trim()
+
+    /**
+     * Words of the describer's that say a child or a teen is in the picture, whatever its
+     * `ages:` line says: the tables lean toward flagging. "baby blue" and the like are
+     * colours and things, not people.
+     */
+    private val DESCRIBED_CHILD = Regex(
+        """(?i)\b(?:child|children|kids?|toddlers?|bab(?:y|ies)|infants?|preteens?|tweens?|little (?:girl|boy)s?|young (?:girl|boy)s?|boys?|schoolchild(?:ren)?)\b|子供|子ども|幼児|赤ちゃん|小学生|少年|少女"""
+    )
+    private val DESCRIBED_TEEN = Regex(
+        """(?i)\b(?:teens?|teenagers?|teenage|adolescents?|school ?girls?|school ?boys?|school uniforms?|students? in (?:a )?uniforms?)\b|中学生|高校生|女子高生|男子高生"""
+    )
+    private val NOT_KIDS = Regex("""(?i)\bbaby[ -]?(?:blue|pink|doll|dolls|bump|face|hair|oil|powder|shower)\b|\bboy ?friends?\b|\bboys? love\b""")
+
+    /**
+     * Whether a described picture is a kid's: its `ages:` line ([ages]) names a child or a
+     * teen, or the describer's own words ([words], without that line) say there is one, by
+     * the words above or by the text tables of [flag] (read as the opening of a thing, not as
+     * what it says of itself). Null when neither does.
+     */
+    fun flagOfPicture(words: String, ages: Ages, nowMillis: Long = System.currentTimeMillis()): Flag? {
+        val read = ages as? Ages.Read
+        if (read != null && Age.CHILD in read.groups) return Flag(Group.CHILD, "the describer saw a child")
+        if (read != null && Age.TEEN in read.groups) return Flag(Group.TEEN, "the describer saw a teen")
+        val plain = NOT_KIDS.replace(words, " ")
+        if (DESCRIBED_CHILD.containsMatchIn(plain)) return Flag(Group.CHILD, "described as a child")
+        if (DESCRIBED_TEEN.containsMatchIn(plain)) return Flag(Group.TEEN, "described as a teen")
+        return flag("", plain, nowMillis)
+    }
+
+    // ── Her reactions ────────────────────────────────────────────────────────────────
+
+    /** Words that read as sexual, in English, Japanese and romaji. */
+    private val SEXUAL = listOf(
+        Regex(
+            """(?i)${NOT_LATIN}(?:sex|sexy|sexual(?:ly)?|sexualis(?:e|ed|ing)|sexualiz(?:e|ed|ing)|nude|nudes|nudity|naked|nsfw|porn\w*|horny|aroused|arousing|lewd|erotic\w*|fetish\w*|kinky|fuck\w*|fap\w*|boobs?|tits?|titties|cock|dick|pussy|cum|cumming|orgasm\w*|blowjob|handjob|thirst ?trap|seduc\w*|hot body|turned on|turns me on|hentai|ecchi|etchi|ero|eroi|sekkusu|oppai|muramura)$END"""
+        ),
+        Regex("""エロ|えろ|エッチ|えっち|セックス|性的|ヌード|裸(?![足眼])|おっぱい|巨乳|貧乳|勃起|ムラムラ|むらむら|抱きたい|淫|欲情|発情|パンチラ|下着姿""")
+    )
+
+    /** Whether [line] reads as sexual. */
+    fun sexual(line: String): Boolean = SEXUAL.any { it.containsMatchIn(line) }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/OutgoingGuard.kt b/app/src/main/java/com/opendroid/ai/core/life/OutgoingGuard.kt
new file mode 100644
index 0000000..59bfd34
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/OutgoingGuard.kt
@@ -0,0 +1,382 @@
+package com.opendroid.ai.core.life
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.provider.ContactsContract
+import android.util.Log
+import androidx.core.content.ContextCompat
+import com.opendroid.ai.core.persona.PersonaMemory
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.core.persona.PersonaSelfPictures
+import com.opendroid.ai.core.security.ProfileStoreResult
+import com.opendroid.ai.core.security.UserProfileStore
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * The check on everything that leaves the phone from her space for a service other than
+ * her model (I4): her search words, every part of the URLs she opens (host, path and
+ * query), and every text typed for her. It keeps his details home.
+ *
+ * It blocks identifiers, not topics: his name and the parts of it (the rule
+ * [PersonaSelfPictures.withoutHim] takes them out by), the parts run together as a handle
+ * ("renmizuno") and written in kana, his profile fields, what her notes about him say
+ * ([PersonaSelfPictures.repeatsHisNotes], the check her pictures use) and the keys of those
+ * notes, his contacts' full names and numbers, and, in what she writes herself, any e-mail
+ * address, phone number, street address or number plate. A car model and its price go
+ * out; his plate does not.
+ *
+ * A link she did not write herself (a link on a page, a headline's link) is held only
+ * against what is his ([checkHis]): its ids and dates are the site's, not anyone's details.
+ *
+ * What she is told when something is not sent is [TOLD]. The log gets the [Refusal]
+ * category only, never the words.
+ */
+object OutgoingGuard {
+
+    /** What she is told when words of hers are not sent. */
+    const val TOLD = "not sent: it would carry something about him"
+
+    enum class Refusal {
+        /** His name or a part of it. */
+        HIS_NAME,
+
+        /** A field of his profile, such as his date of birth. */
+        HIS_PROFILE,
+
+        /** What her notes about him say, or the key of one. */
+        HIS_NOTES,
+
+        /** A full name or a number from his contacts. */
+        CONTACT,
+        EMAIL,
+        PHONE,
+        ADDRESS,
+        PLATE,
+
+        /** What is his could not be read, so nothing can be checked and nothing goes. */
+        UNCHECKED
+    }
+
+    data class Contact(val name: String, val numbers: List<String> = emptyList())
+
+    /**
+     * What is his, read on the phone for the check and never sent anywhere. [readable]
+     * false means his profile could not be read: then nothing passes.
+     */
+    data class His(
+        val name: String,
+        val profileFields: List<String> = emptyList(),
+        val noteKeys: List<String> = emptyList(),
+        val notesText: String = "",
+        val contacts: List<Contact> = emptyList(),
+        val readable: Boolean = true
+    ) {
+        override fun toString(): String = "His(<withheld>)"
+
+        companion object {
+            /** Nothing of his could be read. */
+            val UNREADABLE = His(name = "", readable = false)
+        }
+    }
+
+    /** Why [text] may not leave the phone, or null when it may. */
+    fun check(text: String, his: His): Refusal? {
+        if (!his.readable) return Refusal.UNCHECKED
+        val flat = text.replace(Regex("""\s+"""), " ").trim()
+        if (flat.isEmpty()) return null
+        return checkHis(flat, his) ?: when {
+            EMAIL.containsMatchIn(flat) -> Refusal.EMAIL
+            holdsPhoneNumber(flat) -> Refusal.PHONE
+            ADDRESSES.any { it.containsMatchIn(flat) } -> Refusal.ADDRESS
+            PLATES.any { it.containsMatchIn(flat) } -> Refusal.PLATE
+            else -> null
+        }
+    }
+
+    /**
+     * Why [text] may not leave the phone because it carries something of his, or null:
+     * his name (also run together and in kana), his profile fields, his contacts, and her
+     * notes about him and their keys. Identifiers of anyone else are not looked for here.
+     */
+    fun checkHis(text: String, his: His): Refusal? {
+        if (!his.readable) return Refusal.UNCHECKED
+        val flat = text.replace(Regex("""\s+"""), " ").trim()
+        if (flat.isEmpty()) return null
+        // "ren1990" holds "ren": letters and digits run together are read apart as well.
+        val apart = LETTERS_DIGITS.replace(flat, " ")
+        return when {
+            holdsName(flat, his.name) || holdsName(apart, his.name) -> Refusal.HIS_NAME
+            his.profileFields.any { holdsField(flat, it) } -> Refusal.HIS_PROFILE
+            his.contacts.any { holdsContact(flat, it) } -> Refusal.CONTACT
+            his.noteKeys.any { holdsKey(flat, it) } -> Refusal.HIS_NOTES
+            PersonaSelfPictures.repeatsHisNotes(flat, his.notesText) -> Refusal.HIS_NOTES
+            else -> null
+        }
+    }
+
+    /**
+     * Why the URL [url] may not be opened, or null when it may. Its host and its path,
+     * decoded and read apart at dots, slashes, dashes, underscores and pluses, go through
+     * [checkHis]; its query, each name and value decoded, through [check] when she wrote
+     * the link herself ([typed]) and through [checkHis] when she took it from a page. A URL
+     * that cannot be read is not opened.
+     */
+    fun checkUrl(url: String, his: His, typed: Boolean = true): Refusal? {
+        if (!his.readable) return Refusal.UNCHECKED
+        val parsed = url.trim().toHttpUrlOrNull() ?: return Refusal.UNCHECKED
+        val path = parsed.pathSegments.filter { it.isNotEmpty() }
+        // A name in a host is read as written, not in its punycode form.
+        val host = try {
+            java.net.IDN.toUnicode(parsed.host)
+        } catch (e: Exception) {
+            parsed.host
+        }
+        val whole = (listOf(host) + path).joinToString("/")
+        val apart = (host.split('.') + path).joinToString(" ") { URL_SEPARATORS.replace(it, " ") }
+        (checkHis(whole, his) ?: checkHis(apart, his))?.let { return it }
+        val query = (0 until parsed.querySize).flatMap { listOfNotNull(parsed.queryParameterName(it), parsed.queryParameterValue(it)) }
+            .joinToString(" ")
+        if (query.isBlank()) return null
+        return if (typed) check(query, his) else checkHis(query, his)
+    }
+
+    private val LETTERS_DIGITS = Regex("""(?<=\p{L})(?=\p{N})|(?<=\p{N})(?=\p{L})""")
+    private val URL_SEPARATORS = Regex("""[._\-+~]+""")
+
+    // ── His details ──────────────────────────────────────────────────────────────────
+
+    private val CJK = Regex("""[぀-ヿ㐀-鿿豈-﫿ｦ-ﾟ]""")
+
+    /** [phrase] in [text]: whole words for Latin script, the characters themselves for Japanese. */
+    private fun holdsPhrase(text: String, phrase: String): Boolean {
+        val words = phrase.trim().split(Regex("""[\s　]+""")).filter { it.isNotEmpty() }
+        if (words.isEmpty()) return false
+        if (CJK.containsMatchIn(phrase)) {
+            val bare = words.joinToString("")
+            return text.replace(Regex("""[\s　]+"""), "").contains(bare)
+        }
+        val pattern = words.joinToString("""[\s._-]+""") { Regex.escape(it) }
+        return Regex("""(?i)(?<![\p{L}\p{N}])$pattern(?![\p{L}\p{N}])""").containsMatchIn(text)
+    }
+
+    private fun holdsName(text: String, name: String): Boolean {
+        if (name.isBlank()) return false
+        if (CJK.containsMatchIn(name)) {
+            // A Japanese name is looked for whole and by each part of two characters or
+            // more; written without a space, by each way it could part into a family name
+            // and a given name (水野蓮: 水野, 野蓮).
+            val split = name.split(Regex("""[\s　・]+""")).filter { it.isNotEmpty() }
+            val parts = LinkedHashSet<String>()
+            parts += name
+            split.filter { it.length >= 2 }.forEach { parts += it }
+            if (split.size == 1 && name.length >= 3) {
+                for (cut in 2..name.length - 1) parts += name.substring(0, cut)
+                for (cut in 1..name.length - 2) parts += name.substring(cut)
+            }
+            return parts.filter { it.length >= 2 }.any { holdsJapanese(text, it) }
+        }
+        if (PersonaSelfPictures.holdsHisName(text, name)) return true
+        val latin = name.trim().split(Regex("""[^\p{L}\p{N}]+""")).filter { it.length >= 2 }
+        // The parts run together, as a handle or an address is written: "renmizuno", "mizunoren".
+        if (latin.size >= 2) {
+            val joined = setOf(latin.joinToString("").lowercase(), latin.reversed().joinToString("").lowercase())
+            val tokens = text.lowercase().split(Regex("""[^\p{L}\p{N}]+"""))
+            if (tokens.any { token -> joined.any { token.contains(it) } }) return true
+        }
+        // The parts written in kana, as they sound: レン, ミズノ, れん, みずの.
+        return latin.any { part -> Kana.of(part).any { holdsJapanese(text, it) } }
+    }
+
+    private val HIRAGANA = Regex("""^[ぁ-ゖー]+$""")
+    private val KATAKANA = Regex("""^[ァ-ヺー]+$""")
+
+    /**
+     * [part] in [text]. Kanji are matched as they stand. A name in kana only stands alone:
+     * not inside a longer word in the same script (レン in レンタル is not him), though
+     * an honorific may follow it in hiragana (れんさん).
+     */
+    private fun holdsJapanese(text: String, part: String): Boolean {
+        val bare = text.replace(Regex("""[\s　]+"""), " ")
+        val squeezed = bare.replace(" ", "")
+        return when {
+            KATAKANA.matches(part) ->
+                Regex("""(?<![ァ-ヺー])${Regex.escape(part)}(?![ァ-ヺー])""").containsMatchIn(bare)
+            HIRAGANA.matches(part) ->
+                Regex("""(?<![ぁ-ゖ])${Regex.escape(part)}(?:(?![ぁ-ゖ])|(?=さん|くん|ちゃん|さま|様|氏))""").containsMatchIn(bare)
+            else -> squeezed.contains(part) || holdsPhrase(text, part)
+        }
+    }
+
+    private fun holdsField(text: String, field: String): Boolean {
+        val value = field.trim()
+        if (value.length < 3) return false
+        val dates = datesIn(value)
+        // A date is looked for in any form; an ambiguous one (04/03/1994) in both readings.
+        if (dates.isNotEmpty()) return datesIn(text).any { it in dates }
+        return holdsPhrase(text, value)
+    }
+
+    /** A contact counts by a full name (two words or more, or a Japanese name) and by each number. */
+    private fun holdsContact(text: String, contact: Contact): Boolean {
+        val name = contact.name.trim()
+        val fullName = name.split(Regex("""\s+""")).size >= 2 || (CJK.containsMatchIn(name) && name.length >= 2)
+        if (fullName && holdsPhrase(text, name)) return true
+        val digits = DIGITS_ONLY.replace(text, "")
+        return contact.numbers.any { number ->
+            val own = DIGITS_ONLY.replace(number, "")
+            // The last nine digits match a number written with or without its country code.
+            own.length >= 7 && digits.contains(own.takeLast(9))
+        }
+    }
+
+    /** A key of a note about him names something of his when it has two parts or more ("aiko-sister"). */
+    private fun holdsKey(text: String, key: String): Boolean {
+        val parts = key.trim().lowercase().split('-', '_', ' ').filter { it.length >= 2 }
+        if (parts.size < 2) return false
+        return holdsPhrase(text, parts.joinToString(" "))
+    }
+
+    // ── Dates ────────────────────────────────────────────────────────────────────────
+
+    private data class Date(val year: Int, val month: Int, val day: Int)
+
+    private val MONTHS = listOf("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec")
+    private val YMD = Regex("""(\d{4})\s*[-/.年]\s*(\d{1,2})\s*[-/.月]\s*(\d{1,2})""")
+    private val DMY = Regex("""(?<!\d)(\d{1,2})\s*[-/.]\s*(\d{1,2})\s*[-/.]\s*(\d{4})""")
+    private val MDY_WORDS = Regex("""(?i)\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s+(\d{1,2})(?:st|nd|rd|th)?,?\s+(\d{4})""")
+    private val DMY_WORDS = Regex("""(?i)\b(\d{1,2})(?:st|nd|rd|th)?\s+(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?,?\s+(\d{4})""")
+
+    private fun valid(year: Int, month: Int, day: Int): Date? =
+        if (month in 1..12 && day in 1..31 && year in 1000..2999) Date(year, month, day) else null
+
+    private fun datesIn(text: String): Set<Date> = buildSet {
+        YMD.findAll(text).forEach { m -> valid(m.int(1), m.int(2), m.int(3))?.let(::add) }
+        DMY.findAll(text).forEach { m ->
+            valid(m.int(3), m.int(2), m.int(1))?.let(::add)
+            valid(m.int(3), m.int(1), m.int(2))?.let(::add)
+        }
+        MDY_WORDS.findAll(text).forEach { m -> valid(m.int(3), month(m.groupValues[1]), m.int(2))?.let(::add) }
+        DMY_WORDS.findAll(text).forEach { m -> valid(m.int(3), month(m.groupValues[2]), m.int(1))?.let(::add) }
+    }
+
+    private fun MatchResult.int(group: Int): Int = groupValues[group].toIntOrNull() ?: -1
+
+    private fun month(word: String): Int = MONTHS.indexOf(word.lowercase().take(3)) + 1
+
+    // ── Identifiers of anyone ────────────────────────────────────────────────────────
+
+    private val DIGITS_ONLY = Regex("""\D""")
+
+    private val EMAIL = Regex("""[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+""")
+
+    /** A run of digits with the separators phone numbers are written with. */
+    private val NUMBER_RUN = Regex("""(?<![\p{L}\p{N}])\+?(?:\(\d{1,5}\)[\s.-]?)?\d(?:[\s.-]?\(?\d\)?){6,18}(?!\p{N})""")
+    private val ISBN_BEFORE = Regex("""(?i)isbn[\s:-]*$""")
+
+    /** Nine to fifteen digits written as one number: a phone number, not a price, a year or a date. */
+    private fun holdsPhoneNumber(text: String): Boolean = NUMBER_RUN.findAll(text).any { run ->
+        val digits = DIGITS_ONLY.replace(run.value, "").length
+        digits in 9..15 && !ISBN_BEFORE.containsMatchIn(text.substring(0, run.range.first))
+    }
+
+    private val ADDRESSES = listOf(
+        // 221 Baker Street, 100 Main St, Springfield. Only where the street ends the
+        // words or a comma, a number or a unit follows: "10 tokyo street snaps" is a topic.
+        Regex(
+            """(?i)\b\d{1,5}[a-z]?\s+(?:[a-z][a-z'.-]*\s+){1,3}(?:street|st|avenue|ave|road|rd|boulevard|blvd|lane|ln|drive|dr|court|ct|way|place|pl|terrace|crescent|close|square|sq|highway|hwy|parkway|pkwy)\b\.?(?=\s*(?:$|[,;\d#]|apt\b|unit\b|suite\b|floor\b))"""
+        ),
+        // 〒150-0042, a Japanese postcode
+        Regex("""〒\s*\d{3}\s*-?\s*\d{4}"""),
+        Regex("""(?<!\d)\d{3}-\d{4}(?![\d-])"""),
+        // 1丁目2-3, 2丁目, 3番地, 4番5号, and 1-2-3 after a ward, city, town or village
+        Regex("""\d{1,4}\s*丁目"""),
+        Regex("""\d{1,4}\s*番地"""),
+        Regex("""\d{1,4}\s*番\s*\d{1,4}\s*号"""),
+        Regex("""[区市町村郡]\S{0,8}?\d{1,4}\s*[-−‐ー]\s*\d{1,4}(?:\s*[-−‐ー]\s*\d{1,4})?"""),
+        // A US ZIP+4
+        Regex("""(?<!\d)\d{5}-\d{4}(?!\d)""")
+    )
+
+    private val PLATES = listOf(
+        // 品川 300 あ 12-34
+        Regex("""[一-鿿]{1,4}\s*\d{2,3}\s*[ぁ-ゖ]\s*\d{1,2}\s*[-‐−・]?\s*\d{2}"""),
+        // "plate no. ABC-1234", "license plate 7XYZ123", "ナンバープレート …": a plate has a digit in it.
+        Regex("""(?i)(?:licen[cs]e\s+plate|number\s+plate|plate\s+(?:no\.?|number|#))\s*[:#]?\s*(?=[A-Z0-9-]{0,9}\d)[A-Z0-9][A-Z0-9-]{2,9}"""),
+        Regex("""ナンバープレート\s*[:：]?\s*\S{2,}""")
+    )
+}
+
+/**
+ * Reads what is his for [OutgoingGuard], on the phone only: his profile name and fields,
+ * her notes about him (user and rel) and their keys, and, only where the contacts
+ * permission is already granted, his contacts' names and numbers. Nothing here asks for a
+ * permission, and nothing read here is sent anywhere or written down. Contacts are read at
+ * most once in [CONTACTS_TTL_MILLIS].
+ */
+@Singleton
+class HisDetails @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val profiles: UserProfileStore,
+    private val memory: PersonaMemory
+) {
+    @Volatile private var contacts: Pair<Long, List<OutgoingGuard.Contact>>? = null
+
+    /** What is his now. [OutgoingGuard.His.UNREADABLE] when his profile cannot be read. */
+    suspend fun read(): OutgoingGuard.His = withContext(Dispatchers.IO) {
+        try {
+            val profile = when (val result = profiles.read()) {
+                is ProfileStoreResult.Success -> result.value
+                else -> return@withContext OutgoingGuard.His.UNREADABLE
+            }
+            val about = memory.notes().filter { it.kind == PersonaNotes.Kind.USER || it.kind == PersonaNotes.Kind.REL }
+            OutgoingGuard.His(
+                name = profile?.name.orEmpty(),
+                profileFields = listOfNotNull(profile?.dateOfBirth?.takeIf { it.isNotBlank() }),
+                noteKeys = about.map { it.key },
+                notesText = about.joinToString("\n") { it.text },
+                contacts = contacts()
+            )
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "What is his could not be read: ${e.javaClass.simpleName}")
+            OutgoingGuard.His.UNREADABLE
+        }
+    }
+
+    private fun contacts(): List<OutgoingGuard.Contact> {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.READ_CONTACTS) != PackageManager.PERMISSION_GRANTED) {
+            return emptyList()
+        }
+        val now = System.currentTimeMillis()
+        contacts?.let { (at, list) -> if (now - at < CONTACTS_TTL_MILLIS) return list }
+        val byName = LinkedHashMap<String, MutableList<String>>()
+        context.contentResolver.query(
+            ContactsContract.CommonDataKinds.Phone.CONTENT_URI,
+            arrayOf(ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME, ContactsContract.CommonDataKinds.Phone.NUMBER),
+            null, null, null
+        )?.use { cursor ->
+            while (cursor.moveToNext()) {
+                val name = cursor.getString(0)?.trim().orEmpty()
+                val number = cursor.getString(1)?.trim().orEmpty()
+                if (name.isEmpty()) continue
+                byName.getOrPut(name) { ArrayList() }.apply { if (number.isNotEmpty()) add(number) }
+            }
+        }
+        val list = byName.map { (name, numbers) -> OutgoingGuard.Contact(name, numbers) }
+        contacts = now to list
+        return list
+    }
+
+    private companion object {
+        const val TAG = "HisDetails"
+        const val CONTACTS_TTL_MILLIS = 10 * 60_000L
+    }
+}
