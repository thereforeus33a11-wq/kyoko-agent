+        // In a moment of her own the block of that moment says the rest: only what holds there too is repeated.
+        val inMoment = PersonaOwnTime.appFacts(true, bounds, Wake.At(now), now, hostCanRead = false, inMoment = true)
+        assertEquals(listOf(kept, notebook), inMoment)
+    }
+
+    @Test
+    fun `a line written in the form of the talk block keeps its mark`() {
+        val moment = PersonaOwnTime.parse("you: say: oi. you alive\nyou: << he is late again\nYume: next: in 2 h\nyou: just thinking")
+        assertEquals("oi. you alive", moment.said)
+        assertEquals(Wish.After(2 * 60 * 60_000L), moment.wish)
+        // Without a mark behind it, a labelled line is a thought, as every unmarked line is.
+        assertEquals("he is late again\nyou: just thinking", moment.thoughts)
+    }
+
+    // ── What else her own time points her at ─────────────────────────────────────────
+
+    @Test
+    fun `her open threads are named by key only, as her page shows them`() {
+        val build = Note(Kind.THREAD, "3d-build", "he builds my 3d model on his computer | open")
+        val boots = Note(Kind.THREAD, "boots", "street story: 11,000 yen toward the boots | stalled")
+        val done = Note(Kind.THREAD, "momo-host", "momo paid her tab | closed")
+        val notThread = Note(Kind.ME, "hair", "red, roots showing")
+        val hidden = Note(Kind.THREAD, "his-exam", "his exam is on friday | open")
+        val notes = listOf(build, boots, done, notThread, hidden)
+        val shown = setOf(build, boots, done, notThread).map { it.storageKey }.toSet()
+
+        // Still going on, on her page, in the notebook's order: a closed thread, another kind and a note the page left out are not named.
+        assertEquals(listOf("3d-build", "boots"), PersonaOwnTime.openThreads(notes, shown))
+        // Keys, never their words.
+        val block = PersonaOwnTime.momentBlock(facts().copy(openThreads = PersonaOwnTime.openThreads(notes, shown)))
+        assertTrue(block.contains("- your threads still going on, by key: 3d-build, boots."))
+        for (words in listOf("he builds my 3d model", "11,000 yen", "his exam", "his-exam", "momo-host")) {
+            assertFalse(words, block.contains(words))
+        }
+        // A page that showed nothing names nothing, and a long notebook is named only so far.
+        assertEquals(emptyList<String>(), PersonaOwnTime.openThreads(notes, emptySet()))
+        val many = (1..12).map { Note(Kind.THREAD, "thread-$it", "something | open") }
+        assertEquals(
