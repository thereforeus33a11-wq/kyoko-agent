+++ b/app/src/main/java/com/opendroid/ai/core/llm/providers/OpenAiCompatExtras.kt
@@ -0,0 +1,97 @@
+package com.opendroid.ai.core.llm.providers
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.resolvedCloudTimeoutSeconds
+import okhttp3.OkHttpClient
+import java.util.concurrent.TimeUnit
+
+/**
+ * Small accommodations for hosted OpenAI-compatible endpoints that the stock request
+ * shape (model, messages, temperature, max_tokens) does not cover.
+ */
+internal object OpenAiCompatExtras {
+
+    /**
+     * Keys the app owns. No extra body can replace them: the app parses the reply as one
+     * JSON document and decides itself when a plan must come back as JSON.
+     */
+    private val RESERVED_KEYS = setOf("model", "messages", "stream", "response_format")
+
+    /**
+     * Also kept from a provider's stored options, which ride on every request to that
+     * provider: the planner and the classifier depend on their own low temperature and
+     * token limits. Options given for one request (the persona's reply) may set them.
+     */
+    private val PROVIDER_LEVEL_RESERVED_KEYS = setOf("temperature", "max_tokens")
+
+    private val LEADING_REASONING_BLOCK =
+        Regex("""^\s*<(think|thinking|reasoning)>.*?</\1>\s*""", setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL))
+    private val UNCLOSED_REASONING =
+        Regex("""^\s*<(think|thinking|reasoning)>(?:[ \t]*\r?\n|\S).*$""", setOf(RegexOption.IGNORE_CASE, RegexOption.DOT_MATCHES_ALL))
+
+    /**
+     * Removes a model's visible reasoning from [content]. Some hosted models put their
+     * scratch work inline before the answer; left in, it would be shown in chat, read
+     * aloud, sent in auto-replies and can break the plan JSON it precedes.
+     */
+    fun stripReasoning(content: String): String {
+        if (!content.trimStart().startsWith("<")) return content
+        // Inline reasoning always comes first. Only leading blocks go; a tag further in is
+        // part of the answer (plan text, XML, a sentence about the tag) and is left alone.
+        var rest = content
+        while (true) {
+            val block = LEADING_REASONING_BLOCK.find(rest) ?: break
+            rest = rest.substring(block.range.last + 1)
+        }
+        if (rest.length == content.length) {
+            // An opening tag that never closed, with the reasoning starting right behind it
+            // or on the next line: the reply was cut off while still reasoning and holds no
+            // answer. ("<think> is the tag for ..." is a sentence, and is kept.)
+            return UNCLOSED_REASONING.replace(content, "")
+        }
+        return UNCLOSED_REASONING.replace(rest, "").trimStart()
+    }
+
+    /**
+     * Adds extra request options to [body]: the ones given for this request when there
+     * are any, otherwise the ones stored for the provider. Anything that is not a JSON
+     * object is ignored, so a typo in Settings cannot break every request.
+     */
+    fun mergeExtraBody(body: MutableMap<String, Any>, providerJson: String?, requestJson: String? = null) {
+        val forThisRequest = requestJson != null
+        val extra = parseObject(if (forThisRequest) requestJson else providerJson) ?: return
+        for ((key, value) in extra.entrySet()) {
+            if (key in RESERVED_KEYS) continue
+            if (!forThisRequest && key in PROVIDER_LEVEL_RESERVED_KEYS) continue
+            body[key] = value
+        }
+    }
+
+    /** True when [extraJson] is blank or a JSON object, for the Settings field's error state. */
+    fun isValidExtraBody(extraJson: String?): Boolean =
+        extraJson.isNullOrBlank() || parseObject(extraJson) != null
+
+    private fun parseObject(json: String?): JsonObject? {
+        if (json.isNullOrBlank()) return null
+        return try {
+            JsonParser.parseString(json).takeIf { it.isJsonObject }?.asJsonObject
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    /**
+     * The shared client's 15-second read limit is short for a hosted model that answers
+     * in one piece. Connect keeps the shared limit; read and write follow the setting.
+     * newBuilder() shares the connection pool.
+     */
+    fun httpClientFor(client: OkHttpClient, config: LLMConfig): OkHttpClient {
+        val seconds = config.resolvedCloudTimeoutSeconds().toLong()
+        return client.newBuilder()
+            .readTimeout(seconds, TimeUnit.SECONDS)
+            .writeTimeout(seconds, TimeUnit.SECONDS)
+            .build()
+    }
+}
