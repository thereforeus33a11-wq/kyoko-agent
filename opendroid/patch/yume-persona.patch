+package com.opendroid.ai.core.life.ears
+
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.OfflineModelConfig
+import com.k2fsa.sherpa.onnx.OfflineMoonshineModelConfig
+import com.k2fsa.sherpa.onnx.OfflineRecognizer
+import com.k2fsa.sherpa.onnx.OfflineRecognizerConfig
+import com.k2fsa.sherpa.onnx.OfflineSenseVoiceModelConfig
+import com.k2fsa.sherpa.onnx.SileroVadModelConfig
+import com.k2fsa.sherpa.onnx.SpeakerEmbeddingExtractor
+import com.k2fsa.sherpa.onnx.SpeakerEmbeddingExtractorConfig
+import com.k2fsa.sherpa.onnx.Vad
+import com.k2fsa.sherpa.onnx.VadModelConfig
+import com.opendroid.ai.core.voice.VoiceOut
+import java.io.File
+
+/**
+ * Sound in, words out, through sherpa-onnx on the phone: Silero VAD on every frame, and on
+ * each stretch of speech it finds, his voiceprint first and then the offline recogniser
+ * (SenseVoice-small or Moonshine), and how it sounded ([HowItSounded]): the recogniser's tone
+ * and sound tags, and the phone's own measures against his usual. Beside the VAD, a
+ * [SoundGate] cuts out sounds that are not speech (a laugh, a cough), which the recogniser
+ * names ([hearSound]). No Android in here, so the very code the phone runs was run on
+ * recorded speech with the real models before it shipped.
+ *
+ * Two threads use it: [feed], [speechNow] and [overHerVoice] on the capture thread, [hear],
+ * [hearSound] and [enrolTake] on one other. Samples are zeroed once they are done with;
+ * nothing is written anywhere (I6).
+ */
+class SherpaPipeline private constructor(
+    private val vad: Vad,
+    private val recognizer: OfflineRecognizer,
+    private val speaker: SpeakerEmbeddingExtractor,
+    /** The speaker model's id, which a voiceprint must have been made with. */
+    val speakerModelId: String,
+) {
+
+    /** A stretch of speech the VAD found, on [HearingRules.now]'s clock. */
+    class Segment(val startedAt: Long, val endedAt: Long, val samples: FloatArray) {
+        val millis: Long get() = endedAt - startedAt
+    }
+
+    /** What came of a segment. */
+    sealed class Outcome {
+        class Kept(val heard: Heard) : Outcome()
+
+        class Let(val why: Dropped, val millis: Long) : Outcome()
+    }
+
+    /** What the recogniser made of some sound: its words, its language, and its tone and sound tags. */
+    class Written(val text: String, val language: String?, val tone: Tone?, val sounds: List<SoundEvent>) {
+        override fun toString(): String = "Written(${text.length} chars)"
+    }
+
+    /** One take of an enrolment: its embedding, what the recogniser wrote, how much speech, and its measures. */
+    class EnrolSample(val embedding: FloatArray?, val transcript: String, val speechMillis: Long, val measure: Acoustics.Measure? = null)
+
+    // Samples fed to the VAD since it was last reset, and the clock time of the first.
+    private var fed = 0L
+    private var anchor = 0L
+    // The last of what was heard, for a look at whose voice is talking over her.
+    private val recent = FloatArray(RECENT_SAMPLES)
+    private var recentAt = 0
+    private var recentFilled = 0
+    private val speakerLock = Any()
+    private val recognizerLock = Any()
+
+    // When the last stretch of speech written down ended (his, or anyone's before his is
+    // enrolled), for the pause before the next. The words thread's.
+    @Volatile private var lastSpeechEnd: Long? = null
+
+    /**
+     * Feeds one frame of 16 kHz mono samples that ended at [endAt]; returns the stretches
+     * of speech that ended in it. The frame is not kept beyond the VAD's own buffer and the
+     * last [RECENT_SAMPLES].
+     */
+    fun feed(frame: FloatArray, endAt: Long): List<Segment> {
+        vad.acceptWaveform(frame)
+        fed += frame.size
+        anchor = endAt - fed * 1000 / SAMPLE_RATE
+        remember(frame)
+        val out = ArrayList<Segment>(1)
+        while (!vad.empty()) {
+            val s = vad.front()
+            vad.pop()
+            val startAt = anchor + s.start * 1000 / SAMPLE_RATE
+            val seg = Segment(startAt, startAt + s.samples.size * 1000L / SAMPLE_RATE, s.samples)
+            out += seg
+        }
+        return out
+    }
+
+    /** Whether the VAD hears speech right now. */
+    fun speechNow(): Boolean = vad.isSpeechDetected()
+
+    /**
+     * Whose voice the speech of the last [speechMillis] is (at most [RECENT_SAMPLES]), for
+     * cutting her off: true only when it is his enrolled voice. Without [print] nobody's voice
+     * is told apart, her own echo from the speaker included, so nothing cuts her off by
+     * talking over her until his voice is enrolled.
+     */
+    fun overHerVoice(print: VoicePrint?, speechMillis: Long): Boolean {
+        if (print == null) return false
+        if (print.modelId != speakerModelId) return false
+        val last = lastHeard((speechMillis * SAMPLE_RATE / 1000).toInt())
+        return try {
+            val e = embed(last) ?: return false
+            print.judge(e).first == Voice.HIM
+        } finally {
+            last.fill(0f)
+        }
+    }
+
+    /**
+     * What comes of [segment]:
+     *  1. under [HearingRules.MIN_SEGMENT_MILLIS] it is too short for words and is listened
+     *     to only for a sound (a cough), and under [MIN_SOUND_MILLIS] it is let go;
+     *  2. what fell while the phone spoke ([spells]) or just after is cut away, and if too
+     *     little is left it is the phone's voice;
+     *  3. with [print], whose voice it is;
+     *  4. another voice than his is not written down unless [transcribeOthers]: the
+     *     recogniser still hears it, but only the sounds it names are kept (music, laughing),
+     *     never its words or its tone;
+     *  5. the recogniser writes it down; under [HearingRules.MIN_WORDS] words it is let go,
+     *     unless the recogniser named a sound in it (a laugh), which is kept as a [Kind.SOUND];
+     *  6. words that read like a line the phone just said are the phone's;
+     *  7. how it sounded, against [usual] for his voice, which it then teaches.
+     * [overHer] marks the segment that cut her off. The segment's samples are zeroed.
+     */
+    fun hear(
+        segment: Segment,
+        print: VoicePrint?,
+        transcribeOthers: Boolean,
+        spells: List<VoiceOut.Spell>,
+        overHer: Boolean = false,
+        usual: SoundUsual? = null,
+        keepClip: Boolean = false,
+    ): Outcome = try {
+        heard(segment, print, transcribeOthers, spells, overHer, usual, gate = false, keepClip = keepClip)
+    } finally {
+        segment.samples.fill(0f)
+    }
+
+    /**
+     * What comes of [clip], a sound the [SoundGate] cut out while the VAD heard no speech: let
+     * go when it fell while the phone spoke; kept as a [Kind.SOUND] when the recogniser names
+     * it (laughing, a cough, crying, applause, music); kept as speech only when it is a
+     * whisper with words in it, which the VAD can miss; otherwise let go as [Dropped.NOISE].
+     * The clip's samples are zeroed.
+     */
+    fun hearSound(
+        clip: SoundGate.Clip,
+        print: VoicePrint?,
+        transcribeOthers: Boolean,
+        spells: List<VoiceOut.Spell>,
+        usual: SoundUsual? = null,
+    ): Outcome = try {
+        heard(Segment(clip.startedAt, clip.endedAt, clip.samples), print, transcribeOthers, spells, false, usual, gate = true)
+    } finally {
+        clip.samples.fill(0f)
+    }
+
+    private fun heard(
+        segment: Segment,
+        print: VoicePrint?,
+        transcribeOthers: Boolean,
+        spells: List<VoiceOut.Spell>,
+        overHer: Boolean,
+        usual: SoundUsual?,
+        gate: Boolean,
+        keepClip: Boolean = false,
+    ): Outcome {
+        // Too short for words, a stretch may still be a cough or a short laugh: it is only listened to for a sound.
+        val short = segment.millis < HearingRules.MIN_SEGMENT_MILLIS
+        if (short && (gate || segment.millis < MIN_SOUND_MILLIS)) return Outcome.Let(Dropped.TOO_SHORT, segment.millis)
+        val clean = HearingRules.cleanPart(segment.startedAt, segment.endedAt, spells)
+            ?: return Outcome.Let(Dropped.HER_VOICE, segment.millis)
+        val start = clean.first
+        val end = clean.last + 1
+        if (end - start < (if (short) MIN_SOUND_MILLIS else HearingRules.MIN_SEGMENT_MILLIS)) return Outcome.Let(Dropped.HER_VOICE, segment.millis)
+        // A sound is the phone's if any of it fell while the phone spoke: her laughs are sounds too.
+        if (gate && (start > segment.startedAt + EDGE_MILLIS || end < segment.endedAt - EDGE_MILLIS)) {
+            return Outcome.Let(Dropped.HER_VOICE, segment.millis)
+        }
+        val samples = slice(segment, start, end)
+        try {
+            val measure = Acoustics.measure(samples)
+            val usable = print?.takeIf { it.modelId == speakerModelId }
+            var voice = Voice.NOT_ENROLLED
+            var similarity: Float? = null
+            if (usable != null) {
+                val forSound = gate || short
+                val e = if (forSound && end - start < MIN_SOUND_VOICE_MILLIS) null else embed(samples)
+                if (e != null) {
+                    val (v, s) = usable.judge(e)
+                    voice = v
+                    similarity = s
+                } else {
+                    voice = if (forSound) Voice.UNSURE else Voice.OTHER
+                }
+            }
+            var written = if (short) transcribeWithRoom(samples) else transcribe(samples)
+            val words = HearingRules.words(written.text)
+            if (!short && words < HearingRules.MIN_WORDS && written.sounds.isEmpty()) {
+                // The recogniser names a sound more surely with a little quiet around it.
+                val again = transcribeWithRoom(samples)
+                if (again.sounds.isNotEmpty()) written = Written(written.text, written.language ?: again.language, written.tone ?: again.tone, again.sounds)
+            }
+            val whisper = measure != null && Manner.of(measure, null, null, null).breathyWith(written.sounds) == Manner.WHISPER
+            // A whisper the VAD missed is speech only with a few words in it: the gate also lets in noise the recogniser reads as words.
+            val asSpeech = when {
+                short -> false
+                gate -> whisper && words >= HearingRules.MIN_WORDS + 1
+                else -> words >= HearingRules.MIN_WORDS
+            }
+            if (!asSpeech && written.sounds.isEmpty()) {
+                val why = when {
+                    gate -> Dropped.NOISE
+                    short -> Dropped.TOO_SHORT
+                    else -> Dropped.FEW_WORDS
+                }
+                return Outcome.Let(why, end - start)
+            }
+            val kind = if (asSpeech) Kind.SPEECH else Kind.SOUND
+            val his = voice == Voice.HIM || voice == Voice.NOT_ENROLLED
+            if (!his && !transcribeOthers) {
+                // Not his voice (or not surely): no words, no language, no tone; only the
+                // sounds the recogniser named, and a whisper or a shout.
+                return Outcome.Kept(Heard(start, end, voice, similarity, null, null, overHer, HowItSounded.ofAnother(written.sounds, measure), kind))
+            }
+            // Over her, his enrolled voice has already been told from hers; without a print it cannot be, so the check always runs.
+            if (kind == Kind.SPEECH && (!overHer || usable == null) && HearingRules.soundsLikeThePhone(written.text, start, spells)) {
+                return Outcome.Let(Dropped.HER_VOICE, end - start)
+            }
+            val against = usual?.takeIf { voice == Voice.HIM }
+            val how = HowItSounded.judge(
+                measure = measure,
+                tone = written.tone,
+                sounds = written.sounds,
+                words = if (kind == Kind.SPEECH) words else 0,
+                language = written.language,
+                usual = against,
+                pauseBeforeMillis = if (kind == Kind.SPEECH && his) pauseBefore(start) else null,
+                afterHerMillis = if (overHer) null else afterHer(start, spells),
+            )
+            if (kind == Kind.SPEECH && his) lastSpeechEnd = end
+            if (against != null && measure != null && kind == Kind.SPEECH && !overHer) against.learn(measure, words, written.language, how)
+            val text = if (kind == Kind.SPEECH) written.text else null
+            // His speech itself, for a model of hers that hears: a copy, since these samples are zeroed below.
+            // Only his enrolled voice: before enrolment it could be anyone's.
+            val clip = if (keepClip && kind == Kind.SPEECH && voice == Voice.HIM && end - start <= HeardClip.MAX_MILLIS) samples.copyOf() else null
+            return Outcome.Kept(Heard(start, end, voice, similarity, text, written.language, overHer, how, kind, clip))
+        } finally {
+            if (samples !== segment.samples) samples.fill(0f)
+        }
+    }
+
+    /** The silence since the last stretch of his speech, when it was a pause in his talk. */
+    private fun pauseBefore(start: Long): Long? {
+        val last = lastSpeechEnd ?: return null
+        val gap = start - last
+        return gap.takeIf { it in 0..PAUSE_WINDOW_MILLIS }
+    }
+
+    /**
+     * How long after the phone's last line ended [start] is. Nothing when that line was cut off
+     * by him or is still being said, since he was already talking over it.
+     */
+    private fun afterHer(start: Long, spells: List<VoiceOut.Spell>): Long? {
+        val last = spells.filter { it.startedAt <= start }.maxByOrNull { it.startedAt } ?: return null
+        if (last.cutByHimAt != null) return null
+        val ended = last.endedAt ?: return null
+        return (start - ended).takeIf { it in 0..HowItSounded.AFTER_HER_MILLIS }
+    }
+
+    /**
+     * One take of his enrolment: [speech] (the speech segments of the take, joined) as an
+     * embedding and as words. [speech] is zeroed.
+     */
+    fun enrolTake(speech: FloatArray): EnrolSample = try {
+        val millis = speech.size * 1000L / SAMPLE_RATE
+        EnrolSample(embed(speech), transcribe(speech).text, millis, Acoustics.measure(speech))
+    } finally {
+        speech.fill(0f)
+    }
+
+    /** The speaker model's embedding of [samples], or null when they are too short for one. */
+    fun embed(samples: FloatArray): FloatArray? = synchronized(speakerLock) {
+        val stream = speaker.createStream()
+        try {
+            stream.acceptWaveform(samples, SAMPLE_RATE)
+            stream.inputFinished()
+            if (!speaker.isReady(stream)) null else speaker.compute(stream)
+        } finally {
+            stream.release()
+        }
+    }
+
+    /**
+     * What the recogniser makes of [samples]: the words, and where it says them, the language,
+     * the tone and the sound it heard (SenseVoice; Moonshine gives words only).
+     */
+    fun transcribe(samples: FloatArray): Written = synchronized(recognizerLock) {
+        val stream = recognizer.createStream()
+        try {
+            stream.acceptWaveform(samples, SAMPLE_RATE)
+            recognizer.decode(stream)
+            val r = recognizer.getResult(stream)
+            val lang = bare(r.lang).ifEmpty { null }
+            Written(r.text.trim(), lang, Tone.of(r.emotion), listOfNotNull(SoundEvent.of(r.event)))
+        } finally {
+            stream.release()
+        }
+    }
+
+    /** Forgets what the VAD holds and the last samples: the ears paused or closed. */
+    fun reset() {
+        vad.reset()
+        fed = 0
+        lastSpeechEnd = null
+        recent.fill(0f)
+        recentAt = 0
+        recentFilled = 0
+    }
+
+    /** Lets go of the models. The pipeline cannot be used after. */
+    fun release() {
+        reset()
+        vad.release()
+        synchronized(recognizerLock) { recognizer.release() }
+        synchronized(speakerLock) { speaker.release() }
+    }
+
+    private fun remember(frame: FloatArray) {
+        for (x in frame) {
+            recent[recentAt] = x
+            recentAt = (recentAt + 1) % recent.size
+        }
+        recentFilled = minOf(recent.size, recentFilled + frame.size)
+    }
+
+    private fun lastHeard(samples: Int): FloatArray {
+        val n = samples.coerceIn(0, recentFilled)
+        val out = FloatArray(n)
+        val from = (recentAt - n + recent.size) % recent.size
+        for (i in 0 until n) out[i] = recent[(from + i) % recent.size]
+        return out
+    }
+
+    /** What the recogniser makes of [samples] with a little quiet room around them ([padded]). */
+    private fun transcribeWithRoom(samples: FloatArray): Written {
+        val wider = padded(samples)
+        return try {
+            transcribe(wider)
+        } finally {
+            wider.fill(0f)
+        }
+    }
+
+    /** [samples] with [PAD_MILLIS] of a quiet room on each side; the caller zeroes it. */
+    private fun padded(samples: FloatArray): FloatArray {
+        val pad = (PAD_MILLIS * SAMPLE_RATE / 1000).toInt()
+        val out = FloatArray(samples.size + 2 * pad)
+        // A fixed, faint hiss (about -66 dB), as a phone's microphone gives in a quiet room.
+        var seed = 0x2545F491
+        for (i in out.indices) {
+            seed = seed xor (seed shl 13); seed = seed xor (seed ushr 17); seed = seed xor (seed shl 5)
+            out[i] = (seed % 1000) / 1000f * 0.0009f
+        }
+        samples.copyInto(out, pad)
+        return out
+    }
+
+    private fun slice(segment: Segment, start: Long, end: Long): FloatArray {
+        if (start <= segment.startedAt && end >= segment.endedAt) return segment.samples
+        val from = ((start - segment.startedAt) * SAMPLE_RATE / 1000).toInt().coerceIn(0, segment.samples.size)
+        val to = ((end - segment.startedAt) * SAMPLE_RATE / 1000).toInt().coerceIn(from, segment.samples.size)
+        return segment.samples.copyOfRange(from, to)
+    }
+
+    companion object {
+        const val SAMPLE_RATE = 16_000
+
+        /** The VAD's window, and so the frame the microphone is read in. */
+        const val WINDOW = 512
+
+        /** How much of the last sound is looked at to tell who talks over her: 1.2 s. */
+        const val RECENT_SAMPLES = SAMPLE_RATE * 6 / 5
+
+        /** A pause this long ends a stretch of speech. */
+        const val MIN_SILENCE_SECONDS = 0.5f
+
+        /** A stretch of speech is cut here at the latest. */
+        const val MAX_SPEECH_SECONDS = 15f
+
+        /** A gap between two stretches of his speech up to this long is a pause in his talk. */
+        const val PAUSE_WINDOW_MILLIS = 20_000L
+
+        /** A stretch of the VAD's this short is listened to only for a sound (a cough), and shorter not at all. */
+        const val MIN_SOUND_MILLIS = 250L
+
+        /** A sound shorter than this is not looked at for whose voice it was. */
+        const val MIN_SOUND_VOICE_MILLIS = 1_000L
+
+        /** Rounding at a sound's edges that is not taken for the phone's voice. */
+        private const val EDGE_MILLIS = 20L
+
+        /** The quiet put around a sound for the recogniser's second look at it. */
+        const val PAD_MILLIS = 500L
+
+        /**
+         * Loads the models for [recognizer] from [root] (see [EarsModelInstaller]). Throws
+         * when one cannot be loaded; what was loaded is let go of first.
+         */
+        fun load(root: File, recognizer: EarsModels.Recognizer, threads: Int = 2): SherpaPipeline {
+            fun path(model: EarsModels.Model, name: String) = EarsModelInstaller.file(root, model, name).path
+            val vad = Vad(
+                config = VadModelConfig(
+                    sileroVadModelConfig = SileroVadModelConfig(
+                        model = path(EarsModels.SILERO_VAD, "silero_vad.onnx"),
+                        threshold = 0.5f,
+                        minSilenceDuration = MIN_SILENCE_SECONDS,
+                        minSpeechDuration = 0.25f,
+                        windowSize = WINDOW,
+                        maxSpeechDuration = MAX_SPEECH_SECONDS,
+                    ),
+                    sampleRate = SAMPLE_RATE,
+                    numThreads = 1,
+                ),
+            )
+            var asr: OfflineRecognizer? = null
+            try {
+                val model = recognizer.model
+                val modelConfig = when (recognizer) {
+                    EarsModels.Recognizer.SENSE_VOICE -> OfflineModelConfig(
+                        senseVoice = OfflineSenseVoiceModelConfig(
+                            model = path(model, "model.int8.onnx"),
+                            // Any of its languages, told apart per segment: he speaks English with Japanese words.
+                            language = "",
+                            useInverseTextNormalization = true,
+                        ),
+                        tokens = path(model, "tokens.txt"),
+                        numThreads = threads,
+                    )
+                    EarsModels.Recognizer.MOONSHINE -> OfflineModelConfig(
+                        moonshine = OfflineMoonshineModelConfig(
+                            encoder = path(model, "encoder_model.ort"),
+                            mergedDecoder = path(model, "decoder_model_merged.ort"),
+                        ),
+                        tokens = path(model, "tokens.txt"),
+                        numThreads = threads,
+                    )
+                }
+                asr = OfflineRecognizer(
+                    config = OfflineRecognizerConfig(
+                        featConfig = FeatureConfig(sampleRate = SAMPLE_RATE, featureDim = 80),
+                        modelConfig = modelConfig,
+                    ),
+                )
+                val spk = SpeakerEmbeddingExtractor(
+                    config = SpeakerEmbeddingExtractorConfig(
+                        model = path(EarsModels.SPEAKER, EarsModels.SPEAKER.files.single().name),
+                        numThreads = 1,
+                    ),
+                )
+                return SherpaPipeline(vad, asr, spk, EarsModels.SPEAKER.id)
+            } catch (t: Throwable) {
+                runCatching { asr?.release() }
+                runCatching { vad.release() }
+                throw t
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/SoundGate.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/SoundGate.kt
new file mode 100644
index 0000000..986fc04
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/SoundGate.kt
@@ -0,0 +1,177 @@
+package com.opendroid.ai.core.life.ears
+
+import kotlin.math.min
+
+/**
+ * Sounds that are not speech: a laugh, a cough, crying, a sneeze, applause, music. Silero VAD
+ * is made to let these go (on recorded laughter it found speech in three clips of six), so
+ * beside it the ears keep this gate: a stretch of sound well over the room's noise, while
+ * the VAD hears no speech, is cut out as a [Clip] for the recogniser to name
+ * ([SherpaPipeline.hearSound]). Speech always wins: a clip the VAD takes for speech, while
+ * it lasts or just after, is let go, since the speech path hears it.
+ *
+ * The noise floor follows the quietest of what comes in: down at once, up slowly
+ * ([FLOOR_RISE_DB_PER_SECOND]), so a voice does not lift it. Pure and single-threaded (the
+ * capture thread); the samples it holds are zeroed when let go of.
+ */
+class SoundGate(
+    private val sampleRate: Int = SherpaPipeline.SAMPLE_RATE,
+) {
+    /** A stretch of sound that was not speech, on the clock the frames were fed on. */
+    class Clip(val startedAt: Long, val endedAt: Long, val samples: FloatArray) {
+        val millis: Long get() = endedAt - startedAt
+    }
+
+    private var floor: Float? = null
+    private val pre = FloatArray(PRE_ROLL_MILLIS.toInt() * sampleRate / 1000)
+    private var preAt = 0
+    private var preFilled = 0
+
+    private var open: Buffer? = null
+    private var held: Buffer? = null
+    private var heldUntil = 0L
+    private var lastLoudAt = 0L
+
+    private class Buffer(capacity: Int, val startedAt: Long) {
+        val samples = FloatArray(capacity)
+        var size = 0
+        var endedAt = startedAt
+
+        /** How much of it was over the floor. */
+        var loudMillis = 0L
+
+        fun add(frame: FloatArray): Boolean {
+            val n = min(frame.size, samples.size - size)
+            frame.copyInto(samples, size, 0, n)
+            size += n
+            return n == frame.size
+        }
+
+        fun clip(): Clip = Clip(startedAt, endedAt, samples.copyOf(size)).also { wipe() }
+
+        fun wipe() {
+            samples.fill(0f)
+            size = 0
+        }
+    }
+
+    /** The noise floor now, in dB against full scale; null before the first frame. */
+    val floorDb: Float? get() = floor
+
+    /**
+     * Feeds one frame that ended at [endAt], and whether the VAD hears speech now ([speech]).
+     * Returns a clip once one has ended and was not speech, else null.
+     */
+    fun feed(frame: FloatArray, endAt: Long, speech: Boolean): Clip? {
+        val frameMillis = frame.size * 1000L / sampleRate
+        val db = Acoustics.levelDb(frame)
+        val f = floor
+        floor = when {
+            f == null -> db
+            db < f -> f + (db - f) * FLOOR_FALL
+            else -> f + FLOOR_RISE_DB_PER_SECOND * frameMillis / 1000f
+        }
+        val loud = db >= (f ?: db) + OVER_FLOOR_DB && db >= MIN_DB
+
+        if (speech) {
+            // The speech path has it, and what was gathered is part of it.
+            open?.wipe()
+            open = null
+            held?.wipe()
+            held = null
+            remember(frame)
+            return null
+        }
+
+        var out: Clip? = null
+        held?.let { h ->
+            if (endAt >= heldUntil) {
+                out = if (h.loudMillis >= MIN_LOUD_MILLIS) h.clip() else null.also { h.wipe() }
+                held = null
+            }
+        }
+
+        val o = open
+        if (o == null) {
+            if (loud && held == null) {
+                val b = Buffer(MAX_CLIP_MILLIS.toInt() * sampleRate / 1000 + pre.size + frame.size, endAt - frameMillis - preRollMillis())
+                b.add(preRoll())
+                b.add(frame)
+                b.endedAt = endAt
+                b.loudMillis = frameMillis
+                open = b
+                lastLoudAt = endAt
+            }
+        } else {
+            val fits = o.add(frame)
+            o.endedAt = endAt
+            if (loud) {
+                lastLoudAt = endAt
+                o.loudMillis += frameMillis
+            }
+            val quiet = endAt - lastLoudAt >= END_QUIET_MILLIS
+            if (quiet || !fits || endAt - o.startedAt >= MAX_CLIP_MILLIS) {
+                open = null
+                held = o
+                heldUntil = endAt + HOLD_MILLIS
+            }
+        }
+        remember(frame)
+        return out
+    }
+
+    /** Forgets everything (the ears paused or closed). */
+    fun reset() {
+        open?.wipe()
+        held?.wipe()
+        open = null
+        held = null
+        floor = null
+        pre.fill(0f)
+        preAt = 0
+        preFilled = 0
+    }
+
+    private fun remember(frame: FloatArray) {
+        for (x in frame) {
+            pre[preAt] = x
+            preAt = (preAt + 1) % pre.size
+        }
+        preFilled = min(pre.size, preFilled + frame.size)
+    }
+
+    private fun preRollMillis(): Long = preFilled * 1000L / sampleRate
+
+    private fun preRoll(): FloatArray {
+        val out = FloatArray(preFilled)
+        val from = (preAt - preFilled + pre.size) % pre.size
+        for (i in 0 until preFilled) out[i] = pre[(from + i) % pre.size]
+        return out
+    }
+
+    companion object {
+        /** How far over the noise floor a frame must be to be a sound. */
+        const val OVER_FLOOR_DB = 15f
+
+        /** Nothing quieter is a sound, however quiet the room. */
+        const val MIN_DB = -55f
+
+        const val FLOOR_FALL = 0.5f
+        const val FLOOR_RISE_DB_PER_SECOND = 0.5f
+
+        /** A clip ends after this much quiet. */
+        const val END_QUIET_MILLIS = 400L
+
+        /** Clips with less loud sound than this are let go. */
+        const val MIN_LOUD_MILLIS = 250L
+
+        /** A clip is cut here at the latest. */
+        const val MAX_CLIP_MILLIS = 4_000L
+
+        /** What came just before the first loud frame belongs to the sound. */
+        const val PRE_ROLL_MILLIS = 100L
+
+        /** A finished clip waits this long, and is let go if the VAD takes it for speech meanwhile. */
+        const val HOLD_MILLIS = 300L
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/TarReader.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/TarReader.kt
new file mode 100644
index 0000000..4ffef2b
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/TarReader.kt
@@ -0,0 +1,157 @@
+package com.opendroid.ai.core.life.ears
+
+import java.io.IOException
+import java.io.InputStream
+
+/**
+ * Reads the entries of a tar archive one after the other (ustar, with GNU long names and
+ * pax path records), for the model archives only. Nothing here writes a file: the caller
+ * takes the entries it wants by their exact names and stores them under names of its own,
+ * so a name in an archive can never reach a path outside the models' folder.
+ */
+class TarReader(private val input: InputStream) {
+
+    /** One entry: its name in the archive, its size, and whether it is a plain file. */
+    class Entry(val name: String, val size: Long, val isFile: Boolean)
+
+    private var left = 0L
+    private var padding = 0L
+    private val header = ByteArray(BLOCK)
+
+    /**
+     * The next entry, or null at the end of the archive. What was not read of the entry
+     * before is skipped.
+     */
+    fun next(): Entry? {
+        skip(left + padding)
+        left = 0
+        padding = 0
+        var longName: String? = null
+        while (true) {
+            if (!readBlock(header)) return null
+            if (header.all { it.toInt() == 0 }) return null
+            checkSum(header)
+            val type = header[156].toInt().toChar()
+            val size = number(header, 124, 12)
+            if (size < 0) throw IOException("Bad tar entry size")
+            val pad = (BLOCK - size % BLOCK) % BLOCK
+            when (type) {
+                'L', 'x' -> {
+                    // A long name (GNU) or a pax record for the next entry.
+                    if (size > MAX_META) throw IOException("Tar name record too long")
+                    val meta = ByteArray(size.toInt())
+                    readFully(meta)
+                    skip(pad)
+                    longName = if (type == 'L') {
+                        String(meta, Charsets.UTF_8).trimEnd('\u0000')
+                    } else {
+                        paxPath(meta) ?: longName
+                    }
+                    continue
+                }
+                'g' -> {
+                    skip(size + pad)
+                    continue
+                }
+            }
+            val name = longName ?: ustarName(header)
+            left = size
+            padding = pad
+            return Entry(name, size, type == '0' || type == '\u0000' || type == '7')
+        }
+    }
+
+    /** Reads from the current entry. -1 at its end. */
+    fun read(b: ByteArray, off: Int, len: Int): Int {
+        if (left <= 0) return -1
+        val n = input.read(b, off, minOf(len.toLong(), left).toInt())
+        if (n < 0) throw IOException("Tar archive ends inside an entry")
+        left -= n
+        return n
+    }
+
+    private fun ustarName(h: ByteArray): String {
+        val name = text(h, 0, 100)
+        val magic = text(h, 257, 6)
+        val prefix = if (magic.startsWith("ustar")) text(h, 345, 155) else ""
+        return if (prefix.isEmpty()) name else "$prefix/$name"
+    }
+
+    private fun paxPath(meta: ByteArray): String? {
+        // Records are "<length> <key>=<value>\n".
+        var at = 0
+        var path: String? = null
+        while (at < meta.size) {
+            var space = at
+            while (space < meta.size && meta[space] != ' '.code.toByte()) space++
+            val length = String(meta, at, space - at, Charsets.US_ASCII).toIntOrNull() ?: break
+            if (length <= 0 || at + length > meta.size) break
+            val record = String(meta, space + 1, at + length - space - 2, Charsets.UTF_8)
+            if (record.startsWith("path=")) path = record.removePrefix("path=")
+            at += length
+        }
+        return path
+    }
+
+    private fun text(h: ByteArray, off: Int, len: Int): String {
+        var end = off
+        while (end < off + len && h[end].toInt() != 0) end++
+        return String(h, off, end - off, Charsets.UTF_8)
+    }
+
+    private fun number(h: ByteArray, off: Int, len: Int): Long {
+        if (h[off].toInt() and 0x80 != 0) {
+            // Base-256, for sizes past what octal holds.
+            var v = (h[off].toLong() and 0x7f)
+            for (i in off + 1 until off + len) v = (v shl 8) or (h[i].toLong() and 0xff)
+            return v
+        }
+        val s = text(h, off, len).trim()
+        if (s.isEmpty()) return 0
+        return s.toLongOrNull(8) ?: throw IOException("Bad tar number")
+    }
+
+    private fun checkSum(h: ByteArray) {
+        val stored = number(h, 148, 8)
+        var sum = 0L
+        for (i in h.indices) sum += if (i in 148 until 156) ' '.code else h[i].toInt() and 0xff
+        if (sum != stored) throw IOException("Tar header checksum does not match")
+    }
+
+    private fun readBlock(b: ByteArray): Boolean {
+        var n = 0
+        while (n < b.size) {
+            val r = input.read(b, n, b.size - n)
+            if (r < 0) {
+                if (n == 0) return false
+                throw IOException("Tar archive ends inside a header")
+            }
+            n += r
+        }
+        return true
+    }
+
+    private fun readFully(b: ByteArray) {
+        var n = 0
+        while (n < b.size) {
+            val r = input.read(b, n, b.size - n)
+            if (r < 0) throw IOException("Tar archive ends early")
+            n += r
+        }
+    }
+
+    private fun skip(count: Long) {
+        var rest = count
+        val sink = ByteArray(8192)
+        while (rest > 0) {
+            val r = input.read(sink, 0, minOf(rest, sink.size.toLong()).toInt())
+            if (r < 0) throw IOException("Tar archive ends early")
+            rest -= r
+        }
+    }
+
+    private companion object {
+        const val BLOCK = 512
+        const val MAX_META = 64 * 1024L
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/VoiceEnrolment.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/VoiceEnrolment.kt
new file mode 100644
index 0000000..95f1c32
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/VoiceEnrolment.kt
@@ -0,0 +1,184 @@
+package com.opendroid.ai.core.life.ears
+
+import kotlin.math.sqrt
+
+/**
+ * His voice, as the speaker model hears it: the mean of the embeddings of the sentences he
+ * read, made unit length, and the model it was made with (an embedding from another model
+ * means nothing against it). Stored only sealed with the Keystore ([VoicePrintStore]).
+ */
+class VoicePrint(
+    val modelId: String,
+    val vector: FloatArray,
+    /** How many takes it was made of. */
+    val takes: Int,
+    /** The cosine at and above which a voice is his. */
+    val threshold: Float = DEFAULT_THRESHOLD,
+    /** How he usually sounds (level, pitch, pace), first from his takes, then as the ears learn it; null when not known. */
+    val usual: SoundUsual? = null,
+) {
+    /** The same print with [usual] as how he usually sounds. */
+    fun withUsual(usual: SoundUsual?): VoicePrint = VoicePrint(modelId, vector, takes, threshold, usual)
+
+    /** Whose [embedding] is, and how close it came. */
+    fun judge(embedding: FloatArray): Pair<Voice, Float> {
+        val s = VoiceMath.cosine(vector, embedding)
+        return (if (s >= threshold) Voice.HIM else Voice.OTHER) to s
+    }
+
+    override fun toString(): String = "VoicePrint($modelId, ${vector.size} dims, $takes takes)"
+
+    companion object {
+        /**
+         * Where his voice ends and another begins, for TitaNet-small. Measured on recorded
+         * English speech run through this app's pipeline, against a print made of three
+         * 5.5 s takes: the same speaker in another recording (narrowband, so a harder case
+         * than his own phone) scored 0.66 whole and 0.46 to 0.53 in 1.2 s pieces; ten other
+         * voices (her own voice among them) scored at most 0.24 whole and 0.28 in pieces of
+         * 0.8 s and up. Acted feelings are harder: on RAVDESS (eight actors, one sentence, one
+         * studio, each "enrolled" on four short neutral clips) strong anger or joy often fell
+         * under 0.4 against the actor's own print, and voices of the same sex scored up to 0.69
+         * against another's, so no lower bar is used for a raised voice. It is to be tuned on
+         * the phone (OWN_LIFE_PLAN phase 3, D8).
+         */
+        const val DEFAULT_THRESHOLD = 0.4f
+    }
+}
+
+/** The arithmetic of voiceprints. */
+object VoiceMath {
+    fun norm(v: FloatArray): Float {
+        var s = 0.0
+        for (x in v) s += x.toDouble() * x
+        return sqrt(s).toFloat()
+    }
+
+    /** [v] made unit length; a zero vector stays zero. */
+    fun unit(v: FloatArray): FloatArray {
+        val n = norm(v)
+        return if (n == 0f) v.copyOf() else FloatArray(v.size) { v[it] / n }
+    }
+
+    /** The cosine of the angle between [a] and [b]: 1 the same direction, 0 unrelated. */
+    fun cosine(a: FloatArray, b: FloatArray): Float {
+        require(a.size == b.size) { "embeddings of different sizes" }
+        val na = norm(a)
+        val nb = norm(b)
+        if (na == 0f || nb == 0f) return 0f
+        var dot = 0.0
+        for (i in a.indices) dot += a[i].toDouble() * b[i]
+        return (dot / (na * nb)).toFloat()
+    }
+
+    /** The mean direction of [vs]: each made unit length, averaged, and made unit length again. */
+    fun meanDirection(vs: List<FloatArray>): FloatArray {
+        require(vs.isNotEmpty())
+        val sum = FloatArray(vs[0].size)
+        for (v in vs) {
+            val u = unit(v)
+            for (i in sum.indices) sum[i] += u[i]
+        }
+        return unit(sum)
+    }
+}
+
+/**
+ * Enrolling his voice: he reads [sentences] ([SENTENCES]) aloud, one at a time (about 20 s in all), and
+ * each take is checked before it counts:
+ *
+ *  - at least [MIN_TAKE_MILLIS] of speech was heard;
+ *  - the phone's own recogniser heard most of the sentence ([MIN_SENTENCE_SHARE] of its
+ *    words), so that it was the sentence, read by someone, and not the room;
+ *  - from the second take on, the voice is the same as in the takes before
+ *    ([MIN_CONSISTENCY]).
+ *
+ * After the third, [result] is his [VoicePrint]. Pure: the takes are recorded and turned
+ * into embeddings by the engine ([SherpaPipeline.enrolTake]). Nothing of a take is kept but
+ * its embedding, and only until the print is made.
+ */
+class VoiceEnrolment(
+    private val modelId: String,
+    /** What he reads, in order. */
+    val sentences: List<String> = SENTENCES,
+) {
+
+    /** What came of one take. */
+    sealed class Take {
+        /** It counts. [next] is the sentence to read next, or null when all are read. */
+        data class Kept(val next: String?) : Take()
+
+        /** It does not count; [why] says what to do, and the same sentence is read again. */
+        data class Again(val why: String) : Take()
+    }
+
+    private val kept = ArrayList<FloatArray>()
+    private val measures = ArrayList<Pair<Acoustics.Measure, Int>>()
+
+    /** Which sentence is to be read now (0-based); [sentences].size when all are read. */
+    val step: Int get() = kept.size
+
+    /** The sentence to read now, or null when all are read. */
+    val sentence: String? get() = sentences.getOrNull(kept.size)
+
+    /**
+     * One take of [sentence]: the embedding of what was heard, how much speech that was, what
+     * the recogniser wrote down (null when it wrote nothing), and the phone's measures of it
+     * ([measure]), which begin his usual ([SoundUsual]).
+     */
+    fun take(embedding: FloatArray?, speechMillis: Long, transcript: String?, measure: Acoustics.Measure? = null): Take {
+        val wanted = sentence ?: return Take.Kept(null)
+        if (embedding == null || speechMillis < MIN_TAKE_MILLIS) return Take.Again(TOO_LITTLE)
+        if (sentenceShare(wanted, transcript.orEmpty()) < MIN_SENTENCE_SHARE) return Take.Again(NOT_THE_SENTENCE)
+        if (kept.isNotEmpty() && VoiceMath.cosine(VoiceMath.meanDirection(kept), embedding) < MIN_CONSISTENCY) {
+            return Take.Again(NOT_THE_SAME_VOICE)
+        }
+        kept += embedding.copyOf()
+        // What he read is counted as the sentence, not as the recogniser wrote it.
+        if (measure != null) measures += measure to HearingRules.words(wanted)
+        return Take.Kept(sentence)
+    }
+
+    /** His voiceprint, once every sentence was read, with how he sounded reading them; null before. */
+    fun result(): VoicePrint? =
+        if (kept.size < sentences.size) null else VoicePrint(modelId, VoiceMath.meanDirection(kept), kept.size, usual = SoundUsual.fromTakes(measures))
+
+    /** Starts over, and forgets the takes so far. */
+    fun restart() {
+        for (v in kept) v.fill(0f)
+        kept.clear()
+        measures.clear()
+    }
+
+    companion object {
+        /**
+         * What he reads: plain English, about 6 s each, with a range of sounds. The last one
+         * says her name, as he will when he talks to her.
+         */
+        val SENTENCES = listOf(
+            "The quick brown fox jumps over the lazy dog, and the dog does not seem to mind it at all.",
+            "On a cold morning I like a hot cup of coffee before I check my messages and head out the door.",
+            "Yume, tell me what you read about today, and what you thought of it while you were reading.",
+        )
+
+        /** Less speech than this in a take is too little to know a voice by. */
+        const val MIN_TAKE_MILLIS = 2_500L
+
+        /** How much of the sentence the recogniser must have heard. */
+        const val MIN_SENTENCE_SHARE = 0.5
+
+        /** How close a take's voice must be to the takes before it. */
+        const val MIN_CONSISTENCY = 0.45f
+
+        const val TOO_LITTLE = "The phone heard too little. Read the sentence again, a little closer to the phone."
+        const val NOT_THE_SENTENCE = "The phone did not hear the sentence. Read it again, as it is written."
+        const val NOT_THE_SAME_VOICE = "That did not sound like the same voice as before. Read it again, with nobody else talking."
+
+        /** How much of [sentence]'s words are in [heard]. */
+        fun sentenceShare(sentence: String, heard: String): Double {
+            val want = HearingRules.tokens(sentence).toSet()
+            if (want.isEmpty()) return 0.0
+            val got = HearingRules.tokens(heard).toSet()
+            return want.count { it in got }.toDouble() / want.size
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/ears/VoicePrintStore.kt b/app/src/main/java/com/opendroid/ai/core/life/ears/VoicePrintStore.kt
new file mode 100644
index 0000000..e0fdf45
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/ears/VoicePrintStore.kt
@@ -0,0 +1,171 @@
+package com.opendroid.ai.core.life.ears
+
+import android.content.Context
+import android.util.Log
+import com.opendroid.ai.core.security.AndroidKeyStoreAeadCipher
+import com.opendroid.ai.core.security.SecretAeadCipher
+import com.opendroid.ai.core.security.SecretEnvelope
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.Base64
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * His voiceprint ([VoicePrint]), sealed with a key that stays in the phone's Keystore, in
+ * the app's no-backup storage: one file, and nothing else of his enrolment (no take, no
+ * sound, no transcript). A file that cannot be opened reads as no print, and he enrols
+ * again.
+ */
+@Singleton
+class VoicePrintStore internal constructor(
+    private val directory: () -> File,
+    private val cipher: SecretAeadCipher,
+) {
+    @Inject
+    constructor(@ApplicationContext context: Context) : this(
+        { File(context.noBackupFilesDir, DIRECTORY) },
+        AndroidKeyStoreAeadCipher(KEY_ALIAS),
+    )
+
+    private val lock = Mutex()
+    @Volatile private var held: VoicePrint? = null
+    @Volatile private var read = false
+
+    private val file: File get() = File(directory(), FILE)
+
+    /** His print, or null when none is enrolled (or it cannot be opened now). */
+    suspend fun get(): VoicePrint? = work { readLocked() }
+
+    /** The print as last read or saved, without touching the disk; null before the first read. */
+    fun cached(): VoicePrint? = held
+
+    /** Keeps [print] as his, in place of any before. */
+    suspend fun save(print: VoicePrint): Boolean = work { saveLocked(print) }
+
+    // Called under the lock.
+    private fun saveLocked(print: VoicePrint): Boolean =
+        try {
+            val folder = directory()
+            if (!folder.isDirectory && !folder.mkdirs()) throw IOException("The directory could not be made")
+            val plain = JSON.encodeToString(Sealed.serializer(), Sealed(print.modelId, print.takes, print.threshold, encode(print.vector), print.usual?.let { sealUsual(it) }))
+            val sealed = SecretEnvelope.encode(cipher.encrypt(plain.toByteArray(Charsets.UTF_8), AAD))
+            val draft = File(folder, "$FILE.tmp")
+            try {
+                FileOutputStream(draft).use { out ->
+                    out.write(sealed.toByteArray(Charsets.UTF_8))
+                    out.fd.sync()
+                }
+                if (!draft.renameTo(file)) throw IOException("The file could not be put in place")
+            } finally {
+                draft.delete()
+            }
+            held = print
+            read = true
+            true
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "His voiceprint could not be kept: ${e.javaClass.simpleName}")
+            false
+        }
+
+    /** Forgets his voice. */
+    suspend fun forget() = work {
+        held = null
+        read = true
+        if (file.exists() && !file.delete()) throw IOException("His voiceprint could not be removed")
+    }
+
+    private suspend fun <T> work(block: () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }
+
+    private fun readLocked(): VoicePrint? {
+        if (read) return held
+        val target = file
+        val print = try {
+            if (!target.isFile) null else {
+                val envelope = SecretEnvelope.decode(target.readText().trim()) ?: throw IOException("Not a sealed file")
+                val plain = cipher.decrypt(envelope.iv, envelope.ciphertext, AAD)
+                val s = JSON.decodeFromString(Sealed.serializer(), String(plain, Charsets.UTF_8))
+                VoicePrint(s.model, decode(s.vector), s.takes, s.threshold, s.usual?.let { openUsual(it) })
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "His voiceprint could not be read: ${e.javaClass.simpleName}")
+            return null
+        }
+        held = print
+        read = true
+        return print
+    }
+
+    /**
+     * Keeps how he usually sounds with his print, as the ears learned it. Nothing is kept
+     * when no print is (or a print of another model is): the usual belongs to the print. With
+     * [of], the print the ears learned it with, nothing is kept either when the print kept now
+     * is another (he enrolled again). The read and the save are one step under the lock, so
+     * that "Forget my voice" or a new enrolment that comes in between is never undone.
+     */
+    suspend fun keepUsual(modelId: String, usual: SoundUsual, of: VoicePrint? = null): Boolean = work {
+        val print = readLocked() ?: return@work false
+        if (print.modelId != modelId) return@work false
+        if (of != null && (of.modelId != print.modelId || !of.vector.contentEquals(print.vector))) return@work false
+        saveLocked(print.withUsual(usual.copy()))
+    }
+
+    @Serializable
+    private data class Sealed(
+        val model: String,
+        val takes: Int,
+        val threshold: Float,
+        val vector: String,
+        val usual: Usual? = null,
+    )
+
+    @Serializable
+    private data class Usual(
+        val level: Float,
+        val pitch: Float? = null,
+        val spread: Float? = null,
+        val bright: Float? = null,
+        val rates: Map<String, Float> = emptyMap(),
+        val learned: Int,
+    )
+
+    private fun sealUsual(u: SoundUsual): Usual? =
+        if (u.learned == 0) null else Usual(u.levelDb, u.pitchSemitones, u.pitchSpread, u.brightnessDb, u.rates(), u.learned)
+
+    private fun openUsual(u: Usual): SoundUsual = SoundUsual(u.level, u.pitch, u.spread, u.bright, u.rates, u.learned)
+
+    companion object {
+        private const val TAG = "VoicePrintStore"
+        private const val DIRECTORY = "ears"
+        private const val FILE = "voiceprint.sealed"
+        private const val KEY_ALIAS = "opendroid.persona_voiceprint.aes_gcm.v1"
+        private val AAD = "persona-voiceprint".toByteArray(Charsets.UTF_8)
+        private val JSON = Json { ignoreUnknownKeys = true }
+
+        internal fun encode(v: FloatArray): String {
+            val b = ByteBuffer.allocate(v.size * 4).order(ByteOrder.LITTLE_ENDIAN)
+            for (x in v) b.putFloat(x)
+            return Base64.getEncoder().encodeToString(b.array())
+        }
+
+        internal fun decode(s: String): FloatArray {
+            val b = ByteBuffer.wrap(Base64.getDecoder().decode(s)).order(ByteOrder.LITTLE_ENDIAN)
+            return FloatArray(b.remaining() / 4) { b.getFloat() }
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/eyes/CameraLook.kt b/app/src/main/java/com/opendroid/ai/core/life/eyes/CameraLook.kt
new file mode 100644
index 0000000..e023719
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/eyes/CameraLook.kt
@@ -0,0 +1,464 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingRules
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.data.models.CameraBounds
+import com.opendroid.ai.data.models.CameraWhich
+import com.opendroid.ai.data.models.LLMConfig
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her camera looks (OWN_LIFE_PLAN phase 2), as rules: when one is offered and when one may
+ * begin, which cameras a look takes, whether a frame is too dark to be worth her eyes, and
+ * what she is shown of what came of it. Pure: the phone's state is passed in.
+ *
+ * A look is a `go: look [back | front | around]` line in a moment of hers, never a verb of a
+ * step: nothing she reads on an outing can reach the camera. It runs only while his screen is
+ * on and unlocked (so Android's camera light is seen), while she is awake, with no call going
+ * on, no other app holding a camera, the battery at [BATTERY_PERCENT] or more and the phone not
+ * too hot, with [OwnLedger.Start.STEP] calls on her own left, with looks left today and with
+ * the service holding the camera type. His talk, Stop, his screen going off and a call call
+ * it off while it runs (§1.1).
+ */
+object CameraLook {
+
+    /** The phone as a look needs it, read at once, without waiting: it is asked again at every frame while the camera settles. */
+    data class Phone(
+        val screenOn: Boolean,
+        val unlocked: Boolean,
+        val inCall: Boolean,
+        val cameraInUse: Boolean,
+        val batteryPercent: Int,
+        val thermalStatus: Int
+    )
+
+    /** The look as a moment of hers is offered it: [left] looks today, the front camera too with [frontToo]. */
+    data class Offer(
+        val frontToo: Boolean,
+        val left: Int,
+        /** He is told each time she looks ([LLMConfig.personaCameraTellMe]). */
+        val tellsHim: Boolean,
+        /** His screen is off or locked right now, so a look now would be refused. */
+        val screenOff: Boolean,
+        /** The phone has a hinge: how it is folded changes which camera faces him. */
+        val foldable: Boolean = true,
+        /** She looks with her own eyes: the frame comes to her own model, after the age check ([HerSight]). */
+        val ownEyes: Boolean = false
+    )
+
+    /** Why a look does not begin now; [words] are what she is told. */
+    enum class Refusal(val words: String) {
+        SCREEN_OFF("his screen was off or locked: a look happens only while his screen is on, so he can see the camera light"),
+        CALL("a phone call was going on"),
+        TALKING("he was talking to you"),
+        POWER("the phone's battery was under $BATTERY_PERCENT% or it was too hot"),
+        CALLS_LOW("fewer than $CALLS_NEEDED of his calls on your own were left"),
+        USED_UP("no camera looks were left today"),
+        IN_USE("another app was using the camera")
+    }
+
+    /** A look needs the battery at this or more. */
+    const val BATTERY_PERCENT = 20
+
+    /** A look needs this many calls on her own left: her eyes and her moment of looking. */
+    const val CALLS_NEEDED = 10
+
+    /**
+     * Why a look may not begin as things stand, or null when it may: his screen off or locked,
+     * a call, his talk, the battery or the heat, too few calls on her own ([callsLeft] null:
+     * the ledger cannot be read), no looks left today ([left]), another app on a camera.
+     */
+    fun refusal(phone: Phone, talking: Boolean, callsLeft: Int?, left: Int): Refusal? = when {
+        !phone.screenOn || !phone.unlocked -> Refusal.SCREEN_OFF
+        phone.inCall -> Refusal.CALL
+        talking -> Refusal.TALKING
+        powerLow(phone) -> Refusal.POWER
+        callsLeft == null || callsLeft < CALLS_NEEDED -> Refusal.CALLS_LOW
+        left <= 0 -> Refusal.USED_UP
+        phone.cameraInUse -> Refusal.IN_USE
+        else -> null
+    }
+
+    /** The battery under [BATTERY_PERCENT], or the phone at THERMAL_STATUS_SEVERE or hotter. */
+    fun powerLow(phone: Phone): Boolean =
+        phone.batteryPercent in 0 until BATTERY_PERCENT || phone.thermalStatus >= OutingRules.THERMAL_SEVERE
+
+    /** His number of camera looks in any 24 hours. */
+    fun perDay(config: LLMConfig): Int = config.personaCameraPerDay.coerceIn(0, CameraBounds.MAX_PER_DAY)
+
+    /** The front camera, toward him, is his to allow. */
+    fun frontToo(config: LLMConfig): Boolean = config.personaCameraWhich == CameraWhich.FRONT_AND_BACK
+
+    /** The log's count of frames taken through a camera on a look: what his number of looks a day counts. */
+    const val CAMERA_LOOKS = "camera looks"
+
+    /** The log's count of frames too dark or too flat for her eyes. */
+    const val TOO_DARK = "frames too dark"
+
+    /** The log's category of a look a camera could not take, by why ([Shot.Fail]). */
+    const val CAMERA_PREFIX = "camera:"
+
+    /** The camera looks of the 24 hours before [nowMillis], from her log. */
+    fun usedToday(entries: List<HerLog.Entry>, nowMillis: Long): Int =
+        entries.filter { it.kind == HerLog.Kind.LOOK && it.startedAt > nowMillis - OwnLedger.WINDOW_MILLIS && it.startedAt <= nowMillis }
+            .sumOf { it.counts[CAMERA_LOOKS] ?: 0 }
+
+    /** The pictures her eyes looked at through a camera in the 24 hours before [nowMillis], for the status card. */
+    fun describedToday(entries: List<HerLog.Entry>, nowMillis: Long, picturesKey: String): Int =
+        entries.filter { it.kind == HerLog.Kind.LOOK && it.startedAt > nowMillis - OwnLedger.WINDOW_MILLIS && it.startedAt <= nowMillis }
+            .sumOf { it.counts[picturesKey] ?: 0 }
+
+    // ── Which cameras ────────────────────────────────────────────────────────────────
+
+    /** The ways a look at [at] faces, in order: `around` is the back, then the front where he allows it. */
+    fun sides(at: OutingKind.LookAt, frontToo: Boolean): List<FoldState.Side> = when (at) {
+        OutingKind.LookAt.BACK -> listOf(FoldState.Side.BACK)
+        OutingKind.LookAt.FRONT -> listOf(FoldState.Side.FRONT)
+        OutingKind.LookAt.AROUND -> if (frontToo) listOf(FoldState.Side.BACK, FoldState.Side.FRONT) else listOf(FoldState.Side.BACK)
+    }
+
+    /** The cameras a look takes, or why it takes none. */
+    sealed class Plan {
+        data class Takes(val uses: List<FoldState.Pick.Use>) : Plan()
+        data class Refused(val why: FoldState.Refusal) : Plan()
+    }
+
+    /**
+     * The cameras a look at [at] takes as the phone stands ([posture]): for each way it faces,
+     * the camera that faces that way ([FoldState.pick]). A way no camera faces is left out of
+     * `around`; a look with no camera at all is refused with the first reason.
+     */
+    fun plan(at: OutingKind.LookAt, posture: FoldState.Posture, frontToo: Boolean): Plan {
+        val picks = sides(at, frontToo).map { FoldState.pick(posture, it, frontToo) }
+        val uses = picks.filterIsInstance<FoldState.Pick.Use>().distinctBy { it.lens }
+        if (uses.isNotEmpty()) return Plan.Takes(uses)
+        val refused = picks.filterIsInstance<FoldState.Pick.Refused>().firstOrNull()?.why ?: FoldState.Refusal.UNKNOWN
+        return Plan.Refused(refused)
+    }
+
+    /** What the cameras of a look are called in the log and in his notification: "back camera", "back and front cameras". */
+    fun where(uses: List<FoldState.Pick.Use>): String = when (uses.size) {
+        0 -> "camera"
+        1 -> uses.single().words
+        else -> uses.joinToString(" and ") { it.words.removeSuffix(" camera") } + " cameras"
+    }
+
+    /**
+     * What he is asked to let her look through, where his settings ask him first: "the back
+     * camera"; a camera that faces him says so; `around` names both, one picture each.
+     */
+    fun askWords(uses: List<FoldState.Pick.Use>): String = when (uses.size) {
+        0 -> "the phone's camera"
+        1 -> facing(uses.single())
+        else -> uses.joinToString(" and then ") { facing(it) } + " (one picture each)"
+    }
+
+    private fun facing(use: FoldState.Pick.Use): String = "the " + use.words + when {
+        use.words == FoldState.OUTER_CAMERA -> ", which faces you while the phone is folded"
+        use.side == FoldState.Side.FRONT -> ", which faces you"
+        else -> ""
+    }
+
+    /** How far a frame is turned to stand upright with the screen turned [displayDegrees] (as CameraX works it out). */
+    fun uprightDegrees(sensorDegrees: Int, displayDegrees: Int, front: Boolean): Int =
+        if (front) (sensorDegrees + displayDegrees) % 360 else (sensorDegrees - displayDegrees + 360) % 360
+
+    // ── The light ────────────────────────────────────────────────────────────────────
+
+    /** Under this mean luma (0 to 255) a frame is too dark: the phone is face down or in a pocket. */
+    const val DARK_MEAN = 12
+
+    /** Under this spread of luma a frame is one flat colour: the lens is covered. */
+    const val FLAT_SPREAD = 4
+
+    /** How a frame is lit: its mean luma and how far its pixels spread around it (the standard deviation). */
+    data class Light(val mean: Int, val spread: Int) {
+        /** Too dark to be worth a look. */
+        val dark: Boolean get() = mean < DARK_MEAN
+
+        /** One flat colour, the lens covered. */
+        val blank: Boolean get() = !dark && spread < FLAT_SPREAD
+
+        companion object {
+            fun of(lumas: IntArray): Light {
+                if (lumas.isEmpty()) return Light(0, 0)
+                val mean = lumas.sum().toDouble() / lumas.size
+                val variance = lumas.sumOf { (it - mean) * (it - mean) } / lumas.size
+                return Light(Math.round(mean).toInt(), Math.round(Math.sqrt(variance)).toInt())
+            }
+        }
+    }
+
+    /** The luma of one ARGB pixel (BT.601). */
+    fun luma(argb: Int): Int {
+        val r = (argb shr 16) and 0xff
+        val g = (argb shr 8) and 0xff
+        val b = argb and 0xff
+        return (299 * r + 587 * g + 114 * b) / 1000
+    }
+
+    // ── What came of it ──────────────────────────────────────────────────────────────
+
+    /** What came of one camera of a look. */
+    sealed class Result {
+        /**
+         * Her eyes described it: [words] without the `ages:` line, what that line said
+         * ([ages]), and the kid flag of the frame ([KidGuard.flagOfPicture]) where it is one.
+         */
+        data class Described(
+            val words: String,
+            val ages: KidGuard.Ages,
+            val cutOff: Boolean,
+            val kid: KidGuard.Flag?,
+            /** Who looked: the describer, or the age check on her own model. */
+            val seer: String = KidGuard.DESCRIBER
+        ) : Result()
+
+        /**
+         * She sees it herself: her brain sees, and the age check found no child and no teen in
+         * it. The frame, made ready, goes with her moment of looking; in memory only (I6).
+         */
+        class Shown(val jpegBase64: String) : Result() {
+            override fun toString(): String = "Shown"
+        }
+
+        /** Too dark ([near]: the screen was covered before a camera was opened). No call went out for it. */
+        data class Dark(val near: Boolean) : Result()
+
+        /** One flat colour: the lens was covered. No call went out for it. */
+        data object Blank : Result()
+
+        /** Taken, and her eyes did not describe it. */
+        data class NotSeen(val why: HerEyes.Why) : Result()
+
+        /** No frame. */
+        data class Failed(val why: Shot.Fail) : Result()
+    }
+
+    /** One camera of a look: which one, when, whether a frame was taken through it, and what came of it. */
+    data class Frame(val use: FoldState.Pick.Use, val atMillis: Long, val taken: Boolean, val result: Result)
+
+    /** A whole look: its frames in order; [stopped] when it was called off before the end. */
+    data class Looked(val frames: List<Frame>, val stopped: Boolean)
+
+    /** Whether her words about a frame may be shown to her: described, no kid in it, and the ages read. */
+    fun shows(result: Result): Boolean =
+        result is Result.Shown || (result is Result.Described && result.kid == null && result.ages is KidGuard.Ages.Read)
+
+    /** The frames of [looked] she sees herself, for the turn of her moment of looking. */
+    fun shownFrames(looked: Looked): List<String> = looked.frames.mapNotNull { (it.result as? Result.Shown)?.jpegBase64 }
+
+    /**
+     * Whether a look is worth a moment of looking (one more call of hers): something was
+     * described that she can be told of, words or a kid.
+     */
+    fun worthAMoment(looked: Looked): Boolean =
+        !looked.stopped && looked.frames.any { shows(it.result) || (it.result as? Result.Described)?.kid != null }
+
+    /** Whether a kid was in front of her on this look: the kept-line check runs in its moment. */
+    fun metKid(looked: Looked): Boolean = looked.frames.any { (it.result as? Result.Described)?.kid != null }
+
+    /**
+     * One frame in WHAT YOU SAW (P2-3): "you looked through the back camera at 14:02. the
+     * describer wrote: "<words>." the picture is gone." A camera that faces him says so. A
+     * frame with a child or a teen in it is shown as kid, without the describer's words; a
+     * description without a readable `ages:` line is not shown either.
+     */
+    fun saw(frame: Frame, clock: String, fenced: (String) -> String): String = buildString {
+        append("you looked through the ").append(frame.use.words)
+        // The front camera, and the outer one of a folded phone, face him: what it shows is likely him.
+        if (frame.use.side == FoldState.Side.FRONT) append(", which faces him,")
+        append(" at ").append(clock).append(". ")
+        var sent = false
+        when (val result = frame.result) {
+            is Result.Shown -> {
+                sent = true
+                append(SHOWN_WORDS)
+            }
+            is Result.Described -> {
+                sent = true
+                when {
+                    result.kid != null && result.seer == KidGuard.AGE_CHECK ->
+                        append("kid: the app marks what you saw kid (").append(fenced(result.kid.why))
+                            .append("), so it does not show it to you.")
+                    result.kid != null ->
+                        append("kid: the app marks what you saw kid (").append(fenced(result.kid.why))
+                            .append("), so it does not show you the describer's words.")
+                    result.ages !is KidGuard.Ages.Read && result.seer == KidGuard.AGE_CHECK ->
+                        append("${KidGuard.NO_AGES_CHECKED}, so the app does not show it to you.")
+                    result.ages !is KidGuard.Ages.Read ->
+                        append("${KidGuard.NO_AGES}, so the app does not show you its words.")
+                    else -> {
+                        // The describer's words in quotes, so that where they end and the app's begin is plain.
+                        val words = fenced(result.words.replace(Regex("""\s*\n\s*"""), " ").trim().trimEnd('.').replace('"', '\''))
+                        append("the describer wrote: \"").append(words).append(".\"")
+                        if (result.cutOff) append(" (its words were cut off.)")
+                    }
+                }
+            }
+            is Result.Dark -> append(DARK_WORDS).append(" no picture went to the describer.")
+            Result.Blank -> append(BLANK_WORDS).append(" no picture went to the describer.")
+            is Result.NotSeen -> {
+                sent = true
+                append("it was not described: ").append(result.why.words).append('.')
+            }
+            is Result.Failed -> append("no picture was taken: ").append(result.why.words).append('.')
+        }
+        // Said once a picture went to the describer; a frame that went nowhere says so already.
+        append(if (frame.taken && sent) (if (frame.result is Result.Shown) " it is gone after this moment." else " the picture is gone.") else "")
+    }
+
+    /** A frame she sees herself, said to her in WHAT YOU SAW. */
+    const val SHOWN_WORDS = "you see it yourself: the frame is attached to this moment, as the camera took it."
+
+    /** A dark frame, or the screen covered, said to her. */
+    const val DARK_WORDS = "too dark: the phone is probably face down or in a pocket."
+
+    /** A flat frame said to her. */
+    const val BLANK_WORDS = "one flat colour: the camera was probably covered."
+
+    /**
+     * Why a look came to nothing she could be shown, in a few words for her next moment, or
+     * empty when it came to something. The app's own words: never the describer's.
+     */
+    fun unseen(looked: Looked): String {
+        if (looked.frames.any { shows(it.result) || (it.result as? Result.Described)?.kid != null }) return ""
+        val result = looked.frames.lastOrNull()?.result ?: return ""
+        return when (result) {
+            is Result.Shown -> ""
+            is Result.Described -> "${KidGuard.noAges(result.seer)}, so its words were not shown"
+            is Result.Dark -> DARK_WORDS.trimEnd('.') + "; no eyes call was spent"
+            Result.Blank -> BLANK_WORDS.trimEnd('.') + "; no eyes call was spent"
+            is Result.NotSeen -> "it was not described: " + result.why.words
+            is Result.Failed -> "no picture was taken: " + result.why.words
+        }
+    }
+}
+
+/**
+ * What the host of her outings asks of her camera looks: whether they are offered, the phone
+ * as a look needs it, which cameras a look takes, and the look itself. The host runs a look
+ * from a `go:` line of a moment of hers; a step of an outing has no way here.
+ */
+interface Looks {
+    /** The look as a moment of hers is offered it now, or null when it is not offered at all. */
+    fun offer(config: LLMConfig, nowMillis: Long): CameraLook.Offer?
+
+    /** The phone now, read without waiting. */
+    fun phone(): CameraLook.Phone
+
+    /** The cameras a look at [at] takes as the phone stands now. */
+    suspend fun plan(config: LLMConfig, at: OutingKind.LookAt): CameraLook.Plan
+
+    /**
+     * One look through [uses], in order: each frame taken in memory, too dark or flat ones
+     * left there, the others described by her eyes; every frame zeroed once it is done with.
+     * [keepGoing] is asked between the steps and at every frame while a camera settles: false
+     * calls the look off. [taken] is told each frame as it is taken, by the camera's words.
+     */
+    suspend fun look(uses: List<FoldState.Pick.Use>, keepGoing: () -> Boolean, taken: suspend (String) -> Unit): CameraLook.Looked
+}
+
+/** Her camera looks as the app has them: her eyes, her camera, the fold of the phone, the service's camera type and her log. */
+@Singleton
+class HerLooks internal constructor(
+    private val eyes: Eyes,
+    private val shutter: Shutter,
+    private val phoneNow: () -> CameraLook.Phone,
+    private val posture: suspend () -> FoldState.Posture,
+    private val near: suspend () -> Boolean?,
+    private val ready: () -> Boolean,
+    private val armed: () -> Boolean,
+    private val log: HerLog,
+    private val clock: () -> Long,
+    /** The phone has a hinge ([FoldState.foldable]). */
+    private val foldable: () -> Boolean = { true }
+) : Looks {
+
+    @Inject
+    constructor(eyes: HerSight, camera: HerCamera, fold: FoldState, arm: CameraArm, log: HerLog) : this(
+        eyes = eyes,
+        shutter = camera,
+        phoneNow = camera::phone,
+        posture = fold::posture,
+        near = camera::near,
+        ready = camera::ready,
+        armed = { arm.held.value },
+        log = log,
+        clock = System::currentTimeMillis,
+        foldable = fold::foldable
+    )
+
+    override fun offer(config: LLMConfig, nowMillis: Long): CameraLook.Offer? {
+        if (!config.personaCameraLooks || !ready() || !armed() || !eyes.open(config, nowMillis)) return null
+        val phone = phoneNow()
+        return CameraLook.Offer(
+            frontToo = CameraLook.frontToo(config),
+            left = leftToday(config, nowMillis),
+            tellsHim = config.personaCameraTellMe,
+            screenOff = !phone.screenOn || !phone.unlocked,
+            foldable = foldable(),
+            ownEyes = eyes.ownEyes(config)
+        )
+    }
+
+    /** The camera looks left in the 24 hours before [nowMillis] under his number. */
+    fun leftToday(config: LLMConfig, nowMillis: Long): Int =
+        (CameraLook.perDay(config) - CameraLook.usedToday(log.entries(), nowMillis)).coerceAtLeast(0)
+
+    override fun phone(): CameraLook.Phone = phoneNow()
+
+    override suspend fun plan(config: LLMConfig, at: OutingKind.LookAt): CameraLook.Plan =
+        CameraLook.plan(at, posture(), CameraLook.frontToo(config))
+
+    override suspend fun look(
+        uses: List<FoldState.Pick.Use>,
+        keepGoing: () -> Boolean,
+        taken: suspend (String) -> Unit
+    ): CameraLook.Looked {
+        val frames = ArrayList<CameraLook.Frame>()
+        for (use in uses) {
+            if (!keepGoing()) return CameraLook.Looked(frames, stopped = true)
+            // Covered in front of the screen: no camera is opened, and no call goes out.
+            if (near() == true) {
+                frames += CameraLook.Frame(use, clock(), taken = false, result = CameraLook.Result.Dark(near = true))
+                continue
+            }
+            if (!keepGoing()) return CameraLook.Looked(frames, stopped = true)
+            when (val shot = shutter.take(use.lens, keepGoing)) {
+                is Shot.Failed -> {
+                    if (shot.why == Shot.Fail.STOPPED) return CameraLook.Looked(frames, stopped = true)
+                    frames += CameraLook.Frame(use, clock(), taken = false, result = CameraLook.Result.Failed(shot.why))
+                }
+                is Shot.Taken -> try {
+                    val at = clock()
+                    taken(use.words)
+                    when {
+                        shot.light.dark -> frames += CameraLook.Frame(use, at, taken = true, result = CameraLook.Result.Dark(near = false))
+                        shot.light.blank -> frames += CameraLook.Frame(use, at, taken = true, result = CameraLook.Result.Blank)
+                        // Called off after the frame was taken: it goes to nobody.
+                        !keepGoing() -> {
+                            frames += CameraLook.Frame(use, at, taken = true, result = CameraLook.Result.Failed(Shot.Fail.STOPPED))
+                            return CameraLook.Looked(frames, stopped = true)
+                        }
+                        else -> frames += CameraLook.Frame(use, at, taken = true, result = described(eyes.describe(shot.jpeg, Describe.Source.CAMERA), at))
+                    }
+                } finally {
+                    shot.jpeg.fill(0)
+                }
+            }
+        }
+        return CameraLook.Looked(frames, stopped = false)
+    }
+
+    private fun described(seen: HerEyes.Seen, atMillis: Long): CameraLook.Result = when (seen) {
+        is HerEyes.Seen.Described ->
+            CameraLook.Result.Described(seen.words, seen.ages, seen.cutOff, KidGuard.flagOfPicture(seen.words, seen.ages, atMillis, seen.seer), seen.seer)
+        is HerEyes.Seen.Shown -> CameraLook.Result.Shown(seen.jpegBase64)
+        is HerEyes.Seen.NotSeen -> CameraLook.Result.NotSeen(seen.why)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/eyes/Describe.kt b/app/src/main/java/com/opendroid/ai/core/life/eyes/Describe.kt
new file mode 100644
index 0000000..4fbb8de
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/eyes/Describe.kt
@@ -0,0 +1,114 @@
+package com.opendroid.ai.core.life.eyes
+
+/**
+ * What the describer is told: one neutral instruction for each kind of picture, and one
+ * short neutral line beside the picture itself (P2-4). Constants, with no persona, no names
+ * and nothing about whose picture it is or who will read the words: a describer request
+ * holds exactly one picture and one of these instructions, and nothing else (I5).
+ *
+ * Every instruction opens with [SHARED] and ends with [AGES], the request for the `ages:`
+ * line the code reads ([com.opendroid.ai.core.life.KidGuard.ages]): the age groups of the
+ * people shown, so that kid protection (§1.4) sees when a child or a teen is present. A
+ * description without it counts as unchecked.
+ */
+object Describe {
+
+    /** What a picture is, for the instruction it gets. */
+    enum class Source {
+        /** A picture in a page she opened: a Wikipedia lead picture, a page's `og:image`. */
+        PAGE_IMAGE,
+
+        /** A picture of an item in a feed or a list: a news thumbnail, a video thumbnail, a search result's picture. */
+        FEED_IMAGE,
+
+        /** One frame of a short video in an app. */
+        VIDEO_FRAME,
+
+        /** A phone screen of hers. */
+        SCREEN,
+
+        /** A photo from the phone's camera. */
+        CAMERA,
+
+        /** A picture someone gave her: one he sent in the chat, or one of her own pictures. */
+        PHOTO
+    }
+
+    /** The rule every instruction opens with. */
+    const val SHARED =
+        "You describe images for a reader who cannot see them. Plain prose. Never name anyone or guess who they are. " +
+            "For people: apparent age group (child under 13, teen 13 to 17, adult 18 or older), expression, pose and clothing in general terms. " +
+            "Copy visible text exactly, at most 200 characters. No opinions, advice or warnings."
+
+    /** The request every instruction ends with: the line the code reads for kid protection. */
+    const val AGES =
+        "End with one line: ages: none when no person is shown, or the apparent age groups shown, " +
+            "from child (under 13), teen (13 to 17) and adult (18 or older; young adults count as adults; when you cannot tell whether someone is 18 or older, say teen), for example ages: teen, adult."
+
+    const val PAGE_IMAGE = "$SHARED Describe this image: what is in it, the setting and the style. 3 to 6 sentences. $AGES"
+
+    const val FEED_IMAGE = PAGE_IMAGE
+
+    const val VIDEO_FRAME =
+        "$SHARED This is one frame of a short video in an app. Describe what is happening and any captions. 3 to 5 sentences. $AGES"
+
+    const val SCREEN =
+        "$SHARED This is a phone screen. Name the kind of app if it is clear, give the visible text in reading order, " +
+            "and describe pictures and thumbnails briefly. $AGES"
+
+    const val CAMERA = "$SHARED This is a photo from a phone camera. Describe what is visible, the light and the objects. 3 to 5 sentences. $AGES"
+
+    const val PHOTO = "$SHARED This is a photo someone shared. Describe what is in it, the setting, the light and the style. 3 to 6 sentences. $AGES"
+
+    /**
+     * The age check alone, for a picture that goes to her own model as it is (her brain sees,
+     * [HerSight]): the model is asked first, with nothing but this and the picture, which age
+     * groups are shown, and the picture reaches her as content only when no child and no teen
+     * is (§1.4). It asks for no description, so nothing of the picture is said before she sees it.
+     */
+    const val AGES_ONLY =
+        "You check images for one thing only: the apparent age groups of the people shown. Never name anyone or guess " +
+            "who they are, and do not describe the image. Answer with one line and nothing else: ages: none when no " +
+            "person is shown, or the apparent age groups shown, from child (under 13), teen (13 to 17) and adult (18 or older; young adults count as adults; when you cannot tell whether someone is 18 or older, say teen), for example ages: teen, adult."
+
+    /** The line beside the picture in the age check's user turn. */
+    const val AGES_TURN = "Which age groups are shown? Answer with the ages: line only."
+
+    /**
+     * The age check of a picture just made of her, before it is shown or kept
+     * (MadePictureCheck, beside her engine). It asks for the ages line and a few
+     * words of what the age is judged from, so that those words are read too
+     * ([com.opendroid.ai.core.life.KidGuard.flagOfPicture]): a school uniform, a child's body.
+     * Like the others it names no one and says nothing of whose picture it is.
+     */
+    const val MADE_CHECK =
+        "You check images for one thing only: how old the people shown look. Never name anyone or guess who they are. " +
+            "Answer with two lines and nothing else. First line, looks: what the apparent age of each person shown is judged " +
+            "from (face, body proportions, clothing, setting), at most 25 words; say only what is there, never what is not, " +
+            "and name only age groups that are shown. " +
+            "Second line, ages: none when no person is shown, or the apparent age groups shown, from child (under 13), " +
+            "teen (13 to 17) and adult (18 or older; young adults count as adults; when you cannot tell whether someone is 18 or older, say teen), " +
+            "for example ages: teen, adult."
+
+    /** The line beside the picture in the made-picture check's user turn. */
+    const val MADE_CHECK_TURN = "How old do the people shown look? Answer with the looks: line and the ages: line only."
+
+    /**
+     * The one line that stands beside the picture in the request's user turn. A request has
+     * to have a turn, and this one says nothing but what to do with the picture.
+     */
+    const val TURN = "Describe the image as instructed, and end with the ages: line."
+
+    /** Every instruction there is, for the tests that read them all. */
+    val ALL: List<String> = listOf(PAGE_IMAGE, FEED_IMAGE, VIDEO_FRAME, SCREEN, CAMERA, PHOTO)
+
+    /** The instruction for a picture of [source]. */
+    fun instruction(source: Source): String = when (source) {
+        Source.PAGE_IMAGE -> PAGE_IMAGE
+        Source.FEED_IMAGE -> FEED_IMAGE
+        Source.VIDEO_FRAME -> VIDEO_FRAME
+        Source.SCREEN -> SCREEN
+        Source.CAMERA -> CAMERA
+        Source.PHOTO -> PHOTO
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesImage.kt b/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesImage.kt
new file mode 100644
index 0000000..fb91954
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesImage.kt
@@ -0,0 +1,164 @@
+package com.opendroid.ai.core.life.eyes
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import java.io.ByteArrayOutputStream
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * A picture made ready for the describer, in memory only (I6): decoded, scaled down to at
+ * most [MAX_SIDE] pixels on its long side, and encoded again as JPEG at quality
+ * [JPEG_QUALITY], which leaves its metadata (EXIF, a place, a camera) behind. A picture
+ * under [MIN_SIDE] on either side, an SVG, and anything that is not a picture are skipped
+ * before anything is sent. Nothing here touches a file.
+ */
+object EyesImage {
+
+    const val MAX_SIDE = 1024
+    const val MIN_SIDE = 64
+    const val JPEG_QUALITY = 75
+
+    /** More pixels than this are not decoded, scaled down or not: a picture this large is no page picture. */
+    const val MAX_PIXELS = 60_000_000L
+
+    /** Why a picture was skipped. */
+    enum class Skip {
+        /** Under [MIN_SIDE] on a side: an icon or a tracking pixel. */
+        TOO_SMALL,
+
+        /** An SVG, text, or something that is no picture at all. */
+        NOT_A_PICTURE,
+
+        /** Too many pixels to decode. */
+        TOO_LARGE,
+
+        /** It looked like a picture and could not be decoded. */
+        UNREADABLE
+    }
+
+    sealed class Prepared {
+        /** The JPEG to send. Its bytes are the caller's to zero once the call is over. */
+        class Jpeg(val bytes: ByteArray, val width: Int, val height: Int) : Prepared()
+
+        data class Skipped(val why: Skip) : Prepared()
+    }
+
+    /** What the first bytes of a file say it is. */
+    enum class Kind { JPEG, PNG, GIF, WEBP, BMP, HEIF, SVG_OR_TEXT, UNKNOWN }
+
+    /** The kind of [bytes] by their first bytes, never by what a server said it sent. */
+    fun kindOf(bytes: ByteArray): Kind {
+        fun at(i: Int) = if (i < bytes.size) bytes[i].toInt() and 0xff else -1
+        fun ascii(from: Int, text: String) = text.indices.all { at(from + it) == text[it].code }
+        return when {
+            at(0) == 0xff && at(1) == 0xd8 && at(2) == 0xff -> Kind.JPEG
+            at(0) == 0x89 && ascii(1, "PNG") -> Kind.PNG
+            ascii(0, "GIF8") -> Kind.GIF
+            ascii(0, "RIFF") && ascii(8, "WEBP") -> Kind.WEBP
+            ascii(0, "BM") -> Kind.BMP
+            ascii(4, "ftyp") && (ascii(8, "heic") || ascii(8, "heix") || ascii(8, "mif1") || ascii(8, "avif")) -> Kind.HEIF
+            looksLikeText(bytes) -> Kind.SVG_OR_TEXT
+            else -> Kind.UNKNOWN
+        }
+    }
+
+    private fun looksLikeText(bytes: ByteArray): Boolean {
+        val start = String(bytes, 0, minOf(bytes.size, 256), Charsets.ISO_8859_1).trimStart('﻿', 'ï', '»', '¿', ' ', '\n', '\r', '\t')
+        return start.startsWith("<") || start.startsWith("{") || start.startsWith("[")
+    }
+
+    /**
+     * The size [width] × [height] is brought down to: at most [maxSide] on the long side,
+     * the shape kept; a picture already within it keeps its size.
+     */
+    fun target(width: Int, height: Int, maxSide: Int = MAX_SIDE): Pair<Int, Int> {
+        val long = max(width, height)
+        if (long <= maxSide) return width to height
+        val scale = maxSide.toDouble() / long
+        return (width * scale).roundToInt().coerceAtLeast(1) to (height * scale).roundToInt().coerceAtLeast(1)
+    }
+
+    /** Whether a picture of [width] × [height] is too small to be worth a look. */
+    fun tooSmall(width: Int, height: Int): Boolean = width < MIN_SIDE || height < MIN_SIDE
+
+    /** The power of two to decode at so the decoded picture is still at least [maxSide] on its long side. */
+    fun sampleSize(width: Int, height: Int, maxSide: Int = MAX_SIDE): Int {
+        var sample = 1
+        while (max(width, height) / (sample * 2) >= maxSide) sample *= 2
+        return sample
+    }
+
+    /** [bytes], fetched or taken, made ready for the describer. [bytes] is not changed: it is the caller's to zero. */
+    fun prepare(bytes: ByteArray): Prepared {
+        when (kindOf(bytes)) {
+            Kind.SVG_OR_TEXT, Kind.UNKNOWN -> return Prepared.Skipped(Skip.NOT_A_PICTURE)
+            else -> Unit
+        }
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        try {
+            BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        } catch (e: Exception) {
+            return Prepared.Skipped(Skip.UNREADABLE)
+        }
+        val width = bounds.outWidth
+        val height = bounds.outHeight
+        if (width <= 0 || height <= 0) return Prepared.Skipped(Skip.UNREADABLE)
+        if (tooSmall(width, height)) return Prepared.Skipped(Skip.TOO_SMALL)
+        if (width.toLong() * height > MAX_PIXELS) return Prepared.Skipped(Skip.TOO_LARGE)
+        val decoded = try {
+            BitmapFactory.decodeByteArray(
+                bytes, 0, bytes.size,
+                BitmapFactory.Options().apply {
+                    inSampleSize = sampleSize(width, height)
+                    inPreferredConfig = Bitmap.Config.ARGB_8888
+                }
+            )
+        } catch (e: OutOfMemoryError) {
+            null
+        } catch (e: Exception) {
+            null
+        } ?: return Prepared.Skipped(Skip.UNREADABLE)
+        var scaled: Bitmap? = null
+        var flat: Bitmap? = null
+        return try {
+            val (w, h) = target(decoded.width, decoded.height)
+            scaled = if (w == decoded.width && h == decoded.height) decoded else Bitmap.createScaledBitmap(decoded, w, h, true)
+            // JPEG has no transparency: a transparent picture is put on white, not on black.
+            flat = if (scaled.hasAlpha()) onWhite(scaled) else scaled
+            val out = WipedOutput()
+            try {
+                if (!flat.compress(Bitmap.CompressFormat.JPEG, JPEG_QUALITY, out)) return Prepared.Skipped(Skip.UNREADABLE)
+                Prepared.Jpeg(out.toByteArray(), flat.width, flat.height)
+            } finally {
+                // The stream's own buffer held the picture too: zeroed, so only the copy handed back is left.
+                out.wipe()
+            }
+        } catch (e: OutOfMemoryError) {
+            Prepared.Skipped(Skip.UNREADABLE)
+        } catch (e: Exception) {
+            Prepared.Skipped(Skip.UNREADABLE)
+        } finally {
+            listOfNotNull(decoded, scaled, flat).distinct().forEach { if (!it.isRecycled) it.recycle() }
+        }
+    }
+
+    /** A stream in memory whose buffer can be zeroed once it has been read. */
+    private class WipedOutput : ByteArrayOutputStream() {
+        fun wipe() {
+            buf.fill(0)
+            reset()
+        }
+    }
+
+    private fun onWhite(bitmap: Bitmap): Bitmap {
+        val out = Bitmap.createBitmap(bitmap.width, bitmap.height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(out)
+        canvas.drawColor(Color.WHITE)
+        canvas.drawBitmap(bitmap, 0f, 0f, Paint(Paint.FILTER_BITMAP_FLAG))
+        return out
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesModels.kt b/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesModels.kt
new file mode 100644
index 0000000..0c0edcb
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/eyes/EyesModels.kt
@@ -0,0 +1,127 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+
+/**
+ * Which Venice models her eyes may use: vision models of Venice's Private tier only, where
+ * Venice keeps no prompt and no image. Not end to end encrypted: a picture sent to one can
+ * be read by the host while it is described. Her chat stays on her encrypted model, which
+ * gets only the words.
+ *
+ * The check made when the setting is saved ([judge]): the model is asked for in Venice's
+ * own list of models (`GET /models`), and only one that lists vision and the Private tier
+ * is taken. When the list cannot be had or read (offline), a built-in allowlist decides
+ * ([ALLOWLIST]). Ids of the Anonymized tier (`claude-`, `openai-`, `gemini-`: other
+ * companies' models reached through Venice, which keep what they are sent by their own
+ * rules) are always refused. The field names are those of Venice's API reference for
+ * `GET /models` (docs.venice.ai, read 2026-11-18): `data[].id`, `model_spec.privacy`
+ * (`private` or `anonymized`) and `model_spec.capabilities.supportsVision`. Venice marks the
+ * API experimental and changes it, so the list is read leniently: where it holds the model
+ * but says nothing about vision or its tier, the allowlist decides.
+ */
+object EyesModels {
+
+    /** The model this build starts on. */
+    const val DEFAULT = com.opendroid.ai.data.models.EyesBounds.DEFAULT_MODEL
+
+    /** The models his settings offer, his choice of the Private-tier vision models. */
+    val CHOICES: List<String> = listOf(DEFAULT, "mistral-small-3-2-24b-instruct", "qwen3-vl-235b-a22b")
+
+    /** Private-tier vision models known to this build, for the check when Venice's list cannot be had. */
+    val ALLOWLIST: Set<String> = setOf(
+        "google-gemma-4-31b-it",
+        "mistral-small-3-2-24b-instruct",
+        "nvidia-nemotron-3-5-super-vl-120b-a12b",
+        "google-gemma-3-27b-it",
+        "qwen3-vl-235b-a22b"
+    )
+
+    /** The beginnings of the ids of Venice's Anonymized tier: never her eyes. */
+    val ANONYMIZED_PREFIXES: List<String> = listOf("claude-", "openai-", "gemini-")
+
+    /** The address Venice lists its text models at, vision models among them. */
+    const val LIST_URL = "https://${HerEyes.HOST}/api/v1/models?type=text"
+
+    private val MODEL_ID = Regex("""^[a-z0-9][a-z0-9._:-]{1,79}$""")
+
+    /** What the check made of a model. */
+    sealed class Verdict {
+        /** Taken: Venice's list shows vision and the Private tier ([listed]), or the allowlist has it. */
+        data class Accepted(val listed: Boolean) : Verdict()
+
+        /** Refused, and why, in words for him. */
+        data class Refused(val why: String) : Verdict()
+    }
+
+    /** What Venice's list says of one model. Null fields: the list does not say. */
+    data class Listed(val vision: Boolean?, val private: Boolean?)
+
+    /** Whether [id] is of the Anonymized tier. */
+    fun anonymized(id: String): Boolean = ANONYMIZED_PREFIXES.any { id.trim().lowercase().startsWith(it) }
+
+    /**
+     * Whether [id] may be her eyes, by Venice's list as fetched ([listing], null when it
+     * could not be had) or, without it, the allowlist.
+     */
+    fun judge(id: String, listing: String?): Verdict {
+        val model = id.trim().lowercase()
+        if (model.isEmpty() || !MODEL_ID.matches(model)) return Verdict.Refused("That is not a model id.")
+        if (anonymized(model)) {
+            return Verdict.Refused("Models whose ids start with claude-, openai- or gemini- are of Venice's Anonymized tier, never her eyes.")
+        }
+        val inList = listing?.let { parse(it) }
+        if (inList != null) {
+            val listed = inList[model] ?: return Verdict.Refused("Venice does not list that model now.")
+            if (listed.vision == false) return Verdict.Refused("Venice lists that model without vision: it cannot look at pictures.")
+            if (listed.private == false) return Verdict.Refused("Venice lists that model outside its Private tier.")
+            if (listed.vision == true && listed.private == true) return Verdict.Accepted(listed = true)
+        }
+        return if (model in ALLOWLIST) {
+            Verdict.Accepted(listed = false)
+        } else {
+            Verdict.Refused("That model is not one this build knows as a Private-tier vision model, and Venice's list could not confirm it.")
+        }
+    }
+
+    private fun JsonElement?.obj(): JsonObject? = this?.takeIf { it.isJsonObject }?.asJsonObject
+
+    private fun JsonObject.flag(vararg keys: String): Boolean? = keys.firstNotNullOfOrNull { key ->
+        get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isBoolean }?.asBoolean
+    }
+
+    private fun JsonObject.text(vararg keys: String): String? = keys.firstNotNullOfOrNull { key ->
+        get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString
+    }
+
+    /**
+     * Venice's list of models by id, with what each says of vision and its privacy tier;
+     * null when [json] is not such a list. Read leniently, with the names Venice documents first.
+     */
+    fun parse(json: String): Map<String, Listed>? {
+        val root = try {
+            JsonParser.parseString(json).obj()
+        } catch (e: Exception) {
+            null
+        } ?: return null
+        val data = root.get("data")?.takeIf { it.isJsonArray }?.asJsonArray ?: return null
+        val out = LinkedHashMap<String, Listed>()
+        for (element in data) {
+            val model = element.obj() ?: continue
+            val id = model.text("id")?.trim()?.lowercase()?.takeIf { it.isNotEmpty() } ?: continue
+            val spec = model.get("model_spec").obj()
+            val capabilities = spec?.get("capabilities").obj() ?: model.get("capabilities").obj()
+            val vision = capabilities?.flag("supportsVision", "supports_vision", "vision")
+            val privacy = (spec?.text("privacy", "privacyTier", "privacy_tier") ?: model.text("privacy", "privacyTier", "privacy_tier"))
+                ?.trim()?.lowercase()
+            val private = when {
+                privacy == null -> null
+                privacy.startsWith("private") -> true
+                else -> false
+            }
+            out[id] = Listed(vision, private)
+        }
+        return out
+    }
+}
