+        // By age: the newest twenty, at any time.
+        assertEquals((1..20).toList(), shownOf(PersonaNotes.render(long, maxChars = 2000)))
+
+        // With a recall a quarter of the page is kept free: fifteen by age, five in turn.
+        val seen = HashSet<Int>()
+        val turns = 0L..9L
+        for (turn in turns) {
+            val block = PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), turn))
+            val shown = shownOf(block)
+            assertEquals((1..15).toList(), shown.take(15))
+            assertEquals(20, shown.size)
+            seen += shown
+            assertTrue(block, block.endsWith(
+                "(40 more notes of yours are not on this page: it has no room for all of them. A note that fits what is " +
+                    "being said is put on it first. The others take turns on it, except threads that are over.)"
+            ))
+        }
+        // The first thing he told her is on the very first turn, and after eight turns
+        // every note that stays in the notebook has been on the page.
+        assertTrue(PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 0)).contains("thing number 60 "))
+        assertEquals((1..45).toSet() + (51..60).toSet(), seen)
+        // Threads that are over wait for the talk to touch them: they are what may be taken out.
+        assertTrue((46..50).none { it in seen })
+        // The turns come round again, and a turn before the first is one too.
+        assertEquals(
+            PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 0)),
+            PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 8))
+        )
+        assertEquals(20, shownOf(PersonaNotes.render(long, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), -3))).size)
+    }
+
+    @Test
+    fun `a note the talk touches is put on the page whatever its age`() {
+        val notes = long + Note(Kind.USER, "work", "he does night shifts at the bakery")
+        val atBakery = PersonaNotes.Recall.of(listOf("the bakery wants me on saturdays now"), nowMillis = 3 * PersonaNotes.TURN_MILLIS)
+        assertEquals(3L, atBakery.turn)
+
+        val block = PersonaNotes.render(notes, maxChars = 2000, recall = atBakery)
+        assertTrue(block, block.contains("- he does night shifts at the bakery"))
+        // A thread that is over comes back the same way, and its key counts as its words do.
+        val tab = PersonaNotes.render(notes, maxChars = 2000, recall = PersonaNotes.Recall.of(listOf("what became of done 48"), 0))
+        assertTrue(tab, tab.contains("tab 48 "))
+        // What is being said does not change whose turn it is: the same notes come round with it or without.
+        val turnOnly = shownOf(PersonaNotes.render(notes, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 3)))
+        assertTrue(shownOf(block).all { it in turnOnly })
+        assertEquals(listOf(37, 38, 39, 40, 41), turnOnly.drop(15))
+        // Talk that touches nothing brings nothing but the notes whose turn it is.
+        val other = PersonaNotes.render(notes, maxChars = 2000, recall = PersonaNotes.Recall.of(listOf("melon soda again"), 3 * PersonaNotes.TURN_MILLIS))
+        assertFalse(other.contains("bakery"))
+
+        // The notebook pass picks its page the same way once who she is now has had its
+        // place (forty of her views here), so a note the talk touches can be replaced, not
+        // written beside.
+        val reviewRoom = PersonaNotes.PRESENT_SELF_CHARS + 1000
+        val page = PersonaNotes.review(notes, maxChars = reviewRoom, recall = atBakery)
+        assertTrue("yume.user.work" in page.shownKeys)
+        // It is the talk that put it there, not its turn.
+        assertFalse("yume.user.work" in PersonaNotes.review(notes, maxChars = reviewRoom, recall = PersonaNotes.Recall(emptySet(), 3)).shownKeys)
+        assertEquals(
+            listOf(Note(Kind.USER, "work", "he does saturdays at the bakery too")),
+            PersonaNotes.besideUnseen(listOf(Note(Kind.USER, "work", "he does saturdays at the bakery too")), notes, shownKeys = page.shownKeys)
+        )
+    }
+
+    @Test
+    fun `a notebook that fits the page is shown whole, with or without a recall`() {
+        val notes = long.take(12)
+        assertEquals(PersonaNotes.render(notes, maxChars = 2000), PersonaNotes.render(notes, maxChars = 2000, recall = PersonaNotes.Recall(setOf("bakery"), 5)))
+        assertFalse(PersonaNotes.render(notes, maxChars = 2000, recall = PersonaNotes.Recall(emptySet(), 5)).contains("not on this page"))
+
+        // Only the newest five threads that are over are shown in her chat prompt. The
