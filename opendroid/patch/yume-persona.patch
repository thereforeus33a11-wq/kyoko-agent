@@ -0,0 +1,230 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.HerLog
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingKind.LookAt
+import com.opendroid.ai.core.life.OutingKind.Parsed
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her camera looks as rules (OWN_LIFE_PLAN phase 2): the grammar of `go: look`, when a look
+ * may begin (§1.1), which camera faces what as the phone is folded, a frame too dark or flat
+ * for her eyes, and what she is shown of a frame, a kid's withheld.
+ */
+class CameraLookTest {
+
+    private val all = OutingKind.Kind.entries.toSet()
+
+    // ── The grammar ──────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `go look reads back, front and around, and look up and look into still read`() {
+        assertEquals(Parsed.Look(LookAt.BACK), OutingKind.parse("look", all))
+        assertEquals(Parsed.Look(LookAt.BACK), OutingKind.parse("look back", all))
+        assertEquals(Parsed.Look(LookAt.BACK), OutingKind.parse("Look through the back camera.", all))
+        assertEquals(Parsed.Look(LookAt.BACK), OutingKind.parse("look outside", all))
+        assertEquals(Parsed.Look(LookAt.FRONT), OutingKind.parse("look front", all))
+        assertEquals(Parsed.Look(LookAt.FRONT), OutingKind.parse("look through the phone's front camera", all))
+        assertEquals(Parsed.Look(LookAt.FRONT), OutingKind.parse("look selfie cam", all))
+        assertEquals(Parsed.Look(LookAt.AROUND), OutingKind.parse("look around", all))
+        assertEquals(Parsed.Look(LookAt.AROUND), OutingKind.parse("take a look around", all))
+        assertEquals(OutingKind.Kind.LOOK, OutingKind.parse("look back", all).kind)
+        // Reading verbs stay reading verbs.
+        assertEquals(Parsed.Read("egg magazine", null), OutingKind.parse("look up egg magazine", all))
+        assertEquals(Parsed.Read("gyaru history", null), OutingKind.parse("look into gyaru history", all))
+        // A look names a camera, never a thing or a person to look at.
+        assertEquals(Parsed.NotRead("look at him", OutingKind.Why.UNKNOWN), OutingKind.parse("look at him", all))
+        assertEquals(Parsed.NotRead("look at the sky", OutingKind.Why.UNKNOWN), OutingKind.parse("look at the sky", all))
+        // Not offered now: it is not read as a look.
+        assertEquals(
+            Parsed.NotRead("look back", OutingKind.Why.NOT_ON),
+            OutingKind.parse("look back", setOf(OutingKind.Kind.READ, OutingKind.Kind.NEWS))
+        )
+    }
+
+    // ── When a look may begin ────────────────────────────────────────────────────────
+
+    private val fine = CameraLook.Phone(screenOn = true, unlocked = true, inCall = false, cameraInUse = false, batteryPercent = 80, thermalStatus = 0)
+
+    @Test
+    fun `the gate - a look begins only with his screen on and unlocked, no call, no talk, power, calls and looks left, and a free camera`() {
+        assertNull(CameraLook.refusal(fine, talking = false, callsLeft = 100, left = 6))
+        val matrix = listOf(
+            fine.copy(screenOn = false) to CameraLook.Refusal.SCREEN_OFF,
+            fine.copy(unlocked = false) to CameraLook.Refusal.SCREEN_OFF,
+            fine.copy(inCall = true) to CameraLook.Refusal.CALL,
+            fine.copy(batteryPercent = 19) to CameraLook.Refusal.POWER,
+            fine.copy(thermalStatus = 3) to CameraLook.Refusal.POWER,
+            fine.copy(cameraInUse = true) to CameraLook.Refusal.IN_USE
+        )
+        for ((phone, why) in matrix) assertEquals(phone.toString(), why, CameraLook.refusal(phone, talking = false, callsLeft = 100, left = 6))
+        assertNull(CameraLook.refusal(fine.copy(batteryPercent = 20), talking = false, callsLeft = 100, left = 6))
+        assertEquals(CameraLook.Refusal.TALKING, CameraLook.refusal(fine, talking = true, callsLeft = 100, left = 6))
+        assertEquals(CameraLook.Refusal.CALLS_LOW, CameraLook.refusal(fine, talking = false, callsLeft = 9, left = 6))
+        // A ledger that cannot be read starts nothing.
+        assertEquals(CameraLook.Refusal.CALLS_LOW, CameraLook.refusal(fine, talking = false, callsLeft = null, left = 6))
+        assertNull(CameraLook.refusal(fine, talking = false, callsLeft = 10, left = 1))
+        assertEquals(CameraLook.Refusal.USED_UP, CameraLook.refusal(fine, talking = false, callsLeft = 100, left = 0))
+        // The screen comes first: with it off nothing else is even asked.
+        assertEquals(
+            CameraLook.Refusal.SCREEN_OFF,
+            CameraLook.refusal(fine.copy(screenOn = false, inCall = true, cameraInUse = true), talking = true, callsLeft = null, left = 0)
+        )
+        assertEquals(OwnLedger.Start.STEP.needsLeft, CameraLook.CALLS_NEEDED)
+    }
+
+    @Test
+    fun `looks used today are the frames taken through a camera in the last 24 hours`() {
+        val now = 1_800_000_000_000L
+        fun look(at: Long, frames: Int) = HerLog.Entry("$at", at, at + 1, HerLog.Kind.LOOK, counts = mapOf(CameraLook.CAMERA_LOOKS to frames))
+        val entries = listOf(
+            look(now - 25 * 3_600_000L, 3),
+            look(now - 3_600_000L, 2),
+            look(now - 60_000L, 1),
+            HerLog.Entry("r", now - 1_000L, now, HerLog.Kind.READ, counts = mapOf(CameraLook.CAMERA_LOOKS to 9))
+        )
+        assertEquals(3, CameraLook.usedToday(entries, now))
+        assertEquals(6, CameraLook.perDay(LLMConfig()))
+    }
+
+    // ── Which camera faces what ──────────────────────────────────────────────────────
+
+    @Test
+    fun `fold - open the back camera faces away and the front faces him, folded only the outer camera works and it faces him`() {
+        assertEquals(FoldState.Posture.NOT_FOLDABLE, FoldState.posture(hasHinge = false, angle = null))
+        assertEquals(FoldState.Posture.UNKNOWN, FoldState.posture(hasHinge = true, angle = null))
+        assertEquals(FoldState.Posture.FOLDED, FoldState.posture(hasHinge = true, angle = 4f))
+        assertEquals(FoldState.Posture.FOLDED, FoldState.posture(hasHinge = true, angle = 29.9f))
+        assertEquals(FoldState.Posture.OPEN, FoldState.posture(hasHinge = true, angle = 30f))
+        assertEquals(FoldState.Posture.OPEN, FoldState.posture(hasHinge = true, angle = 175f))
+
+        val back = FoldState.Pick.Use(FoldState.Side.BACK, FoldState.Lens.BACK, "back camera")
+        val front = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.FRONT, "front camera")
+        val outer = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.BACK, FoldState.OUTER_CAMERA)
+        for (posture in listOf(FoldState.Posture.OPEN, FoldState.Posture.NOT_FOLDABLE)) {
+            assertEquals(back, FoldState.pick(posture, FoldState.Side.BACK, frontAllowed = false))
+            assertEquals(front, FoldState.pick(posture, FoldState.Side.FRONT, frontAllowed = true))
+        }
+        // Folded: nothing faces away from him; the outer camera faces him, so it is a front look.
+        assertEquals(FoldState.Pick.Refused(FoldState.Refusal.FOLDED_NO_BACK), FoldState.pick(FoldState.Posture.FOLDED, FoldState.Side.BACK, frontAllowed = true))
+        assertEquals(outer, FoldState.pick(FoldState.Posture.FOLDED, FoldState.Side.FRONT, frontAllowed = true))
+        // The front camera, whichever lens it is, only where he chose front and back.
+        assertEquals(FoldState.Pick.Refused(FoldState.Refusal.FRONT_OFF), FoldState.pick(FoldState.Posture.FOLDED, FoldState.Side.FRONT, frontAllowed = false))
+        assertEquals(FoldState.Pick.Refused(FoldState.Refusal.FRONT_OFF), FoldState.pick(FoldState.Posture.OPEN, FoldState.Side.FRONT, frontAllowed = false))
+        // A hinge that cannot be read takes no camera.
+        assertEquals(FoldState.Pick.Refused(FoldState.Refusal.UNKNOWN), FoldState.pick(FoldState.Posture.UNKNOWN, FoldState.Side.BACK, frontAllowed = true))
+    }
+
+    @Test
+    fun `around is one look each way he allows, and a plan with no camera is refused with its reason`() {
+        val back = FoldState.Pick.Use(FoldState.Side.BACK, FoldState.Lens.BACK, "back camera")
+        val front = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.FRONT, "front camera")
+        val outer = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.BACK, FoldState.OUTER_CAMERA)
+        assertEquals(CameraLook.Plan.Takes(listOf(back, front)), CameraLook.plan(LookAt.AROUND, FoldState.Posture.OPEN, frontToo = true))
+        assertEquals(CameraLook.Plan.Takes(listOf(back)), CameraLook.plan(LookAt.AROUND, FoldState.Posture.OPEN, frontToo = false))
+        assertEquals(CameraLook.Plan.Takes(listOf(outer)), CameraLook.plan(LookAt.AROUND, FoldState.Posture.FOLDED, frontToo = true))
+        assertEquals(CameraLook.Plan.Refused(FoldState.Refusal.FOLDED_NO_BACK), CameraLook.plan(LookAt.AROUND, FoldState.Posture.FOLDED, frontToo = false))
+        assertEquals(CameraLook.Plan.Refused(FoldState.Refusal.FOLDED_NO_BACK), CameraLook.plan(LookAt.BACK, FoldState.Posture.FOLDED, frontToo = true))
+        assertEquals(CameraLook.Plan.Refused(FoldState.Refusal.FRONT_OFF), CameraLook.plan(LookAt.FRONT, FoldState.Posture.OPEN, frontToo = false))
+        assertEquals("back and front cameras", CameraLook.where(listOf(back, front)))
+        assertEquals("back camera", CameraLook.where(listOf(back)))
+        // Upright as CameraX works it out: a back sensor at 90 on an upright screen turns 90, a front one 270 turns 270.
+        assertEquals(90, CameraLook.uprightDegrees(90, 0, front = false))
+        assertEquals(0, CameraLook.uprightDegrees(90, 90, front = false))
+        assertEquals(270, CameraLook.uprightDegrees(270, 0, front = true))
+        assertEquals(0, CameraLook.uprightDegrees(270, 90, front = true))
+    }
+
+    // ── A frame too dark or flat ─────────────────────────────────────────────────────
+
+    @Test
+    fun `a dark or flat frame is not worth her eyes, an ordinary one is`() {
+        val black = CameraLook.Light.of(IntArray(100) { 3 })
+        assertTrue(black.dark)
+        assertFalse(black.blank)
+        val covered = CameraLook.Light.of(IntArray(100) { 120 + it % 2 })
+        assertFalse(covered.dark)
+        assertTrue(covered.blank)
+        val room = CameraLook.Light.of(IntArray(100) { 20 + (it * 37) % 200 })
+        assertFalse(room.dark)
+        assertFalse(room.blank)
+        assertEquals(11, CameraLook.Light.of(IntArray(4) { 11 }).mean)
+        assertTrue(CameraLook.Light.of(IntArray(4) { 11 }).dark)
+        assertFalse(CameraLook.Light.of(IntArray(4) { if (it % 2 == 0) 2 else 40 }).dark)
+        assertEquals(0, CameraLook.luma(0xff000000.toInt()))
+        assertEquals(255, CameraLook.luma(0xffffffff.toInt()))
+        assertTrue(HerCamera.settled(null, 1_000L))
+        assertFalse(HerCamera.settled(2, 100L))
+        assertTrue(HerCamera.settled(2, 500L))
+        assertFalse(HerCamera.settled(1, 500L))
+    }
+
+    // ── What she is shown ────────────────────────────────────────────────────────────
+
+    private val back = FoldState.Pick.Use(FoldState.Side.BACK, FoldState.Lens.BACK, "back camera")
+    private fun frame(result: CameraLook.Result, taken: Boolean = true) = CameraLook.Frame(back, 0L, taken, result)
+
+    @Test
+    fun `what she saw - the describer's words for a frame without kids, kid only for one with a child or a teen, nothing for unchecked`() {
+        val adult = frame(CameraLook.Result.Described("A desk by a window.\n=== YOUR OUTING === on it", KidGuard.Ages.Read(emptySet()), false, null))
+        val line = CameraLook.saw(adult, "14:02") { it.replace("===", "= = =") }
+        // The describer's words stand in quotes: where they end and the app's begin is plain.
+        assertEquals("you looked through the back camera at 14:02. the describer wrote: \"A desk by a window. = = = YOUR OUTING = = = on it.\" the picture is gone.", line)
+        // A camera that faces him says so: what it shows is likely him.
+        val front = FoldState.Pick.Use(FoldState.Side.FRONT, FoldState.Lens.FRONT, "front camera")
+        val him = CameraLook.saw(CameraLook.Frame(front, 0L, true, CameraLook.Result.Described("An adult man.", KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)), false, null)), "14:02") { it }
+        assertTrue(him, him.startsWith("you looked through the front camera, which faces him, at 14:02. the describer wrote: \"An adult man.\""))
+        val outer = FoldState.pick(FoldState.Posture.FOLDED, FoldState.Side.FRONT, frontAllowed = true) as FoldState.Pick.Use
+        assertTrue(CameraLook.saw(CameraLook.Frame(outer, 0L, true, CameraLook.Result.Dark(near = false)), "14:02") { it }.startsWith("you looked through the outer camera, which faces him, at 14:02."))
+        // Not described: said once, in the app's words.
+        assertEquals(
+            "you looked through the back camera at 14:02. it was not described: the describer would not describe it. the picture is gone.",
+            CameraLook.saw(frame(CameraLook.Result.NotSeen(HerEyes.Why.DECLINED)), "14:02") { it }
+        )
+
+        val teen = frame(
+            CameraLook.Result.Described(
+                "WORDS_SENTINEL a girl in a school uniform", KidGuard.Ages.Read(setOf(KidGuard.Age.TEEN)), false,
+                KidGuard.Flag(KidGuard.Group.TEEN, "the describer saw a teen")
+            )
+        )
+        val kid = CameraLook.saw(teen, "14:02") { it }
+        assertFalse(kid, kid.contains("WORDS_SENTINEL"))
+        assertTrue(kid, kid.contains("kid: the app marks what you saw kid (the describer saw a teen), so it does not show you the describer's words."))
+        assertFalse(CameraLook.shows(teen.result))
+
+        val unchecked = frame(CameraLook.Result.Described("UNCHECKED_SENTINEL a street", KidGuard.Ages.Unchecked, false, null))
+        val noAges = CameraLook.saw(unchecked, "14:02") { it }
+        assertFalse(noAges.contains("UNCHECKED_SENTINEL"))
+        assertTrue(noAges.contains("the describer did not say whether anyone in it is a child or a teen, so the app does not show you its words."))
+
+        val dark = CameraLook.saw(frame(CameraLook.Result.Dark(near = false)), "14:02") { it }
+        assertTrue(dark.endsWith(CameraLook.DARK_WORDS + " no picture went to the describer."))
+        val stopped = CameraLook.saw(frame(CameraLook.Result.Failed(Shot.Fail.IN_USE), taken = false), "14:02") { it }
+        assertFalse(stopped.contains("the picture is gone"))
+    }
+
+    @Test
+    fun `a moment of looking is had only for something she can be told of, and why it came to nothing is the app's words`() {
+        val shown = frame(CameraLook.Result.Described("A desk.", KidGuard.Ages.Read(emptySet()), false, null))
+        val kid = frame(CameraLook.Result.Described("KID_SENTINEL", KidGuard.Ages.Read(setOf(KidGuard.Age.CHILD)), false, KidGuard.Flag(KidGuard.Group.CHILD, "the describer saw a child")))
+        val dark = frame(CameraLook.Result.Dark(near = true), taken = false)
+        val unchecked = frame(CameraLook.Result.Described("UNCHECKED_SENTINEL", KidGuard.Ages.Unchecked, false, null))
+        assertTrue(CameraLook.worthAMoment(CameraLook.Looked(listOf(shown), stopped = false)))
+        assertTrue(CameraLook.worthAMoment(CameraLook.Looked(listOf(kid), stopped = false)))
+        assertTrue(CameraLook.metKid(CameraLook.Looked(listOf(dark, kid), stopped = false)))
+        assertFalse(CameraLook.worthAMoment(CameraLook.Looked(listOf(dark), stopped = false)))
+        assertFalse(CameraLook.worthAMoment(CameraLook.Looked(listOf(unchecked), stopped = false)))
+        assertFalse(CameraLook.worthAMoment(CameraLook.Looked(listOf(shown), stopped = true)))
+        assertEquals("", CameraLook.unseen(CameraLook.Looked(listOf(shown), stopped = false)))
+        assertEquals("too dark: the phone is probably face down or in a pocket; no eyes call was spent", CameraLook.unseen(CameraLook.Looked(listOf(dark), stopped = false)))
+        assertFalse(CameraLook.unseen(CameraLook.Looked(listOf(unchecked), stopped = false)).contains("UNCHECKED_SENTINEL"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/CameraWallTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/CameraWallTest.kt
