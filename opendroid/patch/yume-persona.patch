+    @Test
+    fun `the privacy card says where speech is recognised, from what the phone has and what the setting allows`() {
+        assertEquals(ROUTE_POLICY_ANY_LABEL, ROUTE_POLICY_CHOICES.single { it.first == RoutePolicy.ANY }.second)
+
+        for (onDevice in listOf(true, false)) {
+            val strict = PrivacyWording.voiceInput(onDevice, anyRecogniser = true, cloudAllowed = false)
+            val loose = PrivacyWording.voiceInput(onDevice, anyRecogniser = true, cloudAllowed = true)
+
+            // "voice input stops and says so"
+            assertTrue(strict.contains("When the service answers that it cannot work offline, voice input stops and says so."))
+            assertTrue(strict.contains("It is asked without the request only when \"$ROUTE_POLICY_ANY_LABEL\" is chosen above."))
+            val kept = PreferredRecognizer.Choice { false }
+            assertFalse(kept.onError(onDevice = false, error = 13))
+            assertTrue(kept.asksOffline(onDevice = false))
+            assertTrue(kept.offlineUnavailable(onDevice = false, error = 13))
+
+            // "it is asked again without the request"
+            assertTrue(loose.contains("it is asked again without the request, and what you say can then go to its maker's servers"))
+            assertTrue(loose.contains("In wake-word mode that is the sound of the room."))
+            val given = PreferredRecognizer.Choice { true }
+            assertTrue(given.onError(onDevice = false, error = 13))
+            assertFalse(given.asksOffline(onDevice = false))
