+    private val webSearch: (LLMConfig) -> Boolean = { false }
+) {
+    @Inject
+    constructor(
+        engine: com.opendroid.ai.core.persona.PersonaEngine,
+        settings: SettingsRepository,
+        wikipedia: Wikipedia,
