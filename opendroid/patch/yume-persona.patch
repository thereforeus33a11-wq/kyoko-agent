+    /**
+     * A mark at the start of a line, whatever its case, also behind a list dash, and
+     * behind the label a line of the talk block has ("you: say: hey") or a chat model's
+     * name label: copying the transcript's form does not unmark her line.
+     */
+    internal fun marked(line: String, mark: String): String? {
+        val bare = withoutTalkLabel(line.trim().removePrefix("-").removePrefix("*").trim())
+        return if (bare.startsWith(mark, ignoreCase = true)) bare.substring(mark.length).trim() else null
+    }
+
+    /** "you:" or her name with a colon in front of a line, taken off only when a mark follows it. */
+    private val TALK_LABEL = Regex("""^(?:you|yume kisaragi|yume|kisaragi)\s*:\s*""", RegexOption.IGNORE_CASE)
+    private val MARKS = listOf(
+        SAY, NOTE, NEXT, SLEEP, FEEL, PersonaActions.MARKER, PersonaThoughtLines.MARKER,
+        // The marks of her own life: a go: and a wonder: in a moment, a do: in an outing's step.
+        com.opendroid.ai.core.life.OutingKind.MARK,
+        com.opendroid.ai.core.life.Wonders.MARK,
+        com.opendroid.ai.core.life.OutingStep.DO
+    )
+
+    /**
+     * What a thought line of hers (one that opens with [PersonaThoughtLines.MARKER]) says,
+     * or null when [line] is no thought line. The marker rules stay in her package; an
+     * outing's step reads her thought lines through this.
+     */
+    internal fun thoughtOf(line: String): String? {
+        val bare = withoutTalkLabel(line.trim())
+        if (!PersonaThoughtLines.isThoughtLine(bare)) return null
+        return PersonaThoughtLines.split(bare).thoughts
+    }
+
+    private fun withoutTalkLabel(line: String): String {
+        val label = TALK_LABEL.find(line) ?: return line
+        val rest = line.substring(label.range.last + 1)
+        return if (MARKS.any { rest.startsWith(it, ignoreCase = true) }) rest else line
+    }
+
+    /**
+     * Sorts [reply], what she wrote in a moment of her own.
+     *
+     * A line is marked by how it starts: `say:`, `note:`, `next:`, `sleep:`, `feel:` or
+     * the command marker. Every other line is a thought, and so is a line with the
+     * thought marker of a reply, which is simply taken off. What counts as a command is
+     * decided by the rule for a reply's command line. Of several command lines the last
+     * is the command and the others are kept as not run. Of several `next:` lines, and
+     * of several `sleep:` lines, the last one counts.
+     *
+     * No line she wrote is dropped because it does not fit. A line to him is hers as she
+     * wrote it, whatever it is made of. A marked line the app can do nothing with stays
+     * a thought as she wrote it: a note line that does not have the notebook's form, a
+     * note line past the few the notebook takes at a time, a `next:` or `sleep:` line that
+     * names no time the app can read, and a feel line past the few kept at a time or
+     * without the form.
+     *
+     * With [cutOff] the text ran into the model's length limit, so its last line may be
+     * half a line: it is kept as a thought whatever its mark and nothing is done with
+     * it, except that a command there is listed as not run.
+     *
+     * [life] is what of her own life can run now ([OutingKind.Kind]s), null while her own
+     * life is off: then a `go:` or `wonder:` line is a thought like any other. While it is
+     * on, of several `go:` lines the last is the outing and the others stay thoughts, and a
+     * `go:` line the app cannot read ([OutingKind.Parsed.NotRead]) stays a thought as
+     * well; at most [Wonders.PER_MOMENT] `wonder:` lines are taken, and the rest stay
+     * thoughts.
+     */
+    fun parse(reply: String, cutOff: Boolean = false, life: Set<OutingKind.Kind>? = null, kid: Boolean = false): Moment {
+        val lines = reply.lines()
+        val lastWritten = lines.indexOfLast { it.isNotBlank() }
+        val thoughts = ArrayList<String>()
+        val said = ArrayList<String>()
+        // Her notes by the key they are stored under, read the way a notebook pass reads them.
+        val notes = LinkedHashMap<String, PersonaNotes.Note>()
+        val marks = HashMap<String, PersonaNotes.How>()
+        val commands = ArrayList<String>()
+        val unrun = ArrayList<PersonaActionRows.Unrun>()
+        var wishText: String? = null
+        var sleepText: String? = null
+        val feelings = ArrayList<PersonaMood.Felt>()
+        // Her go: lines, and where among her thoughts the last of them stands: one that does
+        // not count stays a thought in its place.
+        val goes = ArrayList<Pair<String, String>>()
+        var lastGoAt = 0
+        val wonders = ArrayList<Wonders.Line>()
+        var dropped = 0
+        for ((index, line) in lines.withIndex()) {
+            val trimmed = line.trim()
+            if (trimmed.isEmpty()) continue
+            val halfLine = cutOff && index == lastWritten
+            // She came back from meeting a kid: a thought, note, feel, wonder or say line of hers that
+            // reads as sexual is not kept, never rewritten, and counted (§1.4). Her other marks are acts.
+            if (kid && marked(trimmed, PersonaActions.MARKER) == null && marked(trimmed, NEXT) == null &&
+                marked(trimmed, SLEEP) == null && marked(trimmed, GO) == null && com.opendroid.ai.core.life.KidGuard.sexual(trimmed)
+            ) {
+                dropped++
+                continue
+            }
+            val command = marked(trimmed, PersonaActions.MARKER)
+            val saying = marked(trimmed, SAY)
+            val note = marked(trimmed, NOTE)
+            val next = marked(trimmed, NEXT)
+            val sleep = marked(trimmed, SLEEP)
+            val feel = marked(trimmed, FEEL)
+            val go = if (life != null) marked(trimmed, GO) else null
+            val wonder = if (life != null) marked(trimmed, WONDER) else null
+            when {
+                command != null -> {
+                    val written = command.trim('`', '"').trim()
+                    if (halfLine) {
+                        if (written.isNotEmpty()) unrun += PersonaActionRows.Unrun(written, PersonaActionRows.NotRun.MOMENT_CUT_OFF)
+                    } else {
+                        commands += written
+                    }
+                }
+                halfLine -> thoughts += trimmed
+                saying != null -> if (saying.isNotEmpty()) said += saying
+                note != null -> {
+                    val written = PersonaNotes.parseLine(note)
+                    // The notebook takes a few notes at a time and reads no further than the
+                    // line that fills it ([PersonaNotes.parse]). What it does not take is still hers.
+                    if (written == null || notes.size >= PersonaNotes.LINES_PER_PASS) {
+                        thoughts += trimmed
+                    } else {
+                        notes.remove(written.storageKey)
+                        notes[written.storageKey] = written
+                        val mark = PersonaNotes.markOf(note)
+                        if (mark != null) marks[written.storageKey] = mark else marks -= written.storageKey
+                    }
+                }
+                next != null -> {
+                    wishText = next
+                    // Words after the mark that name no time may have been a thought.
+                    if (next.isNotEmpty() && parseWish(next) == null) thoughts += trimmed
+                }
+                sleep != null -> {
+                    sleepText = sleep
+                    // Words after the mark that name no sleep the app can read stay hers as a thought.
+                    if (PersonaSleep.parseAsk(sleep) == null) thoughts += trimmed
+                }
+                feel != null -> {
+                    val felt = PersonaMood.fields(feel)
+                    if (felt == null || feelings.size >= PersonaMood.PASS_LINES) thoughts += trimmed else feelings += felt
+                }
+                // Which one counts is decided once all are read: the last.
+                go != null -> {
+                    goes.lastOrNull()?.let { (_, earlier) -> thoughts.add(lastGoAt, earlier) }
+                    lastGoAt = thoughts.size
+                    goes += go to trimmed
+                }
+                wonder != null -> {
+                    val read = Wonders.parse(wonder)
+                    if (read == null || wonders.size >= Wonders.PER_MOMENT) thoughts += trimmed else wonders += read
+                }
+                PersonaThoughtLines.isThoughtLine(withoutTalkLabel(trimmed)) ->
+                    PersonaThoughtLines.split(withoutTalkLabel(trimmed)).thoughts.takeIf { it.isNotEmpty() }?.let { thoughts += it }
+                else -> thoughts += trimmed
+            }
+        }
+        // Of several go: lines the last counts; the others, and one the app cannot read, stay hers as thoughts.
+        val outing = goes.lastOrNull()?.let { (words, _) -> Go(words, OutingKind.parse(words, life.orEmpty())) }
+        if (outing != null && !outing.runs) thoughts.add(lastGoAt, goes.last().second)
+        var command: String? = null
+        commands.forEachIndexed { index, written ->
+            when {
+                written.isEmpty() -> Unit
+                index != commands.lastIndex ->
+                    unrun += PersonaActionRows.Unrun(written, PersonaActionRows.NotRun.NOT_THE_LAST_COMMAND)
+                else -> {
+                    command = PersonaActions.split(PersonaActions.MARKER + " " + written).command
+                    if (command == null) unrun += PersonaActionRows.Unrun(written, PersonaActionRows.NotRun.NOT_A_COMMAND)
+                }
+            }
+        }
+        return Moment(
+            thoughts = thoughts.joinToString("\n").takeIf { text -> text.any { it.isLetterOrDigit() } }.orEmpty(),
+            // Tidied the way a reply is and no further: what she says to him is not judged by what it is made of.
+            said = said.joinToString("\n").takeIf { it.isNotBlank() }?.let(PersonaPrompts::cleanReply).orEmpty(),
+            notes = notes.values.toList(),
+            command = command,
+            unrun = unrun,
+            wish = wishText?.let(::parseWish),
+            wishText = wishText?.take(MAX_ASKED_CHARS),
+            sleep = sleepText?.let(PersonaSleep::parseAsk),
+            sleepText = sleepText?.take(MAX_ASKED_CHARS),
+            feelings = feelings,
+            marks = marks.filterKeys { key -> notes.containsKey(key) },
+            outing = outing,
+            earlierGoes = (goes.size - 1).coerceAtLeast(0),
+            wonders = wonders,
+            kidLinesDropped = dropped
+        )
+    }
