+
+    @Test
+    fun `the other people a step reaches and the rest of what it sends are on the card`() {
+        val found = texts(
+            step(
+                "s1", 1, "SEND_EMAIL",
+                mapOf(
+                    "to" to "riya@example.com", "cc" to "sam@example.com", "subject" to "Jars",
