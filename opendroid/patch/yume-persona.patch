+    // ── How old a note is ────────────────────────────────────────────────────────────
+
+    @Test
+    fun `an open thread and a thing she saw say how old they are, and the age is not read back as part of the note`() {
+        val day = 24 * 60 * 60_000L
+        val notes = listOf(
+            Note(Kind.THREAD, "mom-surgery", "his mom has surgery on november 18 | open"),
+            Note(Kind.OPINION, "inbox", "saw: his inbox has 4,000 unread"),
+            Note(Kind.THREAD, "tab", "street story: the tab is paid | closed"),
+            Note(Kind.USER, "bees", "he keeps bees")
+        )
+        val times = PersonaNotes.Times(
+            writtenAt = notes.associate { it.storageKey to 1_000L } + ("yume.opinion.inbox" to 1_000L + 20 * day),
+            nowMillis = 1_000L + 21 * day
+        )
+
+        val block = PersonaNotes.render(notes, times = times)
+        assertTrue(block, block.contains("- his mom has surgery on november 18 | open (written 21 days ago)"))
+        assertTrue(block, block.contains("- saw: his inbox has 4,000 unread (written yesterday)"))
+        // A fact about him and a thread that is over are not dated.
+        assertTrue(block, block.contains("- he keeps bees\n"))
+        assertTrue(block, block.contains("- street story: the tab is paid | closed"))
+        assertFalse(block.contains("closed (written"))
+        // Without times, or for a note whose time is not known, nothing is added.
+        assertFalse(PersonaNotes.render(notes).contains("(written"))
+        assertFalse(PersonaNotes.render(notes, times = PersonaNotes.Times(emptyMap(), 5 * day)).contains("(written"))
+
+        // Her notebook pass sees the same ages. A line that comes back with one is the note without it.
+        val review = PersonaNotes.review(notes, times = times).text
+        assertTrue(review, review.contains("thread | mom-surgery | his mom has surgery on november 18 | open (written 21 days ago)"))
+        val back = PersonaNotes.parseLine("thread | mom-surgery | his mom had surgery on november 18 and it went fine | closed (written 21 days ago)")!!
+        assertEquals("his mom had surgery on november 18 and it went fine | closed", back.text)
+        assertTrue(back.isClosedThread)
+    }
+
+    @Test
+    fun `only the age the notebook itself wrote is taken off a line, also when she put the new status behind it`() {
+        fun text(line: String) = PersonaNotes.parseLine(line)!!.text
+        // Every form the age takes on a page comes off again.
+        val minute = 60_000L
+        for (elapsed in listOf(0L, 59_000L, minute, 59 * minute, 60 * minute, 23 * 60 * minute, 24 * 60 * minute, 47 * 60 * minute, 48 * 60 * minute, 400 * 24 * 60 * minute)) {
+            val age = PersonaPrompts.age(elapsed)
+            assertEquals(age, "saw: his inbox has 4,000 unread", text("opinion | inbox | saw: his inbox has 4,000 unread (written $age)"))
+            assertEquals(age, "the rig waits for payday | stalled", text("thread | rig | the rig waits for payday | stalled (written $age)"))
+        }
+        // She closes a thread by ending it with its status, as she is told to. The age the page showed is then
+        // in the middle: it goes, and with it the status it stood behind.
+        assertEquals(
+            "his mom has surgery on november 18 | closed",
+            text("thread | mom-surgery | his mom has surgery on november 18 | open (written 3 days ago) | closed")
+        )
+        assertTrue(PersonaNotes.parseLine("thread | mom-surgery | his mom has surgery on november 18 | open (written 3 days ago) | closed")!!.isClosedThread)
+        assertEquals("the rig waits for payday | Open", text("thread | rig | the rig waits for payday (written yesterday) | Open"))
+        assertEquals("saw: his inbox has 4,000 unread | closed", text("thread | inbox | saw: his inbox has 4,000 unread (written 2 h ago) | closed"))
+        // Words of her own in brackets are hers, at the end of a note and anywhere else in it.
+        assertEquals("i keep every dumb thing he says (written on my arm)", text("me | list | i keep every dumb thing he says (written on my arm)"))
+        assertEquals("the song (written by momo) is mine now | open", text("thread | song | the song (written by momo) is mine now | open"))
+        assertEquals("the note (written 3 days ago) he left on the fridge", text("user | fridge | the note (written 3 days ago) he left on the fridge"))
+        assertEquals("the lyrics (written in 3 days) | closed", text("thread | lyrics | the lyrics (written in 3 days) | closed"))
+        // He hands her lines through the same reading.
+        assertEquals(
+            listOf("i keep every dumb thing he says (written on my arm)"),
+            PersonaNotes.read("me | list | i keep every dumb thing he says (written on my arm)").notes.map { it.text }
+        )
+    }
+
+    // ── Where a note came from ───────────────────────────────────────────────────────
+
+    private val day = 24 * 60 * 60_000L
+    private val build = Note(Kind.THREAD, "3d-build", "he is building my 3d model: hair and face are going on now | open")
+    private val builder = Note(Kind.USER, "builder", "he has been around about two months, building me")
+    private val oldBuilder = Note(Kind.USER, "builder", "he has been around about two months, building her")
+    private val surgery = Note(Kind.THREAD, "mom-surgery", "his mom has surgery on november 18 | open")
+    private val bees = Note(Kind.USER, "bees", "he keeps bees")
+    private val inbox = Note(Kind.OPINION, "inbox", "saw: his inbox has 4,000 unread")
+    private val whereFrom = PersonaNotes.Origins.of(
+        seed = listOf(build, builder),
+        earlier = listOf(oldBuilder),
+        how = mapOf(bees.storageKey to PersonaNotes.How.TOLD, inbox.storageKey to PersonaNotes.How.INFERRED, build.storageKey to PersonaNotes.How.READ)
+    )
+    private val sinceThen = PersonaNotes.Times(
+        writtenAt = listOf(build, builder, surgery, bees).associate { it.storageKey to 1_000L } + (inbox.storageKey to 1_000L + 20 * day),
+        nowMillis = 1_000L + 21 * day
+    )
+
+    @Test
+    fun `a starting note in the words of her files says so instead of its age, and a note she marked says how she knows it`() {
+        val block = PersonaNotes.render(listOf(build, builder, surgery, bees, inbox), times = sinceThen, origins = whereFrom)
+
+        assertTrue(block, block.contains("- he is building my 3d model: hair and face are going on now | open (from your files, read)\n"))
+        // Whatever its kind: a fact about him that her files gave her says so too.
+        assertTrue(block, block.contains("- he has been around about two months, building me (from your files)\n"))
+        assertTrue(block, block.contains("- his mom has surgery on november 18 | open (written 21 days ago)"))
+        assertTrue(block, block.contains("- he keeps bees (told)\n"))
+        assertTrue(block, block.contains("- saw: his inbox has 4,000 unread (written yesterday, inferred)"))
+        assertFalse(block, block.contains("open (written 21 days ago, from"))
+
+        // An earlier wording came from her files as well; a note she rewrote is hers and dates.
+        val earlierWords = PersonaNotes.render(listOf(oldBuilder), origins = whereFrom)
+        assertTrue(earlierWords, earlierWords.contains("- he has been around about two months, building her (from your files)"))
+        val rewritten = build.copy(text = "he is building my 3d model and the hair finally reads as hair | open")
+        val hers = PersonaNotes.render(listOf(rewritten), times = sinceThen, origins = PersonaNotes.Origins.of(listOf(build), emptyList()))
+        assertTrue(hers, hers.endsWith("| open (written 21 days ago)"))
+        assertFalse(hers, hers.contains(PersonaNotes.FROM_FILES))
+
+        // Without where they came from, a page is as it was.
+        assertFalse(PersonaNotes.render(listOf(build, bees), times = sinceThen).contains("(from"))
+        assertFalse(PersonaNotes.render(listOf(build, bees), times = sinceThen).contains("(told)"))
+    }
+
+    @Test
+    fun `a moment of hers shows the same beside each kind and key`() {
+        val keyed = PersonaNotes.renderKeyed(listOf(build, bees, inbox), times = sinceThen, origins = whereFrom).text
+        assertTrue(keyed, keyed.contains("- thread | 3d-build | he is building my 3d model: hair and face are going on now | open (from your files, read)"))
+        assertTrue(keyed, keyed.contains("- user | bees | he keeps bees (told)"))
+        assertTrue(keyed, keyed.contains("- opinion | inbox | saw: his inbox has 4,000 unread (written yesterday, inferred)"))
+    }
+
+    @Test
+    fun `her notebook pass and her sleep see a starting note as one, with her marks left to their own list`() {
+        val notes = listOf(build, builder, surgery, bees)
+        val pass = PersonaNotes.review(notes, times = sinceThen, origins = whereFrom).text
+        assertTrue(pass, pass.contains("thread | 3d-build | he is building my 3d model: hair and face are going on now | open (from your files)\n"))
+        assertTrue(pass, pass.contains("thread | mom-surgery | his mom has surgery on november 18 | open (written 21 days ago)"))
+        assertTrue(pass, pass.contains("user | bees | he keeps bees\n") || pass.endsWith("user | bees | he keeps bees"))
+        // Her sleep page keeps every age, and a starting note says where it came from as well.
+        val sleep = PersonaNotes.review(notes, times = sinceThen, allDated = true, origins = whereFrom).text
+        assertTrue(sleep, sleep.contains("thread | 3d-build | he is building my 3d model: hair and face are going on now | open (written 21 days ago, from your files)"))
+        assertTrue(sleep, sleep.contains("user | builder | he has been around about two months, building me (written 21 days ago, from your files)"))
+        assertTrue(sleep, sleep.contains("user | bees | he keeps bees (written 21 days ago)"))
+        assertFalse(sleep, sleep.contains("(told)"))
+    }
+
+    @Test
+    fun `what a page put behind a note is taken off a line that comes back with it, and words of hers in brackets stay`() {
+        fun text(line: String) = PersonaNotes.parseLine(line)!!.text
+        assertEquals(build.text, text("thread | 3d-build | ${build.text} (from your files, read)"))
+        assertEquals(builder.text, text("user | builder | ${builder.text} (from your files)"))
+        assertEquals("he keeps bees", text("user | bees | he keeps bees (told)"))
+        assertEquals("saw: his inbox has 4,000 unread", text("opinion | inbox | saw: his inbox has 4,000 unread (written yesterday, inferred)"))
+        for (mark in PersonaNotes.How.entries) {
+            assertEquals(mark.label, "he keeps bees", text("user | bees | he keeps bees (${mark.label})"))
+        }
+        // She closes a starting thread the way she closes any: the bracket goes with the status it stood behind.
+        assertEquals(
+            "he is building my 3d model: hair and face are on | closed",
+            text("thread | 3d-build | he is building my 3d model: hair and face are on | open (written 3 days ago, from your files) | closed")
+        )
+        assertEquals("he is building my 3d model | closed", text("thread | 3d-build | he is building my 3d model | open (from your files, read) | closed"))
+        // Brackets of hers stay: other words, or the notebook's words where they do not end the note.
+        assertEquals("i read it twice (read it twice)", text("me | twice | i read it twice (read it twice)"))
+        assertEquals("he means it (from your files, babe)", text("user | means | he means it (from your files, babe)"))
+        assertEquals("the line (told) he keeps using", text("user | line | the line (told) he keeps using"))
+    }
+
+    @Test
+    fun `a mark she puts behind a note in a bracket is kept as her mark, not lost with the bracket`() {
+        assertEquals(PersonaNotes.How.UNSURE, PersonaNotes.markOf("user | job | he might quit (unsure)"))
+        assertEquals(PersonaNotes.How.READ, PersonaNotes.markOf("thread | 3d-build | ${build.text} (from your files, read)"))
+        assertEquals(PersonaNotes.How.INFERRED, PersonaNotes.markOf("opinion | inbox | saw: his inbox is full (written yesterday, inferred)"))
+        assertEquals(PersonaNotes.How.LIVED, PersonaNotes.markOf("thread | 3d-build | he is building my 3d model | open (lived) | closed"))
+        // An age or the files alone is no mark, and neither is a bracket of her own words.
+        assertNull(PersonaNotes.markOf("user | builder | ${builder.text} (from your files)"))
+        assertNull(PersonaNotes.markOf("user | bees | he keeps bees (written 3 days ago)"))
+        assertNull(PersonaNotes.markOf("me | twice | i read it twice (read it twice)"))
+        assertNull(PersonaNotes.markOf("user | line | the line (told) he keeps using"))
+
+        // A block reads the mark of the line that stands as the note under each key.
+        val reading = PersonaNotes.read(
+            "user | job | he might quit (unsure)\nuser | bees | he keeps bees (told)\nuser | bees | he keeps two hives\nme | soda | melon soda (lived)"
+        )
+        assertEquals(listOf("he might quit", "he keeps two hives", "melon soda"), reading.notes.map { it.text })
+        assertEquals(
+            mapOf(Note(Kind.USER, "job", "x").storageKey to PersonaNotes.How.UNSURE, Note(Kind.ME, "soda", "x").storageKey to PersonaNotes.How.LIVED),
+            reading.marks
+        )
+        // A line the length limit broke off takes its mark with it.
+        val content = "user | job | he might quit (unsure)\nme | soda | melon soda (lived)"
+        val broken = PersonaNotes.withoutBrokenLine(PersonaNotes.read(content), content)
+        assertEquals(setOf(PersonaNotes.Note(PersonaNotes.Kind.USER, "job", "he might quit").storageKey), broken.marks.keys)
+
+        // A note written beside one she could not see keeps its mark under the key it is stored under.
+        val job = PersonaNotes.Note(PersonaNotes.Kind.USER, "job", "he might quit")
+        val beside = job.copy(key = "job-unseen")
+        assertEquals(
+            mapOf(beside.storageKey to PersonaNotes.How.UNSURE),
+            PersonaNotes.marksFor(listOf(beside), listOf(job), mapOf(job.storageKey to PersonaNotes.How.UNSURE))
+        )
+        assertTrue(PersonaNotes.marksFor(listOf(job), listOf(job), emptyMap()).isEmpty())
+    }
+}
