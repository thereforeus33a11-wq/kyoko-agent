+package com.opendroid.ai.core.voice.own
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonObject
+
+/**
+ * Whether her phone voice says English as English, and the guard on what that voice is
+ * given. Pure decisions over the voice's own files; [OwnVoice] reads the files and plays.
+ *
+ * Every voice of hers up to now (yume-20261118-f037defb1012 and before) learned Japanese
+ * phonemes only, so her English reaches it as katakana ([LineReaders.katakana]): that path
+ * is kept exactly as it is. A bilingual voice, trained on her English as English phonemes
+ * (voice/scripts/pod, stage2_lang.sh), is packed by opendroid/tools/make_own_voice.sh with
+ * ENGLISH_TABLE set, which writes into its config.json
+ *
+ *     "yume_english": {"phonemes": "en_ipa_table", "table": ..., "table_version": ...,
+ *                      "table_sha256": <sha256 of the en_ipa_table.json it was trained with>}
+ *
+ * and ships that table beside it. Only such a voice, whose shipped table is that very
+ * table, is the table this build's reader was checked against ([VERIFIED_TABLE_SHA256]),
+ * and whose tokens hold every symbol the table can give, reads English as English
+ * ([LineReaders.english]). Anything less (no marker, a marker naming another way, a
+ * missing or different table, a table this build was not checked against, missing
+ * tokens) keeps the katakana path: her Japanese is the same either way, and katakana
+ * English is what she sounded like before.
+ */
+object BilingualVoice {
+
+    /** The config.json field make_own_voice.sh writes for a bilingual voice. */
+    const val MARKER = "yume_english"
+
+    /** The only way of reading English this build knows. */
+    const val PHONEMES = "en_ipa_table"
+
+    /**
+     * The SHA-256 of the one en_ipa_table.json this build's reader ([MixedPhonemes],
+     * [EnglishPhonemes]) was held to, byte for byte, by MixedPhonemesParityTest. A voice
+     * trained with any other table (a new row, a renamed or added rule) could be read in
+     * ways it never learned without a single test noticing, so it keeps katakana until
+     * the phone fixture is re-made from that table and this pin moved with it (the test
+     * checks the pin against the table it reads).
+     */
+    const val VERIFIED_TABLE_SHA256 = "8a903fee70238110034f090aad901acd20f50587daf52d2cc9b7d75fabaea475"
+
+    sealed interface Reading {
+        /**
+         * Her English as katakana, through the Japanese path. [why] says why; [broken] is
+         * true when the voice's files claim English but disagree with each other.
+         */
+        data class Katakana(val why: String, val broken: Boolean = false) : Reading
+
+        /** Her English as English, read with [table], into a voice with these [tokens] (codepoints). */
+        class English(val table: EnglishTable, val tokens: Set<Int>) : Reading
+    }
+
+    /**
+     * How the voice with this [config] (its config.json), the shipped [table]
+     * (en_ipa_table.json's bytes) and [tokens] (its tokens.txt) reads English. Null for a
+     * file that is missing.
+     */
+    fun choose(config: String?, table: ByteArray?, tokens: String?): Reading {
+        val root = config?.let { runCatching { Json.parseToJsonElement(it).jsonObject }.getOrNull() }
+            ?: return Reading.Katakana("no readable config.json")
+        val marker = root[MARKER] ?: return Reading.Katakana("the voice reads Japanese phonemes only")
+        val fields = marker as? JsonObject
+            ?: return Reading.Katakana("$MARKER is not an object", broken = true)
+        val phonemes = (fields["phonemes"] as? JsonPrimitive)?.content
+        if (phonemes != PHONEMES) return Reading.Katakana("$MARKER names another way of reading: $phonemes", broken = true)
+        val want = (fields["table_sha256"] as? JsonPrimitive)?.content
+            ?: return Reading.Katakana("$MARKER names no table", broken = true)
+        if (table == null) return Reading.Katakana("en_ipa_table.json is missing", broken = true)
+        val sha = EnglishTable.sha256Hex(table)
+        if (!sha.equals(want, ignoreCase = true)) {
+            return Reading.Katakana("en_ipa_table.json ($sha) is not the table the voice was trained with ($want)", broken = true)
+        }
+        if (!sha.equals(VERIFIED_TABLE_SHA256, ignoreCase = true)) {
+            return Reading.Katakana("en_ipa_table.json ($sha) is not a table this build was checked against ($VERIFIED_TABLE_SHA256)", broken = true)
+        }
+        val parsed = runCatching { EnglishTable.parse(table) }.getOrElse {
+            return Reading.Katakana("en_ipa_table.json cannot be read: ${it.message}", broken = true)
+        }
+        val known = tokens?.let { tokenCodepoints(it) }
+            ?: return Reading.Katakana("tokens.txt is missing", broken = true)
+        val missing = symbols(parsed) - known
+        if (missing.isNotEmpty()) {
+            return Reading.Katakana("the voice has no token for ${missing.map { "U+%04X".format(it) }}", broken = true)
+        }
+        return Reading.English(parsed, known)
+    }
+
+    /**
+     * Every codepoint [table] can give for her English: the list make_own_voice.sh checks a
+     * voice's tokens against before it writes [MARKER], checked again here when the voice
+     * loads ([choose]).
+     */
+    fun symbols(table: EnglishTable): Set<Int> = table.symbols()
+
+    /**
+     * The symbols of a sherpa-onnx tokens.txt ("symbol id" per line; the symbol is all
+     * before the last space, so the space token is "  3"), as codepoints. A symbol of more
+     * than one codepoint cannot be given by codepoint and is left out.
+     */
+    fun tokenCodepoints(tokensTxt: String): Set<Int> {
+        val out = HashSet<Int>()
+        for (line in tokensTxt.split('\n')) {
+            val l = line.removeSuffix("\r")
+            if (l.isEmpty()) continue
+            val cut = l.lastIndexOf(' ')
+            if (cut < 0) continue
+            val symbol = l.substring(0, cut)
+            if (symbol.codePointCount(0, symbol.length) == 1) out += symbol.codePointAt(0)
+        }
+        return out
+    }
+
+    /** The sentences as the voice takes them, and the symbols left out because it has no token for them. */
+    class Kept(val sentences: List<IntArray>, val dropped: Set<Int>)
+
+    /**
+     * [sentences] (one codepoint per phoneme) with every phoneme the voice has no token
+     * for left out, the way her training left one out (Piper's phonemes_to_ids skips a
+     * phoneme missing from the id map, and the pod's phone test drops it too). A sentence
+     * left with nothing is not given at all.
+     */
+    fun keepKnown(sentences: List<List<String>>, tokens: Set<Int>): Kept {
+        val dropped = LinkedHashSet<Int>()
+        val kept = ArrayList<IntArray>(sentences.size)
+        for (s in sentences) {
+            val cps = ArrayList<Int>(s.size)
+            for (p in s) {
+                val cp = p.codePointAt(0)
+                if (cp in tokens) cps += cp else dropped += cp
+            }
+            if (cps.isNotEmpty()) kept += cps.toIntArray()
+        }
+        return Kept(kept, dropped)
+    }
+}
+
+/**
+ * Reads one line of hers (already through the speech normalizer) into the phoneme
+ * codepoints of each of its sentences, or null when the voice cannot say it at all
+ * (another script, or Open JTalk refused it), so that another voice says the line.
+ */
+fun interface LineReader {
+    fun read(normalized: String): List<IntArray>?
+}
+
+/** The two ways her own voice reads a line. */
+object LineReaders {
+
+    /**
+     * Today's way, for every voice that reads Japanese phonemes only: English words as
+     * katakana ([KanaText]), all of it through Open JTalk. Unchanged from before the
+     * bilingual voice.
+     */
+    fun katakana(kana: KanaText, labelsOf: (String) -> List<String>?): LineReader = LineReader { text ->
+        JapanesePhonemes.phonemizeAll(kana.convert(text), labelsOf)
+            ?.map { s -> s.map { it.codePointAt(0) }.toIntArray() }
+    }
+
+    /**
+     * The bilingual voice's way: [mixed] (her English as English, her Japanese through Open
+     * JTalk as before), with every phoneme the voice has no token for left out
+     * ([BilingualVoice.keepKnown]); [onDropped] hears which. A line the port fails on (a
+     * fault, not a line it cannot read) is read by [fallback] instead, so she is still
+     * heard in her own voice, and [onError] hears why.
+     */
+    fun english(
+        mixed: MixedPhonemes,
+        tokens: Set<Int>,
+        labelsOf: (String) -> List<String>?,
+        fallback: LineReader,
+        onDropped: (Set<Int>) -> Unit = {},
+        onError: (Exception) -> Unit = {},
+    ): LineReader = LineReader { text ->
+        val sentences = try {
+            mixed.phonemize(text, labelsOf)
+        } catch (e: Exception) {
+            onError(e)
+            return@LineReader fallback.read(text)
+        } ?: return@LineReader null
+        val kept = BilingualVoice.keepKnown(sentences, tokens)
+        if (kept.dropped.isNotEmpty()) onDropped(kept.dropped)
+        kept.sentences
+    }
+}
