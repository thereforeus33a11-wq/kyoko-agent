--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/TestThoughts.kt
@@ -0,0 +1,53 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.security.EncryptedSecret
+import com.opendroid.ai.core.security.SecretAeadCipher
+import com.opendroid.ai.core.security.SecretKeyUnavailableException
+import java.io.File
+import java.security.SecureRandom
+import javax.crypto.Cipher
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * Stands in for the phone's Keystore in tests: real AES-GCM under a key held in memory,
+ * so a file written with it is unreadable text and a changed file fails to open. With
+ * [lost] set the key is gone, as it is after the Keystore entry was removed. With
+ * [failingReads] above zero the Keystore does not answer that many times when it is
+ * asked to open something, and works again afterwards; with [noReads] it opens nothing
+ * while it still seals.
+ */
+internal class TestThoughtsCipher(keyByte: Int = 7) : SecretAeadCipher {
+    private val key = SecretKeySpec(ByteArray(32) { (it + keyByte).toByte() }, "AES")
+    private val random = SecureRandom()
+    var lost = false
+    var failingReads = 0
+    var noReads = false
+
+    override fun encrypt(plaintext: ByteArray, aad: ByteArray): EncryptedSecret {
+        if (lost) throw SecretKeyUnavailableException()
+        val iv = ByteArray(12).also(random::nextBytes)
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+        cipher.init(Cipher.ENCRYPT_MODE, key, GCMParameterSpec(128, iv))
+        cipher.updateAAD(aad)
+        return EncryptedSecret(iv, cipher.doFinal(plaintext))
+    }
+
+    override fun decrypt(iv: ByteArray, ciphertext: ByteArray, aad: ByteArray): ByteArray {
+        if (lost || noReads) throw SecretKeyUnavailableException()
+        if (failingReads > 0) {
+            failingReads--
+            throw SecretKeyUnavailableException()
+        }
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+        cipher.init(Cipher.DECRYPT_MODE, key, GCMParameterSpec(128, iv))
+        cipher.updateAAD(aad)
+        return cipher.doFinal(ciphertext)
+    }
+
+    override fun resetForReentry() = Unit
+}
+
+/** Her thoughts kept under [directory], sealed with a key that lives in the test and not in a Keystore. */
+internal fun testThoughts(directory: File, cipher: SecretAeadCipher = TestThoughtsCipher()): PersonaThoughts =
+    PersonaThoughts({ directory }, cipher)
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/VeniceImagesTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/VeniceImagesTest.kt
new file mode 100644
index 0000000..68c48dc
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/persona/VeniceImagesTest.kt
@@ -0,0 +1,103 @@
+package com.opendroid.ai.core.persona
+
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import okio.Buffer
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.InetAddress
+import java.util.Base64
+
+/**
+ * Venice's image endpoints as her pictures read them: the picture of a generate answer (JSON,
+ * base64), of an edit answer (the bytes themselves), a picture Venice flags or blurs never
+ * taken for one, bytes that are no picture refused, and every error said in plain words.
+ */
+class VeniceImagesTest {
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val client = OkHttpClient()
+
+    @After
+    fun stop() = server.close()
+
+    private val png = byteArrayOf(0x89.toByte(), 'P'.code.toByte(), 'N'.code.toByte(), 'G'.code.toByte(), 13, 10, 26, 10, 42)
+
+    private fun generate() = VeniceImages.generate(PictureModels.WAI, "p", "n", PicturePrompts.Shape.PORTRAIT, 1).at(server.url("/api/v1/image/generate").toString())
+    private fun edit() = VeniceImages.edit(PictureModels.QWEN_EDIT, "IMG", "p").at(server.url("/api/v1/image/edit").toString())
+
+    private fun json(body: String, vararg headers: Pair<String, String>) = MockResponse.Builder().code(200)
+        .setHeader("Content-Type", "application/json").apply { headers.forEach { (k, v) -> setHeader(k, v) } }.body(body).build()
+
+    private fun image(bytes: ByteArray, vararg headers: Pair<String, String>) = MockResponse.Builder().code(200)
+        .setHeader("Content-Type", "image/png").apply { headers.forEach { (k, v) -> setHeader(k, v) } }.body(Buffer().write(bytes)).build()
+
+    private fun status(code: Int) = MockResponse.Builder().code(code).setHeader("Content-Type", "application/json").body("""{"error":"x"}""").build()
+
+    @Test
+    fun `a generate answer is read for its first picture, and the request goes out with the key and the body`() = runBlocking {
+        server.enqueue(json("""{"id":"generate-1","images":["${Base64.getEncoder().encodeToString(png)}"],"timing":{"total":1}}"""))
+        val made = VeniceImages.send(client, "KEY", generate())
+        assertTrue(made is VeniceImages.Made.Picture)
+        assertEquals(png.toList(), (made as VeniceImages.Made.Picture).bytes.toList())
+        val request = server.takeRequest()
+        assertEquals("Bearer KEY", request.headers["Authorization"])
+        val body = Json.parseToJsonElement(request.body!!.utf8()).jsonObject
+        assertEquals("wai-Illustrious", body["model"].toString().trim('"'))
+        // A data URI is read as well as bare base64.
+        server.enqueue(json("""{"images":["data:image/png;base64,${Base64.getEncoder().encodeToString(png)}"]}"""))
+        assertTrue(VeniceImages.send(client, "KEY", generate()) is VeniceImages.Made.Picture)
+    }
+
+    @Test
+    fun `a picture Venice flags is never taken, and one it blurred is not kept`() = runBlocking {
+        server.enqueue(json("""{"images":["${Base64.getEncoder().encodeToString(png)}"]}""", "x-venice-is-content-violation" to "true"))
+        assertEquals(VeniceImages.Made.Blocked, VeniceImages.send(client, "KEY", generate()))
+        server.enqueue(image(png, "x-venice-is-content-violation" to "true"))
+        assertEquals(VeniceImages.Made.Blocked, VeniceImages.send(client, "KEY", edit()))
+        // Every variant refused under the provider's policy: none came back.
+        server.enqueue(json("""{"images":[],"content_policy_violation_count":1}"""))
+        assertEquals(VeniceImages.Made.Blocked, VeniceImages.send(client, "KEY", generate()))
+        server.enqueue(image(png, "x-venice-is-blurred" to "true"))
+        val blurred = VeniceImages.send(client, "KEY", edit())
+        assertEquals("The picture came back blurred, so it is not kept.", (blurred as VeniceImages.Made.Failed).why)
+    }
+
+    @Test
+    fun `an edit answer is the picture itself, and bytes that are no picture are refused`() = runBlocking {
+        server.enqueue(image(png))
+        assertTrue(VeniceImages.send(client, "KEY", edit()) is VeniceImages.Made.Picture)
+        server.enqueue(image("<html>no</html>".toByteArray()))
+        assertEquals("What came back is not a picture.", (VeniceImages.send(client, "KEY", edit()) as VeniceImages.Made.Failed).why)
+        server.enqueue(json("""{"images":["${Base64.getEncoder().encodeToString("text".toByteArray())}"]}"""))
+        assertEquals("What came back is not a picture.", (VeniceImages.send(client, "KEY", generate()) as VeniceImages.Made.Failed).why)
+        server.enqueue(json("""not json"""))
+        assertTrue(VeniceImages.send(client, "KEY", generate()) is VeniceImages.Made.Failed)
+        server.enqueue(json("""{"ok":true}"""))
+        assertTrue(VeniceImages.send(client, "KEY", edit()) is VeniceImages.Made.Failed)
+    }
+
+    @Test
+    fun `every error is said in plain words`() = runBlocking {
+        val said = mapOf(
+            401 to "The image service did not take the Venice key.",
+            402 to "The Venice balance is too low to make a picture.",
+            422 to "Venice's content rules turned this picture down.",
+            429 to "The image service is busy. Try again in a minute.",
+            400 to "The image service could not take this request (400).",
+            503 to "The image service is down or overloaded (503). Try again later."
+        )
+        for ((code, why) in said) {
+            server.enqueue(status(code))
+            assertEquals(why, (VeniceImages.send(client, "KEY", generate()) as VeniceImages.Made.Failed).why)
+        }
+        val gone = VeniceImages.send(client, "KEY", generate().at("http://127.0.0.1:9/none"))
+        assertEquals("The image service could not be reached.", (gone as VeniceImages.Made.Failed).why)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/record/HistoryImportTest.kt b/app/src/test/java/com/opendroid/ai/core/record/HistoryImportTest.kt
new file mode 100644
