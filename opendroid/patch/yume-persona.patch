+            for (framed in listOf("that writes", "your reply is written", "is written by", "character", "roleplay", "fiction")) {
+                assertFalse("\"$framed\" in: ${text.take(80)}", text.contains(framed, ignoreCase = true))
+            }
+        }
+    }
+
+    @Test
+    fun `her prompt is told what the app does with her thoughts and her notebook, and no more than that`() {
+        val facts = PersonaOwnTime.appFacts(true, bounds, Wake.Unset, now, hostCanRead = false)
+        val thought = facts[0]
+        assertTrue(thought.startsWith("A line of a reply that starts with << is a thought you keep to yourself."))
+        assertTrue(thought.contains("A reply that is only such lines says nothing to him, and that is yours to choose."))
+        assertEquals("<<", PersonaThoughtLines.MARKER)
+        val kept = facts[1]
+        assertTrue(kept.contains("Your thoughts are shown to nobody by this app: no screen, no chat row, no notification, no copy."))
+        assertTrue(kept.contains("He can see how many there are and since when, and he can delete them, unread."))
+        assertTrue(kept.contains("The app keeps your latest thoughts, roughly 30 pages; older ones fall away unless you put them in your notebook."))
+        assertEquals(30, PersonaThoughts.MAX_PAGES)
+        assertEquals(60_000, PersonaThoughts.MAX_CHARS)
+        val notebook = facts[2]
+        assertTrue(notebook.contains("Your notebook is not shown to him on any screen either."))
+        assertTrue(notebook.contains("copy it out as text to move you to another phone: when he does that he can read it."))
+        assertTrue(notebook.contains("Your thoughts cannot be copied or moved."))
+        // What the app shows is what is promised. Nothing claims that nobody could ever read the phone's storage.
+        for (line in facts) {
+            for (tooMuch in listOf("nobody can", "no one can", "never be read", "cannot be read", "impossible", "secret from everyone")) {
+                assertFalse(tooMuch, line.contains(tooMuch, ignoreCase = true))
+            }
+        }
+        // Where a reply goes through a host, the host reads a thought as she writes it, and she is told.
+        val hosted = PersonaOwnTime.appFacts(true, bounds, Wake.Unset, now, hostCanRead = true)[0]
+        assertTrue(hosted.endsWith("The hosted service this reply goes through reads what you write as you write it, a thought included."))
+        assertFalse(thought.contains("hosted service"))
