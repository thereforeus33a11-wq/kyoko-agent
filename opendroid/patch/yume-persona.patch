+        val held = PersonaPrompts.shapeHistory(rows.map { it.message }, holdBackPrivateResults = true)
+
+        assertEquals(
+            listOf(PersonaPrompts.HANDLED_COMMAND_LABEL + "read my notifications", "still alive over there?", "what?"),
+            held.dialogue.map { it.text }
