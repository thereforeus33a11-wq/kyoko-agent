+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.llm.LLMProviderFactory
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Sorting his message into talk or command must not show it to a model that may not read
+ * it. Where the main model may not, the message is sorted on the phone: plain talk still
+ * reaches the reply, and a command still goes to the planner.
+ */
+class IntentClassifierLocalDecisionTest {
+
+    private val custom = "Custom OpenAI Compatible"
+
+    /** The main model is a plain hosted one; [replyModel] is what writes her replies. */
+    private fun config(
+        policy: RoutePolicy,
+        privateMode: Boolean = true,
+        replyModel: String = "",
+        mainModel: String = "some-plain-model"
+    ) = LLMConfig(
+        routePolicy = policy,
+        privateMode = privateMode,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to mainModel),
+        customEndpoints = mapOf(custom to "https://api.venice.ai/api/v1"),
+        personaChatModel = replyModel
+    )
+
+    private val encrypted = "e2ee-gemma-4-26b-a4b-uncensored-p"
+
+    @Test
+    fun `a main route the policy refuses is never asked`() {
+        for (policy in listOf(RoutePolicy.ENCRYPTED, RoutePolicy.OWN_HARDWARE)) {
+            for (replyOnOwnRoute in listOf(true, false)) {
+                assertFalse(
+                    "$policy / $replyOnOwnRoute",
+                    IntentClassifier.mayAskModel(config(policy, replyModel = encrypted), replyOnOwnRoute)
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `a readable main route is not asked while her reply is written on a private one`() {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        assertFalse(IntentClassifier.mayAskModel(splitRoutes, replyOnOwnRoute = true))
+
+        val localReplies = config(RoutePolicy.ANY).copy(
+            personaChatProvider = "Ollama", ollamaUrl = "http://192.168.1.20:11434"
+        )
+        assertFalse(IntentClassifier.mayAskModel(localReplies, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `the main model is asked when it will read the message anyway, or may read everything`() {
+        // No reply of her own: the stock chat goes to the main model whatever is decided here.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY, replyModel = encrypted), replyOnOwnRoute = false))
+        // Her reply is on the same readable route.
+        assertTrue(IntentClassifier.mayAskModel(config(RoutePolicy.ANY), replyOnOwnRoute = true))
+        // He switched private mode off: nothing is held back from the main route.
+        assertTrue(
+            IntentClassifier.mayAskModel(
+                config(RoutePolicy.ANY, privateMode = false, replyModel = encrypted), replyOnOwnRoute = true
+            )
+        )
+        // The main model is itself on a private route.
+        for (policy in RoutePolicy.entries.filter { it != RoutePolicy.OWN_HARDWARE }) {
+            assertTrue(
+                "$policy",
+                IntentClassifier.mayAskModel(config(policy, mainModel = encrypted), replyOnOwnRoute = true)
+            )
+        }
+        val onDevice = LLMConfig(routePolicy = RoutePolicy.OWN_HARDWARE, activeProvider = "On-Device AI")
+        assertTrue(IntentClassifier.mayAskModel(onDevice, replyOnOwnRoute = true))
+    }
+
+    @Test
+    fun `plain talk is talk`() {
+        for (query in listOf(
+            "how was your day", "i am upset and want to forget it", "that makes sense", "i get it",
+            "you never listen", "we should do this together", "what's next for us", "i already told you",
+            "my alarm did not go off this morning", "are you still mad at me", "tell me a street story",
+            "ok", "", "   ", "lol", "what do you think about bees", "i will take a nap", "you remember the hive?"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a plain imperative is still talk, however it opens`() {
+        for (query in listOf(
+            "take your time", "show me", "get over here", "turn around", "make me laugh", "save me a seat",
+            "read my mind", "write me a poem about bees", "check this out", "run away with me",
+            "remember when we met", "next time bring flowers", "start over", "please get lost",
+            "hey, make up your mind", "take off your jacket and get on the bike"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a forced-action word inside plain talk does not make it a command`() {
+        for (query in listOf(
+            "i can't find the words for today", "what music did you grow up with", "you never text back",
+            "the news today made me sad", "i'll send you something later", "we should open up more",
+            "let's play a game tonight", "that film had great dialogue", "the texture of that fabric",
+            "i was playing with the idea", "i had a call with the inspector today", "my phone died on the hill",
+            "i keep searching for the right word", "did you find what you were looking for",
+            "i'd google it but i'd rather hear it from you", "phone's dying, talk later"
+        )) {
+            assertTrue("$query should still count as forced when a model is asked", IntentClassifier.isForcedAction(query))
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a call or a message to himself or to her is talk`() {
+        for (query in listOf(
+            "call me when you wake up", "text me later", "message me when you are back", "ring me tomorrow",
+            "send me a picture", "please call me", "hey, text me", "call you later", "call it a day",
+            "Call me maybe", "phone me", "send us off with a song"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+        // Someone else after the same word is a contact.
+        for (query in listOf("call my mom", "text Sam I'm late", "send Riya the list", "message the inspector")) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a command is a command`() {
+        for (query in listOf(
+            // Opening with a forced-action word, after any lead-in.
+            "call dad", "can you text Sam I'm late", "play something loud", "open the camera",
+            "send Riya the list", "find my keys", "search for hive frames", "google bee suits",
+            "please navigate home", "look up the ferry times", "translate this to french",
+            "remember this", "what did i save about the hive", "music", "ok, call dad",
+            // Something only the phone answers for, wherever the word stands.
+            "what's the weather", "turn on the flashlight", "is the wifi on", "how loud is the volume",
+            "i need a screenshot of this", "bluetooth off",
+            // Opening like a command and naming a thing on the phone.
+            "show me my calendar", "create a note about the hive", "check my email", "set a reminder for five",
+            "delete the alarm for monday", "write an email to Riya", "start a timer", "list my reminders",
+            "Please check my calendar", "could you set a reminder for the inspector",
+            "hey, can you show me my calendar", "babe, check my email", "ok now set an alarm",
+            "  >> create a note: jars", "Email Riya the list", "alarm at seven", "note: buy jars",
+            "lock the phone", "lock the screen", "read my notifications", "take a photo", "check the battery",
+            "list my apps", "read my messages", "make a call to the inspector", "pause the music"
+        )) {
+            assertTrue(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `a thing on the phone counts as a whole word only`() {
+        for (query in listOf(
+            "show me you appreciate it", "make the apple pie", "take the filet off the heat",
+            "read the context again", "check the screenplay"
+        )) {
+            assertFalse(query, IntentClassifier.decideLocally(query))
+        }
+    }
+
+    @Test
+    fun `sorting on the phone never reaches for a provider`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw AssertionError("the main model must not be asked") }
+        )
+
+        assertFalse(classifier.requiresAction("how was your day", askModel = false))
+        assertFalse(classifier.requiresAction("i get it, that makes sense", askModel = false))
+        assertFalse(classifier.requiresAction("take your time", askModel = false))
+        // A forced word does not short-cut the local sort.
+        assertFalse(classifier.requiresAction("i can't find the words for today", askModel = false))
+        assertFalse(classifier.requiresAction("call me when you wake up", askModel = false))
+        assertTrue(classifier.requiresAction("show me my calendar", askModel = false))
+        assertTrue(classifier.requiresAction("call dad", askModel = false))
+    }
+
+    @Test
+    fun `a failed call still falls back to the words instead of losing the message`() = runBlocking {
+        val classifier = IntentClassifier(
+            dagger.Lazy<LLMProviderFactory> { throw IllegalStateException("no provider") }
+        )
+
+        // The stock offline fallback, unchanged: any action keyword anywhere.
+        assertEquals(true, classifier.requiresAction("could we take a break"))
+        assertEquals(false, classifier.requiresAction("how was your day"))
+    }
+
+    @Test
+    fun `a command is planned unless the planner's route is refused while she can still answer`() {
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        assertEquals(MessageHandling.TALK, IntentClassifier.handling(refusedMain, personaActive = true, isCommand = false))
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier.handling(refusedMain, personaActive = true, isCommand = true)
+        )
+        // Without her the stock chat would be refused on the same route: the planner's error says so.
+        assertEquals(MessageHandling.PLAN, IntentClassifier.handling(refusedMain, personaActive = false, isCommand = true))
+        // Her own route is refused too: nothing can answer, and the error names the main model.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED), personaActive = true, isCommand = true)
+        )
+        // An allowed planner plans, hosted or private.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ANY, replyModel = encrypted), personaActive = true, isCommand = true)
+        )
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier.handling(config(RoutePolicy.ENCRYPTED, mainModel = encrypted), personaActive = true, isCommand = true)
+        )
+    }
+
+    /** Counts how often the classifier reaches for the main model; every attempt fails. */
+    private class CountingFactory : dagger.Lazy<LLMProviderFactory> {
+        var asked = 0
+        override fun get(): LLMProviderFactory {
+            asked++
+            throw IllegalStateException("no provider in this test")
+        }
+    }
+
+    @Test
+    fun `the loop's sort asks the main model only where it may read the message`() = runBlocking {
+        val splitRoutes = config(RoutePolicy.ANY, replyModel = encrypted)
+        val refusedMain = config(RoutePolicy.ENCRYPTED, replyModel = encrypted)
+
+        for (settings in listOf(splitRoutes, refusedMain)) {
+            val factory = CountingFactory()
+            val classifier = IntentClassifier(factory)
+            assertEquals(MessageHandling.TALK, classifier.sort("how was your day", settings, personaActive = true))
+            assertEquals(
+                MessageHandling.TALK,
+                classifier.sort("i can't find the words for today", settings, personaActive = true)
+            )
+            assertEquals(MessageHandling.TALK, classifier.sort("call me when you wake up", settings, personaActive = true))
+            assertEquals("${settings.routePolicy}", 0, factory.asked)
+        }
+
+        // A command: planned where the planner may be used, answered by her where it may not.
+        assertEquals(
+            MessageHandling.PLAN,
+            IntentClassifier(CountingFactory()).sort("call dad", splitRoutes, personaActive = true)
+        )
+        assertEquals(
+            MessageHandling.TALK_PLANNER_REFUSED,
+            IntentClassifier(CountingFactory()).sort("call dad", refusedMain, personaActive = true)
+        )
+
+        // One hosted model for everything, which reads the message anyway: it is asked.
+        val oneModel = CountingFactory()
+        IntentClassifier(oneModel).sort("how was your day", config(RoutePolicy.ANY), personaActive = true)
+        assertEquals(1, oneModel.asked)
+        // The stock chat, without her: the same.
+        val stock = CountingFactory()
+        IntentClassifier(stock).sort("how was your day", splitRoutes, personaActive = false)
+        assertEquals(1, stock.asked)
+    }
+}
