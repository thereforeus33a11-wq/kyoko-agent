diff --git a/app/src/test/java/com/opendroid/ai/ui/viewmodel/SettingsViewModelOwnLifeTest.kt b/app/src/test/java/com/opendroid/ai/ui/viewmodel/SettingsViewModelOwnLifeTest.kt
