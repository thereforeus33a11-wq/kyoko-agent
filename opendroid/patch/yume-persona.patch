+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/Feeds.kt
@@ -0,0 +1,248 @@
+package com.opendroid.ai.core.life.reading
+
+import android.util.Xml
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import org.xmlpull.v1.XmlPullParser
+import java.io.StringReader
+import java.time.OffsetDateTime
+import java.time.ZonedDateTime
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her feeds: RSS 2.0, RSS 1.0 (RDF) and Atom, read with [XmlPullParser], which resolves no
+ * external entities. The defaults are hers, and he can remove any: Yahoo! JAPAN's
+ * entertainment and top picks first (her taste: gossip before hard news), then Google News
+ * top stories for Japan and in English. A topic is a
+ * Google News search. He can add YouTube channels; she can follow a site's own feed.
+ *
+ * The feeds are hers, not his locale: the same addresses on every phone, so nothing about
+ * him goes out with them.
+ */
+@Singleton
+class Feeds @Inject constructor(private val fetcher: HerFetcher) {
+
+    data class Feed(val id: String, val name: String, val url: String)
+
+    data class Item(
+        val title: String,
+        /** The link the feed gives. */
+        val link: String?,
+        /** Who published it, where the feed says. */
+        val source: String?,
+        val publishedAt: Long?,
+        val image: String?,
+        val summary: String
+    ) {
+        /**
+         * Where the item opens: its own https link, unless that is a Google News redirect
+         * page, which may not open (UNCONFIRMED): then only the headline is shown.
+         */
+        val opensAt: String?
+            get() = link?.takeIf { it.startsWith("https://") && !isGoogleNewsRedirect(it) }
+    }
+
+    sealed class Read {
+        data class Items(val feed: Feed, val items: List<Item>) : Read()
+
+        data class Refused(val feed: Feed, val why: HerFetcher.Why) : Read()
+
+        data class Unreadable(val feed: Feed) : Read()
+    }
+
+    /**
+     * Reads [feed]. A feed is published for readers to read, so it is read the way a feed
+     * reader reads it, without robots.txt, a crawler's rule (YouTube's closes its own feeds
+     * to crawlers); every other fetch rule holds.
+     */
+    suspend fun read(feed: Feed): Read = when (val fetched = fetcher.fetch(feed.url, robots = false)) {
+        is HerFetcher.Fetched.Refused -> Read.Refused(feed, fetched.why)
+        is HerFetcher.Fetched.Page -> parse(fetched.text())?.let { Read.Items(feed, it) } ?: Read.Unreadable(feed)
+    }
+
+    companion object {
+        const val MAX_ITEMS = 50
+
+        /** How many feeds she may follow herself. */
+        const val MAX_FOLLOWED = 12
+
+        val GOOGLE_NEWS_JAPAN = Feed("gnews-ja", "Google News (Japan)", "https://news.google.com/rss?hl=ja&gl=JP&ceid=JP:ja")
+        val GOOGLE_NEWS_WORLD = Feed("gnews-en", "Google News (world)", "https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en")
+        val YAHOO_TOP = Feed("yahoo-top", "Yahoo! JAPAN top picks", "https://news.yahoo.co.jp/rss/topics/top-picks.xml")
+        val YAHOO_ENTERTAINMENT = Feed("yahoo-ent", "Yahoo! JAPAN entertainment", "https://news.yahoo.co.jp/rss/topics/entertainment.xml")
+
+        /** Her feeds as this build ships them. */
+        val DEFAULTS = listOf(YAHOO_ENTERTAINMENT, YAHOO_TOP, GOOGLE_NEWS_JAPAN, GOOGLE_NEWS_WORLD)
+
+        private val JAPANESE = Regex("""[぀-ヿ㐀-鿿豈-﫿]""")
+
+        /** A Google News search for [topic], in Japanese when the topic is written in Japanese. */
+        fun search(topic: String): Feed {
+            val japanese = JAPANESE.containsMatchIn(topic)
+            val url = HttpUrl.Builder().scheme("https").host("news.google.com").addPathSegments("rss/search")
+                .addQueryParameter("q", topic.trim())
+                .addQueryParameter("hl", if (japanese) "ja" else "en-US")
+                .addQueryParameter("gl", if (japanese) "JP" else "US")
+                .addQueryParameter("ceid", if (japanese) "JP:ja" else "US:en")
+                .build().toString()
+            return Feed("gnews-search", "Google News: ${topic.trim()}", url)
+        }
+
+        private val CHANNEL_ID = Regex("""^UC[A-Za-z0-9_-]{22}$""")
+
+        /** The feed of a YouTube channel by its id. */
+        fun youtube(channelId: String, name: String = "YouTube"): Feed? =
+            channelId.takeIf { CHANNEL_ID.matches(it) }?.let { Feed("yt-$it", name, "https://www.youtube.com/feeds/videos.xml?channel_id=$it") }
+
+        /** The channel id in a channel URL he pastes (`youtube.com/channel/UC…`), or null for a URL that names it otherwise. */
+        fun channelIdOf(url: String): String? {
+            val parsed = url.trim().let { if ("://" in it) it else "https://$it" }.toHttpUrlOrNull() ?: return null
+            if (!parsed.host.endsWith("youtube.com")) return null
+            val segments = parsed.pathSegments
+            val at = segments.indexOf("channel")
+            parsed.queryParameter("channel_id")?.takeIf { CHANNEL_ID.matches(it) }?.let { return it }
+            return segments.getOrNull(at + 1)?.takeIf { at >= 0 && CHANNEL_ID.matches(it) }
+        }
+
+        private val PAGE_CHANNEL_ID = listOf(
+            Regex("""<link[^>]+rel=["']canonical["'][^>]+href=["']https://www\.youtube\.com/channel/(UC[A-Za-z0-9_-]{22})"""),
+            Regex("""<meta[^>]+itemprop=["'](?:identifier|channelId)["'][^>]+content=["'](UC[A-Za-z0-9_-]{22})"""),
+            Regex(""""(?:externalId|channelId)"\s*:\s*"(UC[A-Za-z0-9_-]{22})"""")
+        )
+
+        /** The channel id on a channel's page (an `@handle` URL fetched once). */
+        fun channelIdInPage(html: String): String? =
+            PAGE_CHANNEL_ID.firstNotNullOfOrNull { it.find(html)?.groupValues?.get(1) }
+
+        fun isGoogleNewsRedirect(url: String): Boolean {
+            val parsed = url.toHttpUrlOrNull() ?: return false
+            return parsed.host == "news.google.com" && parsed.encodedPath.startsWith("/rss/articles")
+        }
+
+        /**
+         * The items of a feed, newest first where they are dated, or null when [xml] is no
+         * RSS or Atom feed.
+         */
+        fun parse(xml: String, newParser: () -> XmlPullParser = { Xml.newPullParser() }): List<Item>? {
+            val parser = newParser()
+            return try {
+                parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+                parser.setInput(StringReader(xml.trimStart('﻿').trimStart()))
+                read(parser)
+            } catch (e: Exception) {
+                null
+            }
+        }
+
+        private class Draft {
+            var title = ""
+            var link: String? = null
+            var source: String? = null
+            var date: Long? = null
+            var image: String? = null
+            var summary = ""
+        }
+
+        private fun read(parser: XmlPullParser): List<Item>? {
+            var isFeed = false
+            val items = ArrayList<Item>()
+            var item: Draft? = null
+            var event = parser.eventType
+            while (event != XmlPullParser.END_DOCUMENT && items.size < MAX_ITEMS) {
+                if (event == XmlPullParser.START_TAG) {
+                    val name = parser.name.lowercase(Locale.ROOT)
+                    when {
+                        name == "rss" || name == "feed" || name == "rdf:rdf" || name == "channel" -> isFeed = true
+                        name == "item" || name == "entry" -> item = Draft()
+                        item != null -> fill(item, name, parser)
+                    }
+                } else if (event == XmlPullParser.END_TAG) {
+                    val name = parser.name.lowercase(Locale.ROOT)
+                    if ((name == "item" || name == "entry") && item != null) {
+                        item.toItem()?.let(items::add)
+                        item = null
+                    }
+                }
+                event = parser.next()
+            }
+            if (!isFeed) return null
+            val dated = items.any { it.publishedAt != null }
+            return if (dated) items.sortedByDescending { it.publishedAt ?: Long.MIN_VALUE } else items
+        }
+
+        private fun fill(item: Draft, name: String, parser: XmlPullParser) {
+            when (name) {
+                "title" -> item.title = text(parser)
+                "link" -> {
+                    val href = parser.getAttributeValue(null, "href")
+                    val rel = parser.getAttributeValue(null, "rel")
+                    if (href != null) {
+                        if (rel == null || rel == "alternate") item.link = href.trim()
+                    } else {
+                        text(parser).takeIf { it.isNotEmpty() }?.let { item.link = it }
+                    }
+                }
+                "source" -> item.source = text(parser).takeIf { it.isNotEmpty() }
+                "pubdate", "published", "updated", "dc:date" -> if (item.date == null || name == "published") item.date = dateOf(text(parser))
+                "description", "summary", "content", "media:description" -> if (item.summary.isEmpty()) item.summary = plain(text(parser))
+                "media:thumbnail", "media:content", "enclosure" -> {
+                    val url = parser.getAttributeValue(null, "url")
+                    val type = parser.getAttributeValue(null, "type").orEmpty()
+                    if (item.image == null && url != null && url.startsWith("https://") && (name != "enclosure" || type.startsWith("image/"))) item.image = url
+                }
+            }
+        }
+
+        private fun Draft.toItem(): Item? {
+            var heading = plain(title)
+            if (heading.isEmpty()) return null
+            val from = source?.let(::plain)
+            // Google News puts the source at the end of each headline as well.
+            if (from != null && heading.endsWith(" - $from")) heading = heading.removeSuffix(" - $from").trim()
+            return Item(heading, link, from, date, image, summary.take(500))
+        }
+
+        /** The text of the current element; markup inside it is skipped. */
+        private fun text(parser: XmlPullParser): String {
+            val out = StringBuilder()
+            var depth = 1
+            while (depth > 0) {
+                when (parser.next()) {
+                    XmlPullParser.TEXT, XmlPullParser.CDSECT -> out.append(parser.text)
+                    XmlPullParser.ENTITY_REF -> out.append(parser.text ?: "")
+                    XmlPullParser.START_TAG -> depth++
+                    XmlPullParser.END_TAG -> depth--
+                    XmlPullParser.END_DOCUMENT -> return out.toString().trim()
+                }
+            }
+            return out.toString().trim()
+        }
+
+        private val TAGS = Regex("""<[^>]+>""")
+        private val ENTITIES = mapOf("&amp;" to "&", "&lt;" to "<", "&gt;" to ">", "&quot;" to "\"", "&#39;" to "'", "&nbsp;" to " ")
+
+        /** Text without markup and with the common entities written out. */
+        internal fun plain(text: String): String {
+            var out = TAGS.replace(text, " ")
+            ENTITIES.forEach { (entity, char) -> out = out.replace(entity, char) }
+            return out.replace(Regex("""[\s　]+"""), " ").trim()
+        }
+
+        private fun dateOf(text: String): Long? {
+            val value = text.trim()
+            if (value.isEmpty()) return null
+            return try {
+                ZonedDateTime.parse(value, DateTimeFormatter.RFC_1123_DATE_TIME).toInstant().toEpochMilli()
+            } catch (e: Exception) {
+                try {
+                    OffsetDateTime.parse(value).toInstant().toEpochMilli()
+                } catch (e: Exception) {
+                    null
+                }
+            }
+        }
+    }
+}
