@@ -0,0 +1,182 @@
+package com.opendroid.ai.core.service
+
+import android.content.Context
+import android.util.Log
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.opendroid.ai.core.agent.AgentLoop
+import com.opendroid.ai.data.repository.SettingsRepository
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * The alarm for her own time: it wakes the phone at the time she named for her next
+ * moment, lets her have it, and shows what she marked for the owner as a notification.
+ *
+ * It is one piece of scheduled work that runs once, set to the delay until the stored
+ * time and set again whenever that time changes ([arm]). Nothing repeats by itself: when
+ * a moment is over, the next one is whatever time she named in it. The stored time is
+ * the truth and this work is only the alarm, so it survives the process being put away:
+ * the system keeps the work, and a moment whose time passed while the app was not
+ * running is had when the work next runs, once.
+ *
+ * It is scheduled work and not an exact alarm. The system runs it at the time or later:
+ * while the phone dozes, in its next maintenance window. Being late is accepted, and
+ * she is told so; an exact alarm would need a permission of its own. It has no network
+ * constraint, because her model may run on the phone.
+ */
+class OwnTimeWorker(
+    appContext: Context,
+    workerParams: WorkerParameters
+) : CoroutineWorker(appContext, workerParams) {
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface OwnTimeWorkerEntryPoint {
+        fun agentLoop(): AgentLoop
+        fun settingsRepository(): SettingsRepository
+    }
+
+    private fun entryPoint(): OwnTimeWorkerEntryPoint =
+        EntryPointAccessors.fromApplication(applicationContext, OwnTimeWorkerEntryPoint::class.java)
+
+    override suspend fun doWork(): Result {
+        // Before anything else: from here on the alarm must not be set by anyone but this work.
+        inMoment.set(true)
+        var failed = false
+        try {
+            val entryPoint = entryPoint()
+            // Off the main thread: the moment reads the stores and builds a prompt. A go: line
+            // of hers is handed by the loop to the host of her outings in the service and runs
+            // there by itself: this work does not wait for it, so the system's limit on
+            // scheduled work does not bound an outing.
+            val line = withContext(Dispatchers.Default) {
+                entryPoint.agentLoop().personaOwnTime(applicationContext)
+            }
+            val showText = line != null && entryPoint.settingsRepository().llmConfig.first().checkInShowsText
+            try {
+                // A command she wrote is started by the loop and runs by itself. This work is
+                // what keeps a dozing phone awake, so it stays until the command has run its
+                // course, a few minutes at most. It only waits, and returns at once when
+                // nothing was started: a command that takes longer is left running.
+                entryPoint.agentLoop().awaitCheckInAction(ACTION_WAIT_MILLIS)
+            } finally {
+                // Her line is shown only now, whatever ended the wait. Where the notification
+                // carries her words and she wrote a command with them, the app says in front
+                // of them what is known of the command by now, so that her line is not all
+                // he reads about what the phone did.
+                if (line != null) {
+                    val commandMark = entryPoint.agentLoop().ownTimeCommandMark()
+                    OpenDroidService.showCheckInNotification(applicationContext, line, showText, commandMark)
+                }
+            }
+            // A plan of hers that needs his yes waits in the chat. It is not announced
+            // aloud into a room he may be asleep in: he is told only that there is one. While
+            // she sleeps (this ring was for her sleep) nothing comes from her, this note neither.
+            if (entryPoint.agentLoop().ownTimePlanAwaitsYes() && !entryPoint.agentLoop().personaAsleep()) {
+                OpenDroidService.showOwnTimePlanNotification(applicationContext)
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            failed = true
+            Log.w(TAG, "A moment of her own was skipped: ${e.javaClass.simpleName}")
+        } finally {
+            inMoment.set(false)
+        }
+        // The alarm is set again from what is stored by now: the time she named, the
+        // default, or the short wait after an attempt that failed. Setting it replaces
+        // this very work, which is over at this point. Whatever is stored, the work does
+        // not run again at once: a stored time that something kept in the past would
+        // otherwise wake the phone over and over without a pause.
+        notBefore = System.currentTimeMillis() + if (failed) AFTER_FAILURE_MILLIS else AFTER_RUN_MILLIS
+        try {
+            entryPoint().agentLoop().armOwnTime()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The alarm for her next moment was not set: ${e.javaClass.simpleName}")
+        }
+        return Result.success()
+    }
+
+    companion object {
+        private const val TAG = "OwnTimeWorker"
+
+        /** The name the work was first scheduled under, kept so that the old repeating check is replaced by this one. */
+        const val WORK_NAME = "opendroid_persona_check_in"
+
+        /**
+         * How long the work stays for a command she wrote. Well inside the ten minutes
+         * the system gives scheduled work, and far more than a planner call and a few
+         * steps take.
+         */
+        const val ACTION_WAIT_MILLIS = 3 * 60_000L
+
+        /** After a run the work is not run again sooner than this, whatever time is stored. */
+        const val AFTER_RUN_MILLIS = 60_000L
+
+        /** The same after a run that broke off with an error nobody foresaw. */
+        const val AFTER_FAILURE_MILLIS = 15 * 60_000L
+
+        // The earliest time the alarm may ring, set when a run ends. See [AFTER_RUN_MILLIS].
+        @Volatile private var notBefore = 0L
+
+        // True while a moment is being had in this process. Setting the alarm replaces the
+        // scheduled work, and replacing the work that is running would cut her moment
+        // short; the work sets the alarm itself once it is over.
+        private val inMoment = AtomicBoolean(false)
+
+        /**
+         * Runs the work once, now. It finds whatever is stored: a moment that is due is
+         * had, and in every case the alarm is set from the stored time when the work
+         * ends, or taken off when her own time is off. The settings screen calls this
+         * when her own time is switched, so that the switch does not wait for the voice
+         * service, which only runs once the microphone was granted.
+         */
+        fun lookNow(context: Context) {
+            try {
+                // He asked for it by touching the switch: it does not wait for the pause after a run.
+                notBefore = 0L
+                arm(context, System.currentTimeMillis())
+            } catch (e: Exception) {
+                Log.w(TAG, "The alarm for her own time was not looked at: ${e.javaClass.simpleName}")
+            }
+        }
+
+        /**
+         * How long from [nowMillis] until [atMillis], never less than nothing: a time
+         * that has passed is due now. Never before [earliest], the pause after a run.
+         */
+        fun delayMillis(atMillis: Long, nowMillis: Long, earliest: Long = 0L): Long =
+            (maxOf(atMillis, earliest) - nowMillis).coerceAtLeast(0)
+
+        /**
+         * Sets the alarm to [atMillis], in the place of whatever was set before, or takes
+         * it off with null. While a moment is being had this does nothing: see [inMoment].
+         */
+        fun arm(context: Context, atMillis: Long?, nowMillis: Long = System.currentTimeMillis()) {
+            if (inMoment.get()) return
+            val workManager = WorkManager.getInstance(context)
+            if (atMillis == null) {
+                workManager.cancelUniqueWork(WORK_NAME)
+                return
+            }
+            val request = OneTimeWorkRequestBuilder<OwnTimeWorker>()
+                .setInitialDelay(delayMillis(atMillis, nowMillis, notBefore), TimeUnit.MILLISECONDS)
+                .build()
+            workManager.enqueueUniqueWork(WORK_NAME, ExistingWorkPolicy.REPLACE, request)
+        }
+    }
+}
