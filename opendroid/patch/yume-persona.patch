+/** Providers whose host moderates what its models write, whatever the app sends. */
+internal val MODERATING_HOSTS = setOf("Google Gemini", "OpenAI", "Anthropic Claude", "Mistral AI", "Cohere", "Copilot API")
+
+/** The provider that writes her replies with these settings: the one chosen for them, else the main one. */
+internal fun personaReplyProvider(config: LLMConfig): String {
+    val chosen = ProviderCatalog.canonicalName(config.personaChatProvider)
+    return if (chosen.isNotBlank() && ProviderCatalog.isKnown(chosen)) chosen else ProviderCatalog.canonicalName(config.activeProvider)
+}
+
+/** What is said under the provider field when her replies would be written on a host that moderates; null otherwise. */
+internal fun moderationNotice(config: LLMConfig): String? {
+    val provider = personaReplyProvider(config)
+    if (provider !in MODERATING_HOSTS) return null
+    return "$provider moderates what its models write. It can refuse a reply of hers, cut it off or tone it " +
+        "down, and no setting in this app changes that. Choose another provider for her replies if you do not want it."
+}
+
+/**
+ * How long a system prompt the models that run inside the app are handed whole: two
+ * thirds of the largest context any of them has (PromptBudget.systemPromptFits).
+ */
+internal val ON_DEVICE_PROMPT_ROOM: Int = OnDeviceModelRegistry.allModels.maxOf { it.contextWindow } * 2 / 3
+
+/**
+ * Said under the provider field when her replies would be written by a model that runs
+ * inside the app and her card does not fit one. A prompt of hers is never cut to fit, so
+ * every message to her would be refused on the phone; this says so before he downloads
+ * a model for it. [cardTokens] is her card by the estimate the providers use. Null when
+ * her replies go elsewhere, or when the card fits.
+ */
+internal fun onDeviceReplyNotice(config: LLMConfig, cardTokens: Int): String? {
+    if (!ProviderCatalog.isOnDevice(personaReplyProvider(config)) || cardTokens <= ON_DEVICE_PROMPT_ROOM) return null
+    return "The models that run inside the app take a prompt of about $ON_DEVICE_PROMPT_ROOM tokens at most, and her " +
+        "card alone is about $cardTokens. It is never cut to fit, so with this provider every message to her " +
+        "comes back \"Not sent: her card and notes do not fit this model\". For her replies choose a model on " +
+        "your own network, or an e2ee- model. The main provider can still be a model on this phone."
+}
+
+/** The providers that put the extra options typed for her replies into their requests; no other reads them. */
+internal val EXTRA_OPTION_PROVIDERS = setOf("Custom OpenAI Compatible", "OpenRouter", "Ollama")
+
+/**
+ * What becomes of the extra request options typed for her replies, for the provider and
+ * the route her replies take as things are set. A test holds each sentence against the
+ * providers.
+ */
+internal fun replyOptionsNote(config: LLMConfig): String {
+    val provider = personaReplyProvider(config)
+    return when {
+        provider !in EXTRA_OPTION_PROVIDERS ->
+            "$provider takes no extra options from this app: what is typed in that field is not sent. " +
+                "Only Custom OpenAI Compatible, OpenRouter and Ollama use it."
+        RouteClassifier.personaRoute(config) == RoutePrivacy.ENCRYPTED ->
+            "Her replies are end to end encrypted, and on that route only numbers and switches from that field " +
+                "are sent: temperature, top_p and the other sampling numbers, the token limit (raised to " +
+                "${VeniceE2ee.MIN_OUTPUT_TOKENS} where it is lower), reasoning_effort. " +
+                "Anything else, a stop sequence for one, is left out, because the options travel unencrypted."
+        else ->
+            "The options in that field are sent with her replies to $provider, temperature and the token limit " +
+                "included; her notebook pass and her line about a result keep their own for those two. The " +
+                "keys the app sets itself (model, messages, stream) cannot be changed there."
+    }
+}
