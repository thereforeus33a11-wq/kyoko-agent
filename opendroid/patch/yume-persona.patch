+        assertEquals("fine", VeniceE2eeMessages.unfoldReply("fine\n[he] are you mad", marked = true))
+        assertEquals("fine\nhe: are you mad", VeniceE2eeMessages.unfoldReply("fine\nhe: are you mad", marked = true))
+        // The provider goes by what the request carried, and a reply is never marked as a moment.
