+package com.opendroid.ai.core.persona
+
+import android.util.Log
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.Memory
+import com.opendroid.ai.data.models.MemoryType
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.data.repository.SessionMessage
+import java.security.MessageDigest
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.builtins.MapSerializer
+import kotlinx.serialization.builtins.serializer
+import kotlinx.serialization.json.Json
+
+/**
+ * Her notebook, stored as rows of the existing `memories` table under
+ * [PersonaNotes.KEY_PREFIX]. No schema change: the rows are ordinary long-term
+ * memories. They are filtered out of the context the planner sees and out of the list
+ * the Memory screen shows: the notebook is hers, and it is not put in front of the owner
+ * row by row. Wiping a whole category there leaves them alone. What the owner can do
+ * with the notebook he does on the card screen: hand her notes, copy it out to move her
+ * to another phone, and empty it ([empty]).
+ *
+ * Beside the notes it holds, under the same prefix, what the app has to know between
+ * two runs: the time of her last notebook pass, the unread rows of chats that were
+ * deleted before a pass read them, the lines of a pass that could not be taken and
+ * that she has not been shown yet, the state of her own time, how she feels, the
+ * marks of how she knows a thing, which starting notes the notebook was given and
+ * whether he emptied it. None of these rows is a note of hers: [notes] and
+ * every count of notes leave them out, and they are listed on no screen and copied out
+ * with nothing.
+ *
+ * Nor is her archive: the text a note had before she wrote over it, and every note she
+ * let go or the notebook had no room for. The app never deletes a note of hers on its
+ * own: what leaves her page goes there first ([apply], [fade], [prune]), off her page
+ * and out of her prompts but for the few notes she let go that her sleep pass lists
+ * ([archivedLately]), and a note she let go she can bring back in her sleep ([restore]).
+ * Only the owner's own act of emptying her notebook deletes it ([empty]).
+ *
+ * Every write that changes what a note says, or whether it is there, takes one lock, so
+ * that a note looked at before it is written over ([refreshStartingNotes]) is still the
+ * note it was when it is written.
+ */
+@Singleton
+class PersonaMemory @Inject constructor(
+    private val memoryRepository: MemoryRepository
+) {
+    /** All notes, newest first. */
+    suspend fun notes(): List<PersonaNotes.Note> =
+        noteRows()
+            .filter { it.type == MemoryType.SEMANTIC }
+            .sortedByDescending { it.timestamp }
+            .mapNotNull { PersonaNotes.fromStorage(it.key, it.value) }
+
+    /** When each note was written, by its storage key. A note written again under its key counts from then. */
+    suspend fun writtenAt(): Map<String, Long> = noteRows().associate { it.key to it.timestamp }
+
+    /**
+     * Writes the starting notes once. A notebook the owner has emptied stays empty.
+     *
+     * The marker that says it was done is written last. A first reply that is cut short
+     * part-way through therefore leaves no marker, and the next call writes the starting
+     * notes that are still missing instead of leaving her with half of them. A key that
+     * is already there is not written over: it is either the same starting note or one
+     * she was handed in the meantime.
+     *
+     * A starting note is the oldest thing she has. It is stamped older than every note
+     * that is already there, so notes she was handed before her first reply keep their
+     * place above it: on the page, where the newest come first, and when threads and
+     * opinions have to make way, where the oldest go first.
+     */
+    suspend fun seedIfNeeded(seed: List<PersonaNotes.Note>) = writeLock.withLock {
+        if (isStarted()) return@withLock
+        val rows = noteRows()
+        val present = rows.mapTo(HashSet()) { it.key }
+        val base = (rows.minOfOrNull { it.timestamp } ?: System.currentTimeMillis()) - seed.size
+        seed.forEachIndexed { index, note ->
+            if (note.storageKey !in present) {
+                memoryRepository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC, base + index))
+            }
+        }
+        recordStartingKeys(seed.mapTo(HashSet()) { it.storageKey })
+        markStarted()
+    }
+
+    /**
+     * Gives the starting notes she never touched the wording this build has for them.
+     *
+     * A starting note is written once ([seedIfNeeded]). A phone that ran an older build
+     * keeps the wording that build had, also where her files have changed it since; and
+     * what her notebook says counts for more than her card. [earlier] are the wordings
+     * the starting notes had in older builds, any number for a key. A note of [current]
+     * whose stored text is, character for character, one of the earlier wordings of its
+     * key is one she never rewrote: it is given the current wording. Its old text goes to
+     * her archive the way a note written over does, with the mark she had given it, which
+     * leaves the key with it. The note keeps its time: it keeps its place in her notebook
+     * and its age, and is not new.
+     *
+     * Nothing else is touched: a note she changed, a key with no note under it (she let it
+     * go, or it was taken out: it is not written back), a notebook that has not had its
+     * start or was emptied, and keys the current starting notes no longer have (they stay
+     * as they are). Nothing of it counts as her writing: no note is new or newer by it,
+     * and nothing is moved off her page to make room.
+     *
+     * A starting note that is new in this build comes in as well: one under a key that no
+     * earlier build had, so none of [earlier] has it, and that this notebook was never
+     * given ([recordStartingKeys]), has no note under it now and nothing in her archive.
+     * It is written once, stamped older than every note she has, as a starting note is
+     * ([seedIfNeeded]), and its key is kept as given from then on: what she lets go of it
+     * later stays gone. Nothing new comes into a notebook he emptied, one that holds no
+     * note in the words of a starting note and none in her archive (emptied by an older
+     * build, whatever he handed her since), or one handed
+     * over from another phone: what she let go there is not in her archive here.
+     *
+     * It is done once for each version of the starting notes: a fingerprint of [current]
+     * and [earlier] is kept, and while it is the same nothing more is read. A notebook
+     * handed over from another phone ([handedOver]) is looked over again. Returns how many
+     * notes were given the current wording, and how many came in new.
+     */
+    suspend fun refreshStartingNotes(current: List<PersonaNotes.Note>, earlier: List<PersonaNotes.Note>): Int {
+        if (current.isEmpty() || earlier.isEmpty()) return 0
+        val version = seedVersion(current, earlier)
+        val lookedOver = memoryRepository.getMemory(SEED_VERSION_KEY)?.value
+        if (lookedOver == version) return 0
+        return writeLock.withLock {
+            if (!isStarted()) return@withLock 0
+            val wordings = earlier.groupBy({ it.storageKey }, { it.text })
+            val live = noteRows().associateBy { it.key }
+            val marks = how()
+            val refreshed = HashSet<String>()
+            // The last line under a key is the note, as when the starting notes are read.
+            val starting = current.associateBy { it.storageKey }.values
+            for (note in starting) {
+                val row = live[note.storageKey] ?: continue
+                if (row.value == note.text || row.value !in wordings[note.storageKey].orEmpty()) continue
+                archive(row, REPLACED, marks[note.storageKey])
+                memoryRepository.saveMemory(Memory(row.key, note.text, MemoryType.SEMANTIC, row.timestamp))
+                refreshed += row.key
+            }
+            // As when she writes over a note: the mark said how she knew the old text.
+            if (refreshed.any { it in marks }) updateHow { it - refreshed }
+            val added = addNewStartingNotes(starting.toList(), wordings, live, handedOverHere = lookedOver == HANDED_OVER)
+            memoryRepository.saveMemory(Memory(SEED_VERSION_KEY, version, MemoryType.SEMANTIC))
+            refreshed.size + added
+        }
+    }
+
+    /**
+     * Writes in the starting notes of [current] whose keys are new to this notebook (see
+     * [refreshStartingNotes]), and keeps every key of [current] as given. [earlier] are
+     * the wordings earlier builds had, by key, [live] the notes there are now. Called
+     * under the write lock. Returns how many came in.
+     */
+    private suspend fun addNewStartingNotes(
+        current: List<PersonaNotes.Note>,
+        earlier: Map<String, List<String>>,
+        live: Map<String, Memory>,
+        handedOverHere: Boolean
+    ): Int {
+        val earlierKeys = earlier.keys
+        val given = startingKeys()
+        val archiveRows = archiveRows()
+        val archived = archiveRows.mapTo(HashSet()) { PersonaNotes.KEY_PREFIX + it.key.removePrefix(ARCHIVE_PREFIX).substringBeforeLast('.', "") }
+        // Every wording a starting note has had, this build's and the earlier ones, by key.
+        val wordings = HashMap<String, MutableSet<String>>()
+        for (note in current) wordings.getOrPut(note.storageKey) { HashSet() } += note.text
+        for ((key, texts) in earlier) wordings.getOrPut(key) { HashSet() } += texts
+        // A notebook that never had its start here, or lost it: no note in the words of a
+        // starting note, now or in her archive. A note he handed her under a starting key,
+        // in his own words, is not one.
+        val hadItsStart = live.values.any { it.value in wordings[it.key].orEmpty() } ||
+            archiveRows.any { row -> readArchive(row)?.first?.note?.let { it.text in wordings[it.storageKey].orEmpty() } == true }
+        val emptied = memoryRepository.getMemory(EMPTIED_KEY)?.value == EMPTIED
+        val fresh = current.filter {
+            it.storageKey !in earlierKeys && it.storageKey !in given && it.storageKey !in live && it.storageKey !in archived
+        }
+        val writes = !handedOverHere && !emptied && hadItsStart
+        if (writes && fresh.isNotEmpty()) {
+            val base = (live.values.minOfOrNull { it.timestamp } ?: System.currentTimeMillis()) - fresh.size
+            fresh.forEachIndexed { index, note ->
+                memoryRepository.saveMemory(Memory(note.storageKey, note.text, MemoryType.SEMANTIC, base + index))
+            }
+        }
+        recordStartingKeys(current.mapTo(HashSet()) { it.storageKey })
+        return if (writes) fresh.size else 0
+    }
+
+    /**
+     * The storage keys of the starting notes this notebook was given, or was looked over
+     * with, by this build or a later one. A notebook from an older build has none kept.
+     */
+    private suspend fun startingKeys(): Set<String> =
+        memoryRepository.getMemory(STARTING_KEYS_KEY)?.value?.lines()?.filter { it.isNotBlank() }?.toSet().orEmpty()
+
+    /** Adds [keys] to [startingKeys]. */
+    private suspend fun recordStartingKeys(keys: Set<String>) {
+        val all = startingKeys() + keys
+        memoryRepository.saveMemory(Memory(STARTING_KEYS_KEY, all.sorted().joinToString("\n"), MemoryType.SEMANTIC))
+    }
+
+    /**
+     * Whether this notebook has had its start: the starting notes were written, or it was
+     * emptied, or it was moved here from another phone where it had them.
+     */
+    suspend fun isStarted(): Boolean = memoryRepository.getMemory(SEEDED_KEY) != null
+
+    /**
+     * Records that this notebook has had its start, so [seedIfNeeded] writes nothing into
+     * it from now on. Called when a notebook copied on another phone is handed over here.
+     */
+    suspend fun markStarted() {
+        memoryRepository.saveMemory(Memory(SEEDED_KEY, "1", MemoryType.SEMANTIC))
+    }
+
+    /**
+     * Records that the notebook here was handed over from another phone, where it had its
+     * start. Called once its notes are written in. No starting note is written into it
+     * from now on ([markStarted]), and [refreshStartingNotes] looks over its starting notes
+     * again, whatever version it last looked over here: they are as the build on the other
+     * phone wrote them, or as she wrote them there. No starting note new to it is written
+     * in on that look: what she let go on the other phone is not in her archive here.
+     */
+    suspend fun handedOver() {
+        memoryRepository.saveMemory(Memory(SEED_VERSION_KEY, HANDED_OVER, MemoryType.SEMANTIC))
+        // It is a notebook that had its start, on the other phone: no longer the one he emptied here.
+        if (memoryRepository.getMemory(EMPTIED_KEY) != null) memoryRepository.saveMemory(Memory(EMPTIED_KEY, NOT_EMPTIED, MemoryType.SEMANTIC))
+        markStarted()
+    }
+
+    /**
+     * The stored rows that are her notes: those under the prefix of one of the notebook's
+     * kinds. They are read kind by kind, so that what the app keeps beside them (her
+     * archive above all, which grows) is never read where a prompt is built.
+     */
+    private suspend fun noteRows(): List<Memory> =
+        PersonaNotes.Kind.entries.flatMap { kind ->
+            val prefix = "${PersonaNotes.KEY_PREFIX}${kind.label}."
+            // LIKE treats some characters as wildcards and ignores case, so confirm the prefix for real.
+            memoryRepository.getMemoriesByKeyPrefix(prefix).filter { it.key.startsWith(prefix) }
+        }
+
+    /** What one write to the notebook did: how many notes were written over with other text, and how many were new. */
+    data class Applied(val rewritten: Int, val added: Int)
+
+    /**
+     * Stores [changes]: a note with a known key replaces the old one. A thread she closes
+     * is stored like any other note, so that she still knows how it ended. Later lines
+     * count as newer, which keeps the order of a notebook that is handed over line by line.
+     *
+     * The text a note had before is not lost when it is written over with other text: it
+     * goes to her archive first, with the mark she had given it. The mark goes with it:
+     * it said how she knew the old text, not the new one, so the note under that key has
+     * no mark until she gives it one again. A note written again with the very text it
+     * has is left as it is: it keeps its age and its mark.
+     */
+    suspend fun apply(changes: List<PersonaNotes.Note>): Applied = writeLock.withLock {
+        val live = noteRows().associateBy { it.key }
+        val marks = how()
+        val base = System.currentTimeMillis()
+        var rewritten = 0
+        var added = 0
+        // The text under each key as this write leaves it, for the keys it changes.
+        val written = HashMap<String, String>()
+        changes.forEachIndexed { index, note ->
+            val key = note.storageKey
+            val old = live[key]
+            if ((written[key] ?: old?.value) == note.text) return@forEachIndexed
+            if (key !in written) {
+                if (old == null) {
+                    added++
+                } else {
+                    archive(old, REPLACED, marks[note.storageKey])
+                    rewritten++
+                }
+            }
+            written[key] = note.text
+            memoryRepository.saveMemory(Memory(key, note.text, MemoryType.SEMANTIC, base + index))
+        }
+        // A mark said how she knew what a note said before: it does not say how she knows what it says now.
+        if (written.keys.any { it in marks }) updateHow { it - written.keys }
+        prune(justWritten = changes.mapTo(HashSet()) { it.storageKey })
+        Applied(rewritten, added)
+    }
+
+    /** What emptying her notebook deleted: her notes, and the rows of her archive. */
+    data class Emptied(val notes: Int, val archived: Int)
+
+    /**
+     * When her notebook was last emptied, in this process: a sleep pass that began
+     * before then writes nothing back into it.
+     */
+    @Volatile
+    var emptiedAtMillis: Long = 0L
+        private set
+
+    /**
+     * Deletes every note, her archive, her marks of how she knows a thing and how she
+     * feels (her words for a feeling can name him, or anyone), and says how many notes
+     * and archive rows there were. The marker that says the starting notes were written
+     * stays, and is set if it was not, so an emptied notebook is not filled with them
+     * again, and it is marked as emptied, so a starting note a later build brings does not
+     * come into it either ([refreshStartingNotes]). Only the owner's own action on the
+     * card screen calls this.
+     */
+    suspend fun empty(): Emptied {
+        emptiedAtMillis = System.currentTimeMillis()
+        return writeLock.withLock {
+            val rows = noteRows()
+            rows.forEach { memoryRepository.deleteMemory(it.key) }
+            val archived = archiveRows()
+            archived.forEach { memoryRepository.deleteMemory(it.key) }
+            howLock.withLock { if (memoryRepository.getMemory(HOW_KEY) != null) memoryRepository.deleteMemory(HOW_KEY) }
+            moodLock.withLock { if (memoryRepository.getMemory(MOOD_KEY) != null) memoryRepository.deleteMemory(MOOD_KEY) }
+            // A later build's new starting notes do not come into it either.
+            memoryRepository.saveMemory(Memory(EMPTIED_KEY, EMPTIED, MemoryType.SEMANTIC))
+            markStarted()
+            emptiedAtMillis = System.currentTimeMillis()
+            Emptied(rows.size, archived.size)
+        }
+    }
+
+    // ── Her archive ──────────────────────────────────────────────────────────────────
+
+    /** One row of her archive: a note as it was, when that text was written, when it left her page and why. */
+    data class Archived(
+        val note: PersonaNotes.Note,
+        val writtenAt: Long,
+        val archivedAt: Long,
+        val why: String,
+        val how: PersonaNotes.How?,
+        val backAt: Long?
+    )
+
+    @Serializable
+    private data class ArchiveRow(
+        val t: String,
+        val w: Long,
+        val a: Long,
+        val why: String,
+        val how: String? = null,
+        val back: Long? = null
+    )
+
+    /**
+     * Keeps [row], one version of a note, in her archive. A version is the note's key
+     * with the time its text was written, so keeping the same version twice writes the
+     * same row again. Another text under the key with the same time (a starting note
+     * given a later wording keeps its time) is another version, and gets a row of its own
+     * after the others: an old text is never written over in her archive. Only the last
+     * of those rows is written again, so they stay in the order they were kept in,
+     * whatever the clock said ([restore]).
+     */
+    private suspend fun archive(row: Memory, why: String, how: PersonaNotes.How?, atMillis: Long = System.currentTimeMillis()) {
+        val version = ARCHIVE_PREFIX + row.key.removePrefix(PersonaNotes.KEY_PREFIX) + "." + row.timestamp
+        var key = version
+        var other = 0
+        while (true) {
+            val there = memoryRepository.getMemory(key) ?: break
+            val next = version + "-" + (other + 1)
+            if (readArchive(there)?.second?.t == row.value && memoryRepository.getMemory(next) == null) break
+            key = next
+            other++
+        }
+        val kept = ArchiveRow(t = row.value, w = row.timestamp, a = atMillis, why = why, how = how?.name)
+        memoryRepository.saveMemory(Memory(key, json.encodeToString(ArchiveRow.serializer(), kept), MemoryType.SEMANTIC, atMillis))
+    }
+
+    /** Takes [row] off her page: into her archive first, and only then out of the notebook. */
+    private suspend fun letGo(row: Memory, why: String, how: PersonaNotes.How?) {
+        archive(row, why, how)
+        memoryRepository.deleteMemory(row.key)
+    }
+
+    /** Which of the versions of a note written at the same time a row of her archive keeps: 0 for the first, then 1, 2 ([archive]). */
+    private fun otherVersion(archiveKey: String): Int {
+        val time = archiveKey.substringAfterLast('.')
+        val dash = time.lastIndexOf('-')
+        return if (dash > 0) time.substring(dash + 1).toIntOrNull() ?: 0 else 0
+    }
+
+    private suspend fun archiveRows(prefix: String = ARCHIVE_PREFIX): List<Memory> =
+        memoryRepository.getMemoriesByKeyPrefix(prefix).filter { it.key.startsWith(prefix) }
+
+    private fun readArchive(row: Memory): Pair<Archived, ArchiveRow>? {
+        val version = row.key.removePrefix(ARCHIVE_PREFIX)
+        val storageKey = PersonaNotes.KEY_PREFIX + version.substringBeforeLast('.', "")
+        val kept = try {
+            json.decodeFromString(ArchiveRow.serializer(), row.value)
+        } catch (e: Exception) {
+            return null
+        }
+        val note = PersonaNotes.fromStorage(storageKey, kept.t) ?: return null
+        val how = PersonaNotes.How.entries.firstOrNull { it.name == kept.how }
+        return Archived(note, kept.w, kept.a, kept.why, how, kept.back) to kept
+    }
+
+    /**
+     * Lets go of the notes under [keys], those of them that are in her notebook: each
+     * goes to her archive, off her page and out of her prompts, with its mark, which
+     * leaves the key with it. Returns how many.
+     */
+    suspend fun fade(keys: Collection<String>): Int = writeLock.withLock {
+        val live = noteRows().associateBy { it.key }
+        val marks = how()
+        val gone = HashSet<String>()
+        for (key in keys.toSet()) {
+            val row = live[key] ?: continue
+            letGo(row, FADED, marks[key])
+            gone += key
+        }
+        if (gone.any { it in marks }) updateHow { it - gone }
+        gone.size
+    }
+
+    /**
+     * Brings the note under [storageKey] back from her archive: the newest version of it
+     * that has not been brought back yet, with the mark she had given it. Only into a key
+     * that is free: a note she has under it now is never written over from here. True
+     * when a note came back. Of two versions written at the same time, the newer is the
+     * one that was kept in her archive after the other, by the order of their rows and
+     * not by the clock, which can have been set back in between ([archive]).
+     */
+    suspend fun restore(storageKey: String): Boolean = writeLock.withLock {
+        if (PersonaNotes.fromStorage(storageKey, "-") == null) return@withLock false
+        if (noteRows().any { it.key == storageKey }) return@withLock false
+        val versions = archiveRows(ARCHIVE_PREFIX + storageKey.removePrefix(PersonaNotes.KEY_PREFIX) + ".")
+            .mapNotNull { row -> readArchive(row)?.let { Triple(row, it.first, it.second) } }
+            .filter { (_, archived, _) -> archived.note.storageKey == storageKey && archived.backAt == null }
+        val (row, archived, kept) = versions.maxWithOrNull(
+            compareBy({ it.second.writtenAt }, { otherVersion(it.first.key) })
+        ) ?: return@withLock false
+        val now = System.currentTimeMillis()
+        memoryRepository.saveMemory(Memory(storageKey, archived.note.text, MemoryType.SEMANTIC, now))
+        memoryRepository.saveMemory(row.copy(value = json.encodeToString(ArchiveRow.serializer(), kept.copy(back = now))))
+        archived.how?.let { mark -> updateHow { it + (storageKey to mark) } }
+        prune(justWritten = setOf(storageKey))
+        true
+    }
+
+    /** Every note she let go, or the notebook had no room for, that she can bring back: the newest version under each key, newest first. */
+    private suspend fun letGoNotes(): List<Archived> {
+        val live = noteRows().mapTo(HashSet()) { it.key }
+        return archiveRows().mapNotNull { readArchive(it)?.first }
+            .filter { it.why != REPLACED && it.backAt == null && it.note.storageKey !in live }
+            .sortedByDescending { it.archivedAt }
+            .distinctBy { it.note.storageKey }
+    }
+
+    /**
+     * What she let go lately, or the notebook had no room for: the newest of each, newest
+     * first, at most [limit], without what she has brought back or has under that key
+     * again. A note [leaveOut] covers is not among them.
+     *
+     * With [newest] under [limit], only that many are the newest; the rest of [limit]
+     * are older ones, a different few for each [turn] (a night, say), so that over the
+     * nights every note she let go comes round to her again.
+     */
+    suspend fun archivedLately(
+        limit: Int,
+        leaveOut: ((PersonaNotes.Note) -> Boolean)? = null,
+        newest: Int = limit,
+        turn: Long = 0
+    ): List<Archived> {
+        val all = letGoNotes().filter { leaveOut?.invoke(it.note) != true }
+        if (all.size <= limit) return all
+        val first = newest.coerceIn(0, limit)
+        val older = all.drop(first)
+        val rest = limit - first
+        val start = Math.floorMod(turn * rest, older.size.toLong()).toInt()
+        val coming = (0 until minOf(rest, older.size)).map { older[(start + it) % older.size] }
+        return (all.take(first) + coming).sortedByDescending { it.archivedAt }
+    }
+
+    /** The storage keys of every note she let go, or the notebook had no room for, that a back line of hers can bring back now. */
+    suspend fun restorableKeys(): Set<String> = letGoNotes().mapTo(HashSet()) { it.note.storageKey }
+
+    /** How many rows her archive holds. */
+    suspend fun archiveCount(): Int = archiveRows().size
+
+    // ── How she feels, and how she knows a thing ─────────────────────────────────────
+
+    /** How she feels, as her feel lines left it ([PersonaMood]). */
+    suspend fun mood(): List<PersonaMood.Feeling> = PersonaMood.decode(memoryRepository.getMemory(MOOD_KEY)?.value)
+
+    /** Changes how she feels by [change], one change at a time. */
+    suspend fun updateMood(change: (List<PersonaMood.Feeling>) -> List<PersonaMood.Feeling>) {
+        moodLock.withLock {
+            val next = change(mood())
+            if (next.isEmpty()) {
+                if (memoryRepository.getMemory(MOOD_KEY) != null) memoryRepository.deleteMemory(MOOD_KEY)
+            } else {
+                memoryRepository.saveMemory(Memory(MOOD_KEY, PersonaMood.encode(next), MemoryType.SEMANTIC))
+            }
+        }
+    }
+
+    /** Her marks of how she knows what a note says, by the note's storage key. */
+    suspend fun how(): Map<String, PersonaNotes.How> {
+        val stored = memoryRepository.getMemory(HOW_KEY)?.value ?: return emptyMap()
+        val map = try {
+            json.decodeFromString(MapSerializer(String.serializer(), String.serializer()), stored)
+        } catch (e: Exception) {
+            return emptyMap()
+        }
+        return map.mapNotNull { (key, how) -> PersonaNotes.How.entries.firstOrNull { it.name == how }?.let { key to it } }.toMap()
+    }
+
+    /** Changes her marks by [change], one change at a time. A mark of a note she no longer has is dropped. */
+    suspend fun updateHow(change: (Map<String, PersonaNotes.How>) -> Map<String, PersonaNotes.How>) {
+        howLock.withLock {
+            val live = noteRows().mapTo(HashSet()) { it.key }
+            val next = change(how()).filterKeys { it in live }
+            if (next.isEmpty()) {
+                if (memoryRepository.getMemory(HOW_KEY) != null) memoryRepository.deleteMemory(HOW_KEY)
+            } else {
+                val stored = json.encodeToString(MapSerializer(String.serializer(), String.serializer()), next.mapValues { it.value.name })
+                memoryRepository.saveMemory(Memory(HOW_KEY, stored, MemoryType.SEMANTIC))
+            }
+        }
+    }
+
+    /**
+     * What is kept about her own time: when she is woken next, the moments of the last
+     * day and the last gap she chose ([PersonaOwnTime.State]). It is stored, in one row,
+     * so that the time she named still holds after the app was closed: the stored time
+     * is the truth, and whatever wakes the phone is only set from it.
+     */
+    suspend fun ownTime(): PersonaOwnTime.State =
+        PersonaOwnTime.decode(memoryRepository.getMemory(OWN_TIME_KEY)?.value)
+
+    suspend fun saveOwnTime(state: PersonaOwnTime.State) {
+        memoryRepository.saveMemory(Memory(OWN_TIME_KEY, PersonaOwnTime.encode(state), MemoryType.SEMANTIC))
+        sleepSaved.value = state.asleepSince
+    }
+
+    // When the own time last saved says she lay down to sleep (0 while she is awake): for her ears, which close at once.
+    private val sleepSaved = kotlinx.coroutines.flow.MutableStateFlow(0L)
+
+    /** When her sleep began, as her own time was last saved; 0 while she is awake. Changes when she lies down or gets up. */
+    val asleepSinceSaved: kotlinx.coroutines.flow.StateFlow<Long> get() = sleepSaved
+
+    /**
+     * The time of the newest chat row her last successful notebook pass had read, or 0.
+     * Stored, so that replies from before the app was last closed still count towards
+     * the next pass.
+     */
+    suspend fun lastReflectionAt(): Long =
+        memoryRepository.getMemory(REFLECTION_KEY)?.value?.toLongOrNull() ?: 0L
+
+    suspend fun recordReflection(atMillis: Long) {
+        memoryRepository.saveMemory(Memory(REFLECTION_KEY, atMillis.toString(), MemoryType.SEMANTIC))
+    }
+
+    /**
+     * Keeps [rows], unread rows of a chat that is being deleted, for her next notebook
+     * pass. They are stored on the phone beside her notes and are no note themselves:
+     * they are what he said to her and what she answered, which she has not yet been
+     * given the chance to write down. Without this, clearing a chat after one or two
+     * exchanges would take them from her for good. They stay until a pass has read them
+     * ([dropLeftBehind]); only the newest [MAX_LEFT_BEHIND_ROWS] are held.
+     */
+    suspend fun keepLeftBehind(rows: List<SessionMessage>) {
+        if (rows.isEmpty()) return
+        leftBehindLock.withLock {
+            val all = (readLeftBehind() + rows.map(::toKept)).distinctBy { it.id }.sortedBy { it.at }
+            writeLeftBehind(all.takeLast(MAX_LEFT_BEHIND_ROWS))
+        }
+    }
+
+    /** The rows kept from deleted chats that are newer than [sinceMillis], oldest first. */
+    suspend fun leftBehind(sinceMillis: Long): List<SessionMessage> =
+        leftBehindLock.withLock { readLeftBehind() }.filter { it.at > sinceMillis }.map { kept ->
+            SessionMessage(
+                kept.chat,
+                ChatMessage(
+                    id = kept.id,
+                    text = kept.text,
+                    sender = if (kept.his) ChatMessage.Sender.USER else ChatMessage.Sender.AGENT,
+                    timestamp = kept.at,
+                    modelBadge = kept.badge
+                )
+            )
+        }
+
+    /** Lets go of the kept rows a pass has read: those no newer than [upToMillis]. */
+    suspend fun dropLeftBehind(upToMillis: Long) {
+        leftBehindLock.withLock {
+            val all = readLeftBehind()
+            val left = all.filter { it.at > upToMillis }
+            if (left.size != all.size) writeLeftBehind(left)
+        }
+    }
+
+    private suspend fun readLeftBehind(): List<KeptRow> {
+        val stored = memoryRepository.getMemory(LEFT_BEHIND_KEY)?.value ?: return emptyList()
+        return try {
+            json.decodeFromString(ListSerializer(KeptRow.serializer()), stored)
+        } catch (e: Exception) {
+            // A row this build cannot read is not worth failing a pass over.
+            Log.w(TAG, "Kept chat rows could not be read: ${e.javaClass.simpleName}")
+            emptyList()
+        }
+    }
+
+    private suspend fun writeLeftBehind(rows: List<KeptRow>) {
+        if (rows.isEmpty()) {
+            memoryRepository.deleteMemory(LEFT_BEHIND_KEY)
+        } else {
+            memoryRepository.saveMemory(
+                Memory(LEFT_BEHIND_KEY, json.encodeToString(ListSerializer(KeptRow.serializer()), rows), MemoryType.SEMANTIC)
+            )
+        }
+    }
+
+    private fun toKept(row: SessionMessage) = KeptRow(
+        chat = row.sessionId,
+        id = row.message.id,
+        text = row.message.text,
+        his = row.message.sender == ChatMessage.Sender.USER,
+        at = row.message.timestamp,
+        badge = row.message.modelBadge
+    )
+
+    /**
+     * The lines a notebook pass of hers wrote that the notebook could not take, for her
+     * next pass to be told about: those of her last pass, and older ones that a pass on
+     * a route a host could read was not shown. Empty when there are none.
+     */
+    suspend fun notTaken(): List<String> =
+        memoryRepository.getMemory(NOT_TAKEN_KEY)?.value?.lines()?.filter { it.isNotBlank() }.orEmpty()
+
+    /**
+     * Records the [lines] that were meant as notes and were not taken, in place of what
+     * was recorded before: a few of them and each on one line. An empty list clears the
+     * record: she has been shown all there was.
+     */
+    suspend fun recordNotTaken(lines: List<String>) {
+        val kept = lines.map { it.replace(Regex("""\s+"""), " ").trim().take(MAX_NOT_TAKEN_CHARS) }
+            .filter { it.isNotEmpty() }
+            .take(MAX_NOT_TAKEN_LINES)
+        if (kept.isEmpty()) {
+            if (memoryRepository.getMemory(NOT_TAKEN_KEY) != null) memoryRepository.deleteMemory(NOT_TAKEN_KEY)
+        } else {
+            memoryRepository.saveMemory(Memory(NOT_TAKEN_KEY, kept.joinToString("\n"), MemoryType.SEMANTIC))
+        }
+    }
+
+    /**
+     * Keeps the notebook bounded. Only threads and opinions are ever moved off it: past
+     * the room they have, the closed threads go first, oldest first, and only then the
+     * oldest open threads and opinions. They go to her archive, not away. What she noted
+     * about him, about the two of them and about herself, and what he corrected, is never
+     * moved here.
+     *
+     * The room for threads and opinions is what those notes leave of the cap, and never
+     * less than [PersonaNotes.MIN_THREADS_AND_OPINIONS]: a notebook that holds the cap in
+     * notes that stay must still have a place for a thread she opens. And a note in
+     * [justWritten], the keys this very call stored, is not taken out by it, whatever the
+     * count: what she has just written down is there when she next looks. Her notebook
+     * prompt tells her this rule, so nothing disappears behind her back.
+     */
+    private suspend fun prune(justWritten: Set<String>) {
+        val rows = noteRows().associateBy { it.key }
+        val all = notes()
+        val canGo = all.filter { it.kind == PersonaNotes.Kind.THREAD || it.kind == PersonaNotes.Kind.OPINION }
+        val room = maxOf(
+            PersonaNotes.MIN_THREADS_AND_OPINIONS,
+            PersonaNotes.MAX_TOTAL_NOTES - (all.size - canGo.size)
+        )
+        var excess = canGo.size - room
+        if (excess <= 0) return
+        val oldestFirst = canGo.asReversed().filterNot { it.storageKey in justWritten }
+        val marks = how()
+        val gone = HashSet<String>()
+        for (note in oldestFirst.filter { it.isClosedThread } + oldestFirst.filterNot { it.isClosedThread }) {
+            if (excess <= 0) break
+            val row = rows[note.storageKey] ?: continue
+            letGo(row, ROOM, marks[note.storageKey])
+            gone += note.storageKey
+            excess--
+        }
+        // Its mark went to the archive with it, and does not stay on the key.
+        if (gone.any { it in marks }) updateHow { it - gone }
+    }
+
+    private val writeLock = Mutex()
+    private val leftBehindLock = Mutex()
+    private val moodLock = Mutex()
+    private val howLock = Mutex()
+
+    /** One row of a deleted chat as it is kept: which chat, whose row, when, under which badge, and its text. */
+    @Serializable
+    private data class KeptRow(
+        val chat: String,
+        val id: String,
+        val text: String,
+        val his: Boolean,
+        val at: Long,
+        val badge: String? = null
+    )
+
+    companion object {
+        private const val TAG = "PersonaMemory"
+
+        /** How many rows of deleted chats are held for her at most. Past it the oldest go. */
+        const val MAX_LEFT_BEHIND_ROWS = 400
+
+        /** How many lines that were not taken are kept for her next pass, and how much of each. */
+        const val MAX_NOT_TAKEN_LINES = 5
+        const val MAX_NOT_TAKEN_CHARS = 160
+
+        private val json = Json { ignoreUnknownKeys = true }
+
+        /** Rows under this prefix are not notes (their kind is unknown to [PersonaNotes]); they record what the app did. */
+        private const val META_PREFIX = "${PersonaNotes.KEY_PREFIX}meta."
+
+        /** Records that seeding ran. */
+        private const val SEEDED_KEY = "${META_PREFIX}seeded"
+
+        /**
+         * The fingerprint of the starting notes and their earlier wordings that
+         * [refreshStartingNotes] last looked over this notebook by, or [HANDED_OVER].
+         */
+        private const val SEED_VERSION_KEY = "${META_PREFIX}seedversion"
+        private const val HANDED_OVER = "handed-over"
+
+        /** The keys of the starting notes this notebook was given ([startingKeys]), one per line. */
+        private const val STARTING_KEYS_KEY = "${META_PREFIX}startingkeys"
+
+        /** Says [EMPTIED] once he has emptied her notebook ([empty]), and [NOT_EMPTIED] once a notebook is handed over. */
+        private const val EMPTIED_KEY = "${META_PREFIX}emptied"
+        private const val EMPTIED = "1"
+        private const val NOT_EMPTIED = "0"
+        private const val REFLECTION_KEY = "${META_PREFIX}lastreflection"
+
+        /** What is kept about her own time, as one row ([PersonaOwnTime.State]). */
+        private const val OWN_TIME_KEY = "${META_PREFIX}owntime"
+
+        /** Unread rows of chats that were deleted, and the lines of a pass that were not taken. */
+        private const val LEFT_BEHIND_KEY = "${META_PREFIX}leftbehind"
+        private const val NOT_TAKEN_KEY = "${META_PREFIX}nottaken"
+
+        /** How she feels ([PersonaMood]), and her marks of how she knows a thing. */
+        private const val MOOD_KEY = "${META_PREFIX}mood"
+        private const val HOW_KEY = "${META_PREFIX}how"
+
+        /** Her archive: one row for each version of a note that left her page, under its key and the time it was written. */
+        internal const val ARCHIVE_PREFIX = "${META_PREFIX}archive."
+
+        /** Why a version is in her archive: she wrote other text over it, she let it go, or the notebook had no room for it. */
+        const val REPLACED = "replaced"
+        const val FADED = "faded"
+        const val ROOM = "room"
+
+        /** SHA-256, in hex, of the starting notes and their earlier wordings, line by line. */
+        private fun seedVersion(current: List<PersonaNotes.Note>, earlier: List<PersonaNotes.Note>): String {
+            val text = current.joinToString("\n") { it.toLine() } + "\n\n" + earlier.joinToString("\n") { it.toLine() }
+            return MessageDigest.getInstance("SHA-256").digest(text.toByteArray(Charsets.UTF_8))
+                .joinToString("") { byte -> ((byte.toInt() and 0xff) + 0x100).toString(16).substring(1) }
+        }
+    }
+}
