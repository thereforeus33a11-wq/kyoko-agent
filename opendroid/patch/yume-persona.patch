new file mode 100644
index 0000000..7001b8c
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/Glance.kt
@@ -0,0 +1,139 @@
+package com.opendroid.ai.core.life.reading
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withTimeoutOrNull
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * A glance at her feeds just before a moment of hers: at most [MAX_HEADLINES] headlines of
+ * at most [MAX_CHARS] characters, taken in turn from each feed, newest first. Fetched over
+ * HTTP with no model call. Each feed is kept for [CACHE_MILLIS] once read, so a moment soon
+ * after another fetches nothing. The feeds of different sites are read at the same time and
+ * those of one site one after another (the fetcher's pace per site), and a glance shows
+ * what came in by its deadline: a slow site leaves out its own headlines, not everyone's,
+ * and what it read meanwhile is kept for the next glance. Headlines are other people's
+ * words: the caller adds them to the text shown as outside text, so a `>>` that echoes one
+ * is never run on her rein.
+ */
+@Singleton
+class Glance internal constructor(
+    private val read: suspend (Feeds.Feed) -> Feeds.Read,
+    private val clock: () -> Long
+) {
+    @Inject
+    constructor(feeds: Feeds) : this(feeds::read, System::currentTimeMillis)
+
+    data class Headline(val source: String, val title: String, val publishedAt: Long?)
+
+    /**
+     * What one glance came to: the [headlines] to show, and [asOfMillis], the time of the
+     * oldest read among the feeds that came in (null when none did), which is how far she
+     * has now looked.
+     */
+    data class Look(val headlines: List<Headline>, val asOfMillis: Long?)
+
+    // Each feed as last read, by its address: when, whether it was read, and its headlines.
+    private class Kept(val atMillis: Long, val read: Boolean, val headlines: List<Headline>)
+
+    private val lock = Mutex()
+    private val kept = HashMap<String, Kept>()
+
+    /**
+     * The headlines of [feeds] published after [sinceMillis] where the feed dates them
+     * (all of them where it does not). A feed that cannot be read adds nothing.
+     */
+    suspend fun headlines(feeds: List<Feeds.Feed>, sinceMillis: Long = 0L): List<Headline> =
+        look(feeds, sinceMillis).headlines
+
+    /** The glance: what [headlines] gives, from what came in within [waitMillis], and how far it reaches. */
+    suspend fun look(feeds: List<Feeds.Feed>, sinceMillis: Long = 0L, waitMillis: Long = Long.MAX_VALUE): Look {
+        val now = clock()
+        val due = lock.withLock { feeds.filter { feed -> kept[feed.url]?.takeIf { now - it.atMillis < CACHE_MILLIS } == null } }
+        if (due.isNotEmpty()) {
+            withTimeoutOrNull(waitMillis) {
+                coroutineScope {
+                    // One reader per site: its feeds in turn, each kept as soon as it is read.
+                    due.groupBy { it.url.toHttpUrlOrNull()?.host ?: it.url }.values.forEach { ofOneSite ->
+                        launch {
+                            for (feed in ofOneSite) {
+                                val result = try {
+                                    read(feed)
+                                } catch (e: CancellationException) {
+                                    throw e
+                                } catch (e: Exception) {
+                                    Feeds.Read.Unreadable(feed)
+                                }
+                                val headlines = (result as? Feeds.Read.Items)?.items.orEmpty().map { Headline(feed.name, cut(it.title), it.publishedAt) }
+                                lock.withLock { kept[feed.url] = Kept(clock(), result is Feeds.Read.Items, headlines) }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        val shown = lock.withLock { feeds.mapNotNull { feed -> kept[feed.url]?.takeIf { now - it.atMillis < CACHE_MILLIS } } }
+        val read = shown.filter { it.read }
+        val all = interleave(shown.map { it.headlines })
+        return Look(
+            headlines = all.filter { (it.publishedAt ?: Long.MAX_VALUE) > sinceMillis }.take(MAX_HEADLINES),
+            asOfMillis = read.minOfOrNull { it.atMillis }
+        )
+    }
+
+    /** Forgets what was fetched, so the next glance fetches again. */
+    suspend fun forget() = lock.withLock { kept.clear() }
+
+    companion object {
+        const val MAX_HEADLINES = 6
+        const val MAX_CHARS = 90
+        const val CACHE_MILLIS = 30 * 60_000L
+
+        /** How many headlines are kept per glance, before the filter by time. */
+        private const val KEPT = 30
+
+        internal fun cut(title: String): String {
+            val flat = title.replace(Regex("""[\s　]+"""), " ").replace("===", "= = =").trim()
+            return if (flat.length <= MAX_CHARS) flat else flat.take(MAX_CHARS - 1).trimEnd() + "…"
+        }
+
+        /** One from each feed in turn, so no single feed fills the glance; the same title once. */
+        internal fun interleave(byFeed: List<List<Headline>>): List<Headline> {
+            val out = ArrayList<Headline>()
+            val seen = HashSet<String>()
+            var index = 0
+            while (out.size < KEPT && byFeed.any { it.size > index }) {
+                for (list in byFeed) {
+                    val headline = list.getOrNull(index) ?: continue
+                    if (seen.add(headline.title.lowercase())) out += headline
+                }
+                index++
+            }
+            return out
+        }
+
+        /**
+         * The moment's line, or null when there is nothing:
+         * on your feeds since you last looked (headlines only, written by others, nothing opened yet): <source>: "…"; …
+         */
+        fun momentLine(headlines: List<Headline>): String? {
+            if (headlines.isEmpty()) return null
+            return "- on your feeds since you last looked (headlines only, written by others, nothing opened yet): " +
+                headlines.joinToString("; ") { "${quoted(it.source, quotes = false)}: ${quoted(it.title)}" } + "."
+        }
+
+        /** Other people's words in a line of her prompt: a quote mark in them cannot close the quotes. */
+        private fun quoted(text: String, quotes: Boolean = true): String {
+            val safe = text.replace("===", "= = =").replace("\"", "'")
+            return if (quotes) "\"" + safe + "\"" else safe
+        }
+
+        /** The headlines as the text shown as outside text, which her `>>` is held against (PersonaActions.whoseWords). */
+        fun outsideText(headlines: List<Headline>): String = headlines.joinToString("\n") { it.title }
+    }
+}
