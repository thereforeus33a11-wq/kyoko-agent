index 0000000..d42f74a
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/llm/OwnTimeKeyTest.kt
@@ -0,0 +1,92 @@
+package com.opendroid.ai.core.llm
+
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.EyesBounds
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.models.withOwnTimeKey
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Her own-time key: a Venice key he may give her calls on her own. It goes with a call of
+ * hers on her own (one under [OwnCall]) to api.venice.ai and with nothing else: never with
+ * his calls or her replies to him, never to another host. Without it, his key goes.
+ */
+class OwnTimeKeyTest {
+
+    private val custom = "Custom OpenAI Compatible"
+    private val seen = mutableListOf<String?>()
+
+    private val delegate = object : LLMProvider {
+        override val name = custom
+        override val availableModels: List<String> = emptyList()
+        override suspend fun complete(request: LLMRequest): LLMResponse {
+            seen += request.providerConfig?.apiKey
+            return LLMResponse("ok", 1, request.model.orEmpty(), name, 1)
+        }
+        override fun streamComplete(request: LLMRequest): Flow<String> = flow { emit("ok") }
+        override suspend fun isAvailable() = true
+    }
+
+    private fun request() = LLMRequest(
+        systemPrompt = "system",
+        messages = listOf(ChatMessage(id = "1", text = "hi", sender = ChatMessage.Sender.USER)),
+        responseFormat = ResponseFormat.TEXT
+    )
+
+    private fun config(endpoint: String = "https://api.venice.ai/api/v1") = LLMConfig(
+        routePolicy = RoutePolicy.ANY,
+        activeProvider = custom,
+        selectedModels = mapOf(custom to "some-model"),
+        customEndpoints = mapOf(custom to endpoint),
+        apiKeys = mapOf(custom to "his-key"),
+        apiKeyHosts = mapOf(custom to (RouteClassifier.hostOf(endpoint) ?: ""))
+    )
+
+    private val mark = OwnCall(OwnPurpose.MOMENT) { _, _, _, _, _ -> }
+
+    @Test
+    fun `a call of hers on her own to Venice goes with her own-time key, and his calls with his`() = runBlocking {
+        var settings = config().withOwnTimeKey("her-own-key")
+        val wrapped = WrappedLLMProvider(delegate, { settings })
+        wrapped.complete(request())
+        withContext(mark) { wrapped.complete(request()) }
+        assertEquals(listOf<String?>("his-key", "her-own-key"), seen)
+
+        // Without an own-time key, her calls go with his key as before.
+        seen.clear()
+        settings = config()
+        withContext(mark) { wrapped.complete(request()) }
+        assertEquals(listOf<String?>("his-key"), seen)
+
+        // Never to another host.
+        seen.clear()
+        settings = config("https://example.com/v1").withOwnTimeKey("her-own-key")
+        withContext(mark) { wrapped.complete(request()) }
+        assertEquals(listOf<String?>("his-key"), seen)
+        // And the key itself is kept under its own slot, never as a provider's key.
+        assertEquals("her-own-key", settings.apiKeys[EyesBounds.OWN_TIME_KEY_SLOT])
+        assertEquals("his-key", settings.apiKeys[custom])
+    }
+
+    @Test
+    fun `a picture of herself made in her own time goes with her own-time key, one he asks for with his`() {
+        val settings = config().withOwnTimeKey("her-own-key")
+        assertEquals("her-own-key", com.opendroid.ai.core.persona.PersonaSelfPictures.keyFor(settings, ownTime = true))
+        assertEquals("his-key", com.opendroid.ai.core.persona.PersonaSelfPictures.keyFor(settings, ownTime = false))
+        assertEquals("his-key", com.opendroid.ai.core.persona.PersonaSelfPictures.keyFor(config(), ownTime = true))
+        // Her eyes are always her own time.
+        assertEquals("her-own-key", com.opendroid.ai.core.life.eyes.HerEyes.keyFor(settings))
+        // The action asks whether it runs as a call of hers.
+        val action = java.io.File("src/main/java/com/opendroid/ai/actions/PersonaPictureActions.kt").readText()
+        assertTrue(action.contains("PersonaSelfPictures.keyFor(config, ownTime = currentCoroutineContext()[OwnCall] != null)"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/llm/PlanningFallbackTest.kt b/app/src/test/java/com/opendroid/ai/core/llm/PlanningFallbackTest.kt
