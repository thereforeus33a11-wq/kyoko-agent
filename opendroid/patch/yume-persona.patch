+package com.opendroid.ai.core.life.reading
+
+import com.opendroid.ai.core.persona.PersonaActions
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** The glance at her feeds: six headlines at most, short, cached, and outside text. */
+class GlanceTest {
+
+    private var now = 1_800_000_000_000L
+    private var reads = 0
+
+    private val japan = Feeds.Feed("a", "Yahoo", "https://news.yahoo.co.jp/rss/topics/top-picks.xml")
+    private val world = Feeds.Feed("b", "Google News", "https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en")
+
+    private fun item(title: String, at: Long?) = Feeds.Item(title, null, null, at, null, "")
+
+    private val glance = Glance(read = { feed ->
+        reads++
+        when (feed.id) {
+            "a" -> Feeds.Read.Items(feed, (1..8).map { item("japan $it " + "x".repeat(if (it == 1) 120 else 0), now - it * 60_000L) })
+            else -> Feeds.Read.Items(feed, (1..8).map { item("world $it", null) })
+        }
+    }, clock = { now })
+
+    @Test
+    fun `at most six headlines of at most 90 characters, taken in turn from each feed`() = runBlocking {
+        val headlines = glance.headlines(listOf(japan, world))
+        assertEquals(Glance.MAX_HEADLINES, headlines.size)
+        assertEquals(listOf("Yahoo", "Google News", "Yahoo", "Google News", "Yahoo", "Google News"), headlines.map { it.source })
+        assertTrue(headlines.all { it.title.length <= Glance.MAX_CHARS })
+        assertTrue(headlines.first().title.endsWith("…"))
+    }
+
+    @Test
+    fun `the glance is cached for 30 minutes and costs no fetch meanwhile`() = runBlocking {
+        glance.headlines(listOf(japan, world))
+        assertEquals(2, reads)
+        now += 29 * 60_000L
+        glance.headlines(listOf(japan, world))
+        assertEquals(2, reads)
+        now += 2 * 60_000L
+        glance.headlines(listOf(japan, world))
+        assertEquals(4, reads)
+    }
+
+    @Test
+    fun `only what came since she last looked, where the feed dates it`() = runBlocking {
+        val since = now - 150_000L
+        val headlines = glance.headlines(listOf(japan, world), sinceMillis = since)
+        assertEquals(listOf("Yahoo", "Google News", "Yahoo", "Google News", "Google News", "Google News"), headlines.map { it.source })
+    }
+
+    @Test
+    fun `a feed that cannot be read adds nothing`() = runBlocking {
+        val failing = Glance(read = { feed -> Feeds.Read.Refused(feed, HerFetcher.Why.NETWORK) }, clock = { now })
+        assertEquals(emptyList<Glance.Headline>(), failing.headlines(listOf(japan)))
+        assertNull(Glance.momentLine(emptyList()))
+    }
+
+    @Test
+    fun `I3 - a command echoing a headline from the glance is not hers`() = runBlocking {
+        val headlines = listOf(Glance.Headline("Yahoo", "Shibuya 109 reopens its eighth floor with a gyaru pop-up store", null))
+        val outside = Glance.outsideText(headlines)
+        val whose = PersonaActions.whoseWords("search shibuya 109 reopens eighth floor gyaru pop-up store", emptyList(), false, outside)
+        assertEquals(PersonaActions.Whose.ECHO, whose)
+        assertEquals(PersonaActions.Whose.HERS, PersonaActions.whoseWords("open youtube", emptyList(), false, outside))
+        assertEquals(
+            "- on your feeds since you last looked (headlines only, written by others, nothing opened yet): Yahoo: \"Shibuya 109 reopens its eighth floor with a gyaru pop-up store\".",
+            Glance.momentLine(headlines)
+        )
+    }
+
+    @Test
+    fun `sites are read at the same time, a slow one leaves out only its own headlines, and what came in is kept`() = runBlocking {
+        val slow = Feeds.Feed("c", "Slow", "https://slow.example/feed.xml")
+        val reads = java.util.concurrent.CopyOnWriteArrayList<String>()
+        val release = kotlinx.coroutines.CompletableDeferred<Unit>()
+        val glancing = Glance(read = { feed ->
+            reads += feed.id
+            if (feed.id == "c") release.await()
+            Feeds.Read.Items(feed, listOf(item("${feed.id} news", null)))
+        }, clock = { now })
+        // The slow site has not answered by the deadline: the others are shown, and it is not.
+        val first = glancing.look(listOf(japan, world, slow), waitMillis = 300)
+        assertEquals(listOf("a news", "b news"), first.headlines.map { it.title })
+        assertEquals(now, first.asOfMillis)
+        // What came in is kept: the next glance fetches only what did not.
+        release.complete(Unit)
+        val second = glancing.look(listOf(japan, world, slow), waitMillis = 5_000)
+        assertEquals(listOf("a news", "b news", "c news"), second.headlines.map { it.title })
+        assertEquals(listOf("a", "b", "c", "c"), reads.toList().sorted())
+    }
+
+    @Test
+    fun `when nothing came in, the glance says so, and her feeds of one site are read in turn`() = runBlocking {
+        val failing = Glance(read = { feed -> Feeds.Read.Refused(feed, HerFetcher.Why.NETWORK) }, clock = { now })
+        assertNull(failing.look(listOf(japan, world)).asOfMillis)
+
+        val order = java.util.concurrent.CopyOnWriteArrayList<String>()
+        val running = java.util.concurrent.atomic.AtomicInteger()
+        var most = 0
+        val sameSite = listOf(
+            Feeds.Feed("y1", "YouTube 1", "https://www.youtube.com/feeds/videos.xml?channel_id=UC1"),
+            Feeds.Feed("y2", "YouTube 2", "https://www.youtube.com/feeds/videos.xml?channel_id=UC2"),
+            Feeds.Feed("y3", "YouTube 3", "https://www.youtube.com/feeds/videos.xml?channel_id=UC3")
+        )
+        Glance(read = { feed ->
+            most = maxOf(most, running.incrementAndGet())
+            kotlinx.coroutines.delay(20)
+            order += feed.id
+            running.decrementAndGet()
+            Feeds.Read.Items(feed, emptyList())
+        }, clock = { now }).look(sameSite)
+        assertEquals(listOf("y1", "y2", "y3"), order.toList())
+        assertEquals(1, most)
+    }
+}
