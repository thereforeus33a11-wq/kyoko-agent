+        assertEquals(1, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertEquals(setOf("builder", "miku"), memory.notes().map { it.key }.toSet())
+        // What she let go is in her archive as she let it go.
+        assertEquals(setOf(oldVoice.storageKey), memory.restorableKeys())
+        assertEquals(oldVoice.text, memory.archivedLately(10).single().note.text)
+    }
+
+    @Test
+    fun `an emptied notebook stays empty`() = runBlocking {
+        memory.seedIfNeeded(olderBuild)
+        memory.empty()
+
+        assertEquals(0, memory.refreshStartingNotes(thisBuild, earlier))
+
+        assertTrue(memory.notes().isEmpty())
+        assertEquals(0, memory.archiveCount())
+        assertTrue(memory.isStarted())
+    }
