@@ -0,0 +1,99 @@
+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.data.models.ChatMessage
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaRein
+
+/**
+ * When the persona may write first. An unprompted line costs a model call and lands as
+ * a notification, so it is rare and never piles up. How rare, and at what hours, is the
+ * owner's setting and not a fixed choice of the app.
+ */
+object CheckInRule {
+
+    private const val HOUR_MILLIS = 60L * 60 * 1000
+    private const val HOURS_IN_A_DAY = 24
+
+    /** After an attempt that failed (no network yet) she is asked again this much later. */
+    const val RETRY_AFTER_FAILURE_MILLIS = 15L * 60 * 1000
+
+    /** After she was asked and chose to say nothing she is asked again this much later. */
+    const val RETRY_AFTER_SILENCE_MILLIS = HOUR_MILLIS
+
+    /** An app line older than this is not put in front of her for an unprompted line. */
+    const val MAX_APP_LINE_AGE_MILLIS = 30L * 60 * 1000
+
+    /**
+     * The owner's settings for her unprompted lines: the hours of the day she may write
+     * in ([firstHour] inclusive to [lastHour] exclusive, local time), how long the chat
+     * has to have been silent, and how far apart two of her lines are at the least.
+     */
+    data class Settings(
+        val firstHour: Int = 16,
+        val lastHour: Int = 3,
+        val quietMillis: Long = 3 * HOUR_MILLIS,
+        val gapMillis: Long = 6 * HOUR_MILLIS
+    ) {
+        companion object {
+            fun of(config: LLMConfig): Settings = Settings(
+                firstHour = config.personaCheckInFirstHour,
+                lastHour = config.personaCheckInLastHour,
+                quietMillis = config.personaCheckInQuietHours.coerceAtLeast(0) * HOUR_MILLIS,
+                gapMillis = config.personaCheckInGapHours.coerceAtLeast(0) * HOUR_MILLIS
+            )
+        }
+    }
+
+    /**
+     * Whether [hourOfDay] lies in the window from [firstHour] up to, not including,
+     * [lastHour]. A window whose last hour is the smaller one runs over midnight: 16 to 3
+     * holds 23, 0 and 2 but not 3 or 15. Equal hours mean the whole day.
+     */
+    fun inWindow(hourOfDay: Int, firstHour: Int, lastHour: Int): Boolean {
+        val hour = hourOfDay.mod(HOURS_IN_A_DAY)
+        val first = firstHour.mod(HOURS_IN_A_DAY)
+        val last = lastHour.mod(HOURS_IN_A_DAY)
+        return when {
+            first == last -> true
+            first < last -> hour in first until last
+            else -> hour >= first || hour < last
+        }
+    }
+
+    /**
+     * Whether she may be asked for an unprompted line now. [lastCheckInAt] is when she
+     * last wrote one; [notBefore] is set by an attempt that wrote nothing and only makes
+     * her wait a little, see [RETRY_AFTER_FAILURE_MILLIS].
+     */
+    fun isDue(
+        recentMessages: List<ChatMessage>,
+        nowMillis: Long,
+        hourOfDay: Int,
+        lastCheckInAt: Long,
+        settings: Settings = Settings(),
+        notBefore: Long = 0L
+    ): Boolean {
+        if (!inWindow(hourOfDay, settings.firstHour, settings.lastHour)) return false
+        if (nowMillis < notBefore) return false
+        // She never opens an empty chat: there has to be a conversation to pick up.
+        val lastOwnerMessage = recentMessages.lastOrNull { it.sender == ChatMessage.Sender.USER } ?: return false
+        val lastMessage = recentMessages.last()
+        if (nowMillis - lastMessage.timestamp < settings.quietMillis) return false
+        if (nowMillis - lastCheckInAt < settings.gapMillis) return false
+        // One unprompted line per silence: he has to have written since her last one.
+        return lastOwnerMessage.timestamp > lastCheckInAt
+    }
+
+    fun hoursQuiet(recentMessages: List<ChatMessage>, nowMillis: Long): Long {
+        val last = recentMessages.lastOrNull()?.timestamp ?: return 0
+        return ((nowMillis - last) / HOUR_MILLIS).coerceAtLeast(1)
+    }
+
+    /**
+     * Whether an unprompted line may end in a command of her own. Only when the owner has
+     * given her the phone: on [PersonaRein.ASK] everything she starts waits for his yes,
+     * and when she writes first nobody is there to give it.
+     */
+    fun mayAct(config: LLMConfig): Boolean =
+        config.personaActionsEnabled && config.personaRein != PersonaRein.ASK
+}
