+    /**
+     * True for a line of hers about a marked result that was stored before those lines
+     * had a badge of their own, and so carries her plain badge.
+     *
+     * Her place behind a marked row does not say it. A reply stands there when the plan
+     * for his message broke off behind its rows, and so does a line she sends him from a
+     * moment of her own, which follows whatever was written last. Both are talk, and
+     * taking them out of her own history would leave his next message answering nothing.
+     * So this asks for what was true of every such line when it was stored, and for all
+     * of it:
+     *
+     *  - [before] is the app's exact row of a result, under the app's plain badge, marked;
+     *  - that result was short enough to be put to her ([PersonaTruth.MAX_CHARS]);
+     *  - she wrote the line right after it;
+     *  - the line keeps every fact of the result ([PersonaTruth.keepsFacts]). Only a
+     *    line that passed this was ever stored, and whether the result was a success is
+     *    not on the row, so either reading counts.
+     *
+     * A row that is already a placeholder, or holds no word at all, is no exact row:
+     * its words have been taken out, and with them what a line could be held against.
+     */
+    private fun isUnbadgedPrivateResultLine(row: ChatMessage, before: ChatMessage?): Boolean {
+        if (before == null || row.modelBadge != BADGE || !isHers(row)) return false
+        if (before.sender == ChatMessage.Sender.USER || before.modelBadge != PRIVATE_RESULT_BADGE) return false
