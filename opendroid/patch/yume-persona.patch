+
+    @Test
+    fun `a reply she gave after his plan broke off behind a marked row stays in her own history too`() {
+        // Written seconds after the plan's last row, and it does not repeat what that row says.
+        val rows = listOf(
+            his("text riya that i am late", 1_000, badge = PersonaPrompts.OWNER_COMMAND_BADGE),
+            app("Running: 1 step\n\u2022 Send SMS to Riya", 1_010, badge = PersonaPrompts.privateBadge("YOLO")),
+            app("Got it! Using Riya Fernhill.", 1_020, badge = PersonaPrompts.PRIVATE_RESULT_BADGE),
