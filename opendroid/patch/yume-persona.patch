+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.core.llm.RetryPolicy
+import com.opendroid.ai.core.llm.error.LLMError
+import com.opendroid.ai.core.llm.error.LLMErrorMapper
+import com.opendroid.ai.data.models.ChatMessage
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.IOException
+
+/**
+ * The two requests that carry a picture because the owner pressed a button: "Let her
+ * look" at one of her own pictures, and "Read the picture into the text" for the
+ * background picture. Each is one call, and only a usable answer changes anything.
+ */
+class PersonaPictureReadingTest {
+
+    private val card = "You are Yume. {{owner}} built you."
+    private val picture = "aGVyLXBpY3R1cmU="
+    private val requests = java.util.concurrent.CopyOnWriteArrayList<LLMRequest>()
+
+    // Stands for the engine's own scope: the call to the model runs here, beside the wait.
+    private val callScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    @After
+    fun tearDown() {
+        callScope.cancel()
+    }
+
+    private fun answer(text: String, finishReason: String? = null) =
+        LLMResponse(text, 12, "her-model", "Her Provider", 40, finishReason = finishReason)
+
+    private fun look(
+        timeoutMillis: Long = 5_000,
+        complete: suspend (LLMRequest) -> LLMResponse
+    ): PictureReading = runBlocking {
+        PersonaEngine.describeOwnPictureFrom(card, "Sam", picture, timeoutMillis, callScope) { request ->
+            requests += request
+            complete(request)
+        }
+    }
+
+    private fun readPage(
+        timeoutMillis: Long = 5_000,
+        complete: suspend (LLMRequest) -> LLMResponse
+    ): PictureReading = runBlocking {
+        PersonaEngine.readBackgroundPictureFrom(picture, timeoutMillis, callScope) { request ->
+            requests += request
+            complete(request)
+        }
+    }
+
+    private fun reason(reading: PictureReading): PictureReading.Reason = (reading as PictureReading.Failed).reason
+
+    /** A provider the way the real ones are: it blocks a thread until the answer is there and cannot be interrupted. */
+    private suspend fun blockingAnswer(millis: Long, text: String): LLMResponse = withContext(Dispatchers.IO) {
+        val until = System.nanoTime() + millis * 1_000_000
+        while (System.nanoTime() < until) {
+            try {
+                Thread.sleep(20)
+            } catch (e: InterruptedException) {
+                // Carries on, as a socket read or a model run would.
+            }
+        }
+        answer(text)
+    }
+
+    // ── Let her look ─────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `what she says about her picture comes back as its caption`() {
+        val reading = look { answer("red hair down. gold hoops, tongue out") }
+        assertEquals(PictureReading.Read("red hair down. gold hoops, tongue out"), reading)
+    }
+
+    @Test
+    fun `the request is her card, one line from the app and a turn that carries the picture`() {
+        look { answer("thats me") }
+
+        val request = requests.single()
+        assertEquals(
+            "You are Yume. Sam built you.\n\n" + PersonaPrompts.OWN_PICTURE_HEADING + "\n- " + PersonaPrompts.OWN_PICTURE_LINE,
+            request.systemPrompt
+        )
+        assertEquals(ResponseFormat.TEXT, request.responseFormat)
+        assertEquals(RetryPolicy.NONE, request.retryPolicy)
+        assertNull(request.tools)
+
+        val turn = request.messages.single()
+        assertEquals(ChatMessage.Sender.USER, turn.sender)
+        assertEquals(picture, turn.imageBase64)
+        assertEquals(PersonaPrompts.OWN_PICTURE_TURN, turn.text)
+    }
+
+    @Test
+    fun `nothing but her card and that line is in it`() {
+        look { answer("thats me") }
+        val prompt = requests.single().systemPrompt
+        // Not her chat prompt: no notes, nothing about him or the phone, nothing from under her awareness.
+        assertFalse(prompt.contains(PersonaPrompts.APP_FACTS_HEADING))
+        assertFalse(prompt.contains(PersonaPrompts.UNDER_HEADING))
+        assertFalse(prompt.contains("UNDER YOU"))
+        assertFalse(prompt.contains(PersonaPrompts.LIBRARY_HEADING))
+        assertFalse(prompt.contains("YOUR OWN NOTES"))
+        assertFalse(prompt.contains(PersonaPrompts.OWNER_PLACEHOLDER))
+    }
+
+    @Test
+    fun `her line is tidied like any reply of hers and a command line starts nothing`() {
+        // A gesture in asterisks is hers and is kept: no word of hers is taken out.
+        assertEquals(PictureReading.Read("*smirks* red hair, tan. me"), look { answer("Yume: *smirks* red hair, tan. me") })
+        assertEquals(PictureReading.Read("thats me"), look { answer("\"thats me\"") })
+        // A look at a picture is not a turn of the talk: a command at its end is dropped, not run and not kept.
+        assertEquals(PictureReading.Read("nice nails"), look { answer("nice nails\n>> text nene: look at my nails") })
+        assertEquals(PictureReading.Read("line one\nline two"), look { answer("line one\n\nline two") })
+    }
+
+    @Test
+    fun `a caption is cut at three hundred characters, on a whole word`() {
+        val long = (1..90).joinToString(" ") { "word$it" }
+        val caption = (look { answer(long) } as PictureReading.Read).text
+        assertTrue(caption.length <= 300)
+        assertTrue(long.startsWith(caption))
+        assertEquals(' ', long[caption.length])
+    }
+
+    @Test
+    fun `an empty answer, or one with no word in it, changes nothing`() {
+        assertEquals(PictureReading.Reason.EMPTY, reason(look { answer("") }))
+        assertEquals(PictureReading.Reason.EMPTY, reason(look { answer("   \n ") }))
+        assertEquals(PictureReading.Reason.EMPTY, reason(look { answer("...") }))
+        // Only a command and nothing said: there is no caption in that.
+        assertEquals(PictureReading.Reason.EMPTY, reason(look { answer(">> take a selfie") }))
+    }
+
+    @Test
+    fun `a model that declines is not taken for her words about the picture`() {
+        assertEquals(PictureReading.Reason.DECLINED, reason(look { answer("I'm sorry, but I can't help with that.") }))
+        assertEquals(PictureReading.Reason.DECLINED, reason(look { answer("I cannot describe people in images.") }))
+        // Her own bluntness is not a refusal.
+        assertEquals(PictureReading.Read("i cant see shit in this light. still me"), look { answer("i cant see shit in this light. still me") })
+    }
+
+    @Test
+    fun `a failed call changes nothing, and a refusal of the route is handed on with its reason`() {
+        assertEquals(PictureReading.Reason.CALL_FAILED, reason(look { throw IOException("connection reset") }))
+        assertEquals(PictureReading.Reason.CALL_FAILED, reason(look { throw IllegalStateException("anything else") }))
+
+        // The gate refuses a route his privacy setting does not allow before anything is sent.
+        val refused = LLMErrorMapper.privateRouteRequired("OpenAI", "gpt-4o")
+        val reading = look { throw refused } as PictureReading.Failed
+        assertEquals(PictureReading.Reason.CALL_FAILED, reading.reason)
+        assertSame(refused, reading.failure)
+        assertEquals(LLMError.PrivateRouteRequired, reading.failure!!.error)
+    }
+
+    @Test
+    fun `it is asked once, with no second try`() {
+        var calls = 0
+        look {
+            calls++
+            throw IOException("down")
+        }
+        assertEquals(1, calls)
+    }
+
+    @Test
+    fun `the wait ends when the time is up, even though the provider cannot be interrupted`() {
+        val started = System.nanoTime()
+        val reading = look(timeoutMillis = 150) { blockingAnswer(3_000, "too late") }
+        val waited = (System.nanoTime() - started) / 1_000_000
+
+        assertEquals(PictureReading.Reason.TOOK_TOO_LONG, reason(reading))
+        assertTrue("waited $waited ms", waited < 2_000)
+    }
+
+    @Test
+    fun `leaving the screen while she looks stops the wait and is passed on`() = runBlocking {
+        var result: PictureReading? = null
+        val job = launch(Dispatchers.Default) {
+            result = PersonaEngine.describeOwnPictureFrom(card, "Sam", picture, 5_000, callScope) { blockingAnswer(1_500, "late") }
+        }
+        delay(100)
+        job.cancelAndJoin()
+
+        assertTrue(job.isCancelled)
+        assertNull(result)
+    }
+
+    // ── Read the background picture into the text ────────────────────────────────────
+
+    @Test
+    fun `the page is read by a neutral request that carries neither her card nor her voice`() {
+        val reading = readPage { answer("  She is nineteen. She grew up above a harbour.\n\nShe left at night.  ") }
+
+        assertEquals(PictureReading.Read("She is nineteen. She grew up above a harbour.\n\nShe left at night."), reading)
+        val request = requests.single()
+        assertEquals(PersonaPrompts.BACKGROUND_READING_PROMPT, request.systemPrompt)
+        assertFalse(request.systemPrompt.contains("Yume"))
+        assertEquals(ResponseFormat.TEXT, request.responseFormat)
+        assertEquals(RetryPolicy.NONE, request.retryPolicy)
+        // Written down, not retold.
+        assertTrue(request.temperature <= 0.3f)
+
+        val turn = request.messages.single()
+        assertEquals(ChatMessage.Sender.USER, turn.sender)
+        assertEquals(picture, turn.imageBase64)
+        assertEquals(PersonaPrompts.BACKGROUND_READING_TURN, turn.text)
+    }
+
+    @Test
+    fun `what is written down about the page is not shortened or reshaped`() {
+        val notes = (1..120).joinToString("\n") { "- line $it of the page, as it stands *there*" }
+        assertEquals(PictureReading.Read(notes), readPage { answer(notes) })
+    }
+
+    @Test
+    fun `a page the model did not get to the end of comes back marked as cut off`() {
+        val whole = readPage { answer("She is nineteen. She grew up above a harbour.", finishReason = "stop") }
+        assertEquals(PictureReading.Read("She is nineteen. She grew up above a harbour."), whole)
+        assertFalse((whole as PictureReading.Read).cutOff)
+        // A provider that names no ending has not said that the page was cut.
+        assertFalse((readPage { answer("She is nineteen.") } as PictureReading.Read).cutOff)
+
+        val part = readPage { answer("She is nineteen. She grew up above a harbour and when she", finishReason = "length") }
+        assertEquals(PictureReading.Read("She is nineteen. She grew up above a harbour and when she", cutOff = true), part)
+    }
+
+    @Test
+    fun `the page is given room for a dense sheet, as its own request with its own limit`() {
+        readPage { answer("notes") }
+        val request = requests.single()
+        assertEquals(PersonaEngine.BACKGROUND_READING_MAX_TOKENS, request.maxTokens)
+        // About seven thousand characters of notes come to some two thousand tokens.
+        assertTrue(PersonaEngine.BACKGROUND_READING_MAX_TOKENS >= 3000)
+        // His options for her replies do not replace it: the request keeps its own sampling.
+        assertTrue(PersonaEngine.keepsOwnSampling(request))
+    }
+
+    @Test
+    fun `what she says about a picture is marked the same way when her model ran out of room`() {
+        val part = look { answer("red hair down. gold hoops and", finishReason = "length") }
+        assertEquals(PictureReading.Read("red hair down. gold hoops and", cutOff = true), part)
+        assertFalse((look { answer("red hair down", finishReason = "stop") } as PictureReading.Read).cutOff)
+    }
+
+    @Test
+    fun `a page that could not be read leaves the text alone`() {
+        assertEquals(PictureReading.Reason.EMPTY, reason(readPage { answer(" ") }))
+        assertEquals(PictureReading.Reason.DECLINED, reason(readPage { answer("I'm unable to view images.") }))
+        assertEquals(PictureReading.Reason.CALL_FAILED, reason(readPage { throw IOException("down") }))
+        assertEquals(PictureReading.Reason.TOOK_TOO_LONG, reason(readPage(timeoutMillis = 150) { blockingAnswer(3_000, "late") }))
+    }
+
+    @Test
+    fun `the page is given more time than a look at one picture`() {
+        assertEquals(30_000L, PersonaEngine.OWN_PICTURE_TIMEOUT_MILLIS)
+        assertTrue(PersonaEngine.BACKGROUND_READING_TIMEOUT_MILLIS > PersonaEngine.OWN_PICTURE_TIMEOUT_MILLIS)
+    }
+
+    // ── The owner's name in the under text ───────────────────────────────────────────
+
+    @Test
+    fun `the under text gets his name the way a page of her files does`() {
+        val text = "{{owner}} has said it plainly. she calls him {{owner_lc}} when she is annoyed."
+        assertEquals(
+            "Sam has said it plainly. she calls him sam when she is annoyed.",
+            PersonaEngine.underWithOwner(text, " Sam ")
+        )
+        // With no name stored it reads as a sentence, which "him has said" would not.
+        assertEquals(
+            "The guy has said it plainly. she calls him the guy when she is annoyed.",
+            PersonaEngine.underWithOwner(text, "  ")
+        )
+        assertEquals("nothing to fill", PersonaEngine.underWithOwner("nothing to fill", "Sam"))
+    }
