@@ -0,0 +1,129 @@
+package com.opendroid.ai.core.life.eyes
+
+import android.content.Context
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withTimeoutOrNull
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.resume
+
+/**
+ * How the phone is folded, and so which camera faces what. Written for a clamshell like the
+ * Galaxy Z Flip, whose cover screen sits beside its outer cameras.
+ *
+ * - Open, or on a phone that does not fold: the back camera faces away from him and the
+ *   front camera faces him.
+ * - Folded (the hinge under [FOLDED_UNDER_DEGREES]): the screen that is on is the cover
+ *   screen, beside the outer cameras, so the outer camera faces him; the inner camera is
+ *   shut inside the fold. Nothing faces away from him, and a look `back` is refused rather
+ *   than taken through a camera that faces him or one that sees only the inside of the fold.
+ * - A hinge that cannot be read: no camera is taken, since the app cannot tell what one
+ *   would face.
+ *
+ * The front camera, whichever lens that is, is used only where he chose "front and back".
+ * Hinge angles on the phone itself are UNCONFIRMED (device test D16).
+ */
+@Singleton
+class FoldState @Inject constructor(@ApplicationContext private val context: Context) {
+
+    /** How the phone stands. */
+    enum class Posture {
+        /** It has no hinge: an ordinary phone. */
+        NOT_FOLDABLE,
+        OPEN,
+        FOLDED,
+
+        /** It has a hinge whose angle could not be read now. */
+        UNKNOWN
+    }
+
+    /** Which way a look faces: [BACK] away from him, [FRONT] toward him. */
+    enum class Side(val word: String) { BACK("back"), FRONT("front") }
+
+    /** The camera opened, by how the phone describes its lens (CameraCharacteristics.LENS_FACING). */
+    enum class Lens { BACK, FRONT }
+
+    /** Which camera a look facing one way takes, or why none. */
+    sealed class Pick {
+        /** [lens] is opened; it faces [side], and [words] are what he and she are told it was ("back camera"). */
+        data class Use(val side: Side, val lens: Lens, val words: String) : Pick()
+
+        data class Refused(val why: Refusal) : Pick()
+    }
+
+    /** Why no camera faces the way a look asked for. */
+    enum class Refusal(val words: String) {
+        FRONT_OFF("his settings let you look through the back camera only"),
+        FOLDED_NO_BACK("the phone was folded: its inner camera is shut inside the fold and the outer one faces him, so no camera faced away from him"),
+        UNKNOWN("the app could not tell how the phone was folded, so it could not tell which way a camera faced")
+    }
+
+    /** Whether the phone has a hinge sensor at all, read without waiting. */
+    fun foldable(): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return false
+        val sensors = context.getSystemService(Context.SENSOR_SERVICE) as? SensorManager ?: return false
+        return sensors.getDefaultSensor(Sensor.TYPE_HINGE_ANGLE) != null
+    }
+
+    /** How the phone stands now, from its hinge sensor; [Posture.NOT_FOLDABLE] where it has none. */
+    suspend fun posture(): Posture {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return Posture.NOT_FOLDABLE
+        val sensors = context.getSystemService(Context.SENSOR_SERVICE) as? SensorManager ?: return Posture.NOT_FOLDABLE
+        val hinge = sensors.getDefaultSensor(Sensor.TYPE_HINGE_ANGLE) ?: return posture(hasHinge = false, angle = null)
+        return posture(hasHinge = true, angle = readOnce(sensors, hinge))
+    }
+
+    // An on-change sensor reports its value as soon as it is listened to; the listener goes at once.
+    private suspend fun readOnce(sensors: SensorManager, sensor: Sensor): Float? = withTimeoutOrNull(READ_WAIT_MILLIS) {
+        suspendCancellableCoroutine { going ->
+            val listener = object : SensorEventListener {
+                override fun onSensorChanged(event: SensorEvent) {
+                    sensors.unregisterListener(this)
+                    if (going.isActive) going.resume(event.values.firstOrNull())
+                }
+
+                override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) = Unit
+            }
+            going.invokeOnCancellation { sensors.unregisterListener(listener) }
+            if (!sensors.registerListener(listener, sensor, SensorManager.SENSOR_DELAY_NORMAL, Handler(Looper.getMainLooper()))) {
+                if (going.isActive) going.resume(null)
+            }
+        }
+    }
+
+    companion object {
+        /** Under this hinge angle the phone counts as folded. */
+        const val FOLDED_UNDER_DEGREES = 30f
+
+        /** How long the hinge is listened to for its value. */
+        const val READ_WAIT_MILLIS = 600L
+
+        fun posture(hasHinge: Boolean, angle: Float?): Posture = when {
+            !hasHinge -> Posture.NOT_FOLDABLE
+            angle == null || angle.isNaN() -> Posture.UNKNOWN
+            angle < FOLDED_UNDER_DEGREES -> Posture.FOLDED
+            else -> Posture.OPEN
+        }
+
+        /** The camera a look facing [side] takes as the phone stands ([posture]); the front one only with [frontAllowed]. */
+        fun pick(posture: Posture, side: Side, frontAllowed: Boolean): Pick = when {
+            side == Side.FRONT && !frontAllowed -> Pick.Refused(Refusal.FRONT_OFF)
+            posture == Posture.UNKNOWN -> Pick.Refused(Refusal.UNKNOWN)
+            posture == Posture.FOLDED ->
+                if (side == Side.BACK) Pick.Refused(Refusal.FOLDED_NO_BACK) else Pick.Use(Side.FRONT, Lens.BACK, OUTER_CAMERA)
+            side == Side.BACK -> Pick.Use(Side.BACK, Lens.BACK, "back camera")
+            else -> Pick.Use(Side.FRONT, Lens.FRONT, "front camera")
+        }
+
+        /** The outer camera of a folded clamshell, which faces him over the cover screen. */
+        const val OUTER_CAMERA = "outer camera"
+    }
+}
