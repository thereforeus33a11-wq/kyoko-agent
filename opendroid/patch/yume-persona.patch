+    /** [text] with what is addressed to a writer taken out or reworded. See [WRITER_WORDS]. */
+    private fun withoutWriter(text: String): String =
+        WRITER_WORDS.fold(text) { said, (pattern, replacement) -> pattern.replace(said, replacement) }
+
+    /** [line] without bracketed pointers to other files and with inline file names turned into plain words. */
+    private fun withoutPointers(line: String): String =
+        FILE_NAME.replace(FILE_POINTER.replace(line, "")) { match -> FILE_TOPICS[match.groupValues[1]] ?: match.value }
+
+    /**
+     * [line] without the sentences that name what is [BURIED], or null when the line goes
