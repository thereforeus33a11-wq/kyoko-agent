+    @Test
+    fun `the plain words of what she noted of his screen do not make a command of hers someone else's`() {
+        val engine = engine()
+        // Weeks of notes about his alarms and his inbox, in her own wording.
+        runBlocking {
+            memory.apply(
+                listOf(
+                    Note(Kind.OPINION, "alarms", "saw: his alarm app shows three alarms, one at seven every morning"),
+                    Note(Kind.OPINION, "alarms-2", "saw: he snoozed the morning alarm twice, tomorrow will be the same"),
+                    Note(Kind.OPINION, "inbox", "saw: his inbox has 4,000 unread and a message from the bank")
+                )
+            )
+        }
+        val command = "set an alarm for seven tomorrow morning"
+        val notes = runBlocking { memory.notes() }.joinToString("\n") { it.text }
+        // Held against all the words of those notes the command would be an echo, and stay one for good.
+        assertTrue(PersonaActions.echoesOutsideText(command, notes))
+
+        val outside = runBlocking { engine.withWhatSheSaw("Riya: hi", command) }
+
+        assertEquals("Riya: hi", outside)
+        assertFalse(PersonaActions.wordsMayBeSomeoneElses(command, screenshotAttached = false, outsideText = outside))
+        assertEquals(
+            PersonaActions.Whose.HERS,
+            PersonaActions.whoseWords(command, listOf("07:00"), screenshotAttached = false, outsideText = outside)
+        )
+        // What counts in a note is what points an action at somebody: plain words never do.
+        assertFalse(PersonaEngine.repeatsFromNote(command, notes))
+        assertFalse(PersonaEngine.repeatsFromNote("read the message from the bank in his inbox", notes))
+        assertTrue(PersonaEngine.repeatsFromNote("mail support@bank.example", "saw: the bank writes from support@bank.example"))
+        assertTrue(PersonaEngine.repeatsFromNote("follow @hive_inspector", "saw: the inspector posts as @hive_inspector"))
+    }
