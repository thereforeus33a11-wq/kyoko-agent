+
+    private fun engine(builtInCard: String = "You are Yume. {{owner}} built you.\n"): PersonaEngine {
+        val store = PersonaStore(context) { path -> if (path.endsWith("card.md")) builtInCard else "" }
+        return PersonaEngine(
+            store = store,
+            memory = memory,
