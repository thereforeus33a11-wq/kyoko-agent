+            }
+            // A phrase counts with the weight of the heaviest cue that says it whole.
+            val said = cues.map { " ${wordRun(it.text)} " to it.weight }
+            val weightByPhrase = HashMap<String, Double>()
+            fun phraseWeight(phrase: String): Double = weightByPhrase.getOrPut(phrase) {
+                said.filter { it.first.contains(" $phrase ") }.maxOfOrNull { it.second } ?: 0.0
+            }
+            val phraseLeads = pages.any { page -> page.phrases.any { phraseWeight(it) >= LEADING_WEIGHT } }
+            if (weightByTerm.none { it.value >= LEADING_WEIGHT } && !phraseLeads) return emptyList()
+            val scored = pages.mapNotNull { page ->
+                var score = 0.0
+                var led = false
+                for ((term, weight) in weightByTerm) {
+                    var gain = 0.0
+                    if (term in page.keywords) gain += KEYWORD_GAIN
+                    if (term in page.headingTerms) gain += HEADING_GAIN
+                    if (term in page.terms) gain += rarity[term] ?: 0.0
+                    if (gain > 0.0) {
