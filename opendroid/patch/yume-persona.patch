+package com.opendroid.ai.core.life.reading
+
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/** RSS, RDF and Atom read with the platform's pull parser, and the feeds she has. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class FeedsTest {
+
+    private val googleNews = """
+        <?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+        <rss version="2.0" xmlns:media="http://search.yahoo.com/mrss/"><channel>
+        <title>Top stories - Google News</title>
+        <item>
+          <title>Shibuya 109 reopens its eighth floor - Example Times</title>
+          <link>https://news.google.com/rss/articles/CBMiAbc?oc=5</link>
+          <pubDate>Tue, 17 Nov 2026 09:00:00 GMT</pubDate>
+          <description>&lt;a href="https://news.google.com/rss/articles/CBMiAbc"&gt;Shibuya 109 reopens&lt;/a&gt;</description>
+          <source url="https://www.example-times.com">Example Times</source>
+        </item>
+        <item>
+          <title>Gyaru fashion is back - Daily Example</title>
+          <link>https://news.google.com/rss/articles/CBMiDef?oc=5</link>
+          <pubDate>Tue, 17 Nov 2026 11:30:00 GMT</pubDate>
+          <source url="https://daily.example.com">Daily Example</source>
+        </item>
+        </channel></rss>
+    """.trimIndent()
+
+    @Test
+    fun `RSS - newest first, the source taken off the headline, Google News links shown as headlines only`() {
+        val items = Feeds.parse(googleNews)!!
+        assertEquals(listOf("Gyaru fashion is back", "Shibuya 109 reopens its eighth floor"), items.map { it.title })
+        assertEquals("Daily Example", items[0].source)
+        assertNull(items[0].opensAt)
+        assertEquals("Shibuya 109 reopens", items[1].summary)
+        assertTrue(items[0].publishedAt!! > items[1].publishedAt!!)
+    }
+
+    @Test
+    fun `RSS with CDATA and an image, from Yahoo-style topics`() {
+        val xml = """
+            <?xml version="1.0" encoding="UTF-8"?>
+            <rss version="2.0"><channel><title>Yahoo!ニュース・トピックス - 主要</title>
+            <item><title><![CDATA[渋谷109 8階が リニューアル]]></title>
+            <link>https://news.yahoo.co.jp/pickup/1234567?source=rss</link>
+            <pubDate>Tue, 17 Nov 2026 18:02:11 +0900</pubDate>
+            <enclosure url="https://news.yahoo.co.jp/img/1.jpg" type="image/jpeg" length="0"/>
+            </item></channel></rss>
+        """.trimIndent()
+        val item = Feeds.parse(xml)!!.single()
+        assertEquals("渋谷109 8階が リニューアル", item.title)
+        assertEquals("https://news.yahoo.co.jp/pickup/1234567?source=rss", item.opensAt)
+        assertEquals("https://news.yahoo.co.jp/img/1.jpg", item.image)
+    }
+
+    @Test
+    fun `Atom - a YouTube channel feed`() {
+        val xml = """
+            <?xml version="1.0" encoding="UTF-8"?>
+            <feed xmlns:yt="http://www.youtube.com/xml/schemas/2015" xmlns:media="http://search.yahoo.com/mrss/" xmlns="http://www.w3.org/2005/Atom">
+             <title>Some Channel</title>
+             <entry>
+              <id>yt:video:abc</id>
+              <title>Gyaru makeup tutorial 2026</title>
+              <link rel="alternate" href="https://www.youtube.com/watch?v=abc"/>
+              <published>2026-11-16T10:00:00+00:00</published>
+              <media:group><media:thumbnail url="https://i.ytimg.com/vi/abc/hqdefault.jpg" width="480" height="360"/>
+              <media:description>How to do it.</media:description></media:group>
+             </entry>
+            </feed>
+        """.trimIndent()
+        val item = Feeds.parse(xml)!!.single()
+        assertEquals("Gyaru makeup tutorial 2026", item.title)
+        assertEquals("https://www.youtube.com/watch?v=abc", item.opensAt)
+        assertEquals("https://i.ytimg.com/vi/abc/hqdefault.jpg", item.image)
+        assertEquals("How to do it.", item.summary)
+    }
+
+    @Test
+    fun `RDF - RSS 1_0`() {
+        val xml = """
+            <?xml version="1.0"?>
+            <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns="http://purl.org/rss/1.0/" xmlns:dc="http://purl.org/dc/elements/1.1/">
+            <channel rdf:about="https://example.jp/"><title>Blog</title></channel>
+            <item rdf:about="https://example.jp/1"><title>first post</title><link>https://example.jp/1</link><dc:date>2026-11-10T08:00:00+09:00</dc:date></item>
+            </rdf:RDF>
+        """.trimIndent()
+        val item = Feeds.parse(xml)!!.single()
+        assertEquals("first post", item.title)
+        assertTrue(item.publishedAt != null)
+    }
+
+    @Test
+    fun `what is no feed is not read as one`() {
+        assertNull(Feeds.parse("<html><body><p>a page</p></body></html>"))
+        assertNull(Feeds.parse("{\"json\": true}"))
+    }
+
+    @Test
+    fun `her feeds - the defaults, a topic search, and YouTube channels`() {
+        assertEquals(4, Feeds.DEFAULTS.size)
+        assertTrue(Feeds.DEFAULTS.all { it.url.startsWith("https://") })
+        val search = Feeds.search("gyaru fashion").url.toHttpUrl()
+        assertEquals("news.google.com", search.host)
+        assertEquals("/rss/search", search.encodedPath)
+        assertEquals("gyaru fashion", search.queryParameter("q"))
+        assertEquals("US:en", search.queryParameter("ceid"))
+        assertEquals("JP:ja", Feeds.search("渋谷").url.toHttpUrl().queryParameter("ceid"))
+        val id = "UC" + "a".repeat(22)
+        assertEquals(id, Feeds.channelIdOf("https://www.youtube.com/channel/$id"))
+        assertEquals(id, Feeds.channelIdOf("youtube.com/channel/$id/videos"))
+        assertNull(Feeds.channelIdOf("https://www.youtube.com/@somechannel"))
+        assertNull(Feeds.channelIdOf("https://example.com/channel/$id"))
+        assertEquals(id, Feeds.channelIdInPage("<link rel=\"canonical\" href=\"https://www.youtube.com/channel/$id\">"))
+        assertEquals("https://www.youtube.com/feeds/videos.xml?channel_id=$id", Feeds.youtube(id)!!.url)
+        assertNull(Feeds.youtube("not-an-id"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/reading/GlanceTest.kt b/app/src/test/java/com/opendroid/ai/core/life/reading/GlanceTest.kt
