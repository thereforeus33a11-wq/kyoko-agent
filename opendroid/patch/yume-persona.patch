+package com.opendroid.ai.core.life.reading
+
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OutgoingGuard
+import com.opendroid.ai.core.life.OutingKind
+import com.opendroid.ai.core.life.OutingStep
+import com.opendroid.ai.core.life.eyes.Describe
+import com.opendroid.ai.core.life.eyes.Eyes
+import com.opendroid.ai.core.life.eyes.HerEyes
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+
+/**
+ * Her space while she reads: what is in front of her ([view]) and what each of her verbs
+ * does to it, carried out by code. She steers; the code fetches. Whatever leaves the phone
+ * on her behalf passes [OutgoingGuard] first, her search words and the query of every link
+ * she opens, and is fetched by the fetch rules ([HerFetcher], through [Sources]).
+ *
+ * A page that says of itself, or in its opening, that it is by or about a child or a teen
+ * is marked so ([KidGuard]): its feed is not followed, and she is told why.
+ *
+ * Pictures (her eyes, when he switched them on): a page's lead picture (Wikipedia's page
+ * picture, a page's `og:image`), a search result's picture and a feed item's thumbnail are
+ * numbered in front of her, and `look <n>` has the describer look at one ([Eyes]): its words
+ * stand in front of her while she is there. At most [Limits.looks] an outing. Kid protection
+ * comes first: a picture of a page or an item marked as a kid's is not looked at, and a
+ * picture the describer saw a child or a teen in marks what it belongs to. A marked item
+ * is then shown as one line, its text and its picture withheld; a marked page's picture is
+ * shown as `kid:` with the app's reason, and the describer's words are withheld from her. A
+ * description without a readable `ages:` line is unchecked, and its words are not shown.
+ *
+ * Each verb comes back as a [Did]: one line of what really happened, in the app's words,
+ * and what it counts as. Other people's words stay in [view]; a [Did] line names a title
+ * at most.
+ */
+class ReadingSpace(
+    private val sources: Sources,
+    private val his: OutgoingGuard.His,
+    /** Her feeds: the defaults he left her and the ones she follows. */
+    private val herFeeds: List<Feeds.Feed> = Feeds.DEFAULTS,
+    private val limits: Limits = Limits(),
+    private val clock: () -> Long = System::currentTimeMillis,
+    /** Her eyes, or null when she has none on this outing. */
+    private val eyes: Eyes? = null
+) {
+    /** Where her reading goes: Wikipedia, any page by the fetch rules, her feeds. */
+    interface Sources {
+        suspend fun search(words: String): Wikipedia.Result<List<Wikipedia.Hit>>
+        suspend fun article(title: String, lang: String): Wikipedia.Result<Wikipedia.Article>
+        suspend fun fetch(url: String): HerFetcher.Fetched
+        suspend fun feed(feed: Feeds.Feed): Feeds.Read
+
+        /** Keeps a site's feed among hers. */
+        fun follow(url: String, name: String): HerFeeds.Followed
+
+        /** A picture for her eyes, by the fetch rules for pictures ([HerFetcher.image]). */
+        suspend fun image(url: String): HerFetcher.Fetched = HerFetcher.Fetched.Refused(HerFetcher.Why.WRONG_TYPE)
+
+        /** Her search words on Venice web search ([VeniceSearch]), where he switched it on. */
+        suspend fun webSearch(words: String): VeniceSearch.Result = VeniceSearch.Result.Off
+    }
+
+    /** How much one outing may take: searches, pages, and pictures looked at. */
+    data class Limits(
+        val searches: Int = MAX_SEARCHES,
+        val pages: Int = MAX_PAGES,
+        val headlines: Int = MAX_HEADLINES,
+        val looks: Int = 0,
+        /** A search goes to Venice web search as well as to Wikipedia (his switch, [VeniceSearch.on]). */
+        val webSearch: Boolean = false
+    )
+
+    /**
+     * A picture in front of her: where it is fetched from, the number of the item it belongs
+     * to in a list ([item], null for a page's lead picture), and what came of a look at it.
+     */
+    data class Picture(val url: String, val item: Int?, val look: Look? = null)
+
+    /** What a look at a picture came to. */
+    sealed class Look {
+        /** The describer's words; [kid] where it marks what the picture belongs to as a kid's, and then no words are kept. */
+        data class Words(val words: String, val kid: KidGuard.Flag?, val cutOff: Boolean = false) : Look()
+
+        /** The describer said no ages: its words are not shown. */
+        data object Unchecked : Look()
+    }
+
+    /** What is in front of her. */
+    sealed class View {
+        data class Hits(
+            val words: String,
+            val lang: String,
+            val hits: List<Wikipedia.Hit>,
+            val pictures: List<Picture> = picturesOf(hits.map { it.thumbnail }),
+            /** Results marked as a kid's, by their number: shown as one line, never opened or looked at. */
+            val kids: Map<Int, KidGuard.Flag> = emptyMap(),
+            /** Venice web search's results, numbered after Wikipedia's; empty without it. */
+            val web: List<VeniceSearch.Hit> = emptyList()
+        ) : View()
+
+        data class Headlines(
+            val title: String,
+            val items: List<Feeds.Item>,
+            val pictures: List<Picture> = picturesOf(items.map { it.image }),
+            /** Headlines marked as a kid's, by their number: shown as one line, never opened or looked at. */
+            val kids: Map<Int, KidGuard.Flag> = emptyMap()
+        ) : View()
+
+        data class Page(
+            val site: String,
+            val title: String,
+            val url: String,
+            val parts: List<String>,
+            val part: Int,
+            val links: List<Readable.Link>,
+            val feeds: List<String>,
+            val truncated: Boolean = false,
+            /** The page says of itself, or in its opening, that it is by or about a kid, or its picture shows one: marked, never followed. */
+            val kid: KidGuard.Flag? = null,
+            /** Its lead picture, where it has one. */
+            val pictures: List<Picture> = emptyList()
+        ) : View()
+
+        data class Nothing(val why: String) : View()
+    }
+
+    /** What one verb came to. */
+    data class Did(
+        /** What the app did, in its own words. */
+        val line: String,
+        /** Her words or a link would have carried something about him: not sent. */
+        val refusal: OutgoingGuard.Refusal? = null,
+        /** The fetch rules refused it. */
+        val fetchRefused: HerFetcher.Why? = null,
+        /** A page she opened: its title and site. */
+        val opened: Pair<String, String>? = null,
+        /** Her search words, sent. */
+        val searched: String? = null,
+        /** A feed she now follows. */
+        val followed: Boolean = false,
+        /** What she did was skipped: the page is a kid's ([KidGuard]). */
+        val kidSkipped: KidGuard.Flag? = null,
+        /** A picture was sent to the describer: one call of hers, one look of the outing. */
+        val looked: Boolean = false,
+        /** The describer saw a child or a teen in the picture: what it belongs to is marked. */
+        val kidSeen: KidGuard.Flag? = null,
+        /** The describer said no ages: the picture is unchecked, and its words are not shown. */
+        val unchecked: Boolean = false,
+        /** Why her eyes described nothing, where they did not. */
+        val notSeen: HerEyes.Why? = null
+    )
+
+    var view: View = View.Nothing("nothing opened yet")
+        private set
+
+    private val behind = ArrayDeque<View>()
+
+    var searchesLeft: Int = limits.searches
+        private set
+
+    var pagesLeft: Int = limits.pages
+        private set
+
+    /** Pictures she may still have looked at on this outing. */
+    var looksLeft: Int = if (eyes == null) 0 else limits.looks.coerceAtLeast(0)
+        private set
+
+    /** Whether a search goes to Venice web search too on this outing. */
+    val webSearch: Boolean get() = limits.webSearch
+
+    /** Whether she has eyes on this outing at all. */
+    val hasEyes: Boolean get() = eyes != null && limits.looks > 0
+
+    /** The pictures in front of her, numbered from one in this order. */
+    val pictures: List<Picture> get() = picturesIn(view)
+
+    /** How many times something was not sent because it would have carried something about him. */
+    var guardRefusals: Int = 0
+        private set
+
+    /** The site she is on, for the notification and the log: a host, never a page's text. */
+    val site: String
+        get() = when (val now = view) {
+            is View.Page -> now.site
+            is View.Hits -> "${now.lang}.wikipedia.org"
+            is View.Headlines -> "news"
+            is View.Nothing -> ""
+        }
+
+    /** Her space as it can show a feed she could follow: never a kid's. */
+    val canFollow: Boolean get() = (view as? View.Page)?.let { it.feeds.isNotEmpty() && it.kid == null } == true
+
+    /**
+     * What is in front of her is marked as a kid's ([KidGuard]), or null: a page that is, or
+     * a list with an item that is.
+     */
+    val kidInFront: KidGuard.Flag?
+        get() = when (val now = view) {
+            is View.Page -> now.kid
+            is View.Hits -> now.kids.values.firstOrNull()
+            is View.Headlines -> now.kids.values.firstOrNull()
+            is View.Nothing -> null
+        }
+
+    /** The first look of the outing her `go:` line asked for. */
+    suspend fun begin(parsed: OutingKind.Parsed): Did = when (parsed) {
+        is OutingKind.Parsed.Read -> if (parsed.url != null) openUrl(parsed.url, typed = true) else lookUp(parsed.words)
+        is OutingKind.Parsed.NewsOf -> news(parsed.which, parsed.topic)
+        is OutingKind.Parsed.NotRead -> Did("the app could not read that go: line, so it opened nothing")
+        // A look through the camera is never read here: her reading space has no camera.
+        is OutingKind.Parsed.Look -> Did("a look through the camera is not read in your reading space, so it opened nothing")
+    }
+
+    /** Carries out her `do:` [verb]. [OutingStep.Verb.Done] is the host's; it does nothing here. */
+    suspend fun run(verb: OutingStep.Verb): Did = when (verb) {
+        is OutingStep.Verb.Search -> search(verb.words)
+        is OutingStep.Verb.Open -> open(verb.n)
+        OutingStep.Verb.More -> more()
+        OutingStep.Verb.Back -> back()
+        is OutingStep.Verb.Follow -> follow(verb.n)
+        is OutingStep.Verb.Look -> look(verb.n)
+        OutingStep.Verb.Done -> Did("you were done")
+    }
+
+    // ── The verbs ────────────────────────────────────────────────────────────────────
+
+    private suspend fun search(words: String): Did {
+        if (searchesLeft <= 0) return Did("no searches are left on this outing, so nothing was searched")
+        return lookUp(words, counted = true)
+    }
+
+    private suspend fun lookUp(words: String, counted: Boolean = false): Did {
+        refused(OutgoingGuard.check(words, his))?.let { return it }
+        if (counted) searchesLeft--
+        if (limits.webSearch) return lookUpBoth(words)
+        return when (val result = sources.search(words)) {
+            is Wikipedia.Result.Found -> {
+                show(View.Hits(words, Wikipedia.langOf(words), result.value))
+                Did("searched wikipedia for \"$words\": ${result.value.size} results", searched = words)
+            }
+            Wikipedia.Result.Empty -> {
+                show(View.Nothing("wikipedia found nothing for that"))
+                Did("searched wikipedia for \"$words\": nothing found", searched = words)
+            }
+            is Wikipedia.Result.Refused -> Did("the search did not go out: ${whyWords(result.why)}", fetchRefused = result.why)
+            Wikipedia.Result.Unreadable -> Did("the search came back in a form the app could not read", searched = words)
+        }
+    }
+
+    /**
+     * Her words, past the guard already, on Wikipedia and on Venice web search: one list, the
+     * web results numbered after Wikipedia's. A web result whose own title or snippet marks it
+     * as a kid's is one line, never opened.
+     */
+    private suspend fun lookUpBoth(words: String): Did {
+        val wiki = sources.search(words)
+        val web = sources.webSearch(words)
+        val wikiHits = if (wiki is Wikipedia.Result.Found) wiki.value else emptyList()
+        val webHits = (web as? VeniceSearch.Result.Found)?.hits.orEmpty()
+        val wikiSaid = when (wiki) {
+            is Wikipedia.Result.Found -> "${wiki.value.size} results"
+            Wikipedia.Result.Empty -> "nothing found"
+            is Wikipedia.Result.Refused -> "it did not go out (${whyWords(wiki.why)})"
+            Wikipedia.Result.Unreadable -> "it came back in a form the app could not read"
+        }
+        val webSaid = when (web) {
+            is VeniceSearch.Result.Found -> "${web.hits.size} results"
+            VeniceSearch.Result.Empty -> "nothing found"
+            is VeniceSearch.Result.Failed -> web.why
+            VeniceSearch.Result.Off -> "it is not set up just now, so nothing went there"
+        }
+        // Her words went out where either search left the phone.
+        val webSent = when (web) {
+            is VeniceSearch.Result.Found, VeniceSearch.Result.Empty -> true
+            is VeniceSearch.Result.Failed -> web.sent
+            VeniceSearch.Result.Off -> false
+        }
+        val sent = wiki !is Wikipedia.Result.Refused || webSent
+        if (wikiHits.isEmpty() && webHits.isEmpty()) {
+            show(View.Nothing("neither wikipedia nor venice search found anything for that"))
+        } else {
+            val kids = webHits.mapIndexedNotNull { index, hit ->
+                KidGuard.flag(hit.title + " · " + hit.site, hit.snippet, clock())?.let { wikiHits.size + index + 1 to it }
+            }.toMap()
+            show(View.Hits(words, Wikipedia.langOf(words), wikiHits, kids = kids, web = webHits))
+        }
+        return Did(
+            "searched wikipedia for \"$words\": $wikiSaid; and venice search: $webSaid",
+            searched = words.takeIf { sent },
+            fetchRefused = (wiki as? Wikipedia.Result.Refused)?.why?.takeIf { webHits.isEmpty() }
+        )
+    }
+
+    private suspend fun news(which: OutingKind.News, topic: String?): Did {
+        val feeds = if (which == OutingKind.News.TOPIC) {
+            val words = topic.orEmpty()
+            refused(OutgoingGuard.check(words, his))?.let { return it }
+            listOf(Feeds.search(words))
+        } else {
+            feedsFor(which, herFeeds)
+        }
+        if (feeds.isEmpty()) {
+            show(View.Nothing("none of your feeds are of that kind now"))
+            return Did("none of your feeds are of that kind now, so nothing was read")
+        }
+        val byFeed = feeds.map { feed ->
+            when (val read = sources.feed(feed)) {
+                is Feeds.Read.Items -> read.items.map { it.copy(source = it.source?.takeIf { s -> s.isNotBlank() } ?: feed.name) }
+                else -> emptyList()
+            }
+        }
+        val items = interleave(byFeed).take(limits.headlines)
+        val title = when (which) {
+            OutingKind.News.TOP -> "your feeds"
+            OutingKind.News.JAPAN -> "your feeds · japan"
+            OutingKind.News.WORLD -> "your feeds · world"
+            OutingKind.News.TOPIC -> "google news · \"${topic.orEmpty()}\""
+        }
+        if (items.isEmpty()) {
+            show(View.Nothing("the feeds could not be read just now"))
+            return Did("the feeds could not be read just now")
+        }
+        show(View.Headlines(title, items))
+        return Did("read the headlines of ${feeds.size} feed${if (feeds.size == 1) "" else "s"}: ${items.size} headlines")
+    }
+
+    private suspend fun open(n: Int): Did {
+        if (pagesLeft <= 0) return Did("no pages are left on this outing, so nothing was opened")
+        return when (val now = view) {
+            is View.Hits -> {
+                // Kid protection, before anything is fetched: a result marked as a kid's is not opened.
+                now.kids[n]?.let { return Did(KidGuard.skipped(it), kidSkipped = it) }
+                // A web result opens by the fetch rules, as a link from a page does.
+                now.web.getOrNull(n - 1 - now.hits.size)?.takeIf { n > now.hits.size }?.let { return openUrl(it.url, typed = false) }
+                val hit = now.hits.getOrNull(n - 1) ?: return Did("there is no [$n] in front of you")
+                pagesLeft--
+                when (val result = sources.article(hit.title, hit.lang)) {
+                    is Wikipedia.Result.Found -> {
+                        val article = result.value
+                        val kid = KidGuard.flag(article.title, article.parts.firstOrNull().orEmpty().take(LEDE_CHARS), clock())
+                        go(
+                            View.Page(
+                                article.site, article.title, article.url, article.parts, 0, emptyList(), emptyList(),
+                                kid = kid, pictures = picturesOf(listOf(article.image), ofItems = false)
+                            )
+                        )
+                        Did("opened ${article.site} \"${article.title}\", part 1 of ${article.parts.size.coerceAtLeast(1)}", opened = article.title to article.site)
+                    }
+                    Wikipedia.Result.Empty -> Did("that wikipedia page has no text the app could read")
+                    is Wikipedia.Result.Refused -> Did("that page was not opened: ${whyWords(result.why)}", fetchRefused = result.why)
+                    Wikipedia.Result.Unreadable -> Did("that page came back in a form the app could not read")
+                }
+            }
+            is View.Headlines -> {
+                val item = now.items.getOrNull(n - 1) ?: return Did("there is no [$n] in front of you")
+                now.kids[n]?.let { return Did(KidGuard.skipped(it), kidSkipped = it) }
+                val url = item.opensAt ?: return Did("that headline has no link that opens: only the headline can be read")
+                openUrl(url, typed = false)
+            }
+            is View.Page -> {
+                val link = now.links.take(MAX_LINKS_SHOWN).getOrNull(n - 1) ?: return Did("there is no link [$n] on this page")
+                openUrl(link.url, typed = false)
+            }
+            is View.Nothing -> Did("there is nothing in front of you to open")
+        }
+    }
+
+    /**
+     * Opens [url]: a link she wrote herself ([typed]) is held against everything the guard
+     * looks for, a link from a page or a feed only against what is his.
+     */
+    private suspend fun openUrl(url: String, typed: Boolean): Did {
+        if (!url.trim().startsWith("https://", ignoreCase = true)) return Did("the app opens only https links", fetchRefused = HerFetcher.Why.NOT_HTTPS)
+        refused(OutgoingGuard.checkUrl(url, his, typed))?.let { return it }
+        if (pagesLeft <= 0) return Did("no pages are left on this outing, so nothing was opened")
+        pagesLeft--
+        return when (val fetched = sources.fetch(url)) {
+            is HerFetcher.Fetched.Refused -> Did("that page was not opened: ${whyWords(fetched.why)}", fetchRefused = fetched.why)
+            is HerFetcher.Fetched.Page -> {
+                val text = fetched.text()
+                val site = fetched.host.removePrefix("www.")
+                val asFeed = if (fetched.contentType.contains("xml", ignoreCase = true)) Feeds.parse(text) else null
+                if (asFeed != null) {
+                    go(View.Headlines(site, asFeed.take(limits.headlines)))
+                    Did("opened the feed of $site: ${asFeed.size.coerceAtMost(limits.headlines)} headlines", opened = site to site)
+                } else {
+                    val page = Readable.page(text, fetched.finalUrl)
+                    val parts = Readable.parts(page.text)
+                    val kid = KidGuard.flag(page.title + " · " + site, parts.firstOrNull().orEmpty().take(LEDE_CHARS), clock())
+                    go(View.Page(site, page.title, fetched.finalUrl, parts, 0, page.links, page.feeds, fetched.truncated, kid, picturesOf(listOf(page.image), ofItems = false)))
+                    Did("opened $site \"${page.title.ifBlank { "(no title)" }}\", part 1 of ${parts.size.coerceAtLeast(1)}", opened = page.title.ifBlank { site } to site)
+                }
+            }
+        }
+    }
+
+    private fun more(): Did {
+        val now = view as? View.Page ?: return Did("you are not on a page, so there is no next part")
+        if (now.part + 1 >= now.parts.size) return Did("that was the last part of the page")
+        view = now.copy(part = now.part + 1)
+        return Did("went on to part ${now.part + 2} of ${now.parts.size} of \"${now.title}\"")
+    }
+
+    private fun back(): Did {
+        val previous = behind.removeLastOrNull() ?: return Did("there is nothing to go back to")
+        view = previous
+        return Did("went back to the list you came from")
+    }
+
+    private fun follow(n: Int?): Did {
+        if (n != null) return Did("there are no accounts to follow here")
+        val page = view as? View.Page ?: return Did("you are not on a site with a feed of its own")
+        // Kid protection, before anything is kept: a kid's site is never followed.
+        page.kid?.let { return Did(KidGuard.skipped(it), kidSkipped = it) }
+        val feed = page.feeds.firstOrNull() ?: return Did("this site has no feed of its own to follow")
+        if (feed.toHttpUrlOrNull()?.isHttps != true) return Did("this site's feed is not on https, so it was not followed")
+        return when (sources.follow(feed, page.site)) {
+            HerFeeds.Followed.ADDED -> Did("${page.site}'s feed is among yours now", followed = true)
+            HerFeeds.Followed.ALREADY -> Did("${page.site}'s feed was among yours already")
+            HerFeeds.Followed.FULL -> Did("you follow ${Feeds.MAX_FOLLOWED} feeds already, the most there can be: it was not added")
+            HerFeeds.Followed.FAILED -> Did("the feed could not be kept just now")
+        }
+    }
+
+    /**
+     * Has the describer look at picture [n] in front of her. Kid protection first, before
+     * anything is fetched or sent: a picture of a page or an item marked as a kid's, or of an
+     * item whose own words mark it so, is not looked at. Then the outgoing guard (the
+     * picture's address is a link from a page: held against what is his), the fetch rules
+     * for pictures, and her eyes. The picture's bytes are zeroed once the describer is done.
+     */
+    private suspend fun look(n: Int): Did {
+        val eyes = eyes?.takeIf { hasEyes } ?: return Did("you have no eyes on this outing, so nothing was looked at")
+        if (looksLeft <= 0) return Did("no looks are left on this outing, so nothing was looked at")
+        val now = view
+        val all = picturesIn(now)
+        val picture = all.getOrNull(n - 1)
+            ?: return Did(if (all.isEmpty()) "there is no picture in front of you to look at" else "there is no picture $n in front of you")
+        if (picture.look != null) return Did("you looked at picture $n already: what came of it is in front of you")
+        kidBefore(now, picture)?.let { flag ->
+            picture.item?.let { item -> view = withKid(now, item, flag) }
+            return Did(KidGuard.skipped(flag), kidSkipped = flag)
+        }
+        refused(OutgoingGuard.checkUrl(picture.url, his, typed = false))?.let { return it }
+        val fetched = when (val got = sources.image(picture.url)) {
+            is HerFetcher.Fetched.Refused -> return Did("picture $n was not fetched: ${pictureWhyWords(got.why)}", fetchRefused = got.why)
+            is HerFetcher.Fetched.Page -> got
+        }
+        val source = if (now is View.Page) Describe.Source.PAGE_IMAGE else Describe.Source.FEED_IMAGE
+        val seen = try {
+            eyes.describe(fetched.bytes, source)
+        } finally {
+            fetched.bytes.fill(0)
+        }
+        // The view may have moved on only through her own verbs, one at a time: it is still [now].
+        return when (seen) {
+            is HerEyes.Seen.NotSeen -> {
+                if (seen.why.sent) looksLeft--
+                Did("picture $n was not described: ${seen.why.words}", looked = seen.why.sent, notSeen = seen.why)
+            }
+            is HerEyes.Seen.Described -> {
+                looksLeft--
+                val flag = KidGuard.flagOfPicture(seen.words, seen.ages, clock())
+                when {
+                    flag != null && picture.item != null -> {
+                        view = withKid(withLook(now, n, Look.Words("", flag)), picture.item, flag)
+                        Did("looked at picture $n: the describer saw a kid, so the app marks [${picture.item}] kid and does not show it", looked = true, kidSeen = flag)
+                    }
+                    flag != null -> {
+                        // The describer's words about a kid are withheld: only the mark and why are shown.
+                        val marked = withLook(now, n, Look.Words("", flag))
+                        view = (marked as? View.Page)?.let { it.copy(kid = it.kid ?: flag) } ?: marked
+                        Did("looked at picture $n: the app marks it kid, so it does not show you the describer's words", looked = true, kidSeen = flag)
+                    }
+                    seen.ages is KidGuard.Ages.Unchecked -> {
+                        view = withLook(now, n, Look.Unchecked)
+                        Did("looked at picture $n, but ${KidGuard.NO_AGES}, so the app does not show its words", looked = true, unchecked = true)
+                    }
+                    else -> {
+                        view = withLook(now, n, Look.Words(seen.words, null, seen.cutOff))
+                        Did("looked at picture $n: what the describer wrote is in front of you", looked = true)
+                    }
+                }
+            }
+        }
+    }
+
+    /** Why [picture], in front of her in [now], is a kid's before it is looked at, or null. */
+    private fun kidBefore(now: View, picture: Picture): KidGuard.Flag? = when (now) {
+        is View.Page -> now.kid
+        is View.Hits -> picture.item?.let { item ->
+            now.kids[item] ?: now.hits.getOrNull(item - 1)?.let { hit -> KidGuard.flag(hit.title, hit.description + " " + hit.excerpt, clock()) }
+        }
+        is View.Headlines -> picture.item?.let { item ->
+            now.kids[item] ?: now.items.getOrNull(item - 1)?.let { headline -> KidGuard.flag(headline.title, headline.summary.take(LEDE_CHARS), clock()) }
+        }
+        is View.Nothing -> null
+    }
+
+    // ── Helpers ──────────────────────────────────────────────────────────────────────
+
+    private fun refused(refusal: OutgoingGuard.Refusal?): Did? {
+        refusal ?: return null
+        guardRefusals++
+        return Did(OutgoingGuard.TOLD, refusal = refusal)
+    }
+
+    /** Something new in front of her, with the way back to what was there. */
+    private fun go(next: View) {
+        if (view !is View.Nothing) behind.addLast(view)
+        while (behind.size > MAX_BEHIND) behind.removeFirst()
+        view = next
+    }
+
+    /** A list in front of her in the place of what was there: the first look, or a search. */
+    private fun show(next: View) = go(next)
+
+    companion object {
+        /** Searches per outing. */
+        const val MAX_SEARCHES = 2
+
+        /** The most pictures numbered in front of her in one view. */
+        const val MAX_PICTURES = 20
+
+        /**
+         * The pictures of a list ([ofItems]: each belongs to the item at its place, numbered
+         * from one) or of a page, from their addresses in order. Only https addresses count.
+         */
+        fun picturesOf(urls: List<String?>, ofItems: Boolean = true): List<Picture> =
+            urls.mapIndexedNotNull { index, url ->
+                url?.trim()?.takeIf { it.startsWith("https://", ignoreCase = true) }?.let { Picture(it, if (ofItems) index + 1 else null) }
+            }.take(MAX_PICTURES)
+
+        /** The pictures in front of her in [view]. */
+        fun picturesIn(view: View): List<Picture> = when (view) {
+            is View.Page -> view.pictures
+            is View.Hits -> view.pictures
+            is View.Headlines -> view.pictures
+            is View.Nothing -> emptyList()
+        }
+
+        /** [view] with picture [n] looked at, as [look]. */
+        internal fun withLook(view: View, n: Int, look: Look): View {
+            fun List<Picture>.marked() = mapIndexed { index, picture -> if (index == n - 1) picture.copy(look = look) else picture }
+            return when (view) {
+                is View.Page -> view.copy(pictures = view.pictures.marked())
+                is View.Hits -> view.copy(pictures = view.pictures.marked())
+                is View.Headlines -> view.copy(pictures = view.pictures.marked())
+                is View.Nothing -> view
+            }
+        }
+
+        /** [view] with its item [item] marked as a kid's. */
+        internal fun withKid(view: View, item: Int, flag: KidGuard.Flag): View = when (view) {
+            is View.Hits -> view.copy(kids = view.kids + (item to (view.kids[item] ?: flag)))
+            is View.Headlines -> view.copy(kids = view.kids + (item to (view.kids[item] ?: flag)))
+            else -> view
+        }
+
+        /** Why a picture was not fetched, in her words. */
+        fun pictureWhyWords(why: HerFetcher.Why): String = when (why) {
+            HerFetcher.Why.WRONG_TYPE -> "it is not a picture the app takes"
+            HerFetcher.Why.TOO_LARGE -> "it is larger than the app takes"
+            else -> whyWords(why)
+        }
+
+        /** Pages per outing. */
+        const val MAX_PAGES = 4
+
+        /** Headlines in one list. */
+        const val MAX_HEADLINES = 20
+
+        /** Links she is shown on a page, and can open by their number. */
+        const val MAX_LINKS_SHOWN = 15
+
+        /** How much of a page's opening the kid check reads beside its title and site. */
+        const val LEDE_CHARS = 400
+
+        private const val MAX_BEHIND = 8
+
+        /** Why the fetch rules did not fetch something, in her words. */
+        fun whyWords(why: HerFetcher.Why): String = when (why) {
+            HerFetcher.Why.BAD_URL -> "that is not a link the app can read"
+            HerFetcher.Why.NOT_HTTPS -> "the app opens only https links"
+            HerFetcher.Why.IP_LITERAL, HerFetcher.Why.LOCAL_NAME, HerFetcher.Why.PRIVATE_ADDRESS ->
+                "the app does not open addresses inside a home or a phone network"
+            HerFetcher.Why.NO_ADDRESS, HerFetcher.Why.NETWORK -> "the site could not be reached"
+            HerFetcher.Why.ROBOTS -> "the site asks readers like this one to stay off that page"
+            HerFetcher.Why.TOO_MANY_REDIRECTS -> "the link sent the app on too many times"
+            HerFetcher.Why.WRONG_TYPE -> "it is not a page of text"
+            HerFetcher.Why.TIMEOUT -> "the site took too long"
+            HerFetcher.Why.HTTP_ERROR -> "the site answered with an error"
+            HerFetcher.Why.TOO_LARGE -> "it is larger than the app takes"
+        }
+
+        /** Her feeds for [which] news, from [hers]. */
+        fun feedsFor(which: OutingKind.News, hers: List<Feeds.Feed>): List<Feeds.Feed> = when (which) {
+            OutingKind.News.TOP, OutingKind.News.TOPIC -> hers
+            OutingKind.News.JAPAN -> hers.filter { it.id in JAPAN_FEEDS }
+            OutingKind.News.WORLD -> hers.filter { it.id == Feeds.GOOGLE_NEWS_WORLD.id }
+        }
+
+        private val JAPAN_FEEDS = setOf(Feeds.GOOGLE_NEWS_JAPAN.id, Feeds.YAHOO_TOP.id, Feeds.YAHOO_ENTERTAINMENT.id)
+
+        /** One headline from each feed in turn, the same title once. */
+        internal fun interleave(byFeed: List<List<Feeds.Item>>): List<Feeds.Item> {
+            val out = ArrayList<Feeds.Item>()
+            val seen = HashSet<String>()
+            var index = 0
+            while (byFeed.any { it.size > index }) {
+                for (list in byFeed) {
+                    val item = list.getOrNull(index) ?: continue
+                    if (seen.add(item.title.lowercase())) out += item
+                }
+                index++
+            }
+            return out
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/reading/VeniceSearch.kt b/app/src/main/java/com/opendroid/ai/core/life/reading/VeniceSearch.kt
new file mode 100644
index 0000000..ecdd19e
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/life/reading/VeniceSearch.kt
@@ -0,0 +1,195 @@
+package com.opendroid.ai.core.life.reading
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.llm.providers.cancellable
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.PersonaSearch
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.SettingsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import okhttp3.CookieJar
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.io.IOException
+import java.net.ConnectException
+import java.net.UnknownHostException
+import java.util.concurrent.TimeUnit
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Venice web search for her outings (OWN_LIFE_PLAN phase 2), only where he switched it on
+ * ([LLMConfig.personaSearch] VENICE): a `search` of hers, and the look-up of a `go: read`,
+ * then go to Venice's search as well as to Wikipedia, at $0.01 each.
+ *
+ * - What goes out is her search words and nothing else ([body]): the words have passed
+ *   [com.opendroid.ai.core.life.OutgoingGuard] first, in her reading space. It is not end to
+ *   end encrypted: Venice and its search provider see the words.
+ * - The request is Venice's documented one (docs.venice.ai, `POST /api/v1/augment/search`,
+ *   read 2026-11-18): `query`, `limit` and `search_provider` "brave", Brave with zero data
+ *   retention. Venice calls the endpoint experimental, so its answer is read leniently and
+ *   anything unexpected comes back as unreadable, never as results.
+ * - The key is her eyes' ([HerEyes.keyFor]): her own-time key where he set one, else his
+ *   Venice provider's. It goes to api.venice.ai only, with no cache, no cookie jar and no
+ *   redirect followed.
+ * - Each request that leaves the phone is counted in her ledger as [OwnPurpose.PAID_SEARCH]
+ *   at this call site, whatever came of it. One that never reached Venice is not.
+ * - A result keeps its title, its https address, a short snippet and its date: other
+ *   people's words, shown to her fenced like any list, and opened only by the fetch rules.
+ */
+@Singleton
+class VeniceSearch internal constructor(
+    base: OkHttpClient,
+    private val settings: suspend () -> LLMConfig,
+    private val ledger: OwnLedger,
+    private val url: String = URL
+) {
+    @Inject
+    constructor(client: OkHttpClient, settings: SettingsRepository, ledger: OwnLedger) : this(
+        base = client,
+        settings = { settings.llmConfig.first() },
+        ledger = ledger
+    )
+
+    /** One result: other people's words, and where it opens. */
+    data class Hit(val title: String, val url: String, val snippet: String, val date: String = "") {
+        /** The site it is on, for her list and her log. */
+        val site: String get() = url.toHttpUrlOrNull()?.host?.removePrefix("www.").orEmpty()
+    }
+
+    /** What a search came to. */
+    sealed class Result {
+        data class Found(val hits: List<Hit>) : Result()
+        data object Empty : Result()
+
+        /** Nothing came back that can be shown; [why] in words for her, [sent] when it left the phone. */
+        data class Failed(val why: String, val sent: Boolean) : Result()
+
+        /** Not switched on, or not possible as things are set: nothing was sent. */
+        data object Off : Result()
+    }
+
+    private val client: OkHttpClient = base.newBuilder()
+        .cache(null)
+        .cookieJar(CookieJar.NO_COOKIES)
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .callTimeout(TIMEOUT_SECONDS, TimeUnit.SECONDS)
+        .build()
+
+    /** Her search words searched on Venice, where [on] lets it. */
+    suspend fun search(words: String): Result {
+        val config = settings()
+        if (!on(config)) return Result.Off
+        val key = HerEyes.keyFor(config) ?: return Result.Off
+        val query = words.trim().take(MAX_QUERY_CHARS)
+        if (query.isEmpty()) return Result.Empty
+        val request = Request.Builder()
+            .url(url)
+            .header("Authorization", "Bearer $key")
+            .header("Accept", "application/json")
+            .post(body(query).toRequestBody(JSON_TYPE))
+            .build()
+        val answer = try {
+            withContext(Dispatchers.IO) {
+                client.cancellable(request) { response ->
+                    (if (response.isSuccessful) response.body.string().take(MAX_ANSWER_CHARS) else null) to response.code
+                }
+            }
+        } catch (e: CancellationException) {
+            ledger.count(OwnPurpose.PAID_SEARCH)
+            throw e
+        } catch (e: UnknownHostException) {
+            return Result.Failed("venice could not be reached", sent = false)
+        } catch (e: ConnectException) {
+            return Result.Failed("venice could not be reached", sent = false)
+        } catch (e: javax.net.ssl.SSLHandshakeException) {
+            return Result.Failed("venice could not be reached", sent = false)
+        } catch (e: IOException) {
+            ledger.count(OwnPurpose.PAID_SEARCH)
+            return Result.Failed("the search to venice broke off", sent = true)
+        }
+        ledger.count(OwnPurpose.PAID_SEARCH)
+        val (json, code) = answer
+        if (json == null) return Result.Failed(statusWords(code), sent = true)
+        val hits = parse(json) ?: return Result.Failed("venice's answer could not be read", sent = true)
+        return if (hits.isEmpty()) Result.Empty else Result.Found(hits)
+    }
+
+    companion object {
+        /** Venice's web search, as its API reference gives it. */
+        const val URL = "https://api.venice.ai/api/v1/augment/search"
+
+        /** Brave, with zero data retention: Venice's default, named so that it does not change under her. */
+        const val PROVIDER = "brave"
+
+        /** The results asked for: a list as long as a Wikipedia search's. */
+        const val LIMIT = 8
+
+        /** Venice takes at most 400 characters of query. */
+        const val MAX_QUERY_CHARS = 400
+        const val MAX_TITLE_CHARS = 200
+        const val MAX_SNIPPET_CHARS = 300
+        private const val MAX_ANSWER_CHARS = 200_000
+        private const val TIMEOUT_SECONDS = 20L
+        private val JSON_TYPE = "application/json".toMediaType()
+
+        /** Whether a search may go to Venice as [config] stands: his switch, his privacy setting, and a key. */
+        fun on(config: LLMConfig): Boolean =
+            config.personaSearch == PersonaSearch.VENICE &&
+                config.routePolicy != RoutePolicy.OWN_HARDWARE &&
+                HerEyes.keyFor(config) != null
+
+        /** The request: her words, how many results, and the provider. Nothing else. */
+        fun body(query: String): String = buildJsonObject {
+            put("query", query)
+            put("limit", LIMIT)
+            put("search_provider", PROVIDER)
+        }.toString()
+
+        private fun JsonElement?.obj(): JsonObject? = this?.takeIf { it.isJsonObject }?.asJsonObject
+
+        private fun JsonObject.text(key: String): String =
+            get(key)?.takeIf { it.isJsonPrimitive && it.asJsonPrimitive.isString }?.asString?.trim().orEmpty()
+
+        /** Venice's results, https ones only, cut to size; null when [json] is not such an answer. */
+        fun parse(json: String): List<Hit>? {
+            val root = try {
+                JsonParser.parseString(json).obj()
+            } catch (e: Exception) {
+                null
+            } ?: return null
+            val results = root.get("results")?.takeIf { it.isJsonArray }?.asJsonArray ?: return null
+            return results.mapNotNull { element ->
+                val result = element.obj() ?: return@mapNotNull null
+                val address = result.text("url")
+                if (address.toHttpUrlOrNull()?.isHttps != true) return@mapNotNull null
+                val title = oneLine(result.text("title")).take(MAX_TITLE_CHARS)
+                if (title.isEmpty()) return@mapNotNull null
+                Hit(title, address, oneLine(result.text("content")).take(MAX_SNIPPET_CHARS), oneLine(result.text("date")).take(40))
+            }.distinctBy { it.url }.take(LIMIT)
+        }
+
+        private fun oneLine(text: String): String = text.replace(Regex("""\s+"""), " ").trim()
+
+        private fun statusWords(code: Int): String = when (code) {
+            401, 403 -> "venice did not take the key"
+            402 -> "the venice balance is too low"
+            429 -> "venice was busy"
+            else -> "venice answered with an error"
+        }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/life/reading/Wikipedia.kt b/app/src/main/java/com/opendroid/ai/core/life/reading/Wikipedia.kt
