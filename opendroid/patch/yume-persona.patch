+package com.opendroid.ai.core.persona
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import kotlin.math.pow
+
+/**
+ * How she feels, carried from one call of hers to the next instead of starting again
+ * with every message.
+ *
+ * A feeling is only ever set by her: a feel line she writes in a moment of her own, in
+ * her notebook pass or in her sleep, all of them calls of her one model that run
+ * anyway. The app reads nothing into her words and gives them no score. What it does
+ * is the one thing a clock can do: each feeling fades at the pace she gave it, fast
+ * ones (anger) within hours, slow ones (fondness) over weeks, unless she feels it again.
+ * Her prompt says how strong each one is now, in words.
+ *
+ * Everything here is a decision about text and time. They are stored beside her notes,
+ * in a row of their own; no log line and no copy of her notebook carries them.
+ */
+object PersonaMood {
+
+    private const val HOUR = 60 * 60_000L
+    private const val DAY = 24 * HOUR
+
+    /** How fast a feeling fades: the time in which it halves, and how her prompt says it. */
+    enum class Speed(val label: String, val halfLifeMillis: Long, val fades: String) {
+        HOURS("hours", 4 * HOUR, "fades within hours"),
+        DAYS("days", 2 * DAY, "fades over days"),
+        WEEKS("weeks", 14 * DAY, "fades over weeks")
+    }
+
+    const val FAINT = 1
+    const val SOME = 2
+    const val STRONG = 3
+
+    private val STRENGTHS = mapOf("faint" to FAINT, "some" to SOME, "strong" to STRONG)
+
+    /** One feeling as it is kept: her words for it, how strong it was when she set it, when, and how fast it fades. */
+    data class Feeling(val words: String, val strength: Int, val atMillis: Long, val speed: Speed)
+
+    /** One feel line as she wrote it: a feeling she sets, or one she lets go ([gone]). */
+    data class Felt(val words: String, val strength: Int = SOME, val speed: Speed = Speed.DAYS, val gone: Boolean = false)
+
+    /** How long her words for a feeling may be. */
+    const val MAX_WORDS_CHARS = 40
+
+    /** How many feelings are kept at once: the strongest now. */
+    const val MAX_KEPT = 8
+
+    /** How many feel lines one notebook pass or one moment of hers takes. */
+    const val PASS_LINES = 3
+
+    /** How many one sleep takes. */
+    const val SLEEP_LINES = 8
+
+    /** From these levels on a feeling is strong, some or faint now. Below the last it is gone. */
+    const val STRONG_FROM = 7.0
+    const val SOME_FROM = 4.0
+    const val FAINT_FROM = 1.5
+
+    /** How strong [feeling] is at [nowMillis]: three times its strength when she set it, halved every half-life since. */
+    fun level(feeling: Feeling, nowMillis: Long): Double {
+        val age = (nowMillis - feeling.atMillis).coerceAtLeast(0)
+        return 3.0 * feeling.strength * 0.5.pow(age.toDouble() / feeling.speed.halfLifeMillis)
+    }
+
+    /** A level in the word her prompt uses, or null when the feeling is gone. */
+    fun word(level: Double): String? = when {
+        level >= STRONG_FROM -> "strong"
+        level >= SOME_FROM -> "some"
+        level >= FAINT_FROM -> "faint"
+        else -> null
+    }
+
+    /** How strong she said a feeling was when she set it. */
+    fun strengthWord(strength: Int): String = STRENGTHS.entries.firstOrNull { it.value == strength }?.key ?: "some"
+
+    private val MARK = Regex("""^feel\s*[|:]\s*""", RegexOption.IGNORE_CASE)
+    private val CONTROL = Regex("""[\u0000-\u001F\u007F]""")
+    private val SPACES = Regex("""\s+""")
+
+    private fun speedOf(word: String): Speed? = when (word) {
+        "hours", "hour" -> Speed.HOURS
+        "days", "day" -> Speed.DAYS
+        "weeks", "week" -> Speed.WEEKS
+        else -> null
+    }
+
+    /** [raw] as the words of a feeling: on one line, in lower case, 1 to [MAX_WORDS_CHARS] characters. Null when it cannot be one. */
+    private fun words(raw: String): String? {
+        val text = SPACES.replace(raw, " ").trim().trimEnd('.').trim().lowercase()
+        if (text.isEmpty() || text.length > MAX_WORDS_CHARS) return null
+        if (text.contains("===") || text.contains('|') || CONTROL.containsMatchIn(text)) return null
+        return text.takeIf { words -> words.any { it.isLetterOrDigit() } }
+    }
+
+    /**
+     * What stands after the mark of a feel line: `words | strength | speed`, the two last
+     * in either order and each one optional (some, and days, when left out), or
+     * `words | gone`. Null when it does not have that form.
+     */
+    fun fields(rest: String): Felt? {
+        val parts = rest.split("|").map { it.trim().trimEnd('.').trim().lowercase() }
+        if (parts.size > 3) return null
+        val words = words(parts[0]) ?: return null
+        if (parts.size == 2 && parts[1] == "gone") return Felt(words, gone = true)
+        var strength: Int? = null
+        var speed: Speed? = null
+        for (part in parts.drop(1)) {
+            val asStrength = STRENGTHS[part]
+            val asSpeed = speedOf(part)
+            when {
+                asStrength != null && strength == null -> strength = asStrength
+                asSpeed != null && speed == null -> speed = asSpeed
+                else -> return null
+            }
+        }
+        return Felt(words, strength ?: SOME, speed ?: Speed.DAYS)
+    }
+
+    /** One line read as a feel line (`feel | ...` or `feel: ...`), or null when it is none or does not have the form. */
+    fun parse(line: String): Felt? {
+        val bare = line.trim().removePrefix("-").removePrefix("*").trim()
+        val mark = MARK.find(bare) ?: return null
+        return fields(bare.substring(mark.range.last + 1))
+    }
+
+    /**
+     * What came of reading a block of lines for feelings: the feel lines that were
+     * taken, in order, and [rest], every other line as it was written.
+     */
+    class Reading(val felt: List<Felt>, val rest: String)
+
+    /**
+     * Reads the feel lines of [text], at most [limit] of them. A line past the limit, a
+     * feel line that does not have the form, and, when [cutOff] says the text ran into
+     * the length limit, its last line, are not taken: they stay in [Reading.rest], where
+     * the notebook does not take them either and she is told.
+     */
+    fun read(text: String, limit: Int, cutOff: Boolean = false): Reading {
+        val lines = text.lines()
+        val last = lines.indexOfLast { it.isNotBlank() }
+        val felt = ArrayList<Felt>()
+        val rest = ArrayList<String>()
+        lines.forEachIndexed { index, line ->
+            val read = if (cutOff && index == last) null else parse(line)
+            if (read != null && felt.size < limit) felt += read else rest += line
+        }
+        return Reading(felt, rest.joinToString("\n"))
+    }
+
+    /** [text] without the feel lines [read] takes from it. */
+    fun withoutFeelings(text: String, limit: Int = PASS_LINES, cutOff: Boolean = false): String = read(text, limit, cutOff).rest
+
+    /**
+     * [current] with [felt] laid over it at [nowMillis]: the same words replace the old
+     * feeling with a new time, `gone` takes it away, and what has faded below faint by
+     * now is dropped. At most [MAX_KEPT] are kept, the strongest now.
+     */
+    fun merge(current: List<Feeling>, felt: List<Felt>, nowMillis: Long): List<Feeling> {
+        val byWords = LinkedHashMap<String, Feeling>()
+        current.forEach { byWords[it.words] = it }
+        for (change in felt) {
+            byWords.remove(change.words)
+            if (!change.gone) byWords[change.words] = Feeling(change.words, change.strength.coerceIn(FAINT, STRONG), nowMillis, change.speed)
+        }
+        return byWords.values
+            .filter { word(level(it, nowMillis)) != null }
+            .sortedWith(compareByDescending<Feeling> { level(it, nowMillis) }.thenByDescending { it.atMillis })
+            .take(MAX_KEPT)
+    }
+
+    /** The test a feeling is held back by where a host could read the prompt: one that can be about him. */
+    fun aboutHim(ownerName: String): (Feeling) -> Boolean = { feeling ->
+        PersonaNotes.canBeAboutHim(PersonaNotes.Note(PersonaNotes.Kind.ME, "feeling", feeling.words), ownerName)
+    }
+
+    /** What a page shows of her feelings: one line for each that is still felt, and how many were held back. */
+    class Shown(val lines: List<String>, val heldBack: Int)
+
+    /**
+     * Her feelings at [nowMillis], strongest first, one line each: her words, how strong
+     * she set it and how long ago, how strong it is now, and how fast it fades. Strength
+     * is said in words. A feeling [leaveOut] covers is counted, not shown.
+     */
+    fun shown(feelings: List<Feeling>, nowMillis: Long, leaveOut: ((Feeling) -> Boolean)? = null): Shown {
+        val felt = feelings.map { it to word(level(it, nowMillis)) }.filter { it.second != null }
+            .sortedByDescending { level(it.first, nowMillis) }
+        val held = felt.count { leaveOut?.invoke(it.first) == true }
+        val lines = felt.filter { leaveOut?.invoke(it.first) != true }.map { (feeling, now) ->
+            "- " + feeling.words.replace("===", "= = =") + ": " + strengthWord(feeling.strength) + " " +
+                PersonaPrompts.age(nowMillis - feeling.atMillis) + ", " + now + " now (" + feeling.speed.fades + ")"
+        }
+        return Shown(lines, held)
+    }
+
+    /** Opens the block of her feelings in her prompt. */
+    const val HEADING =
+        "=== HOW YOU FEEL (carried over from before, from your own feel lines. each fades at its own pace unless you feel it again. how it shows, if it shows, is yours) ==="
+
+    /** Ends that block: where she sets them. */
+    const val WHERE_SET = "you set them with a feel line in a moment of your own, your notebook pass or your sleep."
+
+    /** The line that says how many were held back, or null when none were. */
+    fun heldBackLine(count: Int): String? = when {
+        count <= 0 -> null
+        count == 1 -> "(1 more is not shown: it can be about him, and this goes through a hosted service that can read what it is sent. it is still on the phone.)"
+        else -> "($count more are not shown: they can be about him, and this goes through a hosted service that can read what it is sent. they are still on the phone.)"
+    }
+
+    /** The block of her prompt, or empty when she feels nothing that is kept. */
+    fun block(feelings: List<Feeling>, nowMillis: Long, leaveOut: ((Feeling) -> Boolean)? = null): String {
+        val shown = shown(feelings, nowMillis, leaveOut)
+        if (shown.lines.isEmpty() && shown.heldBack == 0) return ""
+        return (listOf(HEADING) + shown.lines + listOfNotNull(heldBackLine(shown.heldBack)) + WHERE_SET).joinToString("\n")
+    }
+
+    /** The lines of a page that is not her chat prompt (her notebook pass, her sleep): the feelings and the held-back line. */
+    fun pageLines(feelings: List<Feeling>, nowMillis: Long, leaveOut: ((Feeling) -> Boolean)? = null): List<String> {
+        val shown = shown(feelings, nowMillis, leaveOut)
+        return shown.lines + listOfNotNull(heldBackLine(shown.heldBack))
+    }
+
+    @Serializable
+    private data class Entry(val w: String, val s: Int, val a: Long, val v: String)
+
+    private val JSON = Json { ignoreUnknownKeys = true }
+
+    /** [feelings] as the one line of text that is stored. */
+    fun encode(feelings: List<Feeling>): String =
+        JSON.encodeToString(ListSerializer(Entry.serializer()), feelings.map { Entry(it.words, it.strength, it.atMillis, it.speed.name) })
+
+    /** The feelings a stored line stands for. A line that is missing or cannot be read is none. */
+    fun decode(stored: String?): List<Feeling> {
+        if (stored.isNullOrBlank()) return emptyList()
+        val entries = try {
+            JSON.decodeFromString(ListSerializer(Entry.serializer()), stored)
+        } catch (e: Exception) {
+            return emptyList()
+        }
+        return entries.mapNotNull { entry ->
+            val speed = Speed.entries.firstOrNull { it.name == entry.v } ?: return@mapNotNull null
+            val words = words(entry.w) ?: return@mapNotNull null
+            Feeling(words, entry.s.coerceIn(FAINT, STRONG), entry.a, speed)
+        }
+    }
+}
