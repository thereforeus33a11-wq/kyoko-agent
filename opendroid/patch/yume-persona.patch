+        assertTrue(block.contains(" every line to him needs its own say: in front, and a line without it stays in your head. "))
+        assertTrue(block.contains("three lines to him look like this (the form, not the words):\n    say: oi\n    say: guess what\n    say: no, you guess\n"))
+        val example = PersonaOwnTime.parse(PersonaOwnTime.SAY_EXAMPLE.joinToString("\n"))
+        assertEquals("oi\nguess what\nno, you guess", example.said)
+        assertEquals("", example.thoughts)
+        // The parser stays strict: the line under a say: line without its own mark is hers alone.
+        val strict = PersonaOwnTime.parse("say: oi\nguess what")
+        assertEquals("oi", strict.said)
+        assertEquals("guess what", strict.thoughts)
+        // The lower case of the rest of her own text, and no stage direction.
+        assertFalse(block.contains("*"))
