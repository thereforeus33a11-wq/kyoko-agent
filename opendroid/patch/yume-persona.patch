+package com.opendroid.ai.core.life
+
+import com.opendroid.ai.core.life.eyes.CameraLook
+import com.opendroid.ai.core.life.eyes.Describe
+import com.opendroid.ai.core.life.eyes.Eyes
+import com.opendroid.ai.core.life.eyes.FoldState
+import com.opendroid.ai.core.life.eyes.HerEyes
+import com.opendroid.ai.core.life.eyes.HerLooks
+import com.opendroid.ai.core.life.eyes.Shot
+import com.opendroid.ai.core.life.eyes.Shutter
+import com.opendroid.ai.core.life.reading.Feeds
+import com.opendroid.ai.core.life.reading.Glance
+import com.opendroid.ai.core.life.reading.HerFeeds
+import com.opendroid.ai.core.life.reading.HerFetcher
+import com.opendroid.ai.core.life.reading.ReadingSpace
+import com.opendroid.ai.core.life.reading.Wikipedia
+import com.opendroid.ai.core.persona.TestThoughtsCipher
+import com.opendroid.ai.data.models.CameraWhich
+import com.opendroid.ai.data.models.LLMConfig
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Her camera looks as the host of her outings runs them (OWN_LIFE_PLAN phase 2, §1.1, §1.4),
+ * with her engine, her eyes, the camera and his phone replaced by fakes:
+ *
+ *  - the gate: no look, and no frame taken, with his screen off or locked, during a call or
+ *    his talk, on a low battery, with too few calls or looks left, with another app on a
+ *    camera, or where no camera faces the way she asked as the phone is folded;
+ *  - his talk, Stop, his screen going off and a call call a running look off, and nothing goes
+ *    to the describer after;
+ *  - a frame too dark goes nowhere and costs no call;
+ *  - a frame with a child or a teen in it is withheld from her, and PK-1 and the kept-line
+ *    check run in her moment of looking;
+ *  - I6 and I8: the frame is zeroed, nothing of it is on disk, and the log holds the camera,
+ *    the time and counts, never a description.
+ */
+class OutingHostLookTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val now = AtomicLong(1_800_000_000_000L)
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val ledger by lazy { OwnLedger({ File(folder.root, "persona/own_ledger.json") }, { now.get() }) }
+    private val log by lazy { HerLog({ File(folder.root, "persona/her_log.json") }, { now.get() }) }
+    private val herNow = HerNow()
+    private val life by lazy { OwnLife(ledger, log, herNow, Wonders({ File(folder.root, "persona") }, TestThoughtsCipher())) }
+
+    @After
+    fun tearDown() {
+        scope.cancel()
+    }
+
+    // ── Fakes ────────────────────────────────────────────────────────────────────────
+
+    private inner class Mind : OutingHost.Mind {
+        @Volatile var config = LLMConfig(personaOwnLife = true, personaEyes = true, personaEyesConsentAt = 1L, personaCameraLooks = true)
+        @Volatile var asleepNow = false
+        val replies = ArrayDeque<String>()
+        val texts = CopyOnWriteArrayList<String>()
+        val kids = CopyOnWriteArrayList<Boolean>()
+        val looks = CopyOnWriteArrayList<Boolean>()
+        val backs = CopyOnWriteArrayList<OutingHost.Back>()
+        val missed = CopyOnWriteArrayList<Pair<String, HerLog.NotStarted>>()
+
+        override suspend fun config(): LLMConfig = config
+        override fun lifeOn(config: LLMConfig): Boolean = true
+        override fun thoughtsShown(config: LLMConfig): Boolean = true
+        override suspend fun asleep(): Boolean = asleepNow
+
+        override suspend fun step(outing: String, sayUsed: Boolean, nowMillis: Long, kid: Boolean, look: Boolean): OutingStep.Step? {
+            texts += outing
+            kids += kid
+            looks += look
+            now.addAndGet(20_000L)
+            ledger.record(OwnPurpose.OUTING_STEP, "e2ee-her-model", 14_000, 300, ok = true)
+            val reply = synchronized(replies) { replies.removeFirstOrNull() } ?: return null
+            return OutingStep.parse(reply, sayUsed = sayUsed, kid = kid)
+        }
+
+        override suspend fun cameBack(back: OutingHost.Back, nowMillis: Long) {
+            backs += back
+        }
+
+        override suspend fun missed(words: String, why: HerLog.NotStarted) {
+            missed += words to why
+        }
+    }
+
+    private class Room : OutingHost.Room {
+        val lines = CopyOnWriteArrayList<String>()
+        val looked = CopyOnWriteArrayList<String>()
+        val asked = CopyOnWriteArrayList<String>()
+        override suspend fun ask(kind: HerLog.Kind, maxMinutes: Int, atMillis: Long, camera: String) {
+            asked += camera
+        }
+        override suspend fun said(line: String, atMillis: Long) {
+            lines += line
+        }
+
+        override suspend fun looked(camera: String, atMillis: Long) {
+            looked += camera
+        }
+    }
+
+    /** Her eyes: open or shut, scripted words, and one EYES call in the ledger for each look, as HerEyes writes it. */
+    private inner class FakeEyes : Eyes {
+        @Volatile var isOpen = true
+        val seen = ArrayDeque<HerEyes.Seen>()
+        val described = CopyOnWriteArrayList<Describe.Source>()
+        override fun open(config: LLMConfig, nowMillis: Long) = isOpen
+        override fun leftToday(config: LLMConfig, nowMillis: Long): Int = 60
+        override suspend fun describe(image: ByteArray, source: Describe.Source): HerEyes.Seen {
+            described += source
+            ledger.record(OwnPurpose.EYES, "google-gemma-4-31b-it", 900, 90, ok = true)
+            return synchronized(seen) { seen.removeFirstOrNull() } ?: HerEyes.Seen.Described("A plain room.", KidGuard.Ages.Read(emptySet()))
+        }
+    }
+
+    /** The camera: every frame it was asked for, by lens, and the bytes it gave, to see them zeroed. */
+    private inner class FakeCamera : Shutter {
+        val takes = CopyOnWriteArrayList<FoldState.Lens>()
+        val frames = CopyOnWriteArrayList<ByteArray>()
+        @Volatile var light = CameraLook.Light(mean = 110, spread = 40)
+        @Volatile var whileSettling: () -> Unit = {}
+        override suspend fun take(lens: FoldState.Lens, keepGoing: () -> Boolean): Shot {
+            takes += lens
+            whileSettling()
+            // The camera asks at every frame while it settles.
+            repeat(3) { if (!keepGoing()) return Shot.Failed(Shot.Fail.STOPPED) }
+            val bytes = ByteArray(32) { 7 }
+            frames += bytes
+            return Shot.Taken(bytes, light)
+        }
+    }
+
+    private val ok = CameraLook.Phone(screenOn = true, unlocked = true, inCall = false, cameraInUse = false, batteryPercent = 80, thermalStatus = 0)
+
+    private val mind = Mind()
+    private val room = Room()
+    private val eyes = FakeEyes()
+    private val camera = FakeCamera()
+    @Volatile private var phone = ok
+    @Volatile private var posture = FoldState.Posture.OPEN
+    @Volatile private var near: Boolean? = false
