+    @Test
+    fun `a name typed for his own machine is said to be a name, and an Ollama port on the compatible provider to be one`() {
+        // A name that reads as his: the route is judged his, and the note says on what.
+        for (name in listOf("http://homeserver/v1", "http://desktop.local:8080/v1", "https://pc.lan/v1", "gaming-pc:1234", "http://box.tailnet-abc.ts.net")) {
+            for (provider in listOf("Ollama", custom)) {
+                val note = RouteClassifier.addressNote(provider, name).orEmpty()
+                assertTrue("$provider $name: $note", note.contains("is a name"))
+                assertTrue(note, note.contains("only when it leads to a private address"))
+                assertEquals(name, RoutePrivacy.OWN_NETWORK, RouteClassifier.classify(provider, "some-model", name))
+            }
+        }
+        assertTrue(RouteClassifier.addressNote("Ollama", "http://homeserver:11434").orEmpty().startsWith("\"homeserver\" is a name"))
+        // An address in numbers, this phone, a public host and no address at all say nothing of the kind.
+        for (other in listOf(
+            "http://192.168.1.20:8080/v1", "http://127.0.0.1:8080/v1", "http://localhost:8080/v1", "http://[fd12:3456::1]:8080",
+            "https://api.venice.ai/api/v1", "https://example.com/v1", "", "   ", "not a url at all"
+        )) {
+            for (provider in listOf("Ollama", custom)) {
+                assertFalse("$provider $other", RouteClassifier.addressNote(provider, other).orEmpty().contains("is a name"))
+            }
+        }
+
+        // The compatible provider at an Ollama server's port: the context cannot be asked for there.
+        for (ollama in listOf("http://192.168.1.20:11434/v1", "http://127.0.0.1:11434/v1", "localhost:11434/v1", "http://desktop.local:11434/v1")) {
+            val note = RouteClassifier.addressNote(custom, ollama).orEmpty()
+            assertTrue("$ollama: $note", note.contains("the port of an Ollama server"))
+            assertTrue(note, note.contains("num_ctx"))
+            // The Ollama provider asks for the context itself, and is told nothing of this.
+            assertFalse(ollama, RouteClassifier.addressNote("Ollama", ollama).orEmpty().contains("num_ctx"))
+        }
+        assertEquals(null, RouteClassifier.addressNote(custom, "http://192.168.1.20:8080/v1"))
+        assertEquals(null, RouteClassifier.addressNote(custom, "https://api.venice.ai/api/v1"))
+        // A provider whose address is not his to type has no such field.
+        assertEquals(null, RouteClassifier.addressNote("OpenAI", "http://homeserver:11434/v1"))
+        assertEquals(null, RouteClassifier.addressNote("Copilot API", "http://homeserver:11434/v1"))
+    }
+
+    @Test
+    fun `what the key list says of a key is what is done with it`() {
+        val venice = "https://api.venice.ai/api/v1"
+        val own = "http://192.168.1.20:8080/v1"
+        val untied = LLMConfig(apiKeys = mapOf(custom to "k"), customEndpoints = mapOf(custom to venice))
+        val tied = untied.copy(apiKeyHosts = mapOf(custom to "api.venice.ai"))
+        val moved = tied.copy(customEndpoints = mapOf(custom to own))
+        val unaddressed = tied.copy(customEndpoints = emptyMap())
+
+        // Not tied yet: it does go to the address that is set, and the sentence says so.
+        val untiedNote = untied.keyHostNote(custom).orEmpty()
+        assertTrue(untiedNote, untiedNote.contains("not tied to an address yet"))
+        assertTrue(untiedNote, untiedNote.contains("goes to the address set for $custom"))
+        assertEquals("k", untied.apiKeyFor(custom, venice))
+        assertEquals("k", untied.apiKeyFor(custom, own))
+
+        // Tied, and the provider points there: sent, to that host only.
+        assertEquals("This key is sent to api.venice.ai only.", tied.keyHostNote(custom))
+        assertEquals("k", tied.apiKeyFor(custom, venice))
+
+        // Tied, and the provider points elsewhere or nowhere: not sent, and the host is named.
+        val movedNote = moved.keyHostNote(custom).orEmpty()
+        assertTrue(movedNote, movedNote.startsWith("This key belongs to api.venice.ai and is sent there only."))
+        assertTrue(movedNote, movedNote.contains("nothing sent to that one carries this key"))
+        assertEquals("", moved.apiKeyFor(custom, own))
+        val unaddressedNote = unaddressed.keyHostNote(custom).orEmpty()
+        assertTrue(unaddressedNote, unaddressedNote.contains("has no address set now"))
+        assertEquals("", unaddressed.apiKeyFor(custom, ""))
+
+        // No key, or a provider with a fixed address: nothing to say.
+        assertEquals(null, LLMConfig(customEndpoints = mapOf(custom to venice)).keyHostNote(custom))
+        assertEquals(null, LLMConfig(apiKeys = mapOf("OpenAI" to "k")).keyHostNote("OpenAI"))
+        // The key itself is never part of what is shown.
+        for (note in listOf(untiedNote, movedNote, unaddressedNote)) assertFalse(note, note.contains("\"k\""))
+    }
