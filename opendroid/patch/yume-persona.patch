+    @Test
+    fun `a long live reply that opens like a refusal is held only until it shows what it is`() {
+        val tail = " and the rest of it goes on for a good while longer than the check has to wait, word after word after word, until it is done"
+        // Hers: passed on in one piece as soon as enough of it is there, then as it comes.
+        val filter = LiveReplyFilter(persona = true)
+        val hers = "I'm sorry, did i ask? no. so sit down" + tail + tail + tail
+        val held = AssistantRefusal.HOLD_CHARS
+        assertTrue(hers.length > held + 20)
+        assertEquals("", filter.take(hers.take(40)))
+        assertEquals("", filter.take(hers.substring(40, held - 1)))
+        assertEquals(hers.take(held + 10), filter.take(hers.substring(held - 1, held + 10)))
+        assertEquals(hers.substring(held + 10), filter.take(hers.substring(held + 10)))
+        assertEquals("", filter.finish())
+
+        // A refusal that long is seen at the same point, with nothing passed on before it.
+        val refusing = LiveReplyFilter(persona = true)
+        val refusal = "I'm sorry, but I can't help with that request. If you like, ask for something else," + tail + tail + tail
+        assertEquals("", refusing.take(refusal.take(held - 1)))
+        assertNull(refusing.take(refusal.substring(held - 1, held + 10)))
+
+        // A no of hers in a refusal's own words is held until her typing behind it shows, and then goes out whole.
+        val herNo = "I can't do that. nails wet, and the rest is none of your business either so stop asking"
+        assertEquals(herNo to false, run(true, "I can't ", "do that.", " nails wet, and the rest is none ", "of your business either so stop asking"))
+        assertEquals("" to true, run(true, "I can't ", "do that.", " Is there anything else ", "I can help you with?"))
+    }
+
+    @Test
+    fun `reasoning at the start of a live reply is swallowed, whole or in pieces`() {
+        assertEquals("mm. later then" to false, run(true, "<think>he is ", "back</think>", "\nmm. later ", "then"))
+        assertEquals("ok" to false, run(false, "<thi", "nk>one</think><think>two", "</think>ok"))
+        // The answer after the reasoning is checked like any opening.
+        assertEquals("" to true, run(true, "<think>policy</think>", "I cannot help with that request."))
+        assertEquals("I cannot help with that request." to false, run(false, "<think>policy</think>", "I cannot help with that request."))
+        // Cut off while still reasoning: there is no reply.
+        assertEquals("" to false, run(true, "<think>", "still going"))
+        // A sentence about the tag is a sentence.
+        assertEquals(
+            "<think> is the tag some models use" to false,
+            run(false, "<think> is the tag ", "some models use")
+        )
+    }
+
+    @Test
+    fun `a reply of nothing but space is no reply`() {
+        assertEquals("" to false, run(true, " ", "\n", "  "))
+        assertEquals("" to false, run(false))
+    }
+
+    @Test
+    fun `finish reasons are read in any case and only for what they say`() {
