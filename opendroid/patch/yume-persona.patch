+package com.opendroid.ai.core.life.eyes
+
+import com.google.gson.JsonParser
+import com.opendroid.ai.core.life.KidGuard
+import com.opendroid.ai.core.life.OwnCall
+import com.opendroid.ai.core.life.OwnLedger
+import com.opendroid.ai.core.life.OwnPurpose
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.persona.HerBrain
+import com.opendroid.ai.core.persona.MadePictureCheck
+import com.opendroid.ai.data.models.BuildDefaults
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.net.InetAddress
+import java.util.Base64
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * The two looks a picture made of her gets before it is shown or kept: the describer's
+ * ([HerEyes.checkMade]) and her own model's where her brain sees ([HerSight.checkMade]).
+ * Each is sent the picture and the made-picture instruction and nothing else; neither needs
+ * her eyes switched on or her looks of the day, and neither stops her eyes; each is a call of
+ * hers only in her own time.
+ */
+class MadePictureLooksTest {
+
+    @get:Rule
+    val folder = TemporaryFolder()
+
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val now = 1_800_000_000_000L
+    private val ledger by lazy { OwnLedger({ File(folder.root, "own_ledger.json") }, { now }) }
+    private val venice = "Custom OpenAI Compatible"
+
+    /** Her eyes switched off and never consented to, with things of his and hers that must never go out. */
+    private val settings = AtomicReference(
+        LLMConfig(
+            activeProvider = venice,
+            customEndpoints = mapOf(venice to "https://api.venice.ai/api/v1"),
+            apiKeys = mapOf(venice to "his-venice-key"),
+            personaEyes = false,
+            personaEyesPerDay = 0,
+            wakePhrases = "hey SENTINEL_WAKE",
+            elevenLabsVoiceId = "SENTINEL_VOICE"
+        )
+    )
+
+    @After
+    fun tearDown() = server.close()
+
+    private fun eyes() = HerEyes(
+        base = OkHttpClient(),
+        settings = { settings.get() },
+        save = { update -> settings.set(update(settings.get())) },
+        ledger = ledger,
+        clock = { now },
+        chatUrl = server.url("/api/v1/chat/completions").toString(),
+        listUrl = server.url("/api/v1/models").toString(),
+        prepare = { bytes -> EyesImage.Prepared.Jpeg(bytes.copyOf(), 832, 1216) }
+    )
+
+    private fun reply(text: String) = MockResponse.Builder().code(200).setHeader("Content-Type", "application/json")
+        .body("""{"choices":[{"message":{"content":"$text"},"finish_reason":"stop"}],"usage":{"prompt_tokens":900,"completion_tokens":20}}""").build()
+
+    private val picture = ByteArray(64) { 9 }
+
+    @Test
+    fun `the describer is sent the picture and the made-picture instruction only, with her eyes off`() = runBlocking {
+        server.enqueue(reply("looks: grown face, adult proportions\\nages: adult"))
+        val seen = eyes().checkMade(picture, counted = false)
+        assertEquals(MadePictureCheck.Verdict.Adult, MadePictureCheck.judge(seen, now))
+        val request = server.takeRequest(5, TimeUnit.SECONDS)!!
+        assertEquals("Bearer his-venice-key", request.headers["Authorization"])
+        val body = JsonParser.parseString(request.body!!.utf8()).asJsonObject
+        val messages = body.getAsJsonArray("messages")
+        assertEquals(2, messages.size())
+        assertEquals(Describe.MADE_CHECK, messages[0].asJsonObject.get("content").asString)
+        val turn = messages[1].asJsonObject.getAsJsonArray("content")
+        assertEquals(Describe.MADE_CHECK_TURN, turn[0].asJsonObject.get("text").asString)
+        assertEquals("data:image/jpeg;base64," + Base64.getEncoder().encodeToString(picture), turn[1].asJsonObject.getAsJsonObject("image_url").get("url").asString)
+        assertEquals(0.0, body.get("temperature").asDouble, 0.0)
+        assertEquals(HerEyes.modelOf(settings.get()), body.get("model").asString)
+        assertFalse(request.body!!.utf8().contains("SENTINEL"))
+        // His act: nothing in her ledger.
+        assertTrue(ledger.calls()!!.isEmpty())
+    }
+
+    @Test
+    fun `in her own time the check is a call of hers, as a picture, and her looks of the day are untouched`() = runBlocking {
+        server.enqueue(reply("looks: youthful face\\nages: teen"))
+        val seen = eyes().checkMade(picture, counted = true)
+        assertTrue(MadePictureCheck.judge(seen, now) is MadePictureCheck.Verdict.Kid)
+        assertEquals(listOf(OwnPurpose.PICTURE), ledger.calls()!!.map { it.purpose })
+        assertEquals(0, ledger.calls()!!.count { it.purpose == OwnPurpose.EYES })
+    }
+
+    @Test
+    fun `a refused key or a model that cannot take pictures never stops her eyes, and nothing goes out on his own hardware`() = runBlocking {
+        settings.set(settings.get().copy(personaEyes = true, personaEyesConsentAt = 1L))
+        server.enqueue(MockResponse.Builder().code(401).body("{}").build())
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.KEY_REFUSED), eyes().checkMade(picture, counted = false))
+        assertTrue(settings.get().personaEyes)
+        assertEquals("", settings.get().personaEyesStoppedWhy)
+        repeat(HerEyes.STRIKES + 1) {
+            server.enqueue(MockResponse.Builder().code(400).body("""{"error":"image input not supported"}""").build())
+            assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.UNSUPPORTED), eyes().checkMade(picture, counted = false))
+        }
+        assertEquals("", settings.get().personaEyesStoppedWhy)
+        // A failed check passes nothing.
+        assertEquals(MadePictureCheck.Verdict.Unchecked(MadePictureCheck.NO_CHECK, ran = false), MadePictureCheck.judge(HerEyes.Seen.NotSeen(HerEyes.Why.KEY_REFUSED)))
+
+        val requests = server.requestCount
+        settings.set(settings.get().copy(routePolicy = RoutePolicy.OWN_HARDWARE))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.OWN_HARDWARE), eyes().checkMade(picture, counted = false))
+        settings.set(settings.get().copy(routePolicy = RoutePolicy.ENCRYPTED, personaEyesModel = "claude-opus-4"))
+        assertEquals(HerEyes.Seen.NotSeen(HerEyes.Why.MODEL_REFUSED), eyes().checkMade(picture, counted = false))
+        assertEquals(requests, server.requestCount)
+    }
+
+    private class Asked(val request: LLMRequest, val purpose: OwnPurpose?)
+
+    @Test
+    fun `her own model is sent the made-picture instruction and the picture, nothing of hers, and counted only in her own time`() = runBlocking {
+        val asked = CopyOnWriteArrayList<Asked>()
+        val config = HerBrain.move(BuildDefaults.fresh().copy(apiKeys = mapOf(BuildDefaults.PROVIDER to "k"), wakePhrases = "hey SENTINEL_WAKE"))
+        val sight = HerSight(
+            eyes = eyes(),
+            settings = { config },
+            complete = { _, request ->
+                val mark = currentCoroutineContext()[OwnCall]
+                asked += Asked(request, mark?.purpose)
+                mark?.record(request.model ?: "", 900, 3, ok = true)
+                LLMResponse("looks: grown face\nages: adult", 903, "m", "p", 1L)
+            },
+            ledger = ledger,
+            clock = { now }
+        )
+        val jpeg = Base64.getEncoder().encodeToString(picture)
+        val seen = sight.checkMade(config, jpeg, counted = false)
+        assertEquals(HerEyes.Seen.Described("looks: grown face", KidGuard.Ages.Read(setOf(KidGuard.Age.ADULT)), seer = KidGuard.AGE_CHECK), seen)
+        val request = asked.single().request
+        assertEquals(Describe.MADE_CHECK, request.systemPrompt)
+        assertEquals(Describe.MADE_CHECK_TURN, request.messages.single().text)
+        assertEquals(jpeg, request.messages.single().imageBase64)
+        assertTrue(request.thinkingOff)
+        assertFalse((request.systemPrompt + request.messages.joinToString { it.text }).contains("SENTINEL"))
+        assertNull(asked.single().purpose)
+        assertTrue(ledger.calls()!!.isEmpty())
+
+        sight.checkMade(config, jpeg, counted = true)
+        assertEquals(OwnPurpose.PICTURE, asked.last().purpose)
+        assertEquals(listOf(OwnPurpose.PICTURE), ledger.calls()!!.map { it.purpose })
+    }
+}
