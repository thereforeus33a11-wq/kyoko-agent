+         * meant to write and is not sent. A call that fails is [HerWords.Answer.Unreachable];
+         * one the owner stopped is passed on.
+         */
+        internal suspend fun writeWordsFrom(
+            card: String,
+            ownerName: String,
+            ask: HerWords.Ask,
+            complete: suspend (LLMRequest) -> Answer
