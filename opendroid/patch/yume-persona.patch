+    @Test
+    fun `a key that is tied to no host yet is tied to the first host that answers it`() {
+        val venice = "https://api.venice.ai/api/v1"
+        // Typed while the provider had no address: there was no host to note for it.
+        val keyFirst = LLMConfig(activeProvider = custom, apiKeys = mapOf(custom to "venice-key"))
+            .let { it.withKeyHost(custom, "venice-key", it.keyHostNow(custom)) }
+        assertEquals(emptyMap<String, String>(), keyFirst.apiKeyHosts)
+        assertTrue(keyFirst.keyIsUntied(custom))
+        // Then the address. The key goes there, and the host that answers is noted as its own.
+        val addressed = keyFirst.copy(customEndpoints = mapOf(custom to venice))
+        assertEquals("venice-key", addressed.apiKeyFor(custom, venice))
+        val tied = addressed.withKeyTiedTo(custom, venice, "venice-key")
+        assertEquals(mapOf(custom to "api.venice.ai"), tied.apiKeyHosts)
+        assertFalse(tied.keyIsUntied(custom))
+        // Pointed at another machine afterwards, that machine gets no key.
+        assertEquals("", tied.apiKeyFor(custom, "http://192.168.1.20:8080/v1"))
+        assertEquals("venice-key", tied.apiKeyFor(custom, venice))
+
+        // A key saved before hosts were noted is tied the same way, the first time it is answered.
+        val fromBefore = LLMConfig(apiKeys = mapOf("Ollama" to "o"), ollamaUrl = "http://192.168.1.20:11434")
+        assertTrue(fromBefore.keyIsUntied("Ollama"))
+        assertEquals(mapOf("Ollama" to "192.168.1.20"), fromBefore.withKeyTiedTo("Ollama", "192.168.1.20:11434", "o").apiKeyHosts)
+
+        // Nothing is tied that should not be: a key that has a host, a key he has typed
+        // since, an address without a host, a provider with a fixed address, no key at all.
+        assertEquals(tied, tied.withKeyTiedTo(custom, "http://192.168.1.20:8080/v1", "venice-key"))
+        assertEquals(addressed, addressed.withKeyTiedTo(custom, venice, "an-older-key"))
+        assertEquals(addressed, addressed.withKeyTiedTo(custom, "", "venice-key"))
+        val fixed = LLMConfig(apiKeys = mapOf("OpenAI" to "k"))
+        assertFalse(fixed.keyIsUntied("OpenAI"))
+        assertEquals(fixed, fixed.withKeyTiedTo("OpenAI", "https://api.openai.com/v1", "k"))
+        assertFalse(LLMConfig(customEndpoints = mapOf(custom to venice)).keyIsUntied(custom))
+    }
