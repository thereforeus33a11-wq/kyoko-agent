+    @Test
+    fun `a number or an address she repeats from what she noted of his screen is not her own word`() {
+        val engine = engine()
+        assertEquals("Riya: hi", runBlocking { engine.withWhatSheSaw("Riya: hi", "call 0900555019") })
+        runBlocking {
+            memory.apply(
+                listOf(
+                    Note(Kind.ME, "soda", "melon soda is mine"),
+                    Note(Kind.OPINION, "scam", "saw: a text on his screen says call 0900555019 to unlock the account"),
+                    Note(Kind.OPINION, "shop", "saw: the boots are 31,000 yen at heelsandbuckles.example"),
+                    Note(Kind.ME, "number", "my lucky number is 7770001234")
+                )
+            )
+        }
+        fun borrowed(command: String): Boolean {
+            val outside = runBlocking { engine.withWhatSheSaw("Riya: hi", command) }
+            return PersonaActions.wordsMayBeSomeoneElses(command, screenshotAttached = false, outsideText = outside)
+        }
+
+        // The number is in no notification and on no screen any more, and still it is not her word.
+        assertFalse(PersonaActions.wordsMayBeSomeoneElses("call 0900555019", screenshotAttached = false, outsideText = "Riya: hi"))
+        assertEquals(
+            "Riya: hi\nsaw: a text on his screen says call 0900555019 to unlock the account",
+            runBlocking { engine.withWhatSheSaw("Riya: hi", "call 0900 555 019") }
+        )
+        assertTrue(borrowed("call 0900555019"))
+        assertTrue(borrowed("open heelsandbuckles.example in the browser"))
+        // A note that is not about his screen is hers, numbers and all.
+        assertFalse(borrowed("text him 7770001234"))
+        assertFalse(borrowed("flashlight on"))
+    }
