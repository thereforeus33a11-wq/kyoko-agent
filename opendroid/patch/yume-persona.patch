+++ b/app/src/test/java/com/opendroid/ai/core/life/eyes/CameraWallTest.kt
@@ -0,0 +1,99 @@
+package com.opendroid.ai.core.life.eyes
+
+import com.opendroid.ai.core.life.OutingStep
+import com.opendroid.ai.core.life.reading.ReadingSpace
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * How her camera is wired, read off the source like the other walls (OWN_LIFE_PLAN phase 2):
+ * a look is a moment line only, so no step verb reaches the camera; the frame stays in memory
+ * and is zeroed; the service takes the camera type only from the front, and "Eyes and ears"
+ * brings it back after a start from the background.
+ */
+class CameraWallTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private fun source(path: String) = File(main, path).readText()
+    private val manifest by lazy { File("src/main/AndroidManifest.xml").readText() }
+
+    /** Code without its comments, so that a word in a comment is not taken for a reach. */
+    private fun code(text: String) = text.replace(Regex("""/\*[\s\S]*?\*/"""), "").replace(Regex("""(?m)//.*$"""), "")
+
+    @Test
+    fun `no step verb reaches the camera - her reading space is made without one, and look in a step is a picture's number`() {
+        // Checked at compile level: nothing that could take a frame is among what her reading space is made of.
+        for (constructor in ReadingSpace::class.java.declaredConstructors) {
+            for (type in constructor.parameterTypes) {
+                for (never in listOf("Looks", "Shutter", "Camera", "Fold", "Shot")) {
+                    assertFalse("${type.name} in ReadingSpace", type.name.contains(never))
+                }
+            }
+        }
+        // The verbs of a step: a look there is a picture in front of her, by its number, and nothing else.
+        val verbs = OutingStep.Verb::class.java.declaredClasses.map { it.simpleName }.toSet()
+        assertEquals(setOf("Search", "Open", "More", "Back", "Follow", "Look", "Done"), verbs)
+        assertEquals(listOf("n"), OutingStep.Verb.Look::class.java.declaredFields.map { it.name }.filterNot { it.contains('$') })
+        assertEquals(null, OutingStep.verb("look back"))
+        assertEquals(null, OutingStep.verb("look through the camera"))
+        // The host makes her reading space without its looks, and runs a look only for a go: line.
+        val host = code(source("core/life/OutingHost.kt"))
+        val space = host.substringAfter("val space = ReadingSpace(").substringBefore("\n            )")
+        for (never in listOf("Looks", "Shutter", "camera", "this.looks")) assertFalse(space, space.contains(never))
+        assertTrue(host.contains("if (parsed is OutingKind.Parsed.Look) return look(outing, parsed.at)"))
+        val reading = code(source("core/life/reading/ReadingSpace.kt"))
+        for (never in listOf("Looks", "Shutter", "HerCamera", "FoldState", "CameraLook")) assertFalse(never, reading.contains(never))
+    }
+
+    @Test
+    fun `I6 - a frame is held in memory only, through an image reader, and zeroed once it has been used`() {
+        val camera = code(source("core/life/eyes/HerCamera.kt"))
+        assertTrue(camera.contains("ImageReader.newInstance(stillSize.width, stillSize.height, ImageFormat.JPEG, 1)"))
+        assertTrue(camera.contains("raw.bytes.fill(0)"))
+        assertTrue(camera.contains("buf.fill(0)"))
+        // The background photo action's file is not here.
+        assertFalse(camera.contains("getExternalFilesDir"))
+        assertFalse(camera.contains("background_photo_"))
+        val looks = code(source("core/life/eyes/CameraLook.kt"))
+        assertTrue(looks.contains("shot.jpeg.fill(0)"))
+        assertTrue(looks.contains("eyes.describe(shot.jpeg, Describe.Source.CAMERA)"))
+    }
+
+    @Test
+    fun `the service takes the camera type from the front, and Eyes and ears brings it back after a start from the background`() {
+        assertTrue(manifest.contains("<uses-permission android:name=\"android.permission.FOREGROUND_SERVICE_CAMERA\"/>"))
+        assertTrue(manifest.contains("android:foregroundServiceType=\"microphone|camera|specialUse\""))
+        val activity = manifest.substringAfter("android:name=\".ui.EyesAndEarsActivity\"").substringBefore("/>")
+        assertTrue(activity.contains("android:exported=\"false\""))
+        assertTrue(activity.contains("Theme.Translucent.NoTitleBar"))
+        val service = code(source("core/service/OpenDroidService.kt"))
+        assertTrue(service.contains("ForegroundStart.typesFor(sdk, granted(android.Manifest.permission.RECORD_AUDIO), granted(android.Manifest.permission.CAMERA))"))
+        assertTrue(service.contains("cameraArm.held(ForegroundStart.holdsCamera(sdk, type, fromForeground))"))
+        assertTrue(service.contains("Intent(this, com.opendroid.ai.ui.EyesAndEarsActivity::class.java)"))
+        assertTrue(service.contains("builder.addAction(0, EYES_AND_EARS, rearm)"))
+        assertTrue(service.contains("cameraArm.held(false)"))
+        assertTrue(code(source("ui/EyesAndEarsActivity.kt")).contains("OpenDroidService.rearm(this)"))
+        // Started from an activity of the app, which is in front; never so from the boot receiver.
+        assertTrue(code(source("MainActivity.kt")).contains("OpenDroidService.start(this, fromForeground = true)"))
+        assertTrue(code(source("ui/Navigation.kt")).contains("OpenDroidService.start(context, fromForeground = true)"))
+        assertTrue(code(source("core/service/BootReceiver.kt")).contains("OpenDroidService.start(context)"))
+        // A camera Android refuses for where the service was started clears it: "Camera: needs one tap".
+        assertTrue(code(source("core/life/eyes/HerCamera.kt")).contains("if (raw.why == Shot.Fail.DISABLED) arm.held(false)"))
+    }
+
+    @Test
+    fun `he is told she looked by the camera alone, and never what was seen`() {
+        assertEquals("Yume looked through the back camera", com.opendroid.ai.core.service.OpenDroidService.lookedText("Yume", "back camera"))
+        assertEquals(
+            "Yume looked through the outer camera (it faces you while the phone is folded)",
+            com.opendroid.ai.core.service.OpenDroidService.lookedText("Yume", FoldState.OUTER_CAMERA)
+        )
+        val host = code(source("core/life/OutingHost.kt"))
+        assertEquals(1, Regex("""room\?\.looked\(""").findAll(host).count())
+        assertTrue(host.contains("if (tellsHim) room?.looked(taken, clock())"))
+        assertEquals(60_000L, com.opendroid.ai.core.service.OpenDroidService.LOOK_NOTIFICATION_MILLIS)
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/life/eyes/EyesModelsTest.kt b/app/src/test/java/com/opendroid/ai/core/life/eyes/EyesModelsTest.kt
