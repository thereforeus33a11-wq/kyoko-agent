+package com.opendroid.ai.ui.screens
+
+import com.opendroid.ai.core.persona.PersonaNotes
+import com.opendroid.ai.ui.viewmodel.CardEditNotice
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** What the card screen says about a saved edit, and which kinds of notes it names. */
+class PersonaCardScreenWordingTest {
+
+    @Test
+    fun `a saved edit on an older built-in card is said to be one, and an unknown one is not called unchanged`() {
+        assertTrue(cardEditNoticeText(CardEditNotice.BUILT_IN_CHANGED)!!.startsWith("The built-in card has changed since your edit."))
+        val unknown = cardEditNoticeText(CardEditNotice.CANNOT_TELL)!!
+        assertTrue(unknown.contains("cannot tell whether the built-in card has changed since"))
+        assertFalse(unknown.startsWith("The built-in card has changed"))
+        assertNull(cardEditNoticeText(CardEditNotice.NONE))
+        assertNull(cardEditNoticeText(null))
+    }
+
+    @Test
+    fun `restoring the built-in card asks first, in the words of the notice when a saved edit goes`() {
+        val saved = restoreBuiltInQuestion(usesSavedEdit = true)
+        assertEquals("Remove your edit?", saved.title)
+        assertEquals("She will run on the built-in card. Your edited text is deleted and is not kept anywhere else.", saved.text)
+        assertEquals("Remove my edit", saved.confirm)
+        // Nothing is saved: only what he typed goes, and she runs on the built-in card already.
+        val typed = restoreBuiltInQuestion(usesSavedEdit = false)
+        assertEquals("Discard what you typed?", typed.title)
+        assertTrue(typed.text.contains("What you typed is not kept anywhere."))
+        assertFalse(typed.text.contains("deleted"))
+
+        // The button no longer removes anything by itself: both ways to the removal go through the question.
+        val screen = java.io.File("src/main/java/com/opendroid/ai/ui/screens/PersonaCardScreen.kt").readText()
+        assertFalse(screen.contains("onClick = viewModel::restoreBundled"))
+        assertTrue(screen.contains("onClick = { confirmRestore = true }"))
+        assertTrue(screen.contains("DiscardDialog(restoreBuiltInQuestion(viewModel.usesSavedEdit), onConfirm = viewModel::restoreBundled)"))
+        assertTrue(screen.contains("DiscardDialog(restoreBuiltInQuestion(usesSavedEdit = true), onConfirm = onUseBuiltIn)"))
+        assertEquals(2, Regex("""restoreBundled""").findAll(screen).count())
+    }
+
+    @Test
+    fun `the kinds named under the field for her notes are the kinds she has`() {
+        for (kind in PersonaNotes.Kind.entries) assertTrue(kind.label, Regex("""\b${kind.label}\b""").containsMatchIn(NOTE_KINDS_HINT))
+    }
+}
