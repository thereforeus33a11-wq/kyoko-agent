+package com.opendroid.ai.ui.viewmodel
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HandTypedModelTest {
+
+    @Test
+    fun `a typed id on a free-form provider is kept even when the list lacks it`() {
+        assertTrue(keepsHandTypedModel("Custom OpenAI Compatible", "some-model:disable_thinking=true"))
+        assertTrue(keepsHandTypedModel("OpenRouter", "vendor/model:nitro"))
+    }
+
+    @Test
+    fun `the untouched seed and blank ids are still replaced`() {
+        assertFalse(keepsHandTypedModel("Custom OpenAI Compatible", "custom-model"))
+        assertFalse(keepsHandTypedModel("OpenRouter", "openrouter/auto"))
+        assertFalse(keepsHandTypedModel("Custom OpenAI Compatible", "  "))
+    }
+
+    @Test
+    fun `an id that was picked from the provider's list and then dropped by it is replaced`() {
+        val before = listOf("vendor/old-model", "vendor/other")
+        assertFalse(keepsHandTypedModel("OpenRouter", "vendor/old-model", previouslyListed = before))
+        assertTrue(keepsHandTypedModel("OpenRouter", "vendor/old-model:nitro", previouslyListed = before))
+    }
+
+    @Test
+    fun `providers with a fixed catalogue keep the stock behaviour`() {
+        assertFalse(keepsHandTypedModel("OpenAI", "made-up-model"))
+        assertFalse(keepsHandTypedModel("Anthropic Claude", "claude-made-up"))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModelStateTest.kt b/app/src/test/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModelStateTest.kt
new file mode 100644
index 0000000..5f9515b
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/ui/viewmodel/PersonaPicturesViewModelStateTest.kt
@@ -0,0 +1,341 @@
+package com.opendroid.ai.ui.viewmodel
+
+import android.app.Application
+import android.os.Looper
+import androidx.lifecycle.viewModelScope
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.persona.PersonaEngine
+import com.opendroid.ai.core.persona.PersonaEngineTestSetup
+import com.opendroid.ai.core.persona.PersonaLibrary
+import com.opendroid.ai.core.persona.PersonaMemory
+import com.opendroid.ai.core.persona.PersonaPicture
+import com.opendroid.ai.core.persona.PersonaPicture.CaptionBy
+import com.opendroid.ai.core.persona.PersonaPicture.Kind
+import com.opendroid.ai.core.persona.PersonaPictureRules
+import com.opendroid.ai.core.persona.PersonaPictures
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.core.persona.PersonaStore
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.models.LLMConfig
+import com.opendroid.ai.data.models.RoutePolicy
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.data.repository.SettingsRepository
+import java.io.File
+import java.net.InetAddress
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import mockwebserver3.MockResponse
+import mockwebserver3.MockWebServer
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * The screen with her pictures as the owner uses it, with the real store, her files in
+ * the app's storage and her model behind a local socket: what a button changes, what it
+ * leaves alone, and that the line it prints afterwards is true.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class PersonaPicturesViewModelStateTest {
+
+    private val custom = PersonaEngineTestSetup.CUSTOM
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private val server = MockWebServer().also { it.start(InetAddress.getByName("127.0.0.1"), 0) }
+    private val pictureDirectory = File(File(context.filesDir, "persona"), "pictures")
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var settings: SettingsRepository
+    private lateinit var store: PersonaStore
+    private lateinit var pictures: PersonaPictures
+    private lateinit var engine: PersonaEngine
+    private lateinit var viewModel: PersonaPicturesViewModel
+
+    // An invented wording. It stands for what the owner typed and for nothing real.
+    private val savedWording = "She grew up above a harbour and left it at night."
+    private val typed = "She grew up above a harbour. He keeps bees, which she pretends not to like."
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        settings = PersonaEngineTestSetup.settings()
+        store = PersonaStore(context)
+        store.saveCard("You are Yume. {{owner}} built you.")
+        pictures = PersonaPictures(context)
+        val library = PersonaLibrary(context)
+        engine = PersonaEngine(
+            store = store,
+            memory = PersonaMemory(
+                MemoryRepository(
+                    memoryDao = database.memoryDao(),
+                    taskHistoryDao = database.taskHistoryDao(),
+                    macroDao = database.macroDao()
+                )
+            ),
+            library = library,
+            settingsRepository = settings,
+            llmProviderFactory = PersonaEngineTestSetup.factory(settings),
+            userProfileStore = PersonaEngineTestSetup.ProfileNamed("Sam"),
+            pictures = pictures,
+            memoryManager = PersonaEngineTestSetup.memoryManager(
+                context, database, PersonaEngineTestSetup.ProfileNamed("Sam")
+            )
+        )
+        // Her model on his own machine, reading images.
+        configure {
+            it.copy(
+                routePolicy = RoutePolicy.ANY,
+                activeProvider = custom,
+                selectedModels = mapOf(custom to "her-vision-model"),
+                customEndpoints = mapOf(custom to server.url("/v1").toString()),
+                personaChatSeesImages = true,
+                personaLibraryChars = 0
+            )
+        }
+    }
+
+    @After
+    fun tearDown() {
+        if (::viewModel.isInitialized) viewModel.viewModelScope.cancel()
+        server.close()
+        database.close()
+        File(context.filesDir, "persona").deleteRecursively()
+    }
+
+    // ── Helpers ──────────────────────────────────────────────────────────────────────
+
+    private fun configure(change: (LLMConfig) -> LLMConfig) = runBlocking { settings.updateConfig(change) }
+
+    /** Opens the screen: the view model is built and the text for the box is read. */
+    private fun openScreen() {
+        viewModel = PersonaPicturesViewModel(pictures, store, PersonaLibrary(context), engine, settings)
+        viewModel.loadUnderText()
+    }
+
+    /** Lets what a button started run to its end. The view model works on the main thread, which a test has to turn. */
+    private fun settle(what: String, done: () -> Boolean) {
+        val deadline = System.currentTimeMillis() + 10_000
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (done()) return
+            assertTrue("Timed out waiting for: $what", System.currentTimeMillis() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    /** Presses a button and waits for the line it prints. */
+    private fun press(what: String, button: () -> Unit): String {
+        val before = viewModel.status
+        button()
+        settle(what) { viewModel.status != before }
+        return viewModel.status
+    }
+
+    private fun reply(text: String) = MockResponse.Builder()
+        .code(200)
+        .setHeader("Content-Type", "application/json")
+        .body("""{"choices":[{"message":{"content":"$text"}}],"usage":{"total_tokens":7}}""")
+        .build()
+
+    /** Puts pictures into the app's storage the way the store keeps them. Nothing here decodes one. */
+    private fun stored(vararg entries: PersonaPicture) {
+        pictureDirectory.mkdirs()
+        entries.forEach { File(pictureDirectory, it.file).writeBytes("picture ${it.id}".toByteArray()) }
+        File(pictureDirectory, "index.json").writeText(
+            PersonaPictureRules.encodeIndex(PersonaPictureRules.Index(pictures = entries.toList()))
+        )
+    }
+
+    private fun self(id: String, caption: String, by: CaptionBy) =
+        PersonaPicture(id = id, file = "$id.jpg", kind = Kind.SELF, caption = caption, captionBy = by)
+
+    private fun background(id: String) = PersonaPicture(id = id, file = "$id.jpg", kind = Kind.BACKGROUND)
+
+    private fun readThePicture(answer: String): String {
+        server.enqueue(reply(answer))
+        settle("the background picture to be listed") { viewModel.background.value != null }
+        return press("the picture to be read", viewModel::readBackgroundIntoText)
+    }
+
+    // ── Read the picture into the text ───────────────────────────────────────────────
+
+    @Test
+    fun `reading the picture into the box keeps what he had typed and not saved, for one step back`() {
+        store.saveUnderText(savedWording)
+        stored(background("page"))
+        openScreen()
+        settle("the saved wording to be shown") { viewModel.underIsOwnWording }
+        viewModel.onUnderTextChange(typed)
+        assertTrue(viewModel.underHasUnsavedChanges)
+        assertFalse(viewModel.canUndoReading)
+
+        val line = readThePicture("She is nineteen. She left the harbour town at night.")
+
+        assertEquals("She is nineteen. She left the harbour town at night.", viewModel.underText)
+        assertTrue(viewModel.underHasUnsavedChanges)
+        assertTrue(viewModel.canUndoReading)
+        assertEquals(PersonaPicturesViewModel.readLine(replacedUnsavedTyping = true), line)
+
+        viewModel.undoReading()
+
+        // His typing is back as it was, still unsaved, and still his to save or drop.
+        assertEquals(typed, viewModel.underText)
+        assertTrue(viewModel.underEditing)
+        assertTrue(viewModel.underHasUnsavedChanges)
+        assertFalse(viewModel.canUndoReading)
+        // Nothing of all this was saved.
+        assertEquals(savedWording, store.savedUnderText()!!.trim())
+    }
+
+    @Test
+    fun `a saved wording is brought back the same way, without leaving the screen`() {
+        store.saveUnderText(savedWording)
+        stored(background("page"))
+        openScreen()
+        settle("the saved wording to be shown") { viewModel.underIsOwnWording }
+
+        val line = readThePicture("Notes about the page.")
+
+        assertEquals("Notes about the page.", viewModel.underText)
+        assertEquals(PersonaPicturesViewModel.readLine(replacedUnsavedTyping = false), line)
+        // He goes on typing in what was read, and still can go back.
+        viewModel.onUnderTextChange("Notes about the page. And more.")
+        assertTrue(viewModel.canUndoReading)
+
+        viewModel.undoReading()
+
+        assertEquals(savedWording, viewModel.underText)
+        assertTrue(viewModel.underIsOwnWording)
+        assertFalse(viewModel.underHasUnsavedChanges)
+        assertEquals(savedWording, store.savedUnderText()!!.trim())
+    }
+
+    @Test
+    fun `once the reading is saved, or the box goes back to her files, there is nothing left to undo`() {
+        store.saveUnderText(savedWording)
+        stored(background("page"))
+        openScreen()
+        settle("the saved wording to be shown") { viewModel.underIsOwnWording }
+
+        readThePicture("Notes about the page.")
+        press("the text to be saved", viewModel::saveUnderText)
+        assertFalse(viewModel.canUndoReading)
+        assertEquals("Notes about the page.", store.savedUnderText()!!.trim())
+
+        readThePicture("Other notes.")
+        assertTrue(viewModel.canUndoReading)
+        press("the wording to be removed", viewModel::backToTextFromHerFiles)
+        assertFalse(viewModel.canUndoReading)
+        assertEquals(null, store.savedUnderText())
+    }
+
+    @Test
+    fun `a reading that fails leaves the box and his typing alone`() {
+        store.saveUnderText(savedWording)
+        stored(background("page"))
+        openScreen()
+        settle("the saved wording to be shown") { viewModel.underIsOwnWording }
+        viewModel.onUnderTextChange(typed)
+
+        val line = readThePicture("I'm sorry, but I can't help with that.")
+
+        assertTrue(line, line.endsWith("The text below is unchanged."))
+        assertEquals(typed, viewModel.underText)
+        assertTrue(viewModel.underHasUnsavedChanges)
+        assertFalse(viewModel.canUndoReading)
+    }
+
+    // ── The line after Save ──────────────────────────────────────────────────────────
+
+    @Test
+    fun `with the switch off the line after Save does not claim the text lies under her awareness`() {
+        configure { it.copy(personaUnderEnabled = false) }
+        store.saveUnderText("An earlier wording.")
+        openScreen()
+        settle("the earlier wording to be shown") { viewModel.underIsOwnWording }
+        viewModel.onUnderTextChange(savedWording)
+
+        val off = press("the text to be saved", viewModel::saveUnderText)
+
+        assertEquals(savedWording, store.savedUnderText()!!.trim())
+        assertEquals(
+            "Saved. It is left out of her prompt while \"Keep this under her awareness in every reply\" is off.",
+            off
+        )
+        // Which is what her prompt does.
+        val prompt = runBlocking {
+            engine.chatSystemPrompt(settings.llmConfig.first(), "", emptyList(), screenshotAttached = false)
+        }
+        assertFalse(prompt.contains(PersonaPrompts.UNDER_HEADING))
+        assertFalse(prompt.contains("above a harbour"))
+
+        // Switched on, the same button says the other true thing.
+        configure { it.copy(personaUnderEnabled = true) }
+        viewModel.onUnderTextChange("$savedWording She kept the key.")
+        val on = press("the text to be saved again", viewModel::saveUnderText)
+        assertEquals("Saved. This is what lies under her awareness from her next reply on.", on)
+        val promptNow = runBlocking {
+            engine.chatSystemPrompt(settings.llmConfig.first(), "", emptyList(), screenshotAttached = false)
+        }
+        assertTrue(promptNow.contains("She kept the key."))
+    }
+
+    // ── Captions ─────────────────────────────────────────────────────────────────────
+
+    @Test
+    fun `saving her caption with a space he added changes nothing, and it stays hers`() {
+        stored(self("a", "nails,\ngold tips", CaptionBy.HER))
+        openScreen()
+        settle("her picture to be listed") { viewModel.selfPictures.value.size == 1 }
+        assertTrue(viewModel.selfPictures.value.single().captionIsHers)
+
+        val unchanged = press("the caption to be looked at") { viewModel.saveCaption("a", "nails,\ngold tips \n") }
+
+        assertEquals("The caption is what it was. Nothing was changed.", unchanged)
+        val kept = runBlocking { pictures.list() }.single()
+        assertEquals("nails,\ngold tips", kept.caption)
+        assertEquals(CaptionBy.HER, kept.captionBy)
+        assertTrue(viewModel.selfPictures.value.single().captionIsHers)
+
+        // Other words are his, and are saved as his.
+        val saved = press("the caption to be saved") { viewModel.saveCaption("a", "nails, gold tips, fresh set") }
+
+        assertEquals("Caption saved.", saved)
+        val retyped = runBlocking { pictures.list() }.single()
+        assertEquals("nails, gold tips, fresh set", retyped.caption)
+        assertEquals(CaptionBy.OWNER, retyped.captionBy)
+        settle("the list to follow") { !viewModel.selfPictures.value.single().captionIsHers }
+    }
+
+    // ── Files the list does not name ─────────────────────────────────────────────────
+
+    @Test
+    fun `picture files the list does not name are counted for him and deleted only when he says so`() {
+        stored(self("a", "black coat", CaptionBy.OWNER))
+        File(pictureDirectory, "left-behind.jpg").writeBytes(byteArrayOf(1))
+        openScreen()
+        settle("the pictures to be read") { viewModel.selfPictures.value.size == 1 }
+
+        assertEquals(1, viewModel.unlistedFiles.value)
+        assertTrue(File(pictureDirectory, "left-behind.jpg").isFile)
+
+        val line = press("the files to be deleted", viewModel::deleteUnlistedFiles)
+
+        assertEquals("Deleted. What is listed here is every picture the app keeps.", line)
+        assertEquals(0, viewModel.unlistedFiles.value)
+        assertFalse(File(pictureDirectory, "left-behind.jpg").exists())
+        assertTrue(File(pictureDirectory, "a.jpg").isFile)
+    }
+}
