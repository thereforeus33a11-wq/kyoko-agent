index 0000000..90d105c
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/voice/WakeWordMatcher.kt
@@ -0,0 +1,83 @@
+package com.opendroid.ai.core.voice
+
+/**
+ * Decides whether a speech-recogniser transcript contains a wake phrase.
+ *
+ * The recogniser is free-form and runs in the device language, so a name it does
+ * not know comes back in several spellings. Phrases are therefore a list. A phrase
+ * counts only where it stands as whole words: what follows a wake phrase is run as
+ * the owner's request, so "yum" must not be heard in "yummy" nor "you may" in
+ * "thank you maybe".
+ */
+object WakeWordMatcher {
+
+    /** What the app listened for before phrases became configurable. */
+    val STOCK_PHRASES: List<String> = listOf("opendroid", "open droid")
+
+    /**
+     * Carrier word plus the spellings an English recogniser tends to produce for "yume".
+     * Nothing here is ordinary English: "you may" and "you me", with or without "hey" in
+     * front, turn up in other people's talk and in text the phone reads aloud, and what
+     * follows a wake phrase is run as the owner's request. A recogniser that only ever
+     * hears the name that way can be given the spelling in the wake-phrase setting.
+     */
+    val PERSONA_PHRASES: List<String> = listOf(
+        "hey yume", "hey yumi", "hey yumei", "hey yoomay", "hey youme",
+        "okay yume", "ok yume", "okay yumi", "ok yumi"
+    )
+
+    fun matches(transcript: String, phrases: List<String>): Boolean {
+        val heard = collapse(transcript)
+        if (heard.isEmpty()) return false
+        return phrases.any { phrase ->
+            val wanted = collapse(phrase)
+            wanted.isNotEmpty() && standsAsWords(heard, wanted)
+        }
+    }
+
+    /** True where [wanted] occurs in [heard] with no letter or digit directly before or after it. */
+    private fun standsAsWords(heard: String, wanted: String): Boolean {
+        var from = heard.indexOf(wanted)
+        while (from >= 0) {
+            val end = from + wanted.length
+            val freeBefore = from == 0 || !heard[from - 1].isLetterOrDigit()
+            val freeAfter = end == heard.length || !heard[end].isLetterOrDigit()
+            if (freeBefore && freeAfter) return true
+            from = heard.indexOf(wanted, from + 1)
+        }
+        return false
+    }
+
+    /**
+     * The phrases to listen for: the built-in ones (the persona list when the persona is
+     * on, then the stock phrases) and, added to them, the owner's own. His list never
+     * takes a built-in phrase away, so adding the spelling his recogniser produces
+     * cannot leave the phone deaf to the name it is told to listen for.
+     */
+    fun resolve(userPhrases: String, personaEnabled: Boolean): List<String> {
+        val builtIn = if (personaEnabled) PERSONA_PHRASES + STOCK_PHRASES else STOCK_PHRASES
+        return (builtIn + parse(userPhrases)).distinct()
+    }
+
+    /**
+     * Splits a comma, semicolon or newline separated setting into clean phrases. A phrase
+     * of his own needs two words or at least [MIN_SINGLE_WORD_LETTERS] letters: anything
+     * shorter turns up in ordinary talk all day.
+     */
+    fun parse(raw: String): List<String> =
+        raw.split(',', ';', '\n')
+            .map { collapse(it) }
+            .filter { isSpecificEnough(it) }
+            .distinct()
+
+    /** Fewest letters a wake phrase of one word may have. */
+    const val MIN_SINGLE_WORD_LETTERS = 5
+
+    private fun isSpecificEnough(phrase: String): Boolean {
+        val words = phrase.split(' ').filter { word -> word.any { it.isLetterOrDigit() } }
+        return words.size >= 2 || phrase.count { it.isLetter() } >= MIN_SINGLE_WORD_LETTERS
+    }
+
+    private fun collapse(text: String): String =
+        text.lowercase().replace(Regex("""\s+"""), " ").trim()
+}
