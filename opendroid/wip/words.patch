+    @Test
+    fun `a sign-off on a long message of his is not his words, his name least of all`() {
+        val train = "text mom the train stopped at the bridge and I will be home around nine tonight"
+        for (sources in listOf(his(train), PlanWords.Sources(listOf(train), names = listOf("Ren Takahashi")))) {
+            for (signed in listOf(
+                "The train stopped at the bridge and I will be home around nine tonight. - Ren",
+                "The train stopped at the bridge and I will be home around nine tonight. Love, mom's boy",
+                "The train stopped at the bridge and I will not be home around nine tonight"
+            )) {
+                assertFalse(signed, PlanWords.isTheirs(signed, sources))
+            }
+            // The same words with a greeting in front are still his.
+            assertTrue(PlanWords.isTheirs("Hey, the train stopped at the bridge and I will be home around nine tonight", sources))
+        }
+        // A dictated email body of his with a sign-off put under it.
+        val dictated = "email boss@example.com saying I am sick today with a fever and a sore throat, I will not be in the office " +
+            "and I will check my mail in the afternoon if I feel better, the report is in the shared folder"
+        val body = "I am sick today with a fever and a sore throat, I will not be in the office and I will check my mail in the " +
+            "afternoon if I feel better, the report is in the shared folder.\n\nThanks, Ren"
+        assertFalse(PlanWords.isTheirs(body, his(dictated)))
+        assertTrue(PlanWords.isTheirs(body.substringBefore("\n\nThanks"), his(dictated)))
+        // A name that is also a word a person may add is still his name.
+        val will = "I will be home around nine tonight with the groceries and the mail, the train stopped at the bridge"
+        assertTrue(PlanWords.isTheirs("$will will", his("text mom $will")))
+        assertFalse(PlanWords.isTheirs("$will will", PlanWords.Sources(listOf("text mom $will"), names = listOf("Will"))))
+        // Where he wrote his name himself, it is his.
+        assertTrue(PlanWords.isTheirs("$will - Ren", PlanWords.Sources(listOf("text mom $will - Ren"), names = listOf("Ren"))))
+    }
