+    @Test
+    fun `the words a macro stores are held to the same rule`() {
+        val stored = """[
+            {"stepId":"m1","order":1,"description":"x","action":"SEND_SMS","params":{"contact":"Mom","message":"good morning"},"extra":7},
+            {"stepId":"m2","order":2,"description":"y","action":"SEND_SMS","params":{"contact":"Dad","message":"Rise and shine, old man. Coffee is on me today."}}
+        ]"""
+        val macro = step("s1", "CREATE_MACRO", mapOf("name" to "Morning", "steps" to stored))
+        val found = notTheirs("make a macro that texts mom good morning and dad too", macro).single()
+        assertEquals(1, found.inMacro)
+        assertEquals("m2", found.words.stepId)
+        assertEquals(listOf("message"), found.words.notTheirs)
+
+        // Written back, a stored step keeps its other keys and loses only what was left out.
+        val read = PlanWords.stored(macro)!!
+        val back = read.with(kept = setOf(1), written = mapOf(1 to mapOf("contact" to "Dad", "message" to "morning")))
+        val array = Json.parseToJsonElement(back).jsonArray
+        assertEquals(1, array.size)
+        assertEquals("m2", array[0].jsonObject["stepId"]!!.jsonPrimitive.content)
+        assertEquals("morning", array[0].jsonObject["params"]!!.jsonObject["message"]!!.jsonPrimitive.content)
+        val untouched = read.with(kept = setOf(0, 1), written = emptyMap())
+        assertEquals("7", Json.parseToJsonElement(untouched).jsonArray[0].jsonObject["extra"]!!.jsonPrimitive.content)
+        // A param that is not text stays, and a fallback taken off is written back.
+        val nested = PlanWords.stored(step("s1", "CREATE_MACRO", mapOf("name" to "x", "steps" to
+            """[{"action":"MAKE_CALL","params":{"contact":"Mom","message":"hi","retries":[1,2]},"fallback":"SEND_SMS"}]""")))!!
+        val off = Json.parseToJsonElement(nested.with(setOf(0), mapOf(0 to mapOf("contact" to "Mom")), mapOf(0 to ""))).jsonArray[0].jsonObject
+        assertEquals("", off["fallback"]!!.jsonPrimitive.content)
+        assertEquals(setOf("contact", "retries"), off["params"]!!.jsonObject.keys)
+        // Steps that cannot be read are not taken for steps.
+        assertNull(PlanWords.stored(step("s1", "CREATE_MACRO", mapOf("name" to "x", "steps" to "send mom hi"))))
+    }
