+    @Test
+    fun `an answer an earlier step gives is the phone's own output and passes`() {
+        val weather = step("s1", "GET_WEATHER", mapOf("location" to "Osaka"))
+        val pasted = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "\$\$s1"))
+        val framed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Today's weather: \$\$s1"))
+        val single = step("s2", "SEND_WHATSAPP", mapOf("contact" to "Mom", "message" to "\$s1"))
+        assertTrue(PlanWords.notTheirs(listOf(weather, pasted), his("text mom the weather in osaka")).isEmpty())
+        assertTrue(PlanWords.notTheirs(listOf(weather, framed), his("text mom today's weather in osaka")).isEmpty())
+        assertTrue(PlanWords.notTheirs(listOf(weather, single), his("whatsapp mom the weather")).isEmpty())
+        // Words around the answer are still held to his.
+        val composed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Mom, don't forget your umbrella: \$\$s1"))
+        assertEquals(1, PlanWords.notTheirs(listOf(weather, composed), his("text mom the weather")).size)
+        // The ".result" the executor also reads is part of the reference.
+        val suffixed = step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "\$\$s1.result"))
+        assertTrue(PlanWords.notTheirs(listOf(weather, suffixed), his("text mom the weather")).isEmpty())
+        // A stretch copied word for word from what a step put out passes; a sentence of words
+        // that only occur somewhere in it does not.
+        val result = "Weather in Osaka: light rain, 18 C, wind from the north. The week ahead looks warm and you will need no coat at all."
+        val sources = PlanWords.Sources(listOf("text mom the weather"), pasted = listOf(result))
+        assertTrue(PlanWords.isTheirs("The weather: light rain, 18 C", sources))
+        assertFalse(PlanWords.isTheirs("you will need the coat in the week ahead", sources))
+    }
