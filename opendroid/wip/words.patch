+++ b/app/src/main/java/com/opendroid/ai/core/agent/AutomatedSender.kt
@@ -0,0 +1,114 @@
+package com.opendroid.ai.core.agent
+
+/**
+ * Who never gets an answer from this phone: addresses and numbers that only send.
+ *
+ * An email address that exists to send (no-reply, notifications, a mailer daemon, a
+ * bounce or newsletter address, or a bulk-mail subdomain such as `em.` or `notify.`),
+ * an SMS short code or sender ID (`12345`, `AX-HDFCBK`), and a bot handle on a chat or
+ * social site. Nothing the app sends is addressed to one of these, whoever wrote it:
+ * a message to a machine reaches nobody, and an answer can confirm the address is live
+ * or sign him up for more.
+ *
+ * A contact's name ("Mom", "Aoi") is never automated. A plain phone number of seven
+ * digits or more is a person's.
+ */
+object AutomatedSender {
+
+    /** Local parts of an email address that only send. Compared without dots, dashes and underscores. */
+    private val SENDING_LOCAL_PARTS = setOf(
+        "noreply", "donotreply", "dontreply", "doreply", "noresponse", "notreply",
+        "notification", "notifications", "notify", "notifier", "alert", "alerts",
+        "mailerdaemon", "maildaemon", "postmaster", "bounce", "bounces", "bouncer",
+        "newsletter", "newsletters", "digest", "updates",
+        "automated", "automail", "autoconfirm", "autoreply", "autoresponder",
+        "robot", "bot", "daemon", "mailer", "mailbot", "notice", "notices", "info-noreply",
+        "verify", "verification", "confirm", "confirmation",
+        "receipts", "receipt", "billing-noreply", "marketing", "promo", "promotions", "offers",
+        "deals", "rewards", "survey", "feedback-noreply", "jobs-noreply", "invitations",
+        "calendar-notification", "drive-shares-noreply", "comments-noreply"
+    ).map(::squash).toSet()
+
+    /** A local part that starts or ends with one of these only sends, whatever else it says. */
+    private val SENDING_MARKERS = listOf("noreply", "donotreply", "notreply", "mailerdaemon", "bounce", "autoreply", "notification")
+
+    /**
+     * The first label of a bulk-mail domain (`em.tumblr.com`, `notify.example.jp`). Labels
+     * people also have mailboxes under, such as `mail.` and `email.` at universities, are
+     * not in it.
+     */
+    private val SENDING_SUBDOMAINS = setOf(
+        "em", "mailer", "mailing", "mg", "mta", "bounce", "bounces", "news", "newsletter",
+        "newsletters", "notify", "notification", "notifications", "alerts", "marketing", "promo",
+        "updates", "sender", "noreply"
+    )
+
+    private val PHONE_CHARS = Regex("[\\s().\\-+]")
+    private val DIGITS = Regex("\\d+")
+    /** An SMS sender ID: two letters, a dash, then letters and digits (`VM-HDFCBK`). */
+    private val SENDER_ID = Regex("^[A-Z]{2}-[A-Z0-9]{3,9}$")
+    private val HANDLE = Regex("^@?[A-Za-z0-9_.\\-]{2,64}$")
+
+    /** True when [recipient] only sends. See [reason]. */
+    fun isAutomated(recipient: String?): Boolean = reason(recipient) != null
+
+    /**
+     * Why [recipient] is never answered, in plain words for the record and the plan, or
+     * null for anyone who may be written to. [recipient] is an email address, a phone
+     * number, a short code, a sender ID or a handle, as a plan step or a notification
+     * carries it; a display name such as `Tumblr <no-reply@tumblr.com>` is read for its
+     * address.
+     */
+    fun reason(recipient: String?): String? {
+        val raw = recipient?.trim().orEmpty()
+        if (raw.isEmpty()) return null
+        val address = Regex("<([^<>@\\s]+@[^<>\\s]+)>").find(raw)?.groupValues?.get(1) ?: raw
+        return when {
+            '@' in address.trim('@') -> emailReason(address)
+            looksLikeNumber(address) -> numberReason(address)
+            SENDER_ID.matches(address) -> "$address is an SMS sender ID, which only sends"
+            HANDLE.matches(address) && address.startsWith("@") -> handleReason(address)
+            else -> null
+        }
+    }
+
+    private fun emailReason(address: String): String? {
+        val at = address.lastIndexOf('@')
+        if (at <= 0 || at == address.length - 1) return null
+        val local = address.substring(0, at).substringBefore('+').lowercase()
+        val domain = address.substring(at + 1).lowercase().trimEnd('.', '>')
+        val squashed = squash(local)
+        if (squashed in SENDING_LOCAL_PARTS) return "$address is an address that only sends"
+        if (SENDING_MARKERS.any { squashed.startsWith(it) || squashed.endsWith(it) }) {
+            return "$address is an address that only sends"
+        }
+        val labels = domain.split('.').filter { it.isNotEmpty() }
+        if (labels.size >= 3 && labels.first() in SENDING_SUBDOMAINS) {
+            return "$address comes from a bulk-mail domain, which only sends"
+        }
+        if (labels.any { it.startsWith("bounce") }) return "$address is a bounce address"
+        return null
+    }
+
+    private fun looksLikeNumber(text: String): Boolean {
+        val stripped = text.replace(PHONE_CHARS, "")
+        return stripped.isNotEmpty() && DIGITS.matches(stripped)
+    }
+
+    private fun numberReason(number: String): String? {
+        val digits = number.replace(PHONE_CHARS, "")
+        return if (digits.length in 3..6) "$number is an SMS short code, which only sends" else null
+    }
+
+    private fun handleReason(handle: String): String? {
+        val name = handle.trimStart('@').lowercase()
+        val squashed = squash(name)
+        return when {
+            squashed.endsWith("bot") || squashed == "botfather" -> "$handle is a bot"
+            SENDING_MARKERS.any { it in squashed } -> "$handle is an account that only sends"
+            else -> null
+        }
+    }
+
+    private fun squash(text: String): String = text.lowercase().filter { it.isLetterOrDigit() }
+}
