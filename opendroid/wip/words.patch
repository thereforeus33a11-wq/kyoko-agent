+package com.opendroid.ai.core.persona
+
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.ResponseFormat
+import com.opendroid.ai.data.models.ChatMessage
+import java.util.UUID
+
+/**
+ * Words the phone is about to send for him that nobody else may write: she writes them.
+ *
+ * When something the phone is about to send (an email, a message, a post, text typed
+ * into another app, an invitation) holds words that are neither his own nor hers, the
+ * app does not send them as the planning tool wrote them. It asks her to write them
+ * herself, as herself, and tells her only what she needs for that: what kind of thing it
+ * is, who it goes to and through which app, that it goes from his phone and his accounts,
+ * and what was asked for, in the words of whoever asked. The draft the planning tool
+ * wrote, and the planning tool's own prompt, are never shown to her: her words would
+ * then only be its words passed through her.
+ *
+ * Her answer is read strictly ([read]): the fields she was asked for, in order, or a
+ * plain NO. Anything else counts as no, and then nothing is sent.
+ *
+ * Like the rest of this package, everything here is a decision about text. The words go
+ * back to the loop that runs plans as finished strings.
+ */
+object HerWords {
+
+    /** What the words are. Each kind is named in her note the way a person would say it. */
+    enum class Kind(val said: String) {
+        EMAIL("an email"),
+        MESSAGE("a message"),
+        POST("a public post"),
+        TYPED_TEXT("text typed into another app"),
+        INVITATION("a calendar invitation"),
+        PAYMENT_NOTE("the note on a payment"),
+        LINK("words a link fills into the page it opens")
+    }
+
+    /** Who asked for the thing the words go with: him, in a message of his, or her, in a command of hers. */
+    enum class From { HIM, HER }
+
+    /**
+     * A mark she may write where the phone puts in what an earlier step gives back when it
+     * runs (the weather it looked up, his answer to a question): [token] is the mark, and
+     * [step] names that step's action the way his approval card does. Neither is anybody's
+     * words: the app makes both.
+     */
+    data class Fill(val token: String, val step: String)
+
+    /**
+     * One thing the phone is about to send, as she is told of it.
+     *
+     * [to] is who it goes to as the phone has it (an address, a number, a name, or the
+     * field text is typed into), empty for a post. [through] is the app it goes through.
+     * [asked] is what was asked for, word for word, by [askedBy]. [fields] are the names
+     * of the parts she writes, in order ("subject", "body"). [stored] says the words are
+     * kept in a macro of his and sent the same every time it runs. [kept] names the parts
+     * that are already his or her own words and stay as they are; only their names, never
+     * their words. [fills] are the marks for what earlier steps give back, which go where
+     * she puts them.
+     */
+    data class Ask(
+        val kind: Kind,
+        val to: String,
+        val through: String,
+        val askedBy: From,
+        val asked: String,
+        val fields: List<String>,
+        val stored: Boolean = false,
+        val kept: List<String> = emptyList(),
+        val fills: List<Fill> = emptyList()
+    ) {
+        /**
+         * This ask for a route that is not given his details: who it goes to is named only
+         * where the words that asked for it name it too. An address or a number the phone
+         * looked up in his contacts stays on the phone.
+         */
+        fun withRecipientHeldBack(): Ask {
+            if (to.isBlank() || kind == Kind.TYPED_TEXT || kind == Kind.POST) return this
+            return if (asked.contains(to.trim(), ignoreCase = true)) this else copy(to = RECIPIENT_HELD_BACK)
+        }
+    }
+
+    /** What came of asking her. */
+    sealed class Answer {
+        /** She wrote them: every field she was asked for, in her words. */
+        data class Written(val fields: Map<String, String>) : Answer()
+
+        /** She will not send it, or her answer could not be read as the fields she was asked for. */
+        object Refused : Answer()
+
+        /** Her model could not be reached, or she is not on. Nothing came from her. */
+        object Unreachable : Answer()
+    }
+
+    /** Stands in for who it goes to where her route is not given his details. */
+    const val RECIPIENT_HELD_BACK = "someone of his (who it is stays on the phone)"
+
+    /** Her answer when she will not send it. */
+    const val NO = "NO"
+
+    // Her voice, steadier than a chat reply: the answer has a shape that is read.
+    private const val WORDS_TEMPERATURE = 0.7f
+    // Room for a whole email.
+    private const val WORDS_MAX_TOKENS = 1500
+    // Longer than any message he would send by hand; an answer past it is not read as one.
+    private const val MAX_FIELD_CHARS = 6000
+    // The fields that are one line: a subject line, the title of an invitation.
+    private val ONE_LINE_FIELDS = setOf("subject", "title")
+    private val QUOTE_PAIRS = listOf('"' to '"', '\u201C' to '\u201D', '\u300C' to '\u300D')
+
+    /**
+     * Her request for [ask]: her card with his name filled in, then the app's facts about
+     * what these words are ([PersonaPrompts.wordsSystemPrompt]), and one turn of the
+     * app's that says what is about to be sent and asks her for the fields
+     * ([PersonaPrompts.wordsPrompt]). Plain text, read whole. It is marked as hers by the
+     * engine before it goes out.
+     */
+    fun request(card: String, ownerName: String, ask: Ask): LLMRequest = LLMRequest(
+        systemPrompt = PersonaPrompts.wordsSystemPrompt(card, ownerName),
+        messages = listOf(
+            ChatMessage(id = UUID.randomUUID().toString(), text = PersonaPrompts.wordsPrompt(ask), sender = ChatMessage.Sender.USER)
+        ),
+        temperature = WORDS_TEMPERATURE,
+        maxTokens = WORDS_MAX_TOKENS,
+        responseFormat = ResponseFormat.TEXT
+    )
+
+    /**
+     * Reads her answer for [fields]. Only two shapes are taken:
+     *
+     *  - a plain NO, which is her saying she will not send it;
+     *  - every one of [fields], in order, each at the start of a line with its name and a
+     *    colon ("subject: ..."), with nothing before the first. Each field runs to the
+     *    next one, and the last to the end. A subject or a title is one line. No field
+     *    may be empty or a bare NO.
+     *
+     * Anything else, half an answer included, is [Answer.Refused]: words that cannot be
+     * read as hers are not sent. One pair of quotation marks around a whole field is
+     * taken off, the way a chat model wraps a line it was asked to write.
+     */
+    fun read(raw: String, fields: List<String>): Answer {
+        val text = raw.replace("\r\n", "\n").trim()
+        if (fields.isEmpty() || text.isEmpty()) return Answer.Refused
+        if (isNo(text)) return Answer.Refused
+        val written = LinkedHashMap<String, String>()
+        var from = 0
+        var openAt = -1
+        var openField: String? = null
+        for (field in fields) {
+            val label = Regex("""(?im)^[ \t]*${Regex.escape(field)}[ \t]*:""")
+            val found = label.find(text, from) ?: return Answer.Refused
+            if (openField == null) {
+                // Nothing of hers may stand before the first field.
+                if (text.substring(0, found.range.first).isNotBlank()) return Answer.Refused
+            } else {
+                written[openField] = text.substring(openAt, found.range.first)
+            }
+            openField = field
+            openAt = found.range.last + 1
+            from = openAt
+        }
+        written[openField!!] = text.substring(openAt)
+        val cleaned = LinkedHashMap<String, String>()
+        for ((field, value) in written) {
+            val words = unquoted(value.trim())
+            if (words.isEmpty() || isNo(words) || words.length > MAX_FIELD_CHARS) return Answer.Refused
+            if (field.lowercase() in ONE_LINE_FIELDS && '\n' in words) return Answer.Refused
+            cleaned[field] = words
+        }
+        return Answer.Written(cleaned)
+    }
+
+    private fun isNo(text: String): Boolean = text.trim().trimEnd('.', '!').trim().equals(NO, ignoreCase = true)
+
+    private fun unquoted(text: String): String {
+        if (text.length < 2) return text
+        val pair = QUOTE_PAIRS.firstOrNull { (open, close) -> text.first() == open && text.last() == close } ?: return text
+        val inner = text.substring(1, text.length - 1)
+        // A quotation mark inside means the outer ones are not a wrapping pair.
+        return if (pair.first in inner || pair.second in inner) text else inner.trim()
+    }
+
+    // ── The app's rows about it ──────────────────────────────────────────────────────
+
+    /**
+     * Why a step that was to send words was left out of the plan, in the app's words.
+     * [fallback] is the line for a step that itself sends nothing, whose fallback alone
+     * would have sent the words: only the fallback goes, and the step still runs.
+     */
+    enum class LeftOut(val reason: String, val fallback: String? = null) {
+        /** She answered NO, or something that could not be read as the words. */
+        REFUSED(
+            "${PersonaPrompts.BADGE} did not write this, so it was left out.",
+            "${PersonaPrompts.BADGE} did not write the words of its fallback, so the fallback was taken off. The step itself still runs."
+        ),
+
+        /** Her model could not be reached, so nothing came from her. */
+        UNREACHABLE(
+            "${PersonaPrompts.BADGE}'s model could not be reached, so it was not sent.",
+            "${PersonaPrompts.BADGE}'s model could not be reached, so its fallback was taken off. The step itself still runs."
+        ),
+
+        /** The words that asked for the plan are not known here, so nobody's words can be told from a tool's. */
+        NOT_KNOWN(
+            "what was asked for is not known here, so it was left out.",
+            "what was asked for is not known here, so its fallback was taken off. The step itself still runs."
+        ),
+
+        /** Who it goes to, or the field it is typed into, reads as a sentence and not as a name or an address. */
+        UNCLEAR(
+            "who or where it goes could not be read plainly, so it was left out.",
+            "who or where its fallback goes could not be read plainly, so the fallback was taken off. The step itself still runs."
+        ),
+
+        /** It reads the answer of a step that was left out, which will never come. */
+        NEEDED("it needed the answer of a step that was left out, so it was left out too."),
+
+        /** It taps, types or waits on his screen right after typing that was left out, and would act on whatever is there instead. */
+        AFTER_TYPING("it acts on text a step that was left out would have typed, so it was left out too."),
+
+        /** A macro all of whose stored steps were left out. */
+        NOTHING_KEPT("nothing it would keep is left, so it was left out.")
+    }
+
+    /** The line for a step whose words she wrote. [stepLine] names the step as the approval card does. */
+    fun wroteLine(stepLine: String): String = "$stepLine: ${PersonaPrompts.BADGE} wrote the words."
+
+    /** The line for a step left out, and why. */
+    fun leftOutLine(stepLine: String, why: LeftOut): String = "$stepLine: ${why.reason}"
+
+    /** The line for a step that still runs without the fallback that would have sent words, and why. */
+    fun fallbackOffLine(stepLine: String, why: LeftOut): String = "$stepLine: ${why.fallback ?: why.reason}"
+
+    /**
+     * The line for a step left out because it was addressed to a machine that only sends.
+     * [reason] is the app's sentence for why that address is never answered.
+     */
+    fun automatedLine(stepLine: String, reason: String): String = "$stepLine: $reason, so it was left out."
+
+    /** The line for a step that still runs, with an address that only sends taken off it. */
+    fun takenOffLine(stepLine: String, reason: String): String = "$stepLine: $reason, so it was taken off this step."
+
+    /** The line for a step that still runs without its fallback, which would have sent words to a machine that only sends. */
+    fun automatedFallbackLine(stepLine: String, reason: String): String =
+        "$stepLine: $reason, so its fallback was taken off. The step itself still runs."
+
+    /** The line for a step kept in a macro: [macroLine] is the macro's step, [innerLine] the stored step. */
+    fun storedStepLine(macroLine: String, innerLine: String): String = "$macroLine, its step $innerLine"
+
+    private const val CHECKED = "Checked before it runs:"
+    private const val NOTHING_LEFT = "Not run: nothing was left to run."
+
+    /**
+     * The row the chat keeps of what was done to a plan's words before it ran: [lines], one
+     * per step, under a heading. With [nothingLeft] the row opens the way every row for
+     * something that was not run does, so that her next prompt reads it as an outcome.
+     */
+    fun record(lines: List<String>, nothingLeft: Boolean): String = buildString {
+        append(if (nothingLeft) NOTHING_LEFT else CHECKED)
+        lines.forEach { append("\n• ").append(it) }
+    }
+}
