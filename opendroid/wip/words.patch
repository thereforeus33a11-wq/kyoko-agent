+        // The words in another order, or a greeting put in front of a long message, are still his.
+        val reordered = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "sorry, I'll be late"))
+        assertTrue(notTheirs("text mom I'll be late, sorry!", reordered).isEmpty())
+        val long = "tell her the train stopped at the bridge and I will be home around nine tonight with the groceries"
+        val greeted = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "Hey, the train stopped at the bridge and I will be home around nine tonight with the groceries"))
+        assertTrue(notTheirs("text mom $long", greeted).isEmpty())
