+    @Test
+    fun `every action with words for a person is either checked or left out on purpose`() {
+        val wordKeys = setOf("message", "subject", "body", "text", "content", "caption")
+        val unlisted = ActionSchema.ALL_ACTIONS
+            .filter { action -> action.params.any { it.name in wordKeys } }
+            .map { it.name }
+            .filterNot {
+                it in PlanWords.SENDING_ACTIONS || it in PlanApprovalSummary.KEEPS_ITS_TEXT_ON_THE_PHONE || it in PlanWords.LOOKUPS
+            }
+        assertEquals(emptyList<String>(), unlisted)
+        // Opening a link is checked, for the links that fill words in, and is no lookup.
+        assertTrue("OPEN_URL" in PlanWords.SENDING_ACTIONS)
+        assertFalse("OPEN_URL" in PlanWords.LOOKUPS)
+        // Nothing is both sent and kept on the phone.
+        assertTrue((PlanWords.SENDING_ACTIONS intersect PlanApprovalSummary.KEEPS_ITS_TEXT_ON_THE_PHONE).isEmpty())
+        assertTrue((PlanWords.SENDING_ACTIONS intersect PlanWords.LOOKUPS).isEmpty())
+    }
+
+    // ── Who a step goes to ───────────────────────────────────────────────────────────
+
+    @Test
+    fun `a step to an address or a number that only sends is gone`() {
+        for (who in listOf("no-reply@tumblr.com", "Tumblr <noreply@tumblr.com>", "56161", "AX-HDFCBK")) {
+            val action = if ('@' in who) "SEND_EMAIL" else "SEND_SMS"
+            val key = if ('@' in who) "to" else "contact"
+            val addressed = PlanWords.withoutAutomated(step("s1", action, mapOf(key to who, "message" to "ok", "subject" to "re", "body" to "ok")))
+            assertNull(who, addressed.step)
+            assertEquals(who, who, addressed.taken.single().who)
+        }
+        val bot = PlanWords.withoutAutomated(step("s1", "SEND_TELEGRAM", mapOf("contact" to "@weather_bot", "message" to "hi")))
+        assertNull(bot.step)
+        assertEquals("@weather_bot is a bot", bot.taken.single().reason)
+    }
+
+    @Test
+    fun `someone copied in who only sends is taken off, and the step still goes to the people on it`() {
+        val email = step("s1", "SEND_EMAIL", mapOf("to" to "sam@example.com", "cc" to "notifications@github.com, aoi@example.com", "subject" to "a", "body" to "b"))
+        val addressed = PlanWords.withoutAutomated(email)
+        assertNotNull(addressed.step)
+        assertEquals("aoi@example.com", addressed.step!!.params["cc"])
+        assertEquals("notifications@github.com", addressed.taken.single().who)
+        // One of two people it is sent to.
+        val two = PlanWords.withoutAutomated(step("s1", "SEND_EMAIL", mapOf("to" to "no-reply@x.com; sam@example.com", "subject" to "a", "body" to "b")))
+        assertEquals("sam@example.com", two.step!!.params["to"])
+    }
+
+    @Test
+    fun `people are never taken for machines, and calls and payments are not looked at`() {
+        for (who in listOf("Mom", "Aoi", "+81 90 1234 5678", "sam@example.com", "\$s1_ask")) {
+            val sms = step("s1", "SEND_SMS", mapOf("contact" to who, "message" to "hi"))
+            assertEquals(who, sms, PlanWords.withoutAutomated(sms).step)
+        }
+        val emergency = step("s1", "MAKE_CALL", mapOf("contact" to "112"))
+        assertEquals(emergency, PlanWords.withoutAutomated(emergency).step)
+        val payment = step("s1", "PAY_UPI", mapOf("to" to "alerts@okaxis", "amount" to "200"))
+        assertEquals(payment, PlanWords.withoutAutomated(payment).step)
+        assertEquals("PhonePe", notTheirs("pay", payment.copy(params = payment.params + ("note" to "for the tickets, thanks!") + ("app" to "phonepe"))).single().words.app)
+    }
+
+    @Test
+    fun `a call whose fallback would text a machine still runs, without the fallback`() {
+        val emergency = step("s1", "MAKE_CALL", mapOf("contact" to "112", "message" to "help"), fallback = "SEND_SMS")
+        val addressed = PlanWords.withoutAutomated(emergency)
+        assertTrue(addressed.fallbackTakenOff)
+        assertEquals(step("s1", "MAKE_CALL", mapOf("contact" to "112")), addressed.step)
+        assertEquals("112", addressed.taken.single().who)
+        // Where the step itself sends, it goes whole, as before.
+        val sms = step("s1", "SEND_SMS", mapOf("contact" to "112", "message" to "help"), fallback = "MAKE_CALL")
+        assertNull(PlanWords.withoutAutomated(sms).step)
+    }
+
+    @Test
+    fun `every text a plan sends or stores is listed for a later rewrite`() {
+        val steps = listOf(
+            step("s1", "WEB_SEARCH", mapOf("query" to "ramen")),
+            step("s2", "SEND_SMS", mapOf("contact" to "Mom", "message" to "home soon")),
+            step("s3", "CREATE_MACRO", mapOf("name" to "x", "steps" to """[{"action":"SEND_SMS","params":{"contact":"Dad","message":"night"}}]"""))
+        )
+        assertEquals(listOf("home soon", "night"), PlanWords.texts(steps))
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/persona/HerWordsTest.kt b/app/src/test/java/com/opendroid/ai/core/persona/HerWordsTest.kt
