+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.core.persona.HerWords
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.coroutines.CancellationException
+
+/**
+ * What every plan goes through while she is on, before it is shown or run, and again
+ * whenever the planning tool rewrites it: the words it sends are his or hers, and
+ * nothing it sends goes to a machine.
+ *
+ * Step by step:
+ *  - A step addressed to an address or a number that only sends ([AutomatedSender]) is
+ *    left out. Where only one of several people it reaches only sends (someone copied in
+ *    or invited), that one is taken off and the step stays. Where only the step's
+ *    fallback would send (a call that falls back to a text), the fallback is taken off
+ *    and the step itself still runs.
+ *  - A step whose words are not his or hers ([PlanWords]) is put to her: she writes the
+ *    parts that are not theirs herself ([HerWords]), and her words take the place of the
+ *    planning tool's in the step, so the approval card and everything after show hers.
+ *    The parts that were his or hers stay as they were, and what an earlier step gives
+ *    back stays where the plan put it. If she will not write them, or her model cannot
+ *    be reached, the step is left out (or only its fallback, as above). A step whose
+ *    recipient or field cannot be read plainly is not put to her at all.
+ *  - A CREATE_MACRO is held to the same rule for every step it stores, so that a macro
+ *    only ever keeps his words or hers.
+ *  - A step that needs the answer of a step that was left out is left out too; so are
+ *    the taps and typing that would act on the text a left-out step would have typed,
+ *    a question or a talk step that only a step that went or changed needed, and, once
+ *    anything is left out, the talk steps that spoke of the plan as it was written.
+ *
+ * Each of these leaves one plain line ([Result.lines]) for the row the chat keeps. A
+ * plan with nothing left runs nothing.
+ *
+ * Her model is handed in as [run]'s `write`, so that the pass can be tried without one.
+ * Nothing here reads a setting or stores anything: the loop decides when it runs and
+ * stores what comes out.
+ */
+internal object PlanWordsPass {
+
+    /**
+     * Whom a plan was made for and in what words: his message ([HerWords.From.HIM]) or her
+     * command ([HerWords.From.HER]). [words] is what the plan's words are held against.
+     * [shown] is what she is told was asked for, which is [words] unless those must stay
+     * on the phone (a message of his that held a secret).
+     */
+    data class Origin(val askedBy: HerWords.From, val words: String, val shown: String = words)
+
+    /** What the pass made of a plan's steps. */
+    class Result internal constructor(
+        /** The steps as they are to be shown and run. */
+        val steps: List<PlanStep>,
+        /** One plain line for every step that was changed or left out, in the order it was done. */
+        val lines: List<String>,
+        /** The ids of the steps left out. */
+        val leftOut: Set<String>,
+        private val replaced: Map<String, PlanStep>
+    ) {
+        /** Whether anything was changed or left out. */
+        val changed: Boolean get() = leftOut.isNotEmpty() || replaced.isNotEmpty()
+
+        /** Whether nothing of the plan is left to run. */
+        val nothingLeft: Boolean get() = steps.isEmpty()
+
+        /**
+         * The same changes made to [live], the plan's steps as they stand when they are
+         * stored: the steps left out go, the steps changed take their new params and
+         * fallback, and no step keeps waiting on one that went.
+         */
+        fun applyTo(live: List<PlanStep>): List<PlanStep> =
+            live.filterNot { it.stepId in leftOut }.map { step ->
+                val now = replaced[step.stepId]
+                step.copy(
+                    params = now?.params ?: step.params,
+                    fallback = now?.fallback ?: step.fallback,
+                    dependsOn = step.dependsOn.filterNot { it in leftOut }
+                )
+            }
+    }
+
+    /**
+     * Runs the pass over [steps]. [origin] is what the plan was made from; with none, words
+     * that are not already in the plan cannot be told from a tool's and the step is left
+     * out. [write] asks her for words. [only] limits the checks to those step ids (a
+     * rewrite's new and changed steps); every pending step is looked at otherwise. A
+     * rewrite also passes the words the plan already had ([alreadyAllowed]) and what its
+     * steps put out so far ([pasted]). [names] are his name, which no text may add
+     * ([PlanWords.Sources.names]). Steps that are not pending are never touched.
+     */
+    suspend fun run(
+        steps: List<PlanStep>,
+        origin: Origin?,
+        write: suspend (HerWords.Ask) -> HerWords.Answer,
+        only: Set<String>? = null,
+        alreadyAllowed: List<String> = emptyList(),
+        pasted: List<String> = emptyList(),
+        names: List<String> = emptyList()
+    ): Result {
+        val sources = PlanWords.Sources(listOfNotNull(origin?.words) + alreadyAllowed, pasted, names.filter(String::isNotBlank))
+        val lines = ArrayList<String>()
+        val leftOut = LinkedHashSet<String>()
+        val replaced = LinkedHashMap<String, PlanStep>()
+        val pass = Pass(sources, origin, write, lines)
+        val line = { step: PlanStep -> PlanApprovalSummary.stepLine(step, steps) }
+        for (step in steps) {
+            if (step.status != StepStatus.PENDING || (only != null && step.stepId !in only)) continue
+            // One that needs the answer of a step already left out cannot run: it is not put to her.
+            if (leftOut.any { reads(step, it) }) continue
+            val checked = pass.check(step, steps, line(step), depth = 0)
+            when {
+                checked == null -> leftOut += step.stepId
+                checked != step -> replaced[step.stepId] = checked
+            }
+        }
+        leaveOutWhatNeededThem(steps, replaced, leftOut, lines, line)
+        val result = Result(steps, lines, leftOut, replaced)
+        return Result(result.applyTo(steps), lines, leftOut, replaced)
+    }
+
+    private class Pass(
+        val sources: PlanWords.Sources,
+        val origin: Origin?,
+        val write: suspend (HerWords.Ask) -> HerWords.Answer,
+        val lines: MutableList<String>
+    ) {
+        /**
+         * [step], one of [siblings], with no address that only sends and with words that
+         * are his or hers, or null when it is left out. [line] names it in the lines;
+         * [depth] is how many macros down it is stored.
+         */
+        suspend fun check(step: PlanStep, siblings: List<PlanStep>, line: String, depth: Int): PlanStep? {
+            val addressed = PlanWords.withoutAutomated(step)
+            val current = addressed.step
+            val why = addressed.taken.joinToString("; ") { it.reason }
+            if (current == null) {
+                lines += HerWords.automatedLine(line, why)
+                return null
+            }
+            if (addressed.fallbackTakenOff) {
+                lines += HerWords.automatedFallbackLine(line, why)
+            } else {
+                addressed.taken.forEach { lines += HerWords.takenOffLine(line, it.reason) }
+            }
+            val stored = PlanWords.stored(current, depth)
+            val checked = when (stored) {
+                null -> current
+                else -> checkStored(current, stored, line, depth) ?: return null
+            }
+            val words = PlanWords.of(checked, siblings, sources)
+            if (words == null || words.notTheirs.isEmpty()) return checked
+            val asked = origin
+            val notAsked = when {
+                asked == null -> HerWords.LeftOut.NOT_KNOWN
+                !plainEnough(words) -> HerWords.LeftOut.UNCLEAR
+                else -> null
+            }
+            val answer = if (asked == null || notAsked != null) {
+                null
+            } else {
+                try {
+                    write(askFor(words, asked, stored = depth > 0))
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    HerWords.Answer.Unreachable
+                }
+            }
+            val failed = notAsked ?: when (answer) {
+                is HerWords.Answer.Written -> {
+                    lines += HerWords.wroteLine(line)
+                    return PlanWords.withWords(checked, words, answer.fields.filterKeys { it in words.notTheirs })
+                }
+                HerWords.Answer.Refused, null -> HerWords.LeftOut.REFUSED
+                HerWords.Answer.Unreachable -> HerWords.LeftOut.UNREACHABLE
+            }
+            if (words.onlyFallback) {
+                // The step itself does not send: it runs without the fallback that would have.
+                lines += HerWords.fallbackOffLine(line, failed)
+                return PlanWords.withoutFallback(checked)
+            }
+            lines += HerWords.leftOutLine(line, failed)
+            return null
+        }
+
+        /**
+         * [macro], a CREATE_MACRO, with every step it stores checked the way a step of the
+         * plan is, or null when none of them is left.
+         */
+        private suspend fun checkStored(macro: PlanStep, stored: PlanWords.Stored, macroLine: String, depth: Int): PlanStep? {
+            val inner = stored.steps
+            val innerLine = { step: PlanStep -> HerWords.storedStepLine(macroLine, PlanApprovalSummary.stepLine(step, inner)) }
+            val leftOut = LinkedHashSet<String>()
+            val changed = LinkedHashMap<String, PlanStep>()
+            for (step in inner) {
+                if (leftOut.any { reads(step, it) }) continue
+                val checked = check(step, inner, innerLine(step), depth + 1)
+                when {
+                    checked == null -> leftOut += step.stepId
+                    checked != step -> changed[step.stepId] = checked
+                }
+            }
+            leaveOutWhatNeededThem(inner, changed, leftOut, lines, innerLine)
+            if (leftOut.isEmpty() && changed.isEmpty()) return macro
+            val kept = inner.indices.filter { inner[it].stepId !in leftOut }.toSet()
+            if (kept.isEmpty()) {
+                lines += HerWords.leftOutLine(macroLine, HerWords.LeftOut.NOTHING_KEPT)
+                return null
+            }
+            val now = inner.indices.mapNotNull { index -> changed[inner[index].stepId]?.let { index to it } }.toMap()
+            val written = stored.with(kept, now.mapValues { it.value.params }, now.mapValues { it.value.fallback })
+            return macro.copy(params = macro.params + ("steps" to written))
+        }
+    }
+
+    private fun askFor(words: PlanWords.StepWords, origin: Origin, stored: Boolean) = HerWords.Ask(
+        kind = kindOf(words.kind),
+        to = if (words.kind == PlanWords.Kind.TYPED_TEXT) {
+            words.into
+        } else {
+            // A recipient filled in from an earlier step is a number he is asked for when it runs.
+            words.to.joinToString(", ") { if (it.startsWith("$")) ASKED_WHEN_IT_RUNS else it }
+        },
+        through = words.app,
+        askedBy = origin.askedBy,
+        asked = origin.shown,
+        // Only the parts that are not his or hers: the rest stays as it was, and she is told only their names.
+        fields = words.notTheirs,
+        stored = stored,
+        kept = words.fields.filterNot { it in words.notTheirs },
+        fills = words.notTheirs.flatMap { words.fills[it].orEmpty() }.distinctBy { it.token }.map { HerWords.Fill(it.token, it.step) }
+    )
+
+    private const val ASKED_WHEN_IT_RUNS = "someone he names when it runs"
+
+    private fun kindOf(kind: PlanWords.Kind): HerWords.Kind = when (kind) {
+        PlanWords.Kind.EMAIL -> HerWords.Kind.EMAIL
+        PlanWords.Kind.MESSAGE -> HerWords.Kind.MESSAGE
+        PlanWords.Kind.POST -> HerWords.Kind.POST
+        PlanWords.Kind.TYPED_TEXT -> HerWords.Kind.TYPED_TEXT
+        PlanWords.Kind.INVITATION -> HerWords.Kind.INVITATION
+        PlanWords.Kind.PAYMENT_NOTE -> HerWords.Kind.PAYMENT_NOTE
+        PlanWords.Kind.LINK -> HerWords.Kind.LINK
+    }
+
+    // ── Whether who and where can be put to her ─────────────────────────────────────
+
+    /**
+     * Whether what she would be told of who and where the words go is plain: each
+     * recipient an address, a number, a handle or a short name, and the field typed into
+     * a short label or a view id. Those values are the planning tool's; one that reads as
+     * a sentence is its words, and is not put in front of her. (The app the words go
+     * through is always one the app names itself.)
+     */
+    private fun plainEnough(words: PlanWords.StepWords): Boolean =
+        words.to.all(::plainRecipient) && (words.kind != PlanWords.Kind.TYPED_TEXT || plainLabel(words.into))
+
+    private const val MAX_NAMED = 60
+    private const val MAX_NAME_WORDS = 5
+    private val EMAIL = Regex("^[^\\s@<>\"]+@[^\\s@<>\"]+\\.[^\\s@<>\"]+$")
+    private val NAMED_EMAIL = Regex("^[^<>\"\\n]{0,40}<[^\\s@<>\"]+@[^\\s@<>\"]+\\.[^\\s@<>\"]+>$")
+    private val NUMBER = Regex("^\\+?[0-9 ().\\-]{3,24}$")
+    private val HANDLE = Regex("^@[A-Za-z0-9_.\\-]{1,64}$")
+    private val VIEW_ID = Regex("^[A-Za-z0-9_.:/\\-]{1,60}$")
+    private val ABBREVIATIONS = setOf("dr.", "mr.", "mrs.", "ms.", "st.", "jr.", "sr.")
+    private val NAME_MARKS = setOf('\''.code, '’'.code, '-'.code, '&'.code, '_'.code, '('.code, ')'.code, 0x200D)
+    private val NAME_TYPES = setOf(
+        Character.NON_SPACING_MARK.toInt(), Character.COMBINING_SPACING_MARK.toInt(), Character.ENCLOSING_MARK.toInt(),
+        Character.OTHER_SYMBOL.toInt(), Character.MODIFIER_SYMBOL.toInt()
+    )
+
+    /** Whether [who], one person a step goes to as the step names them, reads as an address, a number, a handle or a name. */
+    internal fun plainRecipient(who: String): Boolean {
+        val text = who.trim()
+        if (text.isEmpty() || text.length > MAX_NAMED || '\n' in text) return false
+        // Filled in from an earlier step when it runs: she is told only that he names them then.
+        if (text.startsWith("$")) return true
+        return EMAIL.matches(text) || NAMED_EMAIL.matches(text) || HANDLE.matches(text) ||
+            (NUMBER.matches(text) && text.count(Char::isDigit) >= 3) || plainName(text)
+    }
+
+    /** Whether [label], the field text is typed into, reads as a label on his screen or a view id. None at all is plain. */
+    internal fun plainLabel(label: String): Boolean {
+        val text = label.trim()
+        if (text.isEmpty()) return true
+        if (text.length > MAX_NAMED || '\n' in text) return false
+        return VIEW_ID.matches(text) || plainName(text)
+    }
+
+    /** A name of a few words: letters, digits, marks and the odd symbol, and no sentence in it. */
+    private fun plainName(text: String): Boolean {
+        val words = text.split(' ').filter(String::isNotEmpty)
+        if (words.isEmpty() || words.size > MAX_NAME_WORDS) return false
+        return words.all { word ->
+            val bare = if (word.lowercase() in ABBREVIATIONS) word.dropLast(1) else word
+            bare.codePoints().allMatch { cp -> Character.isLetterOrDigit(cp) || cp in NAME_MARKS || Character.getType(cp) in NAME_TYPES }
+        }
+    }
+
+    // ── What else goes with a step that was left out ─────────────────────────────────
+
+    // The id PlanValidator gives a question it queues for a step: "<step>_ask", "<step>_ask2".
+    private val ASK_STEP_ID = Regex("^(.+)_ask\\d*$")
+
+    /**
+     * Adds to [leftOut] every pending step of [steps] that can no longer run, or no longer
+     * means anything, because of what was left out or [changed], repeated until nothing
+     * more goes:
+     *  - a step that reads the answer of one that is gone (with a line);
+     *  - a tap, a keypress, a scroll, a wait or more typing that follows, on his screen,
+     *    text a left-out step would have typed: it would act on whatever is in the box
+     *    instead (with a line);
+     *  - a question the app queued only for a step that is gone, and a question or talk
+     *    step that a step read before and none reads now (with none: nobody's step);
+     *  - once anything at all is left out, every talk step nothing reads: it spoke of the
+     *    plan as the planning tool wrote it, which is no longer the plan (with none).
+     */
+    private fun leaveOutWhatNeededThem(
+        steps: List<PlanStep>,
+        changed: Map<String, PlanStep>,
+        leftOut: MutableSet<String>,
+        lines: MutableList<String>,
+        line: (PlanStep) -> String
+    ) {
+        if (leftOut.isEmpty() && changed.isEmpty()) return
+        val now = { step: PlanStep -> changed[step.stepId] ?: step }
+        val pending = { step: PlanStep -> step.stepId !in leftOut && step.status == StepStatus.PENDING }
+        val readBefore = steps.filter { target -> steps.any { it.stepId != target.stepId && reads(it, target.stepId) } }.map { it.stepId }.toSet()
+        val readNow = { id: String -> steps.any { it.stepId != id && it.stepId !in leftOut && reads(now(it), id) } }
+        val inOrder = steps.sortedBy { it.order }
+        var more = true
+        while (more) {
+            more = false
+            for (step in inOrder) {
+                if (!pending(step)) continue
+                val why = when {
+                    leftOut.any { reads(now(step), it) } -> HerWords.LeftOut.NEEDED
+                    afterLeftOutTyping(step, inOrder, leftOut) -> HerWords.LeftOut.AFTER_TYPING
+                    else -> null
+                }
+                val owner = ASK_STEP_ID.matchEntire(step.stepId)?.groupValues?.get(1)
+                val queuedFor = PlanWords.asks(step) && owner != null && owner in leftOut
+                val noLongerRead = (PlanWords.asks(step) || PlanWords.talks(step)) && step.stepId in readBefore
+                if (why != null) {
+                    leftOut += step.stepId
+                    lines += HerWords.leftOutLine(line(step), why)
+                    more = true
+                } else if ((queuedFor || noLongerRead) && !readNow(step.stepId)) {
+                    leftOut += step.stepId
+                    more = true
+                }
+            }
+        }
+        if (leftOut.isEmpty()) return
+        steps.filter { pending(it) && PlanWords.talks(it) && !readNow(it.stepId) }.forEach { leftOut += it.stepId }
+    }
+
+    /**
+     * Whether [step] acts on his screen right after typing that was left out: between the
+     * two there is nothing but more such steps.
+     */
+    private fun afterLeftOutTyping(step: PlanStep, inOrder: List<PlanStep>, leftOut: Set<String>): Boolean {
+        if (!PlanWords.actsOnScreen(step)) return false
+        var i = inOrder.indexOf(step) - 1
+        while (i >= 0) {
+            val before = inOrder[i]
+            if (before.stepId in leftOut && PlanWords.types(before)) return true
+            if (!PlanWords.actsOnScreen(before)) return false
+            i--
+        }
+        return false
+    }
+
+    /** Whether [step] reads the answer of the step [id], as the executor fills "$id" and "$$id" in. */
+    private fun reads(step: PlanStep, id: String): Boolean {
+        val reference = Regex("\\$" + Regex.escape(id) + "(?![A-Za-z0-9_])")
+        return step.params.values.any { reference.containsMatchIn(it) }
+    }
+}
