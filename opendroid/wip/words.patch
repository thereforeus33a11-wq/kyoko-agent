+    @Test
+    fun `an answer kept in words that are not his is a fill, and goes back where it was`() {
+        val weather = step("s1", "GET_WEATHER", mapOf("location" to "Osaka"))
+        val sms = step("s2", "SEND_SMS", mapOf("contact" to "Wife", "message" to "Today's weather: \$\$s1"))
+        val words = PlanWords.notTheirs(listOf(weather, sms), his("text my wife the weather")).single().words
+        assertEquals(listOf("message"), words.notTheirs)
+        assertEquals(listOf(PlanWords.Fill("{answer 1}", "\$\$s1", "Get weather")), words.fills["message"])
+        // Her words with the mark: the mark is the reference again.
+        assertEquals("hey love, {answer 1}".replace("{answer 1}", "\$\$s1"),
+            PlanWords.withWords(sms, words, mapOf("message" to "hey love, { Answer 1 }")).params["message"])
+        // Her words without it: the reference goes at the end, so the forecast still goes.
+        assertEquals("hey love, here's the weather \$\$s1", PlanWords.withWords(sms, words, mapOf("message" to "hey love, here's the weather")).params["message"])
+        // A field she was not asked for is not written.
+        assertEquals(sms, PlanWords.withWords(sms, words, mapOf("contact" to "someone else")))
+    }
