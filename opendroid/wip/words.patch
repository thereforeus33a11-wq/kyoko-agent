+/**
+ * Whose words a plan sends: his message or her command passes, a tool's composition does
+ * not, and only words that go to a person, a site or another app are looked at.
+ */
+class PlanWordsTest {
+
+    private fun step(id: String, action: String, params: Map<String, String> = emptyMap(), fallback: String = "") = PlanStep(
+        stepId = id,
+        order = id.filter(Char::isDigit).toIntOrNull() ?: 1,
+        description = "the planner's own words about the step",
+        action = action,
+        params = params,
+        fallback = fallback
+    )
+
+    private fun his(message: String) = PlanWords.Sources(listOf(message))
+
+    private fun notTheirs(message: String, vararg steps: PlanStep) = PlanWords.notTheirs(steps.toList(), his(message))
+
+    // ── His words and hers pass ──────────────────────────────────────────────────────
+
+    @Test
+    fun `his words, as he wrote them, pass`() {
+        val sms = step("s1", "SEND_SMS", mapOf("contact" to "Mom", "message" to "I'll be late, sorry!"))
+        assertTrue(notTheirs("text mom I'll be late, sorry!", sms).isEmpty())
+        // Her command passes the same way.
+        val hers = step("s1", "SEND_TELEGRAM", mapOf("contact" to "@nene", "message" to "where are you"))
+        assertTrue(notTheirs("text nene: where are you", hers).isEmpty())
+    }
+
+    @Test
