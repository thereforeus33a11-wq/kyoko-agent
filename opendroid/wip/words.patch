+package com.opendroid.ai.core.agent
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Addresses and numbers that only send are never answered; people are. */
+class AutomatedSenderTest {
+
+    @Test
+    fun `no-reply and notification addresses only send`() {
+        listOf(
+            "no-reply@tumblr.com",
+            "noreply@github.com",
+            "do-not-reply@example.co.jp",
+            "DoNotReply@bank.example",
+            "notifications@tumblr.com",
+            "notification+abc123@facebookmail.com",
+            "MAILER-DAEMON@mx.example.com",
+            "postmaster@example.org",
+            "newsletter@shop.example",
+            "bounce-12345@example.net",
+            "comments-noreply@docs.google.com",
+            "drive-shares-noreply@google.com",
+            "Tumblr <no-reply@tumblr.com>"
+        ).forEach { assertTrue(it, AutomatedSender.isAutomated(it)) }
+    }
+
+    @Test
+    fun `bulk-mail subdomains only send`() {
+        assertTrue(AutomatedSender.isAutomated("hello@em.tumblr.com"))
+        assertTrue(AutomatedSender.isAutomated("team@notify.example.jp"))
+        assertTrue(AutomatedSender.isAutomated("x@bounces.google.com"))
+    }
+
+    @Test
+    fun `people's addresses are answered`() {
+        listOf(
+            "aoi.sato@gmail.com",
+            "boss@company.co.jp",
+            "support@shop.example",
+            "info@ramen-ya.example",
+            "s1234567@mail.utoronto.ca",
+            "student@email.arizona.edu",
+            "me@mail.com",
+            "kenji+work@example.com"
+        ).forEach { assertNull(it, AutomatedSender.reason(it)) }
+    }
+
+    @Test
+    fun `short codes and sender ids only send, phone numbers are people`() {
+        assertTrue(AutomatedSender.isAutomated("12345"))
+        assertTrue(AutomatedSender.isAutomated("226-26"))
+        assertTrue(AutomatedSender.isAutomated("VM-HDFCBK"))
+        assertFalse(AutomatedSender.isAutomated("090-1234-5678"))
+        assertFalse(AutomatedSender.isAutomated("+81 90 1234 5678"))
+        assertFalse(AutomatedSender.isAutomated("(555) 123-4567"))
+    }
+
+    @Test
+    fun `contact names and plain words are never automated`() {
+        listOf("Mom", "Aoi", "Tanaka-sensei", "boss", "", "   ", null).forEach {
+            assertFalse(it.toString(), AutomatedSender.isAutomated(it))
+        }
+    }
+
+    @Test
+    fun `bot handles only send`() {
+        assertTrue(AutomatedSender.isAutomated("@BotFather"))
+        assertTrue(AutomatedSender.isAutomated("@weather_bot"))
+        assertTrue(AutomatedSender.isAutomated("@noreply_alerts"))
+        assertFalse(AutomatedSender.isAutomated("@aoi_sato"))
+        assertFalse(AutomatedSender.isAutomated("@robbie"))
+    }
+
+    @Test
+    fun `the reason names the address`() {
+        val reason = AutomatedSender.reason("no-reply@tumblr.com")
+        assertTrue(reason!!.contains("no-reply@tumblr.com"))
+    }
+}
