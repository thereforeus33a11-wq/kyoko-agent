+    @Test
+    fun `an answer that is only the plan's own words given back is held to his words`() {
+        val draft = "Hello Tumblr Support, I am writing because my blog was flagged by mistake. Best regards, Ren"
+        val talk = step("s1", "CHAT", mapOf("response" to draft))
+        val email = step("s2", "SEND_EMAIL", mapOf("to" to "support@tumblr.com", "subject" to "\$\$s1", "body" to "\$\$s1"))
+        val found = PlanWords.notTheirs(listOf(talk, email), his("email tumblr support about my blog")).single()
+        assertEquals(listOf("subject", "body"), found.words.notTheirs)
+        // Nothing of a talk step is a fill: its words were the planning tool's.
+        assertTrue(found.words.fills.isEmpty())
+        assertTrue(PlanWords.echoes(talk, listOf(talk, email)))
+        // A talk step that shows his own words passes on his words.
+        val shown = step("s1", "DISPLAY_INFO", mapOf("message" to "see you at nine"))
+        val sms = step("s2", "SEND_SMS", mapOf("contact" to "Sam", "message" to "\$\$s1"))
+        assertTrue(PlanWords.notTheirs(listOf(shown, sms), his("text sam see you at nine")).isEmpty())
+        // Copied to the clipboard and read back: the words copied are what is checked.
+        val copy = step("s1", "COPY_TO_CLIPBOARD", mapOf("text" to draft))
+        val read = step("s2", "GET_CLIPBOARD")
+        val paste = step("s3", "SEND_SMS", mapOf("contact" to "Sam", "message" to "\$\$s2"))
+        assertEquals(1, PlanWords.notTheirs(listOf(copy, read, paste), his("text sam about my blog")).size)
+        assertTrue(PlanWords.echoes(read, listOf(copy, read, paste)))
+        // The clipboard with nothing the plan put there is the phone's, and so is a lookup.
+        assertFalse(PlanWords.echoes(read, listOf(read, paste)))
+        assertFalse(PlanWords.echoes(step("s1", "GET_WEATHER", mapOf("location" to "Osaka")), emptyList()))
+    }
