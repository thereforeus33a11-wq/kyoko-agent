+package com.opendroid.ai.core.agent
+
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+import java.net.URLDecoder
+import java.net.URLEncoder
+import java.text.Normalizer
+import java.util.Locale
+
+/**
+ * Whose words a plan sends.
+ *
+ * A plan is written by the planning tool, and the words a step sends (a message, an
+ * email, a post, text typed into another app, an invitation) are in its params. Before
+ * the plan runs, every such text is held against the words it may come from: the
+ * message the plan was made for, or the command it was made from. A text that is those
+ * words, or nearly, passes. One that is not was composed by the tool, and must not go
+ * out as it stands ([notTheirs]).
+ *
+ * Which texts count is decided here and only here, by what the action does with them:
+ *  - words sent to a person, posted where others read them, or typed into another app
+ *    ([SENDERS]), resolved the way the approval card resolves an action
+ *    ([PlanApprovalSummary.resolved]) so that an alias counts as what it will run;
+ *  - an invitation only when it invites somebody;
+ *  - the words a link fills into the page it opens: a share or compose link such as
+ *    `wa.me/<number>?text=` or `twitter.com/intent/tweet?text=` ([linkOf]);
+ *  - the words a CREATE_MACRO stores, which go out later each time the macro runs.
+ * Search and lookup words (a web search, the weather, news, a translation, a fact check,
+ * a sum, music or a video to play, a plain link to open), labels to tap, the clipboard,
+ * and everything [PlanApprovalSummary.KEEPS_ITS_TEXT_ON_THE_PHONE] lists, are not sent
+ * to anybody and are left alone on purpose ([LOOKUPS]).
+ *
+ * An earlier step's answer that a text carries ("$$s1") is the phone's own output and
+ * passes, unless that step only gives back words the plan itself gave it (a talk step, a
+ * note, the clipboard): then those words are what is checked ([echoedWords]).
+ *
+ * The same place says who a step is addressed to, and takes out every address that only
+ * sends ([withoutAutomated], [AutomatedSender]): nothing is sent to a machine.
+ *
+ * Everything here is pure: steps in, steps and texts out.
+ */
+object PlanWords {
+
+    /** What kind of words a step sends. */
+    enum class Kind { EMAIL, MESSAGE, POST, TYPED_TEXT, INVITATION, PAYMENT_NOTE, LINK }
+
+    /**
+     * How one action sends words. [app] is the app they go through, read off the step
+     * where the step says. [wordKeys] are the params the handler reads them from, and
+     * [required] the ones it needs: a required one that is missing still has to be
+     * written. [sends] says whether the step reaches anybody at all (an invitation with
+     * nobody invited stays in his calendar). [addressed] says the step has a recipient to
+     * check.
+     */
+    private class Sender(
+        val kind: Kind,
+        val app: (Map<String, String>) -> String,
+        val wordKeys: List<String>,
+        val required: List<String> = emptyList(),
+        val sends: (Map<String, String>) -> Boolean = { true },
+        val addressed: Boolean = true
+    )
+
+    /** Params that carry words on any action that sends: a handler may read more than one of them. */
+    private val GENERIC_WORD_KEYS = listOf("message", "subject", "body", "text", "content", "caption")
+
+    private fun named(name: String): (Map<String, String>) -> String = { name }
+
+    /**
+     * The platforms a post goes to, by the names the action takes, as they are said. A
+     * platform the step names that is none of these is not named at all: the value is the
+     * planning tool's, and only a name from this list is passed on.
+     */
+    private val PLATFORMS = mapOf(
+        "x" to "X", "twitter" to "X", "instagram" to "Instagram", "linkedin" to "LinkedIn", "telegram" to "Telegram",
+        "discord" to "Discord", "facebook" to "Facebook", "youtube" to "YouTube", "threads" to "Threads",
+        "reddit" to "Reddit", "tumblr" to "Tumblr", "bluesky" to "Bluesky", "mastodon" to "Mastodon"
+    )
+
+    /** The payment apps PAY_UPI opens, by the names the action takes. */
+    private val PAYMENT_APPS = mapOf("gpay" to "Google Pay", "googlepay" to "Google Pay", "phonepe" to "PhonePe", "paytm" to "Paytm")
+
+    /** [value] as one of [names] says it, or [otherwise] for anything that is not one of them. */
+    private fun oneOf(names: Map<String, String>, value: String?, otherwise: String): String =
+        value?.lowercase(Locale.ROOT)?.filter(Char::isLetterOrDigit)?.let(names::get) ?: otherwise
+
+    /** Every action that sends words, by the name the dispatcher runs it as. */
+    private val SENDERS: Map<String, Sender> = mapOf(
+        "SEND_SMS" to Sender(Kind.MESSAGE, named("SMS"), listOf("message", "text", "body")),
+        "SEND_WHATSAPP" to Sender(Kind.MESSAGE, named("WhatsApp"), listOf("message")),
+        "SEND_WHATSAPP_GROUP" to Sender(Kind.MESSAGE, named("WhatsApp"), listOf("message")),
+        "SEND_TELEGRAM" to Sender(Kind.MESSAGE, named("Telegram"), listOf("message", "text", "body")),
+        // Subject and body are both required by the action: a missing one is written, not left blank.
+        "SEND_EMAIL" to Sender(Kind.EMAIL, named("his email app"), listOf("subject", "body"), required = listOf("subject", "body")),
+        "TYPE_TEXT" to Sender(Kind.TYPED_TEXT, named("the app on his screen"), listOf("content"), addressed = false),
+        "TYPE_ID" to Sender(Kind.TYPED_TEXT, named("the app on his screen"), listOf("content"), addressed = false),
+        // A post with no words of its own still has to have them written.
+        "SOCIAL_CREATE_POST" to Sender(
+            Kind.POST, { params -> if (params["platform"].isNullOrBlank()) "X" else oneOf(PLATFORMS, params["platform"], "") },
+            listOf("content"), required = listOf("content"), addressed = false
+        ),
+        "CREATE_CALENDAR_EVENT" to Sender(
+            Kind.INVITATION, named("his calendar"), listOf("title", "description"),
+            required = listOf("title"), sends = { params -> INVITEE_KEYS.any { !params[it].isNullOrBlank() } }
+        ),
+        // A payment is not answering anybody, so its payee is not checked; its note is read by the payee.
+        "PAY_UPI" to Sender(
+            Kind.PAYMENT_NOTE, { params -> oneOf(PAYMENT_APPS, params["app"], "UPI") }, listOf("note"), addressed = false
+        )
+    )
+
+    /** Who an invitation goes to. */
+    private val INVITEE_KEYS = listOf("attendees", "invitees", "guests", "people")
+
+    /**
+     * Actions whose words go to a search engine or a service, or that only open or play
+     * something: not sent to a person, and so not checked. Listed so that a test can tell
+     * an action left out on purpose from one nobody thought of. A link to open is checked
+     * when it is a share or compose link ([LINK_ACTION]), and only then.
+     */
+    internal val LOOKUPS = setOf(
+        "WEB_SEARCH", "GET_WEATHER", "GET_NEWS", "TRANSLATE", "FACT_CHECK", "CALCULATE", "DEFINE_WORD",
+        "SUMMARIZE_URL", "CONVERT_UNITS", "CURRENCY_CONVERT", "CHECK_STOCK", "PLAY_MUSIC", "PLAY_YOUTUBE",
+        "SEARCH_AMAZON", "SEARCH_FLIPKART", "GET_DIRECTIONS", "CHECK_TRAFFIC", "CHECK_FLIGHT",
+        "TRACK_DELIVERY", "ORDER_FOOD", "ORDER_GROCERY", "ADD_TO_CART"
+    )
+
+    /** The action that opens a link: it sends words only when the link fills them into a page ([linkOf]). */
+    private const val LINK_ACTION = "OPEN_URL"
+
+    /** The actions checked here. */
+    internal val SENDING_ACTIONS: Set<String> get() = SENDERS.keys + LINK_ACTION
+
+    /** Where a step's recipient may stand: the keys the approval card names, and a few the planner also uses. */
+    private val RECIPIENT_KEYS = (PlanApprovalSummary.RECIPIENT_KEYS + listOf("email", "emailAddress", "handle")).distinct()
+
+    /** Who else a step reaches: copied in or invited. An address that only sends is taken off; the step still runs. */
+    private val OTHER_PEOPLE_KEYS = (PlanApprovalSummary.OTHER_PEOPLE_KEYS + INVITEE_KEYS).distinct()
+
+    private const val MACRO = "CREATE_MACRO"
+    private const val MAX_MACRO_DEPTH = 3
+
+    // ── Where words may come from ────────────────────────────────────────────────────
+
+    /**
+     * The texts a plan's words may come from. [words] are his message or her command,
+     * and, when a running plan is rewritten, the words it already had: a text passes when
+     * it is one of them or nearly. [pasted] is what the phone itself put out while the
+     * plan ran (the results of its steps): only a stretch copied from it word for word
+     * counts, never words that merely occur in it somewhere. [names] are his name: a text
+     * that has one of them where the words it comes from do not was signed or addressed
+     * by somebody else, however close the rest of it is.
+     */
+    data class Sources(val words: List<String>, val pasted: List<String> = emptyList(), val names: List<String> = emptyList())
+
+    /**
+     * A place in a text where the phone puts in what an earlier step gives back when it
+     * runs. [reference] is the reference as the step holds it ("$$s1"); [token] is the
+     * plain mark that stands for it while the words are written again ("{answer 1}"),
+     * and is put back as [reference] ([withWords]); [step] names the action of the step
+     * it comes from the way the card does ("Get weather"), or says only "an earlier step"
+     * for an action the app does not know.
+     */
+    data class Fill(val token: String, val reference: String, val step: String)
+
+    /** The words one step sends, as the step holds them now. */
+    data class StepWords(
+        val stepId: String,
+        /** The action the step runs as. */
+        val action: String,
+        val kind: Kind,
+        /** The app the words go through. */
+        val app: String,
+        /** Who the step is addressed to, as it names them; empty for a post or typed text. */
+        val to: List<String>,
+        /** Every param that carries the words, in the order they are written. */
+        val fields: List<String>,
+        /** What those params hold now; a field that is not there is blank. */
+        val texts: Map<String, String>,
+        /** The fields whose words are neither in the sources, or that are missing and needed. */
+        val notTheirs: List<String>,
+        /** For text typed into another app, the field it goes into. */
+        val into: String = "",
+        /**
+         * Only the step's fallback sends these words: the step itself does something else
+         * (a call, say), and runs whatever becomes of them.
+         */
+        val onlyFallback: Boolean = false,
+        /** For each field in [notTheirs], the earlier steps' answers the phone puts into it. */
+        val fills: Map<String, List<Fill>> = emptyMap(),
+        /** For the words of a link, the key of the link's query each field is read from. */
+        val linkKeys: Map<String, String> = emptyMap()
+    )
+
+    /** A step whose words are not theirs, and where it stands: in the plan, or [inMacro] stored inside a macro step. */
+    data class Found(val step: PlanStep, val inMacro: Int?, val words: StepWords)
+
+    /**
+     * Every step of [steps] that would send words that are not in [sources], with the
+     * stored steps of a CREATE_MACRO among them. Only pending steps count: what has run
+     * has run.
+     */
+    fun notTheirs(steps: List<PlanStep>, sources: Sources): List<Found> =
+        steps.filter { it.status == StepStatus.PENDING }.flatMap { step ->
+            val own = of(step, steps, sources)?.takeIf { it.notTheirs.isNotEmpty() }?.let { listOf(Found(step, null, it)) }.orEmpty()
+            val stored = stored(step)?.let { macro ->
+                macro.steps.mapIndexedNotNull { index, inner ->
+                    of(inner, macro.steps, sources)?.takeIf { it.notTheirs.isNotEmpty() }?.let { Found(step, index, it) }
+                }
+            }.orEmpty()
+            own + stored
+        }
+
+    /**
+     * The words [step], one of [steps], sends, or null when it sends none. Its action and
+     * its fallback both count: a fallback runs with the same params. When only the
+     * fallback sends ([StepWords.onlyFallback]), the params the step's own action takes
+     * are not its words. [StepWords.notTheirs] holds the fields that are not in
+     * [sources], or that are missing and needed.
+     */
+    fun of(step: PlanStep, steps: List<PlanStep>, sources: Sources): StepWords? {
+        val acts = actionsOf(step)
+        val (primary, primaryParams) = acts.first()
+        if (primary == LINK_ACTION) return linkWords(step, primaryParams, steps, sources)
+        val sending = acts.mapNotNull { (action, params) ->
+            SENDERS[action]?.takeIf { it.sends(params) }?.let { Triple(action, it, params) }
+        }
+        if (sending.isEmpty()) return null
+        val onlyFallback = SENDERS[primary]?.sends(primaryParams) != true
+        val (action, sender, params) = sending.first()
+        val present = { key: String -> !params[key].isNullOrBlank() }
+        val required = sending.flatMap { it.second.required }.distinct()
+        val ownKeys = if (onlyFallback) declaredKeys(primary) else emptySet()
+        val fields = (sending.flatMap { it.second.wordKeys }.filter { present(it) || it in required } +
+            GENERIC_WORD_KEYS.filter(present)).distinct().filterNot { it in ownKeys }
+        if (fields.isEmpty()) return null
+        val texts = fields.associateWith { params[it].orEmpty() }
+        val (notTheirs, fills) = judged(texts, steps, sources)
+        val to = if (sending.any { it.second.addressed }) {
+            (RECIPIENT_KEYS + OTHER_PEOPLE_KEYS).mapNotNull { params[it]?.trim()?.takeIf(String::isNotEmpty) }.distinct()
+        } else {
+            emptyList()
+        }
+        return StepWords(
+            stepId = step.stepId,
+            action = action,
+            kind = sender.kind,
+            app = sender.app(params),
+            to = to,
+            fields = fields,
+            texts = texts,
+            notTheirs = notTheirs,
+            into = if (sender.kind == Kind.TYPED_TEXT) (params["searchText"] ?: params["viewId"]).orEmpty().trim() else "",
+            onlyFallback = onlyFallback,
+            fills = fills
+        )
+    }
+
+    /** Every text [steps] send or store to be sent, whoever wrote it, in step order. */
+    fun texts(steps: List<PlanStep>): List<String> = steps.flatMap { step ->
+        val own = of(step, steps, Sources(emptyList()))?.texts?.values.orEmpty()
+        val stored = stored(step)?.let { macro -> texts(macro.steps) }.orEmpty()
+        own + stored
+    }.filter(String::isNotBlank)
+
+    /** The action [step] runs as and its fallback, each with the params it runs with. */
+    private fun actionsOf(step: PlanStep): List<Pair<String, Map<String, String>>> =
+        listOfNotNull(
+            PlanApprovalSummary.resolved(step.action, step.params),
+            step.fallback.takeIf { it.isNotBlank() }?.let { PlanApprovalSummary.resolved(it, step.params) }
+        )
+
+    /** The params [action] declares, from its schema entry; none for an action that has no entry. */
+    private fun declaredKeys(action: String): Set<String> =
+        ActionSchema.getAction(action)?.params.orEmpty().map { it.name }.toSet()
+
+    /**
+     * Which of [texts] (field to text) are not in [sources], and for each of those, the
+     * earlier steps' answers the phone puts into it, numbered once for the whole step. On
+     * a rewrite, an answer of a step that has run may be in a text as it is rather than as
+     * a reference ([pastedAnswers]); it is kept the same way.
+     */
+    private fun judged(texts: Map<String, String>, steps: List<PlanStep>, sources: Sources): Pair<List<String>, Map<String, List<Fill>>> {
+        val ids = steps.map { it.stepId }
+        val notTheirs = ArrayList<String>()
+        val answers = LinkedHashMap<String, List<Answer>>()
+        for ((field, text) in texts) {
+            val checked = forChecking(text, steps)
+            if (text.isBlank() || !isTheirs(checked.text, sources, ids)) {
+                notTheirs += field
+                answers[field] = (checked.answers + pastedAnswers(text, steps)).distinctBy { it.reference }
+            }
+        }
+        val numbers = LinkedHashMap<String, Int>()
+        val fills = answers.mapValues { (_, found) ->
+            found.map { answer ->
+                val number = numbers.getOrPut(answer.stepId) { numbers.size + 1 }
+                Fill("{answer $number}", answer.reference, answer.step)
+            }
+        }.filterValues { it.isNotEmpty() }
+        return notTheirs to fills
+    }
+
+    // ── Writing words into a step ────────────────────────────────────────────────────
+
+    /**
+     * [step] with [written] (field to words) in place of the words [words] found in it.
+     * Every mark of a [Fill] in the new words is put back as the reference it stands for,
+     * and a reference a field held that the new words leave out is put at their end: what
+     * an earlier step gives back still goes where the plan meant it to. A field is written
+     * to the param it was read from; the words of a link go back into the link.
+     */
+    fun withWords(step: PlanStep, words: StepWords, written: Map<String, String>): PlanStep {
+        val now = written.filterKeys { it in words.fields }.mapValues { (field, text) -> withAnswersPutBack(field, text, words) }
+        if (now.isEmpty()) return step
+        if (words.linkKeys.isNotEmpty()) {
+            val url = PlanApprovalSummary.resolved(step.action, step.params).second["url"] ?: return step
+            val key = step.params.entries.firstOrNull { it.value == url }?.key ?: "url"
+            val byKey = now.mapKeys { (field, _) -> words.linkKeys.getValue(field) }
+            return step.copy(params = step.params + (key to withLinkWords(url, byKey)))
+        }
+        val params = step.params.toMutableMap()
+        for ((field, text) in now) {
+            val old = words.texts[field].orEmpty()
+            val key = if (field in params) field else params.entries.firstOrNull { (_, value) -> old.isNotBlank() && value == old }?.key ?: field
+            params[key] = text
+        }
+        return step.copy(params = params)
+    }
+
+    // Fields that are one line: a reference put back goes on the same line.
+    private val ONE_LINE_FIELDS = setOf("subject", "title")
+
+    private fun withAnswersPutBack(field: String, text: String, words: StepWords): String {
+        var out = text
+        for (fill in words.fills.values.flatten().distinctBy { it.token }) {
+            out = markOf(fill.token).replace(out) { fill.reference }
+        }
+        val missing = words.fills[field].orEmpty().filterNot { fill ->
+            Regex(Regex.escape(fill.reference) + "(?![A-Za-z0-9_])").containsMatchIn(out)
+        }
+        if (missing.isEmpty()) return out
+        val gap = if (field.lowercase(Locale.ROOT) in ONE_LINE_FIELDS || '\n' !in out) " " else "\n\n"
+        return out.trimEnd() + gap + missing.joinToString(" ") { it.reference }
+    }
+
+    /** The mark [token] ("{answer 1}") as it may come back: in any case, with any space inside the braces. */
+    private fun markOf(token: String): Regex {
+        val inner = token.removePrefix("{").removeSuffix("}").trim().split(' ').filter(String::isNotEmpty)
+        return Regex("\\{\\s*" + inner.joinToString("\\s*") { Regex.escape(it) } + "\\s*\\}", RegexOption.IGNORE_CASE)
+    }
+
+    /**
+     * [step] without its fallback, for a step whose fallback alone would send and may not:
+     * the step itself still runs. The words only the fallback would have sent go with it,
+     * where the step's own action is known not to take them.
+     */
+    fun withoutFallback(step: PlanStep): PlanStep {
+        if (step.fallback.isBlank()) return step
+        val primary = PlanApprovalSummary.resolved(step.action, step.params).first
+        val fallback = PlanApprovalSummary.resolved(step.fallback, step.params).first
+        val own = declaredKeys(primary)
+        val its = if (own.isEmpty()) emptySet() else (SENDERS[fallback]?.wordKeys.orEmpty() + GENERIC_WORD_KEYS).filterNot { it in own }.toSet()
+        return step.copy(fallback = "", params = step.params - its)
+    }
+
+    // ── Words a step only gives back ─────────────────────────────────────────────────
+
+    /** Actions whose answer is the words they were given: what they show, keep or copy. */
+    private val GIVES_BACK_ITS_WORDS = setOf("CHAT", "DISPLAY_INFO", "COPY_TO_CLIPBOARD", "ADD_NOTE", "SET_REMINDER", "CREATE_TASK", "WRITE_FILE")
+    private val TALK_ACTIONS = setOf("CHAT", "DISPLAY_INFO")
+    private val TYPING_ACTIONS = setOf("TYPE_TEXT", "TYPE_ID")
+    /** Steps that act on whatever is on his screen: they tap, type, scroll or wait there. */
+    private val SCREEN_ACTIONS = setOf("CLICK_TEXT", "CLICK_ID", "CLICK_COORDINATES", "PRESS_ENTER", "SCROLL", "WAIT") + TYPING_ACTIONS
+    /** Where such a step holds the words it gives back. */
+    private val GIVEN_BACK_KEYS = listOf(
+        "message", "response", "text", "content", "info", "notification", "warning", "status",
+        "body", "subject", "title", "description", "note", "label", "caption"
+    )
+    private const val MAX_ECHO_DEPTH = 3
+
+    /**
+     * The words [step], one of [steps], gives back as its answer that the plan itself gave
+     * it, or null when its answer comes from outside the plan. A talk step's answer is the
+     * text it shows, a note's or the clipboard's is the text it was given, and reading the
+     * clipboard after the plan copied something to it gives back what was copied. Such an
+     * answer pasted into a message is the planning tool's words, not the phone's output.
+     */
+    internal fun echoedWords(step: PlanStep, steps: List<PlanStep>): String? {
+        val (action, params) = PlanApprovalSummary.resolved(step.action, step.params)
+        return when (action) {
+            in GIVES_BACK_ITS_WORDS ->
+                GIVEN_BACK_KEYS.mapNotNull { key -> (params[key] ?: step.params[key])?.takeIf(String::isNotBlank) }.distinct().joinToString(" ")
+            "GET_CLIPBOARD" -> steps.takeWhile { it.stepId != step.stepId }
+                .lastOrNull { PlanApprovalSummary.resolved(it.action, it.params).first == "COPY_TO_CLIPBOARD" }
+                ?.let { echoedWords(it, steps) }
+            else -> null
+        }
+    }
+
+    /** Whether [step]'s answer is only words the plan gave it ([echoedWords]). */
+    fun echoes(step: PlanStep, steps: List<PlanStep>): Boolean = echoedWords(step, steps) != null
+
+    private fun actionOf(step: PlanStep): String = PlanApprovalSummary.resolved(step.action, step.params).first
+
+    /** Whether [step] only shows text: a talk step. */
+    internal fun talks(step: PlanStep): Boolean = actionOf(step) in TALK_ACTIONS
+
+    /** Whether [step] is a question put to him. */
+    internal fun asks(step: PlanStep): Boolean = actionOf(step) == "ASK_USER"
+
+    /** Whether [step] types text into whatever app is on his screen. */
+    internal fun types(step: PlanStep): Boolean = actionOf(step) in TYPING_ACTIONS
+
+    /** Whether [step] acts on whatever is on his screen: a tap, typing, a scroll, a wait. */
+    internal fun actsOnScreen(step: PlanStep): Boolean = actionOf(step) in SCREEN_ACTIONS
+
+    private class Answer(val stepId: String, val reference: String, val step: String)
+    private class ForChecking(val text: String, val answers: List<Answer>)
+
+    /**
+     * [text] as it is held to the sources: a reference to a step that only gives back the
+     * plan's own words ([echoedWords]) is replaced by those words; any other reference to
+     * an earlier step is the phone's own output, and is taken out and listed.
+     */
+    private fun forChecking(text: String, steps: List<PlanStep>, depth: Int = 0, seen: Set<String> = emptySet()): ForChecking {
+        if ('$' !in text) return ForChecking(text, emptyList())
+        val ids = steps.map { it.stepId }.filter(String::isNotBlank).distinct().sortedByDescending { it.length }
+        if (ids.isEmpty()) return ForChecking(text, emptyList())
+        val byId = steps.associateBy { it.stepId }
+        val answers = ArrayList<Answer>()
+        val reference = Regex("\\$\\$?(" + ids.joinToString("|") { Regex.escape(it) } + ")(?:\\.result)?(?![A-Za-z0-9_])")
+        val out = reference.replace(text) { match ->
+            val target = byId.getValue(match.groupValues[1])
+            val echoed = echoedWords(target, steps)
+            when {
+                echoed == null -> {
+                    answers += Answer(target.stepId, match.value, labelOf(target))
+                    " "
+                }
+                target.stepId in seen || depth >= MAX_ECHO_DEPTH -> " " + withoutStepAnswers(echoed, ids) + " "
+                else -> " " + forChecking(echoed, steps, depth + 1, seen + target.stepId).text + " "
+            }
+        }
+        return ForChecking(out, answers.distinctBy { it.reference })
+    }
+
+    // The shortest answer that counts as pasted in whole: shorter ones ("OK", "Done.") are anybody's words.
+    private const val MIN_PASTED_ANSWER_CHARS = 8
+
+    /**
+     * The steps of [steps] that have run and whose whole answer [text] holds word for word:
+     * a re-evaluation that pasted a result in as it is. Each is kept as a reference to that
+     * step, which the phone fills in with the same answer. An answer that is only the
+     * plan's own words given back ([echoedWords]) is not one.
+     */
+    private fun pastedAnswers(text: String, steps: List<PlanStep>): List<Answer> =
+        steps.filter { step ->
+            step.status == StepStatus.COMPLETED && !echoes(step, steps) &&
+                step.result?.trim()?.let { it.length >= MIN_PASTED_ANSWER_CHARS && text.contains(it) } == true
+        }.map { Answer(it.stepId, "\$\$" + it.stepId, labelOf(it)) }
+
+    /** [step]'s action the way the card names it, or "an earlier step" for an action the app does not know. */
+    private fun labelOf(step: PlanStep): String {
+        val action = actionOf(step)
+        return if (ActionSchema.getAction(action) != null) PlanApprovalSummary.actionLabel(action) else "an earlier step"
+    }
+
+    // ── Whose words: the comparison ──────────────────────────────────────────────────
+
+    /**
+     * True when [text] is words from [sources] and not a tool's composition.
+     *
+     * Both sides are normalised first ([normalised]): compatibility forms folded (NFKC),
+     * lower case, punctuation and runs of space folded to one space. A reference to an
+     * earlier step's answer ("$s1", "$$s1", one of [stepIds]) is taken out: what the phone
+     * fills in there is its own output, not anybody's composition. (Where that step only
+     * gives back the plan's own words, [of] has put those words in its place first.)
+     *
+     * The text then passes when it is inside one of the words sources, or when nearly all
+     * of its words appear in one and it is not much longer than that source. The few that
+     * may be missing are only the words a person adds when he says the same thing again
+     * ([SLIPS]: a greeting, a filler, the pieces of a contraction), never one of his
+     * [Sources.names], and never any other word: a sign-off, a name or a "not" is not
+     * his. Japanese and Chinese, written without spaces, are compared by pairs of
+     * characters instead of words, and the pairs that may be missing are those around a
+     * particle. Nor may the text have his name more often than the words it comes from:
+     * "will" said once and signed "Will" is his name added. Stretches copied word for word
+     * from [Sources.pasted] are taken out before that comparison, and pass.
+     */
+    fun isTheirs(text: String, sources: Sources, stepIds: Collection<String> = emptyList()): Boolean {
+        val norm = normalised(withoutStepAnswers(text, stepIds))
+        if (norm.isEmpty()) return true
+        val mine = tokens(norm)
+        if (mine.isEmpty()) return true
+        val names = sources.names.flatMap { tokens(normalised(it)) }.toSet()
+        val nameWords = sources.names.flatMap { normalised(it).split(' ') }.filter(String::isNotEmpty).distinct()
+        val words = sources.words.map(::normalised).filter(String::isNotEmpty)
+        val all = (if (words.size > 1) words + words.joinToString(" ") else words)
+            .filter { source -> nameWords.none { name -> timesIn(norm, name) > timesIn(source, name) } }
+        if (all.any { fits(norm, mine, it, names) }) return true
+        if (sources.pasted.isEmpty()) return false
+        val rest = withoutPasted(mine, sources.pasted.map { tokens(normalised(it)) })
+        if (rest.isEmpty()) return true
+        return all.any { fits(null, rest, it, names) }
+    }
+
+    /** How often [name], one word of his name, stands in the normalised [text]: as a word, or anywhere in Japanese or Chinese. */
+    private fun timesIn(text: String, name: String): Int =
+        if (hasCjk(name)) {
+            text.replace(" ", "").windowed(name.length).count { it == name }
+        } else {
+            text.split(' ').count { it == name }
+        }
+
+    /**
+     * [text] as it is compared: NFKC, lower case, every character that is neither a
+     * letter, a digit nor a mark replaced by a space, and spaces folded.
+     */
+    fun normalised(text: String): String {
+        val folded = StringBuilder()
+        Normalizer.normalize(text, Normalizer.Form.NFKC).lowercase(Locale.ROOT).codePoints().forEach { cp ->
+            if (isWordChar(cp)) folded.appendCodePoint(cp) else folded.append(' ')
+        }
+        return folded.toString().trim().replace(SPACES, " ")
+    }
+
+    private val SPACES = Regex("\\s+")
+    // A step id the planner writes ("s1", "step2", "s2_ask") after one or two "$", with
+    // the ".result" the executor also reads.
+    private val ANY_STEP_ANSWER = Regex("""\$\$?(?:s|step)\d+[A-Za-z0-9_]*(?:\.result)?""", RegexOption.IGNORE_CASE)
+
+    /** [text] without its references to an earlier step's answer, longest id first, as the executor fills them in. */
+    internal fun withoutStepAnswers(text: String, stepIds: Collection<String>): String {
+        if ('$' !in text) return text
+        val ids = stepIds.filter(String::isNotBlank).distinct().sortedByDescending { it.length }
+        val known = if (ids.isEmpty()) text else {
+            Regex("""\$\$?(${ids.joinToString("|") { Regex.escape(it) }})(?:\.result)?(?![A-Za-z0-9_])""").replace(text, " ")
+        }
+        return ANY_STEP_ANSWER.replace(known, " ")
+    }
+
+    private fun isWordChar(cp: Int): Boolean =
+        Character.isLetterOrDigit(cp) || when (Character.getType(cp)) {
+            Character.NON_SPACING_MARK.toInt(), Character.COMBINING_SPACING_MARK.toInt(), Character.ENCLOSING_MARK.toInt() -> true
+            else -> false
+        }
+
+    private fun isCjk(cp: Int): Boolean = when (Character.UnicodeScript.of(cp)) {
+        Character.UnicodeScript.HAN, Character.UnicodeScript.HIRAGANA, Character.UnicodeScript.KATAKANA -> true
+        // The long vowel mark and the repeat mark are shared by the scripts.
+        else -> cp == 0x30FC || cp == 0x3005
+    }
+
+    private fun hasCjk(text: String): Boolean = text.codePoints().anyMatch(::isCjk)
+
+    /**
+     * What is counted of a normalised text: its words, and inside a word every run of
+     * Japanese or Chinese characters as its pairs of characters (one character alone
+     * counts as itself).
+     */
+    private fun tokens(normalised: String): List<String> = normalised.split(' ').filter(String::isNotEmpty).flatMap { word ->
+        val runs = ArrayList<Pair<Boolean, StringBuilder>>()
+        word.codePoints().forEach { cp ->
+            val cjk = isCjk(cp)
+            if (runs.isEmpty() || runs.last().first != cjk) runs += cjk to StringBuilder()
+            runs.last().second.appendCodePoint(cp)
+        }
+        runs.flatMap { (cjk, run) ->
+            if (!cjk) {
+                listOf(run.toString())
+            } else {
+                val chars = run.codePoints().toArray().map { String(Character.toChars(it)) }
+                if (chars.size == 1) chars else chars.zipWithNext { a, b -> a + b }
+            }
+        }
+    }
+
+    // A text may have this share of its words missing from the source and still be the
+    // source's words: an "hey" in front. Pairs of characters give way faster, since one
+    // changed particle breaks two of them.
+    private const val WORDS_MAY_MISS = 0.1
+    private const val PAIRS_MAY_MISS = 0.2
+    // How much longer than the source a text may be, in words: a few, or a fifth.
+    private const val LONGER_BY_WORDS = 2
+    private const val LONGER_BY_SHARE = 0.2
+
+    /**
+     * The only words that may be missing from the source: what a person adds when he
+     * says the same thing again. A greeting or a filler, an article, the pieces of a
+     * contraction ("I'll" against "I will"), a pronoun turned when "tell her I miss her"
+     * becomes "I miss you". Not a sign-off ("love", "thanks", "regards"), not a name, and
+     * not a word that turns the meaning ("not", "don't").
+     */
+    private val SLIPS = setOf(
+        "hey", "hi", "hello", "oh", "ok", "okay", "so", "just", "well", "um", "uh", "yeah", "please", "pls",
+        "a", "an", "the", "that", "and", "to", "of", "it", "is", "are", "am", "will", "have", "has",
+        "s", "ll", "re", "ve", "m", "d", "i", "you", "your", "me", "my", "we", "us"
+    )
+
+    // The particles of Japanese: a pair of characters around one of them is the particle
+    // changed or added, not a word that was not said.
+    private const val PARTICLES = "はがをにでとへのねよもや"
+
+    /**
+     * Whether a text with tokens [mine] (and, when it is one stretch, its normalised form
+     * [norm]) is words of the normalised [source]. A missing token is never one of [names].
+     */
+    private fun fits(norm: String?, mine: List<String>, source: String, names: Set<String>): Boolean {
+        if (norm != null && contains(source, norm)) return true
+        val theirs = tokens(source)
+        if (theirs.isEmpty()) return false
+        val longest = theirs.size + maxOf(LONGER_BY_WORDS, (theirs.size * LONGER_BY_SHARE).toInt())
+        if (mine.size > longest) return false
+        val known = theirs.toHashSet()
+        val missing = mine.filter { it !in known }
+        if (missing.isEmpty()) return true
+        if (missing.any { isName(it, names) } || !missing.all(::mayBeMissing)) return false
+        val share = if (mine.any(::hasCjk)) PAIRS_MAY_MISS else WORDS_MAY_MISS
+        return missing.size <= (mine.size * share).toInt()
+    }
+
+    /** Whether [token] is one of [names], or, for Japanese and Chinese, holds one. */
+    private fun isName(token: String, names: Set<String>): Boolean =
+        token in names || names.any { name -> hasCjk(name) && token.contains(name) }
+
+    /** Whether [token] may be missing from the source and the text still be its words ([SLIPS], [PARTICLES]). */
+    private fun mayBeMissing(token: String): Boolean =
+        if (hasCjk(token)) token.any { it in PARTICLES } else token in SLIPS
+
+    /** Whether [text] stands inside [source]: on word bounds, or anywhere in Japanese or Chinese, where no spaces mark them. */
+    private fun contains(source: String, text: String): Boolean =
+        if (hasCjk(text)) source.replace(" ", "").contains(text.replace(" ", "")) else " $source ".contains(" $text ")
+
+    // The shortest stretch copied from a result that counts as copied: shorter ones can be anybody's words.
+    private const val MIN_PASTED_RUN = 3
+    private const val MAX_PASTED_TOKENS = 4000
+
+    /** [mine] without every stretch of it that is copied word for word from one of [pasted]. */
+    private fun withoutPasted(mine: List<String>, pasted: List<List<String>>): List<String> {
+        val sources = pasted.filter(List<String>::isNotEmpty).map { it.take(MAX_PASTED_TOKENS) }
+        val rest = ArrayList<String>()
+        var i = 0
+        while (i < mine.size) {
+            var best = 0
+            for (source in sources) {
+                val needed = minOf(MIN_PASTED_RUN, source.size)
+                for (j in source.indices) {
+                    var k = 0
+                    while (i + k < mine.size && j + k < source.size && mine[i + k] == source[j + k]) k++
+                    if (k >= needed && k > best) best = k
+                }
+            }
+            if (best > 0) i += best else rest += mine[i++]
+        }
+        return rest
+    }
+
+    // ── Who a step is addressed to ───────────────────────────────────────────────────
+
+    /** An address taken off a step, and the app's sentence for why it is never answered. */
+    data class Unanswered(val who: String, val reason: String)
+
+    /**
+     * [step] without the addresses it is sent to that only send ([AutomatedSender]): taken
+     * off the step, or the whole step gone ([step] null) when nobody it is addressed to is
+     * left. Only a step that sends words to somebody is looked at; a call is not (an
+     * emergency number is three digits long), nor a payment. Where only the step's
+     * fallback would send, the step itself is never left out for it: the fallback is
+     * taken off ([fallbackTakenOff]) and the step runs. A link that fills words in for a
+     * machine is left out whole.
+     */
+    data class Addressed(val step: PlanStep?, val taken: List<Unanswered>, val fallbackTakenOff: Boolean = false)
+
+    fun withoutAutomated(step: PlanStep): Addressed {
+        val acts = actionsOf(step)
+        if (acts.first().first == LINK_ACTION) {
+            val link = linkOf(acts.first().second["url"]) ?: return Addressed(step, emptyList())
+            val gone = link.to.mapNotNull { who -> AutomatedSender.reason(who)?.let { Unanswered(who, it) } }
+            return Addressed(if (gone.isEmpty()) step else null, gone)
+        }
+        val addressedBy = { act: Pair<String, Map<String, String>> ->
+            SENDERS[act.first]?.let { it.addressed && it.sends(act.second) } == true
+        }
+        val itself = addressedBy(acts.first())
+        if (!itself && acts.drop(1).none(addressedBy)) return Addressed(step, emptyList())
+        if (!itself) {
+            val gone = (RECIPIENT_KEYS + OTHER_PEOPLE_KEYS).flatMap { key -> entries(step.params[key]) }
+                .mapNotNull { who -> AutomatedSender.reason(who)?.let { Unanswered(who, it) } }
+                .distinctBy { it.who }
+            return if (gone.isEmpty()) Addressed(step, emptyList()) else Addressed(withoutFallback(step), gone, fallbackTakenOff = true)
+        }
+        val taken = ArrayList<Unanswered>()
+        val params = step.params.toMutableMap()
+        var hadRecipient = false
+        for (key in RECIPIENT_KEYS + OTHER_PEOPLE_KEYS) {
+            val value = params[key]?.takeIf(String::isNotBlank) ?: continue
+            if (key in RECIPIENT_KEYS) hadRecipient = true
+            val people = entries(value)
+            val gone = people.mapNotNull { who -> AutomatedSender.reason(who)?.let { Unanswered(who, it) } }
+            if (gone.isEmpty()) continue
+            taken += gone
+            val left = people.filter { who -> gone.none { it.who == who } }
+            if (left.isEmpty()) params.remove(key) else params[key] = left.joinToString(", ")
+        }
+        if (taken.isEmpty()) return Addressed(step, emptyList())
+        val stillAddressed = RECIPIENT_KEYS.any { !params[it].isNullOrBlank() }
+        return Addressed(if (hadRecipient && !stillAddressed) null else step.copy(params = params), taken)
+    }
+
+    /** The people one param names, one by one: "a@x.com, b@y.com" is two. */
+    private fun entries(value: String?): List<String> =
+        value.orEmpty().split(',', ';').map(String::trim).filter(String::isNotEmpty)
+
+    // ── The words in a link ──────────────────────────────────────────────────────────
+
+    /** A share or compose link: what it is, the app it opens, the words it fills in and who they go to. */
+    private class Link(val kind: Kind, val app: String, val parts: List<LinkPart>, val to: List<String>)
+
+    /** One text a link fills in: the field it is written as, the key of the query it is in, and its words. */
+    private class LinkPart(val field: String, val key: String, val text: String)
+
+    private class LinkSite(val kind: Kind, val app: String)
+
+    /** The sites whose links open a message, a mail or a post with words filled in, by host. */
+    private val LINK_SITES = mapOf(
+        "wa.me" to LinkSite(Kind.MESSAGE, "WhatsApp"), "whatsapp.com" to LinkSite(Kind.MESSAGE, "WhatsApp"),
+        "t.me" to LinkSite(Kind.MESSAGE, "Telegram"), "telegram.me" to LinkSite(Kind.MESSAGE, "Telegram"),
+        "line.me" to LinkSite(Kind.MESSAGE, "LINE"),
+        "mail.google.com" to LinkSite(Kind.EMAIL, "Gmail"), "outlook.live.com" to LinkSite(Kind.EMAIL, "Outlook"),
+        "outlook.office.com" to LinkSite(Kind.EMAIL, "Outlook"), "outlook.office365.com" to LinkSite(Kind.EMAIL, "Outlook"),
+        "mail.yahoo.com" to LinkSite(Kind.EMAIL, "Yahoo Mail"),
+        "twitter.com" to LinkSite(Kind.POST, "X"), "x.com" to LinkSite(Kind.POST, "X"),
+        "facebook.com" to LinkSite(Kind.POST, "Facebook"), "linkedin.com" to LinkSite(Kind.POST, "LinkedIn"),
+        "reddit.com" to LinkSite(Kind.POST, "Reddit"), "tumblr.com" to LinkSite(Kind.POST, "Tumblr"),
+        "threads.net" to LinkSite(Kind.POST, "Threads"), "bsky.app" to LinkSite(Kind.POST, "Bluesky"),
+        "pinterest.com" to LinkSite(Kind.POST, "Pinterest")
+    )
+
+    /** The keys of a link's query that carry words for somebody. On one of [LINK_SITES], a title does too. */
+    private val LINK_WORD_KEYS = setOf("text", "body", "su", "subject", "message", "msg", "content", "caption", "quote", "summary")
+    private val LINK_SITE_WORD_KEYS = LINK_WORD_KEYS + "title"
+    /** The keys of a link's query that name who the words go to. */
+    private val LINK_RECIPIENT_KEYS = setOf("to", "phone", "recipient", "cc", "bcc")
+    private val LINK_FIELDS = mapOf("su" to "subject", "msg" to "message")
+
+    /**
+     * The words [url] fills into the page it opens, or null when it fills in none: a plain
+     * link, a search or a translation. A link counts when its query has words for
+     * somebody (a text, a body, a subject, a message), or a title on a site whose links
+     * open a post. The link is read as the action opens it, with "https://" put in front
+     * where it has no scheme.
+     */
+    private fun linkOf(url: String?): Link? {
+        val raw = url?.trim()?.takeIf(String::isNotEmpty) ?: return null
+        val full = if (raw.startsWith("http://", ignoreCase = true) || raw.startsWith("https://", ignoreCase = true)) raw else "https://$raw"
+        val body = full.substringBefore('#')
+        val place = body.substringAfter("://").substringBefore('?')
+        val host = place.substringBefore('/').substringAfterLast('@').substringBefore(':').lowercase(Locale.ROOT)
+            .removePrefix("www.").removePrefix("m.").removePrefix("mobile.")
+        val path = place.substringAfter('/', "").lowercase(Locale.ROOT)
+        val site = LINK_SITES.entries.firstOrNull { (name, _) -> host == name || host.endsWith(".$name") }?.value
+        // A search or a translation takes words to look up, not words for anybody.
+        if (site == null && (host.startsWith("translate.") || path.startsWith("search") || path.startsWith("results"))) return null
+        val pairs = body.substringAfter('?', "").split('&').filter(String::isNotEmpty)
+            .map { it.substringBefore('=') to decoded(it.substringAfter('=', "")) }
+        val wordKeys = if (site != null) LINK_SITE_WORD_KEYS else LINK_WORD_KEYS
+        val parts = pairs.filter { (key, text) -> key.lowercase(Locale.ROOT) in wordKeys && text.isNotBlank() }
+            .map { (key, text) -> LinkPart(LINK_FIELDS[key.lowercase(Locale.ROOT)] ?: key.lowercase(Locale.ROOT), key, text) }
+            .distinctBy { it.field }
+        if (parts.isEmpty()) return null
+        val to = pairs.filter { (key, text) -> key.lowercase(Locale.ROOT) in LINK_RECIPIENT_KEYS && text.isNotBlank() }
+            .flatMap { (_, text) -> entries(text) } +
+            listOfNotNull(path.substringBefore('/').takeIf { host == "wa.me" && it.isNotEmpty() && it.all(Char::isDigit) })
+        return Link(site?.kind ?: Kind.LINK, site?.app ?: "his browser", parts, to.distinct())
+    }
+
+    private fun decoded(text: String): String = try {
+        URLDecoder.decode(text, "UTF-8")
+    } catch (e: IllegalArgumentException) {
+        text
+    }
+
+    /** The words of a link that fills words in ([linkOf]), held to [sources] like the params of any other step. */
+    private fun linkWords(step: PlanStep, params: Map<String, String>, steps: List<PlanStep>, sources: Sources): StepWords? {
+        val link = linkOf(params["url"]) ?: return null
+        val texts = link.parts.associate { it.field to it.text }
+        val (notTheirs, fills) = judged(texts, steps, sources)
+        return StepWords(
+            stepId = step.stepId,
+            action = LINK_ACTION,
+            kind = link.kind,
+            app = link.app,
+            to = link.to,
+            fields = link.parts.map { it.field },
+            texts = texts,
+            notTheirs = notTheirs,
+            fills = fills,
+            linkKeys = link.parts.associate { it.field to it.key }
+        )
+    }
+
+    /**
+     * [url] with the texts of [byKey] (query key to words) in place of those it had. Every
+     * other part of the link stays as it was, and a key that came twice keeps only the new
+     * words. A reference to an earlier step's answer is kept as it is, so that the phone
+     * still fills it in.
+     */
+    private fun withLinkWords(url: String, byKey: Map<String, String>): String {
+        val hash = url.indexOf('#')
+        val fragment = if (hash >= 0) url.substring(hash) else ""
+        val body = if (hash >= 0) url.substring(0, hash) else url
+        val question = body.indexOf('?')
+        if (question < 0) return url
+        val done = HashSet<String>()
+        val pairs = body.substring(question + 1).split('&').mapNotNull { pair ->
+            val key = pair.substringBefore('=')
+            val words = byKey[key] ?: return@mapNotNull pair
+            if (!done.add(key)) null else "$key=${encoded(words)}"
+        }
+        return body.substring(0, question + 1) + pairs.joinToString("&") + fragment
+    }
+
+    // Any reference to a step's answer, as the executor fills them in: kept out of the encoding.
+    private val ANY_REFERENCE = Regex("""\$\$?[A-Za-z][A-Za-z0-9_]*(?:\.result)?""")
+
+    private fun encoded(text: String): String {
+        val out = StringBuilder()
+        var last = 0
+        val piece = { part: String -> URLEncoder.encode(part, "UTF-8").replace("+", "%20") }
+        for (match in ANY_REFERENCE.findAll(text)) {
+            out.append(piece(text.substring(last, match.range.first))).append(match.value)
+            last = match.range.last + 1
+        }
+        return out.append(piece(text.substring(last))).toString()
+    }
+
+    // ── The steps a macro stores ─────────────────────────────────────────────────────
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /**
+     * The steps a CREATE_MACRO step stores, read as the macro will run them.
+     */
+    class Stored internal constructor(private val array: List<JsonObject>, val steps: List<PlanStep>) {
+        /**
+         * The stored steps written back in the same shape: only those at [kept], those in
+         * [written] with the params given there in place of their own, and those in
+         * [fallbacks] with that fallback. Every other key of a stored step stays as it was,
+         * and so does a param whose text did not change, or that was not text at all.
+         */
+        fun with(kept: Set<Int>, written: Map<Int, Map<String, String>>, fallbacks: Map<Int, String> = emptyMap()): String {
+            val out = array.mapIndexedNotNull { index, obj ->
+                if (index !in kept) return@mapIndexedNotNull null
+                var now = obj
+                written[index]?.let { params ->
+                    val old = obj["params"] as? JsonObject
+                    // A param that is not text was never read as words: it stays.
+                    val notText = old?.filterValues { text(it) == null }.orEmpty()
+                    val texts = params.mapValues { (key, value) -> old?.get(key)?.takeIf { text(it) == value } ?: JsonPrimitive(value) }
+                    now = JsonObject(now + ("params" to JsonObject(notText + texts)))
+                }
+                fallbacks[index]?.let { fallback ->
+                    if (text(obj["fallback"]).orEmpty() != fallback) now = JsonObject(now + ("fallback" to JsonPrimitive(fallback)))
+                }
+                now
+            }
+            return JsonArray(out).toString()
+        }
+    }
+
+    /**
+     * The steps [step] stores, when it is a CREATE_MACRO whose steps can be read, or null.
+     * Steps that cannot be read cannot be run by the macro either, and are left as they are.
+     * [depth] is how many macros down [step] itself is stored; past a few, nothing more is read.
+     */
+    fun stored(step: PlanStep, depth: Int = 0): Stored? {
+        if (depth >= MAX_MACRO_DEPTH) return null
+        if (PlanApprovalSummary.resolved(step.action, step.params).first != MACRO) return null
+        val raw = step.params["steps"]?.takeIf(String::isNotBlank) ?: return null
+        val array = runCatching { json.parseToJsonElement(raw) }.getOrNull() as? JsonArray ?: return null
+        val objects = array.map { it as? JsonObject ?: return null }
+        if (objects.isEmpty()) return null
+        val steps = objects.mapIndexed { index, obj ->
+            PlanStep(
+                stepId = text(obj["stepId"]) ?: text(obj["id"]) ?: "s${index + 1}",
+                order = index + 1,
+                description = text(obj["description"]).orEmpty(),
+                action = text(obj["action"]).orEmpty(),
+                params = (obj["params"] as? JsonObject)?.mapNotNull { (key, value) -> text(value)?.let { key to it } }?.toMap().orEmpty(),
+                fallback = text(obj["fallback"]).orEmpty()
+            )
+        }
+        return Stored(objects, steps)
+    }
+
+    private fun text(element: JsonElement?): String? = (element as? JsonPrimitive)?.contentOrNull
+}
