+    @Test
+    fun `the words every plan sends are his or hers before it is shown or run, and again after every rewrite`() {
+        val loop = loopSource()
+        // His command: after validation, before the card or his own setting.
+        val his = loop.substringAfter("private suspend fun generatePlan(").substringBefore("suspend fun personaOwnTime(")
+        val started = his.indexOf("planManager.startNewPlan(plan, context, PlanStatus.PROPOSED)")
+        val words = his.indexOf("val validated = withOwnWords(")
+        assertTrue(started >= 0)
+        assertTrue(words > started)
+        assertTrue(words < his.indexOf("AutoApprovalPolicy.shouldAutoApprove("))
+        assertTrue(words < his.indexOf("proposePlan(validated, sessionId)"))
+        assertTrue(his.contains("com.opendroid.ai.core.persona.HerWords.From.HIM"))
+        // His words are what the plan is held against; a message of his that held a secret is not shown to her.
+        assertTrue(his.contains("words = userMsg.text,"))
+        assertTrue(his.contains("if (PlanRecord.takesASecret(proposed)) com.opendroid.ai.core.persona.PersonaPrompts.SECRET_MARKER else userMsg.text"))
+        // Her command: before her rein or his setting decides anything.
+        val hers = runPersonaActionSource()
+        val herWords = hers.indexOf("val validated = withOwnWords(")
+        assertTrue(herWords > hers.indexOf("planManager.startNewPlan(plan, context, PlanStatus.PROPOSED)"))
+        assertTrue(herWords < hers.indexOf("PersonaActions.decideStart("))
+        assertTrue(herWords < hers.indexOf("personaPlanIds.add(validated.planId)"))
+        assertTrue(hers.contains("PlanWordsPass.Origin(com.opendroid.ai.core.persona.HerWords.From.HER, command)"))
+        // A rewrite while the plan runs: before the gate judges it.
+        val parked = loop.substringAfter("private suspend fun parkedForApproval(").substringBefore("private suspend fun recordPersonaReinChange(")
+        val after = parked.indexOf("val rewrite = withOwnWordsAfter(merged, context, sessionId) ?: return true")
+        assertTrue(after >= 0)
+        assertTrue(after < parked.indexOf("PlanModification.requiresApproval("))
+        // Only with her on, and only her model writes: the pass is handed nothing else to write with.
+        val pass = loop.substringAfter("private suspend fun withOwnWords(").substringBefore("private suspend fun saveWordsRow(")
+        assertTrue(pass.contains("if (!persona.isActive(config)) return plan"))
+        assertTrue(pass.contains("if (!persona.isActive(config)) return merged"))
+        assertEquals(2, Regex("""write = \{ ask -> persona\.writeWords\(config, ask\) \}""").findAll(pass).count())
+        assertFalse(pass.contains("provider.complete("))
+        // What she is told is built from what was asked and where it goes, never from the step's texts.
+        val askFor = File(mainSources, "core/agent/PlanWordsPass.kt").readText()
+            .substringAfter("private fun askFor(").substringBefore("private const val ASKED_WHEN_IT_RUNS")
+        assertTrue(askFor.contains("asked = origin.shown"))
+        assertFalse(askFor.contains("texts"))
+        assertFalse(askFor.contains("params"))
+        // She writes only the parts that are not his or hers; the rest stay as they were.
+        assertTrue(askFor.contains("fields = words.notTheirs,"))
+        // His name is held to every text, at the start and after a rewrite.
+        assertEquals(2, Regex("""names = listOf\(persona\.ownerName\(\)\)""").findAll(pass).count())
+        // A plan left with nothing but talk is withdrawn like one with nothing left.
+        assertTrue(pass.contains("val nothingLeft = stored.steps.isEmpty() || isTalkOnlyPlan(stored)"))
+        // Shortcuts carry his own words and are left as they are.
+        val alias = loop.substringAfter("private suspend fun executeAliasDirect(").substringBefore("override fun dismissChatError()")
+        assertFalse(alias.contains("withOwnWords("))
+    }
