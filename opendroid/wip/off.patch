+package com.opendroid.ai.social.core.ai
+
+import com.opendroid.ai.core.agent.HerPresence
+
+/**
+ * While she is on, the social writers write nothing. The composer (a post and every change
+ * to one), the campaign generator and the comment-reply engine are stock prompts on the
+ * main model, in nobody's voice: posts and replies are then written by him or by her. Each
+ * of them asks [refuseWhileSheIsOn] first, before any model is called and before any fixed
+ * template is used, and the caller shows [REFUSAL]. With her off, social is stock.
+ */
+object SocialWriters {
+
+    /** What he is told where a social writer would have written for him. */
+    const val REFUSAL = "Posts and replies are written by you or by her."
+
+    /** What a plan step to make a post is told when it carries no words while she is on. */
+    const val POST_NEEDS_WORDS = "The post needs its words."
+
+    /** Throws [SocialWriterRefused] while she is on; returns while she is not. */
+    suspend fun refuseWhileSheIsOn(herPresence: HerPresence) {
+        if (herPresence.isOn()) throw SocialWriterRefused()
+    }
+}
+
+/** A social writer was asked to write while she is on. Its message is [SocialWriters.REFUSAL]. */
+class SocialWriterRefused : IllegalStateException(SocialWriters.REFUSAL)
