@@ -0,0 +1,36 @@
+package com.opendroid.ai.core.agent
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flowOf
+
+/**
+ * Whether she is the one who talks, for code outside her package that must not write
+ * while she does: the social composer, campaign generator and comment-reply engine, the
+ * social actions and the social screens. While she is on, posts and replies are written
+ * by him or by her, never by a tool.
+ *
+ * It is her engine's own answer (switched on, and a card exists), handed over through
+ * this door so that none of those classes imports her package.
+ */
+interface HerPresence {
+
+    /** True while she is on: switched on, and a card exists. */
+    suspend fun isOn(): Boolean
+
+    /** [isOn], told again whenever it changes, for the screens. */
+    val on: Flow<Boolean>
+
+    companion object {
+        /** She is not there: the app is stock. What a test or a build without her gets. */
+        val OFF: HerPresence = object : HerPresence {
+            override suspend fun isOn(): Boolean = false
+            override val on: Flow<Boolean> = flowOf(false)
+        }
+
+        /** She is on. For tests. */
+        val ON: HerPresence = object : HerPresence {
+            override suspend fun isOn(): Boolean = true
+            override val on: Flow<Boolean> = flowOf(true)
+        }
+    }
+}
