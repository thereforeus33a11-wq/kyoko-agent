+package com.opendroid.ai.social.core.ai
+
+import android.content.Context
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.agent.HerPresence
+import com.opendroid.ai.core.llm.LLMProvider
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.social.domain.model.SocialComment
+import com.opendroid.ai.social.domain.model.SocialPlatform
+import java.util.concurrent.CopyOnWriteArrayList
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * While she is on, the social composer, the campaign generator and the comment-reply
+ * engine write nothing: no model is asked and no fixed template is used, and each says
+ * that posts and replies are written by him or by her. With her off they write as stock.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class SocialWritersTest {
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var memory: MemoryRepository
+    private val model = RecordingModel()
+
+    @Before
+    fun setUp() {
+        val context = ApplicationProvider.getApplicationContext<Context>()
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        memory = MemoryRepository(database.memoryDao(), database.taskHistoryDao(), database.macroDao())
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `with her on the composer writes nothing, from a topic or from a draft`() = runBlocking {
+        val composer = SocialContentComposer({ model }, memory, HerPresence.ON)
+        val draft = "Our bakery opens at nine on Saturday."
+
+        refused { composer.generateContentForPlatform("our new opening hours", SocialPlatform.X) }
+        refused { composer.shorten(draft, SocialPlatform.X) }
+        refused { composer.expand(draft, SocialPlatform.X) }
+        refused { composer.changeTone(draft, Tone.EXCITED, SocialPlatform.X) }
+        refused { composer.addCta(draft, "download", SocialPlatform.X) }
+        refused { composer.translate(draft, "Japanese") }
+
+        assertEquals(0, model.requests.size)
+        // Taking hashtags out writes nothing, so it still works.
+        assertEquals("Open at nine", composer.removeHashtags("Open at nine #bakery"))
+    }
+
+    @Test
+    fun `with her on no campaign and no reply draft is written`() = runBlocking {
+        refused { SocialCampaignGenerator({ model }, HerPresence.ON).generateCampaignPlan("Autumn honey", "sell forty jars") }
+        refused { SocialCommentReplyEngine({ model }, memory, HerPresence.ON).generateReply(comment("When is the next release?")) }
+
+        assertEquals(0, model.requests.size)
+    }
+
+    @Test
+    fun `with her off the composer and its changes write as stock`() = runBlocking {
+        val composer = SocialContentComposer({ model }, memory, HerPresence.OFF)
+        model.answer = "Fresh bread from nine on Saturday #bakery"
+
+        val post = composer.generateContentForPlatform("our new opening hours", SocialPlatform.X)
+        val shorter = composer.shorten("A long post about bread", SocialPlatform.X)
+
+        assertEquals("Fresh bread from nine on Saturday #bakery", post.content)
+        assertEquals(listOf("#bakery"), post.hashtags)
+        assertEquals("Fresh bread from nine on Saturday #bakery", shorter)
+        assertEquals(2, model.requests.size)
+        assertTrue(composer.addCta("Fresh bread", "feedback", SocialPlatform.X).startsWith("Fresh bread\n\n"))
+    }
+
+    @Test
+    fun `with her off a campaign and a reply draft are written as stock`() = runBlocking {
+        model.answer = """{"strategySummary":"Two posts.","goals":["sell"],"posts":[{"dayOffset":1,"platform":"X","content":"Honey is back"}]}"""
+        val plan = SocialCampaignGenerator({ model }, HerPresence.OFF).generateCampaignPlan("Autumn honey", "sell forty jars")
+        assertEquals(listOf("Honey is back"), plan.plannedPosts.map { it.content })
+
+        model.answer = "Next week, thank you for asking!"
+        val reply = SocialCommentReplyEngine({ model }, memory, HerPresence.OFF).generateReply(comment("When is the next release?"))
+        assertEquals("Next week, thank you for asking!", reply.replyText)
+        assertEquals(2, model.requests.size)
+    }
+
+    @Test
+    fun `the refusal is the plain line`() {
+        assertEquals("Posts and replies are written by you or by her.", SocialWriters.REFUSAL)
+        assertEquals(SocialWriters.REFUSAL, SocialWriterRefused().message)
+    }
+
+    private suspend fun refused(write: suspend () -> Any?) {
+        try {
+            write()
+            fail("a social writer wrote while she is on")
+        } catch (e: SocialWriterRefused) {
+            assertEquals(SocialWriters.REFUSAL, e.message)
+        }
+    }
+
+    private fun comment(text: String) = SocialComment(
+        id = "c1",
+        platformCommentId = "pc-1",
+        postId = "post-1",
+        platform = SocialPlatform.X,
+        authorName = "Alex",
+        content = text
+    )
+
+    private class RecordingModel : LLMProvider {
+        val requests = CopyOnWriteArrayList<LLMRequest>()
+        @Volatile var answer: String = "ok"
+        override val name: String = "Recording"
+        override val availableModels: List<String> = emptyList()
+        override suspend fun complete(request: LLMRequest): LLMResponse {
+            requests += request
+            return LLMResponse(answer, 1, "model", name, 1)
+        }
+        override fun streamComplete(request: LLMRequest): Flow<String> = flowOf(answer)
+        override suspend fun isAvailable(): Boolean = true
+    }
+}
