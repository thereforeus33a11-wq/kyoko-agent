@@ -0,0 +1,54 @@
+package com.opendroid.ai.data.models
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/**
+ * What this build switches off, so that no part of the app writes words or acts behind
+ * her back: nothing answers a message for him (there is no auto-reply), and no program
+ * outside the app drives it (the local MCP server and the privileged shell behind it
+ * never run). Neither has a switch in Settings any more.
+ *
+ * A phone that saved one of those switches on in an earlier build has it turned off
+ * once, on the update that brings this ([VERSION]; see SettingsRepository). The switches
+ * are not read to decide anything here, so what was saved could not turn either back on;
+ * turning them off keeps a later build from finding them on.
+ */
+object BuildSwitchOffs {
+
+    /**
+     * Raised when a later build switches more off. Each version is applied once: a phone
+     * that has had it is left as it is from then on.
+     */
+    const val VERSION = 1
+
+    /** What the app says when it is asked to switch auto-reply on or off. */
+    const val AUTO_REPLY_OFF = "Auto-reply is off in this build. Nothing answers messages for you."
+
+    /** What the app says where its auto-reply settings used to be. */
+    const val AUTO_REPLY_NOTICE =
+        "Auto-reply is off in this build. Nothing answers messages for you, whoever sent them. " +
+            "Messages that come in are still kept in the notification history."
+
+    private const val MCP_SERVER_KEY = "mcpServerEnabled"
+
+    /**
+     * The saved setting [stored] with the MCP server's switch off, or null when there is
+     * nothing to change: the switch is off already, or the text cannot be read (and is then
+     * read as this build's start, where it is off). Only that one key is touched, so
+     * nothing else that was saved is rewritten. Off is its default, so it is left out.
+     */
+    fun withMcpServerOff(stored: String): String? {
+        val saved = try {
+            Json.parseToJsonElement(stored).jsonObject
+        } catch (_: Exception) {
+            return null
+        }
+        val on = runCatching { saved[MCP_SERVER_KEY]?.jsonPrimitive?.booleanOrNull }.getOrNull() == true
+        if (!on) return null
+        return JsonObject(saved - MCP_SERVER_KEY).toString()
+    }
+}
