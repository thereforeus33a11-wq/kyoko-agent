diff --git a/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt b/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt
new file mode 100644
index 0000000..4da9d65
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/actions/MacroRun.kt
@@ -0,0 +1,124 @@
+package com.opendroid.ai.actions
+
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.agent.AutomatedSender
+import com.opendroid.ai.data.db.entities.MacroEntity
+import com.opendroid.ai.data.models.PlanStep
+
+/**
+ * What a saved macro may run, decided before anything of it runs.
+ *
+ * A macro he switched off does not run at all, and says so. Of one that is on, a step
+ * that would message or email an address or number that only sends ([AutomatedSender]:
+ * a no-reply address, a short code, a sender ID, a bot) is skipped with the plain reason,
+ * and so is a step that uses what a skipped step would have returned. The rest runs as
+ * saved, and the macro's result names every step that was skipped and why.
+ *
+ * A call is not skipped: a short number can be an emergency line.
+ */
+internal object MacroRun {
+
+    /** The actions that write to someone at an address or number, by the name the dispatcher runs them as. */
+    private val MESSAGING_ACTIONS = setOf(
+        "SEND_SMS", "SEND_WHATSAPP", "SEND_WHATSAPP_GROUP", "SEND_TELEGRAM", "SEND_EMAIL"
+    )
+
+    /**
+     * Where such a step's recipient may stand: every key a send handler reads one from, and
+     * a few the planner also uses.
+     */
+    private val RECIPIENT_KEYS = listOf(
+        "contact", "to", "recipient", "number", "phone", "phoneNumber", "username", "channel",
+        "destination", "email", "emailAddress", "handle"
+    )
+
+    // The same resolver the dispatcher runs, so an alias is judged as what it will do.
+    private val autoMapper = ActionAutoMapper()
+
+    /** The line for a macro he switched off. */
+    fun switchedOffLine(name: String): String = "Macro '$name' is switched off, so it did not run."
+
+    /** A step left out of the run, with its place in the macro (counted from 1) and the plain reason. */
+    data class Skipped(val number: Int, val action: String, val reason: String) {
+        val line: String get() = "Step $number ($action) was skipped: $reason."
+    }
+
+    /**
+     * The steps that run, in the macro's order, and those that were skipped. [numbers] holds
+     * each running step's place in the macro, counted from 1, so a result can name it so.
+     */
+    data class Sorted(val toRun: List<PlanStep>, val skipped: List<Skipped>, val numbers: List<Int> = toRun.indices.map { it + 1 })
+
+    /** The macro does not run at all: it is switched off. Null when it may run. */
+    fun refusal(macro: MacroEntity): ActionResult? =
+        if (macro.isEnabled) null else ActionResult.Failure(errorMsg = switchedOffLine(macro.name))
+
+    /** Splits [steps] into what runs and what is skipped, in the order the macro runs them. */
+    fun sort(steps: List<PlanStep>): Sorted {
+        val ordered = steps.sortedWith(compareBy<PlanStep> { it.order })
+        val toRun = mutableListOf<PlanStep>()
+        val numbers = mutableListOf<Int>()
+        val skipped = mutableListOf<Skipped>()
+        val skippedIds = mutableListOf<String>()
+        ordered.forEachIndexed { index, step ->
+            val reason = automatedRecipient(step)
+                ?: skippedIds.firstOrNull { usesResultOf(step, it) }
+                    ?.let { "it uses what a skipped step would have returned" }
+            if (reason == null) {
+                toRun += step
+                numbers += index + 1
+            } else {
+                skipped += Skipped(index + 1, step.action.ifBlank { "unknown action" }, reason)
+                if (step.stepId.isNotBlank()) skippedIds += step.stepId
+            }
+        }
+        return Sorted(toRun, skipped, numbers)
+    }
+
+    /**
+     * [result] of the steps that ran, with every skipped step named after it. The runner
+     * counts only the steps it was given, so a step it stopped at is named by its place in
+     * the macro instead. A refusal he gave is passed on as it is.
+     */
+    fun withSkips(result: ActionResult, sorted: Sorted): ActionResult {
+        if (sorted.skipped.isEmpty()) return result
+        val lines = sorted.skipped.joinToString(" ") { it.line }
+        return when (result) {
+            is ActionResult.Success -> ActionResult.Success(
+                result.dataMap + ("message" to listOfNotNull(result.data, lines).joinToString(" "))
+            )
+            is ActionResult.Failure -> result.copy(errorMsg = "${inMacroNumbers(result.errorMsg, sorted.numbers)} $lines")
+            else -> result
+        }
+    }
+
+    private val STOPPED_AT = Regex("""^Macro stopped at step (\d+) \(""")
+
+    private fun inMacroNumbers(error: String, numbers: List<Int>): String = STOPPED_AT.replace(error) { match ->
+        val number = match.groupValues[1].toInt().let { numbers.getOrNull(it - 1) ?: it }
+        "Macro stopped at step $number ("
+    }
+
+    /** What a macro whose every step was skipped returns: it did nothing, and says why. */
+    fun nothingRan(name: String, skipped: List<Skipped>): ActionResult =
+        ActionResult.Failure(errorMsg = "Macro '$name' did not run: ${skipped.joinToString(" ") { it.line }}")
+
+    /** Why [step]'s recipient is never written to, or null when it has none of that kind. */
+    private fun automatedRecipient(step: PlanStep): String? {
+        val mapping = autoMapper.mapAction(step.action, step.params, emptySet())
+        val action = (mapping.mappedAction ?: step.action).trim().uppercase()
+        if (action !in MESSAGING_ACTIONS) return null
+        val params = if (mapping.mappedAction != null) mapping.mappedParams else step.params
+        return RECIPIENT_KEYS.asSequence()
+            .mapNotNull { params[it]?.takeIf(String::isNotBlank) }
+            .flatMap { it.split(',', ';').asSequence() }
+            .mapNotNull { AutomatedSender.reason(it.trim()) }
+            .firstOrNull()
+    }
+
+    // "$id" and "$$id" are filled in from that step's result; "$s1" is not read out of "$s10".
+    private fun usesResultOf(step: PlanStep, stepId: String): Boolean {
+        val reference = Regex("""\$\$?${Regex.escape(stepId)}(?![A-Za-z0-9_])""")
+        return step.params.values.any { reference.containsMatchIn(it) }
+    }
+}
