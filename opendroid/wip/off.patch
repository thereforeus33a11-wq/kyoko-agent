@@ -0,0 +1,157 @@
+package com.opendroid.ai.data.repository
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.intPreferencesKey
+import androidx.datastore.preferences.core.stringPreferencesKey
+import com.opendroid.ai.core.security.CredentialStoreResult
+import com.opendroid.ai.core.security.ProviderCredentialId
+import com.opendroid.ai.core.security.ProviderCredentialRecoveryState
+import com.opendroid.ai.core.security.ProviderCredentialStore
+import com.opendroid.ai.data.models.AutoReplyConfig
+import com.opendroid.ai.data.models.BuildSwitchOffs
+import com.opendroid.ai.data.models.RoutePolicy
+import java.nio.file.Files
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * On the update that brings this build, every auto-reply switch and the MCP server's
+ * switch are turned off once. What else was saved stays as it was, and a phone that has
+ * had it is not touched again.
+ */
+class BuildSwitchOffsTest {
+
+    @Test
+    fun `the update turns every auto-reply switch off and leaves the rest of what was saved`() = runBlocking {
+        val dataStore = newDataStore()
+        dataStore.edit { saved ->
+            AUTO_REPLY_SWITCHES.forEach { saved[booleanPreferencesKey(it)] = true }
+            saved[stringPreferencesKey("auto_reply_custom_reply")] = "On my way, call you later"
+            saved[intPreferencesKey("auto_reply_delay_minutes")] = 0
+        }
+        val repository = newRepository(dataStore)
+
+        repository.applySwitchOffsOnce()
+
+        val config = repository.autoReplyConfig.first()
+        assertEquals(
+            AutoReplyConfig(customReplyText = "On my way, call you later", replyDelayMinutes = 0),
+            config
+        )
+        AUTO_REPLY_SWITCHES.forEach { assertEquals(it, false, dataStore.data.first()[booleanPreferencesKey(it)]) }
+    }
+
+    @Test
+    fun `the update turns the MCP server's switch off and touches nothing else in the main setting`() = runBlocking {
+        val dataStore = newDataStore()
+        dataStore.edit {
+            it[LLM_CONFIG_KEY] = """{"routePolicy":"ANY","mcpServerEnabled":true,"wakePhrases":"hey you"}"""
+        }
+        val repository = newRepository(dataStore)
+        assertTrue(repository.llmConfig.first().mcpServerEnabled)
+
+        repository.applySwitchOffsOnce()
+
+        val read = repository.llmConfig.first()
+        assertFalse(read.mcpServerEnabled)
+        assertEquals(RoutePolicy.ANY, read.routePolicy)
+        assertEquals("hey you", read.wakePhrases)
+        assertEquals("""{"routePolicy":"ANY","wakePhrases":"hey you"}""", dataStore.data.first()[LLM_CONFIG_KEY])
+    }
+
+    @Test
+    fun `it happens once, so a phone that has had it is left as it is`() = runBlocking {
+        val dataStore = newDataStore()
+        val repository = newRepository(dataStore)
+        repository.applySwitchOffsOnce()
+        assertEquals(BuildSwitchOffs.VERSION, dataStore.data.first()[intPreferencesKey("build_switch_offs_version")])
+
+        // Something put back after it (an old backup, say) is not turned off a second time.
+        dataStore.edit { saved ->
+            saved[booleanPreferencesKey("auto_reply_global")] = true
+            saved[LLM_CONFIG_KEY] = """{"mcpServerEnabled":true}"""
+        }
+        repository.applySwitchOffsOnce()
+
+        assertEquals(true, dataStore.data.first()[booleanPreferencesKey("auto_reply_global")])
+        assertEquals("""{"mcpServerEnabled":true}""", dataStore.data.first()[LLM_CONFIG_KEY])
+    }
+
+    @Test
+    fun `a phone that never saved a setting gets none written for it`() = runBlocking {
+        val dataStore = newDataStore()
+
+        newRepository(dataStore).applySwitchOffsOnce()
+
+        assertNull(dataStore.data.first()[LLM_CONFIG_KEY])
+    }
+
+    @Test
+    fun `only a saved on is rewritten, and a setting that cannot be read is left alone`() {
+        assertNull(BuildSwitchOffs.withMcpServerOff("""{"mcpServerEnabled":false}"""))
+        assertNull(BuildSwitchOffs.withMcpServerOff("""{"routePolicy":"ANY"}"""))
+        assertNull(BuildSwitchOffs.withMcpServerOff("not a setting"))
+        assertNull(BuildSwitchOffs.withMcpServerOff("""{"mcpServerEnabled":"yes"}"""))
+        assertEquals("{}", BuildSwitchOffs.withMcpServerOff("""{"mcpServerEnabled":true}"""))
+    }
+
+    private fun newRepository(dataStore: DataStore<Preferences>) = SettingsRepository(
+        dataStore = dataStore,
+        providerCredentialStore = NoCredentials,
+        runStartupMigration = false
+    )
+
+    private fun newDataStore() = PreferenceDataStoreFactory.create(
+        scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined),
+        produceFile = {
+            Files.createTempDirectory("opendroid-switch-offs-test")
+                .resolve("settings.preferences_pb")
+                .toFile()
+        }
+    )
+
+    private object NoCredentials : ProviderCredentialStore {
+        override val recoveryState: StateFlow<ProviderCredentialRecoveryState> =
+            MutableStateFlow(ProviderCredentialRecoveryState.Ready)
+
+        override fun read(credential: ProviderCredentialId): CredentialStoreResult<String?> =
+            CredentialStoreResult.Success(null)
+
+        override fun readProviderApiKeys(): CredentialStoreResult<Map<String, String>> =
+            CredentialStoreResult.Success(emptyMap())
+
+        override fun write(credential: ProviderCredentialId, value: String): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun remove(credential: ProviderCredentialId): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun migrateLegacyCredentials(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+
+        override fun resetForReentry(): CredentialStoreResult<Unit> =
+            CredentialStoreResult.Success(Unit)
+    }
+
+    private companion object {
+        val LLM_CONFIG_KEY = stringPreferencesKey("llm_config")
+        val AUTO_REPLY_SWITCHES = listOf(
+            "auto_reply_global", "auto_reply_whatsapp", "auto_reply_telegram",
+            "auto_reply_discord", "auto_reply_sms", "auto_reply_email"
+        )
+    }
+}
