@@ -0,0 +1,60 @@
+package com.opendroid.ai.core.service
+
+import com.opendroid.ai.data.models.LLMConfig
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * The local MCP server let a program on the phone that held the app's token run any
+ * action or shell command through it, with no approval prompt. It is off in this build,
+ * and so is the privileged shell behind it: nothing starts the server whatever its saved
+ * switch says, and nothing but the server can reach the shell.
+ */
+class McpServerOffTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    private fun sources() = main.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+
+    /**
+     * The files that hold, build or ask for a [name]: a field, parameter or value of that
+     * type, a constructor call, or a class literal. A name in a comment or a log tag is not
+     * a use.
+     */
+    private fun users(name: String): Set<String> {
+        val use = Regex(""":\s*$name\b|\b$name\(|<$name>|\b$name::class""")
+        return sources()
+            .filter { use.containsMatchIn(it.readText()) }
+            .map { it.relativeTo(main).path.replace('\\', '/') }
+            .toSet()
+    }
+
+    @Test
+    fun `the service never starts the server, whatever the saved switch says`() {
+        val service = File(main, "core/service/OpenDroidService.kt").readText()
+        assertFalse(service.contains("mcpServer"))
+        assertFalse(service.contains("McpServer"))
+        assertFalse(service.contains("mcpServerEnabled"))
+        // The switch still reads off on a phone that never saved it.
+        assertFalse(LLMConfig().mcpServerEnabled)
+    }
+
+    @Test
+    fun `nothing outside the server's own file can build or start it`() {
+        // Hilt builds a class only where something asks for it: here nothing does.
+        assertEquals(emptySet<String>(), users("McpServer"))
+        assertTrue(sources().none { it.readText().contains("mcpServer.start()") })
+    }
+
+    @Test
+    fun `the privileged shell is reached only through the server`() {
+        assertEquals(
+            setOf("core/service/PersistentTerminalManager.kt", "core/service/McpServer.kt"),
+            users("PrivilegedCommandExecutor")
+        )
+        assertEquals(setOf("core/service/McpServer.kt"), users("PersistentTerminalManager"))
+    }
+}
