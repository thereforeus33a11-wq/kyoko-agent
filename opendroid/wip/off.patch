@@ -0,0 +1,216 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import androidx.room.Room
+import androidx.test.core.app.ApplicationProvider
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.agent.HerPresence
+import com.opendroid.ai.core.llm.LLMProvider
+import com.opendroid.ai.core.llm.LLMRequest
+import com.opendroid.ai.core.llm.LLMResponse
+import com.opendroid.ai.core.security.SocialCredentialStore
+import com.opendroid.ai.data.db.MigrationTestApplication
+import com.opendroid.ai.data.db.OpenDroidDatabase
+import com.opendroid.ai.data.repository.MemoryRepository
+import com.opendroid.ai.data.repository.SocialRepository
+import com.opendroid.ai.social.core.SocialManager
+import com.opendroid.ai.social.core.adapter.DiscordAdapter
+import com.opendroid.ai.social.core.adapter.FacebookAdapter
+import com.opendroid.ai.social.core.adapter.InstagramAdapter
+import com.opendroid.ai.social.core.adapter.LinkedInAdapter
+import com.opendroid.ai.social.core.adapter.TelegramAdapter
+import com.opendroid.ai.social.core.adapter.XAdapter
+import com.opendroid.ai.social.core.adapter.YouTubeAdapter
+import com.opendroid.ai.social.core.ai.SocialCampaignGenerator
+import com.opendroid.ai.social.core.ai.SocialCommentReplyEngine
+import com.opendroid.ai.social.core.ai.SocialContentComposer
+import com.opendroid.ai.social.core.ai.SocialWriters
+import com.opendroid.ai.social.core.analytics.SocialAnalyticsEngine
+import com.opendroid.ai.social.core.audit.SocialAuditLogger
+import com.opendroid.ai.social.domain.model.PostStatus
+import com.opendroid.ai.social.domain.model.SocialComment
+import com.opendroid.ai.social.domain.model.SocialCredentials
+import com.opendroid.ai.social.domain.model.SocialPlatform
+import java.util.concurrent.CopyOnWriteArrayList
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.runBlocking
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The planner's social actions while she is on: a post is saved with exactly the words its
+ * step carries and no writer is asked, a post without words is refused, and drafting
+ * replies or a campaign is refused. With her off a post without words is written by the
+ * composer as stock. Nothing here publishes: that stays his tap.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = MigrationTestApplication::class)
+class SocialActionsWordsTest {
+
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var repository: SocialRepository
+    private lateinit var manager: SocialManager
+    private lateinit var memory: MemoryRepository
+    private val model = RecordingModel()
+    private val context: Context get() = ApplicationProvider.getApplicationContext()
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        repository = SocialRepository(
+            database.socialAccountDao(),
+            database.socialPostDao(),
+            database.socialCommentDao(),
+            database.socialInteractionDao(),
+            database.socialAnalyticsDao(),
+            database.socialCampaignDao(),
+            database.socialAutomationRuleDao(),
+            database.socialAuditLogDao()
+        )
+        memory = MemoryRepository(database.memoryDao(), database.taskHistoryDao(), database.macroDao())
+        val client = OkHttpClient.Builder().addInterceptor { error("no social site is reached") }.build()
+        manager = SocialManager(
+            context,
+            repository,
+            NoCredentials,
+            SocialAuditLogger(repository),
+            memory,
+            TelegramAdapter(client),
+            DiscordAdapter(client),
+            XAdapter(client),
+            LinkedInAdapter(client),
+            YouTubeAdapter(client),
+            InstagramAdapter(client),
+            FacebookAdapter(client)
+        )
+    }
+
+    @After
+    fun tearDown() {
+        database.close()
+    }
+
+    @Test
+    fun `a post's own words are saved exactly as they are, with her on or off, and no writer is asked`() = runBlocking {
+        val words = "Bread's out of the oven at nine. Come early, the rye goes first."
+        for (presence in listOf(HerPresence.ON, HerPresence.OFF)) {
+            val result = action(presence, "SOCIAL_CREATE_POST")
+                .execute(mapOf("content" to words, "topic" to "bakery hours", "platform" to "x"), context)
+
+            assertTrue(result.success)
+        }
+
+        val drafts = repository.getAllPostsFlow().first()
+        assertEquals(listOf(words, words), drafts.map { it.content })
+        assertTrue(drafts.all { it.status == PostStatus.DRAFT && it.platform == SocialPlatform.X })
+        assertEquals(0, model.requests.size)
+    }
+
+    @Test
+    fun `with her on a post without its words is refused and nothing is saved`() = runBlocking {
+        for (params in listOf(mapOf("topic" to "bakery hours"), mapOf("content" to "  ", "topic" to "bakery hours"), emptyMap())) {
+            val result = action(HerPresence.ON, "SOCIAL_CREATE_POST").execute(params, context)
+
+            assertFalse("$params", result.success)
+            assertEquals("$params", "The post needs its words.", result.error)
+        }
+        assertTrue(repository.getAllPostsFlow().first().isEmpty())
+        assertEquals(0, model.requests.size)
+    }
+
+    @Test
+    fun `with her off a post without words is written by the composer as stock`() = runBlocking {
+        model.answer = "Fresh bread from nine."
+
+        val result = action(HerPresence.OFF, "SOCIAL_CREATE_POST").execute(mapOf("topic" to "bakery hours"), context)
+
+        assertTrue(result.success)
+        assertEquals(listOf("Fresh bread from nine."), repository.getAllPostsFlow().first().map { it.content })
+        assertEquals(1, model.requests.size)
+    }
+
+    @Test
+    fun `with her on no reply drafts and no campaign are written`() = runBlocking {
+        repository.saveComment(
+            SocialComment(
+                id = "c1", platformCommentId = "pc-1", postId = null, platform = SocialPlatform.X,
+                authorName = "Alex", content = "When do you open?"
+            )
+        )
+
+        val replies = action(HerPresence.ON, "SOCIAL_DRAFT_REPLIES").execute(emptyMap(), context)
+        val campaign = action(HerPresence.ON, "SOCIAL_CREATE_CAMPAIGN")
+            .execute(mapOf("name" to "Autumn", "objective" to "sell honey", "days" to "7"), context)
+
+        assertEquals(SocialWriters.REFUSAL, replies.error)
+        assertEquals(SocialWriters.REFUSAL, campaign.error)
+        assertNull(repository.getUnansweredComments().single().suggestedReply)
+        assertTrue(repository.getAllPostsFlow().first().isEmpty())
+        assertTrue(repository.getAllCampaignsFlow().first().isEmpty())
+        assertEquals(0, model.requests.size)
+    }
+
+    @Test
+    fun `the schema gives the post its words as an optional param`() {
+        val post = ActionSchema.getAction("SOCIAL_CREATE_POST")!!
+        val content = post.params.single { it.name == "content" }
+        assertFalse(content.required)
+        assertEquals("The exact words of the post", content.description)
+        // The topic is only for the composer, so a post with its own words needs none.
+        assertFalse(post.params.single { it.name == "topic" }.required)
+        val (validation, _) = ActionSchema.validateParams("SOCIAL_CREATE_POST", mapOf("content" to "hello"))
+        assertEquals(ActionSchema.ValidationResult.Valid, validation)
+    }
+
+    private fun action(presence: HerPresence, name: String): com.opendroid.ai.actions.base.Action =
+        SocialActions(
+            socialManager = manager,
+            socialRepository = repository,
+            contentComposer = SocialContentComposer({ model }, memory, presence),
+            replyEngine = SocialCommentReplyEngine({ model }, memory, presence),
+            campaignGenerator = SocialCampaignGenerator({ model }, presence),
+            analyticsEngine = unused(),
+            memoryRepository = memory,
+            herPresence = presence
+        ).getActions().single { it.name == name }
+
+    private inline fun <reified T> unused(): T {
+        val unsafeClass = Class.forName("sun.misc.Unsafe")
+        val unsafe = unsafeClass.getDeclaredField("theUnsafe").apply { isAccessible = true }.get(null)
+        return unsafeClass.getMethod("allocateInstance", Class::class.java).invoke(unsafe, T::class.java) as T
+    }
+
+    private object NoCredentials : SocialCredentialStore {
+        override fun getCredentials(accountId: String, platform: SocialPlatform): SocialCredentials? = null
+        override fun saveCredentials(credentials: SocialCredentials) = true
+        override fun removeCredentials(accountId: String, platform: SocialPlatform) = true
+        override fun hasCredentials(accountId: String, platform: SocialPlatform) = false
+        override fun clearAll() = true
+    }
+
+    private class RecordingModel : LLMProvider {
+        val requests = CopyOnWriteArrayList<LLMRequest>()
+        @Volatile var answer: String = "ok"
+        override val name: String = "Recording"
+        override val availableModels: List<String> = emptyList()
+        override suspend fun complete(request: LLMRequest): LLMResponse {
+            requests += request
+            return LLMResponse(answer, 1, "model", name, 1)
+        }
+        override fun streamComplete(request: LLMRequest): Flow<String> = flowOf(answer)
+        override suspend fun isAvailable(): Boolean = true
+    }
+}
