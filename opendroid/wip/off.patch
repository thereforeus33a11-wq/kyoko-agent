+class NothingAnswersMessagesTest {
+
+    private val context = ApplicationProvider.getApplicationContext<Application>()
+    private lateinit var database: OpenDroidDatabase
+    private lateinit var listener: OpenDroidNotificationListener
+
+    private val main = File("src/main/java/com/opendroid/ai")
+
+    @Before
+    fun setUp() {
+        database = Room.inMemoryDatabaseBuilder(context, OpenDroidDatabase::class.java)
+            .allowMainThreadQueries()
+            .build()
+        // Built and given a context, never bound: binding it needs the whole app.
+        listener = Robolectric.buildService(OpenDroidNotificationListener::class.java).get()
+        listener.notificationDao = database.notificationDao()
+        listener.notificationIntelligence = NotificationIntelligence(
+            database.notificationDao(),
+            MemoryRepository(database.memoryDao(), database.taskHistoryDao(), database.macroDao())
+        )
+    }
+
+    @After
+    fun tearDown() {
+        listener.onDestroy()
+        database.close()
+    }
+
+    @Test
+    fun `a message that could be answered is kept, and nothing answers it`() {
+        // A WhatsApp message, an SMS and a Gmail notification from a no-reply sender, each
+        // with a reply action the old auto-reply would have filled in and fired.
+        listener.onNotificationPosted(messageFrom("com.whatsapp", "Aoi", "are you coming?"))
+        listener.onNotificationPosted(messageFrom("com.google.android.apps.messaging", "+15551234567", "call me"))
+        listener.onNotificationPosted(
+            messageFrom("com.google.android.gm", "Tumblr", "Someone liked your post", "no-reply@tumblr.com")
+        )
+
+        savedRows(3)
+        // Long enough for a reply with no delay to have gone out, had anything scheduled one.
+        repeat(15) {
+            shadowOf(Looper.getMainLooper()).idle()
+            Thread.sleep(20)
+        }
+        val saved = savedRows(3)
+
+        assertEquals(setOf("com.whatsapp", "com.google.android.apps.messaging", "com.google.android.gm"), saved.map { it.packageName }.toSet())
+        assertTrue(saved.none { it.isAutoReplied || it.autoReplyText != null })
+        // No reply action was fired, no compose screen was opened and no SMS went out.
+        assertTrue(shadowOf(context).broadcastIntents.none { it.action == REPLY_ACTION })
+        assertNull(shadowOf(context).nextStartedActivity)
+        val sms = shadowOf(context.getSystemService(SmsManager::class.java))
+        assertNull(sms.lastSentTextMessageParams)
+        assertNull(sms.lastSentMultipartTextMessageParams)
+    }
+
+    @Test
+    fun `the listener holds nothing that could answer a message`() {
+        // Only the history and its patterns: no engine, no dispatcher, no settings.
+        val injected = OpenDroidNotificationListener::class.java.declaredFields
+            .filter { it.isAnnotationPresent(javax.inject.Inject::class.java) || it.name.endsWith("Dao") || it.name.endsWith("Intelligence") }
+            .map { it.type.simpleName }
+            .toSet()
+        assertEquals(setOf("NotificationDao", "NotificationIntelligence"), injected)
+        val source = File(main, "core/service/OpenDroidNotificationListener.kt").readText()
+        assertFalse(source.contains("AutoReply"))
+        assertFalse(source.contains("SettingsRepository"))
+    }
+
+    @Test
+    fun `no code answers a message or reads the saved auto-reply switches`() {
+        val sources = main.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+        assertTrue(sources.size > 100)
+        fun users(text: String) = sources.filter { it.readText().contains(text) }.map { it.relativeTo(main).path.replace('\\', '/') }
+
+        // The writer and its sender are gone: the stock prompt that wrote "on behalf of" him,
+        // the inline reply filled into another app's notification, and the "Re:" email draft.
+        assertEquals(emptyList<String>(), users("auto-replying on behalf of"))
+        assertEquals(emptyList<String>(), users("RemoteInput.addResultsToIntent"))
+        assertEquals(emptyList<String>(), users("\"Re: "))
+        for (gone in listOf("AutoReplyPrompts.kt", "AutoReplyGenerator.kt", "AutoReplyEngine.kt", "ReplyDispatcher.kt")) {
+            assertTrue(gone, sources.none { it.name == gone })
+        }
+        // What an earlier build saved is only read where it is stored and turned off once.
+        assertEquals(listOf("data/repository/SettingsRepository.kt"), users("autoReplyConfig"))
+        assertEquals(emptyList<String>(), users("updateAutoReplyConfig"))
+    }
+
+    /** The saved rows once there are [count] of them; the listener saves on its own thread. */
+    private fun savedRows(count: Int): List<com.opendroid.ai.data.db.entities.NotificationEntity> {
+        val until = System.currentTimeMillis() + WAIT_MS
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            val rows = runBlocking(Dispatchers.IO) { database.notificationDao().getRecentNotifications() }
+            if (rows.size >= count || System.currentTimeMillis() > until) return rows
+            Thread.sleep(20)
+        }
+    }
+
+    private fun messageFrom(packageName: String, from: String, text: String, address: String? = null): StatusBarNotification {
+        val me = Person.Builder().setName("Me").build()
+        val sender = Person.Builder().setName(from).build()
+        val style = NotificationCompat.MessagingStyle(me).addMessage(text, 1_000L, sender)
+        val reply = PendingIntent.getBroadcast(context, 0, Intent(REPLY_ACTION), PendingIntent.FLAG_MUTABLE)
+        val notification = NotificationCompat.Builder(context, "messages")
+            .setSmallIcon(android.R.drawable.ic_dialog_info)
+            .setContentTitle(from)
+            .setContentText(text)
+            .setCategory(if (address != null) Notification.CATEGORY_EMAIL else Notification.CATEGORY_MESSAGE)
+            .setStyle(style)
+            .addAction(
+                NotificationCompat.Action.Builder(0, "Reply", reply)
+                    .addRemoteInput(RemoteInput.Builder("text").build())
+                    .build()
+            )
+            .build()
+        address?.let { notification.extras.putCharSequence(Notification.EXTRA_INFO_TEXT, it) }
+        // Posted now: the history keeps 30 days and drops anything older as it is saved.
+        @Suppress("DEPRECATION")
+        return StatusBarNotification(
+            packageName, packageName, 1, from, 10_123, 0, 0,
+            notification, Process.myUserHandle(), System.currentTimeMillis()
+        )
+    }
+
+    private companion object {
+        const val REPLY_ACTION = "com.example.REPLY"
+        const val WAIT_MS = 5_000L
+    }
+}
