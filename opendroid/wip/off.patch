+package com.opendroid.ai.di
+
+import com.opendroid.ai.core.agent.HerPresence
+import com.opendroid.ai.core.persona.PersonaEngine
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import javax.inject.Singleton
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * Hands the code that must not write while she is on (the social writers, actions and
+ * screens) her engine's one answer to whether she is the one who talks, without that
+ * code importing her package. Her engine is asked for lazily, when the answer is first
+ * needed, so a social class never pulls it in where it is not asked.
+ */
+@Module
+@InstallIn(SingletonComponent::class)
+object HerPresenceModule {
+
+    @Provides
+    @Singleton
+    fun provideHerPresence(persona: dagger.Lazy<PersonaEngine>): HerPresence = object : HerPresence {
+        override suspend fun isOn(): Boolean = persona.get().isActive()
+        override val on: Flow<Boolean> get() = persona.get().active
+    }
+}
