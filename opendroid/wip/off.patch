index 0000000..fd35b27
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/ui/screens/social/WritersOffScreensTest.kt
@@ -0,0 +1,49 @@
+package com.opendroid.ai.ui.screens.social
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * While she is on, the Social screens say that posts and replies are written by him or by
+ * her, in place of the composer's writing controls, the reply drafts and the campaign
+ * generator; and a writer refused on a tap says the same, rather than failing quietly.
+ */
+class WritersOffScreensTest {
+
+    private val main = File("src/main/java/com/opendroid/ai")
+    private fun source(path: String) = File(main, path).readText()
+
+    @Test
+    fun `the social screen hands whether she is on to the three tabs that write`() {
+        val screen = source("ui/screens/SocialScreen.kt")
+        assertTrue(screen.contains("val writersOff by viewModel.writersOff.collectAsState()"))
+        assertEquals(3, Regex("""writersOff = writersOff""").findAll(screen).count())
+    }
+
+    @Test
+    fun `each of those tabs shows the notice in place of its writer`() {
+        val content = source("ui/screens/social/SocialContentTab.kt")
+        assertTrue(content.contains("if (writersOff) {\n                        WritersOffNotice()"))
+        // Shorten, Expand, Add CTA and Make Excited are writers; taking hashtags out is not.
+        assertEquals(4, Regex("""if \(!writersOff\) item \{""").findAll(content).count())
+
+        val comments = source("ui/screens/social/SocialCommentsTab.kt")
+        assertTrue(comments.contains("WritersOffNotice()"))
+        assertTrue(comments.contains("if (writersOff) {\n                                // Nothing drafts a reply while she is on"))
+
+        val campaigns = source("ui/screens/social/SocialCampaignsTab.kt")
+        assertTrue(campaigns.contains("item { WritersOffNotice() }"))
+        assertTrue(campaigns.contains("if (showCreateDialog && !writersOff) {"))
+    }
+
+    @Test
+    fun `a refused writer is told on the screen with the plain line`() {
+        val viewModel = source("ui/viewmodel/SocialViewModel.kt")
+        assertEquals(3, Regex("""_statusMessage\.value = SocialWriters\.REFUSAL""").findAll(viewModel).count())
+        for (writer in listOf("contentComposer.shorten(", "contentComposer.expand(", "contentComposer.changeTone(", "contentComposer.addCta(", "commentReplyEngine.generateReply(")) {
+            assertTrue(writer, viewModel.contains("written { $writer"))
+        }
+    }
+}
