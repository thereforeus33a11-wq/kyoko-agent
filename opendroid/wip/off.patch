diff --git a/app/src/test/java/com/opendroid/ai/actions/MacroRunTest.kt b/app/src/test/java/com/opendroid/ai/actions/MacroRunTest.kt
new file mode 100644
index 0000000..b208287
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/actions/MacroRunTest.kt
@@ -0,0 +1,185 @@
+package com.opendroid.ai.actions
+
+import android.content.Context
+import android.content.ContextWrapper
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.agent.ActionSequenceExecutor
+import com.opendroid.ai.data.db.dao.MacroDao
+import com.opendroid.ai.data.db.entities.MacroEntity
+import com.opendroid.ai.data.models.PlanStep
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * RUN_MACRO runs only a macro he left on, and never writes to an address or number that
+ * only sends: such a step is left out with the plain reason, and so is a step that uses
+ * what it would have returned. The result names every step that was left out.
+ */
+class MacroRunTest {
+
+    private val context: Context = ContextWrapper(null)
+
+    @Test
+    fun `a macro he switched off does not run and says so`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro("evening", enabled = false, step("s1", 1, "SEND_SMS", "to" to "+15551234567", "message" to "home soon")),
+            dispatched
+        )
+
+        assertFalse(result.success)
+        assertEquals("Macro 'evening' is switched off, so it did not run.", result.error)
+        assertEquals(emptyList<String>(), dispatched)
+    }
+
+    @Test
+    fun `a step to an address that only sends is skipped, and the rest runs`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "morning", enabled = true,
+                step("s1", 1, "GET_WEATHER", "location" to "Osaka"),
+                step("s2", 2, "SEND_EMAIL", "to" to "Tumblr <no-reply@tumblr.com>", "subject" to "Re: your post", "body" to "thanks"),
+                step("s3", 3, "SEND_SMS", "to" to "+15551234567", "message" to "up early today")
+            ),
+            dispatched
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("GET_WEATHER", "SEND_SMS"), dispatched)
+        assertEquals(
+            "Macro completed successfully (2 steps). " +
+                "Step 2 (SEND_EMAIL) was skipped: no-reply@tumblr.com is an address that only sends.",
+            result.data
+        )
+    }
+
+    @Test
+    fun `a step that uses what a skipped step would have returned is skipped too`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro(
+                "codes", enabled = true,
+                step("s1", 1, "SEND_SMS", "to" to "57575", "message" to "STOP"),
+                step("s2", 2, "COPY_TO_CLIPBOARD", "text" to "\$\$s1"),
+                step("s10", 3, "GET_WEATHER", "location" to "Osaka")
+            ),
+            dispatched
+        )
+
+        assertTrue(result.success)
+        assertEquals(listOf("GET_WEATHER"), dispatched)
+        val data = result.data.orEmpty()
+        assertTrue(data, data.contains("Step 1 (SEND_SMS) was skipped: 57575 is an SMS short code, which only sends."))
+        assertTrue(data, data.contains("Step 2 (COPY_TO_CLIPBOARD) was skipped: it uses what a skipped step would have returned."))
+    }
+
+    @Test
+    fun `a macro whose every step is skipped does nothing and says why`() = runBlocking {
+        val dispatched = mutableListOf<String>()
+        val result = run(
+            macro("bots", enabled = true, step("s1", 1, "SEND_TELEGRAM", "username" to "@weather_bot", "message" to "hi")),
+            dispatched
+        )
+
+        assertFalse(result.success)
+        assertEquals("Macro 'bots' did not run: Step 1 (SEND_TELEGRAM) was skipped: @weather_bot is a bot.", result.error)
+        assertEquals(emptyList<String>(), dispatched)
+    }
+
+    @Test
+    fun `a failure of the steps that ran still names the skipped ones`() = runBlocking {
+        val result = run(
+            macro(
+                "mixed", enabled = true,
+                step("s1", 1, "SEND_EMAIL", "to" to "notifications@github.com", "subject" to "x", "body" to "y"),
+                step("s2", 2, "OPEN_APP", "app" to "maps")
+            ),
+            mutableListOf(),
+            outcome = { ActionResult.Failure("Maps is not installed.") }
+        )
+
+        assertFalse(result.success)
+        assertEquals(
+            "Macro stopped at step 2 (OPEN_APP): Maps is not installed. " +
+                "Step 1 (SEND_EMAIL) was skipped: notifications@github.com is an address that only sends.",
+            result.error
+        )
+    }
+
+    @Test
+    fun `people, calls and steps that write to nobody are left as they are`() {
+        val sorted = MacroRun.sort(
+            listOf(
+                step("s1", 1, "SEND_WHATSAPP", "contact" to "Mom", "message" to "on my way"),
+                step("s2", 2, "SEND_EMAIL", "to" to "aoi@example.com", "subject" to "hi", "body" to "hello"),
+                // A short number can be an emergency line: a call is never skipped.
+                step("s3", 3, "MAKE_CALL", "contact" to "112"),
+                step("s4", 4, "CONVERT_UNITS", "value" to "5", "from" to "km", "to" to "miles")
+            )
+        )
+
+        assertEquals(listOf("s1", "s2", "s3", "s4"), sorted.toRun.map { it.stepId })
+        assertTrue(sorted.skipped.isEmpty())
+    }
+
+    @Test
+    fun `the steps run in the macro's order`() {
+        val sorted = MacroRun.sort(
+            listOf(
+                step("b", 2, "SEND_SMS", "to" to "VM-HDFCBK", "message" to "ok"),
+                step("a", 1, "GET_WEATHER", "location" to "Osaka")
+            )
+        )
+
+        assertEquals(listOf("a"), sorted.toRun.map { it.stepId })
+        assertEquals(listOf(MacroRun.Skipped(2, "SEND_SMS", "VM-HDFCBK is an SMS sender ID, which only sends")), sorted.skipped)
+    }
+
+    private suspend fun run(
+        macro: MacroEntity,
+        dispatched: MutableList<String>,
+        outcome: (String) -> ActionResult = { ActionResult.Success() }
+    ): ActionResult {
+        val actions = MacroActions(
+            macroDao = OneMacroDao(macro),
+            actionSequenceExecutor = ActionSequenceExecutor(
+                executeAction = { action, _, _ ->
+                    dispatched += action
+                    outcome(action)
+                },
+                hasAction = { true }
+            )
+        )
+        return actions.getActions().first { it.name == "RUN_MACRO" }.execute(mapOf("macroName" to macro.name), context)
+    }
+
+    private fun step(id: String, order: Int, action: String, vararg params: Pair<String, String>) =
+        PlanStep(stepId = id, order = order, description = action, action = action, params = params.toMap())
+
+    private fun macro(name: String, enabled: Boolean, vararg steps: PlanStep) = MacroEntity(
+        id = "macro-$name",
+        name = name,
+        trigger = "manual",
+        stepsJson = Json.encodeToString(steps.toList()),
+        isSystem = false,
+        isEnabled = enabled
+    )
+
+    private class OneMacroDao(private val macro: MacroEntity) : MacroDao {
+        override fun getAllMacrosFlow(): Flow<List<MacroEntity>> = MutableStateFlow(listOf(macro))
+        override suspend fun getAllMacros(): List<MacroEntity> = listOf(macro)
+        override suspend fun getMacroById(id: String): MacroEntity? = macro.takeIf { it.id == id }
+        override suspend fun getMacroByName(name: String): MacroEntity? = macro.takeIf { it.name == name }
+        override suspend fun insertMacro(macro: MacroEntity) = error("not written")
+        override suspend fun deleteMacro(id: String) = error("not deleted")
+        override suspend fun clearAllMacros() = error("not cleared")
+    }
+}
