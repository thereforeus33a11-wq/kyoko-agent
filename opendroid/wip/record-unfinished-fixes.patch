+
+    /** An import over [rows] of the app's history, with no auto-replies, that keeps its flag in memory. */
+    private fun importOf(rows: List<TaskHistoryEntity>, flag: MemoryFlag = MemoryFlag()) =
+        HistoryImport(taskHistory = { rows }, notificationsSince = { emptyList() }, flag = flag)
+
+    /** The record's own entry of the plan [planId]: what the plan loop puts when it ends. */
+    private fun ownEntry(planId: String) =
+        textEntry(planId, now - 60_000L, to = "Nene", words = "I'm late").copy(endedAt = now)
+
+    @Test
+    fun `a plan that ran after the update, before the record was first opened, is kept once`() = runBlocking {
+        // He says "text Nene I'm late": the plan logs its row to the history, then goes on
+        // the record. That put is the record's first open, so the import runs then.
+        val history = listOf(row("plan-x", "SEND_SMS", """{"contact":"Nene","message":"I'm late"}""", now - 60_000L))
+        val record = PhoneLog(dir, FakeSeal(), { now }, importOf(history))
+        record.put(ownEntry("plan-x"))
+        assertEquals(listOf("plan-x"), record.entries().map { it.id })
+        assertEquals(listOf("plan-x"), PhoneLog(dir, FakeSeal(), { now }).entries().map { it.id })
+    }
+
+    @Test
+    fun `the import's copy of a plan goes when the plan's own entry comes, and is not brought in beside one`() = runBlocking {
+        val history = listOf(
+            row("plan-x", "SEND_SMS", """{"contact":"Nene","message":"I'm late"}""", now - 60_000L),
+            row("plan-old", "TOGGLE_WIFI", "{}", now - 3 * DAY)
+        )
+        // Her reply opened the record first, while the plan's entry was still on its way.
+        val first = PhoneLog(dir, FakeSeal(), { now }, importOf(history))
+        assertEquals(
+            setOf(HistoryImport.importedPlanId("plan-x"), HistoryImport.importedPlanId("plan-old")),
+            first.entries().map { it.id }.toSet()
+        )
+        first.put(ownEntry("plan-x"))
+        assertEquals(listOf(HistoryImport.importedPlanId("plan-old"), "plan-x"), first.entries().map { it.id })
+        dir.deleteRecursively()
+
+        // The record already holds the plan (an earlier import could not be written): its copy is not brought in.
+        PhoneLog(dir, FakeSeal(), { now }).put(ownEntry("plan-x"))
+        val flag = MemoryFlag()
+        val later = PhoneLog(dir, FakeSeal(), { now }, importOf(history, flag))
+        assertEquals(listOf(HistoryImport.importedPlanId("plan-old"), "plan-x"), later.entries().map { it.id })
+        assertTrue(flag.set)
+    }
 }
