+        val fresh = steps.indexOf("planStarts.stepStarted(currentPlanState.planId, stepToExecute.stepId)")
+        val given = steps.indexOf("planStarts.valuesGiven(currentPlanState.planId, stepToExecute.stepId, stepToExecute.action, resolvedParams, ranWith)")
+        val fallback = steps.indexOf("planStarts.fallbackRan(currentPlanState.planId, stepToExecute.stepId, stepToExecute.fallback)")
+        assertTrue(fresh in 0 until given)
+        assertTrue(given < fallback)
+        val asked = loop.substringAfter("private suspend fun resolveNeedsInput(").substringBefore("\n    }\n")
+        assertTrue(asked.contains("if (params != initialParams) ranWith(params)"))
+    }
 }
