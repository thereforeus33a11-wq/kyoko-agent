+package com.opendroid.ai.core.record
+
+import java.security.GeneralSecurityException
+
+/** A seal for tests: reversible, not the clear text, and it knows its own bytes. */
+internal class FakeSeal : RecordSeal {
+    var sealed = 0
+        private set
+
+    override fun seal(plain: ByteArray): ByteArray {
+        sealed++
+        return MARK + plain.map { (it.toInt() xor 0x5A).toByte() }.toByteArray()
+    }
+
+    override fun open(sealed: ByteArray): ByteArray {
+        if (sealed.size < MARK.size || !sealed.copyOfRange(0, MARK.size).contentEquals(MARK)) {
+            throw GeneralSecurityException("not sealed by this seal")
+        }
+        return sealed.copyOfRange(MARK.size, sealed.size).map { (it.toInt() xor 0x5A).toByte() }.toByteArray()
+    }
+
+    private companion object {
+        val MARK = "FAKESEAL".toByteArray()
+    }
+}
+
+/** A seal whose key is gone: it seals, but nothing it is given can be opened. */
+internal class KeyGoneSeal : RecordSeal {
+    override fun seal(plain: ByteArray): ByteArray = FakeSeal().seal(plain)
+    override fun open(sealed: ByteArray): ByteArray = throw GeneralSecurityException("key is gone")
+}
+
+internal const val DAY = 24L * 60 * 60 * 1000
+internal const val HOUR = 60L * 60 * 1000
+
+/** One entry of his: a text to [to] with [words], [at] millis. */
+internal fun textEntry(
+    id: String,
+    at: Long,
+    to: String = "Nene",
+    words: String = "running late",
+    who: Starter = Starter.HIM_CHAT,
+    why: String? = "text $to that i'm $words",
+    how: LetThrough? = LetThrough.HIS_YES,
+    end: StepEnd = StepEnd.DONE,
+    reason: String? = null
+) = PhoneLogEntry(
+    id = id,
+    at = at,
+    who = who,
+    why = why,
+    letThrough = how,
+    steps = listOf(
+        PhoneLogStep(
+            line = "Send SMS to $to",
+            kind = "Send SMS",
+            app = "Messages",
+            words = listOf(SentWords("message", words)),
+            end = end,
+            reason = reason
+        )
+    ),
+    outcome = if (end == StepEnd.DONE) Outcome.DONE else Outcome.FAILED
+)
