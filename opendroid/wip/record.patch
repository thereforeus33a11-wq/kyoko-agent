index 0000000..4f3c803
--- /dev/null
+++ b/app/src/test/java/com/opendroid/ai/core/agent/ActionSequenceRecordTest.kt
@@ -0,0 +1,110 @@
+package com.opendroid.ai.core.agent
+
+import android.content.Context
+import android.content.ContextWrapper
+import com.opendroid.ai.actions.base.ActionResult
+import com.opendroid.ai.core.record.LetThrough
+import com.opendroid.ai.core.record.Outcome
+import com.opendroid.ai.core.record.PhoneLogEntry
+import com.opendroid.ai.core.record.PhoneRecorder
+import com.opendroid.ai.core.record.SequenceRun
+import com.opendroid.ai.core.record.Starter
+import com.opendroid.ai.core.record.StepEnd
+import com.opendroid.ai.data.models.PlanStep
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** A macro's or a routine's run goes on the record of what the phone did, with every step inside it. */
+class ActionSequenceRecordTest {
+    private val context: Context = ContextWrapper(null)
+    private val recorded = mutableListOf<PhoneLogEntry>()
+    private val recorder = PhoneRecorder { recorded += it }
+
+    private fun executor(execute: suspend (String, Map<String, String>) -> ActionResult) =
+        ActionSequenceExecutor({ action, params, _ -> execute(action, params) }, { true }, recorder, clock = { 42L })
+
+    private fun step(id: String, order: Int, action: String, params: Map<String, String> = emptyMap()) =
+        PlanStep(stepId = id, order = order, description = "", action = action, params = params)
+
+    @Test
+    fun `a macro's run is one entry under its name, with each step and its words, and no results`() = runBlocking {
+        val result = executor { action, _ ->
+            if (action == "READ_NOTIFICATIONS") ActionResult.Success(mapOf("message" to "Mom: the party is at 8")) else ActionResult.Success()
+        }.execute(
+            listOf(
+                step("s1", 1, "READ_NOTIFICATIONS"),
+                step("s2", 2, "SEND_SMS", mapOf("contact" to "Aoi", "message" to "Mom wrote: \$s1"))
+            ),
+            context,
+            SequenceRun.macro("party news")
+        )
+        assertTrue(result.success)
+        val entry = recorded.single()
+        assertEquals(Starter.MACRO, entry.who)
+        assertEquals("party news", entry.why)
+        assertEquals(42L, entry.at)
+        assertEquals(null as LetThrough?, entry.letThrough)
+        assertEquals(listOf(StepEnd.DONE, StepEnd.DONE), entry.steps.map { it.end })
+        assertEquals(Outcome.DONE, entry.outcome)
+        assertEquals("Mom wrote: [the answer to step 1]", entry.steps[1].words.single().text)
+        assertFalse(Json.encodeToString(entry).contains("party is at 8"))
+    }
+
+    @Test
+    fun `a routine that stops at a step says what failed, what was left open and what never ran`() = runBlocking {
+        executor { action, _ ->
+            when (action) {
+                "SEND_EMAIL" -> ActionResult.UserActionRequired("Email draft opened. Review it and tap Send; sending was not verified.")
+                else -> ActionResult.Success()
+            }
+        }.execute(
+            listOf(
+                step("s1", 1, "TOGGLE_WIFI"),
+                step("s2", 2, "SEND_EMAIL", mapOf("to" to "a@b.c", "subject" to "hi", "body" to "hello")),
+                step("s3", 3, "SET_ALARM")
+            ),
+            context,
+            SequenceRun.routine("weekday morning")
+        )
+        val entry = recorded.single()
+        assertEquals(Starter.ROUTINE, entry.who)
+        assertEquals(listOf(StepEnd.DONE, StepEnd.LEFT_OPEN, StepEnd.NOT_RUN), entry.steps.map { it.end })
+        assertEquals(Outcome.PARTLY, entry.outcome)
+
+        recorded.clear()
+        executor { _, _ -> ActionResult.Failure("No clock app.") }
+            .execute(listOf(step("s1", 1, "SET_ALARM")), context, SequenceRun.routine("weekday morning"))
+        assertEquals(StepEnd.FAILED, recorded.single().steps.single().end)
+        assertEquals("No clock app.", recorded.single().steps.single().reason)
+    }
+
+    @Test
+    fun `a run that is stopped still goes on the record, with the step under way not called done`() {
+        try {
+            runBlocking {
+                executor { action, _ -> if (action == "SEND_SMS") throw CancellationException("stopped") else ActionResult.Success() }
+                    .execute(
+                        listOf(step("s1", 1, "TOGGLE_WIFI"), step("s2", 2, "SEND_SMS", mapOf("contact" to "Aoi", "message" to "hi"))),
+                        context,
+                        SequenceRun.macro("m")
+                    )
+            }
+        } catch (expected: CancellationException) {
+            // The run was stopped.
+        }
+        assertEquals(listOf(StepEnd.DONE, StepEnd.INTERRUPTED), recorded.single().steps.map { it.end })
+        assertEquals(Outcome.STOPPED, recorded.single().outcome)
+    }
+
+    @Test
+    fun `steps run without a name are not recorded here`() = runBlocking {
+        executor { _, _ -> ActionResult.Success() }.execute(listOf(step("s1", 1, "TOGGLE_WIFI")), context)
+        assertTrue(recorded.isEmpty())
+    }
+}
diff --git a/app/src/test/java/com/opendroid/ai/core/agent/AutomatedSenderTest.kt b/app/src/test/java/com/opendroid/ai/core/agent/AutomatedSenderTest.kt
