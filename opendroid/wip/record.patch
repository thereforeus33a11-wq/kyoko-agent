@@ -0,0 +1,101 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.agent.PlanRecord
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import java.util.UUID
+
+/**
+ * Who a run of saved steps is ([SequenceRun]): a macro or a routine, by its name. The
+ * executor that runs both is handed one by its caller, so that the run goes on the record
+ * as what it is, with every step inside it.
+ */
+data class SequenceRun(val who: Starter, val name: String) {
+    companion object {
+        fun macro(name: String) = SequenceRun(Starter.MACRO, name)
+        fun routine(name: String) = SequenceRun(Starter.ROUTINE, name)
+    }
+}
+
+/** The entries of runs that are not plans of the chat loop: macros, routines and sends from the app's screens. */
+internal object RunEntries {
+
+    /**
+     * The entry of one run of [run]'s saved steps, [steps] as they stand when it ended.
+     * [handedOverStepId] is a step that left something open for him (a draft waiting for
+     * his tap), which ends the run without being done.
+     */
+    fun sequence(
+        run: SequenceRun,
+        steps: List<PlanStep>,
+        ending: PlanEntries.Ending,
+        handedOverStepId: String?,
+        atMillis: Long
+    ): PhoneLogEntry? {
+        val plan = Plan(
+            planId = "${run.who.name.lowercase()}-${UUID.randomUUID()}",
+            goal = run.name,
+            estimatedDuration = "",
+            estimatedSteps = steps.size,
+            steps = steps,
+            createdAt = atMillis
+        )
+        return PlanEntries.of(
+            plan = plan,
+            start = PlanStarts.Start(who = run.who, why = run.name),
+            ending = ending,
+            fallbackWho = run.who,
+            handedOver = { it.stepId == handedOverStepId }
+        )
+    }
+
+    /** What a send from a social screen was. */
+    enum class SocialSend(val kind: String, val param: String) {
+        POST("Publish post", "content"),
+        COMMENT_REPLY("Reply to comment", "reply"),
+        INBOX_REPLY("Reply to message", "reply")
+    }
+
+    /**
+     * The entry of one send to a social site: [send] on [platform], to [to] (the author
+     * answered, or the account a post goes out from), with [words] in full. [actor] is who
+     * the social code says started it: "USER" is his own tap on the app's screen, anything
+     * else is the app by itself. [error] is why it failed, null when it went through.
+     */
+    fun social(
+        send: SocialSend,
+        platform: String,
+        to: String?,
+        words: String,
+        actor: String,
+        error: String?,
+        atMillis: Long
+    ): PhoneLogEntry {
+        val byHim = actor == HIS_TAP_ACTOR
+        val target = to?.trim()?.takeIf { it.isNotEmpty() }
+        val line = when (send) {
+            SocialSend.POST -> send.kind + (target?.let { " as $it" }.orEmpty())
+            else -> send.kind + (target?.let { " from $it" }.orEmpty())
+        }
+        val failed = error != null
+        val step = PhoneLogStep(
+            line = "$line on $platform",
+            kind = send.kind,
+            app = platform,
+            words = listOf(SentWords(send.param, words)),
+            end = if (failed) StepEnd.FAILED else StepEnd.DONE,
+            reason = if (failed) PlanRecord.reason(error) else null
+        )
+        return PhoneLogEntry(
+            id = "social-${UUID.randomUUID()}",
+            at = atMillis,
+            who = if (byHim) Starter.HIM_SCREEN else Starter.APP,
+            letThrough = if (byHim) LetThrough.HIS_TAP else null,
+            steps = listOf(step),
+            outcome = if (failed) Outcome.FAILED else Outcome.DONE
+        ).bounded()
+    }
+
+    /** The actor the social code gives a send made by his own tap. */
+    const val HIS_TAP_ACTOR = "USER"
+}
