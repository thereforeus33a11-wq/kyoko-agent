+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt
@@ -0,0 +1,48 @@
+package com.opendroid.ai.core.record
+
+import android.util.Log
+import com.opendroid.ai.core.persona.PersonaPrompts
+import com.opendroid.ai.core.persona.PhoneRecordLink
+import kotlinx.coroutines.CancellationException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Her door to the record of what the phone did ([PhoneRecordLink]): the entries are picked
+ * ([RecordLines]) and worded here, and she is handed the finished lines, each with its age
+ * in the words her prompt gives the app's other lines ([PersonaPrompts.age]).
+ *
+ * A record that cannot be read is no lines at all: her prompt is never held up by it.
+ */
+@Singleton
+class RecordForHer internal constructor(private val entries: suspend () -> List<PhoneLogEntry>) : PhoneRecordLink {
+
+    @Inject
+    constructor(record: PhoneRecord) : this({ record.entries() })
+
+    override suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forReply(it, hisMessage, nowMillis) }
+
+    override suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forMoment(it, nowMillis) }
+
+    override suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String> =
+        worded(heldBack, nowMillis) { RecordLines.forNotebook(it, sinceMillis, nowMillis) }
+
+    private suspend fun worded(
+        heldBack: Boolean,
+        nowMillis: Long,
+        pick: (List<PhoneLogEntry>) -> List<PhoneLogEntry>
+    ): List<String> = try {
+        pick(entries()).map { RecordLines.line(it, heldBack, PersonaPrompts.age(nowMillis - it.at)) }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        Log.w(TAG, "The record was not read for her: ${e.javaClass.simpleName}")
+        emptyList()
+    }
+
+    private companion object {
+        const val TAG = "RecordForHer"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt
new file mode 100644
index 0000000..af01bc0
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordLines.kt
@@ -0,0 +1,187 @@
+package com.opendroid.ai.core.record
+
+/**
+ * Which entries of the record she is told, and how each reads: one line per entry, in the
+ * app's plain words, with its age in front.
+ *
+ * Which entries:
+ *  - A reply of hers ([forReply]): the newest of the last two days, and older ones (within
+ *    the record's 30 days) that his message is about: they share a word with it that is
+ *    rare in the record, such as who a message went to, an app, or a word that was sent.
+ *  - A moment of her own ([forMoment]): the last day.
+ *  - Her notebook pass ([forNotebook]): what was done since its last pass.
+ * Each list is oldest first, the way the app's other lines are.
+ *
+ * How each reads ([line]): who started it and why, how it was let through, then every
+ * step with who or what it acts on, the app, the words it sent and how it ended. Where her
+ * route holds his details back, an entry keeps only its kind and its time: who started it,
+ * how it was let through, the bare action of each step and how it ended. Who a step went
+ * to, what it said, his message, a reason (which can name a contact) and a macro's name
+ * stay on the phone.
+ */
+internal object RecordLines {
+
+    const val REPLY_RECENT = 8
+    const val REPLY_RELATED = 4
+    const val MOMENT_ENTRIES = 8
+    const val NOTEBOOK_ENTRIES = 12
+
+    const val RECENT_MILLIS = 2L * 24 * 60 * 60 * 1000
+    const val DAY_MILLIS = 24L * 60 * 60 * 1000
+
+    /** How much of one sent text her prompt shows. The record keeps more. */
+    const val MAX_SHOWN_WORDS_CHARS = 280
+
+    /** How long one entry's line can be in her prompt. */
+    const val MAX_LINE_CHARS = 900
+
+    // An entry stamped a little ahead of the clock (a clock that moved) is still shown.
+    private const val CLOCK_SLACK_MILLIS = 60_000L
+
+    fun forReply(entries: List<PhoneLogEntry>, hisMessage: String, nowMillis: Long): List<PhoneLogEntry> {
+        val shown = entries.filter { it.at <= nowMillis + CLOCK_SLACK_MILLIS && it.at >= nowMillis - PhoneLog.MAX_AGE_MILLIS }
+        val recentFrom = nowMillis - RECENT_MILLIS
+        val recent = shown.filter { it.at >= recentFrom }.sortedBy { it.at }.takeLast(REPLY_RECENT)
+        val older = shown.filter { it.at < recentFrom }
+        val related = about(older, shown, hisMessage).take(REPLY_RELATED)
+        return (related + recent).distinctBy { it.id }.sortedBy { it.at }
+    }
+
+    fun forMoment(entries: List<PhoneLogEntry>, nowMillis: Long): List<PhoneLogEntry> =
+        entries.filter { it.at <= nowMillis + CLOCK_SLACK_MILLIS && it.at >= nowMillis - DAY_MILLIS }
+            .sortedBy { it.at }
+            .takeLast(MOMENT_ENTRIES)
+
+    fun forNotebook(entries: List<PhoneLogEntry>, sinceMillis: Long, nowMillis: Long): List<PhoneLogEntry> =
+        entries.filter { it.at > sinceMillis && it.at <= nowMillis + CLOCK_SLACK_MILLIS && it.at >= nowMillis - PhoneLog.MAX_AGE_MILLIS }
+            .sortedBy { it.at }
+            .takeLast(NOTEBOOK_ENTRIES)
+
+    /**
+     * The entries of [candidates] that [message] is about, best first: those that share
+     * the most of its rare words, and of two alike the newer. A word is rare when few
+     * entries of the whole record ([all]) hold it, so a word every entry has ("send",
+     * an app he uses every day) points at none of them.
+     */
+    fun about(candidates: List<PhoneLogEntry>, all: List<PhoneLogEntry>, message: String): List<PhoneLogEntry> {
+        if (candidates.isEmpty()) return emptyList()
+        val asked = words(message)
+        if (asked.isEmpty()) return emptyList()
+        val wordsOf = all.associate { it.id to words(searchText(it)) }
+        val holding = wordsOf.values.flatMap { it }.groupingBy { it }.eachCount()
+        // In a tenth of the record at most, and never fewer than two entries: one other entry may share it.
+        val rareAt = maxOf(2, all.size / 10)
+        val rare = asked.filter { (holding[it] ?: 0) in 1..rareAt }.toSet()
+        if (rare.isEmpty()) return emptyList()
+        return candidates
+            .map { entry -> entry to (wordsOf[entry.id] ?: words(searchText(entry))).count { it in rare } }
+            .filter { it.second > 0 }
+            .sortedWith(compareByDescending<Pair<PhoneLogEntry, Int>> { it.second }.thenByDescending { it.first.at })
+            .map { it.first }
+    }
+
+    /** What of an entry his message can be about: why, who and what each step acted on, the app, the words. */
+    private fun searchText(entry: PhoneLogEntry): String = buildString {
+        entry.why?.let { append(it).append(' ') }
+        entry.steps.forEach { step ->
+            append(step.line).append(' ')
+            step.app?.let { append(it).append(' ') }
+            step.words.forEach { append(it.text).append(' ') }
+        }
+    }
+
+    /** The words of [text] that can tell entries apart: letters and digits, lowercased, no common words. */
+    internal fun words(text: String): Set<String> =
+        WORD.findAll(text.lowercase()).map { it.value }
+            .filter { word -> (word.length >= 3 || word.any { it.code > 0x2E7F }) && word !in COMMON }
+            .toSet()
+
+    private val WORD = Regex("""[\p{L}\p{N}]+""")
+
+    private val COMMON = setOf(
+        "the", "and", "for", "you", "your", "yours", "with", "that", "this", "these", "those", "from", "into", "onto",
+        "are", "was", "were", "been", "being", "have", "has", "had", "not", "but", "can", "could", "would", "should",
+        "will", "just", "what", "when", "where", "which", "who", "whom", "why", "how", "all", "any", "some", "about",
+        "did", "does", "doing", "done", "its", "him", "his", "her", "hers", "she", "they", "them", "their",
+        "our", "out", "off", "now", "then", "than", "there", "here", "too", "very", "yes", "yeah", "okay", "please",
+        "also", "again", "still", "yet", "get", "got", "let", "lets", "say", "said", "tell", "told", "ask", "asked",
+        "send", "sent", "text", "texted", "message", "messages", "msg", "email", "mail", "call", "called", "open",
+        "opened", "app", "apps", "phone", "step", "steps", "answer", "set", "run", "ran", "make", "made", "today",
+        "tomorrow", "yesterday", "earlier", "later", "one", "two"
+    )
+
+    /** One entry as her prompt reads it, behind its [age] ("3 h ago"). */
+    fun line(entry: PhoneLogEntry, heldBack: Boolean, age: String): String {
+        val text = buildString {
+            append(age).append(": ")
+            append(whoPart(entry, heldBack))
+            howPart(entry.letThrough)?.let { append("; ").append(it) }
+            append(". ")
+            val steps = entry.steps.map { stepPart(it, heldBack) }
+            if (steps.size == 1) {
+                append(steps.single())
+            } else {
+                append(steps.withIndex().joinToString(" ") { (i, step) -> "${i + 1}) $step" })
+            }
+        }
+        return PhoneLogEntry.cut(safe(text), MAX_LINE_CHARS)
+    }
+
+    private fun whoPart(entry: PhoneLogEntry, heldBack: Boolean): String {
+        val why = entry.why?.takeUnless { heldBack }?.let { quoted(it, PhoneLogEntry.MAX_WHY_CHARS) }
+        return when (entry.who) {
+            Starter.HIM_CHAT -> "he asked in the chat" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_VOICE -> "he asked by voice" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_SHORTCUT -> "his shortcut" + why?.let { ": $it" }.orEmpty()
+            Starter.HIM_SCREEN -> "his tap on the app's own screen"
+            Starter.HER_REPLY -> "your command in a reply" + why?.let { ": $it" }.orEmpty()
+            Starter.HER_OWN_TIME -> "your command in a moment of your own" + why?.let { ": $it" }.orEmpty()
+            Starter.MACRO -> "a saved macro" + why?.let { " ($it)" }.orEmpty()
+            Starter.ROUTINE -> "a routine" + why?.let { " ($it)" }.orEmpty()
+            Starter.APP -> "the app by itself"
+            Starter.IMPORTED -> "from the app's history before this record"
+        }
+    }
+
+    private fun howPart(how: LetThrough?): String? = when (how) {
+        LetThrough.HIS_SETTING -> "his approval setting let it run"
+        LetThrough.HER_REIN -> "your rein let it run"
+        LetThrough.HIS_YES -> "he said yes"
+        LetThrough.HIS_NO -> "he said no"
+        LetThrough.HIS_TAP -> "he tapped it himself"
+        null -> null
+    }
+
+    private fun stepPart(step: PhoneLogStep, heldBack: Boolean): String = buildString {
+        if (heldBack) {
+            append(step.kind)
+        } else {
+            append(step.line)
+            step.app?.takeUnless { step.line.contains(it, ignoreCase = true) }?.let { append(" (").append(it).append(')') }
+            when (step.words.size) {
+                0 -> Unit
+                1 -> append(": ").append(quoted(step.words.single().text, MAX_SHOWN_WORDS_CHARS))
+                else -> append(": ").append(step.words.joinToString(", ") { "${it.param} ${quoted(it.text, MAX_SHOWN_WORDS_CHARS)}" })
+            }
+        }
+        append(" - ").append(endPart(step, heldBack))
+    }
+
+    private fun endPart(step: PhoneLogStep, heldBack: Boolean): String {
+        val reason = step.reason?.takeUnless { heldBack }
+        return when (step.end) {
+            StepEnd.DONE -> "done"
+            StepEnd.FAILED -> "failed" + reason?.let { ": $it" }.orEmpty()
+            StepEnd.LEFT_OPEN -> "left open for him to finish, not done by the phone" + reason?.let { ": $it" }.orEmpty()
+            StepEnd.INTERRUPTED -> "under way when it was stopped: it may or may not have gone through"
+            StepEnd.NOT_RUN -> "not run" + reason?.let { " ($it)" }.orEmpty()
+        }
+    }
+
+    /** [text] on one line in quotation marks, cut to [max]. */
+    private fun quoted(text: String, max: Int): String =
+        "\"" + PhoneLogEntry.cut(text.lines().map { it.trim() }.filter { it.isNotEmpty() }.joinToString(" / "), max) + "\""
+
+    /** A line that cannot open a section of her prompt. */
+    private fun safe(text: String): String = PhoneLogEntry.oneLine(text).replace("===", "= = =")
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt
new file mode 100644
