+++ b/app/src/test/java/com/opendroid/ai/core/record/RecordSealTest.kt
@@ -0,0 +1,86 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.security.EncryptedSecret
+import com.opendroid.ai.core.security.SecretAeadCipher
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.fail
+import org.junit.Test
+import java.security.GeneralSecurityException
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+
+/**
+ * The record's seal: AES-GCM with the IV written in front of the ciphertext, bound to the
+ * record. The Keystore itself is not on the JVM, so the cipher here is the same AES/GCM
+ * with a key held in memory, standing in for the one the Keystore holds.
+ */
+class RecordSealTest {
+
+    /** AES-256/GCM/NoPadding with a software key and a fresh random IV per seal, as the Keystore cipher does. */
+    private class SoftwareCipher : SecretAeadCipher {
+        private val key: SecretKey = KeyGenerator.getInstance("AES").apply { init(256) }.generateKey()
+
+        override fun encrypt(plaintext: ByteArray, aad: ByteArray): EncryptedSecret {
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.ENCRYPT_MODE, key)
+            cipher.updateAAD(aad)
+            return EncryptedSecret(cipher.iv, cipher.doFinal(plaintext))
+        }
+
+        override fun decrypt(iv: ByteArray, ciphertext: ByteArray, aad: ByteArray): ByteArray {
+            val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+            cipher.init(Cipher.DECRYPT_MODE, key, GCMParameterSpec(128, iv))
+            cipher.updateAAD(aad)
+            return cipher.doFinal(ciphertext)
+        }
+
+        override fun resetForReentry() = Unit
+    }
+
+    private val plain = "Send SMS to Nene: \"running late\"".toByteArray()
+
+    @Test
+    fun `a sealed record opens to what was sealed, with a fresh 12-byte IV in front`() {
+        val cipher = SoftwareCipher()
+        val seal = KeystoreRecordSeal(cipher)
+        val once = seal.seal(plain)
+        val twice = seal.seal(plain)
+        assertArrayEquals(plain, seal.open(once))
+        assertArrayEquals(plain, seal.open(twice))
+        // A fresh IV each time: the same record never seals to the same bytes.
+        assertFalse(once.copyOfRange(0, KeystoreRecordSeal.IV_BYTES).contentEquals(twice.copyOfRange(0, KeystoreRecordSeal.IV_BYTES)))
+        // The IV, then the ciphertext and its 16-byte tag.
+        assertEquals(KeystoreRecordSeal.IV_BYTES + plain.size + 16, once.size)
+        assertFalse(String(once).contains("Nene"))
+        assertEquals("yume_phone_record", KeystoreRecordSeal.KEY_ALIAS)
+    }
+
+    @Test
+    fun `a changed byte, a short file or another key does not open`() {
+        val seal = KeystoreRecordSeal(SoftwareCipher())
+        val sealed = seal.seal(plain)
+        val changed = sealed.copyOf().also { it[it.size - 1] = (it[it.size - 1].toInt() xor 1).toByte() }
+        for (bad in listOf(changed, sealed.copyOfRange(0, 20), KeystoreRecordSeal(SoftwareCipher()).seal(plain))) {
+            try {
+                seal.open(bad)
+                fail("opened bytes it should not")
+            } catch (expected: GeneralSecurityException) {
+                // The store sets such a file aside.
+            }
+        }
+    }
+
+    @Test
+    fun `the test seal round-trips and never holds the clear text`() {
+        val seal = FakeSeal()
+        val sealed = seal.seal(plain)
+        assertArrayEquals(plain, seal.open(sealed))
+        assertNotEquals(String(plain), String(sealed))
+        assertFalse(String(sealed).contains("Nene"))
+    }
+}
