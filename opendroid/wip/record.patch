diff --git a/app/src/main/java/com/opendroid/ai/core/persona/PhoneRecordLink.kt b/app/src/main/java/com/opendroid/ai/core/persona/PhoneRecordLink.kt
new file mode 100644
index 0000000..0e6530e
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/persona/PhoneRecordLink.kt
@@ -0,0 +1,33 @@
+package com.opendroid.ai.core.persona
+
+/**
+ * What she is told of the phone's own record of what it did, in one narrow door: the
+ * record is kept outside her package, and she is handed finished lines, each with its age,
+ * in the app's plain words. Whoever started a thing (him, her, a macro, a routine, the app)
+ * it is on the record with how it ended, so that what the phone did is hers to know and to
+ * own. Her package never sees what the lines are built from.
+ *
+ * With [heldBack] her route holds his details back: each line then keeps only its kind and
+ * its time, and who a step went to and what it said stay on the phone.
+ *
+ * [NONE] is no record at all: what a test or a build without it gets.
+ */
+interface PhoneRecordLink {
+
+    /** For her reply to [hisMessage]: the newest entries of the last two days, and older ones his message is about. */
+    suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String>
+
+    /** For a moment of her own: what the phone did in the last day. */
+    suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String>
+
+    /** For her notebook pass: what the phone did since [sinceMillis], when its last pass read up to. */
+    suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String>
+
+    companion object {
+        val NONE: PhoneRecordLink = object : PhoneRecordLink {
+            override suspend fun forReply(hisMessage: String, heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+            override suspend fun forMoment(heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+            override suspend fun forNotebook(sinceMillis: Long, heldBack: Boolean, nowMillis: Long): List<String> = emptyList()
+        }
+    }
+}
