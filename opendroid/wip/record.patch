+import com.opendroid.ai.data.db.entities.NotificationEntity
+import com.opendroid.ai.data.db.entities.TaskHistoryEntity
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * On the update that brings the record, what the app already knew the phone had done in
+ * the last 30 days goes into it once, as [Starter.IMPORTED] entries:
+ *
+ *  - the plans in the app's history (the `task_history` table), one entry per plan with a
+ *    step for every row it logged. Those rows were stored with every email field and every
+ *    secret already redacted, and a redacted value is not kept as words. Their parameters
+ *    are the ones the step ran with, so a value filled in from an earlier step stands in
+ *    them as text: a step after one that read his data keeps no words, since they may
+ *    quote what was read. What a step returned is never brought in.
+ *  - the messages the old auto-reply answered (notifications marked auto-replied): who it
+ *    answered in which app, and the reply it sent. Never the message it answered. The email
+ *    channel only opened a draft, so an email reply is recorded as left open for him.
+ *
+ * The flag that it is done ([Flag]) is set only once the entries are written ([done]).
+ */
+@Singleton
+class HistoryImport internal constructor(
+    private val taskHistory: suspend () -> List<TaskHistoryEntity>,
+    private val notificationsSince: suspend (Long) -> List<NotificationEntity>,
+    private val flag: Flag
+) : PhoneLog.OneTimeImport {
+
+    @Inject
+    constructor(
+        taskHistoryDao: TaskHistoryDao,
+        notificationDao: NotificationDao,
+        @ApplicationContext context: Context
+    ) : this(
+        taskHistory = { taskHistoryDao.getTaskHistoryFlow().first() },
+        notificationsSince = { since -> notificationDao.getNotificationsSince(since, limit = MAX_NOTIFICATIONS) },
+        flag = PrefsFlag(context)
+    )
+
+    /** Whether the import has been done on this install. */
+    interface Flag {
+        fun isSet(): Boolean
+        fun set()
+    }
+
+    override suspend fun pending(nowMillis: Long): List<PhoneLogEntry>? {
+        if (flag.isSet()) return null
+        val since = nowMillis - PhoneLog.MAX_AGE_MILLIS
+        return fromTaskHistory(taskHistory().filter { it.timestamp >= since }) +
+            fromAutoReplies(notificationsSince(since).filter { it.timestamp >= since })
+    }
+
+    override fun done() = flag.set()
+
+    private class PrefsFlag(context: Context) : Flag {
+        private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        override fun isSet(): Boolean = prefs.getBoolean(KEY_IMPORTED, false)
+        override fun set() = prefs.edit(commit = true) { putBoolean(KEY_IMPORTED, true) }
+    }
+
+    companion object {
+        private const val PREFS = "phone_record"
+        private const val KEY_IMPORTED = "history_imported_v1"
+        private const val MAX_NOTIFICATIONS = 5000
+        private const val NO_PLAN = "n/a"
+
+        private val json = Json { ignoreUnknownKeys = true }
+
+        /**
+         * What a handler says when it left the step with him (a draft, a chat with the
+         * words ready, a payment app, a settings screen): the history did not keep the kind
+         * of result, only its words.
+         */
+        private val HANDED_OVER = Regex(
+            """tap send|sending was not verified|send it manually|please (?:turn|switch) it|""" +
+                """was opened instead|enter your UPI PIN""",
+            RegexOption.IGNORE_CASE
+        )
+
+        /** One entry per plan in [rows], the history's rows of the steps that ran. */
+        internal fun fromTaskHistory(rows: List<TaskHistoryEntity>): List<PhoneLogEntry> =
+            rows.filter { it.planId != NO_PLAN && it.actionType != ExecutionHistoryPrivacy.PLAN_GENERATION }
+                .groupBy { it.planId }
+                .mapNotNull { (planId, planRows) -> planEntry(planId, planRows.sortedWith(compareBy({ it.timestamp }, { it.id }))) }
+
+        private fun planEntry(planId: String, rows: List<TaskHistoryEntity>): PhoneLogEntry? {
+            val steps = rows.mapIndexed { index, row ->
+                PlanStep(
+                    stepId = "h${index + 1}",
+                    order = index + 1,
+                    description = "",
+                    action = row.actionType,
+                    params = params(row.paramsJson),
+                    status = if (row.success) StepStatus.COMPLETED else StepStatus.FAILED,
+                    error = row.errorMessage
+                )
+            }
+            // A step after one that read his data may carry what was read in its words.
+            val firstRead = steps.indexOfFirst { ActionSchema.readsPersonalData(PlanEntries.mappedName(it)) }
+            val handedOver = steps.filterIndexed { index, step ->
+                !rows[index].success && step.error?.let(HANDED_OVER::containsMatchIn) == true
+            }.map { it.stepId }.toSet()
+            val plan = Plan(
+                planId = planId,
+                goal = "",
+                estimatedDuration = "",
+                estimatedSteps = steps.size,
+                steps = steps,
+                createdAt = rows.first().timestamp
+            )
+            return PlanEntries.of(
+                plan = plan,
+                start = PlanStarts.Start(who = Starter.IMPORTED),
+                ending = PlanEntries.Ending.Finished(isSuccess = rows.all { it.success }),
+                fallbackWho = Starter.IMPORTED,
+                handedOver = { it.stepId in handedOver },
+                wordsKept = { step -> firstRead < 0 || step.order - 1 <= firstRead },
+                id = "imported-plan-$planId"
+            )
+        }
+
+        /**
+         * The history's parameters, as text; a value that is not text is kept as it was
+         * written. A value the history redacted is left out: it says nothing of the step.
+         */
+        private fun params(paramsJson: String): Map<String, String> = try {
+            (json.parseToJsonElement(paramsJson) as? JsonObject).orEmpty().mapValues { (_, value) ->
+                (value as? JsonPrimitive)?.takeIf { it.isString }?.content ?: value.toString()
+            }.filterValues { it.trim() != ExecutionHistoryPrivacy.REDACTED }
+        } catch (e: Exception) {
+            emptyMap()
+        }
+
+        /** One entry for each message the old auto-reply answered, with the reply it sent. */
+        internal fun fromAutoReplies(rows: List<NotificationEntity>): List<PhoneLogEntry> =
+            rows.filter { it.isAutoReplied && !it.autoReplyText.isNullOrBlank() }.map { row ->
+                val to = row.contactName?.takeIf { it.isNotBlank() }
+                    ?: row.senderEmail?.takeIf { it.isNotBlank() }
+                    ?: row.title.takeIf { it.isNotBlank() }
+                val email = row.category == "EMAIL" || !row.senderEmail.isNullOrBlank()
+                val step = PhoneLogStep(
+                    line = "Auto-reply" + to?.let { " to $it" }.orEmpty(),
+                    kind = "Auto-reply",
+                    app = row.appName.takeIf { it.isNotBlank() },
+                    words = listOf(SentWords("reply", row.autoReplyText.orEmpty())),
+                    end = if (email) StepEnd.LEFT_OPEN else StepEnd.DONE,
+                    reason = if (email) "the old auto-reply only opened an email draft for him; whether he sent it is not known" else null
+                )
+                PhoneLogEntry(
+                    id = "imported-reply-${row.id}",
+                    at = row.timestamp,
+                    who = Starter.IMPORTED,
+                    steps = listOf(step),
+                    outcome = if (email) Outcome.LEFT_OPEN else Outcome.DONE
+                ).bounded()
+            }
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt
new file mode 100644
index 0000000..329cb84
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneLog.kt
@@ -0,0 +1,176 @@
+package com.opendroid.ai.core.record
+
+import android.util.Log
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+
+/**
+ * The record of what the phone did: one sealed file, [FILE] in [dir] (the app's
+ * `files/record`), with the entries as JSON inside.
+ *
+ * Every change goes through one lock and is written whole: to a file beside it first,
+ * which then takes the record's place, so a write that is cut short leaves the last good
+ * record. It keeps at most [MAX_ENTRIES] entries and none older than [MAX_AGE_MILLIS]: the
+ * rest are dropped on every write and left out of every read ([retained]).
+ *
+ * A record that cannot be opened (the key is gone after a reinstall, the file was changed
+ * or is not one) is moved aside as `phone_log.sealed.bad`, and the record starts empty.
+ * Nothing here throws to the caller: a record that cannot be read reads as empty, and an
+ * entry that cannot be written is dropped with a line in the log that names no content.
+ *
+ * [history] is the one-time import of what the app already knew before the record came:
+ * asked once, the first time the record is opened in this process, and told it is done
+ * only after its entries are written.
+ */
+class PhoneLog(
+    private val dir: File,
+    private val seal: RecordSeal,
+    private val clock: () -> Long = System::currentTimeMillis,
+    private val history: OneTimeImport = OneTimeImport.NONE
+) {
+    private val lock = Mutex()
+
+    // What the file holds, once it has been read in this process. Null until then.
+    private var held: List<PhoneLogEntry>? = null
+
+    /** Adds [entry], or puts it in the place of the entry with the same id. */
+    suspend fun put(entry: PhoneLogEntry) = work {
+        val now = clock()
+        val all = loaded(now).filterNot { it.id == entry.id } + entry.bounded()
+        store(retained(all, now))
+    }
+
+    /** Every entry the record keeps now, oldest first. */
+    suspend fun entries(): List<PhoneLogEntry> = work {
+        val now = clock()
+        val all = loaded(now)
+        val kept = retained(all, now)
+        // What has aged out is dropped from the file too, not only from what is read.
+        if (kept.size != all.size) store(kept) else held = kept
+        kept
+    }
+
+    private suspend fun <T> work(block: suspend () -> T): T = lock.withLock { withContext(Dispatchers.IO) { block() } }
+
+    /** What the file holds, with the one-time import brought in on the first open. */
+    private suspend fun loaded(now: Long): List<PhoneLogEntry> {
+        held?.let { return it }
+        val read = read()
+        held = read
+        val imported = try {
+            history.pending(now)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The record's import did not run: ${e.javaClass.simpleName}")
+            null
+        } ?: return read
+        val known = read.map { it.id }.toSet()
+        val merged = read + imported.filterNot { it.id in known }.map { it.bounded() }
+        if (store(retained(merged, now))) history.done()
+        return held ?: read
+    }
+
+    private fun read(): List<PhoneLogEntry> {
+        val file = File(dir, FILE)
+        if (!file.exists()) return emptyList()
+        return try {
+            val plain = seal.open(file.readBytes())
+            json.decodeFromString(Stored.serializer(), String(plain, Charsets.UTF_8)).entries
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            // A record nobody can open is not guessed at, and not written over: it is set aside.
+            Log.w(TAG, "The record could not be opened and is set aside: ${e.javaClass.simpleName}")
+            setAside(file)
+            emptyList()
+        }
+    }
+
+    private fun setAside(file: File) {
+        val bad = File(dir, FILE + BAD_SUFFIX)
+        try {
+            Files.move(file.toPath(), bad.toPath(), StandardCopyOption.REPLACE_EXISTING)
+        } catch (e: Exception) {
+            Log.w(TAG, "The unreadable record could not be moved: ${e.javaClass.simpleName}")
+            if (!file.delete()) Log.w(TAG, "The unreadable record could not be removed either")
+        }
+    }
+
+    /** Writes [entries] whole and keeps them as what the file holds. False when nothing could be written. */
+    private fun store(entries: List<PhoneLogEntry>): Boolean {
+        return try {
+            if (!dir.exists() && !dir.mkdirs()) throw IOException("No record directory")
+            val sealed = seal.seal(json.encodeToString(Stored.serializer(), Stored(VERSION, entries)).toByteArray(Charsets.UTF_8))
+            val tmp = File(dir, FILE + TMP_SUFFIX)
+            tmp.outputStream().use { out ->
+                out.write(sealed)
+                out.fd.sync()
+            }
+            try {
+                Files.move(tmp.toPath(), File(dir, FILE).toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING)
+            } catch (e: Exception) {
+                Files.move(tmp.toPath(), File(dir, FILE).toPath(), StandardCopyOption.REPLACE_EXISTING)
+            }
+            held = entries
+            true
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Log.w(TAG, "The record was not written: ${e.javaClass.simpleName}")
+            false
+        }
+    }
+
+    @Serializable
+    private data class Stored(val v: Int, val entries: List<PhoneLogEntry>)
+
+    /**
+     * What the app knew of what the phone did before the record came, put into it once.
+     * [pending] gives the entries to bring in, or null once that is done; [done] is called
+     * when they are written.
+     */
+    interface OneTimeImport {
+        suspend fun pending(nowMillis: Long): List<PhoneLogEntry>?
+        fun done()
+
+        companion object {
+            val NONE: OneTimeImport = object : OneTimeImport {
+                override suspend fun pending(nowMillis: Long): List<PhoneLogEntry>? = null
+                override fun done() = Unit
+            }
+        }
+    }
+
+    companion object {
+        const val DIR = "record"
+        const val FILE = "phone_log.sealed"
+        const val BAD_SUFFIX = ".bad"
+        private const val TMP_SUFFIX = ".tmp"
+        private const val VERSION = 1
+        private const val TAG = "PhoneLog"
+
+        const val MAX_ENTRIES = 600
+        const val MAX_AGE_MILLIS = 30L * 24 * 60 * 60 * 1000
+
+        private val json = Json { ignoreUnknownKeys = true; encodeDefaults = false }
+
+        /**
+         * The entries the record keeps of [entries] at [nowMillis]: none older than
+         * [MAX_AGE_MILLIS], and of the rest the newest [MAX_ENTRIES], oldest first.
+         */
+        fun retained(entries: List<PhoneLogEntry>, nowMillis: Long): List<PhoneLogEntry> =
+            entries.filter { it.at >= nowMillis - MAX_AGE_MILLIS }
+                .sortedBy { it.at }
+                .takeLast(MAX_ENTRIES)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt
new file mode 100644
index 0000000..87cdd4b
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneLogEntry.kt
@@ -0,0 +1,181 @@
+package com.opendroid.ai.core.record
+
+import kotlinx.serialization.Serializable
+
+/**
+ * One thing the phone did, or was asked to do and did not do, as the record of what the
+ * phone did keeps it: when, who started it, why, how it was let through, and what each
+ * step did and how it ended.
+ *
+ * Everything in an entry is read off what ran: the steps as they were given and how each
+ * one ended. What an entry never holds: a secret a step was given, what a step read off
+ * the screen, out of a notification, the clipboard or any other store of his (only that
+ * the step ran), her thoughts and her replies. [PlanEntries] and the other builders are
+ * where that is made true; [bounded] keeps each text to its size.
+ *
+ * [id] is the run's own id. A plan is recorded under its plan id, so a later record of the
+ * same plan (a paused plan that was resumed and finished) takes the place of the earlier
+ * one instead of standing beside it.
+ */
+@Serializable
+data class PhoneLogEntry(
+    val id: String,
+    /** When it started, in millis. */
+    val at: Long,
+    val who: Starter,
+    /** His message, her command, or the macro's or routine's name, cut short. Null when there is none to tell. */
+    val why: String? = null,
+    /** How it was let through; null when it never came to a gate, or ran under one this record cannot name. */
+    val letThrough: LetThrough? = null,
+    val steps: List<PhoneLogStep>,
+    val outcome: Outcome
+) {
+    /** The entry with every text cut to the size the record keeps. */
+    fun bounded(): PhoneLogEntry = copy(
+        why = why?.let { cut(oneLine(it), MAX_WHY_CHARS) }?.takeIf { it.isNotEmpty() },
+        steps = steps.take(MAX_STEPS).map { it.bounded() }
+    )
+
+    companion object {
+        const val MAX_WHY_CHARS = 200
+        const val MAX_WORDS_CHARS = 1000
+        const val MAX_LINE_CHARS = 160
+        const val MAX_REASON_CHARS = 200
+        const val MAX_STEPS = 40
+
+        /** What a text that was cut ends in. The same mark her prompt explains. */
+        const val CUT_MARK = " [cut]"
+
+        internal fun cut(text: String, max: Int): String =
+            if (text.length <= max) text else text.take((max - CUT_MARK.length).coerceAtLeast(1)).trimEnd() + CUT_MARK
+
+        internal fun oneLine(text: String): String = text.replace(Regex("""\s+"""), " ").trim()
+    }
+}
+
+/** Who started what an entry records. */
+@Serializable
+enum class Starter {
+    /** His message in the chat. */
+    HIM_CHAT,
+
+    /** His voice: the voice service, or his own voice heard by her ears. */
+    HIM_VOICE,
+
+    /** His message matched a shortcut and ran without the planner. */
+    HIM_SHORTCUT,
+
+    /** His tap on one of the app's screens, such as Publish on a social post. */
+    HIM_SCREEN,
+
+    /** Her command at the end of a reply of hers. */
+    HER_REPLY,
+
+    /** Her command in a moment of her own. */
+    HER_OWN_TIME,
+
+    /** A saved macro. */
+    MACRO,
+
+    /** A routine. */
+    ROUTINE,
+
+    /** The app by itself, with nobody's tap or message behind it. */
+    APP,
+
+    /** Put into the record from the app's older history on the update that brought the record. */
+    IMPORTED
+}
+
+/** How what an entry records was let through. */
+@Serializable
+enum class LetThrough {
+    /** His approval setting let it run without asking. */
+    HIS_SETTING,
+
+    /** Her rein let a command of hers run without asking. */
+    HER_REIN,
+
+    /** He said yes: on the approval card or by voice. */
+    HIS_YES,
+
+    /** He said no, or cancelled it: what was not run is recorded as not run. */
+    HIS_NO,
+
+    /** His own tap on the app's screen. */
+    HIS_TAP
+}
+
+/**
+ * One step of an entry. [line] names the action and who or what it acts on, as the
+ * approval card names it. [kind] is the action alone, which is all a route that holds his
+ * details back is told. [words] are what the step sent to a person, posted or typed into
+ * another app, each in full up to its cap; a value the phone fills in from an earlier
+ * step is named as that, never quoted.
+ */
+@Serializable
+data class PhoneLogStep(
+    val line: String,
+    val kind: String,
+    /** The app the step acts in, when it is known. */
+    val app: String? = null,
+    val words: List<SentWords> = emptyList(),
+    val end: StepEnd,
+    /** Why it failed, or what was left for him, in plain words; null when there is none fit to keep. */
+    val reason: String? = null
+) {
+    fun bounded(): PhoneLogStep = copy(
+        line = PhoneLogEntry.cut(PhoneLogEntry.oneLine(line), PhoneLogEntry.MAX_LINE_CHARS),
+        kind = PhoneLogEntry.cut(PhoneLogEntry.oneLine(kind), PhoneLogEntry.MAX_LINE_CHARS),
+        app = app?.let { PhoneLogEntry.cut(PhoneLogEntry.oneLine(it), MAX_APP_CHARS) }?.takeIf { it.isNotEmpty() },
+        words = words.map { it.copy(text = PhoneLogEntry.cut(it.text.trim(), PhoneLogEntry.MAX_WORDS_CHARS)) }
+            .filter { it.text.isNotEmpty() },
+        reason = reason?.let { PhoneLogEntry.cut(PhoneLogEntry.oneLine(it), PhoneLogEntry.MAX_REASON_CHARS) }
+            ?.takeIf { it.isNotEmpty() }
+    )
+
+    private companion object {
+        const val MAX_APP_CHARS = 60
+    }
+}
+
+/** One text a step sent, under the parameter that carried it ("message", "subject", "body"). */
+@Serializable
+data class SentWords(val param: String, val text: String)
+
+/** How one step ended. */
+@Serializable
+enum class StepEnd {
+    DONE,
+    FAILED,
+
+    /** Left open for him: a draft, a dialer or a payment waiting for his tap. Never "sent". */
+    LEFT_OPEN,
+
+    /** It was under way when the run was stopped: whether it went through is not known. */
+    INTERRUPTED,
+
+    NOT_RUN
+}
+
+/** How a whole run ended. */
+@Serializable
+enum class Outcome {
+    /** Every step was done. */
+    DONE,
+
+    /** Nothing was done, and something failed. */
+    FAILED,
+
+    /** Some steps were done and some failed or never ran. */
+    PARTLY,
+
+    /** What it did ends with something left open for him, and nothing failed. */
+    LEFT_OPEN,
+
+    /** It was stopped, or ended early, before the end. */
+    STOPPED,
+
+    /** Nothing of it ran. */
+    NOT_RUN
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt b/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt
new file mode 100644
index 0000000..c131aae
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PhoneRecord.kt
@@ -0,0 +1,66 @@
+package com.opendroid.ai.core.record
+
+import android.content.Context
+import android.util.Log
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CoroutineExceptionHandler
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import java.io.File
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * What every place that runs something on the phone hands its entry to: the plan loop,
+ * macros and routines, and the sends from the social screens. [put] never waits and
+ * never throws, so writing the record can neither hold up nor break what it records.
+ *
+ * [NONE] keeps nothing: what a test or a caller without the record gets.
+ */
+fun interface PhoneRecorder {
+    fun put(entry: PhoneLogEntry)
+
+    companion object {
+        val NONE: PhoneRecorder = PhoneRecorder { }
+    }
+}
+
+/**
+ * The record of what the phone did, as the app has it: the sealed file in its own storage
+ * (`files/record/phone_log.sealed`, [PhoneLog]), with the plans and auto-replies of the
+ * last 30 days brought in once on the update that brings it ([HistoryImport]).
+ *
+ * Entries are written in the order they are put, on a scope of the record's own, so a
+ * plan that was stopped still gets its entry written after its coroutine is gone.
+ */
+@Singleton
+class PhoneRecord internal constructor(private val log: PhoneLog) : PhoneRecorder {
+
+    @Inject
+    constructor(
+        @ApplicationContext context: Context,
+        seal: RecordSeal,
+        history: HistoryImport
+    ) : this(PhoneLog(File(context.filesDir, PhoneLog.DIR), seal, history = history))
+
+    // One writer at a time, in order: the log's own lock keeps the file whole, and a single
+    // thread keeps two entries put one after the other from being written the other way round.
+    private val scope = CoroutineScope(
+        SupervisorJob() + Dispatchers.IO.limitedParallelism(1) + CoroutineExceptionHandler { _, e ->
+            Log.w(TAG, "An entry of the record was not written: ${e.javaClass.simpleName}")
+        }
+    )
+
+    override fun put(entry: PhoneLogEntry) {
+        scope.launch { log.put(entry) }
+    }
+
+    /** Every entry the record keeps now, oldest first. Empty when it cannot be read. */
+    suspend fun entries(): List<PhoneLogEntry> = log.entries()
+
+    private companion object {
+        const val TAG = "PhoneRecord"
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt b/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt
new file mode 100644
index 0000000..da9ba46
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PlanEntries.kt
@@ -0,0 +1,203 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.actions.ActionAutoMapper
+import com.opendroid.ai.core.agent.ActionSchema
+import com.opendroid.ai.core.agent.PlanApprovalSummary
+import com.opendroid.ai.core.agent.PlanPrivacy
+import com.opendroid.ai.core.agent.PlanRecord
+import com.opendroid.ai.core.agent.isTalkAction
+import com.opendroid.ai.core.memory.ExecutionHistoryPrivacy
+import com.opendroid.ai.data.models.Plan
+import com.opendroid.ai.data.models.PlanStep
+import com.opendroid.ai.data.models.StepStatus
+
+/**
+ * The record's entry for one run of steps: a plan of his or hers, a macro or a routine,
+ * or a plan from the app's older history. Built from the steps as they stand when the run
+ * has ended, the way [PlanRecord] builds the chat's row, and holding only what the record
+ * may hold:
+ *
+ *  - Each step is its line from [PlanApprovalSummary] (the action and who or what it acts
+ *    on), the action alone for a route that holds his details back, the app where it is
+ *    known, the words it sent, and how it ended.
+ *  - The words are [PlanApprovalSummary.outgoingTexts]: only text a step sends to a person
+ *    or a site, never one that stays on the phone (a note, the clipboard, the secure store),
+ *    never a secret parameter, and a value filled in from an earlier step's result is named
+ *    as that ("[the answer to step 2]"), never quoted. The plan is redacted first
+ *    ([PlanPrivacy.redactPlan]), so a secret quoted anywhere else in it is gone too.
+ *  - What a step returned is never kept: of a step that read his notifications, his screen
+ *    or his mail, only that it ran. A failed reading step keeps no reason either, since a
+ *    handler's error can quote what it read.
+ *  - The plan's goal, its step descriptions and what its talk steps said are the planner's
+ *    words about its own plan, not what the phone did: none of them is kept. Talk steps and
+ *    the steps that only ask him something are left out.
+ *
+ * A run with no step left to record (a plan that only talked) has no entry.
+ */
+internal object PlanEntries {
+
+    /** How a run ended, as the one who ran it saw it. */
+    sealed interface Ending {
+        /** It came to its end; [isSuccess] as the plan loop judged it. */
+        data class Finished(val isSuccess: Boolean) : Ending
+
+        /**
+         * It was stopped while it ran, or paused partway: what ran is told, the rest is not
+         * run. With [waitingForAnswer] the step under way was waiting for his answer, so it
+         * had not run either.
+         */
+        data class Stopped(val waitingForAnswer: Boolean = false) : Ending
+
+        /** It never got past the gate. [refused] when he said no to it or cancelled it. */
+        data class NotRun(val refused: Boolean) : Ending
+
+        /** He said no to the question of step [stepId] while it ran: that step and the rest did not run. */
+        data class Declined(val stepId: String) : Ending
+    }
+
+    private val autoMapper = ActionAutoMapper()
+
+    /** The name a step's action runs under, as the approval card resolves it. */
+    fun mappedName(step: PlanStep): String =
+        (autoMapper.mapAction(step.action, step.params, emptySet()).mappedAction ?: step.action).trim().uppercase()
+
+    /**
+     * The entry for [plan], or null when it has no step to record.
+     *
+     * [start] is what was noted of who started it, why and how it was let through, and
+     * [fallbackWho] is who is named when nothing was noted. [handedOver] is true for a
+     * step that was left with him to finish (a draft waiting for his tap); [toldAlready]
+     * for one that ended by handing the rest to him (a dialer open and waiting): both are
+     * left open, never done. [wordsKept] is false for a step whose words are not to be
+     * kept, such as a step from the older history whose words may quote what an earlier
+     * step read.
+     */
+    fun of(
+        plan: Plan,
+        start: PlanStarts.Start?,
+        ending: Ending,
+        fallbackWho: Starter = Starter.HIM_CHAT,
+        canonicalName: (PlanStep) -> String = ::mappedName,
+        handedOver: (PlanStep) -> Boolean = { false },
+        toldAlready: (PlanStep) -> Boolean = { false },
+        wordsKept: (PlanStep) -> Boolean = { true },
+        id: String = plan.planId,
+        atMillis: Long = plan.createdAt
+    ): PhoneLogEntry? {
+        val safe = PlanPrivacy.redactPlan(plan)
+        val lines = PlanApprovalSummary.stepLines(safe)
+        val kinds = PlanApprovalSummary.stepLines(safe.copy(steps = safe.steps.map { it.copy(params = emptyMap()) }))
+        val words = PlanApprovalSummary.outgoingTexts(safe)
+            .filter { it.text.trim() != ExecutionHistoryPrivacy.REDACTED }
+            .groupBy { it.step - 1 }
+        val declinedAt = (ending as? Ending.Declined)?.let { declined -> safe.steps.indexOfFirst { it.stepId == declined.stepId } }
+            ?.takeIf { it >= 0 }
+
+        val steps = safe.steps.mapIndexedNotNull { index, step ->
+            val canonical = canonicalName(step)
+            if (isTalkAction(canonical) || canonical in PlanRecord.ASKING_ACTIONS) return@mapIndexedNotNull null
+            val reads = ActionSchema.readsPersonalData(canonical)
+            // A plan that never got past the gate has run nothing, unless it was shown again
+            // after a change while it ran: the steps that had run by then say so themselves.
+            val (end, reason) = when {
+                declinedAt != null && index == declinedAt -> StepEnd.NOT_RUN to HE_SAID_NO
+                declinedAt != null && index > declinedAt && step.status != StepStatus.COMPLETED -> StepEnd.NOT_RUN to null
+                ending is Ending.Stopped && ending.waitingForAnswer && step.status == StepStatus.RUNNING -> StepEnd.NOT_RUN to null
+                else -> endOf(step, reads, handedOver(step), toldAlready(step))
+            }
+            PhoneLogStep(
+                line = lines.getOrElse(index) { step.action },
+                kind = kinds.getOrElse(index) { step.action },
+                app = appOf(canonical, step.params),
+                words = if (wordsKept(step)) {
+                    words[index].orEmpty().map { SentWords(it.param, it.text) }
+                } else {
+                    emptyList()
+                },
+                end = end,
+                reason = reason
+            ).bounded()
+        }
+        if (steps.isEmpty()) return null
+
+        val how = when {
+            ending is Ending.NotRun && ending.refused -> LetThrough.HIS_NO
+            ending is Ending.NotRun -> null
+            ending is Ending.Declined -> LetThrough.HIS_NO
+            else -> start?.how
+        }
+        return PhoneLogEntry(
+            id = id,
+            at = atMillis,
+            who = start?.who ?: fallbackWho,
+            why = start?.why?.takeUnless { PlanRecord.takesASecret(plan) },
+            letThrough = how,
+            steps = steps,
+            outcome = outcomeOf(steps, ending)
+        ).bounded()
+    }
+
+    private fun endOf(step: PlanStep, reads: Boolean, handedOver: Boolean, toldAlready: Boolean): Pair<StepEnd, String?> =
+        when (step.status) {
+            StepStatus.COMPLETED ->
+                if (toldAlready) StepEnd.LEFT_OPEN to PlanRecord.reason(step.result) else StepEnd.DONE to null
+            StepStatus.FAILED -> when {
+                handedOver -> StepEnd.LEFT_OPEN to PlanRecord.reason(step.error)
+                step.error?.startsWith(BLOCKED) == true -> StepEnd.NOT_RUN to NEEDED_A_FAILED_STEP
+                // A reading step's error can quote what it read.
+                reads -> StepEnd.FAILED to null
+                else -> StepEnd.FAILED to PlanRecord.reason(step.error)
+            }
+            StepStatus.RUNNING -> StepEnd.INTERRUPTED to null
+            StepStatus.PENDING -> StepEnd.NOT_RUN to null
+        }
+
+    /**
+     * How the whole run ended. Nothing run is [Outcome.NOT_RUN]. A run that was stopped,
+     * or ended early with nothing failed, is [Outcome.STOPPED]. Then: all done, all failed,
+     * done or failed with something left open for him, and anything else is a part.
+     */
+    fun outcomeOf(steps: List<PhoneLogStep>, ending: Ending): Outcome {
+        val ends = steps.map { it.end }
+        val done = ends.count { it == StepEnd.DONE }
+        val failed = ends.count { it == StepEnd.FAILED }
+        val open = ends.count { it == StepEnd.LEFT_OPEN }
+        return when {
+            ends.all { it == StepEnd.NOT_RUN } -> Outcome.NOT_RUN
+            StepEnd.INTERRUPTED in ends || ending is Ending.Stopped || ending is Ending.Declined ||
+                ending is Ending.NotRun -> Outcome.STOPPED
+            ending is Ending.Finished && !ending.isSuccess && failed == 0 && open == 0 -> Outcome.STOPPED
+            done == ends.size -> Outcome.DONE
+            open > 0 && failed == 0 && done + open == ends.size -> Outcome.LEFT_OPEN
+            failed > 0 && done == 0 && open == 0 -> Outcome.FAILED
+            else -> Outcome.PARTLY
+        }
+    }
+
+    /** The app a step acts in: the one it names, or the one its action always uses. */
+    fun appOf(canonical: String, params: Map<String, String>): String? =
+        APP_PARAMS.firstNotNullOfOrNull { params[it]?.trim()?.takeIf(String::isNotEmpty) }
+            ?: ACTION_APPS[canonical]
+
+    private val APP_PARAMS = listOf("appName", "app", "app_name", "packageName", "package")
+
+    private val ACTION_APPS = mapOf(
+        "SEND_WHATSAPP" to "WhatsApp",
+        "SEND_WHATSAPP_GROUP" to "WhatsApp",
+        "SEND_TELEGRAM" to "Telegram",
+        "OPEN_TELEGRAM" to "Telegram",
+        "SEND_SMS" to "Messages",
+        "SEND_EMAIL" to "the email app",
+        "MAKE_CALL" to "the phone app",
+        "MAKE_VIDEO_CALL" to "the phone app",
+        "PLAY_YOUTUBE" to "YouTube",
+        "BOOK_UBER" to "Uber",
+        "BOOK_OLA" to "Ola",
+        "SEARCH_AMAZON" to "Amazon",
+        "SEARCH_FLIPKART" to "Flipkart"
+    )
+
+    private const val BLOCKED = "Skipped: depends on failed step"
+    private const val NEEDED_A_FAILED_STEP = "it needed a step that failed"
+    private const val HE_SAID_NO = "he said no"
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt b/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt
new file mode 100644
index 0000000..6c70f23
--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/PlanStarts.kt
@@ -0,0 +1,44 @@
+package com.opendroid.ai.core.record
+
+/**
+ * Who started each plan the chat loop has in hand, why, and how it was let through, noted
+ * where each of those is known (his message became a plan, her command did, a gate let it
+ * run) and read once the plan has ended, when its entry is written.
+ *
+ * Kept in memory, for the newest [max] plans only: a plan is recorded when it ends, which
+ * is soon after it starts or waits at the gate. A plan noted nowhere (one resumed after the
+ * app was restarted) is recorded with what its entry can still say.
+ */
+class PlanStarts(private val max: Int = MAX_PLANS) {
+
+    /** What is known of how a plan started. Any part can be unknown. */
+    data class Start(val who: Starter? = null, val why: String? = null, val how: LetThrough? = null)
+
+    private val starts = object : LinkedHashMap<String, Start>() {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Start>): Boolean = size > max
+    }
+
+    /** [planId] was started by [who], for [why]. How it is let through is noted apart, when it passes a gate. */
+    @Synchronized
+    fun started(planId: String, who: Starter, why: String?) {
+        starts[planId] = Start(who, why?.takeIf { it.isNotBlank() }, starts[planId]?.how)
+    }
+
+    /**
+     * [planId] was let through by [how]. With [keepEarlier] a gate noted before stands: a
+     * plan that runs on her rein also runs as approved, and it is her rein that let it.
+     */
+    @Synchronized
+    fun letThrough(planId: String, how: LetThrough, keepEarlier: Boolean = false) {
+        val now = starts[planId] ?: Start()
+        if (keepEarlier && now.how != null) return
+        starts[planId] = now.copy(how = how)
+    }
+
+    @Synchronized
+    fun of(planId: String): Start? = starts[planId]
+
+    private companion object {
+        const val MAX_PLANS = 64
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt b/app/src/main/java/com/opendroid/ai/core/record/RecordForHer.kt
