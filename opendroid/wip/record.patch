--- /dev/null
+++ b/app/src/main/java/com/opendroid/ai/core/record/RecordSeal.kt
@@ -0,0 +1,59 @@
+package com.opendroid.ai.core.record
+
+import com.opendroid.ai.core.security.AndroidKeyStoreAeadCipher
+import com.opendroid.ai.core.security.SecretAeadCipher
+import java.nio.charset.StandardCharsets
+import java.security.GeneralSecurityException
+
+/**
+ * Seals the record of what the phone did before it is written, and opens it again. The
+ * record names who he wrote to and what was sent, so it is never on the disk in the clear.
+ *
+ * [open] throws when the bytes cannot be opened: a key that is gone (the app was
+ * reinstalled, the Keystore was reset), a file that was changed or cut short. The store
+ * sets such a file aside and starts again; it never guesses at what it held.
+ */
+interface RecordSeal {
+    fun seal(plain: ByteArray): ByteArray
+
+    @Throws(GeneralSecurityException::class)
+    fun open(sealed: ByteArray): ByteArray
+}
+
+/**
+ * The seal on the phone: AES-256 in GCM mode with no padding, under a key that is made in
+ * the Android Keystore and never leaves it ([KEY_ALIAS]). Each seal takes a fresh random
+ * 12-byte IV from the Keystore, which is written in front of the ciphertext; GCM's tag
+ * follows the ciphertext, so a changed byte anywhere fails [open]. The bytes are bound to
+ * this record ([AAD]), so no other sealed text of the app can be put in its place.
+ *
+ * Built on the app's one Keystore cipher ([AndroidKeyStoreAeadCipher]), so there is still
+ * a single audited crypto implementation.
+ */
+class KeystoreRecordSeal internal constructor(private val cipher: SecretAeadCipher) : RecordSeal {
+
+    constructor() : this(AndroidKeyStoreAeadCipher(KEY_ALIAS))
+
+    override fun seal(plain: ByteArray): ByteArray {
+        val sealed = cipher.encrypt(plain, AAD)
+        check(sealed.iv.size == IV_BYTES) { "The Keystore gave a ${sealed.iv.size}-byte IV" }
+        return sealed.iv + sealed.ciphertext
+    }
+
+    override fun open(sealed: ByteArray): ByteArray {
+        if (sealed.size < IV_BYTES + TAG_BYTES) throw GeneralSecurityException("Too short to be a sealed record")
+        return cipher.decrypt(
+            iv = sealed.copyOfRange(0, IV_BYTES),
+            ciphertext = sealed.copyOfRange(IV_BYTES, sealed.size),
+            aad = AAD
+        )
+    }
+
+    companion object {
+        /** The Keystore alias of the record's key. */
+        const val KEY_ALIAS = "yume_phone_record"
+        const val IV_BYTES = 12
+        private const val TAG_BYTES = 16
+        private val AAD = "opendroid.phone_record.v1".toByteArray(StandardCharsets.UTF_8)
+    }
+}
diff --git a/app/src/main/java/com/opendroid/ai/core/record/RunEntries.kt b/app/src/main/java/com/opendroid/ai/core/record/RunEntries.kt
