+package com.opendroid.ai.di
+
+import com.opendroid.ai.core.persona.PhoneRecordLink
+import com.opendroid.ai.core.record.KeystoreRecordSeal
+import com.opendroid.ai.core.record.PhoneRecord
+import com.opendroid.ai.core.record.PhoneRecorder
+import com.opendroid.ai.core.record.RecordForHer
+import com.opendroid.ai.core.record.RecordSeal
+import dagger.Binds
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import javax.inject.Singleton
+
+/**
+ * The record of what the phone did: one sealed store ([PhoneRecord]) that the plan loop,
+ * macros, routines and the social screens write to ([PhoneRecorder]), sealed under its own
+ * Keystore key ([KeystoreRecordSeal]), and the one door through which her engine is told
+ * what it holds ([PhoneRecordLink]). Her engine never holds the store itself.
+ */
+@Module
+@InstallIn(SingletonComponent::class)
+abstract class PhoneRecordModule {
+
+    @Binds
+    abstract fun bindRecorder(record: PhoneRecord): PhoneRecorder
+
+    @Binds
+    abstract fun bindRecordForHer(link: RecordForHer): PhoneRecordLink
+
+    companion object {
+        @Provides
+        @Singleton
+        fun provideRecordSeal(): RecordSeal = KeystoreRecordSeal()
+    }
+}
